        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "各巻の巻頭には息子の写真を入れデヂケートした。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い蟷螂が頭にとまつた、カマキリ、カマキリ、ウラワカイカマキリに一句デヂケートしようか。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは、今日は何か云ふことの代りに、次の一文を翻訳して此処に掲げ、ひたすら連載を望んで止まぬと、眼中の人の作者へデヂケートする次第であります。",
              "citation": {
                "source": "浪曼的月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローラは、ウヰルソン先生にデヂケートする目的で、このあたりの野生植物やら昆虫類の標本を作ることを主な仕事としてゐた。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が『いろ／＼助けて貰つた詩集がもう出來るが見せられないのが殘念、照ちやんにデヂケートしたいがどうだ』とたづねますと『そんな事、しないで下さい』とやつぱり目立つ事を好まぬと見えて言下に斷りました。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
