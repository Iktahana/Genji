          "literary": [
            {
              "text": "彼女が日本語が解るというので僕が極めて簡単の日本語で、「ランテイさん、アナタワ、ベッピンサンデスネ、ボクヲ、アイシテクレマスカ」　と話しかけると、彼女は日本語で返事をせずに、中華民国語で返事をするのさ。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆々様オカワリナクテ、ケッコウデスネ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヘルサン、毎日オアツイデスネ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キノドクナワンコチヤンデスネ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コマツタコトデスネ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "３オ染サンガ新聞ヲ読ンデクレタラ日本軍ガ合戦ニ勝ッタソーデスネオジサンモ戦ッタノデスカソシテ敵ヲ殺シタノデスカ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエチヤンハ「オカシナミミデスネ」トオツシヤツテ、オワラヒニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弾イテミマショウ……ワガヨウジノオモイデ……ナルホド……我ガ幼時ノ思イ出トイウ題デスネ……作者ジョー・ミウラ」　と声に出して読み上げながら、先生はピアノの前にかけられました。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お早うございます」「ヤアオ早ウ、宜イ天気デスネ」「左様でございます、――今日は特にベーコン・エッグスを致しましたからどうかお試し下さいまし」　そう云って給仕が、卓子の上へ銀盆を置いた時である。",
              "citation": {
                "source": "亡霊ホテル",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「思イ出サレタヨウデスネ」「ああ、だいたい思い出したとも」「アナタハ」炎のような球体は今度は雄弁に思念を送ってくる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダマッテ、モッテイク、ドロボウデスネ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
