        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "浄吉ト二人キリノ時ニモ、嘗テ愛情コマヤカナリシ時代ニハソンナ風ダッタデアロウガ、今デハソウデモナサソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治モ中期以後ニナレバコノ習慣ハ次第ニ廃レタガ、予ノ幼少時代マデハソウデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食堂ヘ行カナイデモイヽジャナイカ、コヽニ鮨ガコンナニ残ッテル、コヽデコレヲ食ベナサイ」「ソウ、デハソウスルワ」「君ト鱧ヲ食ベルノハ浜作以来ダナ」「ソウダッタワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村モ口デハソウ云イナガラソノ実腰ヲ上ゲル様子ハナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
