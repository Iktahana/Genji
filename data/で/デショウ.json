  {
    "uuid": "abefc1dd-255c-57fc-bc43-fb1b68ffb302",
    "entry": "デショウ",
    "reading": {
      "primary": "でしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今アナタ忙ガシイデショウネ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "答、０、と書いたが、若し間違っていたら、またこないだみたいに侮辱されると思ったから、答、０デショウ、と書いた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチニ取ルベキトコロノアルモノガアルデショウカ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰カ近所ノ親切ナ人ガ投ゲ込ンデ下サッタノデショウ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達ハ二人トモ姦通者ナンデショウ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラダハ、ゲンキデショウカ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コノ、ニッポンノ紳士ハ、スコシ、アタマガ変デワナイノデショウカ、変ナコトバカリ云イマス』と。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレモ　ユリコサン　ニアケマス　オトウサマカ　ナニヲシテ　イマスカ　オカアサマニ　オキキナサイ　オカシイデショウ　　　〇六・三・二六」　ロンドンから母宛に来た手紙の中に封じこめられたものであったのでしょう。",
              "citation": {
                "source": "写真に添えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いながら、手帳と鉛筆をさしつけると、兵部の娘は、直ちに鉛筆を取って認めました、「海岸ヲ西ノ方ヘ向イテ行ッテシマイマシタ、ソノウチ帰ルデショウ」　それを見ると、金椎の眉根が不安の色に曇り、思わず窓の外から海の方を見ますと、真の闇ながら、空模様が尋常でない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶん、アルデショウ。",
              "citation": {
                "source": "余はベンメイす",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "前座のＦは、いまや現役のパリパリで、この文章の中にも登場しているが、さて、「ワタクシハダレデショウ？",
              "citation": {
                "source": "艶色落語講談鑑賞",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木氏曰ク、非常ニ忙シイノデ拙宅ヘオ越シ下サルコトヲ望ムガ、往診ノ場合ハ週ニ三回ニシテ戴キタイ、拝見シナケレバ分ラナイガ、オ話ノ様子デハ多分治癒出来ルト思ウ、二三カ月ハカヽルデショウト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛イナンテ嘘デショウ」ト云ウ人モアルガ、嘘デハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ入梅モ明ケルンデショウネ」ト、今日モ婆サンガ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ所ニ埋メラレタクナインダ」「ソレハ分ッテマスケレド、京都ニナサルニシタッテ、来月ノ大文字マデニハ決メルッテオッシャッテタデショウ」「マダ一カ月アルンダカライヽサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「這入リタインデショウ」「別ニ用モナインダケレドネ」「ソレ／＼、興奮スルト滑ッテ転ブワヨ、落チ着イテ、落チ着イテ」今ハ下司板ガ上ゲテアッテ、タイル張リノ床ガシャワーノ水デビショ／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不便ト思ウノハイヽケレド、オ爺チャンヲ楽シマセルタメニ、アタシガ犠牲ニサレルノハ嫌ダワ」「犠牲ト云ウコトハナイデショウ、僕ヲ楽シマセルト同時ニ、君自身モ楽シムンジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキハ上ガ二二三、下ガ一五〇アッタンデゴザイマスヨ」「ソンナコトモタマニハアルデショウナ」「タマニダッテコンナコトガアッチャ大変デゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハソウト、陸子ガ面白イコトヲ聞イテ来マシタンデ、オ爺チャンニモオ耳ニ入レテ置キタイト思イマシテネ」「アヽソウ」又何カイヤナコトヲ云イニ来ヤガッタト思ッテイルト、「オ爺チャン油谷サンヲ覚エテラッシャルデショウ」「ブラジルヘ行ッタ油谷ノコトカ」「アノ油谷サンノ息子サンヲ御存知？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ間、アタシ達ガ軽井沢カラ帰ッテ来タ明クル日ノ晩、先月ノ二十五日ノ晩ニ、後楽園ジムニ東洋フェザー級タイトル・マッチガアッタデショウ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛印アタリハ宝石ノ値ガ安インデスカラ、佛印デ二百萬圓ダッタラ日本ヘ持ッテ来レバ倍以上ニナルデショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「プールッテソンナニ早ク作レルンデショウカ、モウ秋ジャアリマセンカ」ト、陸子ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ニソレヲ見セルノガ目的デプールヲ作ルヨウナモノナンダ」「ソレデモソレハイヽコトデゴザイマスワネ、自分ノ家ニプールガ出来タラ経チャンダッテ喜ブデショウシ、………」陸子ガ云ウト婆サンガ云ッタ。",
