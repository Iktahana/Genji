      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "デイリィ・テレグラフ――犯罪史上、稀にみる奇怪な惨劇である。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "デイリィ・ニューズ――間違いなくこの犯罪の裏には政治的なものがある。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、ブレーク、ベックリン、ロセチ、それにドーレの『失楽園』や、キャメロンの『水神』、『ニーベルンゲン譚詩』のデイリッツなど――ああした、すこぶる幻想的な挿画を見るとだね……」　と云いかけたとき、断崖の尽きた岩壁に、日傘が二つ並んでいた。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪戯小僧８・14（夕）　アーノルド・デイリーといへば、米国では一寸聞えた俳優だが、以前フロウマンといふ同じ俳優の小僧を勤めてゐた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーノルド・デイリーは無論｜善い小僧に相違なかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関に出て来た悪戯小僧のデイリーは、女客の顔を見ると口を窄めて挨拶した。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プレデイリ・オネーの頭取さんのサロンよ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間後に恢復すると、自分が倒れた場所に（十一月二八日）出かけ、自死した――残された遺言は、デイリー・メイル社の翻訳によるとつぎのようである。",
              "citation": {
                "source": "男子の本懐",
                "author": "A WISH FULFILLED",
                "note": "青空文庫"
              }
            },
            {
              "text": "今中がちょっと顔を横にそらすようにしてゆっくりバットの烟をふき終ると、それとなく山原への軽蔑を口辺に示しながら、「とにかく、少くともここにいる者はデイリー・ウォーカアスへの投書に対して下したプラウダの批評を理解していることは自明だと思うんだ。",
              "citation": {
                "source": "道づれ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「――ぶこちゃんはデイリー・モスク※よめばいいじゃないか」「どうして？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイリー・モスクじゃないの。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――いずれはどうせ読めるようになるんじゃないか」　読めないなりに、伸子はデイリー・モスク※のほかに、記事のかきかたのやさしいコムソモーリスカヤ・プラウダを外出のたびに買って来て見るのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、パリで買えるデイリー・メイル紙からそういう記事をよんで間もなかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那側による東支鉄道の回収について、パリの英字新聞「デイリー・メイル」は冷静に事実を報道しているだけだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイリー・メイル」は、はじめと同じような冷静さで、中国側の動きを肯定的にとりあげて報道しつづけている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子はくりかえして「デイリー・メイル」の記事をよんだ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デイリー・メイル」をよんでいる泰造が、七月二十三日の事件について、どんな感想をもつだろうか。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本女はそこで或る朝『デイリー・ヘラルド』を買おうとした。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し日本女は『デイリー・ヘラルド』を欲しいと思う。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍵番の爺さんに日本女は明日の朝から『デイリー・ヘラルド』を配達して呉れと云った。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――デイリー・ヘラルドを？",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝室の戸をあけたら、靴の上にきちんとのっかっているのはデイリー・メイルだ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――貴方デイリー・メイルをよこしたのね。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デイリー・ヘラルドよこして下さい。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デイリイ・ミラアに面白い記事がある。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "月は片眼のロンドンでデイリー・メイル社の電気広告の真上を歩いている。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボルドーで手に入る唯一のおもしろい新聞といへば『デイリ・メイル』くらゐなもので、それもサン・ヂャンの停車場まで一日おくれのを買ひに行かねばならなかつたが、それとてもフランス官憲の統制の下に賣られるのだから、知りたいと思ふことが十分に知られないのはもちろんだつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クック博士のほうは、ギッブスというデイリー・クロニクルの記者が食いさがって徹底的に糾弾をつづけ、その後、公式調査によって、まったくの虚報だったことが明白にされた。",
              "citation": {
                "source": "南極記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "半年くらい前のシカゴ・デイリー・ニュースに、昨年中に駐日米軍が、日本で消費したドルは、七億六千何百万ドルとかに上ったという短い記事が出ていて、「よくも使ったものだ」という意味の見出しがついていた。",
              "citation": {
                "source": "科学は役に立つか",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーディナル・スペルマン、ザ・ジョン・バーチ・ソサエティ、『ニューヨーク・デイリー・ニューズ』紙などが、全面的に支持した。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
