        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五月十八日（木曜）〔受信〕電報　ヨギハ　アスデナク　ケンジ　ペンクラブの会五月十九日（金曜）　一週間ぶりで面会。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "×同ジ日ノ午後勿論太陽ガ在ツテイナケレバナラナイ場所ニ在ツテイタバカリデナクソウシナケレバナラナイ歩調ヲ美化スルコトヲモシテイナカツタ。",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ大役デモ大阪ノモノデナク、江戸ノモノヲ選ンダ方ガヨカッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ陸子夫婦ニ子供ガ三人デ、狭過ギテ困ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ顔ノ女ヲ見ルト、顔ダケデナク、性質モ残虐デアルカノヨウニ思イ、又ソウデアルコトヲ希望スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ春久ト限ッタコトハナイガネ、甘利デモ誰デモイヽガネ」「四阿ヘ来ルト、キットコンナ話ニナルノネ、チット散歩シマショウヨ、足ノ運動バカリデナク、頭ニモ毒ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ唇ダケデナクッテモイヽ、舌ヲ着ケテモイヽ」予ハ七月二十八日ト同ジ姿勢デ、彼女ノ脹脛ノ同ジ位置ヲ唇デ吸ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ成立シタバカリデナク、母ノ忰デアル予ガ孫ノ嫁ノ魅力ニ溺レ、彼女ニペッティングヲ許シテ貰イ、ソノ代償ニ三百萬圓ヲ投ジテ猫眼石ヲ買ッテヤルナンテ事件ガアッタラ、母ハ驚イテ気絶スルダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ左足ダケデナク、左右両方デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ「若奥様」ノ権力ガ日ニ日ニ「御隠居様」ヲ凌ギツヽアルノニ、犬一匹ノ処置ノ問題ガ因ニナッテドンナ大喧嘩ニナルカモ知レナイ、ソレヲ思ウトウッカリ戦端ヲ開ク訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日デナクテモヨカッタノダガ、犬ノ事件ヲ早速佐々木ガ知ラセタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌ダケデナク、手頸ノ方ニカケテ、小指ニツヾク尺骨ノ茎状突起、及ビ橈骨ノ突起マデ痛ミ、手頸ヲグルリト廻ソウトスルト殊ニ痛ンデ巧ク廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「接吻シテクレヽバ痛イノヲ忘レルヨウ」「足ナンカジャ駄目ダヨウ」「ネッキングデモ駄目ダヨウ」「ホントノ接吻デナクッチャイヤダヨウ」コンナ工合ニ散々駄々ヲ捏ネテ泣キ声ヲ立テ、悲鳴ヲ上ゲテ見タラドウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「最モ痛イ時ヲ狙ッテ」ト云ッタガ、本当ニ痛イ時デナクテモイヽ、痛イ振リヲシテヤレバイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモソンナニ古イ形ノモノデナクテモイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレニ答エテ云ッタ、彼女ト春久ト仲ガイヽコトハ予ガ知ッテイルバカリデナク、自分デモ公然ト云ッテイルシ、亭主ノ浄吉モ承知デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――僕ハ何トナク四角ナ壁デ仕切ラレタ安アパート風ノ一室ヲ聯想シ、畳デナクベッドニ寝テイル姿ヲ描イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアサマデナクチャ、イケナイノ」「アア、分った分った。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
