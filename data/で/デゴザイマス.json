    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "看護婦はその捕えた蚤のまだ生きているのを縫針に突きとおし、ハリツケデゴザイマスなどと言って自分のところに持って来てくれるので、枕頭でそれを見乍ら心を慰めて居るという具合であった。",
              "citation": {
                "source": "蚤",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オイデニナッテイラッシャイマシタガ、モウオ帰リニナッタヨウデゴザイマス」ト、多少曖昧ニ答エテ出テ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア、先程ヒルマンガ出テッタヨウデゴザイマスガ」ト、佐々木ガオ静ニ聞キニ行ッテ戻ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤッパリ若奥様ハオ出カケニナッタソウデゴザイマス」……………………………………………………………………………………………………十日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ不思議デゴザイマスネ、無理ニ力ンデ堅イオ通ジデモナサイマシタカ」「イヽヤ」「何カアッタンジャゴザイマセンカ、ドウモ不思議デゴザイマスネ」佐々木ハ頻リニ首ヲ傾ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキハ上ガ二二三、下ガ一五〇アッタンデゴザイマスヨ」「ソンナコトモタマニハアルデショウナ」「タマニダッテコンナコトガアッチャ大変デゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモマア、ホンノ一時的ノ現象ダッタンデゴザイマスネ」ホットシタノハ佐々木バカリデハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト乳母ガ、「ホラ、督チャン、モウ秋デゴザイマスヨ、蟋蟀ガ鳴イテオリマスヨ」ト、ソウ云ッタモノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホラ、アノ声ヲ聞イテルト、『肩｜刺セ裾刺セ、肩刺セ裾刺セ』ト云ッテルヨウニ聞エルデゴザイマショ、モウアノ声ガ聞エ出シタラ秋ナンデゴザイマスヨ」ソウ云ワレルト、気ノセイカ寝間着ノ白地ノ単衣ノ筒袖ヲ肌寒イ風ガ冷エ／″＼ト通リ抜ケルヨウナ気ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那様ニ限リマセン、オ歳ヲ召スト誰方モ喉ガ干涸ビテ、息ヲナサル度ニ笛ノヨウナ音ガ出ルンデゴザイマスネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ニソレヲ見セルノガ目的デプールヲ作ルヨウナモノナンダ」「ソレデモソレハイヽコトデゴザイマスワネ、自分ノ家ニプールガ出来タラ経チャンダッテ喜ブデショウシ、………」陸子ガ云ウト婆サンガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ詰メテ書キ物ヲナサラナイ方ガヨクハゴザイマセンカ、又痛ミ出スト心配デゴザイマス」予ガ日記ヲツケテイルノヲ見テ佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノ福島博士ト云ウ人ハ信用ノ置ケル人カネ」「エヽ勿論デゴザイマストモ、アノＰＱ病院ノ整形科ニ勤務シテイラッシャル先生デスカラ間違イハゴザイマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエイケマセン、二十八日ニ決メテ下サイ、アタシモソノ日ハツイテ行キマス」「婆サンナンゾ来ナイデモイヽ」「イヽエ参リマス」「ソウシテ戴キマシタ方ガ、私モ安心デゴザイマス」ト、佐々木マデガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ食慾ガオアリニナレバ安心デゴザイマスネ」ト、佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭板橋ノ書ガゴザイマスガ御覧ニナッテ下サイマスカ」「ソレヨリ君、突然妙ナオ願イヲスルヨウダガ、アッタラ売ッテ貰イタイモノガアルンダ」「何デゴザイマス」「紅絹ノ裂ヲ二尺バカリト布団綿ヲ一ト塊、分ケテ戴キタインダガネ」「変ッタ御用ヲ承リマスナ、一体何ニナサルンデ？",
              "citation": {
