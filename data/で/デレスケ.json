        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あのでれ助が胡麻の蠅とは、こいつはちいつと出来すぎたわい。",
              "citation": {
                "source": "鼠小僧次郎吉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「でれ助親爺め、仕事は半人前も出来ねえくせに、口ばかりは二人前も達者だ。",
              "citation": {
                "source": "おびとき",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな取り方で植えられっか、このでれ助阿女――」と彼女はいきなり叱りとばした。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人前に大飯ばっかり喰いやがって、このでれ助野郎ら。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "『そんなでれ助だから君は駄目だよ』と突き飛ばしてやっても突ん※ったまゝ矢っ張りニコ／＼していた。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "飴ん坊のでれ助だと云った。",
              "citation": {
                "source": "留さんとその女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴公、よっぽどでれ助だな。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "男たちの中には、その誘惑に負けて、女の党派に荷担した者も少なくなかったが、そういう連中は仲間から手厳しい非難を受けて、二本棒だのでれすけだのと罵られた――これは周知の如く、男子にとっては甚だ不面目な呼称である。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
