          "literary": [
            {
              "text": "（一）コノ荷物ノ中身ガ何デアッタカ誰ニモイウナ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ明治ノ何年頃デアッタカ幼少ノ時デ覚エガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ彼女ノ捜索癖ヲ満足サセルタメデアッタカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ソレカラ何時間後デアッタカ、マタ違ッタ夢ヲ見テイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
