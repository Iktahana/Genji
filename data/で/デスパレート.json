    "definitions": [
      {
        "index": 1,
        "gloss": "desperate",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はデスパレートな状況にもかかわらず、最後まで諦めなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "デスパレートな戦いが、今まさに始まろうとしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女のデスパレートな叫び声が、静かな夜に響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "わが尊敬する犯罪王ナポレオンがいかにデスペレートになつたからと云つてそんなへまをやるだろうか。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦心して探し回って、ついにどうか、こうか快楽という一事を捕えたまではよかったが、その「快楽」を捕えたときは、君はすくなからず蕭殺たる色相とデスペレートな気分とを帯びてるごとく見えたからである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めより生の悲痛と不調和とを覚悟して立ちたるデスペレートな利己主義であった。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "外部からの強暴な敵（私は病気をも外部と感ずる）と戦ってデスペレートな私は、内部よりの敵（彼女の変心）に遭って根本的に敗れてしまった。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれをわれに非なるものと感ずるときはデスペレートなニヒリズムになるほかはないと思います。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女子の行為は、復讐にしろ、また一般犯罪行為にしろ、極めてまわりくどく、且つデスペレートであることをその特徴として居ります。",
              "citation": {
                "source": "印象",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかデスペレートになってしまう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クサンチッペになることは本来の性に逆らっているから、デスペレートになった揚句というおそろしいわけ合いで、我ながらのぞましくない仕儀です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "相当の頭を持った者は皆、皮肉な、一面から云うと、デスペレートな気分で此等の疑問を抱いて居ります。",
              "citation": {
                "source": "Ｃ先生への手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この軟かそうな、瑞々した緑の葉が、あんなに乾いた、何処かデスペレートな感じを与える秋の紅葉になるのか。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘に、殆どデスペレートな愛と希望とをかけている寿賀子は、結婚後も、ゆき子を世間並に良人の手にだけ委ねては置かなかった。",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスペレートな点では、女性も同様であったのだと思う。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉村氏は、滅びるものをして滅ばしめよという風にその姿を克明に描くが、そこに我々は氏のデスペレートな、崩壊の面のみを認識してそこから新たな力の擡頭のあることを理解しない富農の暗い憤りが文章のセッサタクマというところへまで転化して現れているのである。",
              "citation": {
                "source": "同志小林の業績の評価によせて",
                "author": "――四月の二三の作品――",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺のはデスペレートな勇氣さ。",
              "citation": {
                "source": "受驗生の手記",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」受驗生はデスペレートな反抗でさう云ひながら立ち上つた。",
              "citation": {
                "source": "受驗生の手記",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は自分も可なりデスペレートになつてゐたので、心からその青年に同情した。",
              "citation": {
                "source": "受驗生の手記",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり失意の苦惱を續くるにも堪へ兼ねて、誰かにそれを訴へたい氣もあつたし、又得意な弟の樣子を見て、苦痛をいやが上にも大きくして見たいと云ふ、デスペレートな享樂心も在つた。",
              "citation": {
                "source": "受驗生の手記",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
