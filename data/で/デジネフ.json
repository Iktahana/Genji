          "literary": [
            {
              "text": "――八日、デジネフ、ピー、アール、ウェールスか！",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしき予感　帆村探偵は漫画の水兵の画から「八日、デジネフ、ピー、アール、ウェールス」を次のような見方をして、取り出したのだった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デジネフデジネフ。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デジネフ岬というのがある。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムチャッカのデジネフ岬がどうしたというのだ。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デジネフ岬とプリンス・オヴ・ウェールス岬も、ごく狭い海峡を距てて向いあった両地点である。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「プリンス・オヴ・ウェールス岬とデジネフ岬のある中間でしょう」「正にそのとおり！",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "両方から象の鼻のように出ているのはウェールス岬とデジネフ岬にちがいない。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
