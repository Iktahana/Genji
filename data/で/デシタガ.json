          "literary": [
            {
              "text": "ソノ　ムラニモ　ヒトハ　アマリ　ヰマセンデシタガ、マダ　スコシハ　ノコツテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソノ時ハ何シロ夢中デスカラ詳シクハ考エマセンデシタガ、イキナリハイッテ行ッテネテイル道子ノ咽喉ヲ手デシメル積リデアリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ目ヲサマスト驚イテフルエテ居タヨウデシタガ、私ガシャベリ出ストソレニ対シテ、コノウソツキメ、大嘘ツキメト私ヲ罵リマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ハアット云ッテ倒レ机ノハシデ頭ヲヒドク打チ、倒レルト同時ニ血ヲハイタヨウデシタガ、ソノママ昏倒シテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ時自分ノ危険ヲ考エテオリマセンデシタガ然シモシ誰カ来タラ自分ハ道子ヲ一思イニ殺シテ自殺スル気デシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ声ハカスカデシタガハッキリトキキ取レマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒハ　カン　カン　ト、マウヘカラテツテ、アツクテ　タマリマセンデシタガ、ジヨン　ト　チビスケハ　カケツコシテ　ノハラニ　ユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久シュウオ目ニカヽリマセンデシタガ、相変ラズオ元気デイラッシャイマスナ」「ナアニ、チットモ元気ナコトナンカナイヨ、今度ハ京都ヘ自分ノ墓地ヲ捜シニ来マシタ、イツ死ンデモイヽヨウニネ」「御冗談デショウ、ソノ勢イジャアマダ／＼大丈夫デイラッシャイマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
