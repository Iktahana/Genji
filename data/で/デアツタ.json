          "literary": [
            {
              "text": "當時近隣デハ隅田川添ノ今戸橋白髯橋間ノ狹イ地帶ニ火ノ手ガ見エナイダケデ、西ハ龜岡町、吉野町、山谷町、玉姫町イヅレモ火ノ手ガ盛デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "風向ハ南々東デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ始メハ「ガス、タンク」デモ爆發シタカト思ツタ位猛烈ナ勢デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒褐色ノ煙ノ柱徑一町以上ノモノガ天ニ沖シ、中空以上ハ擴ガツテ雲ノヤウデアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻轉ハ地上カラ向ツテ右ネヂノ方向デアツタト思フガ確カデナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "旋風ハ二三分位ノ後ニハ待乳山ノ西側ト思ハレル邊マデ進ンデ行ツタガ大キサハ同樣デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ四時頃デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ハ淋シク有名デアルドウシヤゥ　　　　　×遂ニ▽ヲ埋葬シタ雪景デアツタ。",
              "citation": {
                "source": "破片ノ景色――",
                "author": "△ハ俺ノ AMOUREUSE デアル",
                "note": "青空文庫"
              }
            },
            {
              "text": "青イ静脈ヲ剪ツタラ紅イ動脈デアツタ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ソレハ青イ動脈デアツタカラデアル――　――否！",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的ノナカツタ丈　冷静デアツタ太陽ガ汗ニ濡レタ背ナカヲ照ラシタ時影ハ背ナカノ前方ニアツタ人ハ云ツタ「あの便秘症患者の人はあの金持の家に食塩を貰ひに這入らうと希つてゐるのである」ト‥‥‥‥‥‥‥‥‥‥‥１９３１・６・５",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子ガ部屋中ヘ飛ンデアブナク怪我ヲスル所デアツタ。",
              "citation": {
                "source": "「光線の圧力」の話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
