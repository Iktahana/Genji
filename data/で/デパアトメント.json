        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」と野崎氏はデパアトメント・ストアのやうな大きな口を開けて笑つた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "天国は彼等の話によると、封建時代の城に似たデパアトメント・ストアらしい。",
              "citation": {
                "source": "猿蟹合戦",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後三時のデパアトメントストア。",
              "citation": {
                "source": "未開な風景",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デパアトメント・ストアだ。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは何処かのデパアトメント・ストアに、並んでいたものに違いない。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ最近の新聞によると、紐育あたりのデパアトメント・ストアアはことごとくあのカメレオンの神託の下るのを待った後、シイズンの支度にかかるそうですからね。",
              "citation": {
                "source": "不思議な島",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "光りが廻ると、その輪の中にうようよと音もなく蠢く、ちょうど海の底の魚群のように、人、人、人、人、……僕が眼を上げると、ほら、あすこのデパアトメントストオアね、もう店を閉じて灯火は消えているのです。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "３　デパアトメントストオアには、あらゆる生活の断面が、ちょうど束になった葱の切口のように眼に沁みた。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの大多数の婦人労働者の如き、家庭の狭隘と自由の欠乏とが只だ工場、デパアトメントストア、事務所等に移されたるのみとすれば果してどれ程真の独立を得て居るであらうか。",
              "citation": {
                "source": "婦人解放の悲劇",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れは、こうした大きなデパアトメントストーアーで、頻々と起る万引の中で、婦人は大抵反物類を窃取するが、之れを持ち出す前には便所に行って始末すると云うのであった。",
              "citation": {
                "source": "偽刑事",
                "author": "川田功",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
