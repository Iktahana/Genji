        "examples": {
          "standard": [
            {
              "text": "システム障害の影響で営業所の電話が掛からなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田舎に引っ越したら、うちの地域にもやっと電話が掛かるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この村全体に電話が掛かるまでには20年以上かかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "間もなく煙草專賣局の本所工場觀覽招待に同行を約した内田誠君から、久保田夫人告別式の歸途自動車事故で足に負傷したのでお伴出來ぬと斷りの電話が掛かる。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話が掛かることを承知していながら、わざと「女の子」と出てしまうなんて、ばかにされたような気がした。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
