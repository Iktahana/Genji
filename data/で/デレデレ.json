[
  {
    "uuid": "01147aef-a36e-5809-8e7f-683565a8d45e",
    "entry": "デレデレ",
    "reading": {
      "primary": "デレデレ",
      "alternatives": [
        "でれでれ"
      ],
      "is_heteronym": false
    },
    "grammar": {
