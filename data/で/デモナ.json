        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユライ芸術トハ、コンナモノサ、譬噺デモナシ、修養ノ糧デモナシ、キザナ、メメシイ、売名ノ徒ノ仕事ニチガイナイノダ、ト言ワレテ、カエス言葉ナシ、素直ニ首肯、ソット爪サキ立チ、夕焼ノ雲ヲ見ツメル。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十秒三、デモナケレバ、五デモナイ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは、是れデスデモナが悲歎せし處なるべし、されどオテルロの苦痛はこれより甚しかりしならんとおもひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "云ウマデモナク最近ノ不況ハドシ／＼失業者ヲ街頭ニ投ゲ出シテ居リ、ソレハ全く見ルニ忍ビナイモノサエアルノデス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ事実ガ右ノ調和ウンヌンニ深イ関係ヲ持ツコトハイウマデモナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモナ、口のさきではどうにでも□□るものじゃ、トックリと胸に手を置いて考えて見なされ、日光にてらされたばかりじゃなくはげた頭が妙に熱うなる骨ばった手がひえて身ぶるいが出る事が必ず有ろうナ。",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒人オセロは、イヤゴーの讒言によって、妻デズデモナを殺しますが、後に邪推に過ぎなかったことがわかると、悔恨のあまり自殺しました。",
              "citation": {
                "source": "三つの痣",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故オフィリヤやデスデモナやトスカや、悄々と敵将の前へ身を投出すヴァンナの、あの幽雅なものごしと可憐さを、自分の生れた国の女性に現せないのだろう、異国の女性に扮するときはあれほど自信のある演出するのにと思った。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは全く、彼女によって示された、「祖国」のヒロインや「オセロ」のデスデモナなぞは、今日の日本劇壇にもちょっと発見することが困難であろうと思うほど立派なもので、ありふれた貧弱なものではなかった。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、川上の懇望によって、故郷の檜舞台に、諸外国の劇壇から裏書きされてきた、名誉ある演伎を見せたのは、彼女が三十三歳の明治卅五年、沙翁の「オセロ」のデスデモナを、靹音夫人という名にして勤めたのが、初舞台である。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さながらに曲中の「戦くデスデモナ」となりし心地やしたりけん。",
              "citation": {
                "source": "偏奇館吟草",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "題は「やまのいもハ薯蕷デモ山薬デモナイ」であって詳しく、その事由を図入りで説明しておいた（『牧野植物学全集』第六巻に転載）。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは昭和二年（1927）十二月三十一日発行の『植物研究雑誌』第四巻第六号での「やまのいもハ薯蕷デモ山薬デモナイ」であった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナ二流芝居」「イヤソウ云ッタモンデモナイサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚シタテハソレホドデモナカッタノダガ、コノ三四年目立ッテソンナ風ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後楽園ジムニ全日本フライ級タイトルマッチガアルンダ」「年寄ノ冷水ネ、ソンナ所ヘ出カケテ行ッテ怪我デモナサラナケレバイヽガ」二十三日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰ニ読マセルタメデモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御免ナサイネ、アンナコトシチャッテ」「イヤ、何デモナイヨ」「痛カッタ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ト二人キリノ時ニモ、嘗テ愛情コマヤカナリシ時代ニハソンナ風ダッタデアロウガ、今デハソウデモナサソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ不思議デゴザイマスネ、無理ニ力ンデ堅イオ通ジデモナサイマシタカ」「イヽヤ」「何カアッタンジャゴザイマセンカ、ドウモ不思議デゴザイマスネ」佐々木ハ頻リニ首ヲ傾ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ心配シテ毎日予ヲ仰向ケニ臥カセ、膝ヲ交互ニ組ミ合ワサセテ脚気ノ検査ヲシテイルガ、脚気デモナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ理由ハ外デモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ顔、アタシニ見セタッテ何デモナイワ、ソレヨリ自分デ自分ノ顔ヲヨク見タコトガオアリニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ間ノ涙ハ豫期シナイデモナカッタ涙ダガ、今日ノ涙ハ少シモ豫期シテイナカッタ涙デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
