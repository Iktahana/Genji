          "literary": [
            {
              "text": "（デイヴィン・シーイー）　一年とか一五年ほど昔はね、45回転レコードでロックンロールを売っていた人たちは、歌詞の一部をわざと不明瞭にしておいたのよ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（デイヴィン・シーイー）　プログレッシヴなロックとして私たちが大切にしたものの多くは、音楽的には進歩していても、エモーションの分野では、枯れはててしまっている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（デイヴィン・シーイー）　Ｅのキーの新曲をレパートリーに加えたら、それまでのレパートリーのなかから、Ｅのものをひとつ、すてていく。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（デイヴィン・シーイー）　自分たちのことをブルース・バンドだとは考えていません。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
