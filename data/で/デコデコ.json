        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ホントウに解放された青天井の人間になれ……という宣言を、新生のまま民衆にタタキ付けたのが基督で、オブラートに包んで投り出したのが孔子で、おいしいお菓子に仕込んで、デコデコと飾り立てて、虫下しみたように鐘や太鼓で囃し立てて売り出したのがお釈迦様という事になるんだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の利いた凝った趣のあるビラ、昔風のなつかし味のある簡素な看板なぞは、活動や、缶詰や、最新流行洋式雑貨なぞのデコデコのポスターに蔽い隠されて行く。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "安い西洋菓子のやうな文化建築をデコデコと建て並べなければ好いと案じられる。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "金のいやにデコデコした指環のある手で器用にひきこなして居るのを見ると、若い時の事がフッと思われる。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻のうすっぺらな髪をデコデコ結ったすれ切った女がたまらなく憎い。",
              "citation": {
                "source": "日記",
                "author": "一九一四年（大正三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "つゞいて本塁をまもるシンちゃんがパッとジャンパーをぬぎすてると、派手なユニホームが現れて、この背には、職業野球の背番号の代りに「さゝの枝主人」とデコデコに縫いつけられている。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
