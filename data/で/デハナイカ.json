[
  {
    "uuid": "20229469-42e7-5f9c-a493-d0dfb6d3a557",
    "entry": "では無いか",
    "reading": {
      "primary": "ではないか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現"
      ],
