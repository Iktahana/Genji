          "literary": [
            {
              "text": "別称チチアネルロ（大匠の息）ジョコンドデジデリオジヤニイノ（この人十六歳の青年、甚だ美し。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "石欄より登り来る階段の上にはデジデリオ、アントオニオ、バチスタ、パリスの四人｜茵絨毯の上に寝そべりている。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ、アントオニオ、バチスタ及びパリス、気づかわしげに、また物聞きたげに、二人の方に進み寄り話しかける。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　生命を創造したチチアノが死ぬと云うのか。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　（欄干に倚りかかっているジヤニイノに。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　誰かよく生きる、彼の後に。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　（少女たちに。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            }
          ]
        }
