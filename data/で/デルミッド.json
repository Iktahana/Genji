        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "デルミッドは自分たちの為にのこされてあった食物をくい始めていたが、ムルタを見まもりながら黙って坐していた。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はデルミッドの側に坐して食い始めたが、互に何も言わなかった。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "デルミッドは彼の方を見なかった、ムルタが死の歌をうたって、影がその上にあったから。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "デルミッドは苔の上を見つめていた、もし彼が眼をあげたら、「殺す者」または「影」または「目しいたる者」を見るかも知れないと思った。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カアル、カアル」　ムルタはデルミッドを見た。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "「目しいた者がここに来たのだろう」デルミッドはひくい声して言った。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "デルミッドは深い眠りにおちた。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "「静かにねむれ」彼は小さい声で言って、枝のあいだを滑り降りてデルミッドの側に戻った。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムルタとデルミッドは立ち上がり言葉もなく谷間を歩いて行った、二人のかすかな足音が羊歯をうごかした、籔のしげみを出ると、松の中の路になった。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
