          "literary": [
            {
              "text": "武将ハ、アレデヨイノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍、独裁官田中ハ、諸君ヲ山東ニマデヨコサシメタル田中ハ諸君ノ階級ノ最悪ノ敵デアルコトヲ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クワシイコトハ物理学者ニ聞カナイトワカラナイガ、多分直線ノホウガヨリ少ナイエネルギーデヨリ多クノ距離ヲ行ケルノダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "名乗リ出デヨ吾ガ双生児ノ同胞。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしたゞ一つ今から四十年前（一八九二｜年）にオランダの軍醫デヨボアといふ人が、南洋ジャ※島のトリニールといふ所で發見した骨が、ちょうどこの人間と猿との中間にある動物の骨だといはれてをります。",
              "citation": {
                "source": "博物館",
                "author": "濱田青陵",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、コレデヨカッタ、ホントニ安心イタシマシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ椅子ニ仰向ケニナッテ彼女ニ顔ヲ剃ッテ貰ッタラ、彼女ノアノ鼻ノ孔ガ奥ノ奥マデヨク見エルダロウナ、薄イ鼻ノ肉ガ紅ク透キ徹ッテ見エタリスルノハ悪クナイナト、ソンナコトモ考エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ支那デモ上海ト広東トハマルデ国ガ違ウヨウニ離レテイマス、目下当地デハ「グレイハウンド」ガ流行デス、ソレデヨケレバ持ッテ行キマス、ドウイウ犬カ君ハ多分知ッテイルデショウガ、参考ノタメ「グレイハウンド」ノ写真ヲ此処ニ入レテ置キマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――北京ノ囚人｜盧俊儀、及ビ、ソノ護送役人ヲ殺害シテ盧ヲ奪イ去ッタ大罪人ヲ訴エ出デヨ、という莫大な懸賞つきの布令なのだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またの名をアメノサデヨリ姫といいます。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
