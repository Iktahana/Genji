        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　カツテ私ハ、愛ノ哲人、ヘエゲルノ子デアッタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術家ハ、イツモ、弱者ノ友デアッタ筈ナノニ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ択バレタル霊魂ノ持主ハ、不運デモアッタガ、又、捉エラレルニ適シタホドノ脆弱性ト不安定トヲ持ッテイタ気ノ毒ナ人デアッタ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一）コノ荷物ノ中身ガ何デアッタカ誰ニモイウナ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "意休ハ福助ノ父ノ芝翫デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬘ヲツケタマヽ舟底形ノ枕ニ寝、暗イ部屋ノ褥ノ中デ、友禅ノ長襦袢ヲ着テノコトデハアルガ、実ニ異常ナ技巧ヲ持ッテイタモノデ、マコトニ不思議ナ経験デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ時ノ孫右衛門ハコノ猿之助ノ父段四郎、小春ハ先代梅幸デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "訥升ハ今日モ綺麗デアッタガ、揚巻ノ方ガヨカッタ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ元来健康ナ体質デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハ、浴槽ハ木製ニ限ル、タイルデハ冷メ易ク、冬ハツメタクテイケナイト云ウ説デアッタガ、コレモ颯子ノサジェッションニ従ッテ（婆サンニハ颯子ノ意見ト云ウコトヲ内證ニシテ）タイルニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ日ハバーベキュー、昨日ハ病気デ静養中デアッタガ、ソノ間モ予ノ頭ニハ絶エズコノ言葉ガ引ッカヽッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」戸ハホンノ僅カ、動クカ動カナイクライニ触レタヾケデアッタガ、早クモ彼女ハ気ヅイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレマデノ間ニソット二階カラ下リテ消エテナクナレバイヽ筈デアッタノニ、彼等ノ方ニモ計算違イガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚当座ノ浄吉ハ大シタ打チ込ミ方デアッタガ、今デハソレホドデナイコトハ確カダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ明治ノ何年頃デアッタカ幼少ノ時デ覚エガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新築シタノハ予ノ父デアッタガ、父ハ大正十四年、予ガ四十一歳ノ時ニ死ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ云ッテイタラ際限ガナイカラ、予ハ近々ニ婆サンニ無理ニ承諾サセテ壊シ屋ヲ入レヨウト思ッテイタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝カラ又牽引ヲ始メルトコロデアッタガ、結局利キ目ガナイノデ中止ト決定。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト乳母ガ、「ホラ、督チャン、モウ秋デゴザイマスヨ、蟋蟀ガ鳴イテオリマスヨ」ト、ソウ云ッタモノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ糊ノ硬イゴワ／＼シタ単衣ヲ着セラレルノガ嫌イデアッタガ、寝間着ニハイツモ甘ッタルイ腐リカヽッタヨウナ糊ノ匂イガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治モ中期以後ニナレバコノ習慣ハ次第ニ廃レタガ、予ノ幼少時代マデハソウデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、後カラ考エルト、ソレハ浄吉ノ意志デハナク、颯子ガ夫ニセビリツイタ結果ナノデアッタガ、最初ハソウト気ガ付カナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日ノ午後、最モ痛ミノ激シカッタ日デアッタ、婆サンガ始メテ病室ヲ覗イテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ婆サンニ突然急所ヲ突カレタノデ、明カニ狼狽シテ照レ隠シニ怒ッタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大体虎ノ門病院ノ時ト同ジデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓際ニ予、ソノ隣ニ颯子、通路ヲ隔テヽ佐々木、ト云ウ目算デアッタガ、動キ出シテ見ルト窓際ハ風ガスウ／＼スルカラト云ワレテ颯子ト入レ代リ、通路ニ寄ッタ方ノ席ニ掛ケサセラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "血壓ハ出発直前ニ測ッタ時ハ上ガ一五四、下ガ九三デアッタガ、乗車後予ハ明ラカニ興奮シテイルコトヲ密カニ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
