    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ツマラヌ取次ハスルモノデナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト俺ハ現在ノ父母ノ子デナイトイフ理論ガ成リ立ツ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コマツタ　ヤツダナ、オレニハ　オチチガ　デナイカラ　ヤツパリ　モトノ　マキバヘ　ツレテツテ　ヤラウ」ト　イツテ、ヌスビトハ　ペコペコノ　オナカヲ　オサヘナガラ　マタ　モト　キタ　ミチヲ　カヘツテ　ユキマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ヒノ　デナイ　ウチカラ　ヲトコハ　ハタケノ　マンナカノ　ヲカノ　上ニ　ノボツテ、ラツパヲ　フクノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハ、ナンデ今フユデナイカト云ッテ、泣イテバカリ居タノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ探求シツクスコトハ容易デナイト思ウガ、ゼヒトモ速カニソノ研究ニ着手スベキダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻轉ハ地上カラ向ツテ右ネヂノ方向デアツタト思フガ確カデナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「有難うございます、手妻使いのようには見えませんか」「イヤ、ソウデナイデス、立派ナ西洋貴婦人アリマス」　こういう問答で、一座がにわかに春めいてきたが、主膳の苦々しさったらない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イヤ、馬鹿デナイデス、オ嬢サン、アナタ考エ無シデス」「お前がわたしを騙したんだわ、ああ、いやな奴。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ苦シイ俺ハ遊ブ▽ノすりつぱーハ菓子ト同ジデナイ如何ニ俺ハ泣ケバヨイノカ　　　　　×淋シイ野原ヲ懐ヒ淋シイ雪ノ日ヲ懐ヒ俺ノ皮膚ヲ思ハナイ記憶ニ対シテ俺ハ剛体デアルホントウニ「一緒に歌ひなさいませ」ト云ツテ俺ノ膝ヲ叩イタ筈ノコトニ対シテ▽ハ俺ノ夢デアルすてつき！",
              "citation": {
                "source": "破片ノ景色――",
                "author": "△ハ俺ノ AMOUREUSE デアル",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰椎モ変形シテイルガ、コノ方ハ頸程デナイト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ニ誰カ出来タノカモ知レナイガ、ソノ点ハ確カデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾ痛イノガ激シイ時トソウデナイ時トアリ、一定ノ状態デ持続セズ、全ク痛マナイ時モアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「嘘デナイコトガ分ッタ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚当座ノ浄吉ハ大シタ打チ込ミ方デアッタガ、今デハソレホドデナイコトハ確カダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ書ハ昔或ル美術商カラ手ニ入レタモノダガ、荷風ノ書ハ非常ニ偽筆ヲ上手ニ書ク男ガイタソウデアルカラ、コノ幅モ真偽ハサダカデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処ト云ウコトハ明カデナイガ、多分割下水時代ノ彼女ニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デナイト得意ノシンクロナイズド・スウィミングガ演リニクイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨デ庭ニハ出ラレナイガ、廊下ヲ散歩スルダケデモ容易デナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョットスルト、コンナコトニ涙ガ出ルノハ、イクラ涙脆イニシテモ尋常デナイ、モウ死期ガ近イセイジャナイノカナト云ウ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無鉄砲ノヨウデ、実ハ甚ダ臆病デ用心深イ筈ノ予ガ、佐々木ノ言葉ニソヽノカサレテ頻リニ左様ナ危険ナ注射ヲシテ貰イタク感ジルノハ、ドウモタヾゴトデナイヨウニ思エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「佐々木サンカラ伺イマシタガ、大丈夫デスカオ爺チャン、オ痛イコトハオ痛イデショウガ、ソンナコトヲナサラナイデモ今ニキット直リマスヨ」婆サンハ気ガ気デナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来レバ父ヤ母ヤ祖父ヤ祖母タチノ墓モ、何処カ東京デナイ所ヘ持ッテ来チマイタイクライダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ四面佛ハ必要デナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ッテ正四角形ノ石ハ必要デナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガモシ読ンデイルノデアッタラ、決シテコレハ偽リノ日記デナイヲ信ジテホシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――僕ハ両刀使イダケレドモ、鮒鮨ハアマリ好キデナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……コノ人憑カレテイマス……人間ノ作ッタ曲デナイ……コノ人モウ長クハ生キナイデショウ……」　そして私の方へ柔和な老眼をじいっと向けられました。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノジ、ニホンノジデナイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
