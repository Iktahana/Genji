        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ結果、俺ハ双生児ノ片割レデアルトイフコトガ判明シタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在カタカナガ一般ニ使ワレテイルノハ数学書、法律書、官報、軍関係ノ書類ナドデアルト思ウガ、イズレモ最モ正確ヲ期セナケレバナラヌ種類ノモノバカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等ハ敢テ云フ、諸君ハマサニ自己ノ能力ヲ過少評価スルノ愚ヲ覚ルベキ秋デアルト。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　裁判言渡しの時どう感じたか実ニ不都合デアルト感ジタ三　受刑者として収容せられた時どう感じたか別ニ処感ナシ四　被害者に対してどう思ふか自分ハ正当ト信ズル事ヲ行ッタノミデアル。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　犯罪に因りて得た金品は何に使ったか毫モ利欲ヲ目的トシテナシタ行為デハナク、従ッテ金品ハ何等得テ居ナイ七　自分の悪癖は何と思ふか事ヲナスニ於テ散漫ニ陥ルノガ自分ノ最大ノ悪癖デアルト思フ八　是れまで何か信じて居ったか宗教ノ意味ナレバ何モナシ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僂麻質性モシクハ神経痛ノ如キモノニ変化シテイル證拠デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａハ親切デ正直デ思イ遣リガアリ、Ｂハ不親切デ嘘ツキデ人ヲ欺スコトガ上手ナ女デアルトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ三井化学アタリカラ樹脂原料ヲ買イ入レテ写真フィルム、ポリエチレン被膜、ポリエチレン成型品、バケツダノ、マヨネーズノチューブダノト云ッタ類ヲ製造スル会社デアルト聞イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "惚レッポイコトモ惚レッポイガ飽キッポイコトモ飽キッポイノハ親譲リデ、若イ時ノ予ト同様デアルト考エテイタガ、今日デハ左様ニ簡単ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ忰ハ寧ロ彼女ノ経理ノ才ヲ徳トシテ、彼女ヲ失ッテハ不便デアルト考エテイルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼底出血ノ恐レハナイカト、検査シテ貰ッタコトガアルガ、眼底ノ血壓ニモ格別ノコトハナク、予ノ年齢トシテハ相当デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヒデハナイガコレモ一種ノ麻薬デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ伏見区竹田内畑町ニアル安楽寿院五輪塔、水輪ガ下ノ方デ細マッテ壺形ニナッテオリ、火輪ノ軒ノ反リガ厚ク、ヤダルミノ工合ガ風輪空輪ノ形ト共ニ鎌倉中期カラ後期ニ移ル頃ノ代表的ナ遺品デアルト、川勝政太郎氏ガ述ベテイルアノ作品、アレナドハドウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ知ッテイルヲ容易ニ口ニ出サナイノガ常デアルガ、悪イコトニハソレヲ女ノ嗜ミデアルトモ思ッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデマタ、妻ガソノ写真ヲ見セラレタ場合ノヲ憤ル―――アルイハ憤ル真似ヲスル―――ヲ夫ニ許サレタモ同然デアルト考エルニ至ルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩暈ハ脳動脈硬化ノ結果デアルト云ワレル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
