        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……外から見える縁側の雨戸らしいのは、これなんでしょう、ずッと裏庭へ出抜けるまで、心積り十八九枚、……さよう二十枚の上もありましたろうか、中ほどが一ヶ所、開いていました。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "出抜けると丘が向うに、くっきりと樹が黒い。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを出抜けるとなるほど寺の門が見えた。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを出抜けると成程寺の門が見えた。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京湾を出抜けると、黒潮に乗って、金華山沖あたりからは航路を東北に向けて、まっしぐらに緯度を上って行くので、気温は二日目あたりから目立って涼しくなって行った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "森を出抜ける頃には、既に十五六｜間も懸隔たって了った。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それやこれやで一行は、正午まえに村道を出抜けることが出来なかった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "並木道を出抜けると、前は一面に開けて、空は明るい光に輝いてゐた。",
              "citation": {
                "source": "伊良湖の旅",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "藪原の宿を出抜けると道は既に木曾川の岸を伝って走っている。",
              "citation": {
                "source": "木曾御嶽の両面",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "林を出抜けると草原、崩越を越えて山に沿い暫く王滝川を遠く脚下に見て行く。",
              "citation": {
                "source": "木曾御嶽の両面",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "このまま河岸を出抜けるのはみんな妙に物足りなかった。",
              "citation": {
                "source": "魚河岸",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘形から女房形に出抜けるか出抜けぬかゞ、女形の運定めである。",
              "citation": {
                "source": "街衢の戦死者",
                "author": "――中村魁車を誄す――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の深い関ヶ原を江州の方に出抜けると、平濶な野路の果てに遠く太陽をまともに受けて淡蒼い朝靄の中に霞んで見える比良、比叡の山々が湖西に空に連らなっているのも、もう身は京都に近づいていることが思われて、ひとりでに胸は躍ってくるのであった。",
              "citation": {
                "source": "黒髪",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "その埒の外へ出抜ける当は無い。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸く山林地帯を出抜けると、そこは最う山の頂辺で、芝草が一｜面に生えて居り、相当に見晴しのきくところでございました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その兵隊町を出抜けると大きな門がありその門の脇に見張の兵隊が二人居りますから、その兵隊に書面を示すと早速判を捺して通行を許された。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い鉄管を一つ出抜けると、すぐに又別の鉄管の口があいている。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の家では浅草方面へ出抜ける場合は、京町二丁目のはずれの黒助湯という風呂屋のある露地の突当りに在った小林というしもたやの土間を通り抜けさせてもらっていた。",
              "citation": {
                "source": "桜林",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
