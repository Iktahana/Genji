          "literary": [
            {
              "text": "「昨夜この男がデスナ」と側らの刑事が弁解らしく口を挿んだ。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小僧「私の献上しようと申しますのはデスナ、我国の兵の身長と敵兵の身長との甚だしい相違に着眼したのです。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その発生電波の波長たるやデスナ、近頃流行の短波にするのです。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今マデ患者ニ何回トナクコノ注射ヲシテルンデスガ、血管ニ触レタコトハ一度モナイノニ、今日ハドウカシテルンデスナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
