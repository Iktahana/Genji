        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "土木事業の出面にも出た。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰊場かせぎの出面たちは近処の農村から続々と入りこんでくる。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜べには町じゅうから駆り出された出面たちが、赤地に墨で奔放に書きなぐった大漁旗をおしかついであつまっていた。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "枠網内の鰊はぽん※で畚にうつされ、出面たちはかけ声勇ましく歩み板を渡って廊下にはこぶ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "粒鰊を箱へ詰めおわると、出面と漁夫との鰊ツブシの作業がはじまる。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰊割きの出面を牽制するためにである。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その方は出面を増してなんとか処理するとしても、今はまだやっと中鰊がはじまったばかりのところだ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その町筋は車力や出面（労働者の地方名）や雑穀商などが、ことに夕刻は忙がしく行き来している所なのだが、その奇妙な物売だけはことに柿江の注意を牽いた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "井田が黒の二重マントを式臺に脱ぐ中に出面は机を卸しにかゝる。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相島は出面が運んで來た机の隅にくツついて居る雪を指先でさらひながら「まア宜い事をした」と何んの事はなくさう思つた。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "井田は懷中から蟇口を出して出面に拂ひを濟ますと、出面は一寸禮を云つて馬の轡を引いた。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他に、工場費――九十六圓、男五人、女十人の出面賃。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして原料を多く買ひ込み、出面の人數をふやしさへすれば、仕あがりの箱數が多くなるから、それだけ利益も亦多くなること。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗い隅の方で、袢天を着、股引をはいた、風呂敷を三角にかぶった女｜出面らしい母親が、林檎の皮をむいて、棚に腹ん這いになっている子供に食わしてやっていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "町へ一日、二日の「出面」を取りに行っているものも休んで出迎えた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚、屍体が機関車から投げ出された際に出来たらしく、顱頂骨の後部に近くアングリ口を開いた打撲傷や、その他全身の露出面に亙る夥しい擦過傷等も明かになった。",
              "citation": {
                "source": "気狂い機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩身が狭くて出面に出られんぞ。",
              "citation": {
                "source": "前夜",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "で理論乃至科学は、他の理論乃至科学の成果のこうした露出面（公式其の他）を、その成果から抽出することが出来、又せねばならぬ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "生活の陽当りのよい露出面での出来事でもあり瞬間でもあるのだ。",
              "citation": {
                "source": "娯楽論",
                "author": "――民衆と娯楽・その積極性と社会性・――",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時札幌では手不足のため、どんな無能の者でも顔さえ出せば三十銭から三十五銭の手当をもらえたもので、この臨時雇いを出面取りといっていた。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わからんか　畜生、　えへ、金、金だよ、金さえありゃ中学でも大学でも、　一日一円や二円の出面取りが　どうして子供を大学へなんぞやられると思う？",
              "citation": {
                "source": "炭坑長屋物語",
                "author": "猪狩満直",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に我々は木の皮を大きく四角に剥ぎ取り、その平な露出面に小さな丸判を二、三｜捺したのを見た。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
