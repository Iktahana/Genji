        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "テンカンにも色々あるが、風守は人デンカンというのである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "人デンカンという奇妙な業病にとりつかれても、衆に秀でた天才にめぐまれているのであろう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "人デンカンとは世をあざむく計略。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れながらの業病を隠すために人デンカンという奇妙な病人をつくりあげて覆面させたのだろうよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "人デンカンと称して覆面せしめることも、架空のニンシンをはじめた時から予定していたことでしょう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "風守さまの人デンカン、覆面、座敷牢、唯一の御相手たる私、それらはすべて大殿さまと良伯医師と私の父が合議の上で予定をたてた計略でありました。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の三名の召使いがカミナリデンカンだということを一同が知っていたとすると、栃尾がある目的でひそかに忍びこんだと疑うこともできる。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十一　稲妻は見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "分教場の主任は教師の誰かを下宿させるのが内職の一つで、私の前には本校の長岡という代用教員が泊っていたが、ロシヤ文学の愛好者で、変り者であったが、蛙デンカンという奇妙な持病があって、蛙を見るとテンカンを起す。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
