        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "でかんしょ、でかんしょと、山家の猿は、ヨイヨイ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "でかんしょ、でかんしょで、半年ゃ暮らす、ヨイヨイ、あとの半年ゃ寝て暮らす。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三島亭」は古い牛肉店で、戦争前は三高の学生たちがよくこの店でコンパを開いて、「紅燃ゆる丘の花……」　という校歌やデカンショ節をうたいながら、牛飲馬食した。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――デカンショ、デカンショと半年暮す、ヨイヨイ……。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "別にスポンサーがあったわけでもないのに、篠山は先づデカンショ節で古くから広く知れ渡った。",
              "citation": {
                "source": "丹波篠山",
                "author": "平野零児",
                "note": "青空文庫"
              }
            },
            {
              "text": "盃洗でひっかけたり、デカンショに合わせてあおったりするのは邪道である。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "発祥の地は丹波の篠山だが、お国名物のデカンショ節とは縁が遠く、下宿の本棚には、何やら六つかしいものを列べて置くといった肌合いであったと思う。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "平次読む人読まぬ人――三人の政治家――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
