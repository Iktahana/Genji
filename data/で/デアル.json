  {
    "uuid": "d61375db-f7cb-5f9e-a385-fbee3f727a8d",
    "entry": "デアル",
    "reading": {
      "primary": "である",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我輩ハアワレナ男デアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼナラバ、我輩ハ英語ニ於イテ、聞キトルコトモ、言ウコトモ、ソノホカノコトモ、スベテ赤子ノ如キデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミナラズ、カツマタ、我輩ハ肺病デアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ニ伝染ノ可能性スコブル多大デアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神ノ御名ニ於イテ、君ハ非常ニ気品高キ紳士デアルコトヲ認メル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ハ必ズコノアワレナ男ニ同情ヲ持ツデアロウコトヲ我輩ハ疑ワナイノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ハ英語ノ会話ニ於イテ、ホトンド不具者デアルガ、カロウジテ、読ム事ト書ク事ガ出来ル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スランプトハ、コノ様ナ、パッション消エタル白日ノ下ノ倦怠、真空管ノ中ノ重サ失ッタ羽毛、ナカナカ、ヤリキレヌモノデアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "石坂氏ハダメナ作家デアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学ハ、知ヘノ愛デハナクテ、真実ノ知トシテ成立セシムベキ様ノ体系知デアル、ヘエゲル先生ノコノ言葉、一学兄ニ教エラレタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スベテノ言、正シク、スベテノ言、嘘デアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮ハ筏ノ上ノ組ンヅホツレツデアル、ヨロメキ、ヨロメキ、君モ、私モ、ソレカラ、マタ、林氏、寝ル間モ烈シク一様ニ押シ流サレテ居ルヨウダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本居留民ノ生命ヲ保護スルタメニ来タノデアルカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居留民ノ財産ヲ守ルタメニ来タノデアルカ？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イ見ヨ、諸君ハ、現ニ、商埠遙ニ散在シテイル貧窮セル居留民達ノ生命ヲモ財産ヲモ保護シテハイナイノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、工場ヤ、銀行ヤ、病院ヲ守ッテイルダケデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場ヤ、銀行ヤ、病院ハ誰レノ所有ニ属スルモノデアルカ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "労働者、農民ノ出身デアル兵士諸君！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太ッタ大資本家共ハ、鈴文ヤ松駒ノ如キ階級的裏切者ヲ買収シ、諸君カラノ搾取ヲマスマスヤサシクシ、諸君ノ妻ヤ子ヲ、飢ニヒンセシメ、諸君ヲモ絞殺スル反動ノ城塞ヲ固クスルモノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "分割センガ為メニ弾圧スル――コレガ支那ニ於ケル帝国主義者共ノ政策デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東ノ折軍素的占領ハ、コノ計画ノ第二部ノ開始デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍、独裁官田中ハ、諸君ヲ山東ニマデヨコサシメタル田中ハ諸君ノ階級ノ最悪ノ敵デアルコトヲ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴ハ内地ニ於テ、労働者農民ヲ搾取シ、蹂躪シテイル奴デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴ハ諸君ノ兄弟ヤ父ヲ刑務所ニ閉ジコメ、諸君ノ妻ヤ児ヤ、母ヲ虐待シテイルモノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ結核菌ノ所有者デアルガ、現在ノ父ニモ母ニモ結核菌ハナイ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ誰ノ子デアルカ教ヘテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ結果、俺ハ双生児ノ片割レデアルトイフコトガ判明シタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイデアル・センセーション、それが個人的になっておって、とにかくそれを言い現わし、それを実行しなければいても立ってもどうしてもいられない。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
