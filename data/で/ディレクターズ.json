        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "部屋に戻ったぼくは、居間の中央にあるライティング・デスクに両足をあげてディレクターズ・チェアにすわり、パトリシア・リヴィングストンの小説を読みはじめた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "クイーン・サイズのベッド、そしてディレクターズ・チェアがひとつあるだけの寝室だ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱いだ服はディレクターズ・チェアに置いた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディレクターズ・チェアを引き寄せてそれにすわり、彼はテーブルに両足を上げ、ファイルのなかにあった週刊誌の二ページを膝の上に広げた。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビューローの右側に、折りたたんだディレクターズ・チェアが立てかけてあった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
