        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドーヴァへ渡ったときは「エネシング、トゥ、デクレアー」と聞かれ「ノー」と答えた、ただそれだけであった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "荘重なラルゴで始まったのが、アンダンテ、アレグロを経て、プレスティシモになったと思うと、急激なデクレスセンドで、哀れにさびしいフィナーレに移って行く。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このためナポレオンは終に遠征の反対者将軍デクレスと数時間に渡って激論を戦わさなければならなかった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デクレスはナポレオンの征戦に次ぐ征戦のため、フランス国の財政の欠乏の人口の減少と、人民の怨嗟と、戦いに対する国民の飽満とを指摘してナポレオンに詰め寄った。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デクレスは最後に席を蹴って立ち上ると、慰撫する傍のネー将軍に向って云った。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネー将軍よ、さらばである」　ナポレオンはデクレスが帰ると、忿懣の色を表してひとり自分の寝室へ戻って来た。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚カナイデ、ヨクコノ手紙ヲ読ンデクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "３オ染サンガ新聞ヲ読ンデクレタラ日本軍ガ合戦ニ勝ッタソーデスネオジサンモ戦ッタノデスカソシテ敵ヲ殺シタノデスカ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "口ト口ト合ワセナイデ、互ニ一センチホド離レテ、アーント口ヲ開ケサセテ、予ノ口ノ中ヘ唾液ヲ一滴ポタリト垂ラシ込ンデクレタヾケ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣キナガラ予ハ「痛イ、痛イ」ト叫ビ、「痛イケレド楽シイ、コノ上ナク楽シイ、生キテイタ時ヨリ遥カニ楽シイ」ト叫ビ、「モット蹈ンデクレ、モット蹈ンデクレ」ト叫ブ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナシタイコトガアル、ヨンデクレ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アケチノ、トモダチダ、ハヤク、ヨンデクレ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君がデクレレーションを読めば直ぐ分るが、ライト、権利である。",
              "citation": {
                "source": "平和事業の将来",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
