        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宵のうちはその障子に人影が写り「デデンデン」という三味線の撥音と下手な嗚咽の歌が聞こえて来る。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸い求めしこれなる一刀斬れ味試さんと存ぜしやさき、デデン……なんて、すげえなア。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "門落穂の掻き寄せデデン　一月一日　七時｜起床。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デデンがぶらりと遊びに来た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デデンは唖の巳代吉が事である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唖で口が利けぬが、挨拶をする場合には、デデンと云う声を出す。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がデデンと呼んで来れば、デデンと応ずるまでゝある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家に居ると、物差し、箸箱などを電車に見たて、デデンデデンなどといふ音頭を取つて遊んでをる。",
              "citation": {
                "source": "孫",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
