        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノール　（口のうちにつぶやく）智者デュアックは……智者デュアックはどこにおる？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　あれはデュアックだ。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　王さま、御機嫌よろしう！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　狼はおりませぬ。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　デュアック、きかしてくれ、向うの大きな砦には誰が住んでおる？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　（不思議そうに王を見て、やがて、ゆっくりという）あの砦にすむ人は、コノール王、王のお相手の人たち、王の衛兵たち、王の琴手と詩人たち、それから、宮中の婦人たちでございます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　デュアック、お前にはあの婦人室が見えるか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　婦人室は見えまする、コノール・マック・ネサ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアックよ、わが母ネサのまだ若かった折には、あの琴手や詩人どものいうように、それほどに美しかったであろうか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　ネサはあまりにお美しくて、心を痛めずにお顔を見ることが出来た人は尠かったと申します。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　デヤドラは、あなたがお殺しなされて、もう死なれました。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　お二人のおいでなされますあの静寂の中からは、ただお二人のお名だけが、落ちる露のように、落ちてまいります。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　デヤドラはウスナの子ナイシイの側に眠っておられます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　デヤドラは、ウスナの子ナイシイの側に眠っておられます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　もう眼はおさましなさりますまい。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　もう眼はお覚ましなさりますまい。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　コノール・マック・ネサ、お聞きなさいませ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　彼等の若々しい美しいいさましい生命があった時よりも、死んだ彼等の方がなお恐ろしうございます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　「大王コノールがだまし打ちにしたウスナの子たちほど美しい立派な男たちはない」と。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　彼等は刑罰を求めはしませぬ、ただ、王の名誉が汚されたと叫んでおります。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　彼等は「王は我々の理想の像をほろぼした」と申しております。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　「地上の美しさはすでにうたいふるされた古歌のように過去の物となった」と唄うております。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　夢こそはまことに物いうことが出来ます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　愛は、まことは狂気でございます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　デュアックよ、夢は声を出して物いうことが出来るか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュアック　死んでしまうた古い智慧、風、夢――これらのものは、みな声を出して物いいます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノール　（両手を伸して、城の方を見つめながら、立っている）デュアック　あのお眼には、ただ死と美とが見える。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "やわらかに蘆の笛をふきながら）デュアック　うたえ！",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "（デュアックの方に向いて）わしが青年の時分、琴手フェリムの家に行った日のことをお前は覚えているか？",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
