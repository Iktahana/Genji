          "standard": [],
          "literary": [
            {
              "text": "この図中に見る海鼠壁の長屋と朱塗の御守殿門とは去年の春頃までは半ば崩れかかったままながらなお当時の面影を留めていたが、本年になって内部に立つ造兵廠の煉瓦造が取払われると共に、今は跡方もなくなってしまった。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆の話じゃ、明日の晩、宮殿門で合図をして、タラズ老虎がボリス大公にとって代わるそうだ。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば、王允と黄※の二人が、剣を執って、殿門の両側に立っているではないか。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
