        "examples": {
          "standard": [
            {
              "text": "「あー、美味しいものばっかり食べてると、すぐデブっちゃうんだよな。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ダイエットを始めたばかりなのに、誘惑に負けて「またデブるかも…」と不安になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もう、この際デブるだけデブって、それから痩せればいいんだよ！」と友人が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
