        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "されば日本に於ては、一の新しいジャーナリズムが興る毎に、折角出来かけた新文化は破壊されて、跡には再度鎖国日本の旧文化が、続々として菌のように繁殖する。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとたった一枚のくさりかたびらが出来かけのままでいるだけでした。",
              "citation": {
                "source": "野のはくちょう",
                "author": "DE VILDE SVANER",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝着て行く襦袢が、そこに出来かけていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな画が出来かけてゐるのか、こちらからは見えなかつた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "下駄の出来かけ、桐の用材などがうっちゃり放しになっている。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "家に居ないことまでが、何も河野に、道徳的責任がある訳でもないのだが、幾度も重って居る中には、そう云う事からしても、妙な感情上のコジレが出来かけて居た。",
              "citation": {
                "source": "神の如く弱し",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様の頭から石油をブッ掛けて、火を放けて、狂い死させる設備がチャントこの家の地下室に出来かけているんだ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "相当立派な家だったところを見ると、この頃からポツポツ父の社会的地位が出来かけていたものと見える。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "由三は今ようやく出来かけている口笛を吹きながら、手にぶら下ったり、身体にからまって来たり、一人で燥いでいる。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "何となく若いものだけの世界がそこへ出来かけて来た。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し安心が出来かけるとまた親の腹部の感覚と子供の感覚とは全く別物だと気がついた。",
              "citation": {
                "source": "御身",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シラッカリの沢には第一の小屋が出来かけています、今晩はあそこまでの予定らしく、小屋が出来れば下から路ならしをして来ますそうで――もっとも、測量係りだけは前に進みました」「それで？",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の始末さえ出来ず、自分の不心得から、母親や、子供や妹やその他の人々に心配をかけたり、迷惑をさせたりして暮らしていたのだが、かたわら僕の人生に対するハッキリしたポーズが出来かけていたのであった。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月九日（土曜）　宍戸君来、丁度Ｙやっと翻訳出来かけのところ故、つれて並木の花見をする。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "『硝子戸の中』その章をお読みなさった大塚｜保治博士は、「漸く忘れようとすることが出来かけたのに、あれを見てからまた一層思いだす。",
              "citation": {
                "source": "大塚楠緒子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "その覚悟はしていたのだが、耐えられないのは、日本橋に出ている芸妓に、美妙の子供が出来かけている――ということだ。",
              "citation": {
                "source": "田沢稲船",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女にもよい客が出来かけた。",
              "citation": {
                "source": "お墓のすげかえ",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しずつ個性が出来かけて、溌剌とした心身の営みを示してくる、三歳以上の子の生長を、彼女等は落付いてゆっくり見守る隙がない。",
              "citation": {
                "source": "都会に於ける中流婦人の生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "形式及び、言語の制約、聯想上の特別な約束、さうした物の出来かけた時代であつた。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "顕輔系統と俊頼系統との外に、尚幾流も、さうした半成立の歌学伝統が出来かけて、一二代で、伝統を失ふ者もあつた。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "此つぎと、氏々・官司の本事（略してこととも言ふ）とを混淆して、一列にしぬびごとと称せられ、又宣命の形式のまゝで、漢文風の発想を国語でするしぬびごとも出来かけた。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々は折角出来かけた東洋平和の基礎が、際どい処で覆されたと思って失望したのだが、併し雨降って地固るの喩えもある通り、外務省式の二階から目薬的な日支親善の代りに、北支事件の結果成功しそうに見えたものは、もっと手近かの「北支経済援助」だったのである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々は折角出来かけた東洋和平の基礎が、際どい処で覆されたと思って失望したのだが、併し雨降って地固るの喩えもある通り、外務省式の二階から目薬的な日支親善の代りに、北支事件の結果成功しそうに見えるものは、もっと手近かの「北支経済援助」だったのである。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、もうそれは、曲りなりにも、一家の流儀といふものが出来上り、または出来かけたところでありますから、老人は、それを見て見ぬふりをしてゐる。",
              "citation": {
                "source": "青年の矜りと嗜み",
                "author": "――力としての文化　第四話",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、玩具の船が出来かけてゐる。",
              "citation": {
                "source": "ゼンマイの戯れ（映画脚本）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、昼間はそうやって歩きまわり、夜は夜で、落ちついてゆうべの仕事をつづけるなんという真似のできない僕のことだから、いっそこのまま出来かけの仕事をもって東京へ帰った方がいいのではないか、とまあそんな事も一とおりは考えに入れたうえの決心なのだ。",
              "citation": {
                "source": "大和路・信濃路",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに幕府が鎌倉からして京都に移されるとともに、せっかく鎌倉に出来かけた新しい文明の気運はここに萎靡し果てて京都のみがまた旧のごとく文明の唯一中心となるに至った。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一部の人たちから、文学座の俳優の演技には、一つの古い殻が出来かけているというようなことが言われているとき、そういう殻をだん／＼にふるい落す、一つの契機になつていると思う。",
              "citation": {
                "source": "女優の親",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、陛下を制限から除外する確約を得ないうちに、無条件降伏したことを不満に思うものがこの艦にもいて、不穏な空気が出来かけ、司令部から島野参謀が説得に来られたのですが、馬鹿なやつのために怪我をなすったのです。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
