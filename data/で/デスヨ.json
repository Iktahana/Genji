        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ステッキはコチラデスヨー」などという極めてプロレタリアンな声が、労働階級の細君ででもあるらしい下足番の口から響いて来る。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛行機ハ、秋ガ一バンイイノデスヨ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホントウニ　ソウデスヨ、ワタシモ　ハヤク　ボウヤニ　コノ　ヨイ　セカイヲ　ミセテ　ヤリタクテ　タマリマセン」ト　ウマハ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ　ヒラカナイ　ツボミサン　モウ　ハルデスヨ、オンモニ　デテ　イラツシヤイ」「マダ　ネンネシテル　ツボミサン　オメメヲ　サマシナサイ」　スルト　ツボミガ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソノ　トキ　マドカラ　ミテ　ヰタ　オウマノ　ヲバサンガ、「テフテフデスヨ」ト　花タチニ　シラセマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴカキハ、「ダンナ　カンチガヒデスヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノライヌメガ　ウルサク　ツイテ　キタノデ、タニガワヘ　ホリコマウト　イツテタンデスヨ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア、チヒサイネ」「コドモデスカラネ」「コレデハ、オトナニ　ナツテモ　アマリ　オホキク　ナリマスマイ」「イヤイヤ　オトナニ　ナツタラ、コヤクラヰノ　オホキサニ　ナル」「ダマサウタツテ　ダメダヨ」「ホントウデスヨ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（邪魔ニサレルコトダッテ度々デスヨ！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ真面目ナ話デスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今年ハソノ割ニ雨ガ降ラナカッタジャナイカ」「モウ今日ハ草市デスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコト知ルモンカ」「マ、アッタンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本バンタム一位ノ坂本春夫ガタイノバンタム一位ノシリノイ・ルクプラクリスヲノック・アウトシテ初代チャンピオンガ生レタアノ晩デスヨ、―――」ソノシリノイ・ルクプラクリスト云ウ名ヲ陸子ハ流暢ニペラ／＼ト云ッテ退ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ颯子モイルコトダシ、―――颯子ハ南禅寺ヘ泊ルノハ懲リ／＼ダカラ、ソレダケハ堪忍シテクレト云ッテルンダ」「ドッチニシタッテ颯子ガ行ッタラ又喧嘩デスヨ」「掴ミ合イデモ始メテクレタラ面白イサ」婆サントソンナ遣リ取リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアニ、明日日曜ナンデミンナ遊ンデイルンデスヨ」京都駅ハ下リノ時ハブリッジヲ沢山登ラナケレバナラナイノデ、コレガ甚ダ億劫デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデ結局墓石ノ形式ハドレニオ決メナサイマスカナ、実ニイロ／＼ト専門家モ及バヌホド御存知デイラッシャイマスノデ、私ナゾハ何トモ申シ上ゲヨウガゴザイマセンガ」「僕自身モドウシテイヽカ分ラナイノデ迷ッテルンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
