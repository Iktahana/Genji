          "literary": [
            {
              "text": "『私ハソビエト社会主義共和国連邦ノタメニ命ゼラレタコトハ何事デアッテモ行ウコトヲ誓イマス。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ如何ニ技巧ガ巧妙デアッテモ、モト／＼予ノ趣味デハナカッタノデ、タッタ一遍好奇心ヲ満足サセタヾケデ、ソレキリ同性ト関係シタコトハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ鏡ノ中ノ顔ガモット醜悪デアッテクレタラ、颯子ガ尚コノ上ニモ優秀ニ見エタヾロウニト残念ニ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事ニヨッタラ範囲ヲ蹈ミ越エタノデハアルマイカ、ト、多少疑イヲ抱カセルクライデアッテモヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "情事ノハアルケレドモ、ソレモ上半身ノ一部ニ限ラレテイタノデアッテ、情事ニ必要ノナイトコロハ絶対ニ見セテクレナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハタダ手デ触ッテミテソノ形状ヲ想像シ、相当素晴ラシイ肉体ノ持主デアロウト考エテイタノデアッテ、ソレユエニコソ白光ノ下ニ曝シテ見タイトイウ念願ヲ抱イタワケデアッタガ、サテソノ結果ハ僕ノ期待ヲ裏切ラナカッタノミナラズ、ムシロハルカニソレ以上デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダシ現在ノトコロデハ、記憶喪失トイッテモ思イ出セナイノハ主トシテ人名ヤ地名デアッテ、事柄ヲ忘レテイルノデハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワドケレバキワドイホドヨイ」、―――「多少疑イヲ抱カセルクライデアッテモヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
