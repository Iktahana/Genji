  {
    "uuid": "aa53e9bf-a37d-5903-99d3-3819e405e115",
    "entry": "デアロウ",
    "reading": {
      "primary": "であろう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君ハ必ズコノアワレナ男ニ同情ヲ持ツデアロウコトヲ我輩ハ疑ワナイノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ハソノ期間ニ、我輩自身ヲ我輩ノ私室ニ密閉シ、君ノ文章ヲ研究シ、シカシテ、我輩ノ答ヲ、我輩ノ能力ノ最大ヲ致シテ書キシタタメルデアロウ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨロシク一千年ノ間シンボウ強ク今日ノ日ヲ待ツテイタカタカナヲ登用スベキ時期デアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他日本文化ノ普及ニ役立ツコトハ非常ナモノデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ問題ハオソラクソノアトノ場合デアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシマズ最初ニ新聞ダケデモカタカナニナツテシマエバアトハ割合ラクデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシコノ注意ヲ守ラナケレバ、現代ノ世界人類ハ最大ノ不幸ニオチイルデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッテヤルトイウナラ、余ハ世界人類ノ不幸ヲ救ウタメ、カワッテソノ暴挙ヲ思イトドマラスデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "深イ注意ヲモッテカカル人間ニ対シ適当ナ電波的保護ヲ急グノデナケレバ、世ノ中ニハ「手ニオエナイ神経病者」トイワレルモノガ年ト共ニ激増スルデアロウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ本書ニ説述シタ吾ガ田内整形手術ガ全世界ニ普及セラレタル暁ニハ、世界中ニ只一人ノ醜イ人間モ存在シナクナルデアロウ云々」　実に大胆なるヒルミ夫人の所説だった。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六ハ初役デアロウガ、ヤハリドウモ感心出来ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレラノ婦人達ハ実際ニハ善良ナ婦人ナノカモ知レナイガ、モシ本当ニ悪人デアリ、ソレト同棲―――ハ出来ナイマデモ、セメテ身近ニ住ミ、接近スルコトガ出来タラドンナニ幸福デアロウカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ颯子ヲ愛スルノハ、彼女ニイクラカソンナ幻影ヲ感ズルセイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デモ本心ハ善良ナノデアロウガ、イツノマニカ偽悪趣味ヲ覚エ、ソレヲ自慢ニスルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシタ方ガコノ老人ノ気ニ入ルコトヲ看テ取ッタカラデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "病苦ヲ怺エルト云ウコトガ、正常ナ性ノ快楽ガ享受出来ナイト云ウコトガ、人間ノ根性ヲ斯クモヒネクレサセルノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女モ佐々木ノベッドヲ嫌ッテ、長椅子デ寝ル積リナノデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、彼ガシャワーニ来ルノハ午後カラ夕刻マデノ間、多分颯子ガ浴ビルノト同ジクライナ時間デアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ガ浴室ニイル時、アスコノドーアハマサカ開ケッ放シニハシテ置カナイダロウ、ソノ時ハ戸締マリヲスルデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、モシ予トオ静トガ打ツカラナカッタラ、予ニ知レタコトヲ彼等ハ気ヅカズニイタデアロウ、トスルト、オ静ガ予ト行キ遇ッタコトハ、マダシモ仕合セダッタト云エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子自身モ自分ニソウ云ウ才能ガアルコトヲ、ソノ時マデハ知ラナカッタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ト二人キリノ時ニモ、嘗テ愛情コマヤカナリシ時代ニハソンナ風ダッタデアロウガ、今デハソウデモナサソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト浄吉トノ結婚ヲ、予ノ妻デサエアンナニ激シク反対シタノデアルカラ、アノ時分マデ母ガ長生キシテイタラ、ドンナニ反対シタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ日本人ノ女ガ六十餘年ノ歳月ノ間ニ斯クモ変遷スルモノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ハ明治十六年ニ生ンダ我ガ子ノ督助ガ、ナオモコノ世ニ生存シテイテ、コノ颯子ノヨウナ女、而モ彼女ノ義理ノ孫、彼女ノ孫ノ正妻デアル女―――ニ浅マシキ魅力ヲ感ジ、彼女ニイジメラレルコトヲ楽シミ、自分ノ妻、自分ノ子供達ヲ犠牲ニシテモ彼女ノ愛ヲ得ヨウトスルノヲ、何ト思ウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ丈夫デサエアレバコンナ秋日和ノ日ハドンナニ爽快デアロウ、予モ四五年前マデハソノ爽快味ヲ満喫シテイタノニト思ウト、クヤシクモ忌マ／＼シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ニ感ヅカレタデアロウト思ウト、何ヨリ癪ダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ京都ノ花ノ先生ガ来タノデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ颯子ガコノ老人ノタメニ心ヅクシヲ示シタノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅ト白トノコノ対照ヲ五子ノ前デ見セビラカスノガ目的ダッタノデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
