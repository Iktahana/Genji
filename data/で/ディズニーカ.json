        "examples": {
          "standard": [
            {
              "text": "かつての活気ある市場が、観光客向けの土産物店ばかりになり、すっかり「ディズニー化」してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "観光地のディズニー化が進み、地元の文化や雰囲気が薄れつつあると批判する声がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "街全体がディズニー化されたような清潔感と人工的な演出に、旅行者は驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "設立の年の暮れ近くになって舞い込んだディズニーからの八台の注文と「ファンタジア」の成功は、高品質の測定器メーカーを目指したＨＰにとって、強い追い風となった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
