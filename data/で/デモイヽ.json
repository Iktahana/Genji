        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何トカ出来タラ一夕彼ヲオ座敷ヘ呼ビ、舞台デ見タ通リノ女装ヲサセテ、チョットデモイヽカラ一緒ニ寝テミタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽマデ来タンダカラチョット伊勢丹ヘ寄ロウ」ト、婆サンノ反対ヲ豫期シテ云ウト、「又冷房デモイヽンデスカ、コノ暑イノニ早クオ帰リニナッタラドウ」ト果シテ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モハヤ人生ニ疲レタ、トデモ云ウノダロウカ、イツ死ンデモイヽ気ガシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ春久ト限ッタコトハナイガネ、甘利デモ誰デモイヽガネ」「四阿ヘ来ルト、キットコンナ話ニナルノネ、チット散歩シマショウヨ、足ノ運動バカリデナク、頭ニモ毒ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ハドウデモイヽッテ云ウカモ知レナイケレド、浄吉ハコノトコロ旅行バカリシテタジャナイカ」「ソレガ何ナノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又ソンナモノニ寝ルノカイ」「何デモイヽカラオ爺チャンハ黙ッテオ休ミナサイ」「籐椅子ナンゾジャ風邪ヲ引クヨ」「風邪ヲ引カナイヨウニ毛布ヲ沢山持ッテ来サセルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ダケド話ハ伺イマシタ、アンタナンカイタラ邪魔ダカラ何処カヘ行ッテラッシャイッテ、追イ出シタノヨ」「ソレデモイヽ、ダガモウ一人邪魔ナ人間ガイル」「ハイ、ハイ、分ットリマス」ソウ云ッテ佐々木モ早速気ヲ利カシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコト、子供ガ心配シナイデモイヽ、オ前モウ寝ル時間ジャナイカ」「僕寝テタンダヨ、内證デソット見ニ来タンダヨ」「オ休ミ、オ休ミ、子供ガ餘計ナ………」コヽマデ云ッタト思ッタラ、ドウシタ加減カ声ガ鼻ノ奥デ詰マッテ不意ニ涙ガパラ／＼ト落チタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエイケマセン、二十八日ニ決メテ下サイ、アタシモソノ日ハツイテ行キマス」「婆サンナンゾ来ナイデモイヽ」「イヽエ参リマス」「ソウシテ戴キマシタ方ガ、私モ安心デゴザイマス」ト、佐々木マデガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンナ石ノ下デモイヽト云ウ訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウセ予ハ神佛ヲ信ジナイ、宗旨ナドハ何デモイヽ、予ニ神様カ佛様ガアルトスレバ颯子ヲ措イテ他ニハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久シュウオ目ニカヽリマセンデシタガ、相変ラズオ元気デイラッシャイマスナ」「ナアニ、チットモ元気ナコトナンカナイヨ、今度ハ京都ヘ自分ノ墓地ヲ捜シニ来マシタ、イツ死ンデモイヽヨウニネ」「御冗談デショウ、ソノ勢イジャアマダ／＼大丈夫デイラッシャイマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食堂ヘ行カナイデモイヽジャナイカ、コヽニ鮨ガコンナニ残ッテル、コヽデコレヲ食ベナサイ」「ソウ、デハソウスルワ」「君ト鱧ヲ食ベルノハ浜作以来ダナ」「ソウダッタワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコトハ聞カナイデモイヽ、マア鱧ヲ食イナサイ」ソンナツモリモナク若イ時分ニ何気ナク見テ置イタコトガ、ドンナ時ニ役ニ立ツカ分ラナイモノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
