        "examples": {
          "standard": [
            {
              "text": "会社の組織はいくつかのディビジョンに分かれており、それぞれが専門の業務を担っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "サッカーのリーグ戦では、各チームが上位ディビジョンを目指して競い合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大規模なプロジェクトは、効率化のために複数のディビジョンに分割された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ディヴィジョン・オヴ・レーバーがなくなり、われら自身が土方のようなことをやらせられるのである。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "関西に本社のある大きな繊維会社が、ブルージーンズの部門を新設し、さらに、サブ・ディヴィジョンのようなかたちで、ジーンズを主体にした子供服のブランドをつくり、製作と販売に乗り出している。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サブディヴィジョンの他の根拠は元素構成、味（甘み、酸味、塩味、シャープ、苦味、収斂性）、変化し易さ（消化過程における）、性質、加熱または冷却、柔らかさ、乾き易さ、洗浄性、滑らかにする、などである。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
