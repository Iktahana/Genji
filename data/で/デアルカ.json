        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "諸君ハ、日本居留民ノ生命ヲ保護スルタメニ来タノデアルカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居留民ノ財産ヲ守ルタメニ来タノデアルカ？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場ヤ、銀行ヤ、病院ハ誰レノ所有ニ属スルモノデアルカ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ誰ノ子デアルカ教ヘテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "書ク文字ト活字ハチガツテアタリマエナノデアルカラ気ニスル必要ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると信長は、「デアルカ」　と云って柱からはなれ、シキイの内へはいって、それからテイネイに挨拶した。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍臣が信長に歩みより、こちらが斎藤山城殿でござります、というと、柱にもたれた信長は、「デアルカ」　と言った。",
              "citation": {
                "source": "織田信長",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ行為ニヨッテ害ヲ被ッタ者ガアリトスレバ、モトヨリ彼等ガ不正ナノデアルカラ、従ッテ何等気ノ毒ニ思ヒヤウハナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ以上ノ具体的ノ事ハ釈放時ノ事情ニヨッテ決スルノデアルカラ今カラ何トモ言ヘナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モアノ若サデアノ大役ヲスルノデアルカラ無理モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長男ノ力ガ、マダ大学ノ二年生デ早過ギルノダケレドモ、恋人ガ出来テ結婚サセテクレト云ウノデ、許スコトニシタ、ガ、若イ二人ヲアパートナドニ別居サセテオクノハ不安デアルカラ、力ガ卒業シテ就職スルマデハ手許ニオイテ夫婦生活ヲサセヨウト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ顔ノ女ヲ見ルト、顔ダケデナク、性質モ残虐デアルカノヨウニ思イ、又ソウデアルコトヲ希望スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様ナ場合、浴衣ヲ借リルクライハイヽガ、階下ノ客間ナリ応接間ナリ茶ノ間ナリ、今ハ婆サンモ留守デアルカラ至ルトコロガ空イテイルノニ、二階ヘ上ルニハ及ブマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ経口剤デアルカラノブロンヨリハ気持ガイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ書ハ昔或ル美術商カラ手ニ入レタモノダガ、荷風ノ書ハ非常ニ偽筆ヲ上手ニ書ク男ガイタソウデアルカラ、コノ幅モ真偽ハサダカデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯ノ間カラ莨入レト煙管ノ袋ヲ取リ出シテ一服吸ッタ様子デアルカラ、茶ノ間ニ坐ッテイタヨウデモアルガ、イツノ間ニカ門外ヘ出タラシク、素足ニ吾妻下駄ヲ穿イテ歩イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト浄吉トノ結婚ヲ、予ノ妻デサエアンナニ激シク反対シタノデアルカラ、アノ時分マデ母ガ長生キシテイタラ、ドンナニ反対シタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ明治生レデアルカラ背ガ低ク、五尺二寸アルカナシダガ、颯子ハ予ヨリモ一寸三分高ク、一六一センチ五ミリアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ腹ノ中ヲ隅カラ隅マデ見抜イテイル彼女デアルカラ、マサカ悪ク取リハシマイト思ウガ、………「ソウダ、ヤッパリ会ッタ方ガイヽカナ、二三日ウチニ機会ヲ窺ッテ何トカ巧ク持チカケテ見タラ、………」今日ノ午後、フト予ハ考エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空ットボケルノガ名人デアルカラ、彼女ハ例ノ如ク得々トシテ有楽座ヘ出カケテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "福島博士モ殊ニ重大ナ場合デアルカラ当然ソレダケノ手順ヲ蹈ンダ訳デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ厄介ナノハ、立像ヲ製作スル彫刻家ニハモデルガ何者デアルカヲ知ラセナイ訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミナラズ、モデルガ誰デアルカト云ウコトヲ彫リ手ニ知ラセズニ彫ラセルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ何故デアルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食ノ時ニ食堂ニ見エナカッタノハ、朝寝坊ノ彼女ノ常デアルカラ、予ハマダ颯子ハ寝テイルモノト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ事実デハナク、僕ノ単ナル妄想デアルカモ知レナイガ、デモソノ妄想ヲ僕ハ無理ニモ信ジタカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
