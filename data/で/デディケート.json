        "examples": {
          "standard": [
            {
              "text": "この歌は、亡くなった友人に捧げられた（デディケートされた）ものです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はその功績を、母にデディケートしました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しい図書館の開館式典で、市長はその建物に市の創設者の名をデディケートしました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その上フランケッティは私のために、日本を題材にしたオペラを作ってデディケートしたいとさえいってくれました。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　原著はマーガレット・ブルックス嬢へ、デディケートしてあります。",
              "citation": {
                "source": "日本その日その日",
                "author": "訳者の言葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまに登る人は奥さん方で、これでは著述をデディケートするわけにも行かない。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「我等に先立ちたる、我等と共にある、我等の後に来るべき、すべての登山者に」この本はデディケートしてある。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステート・ハイウエイ７８の、メンフィスからテュペロまでの間は、エルヴィス・プレスリーにデディケートされている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互がお互の秘密を公開するのはそれが必要にかられているからで、お互が精神にデジケートする古代ではなかった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互がお互の秘密を公開するのはそれが必要にかられているからで、お互が精紳にデジケートする古代ではなかった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく書かない振事劇を書いて、喜の字のお祝いにデジケートすることで、もとよりこれは「燦々会」同志の労をかりて、先生に読んで頂くばかりでなく見ていただく心組みだったのだ。",
              "citation": {
                "source": "古い暦",
                "author": "――私と坪内先生",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの人の知るごとく、この曲は最初、チャイコフスキーがアウアーにひかせるつもりで、デジケートまでしたのであるが、技巧上演奏不可能という理由でアウアーがその初演を拒絶し、久しく顧みる者もなかったのを数年後、ブロドスキーが楽譜を一見して、驚くべき魅力を発見し、進んで初演を引き受けて有名になった曲である。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
