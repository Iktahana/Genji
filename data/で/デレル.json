    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ロップ、一時は駄じゃれで君をメキシコ湾だと云ったが、僕の純情知ってくれたか。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "庵室の客人が、唯今申す欄干に腰を掛けて、おくれ毛越にはらはらと靡いて通る、雪のような襟脚を見送ると、今、小橋を渡った処で、中の十歳位のがじゃれて、その腰へ抱き着いたので、白魚という指を反らして、軽くその小児の背中を打った時だったと申します。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白垢の真白なのが、ころころと仰向けに手をじゃれながら足許を転がって行きます。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "真向うは空地だし、町中は原のなごりをそのまま、窪地のあちこちには、草生がむらむらと、尾花は見えぬが、猫じゃらしが、小糠虫を、穂でじゃれて、逃水ならぬ日脚の流が暖く淀んでいる。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日ほどまえから、黄昏どきになると一束の花を持ってここへ電車でやって来て、東京市の丸い紋章にじゃれついている青銅の唐獅子の下で、三四時間ぐらい黙って立っているのである。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、私は、内に針を含んだ言葉を、精いっぱい優しく、いや味をきかせて言ってやることもあるのだが、犬は、きょろりと眼を動かし、いや味を言い聞かせている当の私にじゃれかかる。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "何というゲスな駄じゃれ。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんのじゃれてやってみせたことであったが、花嫁はころりところんで死んだ。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんまりじゃれつきよると競争に行くぞ！",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、とうとう、やって来た」　満腹するとすっかり子供に返ってしまって、誰とでもじゃれて遊びたい仔犬のように、さっきから身体中に弾力の渦巻を転々さして、興味の眼を八方に向け放っていたむす子は、そういって、おかしさに堪え兼ねるように肩を慄わして笑った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその特性は自分もあまり好かないものであるのにかかわらず、この時はなんだか聴衆の悪じゃれを不愉快に感じた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "青く芽を吹いた芝生の上のつつじの影などに足を延ばして横になっている親猫に二匹の子猫がじゃれているのを見かける事もあったが、廊下を伝って近づく人の足音を聞くと親猫が急いで縁の下に駆け込む、すると子猫もほとんど同時に姿を隠してしまう。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳の上におろしてやると、もうすぐそこにある紙切れなどにじゃれるのであった。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもは夜子供らが寝しずまった後に、どうかすると足音もしないで書斉にやって来て机の下からそっと私の足にじゃれるのを、抱き上げてひざにのせてやると、すぐに例のゴロゴロいう音を出すのであったが、その夜はもとよりいないのだから来るはずはなかった。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう紐切れやボールなどにはじゃれなくなった後でも、鋏を持って庭におりて行く私の姿を見るとすぐについて来るのであった。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかくも普通のじゃれ方とはどうもちがう。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃれる品物の中でおもしろいのは帯地を巻いておく桐の棒である。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "急にじゃれついてきて、わたしを興奮させたり、うっとりさせたかと思うと、こんどは手の裏を返すように、わたしを突っぱなして、彼女に近寄ることも、その顔を眺めることも、できないような羽目に落してしまう。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕自身はホップの商いをやってますが、七〜八〇〇ポンドの収入があるので、自分たちだけでも不自由なく、ノーベリに年八〇ポンドのこじゃれた屋敷を持ってます。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の間の小道では、とても楽しそうに子どもたちが走り、大きくきらびやかなチョウチョ一羽とじゃれあっていました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "威勢のいい赤は依然として太十にじゃれついて居た。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎は――普通想像されるように、足をちぢめ揃えて、跳びかかるような姿勢ではなくて――猫がものにじゃれる時のように、右の前肢をあげて、チョッカイを出すような様子で、前に進み出そうとしている。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、ある時その猫が何かにじゃれて、床の間に飛びあがったはずみに、そこに置いてある碁盤に爪を引っかけて、横手の金蒔絵に疵を付けました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "背戸に干した雨傘に、小犬がじゃれかかって、蛇の目の色がきらきらする所に陽炎が燃えるごとく長閑に思われる日もあった。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この帯へじゃれ付いて、いきなり頭を張られたのはこないだの事である。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤十郎の部屋のすぐ隣から、大経師以春に扮した中村四郎五郎と召使お玉に扮した袖崎源次とが出て来る）四郎五郎　（源次の袖を捕えながら、ちょっと所作をして）どうも、お前にじゃれかかるところが、うまく行かぬのでのう。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュピターが扉をあけると、ルグランの飼っている大きなニューファウンドランド種の犬が跳びこんで来て、私の肩に跳びつき、しきりにじゃれついた。",
              "citation": {
                "source": "黄金虫",
                "author": "THE GOLD-BUG",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が腰かけているときにはいつでも、椅子の下にうずくまったり、あるいは膝の上へ上がって、しきりにどこへでもいまいましくじゃれついたりした。",
              "citation": {
                "source": "黒猫",
                "author": "THE BLACK CAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその仔犬たちは私の手許にとんで来てじゃれついた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
