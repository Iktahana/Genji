        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イギリス人は紳士道の一つとしてデュティー・ファーストと教えます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしデュティとは何でしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "インドに向って船を駆ってゆくそれはデュティであったのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デュティー・ティリンガストという名の、生まれが良く社会的に汚点のない男鰥で、その一人娘のイライザが、跡取り娘であるという点を除いて、考えられる全ての利点を備えているようだった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊＊　ガスコーニュの貴族にマルタン・ゲールというものがあり、結婚して間もなく見えなくなったが、やがて彼によく似たアルノー・デュティルという者が現われて、この妻に二人の子を産ませた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが或る日、本当のマルタンが帰って来て、デュティルを訴えた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局デュティルは魔法を使ったのだということになり、死刑に処せられた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
