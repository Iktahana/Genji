          "literary": [
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハ大ヘンモノヲ大切ニスル子デシタカラ、イツモ、ボンコチヤンヲブラツシデ、テイネイニハイテ、テイレヲイタシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニヤンコチヤンハオシヤベリデシタカラ、アルヒ、モンコチヤンニイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
