          "literary": [
            {
              "text": "」「デゾージエ（訳者注　当時歌謡の作者）が好きだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "デゾージエの赤縁のコップはバラトロンの大杯にも匹敵する。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "先頭に道を開いていた馬車の一群は、当時有名なデゾージエの雑曲ヴェスタの巫女を、粗暴な元気さで大声に調子を取って吟じ出した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
