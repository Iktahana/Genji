[
  {
    "uuid": "af2f3bd4-6c5e-538f-954d-29b285fffdad",
    "entry": "伝承",
    "reading": {
      "primary": "でんしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
