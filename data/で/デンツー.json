        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "名物食堂の四階レストランデンツーの招待日で、ポタアジュ、ブフアラモド、冷鶏とシャベット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時、デンツーへ寄り、スープと平目のフライを食って、座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンツーへ寄り、ビフテキを食った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "石田守衛を連れて、デンツーで夕食、ポタアジュと鶏カツ食って、芝浦のサーカス、ベルハムストンの天幕へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンツーで樋口と食事、ニキチャップとブフアラモード。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "少憩の後、「金色」の歌を八時すぎ迄やり、名物食堂デンツーで又食った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンツーで、ポタアジュとブフアラモドを食って有楽座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の部終って名物食堂へ堀井と行き、デンツーで、ポタアジュと、ブフ・アラモド。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "母上・道子今日有楽座見物なので日比谷へ出て、デンツーで食事。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋口とデンツーの食事、こゝは家庭料理の味。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子同道、名物食堂のデンツーへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンツーで二戸と食事、日比谷で「大地」の後半を見る、蝗の来襲のとこ面白かった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物食堂へ寄りデンツーでポタージュとえびのニューバーグを食ひ、五時座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物食堂のデンツーで、鶏のクリーム煮とスパゲティ食べて座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物食堂のデンツーで、ブフ・アラモドとスパゲティを食ひ、座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
