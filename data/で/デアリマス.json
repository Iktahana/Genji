  {
    "uuid": "0895bc0a-8512-58c6-b4f3-734195a84cc5",
    "entry": "デアリマス",
    "reading": {
      "primary": "であります",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
