      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "be",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "本日は晴天であります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の意見は、まさに的確であります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私はこのプロジェクトの責任者であります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さて暫く案じた揚句、大抵はお断りすることとなるのでありますが、今もよつぽどお断りしようかと思つた所でありました。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色々と詩論は毎月の雑誌にも現れてをりますが、此の雑誌に訳載中のアランの論文と、それからこれは直ちに詩論と呼べる限りのものではありませんが、フィードレルの芸術論、まづまづ此の二つが此の数年来に読みました詩論の中で心に残つたものであります。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、新精神の、精神してゐる所はよく分るつもりであります。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一言で云へば、必竟偶然を排し詩を判然と人間の意識の手中に収めたいといふ精神と云ふことが出来るかと思ひますが、それが判然と実現出来れば、全く喜ばしいことであります。",
              "citation": {
                "source": "近時詩壇寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "病気の軽重で、処分の軽重を決めたといふ校長の頭の程は、凡そ奇ッ怪なものでありますが、或ひは此の校長が、その地では人望のある、謂はば人格者かも知れないのです。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく、アツサリ取消しはなかつたことと、私は思ふのであります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "茲に見る例は、如何にも馬鹿げて見えませうが、凡そ大概のことが、猶此の程度には馬鹿げてゐるのが、奈何せん実情であります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "技術堪能そのものが登用される場合は極めて稀であります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論外国にしろ、多少とも此の世の中は左様なものではありますが、高い程度の技術ではともかく、凡そ常識の既に認める範囲にある技術では、我が国程に台所情実は場を占めてないやうであります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私思ひますに、我が国人の素質は非常によく、開化の段階は猶低いのであります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "開化の段階の低いことが、一朝一夕にして高まることはなく、多くの個人の不撓の努力を要することは勿論でありますが、何れにしろ事態打開の先づ第一歩は、「若い身空でイヤな病気」と感ずる前に、「病気の軽重と処分の軽重」が判明に頭なり良心なりに来ること、それに違ひはないと思ふのであります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今官一とは、同郷であります。",
              "citation": {
                "source": "田舎者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼も、なかなかの、田舎者ですが、私のさとは、彼の生れ在所より、更に十里も山奥でありますから、何をかくそう、私は、もっとひどい田舎者なのであります。",
              "citation": {
                "source": "田舎者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "国技館の角力を見物して、まじめくさり、「何事も、芸の極致は同じであります。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事も、生活感情は同じであります、というならば、少しは穏当である。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそ、至難の事業であります。",
              "citation": {
                "source": "政治家と家庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「日本主義とはなんでありますか？",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またかつて私たちの敬愛の的であった田舎｜親爺の大政治家レニンも、常に後輩に対し、「勉強せよ、勉強せよ、そして勉強せよ」と教えていた筈であります。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいまジャーナリズムのヒステリックな叫びの全部に反対であります。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がきょうまで、がまんしてあなたにお手紙差し上げなかったわけは、すべて僕の自信の無さからであります。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、貧しく、無能であります。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ言葉で、その言葉には、みじんも嘘が無いのでありますが、ただ言葉で、あなたへの愛の証明をするよりほかには、何ひとつできぬ僕自身の無力が、いやになったのです。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺町の呉服屋の、豊田様であります。",
              "citation": {
                "source": "青森",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はことし三十三であります。",
              "citation": {
                "source": "私の著作集",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまの私にとって、一日一日の努力が、全生涯の努力であります。",
              "citation": {
                "source": "私信",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "無邪気に信じている者だけが、のんきであります。",
              "citation": {
                "source": "私信",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひそかに読書もしている筈であります。",
              "citation": {
                "source": "自信の無さ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、この世紀の姿を、この世紀のままで素直に肯定したいのであります。",
              "citation": {
                "source": "自信の無さ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
