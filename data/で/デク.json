  {
    "uuid": "8bcf1983-7124-55a7-a940-0af6ebe36076",
    "entry": "デク",
    "reading": {
      "primary": "でく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドーヴァへ渡ったときは「エネシング、トゥ、デクレアー」と聞かれ「ノー」と答えた、ただそれだけであった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "荘重なラルゴで始まったのが、アンダンテ、アレグロを経て、プレスティシモになったと思うと、急激なデクレスセンドで、哀れにさびしいフィナーレに移って行く。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "餘り達者でない・公學校式の角張つた日本語で、ウチヘハイツテ、休ンデクダサイと言ふ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り達者でない・公学校式の角張った日本語で、ウチヘハイッテ、休ンデクダサイと言う。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その和約の席上で、テオドリッヒは家臣に命じ、ハイデクルッグの弓でオドワカルを狙わせたのであったが、弦が緩んでいて、目的を果せず、やむなく剣をもって刺殺したのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、貴方がオドワカル殺しの故智を学ばれたのは、さすがだったと思います、御承知でしょうが、テオドリッヒの用いた弓の弦と云うのは、木の繊維で編んだ、ハイデクルッグ王（北独逸ゲルマン族の一族長）からの、虜獲品だったのですからね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジクッスの弟ポリデクテス、この島の王たり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し念のためにお断りしておくが、その実験をやっている吾輩ばかりが、精神に異状の無い、太平無事のデクノ坊だと誤診されては迷惑だよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スピノザは肺病で死んだことになっているが、実はアムステルダムの一医師に殺されたんだよ、デクインシーと云う人が其れを検べて、自分の著書へ公然と発表しているんだから、間違いはないのさ。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り、此の本をやるから……」彼はデクインシーの本と云うものを私の手の上へ乗せた。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどうしてもデクインシーの著書を読む事が出来なかった。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、デクの棒みたいに立ってる発言権なしのね。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し敵だって、デクな人形ではない。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る楼へ遊びに行ったら、正太夫という人が度々遊びに来る、今晩も来ていますというゆえ、その正太夫という人を是非見せてくれと頼んで、廊下鳶をして障子の隙から窃と覗いて見たら、デクデク肥った男が三枚も蒲団を重ねて木魚然と安座をかいて納まり返っていたと笑っていた。",
              "citation": {
                "source": "斎藤緑雨",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "このためナポレオンは終に遠征の反対者将軍デクレスと数時間に渡って激論を戦わさなければならなかった。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デクレスはナポレオンの征戦に次ぐ征戦のため、フランス国の財政の欠乏の人口の減少と、人民の怨嗟と、戦いに対する国民の飽満とを指摘してナポレオンに詰め寄った。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "デクレスは最後に席を蹴って立ち上ると、慰撫する傍のネー将軍に向って云った。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネー将軍よ、さらばである」　ナポレオンはデクレスが帰ると、忿懣の色を表してひとり自分の寝室へ戻って来た。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髮も短く刈り、着物もさツぱりして、出山の釋迦といふ姿は少しもないのみか、親の老僧が殆んど骨と皮とに痩せてゐるのに比べて、これはデク／＼と肉付きがよかつた。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "衿を背中までずっこかすのはどんな量見なんだ」と、そう云って打擲し、全く、毎日私の骨はガラガラと崩れて行きそうで打たれるためのデクのような存在であった。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今見たいにこんなにデクデク肥っちゃいませんが、中肉中背という奴で頬っぺたも赤くて、桜の蕾かなんぞのように少しふくらんでいましたよ。",
              "citation": {
                "source": "三角形の恐怖",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻っぴの、おでこの、ガニ股の、ブーブー野郎の、デクノ棒野郎の、蛆虫野郎の、飴玉野郎の、――ソノ大間抜け、口惜しかったらここまでやってこい。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
