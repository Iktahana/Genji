        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "正にドビュッシイが言ふやうに、ベートーベンはデスクリプションした。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに彼の叫びの強烈さがデスクリプションを表現的にしたのだ。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、純粋にエステティクに言つて、デスクリプションよりも進んだものとは言へる。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに、事実歌ふ場合に、人は全然トンポエムにもなれない、又全然デスクリプションにもなれない。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのデスクリプションには一つたらないところがあった。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
