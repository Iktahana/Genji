        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女のデビュー作が、いよいよ来月、雑誌に出るらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
