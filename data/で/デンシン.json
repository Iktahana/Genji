[
  {
    "uuid": "94d5e068-6180-5ee0-9f4d-ddf56525ceee",
    "entry": "電信",
    "reading": {
      "primary": "でんしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
