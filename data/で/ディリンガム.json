          "literary": [
            {
              "text": "アラモアナ・ショッピング・センターのある場所は、ディリンガムが所有するただの野原だった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのディリンガムなのか、そこまでは僕は記憶していない。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのディリンガムでも、結局はおなじことだろう。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ海軍および空軍の海洋観測船や気象観測機から、ディリンガム空軍基地や真珠湾に向けて発信されている、さまざまな気象情報だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
