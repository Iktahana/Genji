        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昼がすむと、デリケッセンからランチをとって食ひ、少し休むともうすぐ夜だ、「ガラマサ」のセリフ二三警察から、つまらんとこをカットせよと言って来たのでやりにくかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸く昼が終ると、土地の親分が来て、たってのたのみで、意味なき奴らの前で、一席喋らされ、くさってすぐ戻り、デリケッセンで食事し、楽屋へ入ると、秦豊吉から「ニチゲキノキヤクホンドウナツタ」と電報、人の気も知らないで、畜生何言ってる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の部終ると、やれ／＼と一休み、デリケッセンの一品にパン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一回終るとデリケッセンのカツと、コーヒーに、トースト、ハム、ホットケーキと豪遊し、ねころびて揉ませる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事は部屋でデリケッセンからとる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "デリケッセンでランチを食ひ、楽屋で僕がいろ／＼評をし、技芸賞を四人に与へる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "済んで堀井とデリケッセンでコロッケをとったら全然腐ってた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
