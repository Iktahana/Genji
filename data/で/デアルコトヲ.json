        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "神ノ御名ニ於イテ、君ハ非常ニ気品高キ紳士デアルコトヲ認メル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍、独裁官田中ハ、諸君ヲ山東ニマデヨコサシメタル田中ハ諸君ノ階級ノ最悪ノ敵デアルコトヲ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不正トハ其ノ侵害ガ法律上許容セラレヌモノデアルコトヲ意味スル。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一国ノ平和ヲ護ル争闘意識ノ象徴ハ、マタ同時ニ、閃々タル指揮刀ヲタバサム華ヤカナ装飾人デアルコトヲ自覚シテヰルノデアラウ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ彼ハ最後マデ男子デアルコトヲ相手ニ感ジサセズ、女性ニナリ切ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ顔ノ女ヲ見ルト、顔ダケデナク、性質モ残虐デアルカノヨウニ思イ、又ソウデアルコトヲ希望スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ却テ予ヲ喜バス所以デアルコトヲ心得テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ“存在者”デアルコトヲ忘レ、自分ガ生マレル前カラ世界ガ存在シテイルカノヨウニ認識シタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
