          "literary": [
            {
              "text": "この女詩人は「ゾーヤ・コスモデミヤンスカヤ」という作品を書いている。",
              "citation": {
                "source": "新世界の富",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゾーヤ・コスモデミヤンスカヤはドイツ軍に対して組織されたパルチザンの戦いに参加した十八歳の女性であった。",
              "citation": {
                "source": "新世界の富",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは古い古い駄小説とデミヤン・ベードヌイがまだ批判されずにいた時分の詩集とが、棚の下の方にくっついていました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "文化の革命へ参与する印刷物のСССР的精力の代表はデミヤン・ベードヌイの詩だ。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デミヤン・ベードヌイ。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
