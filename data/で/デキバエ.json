        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今回の展示会では、若手作家たちの出来栄えが注目を集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の手編みのマフラーは、温かみがあって出来栄えが素晴らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供たちの絵の出来栄えを見て、先生が感心していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
