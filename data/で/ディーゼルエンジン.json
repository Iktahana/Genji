        "examples": {
          "standard": [
            {
              "text": "大型トラックや船舶には、パワフルなディーゼルエンジンが搭載されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ディーゼルエンジンはガソリンエンジンよりも熱効率が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の古い車には、まだディーゼルエンジンが使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一たいカワカミなんかに、英国海軍｜工廠が秘密に建造したディーゼル・エンジンの運転ができるはずがないではないか。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディーゼル・エンジンは大西洋で動くと全く同じに北氷洋でも動く筈だし、トラクターはテキサス州に於けると全く同じにトルキスタンでも動く筈である。",
              "citation": {
                "source": "技術の哲学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンジンも、燃料も、きわめてわずかな容積で済み、熟練した技師が一人か二人あれば沢山、さあ問題は解決した、というので、一九一〇年頃から、ディーゼル・エンジンを補助機関に備えつけた日和見帆船がワンサとできた。",
              "citation": {
                "source": "黒船前後",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイアの音とディーゼル・エンジンのうなりが前方にせまり、追い抜くと同時に、すっと後方に消えていく。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの本の大部分は荒木船長に借りたものであるが、中の幾冊かは、――ディーゼル・エンジンに関する本は、自分で東京の神田へいって買ったものであった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
