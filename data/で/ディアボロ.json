        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のディアボロの技は目を見張るものがあり、観客を魅了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、ディアボロで遊ぶのが得意だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "サーカスの演目では、カラフルなディアボロが宙を舞っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そこで子供がディアボロを回して遊んでいた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「恋はやさしい野辺の花よ」の「ボッカチオ」や「岩にもたれた物凄い人は」の「ディアボロ」を高唱しつつカーボーイの帽子を冠つて、セントラルカフエーにブラジル系の珈琲を飲んで拠りどころなき情熱を燃やした私たちそのかみの「ペラゴロ」（さう呼ばれてゐた）もこんな昔噺をかけるやうになつてしまつた。",
              "citation": {
                "source": "大正東京錦絵",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月一の替りは「只野凡児」と「ディアボロ」、二の替りに「梅ごよみ」を行かうなどゝ話す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月二十五日（木曜）　早く浅草へ出て、日本館へ入り、「ディアボロ」を見た。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマの四人の遊冶郎アルセジマルクス、フェドロムス、ディアボルス、アルジリッペは、クールティーユからラバテュの駅馬車に乗り込む。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
