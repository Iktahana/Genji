  {
    "uuid": "6cd645e9-9c28-5059-8a1b-c15a95cadec0",
    "entry": "デンデン",
    "reading": {
      "primary": "でんでん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宵のうちはその障子に人影が写り「デデンデン」という三味線の撥音と下手な嗚咽の歌が聞こえて来る。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンデンと三味線が太く哀調を予想させ、太夫が腹にいれた木の枕をしっかと押えて、かつて小出楢重氏が大阪人は浄瑠璃をうなる時がいちばん利口に見えるといわれたあの声をうなり出し、文五郎が想いをこめた抱き方で人形を携えて舞台にあらわれると、ああここに大阪があると私は思うのである。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デンデン　蟲々　ツノ　出セヤ　ダツタカナア」ト、イロイロ　カンガヘタガ、チツトモ　ソノ　ウタハ　オモヒダセマセンデシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "王サマハ、「デンデン　ムシムシ」ト　口ノ　中デ　イヒナガラ、ニハヲ　グルリト　マハツテ　キマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、オモヒダセナイノデ、トウトウ　オコツテ、カタツムリヲ　ツブシテ　シマハウト　シタ　トキ、フツト　オウサマノ　ココロニ、「デンデン　ムシムシ　ツノ　フレヨ、夜アケニ、ヌストガ　ヤツテ　クル」ト　イフ　ウタガ、ウカビマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "小サナ　小サナ　スキトホルヤウナ　デンデン蟲デシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、大キナ　デンデン蟲ガ　ヨビマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフガ　ミエナク　ナルト、コドモノ　デンデン蟲ハ、「アレ、ナアニ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソラヨ」ト　カアサンノ　デンデン蟲ハ　コタヘマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーン」小サイ　デンデン蟲ハ、オカアサマデモ　ワカラナイ　フシギナ　トホイ　ソラヲ、ホソイ　メヲ　一パイ　ノバシテ　イツマデモ　ミテ　ヰマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンデンムシノ　カナシミ新美南吉　イツピキノ　デンデンムシガ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ　ソノ　デンデンムシハ　タイヘンナ　コトニ　キガ　ツキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンデンムシハ　オトモダチノ　デンデンムシノ　トコロニ　ヤツテ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　イキテ　ヰラレマセン」ト　ソノ　デンデンムシハ　オトモダチニ　イヒマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナンデスカ」ト　オトモダチノ　デンデンムシハ　キキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルノデス」ト　ハジメノ　デンデンムシガ　ハナシマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　オトモダチノ　デンデンムシハ　イヒマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソレヂヤ　シカタナイト　オモツテ、ハジメノ　デンデンムシハ、ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカニモ　カナシミハ　イツパイデス」　ソコデ、ハジメノ　デンデンムシハ　マタ　ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウトウ　ハジメノ　デンデンムシハ　キガ　ツキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "平気で読経し居ると、丑三つ頃、表の戸を敲きデンデンコロリ様はお内にかという者あり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "槌と鶏と怪を為す事、上述デンデンコロリの話にもあり、山茶の木の槌は化ける、また家に置けば病人絶えずとて熊野に今も忌む所あり、拙妻の麁族請川の須川甚助てふ豪家、昔八棟造りを建つるに、烟出しの広さ八畳敷、これに和布、ヒジキ、乾魚などを貯え、凶歳に村民を救うた。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "○おへそを　デンデン　○ありがとう　あなとうとーのみこと（勅語奉答の覚えた）　○エプロンに　お月と兎ついて居　眼玉が碧い貝ボタン、その眼玉とるぞ　とＹいう、片手でお月さんをかくし、片手で兎の目玉かくし。",
              "citation": {
                "source": "一九二七年春より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまに出たのに、下りもしない映画見て、スーとうちへかえって来ちまって、こんななら、何にも見ないでデンデン、デンデン街を歩いた方がいい心持だ。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんや、それが引きつづいてかなりの手だれな調子で、デンデンデンデンと引きほごされてゆくと、机竜之助の空想もその中に引込まれて、「珍しいなア、太棹をやっている」　全く珍しいことです。",
