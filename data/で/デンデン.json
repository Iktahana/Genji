    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの、でんでん太鼓の美しさと。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝＝ねんねんよ、おころりよ、ねんねの守はどこへいた、山を越えて里へ行た、里の土産に何貰うた、でんでん太鼓に笙の笛＝＝白雪　（じっと聞いて、聞惚れて、火焔の袂たよたよとなる。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "＝でんでん太鼓に笙の笛、起上り小法師に風車＝＝と唄うを聞きつつ、左右に分れて、おいおいに一同入る。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同　（手に手に石を二ツ取り、カチカチと打鳴らして）魔が来た、でんでん。",
              "citation": {
                "source": "紅玉",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "みどり児を、片袖で胸に抱いて、御顔を少し仰向けに、吉祥果の枝を肩に振掛け、裳をひらりと、片足を軽く挙げて、――いいぐさは拙いが、舞などしたまう状に、たとえば踊りながらでんでん太鼓で、児をおあやしのような、鬼子母神の像があった。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勝手にピイピイ吹いておれ、でんでん太鼓に笙の笛、こっちあ小児だ、なあ、阿媽。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨も風も吹かンのんに、でんでん虫、虫……」　と、狂言舞に、無性｜矢鱈に刎歩行く。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は酔って唄をうたうなど、絶無のことなのであるが、その夜は、どうしたはずみか、ふと、里のおみやに何もろた、でんでん太鼓に、などと、でたらめに唄いだして、幸吉も低くそれに和したが、それがいけなかった。",
              "citation": {
                "source": "新樹の言葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "常に赤ちゃんの着る花模様のおべべを着て、でんでん太鼓など振って、その九十歳だか百歳だかの御両親のまわりを這いまわって、オギャアオギャアと叫び、以て親の心を楽しましめたり、とあります。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十の老人が、赤ちゃんのおべべを着て、でんでん太鼓を振りまわしている図は、むしろ醜悪で、正視にたえないものです。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、伝六でんでんにしんの子、酒のさかなにもなりゃしねえなんぞと、子どもにまでもバカにされるんだよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいてめんこ、でんでん太鼓にピイヒョロヒョロの笙の笛。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりお房が泣止まないので、三吉は抱取って、庭の方へ行って見せるやら、でんでん太皷だの笛だのを取出して見せるやら、種々にして賺したが、どうしてもお房の気に入らなかった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "成る程、物騒だ、と、木戸を抜けて、入口へかかると、お前、でんでん、太鼓を叩いて遊んでやがらあ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで会うたが七年目、覚悟はよいか、でんでんでん――こりゃあ太棹で、へへへへへ。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "でんでん太鼓に笙の笛――」　調子はずれの子もり歌が、薄暗い行燈の灯影に揺れる。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "里の土産に何貰うた、でんでん太鼓に笙の笛……　美しい、透きとおるような調子に魅せられて、呆然として立って居ると、唄は三度び繰返された。",
              "citation": {
                "source": "狂女と犬",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしとしましては、そんな事まで、お雪ちゃんという子の門出を心配しておりましたにかかわらず、お雪ちゃん自身は、白骨へ行くことを、お隣りのでんでん町へでも行くような気軽さで、楽しそうな様子でございました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なおそのほかに、籠の左右にこぼれたものを見ると、でんでん太鼓だの、風車だの、ピーピーだの、おしゃぶりだの、そりいうものが積まれているのみか、徳利の頭へ管をつけて、その管の一端が、子供の口許にまで導かれて結えられている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしゃぶりも、ピーピーも、風車も、でんでん太鼓もケシ飛んで、ミルクであり、摺粉であるべき徳利はくわえ出されて、その余瀝が餓えたる犬の貪り吸うところとなりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お手のものだけ廿歳の頃、でんでん太鼓でお前が誕生、祝ふてやつた事もある。",
              "citation": {
                "source": "移民学園",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭かきかき　市長のいうにゃ、『でんでんででむしではあるまいし、智慧だせだせと　せめつけられても、無い智慧出されぬ　面目ござらぬ、にげこむねずみの　穴ほしや。",
              "citation": {
                "source": "魔法の笛",
                "author": "ロバアト・ブラウニング",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるんだから仕方がねえ」「…………」「ほんとのことをいや親は、決して自分の忰なんて大きくならねえで、でんでん太鼓に笙の笛てな子守唄うたって生涯こいつと暮らせたらと考えている。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点ででんでん物の旧劇は民衆的であると云える。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "でんでんむしむしでんでんむしむし、角ひけよ。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手ほしやのかえるどの、相手ほしやのかえるどの、でんでんむしの背中にうちのって。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "「晩年」の諸作には、太宰自身もいっているように、どこかでんでん太鼓の美しさのようなものが感ぜられる。",
              "citation": {
                "source": "井伏鱒二によせて",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
