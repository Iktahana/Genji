        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "神々の存在を否認したディアゴラス（Diagoras）もやはり死刑を宣告された後に亡命し、またかの哲学者プロタゴラス（Protagoras）もその著書は公衆の前で焼かれ、その身は国土から追われた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じように無神論者と言われたディアゴラスも答えた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディアゴラスおよびテオドロスは、断然神々の存在を否定した。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
