  {
    "uuid": "f5e58fdd-212c-5ffe-95cf-7590339cdf4e",
    "entry": "デスガ",
    "reading": {
      "primary": "ですが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そりゃお前さんの勝手だから、教師になと車夫になと何になとお成なさるが宜いのサ」「デスガそう御立腹なすッちゃ私も実に……」「誰が腹を立てると云いました。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスガ私ハ私ノ故郷ダカラ好キデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレデ、イタチサヘ　ヨンデ　クレバ、ミンナ　オキヤクガ　ソロフ　ワケデスガ、サテ、イタチハ　ドウ　シマセウ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "記者様――アノ鯉幟ノ棹ハ、私ガ酔ッタ勢イデ立テタモノデスガ、ソレガ記者様ノオ眼ニ止マッテ、コンナ不孝ナ恥ヲ晒ソウトハ夢ニモ思イマセンデシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は仕方ナク床ニ戻ッタノデスガ、ドウ考エテモ余リニ無札ナ仕打デハアリ、私が今更ソンナ事ヲイエタワケデハナイノデスガ、道子ガ人妻トシテ余リニヒドイ乱行ヲシテ居ルノヲ見テ、モウ堪エラレヌ、イッソ道子ヲ殺シテ自分モ自殺シヨウト決心シタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ、道子ヲ殺シタ後清三ガオキタラ、罪ヲスッカリ自白シテ自殺シヨウト思ッテ居タノデスガ、然シ清三ノ態度如何ニ依ッテハ之ヲ殺スツモリデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ソノ時探シタノデスガ何モアリマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、龍宮城デ千年ノ間、若イママデ暮ラセルカ、阿弥陀様ノ極楽浄土ヘ行カセテモラエルナラ、別デスガネ」と答えました。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナッテシマウノデスガ、今夜ハソウナラナイ内ニ、ワザト魔法ニカカッタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハイツデモアツイソウデスガ、今年ハトクベツニアツクテ、三十五年カラナイホドダサウデス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ犬デスガ、年ヲトリマシタノデ、一人デクラスノハ、サミシウゴザイマス。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イマ、オトナリノハタケムラカラ、ヂヤガイモサンガ、アソビニキテヰタノデスガ、キウニヰナクナツタノデス。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ヨツピテグツスリネコンダノニ、マダネタイデスガ、メガサメテシマツテネムレナイノデ、ホンヲヒロゲテヨミマセウトシマストキウニ、マドノスグソトデ、パタパタトハシリマハルオトガシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お客をもてなすに、ツマラナイモノデスガ、とか、お口にあいませんでしょうが、とかと、妙に卑屈なことを言う。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナニナロウト思ッテ、バーレッスンヲ一二年受ケタコトガアルノデ、チョットグライ立ツコトハ立テタンデスガ、サア今デモ立テルカ知ラ」ッテ、ソンナ話ヲシタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ思イ出シタンデスガ、オ墓ノコトハドウナサルノ」「ソウ急グコトハナイサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「―――油谷サン夫婦ハ少シ早メニ出カケテ行ッテ前座ノ試合カラ見テタンダソウデスガ、リングサイドノ奥サンノ右隣ノ席ガ二ツ、最初ハ空イテタンダソウデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ直スニハギプスベッドカ牽引法デ神経ノ壓迫ヲ取リ除クヨリ外ハナインデスガ、ソレニハ三四カ月ノ御辛抱ガ必要ナンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスガソウナルト薬デ一時ヲ糊塗ナサルヨリ方法ハゴザイマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子ハ伺ッタモノカドウカ、ドウシタライヽデショウッテ云ッテルンデスガ、………」「………」「伺ッタライヽジャナイカ、コンナ時コソオ前サンノ顔ヲ御覧ニナッタラ、イクラカデモ痛ミヲオ忘レニナルヨッテ云ッテヤッタンデスガネ」「馬鹿」イキナリ予ハ怒鳴ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
