        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二十年前、スティヴンスンをディレッタンティズムから救ったデエモンは讃えらるべきであった。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "風邪をひいたのは気候のせいもあるけれども、数日間つきものがして（シャレタひとはデエモンと呼ぶ狐）すこし夢中になって精根をこきつかったからもあるのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "デエモンに彼がまけたという自分の感じは当って居る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○自分の中にもこの頃暗き力のデエモンが動いて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（デエモン、或時に明々赫々たり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴎外のなかにも実は守り神のデエモンは住んでゐたのである。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しデエモンがゐるといふことは大切な手がかりであらう。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "デエモンも手の下しやうがなかつたのであらう。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには或はまた手なづけ難いデエモンがゐるのではあるまいか。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
