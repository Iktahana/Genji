        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの人はいま、ケデロンの小川の彼方、ゲッセマネの園にいます。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう夕暮に、かの女はよくパッシィの家を出て、あまり遠くないトロカデロ宮裏の広庭に行った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロカデロ宮前を通り過ぎると、小さいキャフェには昔風に床へ鋸屑を厚く撒いているのが匂った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロカデロ宮を裏へ廻った広庭はセーヌの河岸で、緩い傾斜になっていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道のわきに柵があって、その崖の下の緑樹の梢を越してトロカデロ宮殿の渋い円味のある壁のはずれを掠めて規則正しくセーヌへ向けてゆるやかな勾配を作っている花壇の庭が晴々しく眺められた。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのトロカデロの坂道の崖の下あたりにリサが潜んでいて娘に自分達の後を追わせたのではなかろうか。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち五本がポンデローザでね、五本がレッドチェリイだよ。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンデローザにはまっ赤な大きな実がつくし、レッドチェリーにはさくらんぼほどの赤い実がまるでたくさんできる。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはトマトは食べないけれど、ポンデローザを見ることならもうほんとうにすきなんだ。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "映画監督のシュネイデロフ氏はだれも格好な話し相手がなくて、すみのほうの椅子に押し黙って所在なさそうに見えた。",
              "citation": {
                "source": "北氷洋の氷の割れる音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」映画監督のシュネイデロフが叫ぶ。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "磨出した良い月夜に、駒の手綱を切放されたように飛出して行った時は、もうデロレンの高座は、消えたか、と跡もなく、後幕一重引いた、あたりの土塀の破目へ、白々と月が射した。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トテ　トテ　トテ　ト　ミナ　ミナ　オキロ　モウ　アサダ、　トテ　トテ　トテ　ト　クワヲバ　モツテ　ハタニ　デロ、　トテ　トテ　トテ　ト　タネヲバ　マケヨ　ムギノ　タネ　トテ　トテ　トテ　ト　トテ　トテ　トテ　ト」ト　ヲトコハ　フイタノデ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく、マヌエラのあとを蛇のように追う、ヤンを加えドドを連れて、まずさいしょの根拠地となるコンデロガへ発ったのである。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがコンデロガを発つ探検第一日の前日だった。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、二人は胸に敵意をひめながら、どうやらさいしょの意図とはちがってしまった探検隊が、数日後はコンデロガを発ったのである。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、コンデロガを発って間もなく、曠原の灌木帯で野牛を狩った時のこと、砂煙をたてて、牝の指揮者のもとに整然と行動する、その一群へ散弾をぶちこんだ。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "エッフェル塔の裾が裳のように拡がり張っている下まで来ると、対岸のトロカデロの公園内に打ち込む鉄筋の音が、間延びのした調子を伝えて来る。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この読売新聞に医学士森鴎外がカルデロンの戯曲を翻訳し「調高矣洋絃一曲。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三番続」としてのせていたのが、美妙の插画に対する世論の卑俗猥雑さにつむじをまげて、まだまだ日本人にカルデロンなんか勿体ないというのを、篁村がなだめてつづけさせていることも語られている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "農場主の妻デロア夫人の冷血さ、息子アンリイに対するマリイの感情、こういういきさつはしばしば小説の中に描かれている。",
              "citation": {
                "source": "若い婦人のための書棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリイがデロアの息子であると知って、心から愛するエエメ教姉の話をしたことを愧じる心持、アンリイとの訣別、デロアのところを逃げて来るところ、ここには貧しくよるべなくお針女はしているが、決して卑屈でない女の真情が溢れたぎっているのである。",
              "citation": {
                "source": "若い婦人のための書棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ案内に連られて止宿した旅館は、巴里の王宮の門外にあるホテルデロウブルと云う広大な家で、五階造り六百室、婢僕五百余人、旅客は千人以上｜差支なしと云うので、日本の使節などは何処に居るやら分らぬ。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "十時の汽車に父母のせ（ジェネ※）トロカデロまでかえって Hotel へ行ったら Note がおいている　スミ子プランタンへ行ってしまった。",
              "citation": {
                "source": "「道標」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーヂェニー・デロムという婦人に暴行の後惨殺。",
              "citation": {
                "source": "殺人狂の話",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
