          "literary": [
            {
              "text": "ツカレノ銀ヲクユラシテ、　　　モロ人谷ヲイデキタリ、ココニ二タビ口ソソギ、　　　　セナナル荷ヲバトトノヘヌ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が翌朝十時ごろ私は寝床の中で弟からの電報を受け取ったが、チチブジデキタ――という文句であった。",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツイ　アツイデキタテノ　スナマンヂウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナマンヂウガ　デキタラ　パカ、パカピヨン、ピヨン、パカ、パカオウマニ　ツンデマチヘ　ウリニ　ユキマセウ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタッタッとグラスを並べて身体諸共躍り込み、「デ、デ、デキタ！",
              "citation": {
                "source": "霓博士の廃頽",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "………　僕ハ午前三時頃カラ約一時間以上モ妻ノ裸形ヲ見守リツツ尽キルガデキタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ家庭デ雁皮ヲ使ウガデキタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
