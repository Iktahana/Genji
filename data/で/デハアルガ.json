        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鬘ヲツケタマヽ舟底形ノ枕ニ寝、暗イ部屋ノ褥ノ中デ、友禅ノ長襦袢ヲ着テノコトデハアルガ、実ニ異常ナ技巧ヲ持ッテイタモノデ、マコトニ不思議ナ経験デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十ニナッテモ子ヲ産ンデミセルト云ウ久原房之助ノヨウナ精力ハナク、既ニ全ク無能力者デハアルガ、ダカラト云ッテイロ／＼ノ変形的間接的方法デ性ノ魅力ヲ感ジルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイピイ、ピイピイ、ト、カスカナ声デハアルガ、シキリニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
