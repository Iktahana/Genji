          "literary": [
            {
              "text": "シカシ労働ニ害サレタ手ハ思ウヨウニ自分ノ感力ヲ現ワス事ガデキナイデ困リマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「テフテフサン」ト　トブ　コトノ　デキナイ　花タチハ　イフノデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ　ガマンガ　デキナイ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　オホゼイノ　マエデハ、イフ　コトガ　デキナイヤウナ　クセデ　アリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛筆ニ乏シク、和紙ガ皆無ニチカイ今日ノ我々ノ実生活（趣味生活ハ問題外）ノドコヲ探シテモモハヤヒラガナニ未練ヲノコス理由ヲ発見スルコトガデキナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤキユウヲスルノニ、ダマツテデキナイナンテ、ナンテ、バカナ小僧タチダ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハソノハデキナイダロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時ニ僕モ、ココマデ来テハ後戻リハデキナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ニコウイウエキゾチックノ美ガアルガデキナイデ、他人ニ見ツケ出サレタノハ口惜シイケレドモ、夫トイウモノハ見馴レタ妻ノ見馴レタ姿ヲノミ見タガルモノデ、カエッテ他人ヨリモ迂濶ナノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チキュウノニンゲンノ、デキナイコト、デキル。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
