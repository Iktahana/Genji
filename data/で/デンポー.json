        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どこかで「デンポー、デンポー」と言っているらしい声が聞こえる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっきの「デンポー」はやはり自動車の警笛であった。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日はとりやめ、勿論それはデンポーでおわかりですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日は富士見町、四谷の病院とおせいぼやお礼にまわって、島田のお母さんのものを買ったりして、林町へまわり、うちへ電話かけたらデンポーだとよんでくれたので、すぐありあわせの毛筆でかいたのでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、この紙をひろげていたら、デンポー。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後になって林町から母上来とのデンポー。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
