          "literary": [
            {
              "text": "」　十七世紀のフランスの肖像画家ダニエル・デュムーチエにも盗癖があった。",
              "citation": {
                "source": "愛書癖",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "法王インノセント十世が、未だパンフィリオ僧正と呼ばれていた頃、バルベリニ僧正と二人で、デュムーチエを訪問した事があった。",
              "citation": {
                "source": "愛書癖",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンフィリオは戯れに、デュムーチエの秘蔵していた『トラント宗教会議史』を盗む真似をした。",
              "citation": {
                "source": "愛書癖",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとデュムーチエは火のように怒って、パンフィリオを追い帰して了った。",
              "citation": {
                "source": "愛書癖",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンフィリオが後に法王になってから、デュムーチエを揶揄して、汝の如き不逞の徒は破門して黒焼にすべきであると云った時、デュムーチニは直ちに「私の頭は黒焼にするには白すぎる」と答えた。",
              "citation": {
                "source": "愛書癖",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
