        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オマツリガ　アルノデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オイケデ　オマツリガ　アルノデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エライ目ニオ会イニナリマシタソウデ」「ナアニ何デモアリマセンヨ」「兎ニ角見セテ戴キマショウ」臥カサレテ手ヤ足腰ヲ委シク検査サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハソレヲ考エルト不安デモアリ、彼女ニ罪深イヲ好ムノデアル、―――ヲ刺戟シテ、ソレニヨッテ自分ヲ刺戟シヨウトスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ嫉妬ハ或ル意味ニオイテ必要デモアリ快感デモアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハドンナ場合デモ常ニ夫ニ忠実ナル妻デアル以外ノ何者デモアリマセン」トイウ意味ナノカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この推測が当っていたことは、「僕ハソノ嫉妬ヲ密カニ享楽シツツアッタ」、―――「僕ハ嫉妬ヲ感ジルトアノ方ノ衝動ガ起ル」、―――「ダカラ嫉妬ハ或ル意味ニオイテ必要デモアリ快感デモアル」（一月十三日）―――等々とあるので明らかであるが、もうそのことは一月一日の日記の中でうすうす私には想像できたのであった。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
