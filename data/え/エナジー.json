        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「よし、いくぞ！」と気合を入れ、ステージ裏でエナジーを蓄える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "若いダンサーたちの爆発的なエナジーに、観客席からも熱い歓声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「最近どうもエナジー不足でさ……」と、友人は力なく笑って見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし彼の生活はエナジーの生活であつた。",
              "citation": {
                "source": "生みの力",
                "author": "片上伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドストイェフスキーは實にどういふ意味に於いても「猫のやうなエナジー」を有つた人であつた。",
              "citation": {
                "source": "ドストイェフスキーに就いて",
                "author": "片上伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のエナジーを喰うて生きるのやさかい、おのれの脚を喰らうて生きるタコと変りまへんがな……」と五月女君のタコ哲学の一席。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "「革命的エネルギー」という言葉があるが、それは一種のポテンシャル・エナジーで、転向・転下によって、このエネルギーがディスチャージ（？",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、稍ともすると、我々はポテンシャル・エナージーを養うんだと云って、むやみに牛肉を喰って端艇を漕いだ。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは／＼とばかり花の吉野山　　　　　貞室　当時はスペンサーのエコノミー・オヴ・メンタル・エナージーといふ謬論を信じゐたる故、この句は美麗といはずして美麗を現したりとて感心せり。",
              "citation": {
                "source": "俳句の初歩",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "後滑りする度に見る見るエナージーが減って行くように思える。",
              "citation": {
                "source": "五色温泉スキー日記",
                "author": "板倉勝宣",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにはポテンシャル・エナージーの無限の差の世界が横たわっている。",
              "citation": {
                "source": "認識論とは何か",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "位置のエナージーの差は、一定の落差を与える。",
              "citation": {
                "source": "認識論とは何か",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "思想は一種の労作か労働なのだから、どんなに天来の思想でも必ずその思想的なポテンシャル・エナージーを自覚しているものだ。",
              "citation": {
                "source": "ひと吾を公式主義者と呼ぶ",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
