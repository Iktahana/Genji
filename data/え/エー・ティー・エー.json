        "examples": {
          "standard": [
            {
              "text": "古いパソコンのハードディスクは、ＡＴＡインターフェースで接続されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "シリアルＡＴＡが登場するまで、パラレルＡＴＡが主流だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パソコンを自作する際、ＡＴＡケーブルの種類を確認する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これで彼も、ようようその一日を一日として、ＷＡＴＡのように疲れた身体を階上の自室へ運び上げた。",
              "citation": {
                "source": "踊る地平線",
                "author": "白い謝肉祭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ＴＡＴＡＴＡＴＡＴＡＨ！",
              "citation": {
                "source": "風博士",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシ」と四字で書き得る仮名をＷＡＴＡＫＵＳＨＩと九文字で書かねばならぬ愚かしさを考えれば、その無意味有害な立論であること、すでに明らかな話である。",
              "citation": {
                "source": "文字と速力と文学",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮名は四十八文字でアルファベットは二十六文字でも、単に文字を覚える時の四十八が二十六に対する労力の差と、「ワタクシ」をＷＡＴＡＫＵＳＨＩと四文字を九文字に一生書きつづけねばならぬ労力の差とでは、余りにもその差が大きすぎるようである。",
              "citation": {
                "source": "文字と速力と文学",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "更にその下はＪを独立変数とする二つの関数が、ＲＥＡＤ／ＤＡＴＡ文で順番に並べられた映像搬送周波数と音声搬送周波数の値をそれぞれ取るようになっている。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのナイフは、外がわにシカの角がはりつけてあるのですが、わるいことには、そのシカの角の表面に、じぶんの名がローマ字でＫ・ＭＩＹＡＴＡと、ほりつけてありました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
