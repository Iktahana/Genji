        "examples": {
          "standard": [
            {
              "text": "新任の校長が初めて全校生徒の前で演壇に登る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のスピーチは素晴らしく、聴衆は彼が再び演壇に登るのを待っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は緊張しながらも、堂々と演壇に登った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さりながら今日辞表を出しますれば、明日は演壇に登ることが出来ませぬから、今一場のお話を致して、議員を罷めまする積りでございます――』見よ、演説壇上のこの人を――黒紋付の木綿羽織に、色｜褪せた毛繻子の袴。",
              "citation": {
                "source": "政治の破産者・田中正造",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが予ての合図だったと見え兼清博士は幸田節三に押上げられるようにして、演壇に登る。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりながら、今日辞表をだしますれば、明日は演壇に登ることができませぬから、いま一場のお話を致して議員をやめまするつもりでございます。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
