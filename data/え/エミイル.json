        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジャン・ジャック・ルソオ――「恒久平和の企図」　エミイル・ヴェルハアレン――「黎明」（この戯曲に於て、ベルギイの詩人は人類社会の甦生の希望を述べている。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝は早く街へ下り、ロイドと共に政務長官エミイル・シュミット氏の所で朝食をよばれた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説家の面会９・19（夕）　仏蘭西の小説家エミイル・ゾラは、寺内伯と同じやうに新聞記者との会談を甚く怖がつてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして過去の人たちが、この方面でどれだけの業績をのこしたかを見逃さないために、この方面に於ける最も偉大なる一人である、エミイル・ゾラの説を紹介しようと思ふ。",
              "citation": {
                "source": "エミイル・ゾラの文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　エミイル・ゾラは、有名な「実験小説論」の冒頭で次のやうにことはつてゐる。",
              "citation": {
                "source": "エミイル・ゾラの文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・ゾラがなしたことは、実験的方法の適用範囲を更に一歩拡大したことにほかならぬのである。",
              "citation": {
                "source": "エミイル・ゾラの文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・ゾラは、実験小説の神髄を次の如く要約してゐる。",
              "citation": {
                "source": "エミイル・ゾラの文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　　　　　×　　　　　　　×　　　　　　　×　エミイル・ゾラはこゝで主として小説について論じてゐる。",
              "citation": {
                "source": "エミイル・ゾラの文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・ヴェルハアレン珊瑚礁　　　　　ホセ・マリヤ・デ・エレディヤ波の底にも照る日影、神寂びにたる曙の照しの光、亜比西尼亜、珊瑚の森にほの紅く、ぬれにぞぬれし深海の谷隈の奥に透入れば、輝きにほふ虫のから、命にみつる珠の華。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・ヴェルハアレンボドレエル氏よ、君は芸術の天にたぐひなき凄惨の光を与へぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷺の歌　　　　　エミイル・ヴェルハアレンほのぐらき黄金隠沼、骨蓬の白くさけるに、静かなる鷺の羽風は徐に影を落しぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者法の夕　　　　　エミイル・ヴェルハアレン夕日の国は野も山も、その「平安」や「寂寥」の黝の色の毛布もて掩へる如く、物｜寂びぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "水かひば　　　　エミイル・ヴェルハアレンほらあなめきし落窪の、夢も曇るか、こもり沼は、腹しめすまで浸りたるまだら牡牛の水かひ場。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "畏怖　　　　　　エミイル・ヴェルハアレン北に面へるわが畏怖の原の上に、牧羊の翁、神楽月、角を吹く。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "火宅　　　　　　エミイル・ヴェルハアレン嗚呼、爛壊せる黄金の毒に中りし大都会、石は叫び烟舞ひのぼり、驕慢の円葢よ、塔よ、直立の石柱よ、虚空は震ひ、労役のたぎち沸くを、好むや、汝、この大畏怖を、叫喚を、あはれ旅人、悲みて夢うつら離りて行くか、濁世を、つゝむ火焔の帯の停車場。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "時鐘　　　　　　エミイル・ヴェルハアレン館の闇の静かなる夜にもなれば訝しや、廊下のあなた、かたことゝ、※杖のおと、杖の音、「時」の階のあがりおり、小股に刻む音なひは　　　　　　　　　　　これや時鐘の忍足。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・ヴェルハアレン　珊瑚礁　　　　ホセ・マリヤ・デ・エレディヤ波の底にも照る日影、神寂びにたる曙の照しの光、亜比西尼亜、珊瑚の森にほの紅く、ぬれにぞぬれし深海の谷隈の奥に透入れば、輝きにほふ虫のから、命にみつる珠の華。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者　法の夕　　　　　エミイル・ヴェルハアレン夕日の国は野も山も、その「平安」や「寂寥」の黝の色の毛布もて掩へる如く、物寂びぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・※ルハアレンホセ・マリヤ・デ・エレディヤ珊瑚礁波の底にも照る日影、神｜寂びにたる曙の照しの光、亞比西尼亞、珊瑚の森にほの紅く、ぬれにぞぬれし深海の谷隈の奧に透入れば、輝きにほふ蟲のから、命にみつる珠の華。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・※ルハアレンボドレエル氏よ、君は藝術の天にたぐひなき凄慘の光を與へぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・※ルハアレン鷺の歌ほのぐらき黄金隱沼、骨蓬の白くさけるに、靜かなる鷺の羽風は徐に影を落しぬ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・※ルハアレン都會路はみな都會にむかふ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供心の自分には、一圓が途方もない大金であつたので、今から考へると、パンテオンに改葬したエミイル・ゾラの灰ほどの尊さが、其の頃其の爐の灰にあるものと思つてゐたのであらう。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミイル・ヴェルハアレンの「世界」と云う詩を読んでいるとこんな事が書いてあった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
