          "standard": [],
          "literary": [
            {
              "text": "その人こそ、その人の名こそ、日本映画史にふたたび拭うべからざる汚点を残したものとして、日本に映画のあるかぎり、日本に映画人のあるかぎり、永く呪わるべきであろう。",
              "citation": {
                "source": "映画界手近の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本映画の発祥が明治三十年、神田錦町の錦輝館の活動写真にあることも、今では映画史の第一頁に、例の「すこぶる非常」で売った活弁元祖の駒田好洋の名と共に必ず記されることになった。",
              "citation": {
                "source": "神田界隈",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時に出て、梅田地下劇場へ、「日本映画史」の試写を見る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三葉三四郎が編纂した『世界映画史』の口絵写真にある、今から四十年まえに大人気を博した女賊映画の主人公プロテアのような姿の美女であった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
