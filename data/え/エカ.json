        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同じ太平洋岸でも、有名な航海者「ヴァンクウバア」が、フッド火山や、ベエカア火山や、レイニーア火山を発見してから、三十四年も後に、シャスタは、やっと存在を認められた。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地の人たちは、この森林帯の立派さを艶説しているが、レイニーア火山や、ベエカア火山の、それに競べると、さほどの物ではない。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "上京して、早速、銀座のベエカリイに雇われた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "上京して、早速、銀座のベエカリイに雇はれた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "凛として将た思ふ、カムイ・エカシ、旅行けば我すらや神に入るなり。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "註　カムイ・エカシ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｍ・ベエカリイに寄つて茶を飮みながら一時間程話す。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアは五代綱吉時代にカムチャツカを収めたが、つひに我が千島列島を侵し、女帝エカテリナは日本語の研究をやらせてゐたといふくらゐだから、北海道を手に入れようと窺つてゐたのである。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」売子娘の驚き11・２（夕）　名高い紐育の百貨店ワナメエカアの手套部に近く入つて来た売子娘があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士は擬ふ方もないワナメエカアの主人だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、暫くしてから露廃帝の一族が、トボリスクからエカテリンブルグに遷されたことを知りました。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その電報が来た時、私は露国大使館を訪うて、書記官か誰かにエカテリンブルグの位置などを訊いたことを覚えて居ます。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、何心なく社会部面に目をやりますと、ふと其処に『エカテリンブルグの惨劇』と云う、二段抜きの表題が目に付きました。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "露廃帝の一族が、エカテリンブルグのある家の地下室で、獣の如き過激派の手に依りて惨殺された実相が、可なり精細に書かれて居ました。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "競技は、そのうえ、私の得意のエカルテ（10）だった。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君はたしかに、今夜グレンディニング卿からエカルテで大金をまき上げた人間の本性をご存じない。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の袖の裏から、エカルテにもっとも肝心なあらゆる絵札が発見され、ラッパーのポケットからは、たくさんの骨牌札が発見された。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "エエカ……早川をそそのかして、女を膨らましては自分で引き受けて、相手の親から金を絞るのを、片手間の商売にしとるんだ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それからお嗽いの水も……塩をすこし余計に入れてナ……エエカ……すぐに持って来るんだぞ」　こう云って看護婦を叱り飛ばすと、ドクトルは今までと打ってかわった得意満面の態度で、白い診察服を二ノ腕までマクリ上げた。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "親の因果が子に報いじゃア……エエカナア……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エエカナ……ところが、それから二十年余り経った昨日の事、お前がやって来てからの頼みで、卦を立ててみると……どうじゃ……その盆踊りの晩に、お前の母親の腹に宿ったタネというのは、お前の父親……すなわち文太郎のタネに相違ないという本文が出たのじゃ。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたゝかく、風のない朝、十時時分、僕は蜜柑山の芝のスロウプに腰かけて、海を眺めてゐると、絵かきの朝居閑太郎が、僕の妻に案内されて、僕の前に立ち、情熱のこもつた息苦し気な調子で、そして対者に遠慮する微笑を浮べて「エカキが――」と云つた。",
              "citation": {
                "source": "朝居の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピョートル三世とエカテリーナ二世の間に生れた皇子で、一七九六年帝位に即いたが、性疑い深く、政治上にも非常に過酷な点が多かった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、よほど以前のことであるが、故エカテリーナ女帝陛下がクリミヤへ行幸になつたをり、彼は供奉の一員に選ばれて、二日間その大命を拝し、あまつさへ帝室馬車の馭者台に馭者と並んで同乗する光栄を担つたことがあつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "総帥選挙制は、一五九〇年に始まり、一七六四年にエカテリーナ二世に依つて禁止されるまで継続した。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "一七八七年、エカテリーナ女帝を慫慂して南部新領土への行幸を実現したが、その後、他の寵臣のため女帝の信任が己れを離れたことを知り、一旦締結された土耳古との講和を破棄し、再び戦端を開かんと企て、南露ニコラエフに向ふ途中、病歿した。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、エカテリーナ女帝が下問された。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "」でつぷりして、少し蒼白めた顔の人物　これはエカテリーナ朝に於て劇作者として活躍したフォンウィージン（1745―1792）のことで、彼は純然たる露西亜喜劇、『旅団長』及び『未丁年者』の両作に依つて文学史上不朽の名を残してゐる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエントカフエカシコラミヨノダイミヨウジン。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンタチハ、オ母ッチャガ死ヌ四五日モマエカラ、何ンニモタベルモノガナク、目マイガシ、ムネガヒクヒクシ、ペッタリネタキリダッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
