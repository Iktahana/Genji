        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "世間的な俗物はとに角として、本来的生活者としての人間的存在は、エキジステンツは、一体実証的な世俗の知恵と何の関わりがあろう、とＭ・ハイデッガーの一派はいうのだ。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る人は之をハイデッガーのエキジステンツの哲学と均等して摂取し吐き出そうとする。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸外国の哲学の影響は、科学的に大して問題とするに足りない（高々ハイデッガー系統のエキジステンツ哲学位いなものであろう）。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
