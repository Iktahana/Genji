        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジル・マルシエツクスの告別演奏會が公會堂にあるので皆で出掛け、其處で外山楢夫先生、外村完二氏にお會ひした。",
              "citation": {
                "source": "講演會　其他（大正十五年二月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し其道具立の一つ／＼から順々に帰納的に結論したら、却つて「悄然」と正反対な或るエツクスを得るかも知れない。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシヤのマルクス主義の碩学プレハノフは、此の問題について興味あるワラツシエツクの説を引用してゐる。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワラツシエツクは原始民族の演劇の起源に関する自己の見解を次の如く要約してゐる。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のオランダの古大家、ヤン・フアン・エツクの描いた様々な男女の肖像画を見るならばこれ等の事はよく分る筈である。",
              "citation": {
                "source": "美術上の婦人",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな作業の合間には、事務室に戻り、チエツク・プロテクターを使つたり、来客を応対した。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
