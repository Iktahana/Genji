          "standard": [
            {
              "text": "エタンは常温で気体の炭化水素であり、天然ガスに含まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "化学工業では、エタンを原料として様々な有機化合物が合成される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このガスボンベにはエタンが充填されており、実験に使用する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「このパンはエタンプの小麦粉で作ってます、最高級品です」「一体、そこで何を見てるんですか？",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
