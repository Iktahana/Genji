        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "みんな怒りの絶頂にあることは、その顔色がエビガニのように赤黒くなっていることによっても知れた。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランニング一枚の子供がエビガニを釣って遊んでいた。",
              "citation": {
                "source": "愛のごとく",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣友が、どこそこに手長がいるから行ってみろと教えてくれるので、足の悪いのにわざわざ出かけて行ってみると、エビガニばかりであったりする。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "繁殖旺盛なエビガニのために、手長エビが少なくなったともいえよう。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争中、ソバ屋の天ぷらには、このエビガニを使ったとも聞いた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地の子供は、エビガニをとると玉網に入れたまま、工場からふき出る熱い湯をかけ、まっかにゆであがるのをその場で皮をむいて食べている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
