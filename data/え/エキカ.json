  {
    "uuid": "f62147ff-c0aa-55b2-aac9-56f9b679683b",
    "entry": "腋窩",
    "reading": {
      "primary": "えきか",
      "alternatives": [
        "えきわ"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
