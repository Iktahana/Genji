    "definitions": [
      {
        "index": 1,
        "gloss": "ramification",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "森の中の道は、あちこちで枝分かれしていて、迷いやすかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人生の岐路では、どの道を選ぶかで、その後の展開が大きく枝分かれする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会話が次第に複雑になり、話があちこちに枝分かれし始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この川、どこで枝分かれするんだろう？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その線の途中から枝分かれをして連歌が生じ、それからまた枝が出て俳諧連句が生じた。",
              "citation": {
                "source": "俳諧の本質的概論",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このムラサキは、山野向陽の草中に生じている宿根草で、根は肥厚していて地中に直下し、単一、あるいは枝分かれがしている。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして特にロンドンや帝国内の大都市において、これに応ずる種々の異なった商業の枝分かれがあることによって、混ぜ物処理をした商品の動きは多くの回り道を通っていて、その起源を追跡する非常に詳細な努力を拒んでいる。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、回り道をした枝分かれのある操作によって死の毒の一部が生命の必需品に入り込み、これが入り込むのを可能にした人たちに犯罪性を付け加えることができない。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "海百合状の腕が多く枝分かれした先の細い触手はこの上なく繊細、柔軟、強力で、正確な神経＝筋協調作用を有しており、あらゆる芸術その他の手を用いる作業において、類い稀な技巧と手際を発揮した。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにはガレノスの見解以外の何ものも無く、チェサルピノは他の同時代人と同じように血液は全身の全部分に栄養を与えるために大静脈およびその枝分かれによって身体に分布すると信じていた(*6)。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "生体は固体（骨、肉、すなわち大地、腐植土）および液体部分（水）からなり、その広範に枝分かれした脈管系（運河）は血液を運び、脈として呼び戻してナイル川の上昇下降、体温（火）と呼吸（空気、風）、を起こす。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "12本の静脈は23の枝分かれがあり、この他に幾つかの小さい管が記載されている。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "片方の尾根の末端は、さらにいくつかの小さな峰へと、枝分かれしていた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "母屋に向かうコンクリート敷きの小径が、平屋建ての別棟に向けて枝分かれしていた。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔からある道から、新道が枝分かれしていた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "海底の二人が足下を見れば、サンゴ礁が洞窟を作り、高さは十メートル、枝分かれしている。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "植物は薔薇、三本に枝分かれした中ほどのそれぞれに、見事な花が咲いている。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "村をはなれるとすぐアルプナッハの湖で、ルツァーンの湖水から枝分れするこの水は、ところどころに薄い氷を浮かべて、シルフにつつまれて静かにたたえた様子は、まるで変った感じをあたえておる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルピ Alpi の、南をめぐる北イタリヤの湖水のうちで、殊に美しいと称えられるこの湖は、北は一つ、南は、右ひだりに枝分れして、ちょうど、琴柱の形をしている、そのまんなかにはさまれた岬はヴェラージオで、コモの町は、西南端で、ミラノからとっつきにあたる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマーデンの村の近くで、枝分れする二条の、左から滾り落ちるのは、今日私が沿うて旅したベルニナの渓で、その辺では、フラッツバッハ Flazbach と呼ばれる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹枝状というのは結晶の発達する形の一種で木の枝のように沢山枝分れしたものをいうのである。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般に核が付くと其処で結晶は枝分れをするか、あるいは急に発達を早めるかすることが知られている。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "線香花火の火花が間歇的にあの沸騰している小さい火の球から射出される機構、それからその火花が初めのうちはいわゆる「松葉」であって、細かく枝分れした爆発的分裂を数段もするのであるが、次第に勢が減ると共に「散り菊」になって行く現象がよほど先生の興味を惹いていたようであった。",
              "citation": {
                "source": "線香花火",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央から六出している枝の先端に近い所で、簡単なしかし明瞭な小枝が出ている場合であって、こういう模範的な枝分れの例は、枝分れの現象の研究に大切な資料である。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この（Ｂ）図は、結晶が出来てから観測されるまで大分時間が経ったために、内部の構造即ち小凹凸が、昇華作用のためにかなり消えているのであるが、他の例では、この枝分れの点で結晶の核（蕊）が見えることが多い。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分結晶生成の途中、結晶の他の核が枝の一部に附著すると、そこから枝分れが生ずるものと思われる。",
              "citation": {
                "source": "『雪華図説』の研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この温泉にも、地下で途中から枝分れした湧出口が、他に幾つかあって、それが水中、あるいは谷水とすれすれに開いているとする。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルンネン Brunnen からルツァーンの湖の枝わかれしたウルネル・ゼーに近く沿うて、午後二時半、シシコンの停車場に着いた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（街路は碁盤のごとく、あるいは枝わかれするかのように、繁栄する四十万余家の都市である。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "細く枝わかれしたその白い灌木の間に、褐色の海藻が群生している。",
              "citation": {
                "source": "海底の散歩",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝わかれした淡紅の茎のさきになんてんに似た暗緑の実をつけている。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァル・テリーナは、なお深く東北に走って山の奥、アッダの水の源に、モンテ・コンフィナーレ Monte Confinale、ティロールのオルトラー Ortler も、僅かな途のりであるが、私の乗った電車は、その渓から枝別れして、ポスキヤーヴォの谷底を、ベルニナさして向かうのである。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
