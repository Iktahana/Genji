        "examples": {
          "standard": [
            {
              "text": "交通網の整備が進み、主要道路から細い道へと枝分かれしていく様子がよくわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "議論が白熱し、当初のテーマから大きく枝分かれして、様々な意見が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの頃、もし違う選択をしていたら、今とは全然違う人生になっていただろうな…。」と、人生の枝分かれを思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
