        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "映画館でエンドマークが画面に浮かび上がった瞬間、客席から自然と拍手が起きた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "フィルムにエンドマークが現れて、長い物語がついに幕を下ろした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "昔の映画は「THE END」というエンドマークが出るまで席を立たないのが慣習だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
