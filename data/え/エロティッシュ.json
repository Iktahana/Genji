          "literary": [
            {
              "text": "いや、まだもう一つ、さうやつて無言で向ひ合つてゐる中に次第に微かながらエロティッシュな興味が生じて來たからでもあつた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、まだもう一つ、そうやって無言で向い合っている中に次第に微かながらエロティッシュな興味が生じて来たからでもあった。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、まだもう一つ、さうやつて無言で向ひ合つてゐる中に次第に微かながらエロティッシュな興味が生じて来たからでもあつた。",
              "citation": {
                "source": "夾竹桃の家の女",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の気紛れ、芝居気、皮肉、洒落が強いて作った快活さが、エロティッシュの気味の悪い微笑や悩める本能の醸した暗く寂しい憂鬱と混って、非常に複雑な醜悪をそこに合成した。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしああ云う美少年の癖に少しもホモ・エロティッシュな気を起させないだろう。",
              "citation": {
                "source": "彼",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
