          "literary": [
            {
              "text": "一人でゐてもゐられるものの、なまじ、二人で慰め顔に、エネチアまがひの古い洋燈など点して見るので悲しくなる。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲエテが古い伊太利亞紀行を讀んでも、殊に其エネチア、ナポリ、シシリヤ等の諸篇は同樣の興味からして予等の膝を打たしめるのである。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、朝はやくヴエネチアを立つてパドワに来た。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
