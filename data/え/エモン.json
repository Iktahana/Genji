[
  {
    "uuid": "0c59941a-a1eb-5d12-b512-812ad3ea11b4",
    "entry": "衣紋",
    "reading": {
      "primary": "えもん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
