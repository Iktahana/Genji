        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから一年｜経って、昭和十八年の早春に、アス五ジ　ウエノツクという君からの電報を受け取った。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔翔けりゆく冬のフエノール〕翔けりゆく冬のフエノール、　　ポプラとる黒雲の椀。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いッそエノケンの孫悟空と逃げて満州辺へロケに来てやろうかとも考えたり、とりとめが無い。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和九年四月、渋柿）曙町より（二十）　有名なエノケンをはじめて映画で見た。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノケンもそれまでにはだいぶ距離がある。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日見た「エノケンの酔虎伝」でもお客様に出してある菓子を略奪に出て来る男の子がどの俳優よりもいちばん自然で成効しているように思われた。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "斜面に根を張ったエノキは左右に大きく枝を広げ、窓の向こうの五階の廊下にまで少し先をのぞかせていた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の向こうに一つの傘におさまったバアサンと女の子が消えていくのを見届けてから、オレはエノキの葉についたしずくをバシバシ払いながら五階の廊下を歩いた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "此俗｜本とジエノワ府｜商賈より出づ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "流離　その頃フアビアニ公子の書状屆きしに、文中公子のわがヱネチアに留まること四月の久しきに至るを怪み、強ひてにはあらねど、我にミラノ若くはジエノワに遊ばんことを勸めたる一節あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "曩に拿破里に在りし時、獨逸の士官等の、瑞西の山水を説くを聞き、一たび往いて觀んことを願ふこと漸く切なるに、汽船もて達し易きジエノワを距ること遠くもあらぬを知れば、意を決して往くことゝしつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりはジエノワに往きて、約束せし妻とその父母とを訪はんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝若し我が昔日の生涯を語らず、彼の馴るゝ小鳥の事、愛らしき歌妓の事などを祕せんと誓はゞ、われは汝を伴ひてジエノワに往くべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノシマヘフタリッキリデデカケルノイヤ？",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『エノシマヲフタリッキリサンポスルノイヤ？",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ヤブカラ　デテ、ウグヒスブエノ　ハウヘ　ヤツテ　キタノデ　アリマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウマヤノ　マエノ　ヒザシガ　ヒニ　ヒニ　アタタカク　ナツテ　クロイ　土カラ　白イ　ユゲガ　ノボリハヂメテ　ヰマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエヲ　一ポン　モツテ　イエイエノ　トグチニ　タツテ、ヒロ　ヒロ　ヒート　カナシイ　オトヲ　フルハセ、一セン　二センヲ　モラツテ　タビヲ　シマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイヘン　シヅカナ　ムラデ　イヌノ　ナキゴヱモ　キコエズ、イエイエノ　マドハ　ミナ　カタク　トザサレ、ガイトウニハ　ヒガ　トモツテ　ヰマセンデシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイドウニ　ソツタ　イエイエノ　ヒトタチハ、ムカシ　ジブンタチノ　ノツタ　バシヤガ　コドモタチニ　ヒカレテ　イクノヲ　ミルト、シゴトヲ　ヤメテ　オモテニ　デテ、バシヤヲ　ミオクルノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
