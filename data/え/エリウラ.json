        "examples": {
          "standard": [
            {
              "text": "このシャツ、衿裏に少し汚れがついているみたいだよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "クリーニングに出す前に、ワイシャツの衿裏の黄ばみを確認しておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夏用のジャケットは、通気性を考えて衿裏にもメッシュ素材が使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "黒い透屋の着物、白はかたの帶、水色のえりうらが見えてゐたが、無論素足で――「一ツ目の辨天樣へおまゐりに來て――」　と女はまた笑つた。",
              "citation": {
                "source": "下町娘",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
