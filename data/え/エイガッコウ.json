          "literary": [
            {
              "text": "私立静岡英学校の教頭になったからである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "英学校の職は故の如くである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "静岡を去るに臨んで、渋江塾を閉じ、英学校、英華学校、文武館三校の教職を辞した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は祖父を護して遠方に避難し、兄は京都の英学校に居り、家族の中で唯一人の男の彼は、母と三人の姉と熊本を東南に距る四里の山中の伯父の家に避難した。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は土地の英学校に英学をおさめ、ゆくゆくは東京にでて西欧思想の深処を究める志望をいだいてゐたのであつた。",
              "citation": {
                "source": "母を殺した少年",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
