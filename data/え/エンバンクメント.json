        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何か食べるところはありませんか」　エンバンクメントの外れに一軒の珈琲屋があり、どんよりした目つきの店主が二人を無表情でじろり見た。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンバンクメント沿いにウェストミンスターまで行き、ウェストを横切って、ハイドパークまで行こう。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、メアリ、疲れ果てたのを分かってくれたらなあ」　コニーがエンバンクメントの椅子に座って、泣き崩れた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ午前三時少し過ぎ、エンバンクメントはとても静かだ。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい夜だったので、テムズ川のエンバンクメントで眠り、コーヒー屋台で朝食を食べました。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンバンクメントでの夜霧や恐怖に、もう悩まされない。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、二時間前エンバンクメントでは寝食の危機に直面しました。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストランドや、周辺道路や、エンバンクメント沿いや、橋の上に大勢の野次馬が集まった。",
              "citation": {
                "source": "四日白魔",
                "author": "THE FOUR WHITE DAYS",
                "note": "青空文庫"
              }
            },
            {
              "text": "豪華なホテル、ストランドとテムズ川のエンバンクメント地区で一番目立つド派手なホテル、これが消滅しようとしている。",
              "citation": {
                "source": "四日白魔",
                "author": "THE FOUR WHITE DAYS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
