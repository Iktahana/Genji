          "literary": [
            {
              "text": "餌代丈になりゃ好いだよ。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "この小鳥は、安易な世話と僅少な食餌代とで六十日目毎に幾つかの雛鳥を巧みに巣立させた。",
              "citation": {
                "source": "十姉妹",
                "author": "山本勝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロボットが餌代込みで、一時間四分の三セント。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、餌代不要だ。",
              "citation": {
                "source": "那珂川の鱸釣り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩の惜む所は、餌代船賃に非ずして、職業を忘るゝ損害の大なるにあり。",
              "citation": {
                "source": "研堂釣規",
                "author": "石井研堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハゼ釣り乗り合いの舟代が三百円、餌代が三百円という法外な値あがりで、その代わり腕のよい女の掘り子は、一日千五百円ぐらいのかせぎをした。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
