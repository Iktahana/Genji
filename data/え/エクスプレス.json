        "examples": {
          "standard": [
            {
              "text": "朝の通勤ラッシュを避けるため、特急（エクスプレス）を利用することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この荷物は、エクスプレス便で送れば明日には届くはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「駅弁を買うなら、やっぱりエクスプレスに乗る前に駅で調達しないとね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "原注一六　ニューヨーク、『エクスプレス紙』。",
              "citation": {
                "source": "マリー・ロジェエの怪事件",
                "author": "『モルグ街の殺人事件』続編",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに対し、マック用のＤＴＰソフトの代表格であるクォーク・エクスプレスは、一九九二年十月に出荷予定の日本語版のバージョン３・１で解答を寄せる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "??「僕等は主義として、自分の云へないこと、乃ち、エキスプレス、發想し得ないことは、すべて價値のないものと信じてゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「僕等は主義として、自分の云へないこと、乃ち、エキスプレス、發想し得ないことは、すべて價値のないものと信じてゐる。",
              "citation": {
                "source": "――泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は一つ目をもっと端明に、エキスプレスして表現したものだといえる。",
              "citation": {
                "source": "ばけものばなし",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗客係が来て莫斯科から連絡する巴里迄の二等車の寝台が売切れたから一等｜許りのノオルド・エキスプレスに乗つては何うかと云つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれ、巨象の様な大機関車を先きにして、どの汽車よりも大きな地響を立てて、ウラジホストツクから倫敦までを十二日間で突破するノオル・エキスプレスの最大急行列車が入つて来た、怖しい威風を持つた機関車は今世界の凡ての機関車を圧倒する様にして駐つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "透徹した眼などと云うものは無く、考えずには居られない脳髄と、感じずには居られない胸と、エキスプレスせずには居られない熱情とを持った極の自然人。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノオルド・エキスプレスは綺麗な汽車なんですよ。",
              "citation": {
                "source": "戸の外まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "乘客係が來て莫斯科から連絡する巴里迄の二等車の寢臺が賣切れたから一等許りのノオルド・エキスプレスに乘つては何うかと云つた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとなれば、殊に戯曲に於ては、作者が故意に「へたな」エキスプレスションを用ふることがあるであらうし、又、さうでなくても、一語一語の効果は、それが肉声化される場合を顧慮して、細密に計画されてあると思はなければならないからである。",
              "citation": {
                "source": "戯曲の翻訳",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＡＪＥとは、オール・ジャパン・エキスプレス。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、ドアを開け、なかに入りながら、「オール・ジャパン・エキスプレスです」　と、いつものように言った。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁の電気時計をちらと見て、「オール・ジャパン・エキスプレス。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリ行きオリエント・エキスプレスの寝台券を買い、乗り込もうとする朝、急に高熱が出、目がくらくらして倒れてしまった。",
              "citation": {
                "source": "ブイヨン・ドンゾール",
                "author": "――十一時の肉の煮出し――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
