        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデモ　オヂイサンハ、「アノ　ラツパデハ　キコエナク　ナツタカラ、モツト　ヨク　キコエルノヲ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美人ト不美人トノ相違ノ真髄ハ何処ニアリヤト考エルノニ、要スルニ夫レハ主トシテ眉目ノ立体幾何学的問題ニ在ル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車ヲ運転シタガッタリ拳闘ヲ愛シタリスル一面、ガラニモナク生花ガ好キデ、京都ノ一草亭ノ娘婿ガ週ニ二回、イロ／＼珍シイ花ヲ持ッテ東京ヘ出テ来テ教エルノデ、ソノ人ニ就イテ去風流ヲ習ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………悪イ性質ノ女デモ、ソノ悪サガ露骨ニ見エルノハイケナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ今知ッタノカ、君ミタイナ利口ナ人ガ」「ダケド、ドウ云ウ気持カラソンナコトヲ考エルノ」「自分デ恋ノ冒険ヲ楽シムコトガ出来ナクナッタ腹癒セニ、セメテ他人ニ冒険サセテ、ソレヲ見テ楽シム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ蟋蟀ノ鳴ク季節デハアルケレドモ、コノ部屋デ聞エルノハオカシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ家ノ庭ニモ稀ニ蟋蟀ガ鳴クコトハアルガ、コノ寝室ノベッドニ寝テイテ聞エルノハオカシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラコリーハ止メルヨウニオ爺チャンカラ仰ッシャッテヨ、アタシモソレトナク云ウンダケレド、アタシガ云ッタンジャ颯子ハ聴イテクレナインデスカラト、婆サンハ訴エルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土曜カラ日曜ニカケテノ方ガ、落チ着イテ子供ニ会エルノデ佐々木ニハ都合ガイヽノダガ、コチラハ颯子ガ何ト云ウカ、聞イテ見ル必要ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ直カニ口ニ銜エルノニ今日ハ珍シクホールダーヲ用イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩暈ナラ大概二三分間デ平常ニ復スルノダガ、イツマデタッテモ物ガ二重ニ見エルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ガコンナニ生々シイ色ヲ帯ビテ見エルノハ神経衰弱ガヨホドヒドイ証拠ダナト、夢ノ中デハッキリトソウ思イナガラ、僕ハジーットソノ夢ヲ視ツメテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字ガ二重ニ見エルノデ同ジ行ヲ何度モ読ム。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、私のインフエルノ時代、―――今云ふやうな神経病に悩まされた時代は、まだ文壇に進出する以前、大学の二三年頃のことで、（その頃神経衰弱を直すために、常陸の国助川にある偕楽園別荘に転地したことは前に記した通りである）それから四五年の後京都へ旅立つ時分には殆ど快癒してゐたのであつた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
