[
  {
    "uuid": "fe1c52c1-6273-59db-8093-47f18de4d5b8",
    "entry": "笑み",
    "reading": {
      "primary": "えみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
