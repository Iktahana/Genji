        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレハ　タイヘン　ウツクシク　ミエタノデ　花タチハ　コノヤウナ　セカイニ　ウマレテ　キタ　コトヲ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "清三ノ方ハ病人デスカラ頭ヲ殴ッタダケデモ何トカ始末ガツクト考エタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "視力ガ恐シク衰エタノデ、読書モ思ウニマカセズ、他ニ消閑ノ法モナイカラ、ヒマツブシニイクラデモ書ク気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスレバ長イ間老人ニ取ッ掴マッテオ相手ヲシナイデモ済ムト、考エタノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事ニヨッタラ範囲ヲ蹈ミ越エタノデハアルマイカ、ト、多少疑イヲ抱カセルクライデアッテモヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシモ、コンナ事、アナタニ知ラセタクナイノデスガ、ドウシテモ、コノ問題ハ、アナタニ解決シテモラウシカ、手ダテガナイト考エタノデ、急ギ、コノ手紙書クノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ、ワタシノホシデ、コシラエタノデス。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
