  {
    "uuid": "dd904a37-60f6-591e-9afc-bc4494316b80",
    "entry": "英略",
    "reading": {
      "primary": "えいりゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
