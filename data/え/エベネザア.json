        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スクルージの洗礼名エベネザアも同様。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなものは他の世界から来るのだ、エベネザア・スクルージよ。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖降誕祭だよ、エベネザア！",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "元気を出せ、エベネザア！",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、指の差す方角へ眼で従いながら、打捨り放しにされたその墓石の上に、「エベネザア・スクルージ」と云う自分自身の名前を読んだ。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
