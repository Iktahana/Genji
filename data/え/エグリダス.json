    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一葉には、自分が恋愛について、友情について、人情のあやに対して抱いている人生感の窮極にある旧い常套を我から抉り出す力はなかった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "流れの本質のくさり（腐敗）を抉り出すことで、それへの文学的対蹠の本質を感じさせようとしているし、その点でむしろ一つの流れの中から云いすぎている、自分の流れを客観的に描き出していないという欠点が生じていると思います。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときに到っても、やはり葉子の中にあって彼女を一層混乱させ、非条理に陥らせている封建的な道徳感への屈伏を作者は抉り出すことに成功してはいないのである。",
              "citation": {
                "source": "「或る女」についてのノート",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、私どもに向って身上噺をせいと仰ッしゃるのは、言わば辛うじて治りかけた心の古疵を再び抉り出すような、随分惨たらしい仕打なのでございます。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
