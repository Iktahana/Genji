        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その六の卷なるエネエアスがキユメエの巫に導かれて地獄に往く條に至りて、我はその面白さに感ずること常に超えたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔エネエアスを戀人に逢せしサツルニアとヱヌスとをば、汝が上とこそ思へ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂※波を鞭ちてエネエアスはリユビアの瀲に漂へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エネエアスは去らんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "去りてアスカニウス（エネエアスの子）がために、ヘスペリヤ（晩國の義、伊太利）を略せんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エネエアスが歌にいはく。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エネエアスは無情なる語を出せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これヂドとエネエアスとの對歌なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我はアンヒイゼス（エネエアスの父）が靈の地下に安からんことを勉めき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エネエアスは行きぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エネエアスが舟は波を蹴て遠ざかりゆけり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に羨ましきはエネエアスの役勤めたる男なるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れヰルギリウスが詩の主人公エネエアスが乳媼の名にして、此港を以て其埋骨の地となせるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
