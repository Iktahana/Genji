          "literary": [
            {
              "text": "冠気・履気・少室気・営頭気・車気・騎気・烏気などというのはその形象によって名があるので、白気はその色、善気喜気等はその結果によって存在する名であろう。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "冠氣、履氣、少室氣、營頭氣、車氣、騎氣、烏氣なんどと云ふのは、其の形象によつて名があるので、白氣は其の色、善氣喜氣等は其の結果によつて存する名であらう。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
