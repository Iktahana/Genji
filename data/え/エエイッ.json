          "literary": [
            {
              "text": "至急お耳にいれねばならぬことが――」「エエイッ、さがれと申すに。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエイッ」　ポカーンと音がして、ハンマーは見事に林檎を打ち砕いた。",
              "citation": {
                "source": "人間灰",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人位でぶつかってみろ」　三人の逞しい警官が、たちまちその場に勢ぞろいをすると、一、二イ、三と声を合わせ、「エエイッ」　と扉にぶつかりました。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "エエイッ、死んでもいいや、というので、怪しきアルコールをガブリとやってオダブツとある。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵の力で敵をなげる柔道の、これこそ術だ、みごとにきまって、「エエイッ！",
              "citation": {
                "source": "小指一本の大試合",
                "author": "山中峯太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "呪文はわからないが、腰の棒切れをぬき、一念こめて、エエイッと気合を入れて虚空へ投げる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "エエイッ、エエイッ――続いて圧倒的な気合いが押した。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエイッ」　と抜き討ちに足元へ払いつけた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "対手の耳をつんざいたかと思うと、エエイッ、襷を切って払ったよう。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
