          "literary": [
            {
              "text": "Ａ　リヴィエェルつて「エテュウド」を書いた奴かい？",
              "citation": {
                "source": "ヴェランダにて",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの「エテュウド」を飜譯した連中に云はせると、リヴィエェルなんていふのはまるで希臘神話の中の龜みたいな奴で、生れつき飛べないくせに自分でも飛ばうとして、鷲かなんぞに引張り上げて貰つたが、途中で墜落してしまやあがつたと云ふのだが、――ほら、そんな繪があの本の表紙についてゐたらう？",
              "citation": {
                "source": "ヴェランダにて",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エテュウド」の臭ひがする。",
              "citation": {
                "source": "ヴェランダにて",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはエテュウド・プシコロジックか。",
              "citation": {
                "source": "ヴェランダにて",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
