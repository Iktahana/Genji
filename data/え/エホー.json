        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どんどん登って行くと前方に四人の登山者が見えましたのでエホーと声をかけますと返事がありました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼岳を下る途中エホーと声をかけてみますと案外にもザラ峠から返事がありました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐエホーと声をかけながら元気を出して登りますと、彼の登山者は槍肩の小屋へ入ってしまいました。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エホーと声をかけてみたが返事がない。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今あたり乗鞍の頂きに立って、エホーと声をかけているのではなかろうか、何だかそんな気がする。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エホーと声をかけてみたが、彼等は狩に夢中になっているらしく返事はなかった。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
