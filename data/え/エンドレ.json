        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ビーチボーイズは『ペット・サウンズ』『トゥデイ』『エンドレス・サマー』の三枚、ストーンズは『ホット・ロックス』があります。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い懸崖に圍まれて、淋しく横はる小村はエンドレゴォルと稱ばれた。",
              "citation": {
                "source": "鷲の巣",
                "author": "ビョルンステェルネ・ビョルンソン　Bjornstjerne Bjornson",
                "note": "青空文庫"
              }
            },
            {
              "text": "その名はエンドレであつた。",
              "citation": {
                "source": "鷲の巣",
                "author": "ビョルンステェルネ・ビョルンソン　Bjornstjerne Bjornson",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三の者は言つた――エンドレは人殺しをして此處へ逃げ込んだのだ。",
              "citation": {
                "source": "鷲の巣",
                "author": "ビョルンステェルネ・ビョルンソン　Bjornstjerne Bjornson",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は村の始祖エンドレの子孫ではなくて、髮がちゞれ、眼が細く、巫山戲てばかりゐて、女が好きだつた。",
              "citation": {
                "source": "鷲の巣",
                "author": "ビョルンステェルネ・ビョルンソン　Bjornstjerne Bjornson",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供じみた単純な言葉を話しだした『……あの金の姿、金の階段、音楽、あの音楽の所に戻してくれ、あの音楽と一緒にいたい、私はあの音楽そのもの……』などと単調に、エンドレスに。",
              "citation": {
                "source": "いえ、いえ、ラゴーフにはもう！",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
