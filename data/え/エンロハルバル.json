          "standard": [
            {
              "text": "遠路はるばる訪ねてきた師匠を、弟子たちは頭を下げて迎えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「遠路はるばるよくいらっしゃいました」と女将が玄関先で丁寧に頭を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "遠路はるばる来てくれた友人のために、精一杯の料理をふるまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「おう田巻さん」半年ぶりに見るなつかしさよりも、写真の題材が遠路はるばるわざ／＼やつてきたことが、まづ彼を上機嫌にしたのである。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "話を聞くと、彼はその湯けむりの写真に魅せられ、遠路はるばる別府を訪れたらしかった。",
              "citation": {
                "source": "湯けむり",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はこの方々が遠路はるばるここに来られたのであるから、十分に被害の情況を見ていただくとともに、諸君は誠心誠意をもって実際の被害民のこえを聞いてもらうようにされたい」　かくて暗いランプの光り一つの下で、人々の訴えや質問が夜の更けるまで交※に取り交された。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
