        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「同円光大師絵詞。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三宝絵詞」や「今昔物語」は或は其種本ではあるまいかとも考へられ、王朝末には、説経師の為事が、稍効果を表して来たのではなからうか。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼政の面目をあげたのは、経信の系統に薬を強くした絵模様や、絵詞見立ての趣向歌の印象の新鮮な点が、さうした潮先に乗りかけた為である。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "48　三宝絵詞・今昔物語では、動物の過去生を説いて、経を聴く為の仮身だと説く。",
              "citation": {
                "source": "漂著石神論計画",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "説経の材料は、既に「三宝絵詞」があり、今昔物語があつた。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは継信・忠信の絵詞らしい。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵詞は形の固定しないもので、文章が元のものと変つて来る。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵詞の固定しないのは、絵詞が読み上げられたからである。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸若舞は多く絵詞を読み上げてゐる。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、絵詞は読む人の自由になる。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで鎌倉時代以来の絵詞にはいろ／＼異本が出来たのである。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、一般には、絵詞は固定性が薄く、従つて、異本が多いのである。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵詞は大抵、初めは小さいものがだん／＼と大きくなつて行く。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、絵詞の書き出しは、「さてもその後」、「さる程に」、「そも／＼」などゝ書く。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "依頼を受けた書の種類は一様ではなく、『源氏』を始めとして長編の物語類、歌集類、諸種の絵詞、画賛画幅、色紙、扇面等で、中にも色紙と扇面との最も多かったのは当然のことだ。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "永正九年閏四月には、能登へ遍歴のため出発したのであるが、その発足以前に、実隆はかねて音一から所望されてあった『伊勢物語絵詞』を書写してやった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また延文の『諏訪大明神絵詞』には、根本は酋長もなかりしを、武家その濫吹を鎮護せんために、安藤太というものを蝦夷管領とすともある。",
              "citation": {
                "source": "奥州における御館藤原氏",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "南北朝頃の諏訪大明神絵詞に、当時の北海道における蝦夷に三種あることを記して、その一種に「日の本」と云うのがあるとある。",
              "citation": {
                "source": "国号の由来",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（『太平絵詞』）　商人は何事をなせしか。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしつゞいて信貴山縁起、伴大納言絵詞、鳥獣戯画、地獄草紙、餓鬼草紙、病草紙など、鎌倉期へわたつておびたゞしい絵巻物があらはれる。",
              "citation": {
                "source": "物語の絵画化についてなど",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　私がこゝに引用した原文が、そのまゝ絵詞になつてゐるわけではない。",
              "citation": {
                "source": "物語の絵画化についてなど",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりは文机に向い、またひとりは、先頃父が都から土産にと齎して来た絵巻物の絵詞を、頬づえついて読み耽っているのだった。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名な『後三年絵詞』の「地火炉ついで」の話などもあって、「地炉」に近い語は早くから知られているが、右の全国的なるジロをもって、軽率に地面にしつらえた炉のことと、解してしまうことは事実の無視になる。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを初めとして、藤原から鎌倉に、たくさんの絵巻があるが、なかにも伴大納言絵詞（伝光長）、餓鬼草子、北野天神縁起（伝信実）、春日明神験記（高階隆兼）などの名作がある。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶夢の「繪詞傳」などにも、この市振の一夜を繪に畫いて、芭蕉の前で遊女達が泣いてゐるところなど畫いたりしてゐる。",
              "citation": {
                "source": "文學に於ける虚構",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "『竹崎季長蒙古襲來繪詞』を見ても、國中の蒙古人は皆二個の辮髮――不思議に何れも前頭の留髮はないが――を垂れて居る。",
              "citation": {
                "source": "支那人辮髮の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも更に深く北に入つたのは、紫波郡に遺跡を有する同じく親鸞の弟子の是信房であつて、本願寺第三世の覺知宗昭も、如信の遺跡なる東山迄は來たことがある（最須敬重繪詞）。",
              "citation": {
                "source": "日本史上の奧州",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して、余輩は、此異同に關して、「伊吉連博徳書」に見えたる熟蝦夷、麁蝦夷、都加留の三種の區別、及び、諏訪縁起繪詞に見えたる、渡り黨、唐子、日の本等の區別を以て立論せんとするなり。",
              "citation": {
                "source": "蝦夷とコロボツクルとの異同を論ず之に潜みて",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "南北朝の頃になれる諏訪縁起繪詞に、鎌倉時代の末頃の蝦夷を區別して曰く、蝦夷が千島と云へるは、我國の東北に當て大海の中央にあり。",
              "citation": {
                "source": "蝦夷とコロボツクルとの異同を論ず之に潜みて",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして咄嗟の感じではあるが「伴大納言繪詞」などをロマンのはじまりとすると「八犬傳稿本」でも、まだ繪と文は確然と分離してゐないと思つた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
