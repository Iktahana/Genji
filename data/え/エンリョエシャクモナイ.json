        "examples": {
          "standard": [
            {
              "text": "彼の発言は遠慮会釈もなく、誰もが不快感を覚えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その態度は遠慮会釈もなく、明らかに失礼である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "上司の指摘は遠慮会釈もなく、部下を傷つけるものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "窓から押し込む横殴りの強い陽射しといふ奴は実に又遠慮会釈もない奴である、影みたいな与里の身体に矢張り莫大な黒を落して、伏せた頬から頤の下へジットリ湧いた黒色は、何んだか変に与里の存在そのものをキナ臭く思はせてしまふのだ。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "……僕達がねている頭の上で、彼等は遠慮会釈もない大声を出した。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
