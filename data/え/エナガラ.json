        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ冬ノ寒イ日デ、羽左衛門ハ熱ガ四十度近クモアッタニ拘ラズ、ブルブル震エナガラ水入リヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモコンナ生殺シノヨウナ手足ノ痛ミヲ怺エナガラ生キテイルヨリ、ヒト思イニ残酷ナ殺サレ方ヲシテ見タクモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度ハ方法ヲ改メテ、足ノ裏ノ朱ヲ一遍キレイニ洗イ落シ、足ノ趾ノ股マデモ一本々々拭イ取リ、立ッテ椅子ニ掛ケサセテ、予ハソノ下ニ仰向イテ臥、窮屈ナ姿勢ニ堪エナガラ足ノ裏ヲ叩キ、色紙ノ上ヲ両足デ蹈マセテ捺印サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
