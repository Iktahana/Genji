          "standard": [
            {
              "text": "古都の路地に漂うえも言はず趣のある薫りが、旅人の足を止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "舞台に現れた彼女はえも言はず美しく、客席が静まり返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "夕暮れ時の海岸線はえも言はず幻想的で、カメラのシャッターを押し続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "晝間はいぶせき茅屋も、梅花にうづもれて、夜色の中に縹渺たるさま、えも言はず。",
              "citation": {
                "source": "杉田の一夜",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
