        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「クラテエグス」、野薔薇などの枝生ひ茂りて、重圈をなせる榻列の石級を覆へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ外人等は寝入りばなで、食堂はがらんとしているから、私と園さんは異様な風体のまま食堂に闖入し、パンとハムエグスか何かでそこそこに朝飯を済ませサンドウィッチを作らせた上、人夫を引具し、勇ましくも（！",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州は大體にトウガラシをコショウといふ地域であり、その南部にはカウレエグス、即ち高麗胡椒の名がある。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州はだいたいにトウガラシをコショウという地域であり、その南部にはコウレエグス、すなわち高麗胡椒の名がある。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終り、新大阪へ、グリルで、ポタアジュ、ベーコンエグス、チキン何とか、うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松へ寄って理髪、バッタリ坂本に逢ひ、珍しや八洲亭でポタアジュ、ハムエグス、タンシチュウ、コロッケ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "教文館のフジアイスへ入りハムエグスを食ってると、ひどく糞意を催して来たので出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグス・マカロニなど皆わりに食へる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュ・ハムエグスと肉を食ひ、冷紅茶のんで室へ帰ると又寝てしまった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビーフ・エグスとパン、牛乳。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひるの部終って入浴、食事は大阪屋のトマトポタアジュにタイヨーのハムエグスと野菜ライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋で、大阪屋のランチとハムエグス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中西のハムエグスとおこわを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時に起きる、トーストとハムエグスをとり、すぐ出かける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂でハムエグスと紅茶。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルへ帰るとハムエグストースト紅茶。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食、トースト紅茶ハムエグスこれが不味し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋でトースト、ハムエグス紅茶。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベコンエグスとオートミール。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグストースト、ハンバークステーキにホットケーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時すぎ藤山も起き、食堂で朝食、コンフレークス、ハムエグス等。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂でハムエグスを食ひ、「昇給酒合戦」に手を入れる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂ハムエグストーストのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の出場が済んだのが十時頃、ホテルのグリルへ行って、樋口と二人で、オルドヴル、スープ、舌平目ムニエル、ハムエグスにキャビネットプディング二つ、ねむくならないやうにコーヒーをのみ、座へ帰ったが、けい古が中々進まない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って、ホテルニューグリルへ、樋口と吉本と提携興行の件につき語りつゝ、ミネストロンとハムエグス、メリンゲパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュ、ハムエグス、コーヒー、ペストリー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食がとてもいけなさうなので、不二アイス迄行き、ハムエグストースト他、ハムエグスのみうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグストーストと、ミニツステーキ、わりにいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "観光ホテルのグリルで、豆のポタージュとフライエグス、クラブハウス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
