        "examples": {
          "standard": [
            {
              "text": "週末は、近所のNPO法人が主催する清掃活動に参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼らは、子どもの貧困問題に取り組むNPO法人を立ち上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "NPO法人の活動報告会で、これまでの成果について説明があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このNPO法人の活動、本当に素晴らしいと思うんだ。私も何か協力したいな。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "呼びかけ人たちがつくったルールはあるが、ＮＰＯ法人や任意団体が定めるような規約の類はない。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
