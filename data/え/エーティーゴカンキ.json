        "examples": {
          "standard": [
            {
              "text": "このAT互換機は1990年代のモデルだが今も動作する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "産業用制御システムではAT互換機がまだ使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "AT互換機の堅牢性は現在のパソコンに引け継がれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "このＶＧＡ互換ボードが他社の手によって開発され、業界標準であるＰＣ　ＡＴ互換機に組み込まれた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくして世界の標準は、ＥＧＡに代えてＶＧＡを組み込んだＰＣ　ＡＴ互換機へと移った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし海外にあってあふれかえるＰＣ　ＡＴ互換機とＰＳ／２に囲まれ、かつ日本語を使う必要に迫られているユーザーにとって、ＤＯＳ／Ｖはまさに福音であった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして世界向けにはＰＣ　ＡＴ互換機を生産している日本のハードウエア・メーカーもまた、世界との橋渡しという正論にはしぶしぶか積極的かは別としてうなずかざるを得ない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
