        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チャプリンがその「街の灯」の一場面を撮るためにいかに多くのフィルムをむだにしているかは、エゴン・エルウィン・ウィッシュの訪問記を一見しても想像されるであろう。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブラバントやフランデルン行きの手紙がみんな……」「やあ、エルウィン・インメルタアルが来た」とハンスが言った。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう彼はハンスという名だし、インメルタアルはエルウィンというのだ。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "国王は泣かれた……「こりゃ大変だ」とエルウィン・インメルタアルが言った。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
