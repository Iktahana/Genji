  {
    "uuid": "59d11e5a-6231-5ac4-b8bf-029ef9fbb510",
    "entry": "円状",
    "reading": {
      "primary": "えんじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
