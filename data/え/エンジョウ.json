    "definitions": [
      {
        "index": 1,
        "gloss": "going up in flames",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い木造倉庫が火災で炎上し、あたりは騒然となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "衝突事故を起こした車が、衝撃で一瞬のうちに炎上した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "乾燥した季節に山火事が発生し、広範囲の森林が炎上した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "犯人が証拠隠滅のためか、アジトを炎上させて逃走した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "敵艦の者も此の勇者の姿を望見し、おじ恐れて、ただ、わが帆船のまわりをうろつき、そのおのずから炎上し沈没するのを待つより他はなかったのだ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して、三年後の建保元年癸酉のとしに、例の和田合戦が鎌倉に起り御ところも炎上いたしましたが、このやうなお夢の不思議はその後もしばしばございまして、またお夢ばかりではなく、御酒宴最中にお傍の人の顔をごらんになつて不意にその人の運命を御予言なさる事もございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月一日から地震がございまして、はなはだ縁起の悪い気持が致しましたが、果して陰謀やら兵乱やら、御ところの炎上、また大地震、落雷など、鎌倉中がひつくり返るやうな騒ぎばかりが続きました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親たちは、ただぼんやり、甲府市の炎上を眺めている。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根や柱と共にその家の歴史も共に炎上しているのだ。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿業に依って炎上し、神の意志に依って烏有に帰する。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はた、辻の真昼どき、白楊にほひわななき、雲浮かぶ空の色｜生あつく蒸しも汗ばむ街よ、あな音もなし、鐘はなほ鳴りもわたらね、炎上の光また眼にうつり、壁ぞ狂へる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "炎上焦げに焦がるる我心、そことしもなく聞ゆるは執着の日の喚叫、黒ずむ悪の火の羽ぶき、油日照の四辻は凄惨として音もなく、雲なき空に電流の渦まき消ゆる断末魔。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚破、炎上の火の光、見れどもわかぬ日ざかりにみるみる長く十字｜劃きゐすくむ帯の※色、あなと、昏めば、後より、戞戞戞と※ふませ、隙こそあれや、たとばかり、鞭ひらめかし、驀然、黒き甲と朱の色の蒸汽｜喞筒の馬ぐるま、跳りぞ過ぐれ、湯は釜に飛沫くわつくわと沸りたる紅火夜なり。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "火は葡萄染の深帳、花毛氈や、銀の籠、また、羅のころも、緑髪、わかき瞳に炎上の匂香熱く、『時』の呼吸、瞬き燻る『追懐よ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "告ぐ、基督は救ふべきものを救ひ、救ふべからざるものを救はざる事を、千言万句の祈祷は一たび基督を仰ぎ見るの徳に若かず、仰ぎ見るは心を以て仰ぎ見るべし、祈祷の教会をかしましうするは、尤も好ましからぬことなれ、我は凡ての教会の黙了せん時に、大活気の炎上すべきを信ず。",
              "citation": {
                "source": "各人心宮内の秘宮",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "為に後村上天皇は難を賀名生に避けられ、吉野の行宮は師直の放火によって炎上し、南朝の頽勢は既に如何ともし難い。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "堂塔僧房繁昌し仏法を行ず、炎上の時、尊像十一面観音、秀府二疋の犬の影像、北山へ飛び移る。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてなつかしい多くの酒倉も、あらゆる桶に新らしい金いろの日本酒を滿たしたまま眞蒼に炎上した。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど涙や笑声の惑を脱し、万象の流転の相を忘ぜむと、心の渇いと切に、現身の世を赦しえず、はた咀ひえぬ観念の眼放ちて、幽遠の大歓楽を念じなば、来れ、此地の天日にこよなき法の言葉あり、親み難き炎上の無間に沈め、なが思、かくての後は、濁世の都をさして行くもよし、物の七たび涅槃に浸りて澄みし心もて。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋の玉座　　　　ダンテ・ゲブリエル・ロセッティ心のよしと定めたる「力」かずかず、たぐへみれば、「真」の唇はかしこみて「望」の眼、天仰ぎ「誉」は翼、音高に埋火の「過去」煽ぎぬれば飛火の焔、紅々と炎上のひかり忘却の去なむとするを驚し、飛び翔けるをぞ控へたる。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "炎上の焔、赤々、千万の火粉の光、うちつけに面を照らし、声黒きわめき、さけびは、妄執の心の矢声。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋の玉座　　ダンテ・ゲブリエル・ロセッティ心のよしと定めたる「力」かずかず、たぐへみれば、「真」の唇はかしこみて「望」の眼、天仰ぎ「誉」は翼、音高に埋火の「過去」煽ぎぬれば飛火の焔、紅々と炎上のひかり忘却の去なむとするを驚し、飛び翔けるをぞ控へたる。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏訳詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど涙や笑聲の惑を脱し、萬象の流轉の相を忘ぜむと、心の渇いと切に、現身の世を赦しえず、はた詛ひえぬ觀念の眼放ちて、幽遠の大歡樂を念じなば、來れ、此地の天日にこよなき法の言葉あり、親み難き炎上の無間に沈め、なが思、かくての後は、濁世の都をさして行くもよし、物の七たび涅槃に浸りて澄みし心もて。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "戀の玉座心のよしと定めたる「力」かずかず、たぐへみれば、「眞」の唇はかしこみて「望」の眼、天仰ぎ「譽」は翼、音高に埋火の「過去」煽ぎぬれば飛火の焔、紅々と炎上のひかり忘却の去なむとするを驚し、飛び翔けるをぞ控へたる。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "炎上の焔、赤々、千萬の火粉の光、うちつけに面を照らし、聲黒きわめき、さけびは、妄執の心の矢聲。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の非を悟りて舊都に歸り、さては奈良｜炎上の無道に餘忿を漏らせども、源氏の勢は日に加はるばかり、覺束なき行末を夢に見て其年も打ち過ぎつ。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "炎上する花よ、灼鉄の草よ、毛皮よ、鱗よ、羽毛よ、音よ、祭日よ、物々の焦げる臭ひよ。",
              "citation": {
                "source": "鳥獣剥製所",
                "author": "一報告書",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　菅廟の条には蘭軒が幽斎の文を引いて炎上の年を考へてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼寺は七とせばかりさき炎上してかたばかりなる仮殿なりと書きたり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなはち炎上は天正八年に当れり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
