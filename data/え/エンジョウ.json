  {
    "uuid": "6c7c86f9-6f0e-5f7c-98d9-e1c1a0436c1c",
    "entry": "円上",
    "reading": {
      "primary": "えんじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
