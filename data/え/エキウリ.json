    "definitions": [
      {
        "index": 1,
        "gloss": "station vendor",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅の途中、駅売りのお弁当を買って新幹線の中で食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "地元の特産品が並ぶ駅売りコーナーは、いつも多くの観光客で賑わっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「これ、駅売り限定のポストカードだよ！」友人へのお土産に買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "駅売りのおばちゃんが、笑顔で「お気をつけて！」と声をかけてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "京橋へ来て、こういうくだらない生活を既に一年ちかく続け、自分の漫画も、子供相手の雑誌だけでなく、駅売りの粗悪で卑猥な雑誌などにも載るようになり、自分は、上司幾太（情死、生きた）という、ふざけ切った匿名で、汚いはだかの絵など画き、それにたいていルバイヤットの詩句を插入しました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの時、或る作家の文章が、その部分を切って、名をかくして人に読ませたら、おそらく読まされた者は駅売りのパンフレットのような種類の文章の中の数行を読まされたのだと思うに相違ない文章の書きかたであったのを、つよく印象づけられている。",
              "citation": {
                "source": "今日の文学の諸相",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐにナポリ行きへ乗換える人や、朝だちの旅客のために、プラットフォウムには、駅売りの呼び声が縦横に飛び交していた。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "水上温泉の旅館と、駅売りの弁当では、はやの焼き枯らしを、煮びたしにして客に出したところが、大そう歓迎されたのである。",
              "citation": {
                "source": "水と骨",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も近時の出版界の新しい現象は（駅売り又は頒布用の）パンフレットの洪水である。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "講演の速記と、その原稿を再生させて、駅売りパンフレットをこしらえて、幾人かの男が生計を営んでいたのでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅売りパンフレットも紙なしでもう駄目でしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "車が旭川駅へ入ると、森山は駅弁や蕎麦や駅売りのかん酒など一抱え買い込んできた。",
              "citation": {
                "source": "金山※話",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧国鉄現ＪＲ関係の、紙に印刷されたものならすべて収集しているというコレクターがいまして、戦後初の駅売りアイスクリームのパッケージを何とおりも見せてもらいましたし、写真にも撮って記事に使いました。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「北さん、いまの駅売の言葉がわかりましたか？",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物の声といふものはおもしろいものである、けさも、鶏の鳴声や汽車の音響によつて、もう夜明けにちかいことを知つた、大気の関係で、同一の音がいろ／＼に響くものである、そしてけさはまた風の工合で、駅売の触声がよく聞えた、べんとう、べんとう、――だが、ビール、正宗は聞きとれなくて仕合だつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅売の声がきこえる、夜はことによくきこえる、その声の調子に朝鮮人らしいのがまじつてゐる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、風のぐあいで、駅売の声がはつきり聞える、これはなやましいことだつた！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "港家小亀は関東節及び新内くどきを得意として、駅売の函のやうな小型卓子掛を首から吊して、五目浪花節のなんせんすに十二階随一の人気者としてよく全浅草を圧倒してゐた。",
              "citation": {
                "source": "異版　浅草燈籠",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日より駅売の弁当も食事時間外は無く（京都では七月二十何日とかゝら実施されたさうだが、東京でも今日から節米令が出て、時間を区切り、その時間外は一切米を出さず代用食のみ許すことゝなった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅売店にて「笑の小ばなし」と言へる、十銭の小冊子を求め、読み始めると中々面白し、ネタ箱を作ってネタになりさうなものどん／″＼切っておかう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
