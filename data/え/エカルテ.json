        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "競技は、そのうえ、私の得意のエカルテ（10）だった。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君はたしかに、今夜グレンディニング卿からエカルテで大金をまき上げた人間の本性をご存じない。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の袖の裏から、エカルテにもっとも肝心なあらゆる絵札が発見され、ラッパーのポケットからは、たくさんの骨牌札が発見された。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "エドガーが特に興味を持ったのは、一人の若者がエカルテにのめり込んでおり、その相手は明らかに外人だ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
