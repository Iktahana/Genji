    },
    "definitions": [
      {
        "index": 1,
        "gloss": "with a great deal of effort",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はえっちらおっちら荷物を運んでいた。",
              "source": "幻辞"
            },
            {
              "text": "おばあさんがえっちらおっちら歩いている。",
              "source": "幻辞"
            },
            {
              "text": "力を入れながらえっちらおっちら進んだ。",
              "source": "幻辞"
            },
            {
              "text": "階段をえっちらおっちら上っていく。",
              "source": "幻辞"
            },
            {
              "text": "重い荷物をえっちらおっちら持ち上げた。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら坂を登る。",
              "source": "幻辞"
            },
            {
              "text": "彼女がえっちらおっちら走ってくる。",
              "source": "幻辞"
            },
            {
              "text": "父がえっちらおっちら荷物を引きずっている。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら移動している人たち。",
              "source": "幻辞"
            },
            {
              "text": "兄弟がえっちらおっちら手助けしている。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら這ってきた。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら立ち上がろうとする。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら進みながら疲れている。",
              "source": "幻辞"
            },
            {
              "text": "子どもたちがえっちらおっちら遊んでいた。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら移動する。",
              "source": "幻辞"
            },
            {
              "text": "大きなかばんをえっちらおっちら持ち運ぶ。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら坂を下りていった。",
              "source": "幻辞"
            },
            {
              "text": "力いっぱいえっちらおっちら働く。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら急いでいく。",
              "source": "幻辞"
            },
            {
              "text": "えっちらおっちら歩く老夫婦。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "九段坂へ差しかかった時、荷車の後を押し押して、女連れに少しおくれて、えっちらおっちら登って行く少年詩人の姿がみえたが、そこまで来ると、庸三も何となし間が抜け、にわかに立ち止まった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝室にはスタンドがあるし、それで暗すぎるなら、食堂にだって、その次の部屋にだって、いくらでも電気がつくのに、何もわざわざ此那所までえっちらおっちら持ち出さないでもすむにきまって居る。",
              "citation": {
                "source": "盗難",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "では行って来ましょう」　山形警部は、あぶら汗を流しながら、自分のからだを背負って、えっちらおっちら歩きだした。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "転覆でもしようもんなら大変よ」「ハハハハこれを二十五円で売りつけられる阿爺も阿爺だが、それをまた二階まで、えっちらおっちら担ぎ上げる御前も御前だね。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "えっちらおっちら歩くほど肥満したひとで、思うことは何でもずばずば言ってのけるくせに、いつもにこにこした福相な顔をしていた。",
              "citation": {
                "source": "庶民生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを、御丁寧に抱き起した米友は、重いやつを、えっちらおっちらとここまでかつぎ込んで、この始末です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "とテレマークをやり、えっちらおっちら其の地点まで上って行き、雪上のスプールを見、さてＨＯＷ　ＴＯ　ＳＫＩをルックサックから出して、それに出ているテレマークの写真と自分のスプールとを比較し、泣いたり、笑ったりするマニア。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "客観的に、現実生活の諸関係のうちにある旧いものがひっぱっているから、相当に引きのつよい性格でも、決して図面で計ったようにくっきりとした一本の線を、でくまひくまなしにスーと押し出せず、皆えっちらおっちらと先ずこっちを出し、さて次にこっちを出しとやってゆく。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "作曲家の道もえっちらおっちらですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからえっちらおっちら歩いているのですから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は、仕事の上での収穫も皆無ではありませんでしたし、えっちらおっちらの読書も第三巻終りになり、その他のことでの獲ものは或意味では未曾でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は早く完成の形をとる人間ではないから、えっちらおっちらね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "仔入りの箱もそっちへ、えっちらおっちらもって行ったの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑と畑とにはさまれたなだらかな坂道を、おばあさんは健の首までもある大きな豚桶をになって、えっちらおっちら上がって行く。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　じいさんは、少年たちに、そういいのこすと、二つのカニおけを、棒でかついで、えっちらおっちらと、むこうの森のほうへ、あるいていくのです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりの男は、そのあとから、おもい長イスを、えっちらおっちらと、はこぶのでした。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事をすませたふたりは、にやにやと笑いかわして、そのまま、長イスを部屋の外へはこびだし、えっちらおっちら、玄関のほうへ歩いていきました。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は腹が立ちましたけれども、折角いい事を教えてくれたのですから、御礼を云ってここを出まして、それから二人連れでエッチラオッチラ一里ばかり歩いてその村に来ますと、成る程、村中は大変な騒ぎで、今が祭りの最中です。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして下駄をはいたまま、エッチラオッチラ上にのぼっていった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで勇気をつけて、一旦下りた崖を、またエッチラオッチラと上っていった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "解せないの」「進物箱が十｜行李もあって、十人の家来がエッチラオッチラ、大汗流して担いでおりやす」「進物や女駕籠はどうでもいい、まこと木曽家のお使者なら、うっちゃって置くのも気の毒だ」「へえ、さようでございますとも」「俺も根からの泥棒じゃねえ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生活というものが、ジグザグの線で進み、しかもまことにエッチラオッチラであること。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "エッチラオッチラにしろ、足の運びのように、一方ずつが、ともかく前へと運び出されつつ相互に動いているときはましですが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユリのエッチラオッチラは本年も勿論つづけて居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから重い緑色の風呂敷包み抱えてエッチラオッチラ家まで歩きました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして甲虫が五つも六つものおもちやの車をひいて、尻を指先でたゝかれながら、エッチラオッチラとオリンピックをさせられてゐるのを、可哀さうに思はれました。",
              "citation": {
                "source": "かぶと虫",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は雪線の上で登攀したり、エッチラオッチラ歩いたりしたのと同じぐらい屡々、雪線の下をぶらぶらした。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　怪人物は、そんなことを、いいながら、運転手にてつだわせて、眠っている賢二君のおとうさんを車の外に出して、ふたりがかりで、エッチラオッチラ、暗い森の中へ、はこんでいきました。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "エッチラオッチラ、まるで、よっぱらいのようなかっこうで、さも、なんぎらしく、階段をおりてくるのです。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "トランクあけて歯磨出して、ピチンとしめたら手拭がなかったり、開けたりしめたり、結局洗面所迄エッチラオッチラ運んだり、あゝ面倒くせえ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
