        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "われはその美しさを見るにつけて、血を嘔くおもひをなしつゝ、悄然として場を出でたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "慟哭数日、ついに血を嘔くに至った。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ嘔くようじゃ」と三沢は答えた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘔くのかナ、と思っている所へ向側の老人が這う様にして私の方へやって来た。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頻にせきあぐるを見て、かたへに腰かけたる男、船童をよびて、嘔くうつは持て來らしむ。",
              "citation": {
                "source": "房州紀行",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて歸り來りて、叔母とおぼしき人を伴ひてゆきしが、また獨り歸り來りて、席に伏して、いたく嘔く。",
              "citation": {
                "source": "房州紀行",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘔くものもない妙な不安な状態。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱が高いので絶えず冷やさなければならないし、嘔く物の始末や薬の世話など、夜中でも自分でてきぱきやって呉れた。",
              "citation": {
                "source": "七日七夜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
