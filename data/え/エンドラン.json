        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "監督がエンドランを指示し、打者はバットを振らずに塁に出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "足の速い選手がいるときはエンドランが有効な作戦だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "エンドランが成功したおかげでチャンスが広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "一二塁間突破をねらったヒットエンドランは、ライナーになって、ジャンプした二塁手にとられ、飛び出した一塁走者も刺されて、一瞬にしてチェンジになってしまった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これで終わったと思ったら大まちがい、ヒットエンドランなんだぜ」　といいながら、慶一は令子を見る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
