  {
    "uuid": "c7c8d5a1-27c1-5303-9eac-4afa587ce829",
    "entry": "エナイ",
    "reading": {
      "primary": "えない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "口デ言エナイホド喜ビマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシャハ氷デヒヤセト云ウケレドモ、氷ガカエナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "深イ注意ヲモッテカカル人間ニ対シ適当ナ電波的保護ヲ急グノデナケレバ、世ノ中ニハ「手ニオエナイ神経病者」トイワレルモノガ年ト共ニ激増スルデアロウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時近隣デハ隅田川添ノ今戸橋白髯橋間ノ狹イ地帶ニ火ノ手ガ見エナイダケデ、西ハ龜岡町、吉野町、山谷町、玉姫町イヅレモ火ノ手ガ盛デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ／＼、ソレデ思イ出シタガ、予ニモ全然ペデラスティーノ趣味ガナイトハ云エナイカモシレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老年ニナルト誰デモソウカモ知レナイガ、近頃予ハ一日トシテ自分ノ死ノコトヲ考エナイ日ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "振リ向ケナイカラ顔ハ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフテキデモ鰻デモ過度ニナラナイ程度ナラ差支エナイトノコトナノデ、何デモオイシク食ベテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪サニモ限度ガアリ、盗癖、殺人癖等ハ困リモノダケレドモ、ソレモ一概ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ寝室ニハ極メテ微カニ、手ニ痛ミヲ与エナイ程度ニ冷房ガ施シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "首ダケデ他ノ部分ハ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今浴ビテルトコロナノ、チョウドオ晝寝ノ時分ダト思ッテ覗イテ見タノ」「今日ハ日曜ダッタッケナ、浄吉ハイナイノカ」ソレニハ答エナイデ別ナコトヲ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンニハソレガ相当ヨ」「セメテコウシテル間、シャワーヲ止メテ貰エナイカナ」「止メル訳ニ行カナイ、触ラレタ傍カラ直グト綺麗ニ流シチャワナイト気味ガ悪イ」予ハタヾ水ヲ呑マサレタ気ガシタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕ニモ分ラン、僕ハアンマリ浄吉ノコトヲ考エナイヨウニシテイル」「アタシモソウナノ、聞イテモ彼ハ面倒臭ガッテホントノコトヲ云ッテクレナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "惚レッポイコトモ惚レッポイガ飽キッポイコトモ飽キッポイノハ親譲リデ、若イ時ノ予ト同様デアルト考エテイタガ、今日デハ左様ニ簡単ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "血壓計ハ予ニハ見エナイガ、佐々木ノ顔ツキデ大凡ソ察シガツク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ自分ノ喉ガ鳴ッテイルノダトハ思エナイデ、自分ノ体以外ノトコロカラ鳴ッテ来ルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪ノ形ガソンナニ委シク見エタノニ顔ハドウモハッキリ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "爪ノ化粧モコノ伝デ、詳細ニ書イタラソノ煩ニ堪エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何トモ云エナイ老醜ナ顔ダ」予ハ鏡ノ中ノ顔ヲ見テカラ、次ニ颯子ノ容姿ヲ見ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッチガ原因デ、ドッチガ結果トモ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「隣ニ佐々木サンガ寝テヽクレヽバ何カアッタッテ安心ジャナイカ、ネエ、颯チャンハコッチデ寝テオクレヨ」「煙草ガ吸エナイノガ困ルワ」「吸ッタライヽサ、イクラデモ吸ッテオクレ」「ソンナコトヲシタラ佐々木サンニ叱ラレチャウワ」「オ咳ガヒドクッテイラッシャイマスカラネ」ト、佐々木ガアトヲ引キ受ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデカラ後ドンナ形ノ石ノ下ニ葬ムラレヨウト差支エナイヨウナモノダガ、予ハ矢張気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ必ズシモ不可能トハ思エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ予ニハソウ思エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日、七日ノ晩ニ僕ハスデニ木村ニ対シ淡イ嫉妬（淡クモナカッタカモ知レナイ）ヲ感ジツツアッタノニ、―――イヤソウデハナイ、ソレハ去年ノ暮アタリカラダッタ、―――ソノ半面、僕ハソノ嫉妬ヲ密カニ享楽シツツアッタ、ト云エナイダロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ノソウシテイル様子ニ何トモイエナイ色気ヲ感ジル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ児玉氏ナラ差支エナイト思ッタケレドモ、ソレデモ妻ノコウイウ醜態ヲ見セルノハ好マシクナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間モウロウロシテ来タノニ違イアルマイ）来タノデアルガ起リ得タカヲ、努メテ考エナイヨウニシタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
