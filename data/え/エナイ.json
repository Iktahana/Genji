[
  {
    "uuid": "5193cbea-9268-562f-962f-7d18b6c5ccd6",
    "entry": "得ない",
    "reading": {
      "primary": "えない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "接尾辞",
        "形容詞"
      ],
