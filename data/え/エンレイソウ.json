        "examples": {
          "standard": [
            {
              "text": "深山の木陰で延齢草が白い花を静かに咲かせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "延齢草の三枚の大きな葉が苔の上に広がり、独特の存在感を放っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "北海道の山中では、初夏になると延齢草が群落をなして咲く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "この霊泉は知る人も少ないらしく、鮫島君が前からくわしいので、同君が延齢草の遺伝学的研究家であるのにちなんで、私はたわむれに「延齢ノ湯」と呼んでみた。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
