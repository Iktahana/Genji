        "examples": {
          "standard": [
            {
              "text": "深山の木陰で延齢草が白い花を静かに咲かせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "延齢草の三枚の大きな葉が苔の上に広がり、独特の存在感を放っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "北海道の山中では、初夏になると延齢草が群落をなして咲く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "この霊泉は知る人も少ないらしく、鮫島君が前からくわしいので、同君が延齢草の遺伝学的研究家であるのにちなんで、私はたわむれに「延齢ノ湯」と呼んでみた。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来学者によりてその実物の考えがまちまちになっていて、ある学者はこれをエンレイソウ（ユリ科）ならんといい、ある学者はヤクモソウ一名メハジキ（クチビルバナ科）であろうといい、またある学者はそれはツクバネソウ（ユリ科）であるといっていて、今はこのツクバネソウをそれに充るのがまず通説の様になっている。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
