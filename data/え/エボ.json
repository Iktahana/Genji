        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "みんな六つの瀬戸もののエボレットを飾り、てっぺんにはりがねの槍をつけた亜鉛のしゃっぽをかぶって、片脚でひょいひょいやって行くのです。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みると向うの方を、六本うで木の二十二の瀬戸もののエボレットをつけたでんしんばしらの列が、やはりいっしょに軍歌をうたって進んで行きます。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッテテドッテテ、ドッテテド　肩にかけたるエボレット　重きつとめをしめすなり。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが愕ろいたことは、六本うで木のまた向うに、三本うで木のまっ赤なエボレットをつけた兵隊があるいていることです。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドッテテドッテテ、ドッテテド、　寒さはだえをつんざくも　などて腕木をおろすべき　ドッテテドッテテ、ドッテテド　暑さ硫黄をとかすとも　いかでおとさんエボレット。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドツテテドツテテ、ドツテテド肩にかけたるエボレツト重きつとめをしめすなり。",
              "citation": {
                "source": "月夜のでんしんばしらの軍歌",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドツテテドツテテ、ドツテテド、寒さはだへをつんざくもなどて腕木をおろすべきドツテテドツテテ、ドツテテド暑さ硫黄をとかすともいかでおとさんエボレツト。",
              "citation": {
                "source": "月夜のでんしんばしらの軍歌",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バナナのエボレットを飾り菓子の勲章を胸に満せり。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士等大将のエボレット勲章等を見て食せんとするの衝動甚し。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "この際私が将軍の勲章とエボレットとを盗みこれを食しますれば私共は死ななくても済みます。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで閣下、この好機会をもちまして更に閣下の燦爛たるエボレットを拝見いたしたいものであります。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（エボレットを渡す。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "）大将「いかん、いかん、エボレットを壊しちゃいかん。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "実におん眼からみそなわすならば勲章やエボレットなどは瓦礫にも均しいじゃ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "やむなく食みし　将軍のかがやきわたる　勲章とひかりまばゆき　エボレットそのまがつみは　録されぬ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな六つの瀬戸もののエボレツトを飾り、てつぺんにはりがねの槍をつけた亜鉛のしやつぽをかぶつて、片脚でひよいひよいやつて行くのです。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みると向ふの方を、六本うで木の二十二の瀬戸もののエボレツトをつけたでんしんばしらの列が、やはりいつしよに軍歌をうたつて進んで行きます。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドツテテドツテテ、ドツテテド　肩にかけたるエボレツト　重きつとめをしめすなり。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが愕ろいたことは、六本うで木のまた向ふに、三本うで木のまつ赤なエボレツトをつけた兵隊があるいてゐることです。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドツテテドツテテ、ドツテテド　寒さはだへをつんざくも　などて腕木をおろすべき　ドツテテドツテテ、ドツテテド　暑さ硫黄をとかすとも　いかでおとさんエボレツト。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある人の話では電気の絶縁のためにエボナイトを使ってある箇所を真鍮で作って、黒く色だけをつけておいた器械屋があるという。",
              "citation": {
                "source": "断水の日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉地はいとしくってならぬようにエボニー色の雲のようにまっ黒にふっくりと乱れた葉子の髪の毛をやさしくなで回した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸を歩くと、ミレ村共同宿泊所、エボン村共同宿泊所等と書かれた家屋があり、其の傍で各島民が炊事をしてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "海岸を歩くと、ミレ村共同宿泊所、エボン村共同宿泊所などと書かれた家屋があり、その傍で各島民が炊事をしている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "エボナイトのような弾力と光沢を持った、あらゆる樹木の梢に群がる木の芽は、ずんずんと日｜毎にふくらんで行き、いろいろの小鳥は思い思いの音色で木の枝に囀り廻っていた。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旋条がかなり磨滅し、撃鉄や安全環はニッケルが剥落して黒い生地を露し、握りの処のエボナイトの浮彫も、手擦れで磨滅してしまっている。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エボナイトじゃないわい。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又私を見たとしても、それがセルロイドやエボナイトの商人だとは感附かなかったかも知れないのである。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シイゼエボオイ・エンドゼエガアル」と。",
              "citation": {
                "source": "地球儀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
