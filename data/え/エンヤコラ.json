        "examples": {
          "standard": [
            {
              "text": "「えんやこら」と掛け声を上げて木を運んだ。",
              "source": "幻辞"
            },
            {
              "text": "力仕事の男たちは「えんやこら」と唱っている。",
              "source": "幻辞"
            },
            {
              "text": "重い荷物を運ぶときに「えんやこら」と声を合わせた。",
              "source": "幻辞"
            },
            {
              "text": "船乗りたちは「えんやこら」と掛け声をかけて帆を上げた。",
              "source": "幻辞"
            },
            {
              "text": "建設作業員が「えんやこら」と掛け声をかけている。",
              "source": "幻辞"
            },
            {
              "text": "日本の伝統的な労働歌で「えんやこら」という掛け声が使われる。",
              "source": "幻辞"
            },
            {
              "text": "大勢で重いものを持つときは「えんやこら」と掛け声をすると楽だ。",
              "source": "幻辞"
            },
            {
              "text": "祭りで神輿を担ぐ人たちが「えんやこら」と叫んでいた。",
              "source": "幻辞"
            },
            {
              "text": "江戸時代から「えんやこら」という掛け声は使われていた。",
              "source": "幻辞"
            },
            {
              "text": "「えんやこら」という掛け声は力を合わせるときの合図だ。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "彼は井戸に片足を突っぱって、えんやこらさと勇ましく引いた。",
