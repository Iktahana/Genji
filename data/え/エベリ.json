        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "エベリ編集長は気楽にすぐ会ってくれるだろう。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "エベリ氏が肘掛椅子に寄りかかり煙草をふかしながら言った。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "エベリ、すまないがこれに目を通してくれないか」　ヘラルド紙のエベリ編集長がマーキュリー紙を手に取るさまはあたかも不潔なものに触るかのようだ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "中味を信じるか」　エベリ編集長が思慮深く言った。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "声明を口述した男はアストリア国王でもなく、私でもない」　エベリ編集長がほれぼれして見上げた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "意味が分かるか」「そもそも、名優が国王を演じていたというのか」　とエベリ編集長が尋ねた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "エベリ編集長、この事実に確信が無かったら、俺はやってくれと頼まない。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間はあるか」　エベリ編集長が慎重に答えた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへエベリ編集長があたふたと戻って来た。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
