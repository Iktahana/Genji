    "definitions": [
      {
        "index": 1,
        "gloss": "erotic",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの女優さんの衣装、ちょっとエロすぎない？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はエロい視線を送ってくるので、目を合わせないようにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "思春期のエロい妄想が止まらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この漫画の絵はエロくて、大人が読んでも楽しめる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼に『ヌウ※ル・エロイズ』があれば、是に物のあはれの説があり、戀愛の説があるのも似てゐる。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "アベラアルとエロイズの墓だ。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "他でもない、それはアベラアルとエロイズの事蹟だ。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "アベラアルとエロイズの愛。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中にあるアベラアルとエロイズの事蹟を歌った訳詩の一節をもう一度開けて見た。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが君、アベラアルとエロイズの墓サ。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都大学の高瀬が隣室に居た頃、柳博士等と連立って訪ねて行ったあのペエル・ラセエズの墓地にあるアベラアルとエロイズの墓は、まだありありと岸本の眼に残っていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮令アベラアルとエロイズの事蹟が一種の伝説であるというにしても。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅から岸本が国の新聞紙へあてて送った折々の通信は節子の手で切抜にして保存してあったくらいで、その中に書いてあるアベラアルとエロイズの名は節子の記憶にも残っていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はよく節子にあのアベラアルとエロイズの話をしたことを思い出した。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛欲生活に充たされていた元始の人間はおのずからに催情的の芳香を、呼吸の中に持っていたと、碩学エロイスが説いている。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本で初演のが一つ、フリュートのコンチェルトが一つ、あとヴェトーヴェンの第三（エロイカ）。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アベラールとエロイーズの話、御存じでしょうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「エロイカの第二楽章、あの葬送行進曲を演奏して、蝋燭をつけて行列するんですって。",
              "citation": {
                "source": "旅だち",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソー自身、浪漫主義の端初をなすと云われるが（物語『新エロイーズ』）、そうすればロマンス的・芸術的な・個性の自由が、ここで政治的な市民の自由へ結び付いたと云っていいかも知れない。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体散文は韻文詩の規則を無視したという点に於てロマンティークな文学にぞくすると云わざるを得ないが、ルソーの今云ったアベラルドゥスに倣った「新エロイーズ」（〔Julie ou la Nouvelle He'loi:se〕）が、近代ロマンティシズムの初めだと云われることは無意味ではない。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さん――元来、私はエロイカの名称によって知られているベートーベンの第三シムフォニーが大好きであります……と、海の方へ真向きに向って、半ばは独語の如く、半ばは演説の如く叫び出したのが、尋常の声ではありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――きのふの午後も、今かうやつて貴方に手紙を書いてゐるこの木蔭に寢ころびながら、私はアベラアルとエロイィズの手紙の事を書いた本に讀みふけつてゐました。",
              "citation": {
                "source": "七つの手紙",
                "author": "或女友達に",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイネの門下より出でて、標象論の見地よりして、一個の神話学説を組織せしものをエロイツェルとす。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "エロイツェルの標象論に反対せしものに、フォスあり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケルメス・エロイーク（女だけの都）」では、城囲みに逢ってうろたえまわる亭主どもを奥へおしこめ、女房たちだけの機略で敵の大将を思うように料理してしまう。",
              "citation": {
                "source": "うすゆき抄",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "とはいいますが、僕、そのうちでも特別に、フランソア・マリ・アルウェ・ド・ヴォルテエルの「ラ・アンリヤアド」と、それから、ジャン・ジャック・ルウソオの「ラ・ヌウヴェル・エロイイズ」とが欲しいんです。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あるいはまた、彼がベートーヴェンのエロイカを指揮した方法にたいし、憤怒の叫びをあげた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベートーヴェンのエロイカを聞いたり演奏したりしながら、欠伸を我慢することに――（なぜならこの曲は諸君を退屈がらせるからだ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣りの奏楽珈琲店から響いてくる腹踊りの折り返し句が、エロイカの葬送行進曲に交っていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスチーユの勝利者ユラン将軍はロブコヴィッツ家に泊まっていたが彼はベートーヴェンの友であり擁護者であり、『エロイカ』と『第五交響曲』とが彼に献呈せられた。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エロイカの葬送曲の中に、征服者の悲劇的終局への予言を認めて彼はみずから興がっていた。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにまた、ベートーヴェンは『エロイカ』の終節の一主題を一八〇一年の作品から取っている。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベートーヴェンの前半生の作品には、その最も高いものの中にさえ、崇高な『エロイカ』の中にさえ、なお帽子の羽飾のような自負的な装飾がある。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスカニニのエロイカ竹内浩三がらがらまぬけたいかづちがらがらトスカニニのゆくトスカニニのエロイカのゆくがらがら花を見蛇を見むすめを見見るものを見がらがら帽子を忘れステッキを忘れズボンを忘れがらがらひたぶるトスカニニのエロイカのゆく",
              "citation": {
                "source": "トスカニニのエロイカ",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
