        "examples": {
          "standard": [
            {
              "text": "古い工場の屋根から、黒い煙管が空に向かって伸びていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "暖炉の煙管から立ち上る煙が、冬の訪れを告げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "煙管の内部清掃は、火災予防のために重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
