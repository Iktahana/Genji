        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "恐らく不幸な被害者は生きたまゝ竈中に押込まれ燃え熾る焔管に突込まれてゐる間に人間が經驗した限りでの最も慘苦な死の苦悶を嘗めたに違ひない恐るべき形迹があつた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
