        "examples": {
          "standard": [
            {
              "text": "写真を撮るとき、日陰では適切なエクスポージャーを設定するのが難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夕日の明かりを考慮して、カメラのエクスポージャーを調整した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "エクスポージャーが長すぎたせいで、写真が全体的に白っぽくなってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
