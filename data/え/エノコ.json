  {
    "uuid": "c468482b-494d-56f0-8fdc-a1d84dbf0576",
    "entry": "エノコ",
    "reading": {
      "primary": "えのこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オンダモダイタモエンブチハウノモオマエノコジャモノ、キナガニサッシャイ、イカニモショッショ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワメテアタリマエノコトナノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "後にイエノコと訓読して家の子郎党と並称せられたものは、すなわちもと中間男に相当する「侍」で、国法上この家人階級に当るものであった。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌は、結局原本、「削遺有」とあるので、旧訓チルナミ・タレカ・ケヅリ・ノコセルであったのを、真淵の考で、千蔭の説により、「削」は「消」だとして、フレルハダレカ・キエノコリタルと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエノコヒビトヲヨンデヤラウ　アトレスモシツテイル",
              "citation": {
                "source": "朝",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハ、アサッテ、ヨルノ十二ジニ、ウエノコウエンノ、トショカンノウラニ、イマス」「マア、お前、何をいっているの、お前の側に悪者がいて、お前にそんなことを喋らせているのね。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂ちゃん安心おし、きっと助けてあげるからね」「ケイサツヘ、イイツケルト、オマエノコドモヲ、コロシテシマウゾ」　アア、何ということだ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東地方を始めとして、今でもは痩ぎすであり、また引締まっているのだから、ころころしているからエノコロだと思うのは当らない。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登の半島の引込んだ村々で、アエノコトというのも同じ祭で、これも最近まで旧十一月の五日または四日、あるいは新暦十二月の月送りのその日であった。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを迎えて来る旧十一月の初のある日を、アエノコトともいうのは饗応の式の意であろう。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アエノコトの要点　単なる字義の上からの推定でも、祈年祭が国家の公の祭となったのは、他の一方よりは早かったかと思われる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登の半島で近年注意せられたアエノコトという祭もその一つで、是は別にまた報告する人があるはずだが、此方は収穫期にさらに近い旧暦霜月初旬の行事であり、作法にも一段と新嘗と似たものがある。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アエノコト　今では、刈田の跡に藁だけを円錐形に積みあげた積藁が、田園風景に趣を添えているが、昔、物盗りの心配のなかったころは、刈りとった稲を穂つきのまま田んぼの中に積み、そこで乾燥させ、保存するとともに、田の神を祭ったものであった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに注目される一例としてあげたいのは、能登半島の奥まった村にアエノコトという祭があることである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノコ　隱岐の島前では葛の根をエノコと謂ふ（昔話研究一卷九號）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "エノコ　隠岐の島前では葛の根をエノコという（昔話研究一巻九号）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
