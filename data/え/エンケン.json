    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その顔を、あから顔を見れば、ことさらに作ッた偃蹇恣雎、無頓着な色を帯びていたうちにも、どこともなく得々としたところが見透かされて、憎かった。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "偃蹇として澗底に嘯く松が枝には舞い寄る路のとてもなければ、白き胡蝶は薄き翼を収めて身動きもせぬ。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹽見村の龍伏の松、千年の老幹偃蹇して、ひろさ百坪に及ぶ。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
