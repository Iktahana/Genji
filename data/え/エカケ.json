        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これはさながら地獄の絵掛地。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "お寺へ屡々連れて行つて、地獄極楽の御絵掛地を見せて説明した。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでであるから述べておきたいが、同じく大捏鉢で、白絵掛の上に、松の大木を雄渾な筆致で描いたのがある。",
              "citation": {
                "source": "京都の朝市",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その特色は明確に朝鮮のいわゆる「三島手」、すなわち白絵掛けとか、刷毛目とか、象嵌とか、彫りとかの手法を継承したものたることを語っている。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ鶏龍山の作が白絵掛けではなく、白絵刷毛目なのか、それは材料がかくすることのみを許すからである。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "多く白絵掛けをし上に絵を描く。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白絵掛けの無地が得意のようであるが、このほかに飴釉や黒釉も沢山使う。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お寺へ屡々連れて行つて、地獄極樂の御繪掛地を見せて説明した。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
