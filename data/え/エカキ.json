        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あたゝかく、風のない朝、十時時分、僕は蜜柑山の芝のスロウプに腰かけて、海を眺めてゐると、絵かきの朝居閑太郎が、僕の妻に案内されて、僕の前に立ち、情熱のこもつた息苦し気な調子で、そして対者に遠慮する微笑を浮べて「エカキが――」と云つた。",
              "citation": {
                "source": "朝居の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "久保は激しく震へる胸を辛うじて怺えながら、「僕、エカキの久保です。",
              "citation": {
                "source": "階段",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵二等でエカキ連中と遊んでいる。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフェーのイスに、夜腰を下していたら、エカキのナレのハテの様な、面も人のよさそうな青年が来て、ハサミで肖像を切りぬいてやろうと云うて、寄って来たので、可哀そうだったからやらせてやった。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "エカキは俺と林と二人切りだ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "エカキさん方がすばらしいモデル女だというオッパイ小僧もセントラルにでていたが、美しくなかった。",
              "citation": {
                "source": "安吾巷談",
                "author": "ストリップ罵倒",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕に色々と話しかけ、エカキの卵だなどとデタラメなことを答えていると、誂え向き、ケッコウ、突然男は叫んで、葉書のような名刺をだし、明朝ぜひ訪ねてこい、金もうけの蔓がころがっていると言う。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕に色々と話しかけ、エカキの卵だなどゝデタラメなことを答へてゐると、誂へ向き、ケッコウ、突然男は叫んで、葉書のやうな名刺をだし、明朝ぜひ訪ねてこい、金もうけの蔓がころがつてゐると言ふ。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
