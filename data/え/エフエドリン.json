        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昨日一日の疲れか明方やや強い喘息發作、アストオル吸入で鎭まるには鎭まつたが何やら不安なのでエフエドリン一錠半服用、例の陶醉的作用でやがて再び昏昏と眠り入る。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明方の發作今日も少し重くエフエドリンを服用したが、この四五日にない秋晴れの穩かな日で割に氣分がいい。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エフエドリン二錠を服用してすぐ臥床。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
