        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それに次いで少し古いが同じビクターのエリッツァが良い。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけてもエリッツァの「歌の殿堂」は名盤の一つであったと思うが廃盤になっている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "古いのではビクターにエリッツァがある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリッツァ　Maria Jeritza（ソプラノ）　大戦後にドイツから米国へ渡った時は大変な人気であった。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーラーが映画に転向した後へ、メトロポリタンの支配人が、エリッツァを迎えたわけである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "リードを、シャリアピンやエリッツァのように歌って、面白く聴かせるのは、少くとも本格のドイツ・リード歌手としては恥じなければならぬところだ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは遙かに後の話だが、ドイツで修業したファーラーの圧倒的な人気を忘れかねて、メトロポリタンの支配人は、ファーラー凋落後、同じドイツで修業した、ドラマティック・ソプラノ歌手のぴか一、イエリッツァをスターに迎えた。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
