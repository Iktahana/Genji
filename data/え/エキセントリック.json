        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はちょっとエキセントリックな服装をしているが、その才能は誰もが認めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その芸術家の作品は、エキセントリックな発想と斬新な技法で知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「え、そんなことするの？！」と、彼女のエキセントリックな行動に皆が驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この古い時計は、エキセントリックなデザインだが、正確に時を刻み続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その女の歴史の切ない必然を見ることをしない男たちは自分らの不明を反省するより浅はかな理想の幻影にエキセントリックなまでに殉じようとした彼女らをあざける。",
              "citation": {
                "source": "『静かなる愛』と『諸国の天女』",
                "author": "――竹内てるよ氏と永瀬清子氏の詩集――",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十日（火曜）　気がゆるんだような、がったり落ちがしたようで、よるは長く寝たにもかかわらず、頭は止すまらなかったので、妙にエキセントリックになって居る。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして作家の努力は即ち神経、感情のエキセントリックな者であって嘗て人間の達しなかった眼に見えなかった感情、人の達しない境に入るところに在ると思うのである。",
              "citation": {
                "source": "絶望より生ずる文芸",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキセントリックな方だ、とは思っていました。",
              "citation": {
                "source": "最初の印象",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめからエクセントリックな人間なことはツインコタの人も皆知っていたが、夜になると寝室の窓に灯りが映るだけで、家は何個月経っても閉め切りである。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし少しエクセントリックなところがありすぎるように思われます。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "神経のエクセントリックな衝動とのバランスの意味で。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "東大でも、伊藤ハンニまがいの山師がでているし、きわめてエクセントリックな性格と生活態度の女子学生が大阪の実家で弟に殺されたという事件があったし、法科の学生が教室でエロティックな映画を公開したというおどろくべきこともありました。",
              "citation": {
                "source": "新しい抵抗について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠らなかった夜明けのエクセントリックなカーブでリーパ〔ぼだい樹〕の並木の彼方へ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小都会のこういうエクセントリックな女性、石森の忠子にしても。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "エクセントリックな男の子なり「じら」がえろうて、と。",
              "citation": {
                "source": "日記",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕も二三度引張って行かれたが、あの女には確かに、プラトニックな恋の相手には適してるらしいエクセントリックな所があるね。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一は硬ばり、即ちしなやかさに欠けているということ、　第二は中心はずれ、これはエクセントリックなものといつてもいい。",
              "citation": {
                "source": "笑について",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう思って私の魂は遠くバビロンやアッシリヤの古代の伝説の世界にさ迷ったり、コナンドイルや涙香の探偵小説を想像したり、光線の熾烈な熱帯地方の焦土と緑野を恋い慕ったり、腕白な少年時代のエクセントリックな悪戯に憧れたりした。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "別段この少年の頭がエクセントリックだというのではない。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも私たちがエクセントリック味を満喫している間も、何か面白い場面でも中では映っているのであろう。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いにエクセントリックを仲よく半々に分け合いながら、今や黙々として語るに言葉もなく私はもっぱら麦酒ばかりガブガブと飲み、少年はチェリ・ブランデーを所望して炭酸で割りながら、おのおの無念無想の盃を挙げている時であった。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾分さっきエクセントリック時代にガブ飲みした、麦酒の酔いが発してきたせいもあろう。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
