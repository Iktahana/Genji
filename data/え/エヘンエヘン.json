        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "えへんえへんと二つばかり大きな咳払いをして席に着いた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――旦那様は、呶鳴りつけるつもりだったらしいが、新任の楚々たるモダン小間使のやったことと分ると、くるしそうにえへんえへんと咳ばらいをして、早々奥へひきあげていった。",
              "citation": {
                "source": "什器破壊業事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいっと耳をすますと隣室やほうぼうの部屋々々の壁をとおして、えへんえへんとのどをきる音やぼそぼそいう会話がきこえてくる。",
              "citation": {
                "source": "放浪作家の冒険",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついむじゃきにウソをいってしまいそうになったので、はずかしくなったけど、花はえへんえへんとせきをして、王子くんのせいにしようとした。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あの子、こんなのを見たら、すねちゃうだろうな……きっと、とんでもないほど、えへんえへんってやって、かれたふりして、バカにされないようにするだろうし、そうしたら、ぼくは、手あてをするふりをしなくちゃいけなくなる。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかのねずみが何か生意気なことを言うとエヘンエヘンと言うのが癖でした。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつでもエヘンエヘンと言ってばかりいたやつなんだ。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺三郎がエヘンエヘンとせきばらひをしながら幕の横から出て来て丁寧にお辞儀をしました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘンエヘンと云っているのも聞えます。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺三郎がエヘンエヘンとせきばらいをしながら幕の横から出て来て丁寧にお辞儀をしました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "論より証拠……たたいて御覧になればわかる事で……どこに種仕掛があるかは、眉に唾をつけて御覧になれば、すぐに、おわかりになる事と存じますが……エヘンエヘン…………。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜となく昼となく甘ったるい言葉ばかりかけるので実の両親までもが、朝から晩までエヘンエヘンと云っていたという。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの……鳥打帽を……茶色の鳥打帽を眉深く冠っておられましたので、よくわかりませんでしたが、モウ一人の方はエヘンエヘンと二つずつ咳払いをして、何度も何度も唾をお吐きになりました」「アハハ。",
              "citation": {
                "source": "近眼芸妓と迷宮事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘンエヘン」　と咳払いをしました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」艶「さう云へばさうね、二言目にはすぐ止める……と、ねえ、」私「エヘンエヘン。",
              "citation": {
                "source": "嘆きの孔雀",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しきりにエヘンエヘンと咳払いをつづけて来る。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "（詩人の、「エヘンエヘン」といふ声）妻　　（平気で）うるさいのね。",
              "citation": {
                "source": "世帯休業",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "多次郎がエヘンエヘンと笑ひながらガチャガチャにはしやぎ出したら、総江は大変機嫌の良い顔をして、多次郎の遊んでゐるバケツをガタガタ振つてみせたり、突然チュッ！",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヘンエヘン、用事の方はどうしたんだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘンエヘンエヘン、そこを開けて貰おう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "南蛮秘法箋",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘンエヘンエヘン、寒いのは我慢するが、年寄りに煙は大禁物だ」「どうしましょう、ちょっと、お待ち下さい。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "南蛮秘法箋",
                "note": "青空文庫"
              }
            },
            {
              "text": "人よりも頭のわるいことを始終わすれないようにしましてね」「エヘンエヘンエヘン」　と安斉先生は続けさまだった。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「できないね」「…………」「相変わらず頭がよくないな」「エヘンエヘン」「ちょっと見せなさい。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語は漢文なぞとちがって大事だからね」「エヘンエヘン」「なんでございますの？",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親ゆずりなら、おまえに数学のできるはずはない」「どうもいけません」「家のものはみんな数学がいけない」「エヘン」「語学の方はどうにかこうにかやるが元来花岡家には数理の頭がないのらしい」「エヘンエヘンエヘン」「安斉はかぜを引いたかな？",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若様がたが内証話をすると、「エヘン、エヘンエヘン」　とくる。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
