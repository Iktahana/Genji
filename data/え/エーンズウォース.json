        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから断頭吏の歌をうたって斧を磨ぐところについて一言しておくが、この趣向は全くエーンズウォースの「倫敦塔」と云う小説から来たもので、余はこれに対して些少の創意をも要求する権利はない。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "エーンズウォースには斧の刃のこぼれたのをソルスベリ伯爵夫人を斬る時の出来事のように叙してある。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでだからエーンズウォースが獄門役に歌わせた歌を紹介して置く。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "倫敦塔や、セント・ポールス寺院を訪うたびにエーンズウォースの小説を思い出さずにはいられなかった。",
              "citation": {
                "source": "科学的研究と探偵小説",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
