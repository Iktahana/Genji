        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さっき佐藤夫妻が見舞に来てくれて、エキホスの湿布を胸にしろということになり、そうすると、冷えるといけないから猶床に入っていなくてはならないから一筆。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、あなたも風邪気で咳が出て、胸へ響くようであったら、すぐエキホスの湿布をなさいませ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月十二日　〔巣鴨拘置所の顕治宛　目白より（封書）〕十二月十二日　エキホスがきいて胸の気持が楽になり、きょうは例の五時すぎに七度三分。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜は胸のエキホスをとり換えながら、修治さんは悲しそうな顔をなさっていられる。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
