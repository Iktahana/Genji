  {
    "uuid": "7b1acbf0-b13d-50e6-9ee5-aa1c9df4c7b5",
    "entry": "延胡",
    "reading": {
      "primary": "えんご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "要するに彼女の味方のエンゴ射撃が鞏固な時には自宅に戻ってノンビリできるのが当然なのである。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンゴロが火の作用か何かでゆがんで来ると中の茶碗がゆがんでいる。",
              "citation": {
                "source": "瀬戸・美濃瀬戸発掘雑感",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も文法については一方ならぬ研究の力を費やしたものですからその点についていろいろ質問しますと、そういうむつかしい事は私は知らんからしてこれからラサ府に行く道にエンゴンという所がある。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンゴン寺　其寺がかねてタシ・ルフンプー寺の老僧に教えられて居った文法学者の居るエンゴンという寺である。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで公道を取らずにそのエンゴンという寺へわざわざ上って参りました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [],
      "antonyms": [],
      "related": []
    },
