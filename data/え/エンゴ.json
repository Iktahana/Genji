[
  {
    "uuid": "a94497ce-9928-5b63-b370-1486c2500157",
    "entry": "縁語",
    "reading": {
      "primary": "えんご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "use of related words to enhance expression (in classical Japanese poetry or prose)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "万葉集の歌には、水の流れと涙を重ね合わせた縁語がよく見られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "源氏物語を読むと、和歌の修辞法として縁語が巧みに使われているのがわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生は古文の授業で、「花」と「眺める」のように関連の深い言葉を組み合わせるのが縁語だと説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "裸男口吟して曰く、名にし負ふ箒川べにゆあみして　　こゝろの塵も拂はれにけり『箒の縁語にて、塵を拂ふと云ひたるは、氣が利きたるやうにて幼穉なり』と、夜光命冷かす。",
              "citation": {
                "source": "鹽原新七不思議",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "四季の題は多く客観的にして、『古今』以後客観的の歌は増加したれど、皆縁語または言語の虚飾を交えて、趣味を深くすることを解せざりしかば、絵画のごとく純客観的なるは極めて少かり。",
              "citation": {
                "source": "曙覧の歌",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語を多く用うるは和歌の弊なり、縁語も場合によりては善けれど普通には縁語かけ合せなどあればそれがために歌の趣を損ずるものに候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "むやみに縁語を入れたがる歌よみはむやみに地口駄洒落を並べたがる半可通と同じく御当人は大得意なれども側より見れば品の悪きこと夥しく候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語に巧を弄せんよりは真率に言いながしたるがよほど上品に相見え申候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語及び譬喩　蕪村が縁語その他文字上の遊戯を主としたる俳句をつくりしは怪しむべきようなれど、その句の巧妙にして斧鑿の痕を留めず、かつ和歌もしくは檀林、支麦のごとき没趣味の作をなさざるところ、またもってその技倆を窺うに足る。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語を多く用うるは和歌の弊なり、縁語も場合によりては善けれど、普通には縁語、かけ合せなどあれば、それがために歌の趣を損ずる者に候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "むやみに縁語を入れたがる歌よみは、むやみに地口駄洒落を並べたがる半可通と同じく、御当人は大得意なれども側より見れば品の悪き事｜夥しく候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語に巧を弄せんよりは、真率に言ひながしたるがよほど上品に相見え申候。",
              "citation": {
                "source": "歌よみに与ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語を多く用うるは和歌の弊なり、縁語も場合によりては善けれど普通には縁語かけ合せなどあればそれがために歌の趣を損ずる者に候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "無暗に縁語を入れたがる歌よみは無暗に地口駄洒落を並べたがる半可通と同じく御當人は大得意なれども側より見れば品の惡き事夥しく候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語に巧を弄せんよりは眞率に言ひながしたるが餘程上品に相見え申候。",
              "citation": {
                "source": "歌よみに與ふる書",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌玉きはる内の大野に馬なめて朝ふますらん其草深野　其草深野の一句縁語の如くにて縁語にあらず。",
              "citation": {
                "source": "萬葉集を讀む",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "又縁語を使ふことも枕言葉やかけ言葉と共に明治以来禁断同様であつたが、之も作者は構はずに使ふのである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "戯れに一、二の俳句を作る、趣味において得る所あるに非ず、語句において練る所あるに非ず、あるいは縁語、駄洒落に思ひを凝らし、あるいは極めて浅薄陳腐なる意匠を繰り返して独り自ら喜ぶ。",
              "citation": {
                "source": "俳句の初歩",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁語及び譬喩　蕪村が縁語その他文字上の遊戯を主としたる俳句をつくりしは怪むべきやうなれど、その句の巧妙にして斧鑿の痕を留めず、かつ和歌もしくは檀林、支麦の如き没趣味の作を為さざる処、また以てその技倆を窺ふに足る。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に挙げたる三句が同じく「小倉山」と「小暗き」との縁語を趣向とするに至りては、その変化なきに驚かざるを得ず。",
              "citation": {
                "source": "古池の句の弁",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "八百比丘尼を中心として、かうした因縁語りが、長い連環をなしてゐる。",
              "citation": {
                "source": "古代研究　追ひ書き",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の意味の歌人の、歌から出ないのに反して、後の方の女房は物語・日記類の脚色もある、歌の多く交つた散文に進んで、さうして、盛んに引き歌・故事・縁語等で、律文化した文章を書いた。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し、かけ語・縁語・枕詞・序歌・本歌などで、幻象を畳み絡めるのとは違うて、とにかく、内部からする発想上の弾力であるから、よい傾向であつた。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "其に力添へる者は、枕詞・序歌・懸け詞・縁語・本歌などである。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "えぞのえんごさく、きばなのあまな……さういふ小さな可憐の花が奇蹟のやうに白や黄の個性を今年も明らかに見せてほころび始める。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
