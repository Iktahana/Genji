[
  {
    "uuid": "0f27e112-6b3e-5d53-805f-39ec41d05d41",
    "entry": "延命",
    "reading": {
      "primary": "えんめい",
      "alternatives": [
        "えんみょう"
      ],
      "is_heteronym": false
    },
    "grammar": {
