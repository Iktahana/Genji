        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "えん麦はヨーロッパ原産の穀物だ。",
              "source": "幻辞"
            },
            {
              "text": "えん麦の栽培は冷涼な地域で行われる。",
              "source": "幻辞"
            },
            {
              "text": "朝食のオートミールはえん麦から作られている。",
              "source": "幻辞"
            },
            {
              "text": "えん麦は健康食として知られている。",
              "source": "幻辞"
            },
            {
              "text": "農家はえん麦の収穫をしている。",
              "source": "幻辞"
            },
            {
              "text": "えん麦の粉は焼き菓子の材料になる。",
              "source": "幻辞"
            },
            {
              "text": "えん麦にはタンパク質が豊富に含まれている。",
              "source": "幻辞"
            },
            {
              "text": "馬の飼料としてえん麦が使われることがある。",
              "source": "幻辞"
            },
            {
              "text": "えん麦の収穫量は天候に大きく左右される。",
              "source": "幻辞"
            },
            {
              "text": "えん麦は現代の自然食ブームで注目を集めている。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "」「それやあ、お前さまんとこの馬はえん麦をたべてるんだもの。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "えん麦なんか、ちよつとにほひをかゞせるだけだからな。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
