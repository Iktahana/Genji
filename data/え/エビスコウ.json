        "examples": {
          "standard": [
            {
              "text": "毎年11月のえびす講では、近所の商店街が活気づく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "えびす講の時期に合わせて、商品の新作発表会を開催することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古い木製の札がえびす講の時に神社で配布される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "年の暮のえびす講などに忘年芝居を催したりする派手な店で北新道のあたしの家の並びの荷蔵に、荷車で芝居の道具を出しに来たりしていた。",
              "citation": {
                "source": "大丸呉服店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "初春とか、えびす講とか、何ぞの折というと、茶わん屋捨次郎はよく客を呼んだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
