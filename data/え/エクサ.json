        "examples": {
          "standard": [
            {
              "text": "エクサバイトは10の18乗バイトを表す単位だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "スーパーコンピュータはエクサフロップスの計算能力を持つと予想されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "データセンターのストレージ容量はエクサバイト級に達している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その友達が、お手紙有難うと云ったぎりで、あのエクサイティングな紙については一言も言及してくれないのが、非常に物足りなかった。",
              "citation": {
                "source": "木蔭の椽",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エクサイトし、手をやや暫く握ってはなさず。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせもう夏も過ぎた事だから、すっかり寥れているだろうが、人に訊いてきたレエクサイド・ホテルとか云う、外人相手の小さなホテルだけでも明いていて呉れればいいが――と思って、湖畔で乗合から降り、船の発着所まで往って、船頭らしいものを捉えて訊くと、「さあ、レエクサイドはどうかな？",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "レエクサイド・ホテルと云うからには、もう少し洒落た家かと思っていたら、なんの事はない、――丸木作りの、いとも粗末なバンガロオだった。",
              "citation": {
                "source": "晩夏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり「エクサントリック」といふことは、それだけでは「畸形」に属するとは限らないのであつて、その本質に於て常に病理学的な症状の区別ができるやうに思ふ。",
              "citation": {
                "source": "日本人とは？",
                "author": "――宛名のない手紙――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
