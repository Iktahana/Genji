        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ルチフエエル」（魔王）も神に背きし報にて、胸を氷にとぢられたるが、その大いなる口をば開きたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「ルチフエエル」が姿をば、一たび見つるもの忘るゝことなし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は予が京都でピエエル・ロチイ的の見方をするのを喜ばぬかも知れないが、京都といふものの傳説から全く自由な予は、どうしてもかくの如き漫畫派的羅曼的に見ないわけにゆかぬ。",
              "citation": {
                "source": "京阪聞見録",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "返辞１　新入学生が、初めて学校の校庭を踏むときには、地べたを護謨毬か何ぞのように感じるほど、神経質になるものだが、ある年の新学期にエエル大学に入って来た若い人たちのなかに、とりわけ神経質な学生が一人あった。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前｜仏蘭西の大統領官舎でフエリツクス・フオウルからルウベエ、フワリエエルと三代の大統領に料理番を勤めた男があつて、ある時こんな事を言つてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがフワリエエルと来てはお話にも何にもなつたものでは無い。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "腸から歌７・６（夕）　ラフエエル前派の詩人ロゼツチが自分の詩集を、亡き妻の棺に納めて葬つたのを、後になつて友達の勧めに随ひ、妻の墓を掘かへして、詩集をとり返したのは名高い話だ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西の作家モリエエルは、自分の作物が出来上ると、先づ婆さんの女中に読み聞かせてみて、婆さんの解らない点は幾度か書き直したといふ事だ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "返辞５・１女性　新入学生が、初めて学校の校庭を踏むときには、地べたを護謨毬か何ぞのやうに感じるほど神経質になるものだが、ある年の新学期にエエル大学に入つて来た若い人たちのなかに、とりわけ神経質の学生が一人あつた。",
              "citation": {
                "source": "茶話",
                "author": "昭和三（一九二八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピエエル・モロオは煙草商なり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "シテエ・フワルギエエルの十四番地へ来ると徳永は最う起きて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「プリム・ロオズ」の様な循俗的な脚本が毎｜夜の様に演ぜられて比較的第二流の俳優が登場し、名優ムネ・シユリイやル・バルヂイなどの得意とするコルネエユ、ラシイヌ、モリエエルなどの鉅匠の作を演ずる日が削減されるのは遺憾なことであるから、マス君の議論は真に発言の時を得たものであつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はドルシエエル君の指揮の下に第二回の決戦が開かれ、互に巧妙な突撃と迅速な回避とを交換して第一回にも優る猛烈な戦闘を続けて居る中、マス君は右腕に二回迄敵｜刄を受けた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜日、ペエエル・ラセエズの大墓地へ入つて行つたら、文豪ミユツセの墓に一株の柳が青んで文豪の彫像を掩うた其枝にメルルが啼いて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリエエルとラ・フオンテエヌの墓が並んで居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けば最初に此墓へ葬られたのがモリエエルであつたと云ふ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家のコロオやフルギエエルの墓なども目に附いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリエエルは机に向つて脚本「良人学校」に筆を着けて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "義理の間にせよ父子で結婚は許されないでせう」と云ふと、モリエエルは苦悶し乍ら「是非結婚する事を許して呉れ」と云ふ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此眩しい様な豪奢な光景の中へ盛装したモリエエルの第二の夫人アルマンも加はつて居て、其ブリヤントな容姿が水際｜立つて衆目を惹き附ける。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリエエルと結婚して既に十余年を経た後なのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を偶然来掛つたモリエエルが瞥見した。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の場は同じく、※ルサイユの宮庭内にある劇場の楽屋で、王室｜附俳優の部屋が左右に設けられ、右手にモリエエル夫婦の部屋と先妻マドレエヌの部屋とが並び、扉には各俳優の名が白墨で記されて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮庭の宴会から細君の手を執つて帰つて来たモリエエルの顔は蒼醒めて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリエエルは年若な妻に対する誘惑の多い事を感じて人知れず煩悶する。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリエエルは堪まり兼ねて「今日の園遊会での密会は何のざまだ」と云ふ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の部屋から先の夫人のマドレエヌが手燭を執つて現はれ一人残つたモリエエルを慰める。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三幕目は又モリエエルの家である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリエエルは彼れや是やで気を腐らし脚本「厭世家」に渋渋筆を着けて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛乳嫌ひのモリエエルは飲まうとしない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
