        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「それじゃ『エックホオフ』はいかが。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "『エックホオフ』ならそれよりは宜しいんですか。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの父はエックホオフと申しますのよ。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "『エックホオフ』となるとまるで違います。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるえらい俳優にエックホオフというのがあったくらいですよ。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エックホオフなら及第ですな。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、もう今じゃあなたはエックホオフでなく、ほかの名を名乗っておられて、小さいお丈夫なアントンさんのお母様で、少しばかり気管支をわずらっておられるというわけなのですな。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはガブリエレ・エックホオフの、貴下よ、貴下が御自身のものと呼んでおられる婦人の物語です……そしてよく御留意下さい。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴下がガブリエレ・エックホオフを占有すべく決心せられた時、おそらく貴下の食道筋肉は、あたかも美味なスウプか珍貴な料理かに面した時のごとく、ぐびぐびと動き出したことだろうと思われます。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし彼女の子は、ガブリエレ・エックホオフの息子は、栄えて生きて凱歌をあげています。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガブリエレ・エックホオフの息子が乗っていたのである。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
