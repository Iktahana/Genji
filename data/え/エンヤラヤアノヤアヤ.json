        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "岡持ちさげて、また、「エンヤラヤアノヤアヤ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エンヤラヤアノ、エンヤラヤアノ、エンヤラヤアノヤアヤ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エンヤラヤノ、エンヤラヤノ、エンヤラヤアノヤアヤ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊エンヤラヤアノ、エンヤラヤアノ、エンヤラヤアノヤアヤ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、こうした見知らぬこの北方の夏の夜の雰囲気の何処かで、内地で聴くようなあの三絃の音締めがして、そしてあのエンヤラヤアノヤアヤである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神戸の縉商であるＮさんなぞは、飄逸な海亀さながらの長い首を前伸びに踉けさして、ヤレ漕げソレ漕げエンヤラヤアノヤアヤである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンヤラヤアノヤアヤや。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「エンヤラヤアノヤアヤはおもしろいね。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンヤラヤアノ、エンヤラヤアノ、エンヤラヤアノヤアヤ………………　暗い暗い海、　星。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
