    "definitions": [
      {
        "index": 1,
        "gloss": "smoke pollution",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "工場周辺の住民は長年にわたる煙毒に苦しみ、行政に対策を求める運動を起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "明治期の足尾銅山では煙毒が農地を荒廃させ、深刻な社会問題となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "煙毒による農作物の被害が相次ぎ、農家は損害賠償を求めて訴訟を起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "〔さき立つ名誉村長は〕さき立つ名誉村長は、　　　寒煙毒をふくめるを、豪気によりて受けつけず。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が重き瞼の下に、眠れりとも見えず、覚めたりとも見えぬ眼の色は、瘴煙毒霧を吐く大沢の水の面にも譬ふべきか。",
              "citation": {
                "source": "夜あるき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に煙毒というて、かの阿片の中毒だ。",
              "citation": {
                "source": "日支親善策如何",
                "author": "――我輩の日支親善論",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
