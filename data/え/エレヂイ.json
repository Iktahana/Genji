        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「スプリング・ムーンが、別れた恋人のかたちに似てゐるといふセンチメントをうたつたエレヂイである。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「月が恋人のかたちに似てゐるといふのが、どうしてエレヂイなの？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――十一月になると未だにナタリーは私の誕生日を祝して贈物を寄せるのが、あの「宮に似た」のエレヂイを私が説明した頃から、二十年以来の習慣である。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マスネの「エレヂイ」です。",
              "citation": {
                "source": "誰でもない……自分でもない",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "が加部錬之介の存在は、この時までまつたく無視されたかたちでしたが、彼にも、この「エレヂイ」のかうして歌はれる意味がわかりました。",
              "citation": {
                "source": "誰でもない……自分でもない",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "男と女のあひだには、エレヂイなんか、ない方がいいのですもの。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
