        "examples": {
          "standard": [
            {
              "text": "この寺院の護摩堂には、閻魔天を本尊とした祭壇がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "密教の教えでは、閻魔天は南方の守護者とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "修行僧は閻魔天に向かって礼拝を続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は日本支那の美術史にも詳しく、通訳官を通じての批評、悉く肯綮に当るばかりでなく、最も侯爵を喜ばせたのは、幾百万の金銭にも換え難き名宝として珍蔵せる、藤原時代の極彩色仏画「閻魔天像」と、同時代の作、木造塗箔の阿弥陀如来坐像との前に、伯爵は最も長く立止り、垂涎おく能わざる体に見えたことである。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
