    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ、イヤラシイ、オトコハ、オマエダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウグヒスハ　ヘイノ　ウヘヤ、ツバキノ　エダニ　トマツテ、「ケキヨ、ヨ　ケキヨ、ヨ」ト　ナキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コエダケガヨナカニヒビイテ、オ母ッチャハウゴカナイ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "お父様、エダじゃないの」「そうですよ、イダだよ」「――……」　伸子は笑いくずれるように父の肩ごしに祝儀袋を見せた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　○アツラエダ股引。",
              "citation": {
                "source": "津軽地方特有の俚諺",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アツラエダは「誂へた」である。",
              "citation": {
                "source": "津軽地方特有の俚諺",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また実際この島の住民はたいていバッブラッブベエダを信仰していますよ。",
              "citation": {
                "source": "不思議な島",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　老人「バッブラッブベエダです。",
              "citation": {
                "source": "不思議な島",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お父さん、僕エダマメを喰べようかな」　しばらくすると、長男はまた云った。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし／＼、エダマメ二――それからお銚子……」　彼はやはり同じ調子で叫んだ。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お父さん、僕エダマメを喰べようかな」　しばらくすると、長男はまた云つた。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度神話、希臘神話、北欧神話の基礎本源たる、思想の原形は、殆んど同一なるも、ホメロスの詩篇に見ゆる一個の神話と、『エダ』の神歌に見ゆる一個の神話とは、何人も之れを混同すること無かる可く、又この何れをも、『ブラーマーナー』中の一個の神話と混同すること無かる可し。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六二二年、宗教的地位を得るためにマニラに渡り、二三年十一月二十六日管区長フライ・アロンゾ・メンチエダ神父によつて修道服を受け、ドン・フライ・ペトロ・デ・アルセによつて司祭に補せられた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "リグ・ベエダの時代には赤と黒は殆ど識別されておらず、サンスクリットの全時代に於て緑は完全に発見されておらぬ。",
              "citation": {
                "source": "新らしき文学",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "リグ・ベエダの時代には赤と黒は殆ど識別されてをらず、サンスクリットの全時代に於て緑は完全に発見されてをらぬ。",
              "citation": {
                "source": "新らしき文学",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "古歌では松にイロナグサ、オキナグサ、ハツヨグサ、トキワグサ、チエダグサ、チヨギ、ソチヨグサ、スズクレグサ、タムケグサ、メサマシグサ、コトヒキグサ、ユウカゲグサ、ミヤコグサ、クモリグサ、ヒキマグサ、モモクサなど沢山な名がある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえに昔はシダといえばウラジロを指したものである）の名があるので、そこで歯朶の字をこれに充てこれをヨワイノエダと訓ませ長寿を表象させている。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たかが木魚の音とコエダメの匂いじゃないか相手をゆるす気にさえなれば実になんでもないことなんだそれが、君のお父さんはこの町のお寺さんの中でも立派なお坊さんで有名な人で内の父だって俳句をこさえたりして文句のつけようの無い良い人なのにそいつが、わけもなしに憎み合う！",
              "citation": {
                "source": "詩劇　水仙と木魚",
                "author": "――一少女の歌える――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ここからエダンまで五里、エダンからサン・ポルまで六里、サン・ポルからアラスまで八里半、市長はアラスへ行くんだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその夜、エダンを通ってモントルイュ・スュール・メールへやってきた郵便馬車が、町にはいろうとする時そこの町角で、反対の方向へゆく白馬にひかれた一つの小馬車につき当たった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "エダンに着いた時はもうすっかり夜が明けきっていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "エダンを去る時に、彼はだれかが呼びかける声を聞いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はエダンでだいぶ時間を失っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "エダンからサン・ポルまで行くのに四時間近くかかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああたれかわれをして、ラウリオムやエダプテオンのギリシャ人のごとくに、ホメロスの詩を誦せしむる者があるか！",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "三枝という牛肉店が人の呼ぶままに、自らもミエダと称しているのは商売の関係上、顧客に便利でさえあればよいのであろうが、之と同じ様に地元の人までが無知な登山者の勝手な称呼に迎合するのは困ったことである。",
              "citation": {
                "source": "白馬岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹿児島県の田舎などでは、それでこの遊戯をマメエダレとも呼んでいた。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マメエダレはすなわち真前誰である。",
              "citation": {
                "source": "こども風土記",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
