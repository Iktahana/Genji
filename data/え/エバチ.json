        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だがどれよりも私を惹きつけた一つの赤絵鉢があつた。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう思ふほど私はその赤絵鉢に執心したのである。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで世に出た赤絵鉢の中で最も見事なものの一つに数へたい。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は故人とあの赤絵鉢に就いて親しく語り合ふ折を得なかつたことを、心残りに感じた。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の胸には即座に例の赤絵鉢のことが浮んだ。",
              "citation": {
                "source": "赤絵鉢",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤繪物も案外日本に遺品が多い、案外といふより所謂呉須赤繪鉢の如き、支那になくして日本にのみ存在するといつてよい。",
              "citation": {
                "source": "やきもの讀本",
                "author": "小野賢一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
