        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼から贈られたエンゲージリングは、シンプルだけど存在感がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "結婚式の準備で、まずは二人でエンゲージリングを見に行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "サプライズプロポーズで、ポケットからエンゲージリングを取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "左の手はしょっちゅう洋袴のポケットへ入れていましたが、胸のハンカチを取出すとき、案外白い大きい手の無名指にエンゲージリングの黄ろい細金がきらりと光ったのを覚えています。",
              "citation": {
                "source": "扉の彼方へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……左の薬指に華奢なダイヤ入りと、エンゲージリングを一ツずつ……。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたからいただいたエンゲージ・リングね、あれをやりましてよ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えると、これは両親のエンゲージ・リングなのである。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、あなたの薬指の方の指環はエンゲージ・リングのようだから、それだけはのこしときなさい。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりエンゲージ・リングってやつさ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、君がエンゲージ・リングを受けてくれたので、僕はやっと安心したよ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
