          "literary": [
            {
              "text": "直ぐ背なるエバルの山の山つゞきには、昔のスカル今のアスカルの三家村山に靠りて白し。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "南はゲリジム山、北はエバル山に挟まれたる谷なり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲリジムの山頂には古き建物の跡多く、エバルの山には一面に覇王樹茂れり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            }
          ]
        }
