          "literary": [
            {
              "text": "エキスペリメンタリヌイ〔劇場名〕で、トラビアタ〔歌劇「椿姫」〕をきく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十四日（日曜）　エキスペリメンタリヌイへ行って「生ける屍」の切符を買う。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもここでおち合った美術家（エキスペリメンタリヌイ劇場の）がいろいろ話しをし、オペラの新しき試み等、面白かった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
        }
