        "examples": {
          "standard": [
            {
              "text": "フナやコイのような硬骨魚は、表面が滑らかな円鱗に覆われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "円鱗は同心円状の成長輪を持ち、魚の年齢推定に利用される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "この標本の円鱗を顕微鏡で観察すると、年輪のような輪紋がはっきり見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
