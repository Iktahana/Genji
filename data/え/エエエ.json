          "literary": [
            {
              "text": "「犬は大丈夫かい」「エエエエ直っきに来ますわ」「どうしてあの崖を駈け登れるだろう」慕門次は笑っている、ひょいと見ると、鼻をフン、フン、やりながら、もういつの間にか、傍へやって来て、嬉しそうに尾を掉っている。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "大島ア………小じまアの………あいとお……るウ……ふねエエエは…江差し……がよ……いかアよオ………なつかし…イイ…や……………………「もうひとつ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレエエエ――ッ……」　質屋の娘が仰天して材木の蔭から飛出した。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "出して……くれエエエ――ッ……。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「森栖先生エ――エ――エエエ……」　部屋の中から流れ出る明るい電燈の光線で、窓の外の私の顔を発見された校長先生は、窓の枠に掴まったまま眼を真白く見開いて私をお睨みになりました。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいでは随分苦労もして来た人なんだネー」「エエエエもう、まだようやっと御十六に御なりなんでございますが、御考も御有りになり学問も身にしみてあそばして御いでですから御姉さまより御苦労が多くていらっしゃるんでございますよ。",
              "citation": {
                "source": "錦木",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おやまあ、新がおの夢八姐さん、さっきからお客様がお待ちかねでネ、エエエエ、もう、じりじりなすっていらっしゃいますよ」　こう言われて夢八のお艶、通されたのは庭の池に面した表二階の一間だった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "河村さんのうちの横に山羊がいて、それが年よりの男のような声でメエエエと鳴くが、一種妙な淋しさというか、退屈さというかがある声の響ですきでありません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今自分の胸によって居る人の命がその目の見る度に段々、短くなって行く様な気がして、ロ「イイエ何と云ったって駄目なんだから、ここに私が自分の命にかけても守って居るんだもの、どんな悪魔だって、エエエ、大丈夫だ、きっとどんなにでもして守らなくてはならない。",
              "citation": {
                "source": "無題（一）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かと思ふとまた、「猪牙でエエエエ、セッセ」などと「深川」をやる。",
              "citation": {
                "source": "乞はない乞食",
                "author": "添田唖蝉坊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエエッ」　と阿念は双に開いた足を、ジリジリと詰めて身を伸ばして来た。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前だって喉が乾いたでしょう」「エエエ、お相伴いたしますとも」　お豊は半ばやけな調子で、不二子さんの云うがままに、ドアの外の女中へ伝えた。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
