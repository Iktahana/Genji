        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――海ノ底デネ、青イ袴ハイタ女学生ガ昆布ノ森ノ中、岩ニ腰カケテ考エテイタソウデス、エエ、ホントニ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "断ッテオクガ彼ハ所謂 Hermaphrodite デハナイ、立派ニ男性ノ器具ヲ備エテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコレ以上生キナガラエテイタトコロデ格別ノコトモナイノダカラ、モシ今ノ世ニオ伝ノヨウナ女ガ現ワレタラ、ムシロソノ女ノ手ニカヽッテ殺サレタ方ガ幸福カモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "治療ヲ受ケツヽアル間、予ハ別ノコトヲ考エテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "惚レッポイコトモ惚レッポイガ飽キッポイコトモ飽キッポイノハ親譲リデ、若イ時ノ予ト同様デアルト考エテイタガ、今日デハ左様ニ簡単ニハ云エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮リニ友人ガアッタトシテ、ソノ友人ガ優秀ナ技術ヲ具エテイタトシテモ、予ガ何ノ目的デ左様ナ製作ヲ依頼スルカヲ知ッタトシタラ、果シテ快クソレニ応ジテクレルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ足ノ裏ヲ佛足石ニ彫ラセ、死後ソノ石ノ下ニ予ノ骨ヲ埋メテ、ソレヲ以テ予ト云ウ人間、卯木督助ノ墓ニ代エルト云ウ案ハ、颯子ニモ知ラセナイ方ガイヽト考エテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ秋、書斎ノスタンドヲ螢光燈ニ改メタノモ、実ハイツカハコウイウ機会ガ来ルデアロウヲ理由ニ螢光燈ニ変エタノダッタガ、―――事実読書ノタメトイウヨリモ僕ハ、イツカハ螢光燈ノ明リノ下ニ妻ノ全裸体ヲ曝シテ見タイトイウ慾望ニ燃エテイタノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハタダ手デ触ッテミテソノ形状ヲ想像シ、相当素晴ラシイ肉体ノ持主デアロウト考エテイタノデアッテ、ソレユエニコソ白光ノ下ニ曝シテ見タイトイウ念願ヲ抱イタワケデアッタガ、サテソノ結果ハ僕ノ期待ヲ裏切ラナカッタノミナラズ、ムシロハルカニソレ以上デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ向ウヲ歩イテ行ク妻ノ後姿ヲ見送リナガラ、―――分ケテモスカートノ下カラ踝ノ辺ノ歪曲美ニ見惚レナガラ、今夜ノ※ヲ考エテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
