        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "風月堂の他に、戦前の銀座でうまいケーキを求めれば、モナミ、ジャーマン・ベーカリー、コロムバン、エスキーモ――順に歩いてみよう、思い出の銀座を。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "エスキーモも、現在やっているが、戦前の感じとは、まるで違う。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦前のエスキーモの、ファンシー・アイスクリーム、シンバシ・ビューティーは正に銀座名物と言ってよかろう。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから東宝劇場の少女歌劇見物、エスキーモでカツランチを食って、帝劇のアトラクションだけ見た。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "エスキーモで、カツライスとコーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ時間たっぷりあり、全線座へ、「海の魂」といふのを見て、樋口とエスキーモで挽茶アイスクリームをのみ、金太郎で清の玩具を買って、ホテ・グリで食事し、座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時半に出て、銀座へ、エスキーモでカツ飯を食って、座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座へ出て、エスキーモで一皿食ひ、眼科へ又寄ると、座へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時に出て、京極へ寄り、十二時にエスキーモで藤山と会ふ、今日西条の詞と古賀の曲が出来て、吹込出来るつもりで、大阪にゐるのを呼び寄せたのに、間に合はずフイにさせちまったわけ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "エスキーモでアイスクリームをのみ、十一時十五分に高槻と銀座で待ち合せ、明治神宮へ向ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで又中野と一緒になり、エスキーモでライスカレー食って、橘のとこへ麻雀しに行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "エスキーモへ入り、二品ばかり食べてコーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "新橋で下りて、エスキーモで食事する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座へ廻り、エスキーモで食事し、ビュティー飲み、砧へ引っ返す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座へ出て、エスキーモで食事、マカロニとカツランチ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
