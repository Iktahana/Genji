    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ほかのねずみが何か生意気なことを言うとエヘンエヘンと言うのが癖でした。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「エヘン、エヘン。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クねずみは、「エヘン、エヘン。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　クねずみはあんまりテねずみのことばが立派で、議論がうまくできているのがしゃくにさわって、とうとうあらんかぎり、「エヘン、エヘン。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつでもエヘンエヘンと言ってばかりいたやつなんだ。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クねずみはあんまり猫の子供らの賢いのがしゃくにさわって、思わず「エヘン。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クねずみは非常にあわててばたばたして、急いで「エヘン、エヘン、エイ、エイ。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺三郎がエヘンエヘンとせきばらひをしながら幕の横から出て来て丁寧にお辞儀をしました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘンエヘンと云っているのも聞えます。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺三郎がエヘンエヘンとせきばらいをしながら幕の横から出て来て丁寧にお辞儀をしました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "半次、エヘッと意味深の笑い残して内へ入るとカメラがスーと流れて、　井戸端です。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遊ばせてくれますか、」と種田君はいつもの間延な調子で云つたあとで、「エヘツヘヘ」と可笑しくもないのに笑ふと云つた風に軽く笑つた。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、手紙よりも、木崎さん、一寸これ見て下さい」　細君が出しなにたたき割って行った買いだめの注射薬のアンプルのかけらを、坂野は見せ、土色の顔を一層土色にして、ふぬけていたが、やがてエヘッと笑うと、「印籠みたいなもンでさあ」　と、ポケットからヒロポンの箱を出して来た。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日の婚礼料理に使うにらみ鯛を焼いていた順平が振り向くと、文吉がエヘラエヘラ笑って突っ立っていた。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
