        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子どもが「えーん」と泣きながら駄々をこねている。",
              "source": "幻辞"
            },
            {
              "text": "赤ちゃんは大声で「えーん、えーん」と泣いている。",
              "source": "幻辞"
            },
            {
              "text": "小さい子が「えーん」と泣きじゃくった。",
              "source": "幻辞"
            },
            {
              "text": "悔しくて「えーん」と泣く姿は可愛らしい。",
              "source": "幻辞"
            },
            {
              "text": "子どもが転んで「えーん」と泣き始めた。",
              "source": "幻辞"
            },
            {
              "text": "悲しい映画を見て「えーん」と泣いた。",
              "source": "幻辞"
            },
            {
              "text": "子どもが母親に「えーん」と甘えている。",
              "source": "幻辞"
            },
            {
              "text": "幼い兄弟が「えーん」と泣きながら走ってきた。",
              "source": "幻辞"
            },
            {
              "text": "女の子が「えーん」という掛け声で泣く真似をした。",
              "source": "幻辞"
            },
            {
              "text": "痛いことが起きて「えーん」と声を上げた。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "つづいて加市君が、ひゅっといきをすいこんで、「ふえーん」とうまくなきだした。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　夏子は情報放送の真似をして、「――でも、少ししてまた掛けるから、京ちゃん来たら、待って貰ってくれと必死の声で、言ってたわよ」七「へえーん」　京吉は小莫迦にしたような声を出していたが、やはり、陽子何の用事だろうと、胸はさわいでいた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へえーん」「京ちゃん、どう思う。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はてね」「木崎さんの写真機が盗まれたはずですがね」「へえーん。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察へ届けないのよ」「へえーん。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "えーん　えーん　ないて。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん、漁師や米屋のほうがすき」「へえーん。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　この部落には、鍬鍛冶が住んでいるとみえて、どこかで鎚の音が、かあーん、てえーん、長閑に聞える。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、之はマーク・トゥエーンの言葉である。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーク・トゥエーンという作家は私の読んだ限りでは大した作家ではない。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はうぬぼれかも知れないが、オー・ヘンリーやカミやマーク・トゥエーンよりはましな小説が書けると思っている。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がマーク・トゥエーンに注目しているのは、だから彼の小説に関してではない。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーク・トゥエーンは一日に四十本の葉巻を吸った。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点では、マーク・トゥエーンには負けないつもりである。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、私は煙草についてマーク・トゥエーンのような名文句を書いたことはない。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うに、マーク・トゥエーンは煙草の豊富な、安く、容易に入手できる時代に生れて、そして死ぬまでその状態がかわらなかった。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、マーク・トゥエーンには名文句が出来て、私には出来なかった――という風には私は考えたくない。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから断頭吏の歌をうたって斧を磨ぐところについて一言しておくが、この趣向は全くエーンズウォースの「倫敦塔」と云う小説から来たもので、余はこれに対して些少の創意をも要求する権利はない。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "エーンズウォースには斧の刃のこぼれたのをソルスベリ伯爵夫人を斬る時の出来事のように叙してある。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでだからエーンズウォースが獄門役に歌わせた歌を紹介して置く。",
              "citation": {
                "source": "倫敦塔",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンドルが水牛の角のやうな形をし、ブレーキと荷｜掛けとチエーンのカバーがない。",
              "citation": {
                "source": "坂道",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "植民館の設立者として名高い、米国のジエーン・アダムス女史が、ある時大西洋通ひの汽船に乗つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "事物の由来が事物の実体的本質を構成すると云ふ謎を、私たちのアリストテレスは「ティ・エーン・エイナイ」と云ふ不思議な概念によつて解かうとしました。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "倫敦塔や、セント・ポールス寺院を訪うたびにエーンズウォースの小説を思い出さずにはいられなかった。",
              "citation": {
                "source": "科学的研究と探偵小説",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "……エーン、口惜しい！",
              "citation": {
                "source": "蠢く者",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "エーン、エーン……（泣く真似）男　　早くしろよ。",
              "citation": {
                "source": "富士はおまけ（ラヂオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といったマーク・トウエーンの言葉の真実性はうたがえない。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーク・トゥエーンが〈イノセンツ・アブロード〉でヨーロッパ文化の行きすぎを嘲笑すると、オスカア・ワイルドがわざわざアメリカへ講演に出かけて行ってしっぺいがえしをした。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西の作家ジエーンライブラハは小説“New Beauty”の中に解放せられたる理想的美人を描き出さんと企ててゐる。",
              "citation": {
                "source": "婦人解放の悲劇",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの「非協同」を愛蘭のシン・フエーン主義と區別する。",
              "citation": {
                "source": "劒の教義",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
