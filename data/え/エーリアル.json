          "literary": [
            {
              "text": "ここに本格的なエーリアルを立てるといいという、その場所さ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "許可をもらって僕はそこにエーリアルを立てたよ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "エーリアルだからね、専門の知識は必要ないんだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "エーリアルから引いたワイアーを受信機につないでダイアルをまわしていくと、すごいんだよ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
