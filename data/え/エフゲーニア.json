          "literary": [
            {
              "text": "一月二十八日（土曜）　エフゲーニア・ミハイロヴナの稽古、Ｙ一人。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日よりエフゲーニア・ミハイロブナ毎日稽古。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○エフゲーニア・ミハイロブナの稽古。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十四日（火曜）　エフゲーニア・ミハイロブナの稽古二月十五日（水曜）　今日から、Ｙ稽古に毎朝十一時から通うことになった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・キリロフスキー二月十六日（木曜）　エフゲーニア・ミハイロブナの稽古　Ｙ、キリロフスキーのところへ行ってから、又ミハイロブナ故、くたびれて閉口して居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十八日（土曜）　エフゲーニア・ミハイロブナの稽古二月十九日（日曜）　第一大学の日曜大学の講義をききにゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日エフゲーニア・ミハイロブナのところへゆく筈であったが、やめにして、家でけいこをして貰った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝仕事をしてから、ベゲテリアンへゆき、それからエフゲーニア・ミハイロブナのところへ出かける。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
