        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お母さんを月待（ツキマチ）と云い、娘を江奈古（エナコ）と云う。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒメの気に入ったミホトケを造った者には、美しいエナコをホービに進ぜよう」　長者が金にあかして買い入れたハタを織る美しい奴隷なのだ。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、ヒメの気に入った仏像を造った者にエナコをホービにやるという長者の言葉はオレをビックリさせた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、ヒメの気に入った仏像を造った者にエナコをホービにやるという長者の言葉はオレに大きな驚愕を与えた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでオレはエナコを見つめた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは珍しい動物だ」　オレの目はエナコの顔から放れなかったが、一心不乱ではなかった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その嘲りをエナコに向けるのは不当であると気がついていたが、オレの目をエナコに向けてそこから放すことができなければ、目に宿る嘲りもエナコの顔に向けるほかにどう仕様もない。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコはオレの視線に気がついた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "次第にエナコの顔色が変った。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレはシマッタと思ったが、エナコの目に憎しみの火がもえたつのを見て、オレもにわかに憎しみにもえた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレとエナコは全てを忘れ、ただ憎しみをこめて睨み合った。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコのきびしい目が軽くそれた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコは企みの深い笑いをうかべて云った。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠路のところ、はなはだ御苦労」　エナコの目がはじかれたように開いた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろんオレの目もエナコの顔から放れなかった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコは膳部の横を半周してオレの背後へまわった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレはふりむいてエナコを見た。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコの右手は懐剣のサヤを払って握っていたが、その手は静かに下方に垂れ、ミジンも殺意が見られなかった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコがなんとなく用ありげに、不器用に宙に浮かして垂れているのは、左手の方だ。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の一ツはあなたの斧でそぎ落して、せいぜい人の耳に似せなさい」　エナコはそぎ落したオレの片耳の上部をオレの酒杯の中へ落して立去った。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレと向い合せにエナコが控えていた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレの跫音をききつけて、エナコは首をあげた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "よってエナコを死罪に処するが、耳男が仇をうけた当人だから、耳男の斧で首を打たせる。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳男、うて」　オレはこれをきいて、エナコがオレを仇のように睨むのは道理と思った。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "斧をとってズカズカと進み、エナコの直前で一睨み、凄みをきかせて睨みつけてやった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "エナコの後へまわると、斧を当てて縄をブツブツ切った。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エナコの死に首よりも生き首がほしいか」　これをきくとオレの顔に血がのぼった。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前、エナコに耳を斬り落されても、虫ケラにかまれたようだッて？",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
