[
  {
    "uuid": "e98b318a-5aa0-57c6-a09c-2ac625e84f37",
    "entry": "海老",
    "reading": {
      "primary": "えび",
      "alternatives": [
        "エビ"
      ],
      "is_heteronym": false
    },
    "grammar": {
