          "literary": [
            {
              "text": "姫は早や天に許嫁し給ひて、御名さへエリザベツタと改まりぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エリザベツタの天に許嫁せしを賀するなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　エリザベツ　マリアはエリザベツの友だちだつた。",
              "citation": {
                "source": "西方の人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "バプテズマのヨハネを生んだものはこのザカリアベの妻、エリザベツである。",
              "citation": {
                "source": "西方の人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリア、カエサル【マリア】聖母マリアがその親戚エリザベツを訪はんとて山地なるユダの邑にいそぎてゆけることルカ傳（一・三九）にいづ【チェーザレ】ユーリウス・カエサル。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
