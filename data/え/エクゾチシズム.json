        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "メリメの面白さは、その手法とともにソヴェト作家に与えるもののあることが理解されたが、マルセル・プルーストは、単なるエクゾチシズムでよまれるのだろうか。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ以上のロマンティシズムはあり得なかったのです、エクゾチシズム以上のロマンスは。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "エクゾチシズムが濃い。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第二巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ヵ年計画とともにプロレタリア芸術が獲得しつつある唯物弁証法的な、リアリズムとメイエルホリドのややこけおどしの気味がなくもない様式化、そこにあるエクゾチシズムや誇張性とはどういう関係で発展するものだろうか。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
