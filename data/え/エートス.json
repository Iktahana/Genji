        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その会社は、顧客第一主義という強いエートスを持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は武士のエートスを重んじ、常に公正であろうと努めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "研究室の自由なエートスが、多くの革新的な発見を生み出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "スポーツマンシップというエートスは、勝敗以上に重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "一、話し手のエートス（性格）による証明。",
              "citation": {
                "source": "解釈学と修辞学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで話し手は言葉の技術によって自己のエートスに対する相手の信を作り出すように努める。",
              "citation": {
                "source": "解釈学と修辞学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは各人のパトス、またエートスによって規定され、性格的なものである。",
              "citation": {
                "source": "解釈学と修辞学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "かようにパトスないしエートスに基づくものとして修辞学は表現的である。",
              "citation": {
                "source": "解釈学と修辞学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "医学のエートス（精神）であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり之はフューシス（物理・自然）に対立する処のエトス（倫理）であり人事であり精神なのである。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "希臘の哲学者が、「人はエトスの乳を飲んで育つものだ」とか、「エトスは人間にとつての運命である」とか云つたのは、さういふ意味だと思ふ。",
              "citation": {
                "source": "風俗の非道徳性",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、「倫理的のものはすべてエトスより出て来る」とも云はれてゐるのは味ふべきことで、若し風俗が道徳と関係があるとすれば、風俗こそ、道徳の根柢なのであつて、徒らに風俗の改良を道徳の力にのみ委ねようとするのは、本末顛倒も甚だしいと云はねばならぬ。",
              "citation": {
                "source": "風俗の非道徳性",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに機械のパトスが、機械のエトスが、機械のプラクセイズがある。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
