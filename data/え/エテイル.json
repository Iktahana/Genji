        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノホカニモ水死人、サマザマノスガタデ考エテイルソウデス、白イ浴衣着タ叔父サンガ、フトコロニ石ヲ一杯イレテ、ヤハリ海ノ底、砂地ヘドッカトアグラカイテ威張ッテイタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ忘レッポイト云ッテモ、コノコトハヨク覚エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ心中ハ、タマニハ寝室モ彼女ガ勤メテクレルコトヲ望ンデ已マナイノデアルガ、婆サンガ待チ構エテイルセイカ、颯子ハ殊更ソッケナクスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーノ音ガ聞エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞄カラ鍼ノ匣ヲ取リ出シタリ、アルコールデ消毒シタリスル細カイ作業ハ鈴木氏自身デスルケレドモ、常ニ弟子ノ一人ガ附キ添ッテウシロニ控エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盆ヲ支エテイル手ガ震エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "服ガ籠ニ捨テヽアル以上、彼ハシャワーヲ浴ビテカラ浴衣ニ着カエテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ忰ハ寧ロ彼女ノ経理ノ才ヲ徳トシテ、彼女ヲ失ッテハ不便デアルト考エテイルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫ヲカブッテイル時ノ彼女ハ、何処カラ見テモ立派ナ奥様ノ貫禄ヲ備エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、今朝ハ、ダン／＼意識ガハッキリシテ来ルニ従イ、ソノピイピイト云ウ声ガ、現ニ佐々木看護婦トベッドヲ並ベテイルコノ部屋ノ中デ聞エテイルノニ違イナイコトニ心ヅク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯ヲ染メル時ハ特有ナ鉄漿ノ臭イガシタコトヲ予ハ今デモ覚エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ノ結婚ノ時父ノ代理ダト云ッテ御夫婦デ出席シテ下スッタ―――」「ソンナコト覚エテイルモンカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白ノビーズノハンドバッグノ小サイノヲ左手ニ抱エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドルシンハ汗ガ出テイヤダッテ仰ッシャルンデス」佐々木ガ杉田氏ニ訴エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子、菊太郎、京二郎、ホームニ出迎エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様ニ颯子モ、地下デ喜ンデ重ミニ堪エテイル予ノ魂ノ存在ヲ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、日記帳ヲ入レテアル抽出ノ鍵ハイツモ某所ニ隠シテアルノダガ、ソシテ時々ソノ隠シ場所ヲ変エテイルノダガ、詮索好キノ彼女ハ事ニヨルト過去ノアラユル隠シ場所ヲ知ッテシマッテイルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初ハ木村ガ裸体ノママデ立ッテイルヨウニ思エタガ、胴カラ生エテイル首ガ、木村ニナッタリ僕ニナッタリ、木村ノ首ト僕ノ首トガ一ツ胴カラ生エタリシテ、ソノ全体ガマタ二重ニ見エタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キミ、フルエテイルネ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
