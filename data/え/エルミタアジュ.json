          "literary": [
            {
              "text": "三六号はオテル・エルミタアジュのあたしの部屋の番号よ。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "『僕はオテル・エルミタアジュのあなたの部屋の番号を知っています。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は結婚するほど旧式でもないし、オテル・エルミタアジュはちょっと外部から見たことがあるだけです。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はオテル・エルミタアジュの三六号室に同棲していて、今でもときどきこの手を用いています。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            }
          ]
        }
