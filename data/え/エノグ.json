[
  {
    "uuid": "2def8a70-913d-5244-8411-fd084d8fb5ab",
    "entry": "絵の具",
    "reading": {
      "primary": "えのぐ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現",
