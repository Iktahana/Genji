          "literary": [
            {
              "text": "たしかあれはエコーラリイ（反射症状）だと看護婦が教えて呉れた。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は今一番興味をもって思い出せるのは、診察室や廊下で顔を合わせるエコーラリイの患者である。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "エコーラリイというのは、病気の本体ではない。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
