        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "見知らぬ異国の駅に降り立った瞬間、自分が一人のエトランゼであることを強く実感した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "港町には船を降りたばかりのエトランゼたちが、珍しそうに坂道の多い街並みを眺めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "都会の喧騒の中で、彼はどこかエトランゼのような、寄る辺ない雰囲気を纏って立っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして實際にもその通り、日本で詩人と呼ばれる連中は、過去に於ても現在に於ても、どこか他の一般文學者とちがつたところがあり、何かしら日本の風土習俗に馴染まないところの、妙に周圍と調和しないエトランゼのやうな風貌がある。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カフエー・エトランゼの黒い卓子の上に、私はこんな詩を書いてみた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　エトランゼの裏口から、一ツずつ大きい荷物を持った私たち二人の女を、マダム・ロアは気の毒そうにみて、一週間あまりしかいない私達へ給料を十円ずつ封筒へ入れてくれた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田｜絃二郎なんて、菜っぱと小鳥みたいなエトランゼ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトランゼも居るにはゐましたが、ごく少数で、ドイツの機械商人と、アメリカの記者二三人と、まあ、その位のもので、あとは中国の人ばかりです。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕や毛布を借りるのはエトランゼだけで、私の隣人達は、枕から毛布、ヤカンまで持つて乗り込んで来ます。",
              "citation": {
                "source": "シベリヤの三等列車",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がエトランゼエなら、天王寺から、天満天神、大阪城、文楽座――と、歩くであろうが、私は、もう少し、特異な大阪を――大阪の玄人としての、大阪を知っている。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、おおよそエトランゼたるものは――平ったく云えばおノボリさんたる者は、大概一度は見て置かなければならないところらしい。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕には到底エトランゼエだ」「ダンスなんて一種のぐわんみたいなもんぢやないですか。",
              "citation": {
                "source": "私の社交ダンス",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本へ来てお客、パリでお客、どちらでもエトランゼ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな女にエトランジェのあんたが引かかっちゃいけ無い。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二円にしてはやすすぎると思って、買おうとしたら、一個百二十円だときかされて、胆をつぶしたという人がいるが、それくらいのことに驚いて胆をつぶすような神経では、大阪の闇市場に一歩はいればエトランジェである。",
              "citation": {
                "source": "大阪の憂鬱",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "君のようなエトランジェ（異境人）には言えない」　博士は、そのことばが終るとともに立上って、両の肩をぶるぶるとふるわせた。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうなると此處ではどつちがエトランジェなのだか解らない。",
              "citation": {
                "source": "エトランジェ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトランジェの氣輕さよ！",
              "citation": {
                "source": "エトランジェ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便局の角のところにさつきから二人のエトランジェが立つてゐる。",
              "citation": {
                "source": "エトランジェ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はすでに、エトランジェであった。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "夢の総量は空気であった",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
