        "examples": {
          "standard": [
            {
              "text": "彼女はえちえちなドレスを着て、パーティーに現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "そのアイドルはえちえちなダンスで話題を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "えちえちなキャラクターが登場するゲームが大人気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その祠は山の頂上に近い杉の森の中にある、彼は不自由な躯でえちえちとたどり着き、七歳の知恵と七歳の舌と音声とで御神躰に抗議を呈し、その五躰の修正を頼んだ。",
              "citation": {
                "source": "艶妖記",
                "author": "忍術千一夜　第一話",
                "note": "青空文庫"
              }
            }
          ]
        }
