        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "巻煙草はなぜかエエア・シツプだつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエア・シツプならばございますが、……」　僕は頭を振つたまま、広いロツビイを眺めまはした。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ又あのホテルは巻煙草のエエア・シツプばかり売つてゐたのであらう？",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "巻煙草はなぜかエエア・シップだった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエア・シップならばございますが、……」　僕は頭を振ったまま、広いロッビイを眺めまわした。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ又あのホテルは巻煙草のエエア・シップばかり売っていたのであろう？",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の平田先生の翻訳を読んだのは「ヴアニテイ・フエエア」（虚栄の市）と「エゴイスト」（我意の人）とだけである。",
              "citation": {
                "source": "平田先生の翻訳",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
