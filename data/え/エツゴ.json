          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "粤語は広東地方で話される言葉で、中国の他の方言とは大きく異なる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "香港では粤語が公用語として使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "粤語の映画やドラマは中華圏で人気が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
