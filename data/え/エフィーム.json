        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "床には、死んだ父親のエフィーム・ステパーノフが、ごろごろしている。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親のペラゲーヤは、地主の旦那のお屋敷へ、エフィームが危篤だと、注進に駈けて行った。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "エフィームの頬は桃いろに赤らみ、眼はぎらぎらして、そのまなざしは妙にするどく、さながらエフィームが、小屋のなかも医者の肚も、見とおしているようだ。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　医者は、ものの十五分ほど、エフィームに精だしていたが、やがて立ちあがって、こう言う。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "エフィームは身支度をして、出かけてゆく。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "病院へ、エフィームの容態をききに行ったのである。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリカにはまたもや、ぬかるみの街道や、背負い袋をしょった人たちや、ペラゲーヤや、父親のエフィームが見える。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（窓をのぞいて）カチカチ言わせているのは、お前かい、エフィーム。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
