        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アメリカにジオウジ・エエドといふ文士がゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのエエド氏がある時知り合ひの結婚式に饗ばれて列席した事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "側にゐた近眼の某夫人は、エエド氏の顔を眼鏡越しにじろりと見ながら言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエドさん、貴方は今だにお独りでゐらつしやいますが、御結婚なさるよりもその方が道徳的だと思つてらつしやるんですか。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」エエド氏は洋盃の飲みものに一寸唇をあてながら言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が近江さんに伴はれて階上の室へ行つた晩は四五人の日本学生の人人の外に、日本学生の語学教師であるエエドル嬢も一緒であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年西洋に在りし為、三味線や御神燈を見ても遊蕩を想はず、その代りに艶きたるランプ・シエエドなどを見れば、忽ち遊蕩を想ふよし。",
              "citation": {
                "source": "田端人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりランプ・シエエドなどに感心して来てはいけません。",
              "citation": {
                "source": "田端人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "路易はオレンヂエエドを飮みながら、そして煙草のけむりがしみでもするやうに半分目をつぶりながら、それらの娘の中から、まるで花の莖のやうに細い頸を少しかしげるやうにして立つてゐる一人の娘を選び出して、そればかり見つめてゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてみんなに酒を奢つては自分はオレンヂエエドばかり飮んでゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてオレンヂエエド！",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵬が炭酸水で割つたウイスキイを飮むのを見ながら、路易は昔のやうにほてつた頬をしながらオレンヂエエドを飮んでゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はすつかりオレンヂエエドと頬のほてりを忘れてしまつてゐた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「聖なる煙」：整理者〕と呼ばれた（プトレマイオス王朝の時代になっても同じ処方がエエドフ神殿の壁に刻み込まれている）。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
