        "examples": {
          "standard": [
            {
              "text": "この器は、独特の色合いが鉛釉によるものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "工房では、伝統的な技法で鉛釉を施した陶器が作られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "表面に施された鉛釉が、光を反射して美しく輝く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "中で焼物は伊賀野附近で焼かれ、主に黄色い鉛釉を用います。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他肥前の窯場として、注意すべきは白石の鉛釉の陶器や、黒牟田の品であります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
