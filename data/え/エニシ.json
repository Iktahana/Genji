        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "荒蕪地の方は、ハリエニシダの花が満開中で、四月の太陽を受けて、黄金色に燦爛としていた。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒野に蔽われた田園は、今ちょうど満開のハリエニシダの花が、方々に叢り咲いていて、ロンドンの暗褐色黄褐色、――石板灰色に、あきあきしている目には、とても素晴らしいものに見えた。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒れ地ではハリエニシダが一面花盛りで、春の明るい日差しを浴びて燦爛と輝いている。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜通しの雨のあとの輝かしい朝、荒野の広がる田舎では、鮮やかなハリエニシダの咲く茂みがあり、ロンドンのくすんだ黄や茶や灰といった色にうんざりした目には、いっそう美しく見えた。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて厩舎から四分の一マイルほどばかり、ハリエニシダのやぶにストレーカの合羽が引っかかっていた。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "へこみの縁にはハリエニシダのやぶがあり、そこへストレーカの合羽がかかっていたらしい。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "転づるは French か、角ぐみそめし桜の二列の並木の間の人道を、枯草の辺りを青くして低きかなめ垣の長き径に添ひて、ハリエニシダの花黄なる彼方へとぞゆく。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "転づるは French か、角ぐみそめし桜の二列の並木の間の人道を、枯草の辺りを、青くして低きかなめ垣の長き径に添ひて、ハリエニシダの花黄なる彼方へとぞゆく。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今しがた私の右脚が出て行った廊下の、モウ一つ向うの窓の外には、和ごやかな太陽の光りが満ち満ちて、エニシダの黄色い花と、深緑の糸の乱れが、窓｜硝子一パイになって透きとおっている。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちの窓一パイに乱れかかっているエニシダの枝｜越に、白いドローンウォークの花模様が、青紫色の光明を反射さしているのがトテモ眩しくて美しかった。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "グランパが桜の花を書き、エニシアルを研究し、十二時過に、グリルでランチをとる。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エニシダが、かの北国に美しく咲き匂うのは。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "着いたトタンにいきなり新聞記者が訪ねて来たことも、そしていきなりあの人の名をきいてしまったことも、私とこの土地に吹く風だけが知り合っている秘密のエニシであるということをひそかに考えてみることなどを愉しんだのである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下沈んだり隠れたりしている彼の長所をかきたて、彼のより良くより強い信念とか、逞しい意志などをひきだすエニシとなり、彼のより良い人生のために職業上の技術と善意とを役立ててやることではないでしょうか。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その八　安吾愛妻物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "スティームド・ライスを添えてください」「エニシング・エルス？",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "注文を告げると、「エニシング・エルス？",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリエニシダが積んであった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "森｜外れの斜面にある小さな小屋が東屋、ハリエニシダの黄色い花に囲まれ、はるか先に海峡が霞んでいた。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "運命の電報は新芽のハリエニシダに落ちて、風にひらひら揺れている。",
              "citation": {
                "source": "鉄面皮",
                "author": "A Front of Brass",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリエニシダの両壁に挟まれて、芝生の馬場が延び、この平坦な道に沿って、両馬が動き始めた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィールデンがハリエニシダの陰に潜り込んだのは風を避けるため、煙草に火をつけようとして既にマッチを二本使った。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリエニシダの塊を飛び越えると、左足が何か柔らかい包みのようなものに乗り上げて、がくんとつんのめった。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっと振り返ってみれば、つまずいたのは男、ハリエニシダ藪の根元に寝っ転がり、膝掛けにひっそりくるまっている。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケットにカギは持っているし、明かりはどこかで調達する」　フィリップスがハリエニシダの高垣に消えた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリエニシダの中に誰かいたでしょう？",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間はたっぷりあるから」　メイが賛成すると、まもなく二人は囲いを越え、決勝点や柵を過ぎ、ハリエニシダ群へ向かうと、そこはダウンズ地区との境で、発馬係がコブ馬の上でいらいらしていた。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリエニシダの小山に身を隠し、じっと辛抱して、併せ馬を待った。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブレナム号は軽く流して先頭を走っていたが突然、ハリエニシダ藪から百メートルばかりのところで、もう一頭に先を越され、数馬身差で負けてしまった。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "おわかりでしょうが……」　ラッフル爺さんが話しながら向きを変え、フィールデンも後について行ったので、ハリエニシダの藪陰で熱心に聞いていたチャフィはそれ以上聞けなかった。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "地面にはサクラソウやハリエニシダ、ギョリュウモドキがあるが、花輪を作ろうとか、芝生を刈ろうとした形跡はない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
