        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "加之英露の協約は殆ど世界の平和を保障せり。",
              "citation": {
                "source": "雲間寸觀",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二葉亭は『倫敦タイムス』『ノーウ・オウレーミヤ』『モスコー・ウェドモスチ』等の英露及び支那日本の外字新聞数十種に常に眼を晒らしていた。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八五三年に英露のトルコ分割を目的とするクリミヤ戦争が起った。",
              "citation": {
                "source": "フロレンス・ナイチンゲールの生涯",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちにわるい英露があります、お送りしましょうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十年ばかり前、ナウカであちらのから翻刻した英露があって、それはよかったのですが、買いそこねました、残念ですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの顔触を見て、戦時の英露二国に、ロイド・ジョオジとケレンスキイとが出現した当時の百分の一の緊張をも感じることが出来ませんでした。",
              "citation": {
                "source": "三面一体の生活へ",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "東亞問題に就いても、日本や支那は、殆ど何等の發言權を有することも出來ず、すべて英露諸國の意志の儘に決定されたのである。",
              "citation": {
                "source": "東洋史上より觀たる明治時代の發展",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞面目な儒者、忠實な憂國者として知られた、當時の兩江總督の張之洞すら、日本に割讓すべき臺灣を英露諸國に與へ、其援兵によつて日本を抑へる――速向英、俄（露國）、徳（ドイツ）諸國。",
              "citation": {
                "source": "支那猥談",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだしアフガニスタンは英露の争地なり。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "これアフガン争論のつねに英露の間に絶えざるゆえんなり。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
