              }
            },
            {
              "text": "たちまち　エプロンドレスを　ふんづけて、　はなから　じめんに　つっこんで。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "エプロンドレスを　うしろまえにして　ぴょんぴょん　スキップしながら　いきました。",
              "citation": {
                "source": "ねこぬこタムのはなし",
                "author": "THE TALE OF TOM KITTEN",
                "note": "青空文庫"
              }
            },
            {
