  {
    "uuid": "ea39c1f8-e6ac-5920-b31e-54e3edef71aa",
    "entry": "献杯",
    "reading": {
      "primary": "けんぱい",
      "alternatives": [
        "こんぱい"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞",
        "感動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "toast (to someone; esp. the deceased at a post-ceremony meal)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "故人を偲び、参列者一同は静かに献杯を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「故人のご冥福を祈り、献杯！」部長の低い声が会場に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私たちは彼の偉業を称え、静かにグラスを掲げて献杯した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "署長さん、いや献杯、つゝしんで献杯｜仕ります。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "献杯、いや献杯、」「もう沢山、」「遁げるのか、遁げる気か。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "献杯、さあ献杯だ、おゝい貴様ぁ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "失礼ながら献盃致しまする。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒は甘露、昨日の酒、今日の酒は甘露の甘露だつた、合掌献盃。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "献盃でもするみたいに、盃を遠くに離して、右手で酒をつぐと、ゆっくり銚子をおき、盃を口と両方から接近させる形で、ちゅうと飲む。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
