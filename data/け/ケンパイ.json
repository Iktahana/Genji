        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "連日の激務が続き、彼は全身に倦憊感を覚えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長時間の肉体労働の後、倦憊のあまりその場に座り込んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その兵士は、戦争の過酷さからくる深い倦憊に苦しんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
