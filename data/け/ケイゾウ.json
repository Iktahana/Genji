[
  {
    "uuid": "c76f662f-5856-515f-befe-830e581ddda6",
    "entry": "恵贈",
    "reading": {
      "primary": "けいぞう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "presenting (a gift, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年の功績を称え、記念品が恵贈された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の個展に、多くの美術愛好家から花が恵贈された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "図書館には、作家本人から恵贈された貴重な資料が多数ある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "吉岡は、将来万一起るかも知れない不和の場合を恐れて、友人間の金の恵贈を、避けたらいゝと云うのだ。",
              "citation": {
                "source": "神の如く弱し",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "将来の万一の不和を怖れて、金の恵贈を避けると云うのなら、その何百倍何千倍の強さを以て現在の不和のために、金の恵贈を避けるべき筈ではないかと思った。",
              "citation": {
                "source": "神の如く弱し",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "今村鞆君｜元山府尹たり、近く『増補朝鮮風俗集』を恵贈さる。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨当春阿部正貫出京之節は、御懇切御文通被下、殊に無存掛御肴料二｜方金御恵贈｜被遣、辱拝受、乍去御過厚之事奉恐入候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯川の入獄に対して、匿名で金品を恵贈せられた諸君が多い、我等は深く其高情を感謝すると同時に、姓名を知ることを得ぬのは遺憾に堪へぬ、枯川の一家平民社同人に代りて茲で御礼を申上げる。",
              "citation": {
                "source": "筆のしづく",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ、畏友山本有三氏から近著戯曲集『同志の人々』の恵贈に預つた。",
              "citation": {
                "source": "『同志の人々』",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "又々牛の舌御恵贈の由、不堪感謝候。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其節御恵贈の朝鮮産西洋種｜梨子、誠にやすらかにして美味、有難存候。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴の屋翁画詠、柿本大人像、師岡正胤主恵贈としたものがそこにあった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十四年｜乙丑ノ歳晩予｜偶『有隣舎ト其学徒』ト題シタル新刊ノ書ヲソノ著者ヨリ恵贈セラレタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "御恵贈の『新俳句』一巻今日学校にて落手、御厚意の段難有奉拝謝候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兼子氏の「道友」は更に今度は日本語で書かれた氏の『哲学概論』めいた本を恵贈して呉れたが、それを見ると、前のドイツ語の方の本に対する「独仏」における大家（？",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
