        "examples": {
          "standard": [
            {
              "text": "企業の投資判断には、国内外の経済環境が大きく影響する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "持続可能な成長のためには、変化する経済環境への適応が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "政府は、安定した経済環境の維持に全力を尽くしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それは唯物史観などでいうように、外部の経済環境と歴史の必然で宿命的に決定されているというようなものではない。",
              "citation": {
                "source": "政治学入門",
                "author": "矢部貞治",
                "note": "青空文庫"
              }
            }
          ]
        }
