        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もくしょうは冬期によく捕れる蟹で、握りめしのようなむっくりした形をしてい、茶色で、全体が毛だらけであり、毛蟹とも呼ばれていたが、それは殆んど冒涜的にまで元井エンジに似ていた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "川津は税務事務所に勤めていて、毛蟹のように毛深かった。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
