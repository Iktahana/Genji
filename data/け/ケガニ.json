      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hair crab (Erimacrus isenbeckii)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毛ガニの殻は毛で覆われているのが特徴だ",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "北海道から取り寄せた毛ガニを食べる",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "毛ガニの味噌は濃厚で食べ応えがある",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "おばけガニ　小林少年と井上君は、それを見て、ゾーッと、全身のうぶ毛がさかだつような気がしました。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニは、窓から、はいろうとしましたが、からだが大きいので、はいれません。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふりかえると、おばけガニは、廊下いっぱいになって、おそろしい八本の足で、バリバリ音をたてて、フットボールのたまのような目を、クルクルさせながら、おっかけてくるのです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニは、すぐうしろから、せまってきます。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林君は、それよりも、おばけガニのことが気になるので、うしろをふりかえってみました。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "たちまち、四メートル、五メートル……七メートル、八メートル、おそろしくでっかい、おばけガニです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらのおばけガニが大きなはさみを、おったて、八本の足をモガモガと動かしているありさまは、じつに、なんともいえないおそろしさです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十面相の魔法の力で、あのでっかいおばけガニが、もうろうと、姿をあらわしてきたのです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　メフィストの二十面相が、おばけガニのうしろから、ぶきみな声で、あざわらいました。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニ　深い水の中ですから、パッと、とびつくことはできません。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニは、逃げる潜水夫たちを、五―六メートル追っかけましたが、なにをおもったのか、そのまま向きをかえて、むこうの方へ、とおざかっていきます。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の二倍もある、あのおばけガニです。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニはロープからはなれて、スーッと、むこうへ消えていきました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニのさいご　明智は、懐中電灯をふりてらして、そのあとをおいました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智は、じぶんの目では見ていないのですが、いつか、ハヤブサ丸の金塊ひきあげのロープを切ってしまった、あのおばけガニです。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智が、その方へ近づくと、おばけガニは、サッとにげ出し、こちらが立ちどまると、カニも、とまって、とび出した目玉を、クルクルまわし、巨大なハサミをふりたてて、「ここまでおいて。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニは、八本の足で、よこばいをするのですから、とても、にげあしがはやくて、さすがの明智にも、なかなかつかまりません。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニは、おそろしい、はやさで、その出口にむかって、つきすすんでいきました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっと、首を出して見ますと、おばけガニは、そのまっすぐの岩はだに、八本の足でつかまって、下へ下へと、おりていきます。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばけガニが、ズルズルと、すべったのです。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "見おぼえのある、おばけガニです。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三人の勇士は、それを見ると八方から泳ぎよって、おばけガニに、くみついていきました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "大ガニは巨大なハサミをふりたて、八本の足を、めちゃくちゃに動かして勇士たちをふりほどこうとしましたが、一ぴきと十三人では、いくらおばけガニでも、かなうはずがありません。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い時間の、おそろしいたたかいののち、おばけガニは、とうとうグッタリとなってしまいました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三びきのアリがコオロギの死がいを、はこぶようなぐあいに、勇士たちはてんでに、おばけガニの足を、ひっぱって、海面に浮きあがってきました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三人の勇士は、潜航艇にのぼりつき、おばけガニをかついで、ハッチの中へ落としこみました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、甲板の床には、おばけガニのからが、なげだされ、そのそばに、怪人二十面相が、息もたえだえに、よこたわっていました。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
