[
  {
    "uuid": "721167e4-5ef6-5c39-912d-212e643e60f3",
    "entry": "毛ガニ",
    "reading": {
      "primary": "けガニ",
      "alternatives": [
        "けがに"
      ],
      "is_heteronym": true
    },
    "grammar": {
