          "literary": [
            {
              "text": "いや、適当な手段が見つかったとしても、巨額の対抗兵器と危険多き多数の兵員を要することだろう。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意味においてこの書は、その青春の危険多き航路を終わりたる水夫が、後れて来たる友船へ示す合図である。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "風格におさまる危険多い人。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに大師時代の入唐は非常に危險多く、今日の歐米留學などと同一視すべきものでない。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
