          "literary": [
            {
              "text": "その時分の僕の心持からいふと、ミケエロ・アンヂエロ風な力を持つてゐない芸術はすべて瓦礫のやうに感じられた。",
              "citation": {
                "source": "愛読書の印象",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「豚だろうと、ケエロだろうと、いいさ。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケエロたあ、なんだ」「ケエロさあ」「蛙か。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうだなあ、こうやつて、土ん中の穴あ掘つて、そん中に又こうして棚をこさえてガッカリして寢ているところは、ケエロだな。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
