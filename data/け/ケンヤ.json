        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こんな煤けたレモンの山裾に、数万円の財産をお守りして、その日その日の食うものもケンヤクしている百姓生活。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は一度かけるのに百フラン、一寸二十円程かかるので、あまり沢山うたずに、ケンヤクして、三休橋宛に一つだけ打った。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同じのに「ケンヤ山を仰ぎつつ」というのもある。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、ケンヤクして旅行して居たのに留守を目がけてそんなことしないでよいと。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犬ハヨク夜ヲ守ル、人ニシテ犬ニ如カザルベケンヤ」　背の高いのが、大きな声で叫び出す。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、我諸州ニ内乱ヲ起サシメテ、我州内ノ人民ヲ印度ノ野人ト同様ニ御セント欲スレドモ、印度人殺伐不仁ノ戦ト之ヲ同日ニ論ズ可ケンヤ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "八日帰りがなんとか言つたが、金がなくなつてしまつたので、女が大いにケンヤクを主張して安温泉を廻つて歩き、ヒルメシはカツドンばかり食はされた。",
              "citation": {
                "source": "二十七歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はお前の留守中には三度三度の御飯も一膳ずつケンヤクしているぐらいお前さんに惚れてるんだよ。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "お経をケンヤクしやがるから、こんなことにならアね。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワシはお経をケンヤクするから、奴め、なかなか浮かばれないな」　ソノ子は歯をとりあげて、見ていたが、怖れる様子は一向になかった。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "番頭さんにチョウチンはときかれて、市川までは遠いから、できるだけローソクをケンヤクしなくッちゃアと、言い訳をのべていました。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "一等賞の大名犬も、二等賞の中名犬も、みんなが言い合せて諸事ケンヤクを専一にこれつとめているように、実に貧弱で安ッポイ駄犬用のようなクビワをかけているだけだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "八日帰りがなんとか言ったが、金がなくなってしまったので、女が大いにケンヤクを主張して安温泉を廻って歩き、ヒルメシはカツドンばかり食わされた。",
              "citation": {
                "source": "二十七歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔松本佐藤ノ二子鷲津知事ニ従ヒテ登米県ニ之クヲ送ル　馬前落葉離愁乱レ／朝雨江頭猶未ダ収マラズ／部伍令明ラカニシテ尤モ整粛／使君政簡ニシテ太ダ風流／過ギル時ハ感ズルヲ休メヨ白河ノ暮／到ル日ハ須ク観ルベシ松島ノ秋／語ヲ寄セヨ厳冬大雪多カラン／一領ノ白狐ノ裘無カル可ケンヤ〕となすものを見た。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔五十｜纔カニ過ギテ鬢已ニ華／悠悠心迹残涯ヲ送ル／詩夢ノ春草ヲ尋フコト無カル可ケンヤ／未ダ朝衫ヲシテ酒家ニ付セ使メズ／老後功名古暦ノ如シ／酔来顔色唐花ノ似シ／東風料峭トシテ天街遠ク／疾ヲ力シテ還タ下沢車ニ登ル〕」云々としてある。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "天冥、豈コノ不義ヲ許スベケンヤ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "主ニ反イテ盗ミヲナス安ンゾ期スベケンヤ――と。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイレのことを、「スケンヤ」「ニノジ」「サンサン」。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
