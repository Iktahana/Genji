          "literary": [
            {
              "text": "譬えば微かな風が径尺の水盤の上を渡るように、この愛くるしい顔には、絶間なく小さい表情の波が立っている。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "直径尺五寸もある太い丸太の、頭を円くして二本植ゑた、それが校門で、右と左、手頃の棒の先を尖らして、無造作に鋼線で繋いだ木柵は、疎らで、不規則で、歪んで、破れた鎧の袖を展べた様である。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "直徑尺五寸もある太い丸太の、頭を圓くして二本植ゑた、それが校門で、右と左、手頃の棒の先を尖らして、無造作に鋼線で繋いだ木柵は、疎らで、不規則で、歪んで、破れた鎧の袖を展べた樣である。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども其喉下に（一一三）逆鱗の（一一四）徑尺なるあり。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "老莊申韓列傳第三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
