          "literary": [
            {
              "text": "と幽かにお笑ひになつておつしやつて居られた事もございますし、また、政所、侍所ナドト等シク、都所トイフモノヲ設ケタラドウカ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "沈没シタ汽船ノ客室ノ、扉ヲアケタラ、五人ノ死人ガ、スット奥カラ出テ来タソウデス。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ浴槽デ足ヲ伸バシテイテ、急ニ起キ上ロウトシテ浴室ノ縁ニ手ヲカケタラ、手ガ滑ッテ起キラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ツニハ、ソレヲ打チ明ケタラ彼女ガドンナ顔付ヲシ、ドンナ心理状態ニ陥ルカ、ソノ反応ヲ見タイト思ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
