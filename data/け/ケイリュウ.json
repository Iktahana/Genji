    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同月十五日、長谷川より書類稽留。",
              "citation": {
                "source": "自由の使徒・島田三郎",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "同日太田より書類稽留。",
              "citation": {
                "source": "自由の使徒・島田三郎",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "書類稽留は決して澹泊無味のものに非ず。",
              "citation": {
                "source": "自由の使徒・島田三郎",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇なる哉、安価の見積書は六月十九日に提出せられ太田に稽留せられて三十日に至りしに、値上げの案は、七月二日に提出せられて翌三日に可決せられたり。",
              "citation": {
                "source": "自由の使徒・島田三郎",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "少なくとも稽留熱（continued fever）の１つである小腸に潰瘍のある腸チフス（typhoid fever）もまたコレラと同じように蔓延する多くの事実がある。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "其王與清〔相見、大悦曰、我聞、海西有大隋禮義之國、故遣朝貢、我夷人僻在海隅、不聞禮義、是以稽留境内、不即相見、今故清道飾館、以待大使、冀聞大國惟新之化。",
              "citation": {
                "source": "隋書倭國傳",
                "author": "魏徴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
