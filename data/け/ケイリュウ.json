    },
    "definitions": [
      {
        "index": 1,
        "gloss": "mooring",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "港には、多くの漁船が係留されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "強風のため、すべての船舶は安全な場所に係留された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "飛行船を係留する場所を探すのに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "庭の端っこにある屋根付き船着き場に、整備され、係留してある。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "係留してあるカーセジーニアン二世号が、ふと、ほんの一瞬、その透明にきらめく陽ざしのなかに溶解してしまいそうだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "無数のロープのようであり、単独では弱いものの、からまって島を同じ位置に係留した。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨットは天然の小さな入り江に係留した。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、探検者達は無事に海底に着き、装備を取り出し、その中に配線と電池があり、爆破の為に持参したものであり、配線を持って砂地を横切り、行先は沈島の係留箇所、船長の言葉を借りれば、巨大な中空｜歯根を健康な歯肉に差したような場所だ。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "有り難い、もう危険はない」　快速船が港に係留されていた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰か空ボートに一人乗り込んで、どこか近くに係留しろ」　と警察艇の指揮官が命令。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　戰場での幻想　機關銃よりも悲しげに、繋留氣球よりも憂鬱に、炸裂彈よりも殘忍に、毒瓦斯よりも沈痛に、曳火彈よりも蒼白く、大砲よりもロマンチツクに、煙幕よりも寂しげに、銃火の白く閃めくやうな詩が書きたい！",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」戰場での幻想　機關銃よりも悲しげに、繋留氣球よりも憂鬱に、炸裂彈よりも殘忍に、毒瓦斯よりも沈痛に、曳火彈よりも蒼白く、大砲よりもロマンチツクに、煙幕よりも寂しげに、銃火の白く閃めくやうな詩が書きたい！",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一夜――五時間――伝馬繋留――水夫睡眠――何でもないことであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛行機から爆弾を投下する光景や繋留気球が燃え落ちる場面があるというので自分の目下の研究の参考までにと見に行ったのが「ウィング」であった。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを防ぐためこの頃行われ始めた方法は、海岸ならばそこに繋留した灯台船の底に鳴鐘を附け、不断これを鳴らしている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "材木｜繋留の太い古杭が朽ちてはうち代えられたものが五六本太古の石柱のように朦朧と見える。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "建込みの場所にはかねて親舟が繋留してある。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一杯になった枠網は親舟に繋留し、夜が明けてから陸地に向って曳航した。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ半分も詰め込みのすまない枠網は親舟に繋留して浜べへ急ぐことになった。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽気球はそれを繋留する綱の長さだけ上りつくして、さて止った。",
              "citation": {
                "source": "風船美人",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "水落つ、たたと………‥灰色の亜鉛の屋根の繋留所、わが窓近き陰鬱に行徳ゆきの人はいま見つつ声なし、川むかひ、黄褐色の雲のもと、太皷ぞ鳴れる。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官もやむをえず、そのまま繋留しておくと、翌朝になって、唖は大変腹が減って来た。",
              "citation": {
                "source": "文芸の哲学的基礎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで小僧はエムプレス・チャイナの給仕服のまま生命辛々の手提籠一個を抱えて税関の石垣の上でワイワイ泣いているのを、チャイナ号の向い合わせに繋留っていたアラスカ丸の船長……貴下が発見て拾い上げた……チャイナ号へ面当みたいに小僧の頭を撫でて、慰め慰め拾い上げて行った……という話なんです。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏軍は、そうした我軍の輸送を妨げるために、昨夜も見た通り毎晩日が暮れかかると間もなくから、不規則な間隔をおいて、強力な光弾を打上げては、大空の暗黒の中に包まれた繋留気球に仕掛けた写真機で、独逸軍全線の後方を残る隈なく撮影しているらしい。",
              "citation": {
                "source": "戦場",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "繋留場には、種牛の外に、二頭の牡牛も繋いであつて、丁度死刑を宣告された罪人が牢獄の内に押籠められたと同じやうに、一刻々々と近いて行く性命の終を翹望んで居た。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "丑松は今、叔父や持主と一緒に、斯繋留場の柵の前に立つたのである。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "検査室にも、待合室にも松が飾ってあって、繋留場では赤い牝牛が一頭と、黒牛が二頭繋いであった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、下に降ろして繋留して置くのが普通ですが、天候を油断してそのままにして置く時もあるのです」「バルーンの浮力が減ったと言うのは？",
              "citation": {
                "source": "デパートの絞刑吏",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "岸壁の外れにニュウ・ヨウク号という相当大きな汽船が停泊していたが、タイタニックが其の舷側と平行のところへ進むと、巨船の裂く水勢に引かれて、ニュウ・ヨウク号の繋留索が見るみるぴいんと張り出したのだ。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかり追い詰められて手も足も出なくなっている二人は、昨夜｜窮余の一策で大胆にも繋留ちゅうの河船を襲い、拳銃で番人を脅迫して食糧を奪い去ったというのである。",
              "citation": {
                "source": "チャアリイは何処にいる",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、どうも分らないことがある」「それは何だね」「本艇から、あの繋留塔をおりて、街へいくが、本艇と街と、いったいどっちが、怪星ガンの中心に近いのだろうか」「なんだって」「つまり、ぼくははじめ、本艇のほうが、怪星ガンの表面に近くて、街は、それより深い所にあると思っていたんだ。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "本艇を繋留塔にむすびつけている繋索は、ものすごく丈夫である。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "繋留索は、はじめはとても本艇からはなすことができないほど強いもので、それをたち切ることをだんねんしていたが、テッド隊長はガンマ和尚がいったことばに希望を持ち、隊員をなおも繋留索のところへいかせて、それをたち切る作業をつづけさせた。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
