    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "絵高麗は元々朝鮮陶器でありまして、現に鶏竜山窯跡から様々なものが発掘されます。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは鶏竜山の刷毛目茶碗のように野生的な自然さを有さない点で我々に推測を許している。",
              "citation": {
                "source": "古器観道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏竜山その他数十ヶ所に於て原料土や釉薬の採取も行つた。",
              "citation": {
                "source": "魯山人作陶百影　序",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "刷毛目は大邱に近い鷄龍山から窯跡が發掘されたゝめ、戸籍がわかつてきた。",
              "citation": {
                "source": "やきもの讀本",
                "author": "小野賢一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
