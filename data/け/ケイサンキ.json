    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "瀬戸物屋の前には、うらぶれた大学生が、計算器を売っていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "終り」「うむ、御苦労」　計算器を合わせていたＭ曹長は、顔をあげて叫んだ。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "男性化してしまった女学員バラは、計算器をガヤガヤと動かしていたが、彼はいくら割っても割りきれない割り算を幾百億の下の桁までも割ろうと無謀な努力を続けていた。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "38　斜めに見える自動計算器。",
              "citation": {
                "source": "浅草公園",
                "author": "――或シナリオ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "計算器の前には手が二つしきりなしに動いている。",
              "citation": {
                "source": "浅草公園",
                "author": "――或シナリオ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "警官の後ろから従いて帰ったゲーム取りは、しばらく入口に立っていて、やがて静かに扉をしめると、足音に注意しいしい計算器の椅子に凭った。",
              "citation": {
                "source": "撞球室の七人",
                "author": "橋本五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学的批評とは評価の計算器のことではなくて、文化媒介の認識論的組織あるものを云うのである。",
              "citation": {
                "source": "クリティシズムと認識論との関係",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気計算器、マイクロフィルム等々の機械礼讃が多くの視察者によって高らかに唱えられた。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、さすがに捜査主任は、人の外貌などは意に介しないらしく、万事、事務的に、計算器のような冷めたさで、訊問にとりかかった。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だつてあの男はまつたく計算器そつくりですからな。",
              "citation": {
                "source": "古書の呪い",
                "author": "THE BLAST OF THE BOOK",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の片腕みたいになって、よく働いてくれたＥ衛生曹長は「米国では計算器が発達しているから、暗算や算術は出来ないのでしょう」といっていたが、いくら米国でも、一般家庭にまで計算器がある訳ではない。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな店にも、それ相当の計算器があるので、算術を知らなくても、結構店員はつとまる。",
              "citation": {
                "source": "六三制を活かす道",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "計算器の求めに応じた選択があるばかりだ。",
              "citation": {
                "source": "百万人のそして唯一人の文学",
                "author": "青野季吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきに荷風の「※東綺譚」あり、秋声の「縮図」あり、近くは潤一郎の「少将｜滋幹の母」あり、しかしこの例は、何も計算器選択説を覆へすものではない。",
              "citation": {
                "source": "百万人のそして唯一人の文学",
                "author": "青野季吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
