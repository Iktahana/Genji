        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "電燈ノスタンドヲ、予ニ光線ガ当ラヌヨウニ覆イヲ懸ケテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………午後二時頃、予ガ書斎カラ寝室ニ戻ッテ約一時間午睡ヲシ、マダボンヤリトベッドノ中デ眼ヲ開ケテイル時、突然浴室ノ戸ガ半分ホド開イテ颯子ノ首ガ此方ヘ出タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ予ガ書斎ニイルカ、寝室デ治療ヲ受ケテイル期間ニ来ルコトニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若奥様トシテノ事務モ相当忙シイ筈デアルガ、何デモ引キ受ケテ極メテ手早ク、イツノ間ニカテキパキト片附ケテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ詰メテ書キ物ヲナサラナイ方ガヨクハゴザイマセンカ、又痛ミ出スト心配デゴザイマス」予ガ日記ヲツケテイルノヲ見テ佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハワザト空ットボケテイルノダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ彼女ハ、遠カラズ予ガ死ンデシマッタ後モ、「アノ馬鹿ナ老人ハ私ノコノ美シイ足ノ下ニ眠ッテイル、私ハアノ可哀想ナ老人ノ骨ヲ今モナオ地下デ蹈ミツケテイル」ト思ウコトヲ禁ジ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後三時頃、木村ニ電話ヲカケヨウトシタラ、毎日ノヨウニカケテイル彼ノ学校ノ電話番号ガドウシテモ浮カンデ来ナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
