    "definitions": [
      {
        "index": 1,
        "gloss": "to wipe one's arse",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
