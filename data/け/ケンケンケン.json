          "literary": [
            {
              "text": "見ると、　ケンケンケンケンケンケン・クエク警察長と書いてあります。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おキレの角はケンケンケン　ばけもの麦はザランザララ　とんびトーロロトーロロトー、　鎌のひかりは　シンシンシン。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつこらさと鍬を下ろすと、ケンケンケンケン……鶺鴒めが鳴きくさる、崖の上の麦畠、天気は快し、草つ原に露がいつぱいだで、そこいら中ギラギラしてたまんねえ。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
