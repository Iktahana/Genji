        "examples": {
          "standard": [
            {
              "text": "師匠から授かった「一期一会」という言葉を拳々服膺し、日々の稽古に励んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "先代社長の遺訓を全社員が拳々服膺することで、我が社は未曾有の危機を乗り越えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「奢れる者は久しからず」という教訓を拳々服膺して、成功しても謙虚さを忘れないようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "こりゃ初子さんなんぞは殊に拳々服膺すべき事かも知れませんぜ。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
