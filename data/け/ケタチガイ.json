    },
    "definitions": [
      {
        "index": 1,
        "gloss": "an order of magnitude higher",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年の売上は昨年と比べて桁違いに増えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は桁違いの資産を持つ大富豪だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その選手の体力は他のメンバーと桁違いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ちょっと考えるとある地方で大地震が数年以内に起こるであろうという確率と、あるつり橋にたとえば五十人乗ったためにそれがその場で落ちるという確率とは桁違いのように思われるかもしれないが、必ずしもそう簡単には言われないのである。",
              "citation": {
                "source": "災難雑考",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "学ぼう、学ぼうと思いながらも、悟空の雰囲気の持つ桁違いの大きさに、また、悟空的なるものの肌合いの粗さに、恐れをなして近づけないのだ。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "算術の最も易しい寄せ算をするにしても散る気でもって計算していたら、桁違いを仕たりしそうな事である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "算数をすれば桁違いや撥込みなぞをする傾向がある。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の負けじぎらいも物質的には桁違いでどうにもならなかった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、コンピューターは、それらとは桁違いの力を人間に与えてくれそうだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、もっぱら数値と文字だけを相手にしてきたコンピューターに、絵や音や動画を扱わせようとすれば、従来とは桁違いの処理能力と記憶容量が必要になった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことこうした単純な形の情報に限れば、コンピューターの処理スピードは人間に比べて桁違いに速く、人間にはほんの一瞬と思えるあいだにかなりの作業が進んでしまう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした桁違いの負荷がかかることを踏まえ、ＰＣ―１００には高速化のためのさまざまな回路上の工夫が盛り込まれていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "性能が桁違いに上がり続けるコンピューターの世界では、古いものはたちまち消える。",
              "citation": {
                "source": "短く語る『本の未来』",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の俸給と桁違いだもんだからソンナ事を云うんだ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "話はそれだけであるが、水沢観音付近の産である仙公狸は、四足動物として桁違いの欲望を起こした上に、狸に通有の洒脱味から脱線して、あまり純情であったがために、遂にはかなき最後を見た。",
              "citation": {
                "source": "純情狸",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に桁違いの威力を持つものを作ることは不可能でもないであろう。",
              "citation": {
                "source": "原子力の管理",
                "author": "仁科芳雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその代りに数量の方は技術の発達により、施設の増強により、桁違いに増すことができるであろう。",
              "citation": {
                "source": "原子力の管理",
                "author": "仁科芳雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日までに判明した被害の集計だけをみても、死者　　　三百五十四名行方不明　二百八十四名負傷　　　千名以上というのであるから、かつて最も被害の大きかったといわれているジェーン台風よりも、桁違いに大きい被害をもたらしたのである。",
              "citation": {
                "source": "亡び行く国土",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の中には私の場合などより、桁違いに多い人もあろうが、ともかく私の蒐集も少い方とはいえぬ。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで桁違いなのだから、そこで譲歩すべきであるのに、眼がないというか血気の勇というか、まるっきり逆上したようすで、左右から伊兵衛に向って斬りかかった。",
              "citation": {
                "source": "雪の上の霜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来の日本の法律がはなはだ非民主的であつたことは、我々の国体が支配階級の利益のみを唯一の目的として形成し、維持されてきたことの当然の結果であるが、その中でも、社会救済政策、および文化保護政策の貧困なることは、これを欧米の三、四流国に比較してもなおかつ全然けたちがいでお話しにならない程度である。",
              "citation": {
                "source": "著作権の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれだけ苦学までした人間じゃありませんか」「若いときは、それゃ苦労したろうが、とにかく、日本の金の勘定はよくわからないらしい」　泰造と一緒に出かけて、食事の支払いにけたちがいの金を出し、それを注意したら、金の勘定は不得手だからたのむと、札入れを泰造にまかした、というのであった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり信長公に至っては、従来の英雄とすこし型がちがっていて、眼界のひろさが、けたちがいだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでいつか放送局でラジオ相談所として推薦した本郷の某ラジオ屋へ試みに修繕に出したら、今度は断然｜桁ちがいに感度を低下してしまって、もう拡声器では聞かれなくて、テレフォンでやっと聞こえるようになってしまった。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どういうものか、はじめから寺中甚吾左衛門に旗色が悪くて、いつもの甚吾にも似ず、言うことが片っぱしからどじで、取った点も列座の面々とは桁ちがいと来ているので、甚吾の心中、はなはだ穏かでないものがある。",
              "citation": {
                "source": "寛永相合傘",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔のエンジンの出す力を、かりに蟻一匹の力にたとえると、今どこにでもある一番小さいエンジンの出る力は、七尺ゆたかな横綱力士が出す力ぐらいに相当するんですからねえ、まるで桁ちがいですよ」「なるほど、そういわれると、そのはずだねえ。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから耕作は二重三重にらくになり、収穫は桁ちがいに増大した。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気のないところへ出れば、もっと桁ちがいの快速度が出る」「それが、どこから、とび出したのですか」「研究所の横に、崖があったね。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "震災以来の桁ちがいの味覚であった。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカン・インディアンが白人コロンブス一行を迎えたときの驚愕、エスキモー人がロシア人を見たときの驚愕などは、今回の事件に比べると桁ちがいの小さい驚愕だ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し氷河期の災禍は世界の有する工業力とは桁ちがいに激甚なのである。",
              "citation": {
                "source": "予報省告示",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじょ、そこいらの自称学者先生とは、桁ちがいの大学者なんだ。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに太陽光線の利用度からいうと、普通の農作物とは桁ちがいの効率を上げる。",
              "citation": {
                "source": "科学は役に立つか",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
