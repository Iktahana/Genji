[
  {
    "uuid": "b2819592-f08c-588b-83d8-6ebd2f2bb2ef",
    "entry": "桁違い",
    "reading": {
      "primary": "けたちがい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
