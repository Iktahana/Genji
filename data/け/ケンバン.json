[
  {
    "uuid": "1a6a8a90-4fa8-52dd-b6a2-79f1a6b5090c",
    "entry": "鍵盤",
    "reading": {
      "primary": "けんばん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
