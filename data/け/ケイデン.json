        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』と考へ乍ら、裏畑の細径伝ひ急ぎ足に家へ帰つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "編上靴をシッカリと搦み付けて、勝手口から佩剣を釣り釣り出て来ると、国道とは正反対の裏山に通ずる小径伝いにサッサと行きかけたので、表通りで待っていた一知青年は、慌てて追っかけて来た。",
              "citation": {
                "source": "巡査辞職",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "保吉はとうとう小径伝いに玄関の前の広場へ出た。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物人は小径伝いに降りてゆき、彼を崖上に援け上げた。",
              "citation": {
                "source": "化生のもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さアこっちへおいで」　と花の手をとり、小径伝いに一散に花壇の方へ駆けて行く。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と考え乍ら、裏畑の細徑傳ひ急ぎ足に家へ歸つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
