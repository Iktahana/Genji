        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あんな尻穴の言うことなんか気にするな」と親友がぼそっと慰めてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「あいつは本当に尻穴だな」と愚痴をこぼしながら、彼はビールを一口あおった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "上司を「あの尻穴め」と罵倒した一言がきっかけで、彼は職場での評判を一気に落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
