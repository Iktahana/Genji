          "literary": [
            {
              "text": "一年生の時にはかえって一時剣道部に席をおいたことがある。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田先生は第三中学校の剣道部と云ふものの先生だつた。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田先生は第三中学校の剣道部というものの先生だった。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の相手になるのは剣道部員で、おとなしい生徒だけれども、剣道の巧みな男であつた。",
              "citation": {
                "source": "剣術の極意を語る",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "任地へ戻ってから間もなくのこと、或日学校に何かの会があって、職員一同と生徒の一部が剣道部に集った。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、剣道部の秋の試合に示した、友の沈着な技量は僕達を驚かしました。",
              "citation": {
                "source": "わが師への書",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
