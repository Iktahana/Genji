      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "steep",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "目の前に立ちはだかる険峻な崖を見上げ、登山家はルートの選定に神経を尖らせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その険峻な山道は、慣れた地元の人でも足を踏み入れるのをためらうほどの難所だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かつてここは、険峻な地形を利用した天然の要塞として機能していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "大内義弘亡滅の後は堺は細川の家領になったが、其の怜悧で、機変を能く伺うところの、冷酷｜険峻の、飯綱使い魔法使いと恐れられた細川政元が、其の頼み切った家臣の安富元家を此処の南の荘の奉行にしたが、政元の威権と元家の名誉とを以てしても、何様もいざこざが有って治まらなかったのである。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、雪や氷の蔽っている足がかりもないような険峻の処で、そういうことが起ったので、忽ちクロスは身をさらわれ、二人は一つになって落ちて行きました訳。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くより望んだよりはさらに一層の険峻で、岩は悉く削ったように聳っている。",
              "citation": {
                "source": "月世界跋渉記",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　香巌寺を辞し、渓の中途から左折して一旦山中の平坦なる路に出で、千山諸峰の中の最高峰である仙人台を左方の上に見て、次第に北へ一里ほど行き、更に左折して別の渓へ入ると、険峻な峰を直上することになつたので、私は轎を下りて歩いた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "一浴の後に、加藤、梅原二氏と夜食を共にし、千山の景勝と険峻とを語つて、二氏の御案内の労を感謝するのであつた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ここに攀躋するや、悪道険峻、満身汗を流し、昨冬小笠原母島を跋渉せるときを想出す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある道は日にさらされて険峻な坂をなしていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペテルブルグほど人間の心に陰鬱険峻な、奇怪な影響を与えるところはまずあまりありますまいよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "広東湾の白堊の燈台に過去の燈は消えかけて、ハッピーバレーの嶮峻にかかった満月が年少の同志の死面を照りつけた。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここ嶮峻なる絶壁にて、勾配の急なることあたかも一帯の壁に似たり、松杉を以て点綴せる山間の谷なれば、緑樹｜長に陰をなして、草木が漆黒の色を呈するより、黒壁とは名附くるにて、この半腹の洞穴にこそかの摩利支天は祀られたれ。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁謂もこれに先だつこと一年か二年、明道年間に死んだのであるが、寂照が平坦な三十年ばかりの生活をした間に、謂は嶮峻な世路を歩んで、上ったり下ったりしたのであった。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "東　なきつらに蜂西　なす時の閻魔顔　禍は単り到らず、悲を破るの勇気無きものは復新に悲を得るを云へるは東、人情嶮峻にして金を借る時は仏顔をなし、返す時は閻魔顔をなすの陋態を罵れるは西のなり。",
              "citation": {
                "source": "東西伊呂波短歌評釈",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "歸りは上りになるのと、一度でも歩いた路なのとで、嶮峻の感じを大に薄くする。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "金華山の一夜　金華山は登り二十余町、さのみ嶮峻な山ではない、むしろ美しい青い山である。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここには限らず、古来著名の神社仏閣が多くは風光｜明媚の地、もしくは山谷嶮峻の地を相して建てられていると云う意味を、今更のようにつくづく感じた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大きさは五｜石を盛る瓶の如くで、これに蔵する蜂蜜はさぞやと察せられたが、何分にも嶮峻の所にあるので、往来の者はむなしく睨んで行き過ぎるばかりであった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "続夷堅志・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "山は甚だ嶮峻で、四面にたくさんの洞窟があって、それがあたかも房のような形をなしているので、房山と呼ばれることになったのである。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "子不語",
                "note": "青空文庫"
              }
            },
            {
              "text": "方言に山の嶮峻なるを倉といふ、諸莊に嶮峻の巖山に祭れる神を矢倉明神と稱すること多し。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには山麓といふものがなく、下部も、上部と同じく嶮峻な峰であり、その上方にも下方にも高く空が展がつてゐる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "况んや、其路｜坦々として砥の如く、復た舊道の如く嶮峻ならざるに於てをや。",
              "citation": {
                "source": "秋の岐蘇路",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この山は南側太平洋に面した方は極めてなだらかな傾斜をつくり、海抜四千何百尺かの高さから海に向って遠く片靡きに靡き下っているのであるが、私の生れた村に臨んだ側は殆んど直角とも云い度い角度で切り落ちた嶮峻な断崖面をなして聳えて居る。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、嶮峻の隘路に立つものは拳石にだも躓いて直ぐ千仭の底に墜ちる。",
              "citation": {
                "source": "美妙斎美妙",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "山々は嶮峻に彼らを守りながら季節に従つて柔かに青葉を変へた。",
              "citation": {
                "source": "静かなる羅列",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "登山季節といえども、二千米以上の部分は嶮峻であり、それに火山灰が深くて登攀に困難だということだ。",
              "citation": {
                "source": "エトナ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど嶮峻な峰の連続である。",
              "citation": {
                "source": "従軍五十日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪山の嶮坂を攀じ登る　暫く休んで北に登ること一里にして西に折れ一方に千仞の谷間を望みつつ崖道の恐ろしい牟伽羅坂という坂を登って参りましたが、その坂路の嶮峻なることはなんとも形容のしようがございません。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "巌山ニシテ東麓利根川ニ至リ、南嶮峻屏列月ヶ岳ニ連リ、北方巉巌重畳シテ刀嶺ノ岳ニ連亘シ、西ハ越後国伊香沢村ノ奥ニ跨ル。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に巌山といい、嶮峻｜巉巌などいう文字は、越後沢山の方に適した形容であるし、南方から望めば山勢奔馬の如きものがあって、駒ヶ岳の名は越後沢山に冠せしめた方がよいようである。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この旅を始めて以来日一日と其麓に近付くに連れて、山の高さは加わり嶮峻の度は増して、曾ては一度其｜巓を窮めた身にも、自分は果してあの頂上に登ることが出来たのであろうかと疑わざるを得ない程、心の動揺するのを感じた。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山を思う心に浮ぶのは、秀麗な、嶮峻な山だけで、アイスピッケルをトラーゲンしてフェースをトラヴァースする人々の姿は見えはしない。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
