[
  {
    "uuid": "f6172884-1f6b-5159-a54c-624cc871b0cc",
    "entry": "険峻",
    "reading": {
      "primary": "けんしゅん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
