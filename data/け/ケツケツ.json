        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "楢雄はわけが判らず、けつたいな名になりやがつたと、ケツケツと笑つてゐたが、修一はさては籍がはいつたのかと苦笑し、友達の手前は養子に行つたのだと言ひつくらはうと咄嗟の智慧をめぐらした。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが彼は、ふざけてそんな時の癖で何かの声色でも真似るらしく重々しい調子で、「水の精ニツケルマンの独り言のやうだらう――ブレツケツケツ、ケツクス！",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブレツケツケツ、何とか位ゐ！",
              "citation": {
                "source": "秋晴れの日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
