        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ都所ノ別当ニダケハ、ナツテモヨイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、ドウシタ　コトカ、ゲタニ　バケル　コトダケハ　タイヘン　ウマイ　モノデ　アリマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ソノ……サケハ……オレノ……キモノ……テツケジャ……。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒハ　カン　カン　ト、マウヘカラテツテ、アツクテ　タマリマセンデシタガ、ジヨン　ト　チビスケハ　カケツコシテ　ノハラニ　ユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チビスケハ　ビツクリシテ　ナキダシマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナシサウナ　チビスケハ　クビヲ　タレタママ、ジヨンノ　アトカラ　ツイテユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジヨンガ　イヒマシタガ　チビスケハ　クビヲ　アゲマセン。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハ　オホイヌダ」ト　チビスケハ　ヨロコンデ　トビアガリ、シツポヲ　クルクルト　フリマワシマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チビスケハ　チヨツト　カンガヘテ　ヰマシタガ、ヤガテトビアガツテ　イヒマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "網棚へ小道具の入ったスーツ・ケースを載せると、灰銀のフラノのワンピースに緋裏のついた黒のモヘアのストールという、どこかのファッション・モデルのような恰好で車室を流して歩き、知った顔がないかと物色していたが、三つ目の車でロケハンにでも行くらしい楠田という助監督の一行を見つけた。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "…………………ながいことたってから、かすかに明るいへんの、さらに奥のあたりで人のケハイと足音。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ人間ダケハ植物ダト思フワ。",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ予ノ心境ヲ、颯子ダケハオボロゲニ察知シテイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ支度ダケハ甲斐々々シイガ、離レタトコロカラ見テイルダケデ、ロクニ何モシテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食ダケハ寝室デ取ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦災ノ時ニ又モウ一度改築シタガ、隠居所ダケハ奇蹟的ニ火災ヲ免レタノデ、今モナオ父母アリシ日ノ姿ノマヽニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ソウ云エバ夢ノ中ノ母ハ黒縮緬ノ羽織ヲ着ナガラ足ダケハ足袋ヲ穿イテイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾコノ髯ダケハ剃ッテ置キタイナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ颯子モイルコトダシ、―――颯子ハ南禅寺ヘ泊ルノハ懲リ／＼ダカラ、ソレダケハ堪忍シテクレト云ッテルンダ」「ドッチニシタッテ颯子ガ行ッタラ又喧嘩デスヨ」「掴ミ合イデモ始メテクレタラ面白イサ」婆サントソンナ遣リ取リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来得レバ他ノ何者ニモ気付カレズ、予一人ニダケ、全ク予一人ニダケハッキリト感ジ取ラレルヨウニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ人ガ優レタ藝術家デアレバアルホド、断乎トシテ刎ネツケハシナイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体妻ハ来客ニ対シテハ不愛想デ、コトニ男ノ客人ニハ会イタガラナイノデアルガ、木村ニダケハ親シムノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ敏子ダケハ、三人デ酒ガ始マルト必ズ嫌ナ顔ヲシテ自分ダケサッサト切リ上ゲテ出テ行ッテシマウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノダケハ運搬ノ都合デ二三日｜後レルガ、他ノ荷物ハ木村ガ手伝イニ来テ大体運ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
