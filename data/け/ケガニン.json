    "definitions": [
      {
        "index": 1,
        "gloss": "wounded person",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "交通事故で複数のけが人が出た",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "けが人を最寄りの病院に搬送する",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "災害現場ではけが人の対応が優先される",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その余はすべてなるまゝだ……自恃だ、自恃だ、自恃だ、自恃だ、ただそれだけが人の行ひを罪としない。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "七、「サヨナラだけが人生だ」という先輩の詩句を口ずさみて酔泣きせし事あり。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けが人を床の上に放ってはおけませんからの。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "金井君は、世間の人が皆色情狂になったのでない限は、自分だけが人間の仲間はずれをしているかと疑わざることを得ないことになった。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分だけが人知れずに苦労しているよりは、ちっとは面白く浮かれて見るもいいと、自棄も手伝った気まぐれから、今夜すなおにお花に誘い出されたのであった。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある瞬間から市民はすべて魔睡にかかり、鼾だけが人間の存在から分離されて勝手に夜なかの街を走りまはる。",
              "citation": {
                "source": "広島の牧歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "家々の窓の火光だけが人懐かしく見えた。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "家々の窓の火光だけが人懷しく見えた。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "――飲む食べる、しやべるふざける、――それだけが人生か！",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "その隣りは、「生きた人蜘蛛」という題で、顔だけが人間であとは蜘蛛の大きな絵看板がかかげてある。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナチスは、ドイツ人だけが人類の中で繁栄すべき民族だと主張して、見識のせまい、偏見にみちた保守勢力に迎合した。",
              "citation": {
                "source": "世界の寡婦",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんにち揺がない大出版企業の代表者たちが、文化上どのような性質をもつ存在であるかということは、渡米ラッシュの各界代表選出にさいして、出版界だけが人選にゆき悩んでいる実状に語られている。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけが人生の力頼みのような気がした。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけが人生の力頼みのやうな気がした。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は官員だけが人間としての待遇を受けた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "快楽主義――これだけが人間の最後の目的なのだろうか」　九月二十五日の頁を見ると、ただ一行、「今日で丁度、病床生活一年間」　アグネス・アン・ルロイは、オレゴン州テラムウクの生れで、本名は、アグネス・イムラア。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "己達はいつも二人並んで歩いたり泳いだりして居たっけが人様よりも美くしい毛色をもった己はいつも仲間からうらやまれて居た。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "習慣だけが人をずるずる引崩す。",
              "citation": {
                "source": "在学理由",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると又、あいにくなことに、最も欲するものを抑へること、せめてそれが満足である、いはゞまアそれだけが人間の自覚のやうな気がして、そんな理窟で間に合ふことも多かつた。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "君たちだけが人類じゃない」　返事とともに怪物群は、一せいに頭部をゆすぶって奇声を放った。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の人は、前後は神のもので、中だけが人間のものと考えられる。",
              "citation": {
                "source": "嫉みの話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけが人生のすべてだといふ風に見たいのだ。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり槌の速さだけが人々で変えられる唯一のものである。",
              "citation": {
                "source": "音楽界の迷信",
                "author": "兼常清佐",
                "note": "青空文庫"
              }
            },
            {
              "text": "因州の家中はなかなか枯れた人で、全軍通過のあとにこうしたものを残して行くのは本意でないと半蔵らに語り、自分らの藩からこんなけが人を出したのはかえすがえすも遺憾であると語った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「とにかく、けが人も出さずにね。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、けが人は出したくないものだね。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれも村からけが人は出したくない。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伊之助さん――どうやらこの分じゃ、村からけが人も出さずに済みそうですね。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにたくさんなけが人を出したことも、村の歴史としてはかつて聞かなかったことだと父も言っていた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "耕地も少なく、農業も難渋で、生活の資本を森林に仰ぎ、檜木笠、めんぱ（割籠）、お六櫛の類を造って渡世とするよりほかに今日暮らしようのない山村なぞでは、ほとんど毎戸かわるがわる腰縄付きで引き立てられて行くけが人を出すようなありさまになって来た。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
