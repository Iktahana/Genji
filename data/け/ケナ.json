  {
    "uuid": "763baac2-ae68-5a21-8343-b22ba545aed5",
    "entry": "ケナ",
    "reading": {
      "primary": "けな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「何だ、ボケナス、どうしてはめないんだ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "太宰イツマデモ病人ノ感覚ダケニ興ジテ、高邁ノ精神ワスレテハイナイカ、コンナ水族館ノめだかミタイナ、片仮名、読ミニククテカナワヌ、ナドト佐藤ジイサン、言葉ハ怒リ、内心ウレシク、ドレドレ、ト眼鏡カケナオシテ、エエト、ナニナニ？",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココマデ書イテ、書ケナクナッタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取りムカシ　ムカシノオ話ヨミギノ　ホホニ　ジヤマツケナコブヲ　モツテル　オヂイサン　このお爺さんは、四国の阿波、剣山のふもとに住んでゐたのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瘤取りムカシ　ムカシノオ話ヨミギノ　ホホニ　ジヤマツケナコブヲ　モツテル　オヂイサン　このお爺さんは、四國の阿波、劍山のふもとに住んでゐたのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふもサケナシデーだつた、いやナツシングデーだつた、時々、ちよいと一杯やりたいなあと思つた、私は凡夫、しかも下下の下だ、胸中未穏在、それは仕方がない、酒になれ、酒になれ通身アルコールとなりきれば、それはそれでまたよろしいのだが、そこまでは達しえない、咄、撞酒糟漢め。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日でサケナシデーが三日つゞく、飲みたいのをぐつと抑へて、――つらいね！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ケレド、ヨク　ミルト、ソノ　サルハ　ビヨウキニ　カヽツテ　ウゴケナク　ナツテ　ヰマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　タキクンガ　イフト、「オマエガ　イケナイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、タキクンノ　カホヲ　ノゾキコミナガラ、「オトナシク　シナキヤ　イケナイヨ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ、ソノ　ムラハ　アサニ　ナツテモ　ダレモ　オモテニ　デテ　クル　モノハ　ナク、マドサヘ　アケナイノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "−−−−−−−−−−−−−−−−−−−−−−−−−−二科展所感　　　坂本繁二郎小論○島崎鶏二氏――この人の作品に絵的であるとかいつてケナすのは誤りである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは五月なかばの雨の日に市村座へ出かけて「ダンナハイケナイ」の劇を見物したが、それは全くイケナイものであった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
