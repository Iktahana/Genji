        "examples": {
          "standard": [
            {
              "text": "この事件は複数の汚職事件に牽連している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の発言は、その会社の不祥事に牽連しているとみられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は無関係だと主張したが、状況証拠は牽連を強く示唆していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "東　縁は異なもの西　縁の下の舞　東のは赤縄紅糸の相牽連するは、人意を以て測る可からざるものあるを云ひ、西のは縁の下の舞の舞ひ得て妙なるも、堂上の眼に入らざることを云へるなり。",
              "citation": {
                "source": "東西伊呂波短歌評釈",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
