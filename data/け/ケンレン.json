    "definitions": [
      {
        "index": 1,
        "gloss": "prefectural party chapter",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "自民党の県連が、次期選挙の候補者を擁立した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は県連の幹部として、地域の政治を動かしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "県連の会合では、活発な議論が交わされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "県連の方から融通受けた金の利子さえ払えなくて、毎期、俺たちのような下っ端の、文句のいえねえ人間の、僅かばかりの借りをいじめて、執行だ、なんだって……それでようやく一時のがれやっているけんど、いまにそれが利かなくなったら清算と来べえ。",
              "citation": {
                "source": "瘤",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝口三丁目の四県連合足尾銅山鉱業停止同盟事務所は、二十日と二十四日とに鉱業被害概表を各方面へ発送した。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
