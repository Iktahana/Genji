[
  {
    "uuid": "e64220c3-5a48-597c-b91d-166baadd8394",
    "entry": "敬愛",
    "reading": {
      "primary": "けいあい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
