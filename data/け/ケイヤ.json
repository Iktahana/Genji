          "literary": [
            {
              "text": "わが国には古え軽箭・穴穂箭の名があった〔「安康即位前紀」〕。",
              "citation": {
                "source": "「鐵」の字の古体と古代の文化",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽箭は青銅の鏃、穴穂箭は鉄の鏃が着いた箭である。",
              "citation": {
                "source": "「鐵」の字の古体と古代の文化",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽箭はとうてい穴穂箭の敵ではなかった。",
              "citation": {
                "source": "「鐵」の字の古体と古代の文化",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれその矢を輕箭といふ。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
