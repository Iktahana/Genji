  {
    "uuid": "c3413e82-29e4-5d1a-abcd-f45d52fcf9d5",
    "entry": "軽悔",
    "reading": {
      "primary": "けいかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし、その詠嘆の底には、みずからは永遠に気のつかない惨忍な人類への軽悔が潜んでいるのである。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい名前を聞くたびに、彼は軽悔の色を浮べた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて古來漢族の根據地で、同時に文化の中心點であつた北支那が、爾後三百年間、殺伐野蠻な塞外諸族に占領さるると共に、彼等の支配の下に、漢族は多大の輕悔と虐待を受けたこと申す迄もない。",
              "citation": {
                "source": "歴史上より觀たる南支那の開發",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
