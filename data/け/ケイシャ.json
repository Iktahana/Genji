        "examples": {
          "standard": [
            {
              "text": "医者は患者の患部に温かい油を傾瀉した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "調理で鍋から別の容器に傾瀉する際には慎重に行う必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "実験では試薬を慎重に傾瀉しながら混ぜ合わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "朝鮮の政治家、誰か能く、此の國民的性情と、歴史的積勢の外に出るを得ん耶、已に然り、日本國民は其あらゆる同情を傾瀉して金朴の二人を保護したりと雖も、誰れか金朴が能く百年我に負かざるを保せん耶。",
              "citation": {
                "source": "深憂大患",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、僕、よけいしゃくにさわって、思いきって言いたいことを言ってやったんです。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
