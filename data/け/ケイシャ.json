    },
    "definitions": [
      {
        "index": 1,
        "gloss": "quartz sand",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "珪砂はガラス製造の主な原料である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "鋳造工場では珪砂を使用して型を作る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "珪砂の粒度によって製品の品質が変わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "だから、僕、よけいしゃくにさわって、思いきって言いたいことを言ってやったんです。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "※17　硅砂＝「硅」はシリカを指す。",
              "citation": {
                "source": "インドラ［※１］の網",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天の子供らは夢中になってはねあがりまっ青な寂静印の湖の岸硅砂の上をかけまわりました。",
              "citation": {
                "source": "インドラの網",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、砂耕法と稱して、純粹の硅砂中に植物を植ゑて各種の養分を與へても、同樣の試驗が出來るのである。",
              "citation": {
                "source": "ヴィタミン研究の回顧",
                "author": "鈴木梅太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
