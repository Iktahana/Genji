        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "枕元には、いま障子の破れ穴から飛び込んで来た三毛が、ぶるぶるっと毛繕いして、ものほしそうに鳴いていた。",
              "citation": {
                "source": "蜜柑",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫は腰を下ろして、涼しい顔で彼に背を向け、毛繕いを始めた。",
              "citation": {
                "source": "四風の街",
                "author": "The Street of Four Winds",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫はそこでいったん丸くなり、毛繕いを始めた。",
              "citation": {
                "source": "四風の街",
                "author": "The Street of Four Winds",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　猫は毛繕いを終えた。",
              "citation": {
                "source": "四風の街",
                "author": "The Street of Four Winds",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい鳥たちが毛繕いをしたり、反り返ったり、若い兵士のように威張って行進したりしている。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると１羽の鳩が鳩小屋に着地して、羽根を毛繕いした。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
