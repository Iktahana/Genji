        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ムシュウス・スケボラは、ぼうぎやくな王を殺さなかつたのを悔いて、じぶんに刑罰を加へるために、手を火の中につッこんで焼きました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥロットはそのいきほひのすごいのを見て、これは、ミスもスケボラのやうに、じぶんで手をやいたことがあるのぢやないかとおもひました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオニダス、ネルソン、スケボラ、コクレス、リシャール、これだけの人が頭の中でをどりまはります。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスは、さつき、スケボラのやうに……何とかスケボラだつたつけ……あゝ、ムシュウス・スケボラだ。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのスケボラのやうにうでをつき出しました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスは、そのつぎには、レオニダス、コクレス、スケボラ、それからもう一ぺんネルソンのすがたになつてあらはれました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "変種に白花の品と淡紅色の品とがあって、その淡紅色のものをアケボノユリ（新称）といい、白花のものをシラタマユリと呼んでいる。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "和名をホンアマリリスという人もあるが私はこれをアケボノズイセンと呼んでいる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の言うのは、あなたが、どうしてそんな事になるまでイケボンヤリと坐っていたのって言うの、食べるものが無いなんて――なぜ今まで私にだまっていたのよ？",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにもふたとおりあって、ヨリボッタという太いのは、キジくらいのもあり、細いのを毛ボッタといって、商売人はケボという。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
