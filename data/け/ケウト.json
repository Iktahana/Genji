        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "生々しい膝節を出してスカートのような赤縞のケウトを腰につけたスコットランド服の美貌の門番が銀盆の上に沢山の「平凡」を運んで来た。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼女が几帳面な彼に何かケウトイ心もちを感じた為にも違ひなかつた。",
              "citation": {
                "source": "貝殼",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「トオケウトオキイ」の撮影所。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "微々　　（電話帳を繰り）えゝと、トオケウトオキイ株式会社撮影所と……。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（番号を廻し）あ、もし、もし、トオケウトオキイの撮影所ですね。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
