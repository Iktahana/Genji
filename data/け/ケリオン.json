          "literary": [
            {
              "text": "巴里から十何時間、ブルタアニュの西海岸で、その昔ケリオンといふ不思議な小人が住んでゐた処です。",
              "citation": {
                "source": "カルナツクの夏の夕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、この附近にケリオンといふ小人の種類が棲んでゐた。",
              "citation": {
                "source": "ブルタアニュの伝説より",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれもやつてやる」　織物屋はケリオンの踊つてゐる場所を尋ね廻つた。",
              "citation": {
                "source": "ブルタアニュの伝説より",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
