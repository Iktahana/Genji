        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女はどんなに大変な状況でも、けろっとしていて動じない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「まったく、あの人はいつもけろっとしてて羨ましいわ」と友達が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大勢の前で失敗したのに、彼はけろっとしていて全く気にしていない様子だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
