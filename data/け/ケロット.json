    "definitions": [
      {
        "index": 1,
        "gloss": "completely",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は高熱が出ていたのに、朝にはけろっと元気になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あら、もうけろっと忘れてるみたいね」と彼女は微笑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昨日まで落ち込んでいたのが嘘のように、今日はけろっとした顔をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "アスピリンをどっさり呑めば、けろっとなおるのだが。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　梟はもうけろっと澄まして答へました。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」けろっとしていた。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰とでもすぐ懇意になって、相手がまだけろっとする暇もない中に、もう『君、僕』で話しだす。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "けろっとしている水面に向ってつンと手ばなをとばした一人の男は「おンや？",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　飯台に向うと父親はけろっとしていた。",
              "citation": {
                "source": "前夜",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "などと云ってけろっとしていた。",
              "citation": {
                "source": "雨の山吹",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩きだした泰三は立停って、けろっとした顔で振返った。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダムはそれをしまいまで聞いてから、けろっとした顔で百姓に問いかけた。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにごともなかったように、けろっとしている。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケプナラ、ザンベック両君に避難しろって」「ああ、あんなこと」と、おのぶサンはケロッとして、「あたし、なんだか忘れてしまったらしいよ」「馬鹿っ」と怒気心頭に発した折竹ががんと一つ殴りつけ、「なんのために……。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "とか何とか実にスラスラと事を運んで、ケロッとした顔をして御飯に呼ばれるまでは遊んで行く。",
              "citation": {
                "source": "二十三番地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本へかえって一ヵ月も温泉へ行けば、ケロッとしてしまうだろうって話しだったよ」　そう素子がつたえた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おはるは、ケロッとして、さっさと帰って行った。",
              "citation": {
                "source": "入梅",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日、大東学園病院に見舞いに行ったところ、三浦さんはケロッとしている。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
