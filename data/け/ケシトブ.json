    "definitions": [
      {
        "index": 1,
        "gloss": "to scatter away",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の不安は、彼の優しい言葉で消し飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夢中で遊んでいると、時間の感覚が消し飛んでしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "事故の衝撃で、車の部品が四方に消し飛んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "おまけにひどいあらしで、屋根の石かわらはけしとぶし、女王の遊園のがい骨のぶら下がっている木も、風であしのようにくなくなにまがりました。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "三味線の音もしたけれど、吹さらわれて大屋根へ猫の姿でけし飛ぶようさ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い煙の上にけし飛ぶ枯木の黒い影が見える。",
              "citation": {
                "source": "ある幻想曲の序",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "老爺は少し踉いたが、ウムと踏張ツたので、學生は更に彈ツ返されて、今度は横つ飛に、片足で、トン、トンとけし飛ぶ……そして壁に打突ツて横さまに倒れた。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街を離れた川沿いの一つ家はけし飛ぶ程揺れ動いて、窓｜硝子に吹きつけられた粉雪は、さらぬだに綿雲に閉じられた陽の光を二重に遮って、夜の暗さがいつまでも部屋から退かなかった。",
              "citation": {
                "source": "小さき者へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、雪がけし飛ぶ、愈｜霊山が流れるぞ。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あいつを受けたら粉微塵、骨肉共にけし飛ぶだろう。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場で生産に従事している若い労働者が、七時間労働を終って研究会の椅子へ坐ると、彼の頭からは職場も生産経済計画の数字もけし飛ぶ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "表紙がちぎれて本が遠くのほうへけし飛ぶ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "消しとぶように犬は逃げる。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の間のビタミン不足が一度に消しとぶような気がする。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし魚眼レンズをラグビーのスクラムの中につっこんで撮ったりして、初めて動く魚眼の映画像を見た時は、これまでの苦労も消しとぶほどの興奮をみなに与えたのであった。",
              "citation": {
                "source": "色彩映画の思い出",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが一度の颱風で消しとぶばかりでなく、父から祖父から譲られた大切な田圃が、ひとときの間に押し流されてしまう。",
              "citation": {
                "source": "大雪山二題",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不気味さに、岐道を取ってけわしい坂を山越しすれば、その山の頂上から、魂も消しとぶ逆落しの下り道。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦こがしが消飛ぶでや、お前様もやらっせえ、和尚様の塩加減が出来とるで。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
