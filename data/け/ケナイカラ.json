          "literary": [
            {
              "text": "振リ向ケナイカラ顔ハ見エナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「興奮サセルトイケナイカラ、アダリンヲ飲マセタゲマショウカ」颯子ガ予ニコウ云ウ種類ノコケトリーヲ云ウノハ始メテデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今時分カラ芝生ノ上ニ坐ッタリシテ、冷エルトイケナイカラオ止シナサイト、婆サンハ頻ニ止メタガ、「オ爺チャン、チョットイラッシャイヨ」ト、颯子ガスヽメタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "滑ルトイケナイカラユックリト」予ガ戸口マデ辿リ着イタ時、柔イ指ノ先ガ背中ヲ軽ク押シ出スノヲ感ジタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "習慣ニナルトイケナイカラ今夜モ二錠ヨ」「口移シニシテクレナイカナ」「ソノ顔ヲ考エテモノヲ仰ッシャイ」ソレデモ手デ摘マンデ入レテクレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
