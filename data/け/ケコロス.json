          "literary": [
            {
              "text": "帰らんか、野郎、帰れと云うに、そこを起たんと蹴殺すぞ！",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「存分にすれば蹴殺すばかりよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "退かぬとおのれ蹴殺すぞ。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "退かなきゃ蹴殺すぞッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥八　　寄越さねえと蹴殺すぞ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "慮外なまねすると、蹴殺すぞ」　はったと、睨めつけて、「――帰ったらそう申せ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわねば、蹴殺すぞ」「こ、ここには、おりませぬ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「邪魔すると、蹴殺すぞ」　張飛は、一方へこう呶鳴って歩きかけた。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はこの通り縛られて自由の利かぬ身体だが、ナアニ、貴様の様な卑怯者の一人や二人、蹴殺すのは訳もないぞ」　賊は先ず一喝して置いて、ひるむ山田をねめつけながら、喋り出した。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "なに、おれだけ殺すことは出来ないと云ふのか。",
              "citation": {
                "source": "チロルの旅",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは云うが、死神と狐の両手両足は不二男の首と腰に肉の中までくいこんでいるから、放すこともできないし、死神と狐だけ殺すということもできない。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
