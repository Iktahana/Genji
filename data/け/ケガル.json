        "examples": {
          "standard": [
            {
              "text": "この行為によって伝統が汚った",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "聖地を汚ることはあってはならない",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "名誉が汚ることを恐れている",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "あわれ、何しに御身の膚に汚るべき。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の裏の汚るゝ遊びはせぬものぞと誡め置けるに、下界の土を踏みたがることよ。",
              "citation": {
                "source": "花枕",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "青衫又た馬蹄の塵に汚る月明今夜消魂客。",
              "citation": {
                "source": "夏の町",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "屍露だも汚るれば汝何等の恥辱ぞや！",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯く塵埃に其頭まみれ汚るゝ無慚なる　405姿眺めて、恩愛の母は白髮掻きむしり、美なる面※打棄てゝ聲を搾りて泣き叫ぶ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "高徳の聖殿も長く罪悪と居を共にする時は、ついには汚るるものに御座候。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "この精神こそは奈良朝で有名な光明皇后のみ心を動かしたものであって、「折りつればたぶさにけがるたてながら三世の仏に花たてまつる（三二）。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、為頼朝臣集に「折りつれば心もけがるもとながら今の仏にはな奉る」とあり、光明皇后の御詠として「わがために花は手折らじされどただ三世の諸仏の前にささげん」としたものもある。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
