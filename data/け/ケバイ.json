        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はもうこの人のあとさへついて行けばいいのだ。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西に向いて、また一峰を超え、やや下ってまた北に向って上る、霧の中で目標にする山もないから、手に磁石を放さない、何でも北へ向けばいいのだ、北へ、北へと歩む。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、生きて行けばいいんだ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "『そりゃね、だれも払わんとはいわんのだが、どういう手続きで持って行こうってんだね』『支払い伝票さえ書けばいいこっちゃありませんか』『つまり、退職しようというんだね』と、意地わるの後明人事係はいった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、三上が伝馬を盗んだとでも、何とでもいって、置けばいいじゃないか。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ取り次いでいただけばいいのです」ストキはやっぱりまじめに、急がず、何か相談でもしてるような調子で話した。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウしてゆけばいくら文法は間違っておっても、世の中の人が読んでくれる。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いったい、どこを、どう聞けばいいのか、私は困ってしまいます。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲劇を書けばいいんだろう、と僕が言ってやったら、たぬきは、いや羽衣だよ、と言う。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、まっすぐに追究して行けばいいのだ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロマンスの洪水の中に生育して来た私たちは、ただそのまま歩けばいいのである。",
              "citation": {
                "source": "一日の労苦",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうだ、この調子で書けばいいのだ。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、この調子で書けばいいのだ。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなの行く方へついて行けばいい、と云われるくらいだそうである。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで麓の亀もよちよち登って行けばいつかは鶴と同じ高さまで登れる。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、私には名文も美文も書けやしないのだから、くどくどと未練がましい申しわけを言うのはもうやめて、ただ「辞ハ達スル而已矣」という事だけを心掛けて、左顧も右眄もせずに書いて行けばいいのであろう。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は当惑して、「停車場や何か出来て、この辺は、すつかり変つて、高流には、どう行けばいいのか、わからなくなりました。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこをどう、聞けばいいのだ。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけ、覚えて置けばいいのでしょう。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "観念して、ただていねいにお辞儀しておけばいいのです。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "觀念して、ただていねいにお辭儀しておけばいいのです。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を書けばいいのか。",
              "citation": {
                "source": "小照",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらへ行けばいいのか！",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると蕈の形をした松林があるからね、そいつに入って行けばいゝんだ。",
              "citation": {
                "source": "車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よく目をつぶって行けばいゝさ。",
              "citation": {
                "source": "いてふの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐなかったらも少し追って行けばいゝ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "曇ってさへ居なかったら見当だけつけてぐんぐん本当のみちの方へ草をこいで行けばいゝんだが。",
              "citation": {
                "source": "柳沢",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすこまでさへ行けばいゝんだから。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年もご坊様、親子｜連の巡礼が間違えて入ったというで、はれ大変な、乞食を見たような者じゃというて、人命に代りはねえ、追かけて助けべえと、巡査様が三人、村の者が十二人、一組になってこれから押登って、やっと連れて戻ったくらいでがす。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えゝよ勘次さん、俺ら今日は日のうちから心持えゝんだから、先刻もおつうが揣つてやんべなんていふもんだから少しもやつてくろつて云つた處だよ、こんぢや二三日も過ぎたら勘次さんは又行けべえよ」お品は快よげにいつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
