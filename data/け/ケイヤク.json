        "動詞-サ変",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "contract",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "賃貸契約を結ぶ際は、内容をよく確認することが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はその会社と長期的な業務契約を交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "契約書にサインする前に、弁護士に相談した方が良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "）　――Ｙ、妾が契約の最期の営業を終えたときは夜も白々と明け渡っていたのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――妾はルーマニア人と契約しただけなのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は勇気を出して翌朝彼が提出した新しい契約を破棄してしまいました。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "契約期限切れは赤の他人だわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが政元は病気を時の人※だけで相談して、阿波の守護細川｜慈雲院の孫、細川｜讃岐守之勝の子息が器量骨柄も宜しいというので、摂州の守護代｜薬師寺与一を使者にして養子にする契約をしたのであった。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "この養子に契約した者も将軍より一字を貰って、細川六郎｜澄元と名乗った。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "澄元契約に使者に行った細川の被官の薬師寺与一というのは、一文不通の者であったが、天性正直で、弟の与二とともに無双の勇者で、淀の城に住し、今までも度魔法に凝り募って、種下らない者どもだ、と見えたに疑ない。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の間には彼等土木業者鉱夫の如きものの間にすら通有な、礼儀があり契約があり、若し之に背けば厳重な制裁を蒙る。",
              "citation": {
                "source": "侠客の種類",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、やっと、東京の三鷹村に、建築最中の小さい家を見つけることができて、それの完成ししだい、一か月二十四円で貸してもらえるように、家主と契約の証書交して、そろそろ移転の仕度をはじめた。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し柄がいいので、手元の苦しいところを思い切って契約してみると、二月三月も稼いでいるうちに、風邪が因で怪しい咳をするようになり、寝汗をかいたりした。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が何にも知らず、行き当りばったりに飛び込んで行った浅草の桂庵につれられて、二度目の目見えで、やっと契約を結んだ家は、そうした人生の一歩を踏み出そうとする彼女にとって、あまり好ましいものではなかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　気の早い銀子の父親が、話がきまるとすぐ東京へ飛び出して行き、向島の請地にまだ壁も乾かない新建ちの棟割を見つけて契約し、その日のうちに荷造りをしてトラックで運び出してしまい、千葉を引き払った銀子たちがそこへ落ち着いたのは、夜の八時ごろであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "今どき独身者の病人の家に、給金だけで永くゐる娘はないよ――遺産つきで女房の契約でもしてやらなけりや」　ちよつと皮肉にいつたが、すぐ素直な声になつて、「そんなことはどうでもいゝ。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とみは、ことしの秋になると、いまの会社との契約の期限が切れる、もうことし二十六にもなるし、この機会に役者をよそうと思う。",
              "citation": {
                "source": "花燭",
                "author": "燭をともして昼を継がむ。",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとの事は僕の意志継続と共に、君と契約したものは何んでも履行するさ」　わざと難かしい言葉を使い、はたに対して照れ臭いのを紛らかしています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに較べると西洋の都会と空の雇傭契約は大ざっぱだ。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲葉卯三郎が通訳長尾房之助を帯同、政庁を訪れると、ケノン少佐は移民法に接触してはならぬからと口頭契約で、人夫九百名、石工千名、人夫頭二十名、通訳二名、合計千九百二十二名の労働者の供給を申込んだ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "契約どおり病院はあった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう家へはいって、契約の勧誘をどしどし取ってくれれば、成績によっては、特別手当もだすさかいな、気張って契約とっとくなはれや」　十年前といまでは金の値打ちがちがうとはいえ、しかし、尋常を出ただけにしては、随分良い待遇だと君枝はびっくりしたが、その代り下足番の時とちがって、仕事はらくではなかった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでもないもののようだが、電話機ほど不潔になりやすいものはないと呑み込ませて、契約もとらねばならず、「おいでやす」と「まいどおおけに」だけでこと足りた下足番に比べて、気苦労が大変だった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、淘汰した者も全然ないわけではなく、たとえば、売上げ金費消の歴然たる者は、罪状明白なりとして馘首、最初の契約どおり保証金は没収した。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "『思ひ出』出版の契約が書肆と締結されたのもこの時である。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく試験に合格して、即座に契約が出来た。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "國法は個々の人民をして快適を得しめむがための契約で、亦復打算である。",
              "citation": {
                "source": "古い手帳から",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　丁度、モゴルの契約期間も満期になる頃だったので、リメイも彼を伴っての帰村を承知した。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それについて団長とけいやくしましょう。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "）このけい約書とひきかえに二百円おもらい下され度、その金で「あ」の字の旦那〔これはわたしの宿の主人です。",
              "citation": {
                "source": "温泉だより",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、おかみさんは、一｜週間のけい約をむすんでしまったんだ。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
