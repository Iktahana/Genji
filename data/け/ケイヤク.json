[
  {
    "uuid": "4e97da36-db00-5932-86ac-b48988efeffa",
    "entry": "契約",
    "reading": {
      "primary": "けいやく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
