        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "座敷仕切りはクルミの欄間、ヒバ並びにガンピの釣りづか、ケンポナシの廊下の縁ぶち。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も稲垣氏でさえ慶応義塾でピネオの文典とか、カッケンポスの万国史とかミッチェルの地理書とかいう位のものを読んだくらいのもので、発音は凡ていわゆる変則読みであった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後へチョェ・ボン・ケンポ（教務大師）、その次に法王、その後にはヨンジン・リンボチェ（法王の大教師）が付いて参ります。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、ジャンケン」　ジャンケンポンと、彼は子供の様にはしゃぎ始めるのだった。",
              "citation": {
                "source": "お勢登場",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
