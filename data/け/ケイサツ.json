[
  {
    "uuid": "47b8aa4a-13c4-5f65-946e-5d1f2a151f87",
    "entry": "警察",
    "reading": {
      "primary": "けいさつ",
      "alternatives": [
        "ケーサツ",
        "ケイサツ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
