        "examples": {
          "standard": [
            {
              "text": "日本はかつて、高度経済成長期と呼ばれる時代を経験した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その国は今、まさに経済成長期の真っ只中にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "経済成長期には、人々の生活様式が大きく変化した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ルポの内容は最近の女子大生は貞操観念がないとか、結婚相手を選ぶときは第一に経済力を重視するとか、高度経済成長期に生まれただけあって胸の発育がいいとか、言葉遣いが悪く社会常識がないとかいった何度も聞いたことがあるようなありふれたものばかりで退屈だった。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
