        "examples": {
          "standard": [
            {
              "text": "釣り糸の先に手作りの毛鉤を付け、渓流の岩陰を狙って投げ入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自室で鳥の羽や糸を使い、精巧な毛鉤を作るのが趣味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "魚の食いつきを良くするため、今日の天候に合わせた毛鉤を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "吾はたゞ　天にありとも　地にありとも※河野通雄が、刀佩き氏名よぶことを公より許されける祝ひにうけばりて　世に氏の名をよぶことを　許し給ひき。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "磨けばりっぱになりますから……。",
              "citation": {
                "source": "人間と湯沸かし",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
