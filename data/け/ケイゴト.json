          "literary": [
            {
              "text": "だから、能と所作事・景事との間にある程の違ひはない、と言うてよい。",
              "citation": {
                "source": "組踊り以前",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "景事全盛時代の色あげ。",
              "citation": {
                "source": "小栗判官論の計画",
                "author": "「餓鬼阿弥蘇生譚」終篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "三江戸の浄瑠璃類の初期には、必須条件として、一曲の中に必一場は欠かれなかつた――時としては二場・三場すら含むものもあつた――道行き景事は、中期には芸術化して、此部分ばかりを小謡同様に語ると言ふ流行さへ起した。",
              "citation": {
                "source": "叙景詩の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "又道行きぶりの所作――王朝末から明らかに見えて、江戸まで続いた劇的舞踊の一要素たる海道下り・景事の類の古い型――にかゝりさうな箇所もある。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
