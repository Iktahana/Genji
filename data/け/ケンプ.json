[
  {
    "uuid": "0a61aad5-14fe-5079-99cd-f9fc3dcef036",
    "entry": "絹布",
    "reading": {
      "primary": "けんぷ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
