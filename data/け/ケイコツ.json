[
  {
    "uuid": "61e9b3fa-e0d9-56dd-92cd-31eb4b7bd96a",
    "entry": "脛骨",
    "reading": {
      "primary": "けいこつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "tibia",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ランニング中に転倒し、脛骨を骨折してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "人間の下腿には、脛骨と腓骨の二つの骨がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "レントゲン写真で脛骨のひびが見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "左脛骨及｜左胸の諸肋骨は粉砕せられたり。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の脛骨と左側の全｜肋骨はひどく折れていた。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭蓋骨の破片の外に右の骼骨六枚、左の骼骨四枚、脊柱の中央部、肝臟、脾臟、腎臟、骨盤骨、左右の上膊骨、大腿骨、兩脚の脛骨、脚骨等があつた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十三｜糎という長い脛は比較的めずらしい方に属するばかりか、あなたの脛骨と腓骨の形が非常に美しい。",
              "citation": {
                "source": "大脳手術",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "脛骨の正面なんか純正双曲線をなしている”とね。",
              "citation": {
                "source": "大脳手術",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "間違つても脛骨の上にすゑてはならないさうである。",
              "citation": {
                "source": "癩院記録",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "其農夫は草の中に兎の脛骨の落ちてゐるのを見つけた。",
              "citation": {
                "source": "「ケルトの薄明」より",
                "author": "THE CELTIC TWILIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田千吉君が考古界六巻一号（明治三十九年十一月）において、常陸国小田村の古墳調査の報告中に掲げられた図を見ると、石室の一端に近く二個の頭蓋骨と下齶骨とを正しく並べ、他方に大髄骨脛骨等｜数多の遺骨を、薪を積みたる如く一所に並べて置いた有様が見える。",
              "citation": {
                "source": "火葬と大蔵",
                "author": "焼屍・洗骨・散骨の風俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばん痛いのが脛骨、それから胸骨、あとは似たり寄ったりだが、肋骨は皮一重の下にあるので、なにかと物が触る度に、ずうんと痛む。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸ばしたら二寸はあらうと思はれる真黒な太い毛が、脛骨の峯をさかひに渦を巻きながらひしめき合つてゐる。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニウジヤアシイにては人類の前頭骨に石鏃の立ちたる儘の物を發見し、チリのコピアポにては人類の第二の脊椎に石鏃の立ちたる儘の物を發見し、フランスのフヲンリヤルにては人類の脛骨に石鏃の立ちたる儘の物を發見したる事有り。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ヲ摸シタラント思ハルヽ土偶ニ鬚髯ヲ示シタルモノ無キ事、貝塚發見ノ人類脛骨極メテ※平ナル事、及ビ貝塚發見ノ人類顎骨齲齒ヲ有スル事ノ他、實物ニ付キテハ何事ヲモ知ル事能ハザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」のキャプション付きの図（fig55990_498.png、横110×縦591）入る］図‐498　先日大森の貝墟へ行った時、私は人間の脛骨の大きな破片を発見した。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはプロカの板状脛骨に於て指示された如く、六〇の指数を以て側面に平べったくなっていた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の日本人の脛骨の指数は、我々のと同じく七六である。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本の人間の脛骨は並外れに平たく、指数五〇・二という、記録された物の最低の一つである。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ある人々は、彼をもって不可思議な人物と見なし、決してだれもはいったことのない彼の室には、翼のついた砂時計が備えられ、十字に組み合わした脛骨や死人の頭蓋骨などが飾られていて、いかにも隠者の窖のようだと言った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」五　大酒のみにては不死の霊薬たらず　翌日太陽が西に傾いたころ、メーヌ大通りのまばらな行ききの者は、頭蓋骨や脛骨や涙などの描いてある古風な棺車の通行に対して、みな帽子をぬいだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
