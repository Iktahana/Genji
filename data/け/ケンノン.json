          "literary": [
            {
              "text": "とてもケンノンで見ていられないではないか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケンノンケンノン……不憫至極な事と思ったのであろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかし、そんなに神経を動揺さしたまま俺の前を立ち去るのは尚更ケンノンだ。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの赤玉の一粒に使ってある熱さましは、人間に使う分量の何層倍にも当るのだから、もし本当に利いたら心臓がシビレて死んで終う筈だ……どっちにしても今酒を呑むのはケンノンだから止めろと云って、私の手を押えました」「フーム。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キッピイの様子から相当ケンノンな事情が想像されたからである。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
