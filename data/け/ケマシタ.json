        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルト　ナミ　ハ、ヤマ　ノ　コドモ　ガ　ウミ　ニ　クルナンテ　ナマイキダ　ト　オコッテ、ヤマキチ　ヲ　ヒトマキ　マイテ　イワ　ノ　ウエ　ヘ　タタキツケマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　クルツト　コチラヲ　ムイテ　タキクンヲ　ヒザノ　上ニ　ノツケマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、オマエタチノ　オトウサンヤ　オカアサンタチハ　ヨク　コノ　バシヤノ　ゴオンヲ　ウケタノサ」　ソシテ　ソンチヨウサンハ　イヒツヅケマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　コドモノ　タヌキハ　ゲタニ　バケマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア　ナンノ　カゲダラウ」ト　モウ　ヒトリガ　クビヲ　カタムケマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "所ガ道子ハナオモ叫ボウトスルヨウダッタノデ、イキナリ彼女の顔ヘ斬リツケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ガ痛ミノ為ニ息ヲフキ返シタ時、私ハ叫バレテハイケヌト思イ膝デソノ顔ヲ押エツケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度ソノ時下カラ人ノ来ル足音ガシタノデ、私ハイソイデ立チ上リ、ナイフデ死ノウカドウシヨウカト迷ッテ居タノデス、清三ハ未ダ死ニ切レナカッタト見エ又起キ上リカケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙姫様は一千年の時を超えて響いてくるような声で私に語りかけます――「さあ、私の父の宮殿である、南の海の底にある龍宮城へ、ともに参りましょう」「イイエ、ワタシ、熊本ヘ帰ラネバナリマセン――サッキ電報カケマシタデス」と、私が応えます。",
              "citation": {
                "source": "手紙",
                "author": "一八九三年七月二二日付　チェンバレン　宛",
                "note": "青空文庫"
              }
            },
            {
              "text": "隆治さんから十九日に電報が来て、　イロイロノゴハイリヨアリガタクウケマシタゲンキニシユツパツ　とありそれを見たら涙が浮びました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ、草ノ葉ノカゲデ、セツセト縫物ヲシテヰタコホロギサンガミツケマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便配達ノダテウサンハ、キシヤヨリモハヤクカケテ、ソレヲ、モンコチヤンノオ家ヘトドケマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マケマシタ」と私（夫人）はいった。",
              "citation": {
                "source": "この頃の皇太子殿下",
                "author": "小泉信三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
