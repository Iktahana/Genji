        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "重要な文献に欠文が見つかり、研究が滞った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古代の書物には、欠文が多くて解読が難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この契約書、一部に欠文があるようですが？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ただ安世これを識り、〔以下欠文〕",
              "citation": {
                "source": "失うた帳面を記憶力で書き復した人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　柏軒の日記は十八日より二十八日に至る十一日間の闕文がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "殘餘の闕文は月字の上の三字で、わたくしは今これを讀んで「同年五月」となさむと欲する。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾來七八年して其女兒十四五歳になり、昨今の紅葉然と色付てきた時、其男復た同じ役目で、同じ所に宿つたとまで有て、跡は※が尻に留つた如く、闕文とは殘念だ。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「吾猶及」の三字を「私の幼時にはこんなことを聞いたこともある」と解するのに第一無理があるし、「史之闕文」と「有馬者云々」とを並べるのも変である。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "一説には、「闕文」は本章の文章に闕文があつたので、誰かがその二字を書いておいたのが、いつの間にか本文になつてしまつたといわれている。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○　本章の原文にカツコを附した部分は、もと闕文になつていたのを、学者が研究の結果補つたものである。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "茲に到りては既に草津（以下缺文）（明治三十年、作歌手帖より）",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「※」「残缺文」「歌合懐紙」など如何にも数が多くてどうにも見る気がしない。",
              "citation": {
                "source": "青べか日記",
                "author": "――吾が生活　し・さ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
