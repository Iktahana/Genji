        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "株主総会で新しい役員の選任が決議された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "国際連合で和平を求める決議が採択された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今日の会議で重要な方針が決議される予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "喋り好きの彼等が長時間討議し合ってやっと一つの決議が纒った。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二の決議が出来た。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこぶる激越の調子を帯びた決議文が成文された。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　この決議文を握らされてムッシュウ・ドュフランはキャフェを押出された。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この界隈の連合委員会の事業振興の決議案にもかかわらず、閑散とした取引市場をとりまいて、日一日と失業者と、彼らの飢えが生産余剰と反比例して街の広場に堆積して行った。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリコフでの国際革命作家拡大プレナムの決議は日本のプロレタリア文学運動が、シッカリと大衆の中に根を張り、国際的な連関において前進して行くために、もっとも重要な、さしあたって第一番に議題として我々が討議し、具体化しなければならない幾多の貴重な提案をなしている。",
              "citation": {
                "source": "農民文学の問題",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そのハリコフ会議の日本プロレタリア文学運動についての決議は、農民文学に関して「国内に大きな農民層を持つ日本にあっては、農民文学に対するプロレタリアートの影響を深化する運動が一層注意される必要がある。",
              "citation": {
                "source": "農民文学の問題",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは排日委員会で決議されたスローガンの一ツだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、おとなの居留民達は、出兵請求の決議にかけずりまわり、一ツ一ツ印を集め、懇願書を出して、折角やってきて貰ったなつかしい兵士が、自分達のちっぽけな家とはかけ離れた、工場や銀行の守備に赴くのを、はたして、ペテンにひっかゝったように、憤ろしく、意外に感じなかっただろうか？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにある日とんぼが来て今度蜘蛛を虫けら会の副会長にするといふみんなの決議をつたへました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにある日とんぼが来て今度蜘蛛を虫けら会の相談役にするというみんなの決議をつたえました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭司長や民の長老たちが、大祭司カヤパの中庭にこっそり集って、あの人を殺すことを決議したとか、私はそれを、きのう町の物売りから聞きました。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯くて長谷場純孝氏の提議にて討論終結の動議成立し、杉田議長採決を宣したるに出席總數三百四十五票中決議案を可とする者　百六十八票否とする者　　　　　百七十七票にて戰は僅々九票の差にて政府黨の勝利に歸し申候。",
              "citation": {
                "source": "雲間寸觀",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何となれば、各號は其當番が勝手にやる事に決議しありたればなり。",
              "citation": {
                "source": "消息",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "又革命の際に於て、議會の決議や法律の協定を待たなくても、勞働組合で總てをやつて行けばよいといふ論者もある。",
              "citation": {
                "source": "A LETTER FROM PRISON",
                "author": "‘V NAROD’ SERIES’",
                "note": "青空文庫"
              }
            },
            {
              "text": "（403）そしてこれまで民會の決議は立法であつたのに、今はすぐに行政になつた。",
              "citation": {
                "source": "古い手帳から",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、全く莫迦莫迦しいことに、王、副王以下各大酋長の決議で「サモア支配権を英国に委ねたい」旨を申出そうとしたのだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "己がこの市に来て住むことになつてから、評議員達は二度特別会議を開いて、左の重大な決議をした。",
              "citation": {
                "source": "十三時",
                "author": "THE DEVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "予がこの町に滞在してから、彼らは数回特別会議を開いて、次のような三か条の重大な決議をした。",
              "citation": {
                "source": "鐘塔の悪魔",
                "author": "THE DIVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "中学か大学の寄宿舎の出来事になつてゐるが、鉄拳制裁の決議の場面もある。",
              "citation": {
                "source": "塚越の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つの問題は通行人の膀胱の緊張を調節し緩和するためには、この都市にはあまり共同便所が少ない、この共同便所の少ないことは人間の居宅に近く放尿するといふ結果になるから至急政府に向つて共同便所増設の請願猛運動を起すことに決議された。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族院ヲ廢止シテ審議院ヲ置キ衆議院ノ決議ヲ審議セシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "審議院ハ一囘ヲ限リトシテ衆議院ノ決議ヲ拒否スルヲ得。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ歐米ノ革命的團體ハ大戰ノ遙ニ以前此レヲ以テ國際語トセント決議セシ程ノ者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日大臣相馬人を伴れて掛合に来ると、瓦師馬の教えのままに答えたから評定すると、諸臣一同この瓦師は大力あるらしいから足で牽かせたら莫大の金を取るだろう、いっそ一億金と定めるがよいと決議し王に白し、王それだけの金を遣わして馬を得、厩に入れて麦と草を与えると食わず。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、この政治的形勢の變化によりて、國家權力の命令や、政黨の決議によつて、チェホフの作品の藝術的價値が、一夜のうちに消えてなくなつてしまうであろうか？",
              "citation": {
                "source": "政治的價値と藝術的價値　マルクス主義文學理論の再吟味",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、この政治的形勢の変化によりて、国家権力の命令や、政党の決議によつて、チエホフの作品の芸術的価値が、一夜のうちに消えてなくなつてしまふであらうか？",
              "citation": {
                "source": "政治的価値と芸術的価値",
                "author": "マルクス主義文学理論の再吟味",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついては本会の光栄として、特に天覧に供するものがなくてはならないのですが、それについて、いろいろ協議の結果、濤川惣助氏の無線七宝の花瓶と、あなたの作の矮鶏とを出品中の主なるものとして陳列することに決議しましたから、どうかお作を出すことにして下さい。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "矮鶏の作が計らず展覧会に出品されたいきさつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには工場細胞が全力をあげて、それと工場独特の問題と結びつけて、宣伝、煽動をまき起すこと等が決議された。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビラを撒いてからの第二弾、第三弾の戦術、従業員大会開催の件などが、決議された。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
