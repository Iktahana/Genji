[
  {
    "uuid": "2661c647-2cd1-574a-bcc4-3e88b7fb0710",
    "entry": "血相",
    "reading": {
      "primary": "けっそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
