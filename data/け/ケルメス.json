        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ケルメス・エロイーク（女だけの都）」では、城囲みに逢ってうろたえまわる亭主どもを奥へおしこめ、女房たちだけの機略で敵の大将を思うように料理してしまう。",
              "citation": {
                "source": "うすゆき抄",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "私自身はむしろ、この激しいオランダ的祝祭ケルメスの中に、彼のフランドル的血統の印を認める。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶんケルメス祭の野外の見世物か何かのであろうが、大きな黄色い広告の旗がその畑の中に風にひるがえっていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
