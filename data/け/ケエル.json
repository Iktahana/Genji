    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さっき左内坂で新手の駕籠が奪い乗せるように秀の浦をさらっていったと聞いたときから、おそらく無事なからだじゃけえるめえと思ったからこそ、こうして行火にぬくまりながら、騒ぎの起きるのを待ってたんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒色のくちびる",
                "note": "青空文庫"
              }
            },
            {
              "text": "八丁堀へけえるんだったら、そっちゃ方角ちげえですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうけえるんだよ」　唖然となって、ぱちくりやっている伝六を促しながら、じつに不思議です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "今さら愚痴をいったって、死んだものがけえるわけじゃねえが、なにもよりによって、おらがの辰を連れていかなくてもいいでしょう。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれは、跡をきれいにしてけえるから、おめえだちはさきへけえっとれ」　棺舁の姿が見えなくなると、李夫は脚下に置いてあった鋤を把って、今かけたばかりの棺の上の土を除けはじめた。",
              "citation": {
                "source": "断橋奇聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下へ、けえるがつかあ」「おうおうおう、涎を滴らして木へしがみついて居たのは誰だい」「それも、手前だろう」　旅人達は、一団になって、高声に話しながら降りて来た。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあ、けえるぜ」「何から何までお心添え、一生、未来、忘れることではありませぬ」「おいらも、おめえのことは、一刻も忘れねえつもりだ――しがねえからだだが、いつもいつも、うしろには、田圃の職人がついていると思って、存分にやってくんなよ」　闇太郎は、立ち上った。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "安心しねえよ――決して、わるいようにはしねえのだ――さあ、けえるうちはどこだ？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり可哀そうだし、けえる家もねえようなので、よんどころなく軒別に、宿屋を叩いて、その雪之丞を探しているんだ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれ何かいただきたいものがあれば、改めて、いい時刻にひとりでうかがって、黙っていただいてけえるから――と、ね。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かう甘く見えたつて、七転び以上なンだよ、一転びの苦労もなめた事がないくせに、一かどの苦労をしよつた気の女が多いンだから、全く呆れけえるだわ、ねえ、勘ちやんさうは思はないかい？",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼すっかりアキレ返り、「ヤクザだなあ、俺はけえる！",
              "citation": {
                "source": "御存与太話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきへけえるぞううっ！",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来なかで卒中でぶッくらけえるにしても、和服じゃ態が悪かろうというんだがネ。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "やくたいもねえいのちの使いかたをしちゃアならん」　といって、竿を肩にひっかつぐと、「じゃ、おれはこれでけえるぜ」「阿古十郎さん、なんとかひとつ手を貸して……」　顎十郎は、にべもなく袖をふり払って、「じょうだんいうな、おれなんぞのでる幕じゃない。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "鎌いたち",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日けえるのか、あいよ。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "けえるんならお菓子を貰ってけえりな。",
              "citation": {
                "source": "少年",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜はぬけるのが早かっただ」と幸山船長はしゃがれ声で云った、「おらもう捕ったからけえるとこだよ」　それから人恋しげな口ぶりで、問いかけるように云った、「いっしょに船へ来ねえかね」　私は倉なあこを見たが、彼は黙って次の仕掛をやっていた。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい師匠、どこへゆくんだ」とうしろで声がした、「うちへけえるんじゃあねえのか」　彼は立停って振り返り、よろよろした。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
