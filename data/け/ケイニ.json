[
  {
    "uuid": "66c4d335-4610-54a8-87d5-bc7322644552",
    "entry": "径二",
    "reading": {
      "primary": "けいに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
