        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "棄躯輕似葉　　棄躯軽きこと葉に似、不復覺浮沈　　また浮沈を覚えず。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶成世上毀譽輕似塵。",
              "citation": {
                "source": "遺篇",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
