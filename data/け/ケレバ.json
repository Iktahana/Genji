        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十秒三、デモナケレバ、五デモナイ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼失ワズ　ケサ、六時、林房雄氏ノ一文、読ンデ、私カカナケレバナルマイト存ジマシタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二タス二ガ四ニ相等シイのと同じように「隊長ハ鶏ノスキ焼キガ食ベタイ」「二人ハ鶏ノ徴発ニ赴カネバナラヌ」「徴発出来ナケレバ半殺シニナル」という三つの意味は相等しいのである。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ上ルノニ、トチュウデ何ンベンモヤスンデ、イキヲ入レナケレバナラナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オヽ、頼モシキ思想ノ持主ヨ、新日本ノ後継者ハ立派ニ新シイ騎士道ヲ樹立セナケレバナランノダ、女学生ト附キ合ツテ Girl-shy（助平心）ヲ起スヨウナ習慣ハ少年ノウチカラ彼女等トノ交遊ニヨツテ振リ棄テルヨウニシナケレバナランノダ。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コレカラソノ論証ヲシナケレバナラヌガ、アマリ十分ナ紙幅ガナイカラ箇条書ニシゴク簡単ニ書ク。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在カタカナガ一般ニ使ワレテイルノハ数学書、法律書、官報、軍関係ノ書類ナドデアルト思ウガ、イズレモ最モ正確ヲ期セナケレバナラヌ種類ノモノバカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "古人ノ語ニ、一身ヲ自由ニシテ自ラ守ルハ、万人ニ具ハリタル天性ニシテ、人情ニ近ケレバ、家財富貴ヲ保ツヨリモ重キコトナリト。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「信長記」に、信長卿ハ清水寺ニ｜在々ケルガ、於二洛中洛外一上下ミダリガハシキ輩アラバ一銭切リト御定有ツテ、則柴田修理亮、坂井右近将監、森三左衛門尉、蜂屋兵庫頭、彼等四人被仰付ケレバ、則制札ヲゾ出シケル云々。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「信長記」に、信長卿ハ清水寺ニ在々ケルガ、於洛中洛外上下ミダリガハシキ輩アラバ一銭切リト御定有ツテ、則柴田修理亮、坂井右近将監、森三左衛門尉、蜂屋兵庫頭、彼等四人被仰付ケレバ、則制札ヲゾ出シケル云々。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モシオ前ガ何カ他人ノ物ヲコワシタトキニハ、オ前ハドウシナケレバナランカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ此ノママ一息ニ殺シタノデハ気ガスマヌカラ嬲リ殺シニシテヤラナケレバト思イ、彼女ガ気ヲ失ッテ居ルノヲ幸イ、素早ク腰紐ヲトッテ道子ヲ後手ニ縛リ上ゲタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシコノ注意ヲ守ラナケレバ、現代ノ世界人類ハ最大ノ不幸ニオチイルデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "深イ注意ヲモッテカカル人間ニ対シ適当ナ電波的保護ヲ急グノデナケレバ、世ノ中ニハ「手ニオエナイ神経病者」トイワレルモノガ年ト共ニ激増スルデアロウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "美人ノ眼ガ僅カ一度傾ケバタチマチ醜人ト化シ、醜人ノ唇僅カ一｜糎短カケレバ美人ト化スト云ッタ塩梅デアル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "左ハ言ヘ古器ヲ玩ブハ他ノ学事ト同ジカラザレバ、古刹ノ僧侶ガ霊宝ノ伝来ヲ説クガ如ク、附会ノ説ヲ喋々スルハ甚ダ煩ハシケレバ、考証ハ固ヨリ有用ナレド、務メテ雅致ヲ失ハズ、空シク理窟ニノミ流レザルヲ可トス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "況テ宝器什物ノ有ル可キ様無ケレバ、必ズ曝サネバナラヌト云フコトモ無ケレド、午熱烈シキ比快キ風ノ吹キ入ルヽ小楼ニ、独リ古キ櫃ドモ取出デヽ、手ニ触ルヽ物ヲ列ラネ曝ス程面白キコトハ有ラジ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ文詞モ面白ケレバ、後日花月新誌ニ載セテ世ニ公ス可シ。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "数多ケレバ二品ヲ記ス。",
              "citation": {
                "source": "土用干ノ記",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ之ニ書送リケレバ、早速ニ山口ノ砦を出来リ候。",
              "citation": {
                "source": "手紙",
                "author": "慶応元年九月七日　坂本権平、乙女、おやべあて",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅政友氏は「漢籍倭人考」投馬國の條に不彌國ヨリ南ニ向ヒテ進ミ行クコト二十日ノ後ニ、投馬國ニハイタルトノ義ナレバ、必ズ内海ニハアラズ、豐前豐後ノ東洋ヲ經テ、日向アタリ所謂投馬國ナラント覺シケレバ、本居翁ノ説オホカタハ違ハサルベシ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "狗奴國に就きては、『外交繹史』に菅氏云、大隅ヨリ南ニハ、種子屋久ナドイフサヽヤカナル島々ハアレド、共ニ攻撃スル程ノ國無ケレバ、此狗奴國ハ、モト下ノ「女王國東、渡海千餘里、復有國、皆倭種」トアル地ノ内ナルヲ、陳壽ガ、東ヲ南ト誤リタルナラン。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "此等ノ説、イト巧ニハ辨ゼラレタレドモ、想像ニ成レル事多クテ、確證少ケレバ、慥ナル事ハ知リ難シ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今一刃ヲ加フ、但シ刃長ケレバ則チ棒頭力無シ、他ノ棒ヲ圧スルコト能ハズ、只二寸ヲ可トス、形｜鴨嘴ノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
