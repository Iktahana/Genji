        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただちに軽艇に移りて本船に帰る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "四山環翠、一水澄碧の湖上に輕艇を駛らすれば、凉風｜面を撲つて、白波ふなばたに碎くるさま、もとより爽快の好い心持である。",
              "citation": {
                "source": "華嚴瀧",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
