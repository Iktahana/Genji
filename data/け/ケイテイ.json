        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一説に狩谷｜矩之が本所横川の津軽邸より上野広小路に移つたのは、明治五六年であつたと云ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "又矩之は本所の津軽邸内に蟄してゐたのに、従之は昔望之の住んだ湯島を距ること遠からぬ神田明神前に門戸を張つて画師をしてゐたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
