        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "センサウノ　タメニ　ワタクシタチハ　ハタケヲ　アラサレ、タベル　モノハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンキヲ　ダシテ、フミアラサレタ　ハタケヲ　タガヤシ、ムギノ　タネヲ　マキマシヨウ」ト　ヲトコハ　ヒトビトニ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イタチダケヲ　ヨバナイト　イタチハ　キツト　オコルニ　チガヒ　アリマセン。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナハ君チャンニワケヲキイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、活字ダケヲカタカナニスレバヨイトイウノダ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンソクガヘリノ　　　一ネンセイムギノホ　バタケヲ　　　トホリマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ予ノタメニ腸ダケヲ残シテオクノガ習慣ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局コルセットハ止メルコトニシ、滑リ台ニ寝テ頸ノ牽引ダケヲスルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ日ノ午後二時頃、予ガ寝室デ午睡カラ覚メ、マダボンヤリトベッドノ中デ眼ヲ開ケテイタ時、突然浴室ノ戸カラ颯子ガ首ダケヲ此方ヘ出シテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デ、已ムヲ得ズ、隠居所ダケヲ新築スル積リダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "油谷ノ嫁ノコトヲオシャベリダナンテ云ウガ、彼女モオシャベリデハ引ケヲ取ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "川勝氏ノ著書ニ依ッテ仕込マレタ石像美術ノ知識ダケヲ物識リ顔ニ披露シタニ過ギナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ黙ッテ血壓ダケヲ測ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ自分ノ欲スル※ダケヲ要求スル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また尾張の連等の祖先のオホシの連の妹のメコの郎女と結婚してお生みになつた御子はヒロクニオシタケカナヒの命・タケヲヒロクニオシタテの命のお二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にタケヲヒロクニオシタテの命も天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣化天皇　弟のタケヲヒロクニオシタテの命（宣化天皇）、大和の檜隈の廬入野の宮においでになつて、天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
