        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "またこの「毛唐」がギリシアの「海の化けもの」〔ke`tos〕 に通じ、「けだもの」、「気疎い」にも縁がなくはない。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "直射光線が気疎い回折光線にうつろいはじめる。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "気疎い睡気のようなものが私の頭を誘うまで静かな海の暗を見入っていた。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "慵い体を木蔭のベンチに腰かけて、袂から甘納豆を撮んではそっと食べていると、池の向うの柳の蔭に人影が夢のように動いて、気疎い楽隊や囃の音、騒々しい銅鑼のようなものの響きが、重い濁った空気を伝わって来た。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」お庄は外の方を見ていながら、気疎いような返辞をした。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴしゃぴしゃと気疎い草鞋の音を立てて、往来を通る者がたまさかにあるばかりで、この季節の賑い立った様子は何処にも見られなかった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりにかけ離れた、世間の外の気疎い庭。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "気疎い顔に、まぢ／＼と日を暮す、日なたぼこりの年よりの姿が、目の先に来る。",
              "citation": {
                "source": "山のことぶれ",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "気疎いアロイヂオになつてしまつて……。",
              "citation": {
                "source": "詩集夏花",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄夫は困つて気疎い面魂をして、詮方なしに夕映えのする竹藪の景色を眺めた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ、中学にゆけるんじゃなし、四年を卒業したらはやく何処かの工場に出て、おあしをとらなければならぬと思っている私には、そんなことはまったく、気疎い話であった。",
              "citation": {
                "source": "戦争雑記",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝は外を通ってる人の声を聞いても時々｜気疎いことがありますぞな。",
              "citation": {
                "source": "入江のほとり",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "時おり雲間を洩れる、信濃の高原――安曇の青野は、この日頃、かどかどしさと暗さに馴れた眼には、まったく別種の、気疎いほどのどやかな世界に見える。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒らに正確な懸時計は遠慮なくけうとい音に時を刻んでゐた。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どことも知れず、あの昼にはけうとい羽色を持った烏の声が勇ましく聞こえだす。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒物屋を兼ねた居酒屋らしい一軒から食物の香と男女のふざけ返った濁声がもれる外には、真直な家並は廃村のように寒さの前にちぢこまって、電信柱だけが、けうとい唸りを立てていた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　やがてけうとい雨の暗くたそがれて行く夕方を、おくみはすつかりの雨戸を閉めかけたとき、お湯から帰つて入らつした青木さんにかう言つた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はけうとい目つきで、かくも無遠慮にやっつけられているけばけばしい婦人をながめていたが、やがてまもなく事のなんたるやに考え及んだ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスコーリニコフはけうとい緊張した目つきで、凝視を続けていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザミョートフはけうとい目つきで彼の顔を見ると、布きれにまがうばかり真っ青になった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてしばらくの間、まるで娘が誰かわからないように、けうとい視線をじっとすえながら、その顔を見つめていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は人類全体の苦痛の前に頭を下げたのだ」彼はなんとなくけうとい声で言い、窓の方へ離れた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "」恐怖のあまり氷のようになり、けうとい目つきで相手を見つめながら、彼女はこう尋ねた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちっとはよくなるかもしれません……」　ポルフィーリイの驚愕と介抱ぶりがあまり自然らしかったので、ラスコーリニコフは思わず口をつぐんで、けうとい好奇の表情で彼をじろじろ見回した。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから彼は片隅に立ったまま、けうとい目つきでニコライをながめているラスコーリニコフをちらと見て、その方へ足を向けようとしたが、急にまた立ち止まり、彼を見やったと思うと、すぐさま視線をニコライの方へ移した。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はたちまち一歩後ろへよろけて、けうとい目つきでスヴィドリガイロフを見つめた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥーニャは拳銃をおろして、恐怖というよりも、何かしらけうとい疑惑の表情で、スヴィドリガイロフをみつめていた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
