        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ホーホケキョ」「あ、鶯かしら」　雀が二羽｜檜葉を揺すって、転がるように青木の蔭へかくれた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホーホケキョ」　口笛だ。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度はホーホケキョとやる、（これは自分の名の暗號であつた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホーホケキョ、ホーホケキョ」「オヤ、鶯がやって来たな。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに隠れてまっていてやろう」「ホーホケキョ、ホーホケキョ、ケキョ、ケキョ、ケキョ、ケキョ、ケキョ」　と言ううちに鶯は、斑のいる梅の木のすぐそばにある梅の花のたくさん開いたほそい枝の処へ、ヒョイととまりました。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホーホケキョ、ホーホケキョ」　と鶯は隣のうちの梅の木で鳴いていました。",
              "citation": {
                "source": "梅のにおい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がホウヽホケキョとやると、隣の家のほうでもホウヽホケキョとやる。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホウ、ホケキョ――ケキョ。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに清もいつの間にか上手になって、「ケキョ、ケキョ、ホーケッキョ」とそんな風なところまで漕ぎつけるようになって来た。",
              "citation": {
                "source": "比叡",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前も一つやってみないか」　定雄は笑いながら千枝子にそう云って、「ホー、ホケキョ、ホー、ホケキョ」とやるのであった。",
              "citation": {
                "source": "比叡",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホー、ケキョケキョ、ホー、ケキョケキョ」と清は窓にしがみついたまままだ笛を吹きつづけていた。",
              "citation": {
                "source": "比叡",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
