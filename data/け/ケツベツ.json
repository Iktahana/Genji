    "definitions": [
      {
        "index": 1,
        "gloss": "separation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は長年の友と、ついに決別する道を選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "甘い自分と決別し、新しい人生を歩む決意をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "政治家は、過去の過ちと決別すべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし紙の冊子との決別を狙っている点では、私がＤＴＰの延長線上に見ようとしたものと明らかに繋がっていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "今回の危機に対して無力を露呈する点では同じであったにしても、軍事との決別を目指して無力だったのか、軍事への回帰を目指して無力だったのか、少なくともこのオレははっきりと覚えておくからな。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "網羅的な知識の収拾とは決別して物理学の手法を持ち込むことで、この新しい学問はいったん「単純な生命の謎をきれいに解く」と宣言した。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "決別したはずの網羅主義に、再びはまり込んだのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでの何と決別し、何を始められるのか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "株式の名義人は星の関係者に押さえられていたことから、西は『Ｉ／Ｏ』と決別する覚悟を決めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "東大法学部に進んで司法試験を目指していた兄のようにエリートコースを進んでほしいとの両親の願いとは、このときを境に決別することになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "情報処理事業グループは、従来の常識に決別したマシンの開発の歯車を、常軌を逸したすさまじい勢いで回しつつあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月末まで、ほぼ週一回のペースで進められてきたアプリケーションの供給経路に関する検討の結果は、オフィスコンピューターの流儀からの決別だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣ―９８０１は松本にとって、すでに決別した過去だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭがいったんは決別したはずのＡＴに舞い戻り、しかもこの土俵を捨てる大きな要因となった互換機勢力と手を組んで日本市場に突破口を開こうとするＤＯＳ／Ｖは、痛みを伴う決断を日本ＩＢＭに求めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "口論の末、祖父母との永遠の決別となった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "一瞬ラルフのことを思い浮かべたが、きっぱり決別した。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "コプリを叩きのめして支配から逃れるか、邸宅から追い出され、永遠に決別するかだ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが短歌より出て来たものだとしても、既に短歌と訣別して、新しい領土に立つてゐることも恐らく間違ひない。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれを、青春への訣別の辞として、誰にも媚びずに書きたかった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古典的秩序へのあこがれやら、訣別やら、何もかも、みんなもらって、ひっくるめて、そのまま歩く。",
              "citation": {
                "source": "一日の労苦",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはたぶん横浜岸壁あたりで訣別の色テープの束の美しさを見て来てから考えたものらしい。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、その名城の傍の温泉も、永遠に淳朴の気風を失ふ事は無いであらうと、ちかごろの言葉で言へば「希望的観測」を試みて、私はこの愛する弘前城と訣別する事にしよう。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母が世の常の母であり、わたくしが以前のわたくしなら、むろんこう告白して、父｜歿き後は親一人子一人である母に向って理解されないまでも自分の口ずから訣別の印をしましたことでしょう。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はただ今後書いて行くだろう小説の可能性に関しては、一行の虚構も毛嫌いする日本の伝統的小説とはっきり訣別する必要があると思うのだ。",
              "citation": {
                "source": "可能性の文学",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "タイトルは「ホビーとの訣別」。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "創刊号の巻頭言をまとめようと原稿用紙に向かった西は、まず「ホビーとの訣別」というタイトルでます目を埋めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "創刊号巻頭の「ホビーとの訣別」と題した新雑誌の志を述べた一文は、西の手になるものだろう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが一方で「マシンがどうあるべきか」との問い掛けがこの世界全体において意味を失い、もう一方でマイクロソフトとの訣別がアスキーから未来を選択する力を奪ってしまう中で、かつて巻頭言で謳い上げた主体性は、気がつけば彼ら三人のてのひらから砂のようにこぼれ落ちていた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬも生くるも一所ぢやとは訣別の詞である。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は自分の過去に訣別しようとしてゐた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、今の君にも僕らの時のやうな、ほんたうに過去への訣別をうながすやうな情熱といふものがあるといふのかね。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、全サモア人への訣別の辞を認めて、マターファに渡した。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の訣別の辞は悲しいものであった。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
