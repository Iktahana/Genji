[
  {
    "uuid": "12df0f2c-1e1d-56b4-bbc3-8579d94ee17e",
    "entry": "懸河",
    "reading": {
      "primary": "けんが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
