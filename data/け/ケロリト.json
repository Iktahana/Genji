        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三四日前から風邪をひいていた子供に、売薬をアテがって、出発の日までにはいつものようにケロリト癒ると思っていたのが、三日めごろから熱が急にたかくなって、手足から首へかけて紅い斑点がいっぱいにふき出してきた。",
              "citation": {
                "source": "冬枯れ",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "欣二　……（ケロリトした調子で）お父さんだってヘドを吐くじゃありませんか。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ泣キ声ヲ出スウチハ何モシタゲナイワヨ」「ジャア泣クノヲ止メル」予ハイツモノ予ニナッテ、ケロリトシテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
