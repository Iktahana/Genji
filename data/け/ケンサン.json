  {
    "uuid": "758fb27c-f15b-5678-8bc5-ecd357fbe54b",
    "entry": "県産",
    "reading": {
      "primary": "けんさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
