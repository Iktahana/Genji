        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はまたスイッチをひねって、電燈を消し、お父上の外国土産の生地で作ったビロードのコートを脱ぎ、帯だけほどいて着物のままでお床へはいった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは新聞の事件でないゆえ、それだけほんとうの事件であった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "細長い、長屋のように積重ねられて行く薪は、背丈けほどの高さになった。",
              "citation": {
                "source": "鍬と鎌の五月",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで僕は、春の日ののどかな光が油のような海面に融けほとんど漣も立たぬ中を船の船首が心地よい音をさせて水を切って進行するにつれて、霞たなびく島々を迎えては送り、右舷左舷の景色をながめていた。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、これはひどい難儀をして大へんな手数をしてそれから命がけほど頭を痛くして取って来たんだ。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばくてりやが生活するところには、病人の皮膚をすかすやうに、べにいろの光線がうすくさしこんで、その部分だけほんのりとしてみえ、じつに、じつに、かなしみたへがたく見える。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂敷へ包んでサドルの後ろへ結えつけて戻って来たら、擦れとりましてな、これだけほどになっとった」　兄はその手つきをして見せた。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、見かけほど悲劇的な性格もなく、どこかのん気で愚なところがあつて、情操的にものを突き詰めては考へられなく、萍の浮いたところがあつた。",
              "citation": {
                "source": "過去世",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "延び延びて、私の脊丈けほどに延びたが、いっこうにまだ花が出そうにも見えない。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にはこの説がどれだけほんとうだかわからない。",
              "citation": {
                "source": "簔虫と蜘蛛",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "書くならばできるだけほんとうの径路を科学的に書く事によってすべての人の頭の奥に潜む罪の胚子に警告を与えるようなものにしたい。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「のりつけほうほう、ほうほう、」――梟鳴く。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「のりつけほうほう」――老仕丁　のりつけほうほう。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あやしき神の御声じゃ、のりつけほうほう。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「のりつけほう。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――のりつけほうほう、ほう。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」次第に村人ら皆｜憑らる――「のりつけほうほう。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――思わず袂をふるい、腰を刎ねて）ほう、ほう、のりつけ、のりつけほう。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ほうほうのりつけほうほう――と鳴きつつ来る。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人がいなければつけない裳を言いわけほどにでも女たちがつけておりますから、主人である女が一人いるに違いございません。",
              "citation": {
                "source": "源氏物語",
                "author": "夕顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "とだけほのかに書かれたらしい。",
              "citation": {
                "source": "源氏物語",
                "author": "蛍",
                "note": "青空文庫"
              }
            },
            {
              "text": "山は、見かけほど近くはありませんでした。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は夢中でショールとボアとをかなぐり捨て、もどかしげに帯だけほどくと、髪も解かずに寝台の上に倒れかかって、横になったまま羽根｜枕を両手でひしと抱いて顔を伏せた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とほつあふみ浜名の郡日はぬくし坊瀬越え来てここは白須賀おなじ冬おなじ蔀の日のあたり白須賀はよし古りし白須賀ここ過ぎてなにか現のけほどさよ物はたく音も立ちて止みたる富士五湖昭和七年、妻子と共に晩秋の富士五湖に遊ぶ。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごろすけほう、ごろすけほうこう、むだぼうこう。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜、小田原なぞはほとんど全部があとかたもなく焼けほろびてしまいました。",
              "citation": {
                "source": "大震火災記",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいつ、見かけほどトロくはないんだな。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「むかしの金貨が、うずめてあるというので、ほれるだけほってみたんだろうね。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
