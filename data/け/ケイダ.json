          "literary": [
            {
              "text": "提督は、ゲビスのそばに進みよって、その肩を軽打した。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルデル博士に情のこもった軽打をされると、その刹那に朝子の心には悲しそうに伏目になって唇の両端を拇指と薬指とで押えるようにしている父親の親愛な表情が泛んだ。",
              "citation": {
                "source": "おもかげ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と愛撫するように扉のあたりを軽打した。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "謝肉祭の支那服　――地中海避寒地の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜僧侶の誦経にまざって、急激な軽打とも鳴音ともいう可きものを聞いた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
