[
  {
    "uuid": "474104b3-be31-51e6-be5b-921b80828fea",
    "entry": "慳貪",
    "reading": {
      "primary": "けんどん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さ、早くお寢なさいまし」　さういふ突慳貪な聲を聞かされると、行夫はすつかり眼を覺してしまふだらう。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見突慳貪にも見えるけれど、実は寧ろ気が弱い迄に見解の博い人である。",
              "citation": {
                "source": "萩原朔太郎評論集　無からの抗争",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と突慳貪なように云った。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（何や、）と一ツ突慳貪に云って睨みつけたが、低声で、若いのが何か口上を云うのを、フーフーと鼻で呼吸をしながら、目を瞑って、真仰向けに聞いたもんです。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時母が父にも怒を移して慳貪に口をきいたことをも思い出し、父のこと母のこと、それからそれへと思を聯ね、果は親子の愛、兄弟の愛、夫婦の愛などいうことにまで考え込んで、これまでに知らない深い人情の秘密に触れたような気にもなった。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何しに来たの」と母は突慳貪に一言。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから谷の深い処には細かなうすぐろい灌木がぎっしり生えて光を通すことさえも慳貪そうに見えました。",
              "citation": {
                "source": "マグノリアの木",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "實際私は弟達に對して隨分突慳貪であつた。",
              "citation": {
                "source": "矛盾の樣な眞實",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "世には大なる福分を有しながら慳貪鄙吝の性癖のために、少しも分福の行爲に出でないで、憂は他人に分つとも、好い事は一人で占めようといふが如き人物もある。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時に何なんですかと突っ慳貪に言って自分の顔を見る細君などはたまらないではありませんか。",
              "citation": {
                "source": "源氏物語",
                "author": "帚木",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな乱暴で理不尽な苛立ちを突っ慳貪にぶつけられても、普段の落ち着きとはほど遠いので、心がひどく乱れていると思わざるを得ない。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と慳貪に呼掛けた。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と慳貪に逐っぱらわれ、彼女も度を失い、すごすご台所へ立って行くのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに来て働く女中たちを一人一人｜突慳貪にきびしくたしなめた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乳首食いちぎるに」　妻は慳貪にこういって、懐から塩煎餅を三枚出して、ぽりぽりと噛みくだいては赤坊の口にあてがった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "口が干上るんだあぞ俺がのは」　仁右衛門は突慳貪にこういい放った。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆んな迷惑するだ」　いかにも突慳貪にその声はほざかれた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　喜平は突慳貪に言って、冷めかけた紅茶をいっきに飲み干した。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」渠は慳貪に答へて、自分の落ち度をいそがしい執筆と病氣との理由に押し消さうとするのであつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "機先を制せられて、張り詰めてゐた反抗心は失つたが、再び慳貪に、「連れて行かうが行くまいが、おれの勝手だ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "」聲はなか／＼慳貪であつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中はつんとしたように皿を式台の上に置くと、「おたべよ」と突慳貪にいって、少し身を退き、立ったまま流しめに二人の方を見おろしていた。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と船頭の武助さんは、突慳貪にいつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と検事は、それと創紋との間に起った矛盾に、愕然とした様子だったけれども、法水は依然熊城から眼を離さず、突慳貪に云い放った。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、そんな事はてんで存じません」と普光尼は、いきなり突慳貪に云い放って、ふと首を向け変え夜具の襟に埋めてしまった。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「夾竹桃がたくさんあるじゃないの」　私は、わざと、つっけんどんな口調で言った。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が手ぼうでせえなくば、おなじ車に結えるちゅうて、こう、けんどんに、倒にゃ縛らねえだ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういつた時に、学校で何だか知らないけれど、私がものをいつても、快く返事をおしでなかつたり、拗ねたやうな、けんどんなやうな、おもしろくない言をおかけであるのを、いつでも情いと思ひ／＼して居たのを考へ出して、少し欝いで来て俯向いた。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の胴間でけんどん箱から食品を取り出して膳に配置したり、箱火鉢の銅壺に徳利を浸したりしていたおきみは、あとを船頭に任して表の間へ膳を運んで来ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからあたしだって、おとうさまのことなんか、一度だって考えてあげたことなんかありやしないよ」　もしかしてこれで死んだって、二度とおとうさまのところへなぞ行く気はないと、母はつっけんどんに言いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
