  {
    "uuid": "ec4b8917-1f48-5538-82f0-1bc738e4f50c",
    "entry": "血海",
    "reading": {
      "primary": "けっかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
