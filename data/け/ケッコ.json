        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "みんなに知らせてやろう」「みんなに知らせてやろう」と、コウモリは、チーチー鳴き、メンドリはコッコと鳴き、オンドリはコケッコ、コケッコと鳴きました。",
              "citation": {
                "source": "ほんとにそのとおり！",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてはほんとに耳が潰れたかと思っていますと、そのうちに、「コケッコーコーオ」　と一番鶏の声がきこえました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺んとこのあの美しいケッコ　ケッコ鳴くのがほしんだろう……。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺んとこのあの美しいケッコ　ケッコ鳴くのがほしいんだろう……　壺井さんとこで、豆御飯をもらう。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コケッコッコ――、コッコッコ――。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コケッコーと啼くもいいが、啼いたら啼いたでお日様でも昇らせ、世間を明るくするがいいんだ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、鶏娘が沈み浮かび上がると、「コケッコッコ――」　――で、大変陽気なのであった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ケッコウシマス、テツヅキヨロシクタノム。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそうすると、村尾のいうケッコウとは何をいうのであろうか。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ケッコンシマス、テツヅキヨロシクタノム――。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は「へー」と云ったきりぼんやりして居るうち垣の外のにわとりはいいきみだと云うように「コケッコー」と云って一寸ふりかえってさっさとかえってしまった。",
              "citation": {
                "source": "三年前",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆々様オカワリナクテ、ケッコウデスネ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "地蔵さんが合図をしたので、婆は梁の上でコケッコーと鶏の啼く真似をした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "地蔵さんがまた指図をしたので、婆は再びコケッコーと鶏の啼く真似をしたら鬼どもは、もう二番鶏だと言いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "地蔵さんが三べん目の指図に婆がコケッコーとやると、鬼どもは、それ三番鶏だから夜が明けたと言って、みんなあわてふためいて金をたくさん置いたまま逃げ出して行った。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州のオッサン組と本ヨタ組は完全に没交渉であったが、私はどちらからも大事にされて、甚だケッコウな身分であった。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕に色々と話しかけ、エカキの卵だなどとデタラメなことを答えていると、誂え向き、ケッコウ、突然男は叫んで、葉書のような名刺をだし、明朝ぜひ訪ねてこい、金もうけの蔓がころがっていると言う。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕に色々と話しかけ、エカキの卵だなどゝデタラメなことを答へてゐると、誂へ向き、ケッコウ、突然男は叫んで、葉書のやうな名刺をだし、明朝ぜひ訪ねてこい、金もうけの蔓がころがつてゐると言ふ。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、黒いねこが泉水の近くを歩いていると、コケッコ、コケッコといって、泉水の中の金魚や、こいにも、注意をしたのであります。",
              "citation": {
                "source": "こいのぼりと鶏",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "与惣兵衛は頭の古い政治屋で、人間の真情より約束のほうを重くみる性だったから、もちろん、そんな違約を認めるわけはなく、アメリカジントケッコンスルコトユルサヌといってやると、折返して、「ナニジンナラヨイカ」という皮肉なことをいってきた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "与惣兵衛は腹をたてて、「ケッコンスルナ　フラチ　カンドウ」　と打ってやると、シヨウチシタ　サガシテミルという電報がきた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "Furachi が French になり、Cando が Canada になり、「ケッコンスルナラフレンチカナダ」としか読めない。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロバはヒヒン、犬はワンワン、ネコはニャオニャオ、オンドリはコケッコーとなきさけびました。",
              "citation": {
                "source": "ブレーメンの音楽師",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、オンドリも、このさわぎに目をさまして、横木の上から、「コケッコー。",
              "citation": {
                "source": "ブレーメンの音楽師",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "コケッコッコー金のじょうさまのおかえりだあ　女の子はうちのなかへはいって、おかあさんのところへいきました。",
              "citation": {
                "source": "ホレおばあさん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "コケッコッコーきたないじょうさまのおかえりだあ　このチャンは女の子のからだにこびりついてしまって、一生のあいだどうしてもとれませんでした。",
              "citation": {
                "source": "ホレおばあさん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
