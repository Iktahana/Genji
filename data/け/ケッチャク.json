[
  {
    "uuid": "8d7f8265-db63-5d80-86e3-a71d0815c7df",
    "entry": "決着",
    "reading": {
      "primary": "けっちゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
