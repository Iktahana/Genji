        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモマダミンナキマセンゴザイマス。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、タイヘンナ　コトニ、コゾウサンガ　ピント　ヒゲヲ　ハヤシテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシャハ氷デヒヤセト云ウケレドモ、氷ガカエナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場カラスコシオ金ガキタケレドモ、足リナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、アヒルサンノオカホヲゴランナサイ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、シカタガナイノデ、ソノ洋服ヲキテ、小サクナツテ学校ヘユキマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、ガマンシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オネコサンハ似合ヒモシナイ洋服ヲキテ得意デスシ、アヒルサンハアカダラケノクサイ洋服ヲキテ大ヨロコビナノデ、誰デモ二人ヲミルト、ワラツタリ、ハナヲツマンダリシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、フシギナコトガアレバ、アルモノデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ケレドモオマワリサンハ、「ウソデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、私ハコヽニヰナケレバナリマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ私ハ自分デヌフコトガデキマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、ミツカリマセンデシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オバアサンハヨイネコデスカラ、ケツシテコドモガドンナニヤカマシクシテモ、ドナリツケタリハイタシマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　イヂノワルイ　オサルサンガ、「ザウサンハ　タイヘン　オギヤウギガヨイトイッテ　ミンナガホメルケレドモ、バウシヲトルノニ　テデトラナイデ、ハナデトルデハナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ家ヲトビダシテ、アツチコツチヲアルキマシタケレドモ、ツカレテ、ダンダンネムクナリマシタノデ、自転車ニノツテ、ホテルヘユキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　イクラ　ガマンシテモ　ネムタクナルバカリデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　マイニチマイニチ　フタリハ　カウシテ　コウラヲ　ホシナガラ　ネムツテシマヒマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（５）豁然開朗ハ下ノ土地平曠ト連ラナリ、狹カリシ穴ヨリ廣々トシタル所ニ出タト解スル事誤リナケレドモ、客觀的ノ景色ヲ描クト共ニ、主觀的ナル漁夫ノ心理状態ノ一變シタル事ヲ含ム。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔時ハ禽獸ハ唯本能アリテ、智ハ唯人ニノミ存シテ本能ナシト云説ナリケレドモ、近世ノ發明ニテハ、禽獸ノ本能ハ、譬ヘバ書畫ヲ能クスル者ハ、臂ノ神經ニ其作用備ハリ、歌謠ヲ能クスル者ハ、喉ノ作用ニ其作用備ハルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "トダさんのお嬢さんと結婚いたしますこと、ご報告にあがりたかったのですケレドモ、あなたはご病気だそうで、今日まで遠慮しておりましたのです」　戸田の娘がどうしたというんだ。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モ番ニ行ッタケレドモ今年カラ田植エノ手伝イヲシタノデ腰ガ折レソーニ痛カッタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「オヤ、オカシイナ、ソツチノミミモ立テナサイ」トイヒマシタケレドモ、ウサギハシランカオシテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "笙篳篥ノヨウナモノヲ鳴ラサレルノハ迷惑ダケレドモ、誰カ一人、富山清琴ノヨウナ人ニ「残月」ヲ弾イテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長男ノ力ガ、マダ大学ノ二年生デ早過ギルノダケレドモ、恋人ガ出来テ結婚サセテクレト云ウノデ、許スコトニシタ、ガ、若イ二人ヲアパートナドニ別居サセテオクノハ不安デアルカラ、力ガ卒業シテ就職スルマデハ手許ニオイテ夫婦生活ヲサセヨウト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "附ケ目ニ乗ジテドウスルト云ウ資格モ実力モナイケレドモ、安心シテ美人ノ傍ニ寄ルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステージダンサーデモ幾分カソウナルケレドモ、アタシハ幸イニシテナラナカッタワ」浄吉ガ彼女ニ魅セラレタノハ彼女ノ姿態ニアルコトハ確カダガ、ロク／＼学校モ出テイナイノニ、頭モ悪クハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノブロンハ利クコトハ利クケレドモ、アトノ気持ガ不快デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
