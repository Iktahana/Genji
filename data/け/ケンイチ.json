[
  {
    "uuid": "4824cc2c-496e-5a87-bed8-60662561702a",
    "entry": "挙一",
    "reading": {
      "primary": "けんいち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "けれども彼の神経は、知らず／＼、妻の一挙一動に引きつけられた。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおぜいが車座になってこの新しい同棲者の一挙一動を好奇心に満たされて環視しているのであった。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでいて一挙一動がいかにも子供子供しているのである。",
              "citation": {
                "source": "ねずみと猫",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "親切であるために人の一挙一動は断えず注意深い目で四方から監視されている。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人の一挙一動は寒天のような濃厚な媒質を透して伝播するのである。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　熱帯魚（その二）　いろいろな熱帯魚をよく見ていると、種類によってやはり一挙一動にそれぞれの特徴があるように思われて来る。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "癪じゃ、第一、あの美人は、私が前へ目を着けて、その一挙一動を探って、兄じゃというのが情男なことまで貴公にいうてやった位でないかい。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この犬、一挙一動よく主婦の意を知る、今その座を立ったのを見ててっきり二階へ上るのだと目敏く先へ立って飛出したのであるが、段を六ツばかり駈上ると、振返って猶予って待っている風情。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の進むに従って、私たちの一挙一動がよく知れた。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫夫人などの感化を受けて、今では非常に柔らかな、繊細な美が一挙一動に現われ、化粧なども上手になって、不満足な気のするようなことは一つもないはなやかな美人になっていた。",
              "citation": {
                "source": "源氏物語",
                "author": "胡蝶",
                "note": "青空文庫"
              }
            },
            {
              "text": "お小姓は、女王様の一挙一動をみんな知っているべきだし、いっそ女王様の見張りをさえ勤めるべきものなんですよ」そこで声を低めて、彼は言い添えた、――「昼も、夜もね」「それは、どういう意味です？",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日続きのジガ蜂の一挙一動を観察するのにさへも私はひどく疲れた。",
              "citation": {
                "source": "ジガ蜂",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男の運動の間じゅう、扉の前に立ちつくしてまたたきもせず、男が監房へ帰ってからも胸騒ぎの容易に消ゆることのなかった太田は、その日から異常な注意をもってその男の一挙一動を観察するようになった。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三は高すぎるくらいの卓子に向かって、廻転椅子にかけながらペンを執っているのだが、姿の見えぬ彼女の一挙一動を感知しようとするもののように、耳を澄ましていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "木部はだんだん監視の目をもって葉子の一挙一動を注意するようになって来た。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日毎日凍りつくような濃霧の間を、東へ東へと心細く走り続ける小さな汽船の中の社会は、あらわには知れないながら、何かさびしい過去を持つらしい、妖艶な、若い葉子の一挙一動を、絶えず興味深くじっと見守るように見えた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此｜連中の一挙一動を演芸以上の興味を以て注意してゐた三四郎は、此時急に原口流の所作が羨ましくなつた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の客が二人出て来て泳ぎ廻っていますが、彼らの水中でやる所作が、一挙一動ことごとく手に取るように見えるので、芸としての水泳の価値が、だいぶ下落するようです。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗游于藝華時、妾挙一男二女。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "推するに霧渓二世瑞仙の所謂「嘗游于藝華時、妾挙一男二女、（中略）二女皆夭」の文中、妾と一男とは虚で、二女は実であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬のやうに、母を追うてゐる、母の一挙一動に悲しんだり欣んだりする青年の容子が、気の毒であつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのように、兄さんの一挙一動を心配する人から見たら、仰向けに寝そべったその時の私の姿は、少し呑気過ぎたかも知れません。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが好意となると、相手の所作が一挙一動ことごとく自分を目的にして働いてくるので、活物の自分にその一挙一動がことごとく応える。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この連中の一挙一動を演芸以上の興味をもって注意していた三四郎は、この時急に原口流の所作がうらやましくなった。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　此伯母さんの一挙一動が悉く雨の盛岡に調和して居る。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何なる新色彩を脚色の上に施さむとするか、看客は汗手して二人の一挙一動に凝視せり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬のように、母を追うている、母の一挙一動に悲しんだり欣んだりする青年の容子が、気の毒であった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "良沢の一挙一動が気になった。",
              "citation": {
                "source": "蘭学事始",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の一擧一動を慈愛をこめてまじろぎもせず見守る眼を運命の眼の外に彼等は持たないからだ。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "只容貌許りでなく、手古奈の一擧一動は悉く趣味である。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
