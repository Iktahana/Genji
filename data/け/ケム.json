        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "恐ろしい山恐ろしい山の相貌をみたまつ暗な夜空にけむりを吹きあげてゐるおほきな蜘蛛のやうな眼である。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "題のない歌南洋の日にやけた裸か女のやうに夏草の茂つてゐる波止場の向うへ　ふしぎな赤錆びた汽船がはひつてきたふはふはとした雲が白くたちのぼつて船員のすふ煙草のけむりがさびしがつてる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄生蟹のうた潮みづのつめたくながれて貝の齒はいたみに齲ばみ酢のやうに溶けてしまつたああここにはもはや友だちもない　戀もない渚にぬれて亡靈のやうな草を見てゐるその草の根はけむりのなかに白くかすんで春夜のなまぬるい戀びとの吐息のやうです。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "香爐のかなしいけむりのやうにそこはかとたちまよふ女性のやさしい匂ひをかんずる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄生蟹のうた潮みづのつめたくながれて貝の齒はいたみに齲ばみ酢のやうに溶けてしまつたああ　ここにはもはや友だちもない戀もない渚にぬれて亡靈のやうな草を見てゐるその草の根はけむりのなかに白くかすんで春夜のなまぬるい戀びとの吐息のやうです。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして乞食どものうろうろするどこかの遠い港の波止場で海草の焚けてる空のけむりでも眺めてゐよう。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんといふ怠惰な日だらう運命はあとからあとからとかげつてゆきさびしい病鬱は柳の葉かげにけむつてゐる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しぶきにけむれる岬岬の島かげからふしぎな病院船のかたちが現はれそれが沈沒した錨の纜をずるずると曳いてゐるではないか。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして海岸のけむつた柳のかげで首なし船のちらほらと往き通ふ帆でもながめてゐようあるいは波止場の垣にもたれて乞食共のする砂利場の賭博でもながめてゐよう。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつ暗な夜空にけむりを吹きあげてゐるおほきな蜘蛛のやうな眼である。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふはふはとした雲が白くたちのぼつて船員のすふ煙草のけむりがさびしがつてる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚にぬれて亡靈のやうな草を見てゐるその草の根はけむりのなかに白くかすんで春夜のなまぬるい戀びとの吐息のやうです。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凩のために朝から山があれて小屋のかけむしろがにぶくゆすられていた日であった。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は色々な祕密を此の兄に握られてゐたので、いつもけむつたかつた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本郷のまちの屋根屋根は雨でけむつてゐた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で借りて肩身が狭く、お前をけむったいものだから、必ずどこかで、お前の陰口をたたきます。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸の中に、いつも、うらみを抱いているように見えるものですから、城中の者どもにも、けむったがられ、あまり好かれないようじゃありませんか。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互ひにまだ友人になりきれずにゐる新入生たちは、教室のおのおのの机に坐つてブルウル氏を待ちつつ、敵意に燃える瞳を煙草のけむりのかげからひそかに投げつけ合つた。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いにまだ友人になりきれずにいる新入生たちは、教室のおのおのの机に坐ってブルウル氏を待ちつつ、敵意に燃える瞳を煙草のけむりのかげからひそかに投げつけ合った。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は多彩な女の断面図にベールをかけるように煙草のけむりをふかした。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫色の衣服をつけたお六が、私の肩に手を巻くとそっぽを向いて煙草の黄色いけむりを吐きだした。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ずばりと彼女は云うと、化学的な香料のにおいを発散させながら、黄煙草のけむりで太田ミサコは傲慢なわらいを浮べた顔をくもらせた。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、女は何故か憚るやうにあわてて扉を締めて、置いた火鉢を抱へ直すとけむつぽい顏を横に曲げながら、私の側に近寄つて來た。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "車窓には梅雨にはいつて間もない小糠雨がけむつてゐる。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婚姻何ぞ其人のために喜ぶべけむや。",
              "citation": {
                "source": "愛と婚姻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘ひとつ越えたりけむ、戻る路はまたさきとおなじのぼりになりぬ。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "優しき人のなつかしけれど、顔をあはせていひまけむは口惜しきに。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "常にうとましき児どもなれば、かかる機会を得てわれをば苦めむとや企みけむ。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何方にか去りけむ、暗くなりたり。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきなるはさもなくて、いま幻に見えたるがまことその人なりけむもわかざるを、何とて言はかけざりしと、打泣きしが、かひもあらず。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
