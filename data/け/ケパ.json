          "literary": [
            {
              "text": "魯迅さんの生活は全く原稿生活でしたが、あんまり思うことをズケズケパッパッというものですから圧迫が来るのです。",
              "citation": {
                "source": "魯迅さん",
                "author": "内山完造",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろ――と言って、これは一体、何時ごろから売っていたものなのだろう――カレーパンだの、コロッケパンというものがある。",
              "citation": {
                "source": "駄パンその他",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロッケパンも、店によるだろうが、僕の食ったのは、とても美味くて、やっぱり一個十円だった。",
              "citation": {
                "source": "駄パンその他",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
