        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パスワードは8桁以上の数字と文字で設定してください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "円周率の計算は、小数点以下何桁まで必要なのだろうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "電話番号の最後の桁を間違えて入力してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
