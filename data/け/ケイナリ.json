        "examples": {
          "standard": [
            {
              "text": "将棋の対局で、相手の陣地深くに桂馬を進め、見事な桂成りで局面を有利に進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロ棋士は、次の手で桂成りができる場所を見つけて、相手を追い詰めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの局面での桂成りは、まさに見事な一手だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すぐ五六飛、六八桂、三分考へて四九桂成、同王、五八飛成、同王、六二王。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三二龍、同銀、八三桂成、同王、八四銀。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
