        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オバアサンガ一字ヨムカヨマナイウチニ――オバアサンハ、ムツカシイ字ヲヨムトキハ一字ヨムノニトテモ時間ガカカルノデス――マドノソトデ、ハリサケルヤウナオホキナオトガ、キコエマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ミミガヤブケルヤウナオホキナコエヲシテ、ミケ子トトラ三ガ、マドノソトヲトホツテユキマシタラ、オバアサンハヤツトメヲサマシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ米ハ、タケルヤウニシテアリマス。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新繁昌記」の著者が牛肉を讃美して、「牛肉ノ人ニ於ケルヤ開化之薬舗ニシテ而シテ文明ノ良剤也」と言ひ、京橋に建てられた煉瓦石の家を見ては、「此ノ築造有ルハ都下ノ繁昌ヲ増シテ人民ノ知識ヲ開ク所以ノ器械也」と叫んだ如きわざと誇張的に滑稽的に戯作の才筆を揮つたばかりではなからう。",
              "citation": {
                "source": "虫干",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墳ノ掃苔ニオケルヤマタ彼ハ専ラ尾陽所在ノモノニノミ精シキコトアタカモ我ノ東都ニ限ラレシニ似タリトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「余ノ詩ニオケルヤ固ヨリ遊戯ノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕山は「アヽ上人ノ先考ニオケルヤ半面ノ識アルニ非ズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ヲ以テ余ノ上人ニオケルヤ交情｜最熟ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ韻語ニオケルヤ固ヨリ遊戯余事ニ属ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ余ノ翁ニオケルヤ文字ノ交ニ非ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独リ予及ビ三島遠叔ニオケルヤ盛ニ推許ヲ加ヘ、人前ニ称道シテ唯及ザランコトヲ恐ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
