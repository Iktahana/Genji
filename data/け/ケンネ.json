        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だいたい、いつぞやのケンネル殺人事件――あれでは、支那古代陶器が単なる装飾物にすぎなかった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、糸で鍵を操る術はヴァンダインの『ケンネル殺人事件』だけでつきちゃいないよ。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛の生脂即ちケンネ脂という処を買って細かく截ってそのまま鍋へ入れて少しの水を加えてよく煮ます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛の肝臓もケンネ脂に包まれている腎臓も心臓も胃袋も料理法次第で結構に戴けますから安直なお料理は沢山出来ます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに夫君、ケンネリー・ラムフォード氏と一緒に歌ったレーアンの『スノードロップス』でもあれば充分だった。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫君ケンネリー・ラムフォード氏との二重唱はコロムビアにも一枚あるが、それは『フレンドシップ』というカノンで、その美しさというものは法外だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的の人に命中するかどうかは別として、ピストルの発射だけなれば、十分可能であり、現にヴァン・ダインが「ケンネル殺人事件」の中に、そういう実際上の出来事があったことをしるしている。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
