        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "安藤忠雄は世界的に有名な日本の建築家だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は将来、人々の心に残る建築家になりたいと夢見ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その建築家は、自然と調和したデザインを得意としている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "夏の夜の露店の会話と、建築家の良心はもうない。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポール・ヴァレリーの『ユーパリノスあるいは建築家』のうちで、メガラ生れの建築家ユーパリノスは次のようにいっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "リサの情人で、死ぬのを嫌がり抜いて死んで行った天才建築家フェルナンドはまた新吉の親友だった。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "建築家のＫ氏は我親友の木下杢太郎の姉さんの夫にあたる人で、彼を準養子にされている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこにはわが親友Ｍの義父さんたる建築家のＫ大人が、もう顔を真赤にして小さく床柱に凭りかかって、いい機嫌で旅のころもは篠かけのう、篠かけのうであった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "建築家の役々として其業に従ふや、幾多の歳月を費して後、確かに巍乎たる楼閣を起すの算あり。",
              "citation": {
                "source": "人生に相渉るとは何の謂ぞ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "２　Palladian ――文芸復興期のイタリアの有名な建築家 Andrea Palladio（一五一八―八〇）が古代ローマのコロシアム、大浴堂、凱旋門、その他の非宗教的建築物の研究に基づいて創始した建築様式。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二重勾配屋根をフランスに一般に流行させた建築家 〔Franc,ois Mansard〕（一五九八―一六六二）の名からきた語。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "建築家はその幹を珍重するだろう。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "且其の焼けた一冊が他日の大発明家、大文学家、乃至大建築家を作るべき機縁を持っていたかも解らない。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし今日これが残っておれば建築家の参考となったであろう。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "本所五ツ目の羅漢寺のこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "たださあ、ちがうものがならんでいるほうが、おなじものがならんでいるより、いいんじゃないかなあ」「建物ってのはよ、安定感がなきゃあ、ダメなんだって」　こいつらは、建築家にでもなる気なのか、と慶一はうんざりした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオ十世はその芸術愛好の精神から当時第一流の建築家ブラマンテの建築手腕に眼を着け、彼をしてこの時代を風靡した復活式の様式を以ってサンピエトロ寺院を建立させ、飾るにダ・ビンチやミケランゼロの絵画や彫刻を以て為ようと企てた。",
              "citation": {
                "source": "ローマ法王と外交",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれ明日の式場で、これをお目に懸けられるわけでございますが、あとは卓越した日本の土木建築家の手によりまして、足場を組んで建てていただくつもりでございます」　などと挨拶放送をやって、全国民をまた一入感激させたのであった。",
              "citation": {
                "source": "東京要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか鉄工所のＫ工学博士、建築家のＹ博士、倫敦正金支店のＫ氏一家、Ｎ氏夫妻、砲兵大尉だの学生だの、外務書記生だの在外商店の人々だの、なかなかの賑やかさだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "広場に立つと、「恐怖のイワン」がカザン征服の記念に、バルマとポストニクのふたりの建築家に命じて一五五四から六〇年にわたってつくらせた、もざいくのお菓子のような聖バシルの寺院が南のはしに飾り物みたいに建っている。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六一七年、時の名建築家ピンスボルグの建てたもので、塔の外側を奇妙な階段が螺旋状に巻いて頂上に達している。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は建築家としての活動にまめであった。",
              "citation": {
                "source": "わが父",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "且つ、建築家という一つの専門技術家の立場を、今日の社会の組立ての中で出来るだけ高めて行こうとする努力においてもまめであった。",
              "citation": {
                "source": "わが父",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年時代に日清、日露と二つの戦争を経て、日露戦争前後にはイギリスに数年暮したりした父は、過去六十九年間の日本の経済の発展、変遷と歩調を合わせて、建築家としての経歴を辿って来た。",
              "citation": {
                "source": "わが父",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学を出て役所に入ったのを自分から罷めて、民間の一建築家として活動しはじめた四十歳の父の心持や、その頃の日本の経済的、文化的雰囲気などというものも、私として或るところ迄推察されないこともない。",
              "citation": {
                "source": "わが父",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自身は淡白に、無邪気に建築家という技術を唯一の拠りどころとして生き通した。",
              "citation": {
                "source": "わが父",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "専門が違い、細かいことは分らないながら、私は世の中での父の仕事というものを幾分観ていたから、父が一箇の建築家から曾禰達蔵博士と共同の建築事務所の経営者としての生活に移って行く意味深い歴史の変化も、恐らくは父の知らなかったに違いない関心で眺めていた。",
              "citation": {
                "source": "わが父",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
