        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昔、大銀行だった大建物の廊下に並んだ一つ一つの夥しいドアが、其々一つずつ木箱とケラシンカ（石油コンロ）を並べて、眼路はるか、という風に見えていた都会生活の姿を思いおこします。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台の枕の上へ横になった顔を押しつけて考えこんでいるうちについとろりとした朝子は、やがて、「御飯までにケラシン（炊事用石油）買って来とかなけりゃ駄目なんだろう」と云っている素子のそっけない声で、びっくりして起き直った。",
              "citation": {
                "source": "広場",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
