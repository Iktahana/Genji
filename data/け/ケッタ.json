  {
    "uuid": "c9dbe5b9-707e-560a-b880-6de67b3e217c",
    "entry": "けった",
    "reading": {
      "primary": "けった",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
