    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おれは、その沈没船に代わってでも、また、この船員たちのためにも、船長とたたかう時が必ず来ると信ずる」と、波田は考えにふけった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「けったいやなあ、それなんや。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「行くもんか、行けったってお断りだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしその笑い方は、他人の失策を嘲けったのではなく、親類の不出来しを面白がったように見える。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "われはしばらく思索にふけったふりをして眼を軽くつぶったり短い頭髪のふけを払い落したり、爪の色あいを眺めたりするのである。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜、友人とわずかなお酒を汲み交し、泊めてもらう事にして、私は朝まで一睡もせずに、れいのノートに読みふけった。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを最も熱心に読みふけった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "縦横十文字に読みふけった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして私は、実に非常なる感慨にふけった。",
              "citation": {
                "source": "酒の追憶",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁のざらざらした、屋根がひくい、息づまる寄宿舎で、彼等は思い／＼の考えにふけった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何か、自分でも分からないような考えにふけった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてただいろんな事を止め度もなく考えて、思いにふけったものです。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼ばれて君江「けったいな奴」と言った。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "中では、わたくしに向って、「あたしの身体は臭いだろ、しばらくあっちへ行ってゝもいいよ」　と暗に、わたくしに遠慮することを慫慂して、その間に信玄袋の中に何か出し入れして仕末したり、感慨にふけったりする所作もありました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やいファゼーロ、かけて行け、馬鹿、かけて行けったら。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日も坊様かお侍様かわからぬような、けったいな方が、俺が退治て来てやると言って、山の中へはいって行かれましたが、今に降りて見えぬところを見ると……」「あはは……。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところで、おばはん、けったいな事訊くけど、おまはん字イはどないだ？",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "けったいやなあ」　と言いながら、前掛けをくるりと腹の上へ捲きつけて、随いて来た。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "けったいなお父つぁんやなあ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――藪から棒にこんなこと言うのは、なんやけったいやけど、その子どこぞイ遣るあてがもうあるのんか」「いえ、そんなもんおまへん」「そか、そんなら話がしやすい。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「さあ、お前読んだりイ」「あのう、えらい鈍なことでっけど、わたいは親爺の遺言で、チラシを断ってまんのんで……」「えらいまた、けったいなもん断ってんねんなあ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "けっ、けっ、けっ……」　主任は抜けた歯の間から、けったいな笑いをこぼした。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "けったいな名やろ……？",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜子は近ごろ父との夫婦仲が思わしくないためかだんだん険の出てきた声で、――何や、けったいな子やなア。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「けったいな言い方やねんなあ。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんたとこは昔から五割安だからね」　というと、お内儀さんはうれしそうに、「千日堂の信用もおますさかいな、けったいなことも出来しめへん。",
              "citation": {
                "source": "神経",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "けったくそ悪いよ」　豹吉は再び唾を吐いて、扉の中へはいって行こうとした。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところで、おばはん、けったいな事訊きまっけど、おまはん字ィはどないだ？",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「けったいな言い方やなあ。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　高等学校の一年から二年に進級した夏休みに初めて俳句というものに食いついて、夢中になって「新俳句」を読みふけった。",
              "citation": {
                "source": "俳諧瑣談",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
