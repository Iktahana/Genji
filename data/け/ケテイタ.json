        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "予ハ妙ニ落チ着カナイデ、寝台ニ腰掛ケテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ日ノ午後二時頃、予ガ寝室デ午睡カラ覚メ、マダボンヤリトベッドノ中デ眼ヲ開ケテイタ時、突然浴室ノ戸カラ颯子ガ首ダケヲ此方ヘ出シテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ真鍮ノ守リ札ノ表面ニキイ／＼ト云ウ音ヲサセテ子供ノ住所年齢姓名等ヲ鑿ノヨウナ刃物デ彫リ付ケテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハフォークナーノサンクチュアリヲ読ミカケテイタノデ、チョット挨拶シテ書斎ニ上ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ日記ヲツケテイタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "用ハナイカラサッサト帰レ」「帰ルワ」ト云ウト、茶碗ニ飯ヲ盛リカケテイタノガ、ソノ飯ヲパット飯櫃ヘ投ゲ込ンデ出テ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ間カラ和服デアクセサリーヲ着ケテイタノハ、コノタメノ用意ダッタノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ、アノイヤリングヤレースノ手袋ガ、和服デ着ケテイタ時ノヨウニハ似合ッテイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ日記ヲツケテイタノダ」と云い、「数日前ニウスウス気ガ付イタ」と云っているけれども、実際はよほど前からハッキリと知っており、かつ内容を盗み読みしていたものと思う。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
