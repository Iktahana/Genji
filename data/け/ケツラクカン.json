    "definitions": [
      {
        "index": 1,
        "gloss": "feeling that something is missing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "都会の喧騒の中で、ふと欠落感に襲われることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はいつも満たされない欠落感を抱えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "一人暮らしを始めてから何となく欠落感が拭えず、家族の顔を思い浮かべることが増えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "不安は僕の胸の底に定着し、その不安から欠落感が立ち上がり始めた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "生まれて初めて体験する種類の、不安と悲しさとにくるみ込まれた、奇妙な欠落感だった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝から続いていた不安感、そしてその不安感から生まれてすでに大きく育っていた欠落感は、悲しみに満ちた恐怖へと統合され、頂点に達していた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の内部、あるいはその周囲に、なにか欠落感があることに、ヨシオは気づいた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
