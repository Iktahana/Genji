[
  {
    "uuid": "79d851ff-a807-5fd0-93e1-31c1f892adb0",
    "entry": "ケチケチ",
    "reading": {
      "primary": "ケチケチ",
      "alternatives": [
        "けちけち"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
