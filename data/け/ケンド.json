  {
    "uuid": "6142c54e-f928-5848-b987-fbea0b5dbb5d",
    "entry": "ケンド",
    "reading": {
      "primary": "けんど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
