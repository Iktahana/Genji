    "definitions": [
      {
        "index": 1,
        "gloss": "prefectural land",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この県土の大部分は山林に覆われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "県土の保全と開発のバランスをどう取るかが課題だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地震の後、県土の復興には長い年月がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それからまた県土木技師の設計監督によるモダーン県道を徳川時代の人々が闊歩したり、ナマコ板を張った塀の前で真剣試合が行なわれたりするのも考えものであるが、これはやむを得ないことかもしれない。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水利権問題にては訴願中紛擾もあり、群馬県土木課の冷淡苛酷、殆ど拾年間も自力にて修繕しつつある情態にて容易の業ではない。",
              "citation": {
                "source": "尾瀬沼の四季",
                "author": "平野長蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "高知県土佐郡十六村行川）　この伝説は殊に弘く全国に行き渡ってありますが、大抵はこれに伴って気味の悪い、または愉快な話が語り伝えられているのであります。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなにお前はなやすげに云うけんど、どれ一ツじゃって皆な銭出して買うたもんじゃ。",
