    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ともかくもニホが稲を穂のままに、或る期間蔵置する場所であったことが明白だとすれば、是が農民の心のうちに占める地位が、今よりも遥かに重要であったことはまず推定し得られる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで立戻ってもう一度、何故に琉球列島の一部に、稲の蔵置場と人間の産屋とを、ともにシラと呼ぶ言葉が、残り伝わっているのかを考えてみたい。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "○さて氷室とは厚氷を山蔭などの極陰の地中に蔵置、屋を作りかけて守らす、古哥にもよめる氷室守是なり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞいつまでも飽ざる物は孝心なる我子の顔と、蔵置黄金の光なるべし。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でも古本として雑誌では最高値を呼んでいる由で、近頃外国の図書館でもこの価値を知って、全巻揃いを蔵置する所が多くなった。",
              "citation": {
                "source": "四十年の回想",
                "author": "『民藝四十年』を読んで",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
