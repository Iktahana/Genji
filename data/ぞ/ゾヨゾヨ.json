        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ずたずたに切られ、夢のように拡大された頸、乳、臍の中には、山も川も、森も谷も、そして風の音も、総てが油然と混和されて、ぞよぞよと息づいているのだ。",
              "citation": {
                "source": "魔像",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぞよぞよと廬の前を通る時、皆頭をさげて行った。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
