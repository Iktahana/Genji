        "examples": {
          "standard": [
            {
              "text": "事件の続報を待つ間、私は落ち着かなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ニュース番組では、被災地の状況について続報が伝えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの記事の続報はまだ出ていないのかと、彼は記者に尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "沙河会戦の続報もたいてい発表されてしまって、世間では更に新しい戦報を待ちうけている頃に、向田大尉は突然この師団を立去るという噂がまた聞えた。",
              "citation": {
                "source": "火薬庫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙河会戦の続報もたいてい発表されてしまって、世間では更に新しい戦報を待ちうけている頃に、向田大尉は突然この師団を立ち去るという噂がまた聞こえた。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
