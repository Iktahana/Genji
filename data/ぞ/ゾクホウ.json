        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "曰く、韓国は曾て支那の正朔を奉じて其の属邦たることありしも、未だ外交権を之れに委任したることあらざりき。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国の属邦の太子は、あなたにとっては単なるＭＲ・シュータン以上には出ないじゃありませんか！",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ハ日本ノ屬邦ニ非ズ又日本人ノ植民地ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度ガ英國ノ屬邦タリ英領亞佛利加ガ植民地タルニ對シテ、朝鮮ハ日本ノ屬邦ニ非ズ又植民地ニ非ズト明示セシ所以ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度又ハ亞佛利加ノ住民ガ全然英人ト人種ヲ異ニセルニ對シテ、日鮮人ハ古來ノ混血融合ノミナラズ同一人種中ノ最モ近キ異民族ナル點ニ於テ屬邦タルベカラズ又植民地タルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ永遠ニ政治的言語的思想的屬邦トシテ印度ノ志士ヲ屠ラントセバ止ム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰く、韓國は曾て支那の正朔を奉じて其の屬邦たることありしも、未だ外交權を之れに委任したることあらざりき。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
