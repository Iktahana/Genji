          "literary": [
            {
              "text": "と思い始めるところは、心を正しく保つ（存心）の道を学んだところである。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さぞかし先生の用意存心は、常々この様であったことだろう。",
              "citation": {
                "source": "悦楽（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠・不忠、これはもちろん心中の消息であるが、その心中微妙なところを省みるところに、曽子の徹底的に学問に努める態度と、正しく心を保つ（存心）純粋なところを看るべきである。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
