    },
    "definitions": [
      {
        "index": 1,
        "gloss": "continued advance (in market price)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "株式市場は、昨日に引き続き今日も株価が続騰した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "原油価格の続騰は、経済全体に大きな影響を与えるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "好業績を背景に、その企業の株価は続騰を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "銀貨の価値が落っこちると、金塊相場が続騰した。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「社会」関係の書物が満州事変以後再び下り坂になったに反して、社会問題の基礎的な問題をなすべき経済関係の出版物の口数は、一九三五年になると一九三一年の約一五〇パーセントにまで続騰して来ている。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
