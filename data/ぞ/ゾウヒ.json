    "definitions": [
      {
        "index": 1,
        "gloss": "the good and bad",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "評論家は、その映画の臧否を詳細に分析した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人の行動の臧否を、単純に二分することはできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この計画の臧否については、慎重に議論する必要がある。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "六閑堂賓約一、こゝに来遊するは一日｜世塵を※脱して園林の幽趣をめづるなれば、たゞ風月を談じ詩歌を品するを専らとし時事を論議し人物を臧否するの類は無用たるべし。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　さらに筆をすすめては、宮中府中は倶に一体たり、臧否を陟罰し、宜しく異同すべきにあらず。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
