        "examples": {
          "standard": [
            {
              "text": "彼のリーダーとしての属性は、チームに良い影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プログラミングでは、オブジェクトが持つ属性を定義することが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このソフトウェアは、顧客の購買属性を分析するのに役立つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
