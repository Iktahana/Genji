  {
    "uuid": "72d66493-7bb0-5d30-8f12-155d681fd393",
    "entry": "族制",
    "reading": {
      "primary": "ぞくせい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
