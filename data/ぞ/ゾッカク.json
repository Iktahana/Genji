        "examples": {
          "standard": [
            {
              "text": "英語では、「's」で所有を表すのが属格の働きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この文では、「私の」という部分が属格の役割を果たしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "言語学の授業で、属格の使い分けについて詳しく学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "昨夜は、学校で習はなかった文典（動詞だの名詞だの第一人称だの二人称だの属格だの主格だのといふ事）を教はりました。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
