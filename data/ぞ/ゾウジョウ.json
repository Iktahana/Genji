        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "増上寺の境内に、大勢の見送り人が集っていた。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この東京名所の増上寺山門の前に、ばかな叔父が、のっそり立っているさまを、叔父とも知らず無心に眺めて通ったのかも知れない等と思った。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "増上寺山門の一景を得て、私は自分の作品の構想も、いまや十分に弓を、満月の如くきりりと引きしぼったような気がした。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲板でハース氏に会うと、いきなり、芝の増上寺が焼けたが知っているか、きのうのホンコン新聞に出ていたという。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時分、増上寺の坊さんは可恐しく金を使ったそうでね、怪しからないのは居周囲の堅気の女房で、内々囲われていたのさえ有ると言うのさ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その増上寺に、年少な美僧で道心堅固な俊才のが一人あった。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "祐天顕誉上人（浄土宗大本山増上寺三六世法主）の資質は愚鈍であった。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "是に於いてや、悖戻の情は一時我心上に起り來りて、自信自重の意識は緊縛をわが恆の心に加へ、此緊縛の中よりして、増上慢の鬼は昂然として頭を擡げ、我をして平生我に師たる俗客を脚底に見下さしめ、我耳に附きて語りて曰はく。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "姑はお庄に案内してもらって、久しぶりで浅草や増上寺を見てあるいた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子の胸をどきんとさせるほど高く、すぐ最寄りにある増上寺の除夜の鐘が鳴り出した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "増上寺前に来てから車を傭った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野と浅草と芝との鐘の中で、増上寺の鐘を一番心に沁みる音だと思ったり、自分の寺の鐘を撞きながら、鳴り始めてから鳴り終るまでの微細な音の変化にも耳を傾け慣れていた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかもこの日はお二代台徳院殿様、すなわち前将軍｜秀忠公のご忌日に当たるところから、例年のごとく将軍家の増上寺お成りがあるため、お城内も沿道もたいへんな騒ぎでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "七日まえにまず増上寺へ正式のお使者が立って、お参詣お成りのお達しがある。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて道中、事も起こらずに増上寺へお着きとなれば、もうあとはたわいがないくらいでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "――江戸の陰間茶屋と言えば、芝の神明裏と湯島の天神下と、一方は増上寺、一方は寛永寺と、揃いも揃って女人禁制のお寺近くにあるというのに、京はまたかくのごとく女には不自由をしない曲輪手前に、恐れ気もなく店を張っているのも、都ならでは見られぬ景物に違いない。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだ得ざるを得たりといいいまだ証せざるを証せりと言うのをさえ、世尊はこれを増上慢とて難ぜられた。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、証すべからざることを証せんと求めた爾のごときは、これを至極の増上慢といわずしてなんといおうぞ。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "悟空は、今までの極度の増上慢から、一転して極度の自信のなさに堕ちた。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰り新参で、昌平黌の塾に入る前には、千駄谷にある藩の下邸にいて、その後外桜田の上邸にいたり、増上寺境内の金地院にいたりしたが、いつも自炊である。",
              "citation": {
                "source": "安井夫人",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿彌陀經を借りに行つたら、直ぐそれを坊さんになりたいのだと思つて、何なら増上寺の管長へも紹介しようと云つた、あの世間知らずの、然し柔和な和尚も死んだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつぞや福岡地方で同宿したことのある妙な男とまた同宿した、私を尊敬してくれるのは有難いけれど、何だ彼だと附き纒はれるのは迷惑だ、彼ぐらい増上慢になれば天下太平、現世極楽だらう。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "増上慢はネコイラズみたいなものだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸で将軍家茂の遺骸を増上寺に葬つた月である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀忠の亡くなつたのは正月二十四日で、二十六日の夜増上寺への野邊送があり、二月二十二日に勅使が立ち二十六日に遺物分があり、三月十一日に忠之は暇を賜はつて江戸を立つた。",
              "citation": {
                "source": "栗山大膳",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "準之助は、他人を一歩も仮借しようとしない、夫人の増上慢に、……その無残な仕打に、良人として、いな一人の人間として、呪咀の叫びを上げずにはいられなかった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と美和子は、もう姉のために弁ずるよりも、いかにもけんだかな増上慢を、歴々と顔に出している夫人に、突っかかって行く興奮に自ら酔うているように、止めどもなく、喰ってかかって行く。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔から増上慢をもって己を害し他を※うた事蹟の三分の二はたしかに鏡の所作である。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
