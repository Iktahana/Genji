          "literary": [
            {
              "text": "二　ファウストの善本は無論ゾフィインアウスガアベである。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ疑わしい処をゾフィインアウスガアベで調べて見ただけである。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして何か疑わしい事があると、三冊になっているゾフィインアウスガアベを出して見た。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」こう云てしまって、ふと原文を見る気になってゾフィインアウスガアベを出して見た。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
