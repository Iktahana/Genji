        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "不行跡から淋病を得、暴飲から心臓異常を来たし、無茶な行動から筋骨を挫くようなことは、招いて得た疾病である。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねえ法水君、算哲の心臓異変を発見した君を、僕はアダムスともルヴェリエとも思っているくらいだよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論鎮子をその調査にまで導いていったものは、いつぞや法水が彼女の心像を発いて、算哲の心臓異変を知ることの出来た心理分析にあったのだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不行跡よりして痳疾を得、暴飮よりして心臟異常を來し、無法の擧動よりして筋骨を挫折するを致せるが如きは、招いて得た疾病である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
