[
  {
    "uuid": "2a926864-588b-55e6-ae65-8f11c70102f7",
    "entry": "象嵌",
    "reading": {
      "primary": "ぞうがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
