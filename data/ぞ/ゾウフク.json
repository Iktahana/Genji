        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "顕微鏡は、対象物を肉眼では見えないほどに増幅して観察できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の話は、尾ひれがついてどんどん増幅されていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このレンズを使えば、小さな文字も大きく増幅して読めるよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
