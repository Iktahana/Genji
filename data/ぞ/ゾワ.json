        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よろこびに今ぞわがごと祝がへ蟲。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああわが魂よ、汝何ぞうなだるるや、なんぞわが衷に思い乱るるや、汝神を待ち望め、われに聖顔の助けありて我れなおわが神を讃め称うべければなり」と三度繰返さるるに注意せよ（四十二篇五節と十一節と四十三篇五節とにおいて）。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな筈はないんだけれど、――雨をお天気にする力があるなら、掛けた鍵なぞわけなしじゃあないか。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの、どうぞわたくしを縛って下さいまし、わたくしは決闘を致しまして、人を一人殺しました。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どうぞわたくしの心の臓をお労わりなすって下さいまし。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "訓導宮沢賢治早くもひとり雪をけりはるかの吹雪をはせ行くは木鼠捕りの悦治なり三人ひとしくはせたちて多吉ぞわらひ軋るとき寅は溜りに倒れゐし赤き毛布にくるまりて風くるごとに足小刻むは十にたらざる児らなれや吹雪きたればあとなる児急ぎて前にすがりつゝ一列遠くうすれ行く",
              "citation": {
                "source": "訓導",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ぞわたしは失する。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞわたくしを呪いの犠牲にして下さいまし。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕まぐれほのかに花の色を見て今朝は霞の立ちぞわづらふ　という歌である。",
              "citation": {
                "source": "源氏物語",
                "author": "若紫",
                "note": "青空文庫"
              }
            },
            {
              "text": "降り乱れ汀に凍る雪よりも中空にてぞわれは消ぬべき　とその上へ浮舟は書いた。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とぞわたしの胸の中を察してくださいませ。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでこのお約束が無理だと仰有るのでしたら、どうぞわたしをこのままのこしてノーフォークにお帰り下さい」と、これは私達の結婚の前日に、彼の女が私に云った言葉でした。",
              "citation": {
                "source": "暗号舞踏人の謎",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれでこのお約束が無理だとおっしゃるなら、どうぞわたくしをこのまま残してノーフォークへお帰りください。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええ、ホームズ先生、なにとぞわたくしにもお力添えを。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "果たして二・三時間探しても実を結ばず、あきらめて引き返そうと思って目を空に向けたとき、見えた光景に若者の胸はぞわっと喜びでいっぱいになる。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、波のうえにただようはりや板きれをかきわけかきわけ、万一、ぶつかってつぶされることなぞわすれて、夢中でおよいでいきました。",
              "citation": {
                "source": "人魚のひいさま",
                "author": "DEN LILLE HAVFRUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際また一度や二度行つて見たくらゐでは鉱山の人達の生活なぞわかる気遣ひはなささうであつた。",
              "citation": {
                "source": "籠の小鳥",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「木部さん……あなたさぞわたしを恨んでいらっしゃいましょうね。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっともうひと月ごし、病人だまりにいたんですからね」「ほう、それは耳よりな話じゃが、ではどこぞわずらっていたのじゃな」「そこがつまり、あばたのだんなのひどすぎるところだというんでがすがね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卍のいれずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞわたしに代わり、吉川訓導の卑屈な不道徳極まる行為を責められ、哀れな少女千葉房枝の名誉を世の中の人々にお告げくださいますようお願いいたします。",
              "citation": {
                "source": "錯覚の拷問室",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「藤尾が始終御厄介になりまして――さぞわがままばかり申す事でございましょう。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「若しフランスの軍艦が来るようなら、どうぞわたくし共をお使下さい。",
              "citation": {
                "source": "堺事件",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて歸つて差向ひになつた時、新夫人が、「どうもあなたのおかあ樣と一しよに徃くのは嫌ですから、どうぞわたしに嫌な事をさせないやうにして下さい」と云つた。",
              "citation": {
                "source": "半日",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞわたしに御奉公を……。",
              "citation": {
                "source": "修禅寺物語",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞわたくしに免じて放生会をなにぶんお願い申します。",
              "citation": {
                "source": "鯉",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つには不実な男の顔を見返すためと、二つには廓の苦を逃がれるために、どうぞわたしを請け出してくれと、彼女は繰り返して頼んだ。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "与五郎　おお、それぞわが兄……那須与市宗隆……。",
              "citation": {
                "source": "平家蟹",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の野郎を出し抜くわけじゃあねえが、この一件はどうぞわっしに任せておくんなせえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "妖狐伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし弦之丞様、それやこれも察してあげて、どうぞわっしが立った後は、江戸表へお帰りなすッて、不幸なお千絵様の力となってあげて下さいまし……、このとおり、銀五郎が両手をついてお願い申します」「……さて何としたものやら？",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
