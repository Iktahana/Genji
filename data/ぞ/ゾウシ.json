  {
    "uuid": "f49eb9fb-c335-518c-8a8a-656ac953211a",
    "entry": "造士",
    "reading": {
      "primary": "ぞうし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
