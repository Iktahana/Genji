        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "正隆は、蒼い額に、切り込んだような縦皺を寄せながら、瞼を嶮しく引そばめて、森閑とした周囲を睨まえるのである。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "介抱者たちをあたかもおのが修行の邪魔者であるかのごとく、はったと睨まえると大音声をあげた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第五巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兵衛」　睨まえるように、正成へ。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "じっとそのおもてを睨まえるように見て。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "口に出してはいわないが、目の前に横たわる岬をにらまえると、思わず足に力がはいる。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊氏のにらまえる目を、より強く、はね返して、「つまりは、降伏だ。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
