    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to run around trying to escape",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はマスコミの追及をかわすため、一ヶ月以上も各地を逃げ回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鬼ごっこで足の速い子が鬼になると、他の子たちは必死に園庭を逃げ回る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "浮気がバレそうになった彼は、妻の厳しい質問から逃げ回るのに必死だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一種の連続的な身の毛のよだつ恐怖のどんづまりの叫び声とも何ともつかぬ声をあげて、家ぢうを逃げ回るのであつた。",
              "citation": {
                "source": "浪曼的月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベン・プライスがこの逃げ回る金庫破りの足跡を追っていると公表されると、盗難防止用金庫を持っている人々もほっとすることができた。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく私を見出したならば彼は会心の微笑を洩らして最も残酷な嬲り打ちを浴せ、跳ねては転びしながら逃げ回るであろう私達の悲惨な姿を現出させて鬱屈を晴らすに違いない。",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、机の上においた本が、いつの間にやら宙へうかんでいたり、たべようと思ってパイナップルのかんづめをあけると、たちまち中から輪切りになったパイナップルや、おつゆがとびだしてきて、宙をにげまわるなどと、いうこともあって、なかなかてこずる。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "12　こばやしくんやポケット小ぞうやおまわりさんたちは、おだいばのくさむらで二十めんそうをおいかけましたが、うまくにげまわるので、つかまりません。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとなのからだでは、とても通れないようなところばかりを、にげまわるのですから、なかなかつかまりません。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが下駄を片手にぶらさげて跣足で田の畦を逃げ廻るのを、村のアマゾン達が巧妙な戦陣を張ってあらゆる遁げ路を遮断しながらだんだんに十六むさしの罫線のような畦を伝って攻め寄せて行った。",
              "citation": {
                "source": "五月の唯物観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはほんとうにいい言葉のような気もするのであるが、そうして私も今その言葉を、はっきり掴みたいのであるが、あせると尚さら、その言葉が、するりするりと逃げ廻る。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "と一つ思い浮かべるとその悲劇の有様が目の先に浮んで来て、母やお光が血だらけになって逃げ廻る様がありありと見える。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤吉は逃げ廻るはずみに井戸端で足をすべらせて、井戸側へよろけかかったかと思うと、さかさまに転げ込んでしまった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "久六を逃がすな」　部屋から部屋を逃げ廻る保下田の久六。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃げ廻る遊び人と浪人の三枚目がかった立廻りがあって、浪人は結局フラフラになった遊び人の首筋掴んで引きずって行く。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "頂上、逃げ廻る伊吉。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「相手は死もの狂いで次から次へと田舎を逃げ廻るんでしょ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、新次が中耳炎になって一日じゅう泣いていた時など、浜子の眼から逃げ廻るようにしていた私は、氷を買いにやらされたのをいいことに、いつまでも境内の舞台に佇んでいた。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手人が手をおろさずとも、お葉がおどろいて逃げ廻るはずみに、自分で足をすべらして転げ落ちたのかも知れない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "三甚も気が弱いに相違ありませんが、なにしろお浜が心配して、気違いのように騒ぐので、それに引き摺られて逃げ廻ることにもなったのです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "廻り燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "科人の逃げ廻るのは珍らしくないが、岡っ引がこれだけ逃げ廻るのは前代未聞で、二代目の三甚、いいお笑いぐさになってしまいました」「そうでしょうね」と、わたしも笑った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "廻り燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙に蟹を包み与えると饅頭と思い戴き、開き食わんとして蟹出づるに仰天し騒ぎ逃げ廻る事夥し。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに長い間中国では軍閥というものが民心を荒しつづけましたから、これから逃げ廻ることばかり考えるのに急がしくって、愛国心からも一緒に逃げる練習も出来たのですね。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も逃げ廻るところを引き受けた誠実さを認めずに、他のどこをあの人人から認めようとするのかと。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰からも一大危機と分っているとき、逃げ廻る狡猾さと坐り込む諦念と。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷民達に襲われたので、茅野雄は殺生とは思いながら、幾人かの郷民を叩っ切り、浪江を連れて逃げ廻るうち、岩山の洞窟の口まで来た。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "缶はがらんがらん転げまわる、少年たちはその下敷になるまいと逃げ廻る、いやたいへんなさわぎとなった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　救いの声を立てながら、ヒョロヒョロ逃げ廻るばかりである。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こう云って声をかけたのは、猪之松にとっては一の乾分――上尾街道で浪之助などに追われ、逃げ廻る弱者の峯吉ではなく――角力上り閂峰吉であった。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へい」と云ったのは閂峰吉で、「さぞまア気味の悪いことで、いやアなものでございましょうなあ」「討たれまいとして逃げ廻る。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……こう決心して逃げ廻る心、快いぞ快いぞ」「そんなものでございますかなあ」「とはいえ厭アな気持のものだ。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "討たれる方は討たれまいとして、命を惜しんで逃げ廻る。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "討たれる者、逃げ廻る者、今迄の俺はそうだった！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
