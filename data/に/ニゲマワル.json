[
  {
    "uuid": "ecd3e52b-3c3c-525d-a428-6a6f3ce5c838",
    "entry": "逃げ回る",
    "reading": {
      "primary": "にげまわる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
