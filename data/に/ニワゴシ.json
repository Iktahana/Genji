        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "障子の開け閉てにその娘が欄干に凭れて中庭越しにこっちの部屋を伏目で眺めて居る姿が無意識の眼に映るけれども、私はそれどころでなく書きに書いて心積りした通り首尾よく大晦日の除夜の鐘の鳴り止まぬうちに書き上げた。",
              "citation": {
                "source": "健康三題",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（……駄目ですよ、何をなさるんですよ、）　養父が何をはじめたであらうかと思つて、鉛筆を控へて内庭越しに離屋の方を見た。",
              "citation": {
                "source": "黒い蝶",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船場の宿の座敷から眺めてゐると、梧桐の梢の青々としてゐる庭越しに、隣りの家の物干臺が見えて、幅一寸に長さ五寸ほどの薄い板が、※のやうに細繩で繋いで、ドツサリ乾してあつた。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声が中庭越しにきこえる。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "田中王堂氏の原稿は、書き入れ、書きなおしで御本人さえ一寸困るようだとか、多分藤村氏であった、有名な遅筆だが、（鵠沼の東屋ででもあったのだろう、）おくれて困るので出先まで追っかけて、庭越しに向い合わせの座敷をとって待つことにした。",
              "citation": {
                "source": "狭い一側面",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "でこぼこ石の中庭越しに、裏の長屋と家畜小舎が見えた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "露台の上から、下の中庭越しに塀が見えた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ふと彼は円窓から半身を乗り出して、庭越しに通りの方を見てみる。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、背中の赤ん坊をしつかりと後手でかゝへて、網の目から庭越しに家の様子を窺つた。",
              "citation": {
                "source": "河原の対面",
                "author": "小寺菊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィール夫人が彼女の家へ訪ねて来たとき、隣りの家の召仕いはバーグレーヴ夫人が誰かと話しているのを庭越しに聞いていた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "ヴィール夫人の亡霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "東向の腰の低い一間窓は大きく開いて、此處から碧梧桐の葉に邪魔され乍ら、お隣の庭越しに、神田から駿河臺の景色がよく見えます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "持參千兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏長屋の狹い庭越しに、梅から櫻へ移り行く春の風物を眺めて、唯斯うぼんやりと日を暮してゐる、この頃の平次だつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "梅吉殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏長屋の狭い庭越しに、梅から桜へ移り行く春の風物を眺めて、ただこうぼんやりと日を暮している、この頃の平次だったのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "梅吉殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして中庭越しの向うの部屋には明りが灯いた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山楽」「はい」「たれか、門を、訪れておりはせぬか」　山楽は、庭越しの枝折戸のほうへ、耳をすまして、「ほんに」　と、急に、師のまえを退がって、住居の入口から出て行った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "山手通りの俗に桜並木とよばれる植木会社の表門通りから、遊行坂の降りへかかる坂の降り口で、座敷にいても庭越しに、横浜市街が一望に見えた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
