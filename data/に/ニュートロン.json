        "examples": {
          "standard": [
            {
              "text": "原子核を構成する粒子の一つであるニュートロンは、電荷を持たない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ニュートロンの発見は、原子核物理学の発展に大きく貢献した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "高速のニュートロンが物質に衝突すると、核反応を引き起こすことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてこの場合の畢極の個体は、広義に於けるアトム（エレクトロン・ニュートロン・ポジトロン・等々）である。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
