        "examples": {
          "standard": [
            {
              "text": "スポーツ中に急な激痛が走り、肉離れ（にくばなれ）を起こしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "サッカーの試合中に、太ももを肉離れしてしまい、しばらく運動できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "準備運動を怠ると、肉離れのリスクが高まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "前の日まで中気で寝ていた源さんは、その日無理をして仕事に出た為め工場で過って右腕に肉離れをして了ったのです。",
              "citation": {
                "source": "カンカン虫殺人事件",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉離れがよく、外国にもこんなうまい魚があるか、と感心しました。",
              "citation": {
                "source": "アメリカの牛豚",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕飯に、肉ばなれがしさうだから、すきやきを頼む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
