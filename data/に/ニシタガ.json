          "literary": [
            {
              "text": "百丈和尚、凡ソ参ズルツイデ一老人アリ、常ニ衆ニシタガッテ法ヲキク。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ浴室ト寝室ノ間モ行ケ／＼ニシタガ、コレハ必要ニ応ジテ浴室ノ内部カラ締マリガ出来ルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "流シ場ニハ木製ノ下司板ヲ敷クコトニシタガ、浴槽ハイカントモスル訳ニハ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハノックノ音ヲ耳ニシタガ、返事スル隙モナクドーアガ開イテ彼女等ガ這入ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
