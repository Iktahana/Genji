        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はその分野の第一人者としての風格と、知的な匂いを漂わせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この古い洋館には、かつての華やかな生活を思わせる歴史の匂いが染み付いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼の書く文章には、どこか都会的で洗練された匂いが感じられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
