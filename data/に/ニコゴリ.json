    "definitions": [
      {
        "index": 1,
        "gloss": "jellied fish or meat broth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "フグの煮こごりを温かいご飯に乗せると、熱でとろりと溶けて絶品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母が作る魚の煮付けは、翌朝にはぷるぷるの煮こごりができていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小鉢に出された煮こごりには、魚の旨味が凝縮されていて酒の肴に最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "片翼になって大道に倒れた裸の浜猫を、ぼての魚屋が拾ってくれ、いまは三河島辺で、そのばさら屋の阿媽だ、と煮こごりの、とけ出したような、みじめな身の上話を茶の伽にしながら――よぼよぼの若旦那が――さすがは江戸前でちっともめげない。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、京都では鴨川上流で漁れたどんこの飴煮、金沢ではごりの佃煮、最上の小国川では鰍の煮こごりを食べたが利根川の鰍の味に勝るはなかった。",
              "citation": {
                "source": "魔味洗心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮こごりが素敵である。",
              "citation": {
                "source": "すっぽん",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩秋から冬へかけて、すっぽんの羮を一夜置くと翌朝は煮こごりとなっている。",
              "citation": {
                "source": "すっぽん",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "コゴルは「煮こごり」などの複合形でまだ殘つて居るが、コルといふ動詞に新たな内容が出來て、普通カタマルといふ語を代用し段々もとの意味が不明になつたのと、一方には野老（トコロ）といふぬる／＼するものが知られて居るので、終にトコロテンが標準語になつてしまつたのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コゴルは「煮こごり」などの複合形でまだ残っているが、コルという動詞に新たな内容ができて、普通カタマルという語を代用しだんだんもとの意味が不明になったのと、一方には野老（トコロ）というぬるぬるするものが知られているので、ついにトコロテンが標準語になってしまったのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
