        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "帝国主義者共ハ既ニコノ憎ムベキ計画ノ第一部ヲ国民革命ニ対スル連合ノ軍事干渉ニヨッテ実現シタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太平洋大海戦ハ遂ニ開カレントシ、皇国ノ興廃ト東洋ノ平和ハ、正ニコノ一戦ニ懸レリ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ首都巴里ノ労働者ニシテ「ブルタアニユ」ヤ「ノルマンデイイ」ノ到ル処ニコノ「田舎ノ家」ヲ所有スルモノ其ノ数オビタヾシキニノボルト云ハレル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "書紀の文はそれを評して、「マサニコノ地二都ヲツクラムト欲スカ」　とありますよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛騨・高山の抹殺――中部の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢兄心ニコノ義ヲ主トシサキニ先人ノ遺稿中ニ就テ曾撰ノ二首ト自ラ賦スルモノトヲ合セテ天下ノ一大壇場ニ上シ以テ不朽ニ垂レシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ニデモ行ッテ貰ウサ」「御自分デ御覧ニナラナクッテモイヽンデスカ」「コノ暑イノニコノ体デハ行ケソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ頻リニコノ天候ヲ気ヅカッテ、モウ一日オ延バシニナッタラト云ッタガ、予モ颯子モ承知シナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月モ中旬ダト云ウノニコノ暑サハ異常デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ情ナイ姿ノトコロヲ彼女ニ見ラレテハ極マリガ悪イ、ト、思ッタ途端ニコノ言葉ガ出タノデアルガ、正直ヲ云ウト来テ貰イタクナイコトモナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテソレトナク予ヲ力ヅケルタメニコノ時期ヲ待ッテ出テ来タノダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、誰ニコノ製作ヲ依頼シタライヽカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ殊ニコノ菩薩像ニ惹キツケラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃、総督ノ愛顧ニ狎レテ、トカク盗ミヲ働キ、ソノ※品ヲ、自己ノ小僕部屋ニ匿シオキ、十五日夜半モ又、夫人ノ深窓ヨリ金銀珠玉ヲ盗マントシテ、ツイニ衛兵ノ手ニ縛サレタリ　重罪ノ上、更ニコノ重科ヲ重ネタルカド、尋常ニ非ズ、中央ノ処断ヲ待ツノ間、土牢ヲ申シ付ク「やっぱりおれは騙されていたのか？",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
