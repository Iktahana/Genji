        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこへ同宿のニコデムスと云ふ院僧が歩み寄つた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニコデムスは僧院の会計主任である。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜかと云ふにセルギウスが目にはどうも、ニコデムスは長老に媚び諂つてゐるやうに見えてならない。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてそのニコデムスが側へ来て、叮嚀に礼をして云つた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の名はニコデムスだね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
