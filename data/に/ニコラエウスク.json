        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ニコラエウスクではお前方の逃げて来るのを待つてゐるだらう。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニコラエウスクの町の入口に屋敷がある。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪い事は云はないから、ニコラエウスクへは寄らないが好い。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくし共は段々ニコラエウスクに近づいて来ました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体わたくし共はずつと大きい輪をかいて、ニコラエウスクの側へ寄らないやうにする積りでした。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくし共の僥倖で、丁度その時ニコラエウスクの町に或る年寄の役人がゐました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくし共はその夜の内にこつそりニコラエウスクの側を通り抜けてしまひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに乗つて、外套を体に巻いて眠つてゐたのが、ニコラエウスクの裁判所長でした。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
