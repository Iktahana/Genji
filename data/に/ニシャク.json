          "literary": [
            {
              "text": "これ英国より取寄せられたる瓦斯ストーブにて高さ四尺長さ五尺幅弐尺あり、この価弐百五十円なりという。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "長剣も可宜候得ども手に銃を取る丈の人ハ実ハ刀もなくて可宜候得ども、其通りも参るまじけれバ弐尺壱弐寸の刀に、四五寸計の短刀が宜候。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本権平、一同あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "山茶　栂　概　大竹周り貳尺斗のもの有るといへり。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其生ずる處の竹圍（り）貳尺に及び、實に本邦薩州大河（平）を除くの外他に比すべき地なし。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
