        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "現代日本ニノミ存スル長子相續制ハ家長的中世期ノ腐屍ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "左ハ言ヘ古器ヲ玩ブハ他ノ学事ト同ジカラザレバ、古刹ノ僧侶ガ霊宝ノ伝来ヲ説クガ如ク、附会ノ説ヲ喋々スルハ甚ダ煩ハシケレバ、考証ハ固ヨリ有用ナレド、務メテ雅致ヲ失ハズ、空シク理窟ニノミ流レザルヲ可トス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑務所の書信用紙というのは赤刷りの細かい罫紙で、後の注意という下の欄には――手紙ノ発受ハ親類ノ者ニノミコレヲ許スソノ度数ハ二カ月ゴトニ一回トス賞表ヲ有スル在所人ニハ一回ヲ増ス云々――こういった事項も書きこまれてある。",
              "citation": {
                "source": "死児を産む",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "クニノミヤツコ、アガタヌシ、村首などのスグリかね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔時ハ禽獸ハ唯本能アリテ、智ハ唯人ニノミ存シテ本能ナシト云説ナリケレドモ、近世ノ發明ニテハ、禽獸ノ本能ハ、譬ヘバ書畫ヲ能クスル者ハ、臂ノ神經ニ其作用備ハリ、歌謠ヲ能クスル者ハ、喉ノ作用ニ其作用備ハルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等亦皆智ノ類ナリト雖ドモ、唯ソレ限局シテ之ヲ其一事ニノミ述ルノ能力ハアレドモ、推シテ他ニ及ボスノ力無シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "古墳ノ掃苔ニオケルヤマタ彼ハ専ラ尾陽所在ノモノニノミ精シキコトアタカモ我ノ東都ニ限ラレシニ似タリトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば社会の上流に位する貴族の如きも、これを天皇に対し奉って、やはり家ッ子にほかならぬもので、国造、伴造をクニノミヤツコ、トモノミヤツコと訓むのは、「国の御奴」、「伴の御奴」の義でなければならぬ。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "［過去ノ文脈中ニノミ用フ。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "………自分ノ頭脳ガ日ニ日ニ駄目ニナリツツアルニノミ熱中シテイタラ、イツノマニカ淫慾以外ノスベテノヲ五分ト考エツヅケル根気ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御次ニノミミナ控ヘラレタリ。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このハヤアキツ彦とハヤアキツ姫の御二方が河と海とでそれぞれに分けてお生みになつた神の名は、アワナギの神・アワナミの神・ツラナギの神・ツラナミの神・アメノミクマリの神・クニノミクマリの神・アメノクヒザモチの神・クニノクヒザモチの神であります。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "（国造伴造と書かれたことばはクニノキミとトモノキミとであって、クニノミヤツコまたトモノミヤツコという風にこの文字を読んで来たのは、まちがいだろうと思われる。",
              "citation": {
                "source": "日本歴史の特性",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
