          "literary": [
            {
              "text": "又個々人ノ天才ハ勞働ノ餘暇ヲ以テ發揮シ得ベキ者ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代日本ノ進歩ニ於テ英語國民ガ世界的知識ノ供給者ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "成年者ガ三月又ハ半年ニテ足ル國際語ノ修得ガ、中學程度ノ兒童一二年ニシテ完成スベキコトハ、英語ガ五年間沒頭シテ尚何ノ實用ニ應ズル完成ヲ得ザル比ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "敢テ今次ノ朝鮮太子ト日本皇女トノ結合ヲ以テ日鮮ノ融合ガ試ミラルルニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍國主義ナルカ否カハ傭兵ト徴兵トニヨリテ決セラルル者ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ豈ニ遠大ノ業ニアラズヤ――」　これは云うまでもなく政府の方針になっていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日城廓ニ到ル、帰来涙｜巾ニ満ツ、遍身綺羅ノ者、是養蚕ノ人ニアラズ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十一日（火曜）〔発信〕第六十二信〔受信〕電報　フツカトモ　ナンラ　メンカイヲコトワツテイルニアラズ　ネンノタメニ」アサ九ジハン　ケンジ　白いきちんとした背広、紳士、そり跡蒼きやせ面。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼四県ノ地亦陛下ノ一家ニアラズヤ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "四県ノ民亦陛下ノ赤子ニアラズヤ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ハ魏志文ヲ引クニ、伊都國ヨリ邪馬臺マデノ行程ヲバ略カレタレドモ、コレラノ行程ハ、國々ノ位置ヲ求ムルニ必要ナル者ナレバ、多少ノ誤謬ハ免レズトモ、全クハ棄ツベキ者ニアラズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、彼ノ女ノ罪ハ祖先ノ罪ニアラズ、彼ノ女ノ死ハ彼ノ女ノ罪ニアラズ――彼ノ女ヲ殺シタルハ余ナリ、駒井能登守ナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、後人、耶蘇ノ像ヲ描カントスルモノ、ソノ想像ノ自由ナルト共ニ、表現ノ苦心尋常ニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミケランゼロモ、ダビンチモ、耶蘇ノ有スル無限ノ悲愁ト、沈鬱トヲ写スコト、到底ジョットーノ比ニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ欲スルトコロハ領土ニアラズ、物資ニアラズ、己レノ良心ト信仰トノ活路ヲ見出サンガタメニ新天地ニ出デタルモノ也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜ノ花ハ火ニアラズ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺鐘、城鼓モ遠ケレバマタ趣キナキニアラズ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈不肖余ノ故ヲ以テニアラズヤ感歎ニ堪ヘズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔蕭然野服便チ程ニ登ル／一路山ヲ看レバ世情ニアラズ／応ニ似ルベシ淵明ノ廬岳ニ向フニ／肩輿此ニ一門生ヲ添フ〕という絶句がある。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "交誼啻ニ門ヲ同ジクスルノミニアラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○同一地方ノ發見物ハ必シモ同一人民ノ手ニ成リシ物ニアラズ、トハ亞米利加ニ於ケル事實ニ由リテ理解スルヲ得ベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是故ラニ埋メタルニアラズ、遺物ノ上新ニ土ノ生ジタルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼四県ノ地亦陛下ノ一家ニアラズヤ、四県ノ民亦陛下ノ赤子ニアラズヤ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "上告文には、坂東一帯の騒擾は、すべてこれ、彼の野望と、中央無視の反意によるものであるとなし――為ニ、荘園ハ枯渇シ、農民ハ焦土ニ泣涕流亡シ、ソノ暴状ハ鬼畜モヨク為ス所ニアラズ――と、誇張した文辞で、将門の反官的行為を、ある事ない事、針小棒大に書き出してある。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに四句の天の言葉がございまする……宿ニ遇イテ重ネ重ネ喜ブ高ニ逢イテ是、凶ニアラズ外夷、及ビ、内寇幾処カ、奇功ヲ見ス　きっと後々思いあたることがございましょう。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はて、何事やらんと、拝披いたしてみると、御文言はわずか数行、小閑、岐阜ニ得ルモ忽チ倦ム風雲オサマッテ更ニ風雲ヲ望ム花鳥風月マダ友ニアラズ今歳ノ計策ソレ如何　――こんなお質ね事が書いてあるのだ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
