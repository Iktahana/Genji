        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "植民地再分割ノタメ帝国主義戦争ガ勃発スル可能性ガ十分ニアルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただもう少し科学者と芸術家のコンジェニアルな方面を列挙してみたいと思う。",
              "citation": {
                "source": "科学者と芸術家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "更ニ他ノ一理由ハ日本ノ將來ハ陸上ニアルト同一以上ノ程度ニ於テ海上ニ在ルガ故ニ、國民教育ニ於テ只陸軍的模倣ヲナサシメテ海兵的訓育ヲ閑却スルコトノ矛盾ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "未決監ニアル刑事被告ノ人權ヲ損傷セザル制度ヲ定ムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "未決監ニアル被告ヲ豫備囚徒トシテ待遇シツツアルコトハ純然タル封建ノ遺風ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來取得スベキ新領土ノ住民ガ其ノ文化ニ於テ日本人ト略等シキ程度ニアル者ニ對シテハ、取得ト同時ニ此ノ改造組織ノ全部ヲ施行スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "散粟ノ島嶼ヲ劃定線トシテ國際間ニ於ケル無産者ノ地位ニアル日本ハ、正義ノ名ニ於テ彼等ノ獨占ヨリ奪取スル開戰ノ權利ナキカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、可能ナラバ霊魂第十号ニモウ一度会イ、彼及ビ彼ノ背後ニアル心霊科学ト握手シ、同ジ目的ニ向ッテ協力シタイモノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「千二ヨ、タズネルモノハ、コノサキニアル。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "文を読みますと――スグ丘ノ小屋ノ積藁ノ下ニアル導火線ノ仕掛ヲ取リノゾカナイト、ワガロケットガ、ソノ上ヲ低空飛行シタノチ、一分以内ニ全島ガ爆破スル、注意セヨ。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前五時十五分、北緯三十六度東経百四十三度ノ海上ニアル茨城県湊町在籍ノ鮪船第一｜大徳丸ハ有力ナルＳ国軍用機ノ大編隊ヲ発見ス、高度約二千メートル、進路ハ西南西。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来の右手の小高いところに木造のコロニアル風の洋館があって、それが永いこと貸家になっている。",
              "citation": {
                "source": "牡丹",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "批評は、単に制作の批評であるからばかりではなく、制作とコンジェニアルであることによって、又それ自身かの制作とコンジェニアルな他種類の制作であることによって、制作と内的連関に編み込まれている。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つのものはコンジェニアルなのである。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "――かくて芸術乃至文学と科学とはコンジェニアルなものであることが示されるのである。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "比較的不遇ナ地位ニアルモノデモ、公然ト不平ヲ云ハヌノミナラズ、戦争ノ話ヲスルト忽チ膝ヲ乗リ出スノデアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ニアルハ何ゾ、寺ヲ貴ンデ人ヲ貴バザルナリ。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "述斎は上遊客文」に曰く、「ソレ我ガ上ノ勝ハ桜花ニ非ズシテ実ニ緑陰幽草ノ候ニアルヲ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生男典ニイツテ曰ク墳墓ノ異郷ニアルハ子孫ノ累ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「別墅ノ谷中ニアル者園ヲ賜春ト名ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "多ク春花ヲ植ヱ、氷川ニアル者園ヲ錫秋ト名ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧山が『老子講義』六巻の自序に、「始余ノ昌平黌ニアルヤ寺門静軒マサニ駒籠ヲ去ラントシ、余ニ講帷ヲ嗣ガンコトヲ勧ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕山は「遺居イヅレニアルヤ草荒涼タリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余南中ニアルコト殆一年ト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余モマタ家慈ニ向ツテ頻ニ阿爺ニ見ユルコト何ノ日ニアルヤヲ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモソノ幽囚ニアルヲ知ラザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊著ヲ得テ一読シトミニ二｜豎ノ体ニアルヲ忘ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
