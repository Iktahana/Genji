          "literary": [
            {
              "text": "文子、庭箒を持つて現れる。",
              "citation": {
                "source": "隣の花",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し翌日は尾を下げた犬のやうに人眼を忍んで裏木戸をあけ、まづ庭箒を持ちだして、部屋の方へ背を向けながら庭の片隅を掃いてゐた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると坊さんはちよつと足を止めて、木の葉をはき集めるのに使う、ありふれた庭箒が壁に立てかけてあるのを見た。",
              "citation": {
                "source": "とけない問題",
                "author": "THE INSOLUBLE PROBLEM",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
