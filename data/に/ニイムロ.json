          "literary": [
            {
              "text": "此日神を請ずる家が「新室」と称へられた。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮廷の新室｜寿きなる大殿祭・鎮魂祭・新嘗祭などに来る異装人、又は、京都辺の大社、平野・松尾などの祭りに参加する山人なども、一つ者であつて、山の神人だ。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋祭りなる新室ほかひがすむと、直に翌日から春になつた。",
              "citation": {
                "source": "村々の祭り",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "春祭りのとりこしもあるが、冬の月次祭出のものもあり、新室ほかひに属するものもある。",
              "citation": {
                "source": "ほうとする話",
                "author": "祭りの発生　その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室のほかひに来た神と神に仮装した後代の番匠との聯絡が忘れられて、飛騨の匠や竹田の番匠など言ふ、建築の名人の名を神に代入したのである。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから其が、宮殿を褒める時の詞とか、新室ほかひの時の詞として、使はれてゐるのである。",
              "citation": {
                "source": "神道に現れた民族論理",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「見立て」の考へは、祝詞の考へ・新室のほかひの考へ・大殿ほかひの考へと、互ひに聯関してゐるものであつて、殊に其中心勢力になつてゐるものは、祝詞であるから、祝詞の研究を十分にしたならば、今まで解けなかつた、神道関係の不可解な事も、存外、明らかに釈けて来さうに思ふ。",
              "citation": {
                "source": "神道に現れた民族論理",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、新嘗祭の新室も、一言呪言を唱へて、其で、新室と信じきつて居つた。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室を蹈靜子が手玉鳴らすも。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "手玉を纒いた人が、新室の内の精靈を踏み鎭めて居る樣である。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室のほかひについて言うて置かねばならぬ事は、其が臨時のものか、定例として定期に行うたものかと言ふ事である。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室と言へば、新しく建築成つた時を言ふと思はれるが、事實はさう簡單な事ではなかつた。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈良朝の文獻をすかして見る古代の新室のほかひは、必しも嚴格に、新築の建物を對象としては居ない樣である。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "舊室に對しても、新室と呼ぶことの出來た理由があるのだと思ふ。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "半永住的の建て物を造り出す樣になつた前に、毎年、新室を拵へた時代があることが推せられる。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室と言ひでふ、苫を編み替へ、竪薦を吊り易へ、常は生きみ靈の止る處なる寢處を掃ふ位で新室になるのであらう。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、新室づくりの日は生きみ靈を鎭める必要がある。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も其が、徹頭徹尾、建て物と關聯して居る處から、新室のほかひと言へば、必、家人殊に家長の生命健康を祝福することになつたのである。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろ式の住宅が段々とのに替つて來ると、新室と言ふ語のままに、或は大殿など言ふ語を冠したほかひとなる。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞の意味の新室でなく、舊建物のまゝほかひを繰りかへす。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "まれびとの來るを機會に、新室のほかひをすることは、刈り上げ後にも行はれたと見える。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "適、縮見屯倉首、新室の縱賞して、夜を以て晝に繼ぐに會ふ。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "（顯宗紀）とあるのは、新甞にも新室が附帶する證據である。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "允恭紀の七年冬十二月朔日、「新室に讌す」とあるのも、時から見れば新甞の新室である。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新甞屋」と言ふのも、別に新甞の物忌みに室を建るのではなく、新室の事を言ふのである。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "其は、秋の祭り即新甞の行事が、概して、春祭りよりは、新室ほかひを伴ふ事多く、又、其が原形だと思はれる點から言ふ事が出來る。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "新室ほかひは、吉事祓へとしての意味を完全に殘して居る。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
