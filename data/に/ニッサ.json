[
  {
    "uuid": "5f34de4e-2bdd-510d-87de-76e09d966d99",
    "entry": "日差",
    "reading": {
      "primary": "にっさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは靜に差した明るい秋の日差の中に涙の熱くなるやうな努力に見えた。",
              "citation": {
                "source": "畫家とセリセリス",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼りなげな午後の日差しが靜かに林の中に落ちてゐる。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧牛の群は既に影を潜めて、緑の草原の上には日差しが斜めになつてゐた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪もよいの空ではあるが、日差しに張りのある初春の或る朝であった。",
              "citation": {
                "source": "酋長",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　我々はできるだけ早く階下に降りて、外の明るい朝の日差しを浴びた。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒れ地ではハリエニシダが一面花盛りで、春の明るい日差しを浴びて燦爛と輝いている。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かくも日差しが強くては、何も期待できない。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三が寝起きしている離れの前には、愛らしい百日草が咲き盛っていたが、夏らしい日差しの底にどこか薄い陰影があって、少しでも外気と体の温度との均衡が取れなくなると、彼は咳をした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "細かい羽虫が軒端に簇がっていて、物憂げな十時ごろの日差しであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の日差しの暖かい静かな町へ、二人は時々散歩に出かけたが、庸三に寄り添って歩いている葉子はとかく神経的な感傷に陥いりがちで、鈍感な彼に何かを暗示するような謎の言葉をかけることもあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "欄千の日差はやがて正午に近いといふ事を知らした。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "棠軒公私略に「同（十一月）十六日朝四時過遂に御卒去被遊候、尤発表は翌十七日差出」と記してある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「表発は八日差出す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "初夏の日永の頃だから、日差から判断して見ると、まだ四時過ぎ、おそらく五時にはなるまい。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日差配人が談判に来た。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の八時頃にコツコツ戸を叩いて這入って来た――例のペンが――今日差配人が四度来たという注進だ。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日もまた透き通るような日差を眼に受けて、晴々しい空気を篏硝子の外に眺めた彼の耳には、隣りの洗濯屋で例の通りごしごし云わす音が、どことなしに秋の情趣を唆った。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "来週から先日差入れの本にとりかかる。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、京染屋のお内儀の話によると、玉村という男の引っ越しの時には、別に運送屋が来た様子はなく、本人はトランク一つもってタクシーで行ったきりで、その翌くる日差配が来て貸家の札をはって行ったということであった。",
              "citation": {
                "source": "私はかうして死んだ！",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "藍碧の海をへだてて長く突出した緑色の岬の端には、眼の醒めるような一群の白堊館が、折からの日差しに明々と映えあがる。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "斑な禿山の上には、何に驚いたのか鴉の群が、折からの日差しの中に慌だしく舞い上り、そしてその岬の彼方の沖合には、深谷氏の片足をもぎ取った奴であろう、丈余に亙る暗灰色の大｜鱶が、時々濡れた背中を鋭く光らしながら、凄じい飛沫を蹴立てて疾走していた。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もはや午後の日差しがうっすら淋しく大道にかげり、空風があちらこちらに埃を吹き上げている。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄な日差しのむずかゆい様な日に午後から来たＨは、両親とも留守だったんで千世子と二人で洋館に居た。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体に秋の中頃の黄色っぽい日差しで四方には何の声もしない。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色な日差しがわびしげに四辺にただようて、骨ばかりになった、木の影は、黒い線の様になって羽目にうつって居る。",
              "citation": {
                "source": "霜柱",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、「日本資本主義発達史講座」の件に関し、昨日編輯会議を開き、先日差上げたる私案及び貴店編輯部案を参酌して大体のことを決定｜仕り候間諸種の点に関し御懇談仕りたく、御多忙中恐縮に存じ候得共、御序の節にでも御来駕を煩わし得れば幸甚に御座候処御都合如何に御座候也。",
              "citation": {
                "source": "岩波茂雄宛書簡",
                "author": "一九三一年八月十七日",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい、一昨日差押えられました」「うむ」　支倉の眼は怪しく光った。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきりした日差しに苔の上に木の影が踊って私の手でもチラッと見える鼻柱でも我ながらじいっと見つめるほどうす赤い、奇麗な色に輝いて居る。",
              "citation": {
                "source": "秋風",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピッタリと頭の地ついた少ない髪を小さくまるめた青い顔の女が、体ばっかり着ぶくれて黄色な日差しの中でマジマジと物を見つめて居る様子を考えて見ると我ながらうんざりする。",
              "citation": {
                "source": "秋毛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が大嫌いで、どんな土砂降りでもまだ雨の方が好いと云って居る程の私なので今日の鎮まった柔かな日差しがそよりともしずに流れて居るのがどの位嬉しいか知れなかったのです。",
              "citation": {
                "source": "小さい子供",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
