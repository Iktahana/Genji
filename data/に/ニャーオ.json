        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのとき、道ばたで、「にゃーお」と、猫のなき声がした。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「にゃーお」また猫は、道ばたで鳴いた。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへにげこんだのだろうと思っていると、また「にゃーお」と猫はないた。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「にゃーおん」猫はまたないた。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「にゃーお」返事が、同じところからきこえた。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（目玉のようだが、いったいなんだろう）　とたんに、また「にゃーおん」とあまえるような声がきこえた。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミーがニャーオと鳴いた。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫は太郎の胸にしがみついて、ニャーオ……と鳴きました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "名前がわからないので、白いから、かりにチロとよびますと、ニャーオ……と鳴いて、返事をします。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえも、人に盗まれたりなんかしちゃあいけないよ、ねえチロ……」　チロは頭をすりつけて、ニャーオ……と鳴きました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、キシさんのかわりに、ニャーオと……猫が鳴きました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "見たところはカモメのようだが「ニャーオ」といって猫と同じように啼くのさ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "老母の泣いているのがわかるとみえて、ニャーオとなきもせず、ただお察し申しあげますといわんばっかりに、身をすりよせてくるのが、かえってなんともいえず、いじらしく思われます。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その老母をうながすようにめずらしく玉は、ニャーオ、ニャーオと、あまえたように二声三声なきたてました。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニャーオとこんどは玉はいくらか大きな声をあげました。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ニャーオとなきながらそばへよってきた玉の頭をなでながら、「おまえは利巧な猫ですからわかるでしょうが、こよいはわたしも小金吾のあとを追うが、主人がいなくなったからとて、けっしてわたしや小金吾をうらむではありませんよ。",
              "citation": {
                "source": "亡霊怪猫屋敷",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
