          "literary": [
            {
              "text": "國民自由ノ人權ハ生産的活動ノ自由ニ於テ表ハレタル者ニツキテ特ニ保護助長スベキ者ナリト云フモ其四。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ノ實力援助ニツキテ大方針トスベキハ海上ニ於テノミ彼ノ獨立ヲ援護スルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "今彼我ノ二書ヲ比較スルニ東武ノ詩人｜大沼枕山ノ事ニ関シテハ彼ハ我ニ比シテヤヤ簡略ナリトイヘドモ中京ノ詩人｜森春濤ノ事ニツキテハ遥ニ精緻ヲ極メタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「花ヨカラズ最下品ナリ只日ニツキテマハルヲ賞スルノミ」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
