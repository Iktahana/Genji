          "literary": [
            {
              "text": "私ノ中学ノ幾多ノ先輩ガ窮屈極マル――ソレハ日露戦争時代ノ軍事教育ヲ旨トシテヰル老曹長ナル学生監ノ圧迫ガ酷イノデアルタメ――学窓ヲ放タレルト同時ニ急ニ不思議ナ紳士ニナツテ数々ノすきやんだるヲ遺シテヰルノヲ見テモ実ニ寒心ニ堪ヘン次第デアリマス。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシマズ最初ニ新聞ダケデモカタカナニナツテシマエバアトハ割合ラクデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ツテヰル間中、死ンダヤウニナツテヰルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　アヒルサンハ、マツカニナツテイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタノ洋服、青ニデモオソメニナツテハイカガデセウ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オユデ、ウダツタノデ、ジヤガイモサンハイロガマツシロニナツテ、イゼンヨリモ、ウツクシクナリマシタノデ、ミンナオホヨロコビ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコ　ノ　オバアサン村山籌子　タイヘントシトツタオバアサンネコガ、オヒルコロニナツテメヲサマシテ、ベツドノウヘヘオキアガリマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ヒゲナシ　ニナツテオウチ　ヘカヘツテ　来タラオ母サン　ハオドロイテ山羊サン　ヲ叱ツタ　ケド山羊サン　ハ平気ナ　顔ヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナツテ、人参サンハ　ジヤガイモサント、ケンクワヲシテヰルコトヲ思ヒ出シマシタガ、シカタナク、何度モ、ソノコトヲ話ニジヤガイモサンノオ家ノ入口マデ行ツテハ、「エエ、イマイマシイ、ボクノハウカラ、口ヲキイテヤルナンテコトハナイ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ヲトジテヰルジヤガイモサンハ、石ニツマヅイテ、何度モコロンデ、コブダラケニナツテモ　マダマダ、目ガサメナイデ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒニ　テラサレテ　オマンヂウガ　ウマク　ヤケルマデ　ジロウハ　ウマニナツテ　スナノウヘヲ　トホクマデ　カケテユキマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタニナツテ　メガサメマシタガ、ドツチガ、サキニネムツタノカ　フタリトモ　ワカリマセンデシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
