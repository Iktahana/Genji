        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マサカニ兵卒ト同ジキ飮食ニテハ戰爭ニ堪ヘズト云フ者アルマジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近比外国人ハ競テ日本古物ヲ買求ムレバ、此マヽニテ本邦ノ人ガ我ガ古物ヲ愛重スルコトヲ務メズハ、二三十年ノ後、泰西ニテ必ズ日本古物館ヲ建テヽ、却テ我邦ニテハ自国上代ノ物ヲ観ルコト難キニ至ラン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ澳斯太利人ノ言語ニハ、正義、罪業、罪罰ニ對スル言語ナク、人種下等ノ國ニテハ、仁惠、恩徳等ノ事ハ理會スベカラザルノ事トセリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今摸傚ノ弊ヲ矯メムト欲セバ、何如ナル道ニ從事スベキヤト云フニ、余ガ見ル所ニテハ、唯二道アルニ過ギズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔時ハ禽獸ハ唯本能アリテ、智ハ唯人ニノミ存シテ本能ナシト云説ナリケレドモ、近世ノ發明ニテハ、禽獸ノ本能ハ、譬ヘバ書畫ヲ能クスル者ハ、臂ノ神經ニ其作用備ハリ、歌謠ヲ能クスル者ハ、喉ノ作用ニ其作用備ハルガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "口ニテハ他人ト談話ヲナシツヽ、指ニテ之ヲ彈ズルニ、少シモ曲調ヲ失ハザルガ如キ、是其證ニテ、凡此自動力ハ何人ニテモ之ヲ有スル者ニテ、譬ヘバ人ノ一方ニ行カムト欲スルガ如キモ、行カムト欲シテ其方向ヲ定ムル爲ニ、僅カニ思慮ヲ費セドモ、一タビ足ヲ動カセバ、亦意ヲ用ヰズシテ足ヲ動カスガ如シ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ一種輕キ物質ヲ以テ造レル舟ヲ有シ、陸上ニテハ之ヲ荷ヒテ歩ミ、水上ニテハ之ヲ浮ベテ乘レリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小野蘭山は彼れの『本草綱目啓蒙』に「本邦ニテハ食用セズ」と書いて、これは食える物だが日本では食わぬとの意をホノメカシていれど、それは食いたくても食えぬ実であるから誰れも食わない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其頃人丸ハ天皇ヲ始メ女御皇妃ニ交リ歌ノ御師ナレバ、其妻モ同様御所方ニ召サレ候ヘバ、下民ノ娘ニテハ不都合ユヘ、依羅氏ノ義女トナリ玉フトナン。",
              "citation": {
                "source": "人麿の妻",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔武蔵甲斐両国ニテハ国師ヶ岳ト称フ。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "理云、甲州ニテハ三国山ト称スルコト甲斐国志ニ見ユ、蓋シ信府統記ノ著者モ国師甲武信ノ二山ヲ混同セリ。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『武蔵風土記稿』の秩父郡の元禄図は、『信府統記』より三十年も古いものであるが、雁坂峠の書き入れに「此所ヨリ国師岳迄ノ間山国界不知」と記し、甲信武三州の境に「此所峰通国界、但シ信濃国ニテハ大椹峠」と書いてある。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当村ニテハ八日見山ト唱ヘ、又竜神社ヲ祭レル故ニヤ竜神山トモ唱フ、薄村ニテハ両神山ト唱フ、皆文字異ニシテ唱ヘハ同シ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀尾君は、「ゴデンポウリヨコウサキニテハイケン。",
              "citation": {
                "source": "負けない男",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
