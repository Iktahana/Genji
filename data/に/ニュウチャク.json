          "literary": [
            {
              "text": "何しろ、東京の人はこれまで袷で冬を越しているから綿入着物が珍らしく、縫う人はゴテてそれが恥かしくもない顔をしているから毎年私は恐慌をきたしています、九月から頼んで十一月一杯というのが今日もう三日でしょう、ですものね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォーカス番号　番号　姓名　　　人気１　　　　　　　１　　白太郎　　入着ノ見込ミアリ２　　　　　　　２　　田川博一　対抗。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も入着を予想してない選手なんだ。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
