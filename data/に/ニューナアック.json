        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロシアのデカブリストの事件は（一八二五年十二月十四日）、オーエンのニューナアックの仕事へ全ヨーロッパの支配者の目をひきつけた。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューナアックを見学に来たすべての大公、殿下、学者は、オーエンが、北米のラッパイトの村で共産村 New Harmony をつくって失敗したとき、誰が何の力でオーエンを激励したろう。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの或ものは、自分のメモアルの一頁に、オーエンと彼のニューナアックに熱中した頃の自分を皮肉に回想していないと、誰が云えよう。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
