        "examples": {
          "standard": [
            {
              "text": "カメラを向けると、子供たちはレンズに向かってにこっと笑った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女がにこっと笑うと、部屋全体がパッと明るくなるような気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冗談を言うと、気難しそうな上司もにこっと笑ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "にこにこっと笑う笑顔ったらありませんよ。",
              "citation": {
                "source": "林檎",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんに遣うのだと訊くと、にこっと笑う、憎げというものの少しもない、明るく冴え冴えとした顔で、こっちの眼を真正面に見ながらにこっと笑う、この笑い顔を見せられると、せっかくしかんできた眉が思わず解けそうになる、そこで慌ててむりにむずかしい顔をする。",
              "citation": {
                "source": "明暗嫁問答",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸江が、にこっと笑う。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
