      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "day-by-day renewal",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "科学技術は日新の勢いで進歩しており、一年前の常識がすぐに通用しなくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「日々これ新たなり」の精神で、常に日新の工夫を凝らすことが成長の秘訣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "創業当時の苦労を忘れず、組織が日新の活力を保ち続けられるよう努力している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "孤高｜狷介のこの四十歳の天才は、憤ってしまって、東京朝日新聞へ一文を寄せ、日本人の耳は驢馬の耳だ、なんて悪罵したものであるが、日本の聴衆へのそんな罵言の後には、かならず、「ただしひとりの青年を除いて」という一句が詩のルフランのように括弧でくくられて書かれていた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和四年一月『東京朝日新聞』）",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年八月二十四日『東京朝日新聞』）",
              "citation": {
                "source": "天河と星の数",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十二月十四日『東京朝日新聞』）",
              "citation": {
                "source": "宇宙の二大星流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年八月十八日『東京朝日新聞』）",
              "citation": {
                "source": "蚊帳の研究",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年八月三十日『東京朝日新聞』）",
              "citation": {
                "source": "汽船の改良",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十月七日『東京朝日新聞』）",
              "citation": {
                "source": "写真電送の新法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年五月二十八日『東京朝日新聞』）",
              "citation": {
                "source": "相撲と力学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年八月二十六日『東京朝日新聞』）",
              "citation": {
                "source": "卵の形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年九月二十一日『東京朝日新聞』）",
              "citation": {
                "source": "天然色写真新法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月一日『東京朝日新聞』）",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年八月二十八日『東京朝日新聞』）クロロホルムの作用　近頃英国で犬にクロロホルムを種々な方法で与えてその作用を試験した人がある。",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年八月三十日『東京朝日新聞』）発電所は難破船　メキシコの南隣グァテマラの西海岸の一小市で近頃電灯を点ずるようになったが、その中央発電所は同市の海岸近くに坐洲したドイツの汽船である。",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月六日『東京朝日新聞』）狐と鱗片　四足獣で鱗のあるものは珍しい。",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月七日『東京朝日新聞』）空中飛行の将来　フランスから英国まで海を超えて飛行する事の出来たものには一千ポンドの賞金を与えると申し出した人がある。",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月十六日『東京朝日新聞』）",
              "citation": {
                "source": "「万年筆」欄より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年九月十七日『東京朝日新聞』）",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年四月十日『東京朝日新聞』）",
              "citation": {
                "source": "雪の話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十月一日『東京朝日新聞』）",
              "citation": {
                "source": "ムーア灯",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年七月十五日『東京朝日新聞』）二　室内用として最も広く用いられるのはやはり白熱灯である。",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年七月十六日『東京朝日新聞』）",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和九年一月『大阪朝日新聞』『東京朝日新聞』）",
              "citation": {
                "source": "猫の穴掘り",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和九年七月『東京日日新聞』）",
              "citation": {
                "source": "ピタゴラスと豆",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十年二月『東京朝日新聞』）",
              "citation": {
                "source": "凍雨と雨氷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日新派といわるる人々と正岡君の和歌との関係ですか、僕の考えでは与謝野一派、竹柏園の一流、その他｜尾上、金子などの一流とすなわち今日のいわゆる新派とはほとんど関係がないと思います、第一趣味の根底が違ってますからね。",
              "citation": {
                "source": "子規と和歌",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十三年九月『東京日日新聞』）",
              "citation": {
                "source": "流言蜚語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月十二日『東京朝日新聞』）　　　　　　　　　二　　　　　　一葉『淮南子』には一葉落而知天下秋とあるが、植物学者に聞いてみると、木の葉が夏過ぎて落ち散るのは葉柄の根元の処にコルク質の薄い層が出来てそこだけ脆くなるから少しの風にでも誘われて天下の秋を示すものだそうだ。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月十三日『東京朝日新聞』）　　　　　　　　　三　　　　　　露　夜地上の草木土石が冷えて空気よりも冷たくなると、空気中の湿気が持ち切れなくなって露と結ぶ。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十一年九月十七日『東京朝日新聞』）　　　　　　　　　四　　　　　　鳩吹　古書には「鳩をとるとて手を合せて鳩の声のようにふきならすなり」とある。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
