[
  {
    "uuid": "476def07-b024-52a8-8689-dad10d9a7d47",
    "entry": "荷造り",
    "reading": {
      "primary": "にづくり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "packing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "引越しの前日は、たくさんの荷造りに追われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行の準備として、早めに荷造りを済ませた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "荷造りが終わらないと、出発できないよ！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "戀や結婚と同じやうに、出發の前に荷造りされてる、人生の妄想に充ちた鞄である。",
              "citation": {
                "source": "大船驛で",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、親爺と二人で、荒蓆で荷造りをした、その荷物の上に腰かけていた。",
              "citation": {
                "source": "入営前後",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜の直方発の終列車の上りの客車便に……そう……十時五十分に間に合うように大急ぎで荷造りしてちょうだい。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十分に荷造りしてね。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷造りする時には倉庫の明りが外に洩れないようにしとかなくちゃ駄目よ。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝押し入れから蒲団や行李を引き出して荷造りをしている間にも、宿を移ったとて私はどうなるだろうと思う。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ね」　男は、荷造りの手をまた止めた。",
              "citation": {
                "source": "窓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「…………」「…………」　男はまた力なく、荷造りを始めた。",
              "citation": {
                "source": "窓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、これを入れれば、すっかり荷造りが出来るんです、けど、も一度……」　女は、男の抱えている書物をみつめた。",
              "citation": {
                "source": "窓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうやって荷造りなんかしたっても、あなたに離れて行くことなんか、とても出来ない」「…………」「ね、も一度、おもい返して呉れない。",
              "citation": {
                "source": "窓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の荷造りもすっかり終った。",
              "citation": {
                "source": "窓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その六十里の海岸を町から町へ、岬から岬へ、岩礁から岩礁へ、海藻を押葉にしたり、岩石の標本をとったり、古い洞穴や模型的な地形を写真やスケッチにとったり、そしてそれを次々に荷造りして役所へ送りながら、二十幾日の間にだんだん南へ移って行きました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎年旅館は決まっていて、六月の半ば過ぎになると、早くも幾梱かの荷物が出入りの若衆の手で荷造りされ、漬物桶を担ぎ出さないばかりの用意周到さで同勢上野へ繰り出すのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　気の早い銀子の父親が、話がきまるとすぐ東京へ飛び出して行き、向島の請地にまだ壁も乾かない新建ちの棟割を見つけて契約し、その日のうちに荷造りをしてトラックで運び出してしまい、千葉を引き払った銀子たちがそこへ落ち着いたのは、夜の八時ごろであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫌いというわけではないが、荷造りや旅費の計算が面倒であり、それに宿屋に泊ることが厭だからだ。",
              "citation": {
                "source": "秋と漫歩",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すつかりと荷造りされたる思想の前に、言葉が逡巡して進まないといふやうな、我等の鬱陶しき日和の多いことよ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦場のような騒ぎはまた荷造りにある。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸太の截断から、この荷造りまで、果して何分間を要したであろう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」二人は蝋燭の灯の下にこゞまつて、こんなことを言ひながら一つの荷造りをといて、時計の函をすつかり取り出し、それを又一つにしばつて、片わきへ、おいといて出て行きました。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから毎晩半徹夜の努力を払って自ら石膏の型を取り、自身に荷造りして即刻東京に持帰る途中、岡山で土台石まで自身に選択し、東都で自身監督の下に鋳造させるという感激振りを示した。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、梅田新道にある柳吉の店の前を通り掛ると、厚子を着た柳吉が丁稚相手に地方送りの荷造りを監督していた。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその旨妻に報告すると共に、翌日から荷造りにかゝつた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "木槿の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "業腹ながら爺さんの言葉通りに、荒壁の上塗だけは越してから塗ることにして、九日曉荷物を運び込む故、疊だけは必ず敷いておいて呉れ、と固くも頼んで、看護の片手間にこそ／＼と荷造りにかゝつた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "木槿の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにまた、庭の井戸のなかへ投げこもうかとも――商品のように箱のなかへ入れて普通やるように荷造りして、運搬人に家から持ち出させようかとも、考えてみた。",
              "citation": {
                "source": "黒猫",
                "author": "THE BLACK CAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷造りも昨夜かたづけた。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お昼ごろ、連の人と頂きました花瓶なんですがね、可なり大きさのあるこわれものですから、お店で、すぐ荷造りをして頂くか、それとも一旦、宿の方までお受取りしようか、……とにかく、もう一度うかがう事になっていました……」「はあ、いえ、それでございますがな。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こころを　きめた　ババールは、　あわてて　にづくりの　おてつだいに　セレストを　よびまして。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
