    },
    "grammar": {
      "pos": [
        "動詞-五段-ウ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be fragrant",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "窓を開けると、庭のクチナシの花が甘く匂ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お茶会で出された抹茶は、深い緑の香りが芳しく匂っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕暮れ時の散歩道で、どこからかジンジャーリリーが白く匂い始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "新古今集の和歌は、亡び行く公卿階級の悲哀と、その虚無的｜厭世感の底で歔欷しているところの、艶に妖しく媚めかしいエロチシズムとを、暮春の空に匂う霞のように、不思議なデカダンスの交響楽で匂わせている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ノ池の方に廻る、池には石が座榻のように不規則に、水面に点じている、岸には淡紅の石楠花が水に匂う、蛇紋が掻き破られて、また岩魚が飛ぶ、石楠花の雫を吸っている魚だから、腸まで芳芬に染まっていないかとおもう。",
              "citation": {
                "source": "梓川の上流",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんこん匂う薄荷が眼鼻に沁み渡ると小初は静かにもう泣いていた。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はロダンさんと、花匂うモナコの浜に沿って、心の悲劇を象徴するような大寺院の賭博場に向って、馬車を走らせました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎は、アカシヤの葉がのび、白い藤のような花がなまめかしく匂う通りを、気｜慌しげに往き来した。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学の地下に匂う青い花、こそばゆい毒消しだ。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "籔蔭に早咲きの梅の匂う浜田圃の畦を散歩しながら、私は良人が延ばしていた前の妻の墓標を建てることや、珪次の学費の補助のことや、感傷や遠慮を抜いた実質的な相談をしました。",
              "citation": {
                "source": "扉の彼方へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷畑から採って来た鮮かな山葵の束が縁につけてあるのがくんくん匂う。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「桔梗家へ行けば、鶴雄さんに会える……」　君勇は匂うばかりにはにかみながら、「ほなお受けさせて貰います」　と言った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "初々しく可憐な鈴子が、清楚な花のように匂うばかりにはにかんで、小郷の前に坐った時、小郷は、「ほう……」　と、眼を細めてしまった。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉が死んだのは、忘れもしない生国魂神社の宵宮の暑い日であったが、もう木犀の匂うこんな季節になったのかと、姉の死がまた熱く胸にきて、道子は涙を新たにした。",
              "citation": {
                "source": "旅への誘い",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "後年成長した豹一が毎年木犀の花が匂う頃になると、かっと血が燃えて来るような想いで頭に浮んで来る冬を想わすような寒い秋の日であった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "木犀の花が匂う頃死ぬと決めていたのに危く助かった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔬菜の浅黄いろを眼に染ませるように香辛入りの酢が匂う。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すみれ草が甘く匂う。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳格清澄なかの女の母性の中核の外囲に、匂うように、滲むように、傷むように、規矩男の俤はかの女の裡に居た。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫｜匂う藤沢の、野面に続く平塚も、もとのあわれは大磯か。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「や、蕎麦｜掻を……されば匂う。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、そのあとは急に良き醤油に山椒の芽の匂う鯛の兜焼が食べたくなり、洋間の中に青竹の欄干の小座敷がしつらえてある和食の料理店へ河岸を替えます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見栄も外聞もなく加奈子に委せ切った様子が不憫で、また深々と抱き寄せる加奈子の鼻に、少し青くさいような、そして羊毛のような、かすかな京子の体臭が匂う。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮坂があのほろ苦い理智の匂う独逸の作家の名を挙げて「僕のはトーマス・マンのに一番似ているね」そういうときは如何にも嬉しそうだった。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その匂うばかりの美しさ！",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏にはレモンの花が匂う。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「例えば……」そう云いかけて、たちまち頬を赤くしたかと思うと、匂うほど、女になってしまうのだった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "其所からは強い刺戟性を帯びた香料の匂が匂うて来た。",
              "citation": {
                "source": "黒い蝶",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女を招聘するために佐古が惜し気もなく使った機密費の額に最初文句をつけ通しだった経営者も、純白のイヴニングの裾さばきも軽やかな、匂うばかりの村口多鶴子を見た途端、慾も得も忘れてしまった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "花の咲いた藤が一面に這うて、花の香がむっと匂うてきた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い出してみたまえ、お嬢さんの話では、姉がロイロット博士の煙草が匂うと。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草の薫が来たあとへも、ほんのりと残りそうで、袖にも匂う……たまさかに吸ってふッと吹くのが、すらすらと向うへ靡くのに乗って、畷のほの白いのを蹈むともなしに、うかうかと前途なるその板橋を渡った。",
              "citation": {
                "source": "遺稿",
                "author": "遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなに逢った」　お絹はしばらく黙って俯向いて、油の匂う枕をうっとりと見つめていた。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
