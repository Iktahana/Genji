        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "魚屋はその荷籠から刺のある甲羅を被たこの蟹をつまみ出しながら言った。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "禿頭の親爺がピンピンして頑張っておりましたので……その親父が引いてくれた魚類の荷籠に天秤棒を突込んで、母親が洗濯してくれた袢纏一枚、草鞋一足、赤褌一本で、雨風を蹴破ってワアッと飛出します。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "孫子の代まで生物は売らせまいと思い思い空になった荷籠を担いで帰って来ます。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "山本屋の門には火屋なしのカンテラを点して、三十五六の棒手振らしい男が、荷籠を下ろして、売れ残りの野菜物に水を与れていた。",
              "citation": {
                "source": "世間師",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後五六日を経て明石の町より、天ぷら蒲鉾など小さき荷籠に入れて、舞子のあたりまで売り歩行く子供あり。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬はずぶ濡れで、広い背中に荷籠を二つ乗せていた。",
              "citation": {
                "source": "千里眼の村",
                "author": "クリスマス・ストーリー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
