        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ノチノショウコニ、ワガ足ノ傷グチカラ、破片ヲヌキダシ、コノ缶ニイレテオク。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ムラオヲ、ジッケンシツニイレルナ。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ大ヘンヨロコンデ、ボンコチヤンノリボンヲ前ヨリモモツトモツトキレイナノニトリカヘテ、キレイナ桃色ノ箱ニイレテ、空色ノリボンデソノ箱ヲシバリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨガ　アケルト　ブチト　シロハ　オユニイレラレテ　ゴシゴシト　アラハレマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "グヅグヅ　シテヰルト、マタ　オユニイレラレルゾ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ近頃家ニイレバ大体イツモコノ時刻ニシャワーヲ浴ビルコトヲ予ハ知ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州の方でも彦山の周囲の村などでは、赤ショウビンをニイレという方言があり、この鳥が人家に入れば死人があるといった。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイレという語の語義は明かでないが、沖縄諸島にはニイラ・ニライまたはニラヤという語があって、いわゆる根の国を意味し、また竜宮の代りにも用いられる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
