        "examples": {
          "standard": [
            {
              "text": "かわいいにゃんが、日向で気持ちよさそうに寝ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「うちのにゃんは、もう10歳だよ」と友人が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "道端で迷子のにゃんを見つけたので、保護した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
