[
  {
    "uuid": "8dcd0475-8714-566f-a633-a7b145c7a5cc",
    "entry": "ニヤリ",
    "reading": {
      "primary": "ニヤリ",
      "alternatives": [
        "にやり"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "meaningfully (smiling, grinning, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は意味ありげにニヤリと笑うと、部屋を出て行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私の質問の意図を察した彼は、ニヤリとして何も答えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「これで計画通りだ」と彼はニヤリとつぶやいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "パパハ乙吉ニヤリマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見て鉄五郎が三次を見てニヤリと笑った。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供はじっと私の顔を見つめていましたが、やがてニヤリと笑いました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、「六さん、お早う」と声をかけましたが、子供は私の顔を見てニヤリ笑ったまま、草ぼうきで落ち葉を掃き、言葉を出しませんでした。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか診察を受けに行ったときに、先に来ていた一学生が貰った処方箋を見ながら「また、杏仁水ですか」と云ってニヤリとした。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "めいめいがそれを小脇に引っかかえて路地を出てゆくうしろ姿を、おまきは見送ってニヤリと笑った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とて越中が頭を撫でゝ見、舌赤くニヤリと笑ひ、人さし指に鼻油を引て、しつぺい張んと歯噛をなし立上りし面貌――と云々。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見る端に、前歯の抜けた、汚い口でニヤリとした。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏元はさてこそと腹の中でニヤリと笑った。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、その主任の教授にぴったり寄り添って腰かけて、いかにも、どうも、軽薄に、ニヤリと笑っている生徒が私だ。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とても厳粛な筈の記念撮影に、ニヤリと笑うなどとは、ふざけた話だ。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "撮影の前のドサクサにまぎれて、いつのまにやら、ちゃんと最前列の先生の隣席に坐ってニヤリと笑っている。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニヤリとして言った。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　というと、艶やかな歯でニヤリと笑む。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　巡査は鼻の先でニヤリと薄笑。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　襟の辺を引掻くと、爪を銜える子供のように、含羞む体に、ニヤリとした、が、そのまま、何を噛むか、むしゃむしゃと口舐ずる。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、其魔ものとはどんなものか、と突懸つて訊きますと、其の盲人ニヤリともせず、眞實な顏をしまして、然れば、然れば先づ、守宮が冠を被つたやうな、白犬が胴伸びして、頭に山伏の兜巾を頂いたやうなものぢや、と性の知れぬ事を言ふ。",
              "citation": {
                "source": "三人の盲の話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ツて、ニヤリと茶色の齒を見せて笑つたさうです……（可い所とは何だ無禮な、急病人があると云ふのに、）　と極めつけますとね。",
              "citation": {
                "source": "淺茅生",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ニヤリニヤリと笑う。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……幾干か小遣があると見えて、時々前垂の隙間から、懷中を覗込んで、ニヤリと遣る。",
              "citation": {
                "source": "松の葉",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　水ぶくれの按摩の面は、いちじくの実の腐れたように、口をえみわって、ニヤリとして、ひょろりと立った。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　とすくすくと鬚の生えた、山猫のような口を突出し、対手の耳に囁くと、伝九と呼ばれた一｜人は、歪めて聞いていた面に、もっての外な、ニヤリと笑む。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔的に警察に忍び込んで、署長どのの鉛筆の尖を鋭く針のやうに削つて、ニヤリとしたのがある、と言ふ談話をされた。",
              "citation": {
                "source": "番茶話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "開いて垂れると、舌を出したやうに見えて、風呂敷包が甘澁くニヤリと笑つた。",
              "citation": {
                "source": "露宿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、折からのたそがれに、瀬は白し、氣を籠めて、くる／＼くる、カカカと音を調ぶる、瀧の下なる河鹿の聲に、歩を留めると、其處の釣人を、じろりと見遣つて、空しい渠の腰つきと、我が獲ものとを見較べながら、かたまけると云ふ笑方の、半面大ニヤリにニヤリとして、岩魚を一振、ひらめかして、また、すた／＼。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とニヤリとして、「ちゃっとお拭きなされませい。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　と、うしろから、拳固で、前の円い頭をコツンと敲く真似して、宗吉を流眄で、ニヤリとして続いたのは、頭毛の真中に皿に似た禿のある、色の黒い、目の窪んだ、口の大な男で、近頃まで政治家だったが、飜って商業に志した、ために紋着を脱いで、綿銘仙の羽織を裄短に、めりやすの股引を痩脚に穿いている。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "獺橋の婆さんが、まだ火のない屋台から、顔を出してニヤリとした。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
