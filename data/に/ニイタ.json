        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "永久ニ、コレハ、許サヌコトニイタシマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツエイハンイハ、ヒジリバシヨリスイドーバシニイタルソトボリエンガン一タイ。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョウジョウネコ　ホホールト　ホール　トッピャッピ　オカザキ　デコデンデン（前掲）　ダンコクサイ（又はダンゴグサイ）　ゾンゾロシガ　シルコラタレ・タータ　チトラル（前掲）　ドコニイタイタ　ドコニウ　以上で全部である。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドコニイタイタ」は獅子がササラッ子の中に隠れた段に発せられ、「どこに行った行った？",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "牝獅子隠しの段で、獅子がササラッ子のマン中へ隠れ、牡獅子が探しまわるときに、音譜は「ヒ、ヒヤ、ドコニイタイタ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヒヤ、ドコニウ、ヒヤヒヤ」　と綴られており、「ドコニイタイタ」は「どこに行ったか行ったか」であろう。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝永六年（1709）に発行になった貝原益軒の『大和本草』巻之七に蛮種としてこの名の植物が出で「三月下種苗生ジテ後魚汁ヲソヽグベシ此種近年異国ヨリ来ル花ハ山吹ニ似テ単葉アリ千葉アリ九月ニ黄花開ケ冬ニイタル可愛」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、モシ予トオ静トガ打ツカラナカッタラ、予ニ知レタコトヲ彼等ハ気ヅカズニイタデアロウ、トスルト、オ静ガ予ト行キ遇ッタコトハ、マダシモ仕合セダッタト云エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ日曜デ、百貨店勤務中ノ菊太郎ハ不在ダケレドモ、京大工科ニ通学中ノ京二郎ハ家ニイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻モモウ起キテ茶ノ間ニイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モマダ寝床ニイタガ、彼ノ声ガスルノデ起キテ茶ノ間ニハイルト、「先生、オーケーデス」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時僕ガ寝室ニ入ッタ※ハ彼女ハスデニベッドニイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲州街道の黒野田・北多摩郡の大岱などの類は数多く、怒田という字を宛ててもいるから、ヌタというのが普通だったらしいが上州の下仁田だの伊豆の仁田四郎だのと、特に新田のニイタと差別しようとしたニタもある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ人必ズ七日ノ後、マサニ是ノ如キ快楽ト眷族ヲステ、決定必ズ死ニイタルベシ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "成敗利鈍ニイタリテハ、臣ガ明ノヨク及ブトコロニ非ザル也。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツテノ執権、最明寺時頼ノ母スラ、自ラ破レ障子ヲ繕ウテ、勤倹ノ教ヘヲ垂レタリト聞クソノ松下ノ禅尼ノ子孫高時、今ハ数十人ノ妾ヲ蓄へ、妾ニハ領地ヲ分カチ、白拍子、猿楽、田楽俳優ナド、府内二千人ヲ超ユルニイタル。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は憤慨して、「オ酒ヲ飲ンダトキハ男女性ニカカワラズ、カナラズカガンデ用ヲ足スコトニイタシマショウ」とマジック・インクで大きく紙に書いて正面の壁に貼った。",
              "citation": {
                "source": "愛のごとく",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
