        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さて、それから、ニットーコーナハウスでお茶をのみつゝ、寄席へでも行かうか、それとも浪花節でもあればと、眼を使はないことを考へてみるが、何うにもいゝ知恵が無い。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニットーコーナハウスで京極と会ひ、コロムビアへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼の終り、松平晃と天ぷら、ハゲ天へ行き、ニットーコーナハウスで紅茶。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニットーコーナハウスで、ライスカレーを食って座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
