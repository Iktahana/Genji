    "definitions": [
      {
        "index": 1,
        "gloss": "unpacking (esp. after moving house)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
