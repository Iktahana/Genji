        "examples": {
          "standard": [
            {
              "text": "この端子は、データ入力用にのみ使用され、出力はできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "入力用デバイスは、ユーザーからの情報をコンピュータに伝える役割を果たす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロジェクトでは、生データの保管のために専用の入力用フォルダを作成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「マウスと呼ばれる簡単な入力用具を使い、実際に画用紙の上で絵を書くように手を動かすというもので、我が国でも珍しい」と書いてある日本経済新聞は三月二十日付けであるところを見ると、エイプリルフールの冗談というわけでもないらしい。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえて言えばアルテアは、押し入れの奥から引っ張り出してきた八ビットのパーソナルコンピューターから基板だけを抜き出し、メモリーのあらかたを捨て、周辺機器を接続するインターフェイスも取りはずし、代わりに入力用のスイッチと小さなランプだけを取り付けたような代物だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
