  {
    "uuid": "5750ea72-7df7-5a7a-a6f0-2bba014dfd54",
    "entry": "睨み付ける",
    "reading": {
      "primary": "にらみつける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "下一段-カ行",
