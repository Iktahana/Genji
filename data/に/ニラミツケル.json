    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "船長は周章てゝ起上つたが、怒氣滿面、けれど自己が醜態に怒る事も出來ず、ビール樽のやうな腹に手を當てゝ、物凄い眼に水夫共を睨み付けると、此時私の傍には鬚の長い、頭の禿た、如何にも古風らしい一個の英國人が立つて居つたが、此活劇を見るより、ぶるぶると身慄して『あゝ、あゝ、縁起でもない、南無阿彌陀佛！",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "剛坂金蔵、名前からして何だか物々しくきこえるが、忠実で善良で非常にやかましい老人で、少しでも気に食わないことがあると、だれかれの容赦なしに睨み付ける。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "患者のヌルヌルした涎だらけの唇の左右へ、拇指を容赦なくグイグイと突込んで、左右の顎の骨を両手で力強く引っ掴んだが、そのまま患者のヒンガラ眼を覗き込むように睨み付けると、室中に響き渡るような大きな声で怒鳴り付けた。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、今一人の自分自身としか思えないほど私によく肖通っている窓の外の青年、呉一郎の立っている姿を、何等の恐怖も感じないままに、今一度冷然と睨み付ける事が出来た。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "睨み付けるのも無理はない。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに船が居ないから貴様達に違いあるまい」と睨み付けると頭を掻てセセラ笑いながら「そんなら舟を陸に着けますから一つ調べておくんなさい」と来る。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちへ連れて来い」　と云って睨み付けると、今にも斬られそうな殺気に打たれたらしい。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お春は、ちょっと見たところこう気むずかしそうな娘で、平常店の若い番頭や手代の顔を睨み付けるような眼付をしていたが、しかしそれは彼女が普通の下女奉公と同じに見られまいとする矜持からであった。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "双方ピッタリ合青眼、相手の眼ばかり睨み付ける。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、彼は立上り、怒つた眼で院長を睨み付ける。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、彼は立上り、怒った眼で院長を睨み付ける。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
