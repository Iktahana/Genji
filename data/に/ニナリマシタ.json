        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "水産翁、轟雷雄先生ガ免職ニナリマシタ裡面ニハ、国家ノタメニナラヌ重大秘密ガアリマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ日ノ夜、二人ノ話デ確信スルヨウニナリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデ愛シニ愛シタ女ガ、ネマキ一ツデ顔ニ傷ヲ受ケテ倒レテイル姿ヲ見テ急ニ惨忍ナ気持デ一杯ニナリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ屍体ハ油倉庫ノ中ニ投ゲ入レラレ、放火サレタカラ灰ニナリマシタ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キノフノバン、私ノウチノ地下室ニトマツタ玉ネギサンガ、行方不明ニナリマシタ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、大変ナコトニナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　シカタガナイノデ、ユカノウヘニスワリマシタラ、洋服ガドロダラケニナリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウガタニナリマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人ハ　コンナワケデ、一シヨニマチヘ行ツタノデ、ソノ時カラコツチ、人参ト玉ネギトジヤガイモハ　イツモ一シヨニオ料理サレルヤウニナリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハモンコチヤンノトコロヘ　カヘツテ来ルト、スグニ、クシヤミガトマツテ、モトノヤウニ元気ナボンコチヤンニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンノアタマニデキルダケカツカウヨクカブサリマシタカラ、ソレハソレハヨクニアフヨウニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンモ　オカアサンモオゲンクワンノ　トコロデ、マッテ　オイデニナリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――家ガ仲ノ町デ、引手茶屋ヲシテイマシタカラ……　――ソレガ、ドウシテ、後ニ、赤坂ダノ、葭町ダノヽ住人ニナリマシタカ？",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハネエチヤンニ、「ネエチヤン、アノウサギノミミヲ立テテ下サイ」トイヒマシタノデ、ネエチヤンハ足デウサギノミミヲツマンデ、立テテオヤリニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエチヤンハ「オカシナミミデスネ」トオツシヤツテ、オワラヒニナリマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エライ目ニオ会イニナリマシタソウデ」「ナアニ何デモアリマセンヨ」「兎ニ角見セテ戴キマショウ」臥カサレテ手ヤ足腰ヲ委シク検査サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
