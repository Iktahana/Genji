          "literary": [
            {
              "text": "「雨ニモマケズ」という賢治の詩などは、思いがけぬほど多くの人に暗記されています。",
              "citation": {
                "source": "啄木と賢治",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さんの知っている「雨ニモマケズ」の詩は病気でねている時に書いたのですが、今日でも多くの人に救と力とを与えています。",
              "citation": {
                "source": "啄木と賢治",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "町医者というものは、風ニモマケズ、雨ニモマケズ、常に歩いて疲れを知らぬ足そのものでなければならぬ。",
              "citation": {
                "source": "肝臓先生",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
