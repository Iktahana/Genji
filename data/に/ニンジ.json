  {
    "uuid": "910ddca7-0356-575e-bf79-63b112025f8a",
    "entry": "ニンジ",
    "reading": {
      "primary": "にんじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
