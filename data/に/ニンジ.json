    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Ninji era (1240.7.16-1243.2.26)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "仁治の乱は、鎌倉時代中期に起こった武士の争乱である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仁治三年には、多くの天災が記録されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史の教科書で、仁治という年号を初めて知った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "仁治元年四月の地震には海嘯があって、由比ヶ浜の八幡宮の拝殿が流れた。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠行乃ち仁治中北条泰時の故智を襲いで、多摩川の水を引くことを策した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁治三年三月四日歿。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "清水坂の非人は祇園感神院に属し、奈良坂のは東大寺に属しておったから、ここにも南都北嶺争覇の影響が及んでいたものらしく、仁治、寛元年間に縄張争い等の事から軋轢を始めて、奈良坂の非人が清水坂の非人の或る者を味方につけ、清水坂を襲撃して、その長吏法師を殺したという事件が起った。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし般若寺坂を奈良坂と言い出したのもおそらく鎌倉時代以来のことで、仁治・寛元の頃に東大寺領奈良坂の非人と、京都清水坂の非人とが闘争に及んだことがあった。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "因茲去仁治二年七月九日、忽殺‐害法仏並妻子合四人仕畢。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "即去仁治元年三月二十一日、相‐語悪徒等、淡路法師令損害仕之条、四隣之諸人、皆以所見知仕也。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "寛元二年三月　日　右の文書は清水坂非人から奈良坂非人の不法を訴えたのに対して、奈良坂非人がそのしかるべからざる所以を陳じたもので、実状はいわゆる原被両造の申状を合わせみねばわからぬが、ともかく東大寺領の奈良坂非人というものが、仁治・寛元の際からここにあったことは明らかである。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "真土宿の長吏は近江法師兄弟で、その時弟の方の法仏法師は、本寺には背きがたしとてこれを拒んだがために、仁治二年七月九日に、妻子共四人、清水坂長吏のために殺害されたことがあった。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は奈良坂宿の末宿なる大和七宿の者どもが、年序久しく積んで相互の関係自然疎遠になり、非人の身として猛悪を好み本寺に対して謀反を構えるようになったので、その不当を正そうとしたがためにかえって他の恨みを買って、仁治元年三月二十一日には彼ら悪徒のために襲撃せられるなど、往々圧迫を受けることがあった。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "問題の起った仁治寛元よりも三十余年前の建保元年十月に、清水寺の法師らが寺家を延暦寺の末寺に寄付せんとして、これがために延暦寺の使いが清水寺の寺領に入部し、南都の衆徒これを憤って延暦寺焼打ちの企てをなしたこともあった（『吾妻鏡』）。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "時代を以てすれば、九州の禪宗は仁治建長の間筑前に盛に、豐後より進んで兩肥に及んだのは、鎌倉の末六十年位の間のことである。",
              "citation": {
                "source": "鎌倉時代の布教と當時の交通",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼自身は承久乱の年は六十歳で、その翌｜貞応元年従二位に昇ってから、六十六で正二位、七十一歳で権中納言に就き、七十二歳で出家、仁治二年八月、八十歳を以て薨去した。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は建久九年に生れ、承久乱の年には二十四歳で従四位上左権中将であったが、二十八（嘉禄元年）頭中将、二十九（嘉禄二年）従三位参議兼侍従、三十九（嘉禎二年）従二位権中納言に昇り、四十四歳（仁治二年）のときすでに正二位権大納言となった。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後は、定家の世を去る仁治二年（四十四歳）までに、正二位権大納言に昇ったことは、既に前に述べた通りである。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば「松虫草」と「なべな」、「ほたるぶくろ」と「つりがねにんじん」といったようなものである。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "登場人物の中でいちばんじょうずな役者は主人公のにんじんである。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう意味からすれば、にんじんの父も母も女中もおじさんも皆少し芝居をし過ぎるような気もするが、しかし元来西洋人は日本人に比べると平生でも挙動がだいぶ芝居じみているから、あれぐらいはちょうどいいのかもしれない。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう田舎の名づけ親のおじさんの所へ遊びに行ったにんじんが、そこの幼いマチルドと婚礼ごっこをして牧場を練り歩く場面で、あひるや豚や牛などがフラッシで断続交互して現われ、おじさんの紙腔琴に合わせて伴奏をするところも呼吸がよく合って愉快である。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中が迎えに来て荷馬車で帰る途中で、よその家庭の幸福そうな人々を見ているうちににんじんの心がだんだんにいら立って来て、無茶苦茶に馬を引っぱたいて狂奔させる、あすこの場面の伴奏音楽がよくできているように思う。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のようなものにはこの劇中でいちばんかわいそうなは干物になった心臓の持ち主すなわちにんじんのおかあさんであり、いちばん幸福なのは動物にまでも同情されるにんじんである。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……今日の所得　（銭四十銭、米二升四合）御馳走　（小海老のいりつけ、にんじんのおしたし、豆腐汁）もう栗が店に出てゐる、栗そのものは食べたいとも思はないが、栗の感じはよろしい、柿――きねり柿――をおせつたいとして頂戴した、歯がわるいから小供にくれてやつたが。",
              "citation": {
                "source": "行乞記",
                "author": "広島・尾道",
                "note": "青空文庫"
              }
            },
            {
              "text": "おからや、にんじんの　しっぽや、うりの　かわや、おぞうすいや。",
              "citation": {
                "source": "がちょうの　たんじょうび",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、もうそろそろ、にんじゅうの徳の美しさは疑いはじめているのだ。",
              "citation": {
                "source": "川端康成へ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう見えたって、にんじんの芽だ。",
              "citation": {
                "source": "失敗園",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二〇〇五年には、新宿中村屋の創業者で商いの近代化に努め、妻の黒光とともに、たくさんの芸術家や、アジアの政治活動家を支援した相馬愛蔵と、劇作家、小説家で、ジュール・ルナールの『にんじん』の訳者としても知られる岸田国士の作品を公開した。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "食べものは、切藁、牧草、にんじん、豆粕、もやしなどある限りのものを、あるひは取りまぜ、あるひは代る代る、出來得る限りの變化で與へた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "季節は春に止めを刺すので、材料はたい、にんじん、たけのこ、ふき、さやえんどう、しいたけ、玉子焼、紅しようが、木の芽などである。",
              "citation": {
                "source": "わが妻の記",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "・こどもに雪をたべさしたりしてつゝましいくらし・きたない池に枯葦の葉も大阪がちかい・春風の旗がはた／＼特別興行といふ・うらはぬかるみの、女房ぶりの、大根やにんじん・雲のゆききのさびしくもあるか　三月十一日ほつかり覚める。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「にんじん」は、挫かれひしがれた純情で観客の心を打ったのではなかったろうか？",
              "citation": {
                "source": "私も一人の女として",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
