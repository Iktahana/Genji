        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "堂のすみにしゃがんでいる年とった土人に、「ここに祭ってあるゴッドの名はなんというか」と聞いたら上目に自分の顔をにらむようにしてただ一言「スプロマニーン」と答えた――ようであった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして多数の非常に綿密な測定を行った（主にフウェン Hven 島のウラニーンブルク Uranienburg の観測所で）。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "空へ鼻づらを振り上げて、ニーンと悲しそうに鳴いたかと思うと、行儀よく前足を前へそろえ、その上へあごをピッタリとつけ、絶望したようにうずくまってしまった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
