    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sudden",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は俄に思い立ち、一人で旅行に出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "急な雨で、俄かに空が暗くなり、雷が鳴り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "俄に信じられないようなニュースが飛び込んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしともかく、それらの音楽によつて多くの人々が、好い気持にされてゐるのだから文句はないのだが、然しもと／＼気分の暈縁なぞといふオボコイものを聴いて喜んでゐる連中が取引のこととなると俄然骨ばつてくるし、而も楽々骨ばれるやうに前以て備へてゐるので、「音楽と世態」なぞと今並べてみたくなるのである。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "可哀想に前の赤ん坊が目を覚ますたんびにその泣声に目を覚まし、俄かづくりの笑顔で以て赤坊をあやしてやる。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さう早く出るもんか」「だがね、今日はもう何も云つては駄目ですよ、今急病人があつてお父様は気が立つてるからね」　その時、俄然台所の方から、牛肉か何かを叩く音がして来ると、そゝくさと蒼い顔の妻君は長男の部屋をも立ち去つた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は父が自分のさうした昂奮のために放つ言葉を、親が子を諭す言葉だと、習慣的に信じて言つてることが俄かに堪らないことに思へ出した。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そしてまた何をさう俄かに。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あれ』屍を守る見樣で、棒の如く突立つた女は、軈て俄然と身を投て、伏重なつたと思ふと、熟と僵れて身動も仕無い。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近きベンチへ腰をかけて観音様を祈り奉る俄信心を起すも霊験のある筈なしと顔をしかめながら雷門を出づれば仁王の顔いつもよりは苦し。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "森谷沢という一筋の小川が、左から流れて、落ちるところあたりから、谷というよりも、沢の方へ近くなり、両側の山の頭が低くなって、天が俄に高くなった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "危む相手にまごころをば俄にはうち出しにくい。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――岡本かの子　　　春の雷が鳴つてから俄に暖気を増し、さくら一盛り迎へ送りして、今や風光る清明の季に入らうとしてゐる。",
              "citation": {
                "source": "風と裾",
                "author": "――何人か良案はないか？――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――岡本かの子　春の雷が鳴つてから俄に暖気を増し、さくら一盛り迎へ送りして、今や風光る清明の季に入らうとしてゐる。",
              "citation": {
                "source": "風と裾",
                "author": "――何人か良案はないか？――",
                "note": "青空文庫"
              }
            },
            {
              "text": "俄に天井に白い泡がたつて、青びかりのまるでぎらぎらする鉄砲｜弾のやうなものが、いきなり飛込んで来ました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてもう一尺で地面にその弱い足がつくというとき、よだかは俄かにのろしのようにそらへとびあがりました。",
              "citation": {
                "source": "よだかの星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは俄かに顔いろがよくなって威勢よくおじぎをすると台の下に置いた鞄をもっておもてへ飛びだしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから俄かにお母さんの牛乳のことを思ひだしてジョバンニはその店をはなれました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまっ黒な、松や楢の林を越えると、俄かにがらんと空がひらけて、天の川がしらしらと南から北へ亘ってゐるのが見え、また頂の、天気輪の柱も見わけられたのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなりこっちも窓から顔を出さうとしたとき、俄かにその子供が頭を引っ込めて、こっちを見ました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俄かに、車のなかが、ぱっと白く明るくなりました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら俄かにそこに、つやつやした黒い髪の六つばかりの男の子が赤いジャケツのぼたんもかけずひどくびっくりしたやうな顔をしてがたがたふるえてはだしで立ってゐました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき俄かに大きな音がして私たちは水に落ち〔〕ました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは俄かに何とも云へずかなしい気がして思はず「カムパネルラ、こゝからはねおりて遊んで行かうよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニが見てゐる間その人はしきりに赤い旗をふってゐましたが俄かに赤旗をおろしてうしろにかくすやうにし青い旗を高く高くあげてまるでオーケストラの指揮者のやうに烈しく振りました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときあのやぐらの上のゆるい服の男は俄かに赤い旗をあげて狂気のやうにふりうごかしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　川の向ふ岸が俄かに赤くなりました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の中はもう半分以上も空いてしまひ俄かにがらんとしてさびしくなり風がいっぱいに吹き込みました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」カムパネルラは俄かに窓の遠くに見えるきれいな野原を指して叫びました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども俄かにカムパネルラのお父さんがきっぱり云ひました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずいぶん皆にわかってもらいたくて出来るだけ、ていねいに書いた筈である。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "企てた、とたんに、世界じゅうの小説がにわかに退屈でしらじらしくなって来るのだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "放課のベルを待ち兼ねて学校を飛出し、信さんに教わった新店を尋ねたら、すぐにわかった。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "impromptu skit",
        "register": "standard",
