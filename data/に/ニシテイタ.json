        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "―――ト申シマスノハネ、アノ顔ヲ見テルト、昔アタシガ贔屓ニシテイタレオ・エスピノザヲ思イ出スンデスノ」「又変ナ名前ガ出テ来タジャナイカ」「エスピノザッテノハフライ級世界選手権ノタイトル・マッチニモ出タコトノアル、フィリッピンノボクサーナノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンカラアンナ注意ヲ受ケタタメニ、却テ神経質ニナッテ、気ニシテイタセイデモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日軽井沢デハ努メテ予ト顔ヲ合ワサナイヨウニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人キリノ時ハドウカ知ラナイガ、他人ノ前デハ殊更ソンナ風ニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ今度ノ京都行ヲカネテカラ楽シミニシテイタガ、京都滞在中ニ一日オ暇ヲ戴イテ奈良見物ヲサセテクレト云ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ五子ヲ佐々木ノ案内役ニ附ケテ行カセルコトニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイッテ、僕ハ全然ソウイウヲ考エナイヨウニシテイタノニ、イキナリハッキリト聞カサレタノデギクリトシタ、トイウノガ偽ラザル気持カモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
