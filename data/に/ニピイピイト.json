          "literary": [
            {
              "text": "ケレド確ニピイピイト鳴イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝アタリハ空気ガ乾燥シ、老人ノ喉ガカラ／＼ニ干｜涸ビ、風邪ヒキ加減ニナッテイルセイデ、呼吸ガ喉ヲ入ッタリ出タリスル度毎ニピイピイト云ウ音ヲ発スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉デスルノカ、鼻ノ奥デスルノカ、何処デスルノカハッキリ分ラナイガ、何処カソノ辺ヲ通リ過ギル時ニピイピイト鳴ルノラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "息ヲ強クスルト音モ強クナリ、マルデ笛デモ吹イテイルヨウニピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
