          "literary": [
            {
              "text": "ヨ、ヒトリハ、チンボツオトコナルヲモッテ、ケイエンセラレ、タコマゴウニハノセラレズ、チョクセツモンテヴィデオコウニリクアゲセラレタリ。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏面ニハノ予ノ俗名ト、モシ必要ナラ戒名モ加エテ、享年ヲ刻ンデ置ケバイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にニハツヒの神、次にアスハの神、次にハヒキの神、次にカグヤマトミの神、次にハヤマトの神、次にニハノタカツヒの神、次にオホツチの神、またの名はツチノミオヤの神の九神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
