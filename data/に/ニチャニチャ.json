    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうして二人とも美しい顔をゆがめてチューインガムをニチャニチャ噛みながら白昼の都大路を闊歩しているのであった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論その時はチューインガムという名前も知らず、この税関吏が何故に、何のために、何物をニチャニチャ噛んでいるかも少しも分らなかった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に我が親愛なる税関吏は止みなくチューインガムをニチャニチャ噛みながら品物を丹念に引出し引っくら返しては帳面に記入するのであった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがニチャニチャと止みなしにチューインガムを噛んでいる。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸顔で色の真黒な、目のきょろりとしたのが、一人はベエスボオルの小手を嵌めた手を振るし、就中一人ロイド縁の大目金を掛けたのが、チュウインガムをニチャニチャと噛みながら、「久の息子です。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "来ると、ニチャニチャと飴を食ってるような弁で、直と自分の噂を始める。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間ほど湯に入って頭を洗わんので指の股が油でニチャニチャする。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニキビの一っぱい出た油ぎってニチャニチャする様な二十五六の男だった。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに何も落し物はないだろうな」　両手のポケットを外から叩いて、思い出そうとしたときに掌がいやにニチャニチャする。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "触覚のモティフはまず大体凸凹、ブツブツ、クシャクシャ、ザラザラ、ガタガタ、ゴツゴツ、コツコツ、カチカチ、ヘナヘナ、ヒリヒリ、サラサラ、ヌラヌラ、スベスベ、カサカサ、フワフワ、ネバネバ、ニチャニチャ、張力、弾力、円錐球楕円三角鋭角鈍角平面四角八角ギザギザ階段その他いろいろの複雑な立体などである。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソバは変にニチャニチャして、ちっともおいしくありませんでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、しまいには、失神したような信子夫人を、確りと胸に抱き擁えながら、膏と汗でニチャニチャに汚れた頬を、冷い、滑な彼女の頬に擦りつけながら、「信子、信子……」と子供のように泣き崩れてしまった。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもカステラが膨れないで中央が凹んで餅のように固くなったなら火が強過ぎて膨らまないのですし、ニチャニチャして乾かないのは火が弱過ぎてよく焼けないのです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし火加減が強過ぎると膨れないでニチャニチャします。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのむこうの気違いのような眼つきをした裸の兵隊は、オオハコベを口いっぱいに頬ばり、唇から青い汁を垂らしながらニチャニチャ噛んでいる……そういう人間のすがたも、間もなくまた薄闇のなかに沈む。",
              "citation": {
                "source": "母子像",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "数の子には、口中でパリパリ炸裂せず、型の如き音の響きを発せず、シコシコ、ニチャニチャして、少し渋味のあるようなものがあるが、それは卵が胎中において成熟していないのである。",
              "citation": {
                "source": "数の子は音を食うもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは姦夫姦婦の痴戯を見るに耐えず、油汗でニチャニチャする拳を握りしめ、それを空に打ちふり打ちふり、大牟田家の別邸を走り出し、激情の余り、どこをどう歩いたかも知らず、長い時間を費して、我宿に帰りついた。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも更に異様なことには、それは決して老人のひからびた手ではなく、ニチャニチャと油っこい壮年者の手であった。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
