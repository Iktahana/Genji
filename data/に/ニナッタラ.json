        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "秋ニナッテ葉ヲ落スノハ、無益ナ消耗ヲ避ケテ樹液ヲ貯エ、春ニナッタラ大イニ伸ビテヤロウトイウ樹木ノ高イ意欲ノアラワレナノダ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽマデ来タンダカラチョット伊勢丹ヘ寄ロウ」ト、婆サンノ反対ヲ豫期シテ云ウト、「又冷房デモイヽンデスカ、コノ暑イノニ早クオ帰リニナッタラドウ」ト果シテ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サン曰ク、田園調布ノ鈴木サンニ鍼ヲシテオ貰イニナッタラドウ、鍼デ直ルカモ知レナイカラ頼ンデ見タラト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシタモノカト迷ッテイルウチニ歳ヲ取リ過ギテ、モウ現在デハ手術モ手後レニナッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉モ来月ニナッタラ十日間グライ休暇ヲ取ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ暑イ間ダケオ止メニナッタラ」「イヤ、コノ頃イクラカ利イテ来タヨウナ気ガスルンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ頻リニコノ天候ヲ気ヅカッテ、モウ一日オ延バシニナッタラト云ッタガ、予モ颯子モ承知シナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子ハ伺ッタモノカドウカ、ドウシタライヽデショウッテ云ッテルンデスガ、………」「………」「伺ッタライヽジャナイカ、コンナ時コソオ前サンノ顔ヲ御覧ニナッタラ、イクラカデモ痛ミヲオ忘レニナルヨッテ云ッテヤッタンデスガネ」「馬鹿」イキナリ予ハ怒鳴ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「頸動脈ノ傍ヲ突クナンテ危イコッテスヨ、アタシハ始メカラ不賛成ダッタンデス、明日モイッソオ止メニナッタラ」ト、婆サンハ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソバデ煙草ヲオ吸イニナッタラ、ゴホン／＼オ咳ガ止マラナクナリマスヨ」「ボーイサン、ソノトランクヲコッチノ部屋ヘ運ンデ頂戴」颯子ハ構ワズサッサト隣室ヘ這入ッテ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの譫語には、「木村サントコンナ風ニナッタラナア」という気持と、「夫があの人を私に世話してくれたらなあ」という気持と、二つの願望が籠っていたに違いなく、それを分って貰うためにあの言葉を云った。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
