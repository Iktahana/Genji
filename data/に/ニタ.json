    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "天性陰気なこの人は、人の目にたつほど、愚痴も悔やみもいわなかったものの、内心にはじつに長いあいだの、苦悶と悔恨とをつづけてきたのである。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "糟谷は土曜と知って目がさめたようにたちあがった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻子を振り捨てて、奮然学問のしなおしをやってみようかしら、そんならばたしかに人をおどろかすにたるな。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてつとめて、自分が苦労してる問題に離れた話に興を求め、ことさらにたわいもないことを騒いで、一｜晩ざる碁をたのしんだ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸中に深刻な痛みをおぼえてから、気楽な悠長な農民を相手にして遊ぶにたえられなくなったのである。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "母なる人は無言にたって、芳輔の手を捕えて父の近くへ引き寄せた。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜節見訪竹の里人下総のたかし来たれりこれの子は蜂屋大柿吾にくれし子下ふさのたかしはよき子これの子は虫喰栗をあれにくれし子春ことにたらの木の芽をおくりくる結城のたかし吾は忘れず　多くの場合に人に畏敬せられた先生にして、こんなことの有ったのは世人も少しく意外に感ずるのであろう。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈々子は満足の色を笑いにたたわして、雪子とお児の間にはさまりつつ雛を見る。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぶつぶ絣の単物に桃色のへこ帯を後ろにたれ、小さな膝を折ってその両膝に罪のない手を乗せてしゃがんでいる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕も勿論愉快が溢れる……、宇宙間にただ二人きり居るような心持にお互になったのである。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "捨てはてし身にも猶衣食のわづらひあれば、昼は※処となくさまよひて何となく使はれ、夜は一処不住の宿りに、かくても夢は結びつゝ、日一日とたゞよひにたゞよひて、過しゆくほどに、脊たけと共にのびゆくは、ねじけたる心なるべし。",
              "citation": {
                "source": "琴の音",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "捨てはてし身にも猶衣食のわづらひあれば、晝は※處となくさまよひて何となく使はれ、夜は一處不住の宿りに、かくても夢は結びつゝ、日一日とたゞよひにたゞよひて、過しゆくほどに、脊たけと共にのびゆくは、ねじけたる心なるべし。",
              "citation": {
                "source": "琴の音",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "西鶴は頬の色の「薄花桜」であることを重要視しているが、「いき」な頬は吉井勇が「うつくしき女なれども小夜子はも凄艶なれば秋にたとへむ」といっているような秋の色を帯びる傾向をもっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツァラトストラ」の初版が、僅かにただ三部しか売れなかつたといふ歴史は、この書物の出版当時に於て、これを理解し得る人が、全独逸に三人しか居なかつたことを証左して居る。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の詩の本質――よつて以てそれが詩作の動機となるところの、あの香氣の高い心悸の鼓動――は、ひとへにただあのいみじき横笛の音の魅惑にある。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして貴女はここに來たのやさしい　青ざめた　草のやうにふしぎな影よ貴女は貝でもない　雉でもない　猫でもないさうしてさびしげなる亡靈よ貴女のさまよふからだの影からまづしい漁村の裏通りで　魚のくさつた臭ひがするその腸は日にとけてどろどろと生臭くかなしく　せつなく　ほんとにたへがたい哀傷のにほひである。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「思想は一つの意匠であるか」佛は月影を踏み行きながらかれのやさしい心にたづねた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天氣はさつぱりと晴れて赤松の梢にたかく囀鳥の騷ぐをみた愉快な小鳥は胸をはつてふたたび情緒の調子をかへた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」艶めける靈魂艶めける靈魂そよげるやはらかい草の影から花やかに　いきいきと目をさましてくる情慾燃えあがるやうにたのしくうれしくこころ春めく春の感情。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（とりとめもない夢の氣分とその抒情）春宵嫋めかしくも媚ある風情をしつとりとした襦袢につつむくびれたごむの　跳ねかへす若い肉體をこんなに近く抱いてるうれしさあなたの胸は鼓動にたかまりその手足は肌にふれほのかにつめたく　やさしい感觸の匂ひをつたふ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああげにたへがたくもみじめなる私の過去よながいながい孤獨の影よいまこの竝木ある冬の日の街路をこえてわたしは遠い白日の墓場をながめるゆうべの夢のほのかなる名殘をかぎてさびしいありあけの山の端をみる。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "涅槃は熱病の夜あけにしらむ青白い月の光のやうだ憂鬱なる　憂鬱なるあまりに憂鬱なる厭世思想の否定の、絶望の、惱みの樹蔭にただよふ靜かな月影哀傷の雲間にうつる合歡の花だ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひねもす疲れて畔に居しに君はきやしやなる洋傘の先もて死にたる蛙を畔に指せり。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "農夫海牛のやうな農夫よ田舍の家根には草が生え、夕餉の烟ほの白く空にただよふ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "龜林あり沼あり蒼天ありひとの手には重みをかんじしづかに純金の龜ねむるこの光るさびしき自然のいたみにたへひとの心靈にまさぐりしづむ龜は蒼天のふかみにしづむ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おん脚白く濡らし怒りはげしきにたへざれば足なやみひとり海邊をわたらせたまふ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれも辮髪を背中にたれ、赤い珊瑚玉のついた帽子を被り、長い煙管を口にくわえて、悲しそうな顔をしながら、地上に円くうずくまっていた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はうれしく、この村にたった一軒の宿屋に走って行き、そこのおかみさんに頼んで、鶏卵を十ばかりわけてもらい、さっそく半熟にしてお母さまに差し上げた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "真暗い部屋にたった二人きりでいたって大丈夫なひとだよ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたま人間に生を受けて、しかも別嬪に生れたものを、一生にたった一度、生命とはつりがえの、色も恋も知らせねえで、盲鳥を占めるように野郎の懐へ捻込んで、いや、貞女になれ、賢母になれ、良妻になれ、と云ったって、手品の種を通わせやしめえし、そう、うまく行くものか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
