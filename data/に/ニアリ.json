        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "製品化されたソフトウエアの仕様や機能を、開発工程を逆向きにたどって分析することから、リバースエンジニアリングと総称されるこうした手法は、法律で禁じられているわけではなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしリバースエンジニアリングをかけられる側の反発は、当然予測できた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが中間コードが一致している以上、互換ベーシックの開発にあたって日本電気側がリバースエンジニアリングを用いたことだけは間違いのない事実だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「被雇本人、軍籍ニアリ、万一不時ノ召集ヲ受ケ、労務ニ服スルコト能ハザルトキハ、前借金ニ利子ヲ附シ即時本人又ハ保証人ヨリ弁償スベシ。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊ワレラコクキヤウニアリ　妻子を初め東京の諸友に、その安別から打電した時には、私もまた意気軒昂たるものがあった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ノ經濟的活動ノ動機ノ一ガ私欲ニアリト云フモ其一。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ノ居常且ツ終生ノ憂惧ハ子女ノ安全ナル生長ニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シナガラ實ニ他ノ歐釆諸國ニ見ザル國字改良漢字廢止言文一致羅馬字採用等ノ議論百出ニ見ル如ク、國民全部ノ大苦惱ハ日本ノ言語文字ノ甚ダシク劣惡ナルコトニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ其ノ中食ニ一塊ノ「パン」薩摩芋麥ノ握飯等ノ簡單ナル粗食ヲナサシメ、以テ滋養價値等ヲ云々シテ眞ノ生活ヲ悟得セザル科學的迷信ヲ打破スルニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由戀愛論ノ價値ハ戀愛ノ自由ヲ拘束スル現代ノ政治的經濟的宗教的阻害者ヲ打破セントスル點ニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮人臺灣人ガ其ノ故郷ニアリテ未ダ取得スル時期ニ達セザル國民權ヲ此ノ領土ニ於テ三年後ニ取得シ得ベキ理由ハ、既ニ移住シ居住スルホドノ者ハ大體ニ於テ優秀ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カイゼル」ハ海上ニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "お沙汰書に――向後、土地｜墾闢、人民｜蕃殖、北門ノ鎖鑰厳ニ樹立シ　皇威御更張ノ基ト可相成――とあり、黒田清隆の上書にもちゃんと明記されている、「開拓ノコト宜シク漸ヲ以テソノ成功ヲ責メ、官吏ヲ減ジ、煩擾ヲハブキ、仁政ヲ施シ、人心ヲ安ンジ、賦税ヲ軽クスルニアリ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソヴェト同盟の学校は、アメリカ人のスコット・ニアリングが感服してその本の中に書いているほど、小学校から大学まで学生の自治組織が発達している。",
              "citation": {
                "source": "砂遊場からの同志",
                "author": "――ソヴェト同盟の共学について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "『計画ハ、クイチガッタ、我等ハココニアリ、至急スクイ出シ、タノム』と、信号したくはないのかね。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美人ト不美人トノ相違ノ真髄ハ何処ニアリヤト考エルノニ、要スルニ夫レハ主トシテ眉目ノ立体幾何学的問題ニ在ル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼ号ノ秘密ハ当地ニ於テ今ヤ解カレル一歩前ニアリ折角ノ名誉ト富ヲ捨テル気カ、スグ帰レ、花ヲ持ツテ待ツ、汝ノ崇拝者ヨリ”　これを受け取ったドレゴは一夜を悩み続けた末、今朝になって、とうとう帰国する気になったのだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから自分ニアリングの教育に関する本をよみ、面白かった。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒鷲爆撃機第一号ニ乗リ、今ヤハワイ群島ノ東ニアリ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤山ハ、今御前嶽ト云ヒテ、御井郡ト下妻郡トノ界ニアリ、水沼縣ハ、今ノ筑後國三潴郡ナリ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがこのイソモルフィー・等価関係・共軛性・コンジェニアリティー・等々は、単に諸科学の間にのみ横たわるものではない。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "文芸と科学とのコンジェニアリティーを実証して見せたことは、左翼文壇の評論的進歩の大きい功績の一つなのである。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々はコンジェニアリティーと云ったが、このジェニー（天才）に連関して、感覚（Sense, Sinn）を問題にする必要に迫られる。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの問題を解くことは同時に、一般に芸術と科学との感覚上の統一連帯関係を、従ってかの芸術と科学とのコンジェニアリティーの確立を、結果するだろう。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこの二つの共通感覚――美的と論理的（常識）――が同じく共通感覚である処に、実はすでにかの芸術と科学とのコンジェニアリティー――感覚上の連帯――が横たわる。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "『五山ノ称ハ古ニ無クシテ今ニアリ。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを古に「山の辺の道」と云い、古記にも、崇神天皇には「御陵ハ山辺道ノ勾之岡ノ上ニアリ」とあり、景行天皇には「御陵ハ山辺之道ノ上ニアリ」とある。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
