    "definitions": [
      {
        "index": 1,
        "gloss": "sweet-scented",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "部屋の隅に飾った百合の花が、匂いやかな香りを放っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女が通り過ぎた後には、匂いやかな香水の残り香が漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "春の風に乗って、梅の花の匂いやかな香りが窓から入ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "春の寒い夕、電灯の燦たる光に対して、白く匂いやかなるこの花を見るたびに、Ｋ君の忰の魂のゆくえを思わずにはいられない。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは二年前の陽春の三月ごろで、庸三の庭は、ちょうどこぶしの花の盛りで、陰鬱な書斎の縁先きが匂いやかな白い花の叢から照りかえす陽光に、春らしい明るさを齎せていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "行きつけの美容院へ行って、すっかりお化粧をして来たものらしく、彼女の顔の白さが薄闇のなかに匂いやかに仄めいた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくよかなお顔は、鼻｜隆く、眉秀で夢見るようにまみを伏せて、右手は乳の辺に挙げ、脇の下に垂れた左手は、ふくよかな掌を見せて……ああ雲の上に朱の唇、匂いやかにほほ笑まれると見た……その俤。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "匂いやかな笑みを含んだ顔が、はじめて、まともに郎女に向けられた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めは樹々の若芽が、黒々とした枝の上に緑の点を打って、遠く見ると匂いやかに煙って居るが、その細かい点が日ごとに大きくなって、やがて一｜刷毛、黄の勝った一団の緑となるまで、日々微妙な変化を示しながら、色の深さを増して行くのは、朝晩眺め尽しても飽きない景色である。",
              "citation": {
                "source": "寺町",
                "author": "岩本素白",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い足袋の爪先と匂ひやかな顔の輪廓とが近づいて来た。",
              "citation": {
                "source": "草いきれ",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつたそが中の御厨子の本尊、妖娟なる天女の姿、匂ひやかなる雪の肌、消たば消ちなむ目見の霞……造りも造りたる偽の御堂よな。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくよかなお顏は、鼻隆く、眉秀で、夢見るやうにまみを伏せて、右手は乳の邊に擧げ、脇の下に垂れた左手は、ふくよかな掌を見せて、……あゝ雲の上に朱の唇、匂ひやかにほゝ笑まれると見た……その俤。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "匂ひやかな笑みを含んだ顏が、はじめて、まともに郎女に向けられた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくよかなお顏は、鼻隆く、眉秀で夢見るやうにまみを伏せて、右手は乳の邊に擧げ、脇の下に垂れた左手は、ふくよかな掌を見せて……あゝ雲の上に朱の唇、匂ひやかにほゝ笑まれると見た……その俤。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくよかなお顔は、鼻隆く、眉秀で、夢見るやうなまみを伏せて、右手は乳の辺に挙げ、左は膝のあたりに垂れて……あゝ雲の上に朱の唇、匂ひやかにほゝ笑まれたと見た……あの俤。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其から見れば、十も若いおれなどは、まう一度、思ひ出に此匂ひやかな貌花を、垣内の苑に移せない限りはない。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "匂ひやかな笑みを含んだ顔が、はじめて、まともに郎女に向けられた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふくよかなお顔は、鼻｜隆く、眉｜秀で夢見るやうにまみを伏せて、右手は乳の辺に挙げ、脇の下に垂れた左手は、ふくよかな掌を見せて……あゝ雲の上に朱の唇、匂ひやかにほゝ笑まれると見た……その俤。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何にして、語の陰を多く重ね、幻影を匂ひやかにすることが出来るか。",
              "citation": {
                "source": "短歌本質成立の時代",
                "author": "万葉集以後の歌風の見わたし",
                "note": "青空文庫"
              }
            },
            {
              "text": "匂ひやかなる沫雪の今朝わが庭にふりつみぬ。",
              "citation": {
                "source": "詩集夏花",
                "author": "伊東静雄",
                "note": "青空文庫"
              }
            }
          ]
        }
