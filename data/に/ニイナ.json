        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その、そこに坐っている娘は、わたくしの娘で、ニイナ・ニコライヴナと申しますんでございますよ。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ・ラファロヴナ――曹道先妻、若きロシア婦人。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ・ラファロヴナが物乾しの台の上り口に現れる。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　まあ、お二人ともこんなところで何をしているの？",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　いいえね、今夜でなくてもいいんでしょうと思いましたけれど、これを持って来ましたの。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　鏡ですねは心細いわ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　（驚いて）まあ、安さん、その手はどうしたんですの。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　どうかしていますかって、顫えてるじゃないの、そんなに。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "安重根はニイナへ背中を向けて、自分の手を凝視める。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　笑いごっちゃありませんわ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　（何事も知らぬ気に）あたしなんかにはいっこう解りませんけれど、それでも、いま安さんが立役者だということは、女の感というもので知れますわ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　そんなに持てている安さんじゃあないの。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　まあ、なんて怖い顔！",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナ　何を言ってるのよ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナは降りて行く。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子ハモウ部屋ニイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の固有信仰で、田の神は春先に山から降って来られて、その年の稲作のよく出来ることをご覧になって、秋には帰り給うのであるから、この稲積みをニオ、ニュウなどと呼ぶことは、ニイナメ祭のニイや、神への供物のニエなどと関係があるのではないかと、私どもは早くから主張してきたのであった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイナメという祭は、いまだに詳しいことはわからないが、古代のわが国ではことに厳粛な、大きな祭であって、稲の刈り上げが終ったあとのある期間を、精進潔斎し、物忌みの生活をして神を祭ったものであるらしい。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "農民の間にもニイナメという口言葉はそのままでは残っていないし、いつごろ行われたものであるかもはっきりしないのであるが、私は他の事情から考えて、昔のニイナメは、先にのべた大師講などと、同じものではなかったかと思うのである。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アエは饗で、ニイナメ即ちニイノアエに通じるものではないかと思う。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて雲丹は大人の食うものとして、われわれ子供に適したものにニイナといって、サザエに似てしかも小さな小さな貝があった。",
              "citation": {
                "source": "九年母",
                "author": "青木正児",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
