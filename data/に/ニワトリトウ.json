        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから『長崎虫眼鏡』下に、元禄五年の春より唐人オランダのほかは豕鶏等食する事を停めらるとあれば、それ以前開港地では邦人も外客に倣うて豕を食ったのだ。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その多くは貧民や苦力どもで、皆手に手に乾鶏等を贈ってその行を惜しんだのです。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "食は麥飯を少々づつ、其外｜鷄等格別｜膏氣之なきものを食用にいたし、成丈米抔は勿論五穀を不食樣との事に御座候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
