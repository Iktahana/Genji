    },
    "definitions": [
      {
        "index": 1,
        "gloss": "rain shower",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "午後になって急ににわか雨が降ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "にわか雨に降られて、服がびしょ濡れになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "予報ではにわか雨の可能性があるらしいから、傘を持っていこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「月細く小雨にぬるる石地蔵」「酒しぼるしずくながらに月暮れて」「塩浜にふりつづきたる宵の月」「月暮れて雨の降りやむ星明かり」以上いずれも雨の月であるが、もう一つおまけに「傘をひろげもあえずにわか雨」というのがある。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "肱笠雨というものらしくにわか雨が降ってきてこの上もなくあわただしい。",
              "citation": {
                "source": "源氏物語",
                "author": "須磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "花のころにはつきもののにわか雨です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザアッ――と、刷毛ではいたようなにわか雨でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「うん、ちょっとな」　にわか雨に追いたてられた街に目をやったまま、高志はめんどうくさそうにこたえた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日の帰りのこと、にわか雨がぼつ／＼降りはじめた。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "やぶ医者やぶ医者のフォスタアさんが、グロオスタアへいって、にわか雨にあって、水たまりに立ち往生して、おへその上まで水びたり。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "（いまやにわか雨がふろうとして雲は低くたれこめ、旅宿の窓べにひとり座して昼なおさむざむとした思いをいだく。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはミルブルックの小川、風見車、北極星、南風、四月のにわか雨、一月の雪どけ、あるいは新しい家の最初の蜘蛛以上には孤独でない。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでに何度かひどいにわか雨があり、木の葉がすっかり濡れていたので二人ともずぶぬれになってしまった、と。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中でにわか雨があり、そのためわたしは半時間ばかり松の木の下に立って、頭の上に枝をいただき、ハンケチで雨よけをしなければならなかった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "にわか雨はやみ、東の森のうえの虹は晴れた夕べを約束していた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、道路工夫が知っているとおり、くぼんだ場所はにわか雨のあとの水溜りによって最も簡単にわかる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど傘なしでにわか雨の中を急いでゆく人のような恰好である。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "にわか雨が通り過ぎた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "またしても荒れた夜になり、雪が空中に舞い、にわか雨が聖地の窓を激しく叩いた。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　はじめてのにわか雨がふりしきっているあいだ、ガンたちはこうさけんでいました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "パラマをかすめて南へ下っていき、パンチ・ボウルににわか雨を降らせつつ、ルナリロ・ハイウエイの上空を斜めに横切るだろう。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "にわか雨の、もっと短いものだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "見渡す空ぜんたいが雨の雲におおわれているなら、にわか雨と呼んでもいいと思う。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ひとかたまりの雲の周囲はすべて晴天であり、その晴天がどちらの方向にも広く見えているのだから、いくら雨の雲が上空に来て、そのときいくら雨が降ろうとも、にわか雨とは呼びにくい。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は肩に粉袋を担いできた、にわか雨にあって苦労もした、私は生涯ずっと、お前のためには、切り詰めた生活をする積りだ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大へん大へん、鎧屋さん、はやく逃げたがいいぜ、鬼玄蕃がきやがったにちがいない」　にわか雨でもきたように、あたりの商人たちも、ともどもあわてさわいだが、かの若者だけは、腰も立てずに悠長な顔をしていた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ポツンと来た一つぶの雨に、頬へ手をやりながら、空模様を仰いでいたかと思うと、まだそれ程でもないのに、にわか雨でも来たように、一目散に走り出します。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "其つゥばきだァてのつゥばき御寺へもォててそォだてた日が照ェればすゥずみどォころあァめが降ゥればやめどころ　にわか雨をさけて、軒の下や大木の蔭に、立ちよって晴間を待つことを、昔の人たちはヤメルといっていた。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日、途中でにわか雨にあったが、雨に濡れながらもなお巡視をつづけて来ると、彼方から一人の兵が、百姓のかぶるの上にかざしながら、一目散に馳けてくるのを見かけた。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝はこのにわか雨にあって百姓の笠を盗んだ。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょうちょの　サンドイッチでも　たべて、　にわかあめが　やむまで　ゆっくりでも　するかな。",
              "citation": {
                "source": "つりびとジェレミーさんのはなし",
                "author": "THE TALE OF MR. JEREMY FISHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで　ざあざあ　にわかあめみたいに。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
