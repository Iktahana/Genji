        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "帆村探偵対「狼」の、血飛び肉裂けるの争闘は、漸く機が熟してきたようであった。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "元より強弱敵しがたく、無残や肉裂け皮破れて、悲鳴の中に息｜絶たる。",
              "citation": {
                "source": "こがね丸",
                "author": "巌谷小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "――然るを、つい数日前、寸言、周都督に逆らえりとて、諸大将のまっただ中にていたく面罵せられたるのみか、すでに老齢の身に、百｜打の刑杖を加えられ、皮肉裂け、血にまみれ、気は喪うにいたる。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
