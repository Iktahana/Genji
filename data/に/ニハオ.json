          "literary": [
            {
              "text": "「ソレニハオヨバヌ」という返電が、ようやく十日ほど経って来て、復一はやっと安心した。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイバンユリオコシテイルウチニ、君チャンニハオ母ッチャノカラダガダンダンホネバッテユクノガ分ルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜モ十二時ニハオ婆サンガ又『アグニ』ノ神ヲ乗リ移ラセマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ計略ノ外ニハオ婆サンノ手カラ、逃ゲ出スミチハアリマセン。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモ来年中ニハオ返シシマスト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イガケナク予ガ廊下ニ現レタリ、マズイコトニハオ静ト打ツカッタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
