        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "村を出てからゴーリキイは裏海の漁業組合で働き、やがてドウブリンク駅の番人として働き、駅夫や人夫に地理や天文の本をよんで聞かせてやりながら、半分歩いてニージュニイにたどり着いた。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニージュニイで再び急進的インテリゲンツィアの群に加わった。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニージュニイのこれらの連中のある者はマルクス主義に近づくや否や個人主義的毒素や利己主義や偸安で勝手にマルクスの理論をゆがめ、多くの者は唾棄すべき卑俗な「唯物論者」になり下った。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニージュニイに帰った。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーリキイがまだ二十一歳ぐらいでニージュニイで自殺しそこなった前後のことである。",
              "citation": {
                "source": "冬を越す蕾",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
