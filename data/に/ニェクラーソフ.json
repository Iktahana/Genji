        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロシアの近代には、人類精神史の底石をなすようにベリンスキー、ニェクラーソフ、ドブロリューボフらの文学者があった。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の近代文学のどこにただ一すじのベリンスキー、ニェクラーソフの伝統があるだろうか。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツルゲーネフはゲルツェン会の伝統をもってニェクラーソフ、ベリンスキー等とともに西欧派に属するユートピア的社会主義者であり、当時のロシアよりも早く資本主義が発達しているヨーロッパ諸国、特にフランス・インテリゲンツィアの理想主義的解放論に深く影響されていた。",
              "citation": {
                "source": "ツルゲーネフの生きかた",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニェクラーソフに溺れていたんじゃ何一つ出来ない。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
