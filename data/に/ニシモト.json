        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "町の南のはずれ近く、ニシモト・カントリー・ストアの前には、すでに人が集まっていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "車を出てニシモト・カントリー・ストアに向かって歩いた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車で来ては、ニシモト・カントリー・ストアの前まで歩いて来るのだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアの西側の壁に、シャベルから先に衝突した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアは、やがてあっけなく崩れ、倒れ、平たくなった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ニシモト・カントリー・ストアは、もうない。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンジャミン・ニシモトがトラックにあがった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "集まった人たちを笑顔で見渡し、ベンジャミン・ニシモトはマイクに向かって喋った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまご覧になったとおり、ハレイワのニシモト・カントリー・ストアは、これで終わりです。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "つらい気持を抑え、勇敢な笑顔をいまニシモトはみんなに向けていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナザー・ニシモト・カントリー・ストア、と命名しました。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモトのかたわらに白人の初老の男が立った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しく出来るショッピング・センターの経営者だと、ニシモトは紹介した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモトの人格を讃え、新しい変化が良きものとなるよう最善をつくすことをみなさんに約束する、と彼は結んだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルドーザーの運転手に拍手を、とニシモトが言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌の題名は『ニシモト・カントリー・ストア』と言います」　マイケルは歌い始めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "消えていくニシモト・カントリー・ストアに対する追憶の悲歌だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアの残骸を、自らの重量を利用して細かく砕き始めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニシモト・カントリー・ストアが取り壊しになると聞いてから、少しずつ作ってきた歌なんだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちは、ニシモト・カントリー・ストアに別れを告げた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだい、調子は」「ニシモト・カントリー・ストアが取り壊しになった」「奴ら、次はなにを壊すつもりなんだ」「マイケルが、おなじことを言ってた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、『ニシモト・カントリー・ストア』という歌を作ったんだ」「聴きたい」　州知事オフィスの黄金色燦然たるキャデラックに、ラリーは単純に喜んだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイケルのギターの弾き語りで、『ニシモト・カントリー・ストア』だ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しくて、なんだかこわくて」　マイケル・ヘレアウカラニが、自作の歌『ニシモト・カントリー・ストア』をシングル盤のレコードにする。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアが取り壊しになる朝の、現場の模様を撮影したテープだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェニファーとウエイン・ニシモトがいっしょだった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウエインは、ニシモト・カントリー・ストアの経営者ベンジャミン・ニシモトの甥にあたる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウエイン・ニシモトもそのひとりだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十フィートに挑戦する三人、ウエイン・ニシモト、アルバート・イアウケア、ロニー・カマイを、僕は監督のシュローダーにひきあわせた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
