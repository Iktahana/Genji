      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「だって貴郎にゃお婆さんでも、め組には似合いな年紀ごろだわ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あンちき生、課長や、山長さんにゃおべっかばっかしこけやがって！",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いくらお嬢さんだってその方にゃ苦労人でいらっしゃるから、お前さん、その袷は五両にゃおつけなさりやしまいよ。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地の人気にかかわるからと、なりたけはお客様に、かくしておくにゃおきましたものの、七草が過ぎます時分から、もう、ちらほら、そのために、たってお帰りになりますのが、手前どもばかりじゃござりません、あちらに二組、……こっちに三組。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は語を進めて、「こう言い出すからにゃおれも骨を折るつもりだど、ウン世間がやかましい……そんな事かまうもんか。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先生さまなどにゃおかしゅうござりましょうが、いま先生が水が黒いとおっしゃりますから、わし子どものときから聞いてることを、お笑いぐさに申しあげます」　かれはなおにこにこ笑ってる。",
              "citation": {
                "source": "河口湖",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの町内でも、娘があるからにゃお針の師匠もひとりやふたりあるはずだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血の降るへや",
                "note": "青空文庫"
              }
            },
            {
              "text": "「痛いめに会わせましたね、一石二鳥の右門流といやちっと口はばったいが、一つにゃやつらをおびき寄せるため、二つにゃおまえさんにおけがのねえようにと、涼んでいてもらったんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "お蘭しごきの秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれがやった、おまえか、きさまかと、わいわい騒いでいるうちにゃおのずからほんものの下手人がわかるだろうし、わかりゃ手数をかけずにそっくりこっちが小ボシをふたりちょうだいができるというもんじゃねえかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の中にゃお父さんどころかまだまだたまらないおっちょこがありますよ。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この近所にも大尉が一人おりましてな、どこの馬の骨とも分らない癖に、わしの親類じゃなどと名乗って、と言ってからに、悔みを言いだしたが最後、急いで耳を塞がずにゃおられないような大声を立てますのさ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「死にゃお前結構やが、運の悪い時ゃ悪いもんで、傷ひとつしやへんのや。",
              "citation": {
                "source": "南北",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕みさちゃんがそんなことをしてるのを見ると、わざと自分で自分の身体をこわしてるような気がしていじらしくてしょうがないんだ」「そりゃ、わたしもやめたいのよ、でもこんなにくさくさしちゃやらずにゃおられないのよ」「ほんとに身体だけは丈夫にしてくれないと困るね。",
              "citation": {
                "source": "アパートの殺人",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間にゃお蘭ちゃんのような女もあると思やアなア。",
              "citation": {
                "source": "猿ヶ京片耳伝説",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "品物は与吉のものに相違あるめえが、返すにゃおよばねえぞ小僧」「へ？",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊賀のあばれン坊ともあろうものが、いくら火にまかれても、そうやすやすと焼き殺されようたア思われねえ」「これからすぐ渋江村へ――」「安、おめえも来るか」「あい」「向うへ行ってみたうえで、源三郎の死んだというのが間違いとわかったら、お前その足でこの手紙を、本郷へとどけてくれナ」「言うにゃおよぶ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはきっとアクチニオ四十五世を探し出さにゃおかない」　と男は、杖をからんからんとならしながら、空に向って話しかける。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの辺にあるってことがわかりゃいいじゃねえか」「でも、可哀そうでしたね」「しかたねえ、一人じめにしようとした罰さ、俺はそんなことはしねえ、お前たち二人に手つだってもらったんだ、分け前はちゃんとやるよ」「ありがとうございます」「お礼をいうにゃおよばねえよ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつにゃおれも参ったよ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ビリーはそれにゃお誂え向きの男だったな。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにここへ上陸する時にゃおいらのナイフを持って行きやがったぜ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、洗濯だとか、なんとか、そういう大きな仕事は、まあ、半分の粗相ですむにしたところで、細かな仕事になると、こりゃもう、お前さんの手にゃおえない。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、俺が思い立ったら最後成就せずにゃおかねえから。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事をいった日にゃお父さんこそ、お前に合す顔がありゃしない。",
              "citation": {
                "source": "雪解",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちとらの手にゃおえないよ。",
              "citation": {
                "source": "買出し",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれがこう言ったからには、そうさせにゃおかぬ。",
              "citation": {
                "source": "重吉漂流紀聞",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "決して、血を落としたんじゃございません」「それじゃてめえは、お春さんに見られた時ア、離れからの帰りじゃなかったのか」「………」「厠にゃお春さんが這入っていたんだ。",
              "citation": {
                "source": "乳を刺す",
                "author": "黒門町伝七捕物帳",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかえ、富士見にゃおらの知ってる人も居る。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にゃおっ母さんがあるんだ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
