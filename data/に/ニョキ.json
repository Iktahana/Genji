  {
    "uuid": "f0b01092-2c23-576c-8a06-0aeedc4feade",
    "entry": "ニョキ",
    "reading": {
      "primary": "にょき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
