          "literary": [
            {
              "text": "市俄古トリビュウンの写真班が亜米利加漫遊中のニウジイランド鉱泉王を襲撃に来たように、うっかりしている番頭の顔へ、私は出来るだけ気取った発音を吹っかけてやる。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニウジイランド及びアフリカの一地方には立ち木の上に小屋を作りて住居とする者有り。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「クヰンスランド」土人ト「ニウジイランド」土人ト等シク石器時代ノ人民ナリト雖モ開化ノ度ニ於テハ二者相距ル事遠シ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
