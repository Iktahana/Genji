[
  {
    "uuid": "6b392649-de9a-5848-abb7-df9a654a27b5",
    "entry": "逃げ延びる",
    "reading": {
      "primary": "にげのびる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
