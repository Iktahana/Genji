        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ニタニタッと笑った時が、いちばん危険な丹下左膳、もうすこしで斬られるところだった。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（相手のようすを見ているうちに、ニタッとして）……どうなすって？",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時ニタッタ一遍ダケ奇怪ナ経験ヲシタコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えらい」　お京は、大仰に、賞讃の声をあげて、ニタッと、会心の笑みを洩らした。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウウム、うまくいった」　と、こんどは蛾次郎もわれながらニタッとした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "百助はそれを眺めてニタッ……と嘲笑った。",
              "citation": {
                "source": "増長天王",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
