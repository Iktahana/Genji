    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（中略）私ノ町ノ知的素養ノイクブンナリトモアル青年デモ、自分トイウモノニツイテ思イヲメグラス人ハ少ナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分ノ感ジデハ、此ノ空間ヲ往来シテイル電波ノ諸相ニツイテノ研究ハ、ホンノ手ガツイタバカリダト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテオ前ハ俺ノ行動ニツイテ、昼間飛行島デ別レテカラ後ノコトハ、スベテミナ忘レルノダ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚オ、余ハ無情ナル父親タリシコトニツイテ、彼ノ寛恕ヲ乞ウ。",
              "citation": {
                "source": "無駄骨",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、コツチノ気持ハ第二トシテ、軍人ダケガ、ナゼ当節サウイフ感情ヲ尊重シテヰルカニツイテ考ヘテミルト、「モンテェニュ」デハナイガ、世ノ中ニ軍職グラヰ愉快ナ職ハナイノカモ知レヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナホ数字ニ関スル詳細ハ本社又ハ現地事務所ニツイテ問ヒ合サレタク、毎年三月下旬ヨリ十月下旬マデ、旅費二三等何レモ片道本社負担ニテ現地御案内ノ準備ガデキテヰル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、ハジメニモ申シ上ゲタ通リ、モンコチヤンハ大ヘンモノヲ大切ニスル子デスカラ、ボンコチヤンニツイテヰタホコリヲ、テイネイニブラツシデハイテヤリマシタカラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモソノ書ニツイテ窺フニ氏ハ尾張ノ人ニシテ久シク郷党ノ師ト仰ガルル篤学ノ士ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ有隣舎ノ主人｜鷲津氏ノ事ニツイテ見ルモ彼ハ啻ニ遺秉ヲ拾ツテ遺サザルノミナラズマタ郷老ノ口碑ニ採ル所多シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ忰ノ湿ニシバ／＼オ伝ノ美シサニツイテ語ッタコトガアルソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大切ナ忰ノコトニツイテコレホド無知ナ父親ハ少イダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓石ノ様式ニツイテハ、予ニサマ／″＼ノ案ガアルノデ、未ダニ孰レニシテイヽカ迷イ抜イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子モ一緒ニツイテ行ッタノハ、今マデノ慣例ニヨッタノダロウガ、ソレニシテモ彼女ノ気持ヲ解スルニ苦シム。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不恰好デ背ノ低イ河合女史ニ比ベルト、優雅ナ体ツキノ妻ノ方ガ似合イソウナモノダケレドモ、身ニツイテイナイ感ジデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニヲ研究中デスカ」「イロイロ」「金額ニツイテデスカ」「イヤ、ソコマデ行ッテ居ナイ」「受ケツケルコトハ受ケツケルノデスカ」「研究中デス」ハラワタ、ニエル。",
              "citation": {
                "source": "花と龍",
