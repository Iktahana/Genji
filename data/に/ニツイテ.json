  {
    "uuid": "8ee535b5-bb6b-53d4-a4f7-03be2d9f3165",
    "entry": "ニツイテ",
    "reading": {
      "primary": "について",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
