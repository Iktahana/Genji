          "literary": [
            {
              "text": "『大日本地誌』中国の巻によれば、津山の町の、二里ばかり東方に、やや広き原野を日本原といい、土人これをニッポコウゲと称すとある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『大日本地誌』に、岡山県津山の東にある大なる原野、日本原、土称ニッポコウゲとある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字に書けば野または原であったが、土地の人は最初から、ニッポコウゲもしくは日本コウゲと唱えていたものと思われる。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
