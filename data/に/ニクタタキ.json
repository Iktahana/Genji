        "examples": {
          "standard": [
            {
              "text": "料理をする前に、肉たたきで鶏肉を薄く叩いておく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "キッチンの引き出しには肉たたきが入っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "肉たたきで丁寧に叩くと肉が柔らかくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "本文にあるシブレの外に手軽き料理はチャップ肉を一節ずつに骨を付けて切り肉たたきにて能くたたき両面へ塩胡椒を振掛けおきフライ鍋にバターを溶かし肉を入れてビフテキよりも一層丁寧に血色の消えるまで焼くなり。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○犢のカツレツは腿肉を厚さ二分幅一寸ほどに切り肉たたきにてたたき塩胡椒を振掛けメリケン粉を付け玉子の黄身にて包みパン粉を付けサラダ油にて揚げるなり。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
