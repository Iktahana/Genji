          "literary": [
            {
              "text": "「うまくいったら大金持になれる」　すると玄女もニコツイたが、「そうなった日には妾なんか、こんな商売はしていないよ」「俺だってそうさ、香具師なんかしない。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が自宅へ帰ったのは、夜もずっと更けてからであったが、彼はなんとなくニコツイていた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんの親分さん、戴きましょう」「そうか」といったが奥歯をかみしめ、「おれはわいろは取らねえぜ」しかしとうとうニコツイてしまった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
