          "literary": [
            {
              "text": "人形蒐集熱にかかっている若い夫人は、おもちゃ人形店を漁った。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "福田浅次郎さんのお宅の由良之助お軽、丸平人形店の蕭白の美人、鳩居堂にも蕭白の美人があります。",
              "citation": {
                "source": "座右第一品",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京に戻つてまる三ヶ月目で、家にも新聞をいれて貰ふことにしたら、久振りの新聞には、らんまんの春を待つ雛人形が、百貨店に、人形店に、華やかなデモをくりひろげてゐるのを載せてゐる。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
