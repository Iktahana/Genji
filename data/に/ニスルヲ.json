          "literary": [
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ致富ト改造後ノ致富トガ致富ノ原因ヲ異ニスルヲ了解スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "○石器時代人民相互ノ關係ハ、古今ノ比較ニ於テモ東西ノ比較ニ於テモ、通例ノ人種調査ニ要スル順序ヲ經テ始メテ明カニスルヲ得ベキハ勿論ナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………昨夜デ僕ハ、妻ノ「木村サン」トイウ語ヲ耳ニスルヲ疑ウ餘地ガナクナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
