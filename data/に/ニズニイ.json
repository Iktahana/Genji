        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのイワンが或夏、ニズニイといふ町の市へ品物をさばきに出かけました。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがニズニイからかへつていらしつて、帽子をおぬぎになると、おつむりの髪がすつかり白髪になつてる夢を見たんです。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてニズニイまでの道のりの半分まで来ますと、リアザンの町から来た、或｜知合の商人に出あひました。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのニズニイの市へ出かけるときに、門口へおくつて出た、そのときのおかみさんのすがたも目についてはなれません。",
              "citation": {
                "source": "ざんげ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
