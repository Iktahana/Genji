    "definitions": [
      {
        "index": 1,
        "gloss": "to grasp tightly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "幼い娘は、母親のスカートの裾をぎゅっと握り締めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不安な気持ちを抑えるように、彼はペンを強く握り締めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "合格通知を握り締めて、彼女は歓喜の声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "流石の病人に慣れた青眼先生も、これには驚き慌てまして、紅矢の左の手に飛び付いて、一生懸命こじ明けようとしましたが、どうして梃でも動かばこそ、かえってだんだん強く握り締めるために、拳固が紫色から黒い色に変って行きます。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもどうしてもその弾倉撥条を握り締める力が出ないらしかった。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手を強く握り締める）かえで　でも私は、私は……（涙をこぼす）私のからだは汚れています。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手を延ばす）かえで　（浅香の手を胸のところで握り締める）ねえさんのお手の冷たいこと！",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "永遠にして崇高なものをぐっと握り締めるまでは、私共のなすべきすべてのことはただ思索あるのみである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼鏡　　いゝえ、それが、僕の手を握つたんです（声をあげて泣く）か、か、堪忍、堪忍、して頂戴、かう云ひながら、両、両手で、僕の手を、に、握り締めるんです。",
              "citation": {
                "source": "命を弄ぶ男ふたり（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあさあ、痛い目をしないうちに、早く渡したり、渡したり」「憎い奴等」　兵馬は金剛杖を握り締めると、彼等はバラバラと焚火の傍から走り出して、兵馬を取囲みました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "慢心和尚の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とか彼女達の手を私が握り締めることさえ出来たら、私は病気のことなんて平っちゃらなんだが。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "土壇のあたり、皎々としてまばゆく照り栄え、矢場のここかしこ仙台藩士の色めき立って、打ち睨むその目、にぎりしめる柄頭、一抹の殺気妖々としてたなびきながら、主水之介が手にせる重籐、キリキリとまた音もなく引き絞られたかと思われるや、ヒュウと弦音高く切って放たれたかと見るまに的は五寸、当りは黒星――。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しらんかおをして居る女のよこがおを見ながらソッとにぎりしめるとひやっこいするどい頭の髄まですき通す様な痛さがあたえられた。",
              "citation": {
                "source": "お女郎蜘蛛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにおなげきなさらないで」老婆はただ頭をふって、手をにぎりしめるばかりで、決してなぐさめられることのない人のようだった。",
              "citation": {
                "source": "寡婦とその子",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の　おうちに　そろり　近づきながら　にぎりしめるのは　さびた　大きな　かぎ。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり、おおげさにしないほうが」　夫人は、不安そうに、「それもそうね」　と、いって、両手の中でギュッとキャラコさんの手をにぎりしめると、「キャラコさん、ほんとうにお願いしてよ。",
              "citation": {
                "source": "キャラコさん",
                "author": "雪の山小屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　不二夫君はうれしさに、ギュッと小林少年の手をにぎりしめるのでした。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　中村係長は少年名探偵の手をとって、感謝にたえぬもののように、にぎりしめるのでした。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久しぶりだ、実に何年目だろう」「十七、八年になる」熊谷蓮生も手を伸べて、旧友の手をにぎりしめる。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "広田は、それを見て、さてこそと、おもわず両手を、にぎりしめるのでした。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みにこのような、充分水を含んだ細砂を両手で急に強く握りしめると、湿気が失せて固くなるが、握ったままでいるとだんだん柔らかくなってダラダラ流れ出します。",
              "citation": {
                "source": "夏の小半日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "へと／＼で、考えることも、観察することも、軍刀を握りしめる力もすっかり失って、たゞ惰性的に歩いている。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーキ色の軍服は、こっちで引鉄を握りしめると、それから十秒もたたないうちに、足をすくわれたように草の上へ引っくりかえった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "引鉄を握りしめると、銃声がして、畝にたかっていた鳩は空中に小気味よく弧を描いて、畠の上に落ちた。",
              "citation": {
                "source": "名勝地帯",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満洲に派遣されている軍隊と、支那に派遣されている軍隊は植民地満洲、蒙古をしっかりと握りしめるために番をさせられているのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンゲットの他あやんも到頭本望とげて、マニラで死ねるぞ」　振った手を握りしめると、痛々しく静脈が浮き上った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうもしないが、こうまず俘虜にしておいてどッこい……」と振放そうとする手を握りしめる。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しゅッしゅッと一本｜独鈷をしごき直して、ずっしりと蝋色鞘を握りしめると、静かに問いなじりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケツトの鉛筆をおやぢの手の指の間に挾んで、力まかせにそれを握りしめる。",
              "citation": {
                "source": "女",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "・握りしめるその手のヒビだらけ　暮れて寒い土を掘る寒い人　けふも出来そこなひの飯で寒い　一月廿八日　晴、霜、ありがたい手紙が来た、来た、来た。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "門司埠頭凱旋兵・生きて還つてきた空の飛行機低う　　　　□・芭蕉二株青い雨（追加）　星がまたたく草に寝る　　　　□・かたい手を握りしめる五月廿九日　晴、電車と汽車で緑平居へ、葉ざくらの宿。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅琴は驚いて、自分の胸を開き、暖めようとしたが、フローラは微笑んで、じっと紅琴の手を握りしめるのみであった。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（愕然として、刀の柄を握りしめる！",
              "citation": {
                "source": "袈裟の良人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
