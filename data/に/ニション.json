          "literary": [
            {
              "text": "それを決するには、どれだけの種類の書を「武鑑」の中に数えるかという、「武鑑」のデフィニションを極めて掛からなくてはならない。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、ようやくフェンダーも直り、イグニションもどうやらきくようになった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "駐車場で発見されたときには、キーはなかったのに、自宅近くでみつかったときには、キーがイグニションに入ったままだった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーはイグニションに差しこんだままだった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
