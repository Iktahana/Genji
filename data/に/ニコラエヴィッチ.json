          "literary": [
            {
              "text": "彼が何の気なしにそれを剥がして見ると、内側の洋皮紙に――イワン・トドロイッチよりニコライ・ニコラエヴィッチ大公に贈る――と認められてあった。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミョン・ニコラエヴィッチ！",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――セミョン・ニコラエヴィッチ！",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミョン・ニコラエヴィッチ。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミョン・ニコラエヴィッチと小さい日本女は、いろんな鼻つきをした子供の群にかこまれて、子供だらけの廊下を行った。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い戸をあけて、セミョン・ニコラエヴィッチは廊下の横の小部屋へ日本女と一かたまりの子供たちとを入れた。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い巻物を、一人のピオニェールに、セミョン・ニコラエヴィッチがわたした。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミョン・ニコラエヴィッチが説明した。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
