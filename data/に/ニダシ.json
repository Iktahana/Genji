        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大根の茹った匂いが、汁の煮出しの匂いと共に湯気を上げた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋の煮出し汁は、兼て貯えの彼特製の野菜のエキスで調味されてあった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、紫紺という桔梗によく似た草の根を、灰で煮出して染めるのです。",
              "citation": {
                "source": "紫紺染について",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……女難にだけは安心な男にも、不思議に女房は実意があるから、これはそこらの、あやしげな煮豆屋が、あんぺらの煮出しを使った悪甘いのではない。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほとんど生のままの味で煮出している。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "精分の多い煮汁はみな捨てゝしまひ、肉の煮出し殻を皿に盛つたものだ、かうした些細な食膳の変化にも感激するほどに、妻の献立表は、毎日のやうに単調を極めてゐたのであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして御米が湯を沸かしているうちに、煮出しを拵えるとか云って、しきりに鰹節を掻いた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで爺さん囲炉裏の上へ鍋をかけて、その中へ米を入れてぐずぐず煮出したものだね。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩引鮭の肉汁といふのは、名前通りに塩鮭の切身をとろ火で煮出した汁である。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば現時持て囃さるる「味の素」は蛇を煮出して作るというも嘘でないらしいと言う人あり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋茶を煮出した真黒な土瓶。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "深雪は、古びた土瓶の中へ、薬草を入れて、松の小枝と、松葉の枯れたのを、炉で焚いて、煮出していた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒場と云ってもそれは、馬糞よりも下等な馭者や、もっとそれよりもひどい下層労働者達が、未製のカルバスや生胡瓜を噛って、安酒を呷ったり、牛の臓腑を煮出したスープを啜って飲み食いする劣等な飲食店であった。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　突如藤吉の指さす方、天水桶の傍に、紫の煮出し殻を四角の箱から開けたまま強飯みたいに積み上げてある江戸紫屋自慢の看板。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "怨霊首人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処からともなく蕎麦のだしを煮出している匂いがする。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めの頃はそれでも奉公したのだからと思ひ、朝起きると煮干と昆布のはひつた煮出し袋を釜に入れ、火を焚きつけ、煤けたバンコや台の上や、棚なぞ拭くのでありましたが、日がたつにしたがつて、方作のつかないやうな錘が体中の力を鈍くしてしまふのでありました。",
              "citation": {
                "source": "小さい花",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅干の餡は梅干の酸味をよく煮出してその汁へ少しお酒を加えて葛を溶き込んでドロドロにしたのです。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココアもチョコレートも同じようなものですが、チョコレートはココアへバニラなぞを加えて精製したもの、それを削ってお湯で煮出しますが、ココアの粉になったものは直ぐに牛乳へ混ぜて煮出します。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大麦の黒く炒ったのと大豆のよく炒ったのと半分ずつ交ぜてよく煮出したのです。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから鯛の塩辛煮といって鰹のしおからを湯で煮出してその汁で鯛の切身をよく煮たのです。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の朝の最後の用事はこのポチに昨日のあまりの飯と牛肉の煮出しとを混ぜてやることである。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな俵のような雌花があとでいわゆるヤシャの実になり、わたくしなどは木彫の染料に、それを煮出してつかう。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーヒーのやうな強烈な香りの飲物を毎日いただく余裕のない時や胃の弱いときに、コーヒーの身がはりにほうじ茶を濃く熱く煮出して飲むと、ほんの少しだけ咽のどこかの感じがたのしくされる。",
              "citation": {
                "source": "あけび",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スオウの煮出した汁で凧などが赤く染めてありますが、あのスオウで染めた木綿布をその時分はスオウとはいわずに茜染といって居った。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜の馬肉が、水出しも煮出しもせず、肉の切り方を知らない連中が、タテに切ったものだから、噛めども噛めども噛み切れない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭や骨はもういちど焼き、粉にして煮出しに使ったり、そのまま飯に掛けて喰べたりした。",
              "citation": {
                "source": "雪と泥",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間でも、太陽を忘れているような、生気のない膳部番や、料理人や、老いたるお賄頭が、十年一日の如く、昆布の煮出し汁のにおいの中に住んでいる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "お常が煮出した茶を注ぐと、次郎が不器用な手で山盛りに御飯をつける。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
