[
  {
    "uuid": "9d3cdecb-7e29-5a04-9561-c2b6fa83a401",
    "entry": "煮出し",
    "reading": {
      "primary": "にだし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
