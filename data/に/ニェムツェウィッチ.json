        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "例えば、工場技師のニェムツェウィッチなどは、折さえあると、インガに云っているではないか？",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "インガは自身がインテリゲンツィアであるだけ、ニェムツェウィッチを愛せない。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "インガに対して、彼はニェムツェウィッチのようにこしらえ上げた文句を云うことは知らない。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日中寝巻姿でゾロリとしている技師ニェムツェウィッチの女房が、騒動をききつけてドアから鼻をつっこみ、それを鎮めるどころか、折から書類入鞄を抱えてとび込んで来たドミトリーを見るや否や、キーキー声で喰ってかかった。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "技師のニェムツェウィッチも相変らずだ。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「すると……」　ニェムツェウィッチは執念深く云った。",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「タワーリシチ、ニェムツェウィッチ！",
              "citation": {
                "source": "「インガ」",
                "author": "――ソヴェト文学に現れた婦人の生活――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
