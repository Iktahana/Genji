          "literary": [
            {
              "text": "私ハタシカニソレヲ覚エテ居ルノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ予ニソレヲ誇示スルタメニ浴室ヘ招イタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ニソレヲ見セルノガ目的デプールヲ作ルヨウナモノナンダ」「ソレデモソレハイヽコトデゴザイマスワネ、自分ノ家ニプールガ出来タラ経チャンダッテ喜ブデショウシ、………」陸子ガ云ウト婆サンガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」彼女ガ若シ真ニソレヲ忌マワシク感ジテイルナラ、今少シ違ッタ表情ヲ示ス筈デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ更ニソレヲ以テ第二ノタンポヲ叩キ、朱ヲ薄クシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
