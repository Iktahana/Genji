          "literary": [
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモトキドキ私ニコンナコト云ウノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝ホド測リマシタ時ハ上ガ一四五、下ガ八三デ、至極順調デゴザイマシタノニ、ドウシテ急ニコンナニ上ッタンデゴザイマショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日ノヨウニ、九月中ニコンナコトガアルノモ珍シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女ノ人ニコンナ所ヲ触ラセルノハイヤダヨ」予ハワザトソウ云ッテヤッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
