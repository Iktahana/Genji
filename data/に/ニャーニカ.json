        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "月曜　ニャーニカが二人で私のシーツをとりかえ乍らの話。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニャーニカとフェルシンニッツアの間に昔はセネラーが居た。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い上っぱりに白いプラトークをかぶったニャーニカが来る。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニャーニカの労働は十二時間――午前八時―午後八時、これが二人ずつ四組あって、当直もするのだ。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニャーニカは大体親切だ。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニャーニカ達は、私が毎朝茶に牛乳を入れてのむという習慣を決して記憶しない。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コップへ半分ばかり温めて頂戴　私はお茶を牛乳とのむんだから――　お茶は戸棚に入ってる　モスク※では　まだ、身動きの出来ぬ病人はよごれて寝て居ても当人やニャーニカの恥辱にはならぬ、寛容があるらしい。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前七時に当直のニャーニカが入って来て手拭の端をぴしょぴしょ濡してくれる。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
