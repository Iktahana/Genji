          "literary": [
            {
              "text": "これはコロムビアにフリートマンがお国振りを演奏して四枚入れたのと（Ｊ八〇一〇―三）、ビクターにニーヅェルスキーというポーランドのピアニストの入れた一枚物がある（ＪＡ一三四）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーヅェルスキーはそれよりたしなみがよく、落ちついた繊麗さが好感を持たせる。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
