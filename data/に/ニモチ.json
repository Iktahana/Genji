  {
    "uuid": "dbe711a0-c54e-5a23-96fc-ed410e1ae9fe",
    "entry": "煮餅",
    "reading": {
      "primary": "にもち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "榛軒先生十七回忌に付、雑煮餅一統へ振舞。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月で雑煮餅をよばれたが、大きくて、辛口なのには閉口した。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは二人で心ばかりの祝いのお雑煮餅もいただきました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらは元日の黎明に若水汲んで含嗽し、衣を改めて芝浦、愛宕山、九段、上野、待乳山などに初日の出を拝し、帰来屠蘇雑煮餅を祝うて、更に恵方詣をなす、亀戸天神、深川八幡、日枝神社、湯島天神、神田明神などはその主なるものである。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝の雑煮餅だって随分荒ごなしだったゼ」胃吉「あれは堪忍してもらいたい。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は元日だから楽をしようと思っている処へ朝の雑煮餅が飛込んだも飛込んだも十八枚飛込んで来た。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝なんぞは雑煮餅の大きいのを十八｜片食べました」妻君「オホホ、貴君が物を召上るのはホントにお美事です。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕なんぞは国へ帰るとまだ少食の組だよ、僕ら位の年の者は雑煮餅の三十枚位平気だからね。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "汁粉屋に雑煮餅なく鰻屋に鰌を絶やす事あり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹽煮餅を買ふ隙もありやしません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩煮餅を買う隙もありゃしません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "第廿七吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、正月なので、広い台所の板敷の隅っこで、ほかの下男たちと共に、水ッ洟をすすりながら、粟の雑煮餅を、めずらしく喰べただけだった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なあ、十郎」「は」「おたがいに、屠蘇もまだ酌みあわず、雑煮餅もまだだったな」「そうでした」「さぞ兵どもは、陰でぶツぶツ申しておることだろう」「いや、さような気ぶりは、つゆ見えません。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
