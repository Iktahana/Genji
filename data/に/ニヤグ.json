        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "酒と温泉とに対しては私はグニヤグニヤフニヤフニヤだ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「他人の事となると……」などと云ひながら、膳の上の食物を指でつまんで、具合の悪い入歯でニヤグ／＼と噛んでゐた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "打水をした庭を見降ろしながら、そこに在つた餠菓子を抓んでニヤグニヤグと頬張つてゐた。",
              "citation": {
                "source": "坂道の孤独参昧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてニヤグニヤグと頤を動かせながら反芻動物のやうにそれを噛みしめてゐた。",
              "citation": {
                "source": "痴想",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いぢわるをしました　グニヤグニヤになつたお猫さんとお黒さんは一晩ぐつすりねむつたので、すつかり元気を取りもどしました。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
