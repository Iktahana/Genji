        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "デスカラ身体ヲ大事ニスルヨウニクレグレモ願イマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "誠ハ天ノ道ナリ、コレヲ誠ニスルハ人ノ道ナリ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ致富ト改造後ノ致富トガ致富ノ原因ヲ異ニスルヲ了解スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ガ日本ノ西海道ナル所以ヲ明ニスルトキ百般ノ施設悉ク日鮮人ノ融合統一ヲ來サザル者ナク、獨立問題ノ如キ希フト雖モ生起セザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ガ日本ノ西海道タリ朝鮮人ガ日本人ト大差ナキ民族タル理由ニヨリテ、日本國民タル國民權ヲ最初ニ且ツ完全ニ賦與セラルルヲ明カニスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ講和委員ハ何ガ故ニ英米ト日本トガ國民精神ノ根本、國家組織ノ信念ヨリ異ニスル所以ヲ指摘シテ、日本國民本有ノ國家有機體的信仰ヲ彼等ニ訓ユルコトナカリシカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵營又ハ軍艦内ニ於ケル將校ト兵卒トノ物質的生活ヲ平等ニスル所以ハ自明ノ理ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "書ク文字ト活字ハチガツテアタリマエナノデアルカラ気ニスル必要ハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、二、ソノ色、黒褐色ノ水甕ニシテ、底ヲ逆ニスルト、赤キ「ペンキ」デ４０８４ノ数字ガ記サレタルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "仍リテ両者ハ根本的ニ構造ヲ異ニスルモノト謂フベク、従テ本願ハ、援用立像ヲ以テ拒絶セラルル理由ヲ発見シ得ザルモノナリ。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ヲ以テ之ヲ観レバ、支那ハサテ置キ、我邦ホド古物ヲ疎略ニスル国ハ有ルマジト思フナリ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "有力者中好古ノ名有テ其ノ実無キ輩ハ、徒ラニ古クモ有ラヌ玉瓶瑶盃ニ千金ヲ費ヤシ、反故紙ニモ劣ル偽其昌贋徴明ナドニ流涎シテ、其嚢ヲ倒ニスルハ愚カナルコトニコソ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾妻鏡は果して純粹の日記なるや否や星野博士の吾妻鏡考にも文體ヲ審ニスルニ前後詳略アリ前半ハ追記ニシテ後半ハ逐次續録セシニ似タリとありて徹頭徹尾純粹の日記にあらざることは博士既にこれを云はれたり。",
              "citation": {
                "source": "吾妻鏡の性質及其史料としての價値",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハ大ヘンモノヲ大切ニスル子デシタカラ、イツモ、ボンコチヤンヲブラツシデ、テイネイニハイテ、テイレヲイタシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、ハジメニモ申シ上ゲタ通リ、モンコチヤンハ大ヘンモノヲ大切ニスル子デスカラ、ボンコチヤンニツイテヰタホコリヲ、テイネイニブラツシデハイテヤリマシタカラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬レバ山陰道中峰ヲ廻リ路ヲ転ジ歩々観ヲ異ニスルガ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、他人ヲ挑発スルガ如キ華美ナル服装ヲ慎ミ、歩行中、嬌声ヲ発シ、マタ進駐軍ニ笑顔ヲ見セヌヤウニスルコト。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、単独ノ歩行ヲ避ケ、止ムヲ得ザル場合ニハ三人以上連レダツテ歩クヤウニスル。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "○石器時代人民相互ノ關係ハ、古今ノ比較ニ於テモ東西ノ比較ニ於テモ、通例ノ人種調査ニ要スル順序ヲ經テ始メテ明カニスルヲ得ベキハ勿論ナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同一地方ニ於テモ時代ヲ異ニスレバ固ヨリノ事、假令同一時代ナリトモ、種族ヲ異ニスル石器時代人民ノ棲息スル事有リ得ベカラザル事ニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等遺物ノ比較研究ハ石器時代人民生活ノ状態ヲ明ニスルノミナラズ、又甲乙兩地交通ノ有無ヲモ表示ス。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ニ關スル研究ハ啻ニ日本ノ古事ヲ明カニスルニ於テ有力ナルノミナラズ、人類學上益スル所又决シテ少カラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結句、古鈔本中、ヒトノシニスルの訓あり、略解でヒトノシニセシと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "自殺をするにしてはカネオクレが納得のいかないことなので「ナゼクビキルスヘン」との問い合わせをしたところ「クロシロニスルスグカネオクレ」との返電が来て、はじめて息子の真意が読めたとのことである。",
              "citation": {
                "source": "おきなわやまとぐち",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルカドウカ分ラナイガ、大工ヲ呼ンデ滑リ台ト滑車ヲ作ラセ、医療器械屋ヲ招イテ首ノ寸法ヲ測ッテ貰ウコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局コルセットハ止メルコトニシ、滑リ台ニ寝テ頸ノ牽引ダケヲスルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
