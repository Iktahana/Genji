[
  {
    "uuid": "5ed974e9-125b-56d4-a674-61296da7b111",
    "entry": "鮸",
    "reading": {
      "primary": "にべ",
      "alternatives": [
        "ニベ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
