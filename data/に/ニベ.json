    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "戀を戀する人わたしはくちびるにべにをぬつてあたらしい白樺の幹に接吻した。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでしかたのない夕暮れになつてしまつた燈火をともして窓からみれば青草むらの中にべらべらと燃える提灯がある。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の莊嚴さを持たない裸樹はぎこちなく筋ばつた枝を空に張つて立並び、糊を塗りつけたやうにべた／＼な黒土の上には、芥と枯葉と枯草とがいぎたなく粘り着いて居り、もうすつかり春らしくなつて來た大空に對し殊更ら憐れな對照を作る。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日も私は、別に編みたい気持も無かったのだが、お母さまの傍にべったりくっついていても不自然でないように、恰好をつけるために、毛糸の箱を持ち出して余念無げに編物をはじめたのだ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」かっぽれは、少しおされ気味になって、にやにやと無理に笑って、「私があなたから、まさか、豚のしっぽを借りようとしたわけではなし、こんなもの、とにべもなく言われては、私の立つ瀬が無くなります。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮膚にべとつくやうでかなはんのだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女中あがりらしいその少女は、品のない口調でそう叫んで、私の傍の椅子にべったり坐った。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青扇は素裸のまま脱衣場の畳のうえにべったり坐って足の指の爪を切っていたのである。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなりそう言われて自分は、自分の顔の半面にべったり赤痣でもあるような、みにくい不具者のような、みじめな気がしました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふとその言葉がいまはじめて皮膚にべっとりくっついて思い出され、苦笑した。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮膚にべとつくようでかなわんのだ」私もそれは同じ思いであった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「森影暗く月の光を遮った所へ来たと思うと少女は卒然僕に抱きつかんばかりに寄添って『貴様母の言葉を気にして小妹を見捨ては不可ませんよ』と囁き、その手を僕の肩にかけるが早いか僕の左の頬にべたり熱いものが触て一種、花にも優る香が鼻先を掠めました。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どつちでも行かれますけ……」と、Ｋさんに尋ねられた老婆はにべもなく答へて、すたすたと歩いて行つた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾日経ったんだか、べろべろに毛が剥げて、羽がぶらぶらとやっと繋って、地へ摺れて下ってさ、頭なんざ爛れたようにべとべとしている、その臭気だよ。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、にべもなく言ひすてて、袖も動かさで立ちたりき。",
              "citation": {
                "source": "紫陽花",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其舌の鹽梅といつたらない、いやにべろ／＼して頗るをかしいので、見物が一齊に笑つた。",
              "citation": {
                "source": "迷子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "下駄の泥が帶にべつたりとついたのも構はないで、抱きあげて、引占めると、肩の處へかじりついた。",
              "citation": {
                "source": "迷子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生の間に流行っているらしい太いズボン、変にべたっとした赤靴。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲一つなく暮れて行く空を刺していた黒い鉄骨のエッフェル塔は余りににべも無い。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が成功と思ってくれるのを、いくら自分は不満足だとて、にべもない顔をしているのは、あまりに人間味がありません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが入口から三本目の若い柏の木は、ちやうど片脚をあげてをどりのまねをはじめるところでしたが二人の来たのを見てまるでびつくりして、それからひどくはづかしがつて、あげた片脚の膝を、間がわるさうにべろべろ嘗めながら、横目でじつと二人の通りすぎるのをみてゐました。",
              "citation": {
                "source": "かしはばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とつづけざまにべらべら挨拶しました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが入口から三本目の若い柏の木は、ちょうど片脚をあげておどりのまねをはじめるところでしたが二人の来たのを見てまるでびっくりして、それからひどくはずかしがって、あげた片脚の膝を、間がわるそうにべろべろ嘗めながら、横目でじっと二人の通りすぎるのをみていました。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐はちょっと眼を円くしてつっ立って音を聞いてゐましたがいきなり残りの葡萄の房を一ぺんにべろりとなめてそれから一つくるっとまはってバルコンへ飛び出しひらっと外へ下りてしまひました。",
              "citation": {
                "source": "黒ぶだう",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「知らねえよ、コードなんて」　と、片桐はニベもない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりしづかに自分を見詰めてゐるところへ、風雨の中を酒が来た、しばらくして樹明君とＳさんとがやつてきた、ニベと胡瓜とを持つて。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ御免蒙りまっしょう」　というニベもない挨拶だ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　俺はニベもなく云いかえした。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初にそれを所望したのは豊後の大友宗麟であったが宗湛はニベも無く断わった。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ニベも無く断わった。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
