      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "drum",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕食には、新鮮な鮸の塩焼きが出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "釣りの名人である彼は、あっという間に大きな鮸を釣り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域の特産品は、肉厚な鮸の干物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "皮膚にべとつくようでかなわんのだ」私もそれは同じ思いであった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どつちでも行かれますけ……」と、Ｋさんに尋ねられた老婆はにべもなく答へて、すたすたと歩いて行つた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一、ノルデは三べん胴上げのまま地べたにべちゃんと落とされた。",
              "citation": {
                "source": "ペンネンノルデはいまはいないよ　太陽にできた黒い棘をとりに行ったよ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生の間に流行っているらしい太いズボン、変にべたっとした赤靴。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、小鼻の両傍から頤へかけて、口のまはりを、ぐしやりと輪取つて、瘡だか、火傷だか、赤爛れにべつたりと爛れて居た。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者は川沿いのある芝地を空風の吹く夜中に通っていると、何者かが来て不意にべろりと足をなめる、すると急に発熱して三日のうちに死ぬかもしれないという。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女中あがりらしいその少女は、品のない口調でそう叫んで、私の傍の椅子にべったり坐った。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが入口から三本目の若い柏の木は、ちょうど片脚をあげておどりのまねをはじめるところでしたが二人の来たのを見てまるでびっくりして、それからひどくはずかしがって、あげた片脚の膝を、間がわるそうにべろべろ嘗めながら、横目でじっと二人の通りすぎるのをみていました。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐はちょっと眼を円くしてつっ立って音を聞いてゐましたがいきなり残りの葡萄の房を一ぺんにべろりとなめてそれから一つくるっとまはってバルコンへ飛び出しひらっと外へ下りてしまひました。",
              "citation": {
                "source": "黒ぶだう",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はあい、なあにべつだん心配はありません。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「森影暗く月の光を遮った所へ来たと思うと少女は卒然僕に抱きつかんばかりに寄添って『貴様母の言葉を気にして小妹を見捨ては不可ませんよ』と囁き、その手を僕の肩にかけるが早いか僕の左の頬にべたり熱いものが触て一種、花にも優る香が鼻先を掠めました。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれ程の容色にべらべらしたものでも着せて見たいが親の人情だ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の莊嚴さを持たない裸樹はぎこちなく筋ばつた枝を空に張つて立並び、糊を塗りつけたやうにべた／＼な黒土の上には、芥と枯葉と枯草とがいぎたなく粘り着いて居り、もうすつかり春らしくなつて來た大空に對し殊更ら憐れな對照を作る。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が成功と思ってくれるのを、いくら自分は不満足だとて、にべもない顔をしているのは、あまりに人間味がありません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、老成た事を云って、中でも矮小が、鼻まで届きそうな舌を上舐にべろんと行る、こいつが一芸。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが入口から三本目の若い柏の木は、ちやうど片脚をあげてをどりのまねをはじめるところでしたが二人の来たのを見てまるでびつくりして、それからひどくはづかしがつて、あげた片脚の膝を、間がわるさうにべろべろ嘗めながら、横目でじつと二人の通りすぎるのをみてゐました。",
              "citation": {
                "source": "かしはばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とつづけざまにべらべら挨拶しました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "面にべったり蜘蛛の巣を撫払いて、縁の下より這出づるは、九太夫にはちと男が好過ぎる赤城の下男八蔵なり。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と驚く侍女より照子は先にべったり坐り、「私はもう。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "繃帶を覗いた唇が、上下にべろんと開いて、どろりとして居る。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、にべもなく言ひすてて、袖も動かさで立ちたりき。",
              "citation": {
                "source": "紫陽花",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　善吉は思はず顔を出して、火鉢のなかを覗かうとすると、彼の二人は突然善吉の手を捉へて、大きい赤膏薬をその両方の眼にべつたりと貼り付けてしまつた。",
              "citation": {
                "source": "赤膏薬",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "――言いかえれば、宮子がなぜ、鶴雄を待っていたのか――鶴雄が今日の正午にべにやへ来ることを、なぜ知っていたのか。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう気持がしかし花井に通ぜぬはずはなく、花井もだんだんにべたべたとおたかと親しくし、しばしば図々しくおたかの家の座敷で寝そべったりした。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "Nibe croaker (Nibea mitsukurii)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日本近海では、鮸（ニベ）がよく漁獲される魚種の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "市場で珍しい鮸を見つけ、早速購入して調理した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鮸は、淡白な味わいで様々な料理に利用される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
