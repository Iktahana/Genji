        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古墳ノ掃苔ニオケルヤマタ彼ハ専ラ尾陽所在ノモノニノミ精シキコトアタカモ我ノ東都ニ限ラレシニ似タリトイフベシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「余ノ詩ニオケルヤ固ヨリ遊戯ノミ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕山は「アヽ上人ノ先考ニオケルヤ半面ノ識アルニ非ズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ヲ以テ余ノ上人ニオケルヤ交情｜最熟ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ韻語ニオケルヤ固ヨリ遊戯余事ニ属ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ余ノ翁ニオケルヤ文字ノ交ニ非ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独リ予及ビ三島遠叔ニオケルヤ盛ニ推許ヲ加ヘ、人前ニ称道シテ唯及ザランコトヲ恐ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
