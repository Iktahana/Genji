          "literary": [
            {
              "text": "心をおどらせてひろげ、むこうの街燈の所まで行つて開いて見ると鉛筆の走り書きで今スグ行クカラムコウノポストノソバニイテオクレというのです。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はブルバラネク地方の新婚者等の古くからの習慣に從つて、ブルトンの國の端れともいふべきラ・トリニイテの禮拜堂へと向つて行くのであつた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "何シロ出張旅行ガ多イシ、東京ニイテモ宴会ガ多クテ夜ガオソイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカラナイシ、ヨソノオジサンガ、ソバニイテ、コワイカオシテ、ナニモイッテハ……」　バッタリ声が切れた。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
