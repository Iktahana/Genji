          "literary": [
            {
              "text": "今ハ蒙昧ノ　露ハナル領域ニサヘ驕ルスベモナイ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カノ下等ナル人種ハ、其心既ニ適宜ニ組織シタル事ニサヘモ、相應スルコト能ハズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長公ノ御時ニサヘ、従ハザル諸所ヲ、カク僅カバカリノ間ニ、根来寺、雑賀、熊野山中、高野領ニマデ亘リテ、悉ク打チナビケ給フ、果断、決断ノ程、ヨク勘弁シテ見ルベシ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
