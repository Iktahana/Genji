          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "数日間の議論を経て、ようやくチームは最終的な計画を煮詰めることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロジェクトの目標を明確にするために、もう少しアイデアを煮詰める必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この報告書の草案を、みんなで意見を出し合ってさらに煮詰めていこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
