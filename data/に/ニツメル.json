    "definitions": [
      {
        "index": 1,
        "gloss": "to boil down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ソースを弱火でじっくり煮詰めて、味を濃くする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カレーのルーを煮詰めることで、コクと旨味が増す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このジャムは、フルーツを時間をかけて煮詰めて作られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "皿鍋にこの血の汁を移し家鴨の薄身をいれて掻き廻しながら煮詰めると汁は肉の周囲にチョコレート色に淡く固まる。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚の三枚肉を杉箸が通るほどに湯煮て一寸四角に切って水一升に酒一合｜味淋一合位な割で五時間ほどよく煮て火から卸す一時間も前に醤油を多く入れて煮詰めるのだ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "第五十一　水道の水　梅干の煮方はお登和嬢によりて説明せらる「小山の奥さん、梅干を煮ますのは最初三度ほどもよく湯煮漏してそれから味淋とお砂糖と鰹節を沢山入れて三時間位よく煮詰めるのです。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しも苦くない所が妙だ」妻君「その苦味を取るのが少し面倒で、最初幾度も幾度も湯煮漏して苦味が全く抜けた時分に味淋とお砂糖を加えてよく煮詰めるのです。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを最初は強い火にかけて上へ浮いて来るアクを幾度も丁寧に掬くい取って三十分間煮てアクがいよいよ出なくなったら火を弱くして一時間煮詰めるのです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮詰める時決して掻き廻してはいけません。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉と臓腑と頭、手、足、甲羅の縁などを細かく刻み込み、これに薑を加えて生醤油を注ぎ、炭火で気ながに煮詰めるのであるが、こんな贅沢な佃煮は他にはないかも知れぬ。",
              "citation": {
                "source": "すっぽん",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じっくり煮詰める必要がある。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "概してエルドレッドは物事をじっくり煮詰めるまで話さない。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻袋につめる連中があとから追ッかける。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "といっても、このトランクにつめるようなものは、なんにもありません。",
              "citation": {
                "source": "空とぶトランク",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこもまた、屋台には違い無いのですが、奥が深く、土間にさまざまの腰掛けが並べられていて、それこそ、「お順につめる」と、十人くらいの客が楽に飲み食い出来たのです。",
              "citation": {
                "source": "女類",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビール瓶に藁筒を被して自動的に箱につめる大きな器械がある。",
              "citation": {
                "source": "地獄街道",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛇も毒虫もキライでして、とてもツヅラにつめる勇気がありません。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "家へ帰ってから、お菓子や、果物をランドセルにつめるとき、そばで見ていたお姉さんが、「良ちゃん、そんなに持っていってどうするの？",
              "citation": {
                "source": "少年の日二景",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋のひろさは一坪あまり、すなわち四平方メートルだったから、夜寝るときには、ひらめを魚箱につめるように、みんな横向きになり、しかも頭足交互に並ばねばならなかった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "野見は、そいつを鼻の孔につめる。",
              "citation": {
                "source": "長閑なる反目（三場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "石狩川の鉄橋へ行って、橋の上から採水器を下して河水を採り、それを一立びんにつめる。",
              "citation": {
                "source": "亡び行く国土",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十六の千両箱を一艘や二艘の小船につめるわけのもンじゃない。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "両国の大鯨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのブラウスがなくて何を着たらいいんだ」「…………」　いっしょにつめるように素子が揃えて出したすべてのものを、スーツ・ケースに入れたとしか伸子には思えないのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小麦を蒔いて、刈って、袋につめるのは農民の仕事だ。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その僅の時間で、死体を処分して、トランクにつめるなんて芸当が出来るでしょうか。",
              "citation": {
                "source": "湖畔亭事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーカス団員だけでなく警視庁のうでききの刑事が三人ずつ、夜昼こうたいで、笠原邸につめることになったのです。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋はあるとした上でも、これだけのものを沸騰させ煮つめるだけの「燃料」を自分は貯えてあるだろうか。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山椒昆布を煮る香いで、思い切り上等の昆布を五分四角ぐらいの大きさに細切りして山椒の実と一緒に鍋にいれ、亀甲万の濃口醤油をふんだんに使って、松炭のとろ火でとろとろ二昼夜煮つめると、戎橋の「おぐらや」で売っている山椒昆布と同じ位のうまさになると柳吉は言い、退屈しのぎに昨日からそれに掛り出していたのだ。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同はこの木の幹をきって、そのきり目からふきだすところの液をあつめて、それを煮つめると、なべの底に砂糖のかたまりがのこった。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜｜本牧あたりで獲れたまきえびを、生醤油に酒を三割ばかり割った汁で、弱火にかけ、二時間ほど焦げのつかないように煮つめる。",
              "citation": {
                "source": "車蝦の茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで煮つめるのが美味しい煮方である。",
              "citation": {
                "source": "塩昆布の茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、直火ではなく、湯煎で煮つめるのである。",
              "citation": {
                "source": "塩昆布の茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩蒸しの製法は、酒塩で煮つめる江戸前もあるが、そんなにしなくても、貝ごと水洗いしたあわびに、塩を充分にまぶし、一時間以上蒸せばよい。",
              "citation": {
                "source": "東京で自慢の鮑",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to reach a conclusion",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
