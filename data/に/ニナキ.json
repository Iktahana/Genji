          "literary": [
            {
              "text": "父母共ニナキ兒童ヲ孤兒院ニ收容セザル所以ハ、孤兒院ノ弊害甚ダシキト、兒童ノ保護者トシテ血族長者ノ保護ニ優ル者ナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（３）「其の下には」ト原文ニナキモ、木ト花草ノ關係ヨリ入レ候ヘドモ、必要ナキヤウニ思ハル。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ニオイテカ彼ニナキ所ノモノ往々我ニアリテ我ニ闕キシ所ノモノ彼｜悉クコレヲ補ヘリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
