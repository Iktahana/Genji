          "literary": [
            {
              "text": "だから服飾として誇張されているものが、そのままほんとうの生々した女の心の張りから生じる線や色の取合せのニューアンスというものが壊される場合が比較的に多い。",
              "citation": {
                "source": "女性の生活態度",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四にあの作は人間の細かな心持ちのさまざまな相やニューアンスの展開であって動作に乏しい。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "作品などもいやしくも人間の心情のニューアンスなら、万人の心に必ず解るのだ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
