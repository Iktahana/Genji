[
  {
    "uuid": "6e32f1ed-9f33-511b-8c2e-365321b07206",
    "entry": "煮染める",
    "reading": {
      "primary": "にしめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
