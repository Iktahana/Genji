    "definitions": [
      {
        "index": 1,
        "gloss": "to boil down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お正月の煮しめを作るために、根菜を醤油とみりんでじっくりと煮染める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母は時間をかけて豆を煮染め、中までしっかりと味を染み込ませた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鍋の中で飴色に煮染められた大根は、見るからに美味しそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「それも、着物の下にしめる帯なんでしょう。",
              "citation": {
                "source": "カラー",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "月光の谿緑ヶ丘夜景角の月黄にしめる横雲のうへ、燦爛とうちあがる青きぬがさ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "角の月黄にしめる横雲のうへ、燦爛とうちあがる青きぬがさ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだとすれば、窓は内側からふたたびあのようにしめることはできなかったはずだ。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "一枝の去ったのを見定めて、きっと来てくれる倭文子だろうと、新しい希望を胸に湧かして待っていたが、五分経ち十分経ち、彼の袖が夜露にしめるまで待ったけれども、倭文子はとうとう来なかった。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "花を踏みては、和らかき踵にしめる紅色の名殘の色をかへりみて、暮れゆく春を惜しむかな。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "広大な地域をなかばアジアになかば西欧にしめるスラブ人も、イタリーや、フランスがそれを経験したようには経験しなかった。",
              "citation": {
                "source": "現代の主題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　控所の直ぐ近くの室の入口の重い扉が、力一杯に手荒くブツケるやうにしめる音がした。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう網の底がすっかり地を離れて浮き上がって来ているので、急にしめる速度が増す。",
              "citation": {
                "source": "大謀網",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それから、たびたびここであなたと逢って、人間の親切というものを深く心にしめるにつけ、自分のしていることがいかにも果敢なく思われてきて、新しい出発の動機をつくるために自首するといい出しました。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして、あなの中へはいって、下からふたを、もとのとおりにしめるのは、いっそうむずかしいのです。",
              "citation": {
                "source": "鉄人Ｑ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "法師が入った口とは対向い、大崩壊の方の床几のはずれに、竹柱に留まって前刻から――胸をはだけた、手織｜縞の汚れた単衣に、弛んだ帯、煮染めたような手拭をわがねた首から、頸へかけて、耳を蔽うまで髪の伸びた、色の黒い、巌乗造りの、身の丈抜群なる和郎一人。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其内腰に挟んだ、煮染めたやうな、なへ／＼の手拭を抜いて克明に刻んだ額の皺の汗を拭いて、親仁は之で可しといふ気組、再び前へ廻つたが、旧に依つて貧乏動もしないので、綱に両手をかけて足を揃へて反返るやうにして、うむと総身の力を入れた。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがまあ、大したことはありますまいよ」　約束の通りに強飯やお煮染めの御馳走が出た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "縞柄も分らない筒袖の古浴衣に、煮染めたやうな手拭を頬被りして、水の中に立つたのは。",
              "citation": {
                "source": "光籃",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "褌の掛がえを一条煮染めたような手拭、こいつで顱巻をさしたまま畳み込んだ看板、兀げちょろの重箱が一箇、薄汚え財布、ざッとこれで、身上のありッたけを台箱へ詰め込んだ空車をひいて、どうせ、絵に描いた相馬の化城古御所から、ばけ牛が曳いて出ようというぼろ車、日中は躄だって乗りやしません。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "幅狭き布子の上掻を引張り合せて、膝小僧を押包み、煮染めたような手拭にて、汗を拭き拭き畏り、手をつきて美人の顔、じっと見詰むる眼に涙。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内腰に挟んだ、煮染めたような、なえなえの手拭を抜いて克明に刻んだ額の皺の汗を拭いて、親仁はこれでよしという気組、再び前へ廻ったが、旧によって貧乏動もしないので、綱に両手をかけて足を揃えて反返るようにして、うむと総身に力を入れた。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪のエッセンスを煮染めたような地元、守口、門真の風土には、ロックマニアで作家志望の感性には受け入れがたい臭みがあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほかには、やはり鰺の身を※つて入れた胡瓜もみの小皿と、煮染めの皿とがあつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾頭附き、膾、煮染め、數の子、汁椀などがついてゐる。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだけならば、至極結構なわけで、別にお話の種になるような事件も起らない筈ですが、嘉永二年の六月十五日、この日は赤坂の総鎮守氷川神社の祭礼だというので、市川さんの屋敷では強飯をたいて、なにかの煮染めものを取添えて、手習子たちに食べさせました。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんやお嬢さんや女中が手伝って、めい／＼の前に強飯とお煮染めをならべる。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕の内には煮染めが添えてあるが、それが旨いということになっていて、芝居のみやげに買って帰る人も沢山あった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "人力車に乗って帰る人が幕の内の折詰を膝の上に重ねて置いて、その煮染めの汁が浸み出して着物を汚したなどという話をたびたび聞いた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ」「醤油で煮染めたような物じゃ困るナ」　南部牛は既に四つの大きな肉の塊に成って、その一つズツの股が屠場の奥の方に釣された。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮染めたような木綿の袷に帽子無しの頬冠り、乞食のような風采ではあったが、眉目も清秀で気品もあり何うやら学問もありそうだったので、乞いを入れて一泊させた。",
              "citation": {
                "source": "国事犯の行方",
                "author": "―破獄の志士赤井景韶―",
                "note": "青空文庫"
              }
            },
            {
              "text": "独言つつ月もあかしの町外れを、一歩は高く一歩は低く、ひよろりひよろりと来かかる男、煮染めたやうな豆絞りの手拭、だらしなく肩に打掛けて、仕事着の半纏も、紺といはれしは、いつの昔の事やらむ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほれ、これが金平……煮染めもありますで……ひらべの煮付け……」　リュックを開いて、兄の取り出しているものは、掛軸でもなければ什器、茶道具の類でもありません。",
              "citation": {
                "source": "仁王門",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
