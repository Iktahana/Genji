[
  {
    "uuid": "2e3c15b9-0dbb-5685-8389-2e7aa96a01a8",
    "entry": "煮える",
    "reading": {
      "primary": "にえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
