    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ際、障害物ノ摩擦ニヨリ舳二反目ヲ約二尺スリキラル。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ニヨリマストアタリノ山々ガ浮キアガッタカト思ワレルクライ空ガ美シイ時ガアリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本亦五十年間ニ二倍セシ人口増加率ニヨリテ百年後少クモ二億四五千萬人ヲ養フベキ大領土ヲ餘儀ナクセラル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三期ハ武士ト人民トノ人格的覺醒ニヨリテ各ソノ君主タル將軍又ハ諸侯ノ私有ヨリ解放サレントシタル維新革命ニ始マレル民生國時代ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "民國八年マデノ支那が前者タル理由ニヨリテ後者タル自耳義ヨリ合理的ナリト言フ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米人ノ「デモクラシー」トハ社會ハ個人ノ自由意志ニヨル自由契約ニ成ルト云ヒシ當時ノ幼稚極マル時代思想ニヨリテ、各歐洲本國ヨリ離脱シタル個々人が村落的結合ヲナシテ國ヲ建テタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ限度ヲ破ル目的ヲ以テ財産ヲ血族其他ニ贈與シ又ハ何等カノ手段ニヨリテ他ニ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此限度ヲ破ル目的ヲ以テ血族其他ニ贈與シ又ハ其他ノ手段ニヨリテ所有セシムルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ納付ヲ拒ム目的ヲ以テ血族其他ニ贈與シ又ハ其他ノ手段ニヨリテ所有セシムルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ原則ト云フ者アラバ、只國家ノ保護ニヨリテノミ各人ノ土地所有權ヲ享受セシムルガ故ニ、最高ノ所有者タル國家ガ國有トモ民有トモ決定シ得ベシト云フコト是レノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ都市ノ積極的發達ハ此財源ニヨリテ自由ナルト共ニ、其ノ發達ヨリ結果スル借地料ノ騰貴ハ亦循環的ニ市ノ財源ヲ豐カニス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツラスト」「カルテル」ガ分立的競爭ヨリ遙カニ有理ナル實證ト理論ニヨリテ國家的生産ノ將來ヲ推定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "改造後ノ將來、事業ノ發達其他ノ理由ニヨリテ資本ガ私人生産業限度ヲ超過シタル時ハ凡テ國家ノ經營ニ移スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ利己的欲望中ニ含有サルル斯ル幾多ノ動機ハ、其ノ事業ヲ發展セシメタル國家的認識ト、國家ニ移レル事業ヲ其人ニ經營セシムル手腕發揮ノ自己滿足トニヨリテ、實ニ爭ヒテ私人生産業限度ヲ超越セントスル奮鬪心ヲ刺※シ鞭撻スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民膏血ノ貯金又ハ事業ノ運命ヲ決スベキ預金等ガ銀行ノ破産ニヨリテ消散スルコトハ國民生活ノ一大不安ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ屍山血河ニヨリテ獲得シタル鑛山（例ヘバ撫順炭鑛ノ如キ）ヲ少數者ニ壟斷シツツアル現時ノ状態ハ實ニ最惡ナル政治ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ目的ノ爲ニ凡テ關税ハ此省ノ計算ニヨリテ内閣ニ提出ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹽、煙草ノ專賣制ハ之ヲ廢止シ、國家生産ト私人生産トノ併立スル原則ニヨリテ、私人生産業限度以下ノ生産ヲ私人ニ開放シテ公私一律ニ課税ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞働爭議ハ別ニ法律ノ定ムル所ニヨリテ勞働省之ヲ裁決ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今ニ於テハ資本制度ノ壓迫ニヨリテ勞働者ハ自由契約ノ名ノ下ニ全然自由ヲ拘束セラレタル賃銀契約ヲナシツツアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生ハ勞働ノミニヨリテ生クル者ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ改造ニヨリテ男子ノ勞働者ノ利得ガ優ニ妻子ノ生活ヲ保證スルニ至ラバ、良妻賢母主義ノ國民思想ニヨリテ婦人勞働者ハ漸次的ニ勞働界ヲ去ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "最モ不便ナル國語ニ苦シム日本ハ其ノ苦痛ヲ迯ルルタメニ先ヅ第二國語トシテ並用スル時、自然淘汰ノ理法ニヨリテ五十年ノ後ニハ國民全部ガ自ラ國際語ヲ第一國語トシテ使用スルニ至ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校トシテハ簡單ナル事務ニシテ、若シ兒童ノ家庭ノ惡感化ニヨリテ食事ヲ肯ンゼザル者アラバ教師ノ權威ヲ以テ其ノ保護者ヲ召喚訓責スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ國民教育ノ説明ニヨリテ大學及ビ大學豫備校ノ方針、又其レガ生徒ノ自費タルコト等ハ推想シ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "有婦ノ男子ニシテ蓄妾又ハ其ノ他ノ婦人ト姦シタル者ハ婦ノ訴ニヨリテ婦人ノ姦通罪ヲ課罰ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此ノ立法ガ男子ノ道念ニヨリテ行ハレザルナラバ忌ムベキ婦人勞働トナリ婦人參政權運動トナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
