        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オ母ッチャハワザワザ三町モアルイドニ、四ドモ五ドモ水ヲクムニユクノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "『トウケウミナブ　ジ　アンシンセヨイマヨコハマニユク』　發局は同じく靜岡だ。",
              "citation": {
                "source": "樹木とその葉",
                "author": "地震日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「電報がきたんだ」　キラリと眼を光らせて、「なんといって」「シャンハイニユクモヨウ。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "初句、旧訓ツトニユク、古鈔本中、ケサ又はアサと訓んだのがある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "信州では嫁聟が実家へ遊びに行くことを、正月だけはセチニユクといっているが、埼玉県まで来ると親戚故旧が、年始に集まって、酒宴を催すのがすべてオセチであった。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――十八日東洋文庫ニきりしたん本ヲ調ベニユク。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月六日　　雪ドケ御大葬寫生ハダメ、夕方雪モヤウ二月十三日、日田端、遠藤二人ヨリ手紙月末東京へ引キアゲルニツイテ一寸塚本サンニユク――十七日、くもり　寫生休田端、入谷ヨリ手紙　入谷といふは小澤碧童のこと。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "――二十七日告別式――二十九日香奠帳二册一號ト二號うさぎやニ屆ケル事、菓子ノコトハツキリコトハリ八月七日大草實、小峰八郎來ル芥川サンノ伯母來訪夜伯母サンニツイテうさぎやニ禮ヲノベニユク――十日墓ヲ見ニユク　芥川の家の墓地の檢分のことである。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
