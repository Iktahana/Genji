        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五忘のタクラミは分らないが、ニセツンボで普請を仕上げるまでには五忘の奴にも分らない秘密が握れるかも知れない。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、なにしろニセツンボになりきるのが何よりの大事で、まア、その心得にはヌカリがない自信はあった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金三さんの話では、今度の大工はニセツンボだてえことでした。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "金三さんはニセツンボに年期を入れていますから、一日二日でニセと分ったそうですよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤオヤ、下男の金三もニセツンボで、コチトラだけが見破られるとは呆れた曲者。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにニセツンボは山本定信の廻し者に見破られている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
