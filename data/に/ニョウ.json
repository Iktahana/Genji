      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "urine",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "健康診断では、尿検査が体の状態を知る上で重要となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "脱水症状の時は、尿の色が濃くなることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は実験のため、動物の尿を採取した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それこそ御自身の高級な宿命に、糞尿を浴びせられたやうな氣がするらしい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、お前のたれた糞尿は、お前が持つて歸つたらいいだらう、といふ意味なのだらうか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十一月三十日『東京朝日新聞』）　　　　　　　　　四十八　　　　　　寒さと尿量　寒い時に三時間運動せずにいると尿酸の排出量が平日の五割増す。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで尿酸の分泌の幾分は体熱の損失に対する反応として起るものだろうという。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今、尿道注射に来た憲兵が云っとった。",
              "citation": {
                "source": "穴",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊の尿の中から、回春の霊薬が析出されるそうであるが、映画で勇ましい軍隊の行進や戦闘の光景を見たり、またオリンピック選手やボクサーの活躍を、見たりしているといじけた年寄り気分がどこかへ吹っ飛んでしまってたとえ一時でも若返った気分になることはたしかである。",
              "citation": {
                "source": "映画と生理",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから少しきたない話ではあるが、昔｜田舎の家には普通に見られた三和土製円筒形の小便壺の内側の壁に尿の塩分が晶出して針状に密生しているのが見られたが、あれを見るときもやはり同様に軽い悪寒と耳の周囲の皮膚のしびれを感ずるのであった。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さかりがつくと彼は所かまわず尿水を飛ばして襖や器具をよごした。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い安西洋紙で張りつめた天井には鼠の尿ででもあるのか、雲形の汚染がところどころにできている。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬにしてもそんなに早く死ぬとは思つてゐなかつたし、案外癒るのだらうとさへ思つてゐた私は、『尿器をとつてくれ』といふ弟の声が、余りにも弱々しい時には腹さへ立てた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ずぶ濡の破褞袍、蓋し小児の尿汁を洗わずして干したるもの、悪臭鼻を抉って髄に徹る。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お君の母親は、お君の記憶する限り、まるで裁縫をするために生れて来たような女で、いつみても、薄暗い奥の部屋にぺたりと坐り切りで縫物をしていたが、お君が十五の時、糖尿病をわずらって死んだ。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "路次の入口で徳田が放尿している音をきゝながら、豹一はごろりと横になった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "×重荷おもくて唄うたふ　山頭火　　味取観音堂に於て松はみな枝垂れて南無観世音　耕畝久しぶりに掃く垣根の花が咲いてゐる　同ねむりふかい村を見おろし尿する　同（「三八九」第壱集　昭和六年二月二日発行）",
              "citation": {
                "source": "寝床〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそ御自身の高級な宿命に、糞尿を浴びせられたやうな気がするらしい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、お前のたれた糞尿は、お前が持つて帰つたらいいだらう、といふ意味なのだらうか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の人間の様に行屎走尿の用は足して居るが、用を足して居るか、居らぬか気が付かぬ位に逆上せて仕舞う。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると行屎走尿すら便じなくなる。",
              "citation": {
                "source": "高浜虚子著『鶏頭』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "虚空を頭とし、大地を五体とし、山や水は糞尿であり、風は呼吸であり、火はその体温であり、一切の生物無生物は彼の生むところと説く、シバ神崇拝に類して精力を愛するこの原始の宗教が、コーランを左手に剣を右手に、そして、ときどき七彩の幻に静慮する回教に、なぜ南方民族の寵をば奪われたのであろうか。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "レントゲンにかけられ、血液も尿もとられた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その光栄の失敗の五年の後、やはり私の一友人おなじ病いで入院していて、そのころのおれは、巧言令色の徳を信じていたので、一時間ほど、かの友人の背中さすって、尿器の世話、将来一点の微光をさえともしてやった。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "入院以來硝子の容器に取ることになつてゐる尿の量も、段々健康な人と相違がなくなつて來た。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが今度は、病気の様子がおかしいので、わたくしと嘉六とは母を叱るようにして嘉六のかゝりつけの医者を呼んで来て見て貰いますと、むかし腎盂炎に罹ったあとが全く癒り切らないで残っていて、それが急に重り出して、やゝ尿毒症さえ併発していると申します。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついに尿毒症の烈しいのが来て、注射で一時は軽くなったものゝ医者はこの家では手当が覚束ないと病院入りを勧告しました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "塀にも屋根の上にも一ぱいに専門の皮膚、泌尿科を麗々しく広告している医学博士。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうせんから柳吉はげてもの料理を食べ過ぎたせいか胃腸が悪くて、二ツ井戸の実費医院へ通い通いしていたが、こんどは尿に血がまじって、小用の時泣声を立てた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "実費医院で診て貰うと、泌尿科の専門医へ行くが良かろうとのことで、島ノ内のＫ病院が有名だときいて、診せると、膀胱がわるいという。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "糖尿病をわずらってお君の十六の時に死んだ。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "路次の入口で放尿した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こいつ等が、咽喉にうにょうにょして停滞しているときは、全く無作法な獣たちですね。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
