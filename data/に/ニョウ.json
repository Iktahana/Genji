[
  {
    "uuid": "ae402a4d-a6f3-5202-9cae-8409ce54954f",
    "entry": "尿",
    "reading": {
      "primary": "にょう",
      "alternatives": [
        "ゆばり",
        "いばり",
        "ゆまり",
        "ばり",
        "しい",
