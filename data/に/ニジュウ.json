    "definitions": [
      {
        "index": 1,
        "gloss": "double",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この窓は二重構造になっているので、防音効果がとても高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カーテンを二重にして光を遮断し、寝室を真っ暗にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "二重になっている袋は、破れにくく、重いものを入れても安心だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ネルヴァルの発狂、二重意識の相剋による錯乱は蓋し、彼が彼の分析方面に執し過ぎたことが原因ではある。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も、上林氏と一緒なので、それが、とくに心強く、それに、――これは記名投票なのだから、公表しても差し支へ無いと思ふが――私の眞劍の一票は、上林氏の寒鮒に、いれて在るのだから、私のよろこびも二重になつてゐたのである。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故というに、キャリフォルニアからオレゴン州への、境近い街道に、山が聳えて、複式二重の成層火山、シャスタとシャスチナと、二人の容姿端麗なる姉妹が、見る角度に依っては、並んで手を繋ぎ合ってもいるし、また背中合せに丈くらべをしているようでもあり、何となく人｜懐かしい山に見えるからである。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の小市街の横町は水平であるが、本通りは急坂で、それが極めて不規則な階段のメロデイーの二重奏を奏してゐる。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦痛を通して内臓機関に浸み込んで行く芳烈な匂いは、彼の眼に青とも桃色ともつかぬ二重の蝶を幻覚させた。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "矛盾の性に見向われたものは、裂かれて二重の空骸となった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は見違えるほど体など肥って来たようだがね」　事実、柚木はもとよりいい体格の青年が、ふーっと膨れるように脂肪がついて、坊ちゃんらしくなり、茶色の瞳の眼の上瞼の腫れ具合や、顎が二重に括れて来たところに艶めいたいろさえつけていた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶店の床几で鼠色羽二重の襦袢の襟をした粗い久留米絣の美少年の姿が、ちらりと動く。",
              "citation": {
                "source": "桃のある風景",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母が心の何方に走れりとも知らで、乳に倦きれば乳房に顔を寄せたるまゝ思ふ事なく寐入し児の、頬は薄絹の紅さしたるやうにて、何事を語らんとや、折々曲ぐる口元の愛らしさ、肥えたる腮の二重なるなど、かかる人さへある身にて、我れは二タ心を持ちて済むべきや。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　盲や聾から考えると普通の人間は二重人格のように思われるかもしれない。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の中で揺られている俘虜の群の紹介から、その汽車が停車場へ着くまでの音楽と画像との二重奏がなかなくうまく出来ている。",
              "citation": {
                "source": "映画雑感６",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "島崎藤村……全詩集中の詩大半薄田泣菫……暮笛集・ゆく春蒲原有明……春鳥集・獨絃哀歌三木露風……廢園・白き手の獵人北原白秋……邪宗門・思ひ出（二重圈點◎を附したのは、特に名詩集たるもの。",
              "citation": {
                "source": "名詩集「思ひ出」の眞價",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は自分の演説からして、野口氏に二重の惡い思ひをさせたことを氣の毒にも心苦しくも考へた。",
              "citation": {
                "source": "中央亭騷動事件（實録）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがまた二重に私を口惜しくさせた。",
              "citation": {
                "source": "中央亭騷動事件（實録）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒飮み共の人生は、二重人格者としての人生である。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが天才でない平凡人でも、かうした二重人格の矛盾と悲劇は常に知つてる。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半次尚も、Ｔ「それから　其の黒羽二重に　朱鞘の長刀　落し差して　居る処……」　と云われて仲蔵、恐る恐る「それがどうか致しましたか？",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のことはない、私の錯覺と壞れかかつた街との二重寫しである。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九竜に向けて二重デッキの白いランチが鴎のようにランプの尾を海水に引いて走りだした。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それについて妾は二重にも、三重にも金策をしなくてはならない破目になっているのよ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すつかり葉をふるひ落した裸のポプラ並木、からからに凍りついた歩道、明りを消し、二重窓を降して冷たい沈默を包んでゐる煉瓦や石造りの暗い家並、毎日毎夜の不安な空氣に脅かされてゐる町は、朝から曇つたままに暮れ落ちた暗澹たる夜空の下に、わけても眞夜中過ぎのその夜は、人通さへ稀に無氣味な程に鎭まり返つてゐた。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねらいはそれて、弾丸は二重になった窓硝子を打ち抜いた。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、さっきから、腹這いになって、二重硝子の窓から、向うの丘の方を見ていたのであった。",
              "citation": {
                "source": "雪のシベリア",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天子さんのお通りになる橋とは二重橋のことだった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "踵を失った大西は、丸くなるほど繃帯を巻きつけた足を腰掛けに投げ出して、二重硝子の窓から丘を下って行くアメリカ兵を見ていた。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二重硝子の窓を通して、空の橇が馭者だけを乗せて、丘の道を一列につゞいて下るのが見えた。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二重硝子の窓の外には、きつきつたる肌ざわりの荒い岩のような、黒竜江の結氷が星空の下に光っていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二重硝子を透して遠くに、対岸の黒河の屋根が重い支那家屋の家なみが、黒く見えた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、来ているぞ」　ワーシカは、二重硝子の窓に眼をよりつけるようにして、外をうかがった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴は黒い僧服をまとって乗り込み、箱のなかにじゅうぶんな金を入れてて、それで竜骨から大檣までまるごと買収できる。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
