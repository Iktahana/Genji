          "literary": [
            {
              "text": "テンポにもアダジオやアンダンテはあってもアレグロがなく、表情にもフォルチシモがなく、そうかと云ってピアニシモもなかった。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "哀れな姫君の寝姿がピアニシモで消えると同時に、グヮーッとスフォルザンドーで朗らかなパリの騒音を暗示する音楽が大波のようにわき上がり、スクリーンにはパリの町の全景が映出される。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「青春彷徨」の結末にしろ「車輪の下」の最後にしろ、ヘッセは、誠意をこめて辿って来た精神と肉体の葛藤の終りを、いつでも音楽で云えば弱めて消されるピアニシモの音調で結んでいる。",
              "citation": {
                "source": "若き精神の成長を描く文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このひとのピアニシモは自分に様々の疑問を与える。",
              "citation": {
                "source": "日記",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの疎開地でサイパンの悲報を聞きて胸つまり、声が出なくなって、如何にしても常に自信のあったピアニシモが出来なくなって一夜泣き明かしたが、これでは自分自身まで敵にやられたと同じと思って、一生懸命に練習して遂にまたピアニシモの声を美しく出すことが出来て、先ず胸をなでおろした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "「庭の千草」のピアニシモがよく唱えた時の嬉しい事、私は嬉しかった。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアニシモ（最弱音）で弦の顫えが高まる。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "――やがてそれに続く異常な終節、あの神秘的なピアニシモ、あの影の深淵。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の南のはずれ近く、ニシモト・カントリー・ストアの前には、すでに人が集まっていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "車を出てニシモト・カントリー・ストアに向かって歩いた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車で来ては、ニシモト・カントリー・ストアの前まで歩いて来るのだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアの西側の壁に、シャベルから先に衝突した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアは、やがてあっけなく崩れ、倒れ、平たくなった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ニシモト・カントリー・ストアは、もうない。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンジャミン・ニシモトがトラックにあがった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "集まった人たちを笑顔で見渡し、ベンジャミン・ニシモトはマイクに向かって喋った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまご覧になったとおり、ハレイワのニシモト・カントリー・ストアは、これで終わりです。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "つらい気持を抑え、勇敢な笑顔をいまニシモトはみんなに向けていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナザー・ニシモト・カントリー・ストア、と命名しました。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモトのかたわらに白人の初老の男が立った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しく出来るショッピング・センターの経営者だと、ニシモトは紹介した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモトの人格を讃え、新しい変化が良きものとなるよう最善をつくすことをみなさんに約束する、と彼は結んだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルドーザーの運転手に拍手を、とニシモトが言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌の題名は『ニシモト・カントリー・ストア』と言います」　マイケルは歌い始めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "消えていくニシモト・カントリー・ストアに対する追憶の悲歌だった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニシモト・カントリー・ストアの残骸を、自らの重量を利用して細かく砕き始めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニシモト・カントリー・ストアが取り壊しになると聞いてから、少しずつ作ってきた歌なんだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちは、ニシモト・カントリー・ストアに別れを告げた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうだい、調子は」「ニシモト・カントリー・ストアが取り壊しになった」「奴ら、次はなにを壊すつもりなんだ」「マイケルが、おなじことを言ってた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
