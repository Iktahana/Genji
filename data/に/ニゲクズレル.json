          "literary": [
            {
              "text": "逃げる逃げる、逃げ崩れる。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとはわっと逃げ崩れる。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四日、十五日も、逃げくずれる敵を追って、梁ヶ｜瀬から田神、田部、引田などという部落部落を、残暑に乾ききっている夏草の野を、血しおで黒くするほど駈け捲くした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃げ足は、逃げ足をさそい、果てしなく逃げくずれる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "草は燃え、兵舎は焼け、逃げくずれる賊兵の軍衣にも、火がついていないのはなかった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜀軍はわざと逃げくずれる。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
