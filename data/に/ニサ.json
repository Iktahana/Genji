    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "酒の黴酒屋男は罰｜被ぶらんが不思議、ヨイヨイ、足で米といで手で流す、ホンニサイバ手で流す。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "オンダモダイタモエンブチハウノモオマエノコジャモノ、キナガニサッシャイ、イカニモショッショ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "全世界人ヘノ警告文　余スナワチ金博士は、今度ヒソカニ感ズルトコロアリテ、永年ニ亘ル秘密ノ一部ヲ告白スルト共ニ、之ニサシサワリアル向ニ対シ警告ヲ発スル次第ナリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次に曰く、三、丈が二尺グライノ花瓶、口ニ拇指ヲ置キテ指ヲ中ニサシ入レテ花瓶ノ内側ヲサグリ、中指ガアタルトコロニ、小サク５０９８ト墨書シアリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムサオオニサ」マワイ」ムサワトソネノタシ」マダノイナイ」ムダマオオソ」マラア」「これは例の文句を逆さに書いたのだよ。",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニサナニサそうではない。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニサン十三夜の朧月は、棕樹、橄欖、無花果の木々を、銀鼠色に燻らせていた。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ナニサこんなことはとうの昔から、俺らや姥には解っていたのさ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサ、大芝居だと云うことさ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うのもここにいる馬鹿亭主が、イエなに、ほんの好人物で、随分働きもありますが、悪いことには神様を、ナニサ神様も結構でがすが、拝んでばかりおりましてな、生活の足しにはなりましねえ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサ、俺らの思うには、ああいう立派な殿様だ、時頼さんの心意気で、諸国漫遊に出られたんだろう」こう云ったのも地廻りらしい男。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサ俺だって知っているよ、その宛てという変なものをな。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニサ寝椅子はころがるものさ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナニサわしは居候だ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（邪魔ニサレルコトダッテ度々デスヨ！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ハ蒙昧ノ　露ハナル領域ニサヘ驕ルスベモナイ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮「ナニサあれは篠原｜子と。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジェリコ、ミケランゼロ、レオナルドダビンチ、ラファエル及チシアン等ノ描ケル耶蘇ノ面貌ハ皆、荘厳ト優美トヲ兼ネタル秀麗ナル男性ノ典型トシテ描キタレドモ、独リ十四世紀ノジョットーニサカノボレバ然ラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その棒の木口に三の字を書いて、わが口の中にて「カエリコンズカエリコントハオモエドモ、サダメナキヨニサダメナケレバ」と三度読み、口の内にて「ヨレヨレ」といえば、棒の端が一所に寄ること奇妙なり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トアタリガキウニサワガシクナツタノデ、オ母サンハ目ヲサマシマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙は大方不良少女同士の文通だが、昨日スケート場で中学の三年生の可愛い子をひつかけたから見せてあげるとか、予科のこども譲つてくれてメニサンクス。",
              "citation": {
                "source": "探偵の巻",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の子譲つてくれてメニサンクスなんてのは、こりや、どうせシャンぢやないな。",
              "citation": {
                "source": "探偵の巻",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつちはメニサンクスだの復讐せんならんを読んできてゐるのだから、大いに可笑しくて仕方がないが、先生達まことに悠々たるものである。",
              "citation": {
                "source": "探偵の巻",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "カノ下等ナル人種ハ、其心既ニ適宜ニ組織シタル事ニサヘモ、相應スルコト能ハズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしはニサの子ムルタの子ムルタだ、お前のためにわたしの心が痛む、カアルよ」　これには何の返事もなかった。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が吹き止めた時、うつろの樫から声がした――「わたしのために死の歌を吹いてくれ、ニサの子ムルタの子ムルタよ」　ムルタは微笑してもういちど愛の歌を吹いた。",
              "citation": {
                "source": "精",
                "author": "CATHAL OF THE WOOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとアニサカンの向うの方からその紳士がパナンショーの方へ向けて出かけて来るです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノウサギハアル人ガ「オヂヤウチヤンニサシ上ゲマス」トイツテ、モツテキテクレタウサギデス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
