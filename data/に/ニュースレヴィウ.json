          "literary": [
            {
              "text": "「笑の王国ニュースレヴィウ」。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ後、「笑の王国ニュースレヴィウ」の立稽古をやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「笑の王国ニュースレヴィウ」は、トン／＼行かぬ、自分演の個所もムザン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部、「ニュースレヴィウ」は、まだいゝ、「旗本」大くさり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出る、「ニュースレヴィウ」は、まあ／＼狙いどこを外さず。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "重役連と話し、八月マチネーは、大辻司郎を加へた、ニュースレヴィウをやらうといふことにし、大辻を呼ぶ、二十四日帰朝の彼、やって来り快諾。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
