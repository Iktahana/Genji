    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "從テ其レガ左傾スルニセヨ右傾スルニセヨ前世紀的頭腦ヨリスル是非善惡ニ對シテ應答ヲ免除サレンコトヲ期ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私有財産ヲ尊重セザル社會主義ハ、如何ナル議論ヲ長論大著ニ構成スルニセヨ、要スルニ原始的共産時代ノ回顧ノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ賠償ヲ別途ニ命ジテ同居ヲ父ニ強ヒザル所以ハ、遺棄シタル事情ガ背徳ニセヨ又ハ積極的活動ノ爲ニセヨ干渉スベカラザル別事ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ此ノ改造後ノ國民ニシテ如何ナル思想ニ導カルルニセヨ、國民ノ財産權ヲ犯ス者ハ、人類社會ノ存スル限リ存スベキ法律ノ原則ニヨリテ、強窃盜トシテ罰セラレ又ハ乞食トシテ待遇セラルルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "末節枝葉ニ於テ如何ナル非難アルニセヨ、朝鮮ハ露西亞ノ玄關ニ老婆ノ如ク窮死スベカリシ者ヲ、日本ノ懷ニ抱カレテ少女ノ如ク生長シツツアルハ之ヲ無視スル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ義務ニセヨ、父母妻子ノ負擔アル男子ヨリ其ノ勞働ヲ奪ヒテ何等ノ賠償ヲナサザルコトハ國家ノ權利ヲ濫用スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "假令平家全滅ノ前ノ隆盛ノ如キニセヨ、英國ガ今次ノ大戰ニ於テ本國ヲ脅威セシ獨逸ト、印度ヲ脅威セシ露國トニ恐怖ナキニ至レルコトハ、支那ニ於テ二國ガ亦同樣ナル脅威ヲ滿蒙ト青島ヨリ加ヘタル恐怖ヲ除去シタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "田口七郎兵衛は教壇に上って、　――静カニセヨ――　と白墨で黒板に書いた。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "長良川博士ノ意見ヲ聞イテカラニセヨ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
