        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "犀星の評によれば、僕もまた彼と同じく、馬込村に於ける劍客の一人であるさうだが、僕がもし武士としても、月代をのばした浪人組の部類であつて、彼の藩士の眼から見れば、一個の浮浪人にすぎないだらう。",
              "citation": {
                "source": "室生犀星に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵目ぼしい、小作人組合の主だった、（ならず者ども）は、残らず町の刑務所へ抛り込まれてしまった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、当局が小作人組合に眼を光らさぬ筈がない。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "本田家の邸内を護衛していた、小作人組合に入っていない、青年団の青年たちや、消防組員までも、一応は取調べを受けた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは、きつと、鎌倉時代によそから流れて来た不良青年の二人組が、何を隠さうそれがしは九郎判官、してまたこれなる髯男は武蔵坊弁慶、一夜の宿をたのむぞ、なんて言つて、田舎娘をたぶらかして歩いたのに違ひない。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（少し大きな字）　有馬喜平次を先頭に紫羽織十五人組が抜刀でじりじり迫る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼む」　　　　　　　　　　　　　　　　　　（Ｆ・Ｏ）７４＝（Ｆ・Ｉ）街道　右門暗殺十人組が道を急ぐ。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）８０＝（Ｆ・Ｉ）峠の頂上　五人組が腰打ち掛けて待って居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "８３＝そのまた下の道を　暗殺十人組が来る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼む」（Ｆ・Ｏ）74＝（Ｆ・Ｉ）街道　右門暗殺十人組が道を急ぐ。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）80＝（Ｆ・Ｉ）峠の頂上　五人組が腰打ち掛けて待って居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "83＝そのまた下の道を　暗殺十人組が来る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の決闘場へ近づいて来た三人組があった。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かわりに簡単なゼンマイ仕掛けのメカニズムで、これと同じような動作をする三人組のロボットを造ろうと思えばいつでも造れそうな気がした。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……學者の術語ばなれがして、商賣によつて賢しである、と思つたばかりは二人組かけ合の呼聲も、實は玄米パンと、ちんどん屋、また一所になつた……どぢやう、どぢやう、どぢやう――に紛れたのであつた。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間もプログラムのチェックを進めていたテキサスの二人組は、すぐに最初のものにあったいくつかのバグを訂正した新しいバージョンを、プログラムの各部の働きに関する解説を付けて送ってきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ＤＤＪ』の創刊号には、これまで『ＰＣＣ』に掲載してきたタイニーベーシックの自作に関する記事が再録され、テキサスの二人組による拡張版の、バグ修正済みソースコードリストが載せられた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホビイストへの公開状」を書いて開発者の権利保護を訴えたビル・ゲイツを当てこすり、二人組は「どこかのソフト屋さんとは違って、我々は皆さんがタイニーベーシック拡張版をいじくり回してもっと小さくしてくれることを大いに歓迎いたします」と書き添えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人組のもとには彼らの仕事への賛辞とともにテープの発送を求める依頼が殺到し、『ＰＣＣ』にも読者からの手紙や購読申し込みが続々と送られてきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらの犯人は、電子メールとＦＡＸの二人組だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七〇年代の初頭、オレは高田馬場の空の下で、九人組の不良グループの一員としてガンを飛ばしまくっていた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "かぎろいの春の光、見るから暖かき田圃のおちこち、二人三人組をなして耕すもの幾組、麦冊をきるもの菜種に肥を注ぐもの、田園ようやく多事の時である。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの四人組の一人のおとつっあん、あの人のやうに肉がこけて乾からびていくのと、それはまだいいが、ほんとに文字どほり腐つて行く奴とです。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "部落にはどこにも五人組みたいなものが自然に出來てゐるから、その組の一人に渡して來さへすればみんなに行き渡るわけだが、それでは主旨が徹底しないおそれがあるから、一軒一軒配つて説明して歩いた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの四人組の一人のおとっつぁん、あの人のように肉がこけて乾からびて行くのと、それはまだいいが、ほんとに文字どおり腐って行く奴とです。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三人組は階段を上った。",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と同居人は言いだして、「エナメル革の靴とつま先の尖った靴の二人組は同じ馬車に乗っていて、仲良く家に続く道を一緒に歩いていったのだ――おそらく腕を組んで。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張町の角に、ライオンというカフエが出来、七人組の美人を給仕女に傭って、慶応ボオイの金持の子息や華族の若様などを相手にしていたのもそう遠いことではなかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が暗い道を辿って来たのは、父が違うからだということも想像されないことではなかったが、それにしても彼女は十六か七で、最初のライオンの七人組の美人女給の一人として、生活のスタアトを切って以来、ずっと一本立ちで腕を磨いて来ただけに、金持の親類へ寄って行く必要もなかったし、拘束されることも嫌いであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
