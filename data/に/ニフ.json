    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ナストウリ、モノサシトハサミ、カガミガアリマス、イケニフネ……」大急ぎでそれだけ読んだが、そこで息が切れた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラブ員は海賊のユニフオオムを一着すること。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラブ員は海賊のユニフォオムを一着すること。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカ選手達の予備練習の馬群が浪の泡立つ様にさっと寄ってはさっと引返す間に、緑の縞や薄桃色のユニフォームが、ちらちらする。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和十年十月十五日）　　　　　　　＊　聯合艦隊が芝浦に集合して、昼は多勢の水兵が帝都の街頭に時ならぬユニフォームの花を咲かせ、夜は品川湾の空に光芒の剣の舞を舞わせた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "清長型、国貞型、ガルボ型、ディートリヒ型、入江型、夏川型等いろいろさまざまな日本婦人に可能な容貌の類型の標本を見学するには、こうした一様なユニフォームを着けた、そうしてまだ粉飾や媚態によって自然を隠蔽しない生地の相貌の収集され展観されている場所にしくものはないようである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中での住所を示すのが、ＵＲＬ（ユニフォーム・リソース・ロケーター）だ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パーソナルコンピューターではこれまで、八インチの標準フロッピーディスクと五インチのミニフロッピーディスクが広く使われてきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "代表的なパソコン通信の運営会社であるニフティーサーブには、エキスパンドブックに関する意見交換の場として、ボイジャーのサロンが設けられています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来上がったブックはさっそく、「建築デザイン」、「在宅ワーキング」、「アプリケーション日本語環境」など、ニフティーで出入りしていたフォーラムに登録しました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月には、ニフティーにボイジャーのサロンができました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブックが出来上がるとたいていの作り手たちは、読んでくれそうな人にコピーして配り、続いてニフティーサーブなどのネットワークに登録することを考えます。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "木津田さん自身、はじめてのブックである『エキスパンド・ブックでつくる本』は、よく出入りしていたニフティーのいくつかのフォーラムに登録しました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどこうしたやり方でも、ニフティーの枠を超えてブックを集め、広めていくことはできません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニフティーでは原則的に商業行為が禁止されており、電子本を自由に売れない点も問題です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニフティーなどの通信システムは、文字だけの取り扱いが前提です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "プログラマーとして働いている辰野雄一さんとは、以前ニフティーの在宅ワーキングフォーラムに顔を出す人たちの集まりで会いました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで名刺には、ニフティーサーブのユーザーＩＤを書いてきましたが、電子メールの住所も、藤井さんの会社に間借りした新しいものに変更です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＵＲＬ（ユニフォーム・リソース・ロケーター）は、その番地です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニフティーサーブのボイジャーサロン（go smss1）に集う皆さん。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
