        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "将軍、独裁官田中ハ、諸君ヲ山東ニマデヨコサシメタル田中ハ諸君ノ階級ノ最悪ノ敵デアルコトヲ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ中世貴族ノ所有地ヲ現今ニ至ルモ解決スル能ハズシテ終ニ獨立問題ニマデ破裂セシメタル愛蘭ノ土地問題ト、此ノ私有地限度制トハ其思想ニ於テモ進歩ノ程度ニ於テモ雲泥ノ差アルヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "手ノ痺レハ肘カラ肩ノ辺ニマデ及ビ、コノマヽ半身不随ニナリハシナイカト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ニ予ハアンナニマデ怒ッタノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "信長公ノ御時ニサヘ、従ハザル諸所ヲ、カク僅カバカリノ間ニ、根来寺、雑賀、熊野山中、高野領ニマデ亘リテ、悉ク打チナビケ給フ、果断、決断ノ程、ヨク勘弁シテ見ルベシ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "その戦場に在る日は、つぶ漆のあらあらとした鎧に、虎御前の太刀を横たえ、　コノ若殿、魁ニ御在セバ、軍中、何トナク重キヲナシ、卒伍ノ端々ニマデ心ヲ強メケル――　とは家中のみでなく一般の定評だった。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
