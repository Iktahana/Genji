    "definitions": [
      {
        "index": 1,
        "gloss": "pregnancy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友人が妊娠を報告してくれて、みんなで喜んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は妊娠中の体調管理に気を使っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「え、妊娠したの！？おめでとう！」と私は驚きと喜びの声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「あんた、妾妊娠したかも知れないわ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お前は、腹のまわりに袋に入れたあの粉をまきつけて、――おや、妊娠三カ月にも見えやしなくって？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妊娠の婦人は、その腹よりも、もっとふくらんだ二ツ折の柳行李を、支那人のボーイに、一箇は肩にかつがし、一箇は片手に提げさして、肩で息を切らし乍らやって来た。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妊娠三カ月になる肩で息をしている女房や、ハッパをかけるとき、ほかの者よりも二分間もさきに逃げ出さないと逃げきれない脚の悪い老人が、皆と一緒に働いていた。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」まだその時は妊娠中だった妻は、けだるそうにして、子供たちをうるさがった。",
              "citation": {
                "source": "砂糖泥棒",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから一週間ばかり経って、奥様が流産をなすった……妊娠三箇月で……成る程。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「綾子｜様、このごろの習慣で、寡婦の妊娠のは大変な不名誉です。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり旅の女が盗賊に殺されるといふやうな出来事はこの時代に左のみ珍しくもなかつたが、それを発見した人々の注意をひいたのは、その女が妊娠中に殺害されて、その腹から赤児をうみ落したといふことであつた。",
              "citation": {
                "source": "小夜の中山夜啼石",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "『むかし日坂に妊娠の女ありて、金谷の宿の夫に通ふ。",
              "citation": {
                "source": "小夜の中山夜啼石",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "民家の妻が妊娠中に死亡したので、その亡骸を村内の古廟のうしろに葬った。",
              "citation": {
                "source": "餅を買う女",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所で聞きあわせて、塚のぬしの夫へ知らせてやると、夫をはじめ一家の者が駈けつけて、試みに塚を掘返すと、女の顔色は生けるがごとくで、妊娠中の胎児が死後に生み出されたものと判った。",
              "citation": {
                "source": "餅を買う女",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は妊娠しているのです。",
              "citation": {
                "source": "天衣無縫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "掛けては置くものだと、それをもって世間狭い大阪をあとに、ともあれ東京へ行く、その途中、熱海で瞳は妊娠していると打ち明けた。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今さっき、お前妊娠しているのと違うか――ちゅうておききどした」「叔母さんが……」　お雪はうなずいた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお雪はかんたんに妊娠したのだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その年の夏、持子は頑としてアッパッパを着たがらぬので、不審に思ってよくよく観察してみると、妊娠していると判った。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの娘は妊娠するだろうか、しないだろうかと終日思い悩み、金助が訪ねて来やしないだろうかと恐れた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "妊娠しているときかされ、はっとした。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀子はまだ赤ん坊の顔も見ず、母の妊娠していたことすら知らずにいたのだったが、なるほどそう言えば正月に受け取った時ちゃんの年始状の端に、また妹が一人｜殖えました、どうして家には男の子が出来ないんでしょうなどと書いてあったが、余所事のような気持で、嬉しくも悲しくもなかった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時民子は妊娠九カ月であり、戦死と聞くと瞬間激しい衝動にうたれてにわかに逆上し、心神を喪失して脳病院に担ぎこまれ、そこで流産したきり、三年たらずもの歳月を送り、やっと正常に還った時には、内輪であった彼女の性格も一変していた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "オフィリヤは、妊娠したというのです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに三年ばかり経って米が妊娠した。",
              "citation": {
                "source": "妖蛸",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "網元の主人は非常に喜んで、出産の日を待っていたが、米の妊娠は真箇の妊娠でなくて、病名も判らない奇病であった。",
              "citation": {
                "source": "妖蛸",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その喜兵衛は本妻を娶らずに二人の壮い妾を置いていたが、その妾の一人のお花と云うのが妊娠した。",
              "citation": {
                "source": "四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに妻が妊娠して、翌年になって男の子を分娩したが、ひどい難産のうえに産褥熱で母体が危険になった。",
              "citation": {
                "source": "前妻の怪異",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日がたち、妊娠していると両親にも判った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そういえばタイガーの入口の電飾はにんしんした支那女の入墨のあるお腹みたいだぜ。",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう浮いた話は聞かれない人はにんしんした女房の眠るのを叱ら無い夫のやうに忠實に働く許りだ。",
              "citation": {
                "source": "自分は見た",
                "author": "千家元麿",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お父つぁんなんぞ用か」　出て来た初枝は姙娠していると、一眼で判るからだつきだった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありていに言うと、一番末の娘（といってももう三十歳だが）の持子が、姙娠したのだ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
