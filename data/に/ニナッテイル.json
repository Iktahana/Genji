        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "団子ノ治兵衛ハ如何ニモ一生懸命デ、全力ヲ盡シテイルコトハ認メラレルガ、餘リ一生懸命過ギ、緊張シ過ギテコチ／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ予ノタメニ腸ダケヲ残シテオクノガ習慣ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然彼女ノ専用ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若夫婦ノ居間ハ可ナリ豪華ニ飾ッテアルラシイガ、階段ノ中途ガ螺旋ニナッテイルノデ、足モトノ悪イ予ハタマニシカ上ッタコトガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「這入リタインデショウ」「別ニ用モナインダケレドネ」「ソレ／＼、興奮スルト滑ッテ転ブワヨ、落チ着イテ、落チ着イテ」今ハ下司板ガ上ゲテアッテ、タイル張リノ床ガシャワーノ水デビショ／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "割下水ノ家ニ住ンデイタ時分、六ツカ七ツノ頃ダッタヾロウ、乳母ニ抱カレテ寝床ニ横ニナッテイルト、蟋蟀ガヨク縁側ノ外デ鳴イテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝アタリハ空気ガ乾燥シ、老人ノ喉ガカラ／＼ニ干｜涸ビ、風邪ヒキ加減ニナッテイルセイデ、呼吸ガ喉ヲ入ッタリ出タリスル度毎ニピイピイト云ウ音ヲ発スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、颯子ト四ツシカ違ワナイノニ、モウイヽ加減中年婆サンニナッテイル陸子ガ、アトヲ引キ受ケテ続ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルデ氷ノ中ヘ漬ケタヨウニ無感覚ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "額モ頸ノ周リモ気味悪クベト／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四五日剃ッテイナイノデ顔ジュウ髯ダラケニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ノコトハ何モ云ウナト云ッテアルノデ、颯子ハ知ラナイ筈ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハキシロカインノ場合ニ限ラズ、何ノ注射デモ、タトエバヴィタミンノ注射ノ場合デモ、薬液ヲ血管ノ中ヘ注入シナイヨウニ、一応注射ニ先立ッテ注射針ヲ外ヘ引イテ見、血液ガ混入シタカドウカヲ念ノタメニ慥メテ見ルノガ常識ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ終日ホテルデ休養スルコトニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハモトモト病気ニ対シテ大胆ナ方デハナク、スコブル臆病ナノデアルガ、今度ノ※ニ関シテハ、五十六歳ノ今日ニ至ッテ始メテ生キ甲斐ヲ見出シタ心地デ、或ル点デハ彼女以上ニ積極的、猪突的ニナッテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ、ソレゾレ違ッタ思ワクガアルラシイガ、妻ガデキルダケ堕落スルヨウニ意図シ、ソレニ向ッテ一生懸命ニナッテイル点デハ四人トモ一致シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ト漢中王トハ、養父子ノ間ニナッテイルガ、元々、君ハ羅侯子ノ子デアル。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "劉氏ノ統ハ既ニ漢中王ノ実子ガ継グコトニナッテイル。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
