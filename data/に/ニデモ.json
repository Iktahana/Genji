          "literary": [
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月十一日（月曜）〔受信〕電報モリナガシニメンカイシタシキヨウアスニデモ〔欄外に〕　面会　森長氏に電話かける。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタノ洋服、青ニデモオソメニナツテハイカガデセウ。",
