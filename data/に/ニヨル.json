  {
    "uuid": "2144d9ee-ba5f-5ddc-a3f9-70b821eba294",
    "entry": "ニヨル",
    "reading": {
      "primary": "による",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "階級鬪爭ニヨル社會進化ハ敢テ之ヲ否マズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米人ノ「デモクラシー」トハ社會ハ個人ノ自由意志ニヨル自由契約ニ成ルト云ヒシ當時ノ幼稚極マル時代思想ニヨリテ、各歐洲本國ヨリ離脱シタル個々人が村落的結合ヲナシテ國ヲ建テタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "審議院議員ハ各種ノ勳功者間ノ互選及勅選ニヨル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "無償ヲ以テ徴集スル所以ハ、現時大資本家大地主等ノ富ハ其實社會共同ノ進歩ト共同ノ生産ニヨル富が惡制度ノ爲メ彼等少數者ニ停滯シ蓄積セラレタル者ニ係ハルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外國ノ侵略又ハ其他ノ暴力ヨリ安全ニ其土地ヲ私有シ得ル所以ハ凡テ國家ノ保護ニヨル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "維新革命ハ所有權ノ思想ガ強力ニヨル占有ニ非ズシテ勞働ニ基ク所有ニ一變スルト共ニ、強者ガ其強力ヲ失ヒテ其所有權ヲ喪失シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ニ發達スルモ公共的生産ガ國民生活ノ全部ヲ蔽フ能ハズシテ、現實的將來ハ依然トシテ小資本ニヨル私人經濟ガ大部分ヲ占ムル者ナリト云フモ其三。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "賠償ノ限度及私有財産トノ關係等凡テ私有財産限度ノ規定ニヨル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "積極的ニ見ルトキ大資本ノ國家的統一ニヨル國家經營ハ米國ノ「ツラスト」獨逸ノ「カルテル」ヲ更ニ合理的ニシテ國家ガ其ノ主體タル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家生産又ハ私人生産ニヨル一切ノ農業的工業的貨物ヲ案配シ、國内物價ノ調節ヲナシ、海外貿易ニ於ケル積極的活動ヲナス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲ領有スル結果ヨリ見テ、恰モ百萬圓ヲ貯蓄シタル結果ヨリ見テ、其レガ高利貸ニヨルト忠實ナル勞働ニヨルトヲ考査セズシテ等シク守錢奴ト詈リ侵略者ト誣ユルハ昏迷者ノ狂言ナリ、重大ナル罪惡ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ雇備契約ニヨル兵士ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラバ多大ナル俸給ニヨル傭兵ヲ以テ戰ヒシ英米ヲ見ヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニヨルト、我国ニハ「シロウトハクロウトヲ支配ス」トイウ法則ガアルノデハナイカト思ウガマダ調ベテモミナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハ予テ世間ニ於テ人間ノ美ト醜トニヨル差別待遇ノ甚ダシイノニ大ナル軽蔑ヲ抱イテイタ」とヒルミ夫人はその論文に記している。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ気温異常上昇ハ既ニ地方気象統計ニヨル記録ヲ破壊シ、イマヤ驚異的新記録ヲ示シ、シカモ刻々｜自ラソノ記録ヲ破リツツアリ」　牧山大佐は意味あり気に帆村の肩をドンと叩いた。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（今戸一二六佐野昌一氏書信ニヨル）觀測者ノ位置、淺草區今戸一二六番地自宅前、長昌寺境内（小高イ林ノ中）。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "發見後十五分位ノ後ニハ遙ニ南々西ノ方向（附圖ニヨルト、吾妻橋西詰ノ方ラシイ）ニ前ヨリモ高ク上空迄暗雲中ニ象鼻状（見取圖略）ノ白氣ガ搖レナガラ立昇ルヲ見タ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は柏亭、滿谷、徳永外二人とギニヨル座の芝居を観に行つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ取得額ニヨル謝金ハ其ノ取得アリタル時直ニ之ヲ受ク（九）「顧問料」ハ依頼者トノ契約ニ任ズ（十）　依頼者ガ手数料、旅費、日当又ハ事件処理ニ必要ナル費用ヲ支払ワザル時ハ事件ニ着手セズ又ハ其ノ処理ヲ中止スルコトヲ得　　　――○――　　規定以上の通りです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "朔日黒崎平町乗船、赤間間ニ至ル、西の端町入江和作ヲ尋、但小田村ノ示ニヨル。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ニハ、諸君ノ努力と愛情ニヨルホカ、コノ世ノ幸福ニ恵マレ得ヌ家族ガアルコトニ想ヒ到ラレヨ。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "グラン・ギニヨル（物凄い芝居）の声色を使つて、女どもを喜ばせてゐる一癖ありさうな若者などもゐました。",
              "citation": {
                "source": "カルナツクの夏の夕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "訊問一、鞭打チニヨル（訊問予備）　「ナゼオ前ハ逮捕サレタカ」と質問スル。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、民衆は槍の先きに突き刺さつた頭のまはりでカルマニヨル（共和黨の歌舞）を踊つてゐる時にでも、實に頑是ない好い兒である。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィチ・クロポトキン　Pyotr Alkseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、民衆は槍の先きに突き刺さった頭のまわりでカルマニヨル（共和党の歌舞）を踊っている時にでも、実に頑是ないいい児である。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィッチ・クロポトキン　Pyotr Alekseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍例ニヨルニ尤有ベシ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、日記帳ヲ入レテアル抽出ノ鍵ハイツモ某所ニ隠シテアルノダガ、ソシテ時々ソノ隠シ場所ヲ変エテイルノダガ、詮索好キノ彼女ハ事ニヨルト過去ノアラユル隠シ場所ヲ知ッテシマッテイルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
