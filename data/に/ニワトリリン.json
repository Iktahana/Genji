        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こうなると、鶏林（朝鮮の異称）の風雲おだやかならずと云うので、東京大阪の新聞社からも記者を派遣することになりましたが、まだ其の時は従軍記者というわけではなく、各社から思い思いに通信員を送り出したというに過ぎないので、直接には軍隊とは何の関係もありませんでした。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "居士曰く、過去世に群鶏林中に住み、狸に侵し食われて雌鶏一つ残る。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから京城の鶏林朝報社長、林逞策。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに先生を説伏せて組合の巡邏船、鶏林丸に食糧と油を積んで、その夜の中にズラカッてしまう。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラジオストック、朝鮮人街、鶏林理髪店の土間。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "張首明――鶏林理髪店主。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏林理髪店付近の場末の民家屋根裏、朝鮮字新聞「大東共報」社。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちが敢然と起ったのを見て、鶏林八道から露領、満洲にかけての同志が安閑としていると思うか。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
