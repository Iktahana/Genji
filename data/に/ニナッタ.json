        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "満鉄ヤ撫順ノタメニ諸君ノ暮シガチットデモラクニナッタカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "又句読点もないのですが、わかり易い為普通の文にして読みます）問　ソウスルト被告ガ道子ヲ殺ス気ニナッタノハ、道子ガ他ノ男ニ心ヲ移スヨウニナッタカラカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、自分の原子ガ別ノモノニナッタトキ、自覚シナイカラツマラナイ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――久子、身モ心モ元気ニナッタ。",
              "citation": {
                "source": "山吹の花",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「男谷ノ親父ガ死ンダカラ、ガッカリトシテ、何モイヤニナッタ」　親父が死んだそうな。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだ親父もこいつのためにはどのくらい苦労をしたか、死んで、悴の方ではガッカリシタの一句で片づけているが、相当に無常を感じたことは、何モイヤニナッタの自暴半分の言葉つきでもわかる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ニナッテ葉ヲ落スノハ、無益ナ消耗ヲ避ケテ樹液ヲ貯エ、春ニナッタラ大イニ伸ビテヤロウトイウ樹木ノ高イ意欲ノアラワレナノダ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗イ土手ノ上カラ暗イ大川ノ水ヲ　ジット見テミンナデ　ジット　立ッテイタミンナ　何ントモ　口ヲキカン僕ワ　涙ガ出ソーニナッタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イッタイ予ニハ Pederasty ノ趣味ハナイノダガ、最近不思議ニ歌舞伎俳優ノ若イ女形ニ性的魅力ヲ感ズルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真砂座時代紅葉山人ノ「夏小袖」ノオ嬢サンニナッタ時、予ハ特ニ彼女、デハナイ彼ニ魅惑サレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ何カ不能ニナッタ老人ノ性生活―――不能ニナッテモ或ル種ノ性生活ハアルノダ―――ト関係ガアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽマデ来タンダカラチョット伊勢丹ヘ寄ロウ」ト、婆サンノ反対ヲ豫期シテ云ウト、「又冷房デモイヽンデスカ、コノ暑イノニ早クオ帰リニナッタラドウ」ト果シテ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "負ケズ嫌イナノデ、家ヘ来テカラ勉強シテフランス語ヤ英語モ片言グライハシャベレルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マアオ爺チャン、可哀ソウニ」「ソンナ恰好ヲシテ何分グライ続ケルンデス」「幾日グライヤレバイヽノ」「オ止メニナッタ方ガヨクハナイ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サン曰ク、田園調布ノ鈴木サンニ鍼ヲシテオ貰イニナッタラドウ、鍼デ直ルカモ知レナイカラ頼ンデ見タラト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス映室ノ「悪魔ノヨウナ女」ノ中ノ女教師ニナッタシモーン・シニョレノ顔、近頃評判ノ炎加世子ノ顔等モソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪ノ市役所ニ勤メテ、疾ウニ故人ニナッタガ、コノ男ノ父ハ古イ弁護士カ代言人デ、明治初年ニ高橋オ伝ノ弁護ヲ勤メタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚シタテハソレホドデモナカッタノダガ、コノ三四年目立ッテソンナ風ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今デモ本心ハ善良ナノデアロウガ、イツノマニカ偽悪趣味ヲ覚エ、ソレヲ自慢ニスルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ心理状態ニナッタノハ最近デアルガ、ソレガマス／＼極端ニナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前サンガ颯子ニ甘スギルノガイケナインダヨ、スッカリ舐メラレテルンダカラ」トウ／＼浄吉ニ呼ビツケラレテ颯子ガ婆サンニ弁明スル段ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ、オ爺チャンヲ是非一ペンボクシングニ引ッ張ッテ行クワ」「ボクサーニハ美男ハ少イダロウナ」「鼻ガ潰レテル人ガ多イワ」「レスリングトドッチガイヽカナ」「レスリングハ多分ニショウ的デ、ムヤミニ血ダラケニナッタリスルケレド、真剣味ガ乏シイワ」「ボクシングダッテ血ガ出ルンダロウ」「エヽ、ソリャ出ルワヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ一台ハ予ノベッド、他ノ一台ニハ佐々木看護婦ガ寝ルコトニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハソレ以前カラモ時々自分ダケ茶ノ間デ寝テイタガ、ベッドニシテカラハ完全ニ別レ／＼ニ寝ルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
