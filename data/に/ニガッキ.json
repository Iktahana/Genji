        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二学期からは、学校へは、ほとんど出なかった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期から、休学しようと思っている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "尋常四年の二学期のはじめ頃だったと思います。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからは第二学期で秋です。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その年の九月、第二学期はじめに補欠を採る中学校のあるのを聞いて、その少年は編入試験を受けたのでしたが、今度は立派に合格しました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夏の休暇が済み、二学期の始業式に大阪の市内にある中学校へ行くと、兄弟二人とも村瀬の姓が突然中那尾に変つてゐた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから間もなく、二学期の試験がはじまった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期が来て、高等学校の生徒がそろそろ鎰屋へ顔を見せる頃になっても、豹一の姿だけが現れないとさすがに分ると、お駒はぽかんとしてしまった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――二学期はわりに良く出来たんですが、一学期の点が悪いんです。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期の成績が良かったという豹一の言葉がおかしかったのである。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると三人とも二学期を平均して落第点になった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど二学期の試験のすぐ前であったが、忙しい中から同郷の友達等が入り代り見舞に来てくれ、みんな足しない身銭を切って菓子だの果物だのと持って来ては、医員に叱られるような大きな声で愉快な話をして慰めてくれた。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "レイクサイドスクールの最終学年に達していたゲイツは、二学期を休学する許可を得てアレンの誘いに乗った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "高校三年生の二学期に行われた旺文社の模擬試験では全国で六位、東大合格率が七五パーセント以上と出た。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘇枋咲くと、樗そよぐと、霜置くとあはれ、一学期二学期よとあはれ、日の照ると、雨ふると、風ふくと、寝ると起きると、制帽かむる。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期の編成替えで慶一が入った一〇二号もおなじで、要するに、これは寮中どこでも通用する、グローバルなルールだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期までは、この寮で漫画雑誌を見かけることはなかったが、最近はあちこちの部屋に、「サンデー」や「マガジン」が転がっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期の一〇二とは、ほとんど正反対の部屋といえる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その五年の二学期に私が内地から龍山の小学校へ転校して行ったのだ。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、あしたから二学期がはじまるという日になりました。",
              "citation": {
                "source": "草",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二学期が、はじまってから、もうよっぽどになるでしょう。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、たしか雄吉らが、高等学校の三年の二学期のことだったろう。",
              "citation": {
                "source": "青木の出京",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チエツ、日記なんて誰がつけるもんか、馬鹿々々しい、あんなものは二学期が始まる二三日前に、誰かの処へ行つて天気のことだけ訊いて来て、あとは皆な出たら目を書けば好いんだよ。",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二学期が始まる四五日前に彼は、忠実な学生を訪れて、厭がるのも関はずその日録を奪つて五十日間の「天気」を写しとつたのである。",
              "citation": {
                "source": "貧しき日録",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕には昔から一度もつかまへることが出来なかつた「シヤアシヤア蝉」とヒグラシが正ちやんのお蔭で標本箱に収まり、もう二学期の学校が始まるねと云ふと、彼はこの夏で学校は止めて神田の或る蓄音機の箱をつくる工場に奉公へ行くことになつてゐるのだと云つた。",
              "citation": {
                "source": "魚籃坂にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "残る二学期の終には、いよいよ四年生一同で卒業の論文を作った。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "麹町の学校でも第二学期を終りかけていた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二学期か三学期かの初めに、原書の辞書を渡されてからは、先生の言う通りに分っても分らんでもその原書の辞書ばかりを引いていた。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤吉は二学期から、祖父のすゝめで寄宿舎に入つた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期が始まってから間もなく、たみちゃんは例の通り風邪の気味で学校を休んだ。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
