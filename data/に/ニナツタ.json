          "literary": [
            {
              "text": "「イロイロオセワニナツタコトヲシンシヤス」と書いた。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕ノ親愛ナル新吉ヨ、僕ハイヨイヨ希ヒガカナツテ勇マシイ水雷艇ノ乗組員ニナツタ、ダガ僕ハ御国ノ士官ニナリ損ツタコトガザンネンダ。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マア、ナンテカワイイアヒルチヤンニナツタコト。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ヒゲナシ山羊サン　ヲ見テミンナ　オコルヤラ、泣クヤラ大ヘン　ナ　サワギニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八トテモ　ソノカクカウ　ガワルイノデミンナ　大ワラヒシテネオヒゲ　ガ　生エルマデホツトク　コト　ニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、ナゼ人参サンノ顔ハ赤イカ、ジヤガイモサンハコブダラケカ、オ分リニナツタデセウ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヨウトフウフニナルコトニナツタ」オヨウトノレイノヤクソクハトリケサレタシ」カラシシノ十ロウ」　般若の五郎がこれを読んで、「おれよりも、倅の奴の方が上手だ」　と、笑った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
