        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また「音にほだされし縁の糸」のところも同様に「ネニホ。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーネニホ、ホバシラニハータ、コヒガヰマス、ヒゴヒモヰマス……」　雨がザアーツと降り出して来た。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニホンでいちばんにぎやかな良い橋はニホンバシにちがいない、という彼等のおだやかな判断に他ならぬ。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔沃度ノニホヒフルヒ来ス〕沃度ノニホヒフルヒ来ス、　　　青貝山ノフモト谷、荒レシ河原ニヒトモトノ、　　　辛夷ハナ咲キ立チニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しはなれた食卓にただ一人すわっている日本人らしい若い紳士にハース氏が「アナタハニホンノカタデスカ」と話しかけると Ja ! といってうなずいて見せた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹明君のニホヒは残つてゐたが、姿は見えなかつた（日暦が今日になつてゐたから来庵はタシカだ）。",
              "citation": {
                "source": "行乞記",
                "author": "室積行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "――また散歩（これは私）ケツコウ／＼　ハルダモノ午後四時　樹来アゲ二切タベタ庵のニホヒガシタ　四月廿八日　曇。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタネノ　ツボミタチハ　カンバシイ　ニホヒノ　ナカデ　ダンダン　フクランデ　イキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムラカラ　ムラヘ　コジキヲ　シナガラ、ニホンノ　アシデ　テクテク　アルイテ　イツタノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサン、ホラ　オチチノ　ニホヒガ　シテルワ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ明後日、出発のこととて、外出用のユニホォムである背広がなくなったらコオチャアや監督に合せる顔もない、金を出して作り直すにも日時がないとおもうと根が小心者のぼくのことである。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "服は仮縫いなしに、ユニホォムと同色同型のものを、出帆の時刻までに、間に合してくれることになりましたが、やはり出来てきたのは少し違うので、ぼくはこの為、旅行中、背広に関しては、いつも顔を赤らめねばなりませんでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、赤いユニホォムを着た、でぶの爺さんが、米国一流のハムマア投げ、と、きかされ、もの珍しく、眺めていたのだけ記憶にあります。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "負けたという実感より、気持の上では、漕ぎたりない無念さで、更衣所にひき揚げてきたとき、いちばん若いＫＯの上原が、ユニホォムを脱ぎかけ、ふいと、堰を切ったように泣きだしました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく久米はそのユニホームを脱いだ事は脱いだが、そのユニホームのお蔭で二三度野球部の選手達の為に、運動場へ引きずり出されて練習をやらされてゐるのを見た事がある。",
              "citation": {
                "source": "学生時代の久米正雄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホニホロはオランダ語らしいからこの腰付馬もオランダ渡来だろうと言われたが、右の引句ばかりではこの装いまた芸当を「上るは下るは」といいホニホロと言わず、ホニホロは単に囃の詞らしく、風を含み膨れる体を帆に幌とでも讃えたのでなかろうか。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
