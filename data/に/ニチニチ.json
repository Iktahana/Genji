        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "土曜日日曜日をうかがって、遊びにくるものがあってもたいていは避けて会わないようにした。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "知つてしかも恐れはばかり、日日にただ呪文の如く、朝の臥床の中で繰返してゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その孤児院の組織を見まするに、われわれの今日日本にあるところの孤児院のように、寄附金の足らないために事業がさしつかえるような孤児院ではなくして、ジラードが生涯かかって溜めた金をことごとく投じて建てたものです。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながらこの人の生涯が私を益し、それから今日日本の多くの人を益するわけは何であるかというと、何でもない、この人は事業の贈物にあらずして生涯の贈物を遺した。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十年一月『東京日日新聞』）",
              "citation": {
                "source": "浅草紙",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和九年七月『東京日日新聞』）",
              "citation": {
                "source": "ピタゴラスと豆",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが毎日日課のように繰返される間には、自分の顔の皺の一つや二つは増すに相違ない。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十三年九月『東京日日新聞』）",
              "citation": {
                "source": "流言蜚語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "零落したロシヤの帝政時代の人達の悲慘な生活振も日日眼のあたりにした。",
              "citation": {
                "source": "ハルピンの一夜",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我我は日日の劇しい演習に疲れきつた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日日が延びると、世間では何のかんのと非難が聞え出す。",
              "citation": {
                "source": "探偵小説の魅力",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあの人や、弟子たちのパンのお世話を申し、日日の飢渇から救ってあげているのに、どうして私を、あんなに意地悪く軽蔑するのでしょう。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京日日新聞社政治部、小泉邦録。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イーハトブ日日新聞だ。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の朝、私はホテルの広場で、マリオ日日新聞を読みました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に小禽、既に終日日光に浴し、歌唄跳躍して疲労をなし、唯唯甘美の睡眠中にあり。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に小禽｜既に終日日光に浴し、歌唄跳躍して疲労をなし、唯唯甘美の睡眠中にあり。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次のご文は、時に小禽｜既に終日日光に浴し、歌唄跳躍して、疲労をなし、唯々甘美の睡眠中にあり。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に小禽｜既に終日日光に浴し、歌唄跳躍して疲労をなし、唯唯甘美の睡眠中にあり、汝等飛躍して之を握む。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に小禽｜既に終日日光に浴し、歌唄跳躍して疲労をなし、唯唯甘美の睡眠中にあり、汝等飛躍してこれを握む。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月はじめの日曜日の朝、わたしが例によって半七老人を訪問すると、老人は六畳の座敷の縁側に近いところに坐って、東京日日新聞を読んでいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
