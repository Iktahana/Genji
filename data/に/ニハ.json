[
  {
    "uuid": "29a2161d-f90a-582c-abc4-f9a94811a4e8",
    "entry": "には",
    "reading": {
      "primary": "には",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現",
        "助詞"
      ],
      "ctype": null,
