  {
    "uuid": "4d06864e-b7e9-5b57-b221-81d06ec41e32",
    "entry": "ニハ",
    "reading": {
      "primary": "には",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「フーネニホ、ホバシラニハータ、コヒガヰマス、ヒゴヒモヰマス……」　雨がザアーツと降り出して来た。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト屋根ヤブレルホドノ大｜喝采、ソレモ一瞬ノチニハ跡ナク消エル喝采、ソレガ、ホシクテ、ホシクテ、一万円、二万円、モットタクサン投資シタ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラタメテ占フニハ及ビマセン。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ルヤ、君、断食ノ苦シキトキニハ、カノ偽善者ノ如ク悲シキ面容ヲスナ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ裏ニハキット墓地ガアリマス。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "決シテ、ハカナキ態ニハ非ズ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "緒方サンニハ、子供サンガアッタネ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニハカニ　クラク　ナリマシタカゼガ　ゴウゴウ　フイテキテアメモ　ザアザア　フリマシタ　春の夕立ちは、珍しい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　實に、氣の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ諸君ハ、支那ノ労働者、農民、兵士達ト手ヲ握レ、諸君ガ革命的連帯ノ固キ握手ニ達スルタメニハ、如何ナル犠牲ヲモ辞スルナ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレニハオヨバヌ」という返電が、ようやく十日ほど経って来て、復一はやっと安心した。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿ニ似テ非ナル猿面冠者ハオノガ立身出世ノタメニハ、主人ヨリ猿々ト呼ビ捨テラレルモ、ヘイヘイト追従笑ヒナド泛ベタルハ、即チ羞恥ヲ知ラザル者ト言フガ如シ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘘ノ世ノ中ニハアキアキシタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコニハ自然の約束があるから即ち一定の有様をなして、左り巻なら左り巻、右巻ならば右巻でちゃんと螺旋をなして這いまわるのだ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "のちに東京大学大型計算機センターの石田晴久によって翻訳される、デニス・リッチーとブライアン・カーニハンの『プログラミング言語Ｃ』という本が存在していることを知り、日本橋を探し回った挙げ句見つけられずに、結局アメリカから取り寄せた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ハナレヤニハマダタレカイル。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ日記ニハ「古白曰来」ノ四字ガ特書シテアル処ガアル。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "王サマハ、「デンデン　ムシムシ」ト　口ノ　中デ　イヒナガラ、ニハヲ　グルリト　マハツテ　キマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ミルト　カジヤノ　テニハ、カナヅチガ　ニギラレテ　ヰマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシタチニハ　ナンニモ　キコエヤシナイ」ト　ホカノ　タケノコタチハ　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケレド、ワタシニハ　キコエマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　イママデ　ウツカリシテ　ヰタケレド、ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルデハ　ナイカ」　コノ　カナシミハ　ドウ　シタラ　ヨイデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルノデス」ト　ハジメノ　デンデンムシガ　ハナシマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
