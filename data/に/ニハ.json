        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は英語を話すには話すが、発音はあまり良くない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の考えには賛成するが、やり方には疑問が残る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "学生時代には勉強もしたが、遊びもした。",
              "citation": {
