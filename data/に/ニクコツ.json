        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頓て其女死して多年埋もれて居る故、恰好の試驗材料と云ふ事で掘出て見れば、髮落ちず肉骨と離れず今死たるが如し。",
              "citation": {
                "source": "詛言に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "古きものは肉骨に着きて容易に動かず。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで鰍の肉骨は舌の尖端を魅するにも拘わらず、卵の味は鯰の卵に劣らぬほどである。",
              "citation": {
                "source": "魔味洗心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら、門人が祖師を得た際に、皮肉骨髄の差異あるゆえをもって、祖師を得ることそれ自身に深浅の別があると言えるであろうか。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「祖師の身心は皮肉骨髄ともに祖師なり。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
