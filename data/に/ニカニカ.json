        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "冬中いつも唇が青ざめて、がたがたふるえていた阿部時夫などが、今日はまるでいきいきした顔いろになってにかにかにかにか笑っています。",
              "citation": {
                "source": "イーハトーボ農学校の春",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "机に座って下を向いて唇を噛んでにかにか笑いながらしきりに何か書いているようでした。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キッコは一｜寸ばかりの鉛筆を一生けん命にぎってひとりでにかにかわらいながら８の字を横にたくさん書いていたのです。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもやっぱりキッコはにかにか笑って書いていました。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人はだまってしばらくけむりを吐いてから顔の少しでにかにか笑うのをそっとかくして言ったもんだ。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎はそれを押しいただくようにしてにかにかしながら受け取った。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い新聞紙を鏡の前の畳へ敷いて又長靴をはいてちゃんと立って鏡をのぞいてさあもうにかにかにかにかし出した。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "２　こがらし冷たい寒ながら、にかにかと日が照りだして、小春日といえば小春日のほどのよい七草びよりです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、真暗闇の中でいやというほどなにかにからだをぶつけながら、なににぶつかったのか瞬間には判断出来ない、あの心持になった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
