        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてニノチユカの小さい胸は波立つた。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニノチユカは跡から追ひ掛けられるやうに、暗い室から座鋪へ出た。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　学士はカナリア鳥をちよいと見て、ニノチユカの少し濃い明色の髪を撫でて、かう云つて揶揄つた。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘ニノチユカは段々大きくなる。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがプラトンの娘のニノチユカと年配が同じ位なので、これも検閲と新聞とを、結び附ける鎖の一つとなつた。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さいニノチユカがゴム毬を抱いて走つて来て、すゞしい声で云つた。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
