        "examples": {
          "standard": [
            {
              "text": "早期発見のために、毎年欠かさずマンモグラフィによる乳がん検診を受けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「乳がんだと告げられた時は頭が真っ白になったけど、今は前向きに治療してるわ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "有名な女優が乳がんを公表したことで、世間の関心が一気に高まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は結石を切る道具を発見し、乳がんについて、および膝の脱臼について書いた。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "学術研究会議（ＮＲＣ）の、ガンに対する食事と栄養の影響を研究する委員会は1982年に、“食事のすべての成分を研究した限りで、疫学的および実験的な事実を総合すると、脂肪摂取とガン‥‥とくに乳がん、直腸がん‥‥の間の原因関係が最も強く示唆される。",
              "citation": {
                "source": "栄養学小史",
                "author": "A Short History of Nutritional Science",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
