[
  {
    "uuid": "b024da6d-3f4c-5d35-9209-2de3250bdc1b",
    "entry": "ニヤニヤ",
    "reading": {
      "primary": "ニヤニヤ",
      "alternatives": [
        "にやにや"
      ],
      "is_heteronym": false
    },
    "grammar": {
