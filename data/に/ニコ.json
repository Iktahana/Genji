  {
    "uuid": "54b72ba4-22d4-5fe4-a233-c9a1707754e3",
    "entry": "にこ",
    "reading": {
      "primary": "にこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "平顔の目の小さいくちびるの厚い、見たとおりの好人物、人と話をするにかならず、にこにこと笑っている人だ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "細君の里方では、糟谷をえらい人と思いこみ、なお出世する人と信じて、この結婚を名誉と感じてむすめをとつがし、糟谷のほうでもただ良家の女ということがありがたくて、むぞうさにこの結婚は成立した。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝島獣医学博士が駒場農学校のまさに卒業せんとする数十名の生徒をひきいて種畜場参観にこられたときは、教師はもちろん生徒にいたるまで糟谷のごときほとんど眼中になかった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここをやめたからとて、妻子をやしなってゆくくらいにこまりもせまいが、しかたがない、どうなるものか益のない考えはよそう。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてさびしいはかない苦痛が、胸にこみあげてくるのである。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛想よくいつもにこにこして、葉巻きのたばこを横にくわえ、ざる碁をうって不平もぐちもなかった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "三女の礼子が帰ってきて、「おとうさんただいま、おかあさんただいま」とにこにこしておじぎをしても、父も母もはいともいわない。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "節はその以前から「日本」の愛読者で先生に対しては見ぬ恋にこがれておったとのことで、夢に見た先生と逢って見た先生とが同じであったというて当時節はしきりにそれを不思議にしていた。",
              "citation": {
                "source": "正岡子規君",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "大事に使えば生涯使えぬこともないが、ぞんざいに使えば直ぐにこわれる、治療したって駄目じゃ只眼を大事して居ればよい。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "結句の『枯葉落つる日』この一句これを取離して見れば、ただそれだけのことで、何等作者の独創があるのでなく、唯一句の記号に過ぎない詞であるが、この歌の結句にこの一句を置いて見ると、この平凡な一句が一首全体の上に、非常に淋しい影響と共鳴とを起すのである。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌の会俳句の会すべてを止めて余り人にこられては困ると云うようになってよりは。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "やみあがりの目にこゝろよき　雨の明るさ！",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばしば注意して右に持たせるくらいであるから、飯も盛んにこぼす。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その悔恨はひしひし胸にこたえて、深いため息をするほかはない。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてこの木戸でもあったらと切ない思いが胸にこみあげる。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう次第だから、作おんなのお増などは、無上と民子を小面憎がって、何かというと、「民子さんは政夫さんとこへ許り行きたがる、隙さえあれば政夫さんにこびりついている」　などと頻りに云いはやしたらしく、隣のお仙や向うのお浜等までかれこれ噂をする。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日｜麹漬をつけるからって、お母さんがそう云うから、私飛んできました」　民子は非常に嬉しそうに元気一パイで、僕が、「それでは僕が先にきているのを民さんは知らないで来たの」　と云うと民子は、「知らなくてサ」　にこにこしながら茄子を採り始める。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がさっきほんとに情なくなってと言ったら、政夫さんは笑っておしまいなしたけど……」　面白く遊ぼう遊ぼう言うても、話を始めると直ぐにこうなってしまう。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子は頻りに、にこにこしている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校で皸がきれたらおかしいでしょうね……」　僕は真面目に、「なアにこれはお増にやるのさ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がそら『アックリ』を採っていってお増にやると云えば、民さんがすぐに、まアあなたは親切な人とか何とか云うのと同じ訣さ」「この人はいつのまにこんなに口がわるくなったのでしょう。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "意地曲りの嫂にこきつかわれるのだから一層かわいそうでさ」「そりゃ政夫さん私もそう思って居ますさ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて何を思いだしてか、ひとりでにこにこ笑いだした。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて誰にこの苦悶を話しようもなく、民子の写真などを取出して見て居ったけれど、ちっとも気が晴れない。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、自分が、気取り屋でばかであることを、十分にこっぴどくやっつけられていることも知っていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと、直治に、よくしてやればよかった」　直治は高等学校にはいった頃から、いやに文学にこって、ほとんど不良少年みたいな生活をはじめて、どれだけお母さまに御苦労をかけたか、わからないのだ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬屋の支払いに就いて、私がお母さまにこっそり相談したら、お母さまは、片手でお顔を覆いなさって、しばらくじっとしていらっしゃったが、やがてお顔を挙げて淋しそうにお笑いになり、考えたって仕様が無いわね、何年かかるかわからないけど、毎月すこしずつでもかえして行きましょうよ、とおっしゃった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっかいな事になったと思いながら、食後にこっそり読んでみたが、いや、これが君、実に偉大な書翰であったのだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、マア坊も、真面目にこっくり首肯いた。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君が発見して、それから、二、三日は僕も我慢して誰にも言わずにいたが、とうとうマア坊にこっそり教えて、たちまち噂がぱっとひろがり、何せ「オルレアンの少女」の作者だという事で無条件に尊敬せられ、場長も巡回の時に、花宵先生に向って、いままで知らずに失礼しました、という意味のおわびを言ったくらいだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
