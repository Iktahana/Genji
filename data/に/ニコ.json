[
  {
    "uuid": "884c1454-ed7b-5af7-8f8d-c81070505814",
    "entry": "二胡",
    "reading": {
      "primary": "にこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
