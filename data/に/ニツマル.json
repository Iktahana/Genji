    "definitions": [
      {
        "index": 1,
        "gloss": "to be boiled down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鍋の煮汁が煮詰まってきて、とろみがついてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "議論が白熱し、いよいよ核心に煮詰まってきたようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長時間煮込んだシチューは、具材の旨味が凝縮されて煮詰まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三田は時折麥酒に口はつけるが、心持が重たくなつて、いたづらに煮詰まる鍋を見てゐる事が多かつた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私の書き得なかつた廣島の、當時の樣相を眼底に思い浮べ、私の魂自體が焔の中で煮詰まるほどの、肉體的な、精神的な苦痛を覺えるほかはない。",
              "citation": {
                "source": "「屍の街」序",
                "author": "大田洋子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の苦しみは忘れられないが、しかしちょっと言葉につまるとヘルマン教授が狙っていたように必要な言葉をどなってくれるので、その度に地獄で仏に会ったような気がするのであった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かじってえい……」　主人の声はのどにつまるように聞こえた。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は無智驕慢の無頼漢、または白痴、または下等｜狡猾の好色漢、にせ天才の詐欺師、ぜいたく三昧の暮しをして、金につまると狂言自殺をして田舎の親たちを、おどかす。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶屋女などに関係すれば、金につまる。",
              "citation": {
                "source": "半七捕物帳",
                "author": "歩兵の髪切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからは――」　感情が激してそのつぎの言葉につまるうちに、大西は急に何かに思ひついたらしくにつこりし、まるで別のことをいひはじめた。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この匂いは生きてる内から余り好きでもなかったが死んで後もやはり善くないヨ　何だか胸につまるようで。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸につまるといえばからだが窮屈だね。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日に一銭でも、二銭でも、切手を買って貼りつけていって、台紙が一杯につまると、郵便局へもってゆく。",
              "citation": {
                "source": "郵便切手",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此匂ひは生きてる内から余り好きでも無かつたが死んで後も矢張善く無いヨ、何だか胸につまるやうで。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸につまるといへばからだが窮屈だね。",
              "citation": {
                "source": "墓",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　昨夜あの女が寿司を取つて来て食べさせても、どうしても喉につまると云つてろくろく食べなかつた、あの時分にＹさんは女の家を出たのだらうかなどと私は思ひました。",
              "citation": {
                "source": "女が来て",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（声｜咽喉につまる）親鸞　皆ひざまずいて三宝を礼拝していられる。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "距離とは、人間と作品の間につまるこの空白をさすのであり、肉体的な論理によつて血肉の真実が突きとめられ語られてゐないことを意味してゐる。",
              "citation": {
                "source": "デカダン文学論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "距離とは、人間と作品の間につまるこの空白をさすのであり、肉体的な論理によって血肉の真実が突きとめられ語られていないことを意味している。",
              "citation": {
                "source": "デカダン文学論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして苦しい、喉につまる様な咳が有つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "一足は穿く、二足は革鞄につまるだろう、しかし余る一足は手にさげる訳には行かんな、裸で馬車の中へ投り込むか、しかし引越す前には一足はたしかに破れるだろう。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私　そりゃ君……（言葉につまる）須永　戦争の時は、敵を殺すのは善い事なんでしょう？",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――とき／″＼そうわれとわが胸に質してこたえにつまることがある。",
              "citation": {
                "source": "春泥",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに黄色と黒の横だんだらの方の形勢がわるくなって来たらしく、その若者は、返答につまるたんびに頭の上にちょこなんとのっかっている白いスポーツ帽をうしろから前へつき出すようにしては喋っている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼は喉につまる様な大声を上げて、『こいつだ！",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生先生とぺこぺこされ、金になり、描くほどに金になってゆくと、こういう袋小路につまるのですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍介君は学校中での秀才、頭の良さといったら春田君の質問には、先生でも時々答えにつまるくらいだった。",
              "citation": {
                "source": "危し※　潜水艦の秘密",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……実あ、その事なら、少しほかで工面ができたから、まあ当分は間に合うよ」「当分は間にあっても、お金につまるたんびに、私の身体をあてにされていちゃたまらないよ。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり複數からだんだん單數につまる方式です。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「またとこの犬を打つたら、俺がお前を殺してやるから」とようやくのどにつまるような声で云うことができた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸につまるいっぱいの涙と羞恥ましさに樹蔭へかくれてしまうのである。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "より以上に、師のすがたが胸につまるほどな感謝で待たれていたからである。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三の五　煮つまる鍋を前にして、三田はおりかの酌で飮んで居たが、どう考へても自分の立場は不思議だつた。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
