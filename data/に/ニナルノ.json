        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一年ニナルノニ、彼奴ハ故郷ニジットシテイテ、ドコニモ働キニ行コウトシナイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々ヨロケテ倒レソウニナルノデ、寒竹ノステッキヲ衝イテルガ、大概颯子カ看護婦カ誰カヾツイテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ハ既ニ七歳ニナリ小学一年生ニナルノニ、ソノ後アトガ生レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ全身ニ汗ヲ掻クト、肌ガツル／＼ニ光ッテ非常ニ魅力的ニナルノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間モモウコウナッチャ哀レナモノサ」「自分ニ希望ガ持テナイカラ焼ケ糞気味ニナルノネ」「岡焼キ気味デモアルサ、不便ト思ッテクレ給エ」「巧ク云ッテルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ春久ト限ッタコトハナイガネ、甘利デモ誰デモイヽガネ」「四阿ヘ来ルト、キットコンナ話ニナルノネ、チット散歩シマショウヨ、足ノ運動バカリデナク、頭ニモ毒ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………午睡ノアト、今日ハ鍼ハ休ミデアルガ、ヤハリ気ニナルノデ寝室ニイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽジャナイノ、折角楽シミニシテルンダカラ佐々木サンヲ行カシテオヤンナサイヨ」「君ハソレデイヽノカネ」「何デソンナコトヲオ聞キニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ顔、アタシニ見セタッテ何デモナイワ、ソレヨリ自分デ自分ノ顔ヲヨク見タコトガオアリニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "直グヨチ／＼シテ倒レソウニナルノデ、縁側カラ落チヤシナイカト心配デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワア、ワア、ワア」気ガ狂ッタラ狂ッタデイヽ、モウドウナッタッテ構ウモンカ、予ハソウ思ッタガ、困ッタコトニ、ソウ思ッタ瞬間ニ急ニハット自省心ガ湧キ、気狂イニナルノガ恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテコノ白唐紙ノ色紙ノ上ニ朱デ足ノ裏ノ拓本ヲ作ル」「ソンナモノガ何ニナルノ」「ソノ拓本ニモトヅイテ、颯チャンノ足ノ佛足石ヲ作ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ彼女ハ、「ソンナモノガ何ニナルノ」ト、云ッタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家ニアルツワイス・イコンヲ使ッテ写シテミヨウカト思ウ」ト云ッタラ、「現像ハ外ヘオ出シニナルノデスカ」ト彼ガ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ、ハイニナルノガ、コワクナイノカ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
