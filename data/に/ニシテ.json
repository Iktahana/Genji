  {
    "uuid": "53895784-ef68-5bcd-a49f-c4ef4f7f7a5b",
    "entry": "ニシテ",
    "reading": {
      "primary": "にして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "乙吉ハ二人ヲ大事ニシテクレマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ノ貧弱ニシテ醜悪ナル文章ヲ決シテ怒リ給ウナ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉ハ漆ニテ百入塗タルゴトクニシテ。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬ニシテ礼ニ中ラザルヲ野トイヒ、勇ニシテ礼ニ中ラザルヲ逆トイフ　とか、信ヲ好ンデ学ヲ好マザレバソノ蔽ヤ賊、直ヲ好ンデ学ヲ好マザレバソノ蔽ヤ絞　などというのも、結局は、個人としての子路に対してよりも、いわば塾頭格としての子路に向っての叱言である場合が多かった。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニシテ門ニ入リ名刺ヲ出ダス。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　伯父の遺稿集の巻末につけた、お髯の伯父の跋によれば、死んだ伯父は「狷介ニシテ善ク罵リ、人ヲ仮ス能ハズ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ヲ殺スハ、国家ノ大禁ニシテ、人ヲ殺ス者ヲ罰スルハ、政府ノ公権ニ候処、古来ヨリ父兄ノ為ニ、讐ヲ復スルヲ以テ、子弟ノ義務トナスノ古習アリ。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "右ハ至情不得止ニ出ルト雖モ、畢竟私憤ヲ以テ、大禁ヲ破リ、私義ヲ以テ、公権ヲ犯ス者ニシテ、固擅殺ノ罪ヲ免レズ。",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本國民ハ心ヲ冷カニシテ天ノ賞罰斯クノ如ク異ナル所以ノ根本ヨリ考察シテ、如何ニ大日本帝國ヲ改造スベキカノ大本ヲ確立シ、擧國一人ノ非議ナキ國論ヲ定メ、全日本國民ノ大同團結ヲ以テ終ニ天皇大權ノ發動ヲ奏請シ、天皇ヲ奉ジテ速カニ國家改造ノ根基ヲ完ウセザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那印度七億ノ同胞ハ實ニ我ガ扶導擁護ヲ外ニシテ自立ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ガ大地主ノ土地ヲ徴集スルコトハ最高ノ所有者タル國家ノ權利ニシテ國有ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ借家ヲ以テ利得ヲ爲ス者ハ家屋其者ヨリノ利得ニシテ、地上權ニ伴フ利益ヲ計上スルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大資本ガ社會的生産ノ蓄積ナリト云フコトハ社會主義ノ原理ニシテ明白ナルコト説明ヲ要セズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "積極的ニ見ルトキ大資本ノ國家的統一ニヨル國家經營ハ米國ノ「ツラスト」獨逸ノ「カルテル」ヲ更ニ合理的ニシテ國家ガ其ノ主體タル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貿易順調ニシテ外國ヨリ貨幣ノ流入横溢シ爲ニ物價騰貴ニ至ル恐アル時、銀行省ハ其ノ金塊ヲ貯藏シテ國家非常ノ用ニ備フルト共ニ、物價ヲ合理的ニ調整スルヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ此等ハ非常變態ノ經濟状態ニシテ輸出税ヲ課スル如キ原則ニ非ザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ大本ハ一ニシテ二ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ配當ハ智能的勞働者及ビ力役的勞働者ヲ總括シタル者ニシテ、各自ノ俸給賃銀ニ比例シテ分配ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鑛山土地等其者ハ全ク自然ノ存在ニシテ其レヲ所有セシムル凡テノ力ハ國家ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ國家ノ生産的利益ノ方面ヨリ見ルモ、幼童ニシテ殘賊スルヨリモ其ノ天賦ヲ完全ニ啓發スベキ教育ヲ施シタル後ノ勞働ガ幾百倍ノ利益ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ノ勞働ハ男子ト共ニ自由ニシテ平等ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ハ家庭ノ光ニシテ人生ノ花ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧困ニシテ實男子又養男子ナキ六十歳以上ノ男女、及ビ父又ハ男子ナクシテ貧困且ツ勞働ニ堪ヘザル不具廢疾ハ國家之レガ扶養ノ義務ヲ負フ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ婦人ニ老親ヲ負擔セシメザルハ日本古來ノ不文律ニシテ同時ニ婦人々權ノ擁護ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ヲ男子ト同一ニ教育スル所以ハ、國民教育ガ常識教育ニシテ或ル分科的專攻ヲ許スベキ年齡ニ非ルト共ニ、滿十六歳マデノ女子ハ男子ト差別スベキ必要モ理由モナキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者ヲ強制スルハ無用ニシテ有害ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "成年者ガ三月又ハ半年ニテ足ル國際語ノ修得ガ、中學程度ノ兒童一二年ニシテ完成スベキコトハ、英語ガ五年間沒頭シテ尚何ノ實用ニ應ズル完成ヲ得ザル比ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
