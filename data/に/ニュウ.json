[
  {
    "uuid": "bde67c27-cc1f-58ff-a6b3-fd36027ccd5f",
    "entry": "ニュウ",
    "reading": {
      "primary": "にゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
