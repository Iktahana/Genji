        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どうしても古代に溯りたいなら、せめてサイラスやアルタセルキセスなどは節約して、文化に貢献したアルキメーデス、プトレモイス、ヘロン、アポロニウスの事でも少し話してもらいたい。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ほんとは、ラヂオのニウスで知つたのである。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御身の敬虔なる奴僕アントニウスに慈愛を垂れ給へ。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "噫又吁　四五日内のニウスに注意せよ。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボルツマンやアーレニウスは、そういうプリンシプルの夢を書き残した。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マクスウェル、ボルツマン、アーレニウスらを悩ました宇宙の未来に関するなぞを解くべきかぎとしての「第三第四の方則」がそこにもしや隠れているのではないか。",
              "citation": {
                "source": "量的と質的と統計的と",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "去りてアスカニウス（エネエアスの子）がために、ヘスペリヤ（晩國の義、伊太利）を略せんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニウスの像を見んとてにはあらず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "該撤歿後、アントニウス一派の刺客キケロを刺さんと欲す。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウスの書に見えたる九十六年の破裂は奈何なりけん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士マレツチイは我等を顧みて、君等は古のタチツスをもプリニウスをも讀み給ひしならん、凡そ此等の書の最も好き註脚は此市なりと云ひたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "道の傍なる、蔦蘿深く鎖せるアスカニウスの墳は先づ我眼に映ぜり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アスカニウスは昔アルバ、ロンガの基を立てし人なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "言ふところはドン・ホアンを欺く蕩子なる如くにして、まことは聖アントニウスの誘惑を峻拒する氣概あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖アントニウス寺の七穹窿は、恰も好し月光に耀けり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六七六年（ストラスブルグ）版のプリニウス「万有史」の三十冊と、古代百科辞典の対として「ライデン古文書」が、まず法水に嘆声を発せしめた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりその一句と云うのが、『｜ルクレチア盗み』という沙翁の劇詩の中にあって、羅馬の佳人ルクレチアがタルキニウスのために辱しめをうけ、自殺を決意する場面に現われているからなんだ」と法水はこころもち臆したような顔色になったが、その口の下から、眉を上げ毅然と云い放ったものがあった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にそれからが、往昔｜羅馬皇帝トラヤヌスの時代に、執政官プリニウスが二人の女執事を使って、カリストゥス地下聖廊を探らせた際の、光景を髣髴とするものであった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖アントニウスはあの通りの道心堅固な生涯を送りながら、猶側の人の目に見える迄性慾の煩悶に陥つてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニウスの眼の前には毎夜のやうに裸の美人が映つて、聖者を誘惑しようとして有ゆる戯けた姿をして踊り狂つてゐたといふ事だ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウス言う、ハジ（アフリカの帽蛇）の眼は頭の前になくて顳※にあれば前を見る事ならず、視覚より足音を聴いて動作する事多しと。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウスいわく、ポンツスのリンダクス河辺にある蛇は、その上を飛ぶ鳥を取り呑む、鳥がどれほど高く速く飛んでも必ず捉わると。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウス十巻七十章には、ある鳥どもの血を混ぜて生きた蛇を食べた人能く鳥語を暁ると載す。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウスやルカヌスが書いたヤクルスてふ蛇は、樹上より飛び下りる事矢石より疾く、人を傷つけてたちまち死せしむというは、上述わが邦の野槌の俗伝にやや似て居る。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウスの『博物志』巻十一に、蛇の足が鵝の足に似たるを見た者ありと見ゆ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "古ギリシア人は日本人と同じく蛸飢ゆれば自分の足を食うと信じたるを、プリニウスそれは海鰻に吃い去らるるのだと駁撃した。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウス言う、エチオピアの長生人アトス山の住民等蝮を常食とし、虱生ぜず四百歳の寿を保つと。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウスの説に、驢は寒を恐る、故にポンツスに産せず、また他の畜通り、春分を以て交わらしめず、夏至において交わらしむと。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "プリニウス説に、愚鈍で教ゆべからずとぞ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから古ローマのネロ帝は荒淫傑出だったが、かつて揃いも揃って半男女の馬ばかり選り集めてその車を牽かしめ、異観に誇った（プリニウスの『博物志』十一巻百九章）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
