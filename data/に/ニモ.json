        "examples": {
          "standard": [
            {
              "text": "何をするにも金がかかる時代になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "どうしようにも事態は悪くなる一方だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "どんなに努力するにも及ばない状況だった。",
              "citation": {
