  {
    "uuid": "3336295e-7ba7-5fcd-ad6b-a80e69e78dd7",
    "entry": "ニモ",
    "reading": {
      "primary": "にも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナンニモシナイ、コレダケノモノ、キレイデショ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "海ノカナタノ諸々ノ国ノ者ドモニモ知ラセテヤリタイ　ともおつしやつて居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親ニモ同胞ニモワカレテ仕ヘテヰルノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と御冗談めかしておつしやいましたけれども、或いは、御陽気に見えながらその御胸中には深い御憂悶を人知れず蔵して居られたのでもございませうか、その辺の事は私どもには推量も及ばぬところでございまして、ナンニモ、スルコトガナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子孫ハ、ドコニモ居リマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六年前の建暦元年六月三日丑剋、将軍家御寝の際、高僧一人御夢の中にあらはれて、汝はもと宋朝医王山の長老たり、とお告げになつたのださうで、誰ニモ言ハズニ居リマシタガ、ソナタノ物語ト符合シテヰルトハ面白イ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノホカニモ水死人、サマザマノスガタデ考エテイルソウデス、白イ浴衣着タ叔父サンガ、フトコロニ石ヲ一杯イレテ、ヤハリ海ノ底、砂地ヘドッカトアグラカイテ威張ッテイタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "名をゼロニモ・ルジエラと云いて、西班牙の産なるが、今や此世に望を絶ちて自ら縊れなんとす。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ結核菌ノ所有者デアルガ、現在ノ父ニモ母ニモ結核菌ハナイ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お勢さんも非常に心配してお出でなさるシ、かつ君だッてもナニモ遊んでいて食えると云う身分でも有るまいシするから、若し復職が出来ればこの上も無いと云ッたようなもんだろう。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがナニモ何ですよ、お前さんが官員に成ッておくんなさらなきゃア私どもが立往かないと云うんじゃ無いから、無理に何ですよ、勧めはしませんよ」「ハイ」「それから序だから言ッときますがネ、聞けば昨夕本田さんと何だか入組みなすったそうだけれども、そんな事が有ッちゃ誠に迷惑しますネ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論以前とてもナニモ非常に文三を親愛していた、手車に乗せて下へも措かぬようにしていたト云うでは無いが、ともかくも以前は、チョイと顔を見る眼元、チョイと物を云う口元に、真似て真似のならぬ一種の和気を帯びていたが、この頃は眼中には雲を懸けて口元には苦笑を含んでいる。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ不倫な言ひざまで恐縮の極であるが、わたくしはレオナルドオのモナ・リザよりは寧ろ其サン・ジエロニモの画を愛する。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオナルドオのあの鋭くして柔軟な素描を残したジエロニモこそ世にもこよない物である。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシタチニハ　ナンニモ　キコエヤシナイ」ト　ホカノ　タケノコタチハ　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカニモ　カナシミハ　イツパイデス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカニモ　カナシミハ　イツパイデス」　ソコデ、ハジメノ　デンデンムシハ　マタ　ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ムラニモ　ヒトハ　アマリ　ヰマセンデシタガ、マダ　スコシハ　ノコツテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
