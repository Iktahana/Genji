        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古來歴史上の大科學者、例へばガリレオや、ワツトや、ニユートンや、エヂソンやが、その少年時代に於て、いかに夢想的な子供であり、いかにフアンタスチツクな童話の愛好者であつたかを、彼等の教育者等は知らないのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三階の廊下から見上げた山腹の各旅館の、明るく灯のともつた室々の障子の列が上へ上へと暗い夜空の上に累積してゐる光景は、龍宮城のやうに、蜃氣樓のやうに、又ニユーヨークの摩天樓街のやうにも思はれた。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはでこぼこではありましたが、アルミニユームでできてゐましたから、大丈夫こはれませんでした。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "周公、孔子の如き聖人、ナポレオン、アレキサンドルの如き英雄、或はニユートン、コペルニカスの如き學者であらうとも、皆其の努力に因つて其の事業に光彩を添へ、黽勉に因つて大成して居る事實は、爰に呶々する迄もないことである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニユートンの如きは、現に自ら『不斷の精思の餘に之を得たり』と云つて居るでは無いか。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今頃は傳令の奴、いいニユースを持つてやきもきしながら自轉車を走らせてゐるよ。",
              "citation": {
                "source": "一過程",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが單純なニユースといふより以上の意味をもつて語られてゐる事は明らかであつた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこゝへ來てから偶然に耳にしたニユースのやうなものを二つ三つ話した。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼びそめぬ、ラヂオのニユース、フラン落ち、巴里暴動す、ポアンカレーまた世に出でむ。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "初夏の水たたへてゐる　雲がない花の散らうとしてゐる　柿の若葉が見えるところで寝ころぶ　けふのみちも花だらけ・わらや一つ石楠花を持つ途上で、蛇が蛙を呑まうとしてゐるのを見た、犬養首相暗殺のニユースを聞かされた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹明来信、宿直だから来遊を待つ、おもしろいニユースがあるといふ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時のサイレンを聞いてから出かける、ニユースといふのはＫさんの事だつた（彼に幸福あれ）、いつものやうに夕飯をよばれ（無論、般若湯も！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界歴史に燦然として光輝を放つべき南京入城式の壮観が、今日の新聞では写真と共に色々報道されてゐる、ありがたいニユースであつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、奥さもいつしよに出かける、新天地でニユース映画を観る、帰途、小野さんの宅に立寄る。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「物理学者でも、ガリレオが寺院の釣り洋燈の一振動の時間が、振動の大小に拘はらず同じである事に気が付いたり、ニユートンが林檎が引力で落ちるのを発見したりするのは、始めから自然派ですね」「さう云ふ自然派なら、文学の方でも結構でせう。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニユーヨークにプリンストン出の若い銀行家があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ところに長く住まつてゐると、どこかに移つてみたくなるのは、誰でもが心のどこかにもつてゐるあくがれであるが、ニユー・イングランドの農夫に、この漂泊性を多分にもち合せた男があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍草６・５東京日日（夕）　ニユーヨークに富豪の未亡人で結構な温室をもつてゐる女があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニユートンの飼ひ狗はダイヤモンドといふ名前だつたが、誰一人その犬を宝石と間違へたものはなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞそのダイヤモンドが卓子の上の蝋燭を倒したばかりに主人のニユートンは二十年丹精した光学の原稿を焼かれてしまつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニユーヨークのすぐれた財政家として知られてゐるジヨオジ・ベイカア氏は、若い時からいそがしいづめで、七十になるまでは運動らしい運動をしたことはなかつたが、その年になつて初めてゴルフをしだした。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをニユーヨークのある女学校の高等科で、問題に出して答案を求めたところが、五十人の学生の中で、たつた四人しか答案を出さなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「東京の新聞社ぢや大したものだらう、尤も俺は日本の新聞社は何処も知らないが、――ヒラデルヒヤの学校にゐた時分の友達で、ベン・ウヰルソンといふ男が今でもニユーヨーク・ヘラルドの論説記者をしてゐる、つい此間も手紙を寄した、そら、お前が子供の時分にオルゴールを送つて呉れた人だよ。",
              "citation": {
                "source": "父の百ヶ日前後",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつの間にか、少年雜誌のセント・ニコラスや、ニユーヨーク・タイムスのハツピーフリガン漫畫などを笑ひながら讀めるやうになつてゐた。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて送られてゐたニユーヨーク・ヘラルドの日曜絵附録に、桜の木のジヨージ・ワシントンが現れた時、余は、母に秘かに赤面したが、何としても白状出来なかつた。",
              "citation": {
                "source": "余話（秘められた箱）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつの間にか、少年雑誌のセント・ニコラスや、ニユーヨーク・タイムスのハツピーフリガン漫画などを笑ひながら読めるやうになつてゐた。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "南極へ着いたものは自分がペンギン鳥と踊つてゐる心になり、シヤムに行けば象の鼻をねじり倒した画は自分の活動と思ひ、クルツプやモスコウ、イルクツク、ニユーヨークなどは、ほんとに腕に力が入つた。",
              "citation": {
                "source": "喜びと悲しみの熱涙",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダニユーブ河は雛芥子とともに太っていく。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンシルバニア地方を代表したフイラデルフイア大学はタフトを、ニユーハンプシヤイア地方からのハーバード大学はマツキンレイを、そしてメリーランド地方としてはワシントン大学がルーズベルトを支持した。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
