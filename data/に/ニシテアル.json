          "literary": [
            {
              "text": "石膏デ出来テイテ、頸カラ頤ヲ突キ上ゲルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ浴室ト寝室ノ間モ行ケ／＼ニシタガ、コレハ必要ニ応ジテ浴室ノ内部カラ締マリガ出来ルヨウニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツイデニ記スト、便所ノ右隣ガ予ノ書斎（コノ間モ行ケ／＼ニシテアル）、ソノ右ガ看護婦ノ部屋。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ノイナイ夜ハドウスルカト云ウト、婆サンガ代リニ佐々木ノベッドニ寝ルコトニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日ダケコヽニ入院シタ形式ニシテアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
