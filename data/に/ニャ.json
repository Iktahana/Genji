  {
    "uuid": "e51a8900-1db4-5860-a86e-8bf962531014",
    "entry": "ニャ",
    "reading": {
      "primary": "にゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「権輿」ケンニョ、「山野」サンニャ、「専要」センニョー。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "躯を直角に曲げて、耳をおっ立てて、彼は「グニャグニャしたロープ」を、闇の中に求めた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時間か四時間の間に、彼は茹でられた菜のように、萎びて、嵩が減って、グニャグニャになっていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、あの、「伯父ワーニャ」を演じて日本一と称讃せられた上杉新介氏の正体か。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫を紙袋に入れて、ちょいとつけばニャンと鳴かせる、山寺の和尚さんも、鼠には困った。",
              "citation": {
                "source": "半島一奇抄",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の小猫はまた小猫で、それ井戸は隣と二軒で使うもんだから、あすこの隔から入って来ちゃあ、畳でも、板の間でも、ニャアニャア鳴いて歩行くわ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして私はその時、一冊の同人雑誌の片隅から井伏さんの作品を発見して、坐っておられないくらいに興奮し、「こんなのが、いいんです」と言って、兄に読ませたが、兄は浮かぬ顔をして、何だかぼやけた事を（何と言ったのか、いまは記憶に無いけれども）ムニャムニャ言っただけだった。",
              "citation": {
                "source": "『井伏鱒二選集』後記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チュアン　イエン　ペイフォン　ツイイエンジュン　ハン　コアンフイパイ　ファニャン　ワンアルツイホン　ゾアン　イ　コン　ウエイ「畜生！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「停車場で君がバルシニャ（娘）と話しているのをきいたことがあるよ――美人だったじゃないか。",
              "citation": {
                "source": "穴",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫大将はきげんよくニャーと鳴いてするりと向こうへ行ってしまいました。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の刀は余ッぽどなまくらと見えてグニャーと曲って居る。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "乞食、ムニャムニャ言い乍ら、起き上る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その猫は平常吉田の寝床へ這入って寝るという習慣があるので吉田がこんなになってからは喧ましく言って病室へは入れない工夫をしていたのであるが、その猫がどこから這入って来たのかふいにニャアといういつもの鳴声とともに部屋へ這入って来たときには吉田は一時に不安と憤懣の念に襲われざるを得なかった。",
              "citation": {
                "source": "のんきな患者",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内に小さき鏡、コニャック一｜瓶、小さきコップ数個、紙巻莨を入れたる箱、菓子を入れたる朱色の日本漆器などあり。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かぱっと眼の覚めるようなものを持ってお出で、コニャックでも。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂から上がり、姿見に向かい三人相顧みて、「随分黒くなったなあ」　この夜、吉岡髯将軍ビール二杯呑んだところが早速酔っ払ってしまい、自分から注文した名物の羊羹が来たのも知らずに、鼾声雷のごとくグーグームニャムニャ。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――嘘ついたら、エンマはんに舌抜かれるし」　そして、上ると、他吉はもう蒲団をかぶって寝ていて、枕元にコンニャクの形の空気草履が並べて置いてあった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一銭天婦羅屋は十五年、牛蒡、蓮根、コンニャクの天婦羅を揚げている。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして最後のリフレーンで「イズンティット・ロマーン」まで歌った最後の「ティック」の代わりに、バルコンの下から忍びよるド・サヴィニャク伯爵の梯子が石欄に触れる「ティック」の音を置き換えてある。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがヴァレンティーヌ夫人、ド・ヴァレーズ伯爵、ド・サヴィニャク伯爵へと伝播する。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの野良猫だ、ニャーフウー」　一杯に頬を膨らし、呻って啼真似をすると、ごく低声、膳の上へ頤を出して、「へい、ですかい屑屋ですかい。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と被さるように鼻を持って行ったと思うと、「ニャーゴ！",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　遠慮なく、箸をとっていて、二人とも揃って箸を置いたが、お悦さんの方は一口飲み込むと、酒は一滴も喫けない婦の、白く澄ました顔色で、「ニャーゴ！",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来を云えば弥陀なり弥勒なり釈迦なりを頼んで、何かムニャムニャを唱えて、そして自分一人極楽世界へ転居して涼しい顔をしようと云うのは、随分虫のいいことで、世の諺に謂う「雪隠で饅頭を食う」料簡、汚い、けちなことである。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
