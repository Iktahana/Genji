        "examples": {
          "standard": [
            {
              "text": "今日中にこのレポートを終わらせにゃならん。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "みんなに迷惑をかけないように、気をつけにゃいかん。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "電車の時間に間に合うように、急いで駅に行きにゃいかん。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
