        "examples": {
          "standard": [
            {
              "text": "庭桜が満開になり、美しいピンク色の花を咲かせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "春になると、毎年庭桜の開花を楽しみにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭桜の小さな実を鳥が啄みに来る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "仲道の庭桜はもし咲いて居るかも知れぬと期して居たが何処にもそんな花は見えぬ。",
              "citation": {
                "source": "車上の春光",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ最初に文明十六年十月廿四日の条に、前庭植信乃桜十本とあるが、是は其前年に家を新築した為なので、旧い住居の方でも前庭桜花盛開といふ記事が屡※見えるから、元来が花の多い家だつた。",
              "citation": {
                "source": "信濃桜の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
