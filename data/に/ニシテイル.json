        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日辻堂カラ陸子ガ子供達ヲ連レテ来ルノデ、ソレヲ心待チニシテイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ニモ逃ゲ出シソウニシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕ニモ分ラン、僕ハアンマリ浄吉ノコトヲ考エナイヨウニシテイル」「アタシモソウナノ、聞イテモ彼ハ面倒臭ガッテホントノコトヲ云ッテクレナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般カラハソウ見エルニ違イナイノデ、忰モ内々ソレヲ自慢ニシテイル風ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼モコノトコロ努メテ宵ノウチニ帰ルヨウニシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モデルニスル颯子ニモ、浄吉ニモ、婆サンニモ、誰ヲモデルニシテイルカヲ悟ラセヌヨウニスルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ナリ工合ヤ歪ミ工合ハゴク僅カデ、動作ニ不便ヲ感ズルホドノコトハナク、人ニ気付カレルコトモナイノデ、今日マデソノママニシテイルガ、アノ日カラズット、今モソノ状態ガツヅイテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ時、僕ハ本気デ注射ヲスルノガ馬鹿気テイルノデ、カンフルヲ射ス真似ヲシテ、ヴィタミンヲ射シテヤル※ニシテイルノダガ、木村ガ気ガ付イテ、「先生、コレデイインデスカ」ト小声デ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "散歩ニ出テモアマリ多クヲ歩カヌヨウニシ、ナルベク人通リノ少イ所、百万遍、黒谷、永観堂辺ニ杖ヲ曳イテ、主ニベンチデ休憩シテ時間ヲツブス※ニシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
