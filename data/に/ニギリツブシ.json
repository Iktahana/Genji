        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は手に持った紙コップを握りつぶし、苛立ちをあらわにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怒りのあまり、彼女は手に持っていたリンゴを握りつぶしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "蝶を捕まえた子供は、誤って握りつぶしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
