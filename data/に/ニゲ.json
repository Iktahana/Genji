  {
    "uuid": "2011d0e6-6e91-59f0-acfd-2e791c8ee1ab",
    "entry": "ニゲ",
    "reading": {
      "primary": "にげ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オニドモ　ヘイコウジユンジユンニ　タツテ　ニゲマスヤマオクヘ「待つて下さい！",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "インケツ、ニゾ、サンタ、シスン、ゴケ、ロッポー、ナキネ、オイチョ、カブ、ニゲなどと読み方も教わり、気の無い張り方をすると、「質屋の外に荷が降り」とカブが出来、金になった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "タニガワノ　オトガ　ダンダン　チカク　ナツテ　キタ　トコロデ、トツゼン　カゴカラ　トビダシ、カゼノヤウニ　ハヤク　グングン　ニゲマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムライハ　一シヨウケンメイ　ニゲマシタガ　イキガ　キレタノデ、ミチバタヘ　バツタリ　スワツテ　シマヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カアチヤン、アサツユガ　ニゲテツチヤツタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "下ニゲリア人はその身にかつてを尊び、各その後胤と称し、これを盾に画く者あり（ラツェル『人類史』）。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　ベルリン市ケニゲルグラッツェル街七〇番。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルリン・ケニゲルグラッツェル街のスパイ本部で、マタ・アリは命令を受け取っていた。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ショウワユウゲキタイヲ、オソレルナ……コウフクヲトリケシ……ゼンソクリョクデ、ニゲヨ……」「畜生ッ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十三日）　学校へ「トシニゲタ、ホゴタノム」という電報がきたのは十日だと思う。",
              "citation": {
                "source": "出奔",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は灰色で、シンニゲプラッテ Schynigeplatte, 2060m. やハイムウェー・フルー Heimwehfluh も雲の中。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "日はシンニゲプラッテの上に登って、空は湖水のように澄み渡る、そして波の上には、烟のような淡い霧が風のまにまに流れて来る、然し南の岸は切ったてで、朝の日は湖水のまん中までしかさし込んで来ない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "メョンヒの頂上は雲にかくれて、ラウテルブルンネンの左につづく、シンニゲプラッテの山腹から上には、雪が真白に積っていた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのむこうは、すぐアーベントベルクの絶壁になって、そことシンニゲプラッテの間には、ルーゲンパルクの真黒な樅の木立の後ろに、奥深く入り込んだ、うす暗いラウテルブルンネンのつき当りに、彼のユンクフラウの三山が仰がれる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファウルホルンの方角にはシンニゲ・プラッテの附近が際立って明るく、ニーセンの頂上にはアーク灯らしい光が天狼星のように光る。",
              "citation": {
                "source": "続スウィス日記（千九百二十三年稿）",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二ヒキハ　トンデニゲマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドノ　シタニ　ニゲテ、コレデ　アンシント　ネコロンダ　トタンニ、　パタ　パタ、パン　パン。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オモテヘ　ニゲヨウ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
