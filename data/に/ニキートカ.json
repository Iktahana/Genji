          "literary": [
            {
              "text": "ニキートカとのあいだに四人の子供をもうけましたが、どうもわたくしどもでは子供が育ちません。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで配偶のニキートカに、どうか巡礼に出しておくれと申しましたのでございます。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしがおりませんでは、きっとうちのニキートカはむちゃなことをしているに違いありません。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それと同じことを言って、ニキートカもわたくしを慰めてくれました。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの愛しいニキートカ、おまえさんはこのわたしを、待ちかねていさっしゃろうなあ、ニキートカ、さぞ待ちかねていさっしゃろうなあ！",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
