        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてハイドンや、バッハや、ヘンデルやは、そう呼ばれていないのである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に西洋の子供たち、科學の先進國たる獨逸や佛蘭西の子供たちでさへ、今尚好んで讀んでるものは、グリムやアンデルセンの童話であり、森の妖精や魔法使の話なのだ。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリムもアンデルセンも、日本の桃太郎やカチカチ山の作者も、すべて皆兒童心理學の大家であり、同時にフアンタスチツクの夢をもつてる詩人であつた。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トーヴァルセンを出して世界の彫刻術に一新紀元を劃し、アンデルセンを出して近世お伽話の元祖たらしめ、キェルケゴールを出して無教会主義のキリスト教を世界に唱えしめしデンマークは、実に柔和なる牝牛の産をもって立つ小にして静かなる国であります。",
              "citation": {
                "source": "デンマルク国の話",
                "author": "信仰と樹木とをもって国を救いし話",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、アンデルセンの「あひるの子」ほどの「天才の作品」も、一つもないようだ。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンデルセンの「あひるの子」という話を知っているだろう。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸をどきどきさせて、アンデルセン童話集、グリム物語、ホオムズの冒険などを読み漁った。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ショパン、リスト、モオツアルト、メンデルスゾオン、ラベル、滅茶滅茶に思いつき次第、弾いてみた。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕アンデルゼンのおはなしやなんかもっと読みたいなあ。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アンデルゼンの猫を知ってゐますか。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇で毛を逆立てゝパチパチ火花を出すアンデルゼンの猫を。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして八犬伝やアンデルセンの『月物語』をかの女の兄から借りて読んで居るのだつた。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンデルセンの『即興詩人』を読んだ時に頭に刻まれていたいろいろの場面が、この駅の名の響きに応じて強く新しくよみがえって来るのであった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ではゲーテの「ライネケ・フックス」や、それから、そのころようやく紹介されはじめたグリムやアンデルセンのおとぎ話や、「アラビアン・ナイト」や「ロビンソン・クルーソー」などの物語を、あるいは当時の少年雑誌「少国民」や「日本の少年」の翻訳で読み、あるいは英語の教科書中に採録された原文で読んだりした。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ習い始めたメンデルスゾーンの「春の歌」の、左手でひく低音のほうを繰り返し繰り返しさらっていた。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "中学時代になってからやっとイソップやグリムやアンデルセンにめぐり合って日本の外に他の世界があること、そこにはわれらとはよほどちがった生活と思想のあることを教えられたのであった。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治二十年代の田舎の冬の夜はかくしてグリムやアンデルセンでにぎやかにふけて行ったのである。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸の内の「グンデルビ上海」の類である。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリムやアンデルセンは北欧民族の「民族的記憶」のなごりを惜しんで、それを消えない前によび返してそれに新しい生命を吹き込んだ人ではないかと想像される。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "市電の革屋町駅で降り、本通りと名付けられたこの通りを東に向かって歩くと、パチンコ店や高級食料品店が目に入り、その並びにブティックや書店があり、パン屋のアンデルセン本店のはす向かいには、何と小さな古書店がある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（『アンデルセン童話集』）　印刷本をなぞるみにくいアヒルの子として生まれたＤＴＰはやがて、こう叫ぶでしょう。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "小品ばかりか難しい曲も弾けることは、要望に応えて、メンデルスゾーンのリートや私のお気に入りを何曲か演奏してくれたことからもよくわかる。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンデルセンの夜のはなしを讀んで、涙を流した。",
              "citation": {
                "source": "夜に就て",
                "author": "立原道造",
                "note": "青空文庫"
              }
            },
            {
              "text": "』」解説矢崎源九郎　アンデルセンといえば、おそらくその名を知らない者はないといってもよいであろう。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンス・クリスチャン・アンデルセン Hans Christian Andersen ――われわれはいつのまにかアンデルセンと呼びなれているが、これはわが国独特の呼び方であろう。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は貧しい靴職人であったが、折にふれて幼いアンデルセンにおとぎばなしや物語などを読んで聞かせた。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は仕立屋の職人にしたいという希望を持っていたが、アンデルセンみずからは舞台に立つことを望んで、十四歳のときただひとり首都のコペンハーゲンをめざして旅立った。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
