        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ブンゼン燈のバリバリと音を立てて吹き付ける焔の輻射をワイシャツの胸に受けながらフラスコの口から滴下する綺麗な宝石のような油滴を眺めているのは少しも暑いものではなかった。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気療法のさまざま　強い電光で皮膚病、殊に狼瘡などを治すいわゆるフィンゼン療法は数年前から行われている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一面にはマリオ高等農学校の、ブンゼンといふ博士の、毒蛾に関する論文が載ってゐました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニキビの出ている寿子だけは、アストリンゼントをつけた。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真をとっても証拠にならぬ場合のある事はアムンゼンの飛行機の行くえに関する間違いの例でも知られる。",
              "citation": {
                "source": "錯覚数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の低い大机があちこちにあり、上にはレトルトや試験管、青火揺らめく小型のブンゼン・バーナーなどが散らかっている。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "シルヴィーにくらべれば、レズリー・ゴーアも、コニー・フランシスも、「ゼーンゼン目じゃない」のだそうだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "川棚温泉――土地はよろしいが温泉はよろしくない（嬉野に比較して）、人間もよろしくないらしい、銭湯の三銭は正当だけれど、剃髪料の三十五銭はダンゼン高い。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はもうそんな年齢になったのかね」と道化した顔をしたが、法水は皮肉に微笑み返して、「だいたいヘンゼンでもエーワルトでもそうだが、お互いに聴覚生理の論争はしていても、これだけは、はっきりと認めている。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此レ歐米諸國ヨリ一歩ヲ先ンゼントスル國民的覺醒ヲ裏切ル大汚濁ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の事はないブンゼンラムプの大きなヤツを二百ばかり併列した形だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴女の会社に新高竜夫って言う運転手が来たらダンゼン御用心なさい。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを始めて計算したのがクリスチアンゼン（Christiansen）である。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてクリスチアンゼン（Christiansen）の挙げた次の例に相当する。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがためには証拠の代りに、クリスチアンゼンの言った通り『宇宙進化には本性未知のある作用が行われた』と仮定する外はない。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんた、今日市場へ寄らないの、私今晩のおかずを買って行くのよ……」　一皿八銭の秋刀魚は、その青く光った油と一緒に、私とお千代さんの両手にかかえられて、サンゼンと生臭い匂いを二人の胃袋に通わせてくれるのだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云うと、彼女はフンゼンとして沈黙って出て行った。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "房々とした断髪をかしげて、色っぽい瞳をサンゼンと輝やかす。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かぼそい薬指に、サンゼンと白い石が光って台はプラチナだった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝこんな時にこそ、サンゼンと美しく生れて来ればよかった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一皿八銭の秋刀魚は、その青く光った油と一緒に、私とお千代さんの両手にかゝえられて、サンゼンと生臭い匂いを二人の胃袋に通わせた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼女はフンゼンとして沈黙って出て行くと、やがて梯子段をトントン降りて行った。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ますます貴女はお美しくサンゼンとしてゐます。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、手伝ってちょうだい」「どうすればいいの」「そのブンゼン灯に火をつけてみてよ」「はい。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああブンゼン灯に火がついた。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちのブンゼン灯にも火をつけてよ。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴重な薬が今こそ作られるのだ」　雪子学士の幽霊は、まるで火取虫のようにブンゼン灯のまわりをぐるぐると踊りまわって喜ぶのであった。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、、医学史はじまっての大実験に、俺はきっと凱歌をあげてみせるぞ」　彼は、ぼつぼつ独り言をいいながら、さらにレトルトや金網やブンゼン燈などをあつめてきた。",
              "citation": {
                "source": "生きている腸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気も通じてブンゼン燈にも薄青い焔が点ぜられた。",
              "citation": {
                "source": "生きている腸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "実験第九日目には、ブンゼン燈の焔が消えた。",
              "citation": {
                "source": "生きている腸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
