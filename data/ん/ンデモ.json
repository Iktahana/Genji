        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "莫大ナル出兵費ハ誰カラ出ルカ、諸君ガ一本ノ煙草ヲ喫ンデモ、半斤ノ砂糖ヲ使ッテモ、一足ノサル又ヲ買ッテモ、必ズ間接ニ徴収セラレル税金カラ出テイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　フエフキガ　ヒトリゴトヲ　イフト　ヂイサンハ　カホヲ　アゲテ、「サウサ、カナヅチハ　ナンデモ　ツクルンダ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "臓腑デモ……睾丸デモ……ナンデモ遣ル。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤイヤイ野郎どもトンデモない奴だ！",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサゴハンデモタベルトシヨウ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、通人の旦那たるもの、大いに道を楽しみ、人情小説を書きながすのは結構であるが、カタキでもないトンデモ・ハップンの姐御を、本気で目のカタキにするのは、大人げない。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、姐御が筆の隙間から、目のさめるような酷薄ムザンな正体をさらけだすのにくらべると、旦那はヤカン頭の湯気をポッポッとさらけだしているだけで、トンデモ・ハップンの姐御に円みがないだけ、イキがいいし、目ざましい。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "“能筆ジム”の奥方は、自分の亭主が逮捕されるなんてトンデモ・ハップン、あの人は立派な亭主で、思いやりのある父親で、悪いことをするなんて思いもよらぬことでござんすと、言いはったとか。",
              "citation": {
                "source": "“能筆ジム”",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆の衆聴けよ、この蓬がヨモギだトヨ、我国の学者はトンデモない見当違いをしたもんだ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナ二流芝居」「イヤソウ云ッタモンデモナイサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ト、清琴ノ声デ唄ッテイルノガ聞エテ来ルヨウナ、モウ死ンデイル筈ダガ、死ンデモ聞エテ来ルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モハヤ人生ニ疲レタ、トデモ云ウノダロウカ、イツ死ンデモイヽ気ガシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿道ノ故障ハ今朝ハ一応良クナッタノデ、行ッテ行カレナイコトハナイノダガ、夜ノ外出ナド飛ンデモアリマセント云ッテ、佐々木ガ承知シナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「タマノ土曜日曜ニ家ニイルンダカラネ」「ダカラ何ナノヨ」「タマニハユックリ自分ノ家デ女房ト一緒ニ朝寝坊ヲシタイダロウヨ」「不良爺サンデモ時ニハ忰ニ孝行スル気ガアルノネ」「罪亡ボシニネ」「餘計ナオ世話ダワ、浄吉ノ方ジャ有難迷惑ダッテ云ウワ」「ドウダカネ」「イヽワヨ、ソンナ心配ヲシテ下サラナイデモ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「久シュウオ目ニカヽリマセンデシタガ、相変ラズオ元気デイラッシャイマスナ」「ナアニ、チットモ元気ナコトナンカナイヨ、今度ハ京都ヘ自分ノ墓地ヲ捜シニ来マシタ、イツ死ンデモイヽヨウニネ」「御冗談デショウ、ソノ勢イジャアマダ／＼大丈夫デイラッシャイマスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデモ予ハ感ジテ見セル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜マタ飲ミニ来テクレタマエ」ト云ッタラ、「トンデモナイ、一昨夜ノ晩ハビックリシマシタ、少シ先生モ慎ンデ下サイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ豫想スルトコロデハ、妻ハコノ記事ヲ読ンデモ読マナイフリヲシテ、マスマス淫蕩ニナルデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キタムラガ、アケチノトコヘ、イッテ、ハナシタコトモ、シッテルヨ、ナンデモ、シッテルヨ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエガ何ヲ企ンデモ無駄ナコトダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
