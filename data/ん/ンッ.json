        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三次が「アカンッ」と眼で知らす。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "三次はフンッと鼻であしらってソッポ向く。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョンッと拍子木一ツ鳴る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　仲蔵ドキンッとして立ちすくむ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔見合せて、「何と面白い事じゃ喃」と言って居る時、一人の浪人者がドンッと団九郎に突き当って御免、と其儘立ち去る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "半分寝言を云いながら、戸をあけると、身体がブルンブルンッとすくむ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ浪を離縁せンッか」　「しかしそれは」　「しかしもねもンじゃ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ浪を離縁せンッか」「しかしそれは」「しかしもねもンじゃ。",
              "citation": {
                "source": "小説　不如帰",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えいッ、相手はわずか二人か三人、なにを猶予しているのだ、ふくろづつみにして、そッ首をあげちまえッ」　呂宋兵衛が怒号したとたんに、ズドンッ！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "パン、パンッ、と二つ三つ、弾音が宵の空に谺した。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "引き金を引いた時、バンッという音もガツンという反動も感ぜず――命中すれば常にこうなる――代わりに耳に届いたのは群衆が立てる悪魔的な喚き声だった。",
              "citation": {
                "source": "象を撃つ",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
