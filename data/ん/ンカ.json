        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "八月のことで、外はカンカン日が照つてゐた、そして彼の家は風の入りが好くなかつた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "セイラーは、カンカン・ハマーで、彼女の垢にまみれた胴の掃除をする。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "水夫たちは、デッキのカンカンをやっていたのだった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとかい」「ほんとだとも」　水夫たちは、ボースンと共に、カンカン・ハマーを放り出したまま、おもてへ駆け込んだ。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピー、カンカンか」　私はポカンとそこへつっ立っていた。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも構わないから、滅多に出かけて来て、ケンカを吹っかけそうもない奴で、大もので、面つきの気に食わん奴に『腹を立てとけ』とでもいうことに、俺は考えていたんだろう。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれは、あまり動かない部分をカンカンに凍らせた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はたちやそこらでペンカンさげて、マストにのぼるも――親のばちかね」西沢は坑夫の唄をもじって、怒鳴った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が日本の諸先輩に対して、最も不満に思う点は、苦悩というものについて、全くチンプンカンプンであることである。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "知っているものは世知だけで、思想もなにもチンプンカンプン。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東北人のユウモアは、とかく、トンチンカンである。",
              "citation": {
                "source": "散華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お勝手のマッチ箱にルナアルの絵を貼ったり、お人形のハンカチイフを作ってみたり、そういう事が好きなのね。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "真なるもののみが愛すべきものである、とポアンカレが言っている。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに博士は、ひどい汗かきなのに、今夜は、ハンカチを忘れて出て来たので、いっそう惨めなことになりました。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は早速、三鷹の馴染のトンカツ屋に案内した。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私たちはトンカツ屋で、ビイルを飲みながら話した。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五所川原駅からガソリンカアで三十分くらい津軽平野のまんなかを一直線に北上すると、その町に着くのだ。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おひる頃、中畑さんと北さんと私と三人、ガソリンカアで金木町に向った。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガソリンカアは、のろのろ進み、金木駅に着いた。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの場合を総括するに、いずれもかつてポアンカレーの述べしごとく「原因の微分的変化が結果の有限変化を生ずる場合」に当るを見る。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポアンカレーは「方則は不変なりや」という奇問を発している。",
              "citation": {
                "source": "物質とエネルギー",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ複雑な変化の微小な事、またポアンカレーの謂うごとく複雑さが十分複雑であるために「偶然の方則」が行われ、多くの場合には簡単な平均的の云い表わしを抽象的に考える事が出来るのであろう。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アンカー」と「アンガー」である。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポアンカレーの言葉を借りて云わば、前者は源因の微分的変化に対して結果の変化がまた微分的である場合に当り、後者は源因の微分的差違が結果に有限の差を生ずる場合である。",
              "citation": {
                "source": "地震雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が部屋に這入ると絹のハンカチに涙の地図をかいた女が私の姿を見ると罵るように、妾は日本が憎い、妾の恋しい人を連れ出すのはこのインボスタ奴！",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は昨夜からの涙の滲んだ絹のハンカチを香港の朝の風景に飜えして、　――妾達は陳独秀の健康を祈るのです。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙが汚れたハンカチを振っている。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
