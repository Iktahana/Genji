        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから、醤油屋の「ゴンゾ」にもなった。",
              "citation": {
                "source": "自伝",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はい、えゝと、ベーリング地方と、はい、トバスキー、ゲンゾスキー、二名であります。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「トバスキーとゲンゾスキーといふのは、どういふやうなやつらかな。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「四番書記、トバスキーとゲンゾスキーについて大略を述べよ。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "」四番書記のかま猫は、もう大原簿のトバスキーとゲンゾスキーとのところに、みじかい手を一本づつ入れて待つてゐました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼光｜炯々たるも物を言ふこと少しく遅し、ゲンゾスキー財産家、物を言ふこと少しく遅けれども眼光炯々たり。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタコノヘンノオテラ、ボンゾサン　シッテヰルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノヘンノボンゾサン、シャカブツ五カイ、マモルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "団九郎、例に依って、フンゾリ返って門内に入る。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "桂子はこの鋼鉄の廊門のやうな堅く老い黯ずんだ木々の枝に浅黄色の若葉が一面に吹き出てゐる坂道に入るとき、ふとゴルゴンゾラのチーズを想ひ出した。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "居所ヲ調ベルト承知センゾ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体全体何んでもドンゾコまで分ッてる世界ではない。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の智慧でドンゾコまで分るものだかどうだか知れないのサ。",
              "citation": {
                "source": "ねじくり博士",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなゆかし、ロレンゾか、鐘鳴らし、まめやかに安息の日を祝ぐは、あな楽し、真白なる羽をそろへ鴿のごと歌はまし、わが子らよ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ、ドラムはハンゾーでいいとして、問題はベースだ」　ハンゾーというのは、名字のせいで安易につけられた、服部のニックネイムだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハンゾー、だれかベースやりそうな奴いないかな」「ベースなんて、そこらの奴にもたせりゃ、なんとかなんじゃないの」　柾生とおなじような、乱暴な意見をいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それにしても、ハンゾーはいいよ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジョワは、ハンゾーと高志だけじゃないの」　と、慶一は高志のほうを見る。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「柾生、山崎、佐藤、広岡、こんだけ起こしてこい」「ハンゾー先輩は？",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "余の見る所を以てすると、現今毎月刊行の文学雑誌に載る幾多の小説の大部分は、英国の『ウィンゾー』などに続々現れてくる愚劣な小説よりも、どの位芸術的に書き流されているか分らない。",
              "citation": {
                "source": "文芸委員は何をするか",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヒゲナンゾ　ツケタリ　シテ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴天だと、ルウエンゾリ山が好箇の目標になるのだが……、降りだして雨霧に覆われてからは、ただ足にまかせて密林のなかを彷徨いはじめた。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "左には、連嶺をぬいて雪冠をいただいている、コンゴのルウェンゾリがみえる。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "その涯がうつくしい残陽に燃え、ルウェンゾリの、絶嶺が孤島のようにうかんでいる。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊太利陸軍は、参戦以来、主力をイゾンゾに注いで、大規模な攻撃を開始した。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、費やした肉弾と、砲弾の量にもかかわらず、わずかイゾンゾ河の下流で国境を越えたにすぎなかった。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
