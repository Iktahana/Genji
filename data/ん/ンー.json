          "literary": [
            {
              "text": "私しゃね、大変｜御無沙汰しッちまッて、済まない、済まない、ほんーとうに済まないんだねえ。",
              "citation": {
                "source": "今戸心中",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "おふくろー悪者にしようとすんーような奴ー持った俺れが因果よ。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なーんーでーすーと。",
              "citation": {
                "source": "辻馬車",
                "author": "モルナール・フェレンツ　Molnar Ferenc",
                "note": "青空文庫"
              }
            },
            {
              "text": "意地悪さと高慢とひねくれとねちねちした性格は、だんだんーニヤを抱いた。",
              "citation": {
                "source": "愛の詩集",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はふくぶくしい丸顔の頬についたそら豆大のほくろを看板に学校ぢゆうの愛嬌者になつてたが、ひとが面白半分に「蟹本さん、頬ぺたに墨がついてるよ」といふと　ふ、ふ、ふ　と笑つて「すーみーぢやーなーいーんーだ。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほーくーろーなーんーだ」とおほやうにいふ。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもかまはず倦まず撓まずつづけるうちある日彼は虱のやうにへばりついてる席をはなれひよこひよことそばへきてれいの舌たらずみたいに「□□さーんーはーいーいーひーとーだ」といふなり　ふ、ふ、ふ　と笑つていつてしまつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーン、バーン、ドドーンー　発破は機関銃のように続いて、又は速射砲のようにチョット間を置いて、鳴り続けた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミリミリ、ドタンーとうなる。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "マツシーマーア、カデンーノーオー、センキーンーンタン」というふうに全く同じ四拍子アンダンテの旋律を繰り返しながら、だんだんに薬の効能書きを歌って行くのである。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワラ、あけてやれ」　ふたりがふりかえると、山崎が窓に顔をべったりくっつけて、ブタのような顔をして、ンーと、うなっていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「汝、左門ンーン」　それは、血を吐くようなお浦の声であった。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベンーリオーが命を召されませう。",
              "citation": {
                "source": "ロミオとヂュリエット",
                "author": "ROMEO AND JULIET",
                "note": "青空文庫"
              }
            },
            {
              "text": "父「ン、ンー能く労つて呉れるの。",
              "citation": {
                "source": "大仏餅。袴着の祝。新まへの盲目乞食",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父「ンー摩つて呉れ。",
              "citation": {
                "source": "大仏餅。袴着の祝。新まへの盲目乞食",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳「乞食の足イ……ンー／＼／＼。",
              "citation": {
                "source": "大仏餅。袴着の祝。新まへの盲目乞食",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主「ンー……お前様も何んだらうね……。",
              "citation": {
                "source": "大仏餅。袴着の祝。新まへの盲目乞食",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主「ンー……南蛮砂張の建水は、是品は遠州の箱書ではないかえ。",
              "citation": {
                "source": "大仏餅。袴着の祝。新まへの盲目乞食",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主「然う仰やられては実に胸が一｜杯になります……お菓子か何かあるだらう……最う皆な賓客に持たして遣つてしまつたか……困つたなア……何かないかなア……ンー一｜軒おいて隣家の大仏餅でも宜い、仕方がない……宜しく此餅を皆皿に積んでの……さア何うか不味ない物だが子供衆に皆な上げて下さい。",
              "citation": {
                "source": "大仏餅。袴着の祝。新まへの盲目乞食",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに山里の人に聴けば、ンー、その草なら内の家の裏の岩に幾らも着いていらーと言う処もあろう。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブランデンーをくれ。",
              "citation": {
                "source": "バブル崩壊",
                "author": "A BUBBLE BURST",
                "note": "青空文庫"
              }
            }
          ]
