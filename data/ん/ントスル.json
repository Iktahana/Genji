    "definitions": [
      {
        "index": 1,
        "gloss": "to try to (do)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は逆境にあっても、なお前進せんとする強い意志を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "難攻不落の城を攻略せんとする兵士たちの雄叫びが響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山頂を極めんとする登山家たちの足取りは、一歩一歩が重い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "村落の光る厩のうへに、かがやく愛の手は伸びゆきて、われの身は銀の一脈、ひそかに息づき生命はや絶えなんとする。",
              "citation": {
                "source": "厩",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "作品が存在の姿を持つためには、なんらか書かうとする前に書かんとする作品の全的な予想といふものがハツキリとしてゐなければならぬ。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "男　新聞に拠ると、いよいよ改築を修了せんとする、日本の、ドレスデン街さ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "）５　私が彼を訪問した時、私が訴へんとするすべてのことを、彼は前からちやんと知つてた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし最近の如く、彼が詩に深い接觸をもち、詩的の實精神に憧憬し、殆んどそれによつて文藝觀の本質に突き入らんとするが如きは、恐らくかつて見なかつた所だらう。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私の信ずる所によれば、彼の自殺における「漠然たる不安」の一つは、近く來らんとする彼自身の心境的革命にまで、名状しがたき不安の困憊を感じたのである。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷土の名を、わが空拳にて日本全国にひろめ、その郷土の名誉を一身に荷わんとする意気込みが無ければ、とても自身の生れた所の名を、家の屋号になど、出来るものではありません。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して、芸術論が屡々余りに空言に終ること多い理由は、芸術家でない人に芸術的制作を可能ならしめんとする意向を知つてか知らないでか秘めてゐることそれである。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋なくて日暮れんとする春の水　こうした春の郊外野景を描くことで、蕪村は特殊の画才と詩情とを有している。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『邪魔するな、ヤイ』前に立つた男を突き飛ばして、なお吼けり行かんとする先に、亦もや手を拓げた一人。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不意を打たれて芳は危く昏倒せんとして、僅に身を支へた、其處を、勝に乘じた群衆はなほ、執念強く、取り包んで、凡そ息のある限り、滅多無性に打ちすゑんとする、刹那の急。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィンの射た矢は、まさに放たんとするエーナールの弓のただ中にあたって弓は両断する。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗客多くて坐る余地もなければ入口に凭れて倒れんとする事幾度。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "芒の蓬々たるあれば萩の道に溢れんとする、さては芙蓉の白き紅なる、紫苑、女郎花、藤袴、釣鐘花、虎の尾、鶏頭、鳳仙花、水引の花さま／″＼に咲き乱れて、径その間に通じ、道傍に何々塚の立つなどあり。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "窪んだ眼にまさに没せんとする日が落ちて、頬冠りした手拭の破れから出た一束の白髪が凩に逆立って見える。",
              "citation": {
                "source": "凩",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの諸人物を以て、ただちに日本人の輕重を推計せんとするのは、それこそ刻舟求劍のしたり顏なる穿鑿に近い。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷土の名を、わが空拳にて日本全國にひろめ、その郷土の榮譽を一身に荷はんとする意氣込みが無ければ、とても自身の生れた所の名を、家の屋號になど、出來るものではありません。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おちつきがなく、あせり心地に、つねに外界に索めんとする。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことや我は石のごと影の如くは生きてきぬ……呼ばんとするに言葉なく空の如くははてもなし。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲府盆地の方向から、富士川下流の方へと両端を垂下して、陰鬱なる密集状態を作っているところは、まさに来らんとする雷雨を暗示している。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は水に溺れんとする瞬間に過去の生涯全部の幻影を見るそうである。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほつとしてその柱にとりすがると心がしんとする程門の柱は落ちついて居た。",
              "citation": {
                "source": "秋雨の追憶",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年の間、待ち焦れ、恋ひ慕ひ、あらゆる寂寞と閨怨とによつて刺戟しつくした揚句、今また息も詰るやうな歓喜の圧迫によつてこの自分を苦しめさいなまんとする、敵よ！",
              "citation": {
                "source": "恋愛といふもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "体験さるる意味の論理的言表の潜勢性を現勢性に化せんとする概念的努力は、実際的価値の有無または多少を規矩とする功利的立場によって評価さるべきはずのものであろうか。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の一篇は、一般に予報の可能なるための条件や、その可能の範囲程度並びにその実用的価値の標準等につきて卑見を述べ、先覚者の示教を仰ぐと同時に、また一面には学者と世俗との間に存する誤解の溝渠を埋むる端緒ともなさんとするものなり。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら実際の自然現象を予報せんとする場合に、この現象を定むべき主要条件を遺漏なく分析する事は必ずしも容易ならず。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばまた過飽和の状態にある溶液より結晶が析出する場合のごとき、これがいつ結晶を始め、また結晶の心核が如何に分布さるべきかを精密に予報せんとする時、単に温度従って過飽和度を知るのみにては的中の見込は極めて小なるべし。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　今天然の起る現象を予報せんとする際に感ずる第一の困難は、その現象を限定すべき条件の複雑多様なる事なり。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
