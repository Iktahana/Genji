        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "むしろ性慾を一つの生活気分として、客観的にエンジョイすることの興味を知った。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりこうした中年者らは、享楽の対象を直接の性的慾求に置くのではなく、むしろその性的なものを基調として、一種の客観的な雰囲気を構成する事で、気分的に充分エンジョイしているのである。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等だけが、本当に音楽をエンジヨイし、音楽の本質を完全に知つてゐるのだ。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度の何とか称する貴族で、デッキパッセンジャーとして、アメリカに哲学を研究に行くと云う、青年に貰った、ゴンドラの形と金色を持った、私の足に合わない靴。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "デッキでは、セーラーたちが、エンジンでは、ファイヤマンたちが、それぞれ拷問にかかっていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女がその臨月のからだで走れる限りの速力が、ブリッジからエンジンへ命じられた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　船のエンジンはフルスピードをかけていたが、風と浪とで速力がまるで出なかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリッジからは、直ちにエンジンへ向けて、フルスピードを命令した。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、伝馬にはデッキ、カッターにはエンジンということに振り当てられた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれの要求条件は、エンジンの労働者によっても、吟味せられるだろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃ僕が、都合はどうだか、きいて来るから、君は、エンジンの上で、待っててくれたまえ」　波田は、そのまま、気軽に飛び出して行った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "機関長はエンジンへはいって、ハンドルへ、手をかけて待っていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間がみんな、ナポレオンやミケランジェロになれるわけじゃあるまいし、小人の日常生活の苦闘にも尊いものがある筈だし、金子先生のお話は、いつもこんなに概念的で、なっていない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "男と女が、コオヒイと称する豆の煮出汁に砂糖をぶち込んだものやら、オレンジなんとかいう黄色い水に蜜柑の皮の切端を浮べた薄汚いものを、やたらにがぶがぶ飲んで、かわり番こに、お小用に立つなんて、そんな恋愛の場面はすべて浅墓というべきです。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミケランジェロは、そんなことをせずともよい豊かな身分であったのに、人手は一切借りず何もかもおのれひとりで、大理石塊を、山から町の仕事場までひきずり運び、そうして、からだをめちゃめちゃにしてしまった。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミケランジェロは、人を嫌ったから、あんなに人に嫌われたのだそうである。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは、上は、ナポレオン、ミケランジェロ、下は、伊藤博文、尾崎紅葉にいたるまで、そのすべての仕事は、みんな物狂いの状態から発したものなのか。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "」を保田与重郎が送ってくれ、わがひととは、私のことだときめて再読、そのほか、ダヴィンチ、ミケランジェロの評伝、おのおの一冊、ミケランジェロは再読、生田長江のエッセイ集。",
              "citation": {
                "source": "碧眼托鉢",
                "author": "――馬をさへ眺むる雪の朝かな――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「これは小さい声でいうことだが、僕は、ミケランジェロと老ダンテを思うと、からだがふるえる。",
              "citation": {
                "source": "碧眼托鉢",
                "author": "――馬をさへ眺むる雪の朝かな――",
                "note": "青空文庫"
              }
            },
            {
              "text": "スパークのようなトランジェントな現象である。",
              "citation": {
                "source": "スパーク",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八七五年から七六年にわたる冬の数箇月間ビーチャム・タワー（Beauchamp Tower）というエンジニアーを助手として水力学の実験をした。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからナタル、ザンジバールをも見舞った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "太平の夢はこれらのエンジンの騒音に攪乱されてしまったのである。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　流行言葉の中でも「ソートーナモンジャ」と「ドーカと思うね」には、どこか科学的なスケプチシズムの匂いがある。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は不幸にして未来派の画やカンジンスキーのシンクロミーなどというものに対して理解を持ち兼ねるものであるが、ただ三色版などで見るこれらの絵について自分が多少でも面白味を感ずる色彩の諧調は津田君の図案帖に遺憾なく現われている。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　ロバータ　前に見た「コンチネンタル」と同じく芸人フレッド・アステーアとジンジャー・ロジャースとの舞踊を主題とする音楽的喜劇である。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手でも足でも思い切り自由に伸ばしたり縮めたりしてはね回っているけれども、その運動の均衡が実に安定であって、非常によくバランスのとれた何かの複雑なエンジンの運転を見ているような不思議な快感がある。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
