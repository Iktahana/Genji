          "literary": [
            {
              "text": "」「女中のソーンダズです。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは隣り合わせの部屋で寝ており、キングのおかみがソーンダズの部屋へかけこんだ。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでぼくは、それで何といったのときくと、　ンダズー（そうだよと肯定する方言）と言ったと朗らかに笑っている。",
              "citation": {
                "source": "子どもの世界",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは妻と一しょに「ンダズ」はふるっていると笑ってしまった。",
              "citation": {
                "source": "子どもの世界",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次男の哲は、自分の名前から思いついたらしく、「社会党の書記長」を自任し、長男坊は、例の「ンダズ」事件以来「キョウサントウ」を自称して朗らかなのである。",
              "citation": {
                "source": "子どもの世界",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
