        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あのインダラ鍛冶屋は。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンダラ彫刻した夜の女の手が闇から出て私をシセロの居酒屋に引張ると足とも手ともつかぬ黒い肉体を蛇のように私の首に巻きつけて、蛇酒を調合したソーマ酒の杯をかちあわして一気にあおってしまった。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』に気づくべき筈なのに、帰りて、まず、唯物論的弁証法入門、アンダラインのみを拾いながらでもよし、まず、十頁、読み直せ。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またガニミード神話の反映をガンダラのある彫刻に求めたある学者の考えでは、鷲がガルダに化けた事になっている。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのチョコレートシェイクという飲み物を、白地に赤のダンダラがついたストローですこし吸いあげた慶一は、困惑を忘れた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊「――俺家の鶏ども、白色レグホンだって、ミノルカだって、アンダラシャだって、どいつもこいつも、みんなはあ、黒鶏みてえになってるから。",
              "citation": {
                "source": "黒い地帯",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゴノ　中ノ　サムライガ　ナンダラウト　オモツテルト、コンドハ、「タヽキコロサウカ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オマヘハ　ドウダ、ウデガ　ムヅムヅシテルンダラウ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは正坊だったら、赤と白のダンダラ服をきているから、すぐわかると思ったからでした。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンダラの服はきていませんでしたが、正坊にちがいないことがわかると、クロはウォーンウォーンと、のどをしぼるような、うれしなきのさけびをあげました。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミリオンダラーか何か。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい……派手なダンダラ縞の……ネ。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのパラソルは一口に云えば空色であるが、よく見ると群青と、淡紅色の、ステキに派手なダンダラ模様であった。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからか怪しい物音が近付いて来はしまいかと、耳を澄まし、眼を凝らしながら身構えていたが、そのうちに薄黒いダンダラを作った花壇の向う側の暗黒を、白々と横切っている混凝土塀に眼を止めると、彼は思わずニンガリと冷笑して首肯いた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その卵白色とエナメル黒のダンダラの長い長い抛物線型に伸びた触角は、宇宙間に彷徨している超時間的、超空間的の無限の波動を、自由自在の敏感さで受容れるところの……そうして受入れつつユラリユラリと桐の葉蔭で旋回しているところの……変幻極まりない鋭敏な、小さい、生きた、アンテナそのものであった。",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵白色と、黒｜天鵞絨色のダンダラになって……ホラ……ネ……」「フウム。",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの襟化粧をした頸部の周囲に、生々しい斑点となって群がり残っている絞殺の痕跡……紫や赤のダンダラを畳んでいる索溝を……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはこの時福太郎の頭の上から、夥しい石の粉が、黒い綿雪のようにダンダラ模様に重なり合って、フワリフワリと降り始めたからであった。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞いた通りに派手なダンダラの角帯を締めていやがる。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてタッタ今、凝視していた砂利の上に、何の苦もなく突き倒されたように思ったが、その瞬間に彼は真黒な車輪の音も無い廻転と、その間に重なり合って閃めき飛ぶ赤い光明のダンダラ縞を認めた。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その雪のような乳房の表面には、今まで締め付けていた繃帯の痕跡が淡紅色の海草のようにダンダラになってヘバリ付いていたが、しかし、私は溜息をせずにはいられなかった。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他のブラマ、オーピングトン、アンダラシャン、ブリモースロック、ミルカ、コーチン、レグホンの類は鶏でない。",
              "citation": {
                "source": "探偵小説の真使命",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "春先ではあるがダンダラ縞のモノスゴイ藪蚊がツーンツーンと幾匹も飛んで来て、筆者の鼻の先を遊弋する。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "JANYSKA と刻印した空色のマークの横に、黒と金色のダンダラになった細長い生物がシッカリと獅噛み付いている。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年は上衣と胴衣を脱いでワイシャツ一つのネクタイを緩めているし、眉香子も丹前を床の上に脱ぎ棄てて、派手な空色地の長｜襦袢に、五色ダンダラの博多織の伊達巻を無造作に巻きつけている。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "月代と鬚は近頃剃ったものらしいが、何を使ってどうして剃ったものか、アチコチに切込疵だらけで、ところマンダラに毛が残っているのが、ホコリだらけの町人｜髪。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとから乾燥し切った風が、黄色と黒のダンダラになって追いかけて行く。",
              "citation": {
                "source": "塵",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて舞踏のザワメキが中絶して、シインとなったと思う間もなく、タッタ今閉まった扉が向側から開かれて、赤白ダンダラの三角の紙帽を冠ったタキシードが五、六人ドヤドヤと雪崩れ込んで来て、私の眼の前の長椅子に重なり合って倒れかかった。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは本格の舞踏服に白チョッキを着込んだヒョロ長い中年紳士であったが、赤白ダンダラの三角帽を右手に持って、左の掌に載せた名刺を、私の顔と見比べ見比べ、私の前に立ち止まると、青白い憂鬱な顔をしてジイッと見下した。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜剌比亜式の平べったい煉瓦積み（煉瓦は板壁にペンキで描いたもの）に、カーキー色と赤のダンダラの日除けを張りまわしているのがある。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
