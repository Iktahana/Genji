        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その後ヘンリー八世の所有となったこともあった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭司次長ウィリアム・タッピング祭司長ヘンリー・デビスに代ってこれを述べる。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代の人ではアンリー・ルッソーの画を座右にして居ます。",
              "citation": {
                "source": "岡本一平論",
                "author": "――親の前で祈祷",
                "note": "青空文庫"
              }
            },
            {
              "text": "お京さんがフランス人の夫アンリーから最後に逃げて隠れていたのは丁度こういう露地の中の家だった。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お京さんが夫のアンリーのところを逃げ出す前にお京さんは加奈子にこういったことがあった。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリーはあたしを燃やし尽そうとする。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西人アンリーのこういう願いからお京さんはアンリーに貰われた。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリーはリヨンで王党の党員だったが矯激の振舞いがあったのでしばらくフランス縮緬の輸出の仕事を請負って東洋へ来た。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリーの家へも牛乳を入れていた。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことは一二度に過ぎなかったのだけれど、そのときアンリーから心付けを貰った配達夫はその後も自分で絵葉書を買って配達壜に結びつけお京さんの好意だといって心付けを貰った。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお京さんがアンリーを忘れてしまった時分にすっかり馴染みがついたつもりのアンリーはお京さんとその両親を晩餐に招いた。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから本当に馴染がついてしまってアンリーもお京さんに嫁の望みを言い出せるようになった。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白百合の五つ紋の黒紋付できちょうめんに坐ったアンリー。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリーの覚束ない日本語。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから行くたびに何かかにか愚痴が出るようになり、程なく遂々お京さんはアンリーから逃げ出した。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリーは狂気のようになって探し廻った。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリーは事情を承知して其の儘お京さんの病気が癒って戻って来るのを、ひとりのままで待っているという。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オースチンリードで出来合いをすこし直さしたモーニングの突立った肩が黄いろい金鎖草の花房に臆じた挨拶をしながら庭の門を入る。",
              "citation": {
                "source": "百喩経",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この店の由緒には巴里人が始めてそこでフォークを使ったヘンリー三世時代の驚きが飾りとなっている。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだしもオー・ヘンリーやカミの方が才能があるが、しかし、オー・ヘンリーやカミといえども二流、三流である。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はうぬぼれかも知れないが、オー・ヘンリーやカミやマーク・トゥエーンよりはましな小説が書けると思っている。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の知る限りではただアンリー・ポアンカレーがその晩年のエッセー（７）において論じたものである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンコールが始まると、大半のメンバーの脳裏にスタンリー・キューブリックの「二〇〇一年宇宙の旅」の印象的な場面がよみがえった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "――やがて君は、君の本棚の上にあるヘンリー・ワァード・ビーチャーの額縁なしの肖像画へ目を移した。",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと、古いけどさ、〈ガッド・オンリー・ノウズ〉は？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウェル、ゴナ・ビー・ザ・ラスト・ソング・フォー・トゥナイト……ウー、ベイビー、アイ・ラヴ・オンリー・ユー、〈ユー・ベイビー〉」　ワラが、ドラムとスレイ・ベルをバックにささやく。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年からサロンにもステレオがおかれ、いまもビートルズの新作『サージャント・ペパーズ・ロンリー・ハーツ・クラブ・バンド』を流している。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
