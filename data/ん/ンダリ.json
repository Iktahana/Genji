        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはナムサダルマプフンダリカサスートラというものである。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "プログラムに入るまえに、ＫＷＴＳのレジェンダリー・ファウンダー、一期の浅井高志から、お話があります」　｜伝説の創設者がおかしかったのだろう、オフマイクの笑い声がきこえる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時は丁度、同じ亜米利加から、実業家のヴアンダリツプ一行が来て、盛んに日本人に歓迎されてゐた時なので、ヴアン・ダイクの事は一向世間の噂に上らなかつた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "はるばる九州クンダリまで河合又五郎をきめて来たんだ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "布哇クンダリまで持って行けるか。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それあ、この××クンダリへ流れて来るまでにゃガラ相当の苦労も致しやしたよ。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「最新の学説である問題の『若返り法』はわざわざ九州クンダリまでお出にならずとも当店で達せられます。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シ人ヲヨンダリ叫ンダリハシマセンデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな卓の花瓶にコスモスの花が、紅い小さなボンボンダリアと一緒に挿してあるのが眼に留ると、彼は一昨日は見なかったダリアの花に、ささやかな変化を見出すのではあったが、午後の明るい光線と澄んだ空気は窓の外から、今もこちら側を覗いている。",
              "citation": {
                "source": "秋日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ナモサダルマブフンダリカサス――トラのりふれんが時々きこえて来る。",
              "citation": {
                "source": "惰眠洞妄語",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いポンポンダリアを三本買って来たのを、お久さんが土産に持って来た白樺細工の掛花瓶にさし、一本だけお久さんにやった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンポンダリアはまんまるくて、赤くて、暖かそうで、二輪並んで插っている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい男片腕なし　今日はＹ、リンゴ２、マンダリン〔みかん〕三つを買った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミカン――マンダリーン。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナナースとマンダリーン。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがナチの支配者に云わせるとドイツ文化を純粋にし、高めるためにこそ、こうしたヴァンダリズム（？",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "でこういう「ドイツ文化」が吾々の文化という観念ともはや何等の関係もないので、このドイツ文化が正にドイツの非文化・反文化・となるわけであり、バーバリズム乃至ヴァンダリズムとなるわけなのだ。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、この一種の芸術至上主義が、芸術の社会民衆による批評を無視することによって、如何に芸術上のヴァンダリズムにいたり得るものかということを、示してくれたのも彼である。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "）に類するものが、ナチの手によって見事文化上のヴァンダリズムに転化されて了ったからであり、しかもこれこそが芸術に対する至上の尊敬だという名目は愈々立派に立つことになるからである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーチェやキールケゴールは勿論、イラショナリズムとか、ヴォランダリズムとか、または宗教的形而上学とか、また哲学的文化とか、其の他其の他の普通の哲学概論式命名によっては少しも内容を説き明かされることは出来ない。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "処で漱石の場合、その重きをなし大をなした所以は新しい思想の誕生や旧文化に対するヴァンダリズム文化の創生などではなくて、あくまで既成の、常識的に許容された意味での「文化」の高水準にあったのだ。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オネコサンハ似合ヒモシナイ洋服ヲキテ得意デスシ、アヒルサンハアカダラケノクサイ洋服ヲキテ大ヨロコビナノデ、誰デモ二人ヲミルト、ワラツタリ、ハナヲツマンダリシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　カゲモ　ヨロコンデ、トンダリ、シツポヲ　クルクルト　フリマワシタリ　シテヰマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（父ヘクトール命ぜし名、＊スカマンダリオス、然れども衆人呼べる彼の名は＊アスチュアナクス――其父はひとりイリオン守るため）、彼れ今無言にほゝゑみて愛兒眺むる傍にアンドロマケー近よりて、　405涙を流し彼の手を執りて言句を宣し曰ふ、394　結納の豐富なる意。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマノ　トムト　　イヌノ　ジヨンハアマリヨロコンデ、トンダリハネタリシテ、タローサンニ　　シカラレマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "青紫蘇の繁った庭の隅に、ポンポンダリヤの赤い花が、一きわ珍らしく目に映った。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "口ヲ打タレテ血ダラケニナッテマウスピースガ三ツニ割レテ飛ンダリスルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ハソンナモノヲ担ギ込マセテドウスルンダ」予ハ婆サンノイナイ所デハ、颯子ノコトヲ「オ前」ト呼ンダリ「君」ト呼ンダリスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
