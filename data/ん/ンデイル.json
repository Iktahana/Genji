        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンジツ二〇インチノタイホウ八モンヲツンデイルコトヲハツケンシタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "手術室デ―ソレハ死ンデイルワ　生キタ骨片見タコトアル？",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "団十郎ノ助六ハコノ時ガ最後デ、三十六年ニハ死ンデイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ハ予ニチョット挨拶シタキリ、茶ノ間デ婆サント何カ頻リニ話シ込ンデイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ト、清琴ノ声デ唄ッテイルノガ聞エテ来ルヨウナ、モウ死ンデイル筈ダガ、死ンデモ聞エテ来ルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階ニハ泊リ客ノタメノ室モアルガ、ドコデ彼等ハ涼ンデイルノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子モ一緒ニ出テ行ッタノカ、ソレトモ流石ニバツガ悪イノデ一人デ二階ニ引ッ込ンデイルノカ、一向姿ヲ現ワサナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ母屋デモ家族全部ヲ収容スルノニ狭過ギルト云ウコトハナイガ、予ガイロ／＼ト企ンデイル悪事ヲ実行スルノニハ少シ不便デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノセイカドウカ脚ガ非常ニ重ク且｜浮腫ンデイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナアニ、明日日曜ナンデミンナ遊ンデイルンデスヨ」京都駅ハ下リノ時ハブリッジヲ沢山登ラナケレバナラナイノデ、コレガ甚ダ億劫デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシオ腹ガ減ッテルノヨオ爺チャン、早ク食堂ヘ行キマショウヨ」五子達ハ済ンデイルト云ウノデ三人デテーブルニ就ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒ヲ厳シク禁ジラレテイル予、下戸ノ五子、少シハ行ケル筈ナノニ慎ンデイル佐々木ヲ除イテ、颯子、菊太郎兄弟ノ三人デ調子ガ弾ミ、九時近ク食事ガ終ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御馳走サマ、久シ振ニオイシカッタワ」茶ヲ飲ンデイル颯子ヲ掴マエテ予ハオモムロニ話シカケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ石ヲ蹈ミ着ケテ、「アタシハ今アノ老耄レ爺ノ骨ヲコノ地面ノ下デ蹈ンデイル」ト感ジル時、予ノ魂モ何処カシラニ生キテイテ、彼女ノ全身ノ重ミヲ感ジ、痛サヲ感ジ、足ノ裏ノ肌理ノツル／＼シタ滑ラカサヲ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何モ彼女ガ実際ニ石ヲ蹈ンデイル時トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガモシ読ンデイルノデアッタラ、決シテコレハ偽リノ日記デナイヲ信ジテホシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ来テ、四人デ食卓ヲ囲ンデイル最中ニ彼女ガドコカヘ立ッテ行ッテ、シバラク戻ッテ来ナイノデ、「ドウナスッタノデショウ」ト木村ガ云イ出シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ世ニモ珍シイ廻リ合セト云ウベキハ、陰険ナ四人ガ互イニ欺キ合イナガラモ力ヲ協セテ一ツノ目的ニ向ッテ進ンデイル※デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "媚ビノ呈シ方、陶酔ヘノ導キ方、漸々ニエクスタシーヘ引キ上ゲテ行ク技巧ノ段階、スベテハ彼女ガソノ行為ニ渾身ヲ打チ込ンデイル証拠デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ハ書物ノ上ニ注ガレテイルガ、何モ読ンデイルノデハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
