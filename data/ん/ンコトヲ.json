        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "行クニノゾンデ、継イデ見ンコトヲ約シ、ソノ館舎ヲ詢ヘバ、豊陽館ナリトイフ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ其レガ左傾スルニセヨ右傾スルニセヨ前世紀的頭腦ヨリスル是非善惡ニ對シテ應答ヲ免除サレンコトヲ期ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度ヲ設ケテ壹百萬圓以下ノ私有財産ヲ認ムルハ、一切ノ其レヲ許サヾランコトヲ終局ノ目的トスル諸種ノ社會革命説ト社會及人性ノ理解ヲ根本ヨリ異ニスルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ三年間ノ日月ハ日本ノ整然タル改造組織ヲ傳聞セシムルニ十分ナルガ爲メニ、日本大多數國民ノ歡喜ヲ傳ヘテ彼等ノ大多數國民亦速ニ其ノ福利惠澤ニ浴センコトヲ欲スルニ至ルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今次ノ大戰中ニ於テ日本ハ獨逸ノ青島ヲ領有シテ支那ニ還附セザランコトヲ企ツルト共ニ、獨逸ノ投資ヲ繼承シ更ニ北支那ニ投資的侵略ヲ學ビタルコト悉ク獨逸ノ跡ヲ追フ者ナラザルハナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド人事ヲツクシテ天命ヲ俟タンコトヲ思イ、許シ得ル範囲ノ応急送信機及ビ受信機ヲ建造セルナリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ陛下深仁深慈臣ガ［狂→至］愚ヲ憐レミテ少シク乙夜ノ覧ヲ垂レ給ハンコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ臣ハ恐ル其禍ノ及ブ所将サニ測ル可ラザルモノアランコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏テ望ムラクハ聖明矜察ヲ垂レ給ハンコトヲ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ客ノ此楼ニ登ツテ酔ヲ買ハント欲スルモノ、若シ特ニ某隊中ノ阿嬌第何番ノ艶語ヲ聞カンコトヲ冀フヤ、先阿嬌所属ノ一隊ノ部署ヲ窺ヒ而シテ後其ノ席ニ就カザル可カラズ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧山が『老子講義』六巻の自序に、「始余ノ昌平黌ニアルヤ寺門静軒マサニ駒籠ヲ去ラントシ、余ニ講帷ヲ嗣ガンコトヲ勧ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ヲ以テ改メテ期ヲ速ニセンコトヲ図ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "独リ予及ビ三島遠叔ニオケルヤ盛ニ推許ヲ加ヘ、人前ニ称道シテ唯及ザランコトヲ恐ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔此ノ行鱸魚ノ膾ノ為ナラズ／新詩ヲ把リテ白華ヲ補ハンコトヲ擬ス〕と言ってあるから時節は秋の半過であろうか。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "山重リ嶺｜複リ、道路｜、衆足ヲ失センコトヲ恐レ次ヲ乱シ地ヲ択ビテ行ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "従者ノ泥路ニ苦シマンコトヲ慮リ天ノ曙トナルヲ待ツテ発ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ然ラズシテ長ク毒水ノ横流ニ任セバ、臣ハ恐ル、其禍ノ及ブ所将ニ測ル可ラザルモノアランコトヲ」　最後はまた、次のような哀切極まる文字をもって結んであった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、天下三分シ、操ハソノ二分ヲ占メ、ナオ、馬ヲ蒼海ニ水飼イ呉会ニ兵ヲ観ンコトヲ望ム。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ト予トハ元ヨリ仇デハナク、君ノ厳父ハ、予ノ先輩デアリ、長ジテハ、君ト知ッテ、史ヲ語リ、兵ヲ談ジ、天下ノ為、大イニ成スアランコトヲ、誓イアッタ友ダッタ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨロシク王位ニススメ、魏王ノ位ヲ賜ワランコトヲ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏シテ望ムラクハ、丞相ノ謀リ遠キヲ慮リテ、早ク良図ヲ施シテ怠リヲ欲スルコトナカランコトヲ。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
