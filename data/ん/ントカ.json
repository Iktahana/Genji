          "literary": [
            {
              "text": "トカトントン、トントントカトン、とさかんに打ちます。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "規模から見ても利益率から見ても、日本のエクセレントカンパニーと呼ぶにふさわしい存在であろう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私が、その指に巧みなブリリアントカットの宝石があるのに目を付けて訊ねると、「これはオランダの現王家からだ。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエントカフエカシコラミヨノダイミヨウジン。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "メヲパチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲオリマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　メヲ　パチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲ　オリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "国民酒場のオヤジに向って、旦那、スミマセンガ、モウ一杯ナントカ、と頼んでいるのはオ客の方で、ダメだよ、ウルセエナ、と言っているのはオヤジの方なのである。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "痴人なお汲むナントカの水という禅話がある。",
              "citation": {
                "source": "梟雄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめ大手町の何ントカ省前で二人降され、次に運転手が神田橋で降され、畑のマンナカではなくて、東京のマンナカ、何ントカ省という賑やかな官庁前や神田橋で降されて、犯人をつかまえるための手段ができないという三人のダンナのバカさ加減は、不可解に類する。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリ・ベイルのメチルド夫人に於ける如く、アンゴ某のナントカ嬢に於ける如く、その他何々の何々に於ける如し。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速ルパンが部下をつれて駈け付けた時は、列車はすでにモントカロへ向って出発した後であった。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしモントカロへ着くと、再びメルジイ夫人の手紙が待っていた。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "金助　ホントカ、おい？",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツモ締マリガシテナイト云ッタカラ、ホントカドウカ試シテ見タノサ」云イナガラ予モ浴室ノ方ヘ首ダケ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテソノ足ノ甲ニ接吻サセテクレト云ッテモ、マア汚イトカ、コンナ所ニ触ルモノデハアリマセントカ云ッテ、ナカナカ願イヲ聴イテクレナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたのカミさんがいうには、自分は犬のナントカ連盟の総裁様だとよ。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもなかに「ヨロクはナミントカンでしまって（儲けはみんな使ってしまって）ヒンはヤリもカマラン（銭は一文もない）」などとぼやいているのもいた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
