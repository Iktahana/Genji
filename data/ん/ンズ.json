    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第八章　感情の意味と知性の意味　自然主義の写実論は、世界をその存在のままに於て、少しも主観に於ける選択をせず、物理的レンズの忠実さで書けと言った。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで堀口君の訳した詩は、ヱルレーヌでも、シモンズでも、コクトオでも、すべてみな堀口君自身の詩であつて、どれを読んでも、一つの同じ堀口的スタイル、一つの同じ堀口的抒情詩の変化に過ぎない。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その眼は澄みきつて、レンズのやうで、むしろ生き物のものといふよりは器物のやうであつた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所が火事であるための驚きと、心の感動と、言換れば偶然と必然とを、混同しない程度に比例して芸術非芸術があるとはシモンズの謂ふ所だ。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼をレンズにでも収めるように、一瞬にしてとり入れた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "全速力の汽車が向う向いて走り去るように、彼はズンズン細くなった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長もチーフメートもだれもがブリッジの左舷へ集まって、望遠鏡のレンズを向けた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでおれは隠れてて船の様子を見ることにするよ」　彼はこういってズンズン歩いて行った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで死ぬときに、「この金をもって二つの孤児院を建てろ、一つはおれを育ててくれたところのニューオルリーンズに建て、一つはおれの住んだところのフィラデルフィアに建てろ」と申しました。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後おもちゃ屋で虫めがねのレンズを買って来て、正式の幻燈器械を作ろうとしたが失敗した。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考えてみると光学上の初歩の知識さえ皆無であり、それに使ったレンズがきわめて粗悪なものであるのみならず、焦点距離が長いのに、原画をあまり近く置きすぎたために鮮明な映像を得られなかったのは当然である。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは多分複眼の多数のレンズの作用で丁度｜光り苔の場合と同じような反射をするせいと思われる。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが丁度レンズの焦点を合せるように、だんだんにはっきりして来るのであった。",
              "citation": {
                "source": "議会の印象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去のある瞬間に世界のうちのある場所で起った出来事を映写器械のレンズで見た、その影像の写しをそのままに吾々の眼を通して直接に吾々の頭の中へ写し出すのである。",
              "citation": {
                "source": "教育映画について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "後者に属する発光器にはこれに附属したレンズや反射鏡のごときものを備えた極めて精巧なものもあるという話で、また発光器の中には体の内腔にあって透明な肉を通して光を放つものもあるそうである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カバレット・トアズンドルの舞台では、ターバンを巻いた印度人が、細腰のヒンズー女を抱いて、宗教的な怪奇な踊りを舞っていました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダの声音は印度の夜の国境、ヒンズークシ山脈の下をアフガニスタンに向って疾走する急行列車にもまして叡智がひらめくのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その記者が、レンズを覗きながら、またそう叫び、少年のひとりは、私の顔を見て、「顔を見合せると、つい笑ってしまうものだなあ。",
              "citation": {
                "source": "美男子と煙草",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑ひをこらへて、レンズをのぞけば、罌粟の花、いよいよ澄まして、固くなつてゐる。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうにも狙ひがつけにくく、私は、ふたりの姿をレンズから追放して、ただ富士山だけを、レンズ一ぱいにキャッチして、富士山、さやうなら、お世話になりました。",
              "citation": {
                "source": "富嶽百景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は、函詰、百八十盒でトンズル一文半（日本の金で約九厘）を取った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "軸列一台（木枠三十枚）トンズル二文半、外し一車につき、一文、小箱貼り、軸木運び、庭掃は一カ月二円か三円だった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この模型をごらんなさい」　先生は中にたくさん光る砂のつぶのはいった大きな両面の凸レンズを指しました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みなさんは夜にこのまん中に立ってこのレンズの中を見まわすとしてごらんなさい。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちの方はレンズが薄いのでわずかの光る粒すなわち星しか見えないでしょう。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんならこのレンズの大きさがどれくらいあるか、またその中のさまざまの星についてはもう時間ですから、この次の理科の時間にお話します。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄いろのがだんだん向こうへまわって行って、青い小さいのがこっちへ進んで来、まもなく二つのはじは、重なり合って、きれいな緑いろの両面凸レンズのかたちをつくり、それもだんだん、まん中がふくらみだして、とうとう青いのは、すっかりトパーズの正面に来ましたので、緑の中心と黄いろな明るい環とができました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまただんだん横へ外れて、前のレンズの形を逆にくり返し、とうとうすっとはなれて、サファイアは向こうへめぐり、黄いろのはこっちへ進み、またちょうどさっきのようなふうになりました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
