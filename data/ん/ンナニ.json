        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一日、一日、カク手ガ氾濫シテ来テ、何ヲ書イテモ、ドンナニ行儀ワルク書イテモ、ドンナニ甘ッタレテ書イテモ、ソレガ、ソンナニ悪イ文章デナシ、ヒトトオリ、マトマリ、ドウニカ小説、佳品、トシテノ体ヲ為シテイル様、コレハ危イ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ外ガ見タカッタラ、教場ノ外ヘ出テイナサイ」　窓の外へ立たされて、殊勝らしくじっとうつむいていた顔をひょいとあげると、先生は背中を向けて黒板に字を書いていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナント　イフ　キレイナ　コヱデセウ」「アンナニ　ヨイ　コヱデ　ウタフ　コトノ　デキルノハ　タレデセウ」ト　ナタネノ　ツボミタチハ　ウツトリシテ　ササヤキアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナニ　ヤサシイ　モノガ　花タチノ　オソロシク　オモツタ　ウマダツタノデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　アンナニ　マドガ　タカクテ、ドウシテ　ナカヲ　ノゾク　コトガ　デキマセウ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア　カンザシヲ　オカヘシシマス」　ヲンナノ　コハ　ドンナニ　ヨロコンダ　コトデセウ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　作者が一度読んだものを有意識にも、無意識にも真似たものは、ドンナニ口ざわりがよくても味が落ちるから直ぐにわかる。",
              "citation": {
                "source": "探偵小説漫想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの眼もソンナニ光ッタラ面白イケレド。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイヌ村山籌子マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アヒルノオマワリサンガカウイツテクレタノデ、玉ネギサント、ジヤガイモサンハ、ドンナニウレシカツタデセウ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間ノナカデモ、ソンナニ、利口ナ子供ハ、アマリイマセンヨ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ高イ所ニイラツシヤラナイデ、コノ涼シイ草ノ葉ノカゲヘイラツシヤイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハドンナニウレシカツタデセウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オバアサンハヨイネコデスカラ、ケツシテコドモガドンナニヤカマシクシテモ、ドナリツケタリハイタシマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人参サンハ　ジヤガイモサンニダマツテ、一人デ玉ネギサンヲ　オクツテユカウト思ヒマシタケレド、ソレデハ、ドンナニ玉ネギサンガカナシガルデセウ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンナニウツツタデセウ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲガドンナニ　オホキクナツテモ　キミハ　ヤツパリ　コイヌ　ナンダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムハ　ミンナニ　アヤマリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅イ動脈ダツテアンナニ皮膚ニ埋レテイルト……見ヨ！",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
