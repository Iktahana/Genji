        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "誰も知る人はないが、このきゃしゃな神殿は、私が嬉しくも愛した一人のコリントの乙女の数学的形像だ。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "エロ・百パーセントも「色気たっぷり」では近代色を欠いている。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "映画アーベントなどという広告をよく新聞に見る。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーベントという言葉を用いたのは明治の終りか大正の初めころ、帝大の山上御殿ではじめて開かれた哲学会のカント・アーベントあたりが最初であったろうと思う。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "カント・アーベントには相当に意味があるが、映画アーベントに至っては笑止の極みである。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙な桜の　アラ　ナントネ粋をきかした　縁むすびスッチョイコラ　スッチョイコラ　私の耳の奧にはまだ歌が響いていた。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東育ちでカントの『純粋理性批判』の訳者である天野君はアナゴは知っていたがアマゴを知らなかったのである。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがさうした毒物の麻醉を借りずに、もつと自然的な仕方によつて、夢を自由にコントロールすることができるならば、人生はずつと幸福なものに變るであらう。",
              "citation": {
                "source": "夢",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覺醒時に於ては、既に半ば意識が働き、夢を夢と意識することから、人は或る程度まで、夢を自分の意志によつて、自由にコントロールすることができるのである。",
              "citation": {
                "source": "夢",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかに人の言ふ如く、カントの哲学も難解である。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カントは頭痛の種である。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カントに宿題は残らない。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニイチェの思想の中には、カント流の「判然明白」が全く無い。",
              "citation": {
                "source": "ニイチェに就いての雑感",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元來、我等のすべての言葉は――單語であると綴り語であるとを問はず――各個に皆特種な音調とアクセントとを持つて居る。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切を憎惡し、粉碎し、叛逆し、嘲笑し、斬奸し、敵愾する、この一個の黒い影をマントにつつんで、ひとり寂しく陸橋を渡つて行く。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれなる平野の大軍は英將ウエリントンの一隊。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすが千古の英雄ナポレオン一世も、この戰ひの敗軍によりまして、遠くセントヘレナの孤島に幽囚の身となりました。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝頃になつて、私は町のレストラントに坐つて居た。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが我我の側の地球に於ては、それが逆に韻律され、アクセントの強い言葉で、もつと惱み深く言ひ換へられる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デカルトはこれを思惟の實體と言ひ、カントは認識の主辭だと言ひ、ベルグソンは記憶の純粹持續だと言ひ、シヨペンハウエルと佛教とは、意志の錯覺によつて生ずるところの、無明と煩惱の因縁だと言ふ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟲　　散文詩といふよりは、むしろコントといふ如き文學種目に入るものだらう。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私のこのコントは、かうした詩人たちの創作に於ける苦心を、心理學的に解剖したものとも見られるだらう。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
