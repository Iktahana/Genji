          "literary": [
            {
              "text": "錬郷死ニ非風死ニ皆僕ヨリ先ニ死ンデシマッタ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ、カイダンヲオチテ、ウチドコロガワルクテ、君チャンガネコンデシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト二人デ旅ヲスル楽シミガ消シ飛ンデシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ彼女ハ、遠カラズ予ガ死ンデシマッタ後モ、「アノ馬鹿ナ老人ハ私ノコノ美シイ足ノ下ニ眠ッテイル、私ハアノ可哀想ナ老人ノ骨ヲ今モナオ地下デ蹈ミツケテイル」ト思ウコトヲ禁ジ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
