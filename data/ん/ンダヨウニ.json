          "literary": [
            {
              "text": "私ガ主人ヲ抱キ起シタ時、主人ハサキ申シタ通リ殆ド死ンダヨウニナッテ居リマシタガ、私ガ旦那様旦那様トクリ返シマスト、カスカニ目ヲアキマシタガ、不意ニ思イガケナイ位大キナ声デ、「大寺……大寺ダ」ト申サレマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人ノ言葉ヲキクト今マデ死ンダヨウニナッテ居タ奥様ガ何カ云イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテチョウド糠味噌ノ中ヘ突ッ込ンダヨウニ手ガツメタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
