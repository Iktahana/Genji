        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タカ　ハ、ヤマキチ　ヲ　ソコ　ヘ　オロシ、シバラク　ソラ　ヲ　トンデカラ、マタ　ヨウス　ヲ　ミニクル　ヤクソク　ヲ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『記者様――私ハ、アナタノ新聞ノ記事ヲ読ンデカラ眼ガ醒メマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ヲ生ンデカラ後次第ニ愛情ガ冷メタノカ知ラン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ入浴ノ助手ハ、婆サンハ転ンデカラ以後勤メナイノデ、颯子カ女中ガ勤メルノデアルガ、佐々木ノヨウニ上手ニ親切ニハ助ケテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ最後ニバスローブヲ着セテクレテ、予ヲ寝室ヘ押シ込ンデカラ、自分ハ廊下ヘ出テ行ッテシマウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛞蝓ニ舐メラレタミタイデ、一日気持ガ悪カッタワ」「相手ガ春久ダッタラドウカナ」グット、声ヲ呑ンデカラ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ヲ生ンデカラ特ニ際立ッテソウナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデカラ後ドンナ形ノ石ノ下ニ葬ムラレヨウト差支エナイヨウナモノダガ、予ハ矢張気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ拓本ニモトヅイテ彼女ノ足ノ佛足石ヲ作ルノデアルコト、予ガ死ンデカラ骨ヲソノ石ノ下ニ埋メテ貰ウノデアルコト、ヲ知ッタ時ニモ、彼女ハ格別ノ意見ヲ述ベハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
