        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "落飾　暑き二箇月の間は、館の人々チヲリに遊び給ひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "小尼公の侍女と共に驢に騎りてチヲリの谷間に遊び給ふときは、我はこれに隨ひ行くことを許されたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒漠たるカムパニアの野の盡くるところに、聖彼得寺の塔の湧出したる、橄欖の林、葡萄の圃の緑いろ濃く山腹を覆ひたる、瀑布幾條か漲り墮つる巖の上にチヲリの人家の簇りたるなど、皆かつがつ我筆に上りしなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどチヲリの避暑、御館にかへりて後の心の憂などは、我を妨げてカムパニアに來させざりしなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "今宵はとおもはれし日の午過ぎて、われは羅馬の御館に參りしに、檀那はチヲリに往き給ひし後なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故に我はチヲリに往くに先だちて、一たび媼の許には來ざりしぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷の如き響は我胸を鼓盪して、我失望我苦心と相應じ、我をして前に小尼公の爲めにチヲリの瀧の前に立ちて、即興の詩を吟ぜし時の情を憶ひ起さしむ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで妙に氣が頽れて些とも氣が引ツ立たぬ處へ寂とした家の裡から、ギコ／＼、バイヲリンを引ツ擦る響が起る。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "返事は無くツて、バイヲリンの音がバツタリ止む。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ上手でもないバイヲリンをギコ／＼彈られるんだから耐らんね。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に俺が思索に耽ツてゐる時にバイヲリンを彈いたりなんかして………」「それは濟みませんでしたのね。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私は貴方に無理にお願をしてバイヲリンの稽古までして、家庭を賑にしやうと心掛けてゐるやうな譯ぢやございませんか。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「其のバイヲリンがまた俺の耳觸になるんだ。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケキヨケキヨケキヨ、ヨ、　ケキヨケキヨ、ヨ」　ミンナハ　アタタカク　ナツテ　クルト　ハヲリヲ　ヌイデ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　花ハ　サイテ　ヲリマセン。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ツボミガ　タクサン　ツイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "花タチハ　キイタ　コトノ　アル　コヱダト　オモツテ　ミルト、ウマヤノ　マドニ　大キナ　ヤサシイ　ウマノ　カホガ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
