          "literary": [
            {
              "text": "』『エノシマヲフタリッキリサンポスルノイヤ？",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「顔色ハ白黒ヲ問ハズ眼中涼シクシテ、憂色ヲフクミ左頬ニヱクボアリ、アゴヤヤ長シ」　隠徳の相として挙げられているのは、三項ある。",
              "citation": {
                "source": "奉行と人相学",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度工場外ニ足ヲフミ出シテ見レバ分ル通リ、当工場ハマサニ「Ｙノフォード」タル名ニ恥シクナイ充分ノ待遇ヲ、ソノ時間ノ点カラ云ッテモ、ソノ賃銀ノ上カラ云ッテモ、皆サンニ与エテ居ルノデアリマスカラ、コノ際決シテ、カヽル宣伝ニ附和雷同セザル様、呉々モ申述ベテ置ク次第デアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムネイタイノ、ト君チャンガキクト、イヤト頭ヲフルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナッテ、又ムネイタイノ、トキクト、ダマッテ目ヲツブッテ、ソレカラムネナンテ何ンデモナイ、ト云ッテ、君チャンノカオヲ見、何ンベンモソットナミダヲフイテルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノママ足ヲフミハズシテ、ヒドイ音ヲタテナガラ、マヨナカノ高イカイダンヲコロゲオチテシマッタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「尋ぬる夫の容形、姿は詞に語るとも、心は筆も及びなき、ぼんじやりとしてきつとして、花橘の袖の香に」以下の一節｜等は、いかにもヲフヱリヤが狂ひに狂ひし歌に比べて多く愧ず。",
              "citation": {
                "source": "「歌念仏」を読みて",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハムレット」の著者は明らかに人々をしてハムレットの恋愛に狂へる者なることを言はしめ、其ヲフヱリヤとの問答に就きて之を確かめんとはせしめたり。",
              "citation": {
                "source": "「歌念仏」を読みて",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "之以上グズグズイウナラ私今清三ヲ起シテ来マスヨサア放シテ頂戴」　トイッテ、私ヲフリ切ッテ二階ニ上ッテ行ッテ了イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ガ痛ミノ為ニ息ヲフキ返シタ時、私ハ叫バレテハイケヌト思イ膝デソノ顔ヲ押エツケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清三ハ息ヲフキ返シテ起キアガロウトシテ居マシタカラ、私ハ之モ膝ノ下ニ組ミ敷イテ胸ノアタリヲ一突キニ刺シタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランランタル目、ソノ長イ体ハ、波ノウエヲクネクネト四百メートルモ彎曲シ、アレヨアレヨトオドロクウチ、口ヨリ火ヲフキ、鉄丸ヲトバシ、ワガ船ハクダカレ、全員ハ傷ツキ七分デ沈没シタ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大海魔アラワレ――アレヨアレヨトオドロクウチ、口ヨリ火ヲフキ、鉄丸ヲトバシ、ワガ船ハクダカレ、全員ハ傷ツキ七分デ沈没シタ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼガ　ホヲフクラシテ、フネハ　ナミヲ　　　タテテハシリマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其許好友の　　　　ポートマン　尚々　私え御出状之節宛名左之通ア・エル・セ・ポートマン・エスクエ、ネウヨルク・ユナイテツト・ステーツ・ヲフ・ヱメルケ・ヘルヲーフルレントメールフエ・マルセールス。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカナル父親モ、自分ノ娘ヲファナチックニ愛スル奴ハイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
