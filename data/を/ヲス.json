        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』『セイユウカイハツイニカイサンカイヒウンドウヲステテカンブカイハ、ウンヌン。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ルヤ、君、断食ノ苦シキトキニハ、カノ偽善者ノ如ク悲シキ面容ヲスナ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "移転先は病院へも秘密にし、そして「俺ハ考ヘル所ガアツテ好キ勝手ナ生活ヲスル。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ニ私兵ヲ養ヒテ私利私欲ノ爲ニ攻伐シツツアル現代支那ガ政治的ニ統一セル者ト云フ能ハザル如ク、鐵道電信ノ如キ明白ナル社會的機關ヲスラ私人ノ私有タラシメテ甘ンズル米國ハ金權督軍ノ内亂時代ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスヂ其他（２）アゲハ……クロ（５）キ（３）カラス（７）ジヤコウ（６）アヲスヂ（３）△鞘翅。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸藩支配ノ地コトゴトク之ヲ朝廷ニ収メ、奥羽寒冷ノ地ノ民ヲ移シテ、空隙ノ地ニミタスベシ、今、朝廷数十万が財ヲステ、開拓ノ資ニ供スルモ、得ルトコロ失フトコロヲ償ハズ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ、道子ヲ殺シタ後清三ガオキタラ、罪ヲスッカリ自白シテ自殺シヨウト思ッテ居タノデスガ、然シ清三ノ態度如何ニ依ッテハ之ヲ殺スツモリデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ッテモ、オ勝ハモウスグオ産ヲスル。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ産ヲスルマデハ、イクラ物好キナ彼奴トテモ手ヲ出ス様ナコトガアルマイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ復讐ヲスルンダ。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを解読してみると、『八日夜、試運転ヲスル』となる。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダソウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、あのモルスカヤだの、ゴロホワヤだの、それから僕の覚え違へでないなら、あのヲスネツセンスキイ区にもあるが、好く大きな店の窓に飾つてあるゴム細工があるね。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "■今は其の地にゐるかどうか知りませんが、以前浦塩お徳といつて、洗濯屋か何かをして、ウラジヲストツクで成功した婦人があります、此の人がやはり福岡県の人なのです。",
              "citation": {
                "source": "福岡の女",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "比較的不遇ナ地位ニアルモノデモ、公然ト不平ヲ云ハヌノミナラズ、戦争ノ話ヲスルト忽チ膝ヲ乗リ出スノデアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤキユウヲスルノニ、ダマツテデキナイナンテ、ナンテ、バカナ小僧タチダ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤキユウヲスルノニ、コエヲダサナイデスルトイフワケニハユカンモンデスカネ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「延喜式」には賀茂斎院の忌詞とし、死をナホル　　病をナヲス　　泣くを塩垂る　　血を汗　　宍を※　　打つを撫づ　　墓を壌と言わしめることを規定してある。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなじくカイローの博物館に、ゼンヲスレト一世がプタ神を抱いて接吻するところがある。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "墨竹ヲ写真ニ撮ツテ種板ヲスカシテゴラン―骨骼ノ様ダ　頭蓋骨ハ柘榴ノ様デ　イヤ柘榴ノ陰画ガ頭蓋骨様ダ（？",
              "citation": {
                "source": "骨片ニ関スル無題",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "（返信）ツートツートトツーツー（１）ツートツートトツーツー（２）ツートツートトツーツー（３）　白ペンキ塗リノ礫架デ私ガグン／″＼お延ビヲスル。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "視覚のナマエは人と共に永遠に生きるべき数字的である或る一点である、視覚のナマエは運動しないで運動のコヲスを持つばかりである。",
              "citation": {
                "source": "線に関する覚書７",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モアノ若サデアノ大役ヲスルノデアルカラ無理モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ、予ハトテモソンナコトヲスル気ハナカッタガ、外ニコレト云ウ治療法モナイカラ、マアヤッテゴランナサイト杉田氏ハスヽメル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局コルセットハ止メルコトニシ、滑リ台ニ寝テ頸ノ牽引ダケヲスルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ彼女達ニ意地悪ヲスレバスルホド彼女ニ魅セラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーツト掛ケ布団ヲスッカリ取リ替エテ、気味悪ソウニ横ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
