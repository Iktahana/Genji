        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "奉行ヲヤメサセナサイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカヤ　アヲヤ　キイロヤ　ムラサキヤ、イロイロナ　フウセンダマハ　ホホヲ　スリヨセナガラ　カゼノ　フク　ハウヘ　ナビイテ　ヰマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ンヤ學者文士輩ノ口耳ヨリ濫造セラレタル思想ナル者ノ自由ヲヤ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶代ノ少キ客トイエドモ軽ク取リ扱ワズ、況ンヤ多ク恵ム者ニオイテヲヤ。",
              "citation": {
                "source": "一枚絵の女",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無謀ナルコトヲヤメヨ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此文書第十一行より第十五行へ讀續けると「コシネナカニエヤトトノヲヤマ」と云ふがある。",
              "citation": {
                "source": "天津教古文書の批判",
                "author": "狩野亨吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ、ラファエルニオイテヲヤ……未ダカツテ……ジョットーヨリ純正偉大ナル宗教画家ハナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲヤお前のやうな可愛い子を置いてかえ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその先の奥様という詞が、フツと耳にとまりまして、「ヲヤ、私のさきに、誰か居たの」と、思はず下女の貌を見詰めました、この下女は、私よりもズツと以前にこの家に傭はれて参つたので、何もかもよく存じてゐますのですから、今私に問ひかけられ、余儀なくこう答へました。",
              "citation": {
                "source": "こわれ指環",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲヤ桜井さんがいらしつたとへ、まアどうしやう嬉しいネー、私がお出迎へ申して来るから、お前は少しここを片付けて、そしてお母ア様へさう申し上げて、何かおいしいものをとつて来ておくれと君子は忙しげに出で行きたるが、年頃仲よき友達とて、坐に就く隙ももどかしげに玄関より語らひながら入来りぬ。",
              "citation": {
                "source": "当世二人娘",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "この詞を聞きたる花子ハツと思ひて、面の色も変はりしにぞ轟く胸をやうやく抑へて、ヲヤ甲田さんがあなたの処へいらつしやいますのハアいらつしやいますよたびたびヲヤと花子はしばし無言にて君子の顔を眺めゐしが、いよいよ確かめたくなりてや、詞も自ら急激になり、なぜでしやう、どうしたんでしやうと重ねかけて問ひぬ。",
              "citation": {
                "source": "当世二人娘",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "君子はそれにて始めて会得したらむやうに、ヲヤあなたお加減がお悪いの、道理で今日は、何だか変だと思ひましたよ。",
              "citation": {
                "source": "当世二人娘",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "如才なきお吉は、あるひは半襟の一ツにでも有り付かむかと、忙しき身の立ちかけたる腰を据ゑて、ヲヤヲヤどうも立派です事ネー。",
              "citation": {
                "source": "野路の菊",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル日、アヒルサンガカゼヲヒイテ学校ヲヤスンデヰルト、オネコサンガキテイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッキリ情婦となつてしまへば却つて鞘当てはないのだけれども、相手が処女、清純楚々たるタヲヤメであるとやゝこしくなる。",
              "citation": {
                "source": "決闘",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ヤ高尚ナル學理ニテ論ズル、其關係組織ノ殊ニ極ル者ニ於テヲヤ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ二公ハ学徳兼テ優レルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旗鼓東西壇開キ／詩ヲ以テ命ト為ス況ヤ天才ヲヤ／当年ノ佳話吾能ク記ス／高鳳庭前麦ヲ漂シ来ル〕　わたくしは枕山が溝中に墜ちたという事から更にまたその近視眼であった話を想起した。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔別レニ臨ンデ誰カ能ク黯然タラザランヤ／無情ノ花竹モ亦纏綿タリ／空桑一宿人猶恋フ／況ヤ我ノ淹留スルコト十五年ナルヲヤ〕　枕山は横山湖山その他の詩人と共に星巌を送って板橋駅に到って袂を分った。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤワガ江戸ノ大ナルヤ、文章ノ淵藪ニシテ、牛耳ヲ執リ盟主トナル者騒壇ニ角立スルヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤ二十年ノ久シキヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハンヤソノ師ニオイテヲヤ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "初句は旧訓タヲヤメノ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、「采女は官女の称なるを義を以てタヲヤメに借りたるなり」（美夫君志）という説を全然否定しないのである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "或はヤはヤヲヤのヤと同じく単に頭の数の多いことを意味するものとしても差支ないが、ここでは数の八とするの直截簡明なるに如かない。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "況ンヤ御贔屓ノ訥升ガ見ラレルニ於テヲヤ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
