        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると、翌日の夜、楢雄から速達が来て「俺ハ世間カラキラハレタ人間ダカラ、世間カラキラハレタレプラ療養所デ働ク決心ヲシタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　友田ハソノ頃便所ニ立ッタカモ知レヌト申シテ居ルガ、道子ト話ヲシタ事ハ全クナイト云ッテ居ルガ如何。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクン、イマサラタイヘンナコトヲシタトオモッテモ、モウ　マニアヒマセン。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕モ番ニ行ッタケレドモ今年カラ田植エノ手伝イヲシタノデ腰ガ折レソーニ痛カッタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ冬ノ寒イ日デ、羽左衛門ハ熱ガ四十度近クモアッタニ拘ラズ、ブルブル震エナガラ水入リヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時ニタッタ一遍ダケ奇怪ナ経験ヲシタコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナニナロウト思ッテ、バーレッスンヲ一二年受ケタコトガアルノデ、チョットグライ立ツコトハ立テタンデスガ、サア今デモ立テルカ知ラ」ッテ、ソンナ話ヲシタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレモ去年大改造ヲ施シ、水槽カラ何カラ何マデタイル張リニシ、シャワーノ設備ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」朝寝坊ノ彼女ハ当然マダ寝テイルコトヽ思ッタラ、予ガ身動キヲシタ途端ニ上半身ヲ跳ネ起シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ大失敗ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシシャワーノ時ダッテ、コヽノ戸締マリヲシタコトハナイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「タマノ土曜日曜ニ家ニイルンダカラネ」「ダカラ何ナノヨ」「タマニハユックリ自分ノ家デ女房ト一緒ニ朝寝坊ヲシタイダロウヨ」「不良爺サンデモ時ニハ忰ニ孝行スル気ガアルノネ」「罪亡ボシニネ」「餘計ナオ世話ダワ、浄吉ノ方ジャ有難迷惑ダッテ云ウワ」「ドウダカネ」「イヽワヨ、ソンナ心配ヲシテ下サラナイデモ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ度々コンナツメタサノ経験ヲシタコトガアルガ、ソシテ大体真冬ノ寒中ニソウナルコトガ多イノダガ、必ズシモ冬トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛イ振リヲシタンデハ斯クノ如ク真ニ迫ッタ声ハ出ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "周到ナ用意ヲシタヾケニ、博士ノ落胆ハ甚ダシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「隣ニ佐々木サンガ寝テヽクレヽバ何カアッタッテ安心ジャナイカ、ネエ、颯チャンハコッチデ寝テオクレヨ」「煙草ガ吸エナイノガ困ルワ」「吸ッタライヽサ、イクラデモ吸ッテオクレ」「ソンナコトヲシタラ佐々木サンニ叱ラレチャウワ」「オ咳ガヒドクッテイラッシャイマスカラネ」ト、佐々木ガアトヲ引キ受ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "細長イ真紅ノ色ヲシタホールダーデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ガ短イカラ暗クナラナイウチニ見テシマッテ、奈良ホテルデ夜ノ食事ヲシタヽメテ帰ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、ダカラト云ッテ、二人ノ間ニ不倫ナ関係ガ成リ立ッテイルト云ウ證拠ハナイシ、ソンナコトヲ信ジル者ハ一人モイナイヨト、ソウ云ウト、本当ニ一人モイナイデショウカ、ト、五子ハ妙ナ笑イ方ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ睡ル真似ヲスルノニ都合ガヨカロウト思ッテ飲マシテヤッタノデアル）　彼女ガ睡リ込ンダ（モシクハ睡リ込ンダ風ヲシタ）ノヲ見定メテカラ、僕ハ最後ノ目的ヲ果タス行動ヲ開始シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜ハ僕ハ、妻ニ妨ゲラレルヲ行ウニハ、僕ノ胸、腕、頬、頸、脚ナドヲ手デ探ルヨウナ動作ヲシタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………木村ガ今日妻ガ台所ヘ立ッテ行ッタ留守ニ妙ナ話ヲシタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコレヲ破壊スルヨウニ命ジ、私ハ命ゼラレタ通リノコトヲシタ」「その通りだ」あなたの意識は思念を送った。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
