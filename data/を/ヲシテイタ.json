        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノチラリト見タヾケダッタガ、変ニ冷イ無愛想ナ顔ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ノ中ニ出テ来タ母ハ、予ノ記憶ニアル最モ美シイ最モ若イ時ノ姿ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母モ美シイ足ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イモ寄ラヌ秘密ヲ不意ニ彼女ニ発カレタヽメカ、自分デモ疾ウカラ内々ハ気ヅイテイテ、強イテ気ヅカヌ振リヲシテイタノニ、コノ古狸ニ突如素ッ破抜カレタヽメカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハイクラカ青イ顔ヲシテイタガ、酔ッタ様子ハ見エナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼女ノ性質カラ推シテ、果シテホントウニ睡ッテイタノカ寝タフリヲシテイタノカ、ソノ点ハ疑ワシイ」と夫が書いているあの二日間、私は決して「寝タフリヲシテイタ」のではないが、そうかといって完全に意識を失いつづけていたとは云いがたい。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
