          "literary": [
            {
              "text": "モシ、君ガ充分ノ親切心ト忍耐力トヲ保有シテイルナラバ、君ノ今日ノ用事ヲコノ紙片ニ書キシタタメテ欲シイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国主義ハ、真先ニ掠奪スルタメニ有利ナル戦略的状勢ヲ利用シテ、諸君ヲコノ地ヘ来ラシメタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ボクハ　コノ地上デ受ケタ魂ノ疵ヲコノ地上デ医ヤシタイノダ　アマストコロアト　七千日……〉　旅先で新しい愛人を得て、東京へはもう戻らないと宣言した友からの手紙だつたが、異常な悲壮が揺れうごいてゐた。",
              "citation": {
                "source": "火の踵",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ヲコノ部屋デ見ルノハ久シ振デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来レバ颯子ノ容貌姿体ヲコノヨウナ菩薩像ニ刻マセテ密カニ観音カ勢至ニ擬シ、ソレヲ予ノ墓石ニスル訳ニハ行カナイモノカト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ石ヲ蹈ミ着ケテ、「アタシハ今アノ老耄レ爺ノ骨ヲコノ地面ノ下デ蹈ンデイル」ト感ジル時、予ノ魂モ何処カシラニ生キテイテ、彼女ノ全身ノ重ミヲ感ジ、痛サヲ感ジ、足ノ裏ノ肌理ノツル／＼シタ滑ラカサヲ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吏事君、怪シムヲ休メヨ山城、門ヲ閉ズルヲ好ムヲコノ山、長物ナシ唯、野ニ清鶯アルノミ「貼っておきましょうか」　文八が伺うと、いいとも、いけないともいわず、老公はまた、窓から見える彼方の山と対していた。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
