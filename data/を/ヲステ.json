          "literary": [
            {
              "text": "』『セイユウカイハツイニカイサンカイヒウンドウヲステテカンブカイハ、ウンヌン。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸藩支配ノ地コトゴトク之ヲ朝廷ニ収メ、奥羽寒冷ノ地ノ民ヲ移シテ、空隙ノ地ニミタスベシ、今、朝廷数十万が財ヲステ、開拓ノ資ニ供スルモ、得ルトコロ失フトコロヲ償ハズ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ人必ズ七日ノ後、マサニ是ノ如キ快楽ト眷族ヲステ、決定必ズ死ニイタルベシ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、阿難ヨ、カクノ如キ人モシ慾惑ヲステズ、マタ出家セズンバ、必ズ地獄ニ堕セン。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
