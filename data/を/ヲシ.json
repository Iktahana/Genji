        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本人兵士諸君　日本帝国主義ブルジョアジーハ、諸君ヲシテ、銃ヲ携エ砲ヲ持チ、急速ニ山東ノ地ニ来ラシメタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、翌日の夜、楢雄から速達が来て「俺ハ世間カラキラハレタ人間ダカラ、世間カラキラハレタレプラ療養所デ働ク決心ヲシタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハ、ウチデ、オトナシク、ルスバンヲシテイレバ、ソレデ、イイノダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンノキノ　シタデ　オカアサンノ　タヌキガ　コドモノ　タヌキニ　バケル　コトヲ　ヲシヘテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "師、維那ヲシテ白槌シテ衆ニ告ゲシム。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔者娘ヲシテ其ノ母ニ背カシメンガ爲メニ來レリト云ヘル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "善キ傾向ニ發達シタル者ハ惡シキ發達ノ者ヲシテ學バシムル所アルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ、國家トシテ不合理ナル所有ニ對シテ賠償ヲナス能ハズ實ニ其資本ヲシテ有史未曾有ノ活用ヲナスベキ當面ノ經綸ヲ有スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産業中株式組織ノ事業ハ其レニ雇傭サルル肉體的精神的勞働者ヲシテ、自ラ其ノ株主タリ得ル權利ヲ設定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ其ノ女ガ他家ニ嫁シテ餘力アル者ト雖モ、其老親ノ扶養ヲ夫ノ資産勞働ニ依頼セシムルコトハ、父母ノ屈從不安ヲ招キ更ニ婦人ヲシテ夫ノ前ニ其ノ人格的尊重ヲ傷クルニ至ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ女子ヲシテ優美纎麗ノママニ發達シタル強健ヲ得セシムルニハ丹田ノ根本ヲ整フル以外一ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ將來益々國民ノ大多數ヲシテ數十萬數萬ノ私有財産ヲ有セシムルコトヲ國策ノ基本トスルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "比等ノ領土内ニ在郷軍人團ナキヲ以テ、國家任命ノ改造執行機關ヲシテ土地資本財産ノ調査徴集ニ當ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐洲諸國ガ數百年以上ニ「ジンキス」汗「オゴタイ」汗等蒙古民族ノ支配ヲ許サザリシ如ク、「アングロサクソン」族ヲシテ地球ニ濶歩セシムル尚幾年カアル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこの一週間ばかり旅行して昨十日夜に帰って来ますと、私の机の上に森下氏のお手紙と新青年の六月増大号と、「アヤカシノゴセイコウヲシュクス○トシ○タミ○フミ○チヨ」という岡山発の電報がほかの手紙とゴッチャになって乗っています。",
              "citation": {
                "source": "所感",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「Let him go ――彼ヲシテ、行カシメヨ、か！",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、君チャンノオ母ッチャハ、ナカナカスグニヘンジヲシナクナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ青イカオヲシテ、ダマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イロイロオセワニナツタコトヲシンシヤス」と書いた。",
              "citation": {
                "source": "海をわたる",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コレカラソノ論証ヲシナケレバナラヌガ、アマリ十分ナ紙幅ガナイカラ箇条書ニシゴク簡単ニ書ク。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋸鑢に驚く金物細工をするに鑢は第一の道具で、是れも手製に作って、その製作には随分苦心して居た所が、その後、年経て私が江戸に来て先ず大に驚いたことがある、と申すは只の鑢は鋼鉄を斯うして斯う遣れば私の手にもヲシ／＼出来るが、鋸鑢ばかりは六かしい。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ各人ノ権利ヲシテ全ク保護ヲ受クル能ハザラシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ争訟紛乱ヲシテ叢起セシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
