        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本ノ国ヲオ守リ下サイ。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子孫ガソノ上ノ慾ヲオコシマス　凜乎たる御口調でございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンジニ、セツプンヲオクル。",
              "citation": {
                "source": "男女同権",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "否々、わが「アムボンポアン」の「カステロ、デ、ロヲオ」の如くならんは、堪へがたかるべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ブロデツトオ」は卵の※を入れたる稀き肉羹汁、「チポレツタ」は葱、「フアジヲロ」は豆、「カステロ、デ、ロヲオ」は卵もて製したる菓子、「アニメルレ、ドオラテ」は犢の臟腑の料理、「フイノツキイ」は香料なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "イロイロナモノガ私ノ心ヲオドラセマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテ、マアロオ、ミルトン、カアライル、バイロン、ヲオヅヲオス、ブラウニング等は家數に大小ありといへども皆叙情詩人なり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴官ガコノ事件ヲ、本気デ調査サレタ事ガワカリマシタラ私ガ貴官ノ御宅ニ出頭シテ、真相ヲオ話シシマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トナレバ右ノ九人ノ人間ガ死ンダ事件ノ裏面ニ潜ム恐ロシイ爆弾売買ノ真相ヲオ話シ出来ルモノハ、私一人シカ居リマセンカラ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマオカマサヨシクンゴフサイガ、シナヘイノギセイトナッタコトヲオクヤミモウシマス、イサイハアトヨリ、ニホンジンクラブ　務の顔色はみるみるかわった。",
              "citation": {
                "source": "白っぽい洋服",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙は簡単に「トニカク、クワシイ事ヲオ話シマショウ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ、カイダンヲオチテ、ウチドコロガワルクテ、君チャンガネコンデシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お腹がすいても職がなくつてもウヲオ！",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝバツトでも吸ひたいウヲオ！",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテ私ヲオ父様ノ所ヘ返サナイト『アグニ』ノ神ガオ婆サンノ命ヲトルト言ツテヤリマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "柏亭氏はこれは殆んどイギリス湖水地方の風景と同じだと云つて、ダアエント・ヲオタアを見物した曾遊の話をした。",
              "citation": {
                "source": "道學先生の旅",
                "author": "戸川秋骨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ私ヲオ父様ノ所ヘ返サナイト『アグニ』ノ神ガオ婆サンノ命ヲトルト言ッテヤリマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "三ミミヅクサン　ハメガネ　ヲオトシマシタ。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "局ノ人ガソレニポンポント消シ印ヲオシマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メヲパチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲオリマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「木皮ニ生ズル処ハ一筋ニシテフトシ、末ニ枝多ク分レ下垂シテフサノ如シ、白色ニシテ微緑ヲオブ、フトキ処ヲシゴケバ皮細カニ砕テ離レズ、内ニ強キ心アル故数珠ノ形ノ如シ、故ニ弘法ノ数珠ノ変化ト云、和州芳野高野山野州日光山殊ニ多シ、長サ三五尺ニシテ至テフトシ、雨中ニハ自ラ切テ落」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシネエチヤンガ足ヲオハナシニナルト、ソツチノミミハマタパタリトタオレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――………ネエチヤンモウサギノミミヲツマンデ、立テテオヤリニナリマシタガ、ネエチヤンガソノミミヲオハナシニナルト、マタパタリトタフレテシマヒマシタ。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トカ出来タラ一夕彼ヲオ座敷ヘ呼ビ、舞台デ見タ通リノ女装ヲサセテ、チョットデモイヽカラ一緒ニ寝テミタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論ソレヲオ爺チャンニ出シテ下サイナンテ云ウンジャナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
