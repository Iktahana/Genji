        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "移転先は病院へも秘密にし、そして「俺ハ考ヘル所ガアツテ好キ勝手ナ生活ヲスル。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ッテモ、オ勝ハモウスグオ産ヲスル。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ産ヲスルマデハ、イクラ物好キナ彼奴トテモ手ヲ出ス様ナコトガアルマイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ復讐ヲスルンダ。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを解読してみると、『八日夜、試運転ヲスル』となる。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダソウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "比較的不遇ナ地位ニアルモノデモ、公然ト不平ヲ云ハヌノミナラズ、戦争ノ話ヲスルト忽チ膝ヲ乗リ出スノデアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤキユウヲスルノニ、ダマツテデキナイナンテ、ナンテ、バカナ小僧タチダ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤキユウヲスルノニ、コエヲダサナイデスルトイフワケニハユカンモンデスカネ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（返信）ツートツートトツーツー（１）ツートツートトツーツー（２）ツートツートトツーツー（３）　白ペンキ塗リノ礫架デ私ガグン／″＼お延ビヲスル。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘弥ノ助六デハ物足リナイガ、訥升ガ揚巻ヲスルト云ウノデ、ソレガドンナニ美シイカト思イ、助六ヨリモ揚巻ノ方ニ惹カレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モアノ若サデアノ大役ヲスルノデアルカラ無理モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ、予ハトテモソンナコトヲスル気ハナカッタガ、外ニコレト云ウ治療法モナイカラ、マアヤッテゴランナサイト杉田氏ハスヽメル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局コルセットハ止メルコトニシ、滑リ台ニ寝テ頸ノ牽引ダケヲスルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴ノ助手ヲスル時、彼女ハブリュウデエッフェル塔ノ模様ノ附イタポロシャツヲ着テ、膝ノトコロマデノトレアドルパンツヲ穿イテイルノガ、素晴ラシクスッキリト意気ニ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ薬ガ利イタト見セカケテ寝タフリヲスル積リダッタガ、ツイ本当ニ寝テシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浄吉ハ今日ハイルノヨ、今夜庭デバーベキューヲスルト云ッテ騒イデルノ」「誰カ来ルノカ」「春久サント甘利サント、辻堂カラモ誰カ来ルラシイワ」陸子ハアレ以来当分来ル筈ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ガ浴室ニイル時、アスコノドーアハマサカ開ケッ放シニハシテ置カナイダロウ、ソノ時ハ戸締マリヲスルデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ浴室ハ予専用ノタイル張リニシテ、シャワーノ設備ヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト二人デ旅ヲスル楽シミガ消シ飛ンデシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝間ハダーク・ブラウンノ鉛筆デ、夜ハ墨ニアイ・シャドウヲ交ゼテ眼張リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トコロデプールヲ作ル費用ハドノクライカヽルンデス」当然コノ質問ガ来ルコトヲ覚悟シテイタノダッタガ、大婆サンモ小婆サンモツイ取リ紛レテコノ大切ナ質問ヲスルコトヲ忘レテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ颯子モイルコトダシ、―――颯子ハ南禅寺ヘ泊ルノハ懲リ／＼ダカラ、ソレダケハ堪忍シテクレト云ッテルンダ」「ドッチニシタッテ颯子ガ行ッタラ又喧嘩デスヨ」「掴ミ合イデモ始メテクレタラ面白イサ」婆サントソンナ遣リ取リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭板橋ノ書ガゴザイマスガ御覧ニナッテ下サイマスカ」「ソレヨリ君、突然妙ナオ願イヲスルヨウダガ、アッタラ売ッテ貰イタイモノガアルンダ」「何デゴザイマス」「紅絹ノ裂ヲ二尺バカリト布団綿ヲ一ト塊、分ケテ戴キタインダガネ」「変ッタ御用ヲ承リマスナ、一体何ニナサルンデ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ睡ル真似ヲスルノニ都合ガヨカロウト思ッテ飲マシテヤッタノデアル）　彼女ガ睡リ込ンダ（モシクハ睡リ込ンダ風ヲシタ）ノヲ見定メテカラ、僕ハ最後ノ目的ヲ果タス行動ヲ開始シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレビデ相撲ノ実写ノ後デ、アナウンサーガ取リ口ノ解説ヲスル時ニ、キメ手ノ状況ガ早クモスチル写真ニ撮ラレテ出テ来ルノハポーラロイドヲ使ッテ写スノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日マデハソレヲ確カメル機会ガナカッタガ、今日彼女ガ映画ヲ見ニ出カケタ間ニ茶ノ間ヲ捜シテ、容易ニ探リアテルニハ、早クモ僕ニ嗅ギツカレルヲスル女デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
