        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "厩戸ノ皇子ノコトヲモツト知リタイ　と口癖のやうにおつしやつて、聖徳太子の御治蹟に就いて記されてある古文籍を、広元入道さまや、問註所の善信入道さまにもお手伝ひさせて、数知れずどつさりお集めになり、異常の御緊張を以てお調べなされて居られたのも、その頃のことでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ホンジツヲモツテキンユシユツハカイキンサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "常ニ君ニ親愛ヲモツ君ノ父ヨリ。",
              "citation": {
                "source": "断唱",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾシ、私ノウチニハ、オ皿トナイフトフオークガ一ツヅヽシカアリマセンカラ、オイデ下サル方ハ、ドウゾ、ゴジブンノオ皿ト、ナイフト、フオークヲモツテイラシツテ下サイ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボクハ　オホキナ　カゲヲモツタ　コイヌダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマニ　モツト　オホキナ　カゲヲモツタ　オホイヌニ　ナルンダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トカイタ大キナハタヲモツテ、小サナ男ノ子ノ手ヲ引イタカイスイヨクジヨウノバン人ガムカフカラ歩イテ来ルノガミエマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ猶｜有縁ノ地タルヲモツテ、吉原回禄ノ災ニ罹ル毎ニ、権ク爰ニ仮肆ヲ設ケテ一時ノ栄ヲ取ルコト也最数回ナリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、危急ノ場合ハ護身術（国民戦闘訓、第三、第四）ヲ用ヒ、大声ヲモツテ救助ヲ求メル。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今昔物語」などには、“合戦ヲモツテ、業トナス――”人種のようには書いてあるが、匪賊のように、それのみが目的ではない。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「南海ノ賊首、藤原純友、船千余艘ヲモツテ、朝貢ノ官船ヲ剽掠シ、海路一切通ゼズ」などという古記がみえる。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
