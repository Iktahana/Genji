        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父から「イサムトナヲツケヨ」と電報が来た。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ、……」（判読不能）僕「空電妨害ニ悩サル。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全身ニ毒草ノヨウナモノヲツケタルモ以下語レ」相手「毒草ノヨウナモノヲツケタルモ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には「コノヘンニ狂犬アリオ氣ヲツケナサイ」と書いた奴までが、すつかり隱れてしまつてゐる。",
              "citation": {
                "source": "CARTE POSTALE",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヘルサン、私ノ足ニ綱ヲツケテ上ヘヒツパリアゲテ下サイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ソコデ、カヘルサンハコホロギサンノ足ニ綱ヲツケテ、木ニノボツテモラヒマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬘ヲツケタマヽ舟底形ノ枕ニ寝、暗イ部屋ノ褥ノ中デ、友禅ノ長襦袢ヲ着テノコトデハアルガ、実ニ異常ナ技巧ヲ持ッテイタモノデ、マコトニ不思議ナ経験デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪イ習慣ヲツケテシマッタト、颯子ハ後悔シテイヤシナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ詰メテ書キ物ヲナサラナイ方ガヨクハゴザイマセンカ、又痛ミ出スト心配デゴザイマス」予ガ日記ヲツケテイルノヲ見テ佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日以後本日マデ殆ド痛ミ続ケナノデ日記ヲツケル元気モナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出発以来四日間、近頃ニナク活動シ、ソノ間ニ面倒ナ日記ヲツケタリシタノデ、予自身休養ノ必要ガアルニハアッタガ、今日一日ダケ佐々木ニモ暇ヲ与エル約束ガシテアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今後ハ僕ハ、彼女ガコレヲ実際ニ盗ミ読ミシテイルト否トニカカワラズ、シテイルモノト考エテ、間接ニ彼女ニ話シカケル気持デコノ日記ヲツケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ日記ヲツケテイタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ日記ヲツケテイタノダ」と云い、「数日前ニウスウス気ガ付イタ」と云っているけれども、実際はよほど前からハッキリと知っており、かつ内容を盗み読みしていたものと思う。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――寺院、坊舎、商家、民屋マデ空袋ノ底ヲサグルガ如ク、残ラズ捜シ出サレ、五十、七十ト高手小手ニ縄ヲカケ、袖ヨリ袖ヘ縄ヲ通シ、珠数ツナギニ一群レヅツ札ヲツケテ、本陣ヘ引キ参リ、或ハ駅所駅所ニテ、立チ所ニ斬リ、鳶ヤ烏ノ餌食ニマカセラル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "高国寺、吉原、三枚橋、伊豆相模ノ境目ニアル城ナドニモ、何カト訊ネ質シ給ヒ、由井ノ磯浪袖ヌレテ、ココニ興津ノ白浪ヤ、田子ノ浦浜、三保ヶ崎、三保ノ松原｜羽衣ノ名所名所ニ御心ヲツケラレ、江尻ノ南、久能ノ城、御尋ネナサレテ、ソノ日ハ江尻ノ城ニ御泊。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
