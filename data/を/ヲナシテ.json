        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "米人ノ「デモクラシー」トハ社會ハ個人ノ自由意志ニヨル自由契約ニ成ルト云ヒシ當時ノ幼稚極マル時代思想ニヨリテ、各歐洲本國ヨリ離脱シタル個々人が村落的結合ヲナシテ國ヲ建テタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃木將軍ガ軍事眼ヨリ見テ許ス可カラザル大錯誤ヲナシテ彼ノ大儀牲ヲ來タセシニ係ラズ、彼ガ旅順包圍軍ヨリ寛過サレシ理由ノ一ハ己レ自ラ兵卒ト同ジキ辨當ヲ食ヒシ平等ノ義務ヲ履行セシガ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ無産階級ガ組織的結合ヲナシテ力ノ解決ヲ準備シ又ハ流血ニ訴ヘテ不正義ナル現状ヲ打破スルコトガ彼等ニ主張セラルルナラバ、國際的無産者タル日本ガ力ノ組織的結合タル陸海軍ヲ充實シ、更ニ戰爭開始ニ訴ヘテ國際的劃定線ノ不正義ヲ匡スコト亦無條件ニ是認セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "――魏宮ノ上、雲ハ憂イニ閉ジ、殿裡ノ香煙、朝ヲ告ゲズ、日モ夜モ祭ヲナシテ、哭ク声タダ大イニ震ウ　とある古書の記述もあながち誇張ではなかったに違いない。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
