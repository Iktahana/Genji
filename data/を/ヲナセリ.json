          "literary": [
            {
              "text": "日本ノ國體ハ三段ノ進化ヲナセルヲ以テ天皇ノ意義又三段ノ進化ヲナセリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "總テ蜘蛛ノ類ニハ此類ノ作用殊ニ著シク、或ハ陷穽ヲ作リ他蟲ノ陷ルカヲ窺ヒ、或ハ壁虎ノ如ク、待伏ノ室ヲ作リ、其近邊ニ徘徊スル他蟲ヲ捕ルガ如キ、種々ノ巧ヲナセリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
