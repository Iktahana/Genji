          "literary": [
            {
              "text": "モロビト山ニ入ラントテ、　　　朝明ヲココニ待チツドヒ、或イハ鋸ノ目ヲツクリ、　　　　アルハタバコヲノミニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ再ビスル必要ハ國家組織ヲ根本的ニ改造スル時獨リ宮中ノ建築ヲノミ傾柱壤壁ノマヽニ委スル能ハザレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ是等ヲノミ視ルモ一利ニ對シテ千百害アルコト阿片輸入ノ支那ヲ思ハシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現行法律ガ買淫婦人ヲノミ罰シテ買淫男子ヲ罰セザルハ姦通罪ガ婦人ヲノミ罰シテ男子ニ及バザルト等シキ片務的横暴ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ノ物程貴クシテ愛ス可キハ無シト雖ドモ、千年モ古ニシテ百年モ亦古ナレバ、只管古キヲノミ喜ブハ、贋物ヲ取ルノ憂無キニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋シ、僧侶ハ祈祷ヲ商ヒ、権力ニ媚ブルコトヲ職トスル階級ニシテ、彼等ノ信仰自由ニ同情ヲ持ツコトヲ知ラズ、コレヲ圧迫スルヲノミ職トスルモノナリケレバナラン。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ミミヅクサン　ハオイケ　ノ　ミヅ　ヲノミマシタ。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋｜駑シ肉緩ミ飽煖ヲノミコレ求ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ニコウイウエキゾチックノ美ガアルガデキナイデ、他人ニ見ツケ出サレタノハ口惜シイケレドモ、夫トイウモノハ見馴レタ妻ノ見馴レタ姿ヲノミ見タガルモノデ、カエッテ他人ヨリモ迂濶ナノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヨソ将タルモノハ、当ニ剛柔ヲ以テ相済ウベク、イタズラニソノ勇ヲノミ恃ムベカラズ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
