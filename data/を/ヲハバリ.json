          "literary": [
            {
              "text": "そこでお斬りになつた劒の名はアメノヲハバリといい、またの名はイツノヲハバリともいいます。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでオモヒガネの神また多くの神たちの申されるには、「天のヤス河の河上の天の石屋においでになるアメノヲハバリの神がよろしいでしよう。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲハバリの神はヤスの河の水を逆樣に塞きあげて道を塞いでおりますから、他の神では行かれますまい。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "特にアメノカクの神を遣してヲハバリの神に尋ねさせなければなりますまい」と申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
