        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "食事が済んでから、おくみはその痛む虫歯へ、婆やに買つて来て貰つたケリヲソートを附けたりして、やうやく坊ちやんを泣寝入りに寝せつけて、一人枕もとに坐つてゐた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ活字ハ、ソノ美シクナイヒラガナヲソノママ活字ニ移シタモノデ、活字ニ必要ナ様式化サエ行ワレテイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ハ二人ガ眠テ居ルラシイ事ヲ室ノ外カラウカガッタ後、障子ヲソット開ケテ中ヘ入リマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十四年｜乙丑ノ歳晩予｜偶『有隣舎ト其学徒』ト題シタル新刊ノ書ヲソノ著者ヨリ恵贈セラレタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "地ヲ遍ツテ松ヲ種ヱ、亭ヲソノ中ニ築キ以テ歌哭ノ地トナス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝永六年（1709）に発行になった貝原益軒の『大和本草』巻之七に蛮種としてこの名の植物が出で「三月下種苗生ジテ後魚汁ヲソヽグベシ此種近年異国ヨリ来ル花ハ山吹ニ似テ単葉アリ千葉アリ九月ニ黄花開ケ冬ニイタル可愛」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………浄吉ハ今デハ颯子ヲソンナニ愛シテハイナイヨウニ見エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ彼女ヲソウサセタノニハ予ニモ責任ガナイコトハナイガ、浄吉ノ奴ハ亭主ノ癖ニ最初カラ彼女ニ一目置クヨウナ素振ヲ見セテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ颯子ノサマ／″＼ナポーズノ容貌ト姿体ノ写真ヲ示シ、菩薩ノ顔ト胴ト四肢トヲソレトナク彼女ノソレラニ似ルヨウニ畫カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガ死ンダラ骨ヲソノ石ノ下ニ埋メテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ拓本ニモトヅイテ彼女ノ足ノ佛足石ヲ作ルノデアルコト、予ガ死ンデカラ骨ヲソノ石ノ下ニ埋メテ貰ウノデアルコト、ヲ知ッタ時ニモ、彼女ハ格別ノ意見ヲ述ベハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
