        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鱗ヲカズイテ生出でた、長八｜尺の鬼が出ようかと、汗を流して聞いている内、月チト暗カリケル処ニテ、仁右衛門が出て行った。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ酔ひの勇気がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ醉ひの勇氣がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカあなたニ絵ヲ見テモライマシテカラ故郷デ貧乏漁夫デアル私ハ、毎日忙シイ仕事ト激シイ労働ニ追ワレテイルノデ、ツイコトシマデ絵ヲカイテミタカッタノデスガ、ツイカケナカッタノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜ハフト思イツイテ特別ニ手紙ヲカク。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ヒノ　デナイ　ウチカラ　ヲトコハ　ハタケノ　マンナカノ　ヲカノ　上ニ　ノボツテ、ラツパヲ　フクノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "和尚、一転語ヲカエテ、ネガワクハ野狐ヲ脱セシメヨト。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ、者裏ニ向ッテ、一隻眼ヲ著得セバ、スナワチ、前百丈（野狐ノコト）風流五百生ヲカチ得タルヲ知リ得ン。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "屡雲上高貴ニ咫尺シ、身ヲ持スルコト謹厳｜恬淡ニシテ、芸道ニ精進シテ米塩ヲカヘリミズ。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タダ、活字ダケヲカタカナニスレバヨイトイウノダ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニワガ針路ヲカエルベキカ、否カ、タダチニ指令ヲタマワリタシ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方赤ちゃんを抱っこして大学の銀杏の木の下のベンチに腰をかけてゐると、何だかペナイサキペナイかヲカチペにいた時の事が思出されます。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出勤ガシタイト兄ヘ云ッタラ、手前ガ手段デ、勤道具、衣服モ出来ルナラ、勝手ニシロ、オレハ、イカイコト手前ニハイリ上ゲタ故、今度ハ構ワヌトイッタ故、ソノ時ハオレガホホノ下ニハレ物ガ出テイテ寝テ居タガ、少シモ苦労ヲカケマイトイウ書附ヲ出シテ、檻ヲ出デ――」　出たな！",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オレハ次第ニ貧乏ニナルシ、仕方ガ無イカラ妙見宮ヘムリノ願ヲカケテ、今一度困窮ノ直ルヨウニト、百日ノ行ヲハジメタガ……」　それ見たことか、敵わぬ時の神頼みだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレカラ思イツイテ、心易イ者ヘ高利ヲカシタガヨカッタ、浅草ノ奥山ノ茶屋ヘ金ヲカシタガ、是ハマダルカッタガ、ソノ代り山中ハハイハイトイイオッタ故親分ノヨウダッケ」　　　　　　　　　七十　さて、これから名うての剣客島田虎之助をからかった物語だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタニハ私ノ洋服ヲカシテカゲマセウ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン　アナタガボンコチヤンヲカブツテヰルカツカウハトテモヘンダワ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン、チツトモオカシクナイカラボンコヲカブリナサイ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ姉サントオ兄サンハ思ハズ、オナカヲカカヘテ笑ヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、ボンコチヤンハ、ボーイサンニ「バウシノオ父サン」ノオ家ヲキイテ、トコロトバンチヲカイテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オヂイサンハ、ソノ箱ニモンコチヤンノオトコロトナマヘヲカイテ、郵便局ニモツテイツテ、切手ヲハリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
