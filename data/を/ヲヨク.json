            {
              "text": "センセイノオシヘヲヨクマモリ、オトモダチト、ワルフザケヤケンカヲセズニ、ゲンキヨクアソベ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前ガ秘密ヲヨク守ルコトヲ信ズル。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "安着の電報に添えてチチウエ、オクスリヲヨクメシアガレとうったら、この頃お母さんや達ちゃんたち、閉口するとそれを護符のようにもち出す由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ顔、アタシニ見セタッテ何デモナイワ、ソレヨリ自分デ自分ノ顔ヲヨク見タコトガオアリニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　新サンモ、ワタシモ、アナタタチ夫婦ノ、昔カラノ事ヲヨク知ツテ居ルノデ、金五郎サンニ、女ナドハ作ラセナイ様、ズイブント骨折ツテ来マシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、その本朝画纂の記載には、「――宮本武蔵範高、小倉ノ人、剣ヲヨクシ、傍ラ絵筆ニ通ズ。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
