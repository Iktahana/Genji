        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出勤ガシタイト兄ヘ云ッタラ、手前ガ手段デ、勤道具、衣服モ出来ルナラ、勝手ニシロ、オレハ、イカイコト手前ニハイリ上ゲタ故、今度ハ構ワヌトイッタ故、ソノ時ハオレガホホノ下ニハレ物ガ出テイテ寝テ居タガ、少シモ苦労ヲカケマイトイウ書附ヲ出シテ、檻ヲ出デ――」　出たな！",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オレハ次第ニ貧乏ニナルシ、仕方ガ無イカラ妙見宮ヘムリノ願ヲカケテ、今一度困窮ノ直ルヨウニト、百日ノ行ヲハジメタガ……」　それ見たことか、敵わぬ時の神頼みだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田、石原、富永、平川、魚住、村瀬、奥屋、鬼頭ナドハ、何レモ特別ニ眼ヲカケタト云フ訳デモナイノニ、士官学校又ハ兵学校ニ入学シテカラモズツト遊ビニ来ルシ、古イトコロデハ退職後マデ機嫌ハドウカトタヅネニ来テクレル有様ダ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ浴槽デ足ヲ伸バシテイテ、急ニ起キ上ロウトシテ浴室ノ縁ニ手ヲカケタラ、手ガ滑ッテ起キラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯カラ上ルト、ウシロカラタオルデ拭キ、ベビーパウダーヲ振リカケ、扇風機ヲカケテクレルガ、決シテ前ヘハ廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云エバ予ハ颯子ニ媚ビル気持カラ、彼女ノ前デ心ニモナクレスリーニ優シイ言葉ヲカケテヤリ、囲イノ外カラ菓子ヲ投ゲテヤッタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ男ナノデアルガ、イタイケナ子供ガ突然現レテ、コンナ優シイ言葉ヲカケラレルト、モウ溜ラナイ、拭イテモ拭イテモ眼鏡ガ濡レテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「看護婦附キデ泊ッタリスルト手数ヲカケルコトニナルカラナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクテ予ハソノ颯子菩薩ノ像ノ下ニ、頭ノ上ニ宝冠ヲ戴イテ胸ニ瓔珞ヲカケ、天衣ヲ風ニヒルガエシタ颯子ノ石像ノ下ニ永久ニ眠ルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ竹翠軒ニ電話ヲカケ、直チニ色紙ヲモウ四十枚届ケサセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ手伝イニ来タツイデニ、「ヨロシュウゴザイマスカ」ト階段ノ途中カラ声ヲカケテ上ッテ来テ書斎ニハイリ、「オ約束ノ品ヲ持ッテ来マシタ」トポーラロイドヲ置イテ行ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ方カラモ電話ヲカケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後三時頃、木村ニ電話ヲカケヨウトシタラ、毎日ノヨウニカケテイル彼ノ学校ノ電話番号ガドウシテモ浮カンデ来ナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウモ御心配ヲカケマシテ」ト木村ガ挨拶シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――寺院、坊舎、商家、民屋マデ空袋ノ底ヲサグルガ如ク、残ラズ捜シ出サレ、五十、七十ト高手小手ニ縄ヲカケ、袖ヨリ袖ヘ縄ヲ通シ、珠数ツナギニ一群レヅツ札ヲツケテ、本陣ヘ引キ参リ、或ハ駅所駅所ニテ、立チ所ニ斬リ、鳶ヤ烏ノ餌食ニマカセラル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
