          "literary": [
            {
              "text": "さつそく店まで出かけて、米を買ひ醤油を買ひ焼酎を買ひ、煙草を買つた、そしてすつかり楽天老人となつた、ノンキナ　ヲヂサン　バンザイ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トオちやん、お医者さん呼びに行くから、その間ヲヂちやんと遊んでるかい？",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一生出て行かぬ独身の労働者、タネヲヂなどと謂った者がそれである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "先代先々代からの種ヲヂもおれば、貰い子も寄子も奉公人もいる。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
