        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "現今ニ於テハ資本制度ノ壓迫ニヨリテ勞働者ハ自由契約ノ名ノ下ニ全然自由ヲ拘束セラレタル賃銀契約ヲナシツツアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻トシテ男子ヲ助クル家政勞働ノ外ニ、母トシテ保姆ノ勞働ヲナシ、小學教師ニ劣ラザル教育的勞働ヲナシツツアル者ハ婦人ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "整然タル休養ヲナシツツ絶エズ習練スルコト最モ須要ナリ。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
