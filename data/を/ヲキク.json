          "literary": [
            {
              "text": "百丈和尚、凡ソ参ズルツイデ一老人アリ、常ニ衆ニシタガッテ法ヲキク。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人ノ言葉ヲキクト今マデ死ンダヨウニナッテ居タ奥様ガ何カ云イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空中二相当爆音ヲキクモ、飛行機ノ種別、台数ハ不明ナリ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
