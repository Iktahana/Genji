          "literary": [
            {
              "text": "気温ハ上昇シツツアリ、タダイマ外部ノ気圧計急ニ上昇ヲハジメ、早クモ五百五……”　五百五というところで、文句は切れていた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "“……タダイマ外部ノ気圧計急ニ上昇ヲハジメ、早クモ五百五……”　五百五というところで、竜造寺兵曹長の無電は切れたのだった。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十一づらを下げて三畳の檻の中で手習ヲハジメたとはこれだけは感心だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オレハ次第ニ貧乏ニナルシ、仕方ガ無イカラ妙見宮ヘムリノ願ヲカケテ、今一度困窮ノ直ルヨウニト、百日ノ行ヲハジメタガ……」　それ見たことか、敵わぬ時の神頼みだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
