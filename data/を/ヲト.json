        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋、ワタルゾト思ウ間モナクトンネルノ、闇ヲトオッテ広野ハラ、どんどん過ぎて、ああ、過ぎて行く。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソハヒマビマニトリテ来シ、　　木ノ芽ノ数ヲトリカハシ、アルイハ百合ノ五｜塊ヲ、　　　　ナガ大母ニ持テトイフ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトシノ七月カラ始メテ画用紙ヲトジテ画帖ヲ作リ、鉛筆デ（モノ）ニ向カッテミマシタ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マヲトコツクル（勇作）の情話も愉快だつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ　ヲトコノ　ヒトハ、ナニカ　ヒトノ　ビツクリスルヤウナ　コトヲ　シテ　エラク　ナリタイト　カンガヘテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ　キイタ　コノ　マヅシイ　ヲトコノ　ヒトハ、「ヨシ、ソレデハ　ジブンモ　センサウノ　アル　トコロヘ　イツテ、リツパナ　テガラヲ　タテ　タイシヨウニ　ナラウ」ト　ヒトリゴトヲ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント　イフ　イサマシイ　オトダラウ」　ヲトコノ　ヒトハ　ムネヲ　オドラセナガラ　アシヲ　ハヤメテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　オ花バタケノ　ソバノ　アル　クサヤネノ　コヤニ　ハイツテ　グツスリ　ネムリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　ラツパヲ　ミルト　花ヲ　オコシテ　ヤル　コトモ　ワスレテ、「アア、コレダ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヲトコハ　ウチヨウテンニ　ナツテ　ヰマシタノデ　ソンナ　コトハ　キニモ　カケナイデ、イサマシク　ラツパヲ　フキナラシナガラ　マタ　アルイテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ、チヨウド　オナカガ　スイテ　キタ　コロ　マタ　ヒトツノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヲトコハ　アル　イヘノ　マドシタニ　タツテ、「オナカガ　スイテ　シヨウガ　アリマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ラツパシユニ　ナツテ　リツパニ　ハタラキマス」ト　ワカイ　ヲトコハ　コタヘテ、トシヨリタチノ　マエデ　イサマシイ　ラツパヲ　フイテ　キカセマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トテ　トテ　トテ　ト　ミナ　ミナ　アツマレ　ケンヲ　モテ、　トテ　トテ　トテ　ト　テツパウ　カツゲ　ハタヲ　モテ、　トテ　トテ　トテ　ト　ソレ　ソレ　イソゲ　センサウヘ、　トテ　トテ　トテ　ト　トテ　トテ　トテ　ト」ト　ヲトコ　ハ　フキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　コノ　ヒトビトガ　キノドクニ　ナリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウダ、コノ　キノドクナ　ヒトビトヲ　タスケテ　ヤラネバ　ナラナイ」　ヲトコハ　アチラ　コチラノ　ムラニ　ノコツテ　ヰル　ヒトビトヲ　ヒトトコロニ　アツメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンキヲ　ダシテ、フミアラサレタ　ハタケヲ　タガヤシ、ムギノ　タネヲ　マキマシヨウ」ト　ヲトコハ　ヒトビトニ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサ　イチバン　ハヤク　オキルノハ　アノ　ヲトコデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ヒノ　デナイ　ウチカラ　ヲトコハ　ハタケノ　マンナカノ　ヲカノ　上ニ　ノボツテ、ラツパヲ　フクノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トテ　トテ　トテ　ト　ミナ　ミナ　オキロ　モウ　アサダ、　トテ　トテ　トテ　ト　クワヲバ　モツテ　ハタニ　デロ、　トテ　トテ　トテ　ト　タネヲバ　マケヨ　ムギノ　タネ　トテ　トテ　トテ　ト　トテ　トテ　トテ　ト」ト　ヲトコハ　フイタノデ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ父ッチャハ、工場デヤスリヲトイデイルウチニ、グルグルマワッテ居ルト石ガカケテトンデキテ、ソレガムネニアタッテ、タオレテ家ヘハコバレテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ此ノママ一息ニ殺シタノデハ気ガスマヌカラ嬲リ殺シニシテヤラナケレバト思イ、彼女ガ気ヲ失ッテ居ルノヲ幸イ、素早ク腰紐ヲトッテ道子ヲ後手ニ縛リ上ゲタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シュジュツゴ、ガーゼヲトッテ、テガミヲミヨ」「手術後、ガーゼを取って、手紙を見よ」この信号は、繰返し発信されたのだった。",
              "citation": {
                "source": "西湖の屍人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランランタル目、ソノ長イ体ハ、波ノウエヲクネクネト四百メートルモ彎曲シ、アレヨアレヨトオドロクウチ、口ヨリ火ヲフキ、鉄丸ヲトバシ、ワガ船ハクダカレ、全員ハ傷ツキ七分デ沈没シタ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
