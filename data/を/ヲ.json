    "definitions": [
      {
        "index": 1,
        "gloss": "indicates direct object of action",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "冬の野原を夏の風が行くに煙が去つた情熱の火が突進するブツカルものもなく――だから不可ない昔からあつたものだのに今新たに起つたものだそれを如何して呉れるい横から眺めてゐるな誰の罪でもない必要ぢやない欲しいだけだ",
              "citation": {
                "source": "情慾",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてヒステリーは現実よりも表現を名称を吟味したがるんだ。",
              "citation": {
                "source": "不可入性",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "だつて君そこに浮気があります浮気は悲しい音楽をヒヨツと忘れさせること度々です空　空　空やつぱり壁は土で造つたものでした。",
              "citation": {
                "source": "不可入性",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖書の綱が性慾のコマを廻す原始人の礼儀は外界物に目も呉れないで目前のものだけを見ることでしただがだが現代文明が筆を生みました筆は外界物です現代人は目前のものに対するにその筆を用ひました発明して出来たものが不可なかつたのですだが好いとも言へますから――僕は筆を折りませうか？",
              "citation": {
                "source": "迷つてゐます",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "御覧なさい天才は彼の自叙伝を急ぎさうなものに恋愛伝の方を先に書きました",
              "citation": {
                "source": "（天才が一度恋をすると）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "煉瓦塀に春を発見した福助人形の影法師孤児の下駄が置き忘れてありました公園の入口ペンキのはげた立札心よ！",
              "citation": {
                "source": "（風船玉の衝突）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人は着物のスソを狂犬病にクヒチギられたが……！",
              "citation": {
                "source": "（風船玉の衝突）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――額をみ給へ――一度は神も客観してやりました――不合理にも存在価値はありませうよだが不合理は僕につらい――こんなに先端に速度のある自棄　々々　々々下駄の歯は僕の重力を何といつて土に訴へます「空は興味だが役に立たないことが淋しい――精神の除外例にも物理現象に変化ない」ガラスを舐めて蠅を気にかけぬ",
              "citation": {
                "source": "（古る摺れた）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は悲劇をみて泣いたことはない悲劇に遭遇したことのある自分を発見したゞけであつた。",
              "citation": {
                "source": "（最も純粋に意地悪い奴）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつぱり形式に於ても経験世界を肯定しなきや万人の芸術品とは言へないのでせうか？",
              "citation": {
                "source": "（最も純粋に意地悪い奴）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "技巧を考慮する男は吃度価値ある内容を持つてゐます。",
              "citation": {
                "source": "（最も純粋に意地悪い奴）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "……対象の知れぬ寂しみ神様はつまらぬものゝみをつくつた盥の底の残り水古いゴムマリ十能が棄てられました雀の声は何といふ生唾液だ！",
              "citation": {
                "source": "（ツツケンドンに）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨はまだ降るだらうかインキ壺をのぞいてニブリ加減をみよう",
              "citation": {
                "source": "（ツツケンドンに）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "街の片側は翳り、片側は日射しをうけて、あつたかいけざやかにもわびしい秋の午前です。",
              "citation": {
                "source": "死別の翌日",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その空をみながら、また街の中をみながら、歩いてゆく私はもはや此の世のことを考へず、さりとて死んでいつたもののことも考へてはゐないのです。",
              "citation": {
                "source": "死別の翌日",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、「大蛇」「惜」の「ヲ」に「意」「於」「淤」「乙」などを使った例はない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かように、オに当る文字と、ヲに当る文字との間には区別があって、互いに通じて用いることがないということを契沖阿闍梨が発見したのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはちょうど契沖阿闍梨が古書における仮名の用法を調査して、昔はア行の「イ」「エ」「オ」と、ワ行の「ヰ」「ヱ」「ヲ」と区別があったということを明らかにしたのと全く同じ手続であります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから平安朝の半過ぎからまた「いろは」の中で「イ」と「ヰ」が同音になり、「エ」と「ヱ」と、「オ」と「ヲ」とも同音になって、四十四だけの音が区別せられるということになります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワ行は、「ヰ」（wi）「ヱ」（we）「ヲ」（wo）の三つだけが今よりも多いのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この音が平安朝において語の中および終において「ワヰウヱヲ」の音に変ったのですが、ワ行の音はｗで初まる音で、ｗは唇を合せて発する音ですが、唇音の「ファフィ」などの音も、やはり唇を合せて発する音で、ハ行音がワ行音にかわったのは、唇の合せ方が緩くなったのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢瀉久孝博士をして「何デー」「何デー」「ナンデイ」「ナンデイ」「ナニヲ云ッテヤガルンデイ」、日の神の「日」という美しい言葉を持ちながら何を苦しんで「デー」などという紅毛の国のダミ言葉を使うのかと憤慨させるのも誠に道理がある。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "老子の所謂「谷神不死」「玄ノ玄、牝ノ牝、コレヲ玄牝ト謂フ」の類。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷露声ナクシテ桂花ヲ湿ス。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジク来ツテ月ヲ翫スル人何処ゾ。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙吉ト新美ノ二人ガ、子供ヲ大事ニ気ヲ附ケマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ夏ハクラゲヲ大変｜恐レマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ成田様ノオ護符ノコトヲ思ウ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔ヲ見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ朝、海デ泳グカラ、皆、夜ノ心配ヲ忘レマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            }
          ]
        }
