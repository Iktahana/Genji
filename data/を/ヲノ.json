        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モロビト山ニ入ラントテ、　　　朝明ヲココニ待チツドヒ、或イハ鋸ノ目ヲツクリ、　　　　アルハタバコヲノミニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青キ朝日ハコノトキニ、　　　　ケブリヲノボリユラメケバ、樹ハサウサウト燃エイデテ、　　カナシキマデニヒカリタツ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ、アノクスリヲノムカラ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ再ビスル必要ハ國家組織ヲ根本的ニ改造スル時獨リ宮中ノ建築ヲノミ傾柱壤壁ノマヽニ委スル能ハザレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "單ニ是等ヲノミ視ルモ一利ニ對シテ千百害アルコト阿片輸入ノ支那ヲ思ハシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現行法律ガ買淫婦人ヲノミ罰シテ買淫男子ヲ罰セザルハ姦通罪ガ婦人ヲノミ罰シテ男子ニ及バザルト等シキ片務的横暴ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、君チャンハヨナカニ目ヲサマスト、ブルブルフルエナガラ、何ンダカオッカナクテ、オ母ッチャトコエモ出セズニ、ソート手ダケヲノバシテヤッテ、ユスルノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソイデ、オ母ッチャノ方ニ手ヲノバシテヤッテ、ヨナカニコエヲ出スノガオッカナイノデ、ハジメダマッテユスッテイタガ、オ母ッチャハナカナカ目ヲサマサナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲノリフ※ック（敬礼語）に富めるも亦た、この族制々度の完熟せるに因れること多し、是れ我国言語の特色にして、この特色は以て我邦に於ける貴族（徳川時代にありては武士をも含む）、平民の区界を判ずるに足るべし。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛筆ニ乏シク、和紙ガ皆無ニチカイ今日ノ我々ノ実生活（趣味生活ハ問題外）ノドコヲ探シテモモハヤヒラガナニ未練ヲノコス理由ヲ発見スルコトガデキナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ワズ右手ヲノバスト手ニ何カ堅イ物ガサワッタノデ夢中デ要之助ノ顔ヲナグリツケマスト彼ハ『アッ』ト云ッテ倒レマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミズガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリッタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボロウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行っただろうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "真夏ノ夜ノ河原ノミヅガ血ニ染メラレテ　ミチアフレ声ノカギリヲチカラノアリツタケヲオ母サン　オカアサン断末魔ノカミツク声ソノ声ガコチラノ堤ヲノボラウトシテムコウノ岸ニ　ニゲウセテユキ　それらの声はどこへ逃げうせて行つただらうか。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ一時間ノチ、左舷前方ニトツゼン大海魔アラワレ、海中ヨリ径一メートルホドノ丸イ頭ヲモタゲ、ミルミル五十メートルホドモ頸ヲノバシタ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ノ物程貴クシテ愛ス可キハ無シト雖ドモ、千年モ古ニシテ百年モ亦古ナレバ、只管古キヲノミ喜ブハ、贋物ヲ取ルノ憂無キニ非ズ。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋シ、僧侶ハ祈祷ヲ商ヒ、権力ニ媚ブルコトヲ職トスル階級ニシテ、彼等ノ信仰自由ニ同情ヲ持ツコトヲ知ラズ、コレヲ圧迫スルヲノミ職トスルモノナリケレバナラン。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ミミヅクサン　ハオイケ　ノ　ミヅ　ヲノミマシタ。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサント人参サンガオドロイテ　ジヤガイモサンヲ汽車カラ引ツパリオロサウトウロタヘテヰルウチニ、ガタン、ゴトント　汽車ハ三人ヲノセタママ　ウゴキ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二ヒキノ　コイヌハ　ダイドコロノ　トノスキマカラ　ナカヲノゾキマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "筋｜駑シ肉緩ミ飽煖ヲノミコレ求ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯｜畢ツテ再ビ茗ヲノ竟リトナス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、浴室ノドーアヲノックシテ、「チョット、コヽ締メルワヨ」ト云ウ声ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本バンタム一位ノ坂本春夫ガタイノバンタム一位ノシリノイ・ルクプラクリスヲノック・アウトシテ初代チャンピオンガ生レタアノ晩デスヨ、―――」ソノシリノイ・ルクプラクリスト云ウ名ヲ陸子ハ流暢ニペラ／＼ト云ッテ退ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ニコウイウエキゾチックノ美ガアルガデキナイデ、他人ニ見ツケ出サレタノハ口惜シイケレドモ、夫トイウモノハ見馴レタ妻ノ見馴レタ姿ヲノミ見タガルモノデ、カエッテ他人ヨリモ迂濶ナノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲノネ　美濃揖斐郡の山間の村で、ヲノネといふのは、「からむし」の根のことである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――二十七日告別式――二十九日香奠帳二册一號ト二號うさぎやニ屆ケル事、菓子ノコトハツキリコトハリ八月七日大草實、小峰八郎來ル芥川サンノ伯母來訪夜伯母サンニツイテうさぎやニ禮ヲノベニユク――十日墓ヲ見ニユク　芥川の家の墓地の檢分のことである。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "またサカタノオホマタの女のクロ姫と結婚してお生みになつた御子は、カムザキの郎女・ウマラタの郎女・シラサカノイクメコの郎女、ヲノの郎女またの名はナガメ姫のお四方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヨソ将タルモノハ、当ニ剛柔ヲ以テ相済ウベク、イタズラニソノ勇ヲノミ恃ムベカラズ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
