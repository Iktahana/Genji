          "literary": [
            {
              "text": "然レドモ昭君ハ三十六宮第一ノ佳人ニシテ、胡児ノ婦ト為リ、琵琶ヲム。",
              "citation": {
                "source": "青塚ノ説",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ　テガツカヘルクセニ　アシデ、ナンキンマメノ　カハヲムイテ、タベルヂヤナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄略天皇のやまとの　をむらのたけに　しゝふすとと歌い給うた御歌は、『古事記』にはみえしぬの　をむろがたけに　しゝふすととありて、勿論今来のヲムレとは別の山であるが、ムラが山の義であるならば、ムレ、ムラ、ムロと通じて用いられた事になる、紀伊の牟婁郡は即ち山の郡の義であろう。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その御歌は、吉野のヲムロが嶽に猪がいると陛下に申し上げたのは誰か。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
