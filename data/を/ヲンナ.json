          "literary": [
            {
              "text": "・暮れて雪あかりの、寝床をたづねてあるく・木の葉が雪をおとせばみそさゞい・雪でもふりだしさうな、唇の赤いこと・春の雪ふるヲンナはまことにうつくしい・春比佐良画がくところの娘さんたち・からたちにふりつもる雪もしづかな家　　　追加一句　みんな洋服で私一人が法衣で雪がふるふる　三月九日　愚郎居。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンザシ新美南吉　ヲンナノ　コガ　イケノ　フチカラ　ミズノ　ナカヲ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ」ト　ヲンナノ　コガ　サケビマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンザシガ　ヲンナノ　コノ　アタマカラ　ヌケテ、イケノ　ナカニ　オチタカラデ　アリマス。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サカナサン、カンザシヲ　ヒロツテ　クダサイ」ト　ヲンナノ　コガ　サカナニ　タノミマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハ　カンザシト　イツテ、アタマニ　サスモノデス」ト　ヲンナノ　コハ　オシヘテ　ヤリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンデ　オヒロヒナサイ」　ヲンナノ　コハ　コマツテ　シマヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナノ　コハ　ナキナガラ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツギノ　ヒ　ヲンナノ　コハ　マタ　イケノ　フチニ　ヤツテ　キマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア　カンザシヲ　オカヘシシマス」　ヲンナノ　コハ　ドンナニ　ヨロコンダ　コトデセウ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢字を五字覚えるよりも、いと楽に覚えられ、そしてこれらの用法は我々の慣用の文章に我々を悩ますものではなく、ただ名詞や形容詞のふだん漢字で書いてゐるのにルビをふるやうな場合にだけ困却するだけの話、「ヲンナ」か「オンナ」か、こんな区別はどうだつていゝ。",
              "citation": {
                "source": "新カナヅカヒの問題",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナは飽きる程笑つても果又笑はなくても笑ふのである。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナの目は北極に邂逅した。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナの目には白夜が現はれた。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナの目は膃肭臍の背なかの様に氷の上に滑り落ちてしまつたのである。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界の寒流を生む風がヲンナの目に吹いた。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナの目は荒れたけれどもヲンナの目は恐ろしい氷山に包まれてゐて波濤を起すことは不可能である。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナは思ひ切つて NU になつた。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナは歌ふつもりで金切声でないた。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナはチヨコレエトで化粧するのである。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナはトランクの中に泥にまみれたヅウヲヅと一緒になき伏す。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナはトランクを持ち運ぶ。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナのトランクは蓄音機である。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナは象の目と頭蓋骨大程の水晶の目とを縦横に繰つて秋波を濫発した。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナは満月を小刻みに刻んで饗宴を張る。",
              "citation": {
                "source": "興行物天使",
                "author": "――或る後日譚として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒼白いヲンナ　顔はヲンナ履歴書である。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナの口は小さいからヲンナは溺死しなければならぬがヲンナは水の様に時々荒れ狂ふことがある。",
              "citation": {
                "source": "狂女の告白",
                "author": "李箱",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
