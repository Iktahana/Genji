        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ワシリと一しよに出て来たヲロヂカは矢張流浪人だが、ワシリと仲の好い友達である。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しわたくしや、友達のヲロヂカが見たところでは、爺いさんが頼み少なく見え出したのですね。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時ヲロヂカがわたくしに言ひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヲロヂカが又かういふのです。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "又少し歩くと、ヲロヂカがわたくしをこづいて、「どうも間違つてゐるね」と云ひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでヲロヂカとマカロフとわたくしとで、同志の者にかう云ひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとうヲロヂカが杖で砂の上へ、舶の形をかいて見せました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、ヲロヂカがふいとかう云ひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　あんまり下らない事を言ふと思つて、わたくしはヲロヂカを叱つて遣りました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲロヂカなんぞは跳ねたり踊つたりしてゐます。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
