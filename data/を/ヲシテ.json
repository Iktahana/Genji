  {
    "uuid": "278c466b-5f41-52c8-89a7-9904bfc6c3a9",
    "entry": "ヲシテ",
    "reading": {
      "primary": "をして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本人兵士諸君　日本帝国主義ブルジョアジーハ、諸君ヲシテ、銃ヲ携エ砲ヲ持チ、急速ニ山東ノ地ニ来ラシメタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエハ、ウチデ、オトナシク、ルスバンヲシテイレバ、ソレデ、イイノダヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "師、維那ヲシテ白槌シテ衆ニ告ゲシム。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔者娘ヲシテ其ノ母ニ背カシメンガ爲メニ來レリト云ヘル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "善キ傾向ニ發達シタル者ハ惡シキ發達ノ者ヲシテ學バシムル所アルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三ノ理由ハ、國家トシテ不合理ナル所有ニ對シテ賠償ヲナス能ハズ實ニ其資本ヲシテ有史未曾有ノ活用ヲナスベキ當面ノ經綸ヲ有スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産業中株式組織ノ事業ハ其レニ雇傭サルル肉體的精神的勞働者ヲシテ、自ラ其ノ株主タリ得ル權利ヲ設定スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ其ノ女ガ他家ニ嫁シテ餘力アル者ト雖モ、其老親ノ扶養ヲ夫ノ資産勞働ニ依頼セシムルコトハ、父母ノ屈從不安ヲ招キ更ニ婦人ヲシテ夫ノ前ニ其ノ人格的尊重ヲ傷クルニ至ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "時ニ女子ヲシテ優美纎麗ノママニ發達シタル強健ヲ得セシムルニハ丹田ノ根本ヲ整フル以外一ノ途ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ將來益々國民ノ大多數ヲシテ數十萬數萬ノ私有財産ヲ有セシムルコトヲ國策ノ基本トスルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "比等ノ領土内ニ在郷軍人團ナキヲ以テ、國家任命ノ改造執行機關ヲシテ土地資本財産ノ調査徴集ニ當ラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐洲諸國ガ數百年以上ニ「ジンキス」汗「オゴタイ」汗等蒙古民族ノ支配ヲ許サザリシ如ク、「アングロサクソン」族ヲシテ地球ニ濶歩セシムル尚幾年カアル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「Let him go ――彼ヲシテ、行カシメヨ、か！",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ青イカオヲシテ、ダマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ各人ノ権利ヲシテ全ク保護ヲ受クル能ハザラシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ争訟紛乱ヲシテ叢起セシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　法典ノ実施ヲ延期スルハ各人ヲシテ安心立命ノ途ヲ失ハシムルモノナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　其ノ日「マージャン」ヲシテ居ル最中、タシカ九時半頃デシタト思イマス、友田ガ便所ニ立ッタノデス、スルト道子ガ続イテ何カ台所ニ用ガアルト見エテ室ヲ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は仕方ナク床ニ戻ッタノデスガ、ドウ考エテモ余リニ無札ナ仕打デハアリ、私が今更ソンナ事ヲイエタワケデハナイノデスガ、道子ガ人妻トシテ余リニヒドイ乱行ヲシテ居ルノヲ見テ、モウ堪エラレヌ、イッソ道子ヲ殺シテ自分モ自殺シヨウト決心シタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
