    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「あき店さ、お前さん、田畝の葦簾張だ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋のたもとの望富閣という葦簾を張りめぐらせる食堂にはいり、ビイルを一本そう言った。",
              "citation": {
                "source": "狂言の神",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小初はぐっと横着な気持になって、化粧の出来上った顔に電球を持ち添えて「これでは、どう」と窓の葦簾張りから覗いている貝原に見せた。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学時代に、夏が来ると南磧に納涼場が開かれて、河原の砂原に葦簾張りの氷店や売店が並び、また蓆囲いの見世物小屋がその間に高くそびえていた。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手品か軽業か足芸のようなものを見て、帰りに葦簾張りの店へはいって氷水を飲むか、あるいは熱い「ぜんざい」を食った。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "店とはいっても葦簾囲いの中に縁台が四つ五つぐらい河原の砂利の上に並べてあるだけで、天井は星の降る夜空である。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根の半は葦簾に枯枝をまじへて葺き、半は又枝さしかはしたる古木をその儘に用ゐたるが、その梢よりは忍冬（カプリフオリウム）の蔓長く垂れて石垣にかゝりたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十一　じりじり暑い西日が、庭木の隙や葦簾を洩れて、西だけしかあいていない陰鬱な彼の書斎の畳に這い拡がるなかにいて、庸三はしばらく葉子と離れて暮らしていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、それと同時に彼の面にも暗い困惑の色が浮んで来て、やがて其処を立つて、そろ／＼葦簾張の外へ出て行つた。",
              "citation": {
                "source": "或売笑婦の話",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では皆さんに申上げますが、之は私の長男です……」階段に下りかかる時、葦簾の襖を隔てた隣室からかう云ふ言葉を聞いた。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半月ばかり見ないうちに、家々は最早冬籠の用意、軒丈ほどの高さに毎年作りつける粗末な葦簾の雪がこひが悉皆出来上つて居た。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "土壁には大根の乾葉、唐辛なぞを懸け、粗末な葦簾の雪がこひもしてあつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "葦簾で囲った休茶屋の横手には、人目をひくような新しい食堂らしい旗も出ている。",
              "citation": {
                "source": "食堂",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "新七はお力に手伝わせて、葦簾がこいにした休茶屋の軒下の位置に、母の食卓を用意した。",
              "citation": {
                "source": "食堂",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは葦簾のかげから公園の通路を隔ててアカシヤの木の見えるようなところで、親子二人ぎりで話すにはよさそうな場所であった。",
              "citation": {
                "source": "食堂",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "處々にある葦簾張りの茶店もとぢたり。",
              "citation": {
                "source": "春の郊外",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなごむりをお願いして、もしや不首尾で……」　と口の中でつぶやいたが、それらしい影も見えないので、またしょんぼりと葦簾のかげへはいった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄三郎は、つと身も世もない歓喜が背筋を走るのを覚えつつ、「ま、はいりましょう――」　と先に立って葦簾張りをくぐるとすぐ、「さ、五十両ある」　大きく笑って、重い財布をそこの腰かけへほうり出した。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "葦簾のかげに緋毛氈敷いた腰かけが並んで、茶碗に土瓶、小暗い隅には磨きあげた薬罐が光り、菓子の塗り箱が二つ三つそこらに出ている――ありきたりの水茶屋のしつらえ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうしろに葦簾をかっさばいた白光に、早くも身を低めた栄三郎が腰掛けを蹴返したとたん、ものをいわずに伸びきった源十郎の狂刀が、ぞッと氷気を呼んで栄三郎の頭上に舞った。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗ってくらっせえよ」　という鼻から抜ける声とともに、間伸びした鈴の音が、立場茶屋の葦簾を通して耳にはいると、江戸者らしい若い小意気な旅人が、ひとり飲みかけた茶碗を置いて振り返った。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "護摩堂から笠神明へかけて、二十軒建ちならぶ江戸名物お福の茶屋、葦簾掛けの一つに、うれし野と染め抜いた小旗が微風にはためいているのが、雑沓の頭越しに見える。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "野天芸人の諸※も、葦簾を掛けたり天幕を張って、その中で芸を売っている。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葦簾も天幕も張ってない。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう終りだね、夏も――」　中野五郎は、顔馴染になった監視員の、葦簾張りのなかに入りながら呟いた。",
              "citation": {
                "source": "地図にない島",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唖然とした中野は、望遠鏡から眼を離すと、二三度眼をぱちぱちさせてその船の方を眺めていたが、そのまま圭さんにもことわらずに、その小高い葦簾張りの監視所を飛出すと砂浜を逸散に駈出していた。",
              "citation": {
                "source": "地図にない島",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "横臥場はサナトリウムのはしにあって、ポプラだの藤だのの下に葦簾を張り、横臥椅子をずらりと並べてあった。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "各舎とも屋外に葦簾その他で休憩所が作られ、しるこ、だんご、ふかし芋等の御馳走が並べられる。",
              "citation": {
                "source": "続重病室日誌",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "掃除を一通り終へると、葦簾張りの中に集まつて、女たちの給仕で、男たちは幸福さうに病変した顔に笑ひを漂はせながらだんごにかぶりつくのである。",
              "citation": {
                "source": "続重病室日誌",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "河原へ突き出された葦簾張りの仮小屋の入口に、下品な男が息んだ銅魔声を絞つて、暑さうに胸をはだけながらぞろ／＼とくり込む群集から、大人五銭、小人二銭の木戸銭をとつてゐた。",
              "citation": {
                "source": "父の帰宅",
                "author": "小寺菊子",
                "note": "青空文庫"
              }
            }
          ]
        }
