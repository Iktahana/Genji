        "examples": {
          "standard": [
            {
              "text": "製鉄所では、高温の溶鉄が炉から流れ出ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "溶鉄を型に流し込み、様々な金属製品が作られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鍛冶職人は、真っ赤に熱した溶鉄をハンマーで叩き、刀を鍛える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "……ああ、もう止そう、おっ母さん、お体に障ります、やめて下さい、やめて下さい』　真雄は、鞴の前へ馳け寄って、どっかと、筵の上に坐ると、金火箸を把って、真っ赤な溶鉄となった玉鋼を、火土の中から引き出した。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その裏には、彼の凄まじい精進が、赫々と溶鉄の炉に燃え、骨を削り血を吐くような苦心と研究が潜んでいた。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "厩と百呎とは離れぬ所に沸器は溶鐵の瓦斯爐と同一の仕掛の特別な構造をもつた竈で加熱されるのである。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
