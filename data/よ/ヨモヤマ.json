        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "可い塩梅な酔心地で、四方山の話をしながら、螽一ツ飛んじゃ来ない。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄く塗った感心に襟脚の太くない、二十歳ばかりの、愛嬌たっぷりの女で、二つ三つは行ける口、四方山の話も機む処から、小宮山も興に入り、思わず三四合を傾けまする。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後三四日大友は滞留していたけれどお正には最早、彼の事に就いては一言も言わず、お給仕ごとに楽しく四方山の話をして、大友は帰京したのである。",
              "citation": {
                "source": "恋を恋する人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の学会で先生が報告するはずだったんだが、今のままじゃまだ貧弱でね」　四方山の話が出た。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にも知らぬ二僧は、すっかり悦んで箸を取りながら主人や女中を相手に四方山の咄の末、法眼が言いました。",
              "citation": {
                "source": "茶屋知らず物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲は駕籠が通り人々は煙草をふかし、茶をのみ乍ら四方山の咄しに耽る普通の現実の世界である。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は先生と對座して四方山の物語をして居ながら、熟々思ひました、世に美はしき生活があるならば、先生の生活の如きは實にそれであると、先生の言論には英雄の意氣の充て居ながら先生の生活は一見平凡極るものでした。",
              "citation": {
                "source": "日の出",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、軽部の同僚の蒲地某という男が突然日本橋五丁目に金助の家を訪れ、無口な金助を相手に四方山の話を喋り散らして帰って行った。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "某日、軽部の同僚と称して、薄地某が宗右衛門町の友恵堂の最中を手土産に出しぬけに金助を訪れ、呆気にとられている金助を相手に四方山の話を喋り散らして帰って行き、金助にはさっぱり要領の得ぬことだった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "とかくして食事終れば、續きてはじまる四方山の御物語。",
              "citation": {
                "source": "十萬石",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――三の輪の知人在宿にて、双方心易く、四方山の話に夜が更けた。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "日暮々々に水そゝげば此草とりつく便あるに任せて蔓をのばし、はや六月の初め、ひと花咲きそめて白きひを洗ひ捨てゝ四方山を見るに、さりとは口惜しや一銭つかはで是ほど面白く風情ありしことを知らず、もたれたる遊びに金銭を費して無益の年月を送りけるよと、今ぞ心のほこりを掃ひける。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬屋を見たり、納屋へ入つて農具の説明を聞いたりしてから、また馬屋へ來て、此頃徴發に行つたが大き過ぎて戻されたといふ馬の鼻面をなでながら、私は一時間ほどもその青年と四方山の話をした。",
              "citation": {
                "source": "東旭川村にて",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日も駿介はそこへ出て行つて、待機の姿勢でゐる二人を相手に四方山の話をした。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで續けてゐたらしい四方山話をすぐにはじめた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "田川夫妻は自然に葉子を会話からのけものにして、二人の間で四方山のうわさ話を取りかわし始めた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして三人でしばらく快活に四方山の話をしていたが、ふと思い出したように葉子を顧みて、「これからまた当分は目が回るほど忙しくなるで、その前にちょっと御相談があるんだが、下に来てくれませんか」　といった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同宿は五人、みんな気軽な人々である、四方山話、私も一杯機嫌でおしやべりをした。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・移つてきてお彼岸花の花ざかり　　　　□・蠅も移つてきてゐる近隣の井本老人来庵、四方山話一時間あまり、ついで神保夫妻来庵、子供を連れて（此家此地の持主）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな籠城して四方山話、誰も一城のいや一畳の主だ、私も一隅に陣取つて読んだり書いたりする。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……散歩して少し労れたところで晩酌をやつたので、だいぶ身心くつろいでゐるところへ、Ｋさん来訪、つゞいてＮさん来訪、四方山話でのんびりした。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転屋の主人Ｊさん、つゞいて酒屋の主人Ｍさんがやつてきて四方山話。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、Ｉさん来庵、四方山話をする。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便局で、思ひがけなく藤津君に邂逅、Ｆ屋で痛飲する、めでたく和解して、昨年来の感情のもつれも解消してしまつた、酔に乗じて、打連れて、雨の中を中村君徃訪、生憎不在、父君母君と持参の酒と肴をひろげて四方山話（親馬鹿、子外道の情合を味ふ、中村君しつかりしたまへ、孝行をしなさいよ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、暮羊君来訪、四方山話。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｆさん来訪、あたりさわりのない四方山話。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の涼台で四方山話、世間はうるさいけれどまたおもしろい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……おちついて死ねさうな草萠ゆる和尚さん来談、とりとめもない四方山話をしたが、予想してゐたよりも、文芸に理解のある新らしい老人だつた。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜はまた散歩、無水居、和蕾居、三人で四方山話。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジイドのことを書けとて与られた紙面ではあるが、そのやうなわけで今はよもやまの話をさせて貰はうと思ふのである。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
