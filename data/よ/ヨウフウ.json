    "definitions": [
      {
        "index": 1,
        "gloss": "Western style",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新築の家は、モダンな洋風のデザインが特徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は和食だけでなく、洋風の料理も得意だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このカフェは、落ち着いた洋風の雰囲気で人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "）住居は度々変ったが、純日本風の家を好んで、少しでも洋風を加味したものを嫌った。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人の知人を訪問しても、洋風の応接間などに通されると、帰ってからも甚だ不機嫌であった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって彼の詩境は、「俳句的」であるよりもむしろ「和歌的」であり、上古奈良朝時代の万葉集や、明治以来の新しい洋風の抒情詩などと、一脈共通するところがあるのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし僕も、最近｜漸く老年に近くなってから、東洋風の枯淡趣味というものが解って来た。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬骨が東洋風に出張っていてそれで西洋人の近東の男。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この着物と素足との関係は、全身を裸にして足だけに靴下または靴を履く西洋風の露骨さと反対の方向を採っている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから足ることを知る節制謙譲が生まれるであろう、と教える東洋風の教えがこの集のところどころに繰返して強調されている。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本語は、西洋風の近代小説に適さないと同じく、西洋風の近代詩には尚ほもつと根本的に適しないのだ。",
              "citation": {
                "source": "悲しき決鬪",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへ外貌はどうあらうとも、性格氣質の底に西洋風なキリスト教や、ギリシャ思潮を傾向した人種でなければ、詩の輸入飜案者たる詩人の役目は勤まらない。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "實際僕等の詩操の中から、西洋風の趣味や情操を除いてしまへば、必然の結果として、俳句や歌が出來てしまふ。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "室生君は今隨筆を盛んに書き、その方でも小説家以上の名人といふ定評を取つてゐるし、僕等が讀んでも非常に面白い文章であるけれども、その隨筆の精神は全く東洋風のものであつて、芭蕉等の俳句とも共通した情趣をもつものである。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうした心境に住む室生君が、西洋風のリリックやエピックなど書くとすれば、それこそ却つて不自然に感じられる。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋風の詩の世界は、もはや君にとつて無用の物になつたのである。",
              "citation": {
                "source": "詩に告別した室生犀星君へ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私の趣味としては、もつと空氣の明るく近代的で、工場や、煙突やが林立し、一方に生産的市場が活動しつつ、一方に赤瓦の洋風家屋などの散見する情趣、即ち大都會の郊外にみる近代的生活の空氣がすきなのだ。",
              "citation": {
                "source": "田端に居た頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或はまた純東洋風の文人として、花鳥風月の趣味に遊ぶ、悟りすました人物のやうにも印象させる。",
              "citation": {
                "source": "室生犀星に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大通の街路の方には、硝子窓のある洋風の家が多かった。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はユーストンの地下鉄の乗換場附近にある玄関に、日章旗を交錯した日本料理店胡月の卓子で、外交官の松岡、画家の山中、トンテム・ハム・コートの伊太利料理店の主人と暗い東洋風の部屋で、日本食の晩餐後お互に深い沈黙に陥っていた。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間幽霊のように扉を排して、一人の日本人の旅人が、この東洋風の祭壇のように怪奇な部屋に這入ると、扉に背をもたせて、彼の眼前に小さくうずくまった花子を凝視した。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ユーロップの頭とアラビア海の心臓と東洋風の肉体、苦もなく私に委せてしまった。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "袋地の奧にある自分の家、出入りの度毎に厭やでも眼に著くのだが、古い日本家を洋風まがひに造りなほした、さう言へば如何にもそれらしい變に陰氣臭い感じの小住宅で、殺された女中の可憐な一田舍娘らしい容姿もぼんやり自分の頭に殘つてゐる。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の家は南洋風で夏向きにできているから日本人は南洋から来たのだという説を立てた西洋人がいた。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは病院と言っても決して立派な建物ではなく、昼になると「妊婦預ります」という看板が屋根の上へ張り出されている粗末な洋風家屋であった。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日向はわずかに低地を距てた、灰色の洋風の木造家屋に駐っていて、その時刻、それはなにか悲しげに、遠い地平へ落ちてゆく入日を眺めているかのように見えた。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の一日は低地を距てた灰色の洋風の木造家屋に、どの日もどの日も消えてゆく冬の日に、もう堪えきることができなくなった。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論西洋のものもそろそろ入って来ては居りましたのですが、リットンものや何ぞが多く輸入されていたような訳で、而して其が漢文訳読体の文になったり、馬琴風の文の皮を被ったりして行われていたのでしたから、余り西洋風のものには接していなかったのであります。",
              "citation": {
                "source": "言語体の文章と浮雲",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "一軒は昔ふうの建築であり他の一軒は近代的洋風の店構えになっているのであるが、ともかくも付近に対して著しく異彩を放つ黒焼き屋であることには昔も変わりはないようである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
