        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "駄馬が、ちゃんちゃんと頸の鈴ならして震えながら、よろめき歩くのに適した町だ。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彷徨いよろめき歩くにも似ず、彼の歩き方は速かった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "血の気を失つたエリザのよろめき歩く姿を、人々は、眼を曇らせながら眺めてゐます。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は、夢中になって、広い料理場の中を酔ったようによろめき歩くのでした。",
              "citation": {
                "source": "キャラコさん",
                "author": "月光曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパもその通り、よろめき歩く死一歩手前の老人の多いのに驚かされた。",
              "citation": {
                "source": "美食多産期の腹構え",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "分別ありげな団長の春木もと侯爵夫人さえ、うろうろと死人のそばをよろめき歩くばかりで、なんの知恵も浮かばぬ様子であった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
