        "examples": {
          "standard": [
            {
              "text": "彼女は横髪をまとめてポニーテールにしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "強い風で横髪が顔に吹きかかってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "美容師は横髪のボリュームを調整するよう提案してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "――仙太郎は四年の間にスッカリ人態が変ってしまい、以前から百姓には不似合いなほどに綺麗だった顔が、引きしまり、横髪に少しのぞいている刀の疵跡。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
