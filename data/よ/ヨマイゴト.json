      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "grumbling",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の世迷言を聞くのはもううんざりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "失敗を世迷言でごまかそうとするのはやめろ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若い頃は、よく世迷言を並べていたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もちろんこれは自分等の年輩のものの自分勝手な見方ではあろうが、こうした見方もあるいは現代の俳人に多少の参考にはなるかもしれないと思ったので思い出話のついでに拙ない世迷言を並べてみた次第である。",
              "citation": {
                "source": "明治三十二年頃",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯰入　やあ、何と、……それを頼みたいばッかりに恥を曝した世迷言じゃ。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉱蔵　世迷言を饒舌るな二才。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「世迷言を言うなよ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の怨み晴れやらぬものと思へと狼の吠ゆるが如く喚めき立つるを、何を世迷言云ふぞ、と冷笑ひつ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう世迷言も申しますまい。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう云ふ反感で物を云つてゐるからあんな長々しい世迷言を五十枚もかく勇氣が出るのだらう。",
              "citation": {
                "source": "よしなし事",
                "author": "〔源内の手紙、原稿料のことなど〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに世にすねたる阿呆は痛く文学者を斥罵すれども是れ中々に識見の狭陋を現示せし世迷言たるに過ぎず。",
              "citation": {
                "source": "為文学者経",
                "author": "三文字屋金平",
                "note": "青空文庫"
              }
            },
            {
              "text": "九郎助　何を世迷言をいいやがる。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚吉　何を世迷言いうだ。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "其他まだ種々聴かされて一々感服したが、此様な事は皆｜愚言だ、世迷言だ。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何を申す、世迷言を――」　その声の下から「御尤もでござります。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際この本に対しては、ロンブローゾの最晩年の著作ではあり、耄碌した世迷言だと見る人が多い。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ現在に活動しただ現在に義務をつくし現在に悲喜憂苦を感ずるのみで、取越苦労や世迷言や愚痴は口の先ばかりでない腹の中にもたくさんなかった。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "霊達の世迷言は全く同情に値する。",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            },
            {
              "text": "彦六　へん、なにを世迷言ぬかしやがるんだ。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑々、赤化防止などということは、資本制社会に於て、この制度から直接に一定の生活利益を受け取っている人間にとっては、全く現実的な真剣な問題なのだが、そうでない人間にとっては全く概念的な余計な思惑なのであって、そういう人間の実際的な生活、経済的政治的要求、から見れば、極めて空疎な世迷言に過ぎまい。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "之は社会の経済機構の本質に根本的に無知な或る一部のセンチメンタリストの世迷言だとばかり私は思っていた。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギルマンが眠りながら喋っているのは明白で、菫色の夢の光などという世迷言が出回ったのも明らかにデロシェールが鍵穴越しに聞いた話が元になっている。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "「馬鹿野郎、吾らはそんな世迷言にかす耳を有たぬぞ、こうなった上は一寸の光陰も軽んずべからずだ、愚図愚図すれば撲ち殺されるぞ、生命が惜しくば早く下れ下れ！",
              "citation": {
                "source": "太陽系統の滅亡",
                "author": "木村小舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロージングは好まざる人に取っては全くの世迷言だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふっふふふ、世迷言もいい加減にしろ、世中にゃ泥棒はいるが、『義』の付く泥棒はいねえ、人様の物を盗んで鼻糞ほどの施しをしたって何が義賊だ、泥棒をするやつぁしたくってするんだ、世間の毒虫、人界の芥屑、外道、畜生と相場あ定ってらあ。",
              "citation": {
                "source": "暗がりの乙松",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたし女王様にでもなった様だわ」　彼女は世迷言を呟きながら、飽かず宝石を弄んでいたが、やがて、ふと気がついた様に、残り二つの棺桶に目を注いだ。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そればかりか、恐らく乾き切ってコチコチになっているであろう舌で、殆ど意味をなさぬ世迷言をつぶやく気勢さえ感じられた。",
              "citation": {
                "source": "お勢登場",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうこの上貴様の世迷言を聞いている暇はない。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この上｜生恥をさらすのは耐らない」　と世迷言をわめき立てた。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、武士の意地にも、追手の船へのりまして、弦之丞めを」「世迷言を申すな」「でなければ」「うるさいッ、お前はお前のすることをしておれ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "有っても無くてもいいよまいごとを書いて、これを文芸呼ばわりをし、前人の糟粕を嘗めては小遣どりをし、小さく固まってはお山の大将を守り立てて、その下で小細工をやる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは死にたい、死にたい、死にたい」　こんなよまいごとを、直接聞いたわけじゃありません。",
              "citation": {
                "source": "妻に失恋した男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
