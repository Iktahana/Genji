[
  {
    "uuid": "193d6eed-74ca-5b0f-a8b9-80b1bd097054",
    "entry": "世迷言",
    "reading": {
      "primary": "よまいごと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
