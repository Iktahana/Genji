  {
    "uuid": "926d0ffa-dfc7-5cad-a4e5-2878dbdddcae",
    "entry": "ヨイチ",
    "reading": {
      "primary": "よいち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "改良事項は今以てチヨイチヨイ持出されたが、その実績を見ることは忘れてゐた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしもこれからはチヨイチヨイ来て――あなたお書きなさいな、あたしこゝで静かにあたつてゐるわ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠自身も常に其※話をする事を避けて居たが、それでもチヨイチヨイ口に出るもので、四年前の渠が知つてなかつた筈の土地の事が、何かの機会に話頭に上る。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何んぢや　此の野郎　柳の毛虫　払ひ落せば　またたかる、　チヨイチヨイ。",
              "citation": {
                "source": "頭ならびに腹",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今になつてチヨイチヨイ先生のお書きになつたものなどを拝見しても私には解らない事が多うございます。",
              "citation": {
                "source": "Ｓ先生に",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "会津藩士がつくったヨイチ郡｜黒川村、山田村、伊達藩士が拓いたウス郡モンベツ村、イシカリ郡トウベツ村その他等々。",
              "citation": {
                "source": "望郷",
                "author": "――北海道初行脚――",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治十一年｜八雲を拓いた旧名古屋藩士、十三年ヨイチ郡大江村を拓いた旧山口藩士、十四年イシカリ郡トウベツ村に入った佐賀藩士、福岡藩士、十六年イワナイ郡前田村を拓いた金沢藩士、以下等々。",
              "citation": {
                "source": "望郷",
                "author": "――北海道初行脚――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その辺に網を張っていて一揆の奴等がやって来たら、たかが百姓、チヨイチヨイと叩きなぐって足腰を折っぺしょって元来た方へポイ返してやるまでよ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お秋　そんな無茶を言つたつて、――杉山さん、お前さん、あれからも初ちやんや町田さんとこへチヨイチヨイ行つたんだね？",
              "citation": {
                "source": "疵だらけのお秋（四幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「櫛は、源助がチヨイチヨイ私の家へ來るうち、何かの役に立てようと思つて持つて行つたのでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次女難",
                "note": "青空文庫"
              }
            },
            {
              "text": "――どうしたんです、親分」　八五郎は帶を結びながら、お勝手へ飛んで行つて、チヨイチヨイと顏を濡らすと、もう店先へまぶし相な顏を出しました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "權八の罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃御府内にチヨイチヨイ贋金が現はれるんで、その犯人を擧げた者には、大層な御褒美を下さるといふ御觸れぢやありませんか」「なんだその事か、――そいつは取らぬ狸の皮算用だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "二枚の小判",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツイ十日ばかり前から、荒川｜堤で狐の嫁入がチヨイチヨイおこなはれるんですよ」「おこなはれるは變だね」「最初は丁度この月の始め、雨のシヨボシヨボ降る晩でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "狐の嫁入",
                "note": "青空文庫"
              }
            },
            {
              "text": "磯五郎さんの方でチヨイチヨイ絡んだやうですが、あの人は藝人なんか、相手にしやしません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "僞八五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもすぐ納まつたやうで」「そんなことはチヨイチヨイあるのか」「此節は毎晩ですよ」「喧嘩の種は？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "娘の守袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「鍵屋の金右衞門を始め、今日逢つたのは皆んな元は武家だといふことだよ」「へエ、さうでせうか、ケチ兵衞なんか、隨分不景氣な御武家で」「それから、尾張樣の塀は大抵ぢや越せねえが、あの長屋の塀から、尾張樣の塀へ梯子を渡すとチヨイチヨイと宙乘りをして樂に越せるよ」「へエ、その梯子は？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三軒長屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "良い氣なものだよ、――お前の御用繁多も笑はせるぜ、泥棒猫を追つかける爲に、十手をお預かりしてゐるわけぢやあるめえ」「叶はねえな、親分に逢つちや――ところで、あつしが旅に出ると二日でも三日でも向柳原一帶は空つぽになるでせう、――相濟みませんがその間、誰かにチヨイチヨイ覗かして頂き度いんで。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき獲物",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けば近頃、神田から日本橋へかけて、花嫁がチヨイチヨイ消えてなくなるさうだな」「それなら聞きましたよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "七人の花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前は傳助といひなさるんだね」「へエ――」「どんな係り合ひなんだい」「旦那がいらつしやる頃から、チヨイチヨイお手傳ひに參りました」「商賣の方をか？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金藏の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んだつて又、そんなに持てたんだ――急に顎なんか撫で廻したつて、その上男つ振りが好くはなるまいな」「好い男のせゐもありますが、實は近頃チヨイチヨイ無氣味なことがあるんですつて」「無氣味なこと？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "一と目千兩",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分最初は急所々々の結び目十ヶ所くらゐへ、チヨイチヨイ刄物を入れて置き、潮時を見て、川へ乘出した一番端つこの、大事な繩を二三ヶ所きつたのでせう――四十何人と乘つてゐるんだから、これは一とたまりもありませんや」　藤次郎は、そのやり方の狡さに、齒ぎしりするほど腹が立つ樣子です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼の面",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「お前でさへあの内儀に夢中になつたぢやないか、あれは恐ろしい女だ――自分では大した惡氣もなく、若い男がほんの少しの隙間から自分の心を覗かせれば、みんな夢中になることを知つて、丸吉にもチヨイチヨイその術を使つたのだらう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "艶妻傳",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの男はチヨイチヨイ此處へ來るのか」　平次は訊きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "毒酒藥酒",
                "note": "青空文庫"
              }
            },
            {
              "text": "「去年の春から居りますよ」「大層繁昌するやうだな」「それ程でもありませんが」「伊豆屋の若旦那はチヨイチヨイ來たやうだな」「去年の秋から、今年の春へかけてよく來ましたよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "橋場の人魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "來ると、私が追ひ出されて、その代り小粒一つづつ貰ひましたから、忘れるわけはありません」「成程それは忘れつこはない、――ところでお銀は外へ出ないのか」「滅多に出ませんよ」「伊豆屋の店の者は誰か來ないのか」「下男の元吉さんは、チヨイチヨイやつて來ますよ」「弟の徳三郎さんは？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "橋場の人魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭痛持ちで疳性だから、夜風に吹かれるのが好きで、チヨイチヨイ出かけます、――本當に頭痛持ちなんですね。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "橋場の人魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "豫定では此處へ正午前に登つて其れから國境傳ひに鬼怒沼に向ふ筈であつたが、時刻も遲いし檜枝岐の人から藪のひどい話でおどかされてゐたので、止むなくヨイチ澤（コダイケ澤）へ下りる事に決めた。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私の考へでは再びヨイチ澤の一支流を遡つて鬼怒沼山に出で、それより鬼怒沼を見物して栗山村に下るつもりであつた。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、ヨイチ澤（コダ池澤）の下り　名殘惜しくも僅か一服で黒岩山の頂を離れた私達は其れから南に尾根の偃松を分けて下つた。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩蔭からどつとおめいて姿態もかまはず止む時もなく落ちる水のさまは、ヨイチ澤（コダ池澤）最後の傑作であり、且、其れが全部の象徴でもあつた。",
              "citation": {
                "source": "黒岩山を探る",
                "author": "沼井鐵太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
