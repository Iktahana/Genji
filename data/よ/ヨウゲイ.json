        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "横山湖山の絶句に「海口無関碧漫タリ／妖鯨出没シテ狂瀾涌ク／羽書ハ安辺ノ議ヲ奏セズ／唯夷情測リ得ルコト難キヲ報ズルノミ〕　鷲津毅堂は『告詰篇』一巻を著してこれを水戸｜前中納言斉昭に献じた。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "正にこれ百万の妖鯨濤を蹴りて飛ぶ。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
