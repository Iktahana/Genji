        "examples": {
          "standard": [
            {
              "text": "「この件については、そちのよきに計らえ」と殿様は鷹揚に頷いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "細かい予算の配分については現場の裁量でよきに計らえと言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「道中の宿の手配は、番頭のよきに計らえ」と主人が命じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "其方よきにはからえ」「それでは困ります。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあ、伊賀に――」「うむ、よきにはからえ」　と、おっしゃった。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんでも、よきにはからえ……これが命令だ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉宗は、もうその話は倦きたといったように、「名案じゃ、よきにはからえ」　つぶやくようにいったきり、だまりこんでしまった。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            }
          ]
