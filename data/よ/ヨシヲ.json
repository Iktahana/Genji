          "literary": [
            {
              "text": "」トイヒマシタガ、ヨシヲサンハモウウミノ中ヘトビコンデシマヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハ、オカシクナツテ「アラ、マア、何テヘンナオ子サンダラウ、マルデ、カツパノオバケミタイダワ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントウニ、ヨシヲサンノオ母サンノ言ツタトホリナンデスモノネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、ヨシヲサンノオカアサンハ、ソノマヒゴヲドコカデ見タコトガアル子ダト思ヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハキウニトビ上ツテ、「アラ、アラ、誰カト思ツタラ、アナタハヨシヲサンヂヤナイノ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トバンニンニオレイヲ言ツテ、ヨシヲサンヲウケトリマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "名まへは」「名はヨシヲです。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            }
          ]
