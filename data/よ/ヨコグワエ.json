    "definitions": [
      {
        "index": 1,
        "gloss": "holding horizontally in one's mouth",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
