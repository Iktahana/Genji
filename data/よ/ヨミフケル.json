[
  {
    "uuid": "ea05d8f9-96d9-5ae3-9868-d52d811e1573",
    "entry": "読みふける",
    "reading": {
      "primary": "よみふける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-他動詞",
