[
  {
    "uuid": "2c6ff274-818d-5629-9b45-2a111bd2decb",
    "entry": "用命",
    "reading": {
      "primary": "ようめい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
