        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "定期的にご用命いただいているお客様に感謝を込めて割引を適用した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「いつでもご用命ください」と職人は名刺を両手で差し出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "大量のご用命があったため、工場はフル稼働で対応に追われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
