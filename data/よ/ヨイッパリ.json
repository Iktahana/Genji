[
  {
    "uuid": "06c9d447-564d-5c4c-8714-5de12ba56d16",
    "entry": "宵っぱり",
    "reading": {
      "primary": "よいっぱり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
