        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "左は講堂で、読礼堂と云ふ額が懸かつてゐる。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "後世になると、智識階級はしばらく措き、一般民衆の間には、或は喪を匿くし、或は喪を停めて、その間に嫁娶を行ふ者が愈『五雜組』卷十四、清の徐乾學『讀禮通考』卷百十四、喪制七）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "禮の精神に則つて、服中生子の禁を法律に掲げたのは、普通に『唐律』が最初と認められて居る（『讀禮通考』卷百十五參看）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "清の萬斯同や徐乾學の如き錚々たる學者は、禮教維持や風俗肅清の立場から、強くこの禁解に反對して居る（『讀禮通考』卷百十五）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "士人の中には世間を恥づる餘り、服中に生れた子を養育せずに、暗に葬り去る者も絶無でない（『讀禮通考』卷百十五、喪中産子の項參看）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは清の徐乾學の『讀禮通考』（卷一乃至卷十六）に備つて居り、Groot の The Religious System of China（Vol.II,pp.488 seq.）も亦參考に供することが出來る。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "『明律』『清律』の卷首に載せ、又徐乾學の『讀禮通考』（卷三）や Pierre Hoang（黄伯禄）の 〔Le Mariage Chinois au point de vue le'gal〕【〔Varie'te's Sinologiques. No. 14〕】にも收められてある。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "周時代から唐宋時代を經て、明清時代に至るまでに、可なり變改されて居る（清の徐乾學『讀禮通考』卷一乃至卷三、喪期表參看）。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
