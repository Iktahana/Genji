    "definitions": [
      {
        "index": 1,
        "gloss": "(advance) notice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "演奏会の予告が駅の掲示板に貼られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "会社から臨時休業の予告がメールで届いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "来月の催眠の予告を今週中に出す予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "所が一日、予告もなく府庁の学務課から参観に来て、校長には二言三言だけ普通の話をして立去つた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラ、来週はメーベルノーマンドの写真なのね、あたし今度は一人で来るわ」　予告のビラが横手の壁にあつたのをみて、Ｓ子はさういつた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲーテのライネケフックスの訳本を読んで聞かせてくれたり、十歳未満の自分にミルの経済論、ルソーの民約論を教授してくれるという予告だけでもしてくれた楠さんは、たしかにその時代の新人であり、少なくも自分にとっては、来るべき「約束の国」の先触れをする天使の役をつとめてくれたように思われる。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした瞬間を限って変る人間の気持ちと、構成され破壊される歴史の記録を掲示する銀座の青色の夜、プロレタリア駆逐したプチ・ブルジョワ達によって、かくも盛大に開演された未来派のオペラ、金属的なめろでい、青磁色の空には女優募集の広告と、ダダイズムの集会の予告板とが蛾と戯れていた。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、以上の、われにも似合わぬ、幼き強がりの言葉の数々、すべてこれ、わが肉体滅亡の予告であること信じてよろしい。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "締切を突破した予告原稿だから……。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中でも季節に関する年中行事の報道やあるいは近き未来に関する各種の予告などこういった種類のものを日々新聞で承知するという事は決して悪い事ではない。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "展覧会、講演会、演芸、その他の観覧物も新聞広告で予告を受けて都合のいいものかもしれない。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五夜御用心――それは十五夜に於ける異変を予告するようにも見られた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "十五夜御用心",
                "note": "青空文庫"
              }
            },
            {
              "text": "主食と闇煙草の販売を弾圧する旨の声明は、わざわざ何月何日よりと予告を発して、これまで十数回発表されたし、抜打ちの検挙も行われる。",
              "citation": {
                "source": "大阪の憂鬱",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、到頭その日、即ち電話の予告のあった翌日一日は、何事もなく、少くとも僕の一身には何事も起らずに過ぎてしまったわけでした――が、可哀相なことにも、郁少年の身の上には実に容易ならぬ事件が突発していたのです。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん新聞で時間は予告されてゐるが、絶えず時計に気をつけてゐるわけに行かないから、一寸油断してゐるまに時間がすぎて、聞かうと思ふ講演が終つて居たり、音楽が曲の中途から聴えたりする。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "健脳な読者の中には、ずっと昔、自分と室生犀星等が結束した詩の雑誌「感情」の予告に於て、本書の近刊広告が出ていたことを知ってるだろう。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の日栄蔵は、塾で惣兵衛ちやんに予告した。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "予告は此原稿と、氏の書信によって、草平氏が書いた。",
              "citation": {
                "source": "長塚節氏の小説「土」",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "『それから』予告夏目漱石-------------------------------------------------------【テキスト中に現れる記号について】：ルビ（例）大学生の事を描た：入力者注　主に外字の説明や、傍点の位置の指定（例）それからである。",
              "citation": {
                "source": "『それから』予告",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の予告には数種の短篇を合してそれに『心』といふ標題を冠らせる積だと読者に断わつたのであるが、其短篇の第一に当る『先生の遺書』を書き込んで行くうちに、予想通り早く片が付かない事を発見したので、とう／＼その一篇｜丈を単行本に纏めて公けにする方針に模様がへをした。",
              "citation": {
                "source": "『心』自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜は別に低気圧の予告もなかったのだが、夜中から始めてぼつぼつ降り出した。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、急に、なんの予告もなしに言い出したのだから僕たちは、どきんとした。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ映画の予告篇、結果に於いては、宣伝みたいな事になってしまうのだから、出版元も大目に見てくれるにきまっていると思われる、などとれいの小心翼々、おっかなびっくりのあさましい自己弁解をやらかして、さて、とまた鉄仮面をかぶり、ただいまの抜書きは二枚半、ついでにもう二枚ばかり抜書きさせていただく。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本物の予告篇だと思っていた。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "公園事務所の扉には、もう初夏の夜間開場をする予告の貼札も見えます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "繰上げようとはしないで却って実行には妨げとなる行動の事情を予告のようにおまえに話したのだろうか。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーガスンは来るべき偉大なものを予告し、バアンズは其の偉大なものを成しとげ、私は唯其の糟粕を嘗めたに過ぎぬ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、それから間もなく（まだ私達が四年にならない前に）彼は突然、全く突然、私にさえ一言の予告も与えないで、学校から姿を消して了ったからだ。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、何月何日の何時何分頃、何ホテルの第何号室に投宿する何某という男が真犯人だと警官に予告し、自分自身がその名前で、その時刻に、その室に泊る。",
              "citation": {
                "source": "書けない探偵小説",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへ十二月初旬までという約束で送り付けておりました或る連載物が、某誌から念入りな註文附きの書直しを要求して、返送して来ましたので、既に予告も出ている事ですから、一生懸命になって書直しにかかりましたが、どうしても註文通りに行きませぬ。",
              "citation": {
                "source": "スランプ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　新子は、一ト月前ぐらいに、予告で筋を知っている、可憐な、アメリカのお妾物語を、もう一度頭の中に浮ばせて、人知れず、胸をときめかせながら、「それ、ご覧になります……？",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "園井は正午まで煙草一つ吸わず、帳簿の整理をしたり、集金郵便の予告状を書いたりして、打っ続けに働き、正午のサイレンが鳴ると、自転車に乗って近所にある自宅へ昼食をたべに行ったが、豹一が喫茶店から帰って見ると、もう物差を出して、しきりに広告欄の大組みをしていた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "主任、看視者、ハドソンは、蠅捕紙の命令の、すべてを、受くるべく、既に、予告せり、貴下の、雄鳥雉の、逃亡せる、ことを、信ぜられよ。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
