          "literary": [
            {
              "text": "あぶらや本介も同様也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今年御地寒熱之事被仰下、いづかたも同様也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼には、大なる慈悲を湛ふれども、お前さん方は、いくら、男子で、力があつて、この老婆をおどさうとなされても、そんな事では、驚きませぬといふ勝気も見えて、げに、女の中の仏様也。",
              "citation": {
                "source": "鎌倉大仏論",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎌倉の大仏に至りては、真に仏様也、西郷以上也、無論、人間以上也。",
              "citation": {
                "source": "鎌倉大仏論",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "小生も御客の相手で一人を暮らして居る様也。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大内旅館」についての多評は好景気の様也。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "原稿の価値は大したものにあらず少々物足らぬ様也。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "死人の塩よりのものも異界のものも同様也。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "樋合へ入れ候畳を見れば、のりもつかぬを入れ、腰張りはぎ入しも同様也。",
              "citation": {
                "source": "三次実録物語",
                "author": "稲生武太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹にさめしは、我れのみならず、他の二氏も同樣也。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝も曇りて、今にも降り出しさうな空模樣也。",
              "citation": {
                "source": "梅の吉野村",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "その長屋門の祠に面したる處に、茶菓を賣る店あるは、めづらしき樣也。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとり酒をのみて、寢につきしに、母屋の方にて、がや／＼と酒宴はじまれる樣也。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "霜いとふかき朝にてふとみれば初雪ふりたる樣也、ねぶりけるは一時計成けん、今朝は又金杉に菓子おろしにゆく、寒さものに似ざりき、しばしにてもたましゐをやすめたればにや、今日は筆のやすらかに取れて午前の内に清書を終りぬ、郵書になして星野子におくりしは一時頃成しか。",
              "citation": {
                "source": "「樋口一葉全集第二卷」後記",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
