        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まだたしかあつた筈だと云つて、じゆんは小箱の引出しを幾つも開けてはヨードホルムの瓶を探した。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱脂綿にアルコホルを浸して傷口を洗ひ、ヨードホルムをふりかけ、繃帶をし終へてから、駿介は、そのままそこの板の間に仰向けに寢た。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "傷の方はヨードホルムをつけといたし。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "開業についてだが、ある紳士がヨードホルムを鼻につくほど匂わせ、右人差し指に硝酸銀の黒いシミをつけ、聴診器が入っていると言わんばかりにシルクハットの右側を膨らませて入ってきたのだ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　老博士はかういつて、薬棚からヨードホルムの壜を取出して来た。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "風邪の薬、胃腸の薬、子供の気つけにする薬、ヨードホルム、即効紙などがごたごたと一杯になって入っていた。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨードホルムのにおいが室内に漂った。",
              "citation": {
                "source": "肉腫",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（薬品戸棚からヨードホルムと包帯箱を取り出す）ドクトルは遅いこと。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は「調査箱」と呼んでいるカンヴァス張りの鞄をあけ、小さい薬味入れ――ヨードホルムを振り出す壜――のようなものを彼にわたした。",
              "citation": {
                "source": "予謀殺人",
                "author": "A CASE OF PREMEDITATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰か沃度ホルムがないか。",
              "citation": {
                "source": "ポランの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰か沃度ホルムをもっていないか。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて沃度ホルムの臭いがして、ガアゼが当てられた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
