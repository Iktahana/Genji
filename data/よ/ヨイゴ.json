        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "齢ア四十一だべえが、村一番の醜婦の巨女だア、加之ハア、酒を飲めば一升も飲むし、甚※男も手余にする位の悪酔語堀だで。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊国の庭　昭和十六年晩秋の一夕私は北条秀司君に招かれて、この開化味感溢るゝ楼上に酔語した。",
              "citation": {
                "source": "山の手歳事記",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "老生は酔語し、主賓は酔聴す、何ぞ道理有らん」と。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "歓声酔語は、あちこちに沸騰している。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだあの特色のあるもじゃもじゃな頭髪も若々しく、もちろん酔語放談の調子は老画学生そのものだったし、初対面からおたがいにずいぶん言いたいざんまいを言いあって夜を更かした記憶がある。",
              "citation": {
                "source": "落日の荘厳に似る",
                "author": "――大観画伯の終焉",
                "note": "青空文庫"
              }
            },
            {
              "text": "齡ア四十一だべえが、村一番の醜婦の巨女だア、加之ハア、酒を飮めば一升も飮むし、甚※男も手餘にする位の惡醉語堀だで。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
