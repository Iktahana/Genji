        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ちょっと転んだくらいで泣くんじゃない！この弱みそ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は子供の頃、虫も殺せないような優しい性格から「弱みそ」とからかわれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おい、弱みそ共。俺の後にしっかりついてこいよ！」と番長が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「どいつも、こいつも弱みその露助みたいに呻きやがって！",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、勇子の全き純朴な人生には隠し事や弱みそれに恥ずべきことなどまったくなかった。",
              "citation": {
                "source": "勇子",
                "author": "一つの追憶",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はひとの奥さんだから、弱みそで困る。",
              "citation": {
                "source": "恋愛の微醺",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
