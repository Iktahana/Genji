        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "玄関先に飾るため、ホームセンターで色とりどりのパンジーの寄せ植えを買ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "春らしく華やかな雰囲気を出すために、チューリップとムスカリを寄せ植えにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女は園芸教室に通い、季節の花を使った美しい寄せ植えの作り方を学んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "次にはＯ君から浅い大きな鉢にいろいろの草花を寄せ植えにしたのを届けてくれた。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただＯ君からもらった寄せ植えの鉢だけはまだ花の色もあざやかであるから惜しいと言って、妻がひざの上にのせて持ち帰った。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
