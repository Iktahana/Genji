        "examples": {
          "standard": [
            {
              "text": "彼の言葉の裏には、もっと深い意味が読み込まれている気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この物語には、作者の人生観が深く読み込まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "絵画を鑑賞する際、作者の感情やメッセージを読み込むことが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to take (future changes) into consideration",
        "register": "standard",
        "nuance": null,
