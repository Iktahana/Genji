        "examples": {
          "standard": [
            {
              "text": "契約書の大事な条項を読み落としてしまい、後で大変なことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この本は情報量が多く、うっかりすると重要な部分を読み落としそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験で問題を読み落とさないように、何度も注意深く確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ましてや雑誌でも読まなかった上に、ここでまた本書を読み落とすとなると、心ある人は死んでも死に切れぬはずだ、多分。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の眼には、この小さな黒い字の一点一｜劃も読み落すまいという決心が、焔のごとく輝いた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の眼には、この小さな黒い字の一点一劃も読み落すまいという決心が、焔のごとく輝いた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かんじんなところを読み落すところだったわ……木津さん？",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の思想が、その誠実な生き方に裏書きされてゐることを読み落すのではないかと想像する。",
              "citation": {
                "source": "花田清輝論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の思想が、その誠実な生き方に裏書きされていることを読み落すのではないかと想像する。",
              "citation": {
                "source": "花田清輝論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "のぼせちゃって、かんじんなところを読み落すところだったわ……木津さん？",
              "citation": {
                "source": "猪鹿蝶",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
