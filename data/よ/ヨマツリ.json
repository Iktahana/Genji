        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地元の神社で毎年恒例の夜祭りが開催された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夜祭りでは、提灯の明かりが幻想的な雰囲気を醸し出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子どもたちは夜祭りを楽しみに、浴衣を着て出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "道すがらまた、新兵衛の女房の介錯で、お菊を隣村の夜祭りへ連れ出したことや、雉子が鳴いたり、山鳥が飛んだりする、春の野へお菊をまぜた三四人の女達とわらびをとりに行った時のたのしさなど思い出さずにはおられなかった。",
              "citation": {
                "source": "落穂",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "小正月を控へた残雪の山の急斜面、青い麦の葉生えをそよがしてゐた微風、目ざす夜祭りの村への距離を遠く感じさせる笛の響き、其後幾度とも知れぬほど、私どもの花祭りにあひに出かける心の底には、此記憶がひろがつて居るのです。",
              "citation": {
                "source": "山の霜月舞",
                "author": "――花祭り解説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "近古までもあった五月五日の夜祭りに、男が出払うた後に、女だけ家に残るという風のあった暗示を含んでいる語である。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "近古までもあつた五月五日の夜祭りに、男が出払うた後に、女だけ家に残ると言ふ風のあつた暗示を含んで居る語である。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　父は――同じ錺職だったんですが、盛な時分、二三人居た弟子のうちに、どこか村の夜祭に行って、いい月夜に、広々とした畑を歩行いて、あちらにも茅屋が一つ、こちらにも茅屋が一つ。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼暮色微茫のあはひ、笙すずろ、かなたは町の夜祭に水天宮の舟囃子。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "太秦の牛祭は、静かな秋の夜半過ぎてからの祭で、鞍馬の火祭、宇治の県祭と並んで夜祭の三絶と呼ばれてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡崎氏は大の夜祭好きで、東京にそれが無いのを何よりも残念がつて牛祭だけは是非夜の祭にしたいと言つてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼等はお前様、昨夜は夜祭を見ね行くし、明日は角力に行かんならんさかい。",
              "citation": {
                "source": "恭三の父",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ夜のモスクワ放送は、ソヴェト同盟の第三十二周年革命記念の前夜祭で建設を語る演説と心を魅する音楽を送りだしました。",
              "citation": {
                "source": "宋慶齢への手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一五九九年の「十二夜祭」当日、デンマアク大使のために大夜会が開かれ、女王とエセックスは、群臣の前で、手に手をとって踊った。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやくも流れた五年の昔の、幸福の頂上だったもう一つの「十二夜祭」の夜の幻が、たくさんの思い出を貫いて、二人をこの踊りに導いたのにちがいない。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年も、もうそろそろ秋の夜祭の季節が近づこうとしている。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでおしまいに路傍の石の二十三夜塔と、この夜祭との関係を言うならば、これも農村に文字のなかった時代には、石屋は頼まずに村の人が寄合って、土を運んで来て塚を築いていたもので、多分はそこに簡略な藁の仮小屋を作り、その中に集まって祭の夜籠りをしていたのである。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間にイエスがなぐられ給うたことは、聖書に記事があるだけでも、深夜祭司長の家でサンヘドリンの審理が終わった時に議員たちに拳固でなぐられ、そのあとで下役に平手でなぐられ、ピラトの法廷ではローマの兵卒のため鞭でなぐられた。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜祭でもあるのか、篝の火花が、森のこずえに、うす赤く映している。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷の讃甘神社の夜祭が、此処のような気がしてくる。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、恒例の小生の誕生日ゴルフの前夜祭には、来会者五十五名、新しいゲストには川端康成、壺井栄氏らも加わり、初会以来出張の「きかく寿司」の主人もほとんど用意の寿司米の最後の一握りまで握り尽す。",
              "citation": {
                "source": "年譜",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "真珠の王冠　このあいだ、東京まつりの前夜祭に、ミス東京コンテストの審査員たちが集まった。",
              "citation": {
                "source": "押入れ随筆",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
