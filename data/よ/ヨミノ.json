        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "霞亭は「四書集註、初伝播我邦、垂水広信崇信読之、藤房従而受業、或云、玄慧法師始講之、藤房玄慧同時与交、則其授受固当相通」と云つてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "其所蔵不過緊要必読之書。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一読之亦何の奇もないところに高手の高手たる所因が存するのであらう。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲其文讀之未嘗不流涕也。",
              "citation": {
                "source": "楊雄と法言",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
