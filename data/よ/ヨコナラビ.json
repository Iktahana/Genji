  {
    "uuid": "eb6903de-8c16-58df-b4a7-e99c9bf8295b",
    "entry": "横並び",
    "reading": {
      "primary": "よこならび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
