        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "〔『馬酔木』明治三十六年十一月十三日〕　明治三十五年七月初旬の頃である、看護当番として午後二時少し過たと思う時分に予は根岸庵に参った、今日はどんな様子か知らんと思う念が胸に満ているから、まず母堂や律様の挨拶振りでも、その日の先生の様子が良かったか悪かったかということがすぐに知れる。",
              "citation": {
                "source": "竹乃里人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔『馬酔木』明治三十七年五月五日〕「病牀六尺」六月二日余は今まで禅宗のいわゆる悟りということを誤解して居た。",
              "citation": {
                "source": "竹乃里人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔『馬酔木』明治三十七年八月二十五日〕",
              "citation": {
                "source": "竹乃里人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治三十八年十二月六日夜十二時｜記〔『馬酔木』明治三十九年一月一日〕",
              "citation": {
                "source": "絶対的人格",
                "author": "正岡先生論",
                "note": "青空文庫"
              }
            },
            {
              "text": "苔清水湧きしたたり、日の光透きしたたり、橿、馬酔木、枝さし蔽ひ、鏡葉の湯津真椿の真洞なす水上は思ふべきかな。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇三（明治三十六）年　六月、「馬酔木」創刊。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏に関西を旅し、一一月「西遊歌」を「馬酔木」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇四（明治三十七）年　四月、「榛の木の花」を「馬酔木」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月、「夏季雜咏」を「馬酔木」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇五（明治三十八）年　一月、「秋冬雜咏」を「馬酔木」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇六（明治三十九）年　七月、「炭焼の娘」を「馬酔木」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇七（明治四十）年　五月、「早春の歌」を「馬酔木」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇八（明治四十一）年　一月、「初秋の歌」を「馬酔木」終刊号に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきころまでは何を食べても――水を飲んでさへも――塩つぽく感じたのに、けふこのごろは、何を食べても甘たらしく感じる、何の病気だらうか、しかし近来の私は健康である、今夜も馬酔木居で、肥えたといはれたが、なるほど、私は肥えた、手首を握つて見るに、今までにない大きさである。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後はこの部屋で、三八九会第一回の句会を開催した、最初の努力でもあり娯楽でもあつた、来会者は予想通り、稀也、馬酔木、元寛の三君に過ぎなかつたけれど、水入らずの愉快な集まりだつた、句会をすましてから、汽車辨当を買つて来て晩餐会をやつた、うまかつた、私たちにふさはしい会合だつた。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "）、馬酔木さんを訪ねてポートワインをよばれる、それから彼女を訪ねる、今夜は珍らしく御気嫌がよろしい、裏でしよんぼり新聞を読んでゐると、地震だ、かなりひどかつたが、地震では関東大震災の卒業生だから驚かない、それがいゝ事かわるい事かは第二の問題として。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふは家主から前払間代の催促をうけたので、わざ／＼出かけたのだつたが、馬酔木さんには何としてもいひだせなかつた、詮方なしに、彼女に申込む、快く最初の無心を聞いてくれた、ありがたかつた、同時にいろ／＼相談をうけたが！",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "元寛さんを訪ねて、また厚意に触れた、馬酔木さんに逢うて人間のよさに触れた。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、稀也さんを見送るべく熊本駅まで出かけたが、どうしても見出せなかつた、新聞を読んで帰つてくると、間もなく馬酔木さんが来訪、続いて元寛さんも来訪、うどんを食べて、同道して出かける、やうやくにして鑪板を買つて貰つた（今夜もまた元寛君のホントウのシンセツに触れた）。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "・こゝに住みなれてヒビアカギレ・つゝましう存らへてあたゝかい飯・豆腐屋の笛で夕餉にする　日の落ちる方へ尿してゐる馬酔木居を訪ねてビールの御馳走になる、私は至るところで、そしてあらゆる人から恵まれてゐる、それがうれしくもあればさびしくもある。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてさっそく『三八九』を出すことになった、当面の問題は日々の米塩だったから（ここでもまた、井師、緑平老、元寛、馬酔木、寥平の諸兄に対して感謝の念を新らしくする）。",
              "citation": {
                "source": "『鉢の子』から『其中庵』まで",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅で暫らく雨宿りして、それから街を通りぬけて、四年ぶりに馬酔木居を訪れた、なつかしい。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬酔木居いつぽんかたすみのみつまたのはな川風さむみおちつかないてふてふ水車はまはる泣くやうな声だして　　日田水じゆうわうに柳は芽ぶく山ざくら人がのぼつて折つてゐる藪の椿の赤くもあるかみちがわかれるさくらさく猿田彦花ぐもりいういうとして一機また一機　三月廿五日　曇――晴、二日市。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬酔木君、さよなら、さよなら、馬酔木君。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "咲かない馬酔木の芽のうつくしさ平山から瀬尻へ。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "行けるところまで歩くつもりで、水窪川（天龍の支流の一つ）にそうて行く、河鹿がしきりに鳴く、右側の山には山吹、馬酔木、もちつゝじの花が或は黄ろく、或は白く赤く咲きつゞいてゐる、行き逢う山をとめもきよらかである、――今日の道この道はよいなあと思ひ思ひつゝ歩いて行く。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ではさほどにも思わない馬酔木の若葉の紅く美しいのが、わたしの目を喜ばせた。",
              "citation": {
                "source": "鰻に呪われた男",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬酔木は折節の独り言かも知れぬ。",
              "citation": {
                "source": "森の声",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治39年１月『馬醉木』署名　　　　左千夫",
              "citation": {
                "source": "八幡の森",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治三十九年三月三十一日發行、馬醉木　第三卷第三號所載）",
              "citation": {
                "source": "痍のあと",
                "author": "長塚節",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
