[
  {
    "uuid": "0114eb9e-5223-55f1-b289-93d5fa09bf86",
    "entry": "横座り",
    "reading": {
      "primary": "よこずわり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
