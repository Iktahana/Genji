        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私にそれが嗅ぎ分けられたところでは、それはヨオドフォルムの匂、揚林檎の油の匂、恐怖の匂だ。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてヨオドフォルムや、揚林檎の油や、恐怖の匂を吸ひ込んでゐた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に空は、それも水平線に近き所は、ちやうど試驗管の底に澱むヨオドの如く、重い鬱憂な紫に淀んでしまつたのであつた。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前がそんつもりでをればよかばツてん、ムツシユウ・シヨオドロンにして見れば、代りの女はいくらでんあツとだるけんね。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスで一番名高い温泉は、カンタルにあるシヨオド・エグとヴイクとで、そのお湯は何れも殆ど沸騰してゐる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "早いとこ、飛びこもう」と砂馬は言って、二流の下ぐらいの、ヨオドバ（洋風建築）の店にはいった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
