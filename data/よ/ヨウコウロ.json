    "definitions": [
      {
        "index": 1,
        "gloss": "smelting furnace",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "溶鉱炉の熱気はすさまじく、近くに寄ることも難しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鉄鉱石は溶鉱炉に入れられ、高温で溶かされて鉄になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔ながらの溶鉱炉は、今も現役で稼働している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "同志よ俺たちへの土産はマクニドゴルスク第二溶鉱炉の火のやうな労働者の意志がどんなに燃えてゐるか敵に対する憤りの激しさを火を噴くうなりのはげしさをはつきりときいてきてくれ。",
              "citation": {
                "source": "小熊秀雄全集",
                "author": "―３―",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり幻影を見るんですネ」　幻にしろ本物の人間にしろ、溶鉱炉に飛びこんだと聞いてはいい気持はしなかった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔一九二八年〕二月三日　モスクワ　午後三時半頃日沈、溶鉱炉から火玉をふき上げたような赤い太陽（円く、大きく）光輪のない北極的太陽　雪のある家々の上にあり　細い煙筒の煙がその赤い太陽に吹き上げて居た。",
              "citation": {
                "source": "一九二七年八月より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの当時の苦しみやたのしみは、今になって考えてみると、それが苦楽相半ばして一つの塊りとなって、芸術という溶鉱炉の中でとけあい、意図しなかった高い不抜の境地をつくってくれている。",
              "citation": {
                "source": "棲霞軒雑記",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地は灼熱し、溶鉱炉の中のよう。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄工場には、官設といわず、民間会社と云わず、三千度の溶鉱炉が真赤に燃え、ニューマティック・ハンマーが灼鉄を叩き続け、旋盤が叫喚に似た音をたてて同じ形の軍器部分品を削りあげて行った。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月四日（火曜）　○仕事は溶鉱炉なり。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "溶鉱炉に火が絶えぬと同じに、仕事も絶えるのはいけない。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "生命こそ最も少なく消費して、最も多く産出する溶鉱炉であるがゆえである。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぐりつけるごとき一抹の時の悪寒の底に、個人をその溶接の一関連体とする巨大なる溶鉱炉が、姿をおこす。",
              "citation": {
                "source": "レンズとフィルム",
                "author": "――それも一つの性格である――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぐりつけるごとき一抹の時の悪感の底に、個人をその溶接の一関連体とする巨大なる溶鉱炉が、姿を起す。",
              "citation": {
                "source": "物理的集団的性格",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二の賀川氏にお願いして下さいませんか」　いつも沈黙している魂の賀川氏はつかつかと機械の前に近づいてハンドルを握ってややしばし黙祷していたが、電力を通ずるスイッチのようなものを捻ったと思うと、回転式溶鉱炉ともいうべきものが響きを立て運転を始めた。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "溶鉱炉の火玉を吹き上げたように赤い、円い、光輪のない北極的な太陽が雪で凍てついた屋根屋根の上にあり、一本の煙筒から、白樺の黒煙がその赤い太陽に向ってふきつけていた。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "溶鉱炉へ投げ込むという手もあります。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかも溶鉱炉の口が突然開いてまた閉じたかのようだった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハロルドが科酸をまた吸っていると、アステリアが嬉しそうに微笑みかけて、優雅に前進し、今度は自分の番とばかりに、すぐ上昇し始め、緑の静海へ到達すると、ハロルドの眼前にザーザー、ゴーゴーと荒れ狂う溶鉱炉みたいなものがあった。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "この島には鉄鉱石と銅鉱石があるけど、溶鉱炉が無いため利用できないと、船長に伝えました。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "恭しく頭を下げるなり、同時に、山浦清麿の鍛った刀は、山浦清麿の喉を突き刺して、かりの世の肉体を、ふたたび永遠の溶鉱炉へと送り戻した。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤熱しない許りに焼けた、鉄デッキと、直ぐ側で熔鉱炉の蓋でも明けられたような、太陽の直射とに、「又当てられた」んだろうと、仲間の者は思った。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "熔鉱炉を冷やしてかち／＼にしてやるなんざ、なんでもねえこったからな。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まだ、選鉱場も熔鉱炉も検査はすまねえんだぜ。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを熔鉱炉の手前の縁にして、その向うに炉中の火気と見えるほど都の空は燃えています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空が急に真赤になったと思うと、私は大きな熔鉱炉の真唯中に突立っていた。",
              "citation": {
                "source": "夢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "精錬法も熔鉱炉を要しない高周波や上島式の如き世界独特の方法が続々発明せられている。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにネ、熔鉱炉の中に、誰だか飛びこんだ人間があるようだというのでちょっと騒いだんでさあ」「えッ、熔鉱炉……」「そうですよ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この工場の熔鉱炉と来た日にゃ、人間が好きでたまらねえと見えて、よくやるんですよ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｑは金属がたくさん集まっているので、いい気になって、その中に寝てくらしているうちにある日、熔鉱炉の中に投げこまれ、出られなくなった。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "弓掛の部落を遮っている蛇骨峠を一つ越すと、天蓋山の鉱山で、昼夜分かたず噴煙が硫気を含んで立ち昇り、熔鉱炉の煮える音、鉱石を砕く鎚の音、火薬を仕掛ける大爆音が絶える間もなく響いている。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熔鉱炉を据えた仕事場を正面に控えて山の中腹に巍然として聳える巨大な建物は、この鉱山の一切の事を一手に扱う大機関で――すなわち今日の山事務所で、その頃は吟味所と呼んでいたが、その吟味所の大建物も、今は静まり返っていた。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ち前の進取の気風で、君主がローマ綴で日記をつけ、ギヤマン細工を造り、和蘭式大熔鉱炉を築き、日本最初のメリヤス工場を試設したが、その動機には、外国の開化を輸入して我日本を啓蒙しようとする、明かな受用の意志が在る。",
              "citation": {
                "source": "長崎の印象",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
