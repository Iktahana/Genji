[
  {
    "uuid": "377a389b-c395-5251-bb92-060d215f2c98",
    "entry": "選り取り",
    "reading": {
      "primary": "よりどり",
      "alternatives": [
        "えりどり"
      ],
      "is_heteronym": false
    },
    "grammar": {
