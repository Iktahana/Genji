          "literary": [
            {
              "text": "』『センダガヤノシヨウジヨゴロシノハンニンケンキヨサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ヨサレ節といふのがこれで。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処やらで調子はづれた高い男の声が、最先に唄つた――（ヨサレ―茶屋のか―アかア、花染―の―たす―き―イ――）『面白いですねえ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何處やらで調子はづれた高い男の聲が、最先に唄つた――（ヨサレー茶屋のかーア、花染ーの――たす――き――イ――）『面白いですねえ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "唄はジヨンカラ節、ヨサレ節なぞといふ津輕民謠で、この胡桃の唄も或るジヨンカラ節の一句である。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
