        "examples": {
          "standard": [
            {
              "text": "猛獣である虎の養虎は、非常に危険で専門的な知識が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "動物園では、絶滅危惧種の虎の養虎に力を入れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "養虎は、野生動物の保護や研究において重要な役割を担う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
