          "literary": [
            {
              "text": "四物尽しの、古代に於て、一つの発達した形になつたものは「読歌」である。",
              "citation": {
                "source": "叙景詩の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天語歌・読歌などが、其である。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の旅行で私として得た収穫は、「ほうはい」もさうですが、「よみうた」（読歌）とも言ふべきものを聴いたことです。",
              "citation": {
                "source": "東北民謡の旅から",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれこの二歌は讀歌五五なり。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでこの二つの歌は讀歌でございます。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
