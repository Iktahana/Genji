  {
    "uuid": "be677d74-5cf0-5376-af39-d12f53ff8fae",
    "entry": "読方",
    "reading": {
      "primary": "よみかた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
