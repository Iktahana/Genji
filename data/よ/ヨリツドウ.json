        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてそれに寄り集うた眼白鳥が非常に多い。",
              "citation": {
                "source": "樹木とその葉",
                "author": "伊豆西海岸の湯",
                "note": "青空文庫"
              }
            },
            {
              "text": "「五城目の市日」といえば、昔から、この近郷の人々が寄り集う慣わしであった。",
              "citation": {
                "source": "凍雲",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "件の古家を買った人が、崩す其まゝ古材木を競売するので、其れを買いがてら見がてら寄り集うて居るのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "機蕨とでも申すべきか、よくもあんなに、多數の女性が、あの鬪爭のなかに、和氣あいあいとして寄り集うたものと、感歎せずにはをられないのです。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多端な一日　若い男性の多くは若い女性の天真に近い姿が見られるから海水浴場に寄り集う。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝討ちの機は束の間、やがて陽も高くなろうに」　寄り集うた面々は、顧み合って、口々につぶやいた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "摂家以下、殿上月卿雲客はことごとくそこに陪観の席を賜わって寄り集うていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
