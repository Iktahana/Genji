    "definitions": [
      {
        "index": 1,
        "gloss": "to be greedy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、より多くの富を得ようと欲張った結果、全てを失ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "限られた資源を巡って、子供たちは欲張って取り合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "欲張らず、分相応に満足することが幸せへの近道だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「賃銭はいくらでも出す」と嗾かせば、「それではいくら出す」とはや欲張る。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "山男のくせに欲張るからとんだ罵倒を受けたのだ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえ臨時の仕事を引き受ける場合は平日の五割増程度に止め、それ以上欲張ることは慎しまねばならない。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊「どうだ八、溜飲が下がったろう」「その代り褒美はフイになったぜ、親分」「欲張るな、三吉を逃がした上、お町さんを貰って来たんだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "大村兵庫の眼玉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくピストルにラッパもほしいや」「そんなにたくさん、よくばる子には、下さらないかも知れませんよ」「だってぼく、ラッパもほしいんだもの」「でもね、サンタクロスのお爺様は、世界中の子供に贈物をなさるんだから、一人の子供が欲ばったら貰えない子供ができると悪いでしょう」「じゃあぼく一つでいいや、ラッパ。",
              "citation": {
                "source": "クリスマスの贈物",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「日本人だったら、大人は、なにか、わしに呉れるんですかい」「よくばるな。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ、あまり、よくばるまい」　とケレンコはいった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よくばるから、そんするんだよ。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "慾張ると、どうしても、ちょっと、ごまかしてみたくなりますし、ごまかそうとすると、いろいろ、ややこしくなって、遂に馬脚をあらわして、つまらない思いをするようになります。",
              "citation": {
                "source": "一問一答",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし見物が積極的に、この長時間に比例するほど慾張るが故、役者もやむをえず働らくとすれば役者ははなはだ気の毒である。",
              "citation": {
                "source": "明治座の所感を虚子君に問れて",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "紐育博の出品顔触に対しては、その作品は当時問題にしようとせず、人選を兎角の問題にしたやうであつたが、あゝした海外に送るといふ特殊的事情の下にあつては、余程の人選の慎重さは勿論であるが、さりとて僅かな海外出品者をもつて、我国画壇の全部を語らせようと慾張るときに無理が出来るのである。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり慾張るからじゃありませんか」　たとい吉田のいう通り老人が困窮しているとしたところで、健三にはこうより外に解釈の道はなかった。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だい、あまり慾張るない」　じゃ、行きましょう――と、円タクの助手は扉をあけてくれた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――慾張るとよくない。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "想像力のとぼしさが生じる場合もあって、私は又そこでも慾張るのね、きっと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "注意しておくがね、あまり慾張ると、元も子も無くしてしまうよ。",
              "citation": {
                "source": "囚われ人",
                "author": "――寓話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにをそんなに慾張るかと言へば、この文章の初めに述べたとほり、カザノヴァといふ一個の人間像は、ともかくも、現在のわれわれにさまざまな示唆を与へる、最も健康な生命の一典型であることを明らかにしておきたいのである。",
              "citation": {
                "source": "人間カザノヴァの輪郭",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風に、この横著赤さんはひどくすばやくて、盗坊や詐偽師や、その外あらゆる慾張る人間に、いつまでも恵を垂れる、悪い神様になりましたの。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "児玉　　また、慾張る。",
              "citation": {
                "source": "五月晴れ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして若しそれが虫だつたら、もつとずつと慾張るのだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　　　　×　　　　　　×「どうだ八、溜飮が下つたらう」「その代り褒美はフイになつたぜ、親分」「慾張るな、三吉を逃した上、お町さんを貰つて來たんだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "兵庫の眼玉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が出来れば直ぐに苦労をするんですから」「次男坊が宜い」「次男で少し分けて貰えるようなのが宜しゅうございますわ」「そんなに慾張る必要はないよ。",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の欲には限りがないといいながら、そうそう欲ばるのは悪いことだから、今日限りお前を見世物に出すことはやめて、もとのとおり茂林寺に納めることにしよう。",
              "citation": {
                "source": "文福茶がま",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、そう欲ばるものではないよ。",
              "citation": {
                "source": "舌切りすずめ",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いい加減に欲ばるがいい。",
              "citation": {
                "source": "煙管",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで少し欲ばるようであるが、雪の降らない日の昼間は、凝結核の研究をすることにした。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
