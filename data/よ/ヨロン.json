  {
    "uuid": "af1ca87f-f4da-5459-9fd7-b8a113951ada",
    "entry": "余論",
    "reading": {
      "primary": "よろん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
