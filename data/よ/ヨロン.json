  {
    "uuid": "efdea449-f8f2-55ee-9850-c8942f8a6742",
    "entry": "輿論",
    "reading": {
      "primary": "よろん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
