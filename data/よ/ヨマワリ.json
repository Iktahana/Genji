        "examples": {
          "standard": [
            {
              "text": "地域住民が交代で夜回りを行い、防犯に努めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の寒い夜、夜回りの人たちが町をパトロールしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の日本では、火の用心のために夜回りが行われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "提灯を持って、拍子木をたたいて来る夜回りのじいさんに、お奉行様の所へはどう行ったらゆかれようと、いちがたずねた。",
              "citation": {
                "source": "最後の一句",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "――庭で夜回りが拍子木を打つ音。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて火災の節、その場所にて両三人焼死したりしゆえ、とかくに世間の風評には、横浜館内に幽霊が出ずるとのことなれば、館内に従事する老爺、ある夜当直にて夜番をなし、なんとなく薄気味わるく思い、恐れ恐れ夜回りをするところ、上図のごとく亡霊の姿、突然として目前に現れた。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
