          "literary": [
            {
              "text": "若い女の声で、『姉さん、お銚子』などと呼び騒ぐのを聞捨てゝ、丑松敬之進の二人は三浦屋の側を横ぎつた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "差向ひに椅子に腰掛けたは運動場近くにある窓のところで、庭球狂の銀之助なぞが呼び騒ぐ声も、玻璃に響いて面白さうに聞えたのである。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
