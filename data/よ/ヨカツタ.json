          "literary": [
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「マア、ソレハヨカツタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "長崎の小曽根で一日宿の主人等と花見に行く時お内儀さんが、今日は美いのを御召しなさいと云つたけれど、私は平生着の次ぎのを被て行きましたが、龍馬が後で聞いてヨカツタ／＼と云つて喜びました。",
              "citation": {
                "source": "千里駒後日譚",
                "author": "楢崎龍、川田雪山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
