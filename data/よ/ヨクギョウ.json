        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "翌暁、赭い泥河のそばで河馬の声を聴いた。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌暁風がおさまると同時に、それなり里虹の姿が、掻き消えてしまったのであるから……。",
              "citation": {
                "source": "人魚謎お岩殺し",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「翌暁迄二勺不足之は通じ十一度有之、其間多分御昏睡。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌暁六時手島七兵衛同道発足。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌暁小樽に着く迄は、腰下す席もない混雑で、私は一夜車室の隅に立ち明した。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの山また山の難路退却は、翌暁の午前三時過ぎまで――約四時間にわたるものとなっていたのである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌暁には前夜のそれとは見まごうばかりの落剥した灰色の姿に変わって、三々五々｜蕭条とまた丸山へ戻って行くのであった。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして其の翌暁には前夜のそれとは見まがふ程の落剥した灰色の姿に変つて三々五々蕭条と又丸山へ戻つて行くのであつた。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "天まだ暗い翌暁からさらに攻勢を烈しくして、「師泰、下り松を占れ」　と、号令していた。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
