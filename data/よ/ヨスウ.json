        "examples": {
          "standard": [
            {
              "text": "クラスの人数を班の数で割った余数は、いくつかの班に振り分けられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "余数がゼロになるまで計算を繰り返し、正確な数値を導き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "参加者を均等にグループ分けした結果、どうしても余数が出てしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして与吉を先に、軍之助が風雨に狩られ余数をあつめて、水戸街道を江戸の方へ走りつつあるとき、泰軒は、岸の小陰から衣類とともに例の血筆帳を取り出して、血にそむ筆で二人と大書していた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
