    "definitions": [
      {
        "index": 1,
        "gloss": "small festival held the night before the main festival",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "本祭りの前日には、宵祭りで地域の人々が一体となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "宵祭りの屋台は、本祭りよりもゆっくり見て回れるのが魅力だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、明日の本祭りに備えて宵祭りを楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あす二十二日がこの村の鎮守祭礼の日で、今夕はその宵祭りであるからであろう。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その凶報はおだやかなりし老人の胸を攪乱したばかりでなく、宵祭りを祝うべき平和な家庭をもかきにごした。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し此信仰を認めぬとすると、各地の祭礼が必｜宵祭りを伴うて居る風習を説明することがむづかしい。",
              "citation": {
                "source": "髯籠の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五日がこの村の祭で明日は宵祭という訣故、野の仕事も今日一渡り極りをつけねばならぬ所から、家中手分けをして野へ出ることになった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "宵祭ではあり十三夜ではあるので、家中表座敷へ揃うた時、母も奥から起きてきた。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七月十日）巴里の独立祭（晶子）　七月十三日の晩、自分は独立祭の宵祭の街の賑はひを見て帰つて、子供の時、お祭の前の夜の嬉しかつたのと殆ど同じほどの思ひで、明日着て出る服や帽を長椅子の上に揃へて寝た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏とは昨夜宵祭を見て歩いたのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭礼には必｜宵祭を伴ふ風習は、地上に神の常在しない証拠である。",
              "citation": {
                "source": "盆踊りと祭屋台と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "宵祭まつりの形式が仏家に移ると、盂蘭盆の迎へ火を焚く黄昏となる。",
              "citation": {
                "source": "盆踊りと祭屋台と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "○よど・いたじきばらひ　日向児湯郡｜三納辺で宵祭をよど、祭りの翌日を、いたじきばらひと言ふ。",
              "citation": {
                "source": "方言",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争の直前ハイデルベルヒに行ったら、あの美しい城内の広場でシェイクスピアの『夏至の宵祭の夢』を野外劇として演じ、特にイギリス・アメリカの訪問者を歓迎するというびらを撒いていた。",
              "citation": {
                "source": "パリの地下牢",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月｜五日、粂野のお下屋敷では午祭の宵祭で大層｜賑かでございます。",
              "citation": {
                "source": "菊模様皿山奇談",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（-log）同祭の前夜（宵祭）に焚く丸太。",
              "citation": {
                "source": "熟語本位英和中辞典",
                "author": "Y",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はクリスマスの宵祭です。",
              "citation": {
                "source": "人形の家",
                "author": "ET DUKKEHJEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "「明神様の宵祭か――一升提げて来るんでしたな、親分」　八五郎は鼻水を横なぐりに拭いて、盃を頂くのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "夕立の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際、どういうわけか五月祭の宵祭や万聖節の直後になるとその魔女屋敷の上の方の階で悪臭がするというぼんやりした地元の噂が絶えることはなかった。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "「明神樣の宵祭か――一升｜提げて來るんでしたね、親分」　八五郎は鼻水を横なぐりに拭いて、盃を頂くのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "夕立の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "その正月十五日の元宵祭は、大王廟の境内を中心に、鎮城の全街が人出に沸く。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
