        "examples": {
          "standard": [
            {
              "text": "彼は興味のある分野の本を片っ端から読み漁った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "受験生は、合格するために参考書を読み漁った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、その作家の作品を全て読み漁ることに決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "入社して彼に与えられた仕事は差当って書物を読み漁ることだけだった。",
              "citation": {
                "source": "美しき死の岸に",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木はやたらに煙草を吹かしながら、新聞の綴込をぼんやり読みあさるより外はなかった。",
              "citation": {
                "source": "擬体",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（a）歴史、これこそ私の最も好んで読みあさるものです。",
              "citation": {
