[
  {
    "uuid": "99f8b166-f5ce-5739-bcb8-c9ed566af4db",
    "entry": "幼童",
    "reading": {
      "primary": "ようどう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
