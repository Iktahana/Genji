        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ご飯、よそるの手伝おうか？」と、友人が声をかけてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母は大きな椀に汁物を装り、座卓の前に並べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子供たちの茶碗にご飯をたっぷり装り、夕食の支度を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "が、今は他のものを装る器具でない。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（泣き声を装る）一同はどっと笑う。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "よすがかたらふとかみまくとかにふ、くがつくと同じ様にるをうけてよそるとなる。",
              "citation": {
                "source": "用言の発展",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
