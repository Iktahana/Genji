        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのあとからヒョロ子が豚吉を背負って馬の背中に這い上りますと、無茶先生が手綱を取って、「ハイヨーッ」　と云うと、広い往来を一目散に逃げ出した。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ト晩でヘシ折って見せるがナ」「イヨーッ豪いゾッ。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラヨーッ」　トットットットッと曳き出す掛け声をきいて、記者は久し振りで溜飲が下がったような気がした。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「飯場さ入る時な、皆ば裸にしてよ、入口でヒー、フー、ミー、ヨーッで数えるんだ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叫んで追い、追いつつ振り返り、「妹ヨーッ、ここじゃ、兄はここじゃ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……待て陣十郎、逃げるとは卑怯……妹ヨーッ」と十間二十間！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大変だヨーッ」とまず叫んだ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浜路姉さんの大事な人が、妾の袖を引っぱった、いやらしい野郎に殺されるヨーッ、誰か来ておくれヨー、大変だヨーッ」　野遊びに来たつんぼのお六、二人の切り合いを見付けたのである。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "来ておくれヨーッ、来ておくれヨーッ」　丘を飛び下り駈け出した。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大変だヨー、来ておくれヨー、山影様が殺されるヨーッ」　ほこりを蹴立て、小鬼のように、途方もない速力で走って行く。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ戸外から聞こえて来たのが、「大変だヨーッ」という声であった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山影さんが殺されるヨーッ、みんなみんな来ておくれヨーッ」「え！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛び込んで来たつんぼのお六、やにわに浜路に飛び付くと、「妾の袖を引っ張った、いやらしい野郎が螢ヶ丘の裾で、山影さんと切り合っているヨーッ、姉さん姉さん浜路姉さん、早く早く早くおいでヨーッ」　歓楽の酒場が一瞬にして、混乱の庭と変ったのは、まさに当然というべきだろう。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山影さんだヨーッ、宗さんだヨーッ」　確り抱きかかえたものである。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラ、アラ、アラ、アラ、生きてるヨーッ」　さあさあお仙夢中である。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヨーッ」と杣夫達が嬉しがってしまった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をするんだヨーッ」「知ってるだろうね？",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妾の大切な宗さんだヨーッ」それから地廻りをコヅキ廻した。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれか来ておくれヨー文三がわたしをなめ殺すヨーッ」　その時であった。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あッ、あッ、あッ、君尾殿オー」　ザワザワザワと渡る風、風にまぎれて、「助けてくださいヨーッ」遠く遠く君尾の悲鳴、裏手の方から聞こえてきた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「助けてくださいヨーッ」　と声が消えた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「袴様だヨーッ、広太郎様だヨーッ」ヒシとだきあげたものである。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お持ちくださいヨーッ……おおおおそれにしてもこの傷は！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水だヨーッ……水々……水を汲んでおいで！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
