[
  {
    "uuid": "15db8758-d196-5bb6-94b3-9648a43d142b",
    "entry": "用途",
    "reading": {
      "primary": "ようと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
