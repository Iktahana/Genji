        "examples": {
          "standard": [
            {
              "text": "この養蜂家は30年以上蜂蜜を作り続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "地域の養蜂家たちが連携して蜜の品質向上に取り組んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "養蜂家の仕事は蜂の習性を深く理解することが必須だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ある教授は、彼の熱心さに打たれて、いわゆる養蜂家と称せられる著名な人物に彼を紹介しようと申し出たくらいである。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "岐阜の養蜂家の猪狩氏が、彼の熱意に動かされて、無償で良種の種蜂を数群分けてくれ、その上、必要な器具材料を実費で供給してくれることになつていた。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
