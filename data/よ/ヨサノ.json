        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "露西亜の役人が旅行券を返しに来たが、令嬢が「ヨサノ」と云つて私のも受取つて呉れた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「停車場までの路が今日は暑いので日本のキモノを着たマダム・ヨサノの徒歩は苦しからう」と夫人が云はれる。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其れから五日ほど経つて、おれは妻と芝居を出て夜の十二時過ぎに自動車で下宿の前まで帰つて来ると、丁度其時門の戸を押して外へ出た女が、おれ達を見附けて、「今晩は、ヨサノさん、ヨサノの奥さん。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事の後で名の話が出て、キキイが「ヨサノは伊太利人のやうな名ですね。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の姓のヨサノから想像して主婦は僕を伊太利人の子孫かと云つて笑はせた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨサノ、深尾、荻野、柳、河崎、星野、石本、自分等。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月六日（日曜）『改造』に、ヨサノアキコの押韻詩がある。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨサノさんが、このように古いと、彼女の貧乏して居て書いた時分のものをよんで誰が予測しよう！",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞の役人が旅行券を返しに來たが、令孃が「ヨサノ」と云つて私のも受取つて呉れた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
