          "literary": [
            {
              "text": "心から手を取り合って奇遇を喜び合うのであった。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして町へ引き返して、ビックリしておられる殿宮アイ子さんをソッと呼び出して、私の仕事の中で思いがけない拾いものをした事をお知らせして、心から喜び合う事が出来ました。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、私たち人間が男も女も一層のびのびとした心持で、互いの美点を認め合い、互いの面白さを喜び合うことが出来る。",
              "citation": {
                "source": "人間の結婚",
                "author": "――結婚のモラル――",
                "note": "青空文庫"
              }
            },
            {
              "text": "国頭の大宜味村の青年団の発会式に、雀の迷ひ込んだのを、此会の隆んになる瑞祥だ、と喜び合うたのは、近年の事である。",
              "citation": {
                "source": "琉球の宗教",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやくこれで平和な世の中が来る、と上下貴賤の別なく喜び合うのであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "事の次第を聞いた奥方も乳母も、夢ではないかと喜び合うのであった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　親子は手をとりあって、よろこびあうのでした。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
