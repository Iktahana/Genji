[
  {
    "uuid": "bf42e1a0-0ded-50e5-b5d2-e5dc8b33c437",
    "entry": "拠",
    "reading": {
      "primary": "よんどころ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
