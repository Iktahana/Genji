    "definitions": [
      {
        "index": 1,
        "gloss": "striking on the side",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵から横殴りを受けた兵士が転倒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ボクシングの試合で横殴りが禁止されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その強盗犯は警官に横殴りを食らわせて逃げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "霙が横殴りに吹き込んで来るのに、姉は振綱の下で満身に雪を浴びながら、いつまでも黙って父の顔を睨み付けているのです。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜかと云うと、横殴りの風を伴った霙の真最中五時頃に、姉さんは犯行の最初の階段を踏んだからです。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓から押し込む横殴りの強い陽射しといふ奴は実に又遠慮会釈もない奴である、影みたいな与里の身体に矢張り莫大な黒を落して、伏せた頬から頤の下へジットリ湧いた黒色は、何んだか変に与里の存在そのものをキナ臭く思はせてしまふのだ。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "与里は辛くも半ば開いた重苦しげな番傘へ肩から上をスッポリもぐし込むやうにし、生気の失せた長身をだらしない「く」の字に曲げて、横殴りの繁吹のなかを、何か冷い決意を追ふかに息を詰めて歩いて行つた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしたでも又来てみるさ――」　露路へ出てみると、もうかなり横殴りの陽射しで、長屋一帯は腰から上にだけ鈍い光が耀いてゐた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち塞がる播磨守を払い退けようとして、その拍子に、まるでひとりでに手が動いて、横殴りに一刀深く斬りつける。",
              "citation": {
                "source": "稲生播磨守",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車の外にあるその平凡な光景の空間を、大量の雨が横殴りに飛んでいき、ワイパーがガラスの上でそれをぬぐい続けた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "横殴りの雨が、テーブルの上の朝食のすべてに降りかかる。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "とじり／＼と吸込んで吹殼のこそげ附いて拔けない奴、よこなぐりに、並木の松へトンと拂つて、花の霞の江戸の空、筑波を横に急ぐ。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の内から少し生暖かな風の吹く日で、窓の硝子には横なぐりの雨の滴が着いては消え着いては消えしてゐた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――横なぐりに吹込みますから、古風な店で、半分｜蔀をおろしました。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや蒼空の下へ出た時には、何のことも忘れて、砕けろ、微塵になれと横なぐりに体を山路へ打倒した。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓のそとの樹の枝のゆれぐあいで、風がひどいなと思っているうちに、雨が横なぐりに降って来ました。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっと風が来て、横なぐりの雨を幌の隙間から吹きこんだ。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、芳子は横なぐりの雨に、ひやりと首筋を打たれた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、豹吉は雪子に無関心でおれなくなった自分をぴしゃりと横なぐりの雨のように感じて、ふと狼狽した。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "わあとく、檜木笠を、高浪が横なぐりに撲りつけて、ヒイと引く息に潮を浴びせた。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "可恐いもの見たさで、私もふツと立つて、框から顏を出すと、雨と風とが横なぐりに吹つける。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっしゅっと音を立てて霙は横なぐりに顔を打った。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "駿介を見るなり、腕で横なぐりに顏の汗を拂つて、「何とまあよく照るこつたか。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが横なぐりに靡いて矢よりも早く空を飛んだ。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、まだ横なぐりに吹きつけるものがある。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は、ひどい風が雨を横なぐりにふきつけて、びゅうびゅうあれつづけています。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その折は雨も煙りも一度に揺れて、余勢が横なぐりに、悄然と立つ碌さんの体躯へ突き当るように思われる。",
              "citation": {
                "source": "二百十日",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボズラ（死海の南方）の荒野にあって、昼は鬣狗が守護し、夜になると、魔神降下を喚き出すと伝えられる――死霊集会の標なんだよ」と法水は横なぐりに睫毛の雪を払って、云った。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "くたばれッ」と岡田の左耳から頬にかけ、力一杯、横なぐりした。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに横なぐりに切り払うと、今度は四人になった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神後記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツサツと横なぐりの夏の雨である。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋から冬にかけて度々おとづれて来る無慈悲な横なぐりの雨風に、あぶなく吹き飛ばされないやうに。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一気に扉を押し破りて窖の中に躍り入り、呀つと逃げ迷ふ奈美女の白き胴体を、横なぐりに両断し、総身の黥を躍らせて掴みかゝる馬十の両腕を水も堪まらず左右に斬り落す。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
