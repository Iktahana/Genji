          "literary": [
            {
              "text": "それにしても、およそ子どもっぽいいたずらをしたもんじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒色のくちびる",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ子なき婦人、酒肴、花果、飯餌を以て老猴に祷れば、喜んですなわち食い、衆猴その余りを食う。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また天皇、その后に命詔したまはく、「およそ子の名は、かならず母の名づくるを、この子の御名を、何とかいはむ」と詔りたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
