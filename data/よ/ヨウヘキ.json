    "definitions": [
      {
        "index": 1,
        "gloss": "retaining wall",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "急な斜面を切り開いて作られた宅地の境界には、頑丈なコンクリートの擁壁が築かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大雨による土砂崩れを防ぐため、市は裏山の脆弱な部分に新しい擁壁を建設することを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長年の雨風にさらされた古い石積みの擁壁に、不気味なひび割れが見つかり住民は不安を感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「どうするって、あけなきゃ、いつまでも、あそこでねばるじゃねえか」　頭をぶつけないように、四つんばいになって、壁になっているベッドと、補強用の「擁壁」になっているロッカーのあいだに垂れた、遮光のための毛布をあげ、高志は外へ出た。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山の石肌には、巨大な、人面を現はした石積の塔が聳えてゐてね、部屋々々の石柱は、傾き、石粱は落ちかけて、この山石の、廃墟の前庭には、巨きな樹が、倒れかけた擁壁を支へてゐるし、こゝの、杉のミイラと少しも変りはない。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "石を胸の高さあたりまで斜めに積んだ擁壁の上に、深い生け垣が見えた。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
