        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ヨンデ　ミマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　クセ、「ロバノ　コハ　イリマセンカ、ロバノ　コ」ト　ヨンデ　アルキマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレデ、イタチサヘ　ヨンデ　クレバ、ミンナ　オキヤクガ　ソロフ　ワケデスガ、サテ、イタチハ　ドウ　シマセウ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリヨクニアフノデ、オ母サンハ山羊ノ写真ヤサンヲヨンデ、キネンノ写真ヲトツテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "乍チニシテ島原ノ妓楼廃止セラレテ那ノ輩這ノ地ニ転ジ、新古互ニ其ノ栄誉ヲ競フニオヨンデ、好声一時ニ騰々タルコトヲ得タリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエノコヒビトヲヨンデヤラウ　アトレスモシツテイル",
              "citation": {
                "source": "朝",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラタチノ　カキノナカカラ　タカヲチヤンガ　ヨンデル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナシタイコトガアル、ヨンデクレ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アケチノ、トモダチダ、ハヤク、ヨンデクレ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
