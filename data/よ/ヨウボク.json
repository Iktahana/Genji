        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "植えた幼木は5年でようやく人の背丈ほどの高さに育った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幼木のうちは風対策として支柱を立てることが大切だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この公園に植えられた幼木たちが毎年大きくなっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
