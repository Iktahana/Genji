        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カゴカキ新美南吉　ツキヨノ　マツナミキノ　ミチデ　一リノ　サムライガ、ウシロカラ　ハシツテ　キタ　カラノ　カゴニ　ノセテ　モラヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ「セミヨノフ」輩ヲ用ヒテ内外蒙古ノ獨立ヲ策シツツアル如キハ誠ニ小策士ノ陰險手段。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他ヤコエノトリ、ネザメドリ、アケツゲドリ、ナガナキドリ、トコヨノトリと種々に異名ある（『重訂本草啓蒙』四四）。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後間もなくセミヨノフ軍の方では、この村に白軍が移動して来たことを、ニコリスクの日本軍に知らせるために、私達の一分隊……下士一名、兵卒十一名に、二人の将校と、一人の下士を添えて斥候に出すことになりましたのです。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエントカフエカシコラミヨノダイミヨウジン。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　私達を乗せて吉林のあちこちを見物させて呉れた馬車の馭者をしてゐた男も、その避難民の一人で、何でもセミヨノフ将軍づきの騎兵大尉だつたといふことでしたと公署の役人の一人は言ひました。",
              "citation": {
                "source": "一少女",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋草花にはロベリヤ、チヨノドクサの美しい碧色がある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、オバアサンハプリプリシテ、マドノソトヲミマシタラ、キンジヨノミケ子トトラ三ガ、ランニングヲシテヰマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、ヨノナカハヒトノキヲシランヤツガオホクテコマル。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメノ　カメコオバサンハ、キンジヨノ　マルコオバサンノウチヘ、ノソリノソリト　ハツテユキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "茲に詳にし置く可きは、「トコヨノクニ」の意義なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母はどうしてゐるかと白石が尋ねたところ、父は十一年前に死に、母の名はエレヨノーラ、今猶生きながらへてゐるとすれば六十五歳になる筈であり、兄弟は四人で、長女は夭折し、次は兄で名はヒリプス、次が自分で四十一歳、末弟は十一の折死んでしまつたと答へた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "長坂ヨノ、廿歳……大きな子供の身丈ぐらいしかないおチビさんで、こけし人形とそっくりの顔をしている。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話番号式に申しますと一四九二イヨノクニでございます」「成程。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のせいではないことを責められてでもいるように不貞た顔つきで母親の肩のところを見つめ、「チヨノさんと玉枝さんとおよねさんとおかねさんと、おますやんとかあやんとおつねさんとに一かせずつやったんじゃい」「それだけじゃなかろう、あとはどうした？",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「みんなおすえさんに上げたい」　まるで突っかかってくるようなフサエの言葉にいねは思わず笑顔になり、チヨノさんに玉枝さんに、と指を折ってその一かせずつの人数を数えた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "白馬節会はアオウマノセチエ、豊明節会はトヨノアカリノセチエ、珍しい名だから多くの人々が記憶し、ちがったよび方をすると今でも笑われる。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄略天皇紀の二十二年に、浦島子の記事が出ているのは一つの不審だが、ともかくも是が最古の文献であって、ここには蓬莱山という漢字を使い、その古訓はトコヨノクニであった。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓬莱が竜宮以上の外来語なることは疑いを容れぬが、古訓のトコヨノクニにも文化の香があって、なお最初からの民間の通語とは考えられぬのである。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
