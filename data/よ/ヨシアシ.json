        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「この新しいシステムは、利便性が高い反面、良し悪しがある。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「どちらの選択肢にも良し悪しがあるため、慎重に検討する必要がある。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「「この提案、良し悪し両方あるから、すぐに決められないな。」」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
