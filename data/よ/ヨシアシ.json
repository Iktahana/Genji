[
  {
    "uuid": "f1338c7f-3f15-5bec-bfa4-1341d195487e",
    "entry": "良し悪し",
    "reading": {
      "primary": "よしあし",
      "alternatives": [
        "よしわるし"
      ],
      "is_heteronym": false
    },
    "grammar": {
