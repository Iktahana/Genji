        "examples": {
          "standard": [
            {
              "text": "長距離の旅には、必ず予備馬を連れて行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "落馬に備えて、競技会には予備馬を用意する選手もいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の戦では、予備馬の存在が勝敗を分けることもあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もしマリユスに今少しその方面の知識があったら、彼は刃物師の道具だと思ったもののうちに種々なものを認むることができたろう、すなわち、錠前を破ったり扉をこじあけたりする道具や、切ったり断ち割ったりする道具などで、盗賊仲間でちびおよびばさと言わるる二種の恐ろしい道具だった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
