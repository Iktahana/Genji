        "examples": {
          "standard": [
            {
              "text": "横泳ぎは体力の消耗が少なく、長距離を泳ぐのに向いている泳法だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "水泳教室で横泳ぎを習い始め、ようやくフォームが安定してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "海難救助の訓練で横泳ぎを使いながら要救助者をゆっくり引き寄せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "しばらく同じ処に影を練って、浮いつ沈みつしていたが、やがて、すいすい、横泳ぎで、しかし用心深そうな態度で、蘆の根づたいに大廻りに、ひらひらと引き返す。",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロールともつかず、横泳ぎともつかず、ひどく出鱈目に手足を動かし、それも、急っ込んだり、のろくなったり、たいへんに不規則で、見ようによれば、ふざけているともとれるのである。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
