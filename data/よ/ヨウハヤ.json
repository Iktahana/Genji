        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "徳二郎は、「坊様早く早く！",
              "citation": {
                "source": "少年の悲哀",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おッ、貴様早引か！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "慈円　お師匠様早くお出あそばせ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍馬森　様井藤様井藤助太夫様早※龍馬其後ハ益御勇壮龍馬左右八月十六日森玄道様井藤助太夫様",
              "citation": {
                "source": "続　手紙",
                "author": "森玄道、伊藤助太夫あて（推定、慶応二年八月十六日）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――貴様早くくたばれ。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた少時して、『兄様早う。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那様早速そう申し伝えるでございます。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳二郎は「坊樣早く早く！",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうぞ旦那樣早くよくおなりなすつて」と臺所から出て來た下女は涙乍らに言つた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
