          "literary": [
            {
              "text": "』『街を一時間近く散歩して、裏通りのヨロピン酒場へ寄りました。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨロピン酒場に照会してみると葛飾が来たのは、それから三十分位経って軒灯を消したのだから多分十一時半頃だろうと云う答えであった。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、葛飾の住居からヨロピン酒場迄の道程は電車に乗って約一時間半、だから自動車ならば三十分で充分来られるわけである。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑事はそこで念のためにもう一度ヨロピン酒場を調べた。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　××座とヨロピン酒場とは目と鼻の間にある。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あなたは、自動車でヨロピン酒場へ行ったのだそうですね。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は直に踵をかえして表通りに出ると、通りがかりのタクシイを呼び止めて、それで街のヨロピン酒場へ参りました。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
