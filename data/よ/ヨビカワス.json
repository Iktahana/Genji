[
  {
    "uuid": "4d05e5d1-6c4c-5733-9816-5579ba4850ca",
    "entry": "呼び交わす",
    "reading": {
      "primary": "よびかわす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
