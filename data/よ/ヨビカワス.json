    "definitions": [
      {
        "index": 1,
        "gloss": "to call each other's names",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "離れた場所にいる友人同士が、大声で互いの名前を呼び交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "森の中で迷子になった子供たちは、不安げに親の名前を呼び交わしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "漁師たちは、霧の中で互いの位置を確認するために、名前を呼び交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いつも通り女中に混って敷台へ送りに出た雛妓とわたくしとの呼び交わす声には一層親身の響きが籠ったように手応えされた。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "趣味もなく、理解もない人を、同じ国民と呼び交わすよりも、むしろ国を異にし、語を異にし、又習慣に何等の差あるにしても、今ここにある人々の間におることの、遥かに愉快なのを、私はついに忘れることが出来ない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と呼び交わす二人の男女になっていた。",
              "citation": {
                "source": "溺るるもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ数隻の漁船が海上に点在しているだけで、ときどき微風が、呼び交わす漁夫の声を運んできた。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "都へ来て島原の太夫を知らんというは話にならんテ、なあ溝部」「それに違いない」「それ見ろ、一度この中へ入って済度を受けてみんことにゃ、世の中の人情というものの極意がわからん」　壬生と島原とは呼び交わすばかりの間である。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おーい」「おーい」　高いところの七兵衛と兵馬、谷の中の金掘り少年と呼び交わす。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白根山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さらば――さらば――」呼び交わす船と陸との間は、見るまに波の距離がひろがってゆく。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「霽れたぞ」「起きろ」　其処此処の岩間の蔭や木蔭から這い出して、身を伸ばした武者どもが、口々に、そう呼び交わすと、どこに昨夜を凌いでいたかと疑われるほど、見る見る数百の兵と、数十頭の馬とが、頼朝の身辺にむらがって来た。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬰児が泣く、女たちが呼び交わす。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――弥平治ッ」「十兵衛どの」　呼び交わす声が、二度ほど、喚きの中で聞えた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いは良人の名を、或いは妻の名を、互いに呼び交わす声が悲風の中に絶え絶え聞える。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――城ぬけだっ」「みんな出ろ、城ぬけだ――」　烈風をぬってよびかわす声がきこえた。",
              "citation": {
                "source": "伝四郎兄妹",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫のような声で小さく呼びかわすこの海の砂漠の漂浪者は、さっと落として来て波に腹をなでさすかと思うと、翼を返して高く舞い上がり、ややしばらく風に逆らってじっとこたえてから、思い直したように打ち連れて、小気味よく風に流されて行く。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "命がけに呼びかわす互い互いの声は妙に上ずって、風に半分がた消されながら、それでも五人の耳には物すごくも心強くも響いて来る。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その不思議な沈黙が、互いに呼びかわす惨らしい叫び声よりもかえって力強く人々の胸に響いた。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隔たった所から互いに呼びかわす水夫らの高い声は、この船にどんな大危険でも起こったかと思わせるような不安をまき散らした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりに遠く隔てると互いに呼びかわすその声が、美しい丸みを持って自分の声とは思えないほどだ。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれあれ」と呼びかわす親子主従は、ただ遠ざかり行くばかりである。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "朗らかに晴れ静まった青空には、洋紅色の幻覚をほのめかす白い雲がほのぼのとゆらめき渡って、遠く近くに呼びかわす雲雀の声や、頬白の声さえも和やかであった。",
              "citation": {
                "source": "木魂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か不敬漢でもあらわれたかのように、互いに呼びかわすものがある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、幌の覗き穴を通して、お玉を乗せた俥の先に動いて行くのと、町の曲り角へでも来た時に前後の車夫が呼びかわす掛声とで、広々としたところへ出て行くことを感じた。",
              "citation": {
                "source": "ある女の生涯",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お客さまア」と、声々に呼びかわす。",
              "citation": {
                "source": "今戸心中",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "お庭の植木の葉なぞを採るんじゃないよ」　岸本は先ずそれを子供に言って聞かせたが、兄弟の幼いものが互いに呼びかわす声を新しい住居の方で聞いたばかりでも、彼には別の心地を起させた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "螢　先刻から田圃に呼びかわす男の子の声がして居たと思うたら、闇の門口から小さな影が二つ三つ四つ縁先にあらわれた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜の雨がまだ降り足りないで、富士の頭へ残して行った一片の雨雲がようやく拡がって来ると、白根山脈の方からも、それと呼びかわすように雨雲が出て来る。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白根山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お花畑のあたりでは、仰いで見た雲の山岳が、ここでは相呼びかわすの地位となりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はすぐ耳元に近づいて、『私でございます……』と申しましたが、人間同志で、枕元で呼びかわすのとは異い、何やらそこに一重隔てがあるようで、果してこちらの意思が病床の母に通じたか何うかと不安に感じられました。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "邸の中がにわかにざわめいて、召使いたちが上を下へと走り廻りながら呼びかわす声が入り乱れてきこえたが、そのうちにすべての部屋には明かりがとぼされた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、仲間の者らが呼びかわす名前よりほかには、何にも聞き取っていなかった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "付近の小路には、呼びかわす人々の声や見物に駆けつけてゆく野菜作りの木靴の音などが聞えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
