        "examples": {
          "standard": [
            {
              "text": "春になると、母が作ったよもぎ餅の香りが家中に広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母のよもぎ餅は、優しい甘さで、毎年楽しみにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "桜餅とよもぎ餅は、春の和菓子として人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その夜、彼の泊った宿営に、一盆のよもぎ餅が届けられていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
