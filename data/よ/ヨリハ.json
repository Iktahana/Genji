          "literary": [
            {
              "text": "的言イアテルヨリハ、ワガ思念開陳ノ体系、筋ミチ立チテ在リ、アラワナル矛盾モナシ、一応ノ首肯ニ価スレバ、我事オワレリ、白扇サットヒライテ、スネノ蚊、追イ払ウ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　ヰタ　トシヨリハ　フカイ　タメイキヲ　ツイテ、「センサウハ　モウ　タクサンデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "却テ戰後ニ於ケル利權設定等ノ禍因ヲ播キ、印度其者ヨリハ何等ノ報謝ヲ求メザル天道宣布ノ本義ニ汚點ヲ印シ易キハ豫メ深ク戒ムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字トシテモ現今ノヒラガナヨリハ変態ガナノホウガ美シク、変態ガナヨリハ上代ガナノホウガ美シイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "少ナクトモカナヅカイノ問題ヨリハハルカニ単純デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――秋山ノ樹ノ下ガクリ、逝ク水ノ吾レコソ益サメ、御念ヒヨリハ。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "家蓼ヨリハ大ニシテ半開白色淡緑暈アリ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朔日ニ上ツリタルヨリハ大ニシテ仕形モヤヤ精密ナリ、七ツ過ギ退ク。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ経口剤デアルカラノブロンヨリハ気持ガイヽ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地捜シヨリハソノ方ガ優シダ、私ガ御案内シマショウト京二郎ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………空間ガ空色、頭髪ガ黒、唇ガ真紅、鼻ガ純白、………ソシテソノ黒サモ、紅サモ、白サモ、実物ノ彼女ヨリハハルカニケバケバシク、映画館ノ絵看板ノペンキノヨウニ毒々シカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚戦ニ固着シテ、愚ヲ重ネンヨリハ、如カズ、一タビ退イテ、再起ノ日ヲ計ランニハ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎌倉右大臣モ歌イケル　ものいはぬ　四方の獣すらだにも　あはれなるかなや　親の子をおもふ　サアレ二君ニマミエ、私ヲ負イ名ヲ争ウテ、武門ノ果ヲ汚サンヨリハ祖先モアワレト見ソナワシ給ウベシ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
