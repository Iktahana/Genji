        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、大正九年の秋、たま／＼ヨーロツパから歸つて來た親戚の人からイーストマンの葉書｜判の寫眞器をみやげにもらつた。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしヨーロツパにアレキサンドル大王といふ英雄があつた。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界的太宰治　ヨーロツパの近代人が書いた「キリスト傳」を二、三册讀んでみて、あまり感服できなかつた。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ・Ｍ・マリイといふ人は、ヨーロツパの一流の思想家の由であるが、その「キリスト傳」には、こと新しい發見も無い。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人の骨格は大体ヨーロツパ人よりも小さく、従つて体力も弱い。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ギリシヤ人と二十世紀のヨーロツパ人との間には殆んど骨格の相違は認められぬであらう。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "テエヌの言葉をかりると当時のフランス劇は、「ゴチツク建築と同様に、人間精神の、くつきり整つた形態をあらはしてゐたので、そのために、それはゴチツク建築と同様に全ヨーロツパにひろまつたのである。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロツパの各国に前後して起つたところのロマンチスムの文学運動には、民族や国土やその他無数の条件によつて、それ／″＼異つた色彩が見られる。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう思ふと、私は大變な時にヨーロツパに來合はせたものだと、つくづく感じないではゐられなかつた。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西部東洋の土耳古・阿剌比亞・波斯・印度等はヨーロツパにやられた。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くヨーロツパの電線や瓦斯や機械をめいめいの感覺や精神からはづすがよい。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれはヨーロツパの教化を受けたくない。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "一代も二代も通して東洋文藝復古期をつくり、ヨーロツパと戰はなければ、東半球の南北にかけて、どんなに未知な靈と力とが、波濤と岩との間にかくれてゐるか、眞の黄金期が埋もれてゐるか。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も平生旅行は割合にする方で、内地のみならず、古いことでありますがヨーロツパにも出掛けたし、ヨーロツパへの行き方も少し変つた行き方をしまして、普通ならば横浜乃至神戸から乗船して直接ヨーロツパ大陸へ行く、或はアメリカを通り、ロシヤを通るといつたやうなコースが色々あります。",
              "citation": {
                "source": "観光事業と文化問題",
                "author": "――日本観光連盟第六回総会に於ける講演――",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ／＼の人間としての歴史は、ヨーロツパの十八世紀をまだ迎えていないというところに、大きな困難と、興味とがあるわけです。",
              "citation": {
                "source": "Ｓ夫人への手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "田村君があの芝居をやる決心をしたのも、あれは純粋なアメリカ人の家族ではなく、スカンヂナヴイアからの移民であつて、いわゆる一般にアメリカ人といわれるタイプから離れてもいゝ、もつと北部ヨーロツパの田舎者らしい、従つて、そう日本人ばなれした型が必要ではないという有利な条件を考えてのことらしい。",
              "citation": {
                "source": "俳優と現代人の生活（対話５）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "太古、ヨーロツパ文明にふれない野蛮人の生活についてゞあります。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはアメリカだけではなくしてヨーロツパでも、アジアでも太古の社会はみなさうでありました。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先年私は十年振りでヨーロツパから帰つて来て悪趣味の下劣な日本婦人の服装に驚いたのであります。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはヨーロツパ文明の伝統が残つてゐるからであります。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロツパ人は、ばくろは馬に似た顔をして居ると言ひます。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうかうしてゐる中に、ヨーロツパの大戦争が起つたのである。",
              "citation": {
                "source": "半農生活者の群に入るまで",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八世紀は、周知の如く、ヨーロツパに於ける社会革命の前夜であつて、澎湃たる自由の精神は言わば肉体化されて、一種他の時代に見られない、機略縦横、闊達無軌道な人間の典型を庶民階級の中に生み出した。",
              "citation": {
                "source": "秘伝の名訳",
                "author": "――ボーマルシエ、辰野隆訳『フィガロの結婚』",
                "note": "青空文庫"
              }
            },
            {
              "text": "心にもなく日本に帰る道すがら自分は今一度ヨーロツパの土を踏む事が出来やう。",
              "citation": {
                "source": "黄昏の地中海",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロツパも文明の中心からは遠つて男ははでな着物きて、夜の窓下にセレナドを弾き、女は薔薇の花を黒髪にさしあらはなる半身をマンチラに蔽ひ、夜を明して舞ひ戯るゝ遊楽の西班牙を見る事が出来るであらう。",
              "citation": {
                "source": "黄昏の地中海",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "いか程歌ひたいと思つても、ヨーロツパの歌は唄ひにくい。",
              "citation": {
                "source": "黄昏の地中海",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "やれば、中央ヨーロツパの平野を地中海の岸に結びつけるのだ。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィチ・クロポトキン　Pyotr Alkseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロツパでもハンガリーなどでは即ちマギアール族で東洋民族であるから、苗字を先にし、名を後にする。",
              "citation": {
                "source": "誤まれる姓名の逆列",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
