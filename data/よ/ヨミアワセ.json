[
  {
    "uuid": "74c74573-bc74-51d0-a393-4c2667e42f66",
    "entry": "読み合わせ",
    "reading": {
      "primary": "よみあわせ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "reading out and comparing (e.g. proofs against a manuscript)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "最終原稿と校正刷りの読み合わせを行い、誤字脱字がないか確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "契約書の読み合わせは、双方の合意形成において非常に重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生と生徒でテストの解答の読み合わせをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "下手な応募俳句を読み合わせているところへ、ぶらりと磯田が入って来た。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又世間の多くの人は、最近の博士の有名な論策のいくつかをここで読み合わせることが出来るだろう。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私の東京地図」と「女作者」「虚偽」「泡沫の記録」などをよみあわせたとき、二十年前に「キャラメル工場から」を書き、プロレタリア文学の歴史に一定の業績をのこしているこの作家が、複雑な良心の波にゆすられながら、民主主義の婦人作家として自身に課している努力を理解することができる。",
              "citation": {
                "source": "婦人作家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "所属の部所が私には与えられていなかったから、タイピストは私に、コッピーのよみあわせをしてくれと頼みに来るし、営業の人は、使い走りを命令し、会計は、銀行ゆきをしてくれという。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は凡て羊の皮に焼火箸で書いた自己の「創作集」を肌身離さず背嚢の中に蔵して、敗戦のテントの中では戦友同志に読み合せて慰め、祝勝の宴の上では、節を編んで詩にうたつた。",
              "citation": {
                "source": "浪曼的月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "松岡と分れて、成瀬と二階の教室へ行くと、もう大ぜい学生が集つて、ノオトを読み合せたり、むだ話をしたりしてゐた。",
              "citation": {
                "source": "あの頃の自分の事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンデリヤの明りが、そのテーブルの上に散らかっている書類――タイプライタアの紫インクがぼやけた乱暴な厚い綴込、隅を止めたピンがキラキラ光る何かの覚え書――の雑然とした堆積と、それらを挾んで相対し熱心に読み合せをしている二人の男とをくっきり照して、鼠色の絨毯の上へ落ちている。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして少しのろのろと、三つめの薄い覚え書を読み合せてしまうと佐々は、いかにも重荷の下りた風で、「やあ、どうも御苦労様でした」と、頭を下げ椅子をずらした。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "役々に関する必要なる解説及び各人物構成上の注意（モデル選択の方針又は職業的習癖の観察事項等を含む）――この期間は、毎日読み合せを一回づつ行ふ。",
              "citation": {
                "source": "稽古のしかた",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さまざまな人間が別々な場所で思い思いに書いた筆録を、註解もなくただ雑然と並べているだけだが、かれこれと読み合せて行くうちに、ナポレオンがどんな方法でセント・ヘレナを脱けだし、どういう経過で仏領加奈陀へたどり着いたか自然にわかるようになっている。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞社の編輯局独特の深夜の緊張が四辺を支配して、電話の鈴の音、ザラ紙の原稿紙に鉛筆の走る音、校正の読み合せの声――などが、漸く活気付いて来た工場の雑音を背景に、一種異様なリズムを醸し出して居ります。",
              "citation": {
                "source": "流行作家の死",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ろの方には瓦斯ストーヴが燃え盛って、隣の校正部からは、原稿とゲラ刷を読み合せる、一種のメロデーが、物淋しく響いて来るのでした。",
              "citation": {
                "source": "笑う悪魔",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「蛇姫様」の読み合せ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一景から読み合せをし、セリフを直したりして五時に終る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時から三時迄「弥次喜多」、三時半頃、漸く出来た「曲芸団」のプリントで、読み合せ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雛妓」の読み合せ、又ヘンな芸妓ばかり出るらしい、困りもの。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "読み合せをやり、十時すぎからスタヂオへ入る、第一夜分を二度くり返す、「当世三人兄弟」浪六ものだが、何うも面白くないのでクサる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って、第二夜の読み合せ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "放送会館へ明日より三日間放送の「大望」読み合せやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ後、「芝居の世の中」を、読み合せして、それから立ったから一時になっちまった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ後ラヂオの「笑ふ巴里」の読み合せ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部終ってから、三階で「次男坊」の読み合せあり、大いに肩こる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜すんで、「ガラマサどん」の読み合せ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ後、「二つのネクタイ」の読み合せをやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼女をめぐる」「ハリキリボーイ」「河内山」と読み合せをして行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "読み合せして、一景だけ立つ、その一景が長いし、人数は多いし、大汗ものだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "各々作者が読み、わりに早くアガったので、「彼女と男装」の読み合せをさせる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弥次喜多」は読み合せだけやる、自信なし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "読み合せをし、一時から吹込み。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大久保」読み合せ、もり上るところなし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
