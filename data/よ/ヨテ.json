        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「敵大編隊来襲、八時二十分頃本土着のヨテイ」と。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ信州にまわる一週間のヨテイ。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事今月は百枚突破のヨテイ。",
              "citation": {
                "source": "日記",
                "author": "一九四九年（昭和二十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギヨティーヌは気ちがいのように活動して一分に一つの割合でさまざまの首を断ち落した。",
              "citation": {
                "source": "パリの地下牢",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて広場に着き、最後の祈がすむと、ギヨティーヌの上に導かれた。",
              "citation": {
                "source": "パリの地下牢",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時十五分、ギヨティーヌの大きな斧刀は鋭く落ちて、美しい首を美しい身体から断ち放した。",
              "citation": {
                "source": "パリの地下牢",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "革命裁判の狂暴とギヨティーヌの運転はその後も止む時なくつづいた。",
              "citation": {
                "source": "パリの地下牢",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを出て山の方へ行ってみたかったが、近頃の山火事に追われたカヨテ（狼）やライオンが出るといううわさをきいていたので、行くことは見合せた。",
              "citation": {
                "source": "バークレーより",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「セミマルノオカミトジョチュウ、ヨテイノトオリ、イチバンニテタツ」　巨勢博士はつぶやいた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "数年以来ポトアシクソルフェート（すなわち硫酸剥篤亜斯）、ポトアシクヨテェート（すなわち沃酸剥篤亜斯）、ソヂクカルボナァート（すなわち炭酸｜曹達）等の名称をもって舶載する化学薬品あり。",
              "citation": {
                "source": "化学改革の大略",
                "author": "清水卯三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
