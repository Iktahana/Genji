[
  {
    "uuid": "64308290-fb16-5c99-95fb-ebbc9d1bde02",
    "entry": "よそ目",
    "reading": {
      "primary": "よそめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
