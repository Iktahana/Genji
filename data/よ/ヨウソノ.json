        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "観行院様は非常に厳格で、非常に規則立った、非常に潔癖な、義務は必らず果すというような方でしたから、種善院様其他の墓参等は毫も御怠りなさること無く、また仏法を御信心でしたから、開帳などのある時は御出かけになり、柴又の帝釈あたりなどへも折々御出でになる。",
              "citation": {
                "source": "少年時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は、浄善尼を扼殺した四本の手も、同様其の中に蠢いていたのだよ。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天一坊が愈々江戸に参りました時、御奉行様も伊豆守様其の外の方々と一所に御対面遊ばしました。",
              "citation": {
                "source": "殺された天一坊",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "異族の村の信仰の当体なる動物を、信仰抜きに、直様其人の、其際に現してゐた姿とする。",
              "citation": {
                "source": "信太妻の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿に著て直樣其事を詳記したのを平沼大三郎氏に送り、今に保存し貰ひある。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
