    "definitions": [
      {
        "index": 1,
        "gloss": "all right",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「よしよし、よく頑張ったな」と、先生が子供の頭を撫でた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "泣いている妹に、「よしよし、もう大丈夫だよ」と優しく声をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "犬が芸を成功させたので、「よしよし、賢いね」と褒めてやった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「おゝよしよしよし――お母さんが悪かつた悪かつた、今先生様がよくして下さる――おゝ悪かつた悪かつた」　それまでいふとヒヨツと母親は医者の方へ眼を上げた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "両親は左程には思われぬ、眼を病めば盲人になる人もある、近眼位なら結構じゃ、百姓の子が百姓するに不思議はない、大望を抱いて居ても運がたすけねば成就はせぬもの、よしよしもう思い返して百姓するさ。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よしよし、話のみにては解しがたし、目に見なばそなたもかならず泣かん」いいおわりて苦しげなる息、ほと吐きたり。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "行一は「よしよし、よしよし」膨らんで来る胸をそんな思いで緊めつけた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、）と考えて、「おれは魚屋の前から来た。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、この石へ寝よう。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし捕まえて懲して遣ろうと、ぬき足さし足うしろから近寄ってお出でになりました。",
              "citation": {
                "source": "ドン",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も酔っぱらいと思いまして『よしよし、サア帰ろう、なんでも聞こう』と一しょに連れ立って家に入りました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よしよし静かにしていろ。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よしよし次の晩旗も見せてやるし、先生がその男の死んだのを村の人に告げてからの話もしてやる。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、いや、村の衆。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、）と考へて、「おれは魚屋の前から来た。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、プ、プ、プロージット。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、一つ山男を呼び出して、聞いてみよう。",
              "citation": {
                "source": "紫紺染について",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、おれが引き受けてやろう。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよしそれも面白い。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし」　とおっしゃって茶托に干菓子を山盛りにして下さった。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よしよし、雨ふり坊主はどこにいるのだ」　とお父さんが云われましたから、太郎は喜んで裏木戸へお父さんをつれて行ってみると、萩の花が雨に濡れて一パイに咲いているばかりで、雨ふり坊主はどこかへ流れて行って見えなくなっていました。",
              "citation": {
                "source": "雨ふり坊主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんは急に怖い顔になって、「よしよし。",
              "citation": {
                "source": "雨ふり坊主・先生の眼玉に・奇妙な遠眼鏡",
                "author": "香倶土三鳥（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "無茶先生は大威張りで、「よしよし。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、おれが追払ってやる。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、おれが行って見てやろう。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ると無茶先生はうなずいて、「よしよし。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは序に私のおやじがカンシャク持ちで困りますから、それも治して下さいませ」「よしよし、つれて来い」　こうして無茶先生は家中の者の病気をみんな治してやりました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、それではみんなと一所におれの云うことをきけ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見ると無茶先生は可笑しいのを我慢しながら、「よしよし。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "there, there",
        "register": "standard",
