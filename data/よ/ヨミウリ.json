        "examples": {
          "standard": [
            {
              "text": "江戸時代、事件や災害のニュースは読売によって庶民に伝えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "浮世絵には、町で読売を売る人々の様子が描かれているものもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "読売は、当時の世相を伝える貴重な資料となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
