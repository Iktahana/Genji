        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一日中歩き回ったので、もう体がヨレヨレだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "徹夜明けで、頭も体もヨレヨレになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あー、疲れた！もうヨレヨレだよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
