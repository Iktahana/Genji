        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユフダチ　ヤムノヲ　マツウチニツカレガ　デタカ　オヂイサンイツカ　グツスリ　ネムリマスオヤマハ　ハレテ　クモモナクアカルイ　ツキヨニ　ナリマシタ　この月は、春の下弦の月である。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの人を螫しては※に入り、一たびは烟となれど、又「フヨニツクス」（自ら焚けて後、再び灰より生るゝ怪鳥）の如く生れ出でゝ、毒を吐き人を傷るといふ蛇の刺をば、われ自ら我膚の上に受くと覺えき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女は巣を立ちし「フヨニツクス」鳥の如く、かの穢はしき猶太廓を出でつるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　イツシヨニ　ニギヤカニ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ナタネノ　ツボミト　イツシヨニ　ソダツタ　テフテフデスカラ、ナタネノ　花タチトハ　タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレト　一シヨニ、ソノ　ウタヲ、ヨク　ウタツテ　下サツタ、ヤサシイ　オ母サンノ　コトモ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ヒトビトハ　ウマヤ　ウシト　イツシヨニ　ハタケニ　デテ　キテ　セツセト　ハタラキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……その運命の神様と申しまするのは、竈の神、不浄場の神、湯殿の神、三ツ角の神、四つ辻の神、火の山の神、タコの木の神、泥海の神、または太陽の神、月の神、星の神、リンガムの神、ヨニの神々のいずれにも増して大きな、神々の中の大神様で御座いまする。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "リアリズムからナチユラリズム、ナチユラリズムからインプレツシヨニズム、それからこの動的芸術は一歩を進めて出て来てるのである。",
              "citation": {
                "source": "動的芸術",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "動いたまゝのインプレツシヨニズム――私は其処に新しい芸術を認める。",
              "citation": {
                "source": "動的芸術",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "オソラヲ　ミレバズンズントオ山ノ　上ヲワタノヨニウイテル　クモモトビマシタ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアサン　イツシヨニセツセツセ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しく例を挙げてみれば、羅馬人達が親しみを感じたアヴェンチン山河の「｜親愛の神」も、アリアン民族が尊敬したリンガ神の神体も、印度の人々がいつき祀っていたシャクテイ教の神体たる、ヨニーと称する物の形も、大黒天も聖天もそれなのである。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三汀及びその仲間の仕事は詩に於ける北原白秋氏の如く、俳諧にアムプレシヨニスムの手法を用ひしものなれば、面白がりて読みしものなり。",
              "citation": {
                "source": "わが俳諧修業",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "邸内には、ヨニック式の礼拝堂があります。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "その棒の木口に三の字を書いて、わが口の中にて「カエリコンズカエリコントハオモエドモ、サダメナキヨニサダメナケレバ」と三度読み、口の内にて「ヨレヨレ」といえば、棒の端が一所に寄ること奇妙なり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドナタカ、私ノ家ヘ一シヨニ住ンデ下サル方ハアリマセンカ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲキテ記念ノタメニコホロギサント一シヨニ写真ヲウツシマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタノアサハ　ジヤガイモサンニモサウ言ツテ二人デ一シヨニ、キツト　オミオクリニキテクレタマヘ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人ハ　コンナワケデ、一シヨニマチヘ行ツタノデ、ソノ時カラコツチ、人参ト玉ネギトジヤガイモハ　イツモ一シヨニオ料理サレルヤウニナリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレナラ　イツシヨニ　ノハラヘ　イツテミヨウ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテイヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテ「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨニ（女陰）が声色をつかってやがらあ」　まさかヨニとは言わなかったろうが――。",
              "citation": {
                "source": "艶色落語講談鑑賞",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノスウ一マンヨニンナリ」　正造は「おお」と小さい叫びをあげて強い衝撃に胸をひいた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
