          "standard": [],
          "literary": [
            {
              "text": "「敵大編隊来襲、八時二十分頃本土着のヨテイ」と。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ信州にまわる一週間のヨテイ。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事今月は百枚突破のヨテイ。",
              "citation": {
                "source": "日記",
                "author": "一九四九年（昭和二十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「セミマルノオカミトジョチュウ、ヨテイノトオリ、イチバンニテタツ」　巨勢博士はつぶやいた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
