[
  {
    "uuid": "341f0de8-ca2e-554d-910d-543f5db67131",
    "entry": "予定",
    "reading": {
      "primary": "よてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
