        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれは王廷の番頭で、番頭でありながら、主家をないがしろにし、民税をくすね、巧妙な組織のもとに、十余代二百幾年、ていよく栄華をぬすんできた悪の府ではないか。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸家の用達眞志屋十餘代の繼承次第は殆ど脱漏なくわたくしの目の前に展開せられた。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
