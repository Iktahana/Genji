        "examples": {
          "standard": [
            {
              "text": "伝統的な行事では、陽数が縁起が良いとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は陽数を好むので、いつも3や5を選んで宝くじを買う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古代中国では、陽数は天、陰数は地を表すとされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「九月九日、九は陽数という。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次には山陽数ヵ国を平定している筑前守秀吉にも辱じたがよい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
