      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』『センダガヤノシヨウジヨゴロシノハンニンケンキヨサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ヨサレ節といふのがこれで。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処やらで調子はづれた高い男の声が、最先に唄つた――（ヨサレ―茶屋のか―アかア、花染―の―たす―き―イ――）『面白いですねえ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "何處やらで調子はづれた高い男の聲が、最先に唄つた――（ヨサレー茶屋のかーア、花染ーの――たす――き――イ――）『面白いですねえ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「完全なる犯罪」を実行し得る無上の一｜刹那を、私のために作り出してくれた天地万象が、どこまでも私のアタマのヨサを保証すべく、私の註文通りに動いているかのようであった。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはその撮影と彩色の技術が如何に巧妙な、且、優秀なものであるかを事実に証明しているものであったが、本人自身はその背負っている刺青の威勢のヨサにも似合わず、ただもう恐れ入った篤実そのもののような態度で、ビクリビクリと訊問に応ずるのであった。",
              "citation": {
                "source": "Ｓ岬西洋婦人絞殺事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛唐のヨサがわからなければ芸術はわからないとまで云い合っていた。",
              "citation": {
                "source": "路傍の木乃伊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのヨサを沁みじみ感じながら、そのヨサの正体がわからない。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直のところ、筆者もこの衆口に一致してしまいたいので、この以上に能のヨサの説明は出来ない事を自身にハッキリと自覚している。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、真実のところ、能のヨサの正体をこれ以上に説明すると、第二義、第三義以下のブチコワシ的説明に堕するので、能のヨサを第一義的に自覚するには、「日本人が、自分自身で、舞か、囃子をやって見るのが一番｜捷径」と固く信じている者である。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "能の根本生命……即ち能のヨサはそこから生れて来るのだから……。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "能の隅々までも行き渡っている、云い知れぬ「アリガタサ」や「ヨサ」はかくして生み出され、伝えられたものに外ならないのである。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「ヨサ」や「アリガタサ」を学ぶだけの苦労で、これを楽しみ、これによって衣食する事が出来るのである。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし玄人でも、こうして生まれた能のヨサ、有り難さが解かっていながらに、一と通り芸が出来るようになると、自分独りで豪くなったように思って、恣に羽根を伸したり、新手を編み出したりする者があれば、それは能楽界の外道である。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのヨサをしみじみ感じながら、そのヨサの正体がわからない。",
              "citation": {
                "source": "能ぎらい／能好き／能という名前",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "正直の処、筆者もこの衆口に一致してしまいたいので、これ以上に能のヨサの説明は出来ない事を自身にハッキリと自覚している。",
              "citation": {
                "source": "能ぎらい／能好き／能という名前",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、真実の処、能のヨサの正体をこれ以上に説明すると、第二義、第三義以下のブチコワシ的説明に堕するので、能のヨサを第一義的に自覚するには「日本人が、自分自身で、舞いか、囃子をやって見るのが一番捷径」と固く信じている者である。",
              "citation": {
                "source": "能ぎらい／能好き／能という名前",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人の行先を洩らさない事が運転手のたしなみの第一ぐらいの事はトックの昔から心得ているにきまっている……　……つまり現代のエロ機関の精鋭さは、現代の男女性全体の頭のヨサを超越して行きつつある……日に日にシカゴ化し……巴里化しつつある……　という事をマダムはハッキリと感じておられました。",
              "citation": {
                "source": "奥様探偵術",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "之以上グズグズイウナラ私今清三ヲ起シテ来マスヨサア放シテ頂戴」　トイッテ、私ヲフリ切ッテ二階ニ上ッテ行ッテ了イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亜の役人が旅行券を返しに来たが、令嬢が「ヨサノ」と云つて私のも受取つて呉れた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「停車場までの路が今日は暑いので日本のキモノを着たマダム・ヨサノの徒歩は苦しからう」と夫人が云はれる。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其れから五日ほど経つて、おれは妻と芝居を出て夜の十二時過ぎに自動車で下宿の前まで帰つて来ると、丁度其時門の戸を押して外へ出た女が、おれ達を見附けて、「今晩は、ヨサノさん、ヨサノの奥さん。",
              "citation": {
                "source": "巴里より",
