        "examples": {
          "standard": [
            {
              "text": "祖母の家には、古い趣のある用ダンスが置いてあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は部屋の隅に用ダンスを設置し、細々とした物を収納した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "アンティークショップで、可愛らしいデザインの用ダンスを見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが、ある年、北上川畔の生家へ行った時、土蔵の二階の古い用ダンスをかき回していると、亡き父親の蔵書印を見つけたのである。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
