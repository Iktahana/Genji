        "examples": {
          "standard": [
            {
              "text": "遺産相続の席で兄弟が言い争う姿を見て、人間は欲の固まりだと痛感した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は欲の固まりのような男で、他人の手柄まで自分のものにしてのし上がってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "子供の頃は純粋だったのに、いつの間にか自分も欲の固まりになってしまった気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "谷町の安倍父子はどうなったか、物欲の固まりのような冲左衛門は、八百石から千二百石の大番に出世をし、なお柳沢一派の尾について、その子の又五郎と共に奔命これ努めた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
