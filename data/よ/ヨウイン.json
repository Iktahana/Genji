[
  {
    "uuid": "329ff6ae-f5da-595d-b029-68aa802373c1",
    "entry": "要員",
    "reading": {
      "primary": "よういん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
