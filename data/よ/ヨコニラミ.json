    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "見よかし羆の袖を突出し、腕を頤のあたりへ上げ状に拱いた、手首へ面を引傾げて、横睨みにじろじろと人を見る癖。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "羆は件の横睨みで、「おい、帰るのかあ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、何んにつけても、早く、とまた屹と居直ると、女房の返事に、苦い顔して、横睨みをした平吉が、「だが、何だぜ、これえ、何それ、何、あの貸したきりになってるはずだぜ。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の玉をむき、黙々天下を横睨みに控えてゐるが、如水はすでに川の澱みに落ちたことをさとらない。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
