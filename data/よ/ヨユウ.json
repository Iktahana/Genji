    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然れども其の文章｜亦おのずから佳、前人評して曰く、醇博朗」］、沛乎として余有り、勃乎として禦ぐ莫しと。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "事若し誤らば、この手証は生ながら葬らるべき罪を獲るに余有るものならずや。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貫一はかの生ける宮よりも、この死なんと為る女の幾許幸にかつ愚ならざるかを思ひて、又｜躬の、先には己の愛する者を拯ふ能はずして、今｜却りて得知らぬ他人に恵みて余有る身の、幾許幸無くも又愚なるかを思ひて、謂ふばかり無く悲めるなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "平常状態を維持せんとするも、病を退くるの大道であるが、守れば足らず攻むれば餘有る道理であるから、病むまいとするよりは平常状態以上の健康を得んと力むるも甚だ有效の事である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳ば去年七月｜炮戰之｜騷動御座候由、扨々大騷ぎの事に御座候半、想像仕に尚｜餘有る事に御座候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "其澗内峨々たる岩壁にして其高十丈餘有。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
