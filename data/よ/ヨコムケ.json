        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ガルスワーシーは東洋人の黒いひたむきな四ツの瞳の鋭い視線をいくらか気弱くそらそうとするように室の中央に在る小さな茶テーブルの向う側の低い椅子に腰かけて少しもの憂げなこごみ加減の長身を横向けにした。",
              "citation": {
                "source": "ガルスワーシーの家",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔を横向けたまま、次郎はふるえる声で言った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "弱るじゃありませんか、婆さんがね、けだるそうに腰を伸ばして、耳を、私の顔の傍へ横向けに差しつけたんです。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児を歩行かせるには路が悪いから、見得張らない人だ、またおんぶをして、宿の植込の中から、斜っかいに私の前二階を覗いて、背中の小児に言わせるように、前髪を横向けにして、（お出掛けなさいませんか。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "またそれ以下の人たちのことは、忍耐力の強さ、月日の長さ短さによって、それ相応に好意的な返事をするのだね」　と源氏が言っている間、顔を横向けていた玉鬘の側面が美しく見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "胡蝶",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼んでおいででございます……」　お京、ふっと声を切り、顔を横向け広太郎を見た。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "医師の検査によると、女は束髪に結った面長の美人で、身体はうつぶしになり、顔を横向けてたおれて居たが、右側の背部の肩胛骨の下の所を衣服の上から刺されて、出血のために絶命したものらしかった。",
              "citation": {
                "source": "呪われの家",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞬きをして顔を横向けた。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "周平はされるままに任して、顔を横向けながらちらと保子の方を見上げた。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭を少しずらせ加減に横向けて、周平の方をじっと眺めた。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、いきなり、やつと横向けにしたばかりの男の顔に自分の顔を近づけて、呼吸をたしかめ、やがて、ふところから取り出した大きな握り飯を、その鼻先へ突きつけた。",
              "citation": {
                "source": "この握りめし",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "席から腰を浮かせ、クライスラーの天井に顔を横向けにつけていないと、僕は呼吸が出来ない状態となった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "横向けにした頭をくっつけ合い、天井の下にわずかに残った空間の空気を、僕たちは呼吸した。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "顏を少し横向けに、晝寢している姿で、兩手を投げだしていました。",
              "citation": {
                "source": "いまだ癒えぬ傷あと",
                "author": "――放射線火傷で右手をうしなつた木挽きの妻と河原にうつ伏せて死んでいた幼女に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "来るなりおすえさんの母親は、「まあ子供っちゃなあ」と、大きな声を出して上り框に横向けに腰かけ、袂から赤いマリをそこへ取りだして頭を前に落すような格好で両手をついてあやまりながらも笑った。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
