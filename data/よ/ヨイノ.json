          "literary": [
            {
              "text": "「近日児信重儲古銭数枚、朝夕翫撫、頗有似酒人独酔之楽、因賦一詩。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉でさえ、北陸の丹羽長秀へ出した指令の文の一節には――此表、十四五日｜之内に者、世上｜之物狂も、酒酔之醒たるごとくに（後略）　と見えたりしている。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀吉でさへ、北陸の丹羽長秀へ出した指令の文の一節には、――此表、十四五之内に者、世上之｜物狂も、酒醉之醒たるごとくに（後略）　と見えたりしてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
