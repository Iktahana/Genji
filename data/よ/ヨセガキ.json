    },
    "definitions": [
      {
        "index": 1,
        "gloss": "collection of words or drawings by several people on a single sheet of paper",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "転校するクラスメイトのために、みんなで色紙に寄せ書きをしてプレゼントした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "退職する部長の送別会で、部署のメンバー全員からの心のこもった寄せ書きが手渡された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "卒業式の後、教室の黒板には生徒たちによる先生への感謝の寄せ書きが残されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "編輯後記（大正十五年四月號）『青空』記事梶井基次郎　忽那が三人寄せ書きの後記を書かうと云つて、よしとは云つたもののこれと云つて書く程のことも見付からない。",
              "citation": {
                "source": "編輯後記（大正十五年四月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "繪葉書四五十枚を取り寄せ知れる限りに寄せ書きをした。",
              "citation": {
                "source": "鳳來寺紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "色紙二三枚寄せ書きした。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は僊一郎君治君来訪、方々へ寄せ書きなどした。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅の宿々から郷里へは手紙を寄せ書きした。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日はまるで酔ひどれの下らなさ図々しさを見せるためにお訪ねたやうなものでしたね、寄せ書きした頃から何が何だか解らなくなりましたよ、でも梅若葉のあざやかさ、おひたしのおいしさは、はつきり覚えてゐるから不思議です。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨が全くやまったとき二人は久慈にあてて、チロルの山の恐ろしさ美しさを寄せ書きしてまた遅くまで話し込んだ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿では矢代は千鶴子の部屋で、共通の知人たちをさがして二人で寄せ書きした。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　いつの夏の末だつたか、鶴屋旅館の離れで、芥川さんと室生さんが、同宿の或る夫人のために、女持ちの小さな扇子に發句を寄せ書きなさつたことがあつた。",
              "citation": {
                "source": "萩の花",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "西向きの二階の部屋には、金兵衛が先代の遺物と見えて、美濃派の俳人らの寄せ書きが灰汁抜けのした表装にして壁に掛けてある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐紙を買って来て寄せ書きをやる。",
              "citation": {
                "source": "深川の散歩",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄せ書きをして、吉井先生、久保田さんへ送った。",
              "citation": {
                "source": "随筆　寄席風俗",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう思って考えてみると、伸子がモスク※へ来てから保は二度たよりをよこしたが、二度ともみんなとの寄せ書きばかりだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "動坂の家からは、伸子が東京あてのエハガキをかくよりも間遠に、和一郎がかいたり、寄せ書きしたりした音信が来た。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十日過ぎになって、月見の晩に、「今夜寄せ書きして出したらどうや」と、貞之助が云い出したので、皆賛成して、夕食後、階下の日本間の、お月見の供え物のしてある縁側の近くに、貞之助、幸子、悦子、妙子の四人が集ってお春に墨を磨らせながら巻紙を展べた。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡谷のり子・田村邦男等同車、食堂でデブばかりで寄せ書きを書いたりして楽しく名古屋へ着く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えてみると、ぼくの寝た日本間にも、半双の屏風が立ててあり、それには、石川達三、中野好夫、久保田万太郎、丹羽文雄、亀井勝一郎、横山泰三、かつての文春座文士劇のおりにでも書いたのだろうか、ちょっと判断もつかないような顔ぶれが十数名も入り交じって寄せ書きしていた。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その封筒のなかみは、泰造、多計代、和一郎、保、つや子と、佐々一家のよせがきだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのよせがきには動坂の人たちが、食堂の大テーブルを囲んでがやがやいいながらてんでに喋っているその場の感じがそのまま映っているようだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みなさんのよせがきをありがとう。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の寄せ書がしてあります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "永井荷風氏が褒め、新しい「白樺」の人たち、武者小路、柳、志賀、里見、萱野の諸君までがロダン号の巻頭に寄せ書して、あれを読んで片恋の身に相成候とか何とか盛んに慇懃を通じて来たものだった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝酒、寄せ書、悪筆。",
              "citation": {
                "source": "旅日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "三尺の床の間には、五日前村を出るときかいた源一の寄せ書の日の丸旗やそのほか軍人の手廻りらしい茶鞄の荷物が積まれている。",
              "citation": {
                "source": "その年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔からこの地の名ある太夫の寄せ書を集めたものであろうと、七兵衛は、その和歌の二つ三つを読んでみましたが、自分には読み抜けないのが大分あります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、枕について、それとなく立て廻された六枚屏風を見ると、それは月並のつく芋山水を描いたものでなく、いろいろの文字を寄せ書してある様子が異っているから、また少し枕の向きをかえて見直すと、一目でわかる旅姿の芭蕉の像を描いて、その上に文章が記してある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の傍に円火鉢引寄せ書を読みながら柚味噌煮る楽しみも十二月である。",
              "citation": {
                "source": "写況雑記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄せ書の葉書の上を柳絮飛ぶ六月五日　新京ヤマトホテルに滞在。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは東京の或る女学校の専攻科の人たちが見えたことがあって、その人たちの御礼状であるが、葉書二枚に、一行三十人ばかりで寄せ書をしてよこされたのである。",
              "citation": {
                "source": "低温室だより",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの寄せ書を読みながら、ふと前に言った卵の話を思い出した。",
              "citation": {
                "source": "低温室だより",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
