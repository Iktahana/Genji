[
  {
    "uuid": "087eab65-08a3-528d-83cb-0a8bdc410bae",
    "entry": "寄せ書き",
    "reading": {
      "primary": "よせがき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
