        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この詩のモチーヴとなってるものは、漢詩のいわゆる楊柳杏花村的な南国情緒であるけれども、本質には別の人間的なリリシズムが歌われているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱あるものは、楊柳の露の滴を吸うであろう。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷦鷯のやうに敏捷に身を飜して、楊柳や月見草の叢を潜り、魚を漁つてゐる漁師たちに訪ね合はしてゐる直助の紺の姿と確かりした声が、すぐ真下の矢草の青い河原に見出された。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝に、大慈の楊柳の俤があつた。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三男の隆景は時の人これを楊柳とよんで容姿端麗な武士であった。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、準之助氏が面を吹いて寒からず楊柳の風といったような、おだやかな声でいった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "膳を引くとき、小女郎が入口の襖を開たら、中庭の栽込みを隔てて、向う二階の欄干に銀杏返しが頬杖を突いて、開化した楊柳観音のように下を見詰めていた。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "南岸は崖になつてゐるが、北の岸は低く河原になつて、楊柳が密生してゐる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "俥が橋を渡り尽すと、路は少し低くなつて、繁つた楊柳の間から、新しい吉野の麦藁帽が見える。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "俥が橋を渡り盡すと、路は少し低くなつて、繁つた楊柳の間から、新らしい吉野の麥藁帽が見える。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、舟はすぐ楊柳の浅緑の葉の煙って見える水際の沙にじゃりじゃりと音をさした。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は許宣のあがってくるのを楊柳の陰で待っていた。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "許宣は気が注いて船頭に一言二言別れの詞をかけて、楊柳の陰から走り出て湧金門を入り、ぎっしり簷を並べた民家の一方の簷下を歩いた。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "京口瓜州一水の間、前岸瓜州の楊柳は青々として見えた。",
              "citation": {
                "source": "雷峯塔物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲欄を幾まがりか折れて往くとまた別の庭があって、枝を垂れた数十株の楊柳が高だかと朱の簷を撫でていた。",
              "citation": {
                "source": "西湖主",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は許宣のあがって来るのを楊柳の陰で待っていた。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "許宣は気が注いて船頭に一言二言別れの詞をかけ、楊柳の陰から走り出て湧金門を入って、ぎっしり簷を並べた民家の一方の簷下を歩いた。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "楊柳にたわむれる風も長閑に、岬の白い灯台のまはりを飛んでゐる鴎の群も、誘蛾灯にあつまる昆虫のやうにちいさく、こんな明るい昼日中から夜の舞踏会を待ち焦れてゐるやうに浮れて見える。",
              "citation": {
                "source": "浪曼的月評",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "千曲川の水は黄緑の色に濁つて、声も無く流れて遠い海の方へ――其岸に蹲るやうな低い楊柳の枯々となつた光景――あゝ、依然として旧の通りな山河の眺望は、一層丑松の目を傷ましめた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒寥とした岸の楊柳もところ／″＼。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くつゞく河原は一面の白い大海を見るやうで、蘆荻も、楊柳も、すべて深く隠れて了つた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽船の速力も次第に緩く、岸には赤煉瓦の建物や倉庫らしいものも見え出して来て、縫ふやうに縁に並んで生えてゐる楊柳の緑についさつきから吹き出した蒙古風がすさまじく黄い埃塵を吹きつけてゐるのを眼にした。",
              "citation": {
                "source": "犬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "街路樹の楊柳が枝も幹も地につくまでにたわわに振り動かされてゐるのを見た。",
              "citation": {
                "source": "犬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "をりをり唯遠くの楊柳の枝のたわわに風に吹かれてゐるのが見えるばかりであつた。",
              "citation": {
                "source": "犬",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "（――その一節）……かくの如き人波の中楊柳を折り芙蓉を採る瑶環と瓊珮とを振ひ鏘々として鳴つて玲瓏たり衣は翩々として驚鴻の如く身は矯々として游竜の如し　……と、などゝ、いつまでも歌ひつゞけて。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "また鄭谷の淮上与友人別詩にいふ、揚子江頭楊柳春、楊花愁殺渡江人、数声風笛離亭晩、君向瀟湘我向秦と。",
              "citation": {
                "source": "閑人詩話",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾栽楊柳江南岸、一別江南両度春、遥憶青青江岸上、不知攀折是何人。",
              "citation": {
                "source": "閑人詩話",
                "author": "河上肇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
