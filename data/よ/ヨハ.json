[
  {
    "uuid": "e3ac4e12-edc3-5eea-b0ee-149bd5dca66c",
    "entry": "余波",
    "reading": {
      "primary": "よは",
      "alternatives": [
        "なごり",
        "なごろ"
      ],
      "is_heteronym": false
    },
    "grammar": {
