        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "元来、西洋からしというもの、肝心の辛さが一向辛くなく、第一大切な香味がなっていない。",
              "citation": {
                "source": "日本芥子",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、安価で存在しているものを、なにをもって西洋からしをありがたがるのか。",
              "citation": {
                "source": "日本芥子",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの小麦粉とからし粉を混ぜ合わせたような精気のない西洋からしのいったいどこがよいのだろう。",
              "citation": {
                "source": "日本芥子",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、日本からしは西洋からしのように色が美しくない。",
              "citation": {
                "source": "日本芥子",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを改良したら質においては、西洋からしにまさること数等である。",
              "citation": {
                "source": "日本芥子",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
