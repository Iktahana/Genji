      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "we",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "余等は皆、彼の意見に賛同した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "余等は彼の無事を祈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "余等はこのプロジェクトの成功を信じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼等の下卑で、浅薄で、迷信が強くて、無邪気で、狡猾で、無欲で、強欲で、殆んど余等（今の文壇の作家を悉く含む）の想像にさえ上りがたい所を、ありありと眼に映るように描写したのが「土」である。",
              "citation": {
                "source": "『土』に就て",
                "author": "――長塚節著『土』序――",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に作中の人物の使う言葉が余等には余り縁の遠い方言から成り立っている。",
              "citation": {
                "source": "『土』に就て",
                "author": "――長塚節著『土』序――",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等坊に就きしの故を以て、直ちに内陣に入ることを得たり。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等信州に入るに及びて市場の繁華なるもの皆然り。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとＢも、頬笑んだかと思ふと、この時まで息も切らずに喋舌つてゐたのを、稍暫し眼を伏せたが、突然わけもない声を張りあげながら、盃を執り、余のそれにプロージツトして――そして余等は見事に盃を干した。",
              "citation": {
                "source": "晩春日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の恐るべき殺人犯は何者の所為なるか、余等の探知したる限にては、その筋に於て未だ何等の手掛かりをも得ざるものゝ如し。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "本人の申し立てたる室内の状況は余等が昨日の紙上に記したるところと異ることなし。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等の東京は斯んなに素晴しい装ひを凝して今や初夏の輝やかしい陽の下に生気溢れてゐる。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等は、これらの近代風景を世界に誇り、市民は一勢に立ちあがつて第一文明の建設に余念なき有様である。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の下卑で、淺薄で、迷信が強くて、無邪氣で、狡猾で、無欲で、強欲で、殆んど余等（今の文壇の作家を悉く含む）の想像にさへ上りがたい所を、あり／＼と眼に映るやうに描寫したのが「土」である。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に作中の人物の使ふ言葉が余等には餘り縁の遠い方言から成り立つてゐる。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等は二尺計に開けた雨戸の間から躰の擦れ合うた儘外を見て居たのである。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等が歩いて居る小山の裾に迫つて三角形の眞白な帆を掛けた船が一つ徐ろに其紺碧の水を辷つて走る。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物が漸く動いて余等の前は疎らになつた。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等は肌衣を搾つて女に渡す。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は余等がすつかり草鞋まで穿いてしまつた時、釜から湯を汲んで小皿に少しばかりの干菓子を出した。",
              "citation": {
                "source": "松蟲草",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等の近くに鐵の赤く塗つた勾欄へ倚りかゝりながら遠くを見て居る印袢纒の一群がある。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして其水に立ちながら余等が泳ぐのを見て居る。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "かゝれば余等二人の間には先づ師弟の交りを生じたるなりき。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "本年湯治客にして旭嶽に登りたるは、余等一行に始まる。",
              "citation": {
                "source": "阿武隈川水源の仙境",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "国々に依つて、その名称は異るだらうが、余等が郷国では、「お江戸を見せてやらう。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今では如何か知らないが、余等が幼時、二十年近くも前の話だ。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　即ちこれは、余等の幼時に往々用ひたる脅し文句だつた。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等が幼時の、甲の態度とは黒白の差であること勿論である。",
              "citation": {
                "source": "余の倅に就いて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "祠前に掛茶屋の老爺、余等を呼びとめて、拜殿より左へ男體山に上りて、女體山より下らるゝが順路なりといふ。",
              "citation": {
                "source": "春の筑波山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼びかはす聲も霞に消えゆきて　　夕影寒し男筑波のやま　下りゆく程に、余等遂に路を失ひぬ。",
              "citation": {
                "source": "春の筑波山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "之に當りては大變なりと、すばやく足を以て其岩を踏み、身體しばらく餘裕を得て、傍らの樹につかまりて、余等二人は止まることを得たれど、その餘勢は岩に傳はりて、ころび始めぬ。",
              "citation": {
                "source": "春の筑波山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　人力車との競爭余等は、今房州を去らむとする也。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "余等二人は、ひそかに脚力の強きを恃める也。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、するどき薄刃をさげ、左手をもつて敵手に揖す、はや東雲あくる楢の林に、小鳥うたうたひ、きよらにわれの血はながれ、ましろき朝餉をうみなむとす。",
              "citation": {
                "source": "決鬪",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
