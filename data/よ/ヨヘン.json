        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四十余篇、全部の書き出しを、いま、ここに並べてみたいほどです。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "萩原朔太郎詩集例言一、過去三年以来の創作九十余篇中より叙情詩五十五篇、及び長篇詩篇二篇を選びてこの集に納む。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "茲に収められた七章八十余篇の詩は、明治四十二年の二月（邪宗門出版当時）より大正二年の四月（朱欒廃刊迄）に至る、概ね四ヶ年間の制作であつて、恰度私の青春の花期に当つてゐる。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めオペラや悲劇喜劇等の劇作をしていたが、後寓話を書くに及んで揺ぎなき一家をなし、凡そ三百二十余篇の寓話を残した。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて過去数年間新聞に出した草稿が今では積って二十余篇になった。",
              "citation": {
                "source": "「古琉球」自序",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百余篇も集まった応募文から、何故そんな判りきった誤謬をもったこの一文が当選したのだろう？",
              "citation": {
                "source": "反動ジャーナリズムのチェーン・ストア",
                "author": "――森鶴子君に答える――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「七歳ヨリ綴ル所ノ詩筆、四十｜載、向フ矣、約千有余篇」　こんなことも書いてある。",
              "citation": {
                "source": "岷山の隠士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八三一年から終焉の二年前、最後の作となった「現代史の裏面」に至るまでに書かれた大小百余篇の作品の箇々についての穿鑿は、更に適当な研究者の努力に俟たなければなるまい。",
              "citation": {
                "source": "バルザックに対する評価",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オルフォイスに捧ぐるソネット」と呼ばれる五十余篇のソネットがそれである。",
              "citation": {
                "source": "雉子日記",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度出してみると引込んでいることが出来なくなり、それから先きは友達の嘱みに応じていつも小説のような文章を書き、積り積って十余篇に及んだ。",
              "citation": {
                "source": "「吶喊」原序",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃上人ノ詩ノ尤モ傑スル者百有余篇ヲ採リ、マサニ併セテコレヲ梓セントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ長短二百余篇、固ヨリ皆連城ノ明珠ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗祖岡本綺堂先生は、この点に眼を注がれ、作物の中に、季感と江戸の年中行事を取り入れて、『半七捕物帳』の成功を生んだと言えるのである、試みに六十余篇の遺作のうち一つを読んだだけでも、紙面にあふるる季感に、読者万人は打たれずにはいないだろう。",
              "citation": {
                "source": "銭形平次打明け話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十一）　詩は昔三千余篇あったが、孔子はこれを整理して三百五篇とした。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真実であるならば、「古えは詩三千余篇ありき。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう次第でとうとう筆を折らなければならなくなったが、三百八十余篇の「銭形平次」を愛読してきてくださったみなさんに心からお礼を申上げたいと思う。",
              "citation": {
                "source": "平次と生きた二十七年",
                "author": "――筆を折るの弁――",
                "note": "青空文庫"
              }
            },
            {
              "text": "光文社発行の少年探偵団叢書二十何冊全部のほか、ポプラ社で発行している、私のおとな向きの長篇を少年ものに書きなおしたもの十余篇をも取り入れたのである。",
              "citation": {
                "source": "自作解説",
                "author": "怪人二十面相と少年探偵団",
                "note": "青空文庫"
              }
            },
            {
              "text": "是に於て孤憤、五蠧、説難諸篇すべて五十餘篇を著はす。",
              "citation": {
                "source": "韓非子解題",
                "author": "小柳司気太",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れの生涯中三十七歳から六十三歳まで、人生の最盛期二十七年間は、本國に意を得ないでドイツ、イタリア等に漂泊の生活を送り、『ブランド』以下『ヘッダ・ガブレル』に至る十餘篇の劇をそのあひだに作つた。",
              "citation": {
                "source": "『人形の家』解説",
                "author": "島村抱月",
                "note": "青空文庫"
              }
            },
            {
              "text": "其後も斷えず新曲が製出されて遂に千有餘篇にも及んだが、後世に至つて自然に廢れたものも少からず、近代は二百曲内外を以て普通とすることになつた。",
              "citation": {
                "source": "父兄の方々に",
                "author": "和田萬吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "本書收むる所余が新舊の作四十餘篇素より一として詩の名稱を享受するに足るものあらず。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
