    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to include",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "全員を寄すれば100人になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもも寄すと家族は5人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "これらの経費を計算に寄すべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "〔われらひとしく丘に立ち〕宮沢賢治われらひとしく丘に立ち青ぐろくしてぶちうてるあやしきもののひろがりを東はてなくのぞみけりそは巨いなる塩の水海とはおのもさとれども伝へてきゝしそのものとあまりにたがふこゝちしてたゞうつゝなるうすれ日にそのわだつみの潮騒のうろこの国の波がしらきほひ寄するをのぞみゐたりき",
              "citation": {
                "source": "〔われらひとしく丘に立ち〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、連れ出した男を此の世に於ける唯一の寄すがり者のやうに思へる心に浮々した足取で、そのフェルトをペタペタ夜道に打つつけながら、解雇された仲間で一番給料も多かつた男の下宿の方に歩んだ。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨催の空濁江に映りて、堤下の杭に漣※寄するも、蘆荻の声静かなりし昔の様尋ぬるに由なく、渡番小屋にペンキ塗の広告看板かゝりては簑打ち払う風流も似合うべくもあらず。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒き浜辺にマルガレエテが歩み寄するヴェールを風に千々にされながら。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは福慈神に向って娘としてよりも母らしいものへの寄する情に近かった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒波、どッと押し寄する処。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "渦いて寄する風の音、遠き方より呻り来て、どっと満山に打あたる。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央の木目から渦いて出るのが、池の小波のひたひたと寄する音の中に、隣の納屋の石を切る響に交って、繁った葉と葉が擦合うようで、たとえば時雨の降るようで、又無数の山蟻が谷の中を歩行く跫音のようである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは貴様は宇宙に神秘なしと言うお考なのです、要之、貴様には此宇宙に寄する此人生の意義が、極く平易｜明亮なので、貴様の頭は二々が四で、一切が間に合うのです。",
              "citation": {
                "source": "運命論者",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "一と二と寄すれば三となる。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そなたの道力の進むにつれて、この糸はわしの世界をそなたの世界に手繰り寄する便りになるのじゃ。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こなたは、盛りは四天王、金札打った独武者、羅生門よし、土蜘蛛よし、※々、狼ももって来なで、萌黄、緋縅、卯の花縅、小桜を黄に返したる年増交りに、十有余人の郎党を、象牙の撥に従えながら、寄すれば色ある浪に砕けて、名所の松は月下に独り、従容として名を得る口惜しさ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい次ぎつつ、お沢の落葉を掻寄する間に、少しずつやや退る。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく近づいた跫音は、件の紫の傘を小楯に、土手へかけて悠然と朧に投げた、艶にして凄い緋の袴に、小波寄する微な響きさえ与えなかったにもかかわらず、こなたは一ツ胴震いをして、立直って、我知らず肩を聳やかすと、杖をぐいと振って、九字を切りかけて、束々と通った。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央の木目から渦いて出るのが、池の小波のひた／＼と寄する音の中に、隣の納屋の石を切る響に交つて、繁つた葉と葉が擦合ふやうで、たとへば時雨の降るやうで、又無數の山蟻が谷の中を歩行く跫音のやうである。",
              "citation": {
                "source": "三尺角",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ビジテリアン諸氏に寄す。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "追へども撃てども敵も強者、再び寄する七隻の堅艦、怒濤は逆卷き、風荒れて、血汐に染みたる海賊の旗風いよ／＼鋭く、猛く、此戰何時果つ可しとも覺えざりし時。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより何等同情を寄すべき記述などがあらう筈はなかつた。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "さなきだに葬礼法会ありしと聞けば、魚の腸に寄する鳶のごとく十里を遠しとせざる輩が、しかも丁寧に告知らせしに、召に応ぜざるはそもいかに、貴婦人方は本意なげなり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "患者が顔を差寄すれば、綿なす湯気は口に漲り、頬を蔽い、肩を包み、背に拡り、腰に纏うて、やがて濛々としてただ白気となる。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――打寄する浪に就いて、いま言はう。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "語を寄す、天下の宗教家、渠ら二人は罪悪ありて、天に行くことを得ざるべきか。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "横の町も、縦の町も、角も、辻も、山下も、坂の上も、隣の小路もただ人のけはひの轟々とばかり遠波の寄するかと、ひツそりしたるなかに、あるひは高く、あるひは低く、遠くなり、近くなりて、耳底に響き候のみ。",
              "citation": {
                "source": "凱旋祭",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）して、その子之介と申すは、いつの頃より當家に身を寄することゝ相成りましたな。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "有名になった事が左程の自慢にはならぬが、墨汁一滴のうちで暗に余を激励した故人に対しては、此作を地下に寄するのが或は恰好かも知れぬ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "上代純朴なる時代に男女の詠めりし秋草に寄する心を聞けば　　　　　日置長枝娘子　　秋づけば尾花が上に置く露の消ぬべくもわが念ほゆるかも　　　　　大伴家持　　吾が屋戸の一枝萩を念ふ児に見せずほと／＼散らしつるかも　萩、桔梗、女郎花は私に山を想はせ、刈萱は河原を、そして撫子と藤袴は野原を想はせる。",
              "citation": {
                "source": "秋の七草に添へて",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕王は太祖の第四子、容貌偉にして髭髯美わしく、智勇あり、大略あり、誠を推して人に任じ、太祖に肖たること多かりしかば、太祖も此を悦び、人も或は意を寄するものありたり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑って看る　黄屋　団瓢を寄す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "すわや政宗寄するぞ、心得たり、手を出さば許すまじ、弾丸振舞わん、と鉄砲の火縄の火を吹いて居る勢だ。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸が、そんなにこわかったら、作家をよすことである。",
              "citation": {
                "source": "緒方氏を殺した者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
