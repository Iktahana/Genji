    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――歌唱詩人オスワルドは、ヴェントシン（ヒヨスの毛茸ならんと云わる）を入れたる酒を飲むと見る間に、抱琴を抱ける身体波のごとくに揺ぎはじめ、やがて、妃ゲルトルーデの膝に倒る。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凶鐘にて人形（カラギヨス――土耳古（トルコ）の操人形）を喚び覚ませ、奢那教徒ども（仏教と共通点の多い姉妹的宗教）は地獄の底に横たわらん。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タバヨス木精蓮と云う熱帯種でね。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその時、厨川君は見当を付けて昼間のうち一本水浸しにして置いた、タパヨス木精蓮の中へ落したのだよ。",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、アペルレースアレキサンダー王に事えた時プトレマヨスと快からず。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨスヨスヨスと云いおる中に、三匹か五匹ぐらいはチャンと余計に数えております。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "英の旗艦の水師提督はクーパー、司令長官はウ※ルモット、船長はジヨスリングと云う人で、書翰を薩摩の役人に渡し、応否の返答｜如何と待て居る。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラインゴルドで午食をして、ヨスチイで珈琲を飲んで、なんにするという思案もなく、赤い薔薇のブケエを買って、その外にも鹿の角を二組、コブレンツの名所絵のある画葉書を百枚買った。",
              "citation": {
                "source": "襟",
                "author": "オシップ・ディモフ　Ossip Dymoff",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユダヤ人アカン、エリコの分捕品の中より金銀若干を盜みしかば、ヨシュア（ヨスエ）人々に命じ石にてこれをうちころさしむ（ヨシュア、七・一以下）一一二―一一七第四例、サツピラとその夫アナニア。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなる大詩人にも良き材料を供給するほど三四―三六〔今〕異本、今の字なし〔その疾き火〕雲の火即ち電光三七―三九〔ヨスエ〕ヨシュア。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "競輪には不正がなく、競輪ファンという劣等人種が幻覚上に事を起し、事を好むにすぎない、という決定的な結論を与えるヨスガとなり易いのである。",
              "citation": {
                "source": "光を覆うものなし",
                "author": "――競輪不正事件――",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリッケイまた山多きイトウメーの地占むる族、オイカリエーのユウリトス嘗つて領せし其都城、　730これらを占むる民族をアスクレーピヨス生める息、ポダレーリオス、マカオーンすぐれし二人の醫は率ゆ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも夜なべ仕事に拵えるので、お父様がお薬を調合してお出しになると、大きな乳鉢でつなぎになる薬を入れ――ヒヨスもはいったようでした――乳鉢で煉り合せ、お団子くらいのよいほどの固さになった時、手に少し油を附けて、両手で揉んで、右の親指の外四本の指先に少しずつ附けて、左の掌で丸めるのです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この銭湯の主人公の姓名を今なお不思議に記憶しているのも、スンマツスツジウスツバンツスズキヨスキツとそのお上さんたちが言った言葉をその後になって口癖のように面白がって繰返していたからである。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "学究とか隠者とか、生活から距てられた骨董的老人が、愛読し、そして現代をのゝしるヨスガとする性質の、それも亦骨董品の一つではないかと私は考えているのである。",
              "citation": {
                "source": "現代とは？",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "定メシソノ刹那ニハ七十年来ノ生涯ニ積ミ重ネタ悪事ノ数々ガ走馬燈ノヨウニ次々ト現レルダロウナ、アヽ貴様ハアンナコトモシタ、コンナコトモシタ、ソレデテ楽ニ死ノウナンテ虫ガヨスギル、今苦シムノハ当リ前ダ、ザマア見ヤガレ、―――ドコカデソンナ声モ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初は自分に試し次いで病院で種々の薬を使うことによってシュテルクはドクニンジン、イヌサフラン、トリカブト、チョウセンアサガオ、ヒヨスの効果を研究し、その経験について短い判りやすいモノグラフを書いた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "内ノ者共ツヅイテ込入、即時ニ攻破ツテ天主ニ詰メヨスル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央骨喜堂、ウェル骨喜堂、大陸骨喜店、国民骨喜店、クレップス氏珈琲店、シルレル骨喜店、ヨスチイ骨喜店、骨喜店はカフェーのあて字。",
              "citation": {
                "source": "カフェー",
                "author": "勝本清一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇は、木の國の造のアラカハトベの女のトホツアユメマクハシ姫と結婚してお生みになつた御子はトヨキイリ彦の命とトヨスキイリ姫の命お二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹のトヨスキ姫の命は伊勢の大神宮をお祭りになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はマンドラゴラ、ヒヨス、および多分ケシ汁の麻酔剤を使い、緩下剤として「マーキュリー」と呼ばれた植物物質（ヤマアイ）、ビート、キャベツを盛んに使い、スカモニアおよびエラテリウムのような腸内浄化下剤を使うのを躊躇しなかった！",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉦を「ヨスケ」、〆太鼓二丁、大太鼓一丁、トンビと四つを助けるので四助け。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
