        "examples": {
          "standard": [
            {
              "text": "祖母は色とりどりの寄せ切れを縫い合わせて、孫のために温かいベストを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "着物の端切れを集めた寄せ切れで、小さな巾着袋を仕立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古い浴衣の寄せ切れを使って、台所に置くコースターを縫った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "あの、いつかの奥様みたいな方が持ってきた手箱もあるのよ」「あら、そう、あのよせぎれ細工の手箱が」　房枝は、道子夫人からいただいた手箱が焼け残っていたと聞いて、とたんに、なつかしく、夫人のことが思い出された。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "よせぎれ細工の手箱であった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜個所だけ、よせぎれの色がかわっているんだけど、あの爆発で、色がかわってしまったのかしら」　ふしぎなことを、スミ枝がいい出した。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかのところのよせぎれが、ちりめんだの、紬だの、黄八丈だののりっぱなきれで、ここだけがメリンスなのねえ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
