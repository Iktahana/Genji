        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カノ昆布ノ森ノ女学生ヨリモ、モット、シズカニ考エタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ山ハ私ガ実際ニ感ジルヨリモアマリ平面ノヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメガ　ヤムト　マヘヨリモ　イツソウ　アタタカナ　ヒノ　ヒカリガ　ソソギマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代世界ヲ展開セシメタル三大發明ノ中火藥ガ人類ヲ殺スヨリモ甚シク、印刷術ノ害毒全世界ノ頭腦ヲ朽蝕腐爛シ盡クセリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ヲ口舌ノ鬪爭ニ慣習セシムルハ其天性ヲ殘賊スルコト之ヲ戰場ニ用ユルヨリモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ國家ノ生産的利益ノ方面ヨリ見ルモ、幼童ニシテ殘賊スルヨリモ其ノ天賦ヲ完全ニ啓發スベキ教育ヲ施シタル後ノ勞働ガ幾百倍ノ利益ナルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸ク中世史ノ革命ヲ學ビツツアル未開後進ナル彼ニ對スルニハ現代的再建ヲ想像スルヨリモ、反動ノ襲來又ハ眞乎ノ建國者ニヨリテ「ピーター」大帝ノ再現ヲモ打算外ニ置ク能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ分配ヨリモ國際間ノ分配ヲ決セザレバ日本ノ社會問題ハ永遠無窮ニ解決サレザルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英人ヲ直譯スル輩ハ「レニン」ヲ宣傳スルヨリモ百倍ノ有害ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此レ徃年露西亞ノ滿洲ニ進出シタルヨリモ支那ノ一大危機。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ノ恩惠ノ下ニ青島ニ租借地ヲ得ルヨリモ、英國其者ノ香港ヲ奪ヒテ日本ノ海軍根據地トセヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東苦力トシテ輸出セザルベカラザルホドニ人口漲溢セル支那ノ貧弱ナル一角ニ沒頭スルヨリモ、支那其ノ者ヨリ廣大ニシテ豐饒ナル英國ノ濠洲ヲ併合セヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンダオ父ッチャヨリモヤセテ、カミノケガヌケテ、ネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "古人ノ語ニ、一身ヲ自由ニシテ自ラ守ルハ、万人ニ具ハリタル天性ニシテ、人情ニ近ケレバ、家財富貴ヲ保ツヨリモ重キコトナリト。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニヨリモ、カラダヲ、タイセツニ、イノリマス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニヨリモ、カラダヲ、タイセツニ、イノル、フウトウ、イレテオキマス、ヘンジクダサイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の行になって“ハ、人間ヨリモ恐ロシイ”で、またあとが切れている」　幽霊船に近よるな、吾等は……？",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "發見後十五分位ノ後ニハ遙ニ南々西ノ方向（附圖ニヨルト、吾妻橋西詰ノ方ラシイ）ニ前ヨリモ高ク上空迄暗雲中ニ象鼻状（見取圖略）ノ白氣ガ搖レナガラ立昇ルヲ見タ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキツト私ヲ返スダラウト思ヒマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "妓ヲ揚ゲル玉ヲシテ玉川ノ砂利ヨリモ多ク、妾ニ投ズル金ヲシテ深川ノ薮蚊ヨリモ多ク、了簡ノ浮々シタルハ海ニ在ル水母ヨリモ軽ク、鼻ノ下ノ延ビ過ギタルハ電信ノ張鉄ヨリモ長ク、智慧分別ハ雨夜ノ蛍火ヨリ少ナク、行跡ノ見苦シキハ折助ノ附合ヨリ甚シカラシム。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "廿三日　船見分此日夷人ヨリモ奉行ヘ引合邸留守居ヘ談ズ。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ婆サンハ何ヨリモ『アグニ』ノ神ガ怖イノデスカラ、ソレヲ聞ケバキット私ヲ返スダロウト思イマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "那珂氏が博士の説に對して此ノ山門郡ハ、筑前ナル國々ト相近クシテ、魏志ノ行程ニ合ハザルコトハ、近藤氏ノ山門郷ヨリモ甚シ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "打スレバ則チ棒ヨリモ利アリ、刺ストキハ則チ刃ヨリモ利アリ、両ナガラ相済フ、一名ヲ棍ト曰フ、南方ノ語也、一名ヲ白棒ト曰フ、北方ノ説也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
