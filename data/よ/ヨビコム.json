        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の店は、ユニークな商品で多くの客を呼び込んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "イベントを開催して、地域の活性化と観光客を呼び込みたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の明るい笑顔は、自然と周囲の人を呼び込む魅力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "まだ我樂多文庫の發刊に成らない以前と思ふ……大學へ通はるゝのに、飯田町の下宿においでの頃、下宿の女房さんが豆府屋を、とうふ屋さんと呼び込む――小さな下宿でよく聞える――聲がすると、「媼さん、又豆府か。",
              "citation": {
                "source": "湯どうふ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実父が亡くなつてから訪れて来る舅は何時も村はづれの海辺にある半下宿風の家を宿にしたが、娘達には会はうとはせず樽野一人を呼び込むのであつた。",
              "citation": {
                "source": "円卓子での話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の塊の中から可愛らしいお光を見出して家へ呼び込む。",
              "citation": {
                "source": "東光院",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎月八日は、彼の勤め先である安酒場――お銚子一本通しものつき十銭、鍋物十銭の、実に喧騒を極めた――女たちの客を呼び込む声、泥酔した客たちの議論、演説、浪花節、からかひと嬌声、酒のこぼれ流れてゐる長い木の食卓、奥の料理場から、何々上り！",
              "citation": {
                "source": "日本三文オペラ",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが不思議なことに、母が出かけるとすぐ、父は必ず、自分の寝そべっている玄関脇の三畳の間へ叔母を呼び込むのであった。",
              "citation": {
                "source": "父",
                "author": "金子ふみ子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中洲真砂座といふ芝居の横手の路地にも銘酒屋｜楊弓場軒を並べ、家名小さく書きたる腰高障子の間より通がかりの人を呼び込む光景、柳原の郡代、芝神明、浅草公園｜奥山等の盛況に劣らず。",
              "citation": {
                "source": "桑中喜語",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、外から見たときは、男を呼び込む女の聲が、惡寒を感じたほど哀れな悲鳴にきこえたが、かうして内から覗いて見ると、窓先を群がり過ぎる男共が、一種奇怪な原始動物に見えた。",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　八五郎がお百合とお若を呼び込むと、二人はつゝましやかに、平次の前に並びました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "苫三七の娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵は外れて太鼓へドン、一隅に長火鉢を据えて例の白首が二、三人、長煙管を手にして表を眺め、「ちょいと眼鏡の旦那」「シャッポの兄さん」など、大ぴらに呼び込む。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "文代を縛り終った明智と二郎とは、外の警官を呼び込む前に、先ず敵の様子を探って置こうと、まるで泥棒みたいに足音を盗んで奥へ奥へと忍込んで行った。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "給仕長の圭さんは、白い上着を酒瓶の蔭にかくしてなにか整頓に夢中になっているように見せて置いて、然るのち、その蔭に鈴江をよびこむと、春ちゃんの機嫌をわるくするようなことを言っちゃならねぇぞと、薄気味わるい表情と口調とで、訓戒を与えるのだった。",
              "citation": {
                "source": "電気看板の神経",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "幽霊を本気でこの部屋へ呼びこむんですかね」　古島老刑事は、蜂矢探偵の姿が消えると、さっそく課長の机の前へいって詰問した。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから先祖の魂も呼びこむつもりだ。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう１つは他のすべての心の科学と同じように、曖昧であること、神秘的なこと、その表現を規定できないこと、ペテンおよびペテンを呼びこむのに抵抗できない貪欲な騙されやすさの希望を持てない空気に囲まれていること、である。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "折から貸ボート屋の桟橋には舷に数知れず提燈を下げた凉船が間もなく纜を解いて出やうとするところらしく、客を呼込む女の声が一｜層甲高に、「毎度御乗船ありがたう御在ます。",
              "citation": {
                "source": "吾妻橋",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "折から貸ボート屋の桟橋には舷に数知れず提燈を下げた涼船が間もなく纜を解いて出ようとするところらしく、客を呼込む女の声が一層｜甲高に、「毎度御乗船ありがとう御在ます。",
              "citation": {
                "source": "吾妻橋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、番頭さん、遠慮することはねえ、親分は見通しだ、ズツと入つて來なさるがいゝ」　ガラツ八は表の方へ身體をねぢ曲げて、門に立つてゐる人を呼込むのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "白紙の恐怖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ親分、これが本銀町の淺田屋の番頭で、幸吉さんといふんだが、兎にも角にも、一つ話を聽いてやつて下さいよ」　ガラツ八は平次の引込み思案にものを言はせないやうに、外に待たした客を呼込むと、萬事心得て平次の前へ押しやるのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "白紙の恐怖",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい、手代さん、遠慮することはねえ、親分は見通しだ、ズッと入って来なさるがいい」　ガラッ八は表の方へ身体をねじ曲げて、門に立っている人を呼込むのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "白紙の恐怖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ親分、これが本銀町の浅田屋の手代で、幸吉さんというんだが、とにもかくにも、一つ話を聴いてやって下さいよ」　ガラッ八は平次の引込み思案にものを言わせないように、外に待たした客を呼込むと、万事心得て平次の前へ押しやるのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "白紙の恐怖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
