        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また四月英国の閉塞隊がベルギー海岸のドイツ潜水艇の根拠地を襲撃した場合にも、味方の行動を掩蔽するために煤煙の障屏を使用しようとしたのが肝心の時に風が変って非常の違算を来たしたという事である。",
              "citation": {
                "source": "戦争と気象学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり大小の群星には二つの党派があってそれぞれの根拠地より出でて互いに入り乱れつつも目ざす処に馳せ行くがごとき有様である。",
              "citation": {
                "source": "宇宙の二大星流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "平安時代になつて、坂上田村麻呂が遠く北へ進んで蝦夷の根拠地をうち破り、胆沢城（今の岩手県水沢町附近）を築いて鎮所となしたとあるが、津軽まではやつて来なかつたやうである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは海峡の一部に出来るイギリス海軍根拠地の大工事だと、社長は説明した。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世に人間という形を以て現れて来まして、いろいろの芸当をやって見せますが、時期が来れば楽屋裏の大生命の根拠地へ帰らねばなりません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ＡＳＣＩＩ』にはアメリカの雑誌で仕入れたねたを中心にパーソナルコンピューターの最新動向をまとめていたが、本拠地を移せばより新鮮な情報を直接つかみ、水滴をまとった桃のようなみずみずしい記事が書けるに違いないと思えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの外面的な情実から、家族は国家の柱石、資本主義の根拠地となっている。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで穴倉の底を根拠地として欣然とたゆまずに研究を専念に遣つてゐるから偉い。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "根拠地のない戦争の様なものである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく、マヌエラのあとを蛇のように追う、ヤンを加えドドを連れて、まずさいしょの根拠地となるコンデロガへ発ったのである。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の根拠地となるマコンデ部落にはいったのが、翌日の午過ぎだった。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "枳園は大磯を根拠地として、中、三浦両郡の間を往来し、ここに足掛十二年の月日を過すこととなった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に秀吉は中国の入口に然るべき根拠地を見いだそうとして、播州で名高い古城の址を調べさせた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤松が初めて築いたものか、赤松以前から存在したものか判然しないのであるが、とにかくに赤松以来その名を世に知られ、殊に羽柴筑前守秀吉が中国攻めの根拠地となるに至っていよいよ有名になったのである。",
              "citation": {
                "source": "小坂部伝説",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし所詮かれらの根拠地は小劇場であって、市村座以外の大劇場へはひと足もふみ込むことが出来なかった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は山をめぐる躑躅の茂みを根拠地として、朝に晩にそこらを這い歩いて、日中にも平気で出て来た。",
              "citation": {
                "source": "二階から",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "陶の方からも勿論来援を希望してあったので、この二百艘の船が厳島へ漕ぎ寄するかと見る間に、二十日市（毛利方の水軍の根拠地）の沖へ寄せたので、毛利方は喜び、陶方は失望した。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "海陸運輸の便があり、嘗つて、北条氏、足利氏等の九州征略の際にも、博多はその根拠地となった程である。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "口津村の甚右衛門は、嘗つて有馬氏の治政時代に在った古城の原を無二の割拠地として勧め、衆みな之に同じたから、いよいよ古城を修復して立籠る事になった。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に正成の本拠であった河内東条と、行宮のある吉野は、官軍の二大作戦根拠地であった。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い都を根拠地として考えている私は、父や母から見ると、まるで足を空に向けて歩く奇体な人間に異ならなかった。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本道なら初さんなんどを頼りにしなくっても、自力で日の当る所まで歩いて出て見せるが、何しろ、長年掘荒した坑だから、まるで土蜘蛛の根拠地みたようにいろいろな穴が、とんでもない所に開いている。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人がもし後架から四隣に響く大音を揚げて怒鳴りつければ敵は周章てる気色もなく悠然と根拠地へ引きあげる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "やあ遅かったと思ううち、彼の制帽は馳け足の姿勢をとって根拠地の方へ韋駄天のごとく逃げて行く。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が至る所に容れられぬのは、学問の本体に根拠地を構えての上の去就であるから、彼自身は内に顧みて疚しいところもなければ、意気地がないとも思いつかぬ。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間の許す限り世の評家と共に過去を研究して、出来得る限りこの根拠地を作りたいと思う。",
              "citation": {
                "source": "作物の批評",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで穴倉の底を根拠地として欣然とたゆまずに研究を専念にやっているから偉い。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し僕が代議士に打つて出る時になれば、あちらが根據地だらう。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "而テ支那保全主義ヲ堅持スル日本ハ彼トノ衝突ニ於テ、其ノ支那經略ノ根據地香港ノ有害ナルコトハ、日露戰爭ニ於ケル旅順浦鹽斯徳ノ根據地ニ優ルトモ劣ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ノ恩惠ノ下ニ青島ニ租借地ヲ得ルヨリモ、英國其者ノ香港ヲ奪ヒテ日本ノ海軍根據地トセヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
