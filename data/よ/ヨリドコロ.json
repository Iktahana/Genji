        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "困難な状況の中、家族が私の心の拠り所となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、先輩のアドバイスを唯一の拠り所にして仕事を進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "どんな時も、彼らが私の確かな拠り所だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
