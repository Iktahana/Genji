        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "村の人達の湯にはまた溪ぎわへ出る拱門型に刳った出口がその厚い壁の横側にあいていて、湯に漬って眺めていると、そのアーチ型の空間を眼の高さにたかまって白い瀬のたぎりが見え、溪ぎわから差し出ている楓の枝が見え、ときには弾丸のように擦過して行く川烏の姿が見えた。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が顔を洗う前足の横側には、毛脚の短い絨氈のような毛が密生していて、なるほど人間の化粧道具にもなりそうなのである。",
              "citation": {
                "source": "愛撫",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時忽ち私の横側の倚子で頻りに嘲笑つて居る聲、それは例の鷲鳥聲の婦人だ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "武村兵曹は私の横側で五里霧中の顏。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴底の横側が踏板の縁にこすれて軽くささくれ立っているのが、私にも見て取れた。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲野さんも、宗近君もこの精舎を、もっとも趣きある横側の角度から同時に見上げた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰皿の上に竪に挟んだ燐寸箱の横側をしゅっと擦った。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、乳色をした清々しい光線が差し込んでき、その反映で、闇の中から、梁も壁も、妙に白ちゃけた色で現われてきて、その横側がまた、艶々と黝ずんで光っているのだった。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一軒の家の横側に、ペンキの大字で楽器製造所と書いてある。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "大村が横側の後に腰掛けたので、純一も並んで腰を掛けた。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙切れは幾枚かを紙撚で繋いで、机の横側に掛けてあるのである。",
              "citation": {
                "source": "あそび",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の跨がっている坑の直前は背丈位の石垣になっていて、隣の家の横側がその石垣と密接している。",
              "citation": {
                "source": "鼠坂",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいにく横側に窓が付いていないので、強い光はどこからも射さなかった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その飾窓の横側に斜に嵌め込んである鏡を覗いて今一度私の変装姿を印象すべく……。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチコフがこの奇妙きてれつな部屋飾りを眺めまわしている間に、横側の扉があいて、さっき庭で逢った家政婦が入って来た。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから今度は反対側へ小首を傾げて、横側から鼻を眺めた。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が経つにつれ、授業の間の十分の休憩時間には、私は控所の横側の庭のクローウヴァーの上に坐つて両脚を投げ出した。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下を行こうとした梅の家連の女たちは、幸七に引き止められて、追われるように、すぐ横側の部屋へ上った。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "影人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に机の脇の本箱の横側にかけてあった丸善の『日めくり暦』に目をつけ、何思ったかそれを取りあげて熱心に撥繰っていましたが、やがて、「あった、あった」と叫びました。",
              "citation": {
                "source": "髭の謎",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンデリラという短い手銛のような物を、正面または横側から牛の背部、首根っこへ近いところへ二本ずつ打ち込む。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "台石の横側に、○永四歳（丁亥）十月二日と彫ってある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……おやすみですか」　頭を出せば、ベッドの横側に立てるは、小使いなり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、傷口を仔細に調べてみると、傷口は横側のほうが浅く、咽喉仏へ行くほど深くなって、とたんに顎のほうへ刎ねあげられている。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "鎌いたち",
                "note": "青空文庫"
              }
            },
            {
              "text": "写字机と置戸棚の間にあった三稜剣が壁の隅のほうへ寄り、前列にならんでいたジャヴァの土壺がすこしばかりうしろへひきさげられ、そのかわり、今までは横側しか見えなかった油絵が、正面に向きかえられている。",
              "citation": {
                "source": "キャラコさん",
                "author": "雁来紅の家",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
