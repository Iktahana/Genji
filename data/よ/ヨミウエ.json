        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　悪むものは毛虫、と高らかに読上げよう、という事になる。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "読上げんでも可からうといふ声がした。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "読上げんでも可かろうという声がした。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "軈て、三年二年一年といふ順で、新たに進級した者の名が読上げられたが、怎したものか私の名は其中に無かつた。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『春の夜の――』と山内が妙に気取つた節で読上げると、『万歳ツ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが鎮まると教師が児童出席簿を読上げる声。",
              "citation": {
                "source": "道",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはナイル河底の冥府の法廷で、今から一千九百六十五年前に、記録係のトートの神が読上げた、神秘的な、薄嗄れた声が大空の涯から引返して来た旋律に相違なかった。",
              "citation": {
                "source": "髪切虫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて捨札の読上げ終るや、矢来の片隅に控へ居りし十数人の乞食ども、手に／＼錆びたる槍を持ちて立上り来りアリヤ／＼／＼／＼と怪しき声にて叫び上げつゝ初花太夫を残したる九人の左右に立ち廻はり、罪人の眼の前にて鑓先をチヤリ丶／＼と打ち合はし脅やかす。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "参りました」影の大統領「これが、君のマイクの前で読上げる布告文だ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "』執達吏の読上げて居る書籍は此春郷里の兄から頒けて呉れた亡父の遺物である。",
              "citation": {
                "source": "執達吏",
                "author": "與謝野寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、川口検事によって起訴状が読上げられた。",
              "citation": {
                "source": "それに偽りがないならば",
                "author": "――憲法の規定により国民の名において裁判する――鈴木裁判長",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕やさしいつる草八月三十一日（木曜）　西沢公判第一日　検事の読上げた決定書には四つの罪名があがっているが、呼出状や拘留更新の書つけには死体遺棄が一つよけいに加わっている。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "上件四月廿四日上陸より此所に至ル迄認候処を其儘勘定組頭清水半左衛門、高柳楠之助、成瀬国助の前ニ而読上候ヘバ、廿五日夜のところを高柳の正ニよりて改ム。",
              "citation": {
                "source": "坂本龍馬手記",
                "author": "イロハ丸航海日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "能の場面に手紙を読上げる場所がいくつもあるが、この『甘泉殿の春の夜の夢』で始まる手紙は、恐らく人を動かす感情で満ちる点で、随一の大文章であらう。",
              "citation": {
                "source": "能楽論",
                "author": "野口米次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "町奉行石川土佐守殿は文治の口供ばかりではございませぬ、幾枚も一度に持参いたしますると、正面に松平右京殿その外公用人御着席、それより余程｜下って町奉行が組下与力を従え、その口証を一々読上げて、公用人の手許迄差出します。",
              "citation": {
                "source": "後の業平文治",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このクレーヴン君が家の中で蒐集した物件の品名目録を今読上げてもらうから聞いて下さい」「しかし蝋燭がなくてはどうもならんなア」とクレーヴンが不意に言った、「どうやら暴模様になって来たようだし、これでは暗くて読めん」「時にあなたがたの蒐集中に蝋燭らしいものがあったかな？",
              "citation": {
                "source": "作男・ゴーの名誉",
                "author": "THE HONOUR OF ISRAEL GOW",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では目録を読上げてみましょう」とクレーヴン探偵は鹿爪らしい顔をして一枚の紙を取上げた。",
              "citation": {
                "source": "作男・ゴーの名誉",
                "author": "THE HONOUR OF ISRAEL GOW",
                "note": "青空文庫"
              }
            },
            {
              "text": "では読上げましょう――　第一項　おびたゞしい宝石の山。",
              "citation": {
                "source": "作男・ゴーの名誉",
                "author": "THE HONOUR OF ISRAEL GOW",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めて出られた時、自分が好む本だからと、新井白石の『藩翰譜』を持って来られて、右手を隠しに入れ、左の手に本を持って、生徒の机の間を歩きながら読上げられます。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを表に現して読上げますと次の通りになります。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後ろには、寺社奉行の検使をはじめ、札番書留役、札番読上役などが控え、本堂の奥では、引続き読経の声、鐘の音に和して、これが何とも言えない悲愴陰惨なものだったそうです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "富籤政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一番札、鶴の一千二百三十四番」　読上役がそれを高々と読み上げると、「ワーッ」　境内はさながら大波の寄せたような有様。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "富籤政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "でなければ、読上役が手品を使ったか、――いや、そんな事はとても考えられません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "富籤政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "シェクスピア・坪内逍遙訳の「じゃ／″＼馬ならし」読上る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、ボーイ体の男が番号を読上げるに従って、私達三十四人の男女は、丁度小学生のように、そこへ一緒に並びました。",
              "citation": {
                "source": "覆面の舞踏者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "手短かに事の始終を告げ、授けられた一封の書状を讀上げる。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが一｜枚あれば何處の神社へ行つても役に立てゝ居るものと見えて短い文中に讀上ぐべき神社の名は書いてなくて何郡何村何神社といふ文字で埋めてある。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "軈て、三年二年一年といふ順で、新たに進級した者の名が讀上げられたが、怎したものか私の名は其中に無かつた。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『春の夜の――』と山内が妙に氣取つた節で讀上げると、『萬歳ツ。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "（とて先生は三十餘年前に認めたる古めかしき一册の手帳を取出して讀上げられたる其文は左の如し）　十三日朝第八時ロシフルトは巴里より佛里法九十里にある佛蘭西の海軍港なり。",
              "citation": {
                "source": "明治三十一年三月十二日三田演説會に於ける演説",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
