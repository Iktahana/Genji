        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一面識ナキ小生ヨリノ失礼ナル手紙御読了｜被下度候。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "下乗之事禁中ヨリノ御使イ、並ビニ江戸公儀ヨリノ御使者以外ニ夜中ノ通行堅ク御差止メノ事　はっきりと禁裡御所からのお使い、並びに江戸お公儀からの使者以外は、夜中の通行堅くお差止めの事と書いてあるのです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時ヨリノ天皇ハ純然タル政治的中心ノ意義ヲ有シ、此ノ國民運動ノ指揮者タリシ以來現代民主國ノ總代表トシテ國家ヲ代表スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ借家ヲ以テ利得ヲ爲ス者ハ家屋其者ヨリノ利得ニシテ、地上權ニ伴フ利益ヲ計上スルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "生産的各省ヨリノ莫大ナル收入ハ殆ド消費的各省及ビ下掲國民ノ生活保障ノ支出ニ應ズルヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「レニン」政府ノ尚存續シテ陸上ヨリノ援助ヲ假想ストモ、決定的成否ハ已ニ海軍力ヲ喪失セル露國ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ貴局ヨリノ受信シタル通信文ヲ逆ニ送信スベキヤ」相手「ソノ必要ナシ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴局ヨリノ質問アリヤ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（同巻ヲ倒ニシテ巻首ヨリノ中程ニ突然ト左ノ数行アリ）廿三日　将軍坂ニ下ル○廿三日ハ乙丑ノ九月ナリ校正者識廿四日夜　大坂ニ下ル。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチハ　トシヨリノ　イヌデス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同一地方ニ於テモ時代ヲ異ニスレバ固ヨリノ事、假令同一時代ナリトモ、種族ヲ異ニスル石器時代人民ノ棲息スル事有リ得ベカラザル事ニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナリン太子殿下横浜御出航以来御不例｜予テ船医ニ於テ流行性｜脳脊髄膜炎ト診断船中ニ於テ御加療中ノ処病勢御険悪発熱三十九度五分｜囈言アラセラレ、嘔吐数回嗜眠状態ニアラセラルル旨イキトス号船長ヨリノ無電ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "大使館ニ於テハ取敢エズ更ニ詳報｜方船長ニ向ケ打電同時ニ別掲容態表｜並ニ乗組船医二名ノ手ヲ｜以テ最善ヲ尽ス可キ旨同船長ヨリノ回答ニ接シタリ。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして残る最後の一通は、　ナリン殿下薨去ノ趣前掲通牒ノ如クナレドモ、御遺骸移送ニ際シテハ特ニ慎重ナル可キ旨、イキトス号船長ヨリノ無電ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚｜為念、従者ラジック・シャアナルモノハ殿下御看護ニ際シ感染本日午後一時三十分死去水葬ノ趣唯今イキトス号船長ヨリノ無電ニ接ス。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
