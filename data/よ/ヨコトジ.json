        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このパンフレットは横綴じになっているので、見開きで大きく写真が載せられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "横綴じのアルバムに、旅行で撮った風景写真を順番に貼っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "企画書を横綴じで印刷した方が、図表が見やすくなるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "堺屋出入りの諸屋敷の分は一切あつめて横綴じの厚い一冊に書き止めてあるのであるから、小幡という名を一々拾い出して行くだけでも、その面倒は容易でなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "横綴じになっている桜痴居士直筆の原稿を渡されて、賢二が二幕、わたしが三幕を浄書するはずのところを、賢二は劇場の仕事が忙がしいというので、わたしが序幕から四幕目までを引受けることになった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まずうちへ帰ると婆さんが横綴じの帳面を持って僕の前へ出てくる。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、捜索隊の一人が、山の古宮の境内の青萱の中から拾ったとて、美濃横綴じの手帳を持って来た。",
              "citation": {
                "source": "壁の眼の怪",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その、横綴じの長い帳面の表には「発願奇特帳」とある。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「八丁堀合点長屋店人釘抜藤吉捕物｜覚書」という題で遺っている、大福帳のような体裁の、半紙を長く二つ折りにした横綴じの写本である。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "宙に浮く屍骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "半紙を横綴じしたものへ、矢立の墨で書いたらしい粗末な旅行メモである。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内わきの、左手の庵室、障子を閉して、……たゞ、假に差置いたやうな庵ながら構は縁が高い、端近に三寶を二つ置いて、一つには横綴の帳一册、一つには奉納の米袋、ぱら／＼と少しこぼれて、おひねりといふのが捧げてある、眞中に硯箱が出て、朱書が添へてある。",
              "citation": {
                "source": "遺稿",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……又膝栗毛で下司ばる、と思召しも恥かしいが、こんな場合には繪言葉卷ものや、哲理、科學の横綴では間に合はない。",
              "citation": {
                "source": "遺稿",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "堺屋出入りの諸屋敷の分は一切あつめて横綴の厚い一冊に書き止めてあるのであるから、小幡といふ名を一々拾ひ出して行くだけでも其面倒は容易でなかつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "境内わきの、左手の庵室、障子を閉して、……ただ、仮に差置いたような庵ながら構は縁が高い、端近に三宝を二つ置いて、一つには横綴の帳一冊、一つには奉納の米袋、ぱらぱらと少しこぼれて、おひねりというのが捧げてある、真中に硯箱が出て、朱書が添えてある。",
              "citation": {
                "source": "遺稿",
                "author": "遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "……又膝栗毛で下司ばる、と思召しも恥かしいが、こんな場合には絵言葉｜巻ものや、哲理、科学の横綴では間に合わない。",
              "citation": {
                "source": "遺稿",
                "author": "遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「魔道伝書」ようございますか、勿論、板本でなし、例の貸本屋を転々する写本でなく、実にこの婆さんの兄の間淵が秘蔵した、半紙を部厚に横綴の帳面仕立で。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "間淵は見えないで、その煎餅蒲団のかかった机の上に、入船帳の蔽を抜けて、横綴の表紙が前申した、「魔道伝書」、題ばかりでも、黙って見たままで居られますか。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "横綴の茶の表布の少しは汗に汚ごれた角を、折るようにあけて、二三枚めくると、一｜頁の三が一ほど白い所が出て来た。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の小机には半紙を二枚折にした横綴の帳面を数冊載せてあった。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半紙二つ折りの横綴の古帳に、事細かく、當時流行つた御家流の書體で達者に書きしるしてある。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは想像にもつかれ、さりとて読むべき雑誌も持って来なかったので、包みの中から洋紙を横綴にした手帳を出して、鉛筆で日記をつけ出した。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は旅に行く時には、いつもその横綴の小さな拾遺の方を持つて行つた。",
              "citation": {
                "source": "大阪で",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして売り上げた品名と代価とを一々横綴の帳面に記入する外には、これといふ仕事はなかつた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを抜き取って、つぎに懐中から、懐紙を二つに折った横綴の帳面を取りだした。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下で、雁皮紙を横綴にしたものへ、真書き筆で、こまごまと父への手紙をかく。",
              "citation": {
                "source": "中條精一郎の「家信抄」まえがきおよび註",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お銀様は行燈の下の机によって、忙しく昨晩こしらえた横綴の帳面を繰りひろげて見ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "慢心和尚の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　坊さんは日本紙を横綴にした帳面を繰り開きながら、出て来て、「わかりました。",
              "citation": {
                "source": "吾妻橋",
                "author": "永井壮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の書いた字は横綴の大幅帳には不似合なやうな字ではあつたが其でも容易く讀む事が出來たが、自分の病氣で寢て居つた時や其他の場合に時々照ちやんなどの附けた字には讀みにくいのが多かつた。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一新講の宿屋に泊ると、初旅の人には街道筋の講中の宿屋の名を載せた、三五版十枚許りを横綴にして、表紙には赤丸の中に開の字を白く抜き、其下に一新講社と書いた帳面に、泊った宿屋では其名の下に判を捺し、次に泊る可き駅の旅籠屋へ宛てた案内状（私はそれを送り状と呼んでいました）を添えて渡します。",
              "citation": {
                "source": "登山談義",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半紙｜横綴の分厚な帳面ですが」「それがどうした」「お終ひの三、四日分のところを、※り取つてあるんです」　番頭の源介は、腑に落ちない樣子で、大福帳を撫でてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "影法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは凄い」　時々は死体の前に踞んで、懐から出した半紙横綴の帳面に矢立の筆を抜いて――細雨をかばい乍ら、写生の筆を走らせました。",
              "citation": {
                "source": "芳年写生帖",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄い小さな横とじの豆本なのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう名前と、数字と、品物とが、横とじの帳面に無数につづいている。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
