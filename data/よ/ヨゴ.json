          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "手術は成功したが、予後にはまだ時間がかかるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "重い病気から回復し、静かな環境での予後を過ごしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "患者にとって、治療後の予後をいかに良好に保つかが重要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
