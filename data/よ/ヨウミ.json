    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "神仙妖魅霊異の事も半信半疑ながらにむしろ信じられて居りました。",
              "citation": {
                "source": "馬琴の小説とその当時の実社会",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その郷里のある女が妖魅に取りつかれた時に、寿は何かの法をおこなうと、長さ幾丈の大蛇が門前に死んで横たわって、女の病いはすぐに平癒した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その信念が追々堕落する事、ギリシアローマの詩に彫刻に盛名を馳せた幽玄絶美な諸神が、今日｜藪沢に潜める妖魅に化しおわったごとくなったものか。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また諸鬼、妖魅、悪精、巫蠱を司る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は如何に禅僧の如くに悟つてのけんと試むるとも、我が心宮を観ずること甚深なればなるほど、我は到底悟つてのけること能はざるを知る、風流の道も我を誘惑する事こそあれ、我をして心魂を委ねて、趣味と称する魔力に妖魅せらるゝに甘んぜしめず。",
              "citation": {
                "source": "我牢獄",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "少時、劇に誘はれて大江山の鬼を観たりし事あり、三尺の童子たりし時にすら畏怖の念よりも寧ろ嘲笑の念を抱きたりしを記憶す、而して大江山の鬼は土蜘蛛等と共に中古の鬼物なり、是を彼のバツグビーア、ウイツチなどに比較せばいかに、その妖魅力の差違いかに遠きかは一見して知るべし。",
              "citation": {
                "source": "他界に対する観念",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "至妙なる絵画、能く人を妖魅す、然れども絵画の妙工も一種の妖魅力に過ぎざるを奈何せむ。",
              "citation": {
                "source": "松島に於て芭蕉翁を読む",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "古へより文士の勝景を探る者未だ迷宮に入らざるに、未だ妖魅を受けざるに、未だ造化の秘蔵に近かざるに、先づ筆管を握つて秀句を吐かんとする者多し。",
              "citation": {
                "source": "松島に於て芭蕉翁を読む",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は彫琢したる巧句を得べし、然れども妖魅せられざる前の巧句は人工なり、安んぞ神霊に動かされたる天工の奇句を咏出する事を得んや。",
              "citation": {
                "source": "松島に於て芭蕉翁を読む",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "一たび妖魅せらるゝは、蓋し後に澄清なる識別を得るの始めなるべけれ。",
              "citation": {
                "source": "松島に於て芭蕉翁を読む",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "元よりそのくらいでございますから、狐の憑きましたのも、天狗の憑きましたのも、あるいはまた、何とも名の知れない、妖魅鬼神の憑きましたのも、あの十文字の護符を頂きますと、まるで木の葉を食う虫が、大風にでも振われて落ちるように、すぐさま落ちてしまいました。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見すれば極めて古怪なる妖魅の集い――　彼等は、拍子に合わせて、さんざんに踊ると、赤頭に猩々の面をかぶったのが、「いかにおのおの方、大儀に覚え候ぞ、一休み致して、また踊ろうずるにて候ぞ」　謡がかりの口調でいうと、「畏まりて候なり」　一同が踊りをやめて休息に入る。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その適例は『古今妖魅考』に、「下総国香取郡万歳の後山へ、村の者ども五人連れ立って木こりに行きけるに、少しかたえなる山の端に、常のよりは汚気に見ゆる鵄一つ羽を休めいたり。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分妖魅に富んだ代ものだ。",
              "citation": {
                "source": "河童酒宴",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲州の山奥駒ヶ岳の方から出てくるのが釜無川、甲武信ヶ岳の方から出てくるのが笛吹川、この二川が、鰍沢の地先で合流すると流れは俄然大河の姿を現して、巌を噛む激湍に妖魅さえも感ずる。",
              "citation": {
                "source": "弟子自慢",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もの云うごとに玉虫色の唇は、妖魅の如き美しさを湛える。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐の妖魅をなす事｜和漢めづらしからず、いふもさらなれどいふ也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "こはかれが一時の戯れなるべし、かゝる妖魅の術はありながら人に欺れて捕へらるゝは如何。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪のせ笹の金紋が、薄暗いその部屋の隅に、妖魅めいた光を放って――。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "本は例によって、篤胤の「鬼神論」とか「古今妖魅考」とかいう種類のものだった。",
              "citation": {
                "source": "百面相役者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
