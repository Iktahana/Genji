    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼女は、荒んだ心と、処女としての新鮮さと、未亡人としての妖味とを兼ね備へた美しさと、その美を飾るあらゆる自由とを以て、何時となく、世間のあらゆる男性の間に、孔雀の如く、その双翼を拡げてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、荒んだ心と、処女としての新鮮さと、未亡人としての妖味とを兼ね備えた美しさと、その美を飾るあらゆる自由とを以て、何時となく、世間のあらゆる男性の間に、孔雀の如く、その双翼を拡げていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でも私の好きなのは、あくまで白く塗った妖味豊かなろくろ首の女であった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "月日が経った上に、西洋の寂莫と芸術で苦労したものか、最近はその顔に不思議な妖味を現して来ました。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
