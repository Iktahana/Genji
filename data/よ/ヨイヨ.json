        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハハイヨイヨワルシ」ダザイイツコクモハヤクオイデマツ」ナカバタ　北さんは、そんな電報を私に見せた。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――デカンショ、デカンショと半年暮す、ヨイヨイ……。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "でかんしょ、でかんしょと、山家の猿は、ヨイヨイ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "でかんしょ、でかんしょで、半年ゃ暮らす、ヨイヨイ、あとの半年ゃ寝て暮らす。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨイヨイヨイのヨイヨイヨイだ」　この夜こそ旧暦の盂蘭盆であった。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも品夫はその小説を読んでから、そんな気になったのじゃないかと思うんですが……」「ハハア……」　と黒木はイヨイヨ感動したらしく、片手で鼻の下を撫でおろした。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヨイヨ素敵ですな。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとから新聞の写真を持って行って見せると、丸髷になっとるもんだからイヨイヨ首をひねるんだ」「フーン。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "与九郎奴の追放は薩藩への面当にも相成るでな」「イヨイヨ面白いでは御座らぬか。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "余に刃向う程の小伜なればイヨイヨ面白い。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一足｜毎に、そこいら中がギシリギシリと鳴って、頭の上の天井の隙間からポロポロとホコリが落ちて来たのにはイヨイヨ驚いた。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなところで」　若い親方の返事がイヨイヨ苦しそうである。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけにどこへ連れて行かれるんだかテンキリわからないんだからイヨイヨ以て痛快だ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "安島二郎氏はイヨイヨ椅子の中へ縮こまった。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と叫び出したいような気持ちを、ジッと我慢しながら……そうしてヤットの思いで気分を取り直すと、虎蔵はイヨイヨ静かにベコニヤの鉢の間を抜けて、綺麗に刈り込んだ芝生の上に匐い上った。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはイヨイヨ奇妙なお話ですナ。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……だから私が夢中になって、自分の名前を問うと同時に、ピッタリと口を噤んで、無言の裡に、私の焦燥をイヨイヨの最高潮にまで導こうと試みたのであろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "況んや当世流行の紳士待遇でも与えようものならイヨイヨ病癖が増長して、イヨイヨ止むを得なくなって来る。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……諸君が何か知ら考え詰めてアタマの疲れた時分にウットリと凝視している、アノ取止めのない空想とか、妄想とかいうものがソレで、そのうちに脳髄がイヨイヨ疲れて眠り込んで来ると、そんな意識同志の連絡もイヨイヨ絶え絶えになって来る。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなると又、その恋しい係りの交感台の交感嬢がイヨイヨやり切れなくなってヘタバリ込む。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋しい意識がイヨイヨ完全に遊離して活躍空転する。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで吾輩のこの世に於ける用事もハイチャイを告る事になるのだ……と云ったら又、頭のいい痴呆患者が出て来て……そんならイヨイヨ発狂自殺だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに幽霊と間違えて逃げ出さないところはイヨイヨ感心だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おります」「……ウム……いる……ところでその青年は今、ドッチを向いて突立っているかね」　私は正木博士の質問が、いよいよ出でてイヨイヨ変テコになって来るので、妙な気持ちになりながら答えた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そいつを見ると芬子さんイヨイヨ気の毒になって、天を白眼んで安禄山の奸を悪んだね。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
