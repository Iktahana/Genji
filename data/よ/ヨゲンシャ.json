[
  {
    "uuid": "541069ed-df43-5a6a-a001-3935625cb839",
    "entry": "預言者",
    "reading": {
      "primary": "よげんしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "prophet",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古代イスラエルの預言者たちは、王の堕落を厳しく非難し、悔い改めを迫った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "神の言葉を伝える預言者として、彼は迫害を受けながらも教えを広め続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "砂漠の民は、いつか現れると約束された真の預言者の到来を待ち望んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "モーゼや預言者の時代であったら、あの工科大学の学生は、国の賢者のひとりとなったにちがいありません。",
              "citation": {
                "source": "人形つかい",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、預言者ヨエルの言葉が書いてありました。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し私をキリストに導くところの預言者ヨハネのやうに考へて居る。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何れの時代にも預言者あり、大預言者あり、小預言者あり、其宗教に、其思想に、彼等は代表者となり、嚮導者となるなり、彼等は己れの「時」を代表すると共に、己れの「時」を継ぐべき他の「時」を嚮導するなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "イザヤは其慷慨｜凛凄なる舌を其「時」によりて得たり、而して其義奮猛烈なる精神をもて、次ぎの「時」の民を率ゐたり、カアライルの批評的眼光を以て覗へば、預言者は其精神を死骨と共に棺中に埋めず、巍然として他の「時」に霊活し、無声無言の舌を以て一世を号令するものなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "古昔の預言者は近世に望むべからず、近世の預言者は文字の人なりと言へる、己れ自ら一預言者なるカアライルの言を信ずることを得ば、我は徳川氏時代に於ける預言者を其思想界の文士に求めざるを得ず。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "然り、何れの時代にも或一種の預言者あることを疑はざれば、我は文士を以て最も勢力ある預言者と見るの他なきなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざ、是等平民社界の預言者に就きて、その至粋を招きて理想となしたる跡を尋ねて見む。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "右は難波と江戸との理想の異色を観察したるのみ、元より侠と言へば江戸に限り、粋と言へば難波に限るにあらず、われは爰に預言者の声を吟味し、その代表する「時」を言ひたるに過ぎず。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して徳川氏以前にありては、彼等の思想として余に存するもの甚だ微々たり、徳川氏以後世運の漸く熟し来りたるを以て、爰に漸く、多数の預言者を得て孚化したる彼等の思想は、漸く一種の趣味を発育し来れり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に彼等の中に起りし預言者も、一は彼等の趣味に投じ、一は己れの所見に従ひて、自から忠孝即ち武士の理想をもつて平民に及ぼす事なき能はず、これ即ち封建制度に普通なる現象にてあるなり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯の如き、変遷の時代にありては、国民の多数はすべての預言者に聴かざるなり、而して思想の世界に於ける大小の預言者も亦た、国民を動かすに足るべき主義の上に立つこと能はざるなり。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を以て思想界に、若し勢力の尤も大なるものあらば、其は国民に向つて極めて平易なる教理を説く預言者なるべし。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "再言すれば敢て国民を率ゐて或処にまで達せんとする的の預言者は、斯かる時代に希ふ可からず。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は実に平民に対する預言者の張本人なり。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども吾人を以て福沢翁を崇拝するものと誤解すること勿れ、吾人は公平に歴史を研究せんとするものなり、感情は吾人の此塲合に於て友とするものにあらず、吾人は福沢翁を以て、明治に於て始めて平民間に伝道したる預言者なりと認む、彼を以て完全なる預言者なりと言ふにはあらず。",
              "citation": {
                "source": "明治文学管見",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "営々たる街頭の商児、役々たるレボレトリーの化学者、紛々たる新聞屋の小僧、彼等も亦た彼の預言者と、彼の英雄と、彼の詩人と、其帰着する運命を同うするなり。",
              "citation": {
                "source": "頑執妄排の弊",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "預言者の先見は夢の如くにして而して事実なる事あり、商売人の蓄財は事実の如くにして而して夢なる事あり。",
              "citation": {
                "source": "熱意",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は凡ての預言者的人物の如く生涯真知己を得ることなく、傲逸不遜｜磊落奇偉の一人物として、幾百年の後までも人に謳はれながら、一の批評家ありて其至真を看破し、思想界に紹介するものもなく今日に及びぬ。",
              "citation": {
                "source": "心機妙変を論ず",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "預言者のもと、神の御手に導かれるのみである。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三章　ジョン・フェリアと預言者の対話　ジェファースン・ホープとその仲間たちがソルト・レイク・シティを去り、三週間経った。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間、預言者とその教えについて不思議に思うことを親友にしゃべったとしても、その親友が夜にはその一味となって銃と剣をもち、血で贖えと押し込んでくるかもしれないのだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
