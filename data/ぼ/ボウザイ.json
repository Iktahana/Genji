    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "広い桜の生わった野道を、多勢の子供にぞろぞろとあとをつかれながら、赤いトルコ帽に、あさぎの服を着た楽隊を先頭にして、足に高い棒材でつぎ足しをし、顔を白粉や何で可笑しくそめた男が、ジョーカーのような帽子をかぶって、両手をはげしく振り、腰を曲げて調子をとりとりねって行く。",
              "citation": {
                "source": "「禰宜様宮田」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "片側通行止で、まだ工事につかったセメント樽、棒材、赤いガラスをはめこんだ通行止の角燈などがかためて置いてある。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "道ばたにセメント樽、曲った古レール、棒材がころがっている。",
              "citation": {
                "source": "モスクワの辻馬車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "棒材がなげ出してある。",
              "citation": {
                "source": "新しきシベリアを横切る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰か、棒材を持った奴がロマーシを襲った。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
