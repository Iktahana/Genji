        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "上り口をちょっと入った処に、茶の詰襟の服で、護謨のぼろ靴を穿いて、ぐたぐたのパナマを被った男が、撥で掌を敲きながら、用ありそうに立っている。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはぼろ靴でほうぼうが修理してあったが……。",
              "citation": {
                "source": "一坪館",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、もともとぼろ靴なのでせう。",
              "citation": {
                "source": "太一の靴は世界一",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなぼろ靴をつくろふのにも、ねんにねんを入れるのです。",
              "citation": {
                "source": "太一の靴は世界一",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともとこんな女におっ惚れた俺でもあるめえしさ……とにかく今になっちゃあこんな赤禿げだらけの猫婆ァの面よか、ソネートカのぼろ靴下の方がよっぽど有難えや。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやになるねえ、いつまでも寒くて、この大雪じゃ、わしのぼろ靴で歩くのはこたえまさあね」と、大声でいいながら、戸口でぶるぶるっと雪をはらって、時計屋のテッディ・ヘンフリイが寒そうにはいってきた。",
              "citation": {
                "source": "透明人間",
                "author": "ハーバート・ジョージ・ウエルズ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼろ靴のおかげで、私が辷ったら、皆は私を嗤うのよ。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "この暑いのに合服を着て、ボロ靴をはいて、失業者みたいなみすぼらしい恰好でしたよ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは川面の漣波に、蘆荻のそよぎに、昼顔の花に、鳥のさえずりに、ボロ服とボロ靴にあるのではないか。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "亀のチャーリーは相もかわらず貧乏で冬じゅう何も食わぬ二匹の亀の子とボロ靴下を乾したニューヨークの小部屋では五セントの鱈の頭を食って暮しているがピオニイルはゾクゾク殖えてゆくという物語を、五章からなるエピソード的構成で書いているのである。",
              "citation": {
                "source": "一連の非プロレタリア的作品",
                "author": "――「亀のチャーリー」「幼き合唱」「樹のない村」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "癩者はボロ靴のやうに療養所といふごみ箱に捨てるのが人類の正しい発展となるのでせう。",
              "citation": {
                "source": "外に出た友",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分がボロ靴であることを意識しました――　眼帯をはづして、私はその手紙を読んだ。",
              "citation": {
                "source": "外に出た友",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "わらじ、ボロ靴、ゴム足袋、木靴、洋装、和装、裸装、あらゆる労働的色彩が睡眠不足な蠢動をしている。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
