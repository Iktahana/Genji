        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "親は子に隠し、子は親に隠さなくちゃ読み得ない、つまりちょび髭社長が文化的ぼろ儲けと見当をつけたところさ。",
              "citation": {
                "source": "陽気な客",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「根室の金原君も上海に来てるそうだが、あれもそのぼろ儲けをしているのかな」「もちろん……」と百成は言った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてどういうぼろ儲けをしているかを、俺が問いもせぬのに、次のように説明した。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かボロもうけして成りあがったらしい。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "終戦後、鉄カブトを改造して飯ガマを製造販売してボロもうけをした男が「うっちゃって置けば鉄カブトなんか廃品になるんだ。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カミサン子供の焼死なんざ、ボロもうけの夢心持のマンナカにはさまったサンドイッチみたいなものさ。",
              "citation": {
                "source": "出家物語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
