        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の頃の記憶は茫々としていて、はっきりと思い出せない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の話は茫々としていて、結局何が言いたかったのかわからなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "茫々とした不安に包まれ、夜も眠れない日が続いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
