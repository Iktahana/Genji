          "literary": [
            {
              "text": "ボーウ、ボーウとサイレンが　出船みたいになつてゐる。",
              "citation": {
                "source": "島",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーウと、高く汽笛の音がしました。",
              "citation": {
                "source": "昼のお月さま",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶどう色に空は暮れて、ボーウと、サイレンが鳴りひびきました。",
              "citation": {
                "source": "夕焼けがうすれて",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "（列車の響近づき、汽笛の音がジョンの声をかき消すようにボーウ、ボーウと高原一帯に遠くこだまして鳴りひびく、大の遠吠。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
