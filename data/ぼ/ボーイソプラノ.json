        "examples": {
          "standard": [
            {
              "text": "教会の合唱団で、彼のボーイソプラノの歌声は天使のように美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その映画のサウンドトラックには、感動的なボーイソプラノのソロが収録されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "変声期前の少年だけが持つボーイソプラノの澄んだ歌声は、聴く人を魅了する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「バカッ」　高らかなボーイ・ソプラノが、その時橋の向う側、井伊様屋敷のあたりで高鳴ります。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の美しいボーイ・ソプラノは、二年間の確固たる地位を約束したばかりでなく、教会付属学校の図書室には、ドイツ、オランダ、イタリーの傑作曲楽譜が夥しく用意され、彼の飽くなき知識欲に資したことは、なんという幸せであったことであろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィーンの教会のボーイ・ソプラノに編入されたのは八歳のときで、しばらくは作曲家ロイターの監督の下に音楽の修業を積んだ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十一日（土曜）　十時半起き、道子鎌倉の姉のとこへ行くので、一緒に出て日比谷映画劇場へ、「ボビーの初舞台」てのを見る、ボーイ・ソプラノの何とか少年がとてもいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
