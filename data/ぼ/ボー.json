    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さうして港の波止場に訪ねくるとき、汽船のおーぼーといふ叫びを聞き、檣のにぎやかな林の向うに、青い空の光るのをみてゐると、しぜんと人間の心のかげに、憂愁のさびしい涙がながれてくる。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "松住町から湯島臺へ上つて行く左手のバラツク屋根のなかゝら、茫然とした空に向つてへんにどぼーん／＼と立つてゐる四五本の銀杏樹――それにははつきり誘惑された。",
              "citation": {
                "source": "編輯後記（大正十五年九月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "糺の森がぼーっと霞んで見えなくなる。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "のっぺらぼーの仏様が一つせっせと地面掘ってんのよ。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "明いて居た窓から、薄寒い風が、すっっと這入って来て、五分心の裸ランプが、ぼぼぼーと油煙を吐き始めた。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その幹深く枝々を透して、ぼーッと煤色に浸んだ燈は、影のように障子を映して、其処に行燈の灯れたのが遠くから認められた。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といふやうな穴のなかからの聲が、ぼーつとした感じできれぎれに聞える。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "齒を食ひしばつてぢつと堪へてゐるうちに眼の前がぼーつと暗くなり、意識が次第に痺れて行くのが自分にもわかるのである。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢臺の上に一寸立上つても貧血のために目の前がぼーツとかすむやうになると、彼はしばしば幻影に惱まされ始めた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると二人の反對の側に臺に向つて腰をかけてゐる書記の前に細長い箱がおかれてある、その箱の中から外へ、ぼーつと仄かな晝の電燈の光りがもれた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はぼーつとした氣持になつて、一杯になつた桶を擔ひ棒で擔つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "氣がついてみると、ぼーつと白いものが眼に映つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "駿介は彼女のぼーつと白い顏と、その口の動くのとを見た。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台の上にちょっと立ち上っても貧血のために目の前がぼーッとかすむようになると、彼はしばしば幻影に悩まされ始めた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "車置き場でぼーっとしていると、ぼろを着た少年がジェファースン・ホープという運ちゃんはいるかと訪ねてきて、ベイカー街二二一Ｂの紳士が馬車をご指名だと言うのです。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな時分は訳もわからず、ぼーっとしているから、他哩のないものなのよ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "膳に向っても、水にでも浸っていたように頭がぼーッとしていて、持ちつけぬ竹の塗り箸さえ心持が悪かった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "神経が急にざわざわと騒ぎ立って、ぼーっと煙った霧雨のかなたさえ見とおせそうに目がはっきりして、先ほどのおっかぶさるような暗愁は、いつのまにかはかない出来心のしわざとしか考えられなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭の中は熱を持って、ただぼーと黄色く煙っていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半身が痲痺したり、頭が急にぼーっと遠くなる事も珍しくなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "方々へ無事帰庵のハガキを書く、身心がぼーつとしてまとまらない、気永日永に養生する外ない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、ぼーっとしてきて、私はねむってしまいました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、たちまち眼の前の、ぼーっとした仄暗い空を切り裂いて、青光りのする稲妻が、二条ほどのジグザグを、竪にえがいた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪くいと云う念を通り過すと張り合が抜けてぼーとする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼーとしたあとは勝手にしろ、どうせ気の利いた事は出来ないのだからと軽蔑の極眠たくなる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "沈んで白けて怒つて居るよりも、むしろ、黒けて浮んで笑つて居る方が、何ぼーいゝか解りやしない。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　――どこからかぼーが聞えて来た。",
              "citation": {
                "source": "親方コブセ",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼーッと眼の前が霞んで来た。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼうっとしてしまえ。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　そんな風に、ぼうっとしてしまえ、という風に考えていると、考えというものは、いけないものである。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
