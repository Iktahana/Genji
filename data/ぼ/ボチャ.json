        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」往来を、大きなカボチャを三つ荒縄でくくって背負い、汗だくで歩いているおかみさんがある。",
              "citation": {
                "source": "やんぬる哉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "○＝門前　左膳と山左が七兵衛の手と足を持って一、二、三で側の小川へボチャンと投げ込んだ。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供らが丸裸の背や胸に泥を塗っては小川へはいってボチャボチャやっている。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉の薄い目尻の下った、ボチャボチャした色白の顔で、愛嬌のある口元から金歯の光が洩れていた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "五寸ほど芽の出掛かった椰子の実の落ちているのを蹴飛ばすと、水の中にころげ入ってボチャンと音を立てる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　誰かプウルの縁を歩いて行くものが小石をとばしたと見えて、ボチャンと小さな音が、彼の足のさきの方で聞えた。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩井の場合にかぎらず、画家が一個のリンゴなりカボチャなりを前にして描き出すとき、そのカボチャの実在的な大きさつまり実物の寸法より、画布の上に一巡り大きく描くといふこと、反対に一巡り実物より小さく描くといふことに対して果してその画家はどれだけの良心が働いてゐるだらうか。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボチャンという、微かな音がしました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂丸ボチャの愛嬌顔で、派手な紺飛白の袷に、花模様の赤｜前垂、素足に赤い鼻緒の剥げチョケた塗下駄を穿いていた。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある百姓家では、垣のところに行水盥を持ち出して、「今日は久しぶりでまた夏になったような気がした」などと言いながら若いかみさんが肥えた白い乳を夕闇の中に見せてボチャボチャやっていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚に近い浅い所で、ボチャボチャやっている老人もあった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だいドテカボチャ、ひやけの茄子！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はほどよい穴をつくると、そのなかにボチャンと身体をつけた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "プーに乗った砲弾　黒い爆弾様のものは、覘いが狂ったのかどうかは分らないが、とにかく垣根の側にある井戸の中へ飛びこんで、ボチャーンと大きな音を立てた。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボチャンと音がして、深いところへ……」「深いところへって？",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもないとお千は川の中へボチャンと落ちてしまうにきまっている。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "慣例によってカボチャの実や、ハスの実を出され、習慣通り僕達がそいつを不器用に、その癖通人めかしく、前歯でパチンパチンと外皮を破って食べたことは云う迄もない。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、またカボチャかと思う。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして自分の畑にナスとカボチャがなんぼうあったかと赤鬚先生たちに聞かねばわからぬことになろうか、何事もわが国はそうであるように。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はこの頃、自分をアーボチャンと云い、いろいろの単語を喋り、なかなか可愛くよく発育しています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はカゼがなおって遊びに来て、「アッコオバチャン、おぽんぽが痛くなくなったらアボチャン、トシマエンヘツレテッテヤルヨ」と大いに慰めてくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
