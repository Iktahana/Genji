        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いろいろの大使たち――トオマス・ボドレイもそのうちの一人であるが――が彼の影響下に集まった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群の候補者のなかでも、トマス・ボドレイはエセックスが例の熱烈さで推挙する人物だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "トマス・ボドレイの一件を考えると、彼は良心の針に痛めつけられるのだった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボドレイを彼は女王の侍史として推挙しながら失敗した。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボドレイにこれをくれてやろう――賠償にはちょうどいいものではないか。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてボドレイは、それをもらった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが今日のボドレイ大図書館の奇妙な縁起なのである。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
