        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十七　チヤプリン　社会主義者と名のついたものはボルシエヴイツキたると然らざるとを問はず、悉く危険視されるやうである。",
              "citation": {
                "source": "澄江堂雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし次手にもう一度、何でも○○○○はボルシエヴイツキの手先ださうだと云つた。",
              "citation": {
                "source": "大正十二年九月一日の大震に際して",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び僕の所見によれば、善良なる市民と云ふものはボルシエヴイツキと○○○○との陰謀の存在を信ずるものである。",
              "citation": {
                "source": "大正十二年九月一日の大震に際して",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
