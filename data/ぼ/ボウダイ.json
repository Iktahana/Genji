      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "huge",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "そのプロジェクトには、膨大な量のデータ分析が必要だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は膨大な知識を持ち、どんな質問にも答えることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "災害によって、復旧には膨大な費用と時間がかかると予想されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それは象のように膨大した片腕を根元から切り落とすのであった。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵粮は嫌でも他から仰がなければならぬのであるから、大概の者は頭と腕だけが膨大になつて、胃の腑が萎縮する。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに父の慾望は一年々々に膨大となツて、其の後｜不圖事業熱に取ツ付かれた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "青空表現詩派このながい烟筒はをんなの圓い腕のやうで空にによつきり空は青明な弧球ですがどこにも重心の支へがないこの全景は象のやうで妙に膨大の夢をかんじさせる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟾蜍雨景の中でぽうとふくらむ蟾蜍へんに膨大なる夢の中でお前の思想は白くけぶる。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川の河幅はこの橋の上流の所で著しく膨大して幅二キロメートル半ほどの沼地になっている。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "組み込もうとする素材を、あらかじめ整える作業には、経験も求められるし、かなり膨大な時間も必要になります。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "膨大な空間をしめる紙の冊子は、電卓並みに小型化されています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし膨大な文化的蓄積のただ中に生み落とされる〈人〉にとって、はじめにあるのは言葉です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのことを通じて、これまで人が積み上げてきた膨大な本の世界を、もう半歩前進させる。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしてインターネットに直接繋がった藤井さんのマシンと、私のマシンとを接続してやれば、私自身も世界中の膨大なコンピューターと二十四時間繋ぎっぱなしになった、本当の意味でのインターネットを満喫できるのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに、コンピューターに関する情報をあたりはじめると、あまりの膨大さにただただ圧倒されて、笑い出したくなるような気分に襲われました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし全体として見れば、実に膨大な情報が蓄積されていることには間違いありません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕は、大きな意思を構成する膨大なアトムの一個なんだな」　悲鳴を上げる視神経をなだめてえんえんとサーフィンを続けていたある夜、私の胸に、ふとそんな思いが芽生えました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＷＷＷには、ＨＴＭＬで記述された文書が膨大に蓄積されて行くでしょう。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "言い換えれば、繰り返し開く必要のあるものだけが、膨大な作業量を要する手写の対象となり、本になりえたのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その彼らとしては、膨大な市場規模を持つ家電が電脳化されていくのを、指をくわえて眺めているのも業腹だろう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが我と我が舌が暴走するに反比例して薄れ行く意識の中でウイルス男が考えていたのは、九〇年代においてパーソナルコンピューターに出会うだろう膨大な数のユーザーの運命だった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにはなんといっても膨大なソフトウエアの資産の蓄積があり、アシストが着手し始めたばかりのパーソナルコンピューター分野に関しても、日本市場に持ってきて面白い製品は五万とある。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "膨大な費用をかけてＴＲＯＮ仕様のマイクロコンピューターを開発した、富士通、日立、三菱電機。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく生活空間のあちこちに膨大な数の電子の頭脳を配置しながら、みんな互いに知らんぷりで連携しようとしない。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＡＣＥマシンがはでに出てくるころまでには景気が回復して大企業やバブル人種が大枚をはたいてくれるのかも知れないが、そうなったとしてもその下には膨大な貧乏人がいる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "次は灰色藪鶏、インドにのみあり、頸毛の茎膨大して角板となり、その尖端黄臘を点ぜるごとし。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "苗の時から、花落ちの時から、いろいろ苦心して育てた奴が、一日一日に膨大して、とうとうここまで、一貫目以上もあろうというところまで大きくなったのだから、父が上機嫌で破顔微笑するのも無理はない。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても私は人間の頭脳というものが、かくも膨大な風景をその組織の中に入れ得られるということに驚きを感じる。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくすれば目的の主著は過多にして而も不充分なる事例のために膨大となり過ぎるのを免れることが出来るであろう」、と。",
              "citation": {
                "source": "エマヌエル・カント『自然哲学原理』解説",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "膨大な軍事予算と国民生活安定予算との矛盾をば、狭義国防と広義国防との対立として衝いたのは、社会大衆党などであった。",
              "citation": {
                "source": "挙国一致体制と国民生活",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "莫大な国防献金と云っても、膨大な軍事予算や事変追加費予算の嵩に較べれば、まるで桁が違うのである。",
              "citation": {
                "source": "挙国一致体制と国民生活",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "確かに、高貴な像となることを思わせる芸術的センスを満足させるものではあったが、この建立計画が有する膨大な破壊という、目に見える証拠によって衝撃を受けたからである。",
              "citation": {
                "source": "博多にて",
                "author": "AT HAKATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "膨大な仕事がなし遂げられようとも、私たちの後に続く者たちのみが知ることができる。",
              "citation": {
                "source": "博多にて",
                "author": "AT HAKATA",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
