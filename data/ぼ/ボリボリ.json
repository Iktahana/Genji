  {
    "uuid": "148132bd-2af0-51ef-a6c5-40e6a9542321",
    "entry": "ぼりぼり",
    "reading": {
      "primary": "ぼりぼり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "犬は自分の汚さは自覚していないが、しかし癢いことは感ずるから後脚でしきりにぼりぼり首の周りを掻いていた。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃のきたない絵もやはり自分のきたなさは感じないがその癢さを感じてぼりぼりブラシで引掻いたような痕が見える。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "へへん、）と云って、取巻の芸妓徒の顔をずらりと見渡すと、例の凄いので嘲笑って、軍鶏が蹴つけるように、ポンと起きたが、（寄越せ、）で、一人｜剥いていた柿を引手繰る、と仕切に肱を立てて、頤を、新高に居るどこかの島田｜髷の上に突出して、丸噛りに、ぼりぼりと喰かきながら、（留めちまえ、）と舞台へ喚く。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い根や枝までついた、ぼりぼりに折られた太い薪でした。",
              "citation": {
                "source": "祭の晩",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷里の家の長屋に重兵衛さんという老人がいて、毎晩｜晩酌の肴に近所の子供らを膳の向かいにすわらせて、生のにんにくをぼりぼりかじりながらうまそうに熱い杯をなめては数限りもない化け物の話をして聞かせた。",
              "citation": {
                "source": "化け物の進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "林檎の皮ごとぼりぼり※り歩いている女学生も交じっていた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして手取り早く巻帯を解くと素裸かになって、ぼりぼりと背中を掻いていたが、今まで着ていた衣物を前から羽織って、ラムプを消すやいなや、ひどい響を立てて床の中にもぐりこんだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ぼりぼりとうまそうに食う。",
              "citation": {
                "source": "ドモ又の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大人達のいふ、惜しいことをしたといふ感じよりも、私にはたゞたゞあの元氣な雄鷄がどういふ風にして死んだかと考へられ、その目を瞑つてぐたりとなつてる姿が目にうかび、鼠を喰べるやうにぼりぼりと喰べられたのかと思ふと、かはいさうでならなかつた。",
              "citation": {
                "source": "白い雌鷄の行方",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは顔中ぼりぼり掻きながら、顔はいくら膨れたって、口はたしかにきけますから、授業には差し支えませんと答えた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "武士は昼間虱に吸はせた箇所をぼりぼりと掻いた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからしばらく、油菓子をぼりぼりかじっていましたが、「しんたのむねを下りたところに掘ったら、水が出るだろうかなア。",
              "citation": {
                "source": "牛をつないだ椿の木",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬は強く空気を口で吸ふことで、一頁一頁開くことをやつてゐるのだ、――と博士は観察を下した、プーリは第三面の政治欄は、殊に熱中的に熟読してゐた、何かの仕事を読んで感動したときだらう、片足をもちあげて頭をぼりぼりと引掻いた、すると頭から脱気が新聞の上にばらばらと落ちるのであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入ってかき餅などを焼いてもらってぼりぼり噛んだ。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "また寝るかと思ったら、今度は右の手を下へさげて、凹んだ頬っぺたをぼりぼり掻き出した。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は其所にある塩煎餅を取ってやたらにぼりぼり噛んだ。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして湯も水も呑まずに、硬くて脆いものをぼりぼり噛み摧いては、生唾の力で無理に嚥み下した。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人はうーん、むにゃむにゃと云いながら例の赤本を突き飛ばして、黒い腕を皮癬病みのようにぼりぼり掻く。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」鵬斎は片手を伸ばして、脊骨の辺りをぼりぼり掻きながら言つた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は物貰ひのやうに襤褸つ片を身に纏つて、日がな一日ぼりぼりと微かな歯音をたてて、そこらの葉つぱをかじるのに余念がない。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、暫くは森閑とした宮殿の中で、脱皮を掻きむしるナポレオンの爪音だけが呟くようにぼりぼりと聞えていた。",
              "citation": {
                "source": "ナポレオンと田虫",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、むしろの上に起きあがって、たてつづけて大あくびを三つ四つやって、ぼりぼり身体をかいた。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の男が、ぼろを頭の上からまとって棕梠の木にもたれて、ふところの奥の方をぼりぼりかいていた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜中にふと、太郎と次郎が目を覚ましますと、奥の間でだれかが、何だかぼりぼり物を食べているような音がしました。",
              "citation": {
                "source": "物のいわれ",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌のマメをぼりぼり掻きつつ、頭の中で難解な謎でも解きほぐそうとするかの様に、永い間、上眼遣いに顔を動かさなかったが、ふと決心した様に父は、慎作を真直に見た。",
              "citation": {
                "source": "十姉妹",
                "author": "山本勝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ははっと眼をあいて、首筋や脛をぼりぼりかいた。",
              "citation": {
                "source": "父の形見",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれを、ばりばりむいて、ぼりぼりかじって、喧嘩してる、若い女たちの場面は、ちょっと挨拶に困るしろものだ。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかと土と汗と雨とで、がばがばになった服、それにシラミがうごめき、ノミが跳び、やぶれからむき出した皮膚にはぼりぼり引っかいた爪あとに血がにじみ、いちめんのカイセンがさ。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう夕刻近かつたと覚えてゐるが、妙に眉毛がかゆく、私はぼりぼりと掻きながら自分の部屋へ這入つた。",
              "citation": {
                "source": "発病",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
