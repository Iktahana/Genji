        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供は、カリカリとしたスナックをボリボリ*/と食べている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "カメがレタスをボリボリ*/と音を立てて食べていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の食べる音は、ボリボリ*/としていて少しうるさい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "が、甘さと切なさと恥かしさに、堅くなった胸は、自から溝の上へのめって、折れて、煎餅は口よりもかえって胃の中でボリボリと破れた。",
              "citation": {
                "source": "売色鴨南蛮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護人はたまらん」ボーイは背中をボリボリかきながらこぼした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷹揚にノソノソやって来て、自分の好きな塩煎餅か掻餅でもあろうもんなら、宛もこの家のものは竈の下の灰までが俺の物だというような顔をして、平気で菓子鉢に顔を突込んではボリボリと喰べ初める。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うにあの晩、そなたとふたりでこの倉へ調べに来たときも、きっとボリボリやっていたに相違ないが、気がつかなかったか」「さよう……いえ、おことばどおりでござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "新吉は何やら考え込みながら、無意識にボリボリ食い始めた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "手をもむとボリボリと糊が垢と一しよに黒くなつてこぼれた。",
              "citation": {
                "source": "反逆の呂律",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったくのろのろと人間の頭で想像の出来る限りの、ゆっくりした足どりで、磨りへった階段に、濡れた長靴の跡をベタンベタンとつけながら階下へ降りると、彼はまた長いこと後頭部をボリボリ掻いていた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さういひながらもチェレ※ークは、欠びをしたり、背中をボリボリ掻いたりして、さうしてゐる間だけでも怠ける時間を引きのばさうとするのであつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝の美しい機関士も、ビスケットをボリボリかみながら一寸｜覗いて通る。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は沈黙ってボリボリ大根の塩漬を噛んでいたが、台所の方も佗しそうに、コツコツ葱を刻み出した。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで僕等は、その二つの理論の中から、黙示図の原理を択ばなければならなくなりました」「ああ、まるで狂人になるような話じゃないか」熊城はボリボリふけを落しながら呟いた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして帽子を脱いで机の上に置くと、ボリボリと禿げ頭を掻いた。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川家康は温厚な古狸のように考えられているが、彼の側近の記録によると、自分に不利なことが起ると、たちまち顔色が蒼ざめ、ボリボリ爪をかむ癖があったという。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルモチンだと百粒ボリボリかみながらウィスキーをのむ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "土間桟敷に手あぶりを持運び酒を飲み弁当鮓を食い甘栗カキ餅煎餅煎豆の類を終日ボリボリ食う事差支なくんば煙草の如きは更に差支なき筈なり。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑さで気が狂いそうだといって師匠の国芳は、朝から素ッ裸で冷やした焼酎ばかり傾けては、ボリボリ薄青い胡瓜を丸齧りにしていた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "もはやいかなる手段をつくしても、まことのこけ猿を手に入れねばならぬ」「いや、その儀なれば、御家老のお言葉を待つまでもなく……」　喜田川頼母が、腕をボリボリかきながら言いだすのを、主水正は叱咤して、「おのおの方は、いったい何しに江戸表へこられたのじゃっ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "内山も、ボリボリ掻いて居た。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしく素早い女で」　ボリボリと首筋をかく八五郎です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "千之助さんと知らないから、裏へ廻って、二人っきりになってから、「実は私は千之助」と打明けられた時は、全く腰を抜かしてしまいました」　稲葉屋佐七は、その時の恰好を我ながら極り悪く思い出した様子で、自分の首筋をボリボリと掻いております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "地獄から来た男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お小遣が要るなら、俺のところへ来てそう言えばいいのに、――もっとも、俺のところにも一両と纏まった金は滅多にねえが、いざとなりゃ、質を置くとか、女房を売り飛ばすとか」「止して下さいよ、親分がそんな事を言うから、うっかり無心にも来られねえ」　ガラッ八は面目次第もない頸筋をボリボリ掻くのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "黒い巾着",
                "note": "青空文庫"
              }
            },
            {
              "text": "あろうことか、その花嫁は墓地へ行って、新仏の穴を発き、その中の棺の蓋を取り、死人の冷えた肉と、骨とを取り出して、ボリボリ食っている、あまりのことに仰天して気絶したお婿さんを、その花嫁さんが呼び生かして言うことには、「お前さんは、死人の肉を食ったわたしを怖いと思いますか。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭からか、尻尾からか、それは知らないが、ボリボリと食われているのだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "せんべいをボリボリ噛みつつ、ぼくは涙がとまらなくなった。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかにして』と、言下に氷を男に打つけて怒るかもしれないし、さもなくば『あら、待てないわ』とばかりボリボリ噛み割って喰べてしまう事かもしれない。",
              "citation": {
                "source": "美しい日本の歴史",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　誰と誰と言って「――あたし、ふんとに困っちゃったわ」　鼻の低い、そのかわりのように唇が飛び出た、その踊り子は、無遠慮に投げ出した裸の脚をボリボリ掻きながら、朝野とそんな話をはじめた。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬が怪我をするって言うから、すごい」「クナシリのボリボリ（キノコ）はうまいな。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は道端に立止まって二三分も乞食を眺め続けたが、その間彼は僕を黙殺して、片方しかない手で折れ曲った背中をボリボリ掻いていた。",
              "citation": {
                "source": "悪霊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "日吉は、ボリボリそれを喰べながら、長押の槍を仰いだり、具足櫃の紋を眺めたり――それから眼のまえに坐っている加藤弾正の顔を、穴のあくほど、じろじろ見つめたりした。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
