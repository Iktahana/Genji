          "literary": [
            {
              "text": "――ボオドレール１　一人の医者が死んだ。",
              "citation": {
                "source": "地獄",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（『重症者の兇器』後段）ボオドレールの『旅への誘ひ』のルフランが、この青年強盜の耳にも、なつかしく響きつづけてゐたことが察せられる。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブレエクにしろボオドレールにしろ、ゴオチエにしろロセツチにしろ、スインバアンにしろ、ブラウニングにしろ、今日でこそ一般的の名になつてゐるが、当時にあつては日本では無論のこと英米の読書界では決してさう普遍的なものではなかつたらしい。",
              "citation": {
                "source": "小泉八雲に就てのノート",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
