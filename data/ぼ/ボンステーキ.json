          "literary": [
            {
              "text": "Ｔボンステーキうまかりし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネてから又、Ｔボンステーキ明月へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔボンステーキを、ボビーにやる骨がほしさに食ひ、大切に抱へて帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボビーに昨夜のＴボンステーキの骨を食はせる、大喜びだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ十時半、早田・穂積・南僑とで明月へ寄り、Ｔボンステーキ食ひ、ボビーに骨を土産にして帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
