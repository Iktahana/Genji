          "literary": [
            {
              "text": "オニ・グラ（まづし）、フィレ・ソール・ボンファムとシャリアピン、コーヒー、ペストリ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィレソール・ボンファムが此処第一の味。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時から「従軍記」の舞台けい古故、ホテルのグリルへ行き、オニグラとフィレソール、ボンファムを食ひ有楽座。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人だけ食事、オニグラ、フィレソール、ボンファム・シャリアピンと定ったやうなものばかり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィレソール・ボンファム、これは、此の店独特である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "人参クリーム・スープをやり、次に、こゝのフィレソール・ボンファムを試みる、プルニエのと同じで、こっちの方が量が多いやうだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
