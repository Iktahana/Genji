        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボリナ・チャストニコフ〔自由個人商人の意〕で気が荒くなって居る由。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺たちがここんとこで、どんな手を打つかで、ボリナーヂュ百二、三十人、家族を合せりゃ四百人からの人間が、生きるか死ぬか、どっちかに決るんだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なあデニス、俺あ、まだお前が生れねえ前からボリナーヂュで炭い掘ってるんだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンリ　（老婆の耳のそばへ）このなあ、ボリナーヂュ中の人間の命がよ、俺たちの肩にかかっているからなあ、めったなことでかんしゃくを起こしちゃいけねえよなあ！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ボリナーヂュの出炭量は世界中で一番貧弱だと言う。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボリナーヂュには神さまは、いらっしゃらぬ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボリナーヂュでも黒かった。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はボリナーヂュで神を見失った。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
