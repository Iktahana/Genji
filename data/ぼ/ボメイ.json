[
  {
    "uuid": "c5062946-ad03-5da2-a9cc-172744793d71",
    "entry": "墓銘",
    "reading": {
      "primary": "ぼめい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
