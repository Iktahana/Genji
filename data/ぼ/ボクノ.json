          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ナキダシタノヲ　ホツタラカシテ　オイテ、ロクボクノ　ハウヘ　トンデ　ユキマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクノヨブコエワスレタカ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "アトニナツテ、人参サンハ　ジヤガイモサント、ケンクワヲシテヰルコトヲ思ヒ出シマシタガ、シカタナク、何度モ、ソノコトヲ話ニジヤガイモサンノオ家ノ入口マデ行ツテハ、「エエ、イマイマシイ、ボクノハウカラ、口ヲキイテヤルナンテコトハナイ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ　ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイサナ　ナミガ　ボクノ　スナマンヂウヲ　タベチヤツタ、ワツハツハ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケサハヤク　ノハラデ　アソンデヰテ、ヒヨイト　ミタラ、ボクノカゲハ　キミヨリ　ズツト　オホキカツタンダゼ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミノ　カゲハ　オホキイガ、ボクノカゲハ　モツト　ズツト　オホキイヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
