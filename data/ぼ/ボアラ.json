        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "母はジャンヌ・マティーユーと言い、父はジャン・ヴァルジャンと言い、あるいはたぶん語を縮めまたボアラ・ジャン（ジャンの野郎）の綽名としてヴラジャンとも言った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォアラ、ネスパ、セッサ、ムシュー、アラマディ、プレンプアン、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギャルソンのステファンが、「ヴォアラー・ムシウ」と言って小卓にのせて行く朝食は一日じゅうの大なる楽しみであったことを思い出す。",
              "citation": {
                "source": "コーヒー哲学序説",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はすっと瀟洒に身をかがめて伸子が落して知らずにいたハンカチーフを赤いカーペットの上からひろいあげると、「ヴォアラ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "社交にみがかれてつやのあるヴォアラ・マドモアゼルという云いかた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
