    "definitions": [
      {
        "index": 1,
        "gloss": "worn-out",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年愛用した革の財布が、とうとうボロボロになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い本棚は、もうボロボロでいつ壊れてもおかしくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "引っ越し作業で、段ボール箱がボロボロになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そのペンキはボロボロに剥げて、建物も鎧扉も、指で押せば立ちどころにメリメリツといきさうであつた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "隅に墨だらけになつた小さな机が置いてある他には、小学の教科書とボロボロの学校鞄とが机の下に抛り込まれてゐるだけだつた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのボロボロの長屋に柿色や萌黄の蛇の目の傘が出入りしている。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三　日本橋その他の石橋の花崗石が、大正十二年の震火災に焼けてボロボロにはじけた痕が、今日でも歴然と残っている。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、それを押えながら、石がボロボロころげて来る斜坑を這い上った。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那兵は生前、金にも食物にも被服にもめぐまれなかった有様を、栄養不良の皮膚と、ちぎれた、ボロボロの中山服に残して横たわっていた。",
              "citation": {
                "source": "チチハルまで",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎もさうきいてゐると、たいへんうれしくてボロボロ涙をこぼして云ひました。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狸もそら涙をボロボロこぼして「なまねこ、なまねこ、こんどは兎の脚をかじれとはあんまりはねるためでございませうか。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳はボロボロの麻のはんけち或は焼いたするめのやうだ。",
              "citation": {
                "source": "月夜のけだもの",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　実際ゴム靴はもうボロボロになって、カン蛙の足からあちこちにちらばって、無くなりました。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎もそうきいていると、たいへんうれしくてボロボロ涙をこぼして云いました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　狸もそら涙をボロボロこぼして「なまねこ、なまねこ、私のようなあさましいものでも助かりますなら手でも足でもさしあげまする。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このププホルと『徒然草』のいわゆるボロボロとを並べて考えてみるとだれでもちょっと微笑を禁じ難いであろう。",
              "citation": {
                "source": "日本楽器の名称",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、実に私めも今朝そのおはなしを承わりまして、涙を流してござります」馬はボロボロ泣きだしました。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……蓬々と延びた髪の毛……無性ヒゲ……ボロボロの浴衣……結び目をブラ下げた縄の帯……瘠せ枯れた腕……灰色のホコリにまみれた素跣足……そんなものの黒い影が、一寸法師のように、眩しい地面に這いついていた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "平生腰帯にしていた絹のボロボロの打ち紐が、皺だらけの首に三廻りほど捲かれて、ノドボトケの処で唐結びになったままシッカリと肉に喰い込んでいたが、その結び目の近まわりが血だらけになるほど掻き※られている。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから提灯を消して傍の壁にかけて、ボロボロ浴衣を脱ぐと、くの字なりに歪んだ右足に、黒い膏薬をベタベタと貼りつけたのを、さも痛そうにラムプの下に突き出して撫でまわした。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとうその苦心の外套をも廃止して、中学時代からのボロボロのマントを、頭からすっぽりかぶって、喫茶店へ葡萄酒飲みに出かけたりするようになりました。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」十　陽子はボロボロ涙を落しながら、事務室へかけつけた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "便所でボロボロ涙をこぼした。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その柵は朽ちかけて、既に外皮のところどころはボロボロにくずれかけていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　凡そボロボロなシャツや簡単着をまとった数百の色の黒い男女生徒が、一斉に手を挙げた。",
              "citation": {
                "source": "南島譚",
                "author": "※",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボロボロの唐紙半切に見事な筆跡で、薄墨の走り書きがしてあった。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは古本屋の店頭にゴミクタのように投げ出されてあった、表紙も奥もないボロボロの数十頁でしたが、その中に「江戸川乱歩」の署名がありましたので、私は又かと思いました。",
              "citation": {
                "source": "江戸川乱歩氏に対する私の感想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛とか何とか云うて睾丸の無いような奴が大勢寄集まって、涙をボロボロこぼしおるが、本家の耶蘇はチャンと睾丸を持っておった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "骸骨のように痩せこけた身体に、ボロボロの登山服を纏うて、メチャメチャに壊れたカメラを首に引っかけた、乞食然たる男の姿が、ヒョッコリ旭川の町に現われて、何やら訳のわからない事を口走りながら、ウロウロし初めました。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかも念のために病院に保管して在ったＡのボロボロの登山服を調べてみると……ドウでしょう。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧乏なお婆さんと見え、冬もボロボロの袷を重ねて、足袋もはいていないような、可哀そうな姿をしておりました。",
              "citation": {
                "source": "納豆合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "crumbling",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
