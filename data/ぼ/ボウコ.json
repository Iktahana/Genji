[
  {
    "uuid": "73401c32-d1d6-5408-af0a-5a7a12673103",
    "entry": "茫乎",
    "reading": {
      "primary": "ぼうこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
