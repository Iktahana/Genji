[
  {
    "uuid": "e7f619e6-bda7-583a-b837-d55f4f74819a",
    "entry": "雪洞",
    "reading": {
      "primary": "ぼんぼり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
