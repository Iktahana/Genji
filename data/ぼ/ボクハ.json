            {
              "text": "ボクハ　ドコヘ　イクノカ　ワカンナイヨ」ト　フウセンダマハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ボクハ　コノ地上デ受ケタ魂ノ疵ヲコノ地上デ医ヤシタイノダ　アマストコロアト　七千日……〉　旅先で新しい愛人を得て、東京へはもう戻らないと宣言した友からの手紙だつたが、異常な悲壮が揺れうごいてゐた。",
              "citation": {
                "source": "火の踵",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウウ、ウウ、ウウ、ボクハ　ステキナ　オホイヌダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウウ、ウウ、ボクハ　キミヨリ　オホキインダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハココイラキンジヨデ　イチバン　オホキインダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワン、ワン、ボクハ　オホイヌダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハ　オホイヌダ」ト　チビスケハ　ヨロコンデ　トビアガリ、シツポヲ　クルクルト　フリマワシマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボクハ　オホキナ　カゲヲモツタ　コイヌダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハ、アサッテ、ヨルノ十二ジニ、ウエノコウエンノ、トショカンノウラニ、イマス」「マア、お前、何をいっているの、お前の側に悪者がいて、お前にそんなことを喋らせているのね。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハ、チキューノニンゲンヨリ、百バイ、カシコイヨ、ワカルダロ……、ダケド、キミカワイイネ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
