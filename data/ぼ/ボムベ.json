        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボムベイのワダラ池に水が溜らなんだ時村長の娘を牲にして水が溜つた。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしてチャールストンやニューオーリンズの、それからマドラスやボムベイやカルカッタの、暑さにあえぐ住民がわたしの井戸の水を飲むことかと思われる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "セエラは今、父のクルウ大尉と一緒に、ボムベイからロンドンに着いたばかりのところなのです。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つはロレンソ・ダルメイダのチャウル（ボムベイ南方）に於ける戦死である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が一五三一年にボムベイからヂウ攻撃に向った時には、大小四百隻、ポルトガル兵三千六百を率いていた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでヂウの代りにバッセインの町をサルセット島ボムベイ島と共に譲ろうと申出て来た。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度、ボムベイの商人　強大に鳴る。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この返事を読んだ途端、将来洋行しても、ボムベイだけは絶対行かぬと私は決心した。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水素の方の仕事は、この中では比較的大がかりなのであったが、それでも水素のボムベと目盛りした硝子のＵ字管と、小さい変圧器位の設備で、どんどん曲線は採れて行った。",
              "citation": {
                "source": "寺田先生の追憶",
                "author": "――大学卒業前後の思い出――",
                "note": "青空文庫"
              }
            },
            {
              "text": "水素と酸素とのボムベを運んで来て水を作ったり、或いは、海水を蒸溜して水を作るようなことは、人間生活という立場からいえば、全然不可能といってよい。",
              "citation": {
                "source": "アメリカの沙漠",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
