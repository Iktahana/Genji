        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わがこの娘を私愛してかくボテレンに仕上げたと喚き散らした。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次が大臣病患者、政権利権の脾胃虚病み、人格屋の私生児の後始末、名家名門の次男三男の女出入りの尻拭い、ボテレン芸者の身上相談、鼻垂れ小僧と寝小便娘の橋渡しに到るまで、アラユル社会の難物ばかりが、ハキダメみたいに杉山博士の診察、投薬を仰ぎに来る。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬になると、誰にもひと目でボテレンと分るふくれ方になった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、輝子のボテレンを見たのは、たしかにショックだった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
