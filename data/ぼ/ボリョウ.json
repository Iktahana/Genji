          "literary": [
            {
              "text": "楽浪の墓陵を移して再現したものも見た。",
              "citation": {
                "source": "淡紫裳",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "『帝紀』には、仁徳天皇が生前に、自分の墓陵をつくつたことが書いてある。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、今日のこつている仁徳天皇の墓陵の規模は、その墳墓も、築山も、池も、広大な点において、今日の多くの天皇の墓陵の規格とおなじである。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら、仁徳以前には、天皇の墓陵の制度は、まだそんなに広大なものではなかつた。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            }
          ]
        }
