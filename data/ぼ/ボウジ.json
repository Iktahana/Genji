  {
    "uuid": "cd756841-2a25-5564-a6ac-c93ae981c902",
    "entry": "房事",
    "reading": {
      "primary": "ぼうじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
