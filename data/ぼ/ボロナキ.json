        "examples": {
          "standard": [
            {
              "text": "感動的な映画を観て、彼女はボロ泣きしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試合に負けた悔しさで、選手たちはロッカールームでボロ泣きした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "久しぶりに会った家族の顔を見て、思わずボロ泣きしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いや、実に私めも今朝そのおはなしを承わりまして、涙を流してござります」馬はボロボロ泣きだしました。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ君なめまわすようにお前が問いかけるのにも女はしばらく答えなかったがやがてボロボロ泣き出して「ジが出た」と言う「ジ？",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　言つている間に、ボロボロ泣きはじめたのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
