        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "予モ亦ラジオヲ以テ長年ノ趣味トスルモノニシテ、予ガ組立テタル愛機『スーパーヘテロダイン』ヲ携エテ今回｜此途ニノボレリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボレリは有名な著書「動物の運動」（ローマ、1680-1681）の著者であり筋肉の作用の研究に生理学と数学の深い知識を持ち込んで事実上に機械学派すなわちイアトロ機械学派を創設した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボレリは親指の屈筋が122グレイン（＝0.0648g）であり、その力を3720ポンド（＝0.4536kg）であるとした。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカデミア・デル・チメントの最も有名な会員はボレリであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "同様に消化は機械的な過程でありイアトロ化学者が考えているように発酵過程ではないとボレリは言った。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
