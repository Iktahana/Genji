[
  {
    "uuid": "2cab73cc-6c87-53d9-9d4d-6ac55e767a4a",
    "entry": "牧畜",
    "reading": {
      "primary": "ぼくちく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
