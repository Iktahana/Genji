    "definitions": [
      {
        "index": 1,
        "gloss": "in a subdued voice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は何か思いついたように、ぼそりと言葉を漏らした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "周囲の喧騒の中で、彼女はぼそりと本音を語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会議の終わりに、彼はぼそりと「異議なし」と言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」やはり半分は口の中で、ぼそりと言ふ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心配しないでもいい」　正勝は初めてそれだけをぼそりと言った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これでお蚕に追はれとるうちゃァ何んと云ってもいいが……」宇平は心細さうにぼそりと云った。",
              "citation": {
                "source": "夏蚕時",
                "author": "金田千鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラングボムの研究所にも行つて、加野君にも逢つてやりたいと思つてゐます……」　富岡はぼそりと、そんな事を云つて、さつさと先に応接間へ戻つて行つた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、古新聞の記事をぼそりぼそり読みあげる校長のヴァン・バンメル先生をさがしても無駄だった。",
              "citation": {
                "source": "リップ・ヴァン・ウィンクル",
                "author": "ディードリッヒ・ニッカボッカーの遺稿",
                "note": "青空文庫"
              }
            },
            {
              "text": "（これは鉛筆ケズリの役をする）　d'or 十本入二十六｜哥（紫、赤、茶）まがいアンピールの箱二つ、アメリカの旗がついたボソリスキー一つ（その中にはゴム輪とペン）　◎ Ноина という意味のわからぬ文字を活動写真のビラのように出したくさい糊のチューブ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくしてから、フサがボソリといった。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "インド以東がどんなに遠かろうと、いたるところ商利を約束する港々に満ちているが、太平洋以西はサンフランシスコまで北上したところで、スペイン人の修道館が一つボソリと立っているだけだ。",
              "citation": {
                "source": "汽船が太平洋を横断するまで",
                "author": "服部之総",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
