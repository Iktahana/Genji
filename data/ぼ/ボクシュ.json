[
  {
    "uuid": "07174b7e-a26e-578c-a023-d2d35c3ce658",
    "entry": "墨守",
    "reading": {
      "primary": "ぼくしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
