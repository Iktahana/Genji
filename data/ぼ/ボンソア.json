        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "女中が走つて出て、甘い声で、ボンソアと庭口へ呼んだ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小径の方で、ボンソア……と挨拶してゐる女の声がしてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その風景のなかにレースのやうな淡さで、仏蘭西人はひそかにのんびりと暮してゐたし、安南人は、夜になると、坂の街を、ボンソアと呼びあつてゐたものだ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンソアの声が耳底から離れない。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンソアル・モン・ヴイユウ！",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
