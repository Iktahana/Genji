        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬のコートは、少しボテボテとしていて動きにくい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重い荷物を抱えていたので、彼の足取りはボテボテとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ボテボテとしたデザインのバッグは、収納力があるが持ち運びには不便だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "口もあつみがふえた様にボテボテして感じがにぶくなってしまった。",
              "citation": {
                "source": "つぼみ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は酒のためにボテボテに肥った老人である。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "poorly hit (e.g. grounder)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
