  {
    "uuid": "c8dd99d3-e4b0-5901-a872-b5e2995acf8c",
    "entry": "暴王",
    "reading": {
      "primary": "ぼうおう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
