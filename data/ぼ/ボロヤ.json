  {
    "uuid": "d8ccf731-af70-52ac-aed4-6223feab6cd0",
    "entry": "襤褸屋",
    "reading": {
      "primary": "ぼろや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
