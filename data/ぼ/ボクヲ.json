          "literary": [
            {
              "text": "「ミツルクンガ　ボクヲ　カラカフンダモノ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が日本語が解るというので僕が極めて簡単の日本語で、「ランテイさん、アナタワ、ベッピンサンデスネ、ボクヲ、アイシテクレマスカ」　と話しかけると、彼女は日本語で返事をせずに、中華民国語で返事をするのさ。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カアサマ、ボクヲ、カイモドシテクダサイ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ココデ、ボクヲミタコト、デパートノヒトニ、イイナサイ。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
