        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "純粋な感謝の念の籠ったおじぎを一つボクリとして引退ってしまった。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクリ、ボクリと土の音がするたびに、何か出て来やしまいか、何か手ごたえがして来るだろうと、眼も心も鍬の先にあつまって、他念のない有様です。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
