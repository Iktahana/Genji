          "literary": [
            {
              "text": "けれど多くは、十八世紀の監察官やナポレオン時代の軍需商人など、国家の財産を買い取った者の子孫である）――その貴族にボニヴェー家というのがあった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのボニヴェー家からジャンナン家へ懇親を求めてきた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "息子のボニヴェーはアントアネットへしきりに媚びてきた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
