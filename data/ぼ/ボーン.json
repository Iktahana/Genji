        "examples": {
          "standard": [
            {
              "text": "Unixシステムの管理用スクリプトを、互換性を重視してボーンシェルで記述した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ターミナルでshコマンドを実行し、標準のボーンを起動して設定を確認する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "現代の多くのシェルの基礎となったのは、ベル研究所で開発されたボーンである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
