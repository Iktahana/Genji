    "definitions": [
      {
        "index": 1,
        "gloss": "bone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "犬がおもちゃのボーンをくわえて、嬉しそうに尻尾を振っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "3Dモデルにボーンを組み込んで、キャラクターに自然な動きを付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "犬が庭の隅で、お気に入りの牛のボーンを一生懸命に噛んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一九〇八―九年の冬の間に南アフリカへ遊びに来ないかという招待を、時の南アの長官セルボーン卿から受けたので、そのついでに南洋へも廻る気で出かけた。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーッと空中に線を引いてボーンと地響きがする。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンローの第三巻はこの人の対語訳で、同じものがボーンのポピュラー・ライブラリーの中にも出ているそうであるが、自分はまだこの訳を読んでいない。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "野原のずうっと西北の方で、ぼお、とたしかにトローンボーンかバスの音がきこえました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ腸の中を出され、ボーンと。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーンと飛んで、額、頸首、背、手足、殿たちの身体にボーンと留まる、それを所望じゃ。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蠅よ、蠅よ、蒼蠅よ、ボーンと出され、おじゃった！",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ボーン、ボーン、ボーン、）と云うのが、ねばねばと、重っくるしく、納豆の糸を引くように、そして、点々と切れて、蒼蠅の羽音やら、奴の声やら分らぬ。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ボーン、）　と云う時、稲妻が閃めいて、遠い山を見るように天王寺の森が映った。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三崎座だろう、釣鐘がボーンと鳴る。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "南英の保養地ボーンマスでの三年の後、コロラドを試みては、という医者の言葉に従って、大西洋を渡った。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　明けて一八九一年の正月になると、旧宅、ボーンマスのスケリヴォア荘から、家財道具一切を纏めて、ロイドがやって来た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファニイは当時、戸籍の上では未だ米国人オスボーンの妻であったけれど、久しく夫から脱れて欧洲に渡り、雑誌記者などをしながら、二人の子をかかえて自活していたのである。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーンマスにいた頃、夫の身体の為とはいえ、古い友達の誰彼を、頑として一切病室に入れなかったのも、彼女であった。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "トマス・スティヴンスン氏にとっては、ファニィが米国人であり、子持であり、年上であることよりも、実際はどうあろうと兎に角彼女が戸籍の上で現在オスボーン夫人であることが第一の難点だったのである。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一晩毎に興味を増して来て、父親までが、「ビリィ・ボーンズの箱の中の品目作製を受持とう」と言出した。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りの角にある小さなパブで、その通りを進むとホウボーンに至るのだろう。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　我々はホウボーンを通り過ぎてエンドル街へ入り、入り組んだ貧民街を抜けると、コヴェント・ガーデン市場へ出た。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は喜びついでにホルボーンで一緒に昼食でも摂ろうと誘い、ふたりしてハンソム型馬車で出発した。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は我が冒険談を手短に聞かせようとしたが、話はホルボーンのなかまでもつれ込んだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホルボーンを後にして病院へ向かう道中、スタンフォードは私が同居人と決め込んだ紳士について二三、突っ込んだ話をしてくれた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱馬車はメアリルボーン街まで突き進んで、あっという間に見えなくなる。",
              "citation": {
                "source": "最後の事件",
                "author": "THE FINAL PROBLEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "トマスは熱心な聴き手となって、作中のビリー・ボーンズの衣類箱が探される時にはその中にある種々の品物を挙げ、またフリントの船の名を「海象号」とつけたのも彼であった。",
              "citation": {
                "source": "宝島",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、ボーンという音がして、ワイシャツが燃えている人間が下から飛び出してきた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度一等車の前あたりで、ボーンと云う烈しいマグネシウムの爆発の音が聞えました。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーンと云う、烈しいマグネシウムの爆発が絶間なく続きました。",
              "citation": {
                "source": "たちあな姫",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国でも色好む寡婦、しばしば旅宿を営んだ（ジュフールの『売靨史』や、マーレの『北土考古篇』ボーン文庫本三一九頁等）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
