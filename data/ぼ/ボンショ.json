  {
    "uuid": "0f136eed-e083-51b7-b170-0a25e24666c6",
    "entry": "凡書",
    "reading": {
      "primary": "ぼんしょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
