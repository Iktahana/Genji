        "examples": {
          "standard": [
            {
              "text": "凡庶の身である私には、貴族たちの優雅な暮らしぶりなど想像もつかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "この法律は、特権階級だけでなく広く凡庶の生活を守るために作られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は凡庶の出でありながら、一代で大きな財を成した傑物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
