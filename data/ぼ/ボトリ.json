        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "熟しきった柿が、枝から地面へボトリと落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は持っていた重い袋を、玄関の三和土にボトリと置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大粒の雨が、乾いたアスファルトにボトリボトリと染みを作っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "今、唾液がそのゴム管の先から、一定の時間的間隔をもって、ボトリボトリと滴って居るところへ、犬の好きな食物を見せますならば、点滴の数が急に殖えるのを認めることが出来るのであります。",
              "citation": {
                "source": "新案探偵法",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の手にある丸い物から、そして彼自身の脣から、濃厚な、黒い液体が、ボトリボトリと垂れているのさえ、はっきりと見分けられた。",
              "citation": {
                "source": "踊る一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
