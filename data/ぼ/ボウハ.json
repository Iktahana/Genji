        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "船は防波堤を掠めて、油を流したやうな穩かな海にうねりを殘しながら進んでゐた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "河口の防波堤も半分つくりかけて投げ出したやうな形に見える。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒く濡れた防波堤が現われる。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "独り荷物をかついで魚臭い漁師町を通り抜け、教わった通り防波堤に沿うて二町ばかりの宿の裏門を、やっとくぐった時、朧の門脇に捨てた貝殻に、この山吹が乱れていた。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "足元を洗う小波か、防波堤を越える大波か、いずれにせよ波頭はここに及ぶ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上防波堤へ上がって、砂ぶかい汽車や電車の軌道ぞいの往来へあがってみると、高台の方には、単調な松原のなかに、別荘や病院のあるのが目につくだけで、鉄拐ヶ峰や一の谷もつまらなかった。",
              "citation": {
                "source": "蒼白い月",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷電峠と反対の湾の一角から長く突き出た造りぞこねの防波堤は大蛇の亡骸のようなまっ黒い姿を遠く海の面に横たえて、夜目にも白く見える波濤の牙が、小休みもなくその胴腹に噛いかかっている。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのそばに、さまざまの漁具と弁当のお櫃とを持って集まって来た漁夫たちは、言葉少なに物を言いかわしながら、防波堤の上に建てられた組合の天気予報の信号灯を見やっている。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも牛乳のような色の寒い夕靄に包まれた雷電峠の突角がいかつく大きく見えだすと、防波堤の突先にある灯台の灯が明滅して船路を照らし始める。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "命とかけがえの漁場が、間違った防波堤の設計のために、全然役に立たなくなったのは前にも言ったとおりだ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘だ、煙突だ、レールだ、そして防波堤だ、浮標だ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "左岸には一簇の葦の穗の茂りがあつて其先からは防波堤が屈曲して居る。",
              "citation": {
                "source": "佐渡が島",
                "author": "波の上",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽船は防波堤に隨つて屈曲して進む。",
              "citation": {
                "source": "佐渡が島",
                "author": "波の上",
                "note": "青空文庫"
              }
            },
            {
              "text": "防波堤の上には十人ばかり四つ手｜網を引いて居る。",
              "citation": {
                "source": "佐渡が島",
                "author": "波の上",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、右舷のはるかに、黒々と防波堤が見え、星のように燦めくタラント軍港の燈火――いまや、戦艦「レオナルド・ダ・ヴィンチ」は目睫の間に迫ったのである。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝霧のために、防波堤の形は少しも見えないのであるが、その足元で、砕ける波頭だけは、暈っと暗がりのなかに見えた。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何心配するほどの事はありませんよ」と云い切って、向の石垣まで突き出している掛茶屋から防波堤の上に馳け上った。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ防波堤に当って砕ける波の音のみが、どどんどどんといつまでも響いた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも風さえ高く吹いて例の防波堤に崩ける波の音が凄じく聞え出した。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "防波堤と母の宿との間にはかれこれ五六町の道程があった。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし波が防波堤を越えて土手下へ落ちてくるため、中が湖水のようにいっぱいになる事は二三度あったと告げた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにその聯想から出る、防波堤を砕きにかかる浪の音を嫌った。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "電燈の並んだ防波堤を三方｜海原の行き止まりまで来てビックリして引き返した……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、それに余り興味を覚へませんでしたので仲間に加はりませんでしたが満里子やＲは非常に、これに熱心となつて暇さへあれば、私の窓から真正面に当る防波堤に出て、海へ向つて（私の方を背にして）体操の練習に余念がありません。",
              "citation": {
                "source": "満里子のこと",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
