        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はいつも人のことをボロクソに言うので、周りから嫌われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "上司からボロクソに言われて、すっかり自信を失ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの映画は、公開前から一部のレビューでボロクソに書かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
