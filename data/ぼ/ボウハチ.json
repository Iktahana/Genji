        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の記録には、そのあたりにいくつかの亡八があったと記されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は酒と亡八に溺れ、財産を全て使い果たしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "親は息子が亡八に出入りしていることを知り、深く嘆いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
