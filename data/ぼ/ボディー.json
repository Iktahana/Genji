    "definitions": [
      {
        "index": 1,
        "gloss": "body",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "疲労が溜まって、全身のボディーが重い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "医師は、患者のボディー全体を丁寧に診察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は優れたボディーバランスで、激しい動きにも対応できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "結果的に同社の小型機は、小錦のパワーを舞の海のボディーにぶち込んだ、往時のマラドーナを思わせる仕上がりとなった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "事ここに至るにあたっては、半導体摩擦を口実とした百パーセントの制裁関税を一九八七年に米政府が実施したことは、ボディー・ブローのように後々まできいてきた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "また有名なる慈善家ピーボディーはいかにして彼の大業を成したかと申しまするに、彼が初めてベルモントの山から出るときには、ボストンに出て大金持ちになろうという希望を持っておったのでございます。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもそのときにピーボディーは旅籠屋の亭主に向って「無銭で泊まることは嫌だ、何かさしてくれるならば泊まりたい」というた。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしピーボディーは、「それではすまぬ」というた。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのピーボディーは彼の一生涯を何に費したかというと、何百万ドルという高は知っておりませぬけれども、金を溜めて、ことに黒人の教育のために使った。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日アメリカにおります黒人がたぶん日本人と同じくらいの社交的程度に達しておりますのは何であるかというに、それはピーボディーのごとき慈善家の金の結果であるといわなければなりません。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は、自動車消費者の立場で、それを眺め、ボディーの美しさを味い、このみの色にエナメルする者の立場で、自動車の美について云っているのか、または、エンジンの発達を先ず根本におく自動車製作者の立場でその美をつかみ理解しているのか？",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ前の舗道に沿って並んでいる幾台もの自動車のボディーはキラキラ日に照っているが、××商事の豪壮な石造の入口の奥は暗くひんやりして見える。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ますますその不気味なボディーに愛着を感じ、今度は、その倉庫の、裸の婦人に抱きついてはなれない。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マサチューセッツ州セーラムのピーボディー・ミュージアムには、消防夫の身支度の立派な蒐集が陳列してある。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い槍、各種の武具、軍隊信号に使用する扇、見事な弓と十二本の矢を入れた箭筒、撃剣に使用する刀、槍その他すべての道具等がそれで、セーラムのピーボディー博物館のために、私にくれた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はピーボディー博物館のために、沢山の物品を貰ったが、町田のこの贈物は、何といっても白眉である。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレビの画面では早朝の人気のない街中を白いボディーの車が徐行している。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボディーを手で叩き、跼んで、ボディーの下の車軸や、エンジンの連結部を眺めたりするのだ。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな小さいからだをしているが、じつは、わたしのボディーガードなんですよ。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかたがボディーガードですか。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉村さんは、ボディーガードにかぎをわたしておくのはあたりまえだとおもい、べつにうたがいもせず、ポケットからかぎを出してわたしました。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんどたのんだ先生のボディーガードです。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人目は白ジャケットのネアンデルタール人で、ヴァーナー医師お付きのボディーガードだ。",
              "citation": {
                "source": "最愛の君",
                "author": "Ｈ・ビーム・パイパー　H. Beam Piper",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二十面相の車は青いボディー、小林君たちのは黒いボディー、その二台の自動車の追っかけっこがはじまりました。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ポーツダウン丘陵の砦で司令官をやっているフリーボディ少佐です。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "テスコかグヤトーンでも出てくるんだろうと思っていたら、黒いボディに、白いピックガードがついたフェンダーが出てきたのだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンプをとおさない、ソリッド・ボディのエレキだから、ペラペラした情けない音色だが、それでも充分だった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんだ、こんなもの」　フェンダーのボディを、藤井が手ではらった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは『雨月物語』をやりにきたんだ」　慶一はボディブロウをくりだしたが、クリンチ状態のせいで、あまり威力はなかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十を目前にした男たちが、笑いながらヘッドロックをかけたり、かけられたり、ボディブロウを喰らわせたりしているので、二〇メートルもない道程が、急流の横断のように感じられる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "このギター以外なら、なんだって、くれてやる」「いや、じつはな、そのギターのことなんだ」　広岡は、おぼつかない目で、美しいサンバースト仕上げのボディを見おろした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "表紙のないその二冊には、ただピーボディ博物館という、検印が押してあるのみなので、軽率にも私は、取るに足らぬ目録のたぐいかと誤信して、そのまま書き屑のなかへ突っ込んでしまったらしいのである。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは以前、合衆国マサチュセッツ州サレムにあった、ピーボディ博物館の蔵書であって、著名な鯨画の収集家、アラン・フォーブス氏の寄贈になるものであった。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
