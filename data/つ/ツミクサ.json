    "definitions": [
      {
        "index": 1,
        "gloss": "picking herbs and wildflowers",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "春の陽気に誘われて、河原へヨモギやツクシの摘み草に出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "摘み草で集めた野草を天ぷらにして、季節の味を家族で楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は小さな籠を片手に、道端で可憐な花の摘み草をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "やがてトシオが来たのは、春の頃、トシオが雲雀の声を聞き乍ら、お友達とのどかに摘み草をしたり、夏のみずみずしい緑葉をふみ乍ら、姉様達と蛍狩をした、広い野原でありました。",
              "citation": {
                "source": "トシオの見たもの",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「摘み草して遊ぼうや」　花子の手近につくしん坊が一本ありました。",
              "citation": {
                "source": "花子",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……時間を思っても、まだ小学校前らしいのが、手に、すかんぼも茅花も持たないけれど、摘み草の夢の中を歩行くように、うっとりとした顔をしたのと、径の角で行逢った。",
              "citation": {
                "source": "若菜のうち",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の仲よしは、芹だの、蓬だのと、毎日のやうに、湖に沿ふて遠くまで摘み草に出掛ました。",
              "citation": {
                "source": "虹の橋",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮華や蒲公英が咲いて……野良のポカポカする時分の摘み草なんか、真実に面白うござんすよ。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その摘み草が大へん面白かったので、お高は、また一日どこかへ遊びに行きたいと思っていた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度、摘み草を兼ねて、ハイキングのつもりで土浦の旧桜川へ出かけたとき、家内も子供も尺ブナを釣りあげた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんまに今日はええお天気どすな」と、要と一緒にそろりそろり先へ行きながら、お久は晴れわたった空を仰いで、「こう云う日には摘み草がしとうて、………」と、不平らしく口のうちで云った。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「全く、芝居よりは摘み草に持って来いと云う日だ」「何処ぞここら辺に蕨やつくしの生えてるとこおすやろか」「さあ、この辺は知らないが、鹿ヶ｜谷の近所の山にいくらだってあるでしょう」「へえ、へえ、たあんと生えてます。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――それでわざわざそいつを摘みに行ったんですか」「へえ、これぐらいの籠に一杯、―――」「摘み草もいいが、田舎の町をぶらぶら歩くのも悪くないですな」青空の下を真っすぐ伸びている一とすじ路の町通りは、往来の人影が先の先まで数えられるほど朗らかに、たまにすれちがう自転車のベルの音さえのどかである。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "摘み草が目的なら、もっと暖かくなって人出が賑う頃にもなれば千種も萌えているし花も咲いていよう。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "むこうの土手では摘草の一家族が水ぎわまでも摘み下りている。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丘というほどでもない堆土に子供らは摘草をしています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、さして心を傷めた趣のあるにもあらず、茅花々々｜土筆、摘草に草臥れて、日南に憩っているものと、大なる違はない。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを子供たちが目笊で伏せるのが、「摘草をしたくらゐ笊に澤山。",
              "citation": {
                "source": "番茶話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして摘草ほど子供にとられたと言ふのを、何だか壇の浦のつまり／＼で、平家の公達が組伏せられ刺殺されるのを聞くやうで可哀であつた。",
              "citation": {
                "source": "番茶話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがその後摘草に行った帰りに、馬に蹴られて土堤から下へ転がり落ちた事がある。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことし七十八になる私の老母の話によると、母が十一二のころ春先の野へ摘草に出ると、よく鶴を見かけたものださうだ。",
              "citation": {
                "source": "独楽園",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮華畑の横で女の子らが寝転びながら摘草をしてゐる。",
              "citation": {
                "source": "神馬",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子供は普通に鬼事か摘草かをやる。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "春風あたたかに菜の花に蝶飛ぶ頃、多くのわらはべ男女うちまじりて、南の野へ摘草に行くはこよなくうれしき遊びなり。",
              "citation": {
                "source": "わが幼時の美感",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だいその白い風呂敷は……」　彼女は癖のように、その風呂敷を背中に隠して、ニヤニヤ笑いながら「摘草したのよ」と云った。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は、これらの摘草を茹でて食卓に並べた。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母や妻や親類の子供や、女中や、遠くも無いので摘草かた／＼見物に來た事が有つた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "權現臺の懷古",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時は生憎何も出ないので、採集袋へ摘草を入れて歸つた事もあつた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "權現臺の懷古",
                "note": "青空文庫"
              }
            },
            {
              "text": "（四）摘草　三月八日。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午食前に、夫妻鶴子ピンを連れて田圃に摘草に出た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手拭を姐さんかぶりにして、小脇に目籠を抱えたままで出て来たお雪ちゃんが、目籠の中へ手を入れて、何か摘草のようなものを取り出して、先生の目の前へ持って来て見せると、道庵先生がいちいち頷いて、「そうだ、そうだ、それがセンブリだよ、花の咲いた時分に採って乾かして置くと胃の薬になる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「むいて上げましょうか」「いいよ、いいよ」　お雪ちゃんは摘草用の切出しを目籠の中からさぐり出して、米友のために柿の実の皮を剥いてやろうと好意を示すのを、米友はそれには及ばないと言いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "高低のある広い地は一面に雑草を以て蔽われていて、春は摘草に児女の自由に遊ぶに適し、秋は雅人の擅に散歩するに任す。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
