        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はポケットからルーペを取り出し、古銭に刻まれた細かな紋様を熟と眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鏡の中の疲れ切った自分を熟と見つめ、彼女は決意を新たにして部屋を後にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この集合写真を熟と見てごらん、背景に何かおかしなものが写っていないかい？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
