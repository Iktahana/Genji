        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "綴れ織りのカーテン越しに差し込む光が、部屋を柔らかな色彩で満たしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "美術館で開催された綴れ織り展では、中世ヨーロッパの豪華な壁掛けが展示されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "綴れ織りの複雑な文様を解明するために、専門家が拡大鏡を使って調査を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "大切にしまってある原本曼陀羅を調べて見ると、麻糸と絹糸との綴れ織りであったという。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこここでさまざまな話題が吹き出し、幾重にも折り重なったメンバーの声がにぎやかなつづれ織りをなすのが常のクラブから、人の声がきれいに消え去った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "読んだことの記憶は時に、生きたことの思い出と重なり合って、色合いの深いつづれ織りを成しています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらは繻珍、こちらの品はつづれ織りでございます」　声と同時に十八、九ごろから二十がらみのはで向きを、ずらずらとそこへ並べましたので、さあ一大事とばかりに伝六がいっそう目を丸くしていると、だが、買うものは余人ならぬわれわれのむっつり右門です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "棒縞の腰きりはんてんに、つづれ織りの帯をしめ、紺のももひきに素足にわらじ、頬かむりの上から小さい菅笠をかむった、このあたりの百姓姿である。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗いので見つかる恐れはないし、壁につづれ織りが飾られ、あちこちに鎧人形が立っており、うまく姿を隠してくれた。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "後の控えの間にはつづれ織りがかかっており、窓からは遠くの道路がはっきり見下ろせる。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっ、あれはなんですか」　風がぱーっと部屋に吹き込み、壁のつづれ織りが揺れた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづれ織りの掛物やコルドバ産の皮革がそこら中にあり、高価な貴族趣味に見えるのみならず、盗品を包む重要な覆いにもなる。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私はその報告書を綴織の掛っている食堂に居る、ホームズのところに持って行った。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "報告を持っていくと、友人は綴織りの掛かった古い食堂に鎮座しており、その前でふたりが見張られていた。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "綴織か繻珍か、これも喜劇である。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はいま懐中から手帳を取出して、歩きながら書いてある事柄を調べ始めた、手帳には『お召羽織二十歳位花模様』『男帯綴織風のもの』『三十五六歳向ショール茶色』『上等ウヰスキイ三本贈答用』などと書かれてあつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも手に旌旗の旆棒を握っていて、尖頭から垂れている二様の綴織が、画面の上方で密着していた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "色のついていない積木一組 6.23、アメリカ兵のために古い綴織の単衣帯を並べている、一本 785 800―900―。",
              "citation": {
                "source": "日記",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのような饗宴は、ほの暗い広間や、大きな樫の木の廻廊や、綴織を飾った客間にはふさわしいが、現代の別荘の明るい見栄えのよい広間や、派手な客室には向いていないのである。",
              "citation": {
                "source": "クリスマス",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
