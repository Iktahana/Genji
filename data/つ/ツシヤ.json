        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "牧瀬のスポーツシヤツの体からは、半人半獣のやうな健やかな感触が夜気に伝つて来た。",
              "citation": {
                "source": "夏の夜の夢",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣瓶を井戸の中へ落してやつて、その手答へと、パツシヤンといふ音とに、この井戸も此頃の季節になつて、水の出が一層よくなつてゐることを感じた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "周三は眼色を變へて、衝と立起ツたかと思ふと、突如ピツシヤリ障子を閉めきツた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツテラツシヤイ、バンザイ、パパ、バンザアイ　私は微笑した。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学生の頃は、ドイツのエス・フイツシヤアが其発行する文学書に美しい更紗模様の図案を施した。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは江戸趣味に直したエス・フイツシヤア本であつた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ　ヒラカナイ　ツボミサン　モウ　ハルデスヨ、オンモニ　デテ　イラツシヤイ」「マダ　ネンネシテル　ツボミサン　オメメヲ　サマシナサイ」　スルト　ツボミガ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　メヲ　サマシテ　ヰマス」「アラ　アラ、ソレデハ　スグ　デテ　イラツシヤイ」　ヤガテ　ソノ　ツボミガ　フタツニ　ワレテ　ナカカラ　ナニカ　デテ　マヰリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「セ、セツシヤヲ　コロス　ツモリカ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ヤサシク　オツシヤイマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "石の上におちて、力一杯叩きつけられたものゝやうにグツシヤリと潰れてゐるのがあつた。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯磨の白い大きな唾を彼は、徐ろに落すとそれがペツシヤリとつぶれたやうな音を立てた。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は悪いと思ひつゝそつと覗いて見ましたが、手帳の上に鼻をペツシヤンコにおし付けてゐるんだから、よくは読めなかつたが、漸くのことで私は以下のやうな文章の書いてあるところを見ることが出来ました。",
              "citation": {
                "source": "美智子と日曜日の朝の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん」「符牒教えたる」　古着屋の符牒は、今何うか知らぬが「タカラモツシヤワセ」というのであった。",
              "citation": {
                "source": "死までを語る",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "バツシヤンと、暗闇の中にとても凄まじい水音をたゝ――」　といひ終ると、ヒユウツと口笛を鳴らして馬車の速度を速めた。",
              "citation": {
                "source": "ダイアナの馬",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は庭に面した座敷に這入つて行くたびに、「アツシヤ家の崩壊」といふ言葉がひとりでに浮んでゐた。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度娘マツシヤは一番小さい孫を抱いてゐる。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "今そこではマツシヤが赤ん坊を抱いて寐入らせようとしてゐるのである。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「田地はワツシヤが生きてゐるうちに売り払つて、そのお金は使つてしまひました。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからマツシヤが今の婿のワニヤが好きになりました。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよいとミツシヤを抱つこして下さい。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "水車場にはペトルツシヤアがゐる。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「好いよ／＼、グラツシヤア。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラトンはびつくりして、「グラツシヤア」と一声呼んだ。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ高イ所ニイラツシヤラナイデ、コノ涼シイ草ノ葉ノカゲヘイラツシヤイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンガ　キテ　オツシヤイマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五六人の女婢手を束ねて、ぼんやり客俟の誰彼時、たちまちガラ／＼ツとひきこみしは、たしかに二人乗の人力車、根津の廓からの流丸ならずば権君御持参の高帽子、と女中はてん／″＼に浮立つゝ、貯蓄のイラツシヤイを惜気もなく異韻一斉さらけだして、急ぎいでむかへて二度吃驚、男は純然たる山だし書生。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "クーノー・フイツシヤーの言葉を藉りれば、俺の生活は「自由」の問題から「救濟」の問題にその焦點を移さなければならなかつた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
