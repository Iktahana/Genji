        "examples": {
          "standard": [
            {
              "text": "この言葉は現代日本語ではあまり通行していない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "当時、その表現は一般的な通行を得ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しい専門用語は、まだ一般には通行していない。",
              "citation": {
