  {
    "uuid": "6dccf8bc-60f6-5b6e-bd5e-4b420a184003",
    "entry": "通交",
    "reading": {
      "primary": "つうこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
