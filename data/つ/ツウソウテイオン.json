        "examples": {
          "standard": [
            {
              "text": "通奏低音の書法はバロック音楽を学ぶ上で欠かせない知識である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この曲の通奏低音はヴィオラ・ダ・ガンバで演奏されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "作曲家は通奏低音の和声進行を工夫して曲に深みを持たせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "（イ）通奏低音期――十七世紀の初めから十八世紀の中頃（即ちバッハ、ヘンデルが仕事を終えた頃まで）約一五〇年間を含む。",
              "citation": {
                "source": "総説　西洋音楽史の時代",
                "author": "乙骨三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを通奏低音期と呼んだのは通奏低音（一名数字附低音）と云う略譜を見て即席に和音的伴奏をつける事が行われた時代だからで、この命名はリーマンに従ったものである。",
              "citation": {
                "source": "総説　西洋音楽史の時代",
                "author": "乙骨三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
