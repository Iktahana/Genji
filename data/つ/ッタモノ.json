          "literary": [
            {
              "text": "時間がアレバアアイウ者デマトマッタモノヲ書キ度候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト乳母ガ、「ホラ、督チャン、モウ秋デゴザイマスヨ、蟋蟀ガ鳴イテオリマスヨ」ト、ソウ云ッタモノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白ノ一越縮緬ノ裾模様ニ図案化シタ樹木ノ枝ヲ黒ノ濃淡デ現ワシ、周囲ヲ淡イブルーデ影ノヨウニ絵取ッタモノヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯締メハ金ト銀トヲ縄ノヨウニ撚ッタモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子ハ伺ッタモノカドウカ、ドウシタライヽデショウッテ云ッテルンデスガ、………」「………」「伺ッタライヽジャナイカ、コンナ時コソオ前サンノ顔ヲ御覧ニナッタラ、イクラカデモ痛ミヲオ忘レニナルヨッテ云ッテヤッタンデスガネ」「馬鹿」イキナリ予ハ怒鳴ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
