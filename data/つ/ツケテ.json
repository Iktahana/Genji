        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "色ヲツケテミタラヨカロウト考エテイマスガ、時間ト金ガナイノデ、コンナモノデ腹イセヲシテイルノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガ年尾トツケテヤッタ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ミツルクンヲ　オツカケテ　イツテ　三ツ四ツ　ナグリツケテ　ヤリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　オトウサンハ　キメツケテ　シマヒマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアゲテ　ヰタ　イシコロヲ、ポーント　ムカウノ　キニ　ナゲツケテ、マタ　コヒツジヲ　フトコロニ　イレ、スイタ　オナカヲ　オサヘナガラ　一ツノ　ムラヘ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ、イロイロ　サガシタガ、アマリ　ヨイ　キカイガ　ナイノデ、ラツパヲ　カツテ、「コレヲ　サカサマニ　シテ　ミミニ　ツケテ、ラツパノ　シリカラ　キキナサイ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテラノ　コゾウサンニ　バケル　トキハ　コロモヲ　ツケテ　デルノダヨ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサムラヒニ　バケル　トキハ　マゲヲ　ツケテ、ヒゲヲ　ハヤシテ、カタナヲ　オコシニ　サシテネ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイキナリ道子ノ髪ヲツカミ清三ノ持ッテ居タナイフヲ突キツケテ声ヲ立テルト殺スゾト云ッテヤリマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度ソノ時ニ下僕ガカケツケテ清三ヲ抱キ起シタノデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヘルサン、私ノ足ニ綱ヲツケテ上ヘヒツパリアゲテ下サイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ソコデ、カヘルサンハコホロギサンノ足ニ綱ヲツケテ、木ニノボツテモラヒマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タローサンハ　モシモ　トチウデ、コマルコトガデキ、タラト、バスケツトノナカヘ　デンシヨバトヲイレテキマシタノデ、テガミヲツケテ、ハナシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "隙ヲ狙ッテ出タ積リダッタガ、ワタクシモオ供イタシマスト、看護婦ガ見ツケテ附イテ来タノデ一向面白クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪イ習慣ヲツケテシマッタト、颯子ハ後悔シテイヤシナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ詰メテ書キ物ヲナサラナイ方ガヨクハゴザイマセンカ、又痛ミ出スト心配デゴザイマス」予ガ日記ヲツケテイルノヲ見テ佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ニ彼女ハ、遠カラズ予ガ死ンデシマッタ後モ、「アノ馬鹿ナ老人ハ私ノコノ美シイ足ノ下ニ眠ッテイル、私ハアノ可哀想ナ老人ノ骨ヲ今モナオ地下デ蹈ミツケテイル」ト思ウコトヲ禁ジ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ日記ヲツケテイタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ日記ヲツケテイタノダ」と云い、「数日前ニウスウス気ガ付イタ」と云っているけれども、実際はよほど前からハッキリと知っており、かつ内容を盗み読みしていたものと思う。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、その返事も来ないうちに……無理にコジツケテ、ジーナはあるいはその時の私の幻覚だったかも知れないとしても、それならばその電報の返事も来ないうちに、またもや起ったもう一つの不思議な出来事は、それも私の幻覚なり錯覚だと、いうことになるのでしょうか？",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――寺院、坊舎、商家、民屋マデ空袋ノ底ヲサグルガ如ク、残ラズ捜シ出サレ、五十、七十ト高手小手ニ縄ヲカケ、袖ヨリ袖ヘ縄ヲ通シ、珠数ツナギニ一群レヅツ札ヲツケテ、本陣ヘ引キ参リ、或ハ駅所駅所ニテ、立チ所ニ斬リ、鳶ヤ烏ノ餌食ニマカセラル。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手帳の文字）明智ヲイスノ中ニトジコメタママ、ソトカラ縄ヲマキツケテ、イスゴト甲板カラ海ヘナゲコンデシマエ。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
