[
  {
    "uuid": "905b7a19-e8c3-5980-8d7d-24ed1ba848f9",
    "entry": "艶々",
    "reading": {
      "primary": "つやつや",
      "alternatives": [
        "ツヤツヤ"
      ],
      "is_heteronym": false
    },
    "grammar": {
