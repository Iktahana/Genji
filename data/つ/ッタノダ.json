        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ道子ガ裏切ッタノダ、ダカラ今ココデ罰シテヤルンダ」　ト云ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚シタテハソレホドデモナカッタノダガ、コノ三四年目立ッテソンナ風ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダ、確ニコレダ、コレダッタノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日デナクテモヨカッタノダガ、犬ノ事件ヲ早速佐々木ガ知ラセタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂ヘ出レバ颯子ノ顔ガ見ラレルカモ知レナイト思ッタノダガ、「出テハイケマセン」ト止メラレテ、オトナシク云ウコトヲ聴ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ餘リ大事ヲ取リ過ギタノガ失敗ノ原因ダッタ、萬々一ノ場合ニ備エテ仰山ナ準備ナドヲセズ、イツモノヨウニ手軽ニ考エテスレバヨカッタ、博士自身ガ神経過敏ニナッテイタノガイケナカッタノダ、ト云ウ点デハ二人ノ意見ガ一致スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父母ノ墓ハ深川ノ小名木川近クノ或ル法華寺ニアッタノダガ、ソノ後間モナクアノ辺一帯ガ工場地帯ニナッタヽメニ寺ハ浅草ノ龍泉寺町ニ移リ、ソコモ大地震デ焼カレタノデ、今デハ多磨墓地ニ移ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルヘ戻ッテ何シテタンダ」「寒クナリソウダカラ着換エテ来タノヨ、オ爺チャンモ気ヲオ付ケニナラナイト風邪ヲ引クワヨ」四条通リデ買ッテ来タノヲ早速着テ見タカッタノダロウ、白ノブラウスニ、ブリューニ銀ノラメガ繍イ込ンデアルセーターヲ着テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ彼女ト直接閨房ノ※ヲ語リ合ウ機会ヲ与エラレナイ不満ニ堪エカネテコレヲ書ク気ニナッタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏ヲ送ッテ出ルヲ云エバ、実ハソウシテ貰ウ方ガ僕ノ望ムトコロダッタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノカラノ妄想ダッタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子モ一緒ニツイテ行ッタノハ、今マデノ慣例ニヨッタノダロウガ、ソレニシテモ彼女ノ気持ヲ解スルニ苦シム。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "登校ノ途中ニ寄ッタノダト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒドクナレバ失心スルハナカッタノダガ、今日始メテ測ラセラレ、心電図ヲ取リ、腎臓ノ検査モサセラレル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局ハオマエノヤッタコトハスベテ無駄ダッタノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシソンナ戦争ハ元々ナカッタノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史ハイワバアナタノ誕生ト共ニ始マリ、アナタノ死ト共ニ終ワル運命ニアッタノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
