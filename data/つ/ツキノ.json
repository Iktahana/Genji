        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "忽ち肩尖と靴の上とに鈴つけたる戲奴（アレツキノ）の群ありて、我一人を中に取卷きて跳ね※りたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マタ　サツキノ　フトイ　コヱデ、「ワタシハ　ウマデス、チツトモ　オソロシイ　モノヂヤ　アリマセン」ト　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　サツキノ　コワイ　カホデス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "己は博奕の卓に向つて坐して、勝つたり負けたりしてゐるうちに、ふいと卓に覆つてある緑の羅紗の上に散らばつた貨幣の中に、金のチエツキノが一つ交つてゐるのを見附けた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナニ寝ツキノヨカッタ予モ、コノトコロ痛苦ノタメニ寝ツカレズ、各種ノ睡眠剤ヲ用イテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不恰好デ背ノ低イ河合女史ニ比ベルト、優雅ナ体ツキノ妻ノ方ガ似合イソウナモノダケレドモ、身ニツイテイナイ感ジデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝦夷のシャグシャインやツキノイ、南の小島では赤蜂本瓦や与那国の鬼虎のごとき、容貌｜魁偉なる者は多くは終りを全うしなかった。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "またクナシリ島の酋長ツキノイが「クルムセの舟は皮袋のようで、鳥の浮かぶのに同じだ」といったとも書いてあります。",
              "citation": {
                "source": "言語と文化史",
                "author": "――アイヌ文化の探究にあたりて――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
