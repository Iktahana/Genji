        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "即ち、判断（確信）と感情が相互に強め合うのと同様に、判断（確信）と空想も相互に強め合うということである。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            },
            {
              "text": "互の評価というものを大切に考えていて、その人の積極的な面と方向とを強めあうような努力をこめた女同志の友情というものは殆どなかった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「足し算の人生では、甲の人の力と乙の人の力とがそのまま集まるだけで、お互いにちっともその力を強めあうことがありません。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが掛け算の人生になると、甲の人の力は乙の人の中に、乙の人の力は甲の人の中に溶けこんで、おたがいに力を強めあうのです。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
