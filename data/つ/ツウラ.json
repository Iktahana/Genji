          "literary": [
            {
              "text": "彼洞窟は今カプリ島の第一勝、否伊太利國の第一勝たる琅※洞（グロツタ、アツウラ）にして、舟中の少女も亦實にかのペスツムの瞽女ララなりしなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツウランのそばの何とかつて、日本人の墓地にお参りした事もあつたでしよ？",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツウランの駅から、縦貫鉄道で、サイゴンへ向ふ車中での、一つの運命が、ゆき子を、富岡へめぐりあはせたのであらうか。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツフラ沼などもツフとツウと発音の似たるより、故意にか知らずしてかツウラと書し、相伝えて明治の初年に至りしものと想わる。",
              "citation": {
                "source": "古図の信じ得可き程度",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
