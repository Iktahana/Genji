        "examples": {
          "standard": [
            {
              "text": "演劇の小道具として、ユニークな付け鼻が用意された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はパーティーで付け鼻をつけて、皆を笑わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "サーカス団員は、赤い付け鼻で観客を楽しませる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "水の溜つた田のわきにはおほばたねつけばなのの」は底本では「おほばたねつけばなの」］聚落が有つた。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのへんに「おほばたねつけばな」の群落でもあれば、春さきにはもつと水量が増す証拠である。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし喰いつけばなかなか離れないから、たやすく叩き殺せる。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
