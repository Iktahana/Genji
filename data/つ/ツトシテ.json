          "literary": [
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシワ、アクネンユエ、ジツトシテイマス。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ソノ外ニ蜻蛉石線彫阿弥陀三尊石佛ノ一ツトシテ勢至菩薩坐像ノ拓本ヲ載セテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
