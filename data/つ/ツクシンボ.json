        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "東京などですら子供はツクシンボといい、京都近くでもツクツクシまたはツクツクと呼んでいる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "隔地共通の例　ここまで進んで来ると、東京附近や信州などのツクシンボが、二つの方言の複合であることは、最早討論を要せぬと思う。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "土筆は東京附近ではツクシンボといっている子供が多い。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊におかしいのは秋田県の北部で、このツクシンボを猫ノカモコ、もしくは雁ノカモコともカモグサともいっていることで、これもあの形をそういう人間でないもののカモに譬えたのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
