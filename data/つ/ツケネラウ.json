[
  {
    "uuid": "4bb0f77b-d2d0-59e7-8f34-d861547fe45b",
    "entry": "付け狙う",
    "reading": {
      "primary": "つけねらう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
