        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "身体をうち付け合う。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場でインキを二つ三つぶっ付け合うと……ヘエ……ウインクですか……どうも相すみません。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお互に気を付け合うだけで、余所の人には構わずにいる。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御承知のように、物の本質をなすこの微粒子の中心には、刎ねつけあう電気の争いと、磁力の牽きあう愛情とがあります。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "影は事の大小に拘らず心中の投影であるから、互いの表情に生じる無理が傷をつけあう。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人同士が傷つけあうようになっては大変だ。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "入りこんでしまうと、人と人とをきりはなそうとする社会のなかで逆に人々を結びつけあう力を持った。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "リーダーなしに自然発生したということは、アメリカ社会に対して若者が持っていた個人的な体験が、ひとつの思想として人と人とを結びつけあうだけの力を持ちうるまでに複雑にしかもかなり高度に抽象化されていたことを示している。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて傷つけあうことでもさけたいが、そんなわけにゆくだろうか。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして話はだんだんもつれてゆき、日ごろの不平不満を投げつけあうことになる。",
              "citation": {
                "source": "日めくり",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はべつの愛、けものどうしの闘いのように、おたがいが裸の全身をぶつけあう清潔な関係をのぞんでいた。",
              "citation": {
                "source": "演技の果て",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇妙に引きつけあう力が二人を結びつけて、ジャンは生まれてはじめての恋の中に、いまや自分がしっかりと捕えられたのを感じた。",
              "citation": {
                "source": "ジャンの新盆",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "単に男と女のまじわりではなく、一生の哀楽をともにする夫婦のお互いをむすびつけあうことなのだ。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
