        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "歴史的な古民家には、風情のある築垣が巡らされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "築垣の修復には、専門的な技術が必要となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭園の奥に続く道は、苔むした築垣に沿っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "此春より來慣れたる道なればにや、思はぬ方に迷ひ來しものかなと、無情かりし人に通ひたる昔忍ばれて、築垣の下に我知らず彳みける。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "立上りつゝ築垣の那方を見やれば、琴の音微かに聞ゆ。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "燒け殘りたる築垣の蔭より、屋方の跡を眺むれば、朱塗の中門のみ半殘りて、門もる人もなし。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
