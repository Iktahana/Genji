    "definitions": [
      {
        "index": 1,
        "gloss": "tug of war",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "運動会で綱引きが行われ、クラス全員で力を合わせて綱を引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "綱引きは、チームワークと戦略が勝敗を分ける競技だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちが楽しそうに綱引きをしている姿は、見ていて和む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "藤二は、柱と綱引きをするように身を反らして緒を引っぱった。",
              "citation": {
                "source": "二銭銅貨",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "綱引きやら闘鶏――これは二人が帆桁の上へ向かい合いにまたがって、枕でなぐり合って落としっくらをするのである。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次が鳴り物づくしに、首引き綱引き、第三にすえたのが呼び物の一つである盛遠袈裟切りの大しばいでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　必死に手綱引きしめて声の限り制したが、事の勃発する時というものは仕方がない。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛利元就の弓矢を折る話や、内務省かのポスターで見たことのある「綱引き」の例をもってきた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさか君は、死人が綱引き遊びをしていたなんて言うまいね。",
              "citation": {
                "source": "デパートの絞刑吏",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "綱引きの腕車で出て行く、フロック姿の浅井を、玄関に送り出したお増は、屠蘇の酔いにほんのり顔をあからめて、恭しくそこに坐っていた。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るともう、ホースは畦道の小川まで伸びて、それに綱引きのように人がたかっている。",
              "citation": {
                "source": "ゼーロン",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "少時綱引きの力競べになった。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ううん、いわないけど……」「それ御覧、大丈夫だよ、それで勘三叔父さんは、啓ちゃんと仲良しだものねえ」　体操の組では綱引きが始まった。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭で綱引きと来るか」　自分も、竿を構えて、足を踏ん張る。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたまと手の綱引き……じゃアない、糸引きだ。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "喧嘩右近と魚心堂先生、一進一退、三｜更の街上に不思議な綱引きをつづけている。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、乗客中豪州人と南アフリカ人と両方に相分かれ、綱引きの大競争をなし、豪州人の勝利に帰す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "私と弟の静雄、輝夫の三人の兄弟は、ここに来て休む遠近の人力車の背後にえがかれた武者絵を鑑賞すべく、毎日のように通ったが、とくに遠方から綱引きなどで走って来る人力車を歓迎した。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで綱引き俥を四台頼み、輪を列ねて山道を下り、途中で一晩、越後の方からの八十里越を越えた所にある只見という小さな町に泊った。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "綱引きと川通りもち　築城の際、佐東郡毛木村出身の佐々木太郎右衛門も、土木工事の腕を買われて輝元に召し出され、普請奉行二宮太郎右衛門を助けることになった。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この両太郎右衛門が本城のでき上ったとき、祝賀の白島での綱引きで指揮者になった。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この白島の綱引きの行事は、以来明治時代まで伝えられた。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛利氏時代の風習としては、この綱引きのほかには、毎年旧の十二月朔日の「川通りもち」があるだけであった。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようななりで、梶棒に後押し、紅白の綱引き、三人曳きの人力に乗って「掛持ち」をしていた。",
              "citation": {
                "source": "噺家の着物",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "体育館のゲームは数や種類が多く、ボールゲーム、綱引き（tug-of-war）、独楽まわし（top-spinning）、５つの石を手の背に置いて上に投げ掌で受け取る、などなどであった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「綱引き」「綱引き？",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "つなひきみたいに、みんながなわをひっぱると、ノロちゃんはそれを力にして、ふといスギのみきを、するするとのぼっていきました。",
              "citation": {
                "source": "赤いカブトムシ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日は一日、モッコかつぎをして、帰りの電車の中で、涙が出て来て仕様が無かったが、その次の時には、ヨイトマケの綱引だった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小鳥いそがしく水浴びる朝日影・秋が来た雑草にすわる　子供握つてくれるお米がこぼれます八月十五夜は飫肥、油津、大堂津あたりでは全町総出で綱引をやる、興味ふかい年中行事の一つだと思ふ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の恋仲は、まるで綱引のやうな態度で、長い間かゝつても少しの進展もしなかつた、声援をしたり、野次つたり見物したりしてゐた彼は、まつたく退屈をしてしまつたのだ。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、私の父は、近所の俥屋を起したと見え綱引で馳付けて来ました。",
              "citation": {
                "source": "ある抗議書",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "君も綱引御横行と日記にかくさ」「松平侯って、だれですか」「だれだか知れやしない。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯有る小路の湯屋は仕舞を急ぎて、廂間の下水口より噴出づる湯気は一団の白き雲を舞立てて、心地悪き微温の四方に溢るるとともに、垢臭き悪気の盛に迸るに遭へる綱引の車あり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
