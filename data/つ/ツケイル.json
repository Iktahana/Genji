[
  {
    "uuid": "c4d1adb3-f6b6-55f4-866c-48141d1b02db",
    "entry": "付け入る",
    "reading": {
      "primary": "つけいる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
