          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ぬれた地面を避けるように、飛び石を伝い歩いて池の向こう岸へ行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "足元に注意しながら、岩場を伝い歩いて海の見える場所までたどり着いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、水たまりを避けて石から石へと伝い歩いて楽しそうにしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
