[
  {
    "uuid": "40f6391f-44e4-5328-b528-cc997089ce1e",
    "entry": "遣わす",
    "reading": {
      "primary": "つかわす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
