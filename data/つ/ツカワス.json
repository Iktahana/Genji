        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "王は家臣の長年の忠誠に報いるため、褒美を遣わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "神々から遣わされた使者が、人々に希望の言葉を伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "困っている人に温かい言葉を遣わすのも、人としての優しさだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
