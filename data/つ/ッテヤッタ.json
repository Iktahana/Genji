          "literary": [
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子ハ伺ッタモノカドウカ、ドウシタライヽデショウッテ云ッテルンデスガ、………」「………」「伺ッタライヽジャナイカ、コンナ時コソオ前サンノ顔ヲ御覧ニナッタラ、イクラカデモ痛ミヲオ忘レニナルヨッテ云ッテヤッタンデスガネ」「馬鹿」イキナリ予ハ怒鳴ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女ノ人ニコンナ所ヲ触ラセルノハイヤダヨ」予ハワザトソウ云ッテヤッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
