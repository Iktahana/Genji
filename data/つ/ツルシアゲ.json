        "examples": {
          "standard": [
            {
              "text": "ネット上で個人情報が晒され、激しい吊るし上げにあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議室で部長への吊るし上げが始まり、部下たちが次々と不満をぶつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ミスを犯した新入社員は先輩社員たちによる吊るし上げに一時間以上さらされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
