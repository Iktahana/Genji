        "examples": {
          "standard": [
            {
              "text": "急いでいた男は、邪魔な通行人を荒っぽく突き転ばして去っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "喧嘩の最中、彼は相手の胸ぐらを掴んで勢いよく突き転ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ラグビーの激しいタックルが、相手の巨体を軽々と突き転ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「えい、退きねえ」　といって、内職に配達をやっている書生とも思わしくない、純粋の労働者肌の男が……配達夫が、二、三人の子供を突き転ばすようにして人ごみの中に割りこんで来た。",
              "citation": {
                "source": "卑怯者",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に、小者二人、上林の弥造は三人の百姓を突き転ばすようにして歩かせる。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そなたはお船頭の扱いで、栄耀をしているから気がつかなかったろうが、この船の水夫どもは、わしらが乗ったのを縁起悪がり、ちょっと甲板に出れば、後から蹴る、棒切を投げつける、突っころばすやら水をかけるやら、この間などは、控綱に触ったというばかりに、猫吊しにして海へ投げそうにした。",
              "citation": {
                "source": "重吉漂流紀聞",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "来月になれば、どうかなろうが」「じゃ、やっぱり、新町へ突っ転ばすに限りますね。",
              "citation": {
                "source": "治郎吉格子",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
