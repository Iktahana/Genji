    "definitions": [
      {
        "index": 1,
        "gloss": "doing patchwork",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "おばあちゃんは、古い着物をほどいて継ぎ物で新しい布団を作ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女の趣味は、色とりどりの布を使った継ぎ物でタペストリーを制作することだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "継ぎ物の技術は、廃棄される布を再利用する素晴らしい方法です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "暖簾をはいる彼女のうしろ姿を見届けて、半七は二、三軒先の荒物屋へ寄ると、まだ若い女房が火鉢のまえで継ぎ物をしていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            },
            {
              "text": "大四郎のこういうすなおさは類が少ない、椙女は継ぎ物をしていた。",
              "citation": {
                "source": "ひやめし物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌を返すが如くその人を賞讃し、畏敬の身振りもいやらしく、ひそかに媚びてみつぎものを送ったり何かするのだ。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みつぎものとして、差し上げようという考えらしい。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これにはなにかの取りつぎものがあったことだろうと思います。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "交通事情は目に見えて悪化し、これまでより長い時間をかけてやっと帰宅して、これまでよりもっともっと苦労した燃料でやっと炊事をして、さてようようほっとしようとしたときは、停電だったり、たった二十燭のあかりだったりして、つぎものをするのも不便だし、本をよむのも不便です。",
              "citation": {
                "source": "婦人大会にお集りの皆様へ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの紂王にすすめて、百姓から重いみつぎものを取り立てさせ、非道の奢りにふけったり、罪もない民をつかまえて、むごたらしいしおきを行ったりした妲妃というのは、わたしのことでした。",
              "citation": {
                "source": "殺生石",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙のともしきを見給ふ時は、かぎりあるみつぎものをさへゆるされき。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "母はつぎものをする時もある、歌舞伎（芝居雑誌、二六通や水魚連という連中から贈ってきた）の似顔絵を見ている事もあるが、かき餅を焼いたり蕎麦がきをこしらえてくれたりした。",
              "citation": {
                "source": "西川小りん",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "お節は、つぎものの手を止めて、影の薄い夫の姿を見入った。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つりあげた　７ひきの　ぷりぷりした　コイは　しまぬしさまへの　みつぎものです。",
              "citation": {
                "source": "きたりすナトキンのはなし",
                "author": "THE TALE OF SQUIRREL NUTKIN",
                "note": "青空文庫"
              }
            },
            {
              "text": "チンクルベリと　６ぴきの　りすは　ぷりぷりした　コイを　それぞれ　１ぴきずつ　はこんだのですが、　ナトキンは　おぎょうぎも　よくないので　みつぎものなんか　まったく　もちません。",
              "citation": {
                "source": "きたりすナトキンのはなし",
                "author": "THE TALE OF SQUIRREL NUTKIN",
                "note": "青空文庫"
              }
            },
            {
              "text": "倦まず立働く人で、お雪の傍に居ても直に眼鏡を掛けて、孫の為に継物したり、娘の仕事を手伝ったりした。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "大納言と五十も歳が違うと云うのは、まさかとも思われるけれども、世継物語には「わづか二十ばかりにてぞおはしける」とあり、今昔には「二十に餘る程」とあるので、二十一二歳であったかと思える。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その同じ主題が大宅世継の昔話として書かれると世継物語ともいえたし『大鏡』ともいえた。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "世継物語とは歴史物語の意だし、『大鏡』の鏡は支那の『資治通鑑』などの鑑と同じく、支那史学の立場から見た歴史の意味を持っている。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
