      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "死体は行儀よく顔と顔とをつき合わするようにして並びながら倒れているのに、受けているふたりの傷は向こう傷でなく、うしろからやられたうしろ袈裟とは、いかにも奇怪至極です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々水を飲むために眼をさまして見ると、頭をつき合わす様にして寝ているめいめいの姿が、酔った心に涙の滲むほど親しいものに眺められた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "はしなく浮世の用事思いいだされければ朝とくより乗合馬車の片隅にうずくまりて行くてを急ぎたる我が行脚の掟には外れたれども「御身はいずくにか行き給う、なに修禅寺とや、湯治ならずばあきないにや出で給える」など膝つき合わす老女にいたわられたる旅の有り難さ。",
              "citation": {
                "source": "旅の旅の旅",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "一足入ったら、もう顔つき合わすしかなかった狭さだったから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "板戸を引けば鼻つき合わす客と亭主だ。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "征服、侵略、簒奪、武力による各国民の競争、諸国王の結婚結合よりくる文化の障害、世襲的暴政を続ける王子の出生、会議による民衆の分割、王朝の崩壊による国家の分裂、二頭の暗黒なる山羊のごとく無限の橋上において額をつき合わする二つの宗教の争い、それらももはや今日のように恐るるに及ばないだろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
