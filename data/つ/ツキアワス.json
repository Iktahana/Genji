[
  {
    "uuid": "73d9dfec-eac9-5c26-a773-045fe8c9fab4",
    "entry": "つき合わす",
    "reading": {
      "primary": "つきあわす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
