    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そうして、その一方が凹入して壺形になるのが発生の第一階段である。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、壺形をした渓という意味で、上部は、子安貝に似た裂罅状の開口。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……私の体、私の下にしている脇腹は、私の心のどうしても忘れえない過去を忠実に覚えていて、細い鎖で天井に吊した壺形のボヘミヤ硝子の豆ランプの焔や、シェナ大理石のストオブを私に思い起させた。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "發掘品としては三十六｜年三｜月十九｜日に、活東子が方形裏模樣の土器を出し、望蜀生が、同二｜月二十二｜日に壺形土器を出し、玄川子が土偶の足と、第二圖ニの如き、珍らしく複雜なる把手を出し。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "權現臺の懷古",
                "note": "青空文庫"
              }
            },
            {
              "text": "濤川惣助氏の無線七宝の花瓶というのは、高サ二尺、胴の差し渡し一尺位で金属の肌の上に卵色の無線の七宝が施されたもので、形は壺形をしている。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "聖上行幸当日のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを味よく薄目に煮たのを、壺形の器に入れて膳に乗せます。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ伏見区竹田内畑町ニアル安楽寿院五輪塔、水輪ガ下ノ方デ細マッテ壺形ニナッテオリ、火輪ノ軒ノ反リガ厚ク、ヤダルミノ工合ガ風輪空輪ノ形ト共ニ鎌倉中期カラ後期ニ移ル頃ノ代表的ナ遺品デアルト、川勝政太郎氏ガ述ベテイルアノ作品、アレナドハドウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度今頃白い小さい壺形の花が咲いて居る筈だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "邪戀の償ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "平次は尚もあちこちと歩いてゐるうちに、裏庭の隅に、茶の木に似て六尺あまりに延び、白くて小さい壺形の花を着けた馬醉木を見付けました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "邪戀の償ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」＊14　足ぬくめ――Feuertopf. 足をぬくめるために用いる壺形の煖爐。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
