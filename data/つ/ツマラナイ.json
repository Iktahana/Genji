[
  {
    "uuid": "7cda8493-860f-578c-86d4-e0627907cf20",
    "entry": "詰らない",
    "reading": {
      "primary": "つまらない",
      "alternatives": [
        "つまらねー"
      ],
      "is_heteronym": false
    },
    "grammar": {
