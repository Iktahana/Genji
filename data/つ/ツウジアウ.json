[
  {
    "uuid": "965735df-5b66-5e2d-bc67-989d421f8dcf",
    "entry": "通じ合う",
    "reading": {
      "primary": "つうじあう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
