        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "チームメンバーが互いに意見を通じ合い、より良い解決策を探した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子どもと向き合い、親身になって話を聞くことで心が通じ合うだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "異なる文化背景を持つ人々と積極的に交流し、互いの理解を通じ合うべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
