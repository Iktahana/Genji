        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山歩きの際、誤って蔦漆に触れてしまい、ひどいかぶれに悩まされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "蔦漆は、秋になると葉が鮮やかな赤色に染まるが、触れると危険だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭の手入れをする時は、蔦漆のようなかぶれる植物に気をつけなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "物の枯れてゆく香いが空気の底に澱んで、立木の高みまではい上がっている「つたうるし」の紅葉が黒々と見えるほどに光が薄れていた。",
              "citation": {
                "source": "親子",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところどころにある、つたうるしが真っ赤になっていました。",
              "citation": {
                "source": "空晴れて",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンシユユと径を隔てて向へるツタウルシの木の小さき細なる花、その枝に毛虫の繭ひとつ透きて見ゆ。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンシユユと径を隔てて向へるツタウルシの木の小さき黄なる花、その枝に毛虫の繭ひとつ透きて見ゆ。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツタウルシの毒でかぶれるのと似ているが、アグア・マーラの毒はもっと速く、鞭で打つように人を襲う。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
