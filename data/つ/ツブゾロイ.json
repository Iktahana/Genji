        "examples": {
          "standard": [
            {
              "text": "このオーケストラのメンバーは皆実力派で、本当に粒ぞろいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新人女優たちは皆美しく、今年のオーディションは粒ぞろいだと言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "展示されている作品はどれも素晴らしく、まさに粒ぞろいの逸品ばかりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "皆相当粒ぞろいではあるがつきぬけるようなもの一つもない。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮さまには、粒ぞろいお小さい五人の和子がおありである。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
