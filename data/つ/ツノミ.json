        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "向匱＝向津（ムカヒツ）・五御魂＝厳御魂（イツノミタマ）・速狭騰＝天疎（ハヤサカリ＝アマサカル）此だけ共通で、神の性が本書では姫、一書では向匱男とあるから男神なのであらう。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "別ニ給料ヲ受ケズ、唯酔客ノ投ズル纏頭ヲ俟ツノミ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因ニ云フ、確乎タル証拠ナシト雖モ、旧来ヨリ言伝ヒ聞伝ヒヲ参考スルニ、山野等ノ名称粗々縁故アルモノヽ如クナレバ、記シテ後来ノ識者ニ俟ツノミ。",
              "citation": {
                "source": "尾瀬の昔と今",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大刀の名はサジフツの神、またの名はミカフツの神、またの名はフツノミタマと言います。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
