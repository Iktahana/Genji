          "literary": [
            {
              "text": "又句読点もないのですが、わかり易い為普通の文にして読みます）問　ソウスルト被告ガ道子ヲ殺ス気ニナッタノハ、道子ガ他ノ男ニ心ヲ移スヨウニナッタカラカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ馬鹿サンネ、私がアナタニ身ヲ任セタノハカラカッタカラダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシタ方ガコノ老人ノ気ニ入ルコトヲ看テ取ッタカラデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツモ締マリガシテナイト云ッタカラ、ホントカドウカ試シテ見タノサ」云イナガラ予モ浴室ノ方ヘ首ダケ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョウド自分ノ右隣ニイラシッタカラ、左ノ指ニ篏メテイラシッタノガハッキリ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年前マデハオ爺チャンモマダ足腰ガイクラカ達者グッタカラ、大キナ犬ニ飛ビ着カレテモ心配ナコトハナカッタガ、今日デハ事情ガ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタ一日デ、アタシヘト／＼ニナッチャッタカラ逃ゲ出シタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ最初敏子ニ差シタノダガ、「私ハダメデス、ドウカママニオ酌ナスッテ」ト敏子ガ云ッタカラデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハカネテカラ、敏子ガ木村ヲ避ケル風ガアルヲ、彼女モ感ヅクニ至ッタカラデハナイデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、「コノゴロ僕ノ在宅ノ時ニ妻ガ外出シテイルガアルカラ彼女ヲ連レ出シテ二三時間過シテ来テクレ」ト云ッタカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ父サンニハ約束ノ「アラビアン・ナイト」ガ「ケリー・ウォルシュ」ニアッタカラ持ッテ行クト云ッテ下サイ、コレハ大人ノ読ム「アラビアン・ナイト」デス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「娘ダッタカラ、ワカラナイ！",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
