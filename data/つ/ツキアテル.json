        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "風が坂道の砂を吹き払って凍て乾いた土へ下駄の歯が無慈悲に突き当てる。",
              "citation": {
                "source": "家霊",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五人ほどの部下は、その脚下にうずくまって、折敷きの構えと云うのか、小銃の筒口を、こっちへ向けたまま、ギ、ギ、ギ、ギ……と舳を突き当てるように寄ってきた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "程なく寂然として寝に着きさうだから、汽車の中でもくれ／″＼いつたのは此処のこと、私は夜が更けるまで寐ることが出来ない、あはれと思つて最う暫くつきあつて、而して諸国を行脚なすつた内のおもしろい談をといつて打解けて幼らしくねだつた。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然につきあつて遊ぶものも少なくなる。",
              "citation": {
                "source": "一席話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏切られたと知つた瞬間、子供の泣きツ面のやうな妙な顏をするが、すぐにけろツとして、相手の人間の眞直ぐなところとばかりつきあつて、またも騙されるやうな因をつくる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それがね旦那、その亭主は庄さんていふんですが仲々いゝ男でね、一寸お世辭もいゝし、つきあつちや惡いことはまあ有りませんよ。",
              "citation": {
                "source": "おふさ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は顔中愛嬌をたたへ、私に接近しながらいふのです、『お差支へがなかつたら、お茶でも、つきあつて下さいません？",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく友人が私にむかつて、『お前は青木とつきあつてゐるのか』と青木と私と交際してゐるといふことを非難めいて言はれたものである、青木も田舎から自信をもつて東京に出てきた。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は家の留守を預つてゐる僕につきあつて終日三人とも家でゴロ／＼した。",
              "citation": {
                "source": "文壇諸家一月五日の日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たつたひとりで――まあ、稀にはつきあつて――」　ぱつたりと樽野がＧに出遇ふと、彼は、とても樽野に口を開かせない程の能弁で、恰も電話口に立つて喋舌つてゐる人のやうに独りで愛想が好かつた。",
              "citation": {
                "source": "村のストア派",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――電話をかけに行かなくても、もう少し、ビールを飲むのつきあつて、浅草へ行きアいゝンだらう。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつと俺も納得したンだからね、少しつきあつて行きなさい」　直吉は酔つた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆき子も二三杯の酒をつきあつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の友人と云つてもほんの一人か二人位で、それも、深くつきあつてゐる程度ではない人達なので、早苗は、全くの一人ぽつちであつた。",
              "citation": {
                "source": "風媒",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一緒に少しつきあつて下さい」と縁無眼鏡をかけた背の高い青年はギクシヤクするやうな身振りで私を誘つた。",
              "citation": {
                "source": "二つの死",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅かに昔の夢をなつかしんで、未練たらしく輕蔑しながら、平氣な面をしてつきあつてゐる。",
              "citation": {
                "source": "貝殼追放",
                "author": "女人崇拜",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分とは、僅かに一年半ばかり同じ教室に机を並べたばかりだつたが、その一年半の終りの三四ヶ月の間に、かなり親しくつきあつた。",
              "citation": {
                "source": "貝殼追放",
                "author": "女人崇拜",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんただつて、たまにはつきあつてもいゝだらう。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかはり、あんたも盃みたいなものほつといて、コツプでつきあつたらどうですか。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "淫賣だらうがなんだらうが、よさゝうな人間ならつきあつて見るに限る。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そんなら暫くつきあつて下さい。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おりかさんみたやうな凄いのとつきあつてゐるんだもの。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は親しくつきあつて居るやうに聞いたものだから……」「いや、三田さん。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間に、最も親切にかたくなな私をよき友達としてつきあつて下さつた皆さんに別辭を述べるには多少の感慨があります。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤、父家橘が藤松を勤めて居た程だが、其時の辰五郎の女房お仲は、後に老い女房としてつきあつた源之助であつた。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、矢口渡に六蔵をつきあつた鴈治郎が、あまり柄が大き過ぎて気味わるかつたことが印象してゐる。",
              "citation": {
                "source": "日本の女形",
                "author": "――三代目中村梅玉論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが東京へ出たり、京都の芝居あたりで東京役者につきあつたりすると、初めて彼が別の立ち場に置かれてゐることを知つたのである。",
              "citation": {
                "source": "日本の女形",
                "author": "――三代目中村梅玉論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊五郎などは、その吃又に女房をつきあつて貰つて、実に感謝すべき行儀のよい脇役を得た喜びを正直に人にも告げた。",
              "citation": {
                "source": "日本の女形",
                "author": "――三代目中村梅玉論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに俊徳丸を菊五郎がつきあつたら、どんなに歌舞妓復興の気運を高めることだらう。",
              "citation": {
                "source": "見ものは合邦辻",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の歌は、大人でなければわからない氣持ちをあまり詠みすぎてゐるので、今度は説明をすることは出來ないが、一例をあげると、自分の親しくつきあつてゐた人が、行くことも出來ぬところに隱れてしまつて後、その人のゐた家を訪問して一人悲しんだ名高い歌があります。",
              "citation": {
                "source": "歌の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
