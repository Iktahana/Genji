          "literary": [
            {
              "text": "又句読点もないのですが、わかり易い為普通の文にして読みます）問　ソウスルト被告ガ道子ヲ殺ス気ニナッタノハ、道子ガ他ノ男ニ心ヲ移スヨウニナッタカラカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ知ッタノハ数エ年七十七歳デ喜寿ヲ祝ッテカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ心理状態ニナッタノハ最近デアルガ、ソレガマス／＼極端ニナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭デバーベキューガ始マッタノハ夕刻六時半頃ダッタガ、賑カデ景気ガヨサソウナノデ、予モツイ若イ者タチノ中ヘ参加スル気ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大キナ犬ヲ飼ウヨウニナッタノハ浄吉ガ嫁ヲ迎エテカラデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本橋ヤ、鎧橋ヤ、築地橋ヤ、柳橋ノ、アノ綺麗ダッタ河ヲ、オ歯黒溝ノヨウニシチマッタノハミンナ奴等デハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……………………………………………………………………………………………………………………………………………………………………十七日ノ朝、颯子ガ何ノ断リモナシニ勝手ニ東京ヘ立ッタコトヲ知ッタノハ、午前十一時頃デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食ノ時ニ食堂ニ見エナカッタノハ、朝寝坊ノ彼女ノ常デアルカラ、予ハマダ颯子ハ寝テイルモノト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前ガソレヲ知ッタノハイツダ」「タッタ今デス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハアタシノ想像ダケレドモ、颯チャンガ立ッテ行ッタノハ外ニ何カ、早ク東京ニ帰リタイ理由ガアッタノデハナカロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ僕ハ彼女ニ都合ノヨイ、彼女ノ耳ニ痛イヨウナヲ書ク気ニナッタノハ、彼女ノアマリナ秘密主義、―――夫婦ノ間デ閨房ノトシテ聞キタガラズ、タマタマ僕ガ猥談メイタ話ヲシカケルトタチマチ耳ヲ蔽ウテシマウ彼女ノイワユル「身嗜ミ」、ア　偽善的ナ「女ノラシサ」、アノワザトラシイオ上品趣味ガ原因ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤハリ脳貧血ダソウデ、「御心配ハアリマセン」ト云ッテ、ヴィタカンフルノ注射ヲシテ児玉氏ガ帰ッテ行ッタノハ、夜中ノ二時デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子モ一緒ニツイテ行ッタノハ、今マデノ慣例ニヨッタノダロウガ、ソレニシテモ彼女ノ気持ヲ解スルニ苦シム。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西班牙デ、一番酷カッタノハ、カステイルノ高原……」「智利のサンティアゴは？",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
