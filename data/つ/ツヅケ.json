        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソシテ、オマエタチノ　オトウサンヤ　オカアサンタチハ　ヨク　コノ　バシヤノ　ゴオンヲ　ウケタノサ」　ソシテ　ソンチヨウサンハ　イヒツヅケマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（林直規氏談）　　　　　　　　　　◇　翁の謡には「三ツ地」も「ツヅケ」もないと誰かが云っていた事を記憶している。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろんその当時の筆者には「三ツ地」が何やら「ツヅケ」が何やら解らなかったが、翁の後までも生きていた囃子方の古賀幸吉氏や栗原伊平氏は、「実に打ちよくて、大きくて気乗りがした」　と云っていた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――コノママワガ戦隊ガ前進ヲツヅケルトキハ十分ノノチ、彼ノ艦隊卜衝突ノホカナシ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハエリマキモ外タウモキテヰナカツタノデ、ハクシヨン、ハクシヨン、ハクシヨントクシヤミガツヅケサマニデマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ハンブン　ヰネムリナガラ、ソレデモ　ハナシヲ　ツヅケテヰマス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ハンブン　ヰネムリナガラ、ソレデモ　ガマンシテ　ハナシヲ　ツヅケテヰマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "………　………妻ハ盛ンニ「木村サン木村サン」ト呼ビツヅケタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………自分ノ頭脳ガ日ニ日ニ駄目ニナリツツアルニノミ熱中シテイタラ、イツノマニカ淫慾以外ノスベテノヲ五分ト考エツヅケル根気ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
