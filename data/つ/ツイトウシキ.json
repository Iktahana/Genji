        "examples": {
          "standard": [
            {
              "text": "その国の元首の死去を受け、全国で追悼式が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "追悼式では、犠牲者一人ひとりの名前が読み上げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "故人の追悼式が厳かに挙行された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "続いて追悼式がはじまって読経になり演説になったので、山田はもうすこし旧友と話してみたいと云う興味があったけれども、それが終るまで殆んど一時間半ぐらいは何も云うことができなかった。",
              "citation": {
                "source": "雨夜続志",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その追悼式を、中学の図書室で挙げた時、制帽をかぶった能勢の写真の前で悼辞を読んだのは、自分である。",
              "citation": {
                "source": "父",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
