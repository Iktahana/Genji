        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古くなったタイヤを新品に付け替え、長距離ドライブの準備を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "部屋の雰囲気を変えるために、照明のシェードを和風のものに付け替えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "道路の付け替え工事が行われ、以前よりも通行がスムーズになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ファイル形式の変更が求められる機種向けの変換ツール、ファイル名の付け替えツールなど、それぞれの環境での使い勝手を良くする小道具も、そろってきている。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまではＯＳ／２　３・０として開発してきたものを、ＩＢＭとの大喧嘩以降２・０からの継承性をわざわざ切り捨てて名前を付け替えたマイクロソフトのＷｉｎｄｏｗｓ　ＮＴもまた、ＨＭＮＭへの試みだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし時計の針はきっと、あとから付け替えたものにちがいありません。",
              "citation": {
                "source": "玉振時計の秘密",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話局に新設や付け替えを申し込むと、まず電電公社から元請けに仕事がまわされ、そこから下請けの作業グループに仕事が割り振られる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九八五（昭和六十）年八月にＰＣ―９８０１用として発表された〈一太郎〉と名付けられた製品が、ＡＴＯＫと名前を付け替えられた変換モジュールを他のアプリケーションでも利用できる構造を採用していた点は、高い評価を受けた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "錘は円錐形十五匁から三十匁位まで用い、その日の浪の高低により付け替える。",
              "citation": {
                "source": "ガラガラ釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "革ひもなら、すぐに付け替えができます。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕切りと合せて正札の付け替えもいたさなければなりませず、皺のできておりますところへは霧を吹いて火熨斗も当てなければなりませんし、三、四日は急に眼の廻るような忙しさでございました。",
              "citation": {
                "source": "蒲団",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、新入院の者ある時には、必ず、二階の見はらしよき一室に寝かせ、電球もあかるきものとつけかえ、そうして、附き添って来た家族の者を、やや、安心させて、あくる日、院長、二階は未だ許可とってないから、と下の陰気な十五名ほどの患者と同じの病棟へ投じる。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで結構や」　今まで高等学校の制服をボタンだけつけかえて通して来たのだった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は右脚を先にするは愚なこと、はでな孔雀の羽の代りに、じみな牛の尻尾をつけかえまいものでもなさそうだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのカフスに、指の跡をつけないよう、ボタン穴のところをくずさないよう、小さい私は目玉に力を入れてボタンをつけかえる。",
              "citation": {
                "source": "父の手帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その故障の箇所は、モーター全部をとりかえないとだめなことがわかりましたので、別なモーターを地下の倉庫からさがして、つけかえることにしまして、やっとなおる見込みがたちましたが、なかなか手がかかって、すぐというわけにはいきません。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "空色のドレスのそでがきれたので、メグねえさんが新らしいのとつけかえて下さいましたが、色が青すぎて前のほうがだめになりました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "英ちゃんは、釣りざおの糸をしらべたり、浮きをつけかえたりしていましたが、「もう生意気なことはいわんな。",
              "citation": {
                "source": "小さな弟、良ちゃん",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "……言うがにまさる、いやおうなく、なっとくのいくことがある」「へえ」　といって、ひょろ松、餌をつけかえて鈎を沖に投げこみ、腰をひねって竿の先をさむらいもののほうに向け、凝ったようになって向うの竿先をにらみ始める。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "鎌いたち",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はますます熱心に餌のつけかえをやっていると、彼方海岸の方から、子供がかけて来る。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その子供たちは餌を使い果たしたのか、人の魚籠を見て廻ったり、脚を組んで沖を眺めたり、そんなことばかりしていたんだが――、ふと僕は餌をつけかえようとして、傍の餌箱を見た。",
              "citation": {
                "source": "魚の餌",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "店頭用やジャズ・レコードなどを惜しげもなくかける場合ならば、一々針をつけかえる手数も省けて一概に悪いとは申されぬ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "首飾りをつけかえる。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かしら今夜の良人の気分を察するところがあって、電灯も五十｜燭の球につけ替えた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるじ、的替えい」「はっ」　寸を縮めてつけ替えたのは三寸。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "的替えい」　英膳、鞠躬如としてつけ替えたのは一寸角の金的です。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら、ほら、のう不埒ないたずら共じゃ、早うつけ替えい」　とぼけて松平の御前は竿の方へ、土州侯は腰を低めてお駕籠の方へ、まことにどうもそのぐずり加減、ぐずられ加減の程のよさというものは、なんともかとも言いようがない。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、この仲間うちで各々の札につけ替えた名前である。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は宮村まで供をするという兼吉を見て、ともかくも馬で行かれるところまで行き、それから先は牛の背に荷物をつけ替えようと語り合った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋も得たし、ジャーナリズムにネタを提供して金持にもなったが、元の本物の心臓につけ替えてもらわねば不幸かぎりなしとの訴えだった。",
              "citation": {
                "source": "心臓盗難",
                "author": "烏啼天駆シリーズ・２",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三十分して、魚の当たりのないときは、餌を調べてつけ替える。",
              "citation": {
                "source": "那珂川の鱸釣り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、いま迄蝦を餌につけて置いた英太郎は、烏賊につけ替えると、道綸を下すが早いか、ガッチリと手応えがあった。",
              "citation": {
                "source": "葵原夫人の鯛釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来｜沮洳の地で、水芭蕉や座禅草など生えていたが、今は道が少し上の方へつけ替えられた。",
              "citation": {
                "source": "白馬岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
