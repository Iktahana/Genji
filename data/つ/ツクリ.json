  {
    "uuid": "f143e2f3-801e-5245-841c-4546b4e03ce1",
    "entry": "造",
    "reading": {
      "primary": "つくり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
