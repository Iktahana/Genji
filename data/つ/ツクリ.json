        "examples": {
          "standard": [
            {
              "text": "彼女は今夜のダンスパーティーのために、いつもより一段と華やかな作りをして現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「その凝った髪の作り、今日の和服にとてもよく似合っているよ」と彼は照れながら褒めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "劇団の俳優たちは、開演前に念入りな顔の作りをして、それぞれの配役になりきっていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
