    "definitions": [
      {
        "index": 1,
        "gloss": "muttering voice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験中、隣の席から誰かのつぶやき声が聞こえてきて集中できなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は不満げにつぶやき声で何かを言っていたが、よく聞き取れなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "暗闇の中、微かなつぶやき声が聞こえ、思わず身構えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そして彼女とて、もしもその箱の蓋についた不思議な顔が、そんなに誘惑するように彼女を見なかったら、そして又、箱の中の小さなつぶやき声が、前よりも一層はっきりと聞えるような気がしなかったら、多分そうしたことでしょう。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他のものは、ただ混雑したつぶやき声、乱れたさけび声、そして反響のまた反響する声ばかりでございます。",
              "citation": {
                "source": "ウスナの家",
                "author": "THE HOUSE OF USNA",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子にまた座りなおしてぼんやりと物思いにふけっていた時、教授のつぶやき声じゃないかすかな音に気がついた。",
              "citation": {
                "source": "観点",
                "author": "THE POINT OF VIEW",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
