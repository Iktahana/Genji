    "definitions": [
      {
        "index": 1,
        "gloss": "ready-made clothing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "デパートのセールコーナーには、手頃な価格の吊しのスーツがたくさん並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "急な葬儀に備えて、百貨店で吊しの喪服を一着購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "吊しのスーツでも専門店で裾上げしてもらうと、ずいぶん見栄えが変わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "涼しい風は店の灯を吹き、軒に吊した籠や箒やランプの笠を吹き、見て過ぐる自分の胸にも吹き入る。",
              "citation": {
                "source": "やもり物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "店へはいると一面に吊した絵のニスの香に酔うてしまう。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばん目に止るのは足の方の鴨居に笠と簑とを吊して笠には「西方十万億土順礼　西子」と書いてある。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、木魚を頬ぺたに吊してゐるやうにも見えるわね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速、焚火にかかって、徒渉に濡れた脚絆を乾すやら、大鍋を吊して湯を沸かしたりする。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ持って来て、手を縛って、梁へ吊しやがったな。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、網棚から兵児帯を吊して、首でも縊る時のように、輪の中へ顎を引っかけて、グウグウ眠っている男があった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして縁側の軒端に吊しておいた。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "分らぬ事として竿の先に吊しておくのは慎重ではあろうが忠実とは云われまい。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなものでも半年も戸外に吊して雨曝しにして自然の手にかけたら、少しは落着いたいゝ色調になるかも知れないと思つたりした。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の中に大きな重い振子を吊し、その周囲に粘い油を入れるというのであるが、まだ実際の試験をするところまで行かぬらしい。",
              "citation": {
                "source": "汽船の改良",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」先生は、黒板に吊した大きな黒い星座の図の、上から下へ白くけぶった銀河帯のやうなところを指しながら、みんなに問をかけました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "定まった弾条に定まった重量を吊し、定まった温度その他の同時的条件を一切一様にしても、その長さは一定しないのである。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜匁の分銅を一分間吊した後と、一時間あるいは一昼夜吊しておいた後とは幾分の差がある。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "またあらかじめ百匁を五分間吊した後十匁をかけたのと、一匁を同じく五分吊した後同じ十匁を懸けたのとでも若干の相違がある。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十月一日『東京朝日新聞』）　　　　　　　　　十一　　　　　　磁力起重機　強い電磁石を使って重い鉄片などを吸い付けて吊し上げ、汽車や汽船の荷上げや荷積みをする器械が近来｜処々で用いられる。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また健全な方を籠に入れて吊しておいても、蚤が飛び上がる事の出来るくらいの高さに吊したのではやはり感ずるが、それ以上高くするか、また細かい網に入れて蚤の出入りせぬようにしておけば伝染せぬという。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "五回に一回くらいは風船に旗を吊したものや、相撲や兵隊などの人形の出るのがあった。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋に残っていた六人は、窓に吊した破れたアンペラのかげから外をのぞいた。",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」先生は、黒板に吊した大きな黒い星座の図の、上から下へ白くけぶった銀河帯のようなところを指しながら、みんなに問をかけました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井の隅には拡げた日傘が吊してある。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りにはやはりたき火の痕もありましたし、電気会社には、まるで燈台で使ふやうな大きなラムプを、千｜燭の電燈の代りに高く高く吊してゐるのも私は見ました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　先生は、黒板に吊した大きな黒い星座の圖の、上から下へ白くけぶつた銀河帶のやうなところを指しながら、みんなに問ひをかけました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちはそれから、誰かが助けに来て下さる目標になるように、神様の足※の一番高い処へ、長い棒切れを樹てて、いつも何かしら、青い木の葉を吊しておくようにしました。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "懐中から浅黄地に白の唐草模様の大きな風呂敷を一枚引っぱり出して、両手で高々と吊し拡げた。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "親友の黒田が先年まで下宿していた荒物屋の前を通った時、二階の欄干に青い汚れた毛布が干してあって、障子の少し開いた中に皺くちゃに吊した袴が見えていた。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側に吊した金魚鉢か何かのやうに、毀れ易く、庭の緑を映してゐるやうなものであつた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何の祝宴か磯辺の水楼に紅燈山形につるして絃歌湧き、沖に上ぐる花火夕闇の空に声なし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫の宙返り　猫を倒につるして高い処から落せば空中でくるりと身をかわしてうまく四つ足で立つ。",
              "citation": {
                "source": "猫六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると町〔の〕家々ではこんやの銀河の祭りにいちゐの葉の玉をつるしたりひのきの枝にあかりをつけたりいろいろ仕度をしてゐるのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "hanging",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
