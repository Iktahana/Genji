[
  {
    "uuid": "78fb39c2-19ba-5e84-a57c-684d40c0acf6",
    "entry": "辻辻",
    "reading": {
      "primary": "つじつじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "every street corner",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "選挙期間中ということもあり、街の辻辻で候補者が演説を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "辻辻に設置された掲示板に、新しいポスターが貼られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "辻辻の風景を写真に収めながら、知らない街を散策するのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "花祭ありし夕か、群衆のなだれ長閑かに時花歌街を流れて辻辻に山車練る日なり、行きずりに相見しばかり、高華なる君が風雅も恋ふとなく思ひわすれき。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入つては音楽祭だと云ふので辻辻に焚火が行はれ、男の児等は爆丸を投げて人を驚かし、又｜大通には音楽隊を先に立てた騎馬の市民の提灯行列があつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "街は夕方に向つて散歩する露支人の雑沓を増し、露西亜娘が辻辻でリラや「ねぢあやめ」の花を売り、支那の少年が砂糖煮の山査子を売るのに客を呼んでゐる。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻蟻の穴がつづいてゐるうす暗い地下鉄道のやうに地のそこ深く闇が張りつめられてゐる緑色の巷や町や辻辻のあかるい明りを点したところにもくらい穴がつづいてゐる。",
              "citation": {
                "source": "忘春詩集",
                "author": "忘春詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "町々つじつじの警備に出払ってしまってひっそり閑と静まり返っているお番所の中へさっさとはいっていくと、てこでも動くまいといいたげに、どっかりすわったところは訴状箱の前でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時のごとく目にはいったものは、町々つじつじを堅めているものものしい捕方たちの黒い影です。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
