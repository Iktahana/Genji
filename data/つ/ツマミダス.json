        "examples": {
          "standard": [
            {
              "text": "映画館で大声を出して騒いでいた観客が、スタッフにつまみ出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "不審な男が会場に紛れ込んだので、警備員がすぐにつまみ出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "泥酔して他のお客さんに絡んでいた男を店からつまみ出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
