        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イツモハ　ナカヨシダツタノデスケレド、アンマリ　マンナカノ　ホシガ　サムイ　サムイト　イフノデ　ホカノ　二ツノ　ホシニ　イジメラレタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　ナガレボシダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチノ　上ニ　ヒカツテ　ヰタ　モノハ、ナクナツタ　ホシデハ　ナクツテ、ガラスビンノ　カケラダツタノデス。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチガ　トツゼン　ヒツクリカヘツテ、キゼツシテ　シマツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ、イタチサンガ、オナラヲ　シタイノヲ　アマリ　ガマンシテ　ヰタノデ　コンナ　コトニ　ナツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オネコサンハ、アヒルサンノ赤イ洋服ガウラヤマシクテナラナカツタノデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イマ、オトナリノハタケムラカラ、ヂヤガイモサンガ、アソビニキテヰタノデスガ、キウニヰナクナツタノデス。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨツト　ソウダンシタイコトガ　アツタノデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヨツト　サウダンシタイコトガ　アツタノデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マハリノ人ハトテモオカシカツタノデスケレド、ヤツトガマンシテワラヒマセンデシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無關係ナモノガ間違ツテ入ツタノデス。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲ナオリノ式ハ、無事ニ終ツタノニ、女ノ事デ、オタクノ金五郎サント、友田喜造親分ト、ソシテ、ワタシタチノ間ニ、悪イイキサツガ出来テシマツタノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、イウテ居ツタノデスガ、オ京サンモ、イランオ世話様トイウ、タイ度デシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、二人ダケノ事ナラ、マダ善カツタノデスガ、今度ノ様ナ事ニナルト、困ツテシマイマス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
