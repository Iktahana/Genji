        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「不審な奴め、今すぐここからつかみ出してやる！」と主人は激怒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会場を混乱させていた酔っ払いは、屈強な警備員たちによって屋外へつかみ出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "執務室に無断で侵入した記者は、秘書の手によって速やかにつかみ出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
