        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母が作るおはぎは、甘さ控えめの潰し餡が絶品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パンにたっぷりの潰し餡を乗せて食べるのが私の朝食の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "和菓子の中身に詰めた潰し餡が上品な味わいだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "口が力なくダラリと開くとまだモナカの潰し餡のくっ付いている荒れた舌がダラリと見えた。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（――鴾の細君京千代のお京さんの茶の間話に聞いたのだが――）　つぶし餡の牡丹餅さ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ここに、信也氏のために、きつけの水を汲むべく、屋根の雪の天水桶を志して、環海ビルジングを上りつつある、つぶし餡のお妻が、さてもその後、黄粉か、胡麻か、いろが出来て、日光へ駆落ちした。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯛ならば赤徳鯛、最中ならトラヤのつぶし餡と誤植］、舌の奥にとろりと甘すぎず渋すぎず程のよい味が残ろうという奴じゃ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
