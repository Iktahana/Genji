        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一九二五（大正十四）年　二月、旭川市崎本富三郎三女、崎本ツネコと結婚。",
              "citation": {
                "source": "小熊秀雄全集-1",
                "author": "短歌集",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・ツネコ・サイトウの陪食を仰せつかつてゐるんだから……。",
              "citation": {
                "source": "驟雨（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピッコロミリ・ツネコか。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウバツネコキトクオイデコフ」フジモト　大庭常子のアパアトでは、上を下への騒ぎでした。",
              "citation": {
                "source": "誰でもない……自分でもない",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この草には右のオキナグサのほかになおたくさんな各地の方言があって、シャグマグサ、オチゴバナ、ネコグサ、ダンジョウドノ、ハグマ、キツネコンコン、ジイガヒゲ、ゼガイソウもその内の名である。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、飛騨でモノグルイ、備中でもキツネコンコン、加賀・越中でオニゴロというのもこれであり、筑前その他でゼカイソウといったのは、疑いもなく能の是界坊から出ている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
