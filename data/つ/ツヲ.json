        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ホンジツヲモツテキンユシユツハカイキンサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "クツヤノ　ヂイサンハ　一リデ　セツセト　クツヲ　ツクツテ　ヰテ、フエフキガ　フエヲ　フキハジメルト、「ウルサイカラ　イツテ　オクレ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ　クツヲ　タヽイテルノヲ　ミルト　ヤツパリ　カナヅチデス。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサン新美南吉　ミチコサンガ、コトリヤノ　マヘマデ　クルト、シラナイ　オバサンガ、ウバグルマノ　ナカノ　ニモツヲ　ナホシテ　ヰマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "思想又ハ信仰ノ點ヲ考フルトキ、實ニ價値ナキ又ハ有害ナル者ヲ神ノ如ク裁決シ得ルノ大處ニ立ツヲ要ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヤがそうですから、音のひろがりがなくて、ミヤモトミツヲは窮屈と思うの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、アイサツヲイタシマス。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また益軒の『大和本草』にも紫羅傘［傘は棟の誤り］すなわちイチハツの条下に「民家茅屋の棟ニイチハツヲウヘテ大風ノ防ギトス風イラカヲ不破」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴ノ助手ヲスル時、彼女ハブリュウデエッフェル塔ノ模様ノ附イタポロシャツヲ着テ、膝ノトコロマデノトレアドルパンツヲ穿イテイルノガ、素晴ラシクスッキリト意気ニ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（地味ナスーツヲ着テイルガ、ブラウスガ派手ナノト、フランス製ラシイ模造宝石ノ五聯ノネックレスヲ頸カラ胸ヘ垂ラシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ座敷ヲ汚サヌヨウニ、ボーイニ命ジテ大型ノシーツヲ二枚持ッテ来サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴケンチヨーシヨージキドーカラオモチヤノサツヲウケトレウケトリニンノナハダイコクヤシヨーテン。",
              "citation": {
                "source": "二銭銅貨",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴケンチョーショージキドーカラオモチャノサツヲウケトレウケトリニンノナハダイコクヤショーテン「ゴジャウダン。",
              "citation": {
                "source": "二銭銅貨",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイツヲ、アイツノ子ヲ、アイツノ孫ヲ、オレト同ジ目ニ合ワセテクレ、アイツノ一家ガ栄エテイテハ、オレハ死ニ切レヌ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ中入り（兵家ノ熟語、敵中核ニ深ク入ッテ撃ツヲイウ）ほど危うき戦法はないのじゃぞ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの主力、堀秀政麾下の功を誌した記録によれば――秀政ノ士、堀半右衛門、勝家ガ馬幟ノ御幣ヲ取リ、首二ツヲ獲タリ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツヲは、堅魚木の意。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
