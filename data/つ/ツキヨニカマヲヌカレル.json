        "examples": {
          "standard": [
            {
              "text": "警備が万全だと思って油断していたら、月夜に釜を抜かれるような目に遭ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あんなベテランがこんなミスをするなんて、まさに月夜に釜を抜かれたね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "月夜に釜を抜かれることがないよう、どんな時でも細心の注意を払うべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "月夜に釜を抜かれるも亦名誉と云うべし。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、月夜に釜を抜かれるという「いろはガルタ」が不意に飛び出したのも、つまり、頭上にいただく鍋釜から起った聯想らしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
