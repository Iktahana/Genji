        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "問　被告ハ清三ガ寝テ居ル間ニヒソカニ道子ヲ殺ス事ガ出来ルト思ッタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　オ前ハ二人ヲ殺スノニ何モ物ヲ使オウトハシナカッタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ西洋デハ、大工ノ子ノ生レタ年ヲ、年号ノ初メニスルノカ」「左様でございます」「基督トイウ人ハ、ソンナニ豪イ大工デアッタノカ」「大工さんの子としてお生れになりましたけれども、基督様は救世主でございました、神様の一人子でございました」「神様ノ一人子トハ？",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――イヤ、結局ハ成功ダッタノカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子モ一緒ニ出テ行ッタノカ、ソレトモ流石ニバツガ悪イノデ一人デ二階ニ引ッ込ンデイルノカ、一向姿ヲ現ワサナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ今知ッタノカ、君ミタイナ利口ナ人ガ」「ダケド、ドウ云ウ気持カラソンナコトヲ考エルノ」「自分デ恋ノ冒険ヲ楽シムコトガ出来ナクナッタ腹癒セニ、セメテ他人ニ冒険サセテ、ソレヲ見テ楽シム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽソウカ、ソウダッタノカト、漸ク悟ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテソウ云ウ或ル一日ノ印象ガ、コヽニ蘇ッタノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウ云ウ訳デ怒鳴ル気ニナッタノカ、予自身ニモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモアンマリ生ヤシテ置クト尚更病人ジミルンデネ」「颯子ニ剃ラシタライヽジャナイデスカ」浄吉ノ奴、ドウ云ウ積リデコンナコトヲ云ッタノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「叔母サン、ソレガキャッツアイッテ云ウ石デスカ」座ガ白ケルトデモ思ッタノカ、菊太郎ガ突然云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ニ予ハアンナニマデ怒ッタノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ヲ歩行困難ト思ッタノカ、歩カセテハナラヌト考エタノカ、運搬車ガ来テ待ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、御免ナサイネ、黙ッテ帰ッテ来チマッテ」「誰カト約束デモアッタノカネ」「ソウジャナイノヨ、正直ヲ云ウト、昨日一日オ爺チャンノ相手ヲサセラレタンデ、スッカリ参ッチマッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノ突然ノ事件ハ何ヲ意味スルカ、ソレヲ考エル利天ノ頂辺ニ登ッタノカモ知レナイト思ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは「ホントウノ譫語ダッタノカ、譫語ノゴトク見セカケテ故意ニ僕ニ聞カセタノデアルカ」どちらであるかといえば、その中間ぐらいであったといえよう。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "友田ハ胃カイヨウノ手術ケイカガヨカッタノカ、昔ヨリ血色ガ善クナッテ居ル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
