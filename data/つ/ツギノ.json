        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "デモ　ステナイデ、コシニ　サシ、ツギノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエフキハ　ツギノ　マチヘ　ハイル　ミチデ、ヒロツタ　カナヅチヲ　フリアゲ、クシヤント　フエヲ　クダイテ　シマヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツギノ　ヒ　ヲンナノ　コハ　マタ　イケノ　フチニ　ヤツテ　キマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オ母ッチャハソノツギノ日カラネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀州有田郡のツギツギグサなどは杉菜であり、土佐でツギマツというものも杉菜を意味し、土筆はこれをツギノコといえば杉菜の方が前らしい。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "常陸那珂郡の山村ではツギノコといえば杉菜を意味し、土筆はこれをツギノコノハナと呼んでいる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば淡路の浦村では杉菜でなくツギナ、磐城の相馬ではツギグサ、紀州の有田郡ではツギツギグサ、その他ツギノコ・ツンギノコなどと、呼んでいる村は関東にも多い。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分はツギノコ・ツゲノコから転じたのであろうが、ツベといい始めた動機はまた同一であったように思う。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
