    "definitions": [
      {
        "index": 1,
        "gloss": "dish broiled in a mix of soy sauce, mirin, etc.",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日の夕食は、鶏肉の漬け焼きにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "魚の漬け焼きは、ご飯が進む一品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "香ばしい漬け焼きの匂いが、台所いっぱいに広がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "つけやき刃なら、それがはがれる時になっていたとも見られよう。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そのつけやきばの平気は、すぐに裏切られるやうな運命を持つてゐた。",
              "citation": {
                "source": "世之助の話",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "地には天に向つて立つけやきがある。",
              "citation": {
                "source": "暗い時間に",
                "author": "片山敏彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "土と天候とは沈黙のうちに教えています、俄づくりやつけやきばは役立ちませんよ、と。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
