[
  {
    "uuid": "6b5d8e7f-2ea4-59d6-9a98-606a6f1f4d7c",
    "entry": "積立",
    "reading": {
      "primary": "つみたて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
