        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "剣道の練習で、継ぎ足を使わずに一歩で踏み込む動作を何度も繰り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "能の舞台では、独特の継ぎ足の運びが演者の品格を左右すると言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "空手の突きを出す際に、継ぎ足で間合いを詰める癖を直すよう指摘された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
