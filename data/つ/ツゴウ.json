    },
    "definitions": [
      {
        "index": 1,
        "gloss": "circumstances",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明日の会議ですが、あいにく都合がつきません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ご都合のよろしい時に、一度事務所までお越しください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "家の都合で、しばらくの間実家に帰らなければならなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "扨、現代が芸術にとつて、好都合な時代でないといふことは、漠然と乍ら、既に誰人の胸にも抱懐されてゐる所である。",
              "citation": {
                "source": "詩と現代",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいま友人、大隅忠太郎君から、結納ならびに華燭の典の次第に就き電報を以て至急の依頼を受けましたが、ただちに貴門を訪れ御相談申上げたく、ついては御都合よろしき日時、ならびに貴門に至る道筋の略図などをお示し下さらば幸甚に存じます、と私も異様に緊張して書き送ってやったのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田さんが郷里へお帰りになりましたので、私共も心細く存じておりましたところ、昨年の暮に、大隅さんから直接、私どものほうへお便りがございまして、いろいろ都合もあるから、式は来年の四月まで待ってもらいたいという事で、私共もそれを信じて今まで待っておりましたようなわけでございます。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は五反田駅前の公衆電話で、瀬川さんの御都合を伺った。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時イージーゴーイングな方面で一番好都合なのは、言つてみればその歌の動機を説明しては、トンポエムすることなのである。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、芸術といふものは自体放散的過程を好むものであるからには、実生活人の側は集積的である方が好都合なのである。",
              "citation": {
                "source": "アンドレ・ジイド管見",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "最も好都合なのは、その集積的な活動が一先づ結実し、それが下り坂になつたといふ時なのである。",
              "citation": {
                "source": "アンドレ・ジイド管見",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから朝市の大きな西瓜、こいつはごろごろして台へ載りにくかったのをようやくのせると、神様へ尻を向けているのは不都合じゃと云い出してまた据え直す。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに鴎が飛んでいたと書けば都合よけれども飛魚一つ飛ばねば致し方もなし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには都会の「人間の砂漠」の中がいちばん都合がいい。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の都合のよい日時を知らせてくれ。",
              "citation": {
                "source": "同じ星",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が山王山を知つてから、いづれも生活の敗残者であらう、この森の中で、首縊りが二人ばかりあつた、人目を避けるに、都合がいゝとは言ひながら、不思議なことに、死ぬ人は原始的に安息な自然を選ぶ、川や海に身を投げる人と森の中で縊る人と。",
              "citation": {
                "source": "亡びゆく森",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、裁判はこちらの都合で、五年でも十年でも引っ張れる。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "都合の良い事には、三等車は、やけに混雑していた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈凌ぎに飲食することは、前祝いのようで都合が悪かった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、都合によると、こりゃ危いかも知れねえぞ）　だが、彼はそこでへまを踏むわけには行かなかった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とか都合しといてからでないといけない。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "設計者が日本に地震という現象のあることをつい忘れていたか、それとも設計を註文した資本家が経済上の都合で、強い地震の来るまでは安全という設計で満足したのかもしれない。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合は第二句の方が短いからなおさら都合がよいのである。",
              "citation": {
                "source": "短歌の詩形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "數年前に此地に大火があつたさうであるが、成程火災の傳播には可也都合よく出來てゐる。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "故人北原多作氏のごとき少数な篤学の官吏の終生の努力と熱心によってようやく水産に聯関した海洋調査がやや系統的に行われるようになりはしたが、自分の知る限りでは時々の政府の科学的理解のない官僚の気まぐれなその日その日の御都合による朝令暮改の嵐にこの調査の系統が吹き乱される憂いが多分にあった。",
              "citation": {
                "source": "新春偶語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また片方の尖っている方が親鳥の腹の下へ沢山詰め込むのに都合がよいからだという説もある。",
              "citation": {
                "source": "卵の形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "受信器のアンテナに電波が来れば急速な交番電流が起る、これを白熱灯デテクターおよび電流計あるいは電話の受話器に接続すれば、ごく微弱な電波でも感じるから遠距離の通信には都合のよいものである。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に少々この電灯の不都合な点を述べてみれば、こういう長い硝子管の一箇所でもちょっと罅裂が入れば全体が駄目になる。",
              "citation": {
                "source": "ムーア灯",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで何か炭素に代る都合のよい物質はないかと調べた結果、色々の発明が出来た。",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お医者でも原則通りですべて病人が都合よく処理出来るなら、どのお医者でもみな病理学研究室に閉じこもって居れば世話はありません。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして女人の身、いっそう都合が悪いのです。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は地方の零落した旧家の三男で、学途には就いたものの、学費の半以上は自分で都合しなければならなかった。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "都合のいいこともあれば都合の悪いこともある。",
              "citation": {
                "source": "巴里のむす子へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は、きっと死ぬる際まで、粋紳士風の趣味を捨てず、そんなはいからのこと言って、私をかつごうとしていたのでしょう。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "arranging",
