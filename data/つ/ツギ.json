  {
    "uuid": "1c08c143-e718-50b0-9db4-93e24e0b44bd",
    "entry": "継ぎ",
    "reading": {
      "primary": "つぎ",
      "alternatives": [
        "ツギ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "patch",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お気に入りのジーンズに大きな穴が開いたので、デニム地で継ぎを当てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い着物を解いて、色鮮やかな布で継ぎを入れ、現代的なバッグに作り変えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母は手慣れた手つきで、息子のズボンの膝に丁寧に継ぎをしてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "明治以後、彼の最初の発見者たる正岡子規、及びその門下生たる根岸派の俳人に継ぎ、殆んどすべての文壇者らが、こぞって皆蕪村の研究に関心した。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれに紅白、あるいは紺と白と継ぎ分けた紙の尾を幾条もつけて、西北の季節風に飛揚させる。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人の多様な過去の生活を現わすかのような継ぎはぎの襤褸は枯木のような臂を包みかねている。",
              "citation": {
                "source": "凩",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "焚火の烟は、油紙の屋根の継ぎ目から洩れて、白い柱が立っては崩れ、風に折れて地を這いながら、谷中を転げてゆく。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "石小舎の前には、樺や偃松が、少しは生えて、生々しい緑が捨てられている、谷底一杯は石の破片で埋まっていると言って、いいくらいで、白壁のような残雪が、崖の腹からくずれかかってその破れ石の上を、継ぎ剥ぎに縫っている。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本で富士山よりも高い火山を、欠損空線を継ぎ合せ、盛り上げることによって、創造してゆく快味は、八ヶ岳高原にたたずんで、始めて得られるのである。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うだって引継ぎの時にゃ、間誤つくだろうよ。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――即ち彼等の妻や娘らによって、よく洗濯されてあり、よく継ぎはぎされてあります。",
              "citation": {
                "source": "雪の日",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十くらいもあろうかと思う六角の蜂窩の一つの管に継ぎ足しをしている最中であった。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一廻り壁が継ぎ足されたと思うと、蜂はさらにしっかりとからだの構えをなおして、そろそろと自分の頭を今造った穴の中へ挿し入れて行った。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃やっと二つの欠けらがどうやらうまく継ぎ合わされたようである。",
              "citation": {
                "source": "スパーク",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "切れた捲綱を継ぎ合して七カ月も厚かましく使っていた。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、いつ、ぷすりと継ぎ目がぬけるか分らないのだ。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　タネリが指をくわいてはだしで小屋を出たときタネリのおっかさんは前の草はらで乾かした鮭の皮を継ぎ合せて上着をこさえていたのです。",
              "citation": {
                "source": "サガレンと八月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリレー、トリツェリ、ヴィヴィアニ、オットー・フォン・ゲーリケ、フック、ボイルなどといったような人がはなはだ粗末な今から見れば子供のおもちゃのような道具を使って、それで生きた天然と格闘して、しかして驚くべき重大な画期的実験を矢継ぎばやに行なったのがそもそもの始まりである。",
              "citation": {
                "source": "量的と質的と統計的と",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "継ぎ歯、金冠、ブリッジなどといったような数々の工事にはずいぶんめんどうな手数がかかった。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「われ聖徒となりて父の業を継ぎ、神学を学ぶ中に、聖書の内容に疑を抱き、医薬化学の研究に転向してより、宇宙万有は物質の集団浮動に過ぎず。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には上半身裸体で屑屋みたいな継ぎハギの襤褸股引を突込んだ向う鉢巻で「サア来い」と躍り出るので、審判に雇われた大学生が腹を抱えて高い腰掛から降りて来るようなこと。",
              "citation": {
                "source": "ビール会社征伐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに比べて見ると、そこらに立っている婦人の衣服の人工的色彩は、なんとなくこせこせした不調和な継ぎ合わせもののように見えた。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ困るのは、すでに在る案内記の内容をそのままにいいかげんに継ぎ合わせてこしらえたような案内記の多い事である。",
              "citation": {
                "source": "案内者",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをみがいて継ぎ直したらいくらかよくなったが、またすぐにいけなくなる。",
              "citation": {
                "source": "断水の日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしも、レコードと現場の放送との継ぎ目を自由に、ちょうどフィルムをつなぐようにつなぐことができれば、すでに故人となった名優と現に生きている名優とせりふのやり取りをさせることもできるであろう。",
              "citation": {
                "source": "ラジオ・モンタージュ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "地質学者の一隊が中継ぎのステーションへ向かって突進する、その荷物を橇で引いて行く犬群の頼もしく勇ましい姿は何かしらわれわれの心の奥底に触れる美しさをもっている。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、そんなことを言っても誰一人判って呉れるものはないのだから彼はただ、ときどき顔を背けて苦笑するだけで、縁あれば道伴れとなり縁なければ別れて一人となる機会の操るままに任せ、自分だけは切れそうになる思惟の糸を継ぎ継ぎ一向きにかの神秘の把握に探り入った。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖徳太子さまの大乗仏教的聖旨は、日本の国民性とともに万代不易に継ぎ伝わり、渇仰は永遠に尽きせぬものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理場は口を引結んで弾丸を矢継ぎ早やに詰め代える塹壕の光景になった。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十七　夫人はわずかに語るうちも、あまたたび息を継ぎ、「小児と申しても継しい中で、それでも姉弟とも、真の児とも、賢之助は可愛くッてなりません。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "舌を濡して言を継ぎ、「串戯はさて置き、まだまだ気味の悪いのは。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと、そのＭ・Ｔという人は、用心深く、妹からお友達の名前をたくさん聞いて置いて、つぎつぎとその数ある名前を用いて手紙を寄こしていたのでございましょう。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのつぎには顔である。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
