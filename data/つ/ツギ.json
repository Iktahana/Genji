        "examples": {
          "standard": [
            {
              "text": "話の継ぎが不自然にならないよう、慎重に次のトピックへと話題を移した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "列車の継ぎが悪く、駅のホームで一時間以上も待たされる羽目になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "二つの物語の継ぎとなるエピソードを加えることで、全体の整合性を高めた。",
