[
  {
    "uuid": "63e600cd-7c41-5c59-a8b5-8f592846fda1",
    "entry": "次",
    "reading": {
      "primary": "つぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
