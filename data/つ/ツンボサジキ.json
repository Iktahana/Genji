          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "劇場のつんぼ桟敷席からは、舞台がよく見えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "音響の悪い会場で、つんぼ桟敷に座ると何も聞こえない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「昔は映画館にも、つんぼ桟敷があったらしいよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
