    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……式亭三馬｜嘲る処の、聾桟敷のとんちきを顕わすと、「路之助はんが、出やはるやろ。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いなしか、顔のこしらえまで、――傍にならんだのとそっくりなのに、聾桟敷一驚を吃する処に、一度姿を消した舞妓が一人、小走りに駆け戻るのと、花道の、七三とかいうあたりで、ひったり出会う。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　酒と、女か、目にも口にも借りのある、聾桟敷のとんちきも、むらむらとして、我ながら姿見に色が動いた。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方の劇場といえばどこもそうだが、ここでもシャンデリヤの上の辺には靄がたなびいて、聾桟敷ががやがやと沸き立っていた。",
              "citation": {
                "source": "犬を連れた奥さん",
                "author": "DAMA S SOBACHKOI",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
