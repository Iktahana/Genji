    "definitions": [
      {
        "index": 1,
        "gloss": "fishing stand",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ヘラブナ釣りの愛好家たちは、水辺に自前の釣り台を設置し、一日中じっとウキを見つめている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "斜面が急な河原でも、足の長さを調節できる釣り台があれば安定した姿勢で釣りが楽しめる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "重い釣り台を抱えて山道を下るのは一苦労だが、最高の釣り座を確保するためには欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "牛込へ帰って来ると、今朝しとしと降る雨のなかを、縁先から釣り台に載せられて、解剖室の方へ運ばれて行った先生の死骸が、また旧のとおり綺麗に縫いあわされて、戻って来てから、大分経った後であった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の内外には荷車釣り台など見えて、脇玄関にランプの火光さし、人の声す。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この方から逆寄せして、別宅のその産屋へ、守刀を真先に露払いで乗込めさ、と古袴の股立ちを取って、突立上りますのに勢づいて、お産婦を褥のまま、四隅と両方、六人の手で密と舁いて、釣台へ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "真中へ、お産婦の釣台を。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも祟りに負けるなと、言うて、一生懸命、仰向かしった枕をこぼれて、さまで瘠せも見えぬ白い頬へかかる髪の先を、しっかり白歯で噛ましったが、お馴染じゃ、私が藪の下で待つけて、御新造様しっかりなさりまし、と釣台に縋ったれば、アイと、細い声で云うて莞爾と笑わしった。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その入院した時、既に釣台で舁がれて来た、患者の、危篤である事はいうまでもない。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（いらしった時から釣台でしたから、）　それさえその時まで私は気がつかないで居たくらいで。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓からは、毎日のやうに釣台で運ばれて来る病人が見えた。",
              "citation": {
                "source": "秋は淋しい",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお葉は、水色の幕を垂れた釣台にのって、朝夕にニコライの鐘が枕にひゞく病室に入れられた。",
              "citation": {
                "source": "青白き夢",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからこの釣台はまた煉瓦塀をまわって、この病室に入れられた。",
              "citation": {
                "source": "青白き夢",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "臨川寺の僧が厳子陵の図を浦島が子となしたのは、木曾の寝覚の床に浦島が子の釣台があると云ふ伝説に拠つて言つたのであらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他は幸いに差したることでもないので、それ／″＼に手当をして送り帰しましたが、三河屋と伊丹屋からは釣台をよこして子供を引取ってゆくという始末。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "病人は避病院へ送られるらしく、黄いろい紙の旗を立てた釣台も来ておりました。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は三階の窓から、田舎へ帰る釣台を見下した。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣台は暗くて見えなかったが、用意の提灯の灯はやがて動き出した。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京へ戻ってもすぐ自分の家の門は潜らずに釣台に乗ったまま、また当時の病院に落ちつく運命になろうとはなおさら思いがけなかった。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "思うほどの会釈もならないうちに余は早く釣台の上に横えられていた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄昏の雨を防ぐために釣台には桐油を掛けた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳には桐油を撲つ雨の音と、釣台に付添うて来るらしい人の声が微かながらとぎれとぎれに聞えた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣台に野菊も見えぬ桐油｜哉　これはその時の光景を後から十七字にちぢめたものである。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はこの釣台に乗ったまま病院の二階へ舁き上げられて、三カ月｜前に親しんだ白いベッドの上に、安らかに瘠せた手足を延べた。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "折よく連の人が来たので、自分の容態を話し、とても人力には乗れぬから釣台を周旋してくれまいかと頼んだ。",
              "citation": {
                "source": "病",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "二時間ばかり待ってようよう釣台が来てそれに載せられて検疫所を出た。",
              "citation": {
                "source": "病",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣台には油単が掛って居て何も見えぬけれども人の騒ぐ音で町へ這入った事は分る。",
              "citation": {
                "source": "病",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "上陸した嬉しさと歩行く事も出来ぬ悲しさとで今まで煩悶して居た頭脳は、祭礼の中を釣台で通るというコントラストに逢うてまた一層煩悶の度を高めた。",
              "citation": {
                "source": "病",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤十字病院へ入れるにしても、暖かい日の真昼、釣台でといわれたのを、母は家へ連れて帰りたいと願った。",
              "citation": {
                "source": "渡りきらぬ橋",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜にかけて釣台にのせて連れて来て、組合中の都合で今日葬式をすると云うのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日は釣台が幾台も市五郎の宅まで運ばれ、羽織袴で親類や総代が、市の立ったほどにお礼を述べに来ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣台で運んで来たその女房の無惨な亡骸を見た時もゲラゲラと笑いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「泣くことはないじゃないか、取って食おうともなんとも言やしないよ、お前と一緒に遊んであげたいから来たんじゃないの」　しかも、乗込んで来たその主の乗物というのは、一肩の釣台でした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
