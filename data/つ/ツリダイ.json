        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "時代劇の中で、重罪人を籠や釣り台に乗せて牢屋まで運ぶシーンは非常に物々しい雰囲気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "江戸時代の物流において、馬の背に積めないような大きな荷物は釣り台を使って人夫たちが運んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "博物館に展示されている古い釣り台を見ると、当時の人々の力強さや知恵を垣間見ることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
