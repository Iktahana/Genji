          "literary": [
            {
              "text": "倫敦屋てふ店でツータルタイを発見、三本買った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "阪急デパートで、又々ツータル・タイの新着品と、上等のタイを買ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人になって元町のサノヘイでネクタイ、ツータルの黒がゝったグリーンの、藤山に一つお揃ひのを買ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーサカヤって店にツータルのいゝネクタイがあるので、二本買ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
