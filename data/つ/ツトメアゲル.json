    "definitions": [
      {
        "index": 1,
        "gloss": "to serve out one's apprenticeship",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は長年勤めた会社を、ようやく勤め上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "見習いの期間を勤め上げ、一人前の職人になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "厳しい修行の期間を勤め上げた彼の顔には達成感が漲っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は二度目の、窃盗、文書偽造の刑期を勤め上げる間に、刑務所の中での退屈な時間をこの玩具の考案に費したのであつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、新しく神人になつた者の神名は、いざい神で、其を或期間勤め上げると、たむつ神の時期に入る。",
              "citation": {
                "source": "琉球の宗教",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "柔順につとめあげるためには、やけならやけなりに、もっとほがらかでなくてはいけない。",
              "citation": {
                "source": "放浪作家の冒険",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "要吉が徴兵検査まで勤めあげるという約束で、要吉の父は、水菓子屋の主人から何百円かのお金をかりたのです。",
              "citation": {
                "source": "水菓子屋の要吉",
                "author": "木内高音",
                "note": "青空文庫"
              }
            },
            {
              "text": "去定ならそう云うであろう、年月は知らないが、遊女などで年期を勤めあげるうちには、人の想像も及ばないようなことを経験するだろう。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "鶯ばか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
