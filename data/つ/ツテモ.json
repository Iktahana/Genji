        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ都所ノ別当ニダケハ、ナツテモヨイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と要らざる出しやばり口をきいたやうな次第でございましたけれども、将軍家はちよつとお考へになつて、それから一言、ドコヘ行ツテモ、同ジコトカモ知レマセン。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビヨウキノ　サルヲ　キツテモ　シカタナイト　イフノデ、五人ノ　サムライハ、ソノ　サルヲ　ツレテ　ユキマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キエテ　イツタ　ホシハ、イツマデ　タツテモ　カヘツテ　キマセンデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ、ソノ　ムラハ　アサニ　ナツテモ　ダレモ　オモテニ　デテ　クル　モノハ　ナク、マドサヘ　アケナイノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エエ　アリガタウ、デモ　オイタボウデ、トツテモ　オモイノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア、チヒサイネ」「コドモデスカラネ」「コレデハ、オトナニ　ナツテモ　アマリ　オホキク　ナリマスマイ」「イヤイヤ　オトナニ　ナツタラ、コヤクラヰノ　オホキサニ　ナル」「ダマサウタツテ　ダメダヨ」「ホントウデスヨ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ウサギノ　ハウハ　イクラ　ダイジニ　シテ　ヤツテモ、チツトモ　オホキク　ナリマセン。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ　シカツテモ　ダメデ　アリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ、ホカノ　ヒトニハ　トウトイ　モノデ　アツテモ、ジブンニハ　チツトモ　トウトクナイ　コトモ　アルノダ、ト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ソコデ、カヘルサンハコホロギサンノ足ニ綱ヲツケテ、木ニノボツテモラヒマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ヲトジテヰルジヤガイモサンハ、石ニツマヅイテ、何度モコロンデ、コブダラケニナツテモ　マダマダ、目ガサメナイデ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリヨクニアフノデ、オ母サンハ山羊ノ写真ヤサンヲヨンデ、キネンノ写真ヲトツテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ　オホキク　フンバツテモ、チイサナ　カゲハ　オホキク　ナリマセンデシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲガドンナニ　オホキクナツテモ　キミハ　ヤツパリ　コイヌ　ナンダヨ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　イツモハ　シロヤ　ブチガ　チヨツト　アガツテモ　タイヘンニ　シカラレル　ソノタタミカラ、クモノヤウナ　ホコリガ、イツパイニ　マヒアガツテヰマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカライクラ、オモシロクツテモ、アンマリナガク水ノ中ニハイツテヰルト、カラダニドクデスカラネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎畫伯ガ有ツテモヨカラン」關「デハ、私モ以後、別號ヲ“雲虎”トデモシマスカナ」僕「連想ガワルイ、虎關ハドウデス」關「足下ハ、ナカナカ口ガ惡イ、栖鳳サンノ若イ頃ニ似テイル、髮ノ生エ方マデ似テイル」　筆談には、まゝ栖鳳氏の名が出る。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
