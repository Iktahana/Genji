    "definitions": [
      {
        "index": 1,
        "gloss": "preparing (food) in advance",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
