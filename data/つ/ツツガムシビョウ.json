        "examples": {
          "standard": [
            {
              "text": "山林での作業後に高熱が続いたため、医師はツツガムシ病を疑って検査を指示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ツツガムシ病は野山に入る際に長袖・長ズボンを着用することで予防できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "秋に農作業をした後に発症したツツガムシ病は、適切な抗生物質投与で回復した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "発疹チフスにもっと近いものはある意味で「またいとこ」にあたるもので日本洪水熱またはツツガムシ病と呼ばれるものである。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばツツガムシ病の局所には壊死があり、真性発疹チフスにはリンパ節の腫脹があり、ボタン熱ではしばしば隆起した小円状の小丘が見られる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じような状態はツツガムシ病についても成り立つ。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
