        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "上を見ると、鉛筆で、『代印デトッテオキマシタ、ビル管理人』と書いてあった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "断ッテオクガ彼ハ所謂 Hermaphrodite デハナイ、立派ニ男性ノ器具ヲ備エテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ五時ダネ、オ婆チャン、コレカラ銀座ヘ出テ晩飯ヲ喰ッテ帰ロウジャナイカ」「銀座ノドコヘ」「浜作ヘ行コウヨ、コノ間カラ鱧ガ喰イタクッテ仕様ガナインダ」颯子ヲ呼ンデ浜作ニ電話サセ、カウンターノ席ヲ三四人分取ッテオイテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ所ニ埋メラレタクナインダ」「ソレハ分ッテマスケレド、京都ニナサルニシタッテ、来月ノ大文字マデニハ決メルッテオッシャッテタデショウ」「マダ一カ月アルンダカライヽサ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスレバ長イ間老人ニ取ッ掴マッテオ相手ヲシナイデモ済ムト、考エタノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後五時牽引ノ時、「伯父サン、毎度ドウモ有難ウ存ジマス、オ蔭デ毎日助カッテオリマス」ト、春久ガ挨拶シテ通リ過ギテ行クノガ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト颯チャンノ石ダッテ餘程ノモノデショウネ」「ソンナモノヲ誰ガイツノ間ニ買ッテオヤリニナッタンデショウ」ト、コヽデ又婆サンガ一言シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又ソンナモノニ寝ルノカイ」「何デモイヽカラオ爺チャンハ黙ッテオ休ミナサイ」「籐椅子ナンゾジャ風邪ヲ引クヨ」「風邪ヲ引カナイヨウニ毛布ヲ沢山持ッテ来サセルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヽ、直キナオルヨ、………早ク二階ヘ行ッテオ寝、………」予ハソウ云ッタ積リダッタガ、「早ク二階ヘ」アタリカラハ妙ナ濁声ニナッテ何ヲ云ッテルノカ自分デモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウナサイマスカ、博士モ決シテ無理ニスヽメテハオラレマセン、オ気ガ向カナケレバオ止メニナッタ方ガヨロシイト云ッテオラレマスカラ、マアヨクオ考エニナリマシテ、―――」コノ間ノ晩、子供ニ不意討チヲ喰ッテ泣カサレタコトガ未ダニ胸ニ残ッテイ、コンナ場合ニ何トナクアレガ不吉ノ前兆ノヨウニ思イ出サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「隣ニ佐々木サンガ寝テヽクレヽバ何カアッタッテ安心ジャナイカ、ネエ、颯チャンハコッチデ寝テオクレヨ」「煙草ガ吸エナイノガ困ルワ」「吸ッタライヽサ、イクラデモ吸ッテオクレ」「ソンナコトヲシタラ佐々木サンニ叱ラレチャウワ」「オ咳ガヒドクッテイラッシャイマスカラネ」ト、佐々木ガアトヲ引キ受ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ伏見区竹田内畑町ニアル安楽寿院五輪塔、水輪ガ下ノ方デ細マッテ壺形ニナッテオリ、火輪ノ軒ノ反リガ厚ク、ヤダルミノ工合ガ風輪空輪ノ形ト共ニ鎌倉中期カラ後期ニ移ル頃ノ代表的ナ遺品デアルト、川勝政太郎氏ガ述ベテイルアノ作品、アレナドハドウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆ヤハ通イナノデ夕方水ダケ張ッテオイテ帰リ、瓦斯ニ火ヲ付ケルノハワレワレノウチノ誰カナノダガ、今夜ハ時分ヲ見計ラッテ郁子ガ付ケタ）ヘ行ッテ倒レタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥サンハ先生ニ対シテイマダニ貞節ヲ保ッテオイデデスト、アノ人ガ云ウノヨ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナニ、ソウイッテオケ、ウミノソコノ、マモノガ、イヨイヨ、ニッポンニ、ジョウリクシタト、ソウイッテオケ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "平川祐弘『マッテオ・リッチ伝』（平凡社、昭四四、全三冊）参照。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "平川祐弘『マッテオ・リッチ伝』に詳しいパラレルがなされている（１．二二七―二六四頁）。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
