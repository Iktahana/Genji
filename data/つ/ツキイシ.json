          "literary": [
            {
              "text": "築石や、棚畑や、ふかき昼を日の照り、時うつる、この片岨。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "築石や、棚畑や、ふかき晝を日の照り、時うつる、この片岨。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "君とわたしもそのとほり、夫婦の頑固な築石とならずにいつまでも恋する仲で居ませうよ。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "察するに女山の神籠石の如く、穴と穴とを築石にて必ず連続せしものなるべく候。",
              "citation": {
                "source": "周防石城山神籠石探検記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "畏れ多いご比較ではあるが、吉野の御陵には、雑草が離々と茂いて、ここの何分の一の御築石もない――穢れもくそもあるものか、俺は、斬る」「そう云うなら勝手にしたまえ」「見ておれ」　彼が、大刀を抜こうとすると、「武市さん、およしなさいよ」　笛のお菊ちゃんが、後ろに来ていた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
