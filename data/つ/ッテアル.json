          "literary": [
            {
              "text": "君ニ逢ウタラ鰹節一本贈ルナドトイウテ居タガ、モーソンナ者ハ食ウテシマッテアルマイ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナ黒人ノ俳優バカリ使ッテアルノ」「ソレガソンナニイヽノカネ」「ブレノ・メロッテノハサッカーノ選手上リデ、素人ナンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若夫婦ノ居間ハ可ナリ豪華ニ飾ッテアルラシイガ、階段ノ中途ガ螺旋ニナッテイルノデ、足モトノ悪イ予ハタマニシカ上ッタコトガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「経助ノコトナンゾ考エテヤルヨウナマヽジャナインダカラネ、学校ノ宿題ダッテアルバイトノ学生ニ任セッキリナンダカラ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "草履ハ銀ノ綴デ三段ノ高サノモノ、鼻緒ノ裏ダケニピンクガ使ッテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ノコトハ何モ云ウナト云ッテアルノデ、颯子ハ知ラナイ筈ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ今日一般ニ行ワレテイル長方形ノノッペラボウノ石ノ表面ニ戒名又ハ俗名ヲ記シ、ソノ下ニ台石ヲ据エテ、ソノ前ニ線香立テノ穴ト手向ケノ水ヲ供エル穴トヲ穿ッテアルアノ形式、アレハイカニモ平凡デ、俗ッポクッテ、何事ニモ旋毛曲リノ予ニハ気ニ入ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人服ノアクセサリーヲ売ル店デ、レースヤナイロン製ノ手袋、各種ノイヤリング、ペンダント等々ガウィンドウニ飾ッテアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
