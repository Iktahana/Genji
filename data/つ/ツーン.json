        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "家へいらっしゃる時なんか、つーんとしていていやだったけれど、二人ぎりでお交際すると、とてもいいわ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "螢の提灯螢の提灯光つてるぴかん　ぴかん光つてる早くみんなで追つかけよう螢の提灯考へたぴかん　ぴかん考へた早く提灯とつちまい螢の提灯｜消えちやつたつーん　つーん消えちやつた早く蝋燭見せてやれ。",
              "citation": {
                "source": "十五夜お月さん",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえ、ごつーんと、はげしく仲間同士の鉢あわせ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あの甘ずっぱい林檎の匂いまでが、つーんと彼の鼻をつきさしたように思ったのである。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とクイーンは、頭をつーんとそらして、そのあとアリスの方をむいてさらにひとこと、「そこな子ども、名は何と言う？",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水のかおりが、つーんと、鼻に抜ける。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "抱き起してみた途端に、ぐッたりとしたお粂の襟元から、つーん……と異様なにおいが鼻をついて来ましたので、「あっ、魔薬」　と、九兵衛はあわてて、自分の顔半分を袖口で掩いかくすことを忘れませんでした。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草の匂いがつーんと鼻に来た。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "つーんと、あたまのしんが、冷たいうつろになったとき、もう涙もなく、平易な行為のように指は帯のあいだをまさぐっていた。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてやはり頭につうんと來る感銘が深かつた。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいフイルムを見たときにつうんとくる涙つぽい種類の快よさであつた。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は一つうんとおもしろいことをやりましょう。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお孝は、がっかり、も一つうんざりしたらしい。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつうんと丸太を投げた樣な響が土手の下から近く聞えた。",
              "citation": {
                "source": "おふさ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "甜めて見ると唇につうんと辛味を感じた。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はなんだか鼻の奥がつうんと痛くなるような気持で、しばらくじぶんの用件をもち出すのも忘れていたほどだ。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は飛びあがって、そいつの横面を一つうんと殴りとばして、そとへ出た。",
              "citation": {
                "source": "続獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘れていた刃のにおいが、つうんと惣七の嗅覚をついた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなつうんと澄していて、寝る時も、一番きたないぼろぼろの蒲団を貸してくれた。",
              "citation": {
                "source": "淪落",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "霜じめりした朝の薔薇の匂ひが、つうんときんの胸に思ひ出を誘ふ。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "霜じめりした朝の薔薇の匂いが、つうんときんの胸に思い出を誘う。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭のしんが、つうんと痛くなる。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼がくらくらとして、頭のしんが、つうんと痛くなった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "降りていって、一つうんと文句をいってやろうか」　と思っていると、ゴンドラが急にごとんと大きく揺れて、地上から二三メートル上に飛びあがった。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つうんと承知をしてくれよ」　正木正太と名乗る半纏着の男は、ようやくのことで五郎造の薦めを応諾した。",
              "citation": {
                "source": "東京要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら叔母さまがよろこんでね、こんなにいろいろ心つけて貰ってどうして恩をかえそうやら、いまに富雄が儲けたら、一つうんとお礼をすると仰云ったので、そら又儲けたら、が出たと又本当にすこし気持をわるくして申しました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そりゃそうさね、営門さえ背負って出れば、そいだけは呉れてやるつうんだもん、一生に一遍這う位、何のこたなかッぺ」　それにつれて五兵衛は、何か自分にもかかわりのあった滑稽なことを思い出したらしく、ハハハと、一人でひどく笑った。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年はほんたうに何も書きたくなかつたので、あつさりと何も書かなかつたが、今年はそんな氣持はかなぐり棄てて、ひとつうんと書いて見るつもりだ。",
              "citation": {
                "source": "ランプの下で",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "まんいちにも調子がわるく、いじのわるい大波が、どっと伝馬船をもちあげて、ごつうん、と本船の舷側にたたきつけたら、伝馬船は、たちまち、ばらばらにくだけてしまうだろう。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この調子で、夕方までブッ坐るんだから（農夫に）いやね、上の息子の時も、下の息子の戦死の公報が入った時も、チャンと諦らめを附けてビクともしなかったつうんだ。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
