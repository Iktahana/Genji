        "examples": {
          "standard": [
            {
              "text": "冗談のつもりだったが、同僚たちは彼をからかい、吊るし上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "作業員が滑車を使って重い荷物を梁の上へ吊るし上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "猟師が仕留めたイノシシを木の太い枝に吊るし上げて血抜きをおこなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それは聞いている者の心臓を虚空に吊るし上げる程のモノスゴイ純情の叫びであった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
