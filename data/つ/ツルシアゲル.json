    "definitions": [
      {
        "index": 1,
        "gloss": "to hoist",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冗談のつもりだったが、同僚たちは彼をからかい、吊るし上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "作業員が滑車を使って重い荷物を梁の上へ吊るし上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "猟師が仕留めたイノシシを木の太い枝に吊るし上げて血抜きをおこなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それは聞いている者の心臓を虚空に吊るし上げる程のモノスゴイ純情の叫びであった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が暮れて、点灯夫がそれを下し、火を点じて、また吊し上げると、弱い光を放っている数多の仄暗い灯心が、病みほうけたように頭上で揺れ動いて、あたかも海上にあるようであった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "計一　　ぢや、お母さんとピアノの先生とで、お前を雲の上へ吊し上げる夢は？",
              "citation": {
                "source": "歳月",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "三業組合というようなところでは、待合芸者結束してボリ屋の一軒を吊し上げるという壮挙を敢行して土地の自粛をはかることはありうる。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その二　大岡越前守",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、その店がいくらボッたって、結束して店を吊し上げる必要はない。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その二　大岡越前守",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ん坊の胴を持ってつるし上げると、赤ん坊はその下垂した足のうらを内側に向かい合わせるようにする。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "屈んで煙草盆の火をつけないで、火をつけるたびに煙草盆の方を鼻の先までつるし上げるのがこの男の癖と見えます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "つるし上げる者、ソロバンをはじく者、毛布にくるまって眠る者、炊きだしの者、ごったがえしている。",
              "citation": {
                "source": "桐生通信",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "つるし上げる方は交代で存分に眠っているが、つるし上げられる方は眠らせてもらえない。",
              "citation": {
                "source": "桐生通信",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "羊三は、庭の隅の大きな果樹の幹のうへに、父が囮を吊しあげる時分のことが思出された。",
              "citation": {
                "source": "籠の小鳥",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "じつはとなりの曹司で、白女と遊んでおりました」「言わぬなら、もう一度吊しあげるだけのことだ」　僕は震えだした。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らが反動を吊しあげるのも、根は日本の軍部が仕込んだ業だ。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄夫の姿を認めると与里は忽ちホッとして救はれたやうに活気づいたが、力の無さは詮方もなく寝床の上へ首だけを擡げて「昨夜は迷惑をかけて済まなかつたね」とか「今朝もまだ八度あまりの熱があつてフラフラして――」なぞと、痩せくたびれた頬から頤を吊しあげるやうにして無理に笑顔をつくらうとしてゐる。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "じつはそばの局で白女と遊んでおりました」「言わぬならもう一度吊しあげるだけのことだ」　僕は震えだした。",
              "citation": {
                "source": "無月物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
