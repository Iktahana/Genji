        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "観衆は、ミスをした選手を非難の言葉で吊るし上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "部下たちは不正を犯した上司を会議室に呼び出して吊るし上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "クラス全員が一人の生徒を吊るし上げるように責め立て、担任が慌てて制止した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
