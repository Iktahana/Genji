    "definitions": [
      {
        "index": 1,
        "gloss": "perversity",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は相当な旋毛曲がりで、みんなが右と言えば必ず左と言い張る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "せっかくの親切を素直に受け取らないなんて、本当に旋毛曲がりな性格だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旋毛曲がりの彼を説得するには、真正面からぶつかるよりもお世辞を言う方が効果的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "では老師先生」　金博士は、日頃のつむじまがりもどこへやら、まるで人がちがったように師の前には従順となり、庭園へ出た。",
              "citation": {
                "source": "大使館の始末機関",
                "author": "――金博士シリーズ・７――",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、教えてやろうかと思ったが、やっぱり教えないでおくか」　博士は、どこまでも意地悪で、つむじまがりであった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年にたいする祖母の盲目的な偏愛は、祖母と母との衝突のほとんど唯一の原因だつたが、そのたびに少年は母のきびしい躾けを内心怨みながらも、その一ぱう母のためにかなり強い義憤を覚えずにゐられぬ程度には、つむじまがりの早熟な少年であつた。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　すね者というと、変につむじまがりか、さもなければ卑屈な人間が多いけれど、この蒲生泰軒先生のように、とてもほがらかに世の中をすねちゃった人物は、ちょっとほかに類がないであろう。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（注）あちらでは、つむじまがりのことを背骨まがりと申します。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしい頑固なつむじまがりの、高慢で癲癇持ちで人の気嫌なぞを些とも気にかけない、撲ぐられてもひいひい泣いても涙を見せないやうな子であつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしかすると世間の人々の好みに合ふことがつむじまがりのわたくしの好みに合はないのではあるまいか。",
              "citation": {
                "source": "谷崎文学の代表作「細雪」",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この旋毛曲りの性質がなかったら科学の進歩は如何なったであろうか。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコラ学派時代に科学の進歩が長い間全く停滞したのは、全くこの旋毛曲りが出なかったために外ならない。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "レネサンスはすなわち偉大な旋毛曲りの輩出した時代である。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリレーはその執拗な旋毛曲りのために縄目の苦しみを受けなければならなかった。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "エネルギー保存説の開祖ロベルト・マイヤーは、当時の物理の世界から見ればむしろ旋毛曲りの頑固な田舎親爺であったに相違無い。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸にして主人のように吾輩の毛をややともすると逆さに撫でたがる旋毛曲りの奇特家がおったから、かかる狂言も拝見が出来たのであろう。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一草亭が思ひついたやうに、この二人が無事に顔を合はせたところで、あの通り旋毛曲りの人達だけに、二人はまさか小説の話や俳諧の噂もすまい。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、旋毛曲りのゴリキイは顔を顰めてそれを受取つた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滅多に他人の言ふ事を肯かなかつたあの旋毛曲りの漱石氏も滝田氏に懸つては手も脚も出なかつたらしく、書、画、扇面、額、軸物……と相手の言ふが儘に手当り任せに書かせられてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日の事、都路華香氏を訪ねて、例のやうにそろそろ拝み倒しにかゝつたが、旋毛曲りの華香氏を動かすには何でも画家仲間の悪口を言はねばならぬと思つたらしかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――餘つ程｜旋毛曲りだと見える。",
              "citation": {
                "source": "我等の一團と彼",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう旋毛曲りの「アマノジャク」は始終であって、一々記憶していないほど珍らしくなかった。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来椿岳というような旋毛曲りが今なら帝展に等しい博覧会へ出品して賞牌を貰うというは少し滑稽の感があるが、これについて面白い咄がある。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "倅が鶏に目玉を突かれて、放浪性に富んだ旋毛曲りとなつたといふ迷信からかも知れない。",
              "citation": {
                "source": "月あかり",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "加福の師匠は繍の名家としてまた「旋毛曲り」として業界から折り紙をつけられている。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "業界では「賞めない人」として加福の師匠は通っているし、その烈しいまでの潔癖な眼識を「旋毛曲り」としてみていた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頑なさ、その片意地な程の潔癖さを世間の眼は「旋毛曲り」とみていた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとは事かわりますが、世の中には、誉めたいのだが、他人があんまり感心するから嫌だといったふうな旋毛曲りがかなりにあります。",
              "citation": {
                "source": "平塚明子（らいてう）",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍々先生は生れ付きの旋毛曲り、親に見放され、学校は追出され、その後は白浪物の主人公のような心持になってとにかくに強いもの、えばるものが大嫌いであったから、自然と巧ずして若い時分から売春婦には惚れられがちであった。",
              "citation": {
                "source": "妾宅",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "御存じの通り、あつしは雷鳴樣は嫌ひでせう」「――雷鳴は鳴る時だけ樣をつけ――とね、雷鳴を好きだといふ旋毛曲りも少ないが、お前のやうに、四つん這ひになつて逃げ出すのも滅多にないよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "夕立の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九世紀のロシアの大ピアニストにして、旋毛曲りのルービンシュタインは、シューベルトの「白鳥の歌」の一つなる「憩いの地」を聴いてこう言った。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は旋毛曲りのようだが『ツィゴイネルワイゼン』の曲目を避けた。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――直ぐにも引き取って、足を洗わせようと思ったが、君の強情さも旋毛曲りも知り尽して居るし、それに近頃精神的にも余程変って居るようだというから、表面から忠告に向ったんではとても受け付けまいと思ったんだ。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第七夜　歓楽の夢魔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
