  {
    "uuid": "dd67d281-4452-57e2-813a-88fe4b85f5ac",
    "entry": "積み下ろし",
    "reading": {
      "primary": "つみおろし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
