          "literary": [
            {
              "text": "――ぶらぶら歩行き出すと、ツンツンテンレン、ツンツンテンレン。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなあーじ、ツンテン　庄吉は、大きい声で、歌を唄いながら、湯殿へ入ってきた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "くろウ、かアみイの、ツンテン。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつを、お藤、チリチリツンテンシャン！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるはまた廓の夜でなくもあれ、遠くより近づき来て再び遠ざりゆくテンツルツンテン、ツンテンツンテンの響き、或は低く、或は高く、夜の空気を揺るがせて余音の嫋々を伝うるとき寒灯の孤座に人知れず泣く男の女房に去られてと聞いてもその迂ッ気を嗤うよりは、貰い泣きするが情だ。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――「徳若に御万歳と、御代も栄えまします、ツンテントン、愛敬ありける新玉の、………」妙子はそれに乗りながら、立ち上って、身振をし始めたが、「待って待って、中姉ちゃん」と、自分の部屋へ走って行って、手早く洋服を着物に着換えて、舞扇を持って戻って来た。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
