[
  {
    "uuid": "be1262ff-fa19-5b53-86e8-1490ea66224a",
    "entry": "ツツー",
    "reading": {
      "primary": "つつー",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
