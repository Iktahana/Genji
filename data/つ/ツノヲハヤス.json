        "examples": {
          "standard": [
            {
              "text": "「もう、彼女は彼が他の女の子と話しているのを見て角を生やしているわ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あの人は嫉妬深くて、誰に対してもすぐに角を生やすから困ったものだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ちょっとした冗談のつもりだったのに、彼女に角を生やさせてしまった。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「これへかう角を生やすのだ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "家内なぞは這般の消息に通じない悲しさ、良人が一生懸命に算盤玉を弾いて公明正大の商売取引をしているのに角を生やす。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
