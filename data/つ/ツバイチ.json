          "literary": [
            {
              "text": "爾後その椎を作った処を海石榴市というと記す。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "大和にも豊後にも、海石榴市があつた。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿の杖を持つて来て、魂ふりをした為に、海石榴市と称せられたのであらうと思ふ。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊後風土記を見ると、海石榴市の説明はよく訣る。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、山人が椿の桙を持つて来たから、海石榴市である。",
              "citation": {
                "source": "花の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
