    "definitions": [
      {
        "index": 1,
        "gloss": "sunny spell during rainy season",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "梅雨晴れの日に、久しぶりに青空を見ることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "梅雨晴れの一日、公園には多くの家族連れが訪れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "梅雨晴れを狙って、たまっていた洗濯物を一気に片付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "梅雨晴れのから風の強い日であって、番町へんいったいの木立ちの青葉が悩ましく揺れ騒いで白い葉裏をかえしていたのを覚えている。",
              "citation": {
                "source": "Ｂ教授の死",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼い第二の国民に柩を送られる一戦死者の霊――　砲煙のみなぎった野に最後の苦痛をあじわって冷たく横たわった一｜兵卒の姿と、こうした梅雨晴れのあざやかな故郷の日光のもとに悲しく営まれる葬式のさまとがいっしょになって清三の眼の前を通った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度｜梅雨晴れの頃で、ある百姓家の軒続きに、心臓形の青い葉が一面に蔓つてゐる畑を見て、「おや／＼※菜がこんなに植わつてる……」と独語をいふと、そこに居合はした百姓が笑ひ／＼、「坊ちやま、これあ※菜ぢやござりましねえ、坊ちやまの食べさつしやる甘藷でがさ。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後大学の教室に立つて、欧羅巴の近代文学を論ずるやうになつても、梅雨晴れの日光が硝子窓からちらちらするのを見ると、いつもその※菜の葉が幻のやうに想ひ出されると言つてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　晴れると暑い牛の乳房もたらり・やたらにてふちよがとんでくる梅雨晴れ・降りつづける水音が身のまはり・身のまはりは草だらけマイナスだらけ・いちにち風ふく風を聴きをり「製材所とシネマ」　　新生の記　　　　　×　　　ぐうたら手記薊には薊の花が咲く、薊には薊の花を咲かせておけ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度私が行つたのは、梅雨晴れの晴れ切つた日で、海は紺青に輝き、岸では日和山の一部が墓原になつてゐる處に植ゑてある葵が、紅に今を盛りに咲き匂つて、何とも云へず明るく、輝かな、麗はしい印象を受けた。",
              "citation": {
                "source": "山陰の風景",
                "author": "――歌になるところ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまた、梅雨晴れの空の下に起伏してゐる山々の鮮な緑と、眩ゆく日の光を反射してゐる水銀のやうな海面とを背景にして、美しいパノラミックな景色をつくつてゐる。",
              "citation": {
                "source": "軍艦金剛航海記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれの上、梅雨晴れの輝かしい街衢の高みを過ぎ行くものは、脂粉の顔、誇りかな香りを放つ髪、新鮮な麦藁帽子、気軽に光るネクタイピン……この魂にとつて、一日も眺めるのを欠くべからざる物らの世界である。",
              "citation": {
                "source": "俯瞰景",
                "author": "富永太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　梅雨晴れの、蒸し暑い日の午後であつた。",
              "citation": {
                "source": "すべてを得るは難し",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（佐田がボンヤリ二人を見ている）　　　　　３　夕　梅雨晴れの午後の陽がカッと照りつけ、底一面、燃えるような緑の輝き。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　それから五六日、梅雨晴れの爽やかな日は續きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "猿蟹合戰",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは朝であって梅雨晴れの陽ざしが開け放した南向の窓から室中に流れこんでいたが、わたしは自分の身体が薄暗い影の中に立っているような気がした。",
              "citation": {
                "source": "三等郵便局",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早や七年も前になる……梅雨晴の青い空を、流るる雲に乗るように、松並木の梢を縫って、すうすうと尾長鳥が飛んでいる。",
              "citation": {
                "source": "瓜の涙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "早起、梅雨晴、どうやら梅雨もあがつたらしい。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよ／＼梅雨晴らしい。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の家を再度｜訪問れたのは、それからまた二三日経った梅雨晴の夕方であった。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の家を再度訪問れたのは、それからまた二三日経った梅雨晴の夕方であった。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨晴や蜩鳴くと書く日記　七月十二日。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨晴とも梅雨曇とも云ひ得る重い日和で、うす濁りの波の色は黒く見えた。",
              "citation": {
                "source": "梅雨紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "低く浮んだ雲の蔭に強い日光を孕んでをる梅雨晴の平原の風景は睡眠不足の眼に過ぎる程の眩しい光と影とを帶びて兩側の車窓に眺められた。",
              "citation": {
                "source": "水郷めぐり",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――こう云う調子で、啣え楊枝のまま与兵衛を出ると、麦藁帽子に梅雨晴の西日をよけて、夏外套の肩を並べながら、ぶらりとその神下しの婆の所へ出かけたと云います。",
              "citation": {
                "source": "妖婆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹きすさむ梅雨晴の夜風は肌寒いほど冷である。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨晴の静な午後と秋の末の薄く曇った夕方ほど物思うによい時はあるまい……。",
              "citation": {
                "source": "花火",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨晴間打水しある門を入る六月八日　七宝会。",
              "citation": {
                "source": "五百五十句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅雨晴の波こまやかに門司ヶ｜関六月十六日　山陽ホテルに少憩。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真の梅雨晴でないこともまたこの語がよく現している。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "古来いろいろな解釈があるらしいけれども、梅雨に入って吹くのをクロハエ、梅雨半に吹くのをアラハエ、梅雨晴るる頃より吹く南風をシラハエという『物類称呼』の説に従って置く。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
