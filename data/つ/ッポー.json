        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "インケツ、ニゾ、サンタ、シスン、ゴケ、ロッポー、ナキネ、オイチョ、カブ、ニゲなどと読み方も教わり、気の無い張り方をすると、「質屋の外に荷が降り」とカブが出来、金になった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オッペケペー、オッペケペッポーポー。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "紺羅紗の筒ッポーに黒い鳥打帽、黒い前垂れに雪駄という扮装だから、どこかの店員が註文品でも届けに行く恰好にしか見えない。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察では、その目的って奴を、まだ嗅ぎ付けていないんでしょうか」「いないとも……浮浪人狩なんか遣っているところを見ると、この事件の性質なんか全然問題にしないで、見当違いの当てズッポーばっかり遣っているらしいんだね。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "診察治療が当てズッポーだよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "些くとも今までのように当てズッポーの病名を付けて、浅薄な外科や内科の療法を応用したり、そいつが巧く当らなかった時には縛り上げたり、監禁したりなぞ、原始時代をそのままの手当を試みたりするような低級な頭では駄目の皮だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "至急回答ありたし」　と当てズッポーで威かしてやったら、今度は方向を違えた釜山警察署から報告が来た。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お乳母日傘でハトポッポーなんていった奴とは育ちが違うんだからね……。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……彼奴等はいつもコンナ当てズッポー式の見込捜索をやるから困る。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "再度の暗殺決行とか、社会主義的潜行運動のためとか、又は露西亜への逃亡のためとかいったような風説が皆、御念の入った当てズッポーばかりで、天下を聳動した私の脱獄の動機なるものが、実は他愛もないモノであった事を知っている人間は、そう沢山には居ない筈です。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いらっしゃいまし」　と云うイガ栗頭の中小僧の愛嬌顔と、縞の筒ッポーが彼の眼に映った。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々ポーッポーッと明るくなるのです。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玩具のふくろうを間ぬけな目つきをしてポッポーと吹きならして見たり、とんだりはねたりもんどりうたして見たり、盛花の菊の弁をひっぱって見たりして、私はどれからも満足したふっくりした気分をうけとれないいまいましさに、いつものくせにピリッと眉をよせた。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "克子さんにはきれいな腰紐とカッポー着。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「千世子」改題「テッポー虫」を書こうとも思って居る。",
              "citation": {
                "source": "日記",
                "author": "一九一四年（大正三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "信吉の手が小さくて、そのノッポーで感の悪い労働者には、男だと思えなかったんだ。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして次のは、割合あてズッポーに選べばよい。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "議会が文武官僚乃至半官僚的内閣の提起するものに就いて、如何に大胆率直に批判を下し得るかを、支配者と民衆とに知らせることは何よりも議会政治の恢復にとってモーラルサッポートを獲得する所以なのである。",
              "citation": {
                "source": "思想議会たるを知れ",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "その犬小屋には小さくて臆病だが自宅の前でだけはメッポー勇み肌のテリヤの雑種が住んでいたから、思いがけない闖入者に慌てふためいて、お奈良さまの足にかみついたのである。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを芸人帽子（シャッポーダルチスト）と呼ぶなり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は三十分おきの簡単な曲）音楽　やんでチョット静かになってから、寂しい、はるかな山鳩の声が、ポッポー、ポッポーとひびく。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又二三町きて、やはり道が当なく、草原につづいているばかりで、目ざす森も見えませんければ、人家もないのでがっかりとして、もと来た道を帰ろうかと立止って考えますと何処からか山鳩が一羽飛んで来て、ちょうど頭の上の木の梢にとまって、「二郎さん二郎さん早くお出でよ、トテッポーッポー、脇見をせんでお出でなさい。",
              "citation": {
                "source": "迷い路",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "トテッポーッポー」と二郎に力づけて、又｜何処へか去ったのであります。",
              "citation": {
                "source": "迷い路",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
