        "examples": {
          "standard": [
            {
              "text": "彼は付き馬として、毎晩繁華街をうろついていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "付き馬の厳しい取り立てに、借金苦の客は怯えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の遊郭には、付き馬という職業があったと聞く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この人の唯一の弱身は、生れ付き馬が嫌ひで、尤も身分柄乘らずに濟んだせゐもあるでせう、今までは先づ其爲に困つた經驗もなかつたのですが、和田倉門外の御評定所へ行つて大事の品を受取つて來るとなると、馬で行くのが一番ピタリとします。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "名馬罪あり",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
