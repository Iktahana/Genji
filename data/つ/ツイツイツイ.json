          "literary": [
            {
              "text": "足腰が、水馬の刎ねるように、ツイツイツイと刎ねるように坂くだりに行く。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやしのなかにふるきりの、　つぶはだんだん大きくなり、　いまはしずくがポタリ」　霧がツイツイツイツイ降ってきて、あちこちの木からポタリッポタリッと雫の音がきこえてきました。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カン蛙は、けれども一本のたでから、ピチャンと水に飛び込んで、ツイツイツイツイ泳ぎました。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
