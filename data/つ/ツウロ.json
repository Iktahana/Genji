    "definitions": [
      {
        "index": 1,
        "gloss": "passage",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "飛行機の通路側に座りたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "非常時には、通路を塞がないでください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "狭い通路を抜けて、奥の部屋へ進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "通路を距てて直ぐの向ひ側には、鉄道従業員の妻君みたいなのが、胸をはだけて赤坊に乳を飲ませてゐる。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さう云ふなり良子は、走つて台所と物置との間の、狭い通路に這入つてしまつた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母さんが台所に這入ると、小僧は天秤棒を担ぎあげて、「ありがと、存じました」といふや、赤い手を振りながら、さつき良子が隠れた、あの通路の方へ行つた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人垣は急に崩れて、大風に偃す野草の如く、芳の通路を拓けども、何分多人數であるから、幾重にも犇犇と垣あり。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "通路にさえ三十人も立ったり、蟠ったりしていた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の人の耳を小突きながら、隣の人は小突かれると、反対の通路の方へガックリと首を傾けた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほら」　少年は通路に立っている乗客の方を、顎でしゃくって見せた。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、その一定の意味は「言語」によって通路を開く。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "異性間の通路として設けられている特殊な社会の存在は、恋の実現に関して幻滅の悩みを経験させる機会を与えやすい。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘える者と甘えられる者との間には、常に積極的な通路が開けている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこの場合、「いき」の質料因と形相因との関係が、うすものの透かしによる異性への通路開放と、うすものの覆いによる通路封鎖として表現されている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "口は、異性間の通路としての現実性を具備していることと、運動について大なる可能性をもっていることとに基づいて、「いき」の表現たる弛緩と緊張とを極めて明瞭な形で示し得るものである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "この抜き衣紋が「いき」の表現となる理由は、衣紋の平衡を軽く崩し、異性に対して肌への通路をほのかに暗示する点に存している。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "一定の意味として民族的価値をもつ場合には必ず言語の形で通路が開かれていなければならぬ。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの眠たそうなプルウストをひとつうろたえさせてやろうじゃないか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの眠たさうなプルウストをひとつうろたへさせてやらうぢやないか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦は手を振りつつうろたえた。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "も一人の平三は、車力の親方の子で『菅原伝授手習鑑』の寺子屋、武部源造の弟子ならば、こいつうろんと引っとらえと、玄蕃が眼を剥きそうな、ひよわげで、泥亀に似た顔をしている。",
              "citation": {
                "source": "鉄くそぶとり",
                "author": "続旧聞日本橋・その二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして　ネズミたちは、　家から　家へ、　長く　せまい　つうろを　通って、　ちょろちょろ。",
              "citation": {
                "source": "グロスターのふくやさん",
                "author": "THE TAILOR OF GLOUCESTER",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつデッキを通ろうと試みても、そこは外海と何ら異なるところはないからであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "変に跨ぎ心地が悪うございますから、避けて通ろうといたしますと、右の薄光りの影の先を、ころころと何か転げる、たちまち顔が露れたようでございましたっけ、熟く見ると、兎なんで。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "肌守りを懸けて、夜中に土堤を通ろうじゃあないか。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ッ子一人通ろうではなし、助けてもらうわけにはゆかず、といって石は退けられないし、ただもうせめてのことに、お見舞をいうばかり、小銀が悲しい声を絞って。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどたれあってこの老人を気に留める者もなく、老人もまた人が通ろうと犬が過ぎ行こうと一切おかまいなし、悠々行路の人、縁なくんば眼前千里、ただ静かな穏やかな青空がいつもいつも平等におおうているばかりである。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐伯は思い掛けない郷愁をそそられ、毎日この道を通ろうと心に決めた。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへ行くつもりなのかと立止ると、赤井は豹一をひっ張って、「此処を通ろう」とわざわざ三条通の入口からさくら井屋のなかへはいり、狭い店の中で封筒や便箋を買っている修学旅行の女学生の群をおしのけて、京極の方の入口へ通り抜けてしまった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "前を通ろうとして、我にもあらず立淀んだ。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "だのに、わざわざ呼留めて、災難を免れたとまで事を誇大にして、礼なんぞおっしゃって、元来、私は余計なお世話だと思って、御婦人ばかりの御住居だと聞いたにつけても、いよいよ極が悪くって、此処だって、貴女、こそこそ遁げて通ろうとしたんじゃありませんか。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "凄い月で、紫色に透通ろうね。",
              "citation": {
                "source": "霰ふる",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、一散に駈けて来て、黙って小屋の前を通ろうとする。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
