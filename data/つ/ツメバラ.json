        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "度重なる不祥事により、責任者である彼がついに詰め腹を切らされることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロジェクトの失敗は彼の責任とされ、会社から詰め腹を切らされることを余儀なくされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "社長の失脚に伴い、側近の重役たちも次々と詰め腹を切らされる羽目になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
