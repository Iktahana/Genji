[
  {
    "uuid": "1ade1feb-eddd-5694-9d9b-81c0941f8be7",
    "entry": "詰め腹",
    "reading": {
      "primary": "つめばら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "being forced to commit seppuku",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "汚職の責任を取らされ、家老はついに詰め腹を切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "改革案が反対多数で否決されたため、部長は面目を失い詰め腹を切るしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "不正の証拠が露見し、社長は役員会から詰め腹を迫られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "刃傷事件に座して、親族立ち会いの上で詰め腹を切らされた十九歳の少年の祖母になる人が、愁傷の余りに失心しようとした。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は初めに甥を説得して詰め腹を切らせようかとも考えたが、もし不承知で四の五のいうと却って面倒である。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お手討ちも詰め腹も真平御免だとことわった。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠密なぞと軽はずみな事呼ばわり立てなば、あとにて面々詰め腹切らずばなるまいぞ。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはなりません、非人乞食を御屋敷に呼び入れるなどは以ての外で」　こうなると、多勢の家来の方が強く、まごまごしたら伊予守忠弘、詰め腹を切らされるかもわからない情勢だったのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "乞食志願",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川時代も此頃になると、忠義とか家とかの観念はすっかり変って、お家が立ち行かなくなると、随分主君に詰め腹を切らせ兼ねない忠臣があったものです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "暴君の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰め腹を切らされたのだ。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪隠で詰腹を切る体だね、誠にはやなんとも謂われねえ臭気だぞ、豪傑に支えたと見えてここらじとじとする。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "剛勇ではあり、多勢ではあり、案内は熟く知っていたので、忽に淀の城を攻落し、与二は兄を一元寺で詰腹切らせてしまった。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやそれについて話しのある、其十兵衞といふ男の親分がまた滅法えらいもので、若しも些なり破壊れでもしたら同職の恥辱知合の面汚し、汝はそれでも生きて居られうかと、到底再度鉄槌も手斧も握る事の出来ぬほど引叱つて、武士で云はば詰腹同様の目に逢はせうと、ぐる／＼／＼大雨を浴びながら塔の周囲を巡つて居たさうな。",
              "citation": {
                "source": "五重塔",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる詰腹で、社会の制裁が非常に悪辣苛酷なため生きて人に顔が合わされないからむやみに安く命を棄てるのでしょう。",
              "citation": {
                "source": "文芸と道徳",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄碩さんはわたくしの宅で詰腹を切らせます。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもこの一件が親兄弟にも知れたので、表沙汰にならない先に、屋敷内で詰腹を切らされたという噂です。",
              "citation": {
                "source": "半七捕物帳",
                "author": "ズウフラ怪談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先殿様の御葬式がすむと間もなく、源太夫様もつづいてお亡くなりなすったので、世間では追腹などと申しますが、ほんとうは千之丞様の親御たちが寄りあつまって詰腹を切らせたのだとかいうことでござります」「ほう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰腹……」と、澹山は顔をしかめた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、源太夫殿とても御用人格の立派な御身分であるから、いわれ無しに詰腹など切らされる筈もあるまい。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが禁制の殉死であるともいい、または毒害ともいい、詰腹ともいう噂があった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "用人の一人は詰腹を切らされた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは見あたり次第に伜を引っ捕えて、詰腹を切らせる覚悟であったらしい。",
              "citation": {
                "source": "妖婆",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "三左　　孃樣のおつしやる通り、お家のためとは申しながら、甥の殿をむざ／＼御手討の詰腹のとは、憚りながら餘りにむごい御沙汰。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年越しおまへに馴染んで、廓通ひの數かさなれば、勤向きの首尾もよろしからず、親類共も心配して、やれ詰腹の、座敷牢のと、なにか頻りに騷いでゐる。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、中には到底不可能な攘夷の実行を迫つて、幕府を窮地に追ひ詰め、詰腹を切らせようとする倒幕戦術としての攘夷論者もあつた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何でもいい、飲まんのだから飲まんのだ、女なんかに何がわかるものか、黙っていろ」「どうせ女ですわ」と細君がタカジヤスターゼを主人の前へ突き付けて是非｜詰腹を切らせようとする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「元親公の御諚で検使が二人来て、詰腹切らされました」　少年は苦しそうに云って呼吸をついた。",
              "citation": {
                "source": "八人みさきの話",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "比江山親興が、元親の検使に詰腹を切らされた時のことであった。",
              "citation": {
                "source": "八人みさきの話",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そちが詰腹切らせたではないか」「お祖父様にこの絵が……」「ナニ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "斉興は、それを吸いながら「第一、無理に押しつけられる性のことではなかろうがな、将曹」「それが――例の、密貿易の書類、あれで、詰腹を切らそうと、某は、そう観ておりますが――」　斉興は、暫く、喫っていたが、吐月峯へ、雁首を叩きつけながら「奇怪な計をやる」　と、呟いた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まず詰腹でも切らせるだろうよ」「詰腹。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『幸蔵主殿の甘言を以て秀次君をおびき出し、城中で詰腹を切らせましょう』『いやいや我君のお眼に入れては、血縁のある伯父姪でござる。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏見城で詰腹を切らせられるか、ないしは途中で殺されるだろう。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to be forced to bear responsibility and resign from one's position",
        "register": "standard",
