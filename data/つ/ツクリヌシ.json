    },
    "definitions": [
      {
        "index": 1,
        "gloss": "maker",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この古い建物の造り主は、有名な建築家だったと聞いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "宇宙の造り主の存在を信じる人もいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その映画の造り主は、観客に強いメッセージを届けたかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「私はただ一つのクレアトールとして、造り主と、他のクレアトールとに対する徳を得たい、神に仕え、隣人を愛して、ひとりの力なき忠実な僕として生きよう」　そのようなことを考えて、宿へ帰る間私は幸福でした。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは造り主が蒔いたのである。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "造られたるものの造り主に対する務めである。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は造り主の属性が私たちの先天的の素質として顕はれるのではあるまいか。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私たちの魂は悪のみなり」と宣べる時、私たちは他人のもの、造り主のものを罵つてはゐないであらうか。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "造り主の名によつて凡ての被造物と繋りたいのである。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して造られたるものの切なる願ひは、造り主の完さに似るまで己れをよくせんとの祈りである。",
              "citation": {
                "source": "善くならうとする祈り",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ造り主によって作られたる共通の血の音がある。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "天国と地獄とが造り主の一の愛の計画として収められるのである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つくられたるものの造り主に対する務めである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは造り主の属性が私たちの先天的の素質として顕われるのではあるまいか。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私たちの魂は悪のみなり」と宣べるとき私たちは他人のもの、造り主のものを罵ってはいないであろうか。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "造り主の名によってすべての被造物と繋りたいのである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しこうしてつくられたるものの切なる願いは、造り主の完さに似るまでおのれをよくせんとの祈りである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく造り主の知恵であろう。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほむべき造り主はそのなかにかえって深い愛を蔵していられるかもしれない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗教心とはこの恐るべきさだめの内にかえって造り主の愛を見いだす心をいうのであろう。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "造り主に対する造られたるものの義務である。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃ此処に斯うして毎日君の活動を見て居ると、羨ましくもなるし、黙って立って居る俺は実以て済まぬと恥かしくもなるが、此れが性分だ、造り主の仕置だから詮方は無い。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし今、ここにはかような野蛮国や半開人種の神について論ずることをはぶいて、単にいわゆる文明国の人々が長い間信じきたった天地の造り主なる神だけについて考えてみよう。",
              "citation": {
                "source": "我らの哲学",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロッパやアメリカでは昔から今日までたれもかような天地の造り主なる神があるものと信じ、日々の生活もときどきの儀式もみなこの信仰に基づいて定められた。",
              "citation": {
                "source": "我らの哲学",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "造り主が大変者なのだ」「大変者って、何者なので？",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの山小屋の造り主がそんな神がかりになったことが、わびしかったのである。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "万物の造り主である活ける神は、人の工と巧とをもって石から造られる神とは違う。",
              "citation": {
                "source": "『偶像再興』序言",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の造り主である。",
              "citation": {
                "source": "『偶像再興』序言",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ただ万有の造り主なる神のみ心のままに……」と、そんなことを言つて見ようか。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "若き日に汝の造り主をおぼえよ。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらゆるものの造り主、より善き世の大元が彼を神の種より造ったのか、それとも、高い精気から近頃分たれた大地が同種である天の種子をもどしたのであろうか。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "他のものをしてあらしめるのだから、これは「造り主」という意味になる。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
