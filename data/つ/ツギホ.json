        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "話が途切れたところで、彼女は「ところで、あの件だけど…」と上手く接ぎ穂を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会議で沈黙が流れた時、上司が「では、次の議題に移りましょうか」と巧みに接ぎ穂を打った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ああ、そういえば！」と、彼は気まずい沈黙を破るための絶好の接ぎ穂を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
