        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "引き揚げて家へ連れ戻ると、お君は盥を持ちだした。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "豹一を引き揚げて、家に連れ戻ると、お君はたらいを持ち出した。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那さまが叱ったのは知りませんけれど、連れ戻るときわたしが馬車のお供をしていたんですが、お嬢さまは馬車の中で酷く妹を叱っていましたから。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「連れ戻るか、斬るかであろう」　一木は、冷たい微笑をして「君公の命じゃ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし機関大尉が生きていられたら、きっと連れ戻る。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、聟が嫁を捉えたとなると、髪束をひっつかんだり、随分手荒なことをして連れ戻る。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、聟が嫁を捉へたとなると、髪束をひつゝかんだり、随分手荒な事をして連れ戻る。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリゴリイは赤ん坊を抱き上げて家へ連れ戻ると、妻を坐らせて、その乳房へ押しつけるようにして、赤ん坊を彼女の膝へ載せた。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も道理と思って、九十パーセント丈けにお願い致しました」「成程」「必ず迎いに参ります」　と長船君は三日目に又来て連れ戻る。",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ川を越えて、救いにと思ったが、待てと、考え当ったのは、ふたたび川の此方へ連れ戻ることが、鶴菜どのにとって幸か不幸か、それでござった。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは、この樹の上にかくれている女を降ろし、この先の数珠屋の宿まで連れ戻るから、それまで待っておれ」「ばかをいえ、そうはさせねえ」「なんじゃと」「この娘は、おれが以前女房にしていた女の娘。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしらが、無下に連れ戻る筋合いはない。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "連れ戻るにふしぎはない」「渡さぬな」「ご不足なら、主人へじかにおかけあいなされい。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私は、アッシャーをやさしくまた強く窓ぎわから椅子の方へ連れもどるときに、身ぶるいしながら言った。",
              "citation": {
                "source": "アッシャー家の崩壊",
                "author": "THE FALL OF HOUSE OF USHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかこちらへ入らっしゃりそうな御様子にも見えるので、きょう殿にいきなりその養女を見られてはしようがない、まあ暫くは知られないようにして、なりゆきに任せて置いた方が好いと思うものだから、出来るだけ急いで連れもどるようにと皆に言いつけた。",
              "citation": {
                "source": "ほととぎす",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方、ようやく薫さんの癪もおさまり、浜之助が連れもどることになって、皆して水戸さまの前まで送っていった。",
              "citation": {
                "source": "花を持てる女",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "……もしそち達が、強ってわたくしを荊州へ連れもどるというならば、長江へ身を投げて、この悲しみからのがれるばかりです」「なに、入水する？",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
