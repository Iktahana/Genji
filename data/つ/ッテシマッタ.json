        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕ハモーダメニナッテシマッタ、毎日訳モナク号泣シテ居ルヨウナ次第ダ、ソレダカラ新聞雑誌ヘモ少シモ書カヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫ガ病人ニナッテシマッタノダカラ残念デタマラナイノダガ、君ノ手紙ヲ見テ西洋ヘ往タヨウナ気ニナッテ愉快デタマラヌ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、オ気ノ毒ネ、アタシハ行ッテ参リマス、アトデ話シタゲルワ」ソウ云ッテ颯子ハサッサト出テ行ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来ルノカネ彼氏」「エヽ」ソウ云ッテ、颯子ガチラリト顔ヲ出シタガ、直グニバタント強イ音ヲ立テ、締メ切ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノ一分間グライデ、ソレカラアトハ朦朧トナッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、チョット叱ッテ睨ミツケルト、コリーハ忽チ従順ニナリ、颯子ノアトカラ尾ヲ振ッテ犬舎ノ方ヘ行ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ彼方ヘ逃ゲテクカラ、一人デ勝手ニ泣イテラッシャイ」「ネエ颯子、コレカラ時々『颯チャン』ト呼バシテオクレヨ」「馬鹿ラシイ」「颯チャン」「甘ッタレ坊主ノ嘘ツキ坊主、誰ガソノ手ニ載ルモンデスカ」プリ／＼怒ッテ行ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデシマエバ何処ニ埋メラレタッテ構ワナイヨウナモノダケレドモ、今ノ東京ノヨウナ不愉快ナ、自分ニ何ノ因縁モナクナッテシマッタ土地ニ埋メラレルノハイヤダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂場ト離レ屋トヲ廊下デツナゲルノト、ピアノノ床下ニ煉瓦ヲ積ム工事ハアラカタ終ッタガ、電話ノ切リ換エガマダデアルシ、今日ハ赤口デ日ガ悪イカラ二十一日ノ大安マデ待チナサイト昨日郁子ハ云ッテイタガ、敏子ハ構ワズ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ中年以後、妻ノ度ハズレテ旺盛ナ請求ニ応ズル必要ガアッタタメニ、早期ニ精力ヲ消耗シ尽シ、今日デハアノ方面ノ慾望ガハナハダ微弱ニナッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻僕ラガ郁子ヲ自動車カラ抱キオロシタ時ハ玄関ニウロウロシテイタヨウデアッタガ、僕ラト入レ違イニ黙ッテ関田町ヘ帰ッテシマッタラシイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "用ハナイカラサッサト帰レ」「帰ルワ」ト云ウト、茶碗ニ飯ヲ盛リカケテイタノガ、ソノ飯ヲパット飯櫃ヘ投ゲ込ンデ出テ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
