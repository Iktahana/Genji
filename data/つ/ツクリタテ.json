        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "茶屋へ入ったところが作り立ての饅頭がある。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "金色の鼠は鼠類に金色に光るもの数種あり、それを祀ったであろうと、十二年前の『太陽』に書いて置いたが、あるいは鼠王を勿体付くるため祠僧が密かに金色に作り立てたかも知れぬ。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "罪悪を罪悪として摘発することは己れの職務だが、罪悪を罪悪として作り立てて人を陥れることは、江戸っ児にはできねえ、という自負心があった。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "作り立ての貨幣みたいにきれいだった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "九鬼右馬允嘉隆は、信長から水軍の建設をいいつかると、鳥羽、熊野などの船大工や、多年海上で動作に馴れた水夫などを糾合して、やがて七艘の大船を作り立て、これを堺の浦へまわして来た。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は最初の理由も知らず、単にこの木を美しく作り立てる喜ばしさのみを遺伝している。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "作り立ての器より、使い古したものはさらに美しいではありませんか。",
              "citation": {
                "source": "民藝とは何か",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこからこの独創的な表現を捕えてくるのか、真新しい作り立てのものにも、しばしば素敵な傑作を見出すのです。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしかの地で示された我々の最初の行動模範が、これらの人民を徳の賛美と模倣とに導いたならば、そして彼らと我々との間に兄弟のような親愛と理解とを作り立てたならば、それはわが地球全体に対してどんなに大きな向上発展となったことであろう！",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "家人が詰問しますと、　氏は「だって、あれだけの冒険をしてやっと這入ったんだぜ、（盗人は三重の扉を手際よく明けて入りました）あれ位いの仕事じゃ（盗人は作りたての外套に帽子をとりました。",
              "citation": {
                "source": "岡本一平論",
                "author": "――親の前で祈祷",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥ざゑもんはからず十両の金を得て質入れせし田地をもうけもどし、これより屡幸ありてほどなく家もあらたに作りたていぜんにまさりて栄けり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "作りたての器は、まだ人の愛を受けておらぬ。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
