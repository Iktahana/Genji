[
  {
    "uuid": "9fb5072e-f31c-538a-8f36-cca354c91bd3",
    "entry": "辻",
    "reading": {
      "primary": "つじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
