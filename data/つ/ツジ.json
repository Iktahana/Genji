        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "辻でばったりと旧友に会い、懐かしさのあまり立ち話をしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "雨の日の辻は、行き交う傘で色とりどりに彩られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "辻の角にある小さなパン屋から、香ばしい匂いが漂ってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
