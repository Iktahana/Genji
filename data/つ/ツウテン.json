[
  {
    "uuid": "0bbd4c27-ac04-5324-97dd-df3355e06b91",
    "entry": "痛点",
    "reading": {
      "primary": "つうてん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
