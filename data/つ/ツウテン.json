    },
    "definitions": [
      {
        "index": 1,
        "gloss": "pain point",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "看護師さんの腕が良かったのか、注射の針が偶然にも痛点を避けたのか、全く痛みを感じなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "皮膚の表面にある痛点の密度は、指先と背中では大きく異なることが実験でわかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そこが俺の精神的な痛点なんだ」と言って、彼は過去の失敗に触れられるのを極端に嫌がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ところで熊城君、君は、ババンスキイ痛点という言葉を知っているかね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、クリヴォフ夫人のような、初期の脊髄癆患者によく見る徴候で、後踵部に現われる痛点を指して云うのだよ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは古材木だ」　そんな気分が、指が痛点を圧するにつれてだんだん消え、彼は枕をつかんでうなったり、「痛い！",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "揉み、打ち、圧をかけたり、マッサージをするのは明らかに痛点を探す経験的医学からのものである。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
