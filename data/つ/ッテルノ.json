        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「オホキナ　コヱデナニヲ　ネゴトヲイッテルノ」トオカアサンニオコサレテ、ハジメテ　ユメダッタ　トワカリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ年寄ニハ残酷ダワ」ミンナガ周リデガヤ／＼云ッテルノガ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "映畫デハ都電ノ運転手ニナッテルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘエ、君ハイツカラ煙草ヲ吸ウンダ」「近頃トキ／″＼二階デ内證デ吸ッテルノ」手ノ中デライターガ光ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヽ、直キナオルヨ、………早ク二階ヘ行ッテオ寝、………」予ハソウ云ッタ積リダッタガ、「早ク二階ヘ」アタリカラハ妙ナ濁声ニナッテ何ヲ云ッテルノカ自分デモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オ婆チャンハ胃痛カモ知レナイカラ、ツイデニ行ッテ見テ貰オウッテ云ッテルノサ、オ婆チャンノハ神経ダヨ」「ドウセソウニ決マッテマスワ」「君」ト云イカケテ予ハ云イ直ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシオ腹ガ減ッテルノヨオ爺チャン、早ク食堂ヘ行キマショウヨ」五子達ハ済ンデイルト云ウノデ三人デテーブルニ就ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
