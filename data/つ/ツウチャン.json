          "literary": [
            {
              "text": "低く口笛を鳴すとひとしく、「ツウチャン、ツウチャン。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "他なし、お通がこの家の愛娘として、室を隔てながら家を整したりし頃、いまだ近藤に嫁がざりし以前には、謙三郎の用ありて、お通に見えんと欲することあるごとに、今しも渠がなしたるごとく、籠の中なる琵琶を呼びて、しかく口笛を鳴すとともに、琵琶が玲瓏たる声をもて、「ツウチャン、ツウチャン。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾丸の中に行く人の、今にも来ると待ちけるが、五分を過ぎ、十分を経て、なお書斎より来らざるにぞ、謙三郎はいかにせしと、心々に思える折から、寂として広き家の、遥奥の方よりおとずれきて、「ツウチャン、ツウチャン。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び、「ツウチャン。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉を吹く風の音につれて、「ツウチャン、ツウチャン、ツウチャン。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
