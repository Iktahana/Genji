        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自省直ケレバ千万人ト言エドモ、――イヤ、握手ハマダマダ、ソノ楯ノウラノ言葉ヲコソ、「自省直カラザレバ、乞食ト会ッテモ、赤面狼狽、被告、罪人、酒屋ニ飛ビ込ム。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "莫大ナル出兵費ハ誰カラ出ルカ、諸君ガ一本ノ煙草ヲ喫ンデモ、半斤ノ砂糖ヲ使ッテモ、一足ノサル又ヲ買ッテモ、必ズ間接ニ徴収セラレル税金カラ出テイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トッテモ恐ろしい、お茶の中のお茶といってもいい位な、お茶の中のナンバー・ワンなんです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそ足の幽霊かと思うくらいハッキリしていて、トッテモ気味がわるいんですがね」「足の幽霊……」「そうなんです。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度工場外ニ足ヲフミ出シテ見レバ分ル通リ、当工場ハマサニ「Ｙノフォード」タル名ニ恥シクナイ充分ノ待遇ヲ、ソノ時間ノ点カラ云ッテモ、ソノ賃銀ノ上カラ云ッテモ、皆サンニ与エテ居ルノデアリマスカラ、コノ際決シテ、カヽル宣伝ニ附和雷同セザル様、呉々モ申述ベテ置ク次第デアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ッテモ、オ勝ハモウスグオ産ヲスル。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのはとにかく大会社だけれど私のは個人経営だし……丸ビルの中なんて、トッテモひどいワ」　みどりは秋田から逃げて上京して来た。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクン、イマサラタイヘンナコトヲシタトオモッテモ、モウ　マニアヒマセン。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『私ハソビエト社会主義共和国連邦ノタメニ命ゼラレタコトハ何事デアッテモ行ウコトヲ誓イマス。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタト云ッテモ三十ソコ／＼デナオ美シカッタガ、見タトコロ年増女ト云ウ感ジデ、トテモ男性トハ思エナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ図ラズモ予ノ希望ハ叶エラレタガ、首尾ヨク同衾シ、事ヲ行ウニ至ッテモ、普通ノ藝妓ト普通ノ方法デ行ッテイルノト異ルトコロハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ如何ニ技巧ガ巧妙デアッテモ、モト／＼予ノ趣味デハナカッタノデ、タッタ一遍好奇心ヲ満足サセタヾケデ、ソレキリ同性ト関係シタコトハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ何カ不能ニナッタ老人ノ性生活―――不能ニナッテモ或ル種ノ性生活ハアルノダ―――ト関係ガアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十ニナッテモ子ヲ産ンデミセルト云ウ久原房之助ノヨウナ精力ハナク、既ニ全ク無能力者デハアルガ、ダカラト云ッテイロ／＼ノ変形的間接的方法デ性ノ魅力ヲ感ジルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美シサト云ッテモ予ニハ予ノ好ミガアルカラ、顔ヤ体ノ種々ナ点ガソレラニ合致シテイナケレバ駄目ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ニデモ行ッテ貰ウサ」「御自分デ御覧ニナラナクッテモイヽンデスカ」「コノ暑イノニコノ体デハ行ケソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イクラ忘レッポイト云ッテモ、コノコトハヨク覚エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ這入ンナサイヨ」「這入ッテモイヽ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ヤ彼女ハ卯木家ニ於テ確乎タル地歩ヲ占メルニ至リ、浄吉ニ取ッテモ、ソウ云ウ意味デ缺クベカラザル存在トナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ唇ダケデナクッテモイヽ、舌ヲ着ケテモイヽ」予ハ七月二十八日ト同ジ姿勢デ、彼女ノ脹脛ノ同ジ位置ヲ唇デ吸ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カノ拍子デソレッキリニナッテモ仕方ガナイト諦メテモイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔ノ化粧ノ方法モ昔ハ甚シク違ッテモイタシ、簡単デモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「颯子ニ出シテヤル金ハアッテモ陸子ニ出ス金ハナイッテコトサ」コウ先ズ度胆ヲ抜イテヤッタガ、咄嗟ニ巧イ口実ガ浮カンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月ト云ッテモマダ暑イノデ洋装ニスレバイヽノニ、ナゼカ颯子ハ和服デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事ノ世話、入浴ノ世話、ブラッシングノ世話ナド手ガカヽルコト夥シイノデ、婆サンカラ女中達マデ不平ガ絶エナカッタガ、何ト云ッテモ浄吉ガ実行サセタコトハ当時ノ日記ニ記シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「少シハ痛クッテモコンナコトヲシテイル方ガ気ガ紛レルヨ、痛クテ溜ラナクナッタラ止メル、今ノウチハ仕事シテイル方ガイヽ、アッチヘ行ッテヽクレ給エ」午後一時ヨリ午睡、一時間ホドトロ／＼トスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
