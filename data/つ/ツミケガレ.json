          "literary": [
            {
              "text": "「お兄さま…………」　とアヤ子が叫びながら、何の罪穢れもない瞳を輝かして、私の肩へ飛び付いて来るたんびに、私の胸が今までとはまるで違った気もちでワクワクするのが、わかって来ました。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "此が尊者の身のゆき身のたけ、この竪横の身に、うき世の人の罪穢れを吸ひとつて、卜ひ清めるのだとか申します。",
              "citation": {
                "source": "死者の書　續篇（草稿）",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
