          "literary": [
            {
              "text": "ペトラルカは基督暦千三百四年七月二十日アレツツオに生れき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレツツオとピザとの戰ありしときは、ダンテ軍人たりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校に入りてよりは、「パラツツオオ、デル、ドリア」の廡作りの平屋根より笑ひ戲るゝ群を見ることを許されしのみ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は舟人を喚びて市長の家に往くことを命ぜしに、舟人そのオテルロ宮（パラツツオオ、ドテルロ）なるを告げたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "何時か帝国ホテルで、あのペツツオルド夫人と云ふお婆さんが、リストの der heilige Antonius schreitend auf den Wellen（だと思ふ。",
              "citation": {
                "source": "あの頃の自分の事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツツオチゴメ」という言葉は調子が悪いが、どうしてチを略してツツオとなるのか。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
