[
  {
    "uuid": "3a6861cd-cc1b-5a4c-accd-27d3dcd0cbd3",
    "entry": "務まる",
    "reading": {
      "primary": "つとまる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
