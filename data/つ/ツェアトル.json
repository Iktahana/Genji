          "literary": [
            {
              "text": "○マールイ・ツェアトルで、リュボヒ・ヤロ※ーヤを見る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女のような立場は実際あったのだし、悲劇的取材だが、人の出し入れ茶番、むだな廻り舞台等、マールイ・ツェアトルのたるみを充分にバクロして居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "マールイ・ツェアトル風の流儀でやって居て、無駄とくすぐりが多い。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝居の歴史をよみ、ソブレメンヌイ・ツェアトル〔現代演劇〕をよみ、大分勉強した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
