        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ホンジツヲモツテキンユシユツハカイキンサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シユーベルト、シヨパン、バツハ、なんでもいい。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだ、それは、バツハか。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにまた「三人姉妹」に於ては、トウゼンバツハ氏とマーシヤさんが、次のやうな會話を交してゐる。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウゼンバツハ――二百年三百年後はおろか、たとへ百萬年の後でも、生活はやはりこれまでの通りです。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とでも勝手に理窟をこね※すがいい、おれ達はただ飛べばいいんだつてね……マーシヤ――それにしても意味といふものが――トウゼンバツハ――意味ですつて……いま雪が降つてゐる、それに何の意味があります？",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハツハツヽヽヽヽ坊樣、此｜姉樣が死ぬと言ひますが如何しましようか。",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハツハツヽヽヽ大概そんなことだらうと酒を持て來たのだ、飮みな／＼私が歌つてやる！",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハツハツヽヽヽヽそんなら泣きナ、坊樣と二人で聞くから」と徳二郎は僕を見て笑つた。",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "マネにゆき、ドガにゆき、ゴオガンにゆき、アンドレエエフにゆき、シユトラウス、ボオドレエル、ロオデンバツハの感覚と形式にゆく。",
              "citation": {
                "source": "桐の花とカステラ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬虔な私のいまの心持は軽薄なワイルドの美くしい波斯模様の色合から薄明りの中に翅ばたく白い羽虫の煙のやうなロウデンバツハの神経に移つてゆく。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ウソイツハリのない自殺的行為だ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコールのおかげで快眠、夢中大きな鯉を捕へた、何の前兆か、ハツハツハツ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イツテ、ハツハツハツト　ワラヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……「ウアツハハ」と高く笑つて、薄く雪明のした小路を、大跨に歩き去つた。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、お由は、黒漿の剥げた穢い歯を露出にして、ワツハヽヽと男の様に笑つたものだ。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と変に剛つた声で云つて、物凄く「アツハハ。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ハツハヽヽ、私は駄目ですよ、生れてから未だ加留多に勝つた事がないんで……だが何です、負傷者でもある様でしたら救護員として出張しませう。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ハツハハ、解りませんか？",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、並んで歩いてる人から望遠鏡を借りて前の方を見たんだがね、二十里も前の方にニコライの屋根の尖端が三つ許り見えたよ』『アツハハハ。",
              "citation": {
                "source": "散文詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして町はずれの小バラツクの前で吾々を降ろしたが、妻が賃金の紙包みを彼のポケツトにおし込むやうにしても彼は、ひたすら拒んで、アツハツハ！",
              "citation": {
                "source": "冬の風鈴",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハツハツハ……」　彼等はこんな甘いたあひもない話に、うつとりと酔うてしまつた。",
              "citation": {
                "source": "陽に酔つた風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハツハツハ……」「随分あなたは嘘つきね。",
              "citation": {
                "source": "晩春の健康",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハツハツハ……」「照子さんはもう学校を出たの？",
              "citation": {
                "source": "晩春の健康",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
