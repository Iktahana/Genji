          "literary": [
            {
              "text": "ツルクシダイコ　又單にツルクシとも謂ふは乾大根のことである（愛知縣碧海郡誌）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし現在はたゞツルクシ又はツルシといへば、乾柿を意味する處の方が多い。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツルクシダイコ　また単にツルクシともいうは乾大根のことである（愛知県｜碧海郡誌）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし現在はただツルクシまたはツルシといえば、乾柿を意味する処の方が多い。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
