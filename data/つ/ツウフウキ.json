        "examples": {
          "standard": [
            {
              "text": "トンネル内の排気ガスを入れ替えるため、天井に設置された巨大な通風機がフル稼働している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "厨房にこもる熱気を素早く逃がすために、馬力の強い最新の通風機を増設することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "アパートの古い通風機のモーター音が夜中に響いて、気になってなかなか眠れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "外廊から舞台の直前まで身動き出来ない鮨詰で、一階から三階までの窓を全部｜明放し、煽風機、通風機を総動員にしても満場の扇の動きは止まらないのに、切符売場の外ではまだワアワアと押問答の声が騒いでいるのであった。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "通風機、食糧庫、弾薬庫も、その真下に、相当広い面積を占めていた。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
