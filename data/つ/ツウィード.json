          "literary": [
            {
              "text": "彼は中背で小肥りの体を、金髪に調和する褐色のツウィードの服で包んで居る。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのツウィードの着物と、色がはりのシャツと、それからもじや／＼した頬髯とで、その男が英國人だといふ事が分つた。",
              "citation": {
                "source": "醫師と旅行鞄の話",
                "author": "ロバート・ルイス・スティーヴンソン",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうね、ツウィードかなんか？",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大野　でもあんたなど、ツウィードのスーツなぞ着たりしていいのかねえ？",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
