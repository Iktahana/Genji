        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "不安な気持ちが、私を勉強に突き動かした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チームの勝利への執念が、選手たちを突き動かした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の情熱が周りの人々を突き動かし、プロジェクトは成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
