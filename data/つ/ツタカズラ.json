    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "人跡絶えた山道には、人力車の通う術もなかったので、二人の若い男女は、互に助け合いながら、蔦葛の這う細道を、幾時間となくさまよい歩いた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "前後に次第に高くなって、白い梟、化梟、蔦葛が鳥の毛に見えます、その石段を攀じるのは、まるで幻影の女体が捧げて、頂の松、電信柱へ、竜燈が上るんでございました。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い石垣に蔦葛がからみついて、それが真紅に染まっているあんばいなど得も言われぬ趣でした。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "水車は川向にあつて其古めかしい處、木立の繁みに半ば被はれて居る案排、蔦葛が這ひ纏ふて居る具合、少年心にも面白い畫題と心得て居たのである。",
              "citation": {
                "source": "畫の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "水車は川向にあってその古めかしい処、木立の繁みに半ば被われている案排、蔦葛が這い纏うている具合、少年心にも面白い画題と心得ていたのである。",
              "citation": {
                "source": "画の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑も此男は父の死だ後、市街外れに在る小さな莊園を承嗣だので、此莊園こそ怠惰屋の店とも謂つべく、其白い壁は年古て崩れ落ち、蔦葛思ふがまゝに這纏ふた門は年中開つ放しで閉たことなく、無花果や芭蕉が苔むす泉のほとりに生茂つて居るのである。",
              "citation": {
                "source": "怠惰屋の弟子入り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "攀上り、垂下り、絡みつき、輪索を作る蔦葛類の氾濫。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨大な榕樹が二本、頭上を蔽ひ、その枝といはず幹といはず、蔦葛の類が一面にぶらさがつてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨大な榕樹が二本、頭上を蔽い、その枝といわず幹といわず、蔦葛の類が一面にぶらさがっている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥濘は、荊棘、蔦葛とともに、次第に深くなり、絶えず踊るような足取りで蟻を避けながら、腰までももぐる野象の足跡に落ちこむ。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは、虎でもくぐれそうもない蔦葛の密生で、空気は、マラリヤをふくんでどろっと湿っけている。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "大懶獣草の犢ほどの葉や、スパイクのような棘をつけた大｜蔦葛の密生が、鬱蒼と天日をへだてる樹葉の辺りまで伸びている。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それは、この蔦葛のうえを“Kintefwetefwe”に利用するんだ」「…………」「つまり、コンゴの土語でいう『自然草の橋』という意味だ。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉の赤くなった蔦葛がそれに絡まっていた。",
              "citation": {
                "source": "人面瘡物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間オシャベリをする雲雀や、夜中に鳴きまわる蛙がいないから、どんなにうるさくなくていいだろう」　と思いながらフト足もとを見ますと、一本の蔦葛が垂下って、ずうっと崖の下の家の側まで行っております。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オシャベリ姫は直ぐにその蔦葛を伝って下へ降り初めました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてオシャベリさえしなければきっと親切にしてもらえるに違いない」　とこう思いながら、オシャベリ姫は蔦葛にすがって崖を降りはじめました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めのうちは崖がデコボコしているので、オシャベリ姫はちょうど段々を降りるようにして蔦葛にすがりながら降りてゆきましたが、だんだん下の方になりますと崖が急になって、しまいには全く宙にブラ下ってしまいました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫はこわくなって引返そうとしましたが、もう引返す力が抜けてしまいまして、姫はあまりの恐ろしさに蔦葛にすがりながら泣き出しました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見ると姫は一層恐ろしくなって、手と足で蔓にかじり付いてブルブルふるえていますと、その中にはるか下の方から姫の掴まっていた蔦葛を伝って昇って来るものがあります。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お月様が東の山からあがると間もなく、この塔の上から見まわしますと、向うの崖の途中に蔦葛につかまって一人のお嬢さんが降りて来ます」「まあ……それじゃ、あの時私を助けて下すったのはあなたでしたか」「いいえ、私ではありませんが、ただ何というあぶないことだろうと思いました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁はくづれかゝつてゐたけれど、青々した蔦葛が一ぱいにそれを覆つてゐるので、却つて美しく見えました。",
              "citation": {
                "source": "首相の思出",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "震災以前とて、その傾向が無いではなかったが、従来の型の如き型を破った髷物小説は、僅かに、指折ってみて、中里介山の「大菩薩峠」（都新聞）、国枝史郎の「蔦葛木曾桟」（講談雑誌）、白井喬二の「神変呉越草紙」（人情倶楽部）、大佛次郎の「鞍馬天狗」（ポケット）に過ぎなかったものである。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "その名を、岳陰荘と呼び、灰色の壁に這い拡がった蔦葛の色も深々と、後方遙かに峨々たる剣丸尾の怪異な熔岩台地を背負い、前方に山中湖を取｜繞る鬱蒼たる樹海をひかえて、小高い尾根の上に絵のように静まり返っていた。",
              "citation": {
                "source": "闖入者",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "家は三疊と六疊との二た間で、ところ／″＼床板が朽ち折れてゐるらしく、凹んだ疊の上を爪立つて歩かねばならぬ程の狐狸の棲家にも譬へたい荒屋で、蔦葛に蔽はれた高い石垣を正面に控へ、屋後は帶のやうな長屋の屋根がうね／＼とつらなつてゐた。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "（前編終り）　作者より　「蔦葛木曽棧」は足掛け五年書きました。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春雨や人住んで煙壁を洩る　蔦かずらの纏う廃屋の中から、壁を伝って煙が洩れてる。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔦かずらの這う古く懐かしい家の中で、薪の燃えるストーヴの火を囲みながら、老幼男女の一家族が、祖先の画像を映す洋燈の下で、むつまじく語り合うことを言うのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この、筆者の友、境賛吉は、実は蔦かずら木曾の桟橋、寝覚の床などを見物のつもりで、上松までの切符を持っていた。",
              "citation": {
                "source": "眉かくしの霊",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の栄華を語る古城のほとり、朽ちかけた天守閣には蔦かずらが絡み、崩れかけた石垣にはいっぱい苔が生え、そのお濠に睡蓮の花が咲いていたら、私達は知らぬ間に、涙含ましい気持ちでいっぱいになっているに相違ありません。",
              "citation": {
                "source": "季節の植物帳",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
