          "literary": [
            {
              "text": "達者ニ在ッテハ何ゾ必ズシモ其｜遽カニ至ルヲ驚カン哉。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ハラガヘッテハ、イクサガデキヌ。",
              "citation": {
                "source": "古典竜頭蛇尾",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　――オマエハ、モウ、ソレヨリ、オオキクナッテハ、イケマセンヨ。",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ、道子ヲ殺シタ後清三ガオキタラ、罪ヲスッカリ自白シテ自殺シヨウト思ッテ居タノデスガ、然シ清三ノ態度如何ニ依ッテハ之ヲ殺スツモリデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでそれが莫騎すなわちナノリソ（乗ッテハナラナイ）である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ忰ハ寧ロ彼女ノ経理ノ才ヲ徳トシテ、彼女ヲ失ッテハ不便デアルト考エテイルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘー、颯子ガ伺ッテハ悪インデスカ」「颯子バカリジャナイ、陸子ナンゾ見舞ニ来ヤガッタラ承知シナイゾ」「ソリャ分ッテマスヨ、イクラ痛イト仰ッシャッテモ手ノコトダカラ心配ハナイ、オ前サンハ遠慮シナサイッテ、コナイダモ陸子ヲ追イ返シタンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日来テ又モ失敗ト云ウヨウナコトガアッテハ困ルノデ、博士モモウ一度ト云ウ気ハナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パパ、ママハドコヘ行カハルノカ分ッテハルノ」ト、膳ニ向ウト敏子ガ始メタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際｜此処マデ来テシマッテハ外ニ道ハナサソウデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカラナイシ、ヨソノオジサンガ、ソバニイテ、コワイカオシテ、ナニモイッテハ……」　バッタリ声が切れた。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシノコト、ダレニモイッテハイケナイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
