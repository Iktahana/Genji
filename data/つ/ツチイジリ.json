    },
    "definitions": [
      {
        "index": 1,
        "gloss": "playing with dirt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は昔から土弄りが好きで、週末はいつも庭で過ごしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、よく裏山で土弄りをして秘密基地を作っていたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しい花壇を作るため、朝からずっと土弄りをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしなまじっか学問なんか噛りちらすより、土弄りでもしていた方がよかったかも知れんよ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "到頭お島がつれられて行ったときに、彼は麦や空豆の作られた山畑の中に、熱い日に照されて土弄りをしていたが、無智な顔をして畑から出て来る汚いその姿を見たときには、お島は慄然とするほど厭であった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり土弄りをして暮しているじゃないか」「ふむ、誰がその親のところへ、籍を入れてくれろと頼みに行ったんだ。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが軍隊生活の土産として、酒と女の味を知った彼は、田舎の味気ない土いじりに、もはや満足することが出来なかった。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は腰を折られて土いじりもしなくなった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは興醒めた気持になって、これでは葛岡のことを相談しても駄目だと思い、たださり気なく、日々通学する学園の生活のはなしをして、そこには丘の陽当りに果樹園があったり、花畑があったりして学課の間には土いじりもする。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は天気のいい日の例で今日もやはり一日庭に出て土いじりしているらしかった。",
              "citation": {
                "source": "黒猫",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日倉地が例のように庭に出て土いじりに精を出している間に、葉子は悪事でも働くような心持ちで、つやにいいつけて反古紙を集めた箱を自分の部屋に持って来さして、いつか読みもしないで破ってしまった木村からの手紙を選り出そうとする自分を見いだしていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもの着物とちがうんだからね、土塀にもたれたり、土いじりしちゃいけないんだよ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "草鞋穿で、土いじりでもしながら、片手間に用務を談ずるなんて、そういう気風の人じゃ有りません」「極く平民的な人のようだが、一面は貴族的だネ。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この従妹は田舎の家で土いじりの好きな父親の対手をしていたものだから、いろいろのことに自然通じていて、そうやって鉢へ入れる土も、縁の下のでなければだめ庭土はすっかり凍っているからと、私に教えるのであった。",
              "citation": {
                "source": "昔を今に",
                "author": "――なすよしもなき馬鈴薯と綿――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つくねんと土いじりしながらそれを視ていた啓吉は、吃驚した気持ちから、おぼろげな胸のとどろきを感じた。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭で土いじりをして。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうはすっかり春めいて太郎は庭で土いじり。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "都会の人って面白いのね、わたしたちは誰かが土いじりしていると、つい誘われて何かしたくなるのに、町の人ってものは、そういう気分が全くないものと見えるのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこで暮すにしろ、天気晴朗の朝、俄然婦徳を発揮するまで、わたしは土いじりと勉強とで過したいと思います。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんのいる所の前がすぐ往来で、往来には髪ののびた、手も足も塵と垢がうす黒くたまったはだしの男の児が三人で土いじりをしていたが、私たちの通るのを見て「やア」と言いながら手をあげた。",
              "citation": {
                "source": "日光小品",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なかなかいいところがあるもんだよ、こういう生活も……」「――もっとも、あんたのその手じゃ、ちょいと細君になりてもないだろうけど」　土いじりをし、万端の荒仕事をする竹村は火箸をもっている自分の手をちらりと見おろして、「ふん」といった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃は父も閑散な身となって佃島にすんで土いじりをしていたので、一所に植木いじりはしていたが――たまたま粋な客などが来て、海にむかった室で昼間の一酔に八十翁もよばれてほろよいになると、とてもよい声で、哥沢の「白酒」を、素人にはめずらしい唄いぶりをした。",
              "citation": {
                "source": "木魚の顔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "（注ぐ）昌允　さんざ、土いじりをして来たんだろう。",
              "citation": {
                "source": "華々しき一族",
                "author": "森本薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が庭の中で夢中に土いじりをしている、病中の母親が寝ながらその方を眺めている、それが彼等二人にとっては何であるかを、私は初めて瞥見したような気がして、先刻の自分のおせっかいを苦々しく思い出した。",
              "citation": {
                "source": "或る素描",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕はほかに運動をしないから、こんなことをしてるんだが、然し、土いじりをすることは、何よりも身体にいいし、随って、何よりも頭にいいし、随ってまた、身体にいいよ。",
              "citation": {
                "source": "白い朝",
                "author": "――「正夫の童話」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "居間にも座敷にも他所者が一ぱいに詰まって采配を振り、家付の無能な子供たちは裏の菜園で黙黙として土いじりをしていたり、気抜けのした別の子供たちは穴倉に追いこめられて『福音書』の暗誦で日を立てたりしてるという有様である。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の事で、千住の家の奥庭の柿の花の頻りに降る下で、土いじりをして遊んでいました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも土いじりばかりなすって、堅い手をしていらっしゃる。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は毎日お邸へ診察に出かけ、後は近所の知り合の病人を見るくらいのものですから、至って暇でしたが、家には庭がないので、好きな土いじりが出来ません。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ家で本を読んだり、裏庭で土いじりをするくらいのものですから、兄に附添って下宿にいられる祖母が、用事があって家へ来られた時に連れて行ってもらうのが楽しみで、祖母の来られるのが待たれました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も土いじりが好きですから、よく草取りをします。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを大々的にやるんで、どしどし工場や住宅を建築するんだが、あんな君の部落のような山の中腹のつまらない所で一生涯ぴいぴいして土いじりをしているより、どうだい、俺の事業へやって来ねえか。",
              "citation": {
                "source": "荒蕪地",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、あのあたりで土いじりをしている職人というものは、百姓みたいなものであるから、さもありなんと、私はこの話を心に留めていた。",
              "citation": {
                "source": "蝦蟇を食べた話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
