          "literary": [
            {
              "text": "さて、そこに書き綴られた文章は――「レイノジケンニツキ、シキユウ、セキガイセンシヤシンサツエイタノム。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツエイハンイハ、ヒジリバシヨリスイドーバシニイタルソトボリエンガン一タイ。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とうちゃんは、今、新山の学校の二階にいる、お土産をもっていく……火の用心……云々」　ここで記念サツエイをパチン。",
              "citation": {
                "source": "平泉紀行",
                "author": "──専攻科第一類歴史部──",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは極く上等の純白の模造紙にペンで書いたもので（○ツエイ　ハ　ヨ○八時三十分　ヨリ行ウ　○ショップ　○ンセン同伴ス）というだけの文句である。",
              "citation": {
                "source": "危し※　潜水艦の秘密",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに気づいたのは、例の暗号文、「サツエイ　ハ　ヨル八時三十分」と書いてあったことだ。",
              "citation": {
                "source": "危し※　潜水艦の秘密",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
