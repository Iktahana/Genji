        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "暇な時間は、つべで面白い動画を探して見ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のバンドのライブ映像は、つべで公開されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最近の若者はテレビよりもつべを見る時間の方が長いらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "〔いざ渡せかし　おいぼれめ〕宮沢賢治「いざ渡せかし　おいぼれめいつもこゝにて日を暮らす」すぱとたばこを吸ひやめて何を云ふともこの飯の煮たたぬうちに　立つべしや芋の子頭白髪しておきなは榾を加へたり",
              "citation": {
                "source": "〔いざ渡せかし　おいぼれめ〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ようやく八時なればまだ四時間はこゝに待つべしと思えば堪えられぬ欠伸に向うに坐れる姉様けゞん顔して吾を見る。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "山が育つべく思うほどのこどもなら山は育てよう。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山と山神とは性格も容貌も二つに分つべからざる関係を持つことは翁が西国の諸山に間配って諸山の山神に仕立てた自分の子供たちによって知れるところのものである。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汨羅の屈原ならざれば、恨みは何とかこつべき、大川の水清からぬ名を負ひて、永代よりの汽船に乘込みの歸國姿、まさしう見たりと言ふ物ありし。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小指は高くゝりの覚」で貸借の争議を示談させるために借り方の男の両手の小指をくくり合せて封印し、貸し方の男には常住坐臥不断に片手に十露盤を持つべしと命じて迷惑させるのも心理的である。",
              "citation": {
                "source": "西鶴と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "手工は勿論高等教育を受けるための下地にはならないでも、人間（〔sittliche Perso:nlichkeit〕）として立つべき地盤を拡げ堅めるために役に立つ。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェーゲナーの大陸漂移説や、最近ジョリーの提出した、放射能性物質の熱によって地質学的｜輪廻変化を説明する仮説のごときも、あながち単なる科学的ロマンスとして捨つべきものでないと思われる。",
              "citation": {
                "source": "地震雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の夜　庭の芭蕉のいと高やかに延びて、葉は垣根の上やがて五尺もこえつべし。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "故人がよみつる歌の事などさま／″＼胸に迫りて、ほと／＼涙もこぼれつべく、ゆかしさのいと堪へがたければ、閨の戸おして大空を打見あぐるに、月には横雲少しかゝりて、見わたす岡の若葉のかげ暗う、過ぎゆきけんかげも見えぬなん、いと口惜しうもゆかしうも唯身にしみて打ながめられき。",
              "citation": {
                "source": "すゞろごと",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また第百十二段に大事の前に小事を棄つべきを説く条でも同様である。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三十八段、名利の欲望を脱却すべきを説く条など、平凡な有りふれの消極的名利観のようでもあるが、しかしよく読んでみると、この著者の本旨は必ずしも絶対に名利を捨てよというのではなく、「真の名利」を求めるための手段として各人の持つべき心掛けを説いているようにも思われる。",
              "citation": {
                "source": "徒然草の鑑賞",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう云つたやうな夢をもつべきではないのでせうか。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "堂堂と遠慮なく爭ひ勝つべく、弱き者｜敗るる者がドシドシ蹴落されて行く事に感傷的な憐憫など注ぐべきでもあるまい。",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通教育にも理科の課程がかなり豊富にあるようであるから、それがよく呑み込めていれば、それだけでも一通りはかなり役に立つべきはずであるが、実際それがそうでないのは、教える方と教わる方と両方に罪があるであろう。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」如何にも兵士など、わしの風しもに立つべき奴等なんだ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっぱいの星がべつべつに瞬いてゐる。",
              "citation": {
                "source": "柳沢",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "草より出でゝ草に入るとは武蔵野の往時の月をいひけん、今は八百八町に家相望めば、東京の月は真に家の棟より出でゝ家の棟に入るともいふべけれど、また水の東京のいと大なるを思へば、水より出でゝ水に入るともいひつべし。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれ秋の夕なんど天の一方に富士を見る時は、まことにこの渡の風景一刻千金ともいひつべく、画人等の動もすればこの渡を画題とするも無理ならずと思はる。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵政の世界において秀吉が不世出の人であったと同様に、趣味の世界においては先ず以て最高位に立つべき不世出の人であった。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "よろづ温順にして、君子の体を具へて小なるものともいひつべきさまなる、取り出でゝ賞むべきものにもあらぬやうなれど、なか／＼に好まし。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今かりに現代科学者が科学者として持つべき要素として三つのものを抽出する。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは映画俳優の演芸が舞台俳優のそれと全くちがった基礎の上に立つべきものだということをわれわれに教えるものではないかと思われる。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはぜひともしかるべき人々の慎重な考究にまつべきではないかと思う。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの一疋はそこで得意になって、舌を出して手拭を一つべろりと嘗めましたが、にわかに怖くなったとみえて、大きく口をあけて舌をぶらさげて、まるで風のように飛んで帰ってきました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「多分両方べつべつに染めましたでせう。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑も此男は父の死だ後、市街外れに在る小さな莊園を承嗣だので、此莊園こそ怠惰屋の店とも謂つべく、其白い壁は年古て崩れ落ち、蔦葛思ふがまゝに這纏ふた門は年中開つ放しで閉たことなく、無花果や芭蕉が苔むす泉のほとりに生茂つて居るのである。",
              "citation": {
                "source": "怠惰屋の弟子入り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺もこうやってはいるがいざとなればそのくらいの工面はつくから、苦しいながらあちこち世話をやいてやってみると、そんなところから金を出してもらうのは嫌だとか何んとか、つべこべいいくさる。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老女　――相変らずつべこべとうるさい奴等だ。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の勢に乘じて、立所に一國一城の主と志して狙をつけたのは、あらう事か、用人團右衞門の御新姐、おくみと云ふ年は漸う二十と聞く、如何にも、一國一城に較へつべき至つて美しいのであつた。",
              "citation": {
                "source": "片しぐれ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
