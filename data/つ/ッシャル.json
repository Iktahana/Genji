          "literary": [
            {
              "text": "オ爺チャンガアヽ仰ッシャルノモ無理ナイワ」ト颯子ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「手ガ痛イダノ歩ケナイダノト云イナガラ、結構生活ヲ享楽シテイラッシャルジャアリマセンカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ瞼ガ切レル場合」「若奥様ハソンナノヲ見ニイラッシャルンデスカ」ト、佐々木ガ口ヲ挟ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、マダ起キテラッシャルノネ、鼾ガ聞エテ来ナイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシハ一下足オ先ニ参リマス、オ爺チャンハイツイラッシャルノ」ト、婆サンハ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ胸ニ収メテ置ク」「オ爺チャンハアタシニソンナコトヲシロッテ仰ッシャルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハソウト、陸子ガ面白イコトヲ聞イテ来マシタンデ、オ爺チャンニモオ耳ニ入レテ置キタイト思イマシテネ」「アヽソウ」又何カイヤナコトヲ云イニ来ヤガッタト思ッテイルト、「オ爺チャン油谷サンヲ覚エテラッシャルデショウ」「ブラジルヘ行ッタ油谷ノコトカ」「アノ油谷サンノ息子サンヲ御存知？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外デハアンマリアンナ真似ハナサイマセン、旦那ガ御覧ニナッテイラッシャル時ニヨクアンナ真似ヲナサルンデス」ト野村ハ云ウガ、ソウダトスレバ、コレモ予ヲ揶揄スル積リナノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドルシンハ汗ガ出テイヤダッテ仰ッシャルンデス」佐々木ガ杉田氏ニ訴エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ御老人ノコトデスカラソノ御辛抱ガ辛イト仰ッシャルノモ無理ハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハイ、ハイ、オ爺チャン、アタシニドウシロッテ仰ッシャルノヨ、何デモスルカラ仰ッシャッテヨ」ト、ソウ来テクレヽバ締メタモンダガ、迂闊ニソウハ云イソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フヽン、アタシニ何ヲサセヨウッテ仰ッシャルノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カヨイ治療法ハナイモノデショウカ、御老人デイラッシャルノデ、牽引法ソノ他手数ノカヽル面倒ナ方法ハオイヤナンデスガ、ト云ッタトコロ、ソレニハ方法ガナイコトハナイト、博士ガ云ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノ福島博士ト云ウ人ハ信用ノ置ケル人カネ」「エヽ勿論デゴザイマストモ、アノＰＱ病院ノ整形科ニ勤務シテイラッシャル先生デスカラ間違イハゴザイマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――誰ヲ連レテイラッシャルオ積リ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今度ハ幾日グライイラッシャルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何テコトヲ仰ッシャルンデス」「佐々木サン」「ハイ」「ハイジャアナイ、君ダッテ五子カラ聞イテ知ッテタンダロウ、ミンナデ寄ッテ集ッテコノ老人ヲ騙シニカヽッテタンダ、ミンナデ颯子ヲ邪魔ニシテヤガル」「ソンナ風ニ思ッテラシッチャ佐々木サンコソイヽ迷惑ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ理由ハアタシニハヨク分ラナイガ、オ爺チャンコソ何カシラ感ヅイテイラッシャルノデハナイデショウカト、乙ニ絡ンデ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
