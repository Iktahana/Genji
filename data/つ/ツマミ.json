        "examples": {
          "standard": [
            {
              "text": "ビールを飲むときは、枝豆や唐揚げのような摘みが欲しくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "居酒屋では、お酒に合う様々な摘みが用意されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "手作りのチーズ摘みは、ワインとの相性が抜群だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
