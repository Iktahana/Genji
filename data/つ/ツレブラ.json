          "literary": [
            {
              "text": "ダンスはツレブラ、そのシステム、ウォーク、右廻転、左廻転、プロムナード、チロ、踵を床から浮離するツレブラを愛す。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が踊りにおいてツレブラを好むように、彼女の色素の複雑さが、ジャズが夜中のサイレンのように鳴り渡る都会人の愛情を占領してしまった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで彼女はツレブラを踊った。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            }
          ]
