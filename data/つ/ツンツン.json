  {
    "uuid": "c0b6b78f-098e-50a6-a7a7-0d6110ed34fe",
    "entry": "つんつん",
    "reading": {
      "primary": "つんつん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "松の木や楢の木が、つんつんと光のそらに立ってゐます。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔をあげて見ますと入口がパッとあいて向ふの山の雪がつんつんと白くかゞやきお父さんがまっ黒に見えながら入って来たのでした。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松の木や楢の木が、つんつんと光のそらに立っています。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "聾の僻みで、昨日悩まされた、はじめの足疾な女に対するむか腹立も、かれこれ一斉に打撞って、何を……天気は悪し、名所の見どころもないのだから、とっとっ、すたすた、つんつん聾が先へ立って。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからこんどは、針がいっぱいつんつんつッたっている、せまい針箱のなかにはこばれました。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからは気息づまるような不快な匂が彼れの鼻の奥をつんつん刺戟した。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あごの無精ひげを指先でつんつんとひっぱりながら、じっとご奉行神尾元勝の顔を見ているうちに、かれの玻璃板のごとき心鏡は、玲瓏として澄み渡ってまいりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、例の烱々としたまなこをらんらんと光らして、おもむろに、あごのまばらひげをつんつんとひっぱっていたようでしたが、いっしょにずばりと天下第一の胸がすく名｜啖呵が言い放たれました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのつんつんとひっぱるやつがお出なさりゃ、じきに知恵袋の口があくんだからな」　と――いうかいわないうちに、果然、むくりと起き上がるや、微笑とともにあいきょう者へ、朗らかなところが飛んでいきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう、つんつんしないでさ！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉吉は怒つてしまつて、むきにつんつんしてゐるなか子が、急に可愛くなつてしまつた。",
              "citation": {
                "source": "朝夕",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二つの目玉がみがき上げた鏡を並べたようにきらきらかがやいて、剣を植えたようなきばがつんつん生えた間から、赤い舌がめらめら火を吐くように動いていました。",
              "citation": {
                "source": "田原藤太",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "つんつんすりゃ仇されるしさ、うっかりサービスすりゃエロだってひっかけるしさ。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　トントンピーピのわるとびは、としよりお家にほめられて、ほめられて、つんつんつんとそりかへり、「としより家さんみておくれ。",
              "citation": {
                "source": "トントンピーピ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そう押しかぶせて、「おせきら、俺にいつまでそんなつんつんした口きいていんだ、ようく考えてしねえと、はア、損だっぺで。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこんとこをよく考えてな、後生だからあまりつんつんして貰いますまいぜ。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "申すまでもなく天の仕事に無理はないのであって、この庭にごらんの通り木賊がつんつんと生えております。",
              "citation": {
                "source": "芸術的な書と非芸術的な書",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とつんつん言い出すアリス、だってちょっとわずらわしく思えてきたものだから。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "河原はいちめんに草が萠え、葦の芽がつんつんと伸びている。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高慢ちきで、つんつんだもん。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
