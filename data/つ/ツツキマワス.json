        "examples": {
          "standard": [
            {
              "text": "子供が寝ている間に、おもちゃ箱をそっとつつき回した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "探偵は怪しい部屋の中を、隅々までつつき回して証拠を探した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいパソコンの機能が分からず、とりあえず色々とつつき回してみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「まだ誕生やそこらの子を、手術じゃとやら何とやらいうて、生きた目をつつき回すんじゃそうなが、そんなことしてえいことかなあ。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう人々はソヴェト同盟の社会生活の心理には、いつでも『プラウダ』の肯定しているのとは違った底流れがあるということを、生活感情が分裂懐疑している自分たちの文化の本質を計らずむき出しつつ、興味をもってつつきまわす人々であった。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
