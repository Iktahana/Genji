  {
    "uuid": "caf47f93-f7e7-5d96-b192-a817a098e8d2",
    "entry": "釣り上がる",
    "reading": {
      "primary": "つりあがる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to be landed (of a fish)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海から揚がったばかりの魚が、網の中で釣り上がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "大きなシーバスが釣り上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "重い真鯛が釣り上がり、みんなで歓声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "髪毛も同様に、仮髪かと思われるくらい豊かに青々としているのを、眥が釣り上がるほど引き詰めて、長い襟足の附け根のところに大きく無造作に渦巻かせていた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが邦でも落雷などで極めて驚くと睾丸釣り上がると言うが、インドでは釣り上がるどころか天上して失せおわるとしたのだ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集の目がそれへつりあがると、また、寂とした大地を、かつかつと駆ける馬蹄の音がおこっていた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
