        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜もすがら夜もすがら歌ふ鶯……月白き芝居裏、河岸の病院、なべて夜の疲れゆくゆめとあはせて、ウヰスラアーの靄の中音に鳴き鳴きてそこはかとなし。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十三年五月　　六月白い静かな食卓布、その上のフラスコ、フラスコの水にちらつく花、釣鐘草。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "――花柑子咲く野も近み、月白ろむ葡萄畑の夜の靄に、土蜂の羽音、香の甘さ、青葉の吐息、情慾の誘惑深く燃え爛れ、仰げば空の七つ星紅く煌めき、南国の風さへ光る蒸し暑さ。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "千九百十四年九月白秋真珠抄　短唱わが心は玉の如し、時に曇り、折にふれて虔ましき悲韻を成す。",
              "citation": {
                "source": "真珠抄",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "童話の月白い月白い月ゆゑ、昼の千鳥もつれないか。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "是月白井孝右衛門、橋本、大井も亦署名す。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼うどんが東京に入り込んで来たのは明治以後のことで、黙阿弥の「嶋鵆月白浪」は明治十四年の作であるが、その招魂社鳥居前の場で、堀の内まいりの男が夜そばを食いながら、以前とちがって夜鷹そばは売り手が少なくなって、その代りに鍋焼うどんが一年増しに多くなった、と話しているのを見ても知られる。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十三年の七月、市村座――その頃はまだ猿若町にあった――で黙阿弥作の『嶋鵆月白浪』を上演した。",
              "citation": {
                "source": "源之助の一生",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "○十二月、新富座の二番目に「島鵆月白浪」を初演。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "くづをれ、――さては自らほしいままなる願ひに、ただよひ心地の束のひまを、沈默よ、胸のふかみに、今しも低きささやき、――月白ほのかに匂ひわたるこの夕暮の刹那や、あるひは吾世のすがたならぬ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ、かなた、森の木の間に、うは白み、――ああ月白のにほひ仄に。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "必死と争へる両箇が手中の刃は、或は高く、或は低く、右に左に閃々として、あたかも一鉤の新月白く風の柳を縫ふに似たり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『甲子夜話』五一に、吉宗将軍小金原に狩りして、自ら十文目の鉄砲で五月白と名づけた古猪の頭を搏ち、猪一廻りした処を衆人折り重なって仕留めた。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "近藤事務長は土地の有志と計りて、事務長以下十数人、遺骸を奉じて埠頭を去る三｜哩なるパセパンシャンの丘巓に仮の野辺送りをし、日本の在留僧釈梅仙を請じて慇ろに読経供養し、月白く露深き丘の上に遥かに印度洋の※鞳たる波濤を聞きつつ薪を組上げて荼毘に附した。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "同年四月白水社『機械』に初収。",
              "citation": {
                "source": "時間",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "桃水和尚は凡夫に如同する事に於て可成り垢抜けしたところまで行つたがそれでも臨終に鷹峯風清月白とか何とかいふ遺偈を遺し片鱗を露してる。",
              "citation": {
                "source": "非凡人と凡人の遺書",
                "author": "岡本一平",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば相愛する女と月白く花咲ける籬に相擁して、無量の悦楽を感じたとする。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯れすすき霜にきらめく影更けて荒き裾野に月白く照る高野川のほとりに住みける春。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            },
            {
              "text": "月白うして黄海、物のさえぎるなし。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の文人ならば当然、月白く、風清し、この良夜を如何せん――というところなのでしょう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "町中の堀割に沿うて夏の夕を歩む時、自分は黙阿弥翁の書いた『島鵆月白浪』に雁金に結びし蚊帳もきのふけふ――と清元の出語がある妾宅の場を見るような三味線的情調に酔う事がしばしばある。",
              "citation": {
                "source": "夏の町",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "春寒のよりそひ行けば人目ある大正十四年二月草摘に出し万葉の男かな草を摘む子の野を渡る巨人かな大正十四年三月春宵や柱のかげの少納言大正十四年三月白牡丹といふといへども紅ほのか雨風に任せて悼む牡丹かな大正十四年五月十七日　大阪にあり。",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入ってはただ月白く風｜爽かに、若葉青葉の薫りが夜気に揺らぐを覚ゆるのみである。",
              "citation": {
                "source": "左千夫先生への追憶",
                "author": "石原純",
                "note": "青空文庫"
              }
            },
            {
              "text": "月白く、風すずやかな夜から始まる。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "政略、用兵、経済、器能の働きはもちろん、自然の山川原野を駆使し、月白烈日の光線を味方とし、暗夜暁闇の利を工夫し、雲の去来、風の方角、寒暑湿乾の気温気象にいたるまでのあらゆる万象を動員してそれに機動を与え、生命を吹きこみ、そして「我が陣」となす中心のものは人間である、人間の力でしかない。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "月白き半島の千鳥ヶ浜以来、ここに再び巡り会いました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
