[
  {
    "uuid": "fa156e40-eb15-528b-aa2c-127d8f1f5dbc",
    "entry": "突き落とす",
    "reading": {
      "primary": "つきおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to thrust down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は相手を突き落とし、勝利を収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "崖から石を突き落とすな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怒りに我を忘れ、友人を階段から突き落とそうとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そして今にも襟髪を掴むか、今にも崖から突き落とすか、そんな恐怖で息も止まりそうになっているんです。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナ・ステンのナナが酒場でうるさく付きまとう酔っぱらいの青年士官を泉水に突き落とす場面にもやはり一種の俳諧がある。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彼女を悲惨な感情のどん底に突き落とすものはただそればかりではなかった。",
              "citation": {
                "source": "街頭の偽映鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "折助は先廻りをして、芦の間か柳の蔭にでも隠れていて、不意に亭主を突き落とす……。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "安蔵が釣りに行くのを知って、勇二が先廻りをしていて不意に川へ突き落とす……。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこまで倉地を突き落とすことは、それだけ二人の執着を強める事だとも思った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、窓枠の高さは二尺五寸ほどありますから、人間一人を突き落とすには、よほどの力を要します。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の六（終局）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすれば、第二の人がたとい忍び足で近づいていっても、突き落とすときには両脚を踏ん張るのが至当であります。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の六（終局）",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとなれば、抱き上げるためには突き落とすときよりも余計に力を要するからです。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の六（終局）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな時こそ、私を庇護ってくれなきゃいけない人なのに、先生は私を突き落とすようなことをしたのよ。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういった我らの客にとって誠に悦ばしい評判が、市じゅうにひろまって、それは、この客のある奇怪な本性と、企らみというか、それとも田舎でよくいう『やまこ』というやつが、殆んど全市を疑惑のどん底へ突き落とすに至るまで、ずっと続いたのであるが、その経緯については、間もなく読者の探知するところとなろう。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて又翌日をむかへれば、麓への交通をつけるために里人は山がひの径へ集合しますが、嗚呼勤労の歓喜、彼等は径の雪をわり深い谷底へ嗚呼歓喜の叫びをあげながら突き落とすのです。",
              "citation": {
                "source": "金談にからまる詩的要素の神秘性に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "良心は暴君と變り、情熱の咽喉元を掴み、嘲笑して彼女にその可愛い足を泥濘の中に浸すばかりだと云ひ、彼はその鐵の腕をもつて彼女を底知れぬ苦惱の深淵に突き落とすと誓ふのだ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほかでもない、もし君がもう一度……たった一口でも……母をあしざまに言ったら……僕は君を階段から突き落とすぞ！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そう……ご親切に……ねえ、ドゥーニャ、僕はさっきルージンに、階段から突き落とすぞと言ってやったよ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに聴くことのできた話の内容は、一向に二人の関係について予備知識をもたなかった僕を、驚愕の淵につきおとすに十分だった。",
              "citation": {
                "source": "振動魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなきゃ、階段からつきおとすぞ。",
              "citation": {
                "source": "こわいことを知りたくて旅にでかけた男の話",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、人生の夢というものは、かように一方では人間進歩の動力となるものでありますが、他方では、どうかすると、かえって人間の生命を萎縮させ、しばしば人を絶望の深淵につきおとすことがあるものであります。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしかすると、そのあとサンタクロースをあの穴のところにひっぱりだして、ならくの底につきおとすつもりなのかもしれません。",
              "citation": {
                "source": "サンタクロースがさらわれちゃった！",
                "author": "A KIDNAPPED SANTA CLAUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "といって、上にのぼって、たとえ明智をつきおとすことができても、かんじんのプロペラがこわれているのでは、どうすることもできません。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "劉封の君、孟達などのご処分は、後にして然るべきかと存じます」　やがて張飛も駈けつけ、蜀中の兵馬も、続々と成都に入り、ここ両三日、三峡の密雲も風をはらみ、何となく物々しかった折も折、国中を悲嘆の底へつきおとすような大悲報は、遂に、最後の早馬によって、蜀宮の門に報じられた。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの男を突き落す前に掏ってやればよかった……」　そんな後悔でかえって自分を力づけていた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "手を添えて突き落すは三つ児でも出発る業で厶りまするが、これを支え、喰い止めようとするは大丈夫の御覚悟持ったお方でのうてはなかなかに真似も出来ませぬ。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まんなか辺まで引摺って行って突き落すか。",
              "citation": {
                "source": "鴛鴦鏡",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一歩進んで、より孤独な境遇に突き落すのはなお厭でした。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっと後から突き落すような勢で、彼を前の方に押しやった。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一息で懺悔の深谷へ真ッ逆さまに突き落すつもりでいた彼女は、まだ兄の後に平坦な地面が残っているのではなかろうかという疑いを始めて起した。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそ谷山家の一切合財を、地獄のドン底まで突き落すに足る大発見と思って、胸を轟かしたに違いありません。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その地獄絵巻の実在を、自分の死によって裏書きして、小生等を仏教の所謂、永劫の戦慄、恐怖の無間地獄に突き落すべく……。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はとつさに、女をさうした逆境に突き落す金がいくらであるかを聞いた、その時は、すぐにそれを出してやりたいと云ふ気持に駆られてゐた。",
              "citation": {
                "source": "日本三文オペラ",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
