[
  {
    "uuid": "4cf6b03e-bf45-5d2d-bd18-4f77eb82a946",
    "entry": "付け木",
    "reading": {
      "primary": "つけぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
