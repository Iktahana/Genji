      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "thin strip of wood smeared with sulfur, used to light a fire",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "マッチが普及する前は、付け木の先に硫黄を塗ったものが火種として使われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母は昔、火鉢の炭から付け木を使って行灯に火を灯していたという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古道具屋の隅に、江戸時代から伝わる古びた付け木が置かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "付け木の水車を仕掛けているのもあれば、盥船に乗って流れて行くのもある。",
              "citation": {
                "source": "花物語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "車夫は梶棒をおろして、奥様、お気の毒ですがその腰掛けの下にオランダ付け木（マッチの事ですよ）がはいっていますから、というのでしょう。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一方に、付け木を二、三枚、人にしらせず懐中すれば船に酔わぬなり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、他から物を贈られたときに、付け木を入れて返すは、付け木の先に硫黄がついておるから、サキイワウすなわち先を祝うの意味であるとのことだ。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「燧石と火打鎌と、火口と硫黄付け木じゃ、あんなことはむずかしかろう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "火の呪い",
                "note": "青空文庫"
              }
            },
            {
              "text": "「え、その小さいお重の中へ入れておいたのです」「よし、それでいい」　平次はお越の後ろ姿が廊下に消えると、踏台を戸棚の前に持って行き、硫黄付け木を一枚灯して、念入りに戸棚の上を調べ始めました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「男三人は相当に書けるが、女四人はお松の外は皆んな下手っ糞だな」「このうちに付け木の字に似たのはありませんか」「無い、一つも無い。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "付け木の字はもっと下手だ」「わざと下手っ糞に書いたんじゃありませんか」「多分そんな事だろう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "付け木に書いた下手な字も、お越は全くの無筆のふりをしていたので、手のつけようがなかった。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "焚きつけは硫黄付け木の小枝で間に合せ、油はほんの少しばかりの灯油が、行灯の皿と古い小さい油壺にあるだけ、綿は蒲団でも引っ剥がしたら古いのが出て来るかも知れないといった程度です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "酒屋火事",
                "note": "青空文庫"
              }
            },
            {
              "text": "プーンと匂う、硫黄付け木の匂い。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "巾着切りの娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりの子供は、燐の壜の中に差し込んだ付け木に火をつける音を聞いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は餌物をつかんでる梟のように暗闇に満足して、手探りに階段を上がってゆき、静かに戸を開いてまた閉ざし、何か物音が聞こえはしないかと耳を澄まし、コゼットとトゥーサンとが確かに眠ってるらしい様子を見て取り、フュマードの発火壜に付け木を三、四本差し入れてようやく火をともした。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "街に玩具の月が出ると燐寸箱を出たり入つたり人形どもはキーキーわけのわからぬ咽喉笛を鳴らす　　　×あれ塗りのはげた女の人形は念入りにこてこてご粉を塗りつけぎつくり。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁が妻水のうちよりもゆる火を見せ申さんとて、混堂のうしろに僅の山田ある所にいたり、田の水の中に少し湧ところあるにつけぎの火をかざししに、水中の火｜蝋燭のもゆるが如し。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "三束五束附木を並べたのを前に置いて、手を支いて、縺れ髪の頸清らかに、襟脚白く、女房がお辞儀をした、仰向けになって、踏反って、泣寐入りに寐入ったらしい嬰児が懐に、膝に縋って六歳ばかりの男の子が、指を銜えながら往来をきょろきょろと視める背後に、母親のその背に凭れかかって、四歳ぐらいなのがもう一人。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩が離れて、大な白足袋の色新しく、附木を売る女房のあわれな灯に近いたのは円髷で。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三味線弾きて折々わが門に来るもの、溝川に鰌を捕ふるもの、附木、草履など鬻ぎに来るものだちは、皆この児どもが母なり、父なり、祖母などなり。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若狹鰈――大すきですが、其が附木のやうに凍つて居ます――白子魚乾、切干大根の酢、椀はまた白子魚乾に、とろゝ昆布の吸もの――しかし、何となく可懷くつて涙ぐまるゝやうでした、何故ですか。",
              "citation": {
                "source": "雪靈續記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "端の歩が附木、お定りの奴で。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、匙は附木の燃さしである。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若狭鰈――大すきですが、それが附木のように凍っています――白子魚乾、切干大根の酢、椀はまた白子魚乾に、とろろ昆布の吸もの――しかし、何となく可懐くって涙ぐまるるようでした、なぜですか。",
              "citation": {
                "source": "雪霊続記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その松は、皮をむかれ、削られて建ったばかりの門の背骨のような附木となっていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「早附木を買いに入ったのかな。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　打見に何の仔細はなきが、物怖したらしい叔母の状を、たかだか例の毛虫だろう、と笑いながら言う顔を、情らしく熟と見て、「まあ、呑気らしい、早附木を取って上げたんじゃありませんか。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じゃ、早附木ではないんですか。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じゃあね、言いますけれど、銑さん、私がね、今、早附木を買いに入ると、誰も居ないのよ。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "早附木を下さいなッて、云ったけれど聞えません。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お婆さん、早附木を下さい、早附木を、といった、私の唇の動くのを、熟と視めていたッけがね。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（早附木よ、お婆さん。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
