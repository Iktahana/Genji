          "literary": [
            {
              "text": "四五日剃ッテイナイノデ顔ジュウ髯ダラケニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、昨日モ申シ上ゲタヨウニ博士ハ今マデニ何十人トナクコノ患者ヲ扱イ、コノ方法デ簡単ニ成功シテイルノデ、ソンナ神業ナンテ云ワレル程ノムズカシイモノトハ思ッテイナイ、患者モ格別不安ガッタリ恐レタリシタ者ハナカッタ、皆気軽ニ注射シテ貰イ、直グ良クナッテ大喜ビデ帰ッテ行ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰宅シテ見ルト、颯子ハマダ帰ッテイナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡庸ノ作家ノ技術デハ容易ニ出来ル仕事デハナイガ、予ハ不幸ニシテ彫刻家ニ一人ノ友人モ持ッテイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハ、アノイヤリングヤレースノ手袋ガ、和服デ着ケテイタ時ノヨウニハ似合ッテイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
