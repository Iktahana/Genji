    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "惚れた女の腹の中で、じたばたでんぐり返しを打って騒ぐ、噛み合う、掴み合う、引掻き合う。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "人と人とが血みどろになって掴み合うている。",
              "citation": {
                "source": "私を語る",
                "author": "――（消息に代えて）――",
                "note": "青空文庫"
              }
            },
            {
              "text": "探幽は顫える手に絵筆を取り上げて、画絹と掴み合うような意気込で、雲龍の図にとりかかりました。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭の中、眼の奥には、血潮の散乱と、剥き出した眼球、破れた着物、掴み合う手、その手の中の乱髪、刀、踏みにじられた草、折れた灌木――そんなものが、入り乱れていた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "撲る、蹴る、掴み合う！",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、いざ手取りにしようと掛って見ると、命がけで飛び懸って来た牙に捕えられて、思わず同じ係蹄に転り込んだ猟師が、泣きながら、叫喚びながら、獣と人間との血を混ぜ合わせて、掴み合う、食い合う、争闘する――その、自業自得を見ろ！",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "掴み合うたびごと、つき倒されるたびごと、ころがり廻るたびごとに、服も下着も引きちぎられ、今はもう身を蔽うものも残り少なくなっていた。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "槍闘、騎闘、肉闘、白刃戦、敵味方混み合って滅茶滅茶に血しおを浴び肉を掴みあう時でも、戦いは何も黙ってするものと極ってはいない。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっちで取っ組む、こっちで掴みあう。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
