          "literary": [
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ家ガ本所割下水ニアッタ時代デ、両国廣小路ノ、アレハ何ト云ッタッケナ、何トカ云ウ有名ナ絵草紙屋ノ店頭ニ助六ト意休ト揚巻ノ三枚続キノ錦絵ガ掲ゲテアッタノヲ今モ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨日ノ日曜日、二十四日ノ午過ギニ、颯子ガ洩ラシタ言葉ガアッタノヲ予ハ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ血相ガ変ッタノヲ見テ五子モ青クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
