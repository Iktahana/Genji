        "examples": {
          "standard": [
            {
              "text": "レジでお釣りの釣り銭を数え間違えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この店では、釣り銭のやり取りが丁寧だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "五千円の品物に一万円札で支払い、五千円の釣りをもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      },
