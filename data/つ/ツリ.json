    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "渝らぬ契りの誰れなれや千年の松風颯々として血汐は殘らぬ草葉の緑と枯れわたる霜の色かなしく照らし出だす月一片何の恨みや吊ふらん此處鴛鴦の塚の上に。",
              "citation": {
                "source": "別れ霜",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "想へ、流失する時劫と、闇黒と、物言はざる刹那との宙宇にありて、只一人吊されたる單位の恐怖をば、光の心靈の屍體をば。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側に吊した金魚鉢か何かのやうに、毀れ易く、庭の緑を映してゐるやうなものであつた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その松の樹には、今は亡き弟と或時叱られて吊り下げられたことがある。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」祖母は剃られて青白い、眉毛の跡を吊り上げて、その老眼鏡の上から覗くやうに言つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にしろ自分の考へたことは本当だと、悦びに吊られて思ひ込んだ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいかオイ……」と突然三田村はその重さうな頭をハネ上げて続きを始めるのだつた、「俺がついててやるから安心しいろい」「うん、うん」と私は相変らず吊り込まれて承知するのだつた。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速、焚火にかかって、徒渉に濡れた脚絆を乾すやら、大鍋を吊して湯を沸かしたりする。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄花石楠花が、岩角の間に小さくしがみついて咲いている、その間を踏んで、登れば、千枚沢岳と悪沢岳の間に、赤石山が吊鐘を伏せたように円く立っている、支脈伝いに背面を見た時には、壮大だと思った白河内岳も、ここから見ると、可愛そうなほど、低くなって、下に踞くまってしまった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "附近一帯の水涸れで、工面のいい家は、どん／＼井戸を掘り下げたり、水道を引いたりして、文字通り「涼しい顔」をしてゐられるのであるが、この埃の溜つた井戸の使用者は借家人であり、その家主は、前代は財布の紐で首でも吊つたんではないか、と疑はざるを得ない吝ん坊なのである。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ持って来て、手を縛って、梁へ吊しやがったな。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、網棚から兵児帯を吊して、首でも縊る時のように、輪の中へ顎を引っかけて、グウグウ眠っている男があった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "首っ吊りしてやがらあ。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さん、首っ吊りするって訳じゃねえだろうな」「うん」　少年は再び眼を瞑ろうとした。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」一人連れていてその癖、網棚から首なんぞ吊るしやがって、横柄な顔をして大鼾で寝てやがる。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一番いいのは、俺が首を吊ってしまうことだ！",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、首に綱をつけて吊り下すことはできた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の入ってる間に、一人首を吊って死んだ。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "――宇都の宮じゃないが、吊天井の下に誰か潜り込む奴があるかい。",
              "citation": {
                "source": "牢獄の半日",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしておけば、一々ハッパ押えを、断崖の下まで吹き飛ばされないで済むし、ハッパ穴が五六尺の高い段の上に穿られても、上からハッパ押えを吊るしておけるのだった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰を打たれた方はすぐ死んだらしいんです、だから、放水路を出外れた吊橋のところから、渦になっているでしょう。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子には頭じゅう繃帯したのや、手を肩から吊ったのだのが、二、三人かけて待っていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那に於いては棹の端に五色の糸をかけてお祭りをするのだそうであるが、日本では、藪から切って来たばかりの青い葉のついた竹に五色の紙を吊り下げて、それを門口に立てるのである。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一重瞼で、目尻が吊り上って、髪にパーマネントなどかけた事が無く、いつも強く、ひっつめ髪、とでもいうのかしら、そんな地味な髪形で、そうして、とても貧しい服装で、けれどもだらしない恰好ではなくて、いつもきちんと着附けて、清潔です。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなり大きな眼が、笑うとかえって眼尻が吊り上って、そうして針のように細くなって、歯がまっしろで、とても涼しく感ぜられる。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キヨ子さんといって、マア坊と同じくらいの年恰好で、痩せて、顔色の悪い、眼の吊り上ったおとなしい娘さんだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のあの鳥渡した動作が、どんなに大事件だったのか、だんだんはっきりわかって来て、あのとき、私のうちに毒薬があれば私は気楽に呑んだことでございましょうし、ちかくに竹藪でもあれば、私は平気で中へはいっていって首を吊ったことでございましょう。",
              "citation": {
                "source": "燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月、六月、七月、そろそろ藪蚊が出て来て病室に白い蚊帳を吊りはじめたころ、私は院長の指図で、千葉県船橋町に転地した。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校から歸るとすぐ、私は柔い着物と着換へ、端に小さい鉛筆をむすびつけた細い銀鎖を帶に吊りさげて芝居小屋へ走つた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "落第の懸念に苦しまされてゐた私は、その通告簿を片手に握つて、もう一方の手で靴を吊り下げたまま、裏の海岸まではだしで走つた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
