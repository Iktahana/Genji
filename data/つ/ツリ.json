  {
    "uuid": "753eb801-8e2d-57e0-ba6b-b3e16350b128",
    "entry": "吊",
    "reading": {
      "primary": "つり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
