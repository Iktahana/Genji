        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓外、庭ノ黒土ヲバサバサ這イズリマワッテイル醜キ秋ノ蝶ヲ見ル。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、工場ヤ、銀行ヤ、病院ヲ守ッテイルダケデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎が電報をうつと、スグコイマッテイルとの返事だったので、喜んで行こうとすると、君枝はもじもじしながら、「うちも一しょに行くわ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ゴロ愛惜シタ樹木ヤ草花ナドガ、イツトハナク落葉シテシマッテイル。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年ノ多クハ小サクサカシクオサマッテイルモノカ、ツマラナク時ヲ無為ニ送ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイ」‥‥山が地上から空にもれあがる‥‥それはすばらしい自然への肉迫を表現した言葉だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "告　皆サンモ知ッテイル通リ、本日何者カヾ当工場ニ「失業者大会」ノビラヲ撒イテ行キマシタ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月八日◯去ル五日ニ気ガ附イタコトデアルガ、イツノ間ニカ左眼ガワルクナッテイルノダ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワレワレ通信技術者ガワレワレノ組立テタ器械ニヨッテ放出シテイル通信用電波ノ外ニ此ノ空間ニハ現ニ多種多様ナ未知ノ電波ガ飛ビ交ッテイルノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアこれは一寸耳をこちらへ出して、ソコイラノ評論ヲ評論ト云イ得ルトハ思ッテ居リマセンガ、私ニハホントノ評論ヤソノ骨格ガワカッテイルカラケンソンスルノデス。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩一晩ダケデス、明日コノ川下ルト海ニ出マス、海ニ出ルトソノ黒船ガ待ッテイルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると女の子も引きつづいて、ヘービモムカデモドキアレオレハ鍛冶屋ノ嫁ドンダ槍モ刀モ持ッテイル　こうして一時に喚き出したかと思うと、その中から一人、火のつくように泣き出したのがあります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "助六ノ芝居ヲ知ッテイルノハ予ト婆サンダケ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンペラ門兵衛ハ特ニ浅草ノ宮戸座カラ中村勘五郎ガ買ワレテ来テ演ジタガ、コレガ妙ニ印象ニ残ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ図ラズモ予ノ希望ハ叶エラレタガ、首尾ヨク同衾シ、事ヲ行ウニ至ッテモ、普通ノ藝妓ト普通ノ方法デ行ッテイルノト異ルトコロハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "団子ノ治兵衛ハ如何ニモ一生懸命デ、全力ヲ盡シテイルコトハ認メラレルガ、餘リ一生懸命過ギ、緊張シ過ギテコチ／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ通リ」ト、予ハ持ッテイルスネークウッドノステッキノ石突ヲ示シ、「コヽントコロガ取レチマッタンダヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナノトテモ欲シインダケレド、オ高クッテ手ガ出ナイワ」ト、墺太利製ラシイベージュノスウェードノ、口金ニサファイヤノイミテーションラシイ石ガ這入ッテイルハンドバッグノ前デ、颯子ハ頻リニ嘆声ヲ発シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」颯子ノ前ニ鱧ガソックリ残ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ予ノタメニ腸ダケヲ残シテオクノガ習慣ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然彼女ノ専用ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東大梶浦内科ノ診断デハ、今日デハ脳中枢ノ病巣ハ殆ドヨクナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋子ト夏二ハ早速経助ノ部屋ヘ行ッテイル様子。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ト、清琴ノ声デ唄ッテイルノガ聞エテ来ルヨウナ、モウ死ンデイル筈ダガ、死ンデモ聞エテ来ルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
