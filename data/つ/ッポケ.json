        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「自分のようなチッポケな存在から凡てが理解されてしまうような世界では、その中に棲むことが何としても不安だ。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その又、総元締の配下になって御座る大元締というのが、やはり日本でも指折りの豪い人達ばっかりですが、その人達の手から爆弾村へ集まって来た爆薬が、チッポケな帆舟に乗って宇和島をまわって、周防灘から関門海峡をノホホンで通り抜けます。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百｜噸足らずのチッポケな船だったが、まるで見違えてしまっている上に、デッキの上は丸で宴会場だ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ふむ」と老人の嘲笑う声がまた室から聞こえて来たが、「何事も大仰なその方の事じゃ、獲物の価値も知れている」「さようなチッポケの獲物なんどで、何じょう殿を起こしましょうぞ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昼間の上海の大馬路や四馬路をご覧なさいまし、そりゃア迚も今夜のようなチッポケの人出じゃありません」　と野村氏は云った。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本には外国のような大建築もないが、またこんなチッポケな別荘もない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなチッポケな店でも、開店といえばエンギのものだぜ。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなチッポケな店へ数名は無茶だが、宿六は実際さう考へてをるので、なんでもかでもエロサービス、ついでに自分も数名から代りばんこにサービスを受けるつもりに相違なく、富子が出て行く方がまつたく万事宿六の方には都合がよい。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなチッポケなウチぢやア、置き場所の始末がつくかな。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔つ払ふと大はしやぎで、ふだんは蚊のなくやうな細い声しかでないくせに、こんなチッポケな痩身のどこからでると思ふやうな破れ鐘の声で応援団のやうに熱狂乱舞して合ひの手に胴間声にメッキのやうなツヤをかぶせて御婦人を讃美礼讃したり口説いたりする。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "三平は肉体も精神も脆弱で、痩せたチッポケな身体は婦女子の一突きによろける程であつたし、その精神は常に結論を見失つて迷路の中をあがいてゐた。",
              "citation": {
                "source": "朴水の婚礼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつたく彼が四十になつてもまだ生きてゐるのは不思議だといふ取沙汰であつたが、然し、彼のチッポケな肉体にも彼なみの烈々たる希望はあつたのである。",
              "citation": {
                "source": "朴水の婚礼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様ら、天下の車組の社長、車善八を、貴様ら如きチッポケな雑誌の社長に見立てゝ、オレが、そんなものに、なると思うか」「イヤ、社長、そうじゃないです。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小ッポケな自衛権など、全然無用の長物だ。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな小ッポケな工場を持ったおかげで、私なんか身動きができないから哀れですよ。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊東にはチッポケな家があるだけです。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊東市でこれ以上チッポケな湯殿はなかろうと思われるぐらい、洗い場もないほどのところだが、私にはこれ以上の広さも必要ではない。",
              "citation": {
                "source": "温浴",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラムネ玉ほどの小ッポケな奴が何百万円もするのだもの、この世に金の値打ほど不思議を働く物はないのさ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その六　血を見る真珠",
                "note": "青空文庫"
              }
            },
            {
              "text": "タナグ山は昔から何人かの信仰があったらしく、その麓には誰がたてたのか小ッポケながら鳥居があり、それが古くなると、いつのまにか誰かがたて代えて今につづいていた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩竈のチッポケな財産なんぞが消えてなくなったってタダみたいのものよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "つらつら悲劇のもとをもとむれば、チッポケなかびくさい系図にとらわれた氏族の罰さ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その九　覆面屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "小沼男爵というのはさる大名の末の分家、石高一万か二万の小ッポケナ小大名で、先祖代々の貧乏大名。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "御座敷女中入用のハリ紙をみてこの人が訪ねてくれた時にはトオサンもぼくもびっくりしたもので、「ハキダメへ鶴がおりるということは申しますが、こんなチッポケなうす汚い安料理屋へあなたのような人が働いたらおかしいや。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "といっても極めてチッポケな店で、ナワノレンに毛の生えた程度、その毛もなるべく過少に考えた方がマチガイが少いでしょう。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "チッポケな子供の声ぢやないか。",
              "citation": {
                "source": "群集の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤミ屋のチッポケな親分でも、一年のうちに繁華な中心街を建設し、葬式の無料奉仕だのリンタク奉仕を開業している有様だ。",
              "citation": {
                "source": "戦後合格者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷の五十鈴川上の猿田彦神社の如きもチッポケ千万なもの、大国主の大三輪神社その他諸国に数々の大神社、スサノオの八坂神社等々に比べて、神話中の立居振舞相当なるにも拘らず、後世のモテナシ、まことに哀れである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "安吾・伊勢神宮にゆく",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆半島の半分のミチノリもないチッポケな半島だが、往復八千円だ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京では、やせてチッポケな、ニセモノの秋田犬に横綱のようなシメナワを十字にキリリとかけて歩かせたりしているが、大館のホンモノの方には、十字のタスキをかけた犬など完全に一匹もいないのである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな田舎のチッポケな出来事貴方方には興味がないかも知れませんが、私は書く事に依っていい様のない憤りが静まる様な気がしたので書いて見ました。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その二　大岡越前守",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
