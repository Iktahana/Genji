        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "父は庭の柿の木に別の品種を接ぎ木して、二種類の味を楽しめるようにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このバラは病気に強い台木に、香りの良い品種を接ぎ木して育てられたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "農業高校の実習で、苗木をナイフで削って接ぎ木をする繊細な作業を学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「枝ぶり悪き桜木は、切って接ぎ木をいたさねば、太宰の家が立ちませぬ。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「枝ぶり悪き桜木は、切って接ぎ木をいたさねば、太宰の家が立ちませぬ」と、定高は凛とした声でいい放つ。",
              "citation": {
                "source": "島原の夢",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間の眼から見ればいわゆるぶらぶらしていたその頃の彼についてエマスンはこういっている、「彼は決して怠惰でも放縦でもなく、長期の職業にしばられるかわりに、金が入用になると、小舟や柵をつくること、植樹、接ぎ木、測量のような何か短期の肉体労働の仕事でそれを獲た。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "訳者の言葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の果樹園はかつてはブリスターズ丘の全体をおおうていたが、すでにずっと前からヤニマツに圧倒されてしまい、わずかにいくつかの根株があるだけで、その古根は今でも村で接ぎ木の野生の台木に倹約につかわれ、栄えている。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "政治家や耽美家や社会学者がそれに接ぎ木されることは、おかしな変形だと思っていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、ここに金を置いてゆきますから、このつぎきますまでに、そんなかわいそうなくまでない、もっと恐ろしい大ぐまをしとめて、きもをとっておいてください。",
              "citation": {
                "source": "猟師と薬屋の話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "とよに縫いもののつぎきれを出して座敷へ戻って来てみると、竹村があぐらをかいた膝の前に二つ折りにした盤をおいて、「何だって――ピヨン、ピヨン？",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひろ子といえども、裁縫で五円八十銭稼いだことはなかろう」　重吉は、「僕がやってやろう、見ていてごらん、うまいんだから」　袋をとって、ひっくりかえして、内側からつぎきれを当てて、縫い出した。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはこうしておくの」　その日の日づけをかいて、和裁工石田重吉記念作品と、つぎきれの上に書きつけた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひとりでに仕立台からおちるくずのつぎきれなぞは、ぬすむというほどのものではございません。",
              "citation": {
                "source": "天国へいった仕立屋さん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "接木をしたとかいう老桜よ、若返ってくれ。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "三階から二階へかけては、塔同様洋式建築のもありますけれども、接木の古株を見るように、むかし、うまや路で見かけたとでもいう青楼の、面影をいま茲に顧られるかのような店附を遺した家もございます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で動かさうと思つて動かしたのではないけれど、押石をとれば接木の枝が刎ねかへる様に、俺の感情も押石の理智が除かれたから、自ら刎ねかへつて、その恣な活動を起して来たのである。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度それは子孫の繁殖と自己の防禦との必要を全く忘れさせられた梨の接木が、大きな刺を幹にも枝にも持たなく成つたやうに、恐怖が彼等を去つたのである。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "源助さんは、啻に話巧者で愛想が好い許りでなく、葬式に行けば青や赤や金の紙で花を拵へて呉れるし、婚禮の時は村の人の誰も知らぬ「高砂」の謠をやる、加之何事にも器用な人で、割烹の心得もあれば、植木｜弄りも好き、義太夫と接木が巧者で、或時は白井樣の子供衆のために大奉八枚張の大｜紙鳶を拵へた事もあつた。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之何事にも器用な人で、割烹の心得もあれば、植木｜弄りも好き、義太夫と接木が巧者で、或時は白井様の子供衆のために、大奉八枚張の大紙鳶を拵へた事もあつた。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分も一緒に食ひながら、急に、接木をしたやうな親しみを皆に見せた。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは接木や挿木をくりかえして来た蜜柑には種子がなくなると同じである。",
              "citation": {
                "source": "最終戦争論",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の近代精神のより健やかなる展開のために先ず入用なのは、誤った技術家が非科学的に使う剪定鋏を引きこませること、及び悪条件にもちこたえつつ、どうやら命脈を保ちつづけて来た一条の民主的、合理的精神の幹に、全く科学的に考慮された接木をして、豊かな結実を可能にする方法ではなかろうか。",
              "citation": {
                "source": "よもの眺め",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恭一君は学問よりも実地がうまく、接木などでも彼がすると皆ついた。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん結婚という接木が不成功であることの証明された今、また自ら血が血をよんで自分は血族のうちに牽きつけられようとするのであろうか。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この広い世界にも、その林檎から接木した木は一本だってないだろうと思います。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "生活の接木などという変な言葉を俊彦は用いたが、そんな深い重大なことではなく、何かごく平凡な――常識的な事柄が、彼を支配してたのであって、それへ無理に理屈をつけたもののように、昌作には思えるのだった。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ではその桑の木の若芽を接木したと伝えられる老樹は庭の隅に枝をひろげて日蔭を作っている。",
              "citation": {
                "source": "シェイクスピアの郷里",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の俳句にも接木とか麦蒔とか人事句は沢山あるが、夫等は人間を配合した季題の面白味を主としたもので、之に反し近代的な日常生活を中心におき、其真を把握する事に努力して、季感は副の感がある。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり接木に健全な芽が生えてスクスク成長するはずのあるべきものじゃない。",
              "citation": {
                "source": "帝銀事件を論ず",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのクズレた甘さときては、全然不手際な接木のように、だしぬけに猫の鳴声のような甘え方を見せるのだ。",
              "citation": {
                "source": "三十歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "斉しく温州蜜柑を以てこれに接木したならば、ことごとく温州蜜柑の甘美な果実を結ぶ。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言すれば我が日本臣民中には、甚だ多くの接木されたる天孫民族が混在しているのである。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻さしあげた「民族と歴史」の中にも書いてあります通り、枳殻や、柚子や、橙や、いろいろの柑橘類が、みな温州蜜柑の接木によって、ことごとく温州蜜柑になってしまっているのです。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
