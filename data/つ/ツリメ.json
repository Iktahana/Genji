          ],
          "literary": [
            {
              "text": "笑より顰め面に變る表情のうつり目。",
              "citation": {
                "source": "三太郎の日記　第三",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだんに変化して行く心のうつり目が、かの前後の敵を一刀に斬り捨てたところに至って言句も思慮も及ばなくなりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "甲源一刀流の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで人ごとのようにわだかまりのないようすで、「目っつり目っつりと、やすやすいうてくれな。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            }
          ]
        }
