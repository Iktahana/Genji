        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大広間の酔ぱらつて居る家来も流石に王のこの様子に気づいたのか急にヒツソリとなつた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し謝源は少しも残念がる様子もなく或夜コツソリと一そうの小舟で首里からのがれて行つた。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜明方に起きて、一人でコツソリ山へ來て、大きな奴を採つたあとには落葉をかぶせて、根太を絶對に人には知られんやうにしておく。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼としては非常な大骨折で、僅か二三日の間に、げツソリ頬の肉が※けたと思はれるばかり體も疲れ心も勞れた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アノ　コヒツジハ　ウマサウダ」ト　イツテ、ヌスビトハ　ソノ　コヒツジヲ　コツソリ　ヌスンデ　フトコロニ　イレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に青年が人目を忍ぶやうに、品川からたゞ一人、コツソリと乗つたことが、美奈子の心を、可なり傷けた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "町の市場はヒツソリとして扉を閉ざし学校も休みになつた。",
              "citation": {
                "source": "不思議な船",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "青白い月光に、片頬丈ゲツソリとこけたのが、透き通る様に見える。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきから、開いたまゝの窓の処を見てゐると、ボヤツと見えるのは、今のゲツソリ頬のこけた人の顔だしかも半面鮮血淋漓、ゾツとして眼をしばたゝくと、窓は矢つ張りあいたまゝで、斜に、月の光が画の様。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の恰好と言ひ、身体の容子と言ひ――」　お節の若々しい快活な笑声と、子供等の騒ぎとでヒツソリとした家の中は急に賑かに成つた。",
              "citation": {
                "source": "出発",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしてムツソリーニに始められた全体主義は、ヒトラーによつてより巧みに利用され、日本等またこれに從つて國力の飛躍的發展をはかり、遂にデモクラシーによつて順調に進んでいる富裕なる先進國の支配力を破壞して世界制覇を志したのが、今次の大破局をもたらしたのである。",
              "citation": {
                "source": "新日本の進路",
                "author": "石原莞爾將軍の遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神主の社務所に眠る小春かな」といふやうなことを大きな聲でやりながら、願念寺はノツソリと私の邸の裏門から庭傳ひに、泉水の石橋を渡つてよくやつて來た。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒繻子の襟の中へ腮を埋めるやうにして、旦那の立つて行くのを見向きもしないでゐたお光は、旦那が直ぐ下駄を穿かずに長火鉢の前へ坐つたらしい氣色を知ると、俄に濟まぬやうな氣がして、自分も後からノツソリ立上つた。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノツソリと車室を出て來るところへ、自分がこの姿で駈け寄ると、別に會釋もしないで、「よく來られたね。",
              "citation": {
                "source": "兵隊の宿",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "前は青物屋である、市場の荷が未だ着かぬと見えて、店はヒツソリ寂れて居る。",
              "citation": {
                "source": "茗荷畠",
                "author": "眞山青果",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの機関車――３２７１号はムツソリニである。",
              "citation": {
                "source": "機関車を見ながら",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムツソリニの走る軌道は或は光に満ちてゐるであらう。",
              "citation": {
                "source": "機関車を見ながら",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしどの軌道もその最後に一度も機関車の通らない、さびた二三尺のあることを思へば、ムツソリニの一生も恐らくは我々の一生のやうに老いてはどうすることも出来ないかも知れない。",
              "citation": {
                "source": "機関車を見ながら",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあの逞しいムツソリニも一｜椀の「しるこ」を啜りながら、天下の大勢を考へてゐるのは兎に角想像するだけでも愉快であらう。",
              "citation": {
                "source": "しるこ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒステリツクになつたムツソリニは勿論国際的に危険である。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことをいふと古くさいと笑はれるかも知れないが、みじんまく――即ちおしやれは、人に知られず自分だけコツソリしてこそ引きたつ、同性だからかまはないといふのは違ひはしまいか。",
              "citation": {
                "source": "春",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "又　今日の支那の最大の悲劇は、無数の国家的｜羅曼主義者即ち「若き支那」の為に鉄の如き訓練を与へるに足る一人のムツソリニもゐないことである。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして後から後から三四人づゝゾロ／＼這入つて来て、何時の間にか、ヒツソリしてゐた控所の中は一杯になり腰掛には空きがなくなつた。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "控所の中は一時にヒツソリしてしまつた。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、最も極端なのは、世界の専制政治家を代表する三人、ムツソリーニ、ヒツトラー、スターリン、この三人は実に、写真を見ますと、或はその行動を見ますと、先づ第一に、名優だといふ印象を受けます。",
              "citation": {
                "source": "芝居と生活",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ今日はムチに見舞はれると思つたので、その時は両手で耳と頭を抱へて、力一ぱい喚き上げようと、みんなコツソリ相談し合ひました。",
              "citation": {
                "source": "先生と生徒",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウンと出した、パラリと出した、チヨツキリ切つて――」　すると、この騒ぎを聞きつけて、先生の奥さんがコツソリやつて来て、心配さうに止めるのです。",
              "citation": {
                "source": "先生と生徒",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯さへ憔悴した顔付きが、この数日間の不眠不休の看護のため怖い位にゲツソリと青ざめてゐる。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして、寝てゐた土方がノツソリ起きて、旅商人を見る。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土方はノツソリ歩き出して切符を買ひ、改札口を出て行く。",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
