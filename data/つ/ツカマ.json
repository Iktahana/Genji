          "literary": [
            {
              "text": "マモナクヨコハマジヤツクトイウワルモノニツカマツタ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弁吉はアツカマシイのよ。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他伊賀のアベ（阿拜）は「アハイ」となり信濃のツカマ（筑摩）は「チクマ」となつたやうな例はなほ若干ある。",
              "citation": {
                "source": "國語尊重",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            },
            {
              "text": "大ゲーテが『偉大の詩……は自己の力で出來たのではない、靈の惠である』とエツカマンとの對話中に曰ふ處と一致してゐる。",
              "citation": {
                "source": "新詩發生時代の思ひ出",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "画眉鳥が杉や川楊などの最上端にとまって、青い天地を眺めつつ啼く声まで、我々にはイッピツケイジョウツカマツリソロというように聴えた。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
