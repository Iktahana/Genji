        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オ父ッチャハ半トシモネテ、ウチノ中ニ何ンニモナクナッタトキニ死ンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度ソノ時下カラ人ノ来ル足音ガシタノデ、私ハイソイデ立チ上リ、ナイフデ死ノウカドウシヨウカト迷ッテ居タノデス、清三ハ未ダ死ニ切レナカッタト見エ又起キ上リカケマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰カ来テクレタ人ニ云ウヨウスデシテ、決シテ一郎トイウ名ヲタダヨンダノデハナカッタト思イマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、自分の原子ガ別ノモノニナッタトキ、自覚シナイカラツマラナイ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレハ明治三十年前後、十三四ノ頃ダッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ羽左衛門ノ助六ヲ見タ時ハ、意休ガ先代中車、揚巻ガヤハリ昔ノ福助、当時ノ歌右衛門ダッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ大役デモ大阪ノモノデナク、江戸ノモノヲ選ンダ方ガヨカッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜｜冷奴ヲ食ベ過ギタノガ悪カッタト見エテ夜半ヨリ苦シミ出シ二三度下痢スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時カラソウ云ウ傾向ガアッタトハ思ワナイガ、老年ニ及ンデダン／＼トコンナ工合ニナッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナマメカシイト云ッタライヽノカ、色ッポイト云ッタライヽノカ、己ハ今マデニアンナ妖艶ナ女ヲ見タコトガナイ、妖婦ト云ウノハ正シクアンナ女ノコトヲ云ウンダロウナ、アンナ女ニナラ殺サレタッテイヽト思ッタト、湿ノ父親ハイツモ忰ヲ掴マエテヨク／＼感ニ耐エタヨウニ云イ暮ラシタソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪イ習慣ヲツケテシマッタト、颯子ハ後悔シテイヤシナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盲人ハヤットアイスクリームヲ食ベ終ッタトコロデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、モシ予トオ静トガ打ツカラナカッタラ、予ニ知レタコトヲ彼等ハ気ヅカズニイタデアロウ、トスルト、オ静ガ予ト行キ遇ッタコトハ、マダシモ仕合セダッタト云エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハソウト、陸子ガ面白イコトヲ聞イテ来マシタンデ、オ爺チャンニモオ耳ニ入レテ置キタイト思イマシテネ」「アヽソウ」又何カイヤナコトヲ云イニ来ヤガッタト思ッテイルト、「オ爺チャン油谷サンヲ覚エテラッシャルデショウ」「ブラジルヘ行ッタ油谷ノコトカ」「アノ油谷サンノ息子サンヲ御存知？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人キリニナッタトコロデ、サテドンナ風ニ切リ出シタモンカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコト、子供ガ心配シナイデモイヽ、オ前モウ寝ル時間ジャナイカ」「僕寝テタンダヨ、内證デソット見ニ来タンダヨ」「オ休ミ、オ休ミ、子供ガ餘計ナ………」コヽマデ云ッタト思ッタラ、ドウシタ加減カ声ガ鼻ノ奥デ詰マッテ不意ニ涙ガパラ／＼ト落チタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カヨイ治療法ハナイモノデショウカ、御老人デイラッシャルノデ、牽引法ソノ他手数ノカヽル面倒ナ方法ハオイヤナンデスガ、ト云ッタトコロ、ソレニハ方法ガナイコトハナイト、博士ガ云ワレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツナサルノ」「病院ノ方ハイツデモイラッシャイト云ッテルンダ、ソウ決マッタラ早イ方ガイヽ、明日行ク」「マアオ待チナサイ、アナタハイツモ性急ナンダカラ」婆サンハ出テ行ッタト思ウト、高島易断ノ暦ヲ持ッテ戻ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ種類ノネックレスハ国産品ニモシバ／＼見受ケルガ、背後ノ後頭部ニ附イテイル留金ニイロ／＼ナ宝石ガ鏤メテアッテ、コノ真似ガ国産品デハ出来ナイノデアル）血壓ノ高イ時ハ頻尿ニナル癖ガアルガ、頻尿ニナッタト思ウト、逆ニソノタメニ一層血壓ガ上ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヽニ決メテヨカッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三時ニ住職カラ連絡ガアッタト見エテ石屋ノ主人ガ面会ニ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮リニ友人ガアッタトシテ、ソノ友人ガ優秀ナ技術ヲ具エテイタトシテモ、予ガ何ノ目的デ左様ナ製作ヲ依頼スルカヲ知ッタトシタラ、果シテ快クソレニ応ジテクレルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ僕ガ木村デアッタトシテ、ドッチニヨケイ惹キ付ケラレルカトイエバ、ソレハ、年ハ取ッテイルケレドモ母ノ方デアルヨリモ、僕自身ハドンナツモリナノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ、慾望ハ大イニアルノダガ、ソレヲ裏付ケル体力ガ缺ケテシマッタトイッタ方ガヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先夜以来、アノ場合ノ妻ノ態度ガニワカニ積極的ニナリ、種々ナル技術ヲ進ンデ弄ブヨウニナッタガ、今コソ彼女ニモ分ッタト思ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "揃イモ揃ッテ陰険ナノガ四人マデモ集ッタトハ呆レルホカハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
