        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノホカニモ水死人、サマザマノスガタデ考エテイルソウデス、白イ浴衣着タ叔父サンガ、フトコロニ石ヲ一杯イレテ、ヤハリ海ノ底、砂地ヘドッカトアグラカイテ威張ッテイタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソイデ、オ母ッチャノ方ニ手ヲノバシテヤッテ、ヨナカニコエヲ出スノガオッカナイノデ、ハジメダマッテユスッテイタガ、オ母ッチャハナカナカ目ヲサマサナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、シバラクダマッタママ、少シズツ大キクユスッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ青イカオヲシテ、ダマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ択バレタル霊魂ノ持主ハ、不運デモアッタガ、又、捉エラレルニ適シタホドノ脆弱性ト不安定トヲ持ッテイタ気ノ毒ナ人デアッタ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムモ　メリーサンモモトハ　ギンザノオミセデ　カッテイタダイタノデス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗イ土手ノ上カラ暗イ大川ノ水ヲ　ジット見テミンナデ　ジット　立ッテイタミンナ　何ントモ　口ヲキカン僕ワ　涙ガ出ソーニナッタ。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚巻ハ先代歌右衛門、ソノ時ハマダ福助ト云ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ彼ハ最後マデ男子デアルコトヲ相手ニ感ジサセズ、女性ニナリ切ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬘ヲツケタマヽ舟底形ノ枕ニ寝、暗イ部屋ノ褥ノ中デ、友禅ノ長襦袢ヲ着テノコトデハアルガ、実ニ異常ナ技巧ヲ持ッテイタモノデ、マコトニ不思議ナ経験デアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入梅中デ雨モ降ッテイタノニ、昨夜ハナカ／＼暑カッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紗ノ夏羽織ニポーラーノ単衣、絽ノ長襦袢ヲ着テ、シカモ左ノ手ニハ鼠ノ毛糸ノ手袋ヲ篏メ、白金懐炉ヲハンケチニ包ンデ握ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ニ行クホド暑クナリマス」正直ノトコロ、予ハ手ノ痛サニ閉口シテ晝ノ部ヲ見ルノハ止メヨウカト思ッテイタノダガ、婆サンニ窘メラレタノデ却ッテ依怙地ニナリ、痛イノヲ怺エテ明日ノ晝ニ又来ヨウカト思ッテイタノダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ陸子夫婦ニ子供ガ三人デ、狭過ギテ困ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ美シサニ於テＡヨリＢガ少シデモ劣ッテイタノデハイケナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ夏軽井沢ヘ行ッテイタ留守ニ寝室ト浴室ト便所トヲ作リ直サセタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ幸イニ一時快方ニ向ッテイタノダガ、昨夜ノ失敗デ又ブリ返シタヨウデアルカラ、当分用心シタ方ガイヽ、シノミンハ餘リ連用スルト副作用ガアルカラ一回四錠ズツ日ニ三回、三日以上ハ続ケナイデ下サイ、毎朝怠ラズ尿ノ検査ヲシ、雑菌ガアッタラ、ウバウルシヲオ飲ミナサイト云ワレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ日ハバーベキュー、昨日ハ病気デ静養中デアッタガ、ソノ間モ予ノ頭ニハ絶エズコノ言葉ガ引ッカヽッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ春久ガ夜間ハ忙シイケレドモ、晝間ハ自由ガ利クト語ッテイタコトガアルノヲ、聞キカジッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予ハ、彼等ノ結婚ヲ許シハシタモノヽ、ドウセ長クハ続クマイト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ一度測ラセテ戴キマス」結果ハ幸イニモ常態ニ戻ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻布ノ家ヲ新築シタト云ッタガ、タシカ明治年間政友会ノ長谷場純孝ノ邸宅ガアッタ辺ダトカ云イ、前カラ古イ屋敷ガ建ッテイタノデ、ソノ一部ヲ残シテ大部分ヲ改築シタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナコトヲ云ッテイタラ際限ガナイカラ、予ハ近々ニ婆サンニ無理ニ承諾サセテ壊シ屋ヲ入レヨウト思ッテイタノデアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ狙ッテイタ三百萬圓ハソノ金ノ一部ナノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人トモ妙ニ殺気ダッテ、颱風ナンカイクラデモ吹ケト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
