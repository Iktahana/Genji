        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "満鉄ヤ撫順ノタメニ諸君ノ暮シガチットデモラクニナッタカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（さうだとさ）（蜂雀かが弟なの）（さうだとさ　第一それは女学校だかどこだかの　おまへの本にあったんだぜ）（知らないわ）　　　さてもこんどは獅子独活の　　　月光いろの繖形花から　　　びろうどこがねが一聯隊　　　青ぞら高く舞ひ立ちます（まあ大きなバッタカップ！",
              "citation": {
                "source": "春と修羅　第二集",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ニヨリマストアタリノ山々ガ浮キアガッタカト思ワレルクライ空ガ美シイ時ガアリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………カッタカタア、カッタカタ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "又句読点もないのですが、わかり易い為普通の文にして読みます）問　ソウスルト被告ガ道子ヲ殺ス気ニナッタノハ、道子ガ他ノ男ニ心ヲ移スヨウニナッタカラカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　私ガ道子ヲ殺ス気ニナッタノハ、今マデ私ニ親切デアッタノニ心変リヲシテカラ全ク私ニ冷淡ニナリ、友田ヲ愛スルヨウニナッタカラデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　友田ハソノ頃便所ニ立ッタカモ知レヌト申シテ居ルガ、道子ト話ヲシタ事ハ全クナイト云ッテ居ルガ如何。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ馬鹿サンネ、私がアナタニ身ヲ任セタノハカラカッタカラダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　被告ハ道子ヲ何処デ殺スツモリダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　然ラバ、清三ガオキタラドウスル積リダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　如何イウ方法デ殺ス積リダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入レナイドコロカ、机ノ上ニデモアッタカ、ナイフヲイツノ間ニカ抜イテ、蒼白ニナッテフルエナガラ、突然私ニ斬リツケタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一）コノ荷物ノ中身ガ何デアッタカ誰ニモイウナ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お澄さんのうちから、オスミカエッタカと、電報あり。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "カッタカッタカッタ　これは製縄部の片隅にいる五十に近い或はそれ以上とも見える頬のこけた栄養不良の老女工の廻す車の音である。",
              "citation": {
                "source": "トンカトントンカッタカッタ",
                "author": "今野大力",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシタ方ガコノ老人ノ気ニ入ルコトヲ看テ取ッタカラデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツモ締マリガシテナイト云ッタカラ、ホントカドウカ試シテ見タノサ」云イナガラ予モ浴室ノ方ヘ首ダケ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ明治ノ何年頃デアッタカ幼少ノ時デ覚エガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠居所ナンカ作ルヨリコノ方ガドンナニヨカッタカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考エルトアノ奥サン大層オシャベリナ方ダッタカラ、ワザ／＼コレガ云イタクッテ寄ッタンジャナイカッテ、陸子ハ云ウンデスガネ」「コレトハ何サ」「マア、コレカラ先ハ陸子ニオ聞キニナッテ下サイ」安楽椅子ニ腰カケテイル予ノ面前ニ並ンデ立ッテイタ二人ハ、コヽデ「ドッコイショ」トソファニ腰ヲ据エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョウド自分ノ右隣ニイラシッタカラ、左ノ指ニ篏メテイラシッタノガハッキリ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年前マデハオ爺チャンモマダ足腰ガイクラカ達者グッタカラ、大キナ犬ニ飛ビ着カレテモ心配ナコトハナカッタガ、今日デハ事情ガ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピラビタール、イルガピリン、又シテモパロチン、イルガピリン座薬、ドリデン、プロバリン、ノクターン等々、服用シタ様々ノ薬ノ名ヲ佐々木ニ教エテ貰ッタガ、マダコノ外ニモアッタカ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ行ッテシマッテカラ一人デ静カニ考エテ見ルト、アンナニ怒ラナイデモヨカッタ、颯子ガ婆サンカラ聞イテドンナ風ニ取ッタカト、シキリニ気ニナッテ仕様ガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガコノ家ヲ訪ウノハコレデ二回目デアルト云ウガ、最初ニ訪ウタノハイツノコトデアッタカ殆ド記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "指環モ取リ換エテ、何ト思ッタカ問題ノキャッツアイヲ篏メテ来テイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタ一日デ、アタシヘト／＼ニナッチャッタカラ逃ゲ出シタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ彼女ノ捜索癖ヲ満足サセルタメデアッタカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
