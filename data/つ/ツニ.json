        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」『スズサン、リヨウジカンケイサツニコウリユウセラル、ドナタカスグゴライセイヲコウ――ハナカワヤ』「おや、すゞがあげられた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　メヲ　サマシテ　ヰマス」「アラ　アラ、ソレデハ　スグ　デテ　イラツシヤイ」　ヤガテ　ソノ　ツボミガ　フタツニ　ワレテ　ナカカラ　ナニカ　デテ　マヰリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニヨリモ、カラダヲ、タイセツニ、イノリマス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニヨリモ、カラダヲ、タイセツニ、イノル、フウトウ、イレテオキマス、ヘンジクダサイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケイサツニツゲタリ、コノハナカゴヲウゴカスト、スグバクハツサセマス、ワタクシタチノブカガ、イツモチャントミテイマス。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ムラオヲ、ジッケンシツニイレルナ。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの仰云った通りの文言の下にお名を入れ、つづけて「ゴアンチャクニテアンシンツカレオタイセツニ　ユリコ」として出しました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横でそれを受けとって、あけて、読みにくいローマ綴りの字を辿ると、そこには八ガツ一ヒタモツドゾウチカシツニテシスアトフミと一並び書いてあった。",
              "citation": {
                "source": "おもかげ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八ガツ一ヒタモツドゾウチカシツニテシスアトフミ。",
              "citation": {
                "source": "おもかげ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八ガツ一ヒタモツドゾウチカシツニテシス。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "八ガツ一ヒタモツドゾウチカシツニテシスという電文をよんで気を失いかけながら、伸子がくりかえして、よくって？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗟夫レ華族ヲシテ各其身ヲ愛セシメバ以テ家ヲ保ツニ足ル。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "老母一人、龍女、いもと両人、男の子一人、かつへ／＼ニて、どふもきのどくニて、龍女と十二歳ニなる妹と九ツニなる男子をもらい候て、十二歳の妹名きみへ、男子太一郎ハ摂州神戸海軍所の勝安房ニ頼ミたり。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハイツデモアツイソウデスガ、今年ハトクベツニアツクテ、三十五年カラナイホドダサウデス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジロウハ　ウミニ　ハイツテ　ブリキノバケツニ　ミヅヲ一パイ　クミマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界一の首飾りの玉の一つになるようなのを誰でも一ツニツは手に入れるのだから豪勢だ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その六　血を見る真珠",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ニモツニツキソッテイク、メイレイマツツゴウヨロシ、もう分ったろう。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ此性理ノ智ト云フ者ハ、概略右ノ如シト雖ドモ、又之ヲ再別シテ識ト才トノ二ツニ分ツナリ、識ト才トハ何人ニテモ兩ナガラ之ヲ具スト雖ドモ必ズ長短無キコト能ハズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナホ待ツニ賓師ノ礼ヲ以テシ三口糧ヲシテ経ヲ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「晴、四ツニ出ヅ、今日長崎譯官本木昌造、蒸汽船雛型持出シ御覽アリ。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはわからないが、翌年八月、その船が土佐へ無事着ス」そして同じ八月二十三日には「――四ツニ出、八ツニ退ク。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "一座に中国人の手品師がゐたが、しまひにこの中国生れの手品師までが同じく感嘆此を久しうして、「ジツニウマイ。",
              "citation": {
                "source": "落語家温泉録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ツ一ツニノツクヲシテ見ル。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其名の起源は知らないが、『信濃宝鑑』に「甲武信ヶ岳一ツニ拳ヶ岳トモ書ケリ」とあるのが真ならば、それは形から名付けたので、推察するに栃本の称呼であろう。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
