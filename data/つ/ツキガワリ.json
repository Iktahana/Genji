        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昭和二年からは、豊隆と自分とがひと月代わりに書くことになった。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和六年からは「曙町より」という見出しで、豊隆の「仙台より」と、やはりだいたいひと月代わりに書いて来た。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もしお母さんがよいよいになつたら、毎月代り番こでお母さんをおぶつて帝劇へ行くのだぞ。",
              "citation": {
                "source": "母たち",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど月代りの最後の日で、呉服橋からは、せんぶりの千太が高慢ちきな顔をして出張って来て、ひと目見るなり、こりゃア、虎列剌だ、まぎれはねえ、で引きとって行った。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "ねずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……明日から月代りで今日一日は暇。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "金鳳釵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
