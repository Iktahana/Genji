[
  {
    "uuid": "016180e4-9c49-5237-8fdf-26b696c42ae0",
    "entry": "突慳貪",
    "reading": {
      "primary": "つっけんどん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
