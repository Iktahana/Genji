    },
    "definitions": [
      {
        "index": 1,
        "gloss": "blunt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「関係ない」と突慳貪な返事が返ってきて、話しかけた側が困惑した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "窓口の担当者が突慳貪な態度で、客は気分を害した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は疲れているのか、いつもより突慳貪な口調で電話を切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "一見突慳貪にも見えるけれど、実は寧ろ気が弱い迄に見解の博い人である。",
              "citation": {
                "source": "萩原朔太郎評論集　無からの抗争",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "實際私は弟達に對して隨分突慳貪であつた。",
              "citation": {
                "source": "矛盾の樣な眞實",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何しに来たの」と母は突慳貪に一言。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆んな迷惑するだ」　いかにも突慳貪にその声はほざかれた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さ、早くお寢なさいまし」　さういふ突慳貪な聲を聞かされると、行夫はすつかり眼を覺してしまふだらう。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と船頭の武助さんは、突慳貪にいつた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と突慳貪なように云った。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中はつんとしたように皿を式台の上に置くと、「おたべよ」と突慳貪にいって、少し身を退き、立ったまま流しめに二人の方を見おろしていた。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（何や、）と一ツ突慳貪に云って睨みつけたが、低声で、若いのが何か口上を云うのを、フーフーと鼻で呼吸をしながら、目を瞑って、真仰向けに聞いたもんです。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　喜平は突慳貪に言って、冷めかけた紅茶をいっきに飲み干した。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに来て働く女中たちを一人一人｜突慳貪にきびしくたしなめた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "口が干上るんだあぞ俺がのは」　仁右衛門は突慳貪にこういい放った。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、妹は自身の膝を揃へながら、突慳貪に姉にいふ。",
              "citation": {
                "source": "姉妹",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間というものに愛想がつきたのです」　杜子春は不平そうな顔をしながら、突慳貪にこう言いました。",
              "citation": {
                "source": "杜子春",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お富の返事は突慳貪だつた。",
              "citation": {
                "source": "お富の貞操",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、品物を取り出すひまもなく、きっぱりと突慳貪に私は断られた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と検事は、それと創紋との間に起った矛盾に、愕然とした様子だったけれども、法水は依然熊城から眼を離さず、突慳貪に云い放った。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私、そんな事はてんで存じません」と普光尼は、いきなり突慳貪に云い放って、ふと首を向け変え夜具の襟に埋めてしまった。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　杜子春は不平さうな顔をしながら、突慳貪にかう言ひました。",
              "citation": {
                "source": "杜子春",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　素戔嗚はそろそろ焦れ出しながら、突慳貪に若者の請を却けた。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神田の方ですよ」いつもお竜ちゃんと仲の悪い佐吉が、私に代って突慳貪な返事をした。",
              "citation": {
                "source": "幼年時代",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の支那人のボオイを呼んで、朝飯はまだ食はせてくれるかと聞いたら、すこし怒つたやうな顏つきをして、朝食を食べるならもう少し早く起きてほしい、もう十二時だ、と下手糞な日本語で、それだけ一層さう見えるのかも知れないが、私にかなり突慳貪な返事をした。",
              "citation": {
                "source": "旅の繪",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　計算台を前にして腰掛けていた中老が突慳貪に訊き返えした。",
              "citation": {
                "source": "死の航海",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡そ現在の日本人ほど無愛想で、突慳貪で、人の気持を汲まず、大勢ゐるなかでその場を白けさせることの上手な人間はないと思ふくらゐです。",
              "citation": {
                "source": "勤労と文化",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばやさしい声、或いは突慳貪な声、甘ったれた声、悲しい声、そういう風に声と人間の感情を結びつけること、それからまた、その声の質にもっと人間の値打のようなものを結びつけることがあります。",
              "citation": {
                "source": "俳優倫理",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "らく　　さう突慳貪に云はないで下さいよ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「売つてやる」といふ調子の横柄さ、突慳貪な客扱ひは、流石に誰の眼にも余るとみえ、商人の自戒を求めたものと思はれますが、これなども、同胞に対する愛情がないとは云へないのでありまして、まさしく、他の感情のために、それが押しのけられ、客の方に通じなくなつてゐるのです。",
              "citation": {
                "source": "戦争と文化",
                "author": "――力としての文化　第三話",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は、いくぶん照れて、照れかくしに、わざと突慳貪な云ひ方で、母親の、台所へ瓦斯を止めに行くその背中へ浴せかける――「こら、新聞を早く持つてこい。",
              "citation": {
                "source": "青年の矜りと嗜み",
                "author": "――力としての文化　第四話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、つっけんどんにいって、とんとんと仕事をしていました。",
              "citation": {
                "source": "王さまと靴屋",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからあたしだって、おとうさまのことなんか、一度だって考えてあげたことなんかありやしないよ」　もしかしてこれで死んだって、二度とおとうさまのところへなぞ行く気はないと、母はつっけんどんに言いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
