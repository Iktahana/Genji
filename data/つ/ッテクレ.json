          "literary": [
            {
              "text": "ソシテ、タカ　ニ、ドウカ　アソコヘ　ツレテ　イッテクレ　ト、タノミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシキハソコノ人ガタクサンアツマッテ、ドウニカヤッテクレルコトニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二）コノ品物ハスグチャントシマッテクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談ニソンナコトヲ云ッタラ、オ望ミナラサセテアゲマスト云ッテクレタ或ル待合ノ女将ガイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オ前ガモ一度連レテッテクレルカ」「アタシガオ供スレバ見テ下サル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浄吉ナラ分ッテクレルワ」「マアイヽサ、ソンナコト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間モモウコウナッチャ哀レナモノサ」「自分ニ希望ガ持テナイカラ焼ケ糞気味ニナルノネ」「岡焼キ気味デモアルサ、不便ト思ッテクレ給エ」「巧ク云ッテルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「僕ニモ分ラン、僕ハアンマリ浄吉ノコトヲ考エナイヨウニシテイル」「アタシモソウナノ、聞イテモ彼ハ面倒臭ガッテホントノコトヲ云ッテクレナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ鏡ノ中ノ顔ガモット醜悪デアッテクレタラ、颯子ガ尚コノ上ニモ優秀ニ見エタヾロウニト残念ニ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "止メテ帰ッテクレ」予ハ出来得ル限リ声ヲ低メテ顫エテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ足ノ指ノ股マデモキレイニ拭イチテヤリ、「君、ソノ手ノ指ノ股ヲ拭イテヤッテクレタマエ」ト木村ニモ命ジタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ先刻カラ或ル計画ガ心ニ浮カビツツアッタノデ、内心ハ木村ガ帰ッテクレルガ今夜コソ実行デキルト思イ、ソノ期待デ興奮シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ガソコマデデ蹈ミトドマッテクレレバヨイガ、ソレ以上ノニナル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ十日マッテクレガマン」十二月六日　御返事を出そうとして、封筒に住所を書いたものの、三鷹からではいけないと思い、日曜日に、東京へ出て、そこから投函しようと思っていたら、亀島様がおみえになる。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミサオ、コノ敵ヲ討ッテクレ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
