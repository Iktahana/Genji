          "literary": [
            {
              "text": "お空のひかり、おてんとさまは、カンカンカン、月のあかりは、ツンツンツン、ほしのひかりの、ピッカリコ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オモチヤノ　オフネハツンツンツン。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツンツンツンとくる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツンツンツンとくれば、たしかにエビの口へ針がかかっているから、水ぎわをうまく引きあげる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを三本ほど並べて竿先を見ていると、ツンツンツンとあたりがあるのである。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
