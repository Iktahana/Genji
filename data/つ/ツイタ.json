        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "船司は、ハナシツイタ、ソウキンタノムと大阪の児子家へ電報打った。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フエフキハ、タカイ　トコロデ　ハタライテ　ヰル　ダイクノ　テニ　カナヅチガ　ニギラレテ　ヰルノニ、ハジメテ　キガ　ツイタヤウニ　オドロキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　コノ　ヒトハ　ニシノ　ハウニ　ムケテ　シユツパツイタシマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分ノ感ジデハ、此ノ空間ヲ往来シテイル電波ノ諸相ニツイテノ研究ハ、ホンノ手ガツイタバカリダト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大いにこれならよいと安心し、すぐ宮に　　イマツイタ、　チチウエ　オヨロコビ　ヨウス　ヨロシアンシン　二五ヒユリ　と打った。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆ンナオレガ悪イカラ起ッタコトダト気ガツイタ……も出来がいい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤントワンコチヤンノナキゴヱヲキイテ、オ母サンハ、キツト、ワンコチヤンガモンコチヤンニホエツイタノダラウトオモヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は身体の幅がバカに広くて、まるでツイタテのような大男だったから、胃袋の容積が超特別であることは想像できるが、一斗のんだかどうか私が見たわけではないから請合えない。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの正説があるに拘わらず更に唇形科の仏ノ座を春の七種の一ダとしてあるのを観ると、貝原先生もちとマゴツイタ所があることが看取せられる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マサカソレニハ及バンサ」「イヽワヨ、飲マセタゲルワヨ」彼女ガ薬ヲ取リニ出テ行ッタ間ニ、予ハ又一ツノ楽シミヲ考エツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ノ奴、返答ニ困ッテ嘘ヲツイタナ、ダガドコニイルンダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、後カラ考エルト、ソレハ浄吉ノ意志デハナク、颯子ガ夫ニセビリツイタ結果ナノデアッタガ、最初ハソウト気ガ付カナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気狂イノ真似ナンカシテルト今ニホントノ気狂イニナルワヨ」予ノ耳元ヘ口ヲ寄セテ、ヘンニ落チツイタ、冷笑ヲ含ンダ低イ声デ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今又チョット新タニ思イツイタコトモアルンデ、マアモウ二三日考エサシテ貰イマショウカナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ワレテ僕ハ直チニ一ツノ着想ヲ思イツイタガ、シカシ、僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハフト、芥川龍之介ノ書イタモノノ中ニ、中国ノ婦人ハ耳ノ肉ノ裏側ガ異様ニ色ガ白クテ美シイト云ッテイルノヲ読ンダヲ考エツイタノハ彼女自身ノ知慧デハアルマイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真デ思イツイタガ写真機ガ欲シクハナイデスカ、「パテエ・ベビイ」ハイカガ？",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ好イ加減キマリガツイタ時分ダト思ッテイタノニ、先達淡路カラ絵端書ヲ貰ッテマダソンナコトカト驚イタ次第デス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この游心帳は綴ぢも全き物、ひかた吹く花｜合歡の下もろこしのみやこのてぶりあが我鬼は立つ、あらぞめの合歡あらじか我鬼はわぶはららにうきてざればむ合歡、雨中湯ヶ原ニ來ル、道バタ赤クツイタ柿ニ歩イタ等の僕のものあり、次の游心帖大正十年秋湯河原ニテに連絡する物である。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
