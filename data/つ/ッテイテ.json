        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナルベク今ノ程度ニハ太ッテイテ貰イタイナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日ノ諍ガマダ頭ニ残ッテイテ、少シイツモヨリ萎ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸ハ締マッテイテ動カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキノ土蹈マズノ感触ガ、マダ唇ニ残ッテイテ忘レヨウトシテモ忘レラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツメタイ餘リ無感覚ニナッテイテ、ソレデイテ痛イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガ門ノ前ニ立ッテイテ、庭カラスグニ離レ座敷ヘ案内シ、「デハ私ハ留守番ニ行ッテイマス」ト云ッテ出テ行ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（脚ノ力モ弱ッテイテ歩キ過ギルトジキニ疲レル）………　………今日散歩カラ戻ッテ来ルト妻ガ洋裁ノ河合女史ト茶ノ間デ話シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階ヘ行ッテイテ下サイ」ト云ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
