        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "へんな形をしたラツパの口から音がきれぎれにもれるのである。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにへんな形をしたラツパといふのも、蓄音機の電気拡声器として、以前から使はれてゐたものである。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはラツパで聴くのでなく、受話機を耳に当てて聴くのである。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に悪い印象を受けたのは、拡声機のラツパで聴いた為であることが、ここに於て始めてわかつた。",
              "citation": {
                "source": "ラヂオ漫談",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」新兵「ラツパは何でありますか。",
              "citation": {
                "source": "詩の翻訳について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　とまれ不消化な複雑くらゐなら、馬鹿の朴訥の方がまだしもだと思ふと、暫時サツパリするだけでもましである。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから握手するか、ヒツパタクか、分つたものか。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生には今以て子供が出来ず、先生は夏はアツパツパーを着て読書をしたり午睡をしたりしてをられる。",
              "citation": {
                "source": "夏",
                "author": "〔私が貧乏で〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、頭を洗つてサツパリして理髮屋を出ると、近所の古本屋二軒で暫く隙を潰した。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、大正九年の秋、たま／＼ヨーロツパから歸つて來た親戚の人からイーストマンの葉書｜判の寫眞器をみやげにもらつた。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨオロツパでも警察力の完備した所と聞えたストツクホルム、當然喧々囂々たる非難の矢面に立つ責任者だつたから‥‥。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛騨は、手持ちぶさたげに床をスリツパでぱたぱたと叩いたりして、しばらく葉藏の枕元に立つてゐた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしヨーロツパにアレキサンドル大王といふ英雄があつた。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき一緒に、やさしい模樣のスリツパも買つて來た。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそのスリツパをはいて、二階の廊下を懷手して、ぶらぶら歩き、ときどき富士を不機嫌さうに眺めて、やがて部屋へはひつて、こたつにもぐつて、何もしない。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界的太宰治　ヨーロツパの近代人が書いた「キリスト傳」を二、三册讀んでみて、あまり感服できなかつた。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ・Ｍ・マリイといふ人は、ヨーロツパの一流の思想家の由であるが、その「キリスト傳」には、こと新しい發見も無い。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ちラツパを勇ましく吹き立てゝ車は傾斜を飛ぶやうに滑る。",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅かの假寢ではあるが、それでも氣分がサツパリして多少か元氣が附いたので懲ずまに義母に『横濱に寄らないだけ未だ可う御座いますね。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」明るくたのしくみんなの聲はひびき、みんなはそのそらの遠くから、つめたいそらの遠くから、すきとほつた何とも云へずさわやかなラツパの聲をききました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "發作のために醉がボツパツして、意識が朦朧となつてしまつてゐた。",
              "citation": {
                "source": "中央亭騷動事件（實録）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、私がキツパリと答へると、彼はポンと膝を叩いて『やあ、奇妙々々。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜活動写真を見る．鉱夫の二三人が手に手に持つたハツパを擲げつけると、鉄のやうな巌壁が粉韲せらる。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは誰も気にかけず、店を掃いたりしてゐたが、朝めしすこしすぎたころ、だんだんそれが近づいて、みんな立派なチヤルメラや、ラツパの音だとわかつてくると、町ぢゆうにはかにざわざわした。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてビルのフルーツパーラーへはいって片っ端から読んで行った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "堪らず袖を巻いて唇を蔽ひながら、勢ひ釵とともに、やゝ白やかな手の伸びるのが、雪白なる鵞鳥の七宝の瓔珞を掛けた風情なのを、無性髯で、チユツパと啜込むやうに、坊主は犬蹲に成つて、頤でうけて、どろりと嘗め込む。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "金色夜叉中編のお宮は、この姿で、雪見燈籠を小楯に、寒ざきつゝじの茂みに裾を隱して立つのだから――庭に、築山がかりの景色はあるが、燈籠がないからと、故らに据ゑさせて、右の裝ひでスリツパで芝生を踏んで、秋空を高く睫毛に澄して、やがて雪見燈籠の笠の上にくづほれた。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の大ザツパで、ゾンザイであるのをば、斥けねばならぬのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の時は、鞠が有れば鞠投げ、羽子が有れば羽子突き、駈けツ競や、飛びツ競のやうな單純な事をしても、心が其の事イツパイ、其の事が心イツパイで、そして嬉々洋々として、遊技もすれば、學問もしたのが、誰しもの實際である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
