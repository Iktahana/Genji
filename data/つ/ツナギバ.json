        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六十の馬｜繋ぎ場を急設する。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手には馬繋ぎ場も出来ている。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬繋ぎ場のわきで立ちどまった彼は、振り分け荷を土塀の下の草の上において、袴の股立ちをおろした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、たくさんな幕と乱軍の営内では、どこが敵の馬繋ぎ場か、ちょっと見当もつかないのである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉次は、鳥居わきの駒つなぎ場に近いところに土下座していた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "清左衛門は従者をよび、泊るときめて、馬のつなぎ場を、於通へたずね、自身も旅装など解きはじめる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
