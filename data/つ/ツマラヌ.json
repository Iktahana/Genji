    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ツマラヌ取次ハスルモノデナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハナントナクコンナツマラヌモノヲあなたニ見テモラウノガハズカシイノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一向ツマラヌ芸無し猿じゃ」と自分でも云うて御座る。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、それが威張れば威張るほどツマラヌ奴に見えて来るし、栄耀をすればする程、自分の恥を晒すことになるものですが、不思議なことに、ドンナに身分不相応な事でも、天子様と、神様と、親様の御為にする事なら、決して恥かしくないことがわかりました。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この逸話の載った当日の新聞を読んだ時、誰が書いたか知らぬがツマラヌ事を書いたもんだと窃に鴎外の誤解を恐れた。",
              "citation": {
                "source": "鴎外博士の追憶",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、二葉亭の交際した或る文人が或る雑誌に頼まれて寄稿した小説が頗る意に満たないツマラヌ作であるを頻りに慚愧しながらも、原稿料を請取ると大いに満足して直ぐ何処へか旅行しようと得意になる心のさもしさを賤んじて日記に罵っている。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時分私の親類の或るものが『書生気質』を揃えて買って置きたいからって私に買ってくれといった時、私はあんなツマラヌものはおよしなさい、アレよりは円朝の『牡丹燈籠』の方が面白いからといって代りに『牡丹燈籠』を買ってやった事がある。",
              "citation": {
                "source": "明治の文学の開拓者",
                "author": "――坪内逍遥――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな想いなどは想像もつかなかったが、私は難なく忘れて口にした験しもなかったのに、ツマラヌ連想から不意とその時、人の名前というほどの意味もなく、その文字面を思い浮べたらしかったのである。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな想ひなどは想像もつかなかつたが、私は難なく忘れて口にした験もなかつたのに、ツマラヌ連想から不意とその時、人の名前といふほどの意味もなく、その文字面を思ひ浮べたらしかつたのである。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の卯之吉が小麦｜蒔くのがツマラヌでも無い。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の卯之吉が小麦蒔くのがツマラヌでも無い。",
              "citation": {
                "source": "地蔵尊",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち私は、「私小説」の本体たる「私」が、如何にツマラヌ、平凡な人間であつても、いゝと極言したい。",
              "citation": {
                "source": "「私」小説と「心境」小説",
                "author": "久米正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、彼等は昔ながらの、いわゆる政治をやっておるにすぎず政治家の手腕だなどとツマラヌことを今もって考えている。",
              "citation": {
                "source": "坂口流の将棋観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はカナヅカイも漢字もろくに知らない不勉強者だから、さういふツマラヌ心労や不満がよく分るのだが、委員諸家は学者方だから不勉強者の心事など御存知ないに相違ない。",
              "citation": {
                "source": "新カナヅカヒの問題",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、一般の作家、学者の方々も秀才に相違ないから、僕の不満反感に同情がないかも知れぬが、僕はどうも、「やう」だか「よう」だか、「ふ」だか「う」だか、「え」だか「ゑ」だか、そんな心労が全然ムダ、ツマラヌものに思はれてたまらない。",
              "citation": {
                "source": "新カナヅカヒの問題",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "このマニフェストというのはコケオドシの実にツマラヌものであった。",
              "citation": {
                "source": "安吾巷談",
                "author": "教祖展覧会",
                "note": "青空文庫"
              }
            },
            {
              "text": "女というものはツマラヌ人間である、ぼくがこう判断したのがマチガイかどうか、ひとつ聴いていただきたいものですよ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ何かツマラヌことをやりだすと今度はそれにかかりきるという妙なことになってしまう。",
              "citation": {
                "source": "人生三つの愉しみ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、おそろしくツマラヌ小説を書く。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "男と女が顔を揃えて酒をのみながら、あられもない、文学だの芸術だのとツマラヌ話をしているから、尊公らの作品はいつまで経っても青ッポイのさ。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　海老塚は、何をツマラヌことを、という顔付で、それでも返事だけはした。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、内海殺しの夜は、なんでもないツマラヌことがキッカケで、あの物凄い格闘となった。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
