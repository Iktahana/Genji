          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日同じことの繰り返しで、詰まらぬ日々を淡々と過ごしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "そんな詰まらぬ演説を延々と聞かされる身にもなってほしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この本には、人生における詰まらぬ理屈ばかりが書かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "どう云ふ人か私は知りませぬし、あの人の説を批評するのでも反駁するのでもありませぬが、先刻から同じ事に就いて色々考へて見ましたから、詰まらぬ事を話します。",
              "citation": {
                "source": "混沌",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の恋人ののろけ話と、自分の子供の自慢話と、（もう一つ、昨夜見た夢の話と）――当人には面白かろうが、他人にとって之くらい詰まらぬ莫迦げたものがあるだろうか？",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って三五屋という名前は大阪では一廉の大商人で通っていたが、長崎では詰まらぬ商人宿に燻ぶっている狐鼠狐鼠仲買に過ぎなかった。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーナーヴォン卿その株を睹由来を聴いて、英人なら謝恩のためこの樹を保存すべきに葡人はこれを伐った、所｜異れば品異るも甚だし、以後ここの人がどんな難に遇うを見ても我は救わじ、救うて御礼に殺されちゃ詰まらぬと評したとある。",
              "citation": {
                "source": "十二支考",
                "author": "兎に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『おれは猿になりたい』と、詰まらぬ因襲と制度とから、切腹を命じられた武士は思わなかっただろうか。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "賢いくせに、詰まらぬところに力こぶを入れたり、どんな劣等動物でもしないような詰まらないことを、人間の特徴と誇りながらしたりする動物だろう、人間ってものは。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし搾ろうとするならば、搾られる者が「何か」――それはきわめて詰まらぬことでいい、二と二とを加えると四となるということでも――知っているということは、それより悪いことを、搾るものが見つけるのが困難であろう。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "一二一一年頃ジャーヴェ筆『皇上消閑録』を見ると、その頃既に仏国でも、竜は詰まらぬ河童様の怪魅と為りおり、専ら水中に住み、人に化けて市へ出るが別に害をなさず、婦女童児水浴びるを覗い、金環金盃に化けて浮くを採りに懸るところを引き入れて自分の妻に侍せしむとあり。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "知れ切った道理を述べた詰まらぬ話のようだが、わが邦近来何かにつけて、こんな遣り方が少ないらしくないから、二千五百年前のイソップに生まれ還った気になり、馬譚を仮りて諷し置く。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さほど知れ切った事でも黙っていては顕われず、空しく欧米人をして発見発見と鼻を高からしめ、その後に瞠若たりでは詰まらぬ。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間に尤不思議なようで実はこの通り詰まらぬ事が多い。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "予欧州にあった日、大高名の学者と伴れて停車場へ急ぐ途中種々の事を問い試むるにその返答は実に詰まらぬものばかりだった。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏典にはこれを一女の故を以て十八｜※（今の計え方で百八十億）の大衆を殺した喧嘩ばかり書いた詰まらぬ物と貶し、『六度集経』にも羅摩を釈尊、私陀をその妻｜瞿夷、ハヌマンの本尊帝釈を釈尊の後釜に坐るべき未来の仏｜弥勒としながら羅摩、私陀等の名を一切抹殺して単に大国王、その妃などといい居る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔人多からざりし世に猴ばかり住んだ地方ありしは疑いなく、さてタイラーも言ったごとく、未開時代には猴を豪い者とし、人を詰まらぬ者とし過ぐる事多かったに付けて、かく他の諸動物に勝れて多勢で威を振うを見て、その地の所有権は猴にあるごとく認めたのだ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればゲーテはいかな詰まらぬ事をも十分に文想を振うて至極面白く詠んだとショッペンハウエルは讃めたと記憶する。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "第六十二回　毒蜘蛛　今考えて見ると彼の絵姿を貼ってあった所は元の戸口で有ったけれど、其の戸がなくなったので板を填めそうして壁の色の違うのを隠す為に詰まらぬ絵を貼り、旁々外から内の様子を窺く便利に供して置いたのだ。",
              "citation": {
                "source": "幽霊塔",
                "author": "黒岩涙香",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども今になって、詰まらぬことは申しますまい。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はたといどんな詰まらぬ句であっても一句でもそれを棄てるに忍びない。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、悲の翼は己の体に触れたのに、己の不性なために悲の代に詰まらぬ不愉快が出来たのだ。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな詰まらぬ喜でも、どんな詰らぬ歎でも、己は真から喜んで真から歎いて見る積りだ。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に草原を物狂わしく走っていた間感じていた、旨く復讐をし遂げたという喜も、次第に詰まらぬものになって来た。",
              "citation": {
                "source": "女の決闘",
                "author": "オイレンベルク　Herbert Eulenberg",
                "note": "青空文庫"
              }
            },
            {
              "text": "息は詰まらぬが、元気も無い。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "心を澄ませ月を観想していたのに、詰まらぬことを言って、驚かしくださいますな。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼盛　詰まらぬものに邪魔だてされて、興も醒めてしまったわ。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "千鳥には、知らぬ人とは口をきいてはなりませぬと、かねて戒められておったのに、平家と聞いて我を忘れて詰まらぬ言葉をつい出してしもうた。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな詰まらぬ事にもせよ、此流義で為遂げる。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外国の方だから、自分でやってみんと気が済まんと見えるね」　と医者は詰まらぬことを感心して、クックッと鶏みたいな笑い声を挙げたが、「やはり、熱はないな。",
              "citation": {
                "source": "葛根湯",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "而もあの老人がそう云う災厄を蒙むるに至ったのは、平中が時平に詰まらぬおしゃべりをしたからなのである。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角貴下のような方とお近づきになったのを喜んでいたのに、こんな詰まらぬことからお附合いが出来なくなってはこの上もない損失であるから。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……対象の知れぬ寂しみ神様はつまらぬものゝみをつくつた盥の底の残り水古いゴムマリ十能が棄てられました雀の声は何といふ生唾液だ！",
              "citation": {
                "source": "（ツツケンドンに）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
