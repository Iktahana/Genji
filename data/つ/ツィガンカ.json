        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五六人の労働者と、子供をかかえた一人のツィガンカがやはりアーチの下へ雨宿りに来た。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツィガンカは裸足で、赤い更紗の重くひろい裾を蹴るように歩き、一人一人の労働者の前に手を出した。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気違いみたいなお天気じゃないの」　ツィガンカが、目さとく彼女を見つけ、そばへよって来た。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「｜可愛いお方、｜占いしましょう、｜たった十カペイキ、｜占いさせて下さい」　アンナ・リヴォーヴナは手提袋をあけ、三カペイキの銅貨をツィガンカの黒い、爪だけ白い手の平にのせた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツィガンカはおじぎし、アーチの端へ去った。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はツィガンカに一ぺんも物乞いをされたことがなかった。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
