    "definitions": [
      {
        "index": 1,
        "gloss": "to catch",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園で逃げ出したインコを、網を使ってようやく捕まえることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「泥棒！誰かあの人を捕まえて！」という叫び声が響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夏休みの宿題のために、裏山で大きなカブトムシを捕まえるのに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、一人をも本当の奴を捕まえることが出来なかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃げだすパルチザンを捕まえるためだ。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕まえる腕前はソッチのもの。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日幸子さんは、どう云うものか、ひどくヒステリックになっていて、あのきりぎしの上で僕が幸子さんを捕まえると、幸子さんは泣きながら、僕に一緒に死んでくれと云いました。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様は何だ」「おれはこの町の喧嘩の大将だが、今貴様のうちにヒョロ長い女がまん丸い男をおぶって逃げ込んだから捕まえに来たんだ」「何だってその夫婦を捕まえるんだ」「その夫婦は奇妙な姿で屋根から屋根へ飛び渡って町中を騒がしたんだ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこかその辺の開墾場へ逃げ込んだに相違ねえから、開墾地のだれかが森谷家への貸し分の代わりに捕まえるだろうから。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナリアの籠が窓に下がっていたから、目的は鳥を捕まえることだったのだろう。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私はヘビトリと呼んでいて、このテディはそれはもう素早くコブラを捕まえる。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「殺人犯を捕まえるのが遅れたら、新たなる凶行の機会を与えることになる。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし捕まえるものがないから、しだいしだいに水に近づいて来る。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "オシャベリ姫はあんまりの恐ろしさに気絶してしまいましたが、蜘蛛の方は姫を捕まえると、そのまま沢山の糸を出して姫をグルグル巻きにして、鉄の塔の隅っ子の方へ仕舞いまして、自分は又入り口のところへ来てグルグルまわっているうちに、網をもとの通りにすっかり張り直してしまいました。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それによると、私が非常に追及されていること、ロイド眼鏡をかけていることさえも知られていること、それからあんな奴は少し金さえかければ直ぐ捕まえる事が出来ると云っているから充分に注意して欲しいとあった。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、おそらく、君の腕じゃ俺を捕まえることはむずかしかろう」「何？",
              "citation": {
                "source": "深夜の電話",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで犯人を捕まえるのですから、うっかり他人に話してはいけませんよ。",
              "citation": {
                "source": "髭の謎",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それッ」と俊夫君が指をさしだしたので、私は躍りかかって書生を捕まえると、彼は死に物狂いで抵抗しました。",
              "citation": {
                "source": "髭の謎",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「三万円渡しておいて、安心させてから捕まえるんだ」「もうその計画は立っているかい？",
              "citation": {
                "source": "塵埃は語る",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯人を科学的な方法で捕まえるのも科学探偵中の重要な部分です。",
              "citation": {
                "source": "白痴の知恵",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「このあいだの夜、ここへ来た泥棒を捕まえるのさ」「え？",
              "citation": {
                "source": "頭蓋骨の秘密",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、捕まえるまで待ってください。",
              "citation": {
                "source": "現場の写真",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "つよい――心も、或は慾情も――男が彼女を捕まえる。",
              "citation": {
                "source": "一九二五年より一九二七年一月まで",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうするとアトはその犯人を捕まえるダケですね」「そうだよ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れから脇屋を捕まえると同時に家捜しをして、そうしてその儘当人は伝馬町に入牢を申付けられ、何かタワイもない吟味の末、牢中で切腹を申付られた。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ときに、君はこのドド氏をどこで獲ったのだね」「場所ですか」とカークは思わせぶったようにすぐには答えず、まず、ドドを捕まえるにいたった一仍始終を語りはじめた。",
              "citation": {
                "source": "人外魔境",
                "author": "有尾人",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰でもやって来た者は、直ぐ捕まえるようにという命令で。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とかして、あれを捕まえる方法はありませんか。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙の中にいる姿の見えない人を捕まえるのですから、それこそまったく雲をつかむようなものでした。",
              "citation": {
                "source": "お山の爺さん",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ朝から晩まで出歩いているから滅多に捕まえる事が出来ない。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二匹居るうちの黄色い方の痩せっぽちの男猫が、他には何の能もない代りに蛾をつかまえることだけに妙を得ている。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが困った事にはそういう罪人をつかまえる為政者の方でもちゃんとそれを承知しているから、あらかじめ犬の糞を用意しておいて、すぐにそれを食わせ、そうしてすっかり毒を吐き出させてしまう。",
              "citation": {
                "source": "マルコポロから",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを猟師がつかまえるのだという。",
              "citation": {
                "source": "マルコポロから",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
