        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "近所の人を捕まえては、孫の自慢話ばかりしているおばあさん。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おい、そこな若者を捕まえて道を聞いてみようじゃないか」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はすれ違う知人を捕まえて、今夜のパーティーの誘いをかけていた。",
