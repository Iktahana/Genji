        "examples": {
          "standard": [
            {
              "text": "崖から落ちそうになった彼の腕を、間一髪のところで捕まえることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "混雑した電車の中で、よろけないように吊り革をしっかりと捕まえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おい、ちょっと待てよ」と、逃げようとする少年の襟首を捕まえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
