          "literary": [
            {
              "text": "問　友田ハソノ頃便所ニ立ッタカモ知レヌト申シテ居ルガ、道子ト話ヲシタ事ハ全クナイト云ッテ居ルガ如何。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ彼女ノ捜索癖ヲ満足サセルタメデアッタカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日、七日ノ晩ニ僕ハスデニ木村ニ対シ淡イ嫉妬（淡クモナカッタカモ知レナイ）ヲ感ジツツアッタノニ、―――イヤソウデハナイ、ソレハ去年ノ暮アタリカラダッタ、―――ソノ半面、僕ハソノ嫉妬ヲ密カニ享楽シツツアッタ、ト云エナイダロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "敏子ガイテクレルダカラソレモ計算済ミダッタカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
