        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スープは栄養よりもアッペタイトを刺戟するのでよいのだそうだけれども。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白いものね、この間割合ひどい病気して、そのために感覚的にそういう感じがわかるようになって来て、そのアッペタイトのようなものはああ仕事したいという欲望に結びついて、何か活気ある情感を漲らします。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッペタイトがおこらない。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソプラノ嬢はハヤテの如く襲いかゝって、千鳥波の鼻、口、ホッペタのあたりをつかんで、肉をむしりあげる。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕頭に侍り、カナダライに氷をいれ、タオルをしぼり、五分間おきに余のホッペタにのせかえてくれたり。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、あなたの頬ッペタを、ちょッと突ッついてみたいね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは頬ッペタを突ッつきたいんだ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "べつに頬ッペタを突ッつかなくとも出すんだとさ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "南洋の観音様は、こッちの方から頬ッペタを突ッついてあげて、コンニチハの挨拶がわりにしたいんだなア。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "キッピイは睨みつけて、「じゃア、私の頬ッペタ、突ッついてごらんよ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふだんと、まるで人相がちがって、赤いホッペタの童女が、怒って、白くなったように見えた。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男、時はもう明治十八九年という開化の時世であるが、酔っぱらうと、泉山虎之介タチバナの時安と見得を切って女中のホッペタをなめたがる悪癖がある。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメエに似ているという話だ」「メッソウもない」「婦人の首ッ玉にかじりついて頬ッペタをなめるものだから、神楽坂は夜の八時から婦人の通行がないそうな。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガマ六のヤブニラミといえば泣く子もだまるほどニラミのきいたものだが、その目玉の片方はとびだしてホッペタにぶら下っているし、片目はなくなっている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            },
            {
              "text": "起きねとシッペタへ真ッ赤の釜のシッペタくッつけてやるろ」　シッペタはお尻のことである。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "花天狗流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャベだのアンニャだのシッペタだのゲェルマッチョ（蛙のこと）などという下賤な言葉は禁止される。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "花天狗流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "二ツの目の上やホッペタにゴツゴツとコブのある顔だ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛騨・高山の抹殺――中部の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいから、ホッペタとホッペタ。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほれ、ホッペタを食べてやりなさい。",
              "citation": {
                "source": "桜の森の満開の下",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねエ、ちょいと」　と、アタピンに頬ッペタをつつかれて、八丁鼻はグニャグニャする。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オメサマ、敵のタマが尻ッペタから前の方へぬけたもんでは、恥なもんだガネ」「キサマ、主人を慾タカリのイクジナシと言ったな」「言うたもんだ。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ僕ナンカ哀レナモンサ」「又頬ッペタヲ打タレナイヨウニ気ヲ付ケテ頂戴」「ゴマカシッコナシニシヨウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
