        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "〕湖上ポッカリ月が出ましたら、舟を浮べて出掛けませう。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポッカリ月が出ましたら、舟を浮べて出掛けませう、波はヒタヒタ打つでせう、風も少しはあるでせう。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのきんとんには、サッカリンが多分に入っていることを、私は知っていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにそれは、この闇の中に、ボンヤリすわって時々、「シッカリしないか」とだけ怒鳴る船長の、利己心からのみ起こった一切だ、という感じが、いつのまにか、闇が産みつけでもしたように、二人の胸の中に食い入っていたのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「スッカリ忘れてた」「まだ忘れてるよ」三上は押っかぶせるようにいった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウッカリするとウォーニンのあおりを食って、海へ飛んで行かねばならなかった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボースンは落ちて来た煙火の人形のように、ガッカリしていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーイ長までも、ウッカリほほえんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "南半球の星を、何年間かアフリカの希望峰植民地に行きまして、スッカリ図に載せましたゆえに、今日の天文学者の知識はハーシェルによってドレだけ利益を得たか知れない。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず嫌疑者の両の手に器械の電極をシッカリ握らせておいて、色々の問を掛ける、そのうちにギックリ胸にこたえる事があると器械の鏡から反射する光線がピクリと動く。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "車屋のばあさんなどは「もうスッカリ御全快だそうで」と、ひとりできめてしまって、そっとふところから勘定書きを出して「どうもたいへんに、お早く御全快で」と言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人から、うしろ指一本さされない態の、意志に拠るチャッカリ性。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、俗にいうチャッカリ性でした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリコフでの国際革命作家拡大プレナムの決議は日本のプロレタリア文学運動が、シッカリと大衆の中に根を張り、国際的な連関において前進して行くために、もっとも重要な、さしあたって第一番に議題として我々が討議し、具体化しなければならない幾多の貴重な提案をなしている。",
              "citation": {
                "source": "農民文学の問題",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロレタリア文学運動は、ゼイタクな菓子を食う少数階級でなく、一切のパンにも事欠いて飢え、かつ、闘争している労働者農民大衆の中にシッカリとした基礎を置き、しかも国境にも、海にも山にも妨げられず、国際的に結びつき、発展して行く。",
              "citation": {
                "source": "農民文学の問題",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い封蝋細工のほほの木の芽が、風に吹かれてピッカリピッカリと光り、林の中の雪には藍色の木の影がいちめん網になって落ちて日光のあたる所には銀の百合が咲いたやうに見えました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お空のひかり、おてんとさまは、カンカンカン、月のあかりは、ツンツンツン、ほしのひかりの、ピッカリコ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い封蝋細工のほおの木の芽が、風に吹かれてピッカリピッカリと光り、林の中の雪には藍色の木の影がいちめん網になって落ちて日光のあたる所には銀の百合が咲いたように見えました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨水を含んでいる岩角はウッカリすると墜落して手も足もかけることが出来ぬ。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲巌寺へはズット後戻りして、細い道を右へ曲って行かねば駄目だ」と、悉しく道を教えられて有難いやらガッカリやら。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "初め雲巌寺まで二里と聴いた水車小屋からは、二里は愚か無駄足をして既に四、五里は来たのに、この先まだ二里半あるとはガッカリガッカリ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はみなチャッカリしてるが、しかし君みたいに、徹底したのはおらんな。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなチャッカリした女にも、一つだけ抜けたところがある。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまに珈琲も飲む」「砂糖がよく廻るね」「闇屋が持って来るんだが、ない時はサッカリンを使う」「煙草に砂糖、高いものばかしだ。",
              "citation": {
                "source": "鬼",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズルチン呆けしたかな」ズルチンはサッカリンより甘いが、脳に悪影響があるからやめろと、最近友人の医者から聴いていた。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
