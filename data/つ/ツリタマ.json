        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わずかに五十｜対ばかりの列めぐりおわるとき、妃は冠のしるしつきたる椅子に倚りて、公使の夫人たちをそばにおらせたまえば、国王向いの座敷なるかるた卓のかたへうつりたまいぬ。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "また伊迦賀色許男の命に仰せて、天の八十平瓮七を作り、天つ神｜地つ祇の社を定めまつりたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また宇陀の墨坂八の神に、赤色の楯矛を祭り九、また大坂の神一〇に、墨色の楯矛を祭り、また坂の御尾の神、河の瀬の神までに、悉に遺忘ることなく幣帛まつりたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に佐佐宜の王は、伊勢の神宮をいつきまつりたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
