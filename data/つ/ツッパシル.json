        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は夢の実現のために、脇目も振らずに突っ走ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若さゆえの情熱で、彼は目標に向かって一直線に突っ走っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仕事に突っ走りすぎて、体調を崩してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
