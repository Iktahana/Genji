[
  {
    "uuid": "bf640dad-89f7-5753-be0e-cba2102e09c4",
    "entry": "使いで",
    "reading": {
      "primary": "つかいで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
