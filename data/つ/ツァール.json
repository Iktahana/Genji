        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "共産、過激、虚無、その他あらゆる強烈な思想が、宣伝ビラや小冊子となって、欧州大戦の裡面を波打ち流れた――ツァールの帝国主義、カイゼルの軍国主義と戦った――そうして遂に大勝利を博した事を知っている。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "多恨の詩人肌から亡朝の末路に薤露の悲歌を手向けたろうが、ツァールの悲惨な運命を哀哭するには余りに深くロマーノフの罪悪史を知り過ぎていた。",
              "citation": {
                "source": "二葉亭追録",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一次大戦終結の前後、ロシアの人民が悪夢のようなツァールの政権をとりのぞいて、世界にはじめて社会主義の社会を出発させ、他の多くの国々でも封建の要素のつよい王権を排除した。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月革命によってツァールは倒れた。",
              "citation": {
                "source": "十月革命と婦人の解放",
                "author": "野呂栄太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジョアジーの支配が維持された限り、ツァールは倒れてもツァーリズムの暴虐は跡を絶たなかった。",
              "citation": {
                "source": "十月革命と婦人の解放",
                "author": "野呂栄太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュウイツァールの男がクルシュクールもってそっと歩いて行く。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえってシュウェイツァール〔守衛〕で鍵をうけとるとザピースカ〔書きつけ〕がついて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "【補遺】モスクワにて二月五日（日曜）　夜、シュウェイツァールのカーキ色の男が、部屋に入って来て、孤児のためのМ・Х・А・Тの慈善芝居の切符を当選した人には二枚上げる。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "М・Х・А・Т 第二はミチキノ・ツァールストヴォでも目立って変なギゴチなさがいつもついてまわってる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツァールスコエ・セロー（皇帝村）とよばれていたその離宮村は、その後デーツコエ・セロー（子供の村）と改称され、格別そこに子供のための施設ができているわけではなかったが、レーニングラード近郊の遊園地になっていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山と兵隊はあんまり調和しないが、二部で唱ってるのが、聞いていても気持ちがいい、ハイドゥンを生みモツァールトを生んだ国は、兵隊さんの軍歌まで違うと、一寸感心しながら山を下る。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "認識論上の絶対真理の主張（機械論的・形而上学的・形式論理的・認識論のもの）は、つまり法皇やツァールの真理の権威を擁護することに他ならないわけだ。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "法皇やツァールの真理はそういう神聖な「絶対」真理であり、即ち虚偽を蔽い匿すために神聖というベールをかけた、まやかし物に他ならない。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマ法皇もツァールも、メッテルニヒもギゾウも、フランスの急進黨もドイツの探偵も。",
              "citation": {
                "source": "共産黨宣言",
                "author": "カール・マルクス",
                "note": "青空文庫"
              }
            },
            {
              "text": "シューベルトやモツァールトを聴いてそれが銭形平次に通じてゆくということは誰も考えないだろうと思う。",
              "citation": {
                "source": "平次と生きた二十七年",
                "author": "――筆を折るの弁――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
