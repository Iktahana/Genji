          "literary": [
            {
              "text": "アハハハハハ」　彼の素ットンキョウな笑いは止るところがなくなったようである。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "待人を迎へる顔付なども、田舎の人のスットンキョウな喜びやうもしてゐなければ、都会風に無理をしたお愛想笑ひもしてゐない。",
              "citation": {
                "source": "盗まれた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "変なことをしてるな、とみてゐると、急にそのお友達が、スットンキョウな声をあげて、「あ、あゝ、みえる／＼」といつた。",
              "citation": {
                "source": "ハナとタマシヒ",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
