        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いきなり、死んだはずのエ・ツーカ・シューが、むっくと起きあがった。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "動いているだが、エ・ツーカ・シューは死んでいるだ」という。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "エ・ツーカ・シューは、これから『｜冥路の国』へ召されるところだから。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "死骸になってから行かされるなんて、おいらの種族はなんて手間が掛るだべえ」　とみる間に、エ・ツーカ・シューがのっしのっしと歩きはじめた。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "エ・ツーカ・シューは死体のまま橇を駆り、晦冥の吹雪をつき氷の涯へと呑まれたのだ。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親が調子をとつて小槌を振りあげ、蹄鉄を続け打ちにした後に、そら来たツーカーンと金床を打ち鳴らすと、大上段に振り翳されて合図を待つてゐた八重の槌が火花の中に振り落された。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "テニス式にアンツーカ野球場というのは滑りこみが出来なくてダメであろうが、だいたいに於て夜になると風がなぐような形勢であるから、いずれは夜間野球ということを主として考えるのがよろしいように思った。",
              "citation": {
                "source": "神経衰弱的野球美学論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "マツーカ、なんて発音する人もいて。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "話しぶりでツーカーの間だ。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            }
          ]
        }
