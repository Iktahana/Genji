          "literary": [
            {
              "text": "蓋しＫ・フィッシャーやツェラーやＥ・エルトマン等によれば、哲学は体系としては破産したのであって、ただ歴史としてのみ成り立つことが出来る。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "その流れを汲むツェラーによれば、ソクラテスは初めて哲学を概念の上に基礎づけ、理論的論理学の原理を発見した。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「聖パウロの聖劇楽」に於て我等の指揮者カール・ツェラーンは、「高きにいます神へ」の合唱の際、或る分節にある気持のいい最終音調を予期して、必ず特別に活発になる。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
