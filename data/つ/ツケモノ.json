    "definitions": [
      {
        "index": 1,
        "gloss": "tsukemono (pickled vegetables)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ご飯のお供に、美味しい漬物が欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母が作った手作りの漬物は、格別の味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "日本の食卓には、様々な種類の漬物が並ぶ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "食事も米の飯に味噌汁、野菜の漬物や煮魚を食い、夜は二三合の日本酒を晩酌にたしなんだ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（金は憲坊に頼みました）先づ平野屋のいもぼうの缶詰（ッてのがあるそうです）黒のとろろこぶ、花かつを、懐中じるこ、甘酒の素、なるせの漬物とほーじ茶。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "炊事場は、古い腐った漬物の臭いがした。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何年来食ったことのなかった漬物などを、ばりばり音を立てて食うことが出来る。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには豚の脂肪や、キャベツや、焦げたパン、腐敗した漬物の臭いなどが、まざり合って、充満していた。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして脂肪や、焦げパンや、腐った漬物の悪臭が、また新しく皆の鼻孔を刺戟した。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "莞爾として聞きながら、よし／＼其もよし、蒲鉾は旅店の口取でお知己、烏賊の鹽辛は節季をかけて漬物屋のびらで知る通、外郎は小本、物語で懇意なるべし。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれのは漬物だよ。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前のうちじゃ蕈の漬物なんか喰べないだろうから茶いろのを持って行った方がいいやな。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にせよ恵比寿講の帳合いと言うたなら、一文二文の間違いにも青筋を立てて算盤を弾き合うような吝垂れた金持連中の寄合の事で御座いますけに仮令、仕事が夜通しがかりになったにしても、出て来るものは漬物にお茶か、せいぜい握飯ぐらいで、それでもペコペコと頭を下げてお礼を言うて帰るのが普通で御座います。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹行李が二つ、柳行李が一つ、漬物樽が一つ、ストーヴが一つ、大きな風呂敷包が一つ、書棚が一つ、それ等がごつたに折り重なつた上に、簡單な机が仰向けに積んであつた。",
              "citation": {
                "source": "半日",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻は正午間近なので、朝飯の不足に腹が減って堪らず、ここは掛茶家ではないが、一同は御免｜候えと腰を下し、何か食う物は無いかと聴くと、何も食う物は無いが、焼酎に漬物位なら有るという。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「焼酎でも結構結構」と、焼酎五、六合に胡瓜の漬物を出して貰い、まだ一缶残っておった牛肉の缶詰を切って、上戸は焼酎をグビリグビリ、下戸は仕方がないので、牛肉ムシャムシャ、胡瓜パクパク。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "漬物は五、六杯お代りをすれば、もう一家中にあるだけ尽く平げてしまったので、今度は生の胡瓜に塩をつけて丸噛り。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前のうちぢゃ蕈の漬物なんか喰べないだらうから茶いろのを持って行った方がいゝやな。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから家の漬物はさっぱり気が無いの、土用｜越の沢庵、至って塩の辛きやつで黙らそうとは圧が強い。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "漬物と冷飯だけのひどい夕飯を情なくたべながら、「脱走」ときめた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやく近頃になって漬物はうまいなあとしみじみ味うている。",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい女房は亭主の膳にうまい漬物を絶やさない。",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は断言しよう、まずい漬物を食べさせる彼女は必らずよくない妻君だ！",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "山のもの海のもの、どんな御馳走があっても、最後の点睛はおいしい漬物の一皿でなければならない。",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "漬物の味が解らないかぎり、彼は全き日本人ではあり得ないと思う。",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまた私は考える、――漬物と俳句との間には一味相通ずるところの或る物があることを。",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "△漬物は日本人にはなくてはならぬ食物である、私は今日、大根を間引いて漬けた、明日は食べられる、おいしからうぞ。",
              "citation": {
                "source": "行乞記",
                "author": "伊佐行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食（味噌汁、漬物）宿の前にある水は自慢の水だけあつてうまかつた、つめたすぎないで、何ともいへない味はひがあつた、むろん二度も三度も腹いつぱい飲んだ。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎年旅館は決まっていて、六月の半ば過ぎになると、早くも幾梱かの荷物が出入りの若衆の手で荷造りされ、漬物桶を担ぎ出さないばかりの用意周到さで同勢上野へ繰り出すのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの袋戸棚から竈の下とその向う側、洗面所の上下の袋戸、物置の炭俵や漬物桶の間、湯殿と台所との間の壁の厚さ、女中部屋の空っぽの押入れ、天井裏にかけた提灯箱なぞいうものを、妻木君は如何にも慣れた手付きで調べて見せたが何一つ怪しいところはなかった。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "無茶先生は、睡っているヒョロ子と豚吉を二人共丸｜裸体にして、手は手、足は足、首は首、胴は胴に鋸でゴシゴシ引き切って、塩をふりかけて、傍にある空樽の中へ漬物のように押しこんでいます。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその美しい青年は、この二つのかなり性質のちがつた證言の間に、幾分、ワトオの「うつけもの」と題せられた繪に見るごとき均衡のうちに立つてゐるのである。",
              "citation": {
                "source": "モオリス・ド・ゲラン",
                "author": "「そしてこの稀有で、偉大で、しかも果敢ないもの、一個の詩人」",
                "note": "青空文庫"
              }
            },
            {
              "text": "「のはらのまん中の　めつけもの　すっこんすっこの　栃だんご　栃のだんごは　　　結構だが　となりにいからだ　ふんながす　青じろ番兵は　　　気にかがる。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
