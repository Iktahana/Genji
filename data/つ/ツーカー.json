    "definitions": [
      {
        "index": 1,
        "gloss": "quick to take a hint",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
