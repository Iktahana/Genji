        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年連れ添った夫婦は、言葉がなくてもツーカーで意思疎通ができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あの件、例の場所で」「了解」という短いやり取りだけで済むツーカーな間柄。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "仕事のパートナーとはツーカーの呼吸で、アイコンタクト一つで次の段取りがわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "父親が調子をとつて小槌を振りあげ、蹄鉄を続け打ちにした後に、そら来たツーカーンと金床を打ち鳴らすと、大上段に振り翳されて合図を待つてゐた八重の槌が火花の中に振り落された。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "話しぶりでツーカーの間だ。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
