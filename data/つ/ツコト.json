          "literary": [
            {
              "text": "トロツコトロツコ坑の奥、一ぱい積んでよろけてる。",
              "citation": {
                "source": "カンテラ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ事実ガ右ノ調和ウンヌンニ深イ関係ヲ持ツコトハイウマデモナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ他日本文化ノ普及ニ役立ツコトハ非常ナモノデアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋シ、僧侶ハ祈祷ヲ商ヒ、権力ニ媚ブルコトヲ職トスル階級ニシテ、彼等ノ信仰自由ニ同情ヲ持ツコトヲ知ラズ、コレヲ圧迫スルヲノミ職トスルモノナリケレバナラン。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ知ノ元質ハ過去ノ經驗ニ則リ、勉メテ現在ニ善源因ヲ施シ、惡源因ヲ避ケ、而テ未來ニ於テ善結果ヲ招キ、惡結果ヲ絶ツコトニ外ナラズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯薬ヲ絶ツコト一日ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナニナロウト思ッテ、バーレッスンヲ一二年受ケタコトガアルノデ、チョットグライ立ツコトハ立テタンデスガ、サア今デモ立テルカ知ラ」ッテ、ソンナ話ヲシタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
