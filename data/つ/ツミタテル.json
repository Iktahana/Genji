[
  {
    "uuid": "5bdd5f0d-b1cf-5119-85dc-9dedc201b5cc",
    "entry": "積み立てる",
    "reading": {
      "primary": "つみたてる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
