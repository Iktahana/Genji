    "definitions": [
      {
        "index": 1,
        "gloss": "dance done by two persons or more",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
