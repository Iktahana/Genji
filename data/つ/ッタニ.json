        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ冬ノ寒イ日デ、羽左衛門ハ熱ガ四十度近クモアッタニ拘ラズ、ブルブル震エナガラ水入リヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウ云ウモンカステッキノ石突ハメッタニ長持チシナイモンダネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノ運転デハ危ナガッテ家ノ者ハメッタニ乗ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "可ナリ激シクテモソノタメニ寝ラレナイト云ウコトハメッタニナイノニ、昨夜ハ夜中ニ眼ガ覚メ、耐エ難イノデ佐々木ヲ起シ、ノブロンヲ注射シテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "用ガナケレバメッタニ出テ来ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレマデノ間ニ、恐ラク予ガ治療ヲ済マス以前ニ、二階ノ客ハ帰ッテ行ッタニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「仮リニ君ガ―――仮リニダヨ、―――春久トドウ云ウコトガアッタニシタッテ、僕ハソレヲ取リ上ゲル気ハナインダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ラク二人ノ結婚ハ成立シナカッタニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエ別ニ………」「ソウカイ、子供達モ大層元気ラシカッタネ」「有難ウゴザイマス、オ蔭様デ今年モ大喜ビデ」「不断メッタニ見ナイセイカ、三人トモ見違エルホド大キクナッタネ」コヽデ婆サンガ口ヲ挟ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城山家ハモト吉田山ニ住ンデオリ、当時ハシバ／＼来往シタ覚エガアルガ、主人桑造ノ死後遺族ガコヽニ移ッテカラハメッタニ訪ネナイヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故桑造在世中モ夫婦デ旅行シタコトナドハメッタニナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハマタ僕ガ足ノ fetishist デアルヲ知ッテイナガラ、イヤ知ッテイルガユエニ、メッタニソノ足ヲ僕ニ見セヨウトシナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テープノ寸法モ測ッテアッタニ違イナイト思ウガ、ウッカリ丸メテシマッタノデ調ベルハ書カナイデオイテクレ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ夕食時ニ妻ガ留守ノハメッタニナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
