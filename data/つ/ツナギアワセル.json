        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "木の板をつなぎ合わせてテーブルを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "破れたシートをつなぎ合わせて応急処置をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "複数の映像クリップをつなぎ合わせて動画を完成させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "映画の編集過程　たくさんな陰画の堆積の中から有効なものを選び出してそれをいかにつなぎ合わせるかがいわゆるモンタージュの仕事である。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "田を踏みにじられた隣りの農場の小作が、壊れた瀬戸物でもつなぎ合わせるように、田の中に入って行って、倒れた稲を起しにかかった。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはすべての材料をひとつにつなぎ合わせる触媒のようなものだ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていっさいがっさいを、マスタード・マヨネーズがつなぎ合わせる。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭の中で切れている糸の一筋をもつなぎあわせることはできなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてのフィルムを何度繰り返してどうつなぎあわせるかを、僕が最終的に決定した頃に、エマニュエルがいなくなった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
