          "literary": [
            {
              "text": "子息ハ宥免ノツモリデヰマシタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アンマリ、カワイカツタノデ、マダ　ダツコシテル　ツモリデ　カヘツテ　キタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　寝室ニイッテ殺スツモリデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ、道子ヲ殺シタ後清三ガオキタラ、罪ヲスッカリ自白シテ自殺シヨウト思ッテ居タノデスガ、然シ清三ノ態度如何ニ依ッテハ之ヲ殺スツモリデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行デ借リルツモリデアルガ、差当リソノ利息ダケ二萬圓ホド助ケテモラエマイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンナツモリデ今夜モ木村ヲ引キ留メタノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マゼクルノデハ無クテ、オサメルツモリデショウ」「親子トモドモ、若松港ノガンジャワイ」トイッタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
