        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カタツムリガ　ツノヲ　フツテルノヲ　ミテ　ヰルト、王サマハ、子ドモノ　ジブン、何ダカ、カタツムリノ　ウタヲ　ヨク　ウタツタ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イハサクの神からイハヅツノヲの神まで岩石の神靈。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "その劒の先についた血が清らかな巖に走りついて出現した神の名は、イハサクの神、次にネサクの神、次にイハヅツノヲの神であります。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでお斬りになつた劒の名はアメノヲハバリといい、またの名はイツノヲハバリともいいます。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に水底でお洗いになつた時にあらわれた神はソコツワタツミの神とソコヅツノヲの命、海中でお洗いになつた時にあらわれた神はナカツワタツミの神とナカヅツノヲの命、水面でお洗いになつた時にあらわれた神はウハツワタツミの神とウハヅツノヲの命です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、ソコヅツノヲの命・ナカヅツノヲの命・ウハヅツノヲの命｜御三方は住吉神社の三座の神樣であります。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またソコツツノヲ・ナカツツノヲ・ウハツツノヲの三神だ。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
