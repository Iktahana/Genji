        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タッテヤルトイウナラ、余ハ世界人類ノ不幸ヲ救ウタメ、カワッテソノ暴挙ヲ思イトドマラスデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はカゼがなおって遊びに来て、「アッコオバチャン、おぽんぽが痛くなくなったらアボチャン、トシマエンヘツレテッテヤルヨ」と大いに慰めてくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ノタメニカルダンノ絹ノネッカチーフヲ買ッテヤル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ成立シタバカリデナク、母ノ忰デアル予ガ孫ノ嫁ノ魅力ニ溺レ、彼女ニペッティングヲ許シテ貰イ、ソノ代償ニ三百萬圓ヲ投ジテ猫眼石ヲ買ッテヤルナンテ事件ガアッタラ、母ハ驚イテ気絶スルダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭ニプールガアッタライヽナッテ云ッテタカラ、先ズプールヲ作ッテヤルカナ、ソウシタラドンナニ喜ブダロウナ」婆サンハ何モ云ワナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様ノ顔ハ見ルノモ癪ダカラ、附イテ来ルナラ別ノ箱ニ乗レト云ッテヤル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
