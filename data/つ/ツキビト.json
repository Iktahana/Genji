[
  {
    "uuid": "afb64cd5-eb39-5008-b31c-1c090bc9f32c",
    "entry": "付き人",
    "reading": {
      "primary": "つきびと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "assistant (esp. in show business or sumo)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大物俳優の付き人として、撮影現場での身の回りのお世話から運転までこなす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「いつか自分も主役を張るんだ」と、付き人の青年は厳しい修行に耐えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "相撲界では、関取一人に対して数人の若い衆が付き人として仕える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "じつは、そのお姫さまのお付き人の――」「えッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そなたの付き人の痛みが引いたら明日にでもこの地を立ち去り、西方の鄙の地にでも落ちていくがよい。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "付き人のミリアムは対照的だった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "付き人が欲しいですね。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "付き人ですら暇を与え、その口実というのが国家行事で夜も遅くなったから早く休みたい。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔日本球根商会が〕日本球根商会が、　　　　　　　よきものなりと販りこせば、いたつきびとは窓ごとに、　　　春きたらばとねがひけり。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、万一の御用意を」「だが、引き移るのはいやだよ」「それならば、、お付人として、手の利いたものを詰めさせる儀は」「うむ。",
              "citation": {
                "source": "吉良上野の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "南玉と、庄吉は、付人じゃ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "接待係――（胸に徽章をつけている）あとは三人の被害者と、東山さんと、あなたがたお二人とで、ちょうど受付人員九百三十四名と数はあっております。",
              "citation": {
                "source": "探偵戯曲　仮面の男",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼びにやった同じく上杉家付人、目付役、清水一角が、ぬっとはいってくるのを見上げて、書きものをしていた経机を、膝から抜くようにして、わきへ置いた。",
              "citation": {
                "source": "口笛を吹く武士",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "飾窓へやっと一つ着付人形を買う――あの時分の楽しかったこと……その時分からエーゴルはマンドリンが上手くてね、町で評判だった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、狐狸のこと　付人狐、犬神のこと。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二段　狐狸のこと　付人狐、犬神のこと　わが国の怪談中、最も民間に普及しておるものは狐狸の怪談である。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるひはまた、これも家が始終忙しい為めにコドモは邪魔であるから、毎晩のやうに、義太夫席の新柳亭であるとかまたは色ものの立花家へ付人をつけて寄席にやられてゐました。",
              "citation": {
                "source": "私のこと",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はすでに借財を背負い、貸付人たちはようやくつむじを曲げようとするころだった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしこそは、なにをかくしましょう、故勝頼公のわすれがたみ、武田伊那丸君の付人、恵林寺の禅僧加賀見忍剣ともうしますもの」「じぶんは、おなじく伊那丸さまの微臣、木隠龍太郎という者」「拙者は、山県蔦之助です」　礼にたいしては礼をもって酬う。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その伊那丸さまのお年ごろは」「天目山にて、お父上とともにお果てあそばした太郎信勝さまよりお一つ下――本年お十六｜歳にわたらせられる」「して、お付人は？",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このうえは、いっこくもはやく、あの垢離堂から社家へおうつし申しあげ、また、付人の忍剣とやらの神縛もといて謝罪するよりほかに手段はなかろう」　いつまで応接のないのはそのためであった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして縷々と、李逵の帰郷のいきさつを語り、また朱貴が梁山泊の命で彼の付人として付いて来たことから、李逵の孝心もむなしく、老母を亡くしてしまった恨みなど、逐一を物語って。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "郎党には米田金八｜郎・何児小左衛門・岩成兵助の三名を付人としてつかわすほどにな。",
              "citation": {
                "source": "日本名婦伝",
                "author": "細川ガラシヤ夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥方を……いや迦羅奢を、すぐ用意の山駕にうつせ」　庭面で、付人達の返事がした。",
              "citation": {
                "source": "日本名婦伝",
                "author": "細川ガラシヤ夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の供をして三戸野山へ夜のうちに落ちようとする付人達は、山仕度で庭の近くまで、その山駕を用意して来ていたが凝然と、ただ立ちすくんでいた。",
              "citation": {
                "source": "日本名婦伝",
                "author": "細川ガラシヤ夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "樵夫とも浪人ともつかない侍が、その砂子塗りの女駕を取りまいて、のどかに煙草をふかしていますが、駕は無紋、付人は異様な郷士？",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸の付人　バタバタと蒲焼を焼く煙の中で団扇をたたく音が板場でする。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ……そうに違いない』『米沢の剣客か』『隠居の付人に連れて来た者たち』　低く――然し、つよい語気で、誰かが、『くそっ』　と、呟いたのが風に流れた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "案の定、赤穂の痩せ浪人がちらほら、後から尾いて来るわ』　一学は、こう云って、付人の剣客達へ誡めた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "云われた通り、付人達は、歩いていた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "付人や、家来は、幾人でも斃せようが、上野介が、討てるか否かとなると、拙者にも、誰にも、勝算は見えないのがほんとだ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのために、木村丈八を初め、腹心の付人たちは、明かに、浅野浪士へ対して、張りつめた戦意をもって、戦っている気持なのだ。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この茶会の人出入りには、吉良家の家臣も付人たちも、又かといつも頭痛にしていた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
