    "definitions": [
      {
        "index": 1,
        "gloss": "deceitful",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "思わせぶりな態度で相手をその気にさせるなんて、本当に罪作りな人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "期待だけさせておいて最後には裏切るという、罪作りな結末が待っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女の罪作りな微笑みに、多くの男性が翻弄されてきたのは有名な話だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "神将のＡ　――僧侶で美男は罪作りだ。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かわいい姿で、毎日見ている人さえだれも見飽かぬ気のするこの人を、別れた日から今日まで見せてやっていないことは、真実の母親に罪作りなことであると源氏は心苦しく思った。",
              "citation": {
                "source": "源氏物語",
                "author": "初音",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦しそうだ、人が至当と認めぬ望みを持つことは仏の道から言っても罪作りなことになるであろうと薫は思った。",
              "citation": {
                "source": "源氏物語",
                "author": "竹河",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分親切からでしょうが、紅茶に催眠剤を入れた方は飛んだ罪作りの方です。",
              "citation": {
                "source": "ニッケルの文鎮",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッ罪作りな……第一の精霊　若い人がござるは、年功でもない、一寸はつつしまねばならぬワイ。",
              "citation": {
                "source": "葦笛（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜ自分も、若くて綺麗なうちに罪作りをして置かなかったのかと、口惜しいような羨ましいような気がした。",
              "citation": {
                "source": "女房ども",
                "author": "БАБЫ",
                "note": "青空文庫"
              }
            },
            {
              "text": "思えば子爵も罪作りさね。",
              "citation": {
                "source": "正義",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あまり、罪作りなことはなさらぬように。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人でも残したら、かえって罪作りなことと思いますが」「さよう、康頼はまあよかろう、しかし俊寛は」　いままで穏かであった清盛の言葉が、次第に激しい口調に変ってきた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第三巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛んだ罪作りだね、フ、フ、フ」　萬七の舌は毒を含みますが、貫祿の違ひでガラツ八の八五郎もその上應酬が出來ません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "麝香の匂ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんだ罪作りだね、フ、フ、フ」　万七の舌は毒を含みますが、貫禄の違いでガラッ八の八五郎もその上応酬が出来ません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "麝香の匂い",
                "note": "青空文庫"
              }
            },
            {
              "text": "後から子供達が叱られたりしちゃ飛んだ罪作りだ」　とお祖父さんも笑って諦めた。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "罪亡しの罪作り　安達君は早速小宮君のところへ駈けつけたが、瀬戸君が来ていたのに驚いた。",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それどころか、あいつのもう一人の息子はキューバで黒人女と罪作りな生活をしていると言い抜けて、新聞ネタに出せるものなら出してみろってさ。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶子の奴も、えらい罪つくりやし、おまけにそやって苦労しとっても、いつなんどき相手と別れんならんか判れへんし、苦労の仕甲斐がないわ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな人を、こんなにだますなどと、磯五という人は、何という罪つくりであろうと思った。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前も薄情な罪つくりだな」女はすこしきっとなった。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに切れ長にすんだその眼、それには異性の琴心をかき乱さずにはおかないあるやさしい悩ましさを宿しているところを見ると、この守人、ことによると、いたるところで思わぬ罪つくりをしているかもしれない。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "現場をせせくっているうちに、のろま清次も変な気になったものと見え、「へ、へ、へ、この後家様、これがなア、ずいぶん罪つくりの後家様だなあ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたぐらい、性悪の、男ったらしの、罪つくりな女はありませんよ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど時々主人家族は用事に托して外出し、料理屋に入り、日頃の渇望を充たすのであるが、小店の主人やお屋敷の如く、雇人の前に御馳走を見せびらかすような罪つくりはしない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根に登って盗み見の旦那が下に落ちたらしい、いやとんだ罪つくりのストリップ宴会。",
              "citation": {
                "source": "ストリップ修学旅行",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "莞爾として、『年老の罪つくり』　と答えた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――案外、こんなことで役者の反目、劇団の分裂なんてことが起るんじゃないか、としたらニンニクも罪つくりである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔をみると狎れッこい態度で、「ああいう美女をこの山奥まで逢いに来させるなんて、旦那も、なかなか罪つくりでございますね」と、啓之助にとっては、すこぶる不愉快なお追従笑いをした。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "cruel",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
