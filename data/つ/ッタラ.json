        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "煙草はレッド・バンドを喫い、酒はラム酒、とくにネグリッタラムにてつくるバカーデ・カクテールを愛飲する。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "幹太郎は工人等が、黒い饅頭か、高粱粉をベッタラ焼きのようにした※餅のかけらを噛って、湯をのむだけで、よくも一日十五時間の労働に消費される熱量を補給し得るものだと考えた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "タ、タ、タ、タ、タラッタラー。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タラッタ、ラタ、ラッタラー、マーケットの日に、私は初めてペッギーを見た。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タラッタ、ラタ、ラッタラー、私は歌う、其の乾草が若草で、春の花を一杯つけたとて、盛りの彼女に敵わぬと。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タラッタ、ラタ、ラッタラー、…………………………　ワルトンも向き合って踊り出した、二人は仲々調子よく踊った。",
              "citation": {
                "source": "決闘場",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナニ外ガ見タカッタラ、教場ノ外ヘ出テイナサイ」　窓の外へ立たされて、殊勝らしくじっとうつむいていた顔をひょいとあげると、先生は背中を向けて黒板に字を書いていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツカオヒマガアッタラ御教示ヲ願イマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬱単越（梵語ウッタラクルの音訳）は天下勝の義でまた勝処また勝生と訳し、アイテルの『梵漢語彙』には高上と訳しある。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "中には崑崙茶の味なんか知らないまま、見様見真似に「茶精」の味ばかりに耽溺して、アッタラ青春を萎縮させてしまう青年少女も居るといった調子ですが、今そこに寝ている支那留学生は、たしかにその一人に相違ないのです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠のオヤジの生蕃小僧問題なんかホッタラかしちゃって、座員の寺本に電報を打って、この特等席を二つ取ってもらって、その返事を見てから大急ぎで帰って来たんだがね。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人が、達磨の頭を見あげて、「アノ、素てッぺんから、転ばり落ッこッタラ、如何ヅラァなァ！",
              "citation": {
                "source": "環魚洞風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラダガナオッタラ、＊＊＊＊＊＊＊＊＊ニナッテ、＊ヲ＊＊テアルキタイナアッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタラッタ、ラッタッタッ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラッタラッタ、タッタララ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に、「阿耨多羅三｜藐三｜菩提を得たもう」　ということですが、この語は、梵語の音をそのままに写したもので、原語でいえば「アヌッタラ、サミャク、サンボーディン」というのであります。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの眼もソンナニ光ッタラ面白イケレド。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ずボッタラ焼の種位なドロドロの物にして別に三つ分の玉子の白身をよく泡立てて混ぜて、玉子焼へ油の浸みた紙を敷いてその中へ半分ほど流し込んで今の通りに焼くとソバ入りのカステラが出来ます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノウチ、親父ヨリ度々書取リニシテ、イケンヲ云ッテクレタ、ソノ時、隠居ヲシテ、息子ガ三ツニナルカラ家督ヲヤリタイトイッタラ、ソレハ悪イ了簡ダ……」　悪イ了簡ではない、図々しいというものだ、と神尾が呆れました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出勤ガシタイト兄ヘ云ッタラ、手前ガ手段デ、勤道具、衣服モ出来ルナラ、勝手ニシロ、オレハ、イカイコト手前ニハイリ上ゲタ故、今度ハ構ワヌトイッタ故、ソノ時ハオレガホホノ下ニハレ物ガ出テイテ寝テ居タガ、少シモ苦労ヲカケマイトイウ書附ヲ出シテ、檻ヲ出デ――」　出たな！",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ露店の大道商人となるとも自分は髭を生し洋服を着て演舌口調に医学の説明でいかさまの薬を売ろうよりむしろ黙して裏町の縁日にボッタラ焼をやくか※粉細工でもこねるであろう。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "乞食坊主、売僧坊主、オゲ坊主、チャンチャン坊主、糞坊主、スッタラ坊主、ハッチ坊主、横着坊主、毛坊主、カッタイ坊主などこれである。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "エッタ坊主・ハッチ坊主・スタスタ坊主・スッタラ坊主・乞食坊主・マイス坊主・オゲ坊主・毛坊主・カッタイ坊主・長吏ン坊・八ン坊・皮坊・御坊（隠亡）などから、はてはべら坊・泥坊・立ちん坊・風来坊・ケチン坊・シワン坊に至り、腥坊主・糞坊主・チャンチャン坊主などという語までが用いられる。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ニナッテ葉ヲ落スノハ、無益ナ消耗ヲ避ケテ樹液ヲ貯エ、春ニナッタラ大イニ伸ビテヤロウトイウ樹木ノ高イ意欲ノアラワレナノダ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ誓ヲ破ッタラ処罰サレルコトヲ承知シマス』　一雄は日本に残っている妻のことを考えると拒むことが出来なかったと云います。",
              "citation": {
                "source": "恐怖の幻兵団員",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "冗談ニソンナコトヲ云ッタラ、オ望ミナラサセテアゲマスト云ッテクレタ或ル待合ノ女将ガイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
