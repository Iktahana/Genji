    "definitions": [
      {
        "index": 1,
        "gloss": "pluralizing suffix",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "明日、うちっちでパーティーするから、遊びに来てよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あいつっち、またケンカしてるのか？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供っちが全員集まったら、出発しよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "あれは対戦中の右翼小説ほどひどくは無いが、しかし小うるさい点に於いては、どっちもどっちというところです。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、お逢いしたことは無いのでございますが、私が、その五、六日まえ、妹の箪笥をそっと整理して、その折に、ひとつの引き出しの奥底に、一束の手紙が、緑のリボンできっちり結ばれて隠されて在るのを発見いたし、いけないことでしょうけれども、リボンをほどいて、見てしまったのでございます。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっちも或る第三者を計算にいれてものを言っているのだからな。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おめえの色男がかえっちゃった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな奴と喧嘩したら、倒立ちしたってこっちが負けだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっとも手むかいせずに、こっちの殴った手へべっとりくっついて来る」急に真剣そうに声をひそめて、「あいつ、菊の手を平気で握りしめたんだよ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "額はあくまでもせまく皺が横に二筋はっきりきざまれていて、もう、なっちゃいない。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とこう言い切るとあなたのほうじゃ、すぐもうこっちをポンチにしているのだからな。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでもなくっちゃあ、――」言うことが大きい。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九字二十四行、つまり、きっちり四百五十六字の文章を一つ書いてみろというのである。",
              "citation": {
                "source": "無題",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっちり四百五十六字の文章なんて、そんな気のきいた事が出来る男じゃないんだ。",
              "citation": {
                "source": "無題",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちの面目丸つぶしです」と言って来た。",
              "citation": {
                "source": "無題",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした環境に育った僕は、家で来客と話すよりも、こっちから先方へ訪ねて行き、出先で話すことを気楽にして居る。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがこっちから訪ねる場合は、何時でも随意に別れることが出来るのである。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一部が英訳されているのをおもしろそうだと思って買って来たまま、しばらく手を触れないで打っちゃっておいた。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして、もう一遍振返って見ると、女は引返してまたこっちへゆっくりゆっくり歩いて来るらしい。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬はどっちへ行こうかと云う風で立止っていると、女の子は馬の腹をくぐって前へまわってまたダーダーと云いながら新屋敷の方へ引いて行った。",
              "citation": {
                "source": "鴫つき",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏は喜んであっちこちこぼれた米をひろっている。",
              "citation": {
                "source": "鴫つき",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに東京と国とどっちがいいかと聞いてみたら、おくにのほうがいいと言った。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして一行は東俣谷の、オリットの小舎に着いた、私が恐い、怖ろしい念いをしながらも、もう一遍後髪を引かれて見たいとおもった小舎の前の深潭は、浅瀬に変って、水の色も、いやに白っちゃけてしまった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウダンツツジの葉と、背向きになって、翠い地紙に、赭っちゃけた斑が交ったようだ、何枚も、何枚も、描き捨てられた反古のような落葉が、下に腐って、半ば黒土に化けている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほど霧で眼界を窄められていた、それだけまた神経が鋭く尖っていた、自分たちから一間ばかり、先へ離れて、雷鳥がちょこちょこ歩いて行く、こっちで停まれば向うでも停まる、歩けば先へ立って行く、冥府から出迎いにでも来た悪鳥のように、この鳥の姿が消えるとき、自分たちの運命も終焉を告げるように。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "この谷は、しばらくは、一方は截っ立った崖で、一方は森の下道である、そして板橋一つで、向う岸へ往ったり、こっちへ来たりするので、橋が多い、その板橋を渡る時には、いつも冷たい風が、上流の方から吹いて来る、それは雪を含んで来るのでなければ、氷のように冷たい水のおもてを吹いて来るからであろう。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入っては、私は虫が嫌いなので、障子を締め切ってしまうと、あっちでも、こっちでも障子の外で、カサカサカリカリと忍び音がする、嘴や鬚で、プツリと穴を明けて、中を覗き込んで、呪っているのではあるまいかと、神経が苛々する。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "霧がすっきりと霽れて、前には笠ヶ岳の大尾根が、赭っちゃけた紅殻色の膚をあらわし、小笠から大笠へと兀々とした瘤が、その肩へ隆起している、遠くの空に、加賀の白山は、いつもの冷たい藍色に冴えて、雪の縞が、むしろ植物性の白い色をおもわせる。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「途が違うぞよ」「そっちへゆくでねえぞ」遠くから呼ばった人の親切は、心のうちで受けた。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らぬ間に、爪先上りとなって、馬返しまで着くと思いがけなく村の男女が、四人ばかり籠をしょって、こっちを見ている。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "海事局だって、俺の言い分なんか聞かねえ事あ、手前や船長が御託を並べるまでも無えこっちで知ってらあ。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
