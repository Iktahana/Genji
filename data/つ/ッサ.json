        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モーパッサンを見よ。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて遂に、初期に於ける情熱性は排斥され、ゾラやモーパッサンの開祖でさえ、あまりに感傷的であるとして非難された。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人に於て見れば、ゾラやモーパッサン等の自然主義は、真の自然主義でないのである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コムプレッサーでは、ゲージは九十封度に昇っていた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の子供は、コムプレッサー、鍛冶場、変電所、見張り、修繕工場、などを見て歩いたが、その親たちは見当らなかった。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "余りアッサリし過ぎてもいけないし、正直過ぎても困るのだ。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃健啖なのに、下の女の児は一杯食つた切りで、「御馳走様」と云つて、サッサと寝床にもぐり込んだ。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、実力さえあったら人に遠慮などせずに、サッサと船長にでも機関長にでもなったらいいじゃないか」　船長は、だんだんストキの話の相手になってしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "エッサエッサと掛け声をかけてやっている。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルシッサスである。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロフェッサアのプロよ。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」まず、ざっと、こんなものだ、と言わぬばかりに、ナルシッサスは、再び、人さし指で気障な頬杖やらかして、満座をきょろと眺め渡した。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家のいわゆるデッサンが正しいとか正しくないとかというものも、やはりこういう意味で心理的に真実な描写をするという意味らしく思われる。",
              "citation": {
                "source": "観点と距離",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "干からびたいわゆるプロフェッサーとはだいぶ種類がちがっている。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカでもプロフェッサー達はみんな品のいい、そうしてヨーロッパの国々の多くのプロフェッサーよりもさっぱりした感じの人が多かったが、これらの先生達は誰もチューインガムを噛んではいなかった。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時自分の感じた事は、その鉛筆画が普通のアカデミックなデッサンとはどこか行き方が違っているという事であった。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォアラ、ネスパ、セッサ、ムシュー、アラマディ、プレンプアン、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウパッサンが普仏戦争を題材にした一篇の読みだしは、「巴里は包囲されて飢えつつ悶えている。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッサと出せ、出せ」　白糸は死守せんものと決心せり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "メリメ、モオパッサンの諸秀才も遠く及ばぬ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「書き損じのデッサンでもなんでも、とにかく見たいのです。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」老画伯は首をかたむけて、「デッサンが三枚ばかり、私のところに残っていたのですが、それを、あのひとが此の間やって来て、私の目の前で破ってしまいました。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつは、所詮ナルシッサスだ。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロオジヤスの后メッサライナ。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "メッサライナは、アグリパイナの瞳をひとめ見て、これは、あぶない、と思った。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
