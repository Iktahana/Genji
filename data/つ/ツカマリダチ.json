        "examples": {
          "standard": [
            {
              "text": "10ヶ月になった息子が、テーブルの角で初めて「つかまり立ち」をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おっ、つかまり立ちができるようになったね！成長が早いなあ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ソファに手を添えて、不安定ながらもつかまり立ちをする姿が愛らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "子供がそばで騒ぎまわったり、やや大きい子が人形を作って遊んだり、本を読んだり、手習いをしたりするのをいちいち見てやらねばならぬ忙しい時にも、また一人の小さい子が後ろから這いかかって来てつかまり立ちをしようとするような、母であるための繁忙に追われて、夫人はもう奪った手紙のことなどは忘れ切っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
