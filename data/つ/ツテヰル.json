        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ノ見タトコロデモ死骸ハ大概同ジヤウナ形ニナツテヰタ頭ガヒドクフクレ　顔ハマル焦ゲ　胴体モ腕モケイレン的ニフクレ上ツテヰル　火傷者ノ腕ニ蛆ガ湧イタリスル　十三日後ニナツテモ広島市デハマダ整理ノツカヌ死骸ガ一万モアルラシク　夜ハ人魂ガ燃エテヰルト云フ。",
              "citation": {
                "source": "原爆被災時のノート",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "急ニ轟々タル音響ガ聞エテ西南ノ方聖天町邊（書信ニハ圖ガ添ヘテアルガ略スル）ニ旋風ノ起ツテヰルノヲ認メタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ツテヰル間中、死ンダヤウニナツテヰルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ間違ツテヰル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、玉ネギサンノ　ノツテヰル汽車ノ中ヘハイツテイツテ、席ニコシヲ下シテ、グウ　グウ　グウ　グウ眠リコンデシマヒマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン　アナタガボンコチヤンヲカブツテヰルカツカウハトテモヘンダワ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカライクラ、オモシロクツテモ、アンマリナガク水ノ中ニハイツテヰルト、カラダニドクデスカラネ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "［西洋人ハ支那ヲ世界ノ涯ト思ツテヰル、邦語ノ所謂「金の草鞋云々」ニ該當スベシ。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
