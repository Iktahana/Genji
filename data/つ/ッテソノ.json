          "literary": [
            {
              "text": "故ニ、随ッテソノ間ニ行ワルル犯罪ノ種類モ亦、唯物科学ノ原理ヲ応用セルモノ多カルベキハ自然ノ理ナリ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッテヤルトイウナラ、余ハ世界人類ノ不幸ヲ救ウタメ、カワッテソノ暴挙ヲ思イトドマラスデアロウ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ヲ以テ朋友親戚挙ッテソノ為ス所ヲ咎ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテシバラク眼ヲモッテソノ姿態ヲ貪リ食イ、タダ歎息シテイルバカリデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
