[
  {
    "uuid": "ef2d0425-f7b3-59fb-ad24-6eab47a947f1",
    "entry": "ってか",
    "reading": {
      "primary": "ってか",
      "alternatives": [
        "てか"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "接続詞"
      ],
