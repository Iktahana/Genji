          "literary": [
            {
              "text": "彼はまず青山の家族にあって、長い看護に疲れ顔なお民にも、七十八歳の高齢で義理ある子を先立てたおまんにも、それから宗太夫婦にも厚く弔みを述べた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきほどまで気の張りつめていたらしい妻も、ひどく悲しく疲れ顔で押し黙っている。",
              "citation": {
                "source": "美しき死の岸に",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうは疲れ顔だった。",
              "citation": {
                "source": "日記",
                "author": "一九四七年（昭和二十二年）",
                "note": "青空文庫"
              }
            }
          ]
