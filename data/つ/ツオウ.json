          "literary": [
            {
              "text": "女婢其の後に續いて、こはいかに、掃帚に跨り、ハツオウと云つて前後して冉々として雲に昇り去つて姿を隱す。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツオウ駅を中心とした町々の最も繁華な通りの飾りつけは一時パリーと同様にしたことがあるそうだが、禁じられてドイツ流に変ったとのことである。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、ツオウ駅まで出て行く。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月十一日　夜十一時ベルリン、ツオウ駅出発。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
