          "literary": [
            {
              "text": "粗末な泥土塗りの田舎家もイタリアと思えばおもしろかった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "囲爐裡の角をひらりと跳ね越えて飛んで来た踏絵の手を取ると、岩井は配膳棚と反対の壁際へ飛んで行き、壁のように見せかけてある土塗りの盲扉を開けるより早く、ダ、ダ、ダ、ダと階段を踏み鳴らしながら、暗く口を開けた地下室の方へ駆け降りて行く。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
