[
  {
    "uuid": "d2d10d2d-1ad1-522f-ac7f-296b8ff2e9c4",
    "entry": "面付き",
    "reading": {
      "primary": "つらつき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "expression (on one's face)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の面付きから、何を考えているのか全く読み取れなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "合格発表を見た時の彼女の面付きは、喜びで輝いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "無表情でいることが、かえって不気味な面付きになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "むろん米の酢じゃけに飲むとどことなくポーッと酔うたような気持になるのでなあ……まことに面目ない、浅ましい話じゃったが、奈良原が、あの面付きでシカメて酢を飲みよるところはナカナカ奇観じゃったよ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴等は、戦争に負けた時が、死んだ時という覚悟を女子供の端くれまでもチャンと持っているので、生きたまま捕虜にされると何とのう不愉快な、理窟のわからんような面付きをしておった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あからさまに言えば、こいつはにたにた笑ってはいるが、ずうずうしい陰険な面付きをしていた。",
              "citation": {
                "source": "鐘塔の悪魔",
                "author": "THE DIVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その職人は竹と云って、年も若し、面付きこそ人並だが、酒はのむ、博奕は打つ、どうにもこうにもしようのねえ野郎だ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて彼の面付き、眼の配り、世のつねの乱心狂気ともおぼえませねば、何か子細ありげな奴、あらためて吟味いたすまでは館の内に繋ぎ置こうと存じまする。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも面付きが気に食わねえと思った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "春の雪解",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは、大体そのノツペラボーな、面付きが昔から気にくわんのだ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の側には遍路車が据ゑてあつて、中には面付きの悪い十二にはなるまいと思ふ子が、足が立たぬ様な態度をして栄一の這入つて行くのを見守つて居る。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お留守のところへあがり込んで、どうも済みませんが、娘がいろいろお世話になって」と、丁寧にさげたあたまを再びあげるところを見ると、心持ちかは知らないが、何だか毒々しいつらつきである。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "お鳥居のやうに両足ふんばつて　山をにらんで拝むつらつきというのです、ちょっとおもしろいと思いました。",
              "citation": {
                "source": "木曾御岳の話",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木下杢太郎、長田秀雄、吉井勇、斎藤茂吉、谷崎潤一郎、茅野蕭々、萱野二十一の諸氏とならんで、つらつき一人前になって私の詩がヒナドリのように羽根をぴくぴく動かしていた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "面は本物のうはばみのつらつきはしてゐるものの白面で女らしく優しく、口のところでは未だ十三四くらゐに見える娘の唇が、ぬれて見えた。",
              "citation": {
                "source": "末野女",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるでフィリッピンから来た男のつらつきであった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三日後から私は烈しい咳はしていたが、なおった患者のつらつきで病院の廊下を歩いた。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも構わないから、滅多に出かけて来て、ケンカを吹っかけそうもない奴で、大もので、面つきの気に食わん奴に『腹を立てとけ』とでもいうことに、俺は考えていたんだろう。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、どれも面つきが前座らしい。",
              "citation": {
                "source": "番茶話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その面つきいと真面目なれば逃げんとしたれども、ふと思い付きて、まず殻をとりてたまわれと答えける。",
              "citation": {
                "source": "突貫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではこりゃいったい何だと考えているうちに、かつてオレの悪妻自慢に悪乗りした某の面つきが浮かんで、はたと膝を叩いた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＵＮＩＸであれ、ＯＳ／２　３・０であれ、Ｗｉｎｄｏｗｓ　ＮＴであれ、オレがマッキントッシュで出合ったいわゆるＧＵＩの面つきじゃないのか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "省作はようやくのこと、いやだいやだと口の底で言いつつ便所を出たけれど、もしも省作がおとよさんにあって、おとよさんのあの力ある面つきで何とか言い出されたら、省作がいま口の底でいう、いやだいやだなんぞは、手のひらの塵を吹くより軽く飛んでしまいそうだ。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほかの坊主はともかくも、和尚の面つきがどうも気に入らねえ」と、留吉は寝ながらに考えた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはレッグズの意見によれば、とりわけ大酒呑みの阿呆らしいその男の面つきから考えると、至極必要な用心なのだそうだ。",
              "citation": {
                "source": "ペスト王",
                "author": "寓意を含める物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのシャンデリヤの下に斑白、長鬚のガッチリした面つきの老爺が、着流しのまま安楽椅子に坐って火を点けながら葉巻を吹かしている。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗鬱、愚痴、こんなものは敵だとおもつてゐるのだ、さりとて情熱の欠けた日にペンを構えてゐる己れの面つきを想像すると、どうしても、これも修業だと自惚れるわけにはいかなかつた。",
              "citation": {
                "source": "「学生警鐘」と風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうもヨーロッパ人くさくない面つきの奴が多い。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　兵隊あがりらしい、面つきやからだは逞ましいが、そしていつも葡萄酒の酒臭い息を吐いているが、案外人の好さそうな看守が、よほど注意して聞いていないと分らないような変ななまりのフランス語で尋ね返した。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "法螺忠がさっきから折に触れてはこちらの顔を憎々しそうに盗み見るのは、別段それは彼の癖ではなく、人を小馬鹿にするみたいな私の面つきに堪えられぬ反感を強いられていたものと見えた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、遠慮も忘れて早く酒の仕度をさせろよと促し、閻魔のやうな面つきで骨身の寒気と闘つてゐた。",
              "citation": {
                "source": "冬物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どうだい、あの山高帽子をアミダに被つて頬つぺを突つぷくらせてゐる憎たらしい面つきと云つたら……」「狒々親爺奴が！",
              "citation": {
                "source": "鬼の門",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "法螺忠がさつきから折に触れては此方の顔を憎々しさうに偸み見るのは、別段それは彼の癖ではなく、人を小馬鹿にする見たいな私の面つきに堪えられぬ反感を強ひられてゐたものと見えた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
