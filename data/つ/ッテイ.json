        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノホカニモ水死人、サマザマノスガタデ考エテイルソウデス、白イ浴衣着タ叔父サンガ、フトコロニ石ヲ一杯イレテ、ヤハリ海ノ底、砂地ヘドッカトアグラカイテ威張ッテイタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓外、庭ノ黒土ヲバサバサ這イズリマワッテイル醜キ秋ノ蝶ヲ見ル。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、工場ヤ、銀行ヤ、病院ヲ守ッテイルダケデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎が電報をうつと、スグコイマッテイルとの返事だったので、喜んで行こうとすると、君枝はもじもじしながら、「うちも一しょに行くわ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時庸三は、海風の通って来る、ある郊外のコッテイジじみたホテルへ仕事をもって行こうとして、ちょうど彼女がいつも宿を取っていた近くの旅館から、最近母を亡くして寂しがっている庸三の不幸な子供達の団欒を賑わせるために、時々遊びに来ていた彼女――梢葉子を誘った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ゴロ愛惜シタ樹木ヤ草花ナドガ、イツトハナク落葉シテシマッテイル。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年ノ多クハ小サクサカシクオサマッテイルモノカ、ツマラナク時ヲ無為ニ送ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイモノダト思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山ハ絵ノ具ヲドッシリ付ケテ、山ガ地上カラ空ヘモレアガッテイルヨウニカイテミタイ」‥‥山が地上から空にもれあがる‥‥それはすばらしい自然への肉迫を表現した言葉だ。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "師、手ヲウッテ笑ッテイウ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "寅二郎は、船上に吊ってあるバッテイラを指して、手真似であれで連れて行けと頼んだが、きかれなかった。",
              "citation": {
                "source": "船医の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "告　皆サンモ知ッテイル通リ、本日何者カヾ当工場ニ「失業者大会」ノビラヲ撒イテ行キマシタ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日八時、石切山ノ下デマッテイマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレモハジメノウチデ、工場ノ人モダンダンコナクナッテ、死ンダトキニハ、ミンナハモウ君チャンノオ父ッチャノコトヲワスレテシマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イソイデ、オ母ッチャノ方ニ手ヲノバシテヤッテ、ヨナカニコエヲ出スノガオッカナイノデ、ハジメダマッテユスッテイタガ、オ母ッチャハナカナカ目ヲサマサナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、シバラクダマッタママ、少シズツ大キクユスッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ青イカオヲシテ、ダマッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "出版してから三年ばかり後のこと、ラファエル前派の詩人ロゼッテイの二人の友人が、散歩の途次偶然、埃に埋もれたこの珍しい本を発見して、彼にその話をした。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロゼッテイは同志の詩人スウィンバーンと一緒に件の店に出かけて行って、ちょっとその本を覗いただけで直ちにその価値を認め、おのおの数冊ずつ買って帰った。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロゼッテイは怒りと諧謔をまぜた抗議口調でその男に食ってかかったが、結局二倍の値段で少しばかり買って立ち去った。",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツヅイテ刺スヨウナ痛ミヲオボエマシタノデハット思ッテ目ヲ開クト要之助ガ悪鬼ノヨウナ相ヲシテ白イ光ルモノヲモッテ私ニ馬乗リニナッテイマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカットナッテイキナリ拳固ヲ堅メテ頭ヲ突キマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
