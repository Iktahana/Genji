    "definitions": [
      {
        "index": 1,
        "gloss": "to take advantage of someone's kindness or patience",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あまり甘い顔ばかりしていると、部下が付け上がるので注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "一度要求を飲んだら、彼はさらに図に乗って付け上がってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "親の優しさに付け上がって、家の手伝いを全くしようとしない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "すぐ付け上がるからいやだ」「ハハハ付け上がるものか。",
              "citation": {
                "source": "二百十日",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "付け上がるのは華族と金持ばかりだ」「また華族と金持ちか。",
              "citation": {
                "source": "二百十日",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな法律を男性は一笑に付して、益つけあがるでありましょう。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「煩いから黙つてゐれば、何処までつけあがるんだらう。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンパにやめたら、こいつ、またつけあがる」　と大森が、手塚の首にかけた手に力を入れた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手に出れば相手はつけあがるなどと恐れる人々は、八紘一宇を口にする資格がない。",
              "citation": {
                "source": "最終戦争論",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあ、この人は何処までつけあがるのだらう？",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつぱり君は人間か」「ぢやア、なによ」　私は女をおだてるとつけあがることを知つてゐたから黙つてゐた。",
              "citation": {
                "source": "私は海をだきしめてゐたい",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり君は人間か」「じゃア、なによ」　私は女をおだてるとつけあがることを知っていたから黙っていた。",
              "citation": {
                "source": "私は海をだきしめていたい",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりやさしくしてくれると、わたしは、つけあがるよ」「かわいゝことを言ふやつだ。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "女つてもんは、つけあがるのよ。",
              "citation": {
                "source": "女人渇仰",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "放っておいたら、どこまでつけあがるか知れやしねえ、こんどこそはギュッという目にあわせて、申しわけがございませんの百辺も言わしてやるつもりなんだ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "野伏大名",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのへんまでは我慢が出来たが、酌をしに来いとまでつけあがるんじゃ、この先のことを思いやられる。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "かごやの客",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、やがて彼女も、皆が心を柔げてくれるどころか、素直にすればつけあがるだけだということを、悟らなければなりませんでした。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "うッかりからかってオダテたが最後、つけあがること、男という男を鼻息で吹きちらかして尻にしきまくる魂胆なんで、本県じゃア前科十犯の人殺し屋でもチヂミ上るという八丁鼻が、アタピンにかかっちゃ鼻先であしらわれていまさ。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「おい」「おいが気に入らねえ」「モシモシ、尾沢君」「ばかにするな」　と尾沢生は相手がどこまでも下から出るのを承知でますますつけあがる。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "つけあがるばかりだ」　男は深く何度もうなずいた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしここでは、（b）助けおこしてやっても何のかいもなく・むしろそうすれば益々つけあがるような・人間を助けたりおこしたりするのは、不正でもあり無慈悲でもある。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらに附属している太政官の地券、下文、国司の証など、遺産の大部分は、返していただいておりません」「つけあがるなッ」呶喝して、良正は、杯の酒を、ぶっかけようとしたが、良兼が、あわてて、手くびを抑えた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊太夫は冷かすように、「旅川、お前は案外、女には手荒だな」「そうでもないが、つけあがるからよ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉が、つけ上るはずですわ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれ共、どうしても願い通りにしてやればつけ上る気味がある。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "寛くすればつけ上る、厳しくすれば怖じけて何を云っても返事もしないようになるのは、彼等の通癖である。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さんが黙ってるからつけ上るんだよ。",
              "citation": {
                "source": "少年の死",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓というやつは、厳しくすれば反抗する、甘くすればつけ上る――表面は土下座しながら、内心ではこっちを侮っている、最も卑しむべき動物は百姓だ――これには強圧を加えるよりほかに道はないと、それ以来の神尾家は、代々そう心得て百姓を抑えて来ていた。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓というやつは厳しくすれば反抗する、甘くすればつけ上る――表面は土下座しながら、内心ではこっちを侮っている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻　　女はつけ上るものよ。",
              "citation": {
                "source": "紙風船（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "廉太　　つけ上るからさ。",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども中介は人が才能を認めてくれるとそれが当り前だと思つてつけ上るばかりであるから、稔も一方に腹を立てゝもゐるのである。",
              "citation": {
                "source": "朴水の婚礼",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（小人がつけ上るのも、怨むのも、また嫉妬心を起すのも、結局は自分だけがよく思われ、自分だけが愛されたいからだ。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
