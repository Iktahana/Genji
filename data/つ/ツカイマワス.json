    "definitions": [
      {
        "index": 1,
        "gloss": "to use (the same thing) for multiple purposes",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "一つのパスワードを複数のサービスで使い回すのは、セキュリティ上危険だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古いノートパソコンの部品を分解して、他のマシンに使い回す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は同じ言い訳を何度も使い回して、上司の追求を逃れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "松島も次第に商売の骨もわかり、周旋屋の手に載せられるようなどじも踏まず、子供を使いまわすことにも、特得の才能が発見され、同業にも顔が利くようになった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "……まるで気ちがいみたいに、方図もなくお金を使いまわす癖がある上に、借金するほか能のない男にとついだんです。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（笑う）わたしの恩給は、のこらず支配人が取りあげおって、農作だ牧畜だ蜜蜂だと使いまわす。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "初回に作っておいた印刷用のフィルムを使い回せるため、再版では一冊あたりの製造コストを抑えられます。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to work (someone) hard",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
