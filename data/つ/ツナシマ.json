          "literary": [
            {
              "text": "稽古してからツナシマへ行って理髪、モリナガで食事して、座へ帰った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "山野を誘って、理髪にツナシマへ行き、帰りにみや古で食事し、雨に濡れつゝ座へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二十五日（土曜）　今日は理髪しようとてツナシマへ行くと全然三枚目、二十五日定休。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出る前、ツナシマへ寄って理髪する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひる終って、ツナシマへ理髪に行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふとそんな気になってツナシマへ理髪に行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツナシマで理髪し、舟和でチョコレートアイスクリームソーダをのむ、宿酔気味で色々水分を欲する朝だ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
