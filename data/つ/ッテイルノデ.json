        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハイロイロナ構図デ頭ガイッパイニナッテイルノデスガ、ナニシロマダカクダケノ腕ガナイヨウデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ッテイル間中、死ンダヨウニナッテイルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ御苦労ナコトダガ、春久ガ御祭ヲ撮影スルノダト云ッテ昨日カラ行ッテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若夫婦ノ居間ハ可ナリ豪華ニ飾ッテアルラシイガ、階段ノ中途ガ螺旋ニナッテイルノデ、足モトノ悪イ予ハタマニシカ上ッタコトガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓モドーアモ締マッテイルノデ、外カラ聞エテ来ル訳モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脈ハ大分ヨクナッテイルノデ連レテ帰ルハ私ヲオ信ジニナッテ下サイ、オ嬢サンガスベテ御存ジデス」ト云ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覗イテミルト妻ガ洋服ヲ着セテ貰ッテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ誤解シテイルヨウダガ僕ハ決シテ怒ッテイルノデハナイノデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノホシデハ、ウチュウノコト、ミナ、シラベテ、ワカッテイルノデス、ワタシ、チキュウノニンゲンヨリ、百バイ、カシコイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
