[
  {
    "uuid": "97fa9652-885e-5bba-b179-c939637bc991",
    "entry": "っ子",
    "reading": {
      "primary": "っこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "接尾辞"
