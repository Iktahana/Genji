        "examples": {
          "standard": [
            {
              "text": "彼はギターをつま弾きながら、お気に入りの歌を歌い始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "静かな湖畔で、友人がウクレレを優しくつま弾く音が心地よかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、幼い頃からピアノを習い、指先で鍵盤を器用につま弾く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "福井　※伊豆の山々月あはくあかりにむせぶ湯のけむりあゝ初恋の君をたづねて今宵またギターつまびく旅の鳥トおでんやの店先に立寄り、福井　おじさん。",
              "citation": {
                "source": "渡鳥いつかへる",
                "author": "軽演劇一幕四場",
                "note": "青空文庫"
              }
            }
          ]
