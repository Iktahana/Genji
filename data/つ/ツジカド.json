        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "資生堂の横丁と交叉する辻角に来たとき五人の酔った一群が肩を一列に組んで近くのカフェから出て来た。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある処にて秋のはじめつかた毎夜村の若衆｜抔打ち寄りて辻角力を催すに、力自慢の誰彼自ら集まりてかりそめながら大関関脇を気取りて威張りに威張りつつ面白き夜を篝火の側に更しける。",
              "citation": {
                "source": "俳諧大要",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "云い伝えによると、街の辻角や林の小径で魔物に逢うのも、この黄昏れ時だといわれる。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリユツセルの街を歩いて居て或辻角に出た時鉄柵の中に珍らしい噴水のあるのに気が附いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あちこちの辻角には村の閑人や賢人たちの會合が開かれてゐる。",
              "citation": {
                "source": "驛傳馬車",
                "author": "アーヴィング",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
