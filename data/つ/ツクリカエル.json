[
  {
    "uuid": "64e458cd-76af-5900-b881-fc98529f5a31",
    "entry": "作り変える",
    "reading": {
      "primary": "つくりかえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
