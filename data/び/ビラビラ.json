    "definitions": [
      {
        "index": 1,
        "gloss": "fluttering (esp. of thick or heavy material)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風が吹くたびに、古くなった暖簾がびらびらと音を立てて揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "飾りのリボンがびらびらして邪魔だったので、ピンで固定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "切りっぱなしの布の端がびらびらしており、少しだらしない印象を与える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "こんなさびしい風景の中にうきあがつて、白つぽけた殺人者の顔が、草のやうにびらびら笑つてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争の気配もないのに、大砲の音が遠くで聴え、城壁の周囲に立てた支那の旗が、青や赤の総をびらびらさせて、青竜刀の列と一所に、無限に沢山連なっていた。",
              "citation": {
                "source": "日清戦争異聞（原田重吉の夢）",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒寥地方散歩者のうろうろと歩いてゐる十八世紀頃の物さびしい裏街の通りがあるではないか青や赤や黄色の旗がびらびらしてむかしの出窓に鐵葉の帽子が飾つてある。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "市街之圖散歩者のうろうろと歩いてゐる十八世紀頃の物わびしい裏町の通があるではないか青や　赤や　黄色の旗がびらびらしてむかしの出窓にブリキの帽子が竝んでゐる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大砲を撃つわたしはびらびらした外套をきて草むらの中から大砲を曳きだしてゐる。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柱や手すりを白樺の丸太で作り、天井の周縁の軒ばからは、海水浴場のテントなどにあるようなびらびらした波形の布切れをたれただけで、車上の客席は高原の野天の涼風が自由に吹き抜けられるようにできている。",
              "citation": {
                "source": "軽井沢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "船だねえ、雪のびらびらした顔の船だねえ、さういふものが、いつたりきたりしてうごいてゐるのだ。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪に挿した簪のびらびらが、月を映して揺れなびき烈しい眩ゆさで光りつづけた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面に月をうけて立った舞妓たちの簪のびらびらが、せせらぐ川波の中で揺れていてまだ宵らしくつづいた川向うの灯が、橋を渡る夥しい人の足を浮きあがらせて賑かだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私、ここに放つてあるから、ひがんじまつたのよ」「食物でひがむのなら判るけれど、まさか、旦那さまのことでひがむのないわねえ……」　登美子は寫眞を取つて、薄いびらびらの紙も丁寧にかぶせて、杉枝の膝に、「大事になさいよ」　とそおつと置いた。",
              "citation": {
                "source": "婚期",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてヤードに新しくあげた信号旗をびらびらさせながら、平靖号の方へ近づいていった。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁をふらふらにくっつけ、長い毳のある肩掛をぐるぐる巻きつけ、鍔のびらびらしている帽子をかぶり、泥だらけの脚をして、その馬車の中から体をゆすぶりながら出て来た、乗客のロリー氏は、幾らか、大きな犬のようであった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "若葉が、びらびらと湿っぽい風に揺れている。",
              "citation": {
                "source": "抜髪",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると髪に※した花簪のびらびらが、美しく揺れた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物席からイキナリ駈上って来たらしく頬を真赤にしてセイセイ息を切らしていたが、吾輩が振翳している死骸なんかには眼もくれずに、ハンドバッグの中から分厚い札束を掴み出すと、みんなの鼻の先へビラビラさせて見せまわしながら、ニッコリと笑った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉の上まで庇を冠せて、そのうしろに中将姫のようなビラビラを戴いているのがある。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物松茸ようかんと大きく書いた字だの、赤い黄いビラビラした旗だのが、その『誰か』と絶えず一緒になつて眼にちらついた。",
              "citation": {
                "source": "百日紅",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の家は食うにも困っているということが子供の私にさえわかっているのに、母は私にビラビラの下った赤い梅の花簪を買って来てくれた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして「運動を見せる」といふ事は一方よりいへば日本服にはビラビラした部分が多いといふ事で、さてそのビラビラした部分が多い日本服には「だらりとして取締のない」といふ欠点があるのだ。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝の陽をいっぱい浴びて、並んだ女郎屋の二階のてすりには、蒲団の行列、下の写真棚には、お葬式のビラのような初店の女の名前を書いた白い紙がビラビラ風に吹かれていた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「知った家はないし、どうせ兵営の傍の木賃泊りだ」「召集されて随分｜悲惨な家もあるンでしょうね」「ああ百姓なんか収穫時だ、実際困るだろう」　海水浴場案内のビラが、いまは寒気にビラビラしていて、駅の前を行く女達の薄着の裾が帆のようにふくれ上っていた。",
              "citation": {
                "source": "清貧の書",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちと陣中見舞いとしては、遅くなったので気がかりじゃよ」　巨大な御幣を腰に差し、自分も御幣さながらの躰を、夜風に、ビラビラ翻しながら、そう姥は心配そうに云った。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日では、そういう考えかたすべてが、自身の感情のビラビラに甘えていたことであるのを感じて居る由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして写し終った部分はノートを四つに裂いて、ビラビラしたのれんみたいにしているの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴さんは石坂論では、モチにかかって居ります、自分の心の、感情のビラビラのもちに。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯨の背中には、先刻のべたような服装の縹緻よしの女口上つかいが桃割にさした簪のビラビラを振りながら、いい声で鯨の口上。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "両国の大鯨",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い空に赤い旗のビラビラなびくモスコー迄は五千里だ。",
              "citation": {
                "source": "敗れて帰る俺達",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思わずのぞくと、髪を桃われにゆったひとりの少女が、ビラビラかんざしといっしょに造花のもみじを頭にかざり、赤い前かけに両手をくるむようにして、無心な顔で往来のほうを向いて立っていた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまもいまとて、伊那丸と忍剣が、一気にかれを討ちとろうとしたせつな、どこからともなく、ビラビラビラビラビラッと吹きつけてきた針の風！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉服屋の店さきには見たこともない美しい内地着物がビラビラ飾ってある。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
