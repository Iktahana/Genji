        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頸から肩と思ふあたり、ビクツと手応がある、ふつと、柔く軽く、つゝんで抱込む胸へ、嫋さと気の重量が掛るのに、アツと思つて、腰をつく。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……さいなみたければさいなむがよろしい、嘉門は少しもビクツキません。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかしあらかじめ申し上げておく、今日は切り合いをやめといたしても他日にはきっと討って取るとな」「よかろう」と紋也もビクツカなかった。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　死に身の勇気、男らしく、臍を定めるとビクツカない。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎　（ビクツと、小さく飛上るやうな動作）……。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手で自動車の音）笠太　（それを叱り飛ばす気もなくなつてボンヤリ下手を見てゐたが、ラツパの音で不意にビクツとして）……はあ、検査官は何処へ行くんぢやらう、区長さん？",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
