[
  {
    "uuid": "b11cb051-c670-58b3-a27a-1541d6e0ee08",
    "entry": "病患",
    "reading": {
      "primary": "びょうかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
