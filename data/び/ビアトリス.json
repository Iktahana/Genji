        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "つぎに知れているのはジョウジ・オリヴァ・ラヴ――George Olive Love――という三文小説の主人公みたいな名でカロライン・ビアトリス・ソウンヒルという十八歳の女と結婚していることだ。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人は、大谷大学の教授鈴木大拙博士の夫人ビアトリス女史で、もう今は世に亡いかたである。",
              "citation": {
                "source": "仔猫の「トラ」",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうしろにジョー・カラマの奥さん、ビアトリスが顔を見せた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "家のなかに冷たいチェリー・パンチがたくさん用意してあります、とビアトリスは可愛い声で言った。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョー・カラマとビアトリスを両腕に抱き、階段の上からラリー・デイヴィスが演説をした。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビアトリスが女性たちに抱きかかえられて泣いていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
