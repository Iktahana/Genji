        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コローやドービニーなどの風景画がそっくり抜け出して来たように思われてうれしかった。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "はんだ付けをした箇所やビニール線の確認、次に電源をチェックしていく。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "下乗之事禁中ヨリノ御使イ、並ビニ江戸公儀ヨリノ御使者以外ニ夜中ノ通行堅ク御差止メノ事　はっきりと禁裡御所からのお使い、並びに江戸お公儀からの使者以外は、夜中の通行堅くお差止めの事と書いてあるのです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんだよ」「坐れよ」と高志が、となりのイスの黄色いビニールを平手で叩いた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この東芝盤は、会社が「エバークリーン」と呼んでいる、静電気の起こらない盤で、赤い塩化ビニールを使っていたために、俗に「赤盤」と呼ばれて、未来の中古屋でご大層な値段をつけられることになる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一も起きあがり、はだしのままビニールタイルの床を歩いて、インターフォンのまえにいき、呼出しスウィッチを押した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一もはだしで、ペタペタとビニールタイルの上を歩く。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロッカーには、大きなビニール袋が入っていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊べるぜ、あいつは」　ビニールレザーのギター・ケースを肩にかけ、慶一は柾生たちをうながした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「高志兄さん、わたしがここに入ることも、反対だったんです」　中央の正面口から射しこむ西陽が、ビニールタイルの床で反射して、慶一の右側を歩きながら、こちらを見た令子の顔を、やわらかい光でつつみこんだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "高志はなにもいわず、ゴミ袋にメロンの皮と紙の皿を放りこみ、令子は果物ナイフを鞘にしまい、まな板をビニール袋に入れた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まいった、まいった」　東屋に入ると、ビニールコーティングした敷物を投げだし、高志が笑った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三脚のキャスターもガタがあるし、床のビニールタイルも移動撮影など考慮していないので、カメラが搖れる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒いビニールレザーでおおわれている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピーナツだの、サラミだの、なんだかわからないゴミだのが散乱し、ウィスキーやらビールやらが、なかば乾いてビニールタイルにへばりつき、テーブルやイスは、立っているものでさえも、あちこち勝手な向きをむいている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア　ウグヒスガ　アソビニ　ヤツテ　キタ」ト、イヒナガラ、コドモタチハ　テヲ　ウツテ　コロコビマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、カネガ　ナツテ　キヨウシツノ　マエニ　ナラビニ　ユクト、ミツルクンハ　マダ　ナイテ　ヰマス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ母ッチャハネタキリデ、目アナガウントヒッコンデ、ダマッテミテイルト、イキヲスルタビニウゴイテイタフトンガ、ダンダン分ラナイグライニナッテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、彼もドルビニー（d'Orbigny）と同様に、ある大規模な自然界の革命が、彼の考えでは火山噴出があってその際にあらゆる生物が死滅し、そうしてこの絶滅したものに代って新しい種類のものが創造されたと考えた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ我々ノ映画事業ニシテモ、何カ会ダノ組織ダノガデキルタビニ、ズラリト重要ナ椅子ヲ占メラレルノハ、必ズ、全部ガ全部映画ニハ何ノ関係モナイ人バカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、ヒラガナトイウモノハ、元来毛筆ナラビニ和紙トイウモノトトモニ育ツテキタモノデ、ソレラヲ離レテハホトンド生命ノナイモノト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒歩会の人は二日ともノビニズムを研究していた。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも言語のショービニストではないのだ。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "三〇　ガーイウスに関する疑問　ガーイウスは、羅馬五大法律家の一人で、サビニアン派に属し、著述もなかなか多く、殊に「十二表法」の註釈、および「金言」(Aurea)と称するものは有名である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "三〇　ガーイウスに関する疑問　ガーイウスは、羅馬五大法律家の一人で、サビニアン派に属し、著述もなかなか多く、殊に「十二表法」の註釈、および「金言」（Aurea）と称するものは有名である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "白百合の様な姿とダイヤの様なかがやかしい貴い気持をもったリジヤ姫、男獅子よりも強い忠僕のウリセス、ラクダの様な猿の様な狐の様な鼻まがりの悪党のチロポンピヤ、ビニチュース、ネロ、ペテロ、そうした人達の間に生れて来る大きな尊い芸術的な悲劇の中に私の心は段々ととけこんでしまいました。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
