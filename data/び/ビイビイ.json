          "literary": [
            {
              "text": "紡錘はビイビイと唸つてゐる。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビイビイビイビイビイビイ。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "いぶかしさうに小首を傾けた母は、立つて行つて戸棚から一束のじんきを持ち出し、またビイビイビイと紡ぎ始めた。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は気持よく起きて、話をしていた人間が、昼すぎに、四五回、ビイビイと、口から黄色い粘液汁を吐いたと思うと、一時間も経たずに死んでしまう。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
