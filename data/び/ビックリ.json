        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "誕生日には、友達が企画してくれたびっくりパーティーで盛大に祝ってもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の結婚の発表は、私たちにとって嬉しいびっくりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、箱から飛び出すびっくり箱に大喜びしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
