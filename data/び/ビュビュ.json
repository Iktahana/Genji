        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」かれは、ビュビュ・ド・モンパルナスを書きあげた。",
              "citation": {
                "source": "碧眼托鉢",
                "author": "――馬をさへ眺むる雪の朝かな――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君のビュビュに就いての記事、僕はずいぶんうれしかった。",
              "citation": {
                "source": "碧眼托鉢",
                "author": "――馬をさへ眺むる雪の朝かな――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらが動きもしないのに、チラと信子に気づいたのか、ビュビュと飛んでしまった。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風がビュビュと耳を過ぎる。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビュビュ、風が唸って過ぎた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小さき町にて」「ビュビュ・ド・モンパルナス」「母への手紙」の作者、シャルル・ルイ・フィリップも熱心な彼女の支持者であったが、自分のためにさえ何もなし得なかったフィリップにはマルグリットを世のなかに押し出す力はなかった。",
              "citation": {
                "source": "若い婦人のための書棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャルル・フィリップの「ビュビュ・ド・モンパルナス」（これはお手紙で下らなさがわかった）をふとよみかえして、ここに描かれているパリの下級勤人の生活や娼婦の生活に対する作者の心持と、荷風や武麟や丹羽のかく市井風俗との気稟のちがいを感じます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビュビュ・ドゥ・モンパルナッスより　――売笑婦になじみもあったがね、彼女等が愉快そうにして居るのは、それ、子供が怖ろしさをかくすために喚き散らすだろう、あれと同じなのだよ。",
              "citation": {
                "source": "一九二五年より一九二七年一月まで",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "◎「ビュビュ・ドゥ・モンパルナッス」、ベルトという淫売婦、モオリスという情夫――女喰い、ピエールという小役人。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "読んでみろよと、「モンパルナスのビュビュ」という本をあさひにおしつけた。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
