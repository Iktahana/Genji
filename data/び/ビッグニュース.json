        "examples": {
          "standard": [
            {
              "text": "昨日のニュースは、まさにビッグニュースだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の結婚の発表は、ファンにとってビッグニュースだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "世界中を驚かせるようなビッグニュースが飛び込んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "南条己未男は、彼の顔をみると、「おい、ビッグニュースだ。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツ兵のいる陸地へ、こっちからいって上陸したということになれば、そのニュースは、ビッグ・ニュースとして全世界を震駭し、奮わざること久しきイギリス軍も勇気百倍、狂喜乱舞いたしますよ」「狂喜乱舞するかな。",
              "citation": {
                "source": "独本土上陸作戦",
                "author": "――金博士シリーズ・３――",
                "note": "青空文庫"
              }
            },
            {
              "text": "只今ドイツ側がビッグ・ニュースの放送をやって居ります。",
              "citation": {
                "source": "独本土上陸作戦",
                "author": "――金博士シリーズ・３――",
                "note": "青空文庫"
              }
            },
            {
              "text": "三面記事、ビッグ・ニュース、それを面白がるだけで、たくさん。",
              "citation": {
                "source": "帝銀事件を論ず",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "……世界的なビッグ・ニュースである。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "人工衛星や核融合などのビッグ・ニュースを、始終聞かされているうちに、たいていの人は、科学の成果に幻惑される。",
              "citation": {
                "source": "科学ブームへの苦言",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺されて庭の椎の木に磔刑にされた近江屋半兵衛は、かつて街道筋を荒し抜いた、斑組六人男の片割れとは、まさに岡っ引本能にどんでん返しを打たせるような、センセイショナルなビッグ・ニュースです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正時代というのは、一般に平穏無事であったから、全権の出発などは、夕刊の全面を埋めるビッグ・ニュースである。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
