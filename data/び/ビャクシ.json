  {
    "uuid": "344b46cc-b73e-548b-807a-ecb30294726c",
    "entry": "辟支",
    "reading": {
      "primary": "びゃくし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "勿論寂心は辟支仏では無かったのである。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾の求むるところは、阿羅漢も辟支仏もいまだ求むる能わず、また求めんともせざるところじゃ。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾時辟支仏あって城下に来りしを、かの五百｜牧牛人供養発願して、その善根を以てたとい彼女身死するとも残金五百銭を与えて、約のごとく彼と交通せんと願懸した。",
              "citation": {
                "source": "十二支考",
