        "examples": {
          "standard": [
            {
              "text": "この病気の初期病徴は、微熱と倦怠感だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "医師は、患者の訴える病徴を注意深く聞き取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "病徴が急速に現れるため、迅速な診断が求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "從つて顏面は若くは蒼白、若くは黝黄、若くは枯赭で、間々或は肺病徴候のやうに兩頬の美淡紅色を呈して居るのもあるが、先づ大抵は眼の結膜などの紅色も薄くて、腦の血量の乏しいことを現はして居る。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "完全な題は長たらしい「新考案、胸壁を叩いて胸郭内部に隠れた病気の病徴をみつけるための」であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
