  {
    "uuid": "8dbaed78-4d0c-5b8c-94b4-a57f577bbe44",
    "entry": "びんた",
    "reading": {
      "primary": "びんた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「横びんた撲りこくるだ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "つかつかと歩み寄つたＫ少尉、いきなりびんたの一つも張るかと思つたらさにあらず、『それ位にして置いて早く集つて下さい、濟まんが』とやつたものだ。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはことさら撲られるのも感じないほど酔っている風に装い、唇を開けてフラフラして見せているのに、沢村さんは、続けて、ぼくの右頬から左頬ヘと、びんたを喰わせ、松山さんを顧みてはニヤニヤ笑い、「こら、大坂、これでもか。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはことさら撲られるのも感じないほど酔っている風に装い、唇を開けてフラフラして見せているのに、沢村さんは、続けて、ぼくの右頬から左頬へと、びんたを喰わせ、松山さんを顧みてはニヤニヤ笑い、「こら、大坂、これでもか。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふざけるない、土竜の無精馬奴、びんた一つ喰はさうかえ。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、若者が口先ばかりで終ひにびんたを試みなかつたのが遺憾であつた。",
              "citation": {
                "source": "夜見の巻",
                "author": "「吾が昆虫採集記」の一節",
                "note": "青空文庫"
              }
            },
            {
              "text": "びんたぼをチョッペリと出して、てっぺんに出来合いの小さなマゲをのせるのだったが、この和洋折衷のハイカラ髪は清子が嫁いで来てからの慣わしだった。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "前年の春、勉は仕事をしているプロレタリア文化団体の関係でやられ、びんたをくわされたのが原因で、悪性の中耳炎になった。",
              "citation": {
                "source": "小祝の一家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう承知ならん、あんなことをいうやつは、びんたを喰らわしてやるのが当たり前だ」とフェルフィーチキンは金切り声を立てた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜のような醜態を、かりに白雲に見られたとすれば、マドロスは有無をいわさず、叩き起されて、二つや三つのびんたを食うことはわかっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手はくるりと振りむいて、力まかせ横びんたを喰らわそうと身がまえたが、荒だてては事面倒と思いかえした。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "とその瞬間、彼女の頬っぺたにがあんと一発、横びんたが飛んだかと思うと、ジノーヴィー・ボリースィチはあけっぱなしの小窓めがけて突進した。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "白ウサギ　クイーンさまにびんたを張ったのじゃよ。",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「クイーンさまにびんたをはったのじゃよ――」と言い出すウサギ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と私は大声一｜喝、追い縋って、持っていた唖鈴で国分の横びんたを撲った。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度などは、小休止の間に、バックが輓革をもつらして出発がおくれた時に、デイヴとソルレクスが一しよにとびかかつてきて、ひどいびんたをくらわした。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちくしょうッ」　燕作は拳をかためて、イヤというほど、竹童のびんたをなぐる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そいつをぽんと蹴放し、また、とたんに、も一つの脚へ搦んできたチンピラの横びんたへ向っては、「ちょめ！",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
