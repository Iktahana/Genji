        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "正確を以て聞えたニエビュールの『亜喇比亜紀行』にも屁を放って国外へ逐われた例を挙げおり、一七三五年版ローラン・ダーヴィユーの『文集』巻三にも、二商人伴れ行くうち一人放屁せしを他の一人｜瞋って殺さんとす。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "さていよいよ放り込むや否や直ちにその穴を土で埋め、かくて声も香も他に知れざりしを確かめ、やっと安心して帰ったとあって、この書世に出た頃大いに疑われたが、ニエビュールがその真実たるを証言した。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニービュールが、アラビアで見た体大きくて、悍の善い驢は、旅行用に馬よりも優れば、したがって価も高い由。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ノクタンビュール」　たしか青木前夫人の働いているバーである。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ノクタンビュールへは、たいがい、幾時ごろ行かれたのでしょう？",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノクタンビュールは九時か九時半ごろ、一時にドッとはやるのよ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがサン・ポールの城がビュール侯とルー殿によって我々から奪われた時には、大将ジュイルの旗手にとって、事はそううまくはこばなかった。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
