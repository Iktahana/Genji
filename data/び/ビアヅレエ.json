          "literary": [
            {
              "text": "何となく英國でビアヅレエイ等のやつてゐた「イエロウ・ブック」を思ひ出させるものがある。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國でビアヅレエイ等のやつてゐた「イエロウ・ブック」と比較して見ると、非常に共通した點があつてなかなか興味が深い。",
              "citation": {
                "source": "色褪せた書簡箋に",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し後にビアヅレエの「アンダー・ザ・ヒル」の話が出て、あの一癖ある文章をちよつと訳して見たいやうな気がする、と自分が云ふと、彼も以前にさう思つたことがあつたと云ふ。",
              "citation": {
                "source": "芥川龍之介を憶ふ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
