        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同じ文学を志した友人のＫ君と徒歩でこゝを通つたとき、隧道の難工事に従事してゐる労働者達の荒くれた風貌や関東弁がいかにアムビシヤスな、田舎からぽつと出の二人の幼な青年を驚かしたかを思ひ浮べたりした。",
              "citation": {
                "source": "芭蕉と歯朶",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハマビシヤ（ツルナ）。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "過労で眼を赤くした馬の腹から胸は、自分がビシヤ／＼はね飛ばす泥が白く乾いていた。",
              "citation": {
                "source": "押しかけ女房",
                "author": "伊藤永之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "臼杵には、ヤソ会への入会希望者のための練習所ノビシヤドを設立する。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "この計画は早速実行に移され、臼杵のノビシヤドはクリスマスの前日に開かれた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "府内のコレジヨ、臼杵のノビシヤドはいずれも予期以上にうまく行っている。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "生徒も非常に優れて居り、六七人は臼杵のノビシヤドに行きたいと云い出した。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "島津の兵が臼杵を占領して宗麟の建てた壮麗な会堂やノビシヤドの建物を焼き払ったとき、豊後の教会の人々を救出して下の関へ運んだのも、彼の力であった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
