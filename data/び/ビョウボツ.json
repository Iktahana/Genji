    },
    "definitions": [
      {
        "index": 1,
        "gloss": "dying of illness",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は若くして病没し、多くの人に惜しまれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "偉大な芸術家が、病没によりこの世を去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長年の闘病の末、静かに病没した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "かつては書店の主人であったが、愛妻の病没により、哀傷の極は発願して、奮って無一物の真の清貧に富もうと努めた。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして翌大正一五（一九二六）年四月七日、病没。",
              "citation": {
                "source": "尾崎放哉選句集",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして翌明治三十七年以降は大正三年の病没の年に至るまで、そこの世界屈指の美術博物館に、日本およびシナの部の首脳として、毎年の半ばをかの地に過ごすに至った。",
              "citation": {
                "source": "茶の本",
                "author": "はしがき",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず許嫁の伊太郎が、肺を病んで病没した。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤原の四兄弟も、一時に病没したのである。",
              "citation": {
                "source": "道鏡",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその肥大も実は五六年前｜前夫｜通武の病没したる後の事にて、その以前はやせぎすの色｜蒼ざめて、病人のようなりしという。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "但しその刊刻せられたのは明治十五年壬午十月で、あたかも毅堂の病没した時である。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "明年癸亥六月二十二日病没。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "明年癸亥六月二十二日病没ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月二十四日にかつて安政中鷲津毅堂の隣家に住んでいた幕府｜表坊主中山文節という者が病没した。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "惜しいかな、病没の二十二、三年前から、おそらく神経の疾患のためであったらしく、その研究の意義あるものは、全く中断したように思われる。",
              "citation": {
                "source": "和算の社会的・芸術的特性について",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二男賛次郎は大戦中陸軍大尉の資格で糧秣廠に通っていたが、疲労のため昭和十九年四月八日病没。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "毛利輝元は、病没した蜂須賀彦右衛門に代わって秀吉の意を伝える黒田孝高の忠言もあって、ついに平城の建設を決めた。",
              "citation": {
                "source": "広島という名の由来",
                "author": "薄田太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その学生は、のちに官吏になり、戦後病没したが、その最後の日までメシアの感激を追想していたと、未亡人から手紙が来たのは、それから二十年の後である。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "山寺梅龕は会津の俳人で、明治26年８月、27才で病没。",
              "citation": {
                "source": "藤野古白句集",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "或るものは病没し、或るものは炭坑変災の犠牲となった。",
              "citation": {
                "source": "金山※話",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢沢千秋は五年前に病没し、この世を去っております。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "元禄六年の二月十八日に、白石在の某家でたしかに病没したのだが、それから十何年ののち、或る商人が京都に旅行して、途中で白石翁を見たという話も伝わっていたから、かりに海尊であったとしても理窟だけは合うのである（以上『東藩野乗』下巻および『封内風土記』四）。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところへまた、黄賊の総帥張角が、陣中で病没したため、総攻撃に出て、一挙に賊軍を潰滅させ、降人を収めること十五万、辻に梟くるところの賊首何千、さらに、張角を埋けた墳をあばいてその首級を洛陽へ上せ、（戦果かくの如し）と、報告した。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "金内の私宅には、八重ということし十六になる色白く目鼻立ち鮮やかな大柄な娘と、鞠という小柄で怜悧な二十一歳の召使いと二人住んでいるだけで、金内の妻は、その六年前にすでに病歿していた。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "勾当、病歿せしは明治十五年、九月八日。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がジョン・ステーナー（今世紀の当初病歿した牛津（オックスフォード）の音楽科教授）の作と推測し、それに算哲が、何かの意志で筆を加えたものと信じていた鎮魂曲が、人もあろうに、この館の設計者ディグスビイの作だったのだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに東京にある養父源吾は、専六がなお舟中にある間に病歿した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文政三年庚辰十月廿九日病歿。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "天保七年十一月十四日病歿す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "霞亭は「居無幾、先生帰伊州、予亦雲遊四方、数歳而帰郷、（中略）遂往訪則云、先生以本月朔病歿、今已六日、実文化七年三月也、夫知己相待之殷、以十三年※離之久、期一見於二百里外、豈意其人既亡、臨之後事、即俾予此行、纔在数日前、尚及其目未瞑也」と云つてゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに山陽病歿の前後に頼氏に寓してゐて、山陽の命を受けて其著述を校訂し、山陽の易簀するに及んで、後事を経営した関五郎と云ふものがある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一七八七年、エカテリーナ女帝を慫慂して南部新領土への行幸を実現したが、その後、他の寵臣のため女帝の信任が己れを離れたことを知り、一旦締結された土耳古との講和を破棄し、再び戦端を開かんと企て、南露ニコラエフに向ふ途中、病歿した。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "元和元年八月二十四日に――信長、秀吉の殊寵を受け、わけても関白秀吉の為めには、朝鮮征伐の地勢調査として自ら韓人に変装し、慶尚、京畿、平壌などを、詳かに探って復命したほどの、大貿易商であり武人である所の――島井宗室は病歿した。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、私の物語ろうとする『稚子法師』の怪異譚は即ち蘇門病歿の時を以て、先ず其端を発するのである。",
              "citation": {
                "source": "稚子法師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
