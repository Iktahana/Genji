[
  {
    "uuid": "435c87fa-9b6d-50e0-a092-b7f0f8a3faa5",
    "entry": "病室",
    "reading": {
      "primary": "びょうしつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
