    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sickroom",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "静まり返った病室に、規則正しく時を刻む時計の音だけが空虚に響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おじいちゃんの病室は、窓から綺麗な公園の桜が見える素敵な場所だったよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "看護師は夜回りの際、病室のドアをそっと開けて患者たちの寝顔を確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "家敷の二方に並ぶ病室からは、患者や附添人等の呑気な饒舌が、時には高く、その余はゴトゴトと聞えて来た。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「病室の奴等は……」と思ふとその饒舌の声々に腹が立つたが、その入院してる一人々々の顔を憶ひ出すと、何にも云へぬ気がした。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡り廊下に近い一棟の病室の者達が、最早その赤坊の苦しげな絶え／＼の泣き声のために「急病人あり」と知つて、縁側に出て見えもせぬ診察室の方に首を伸してゐた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "或日父は近頃にない早く、外来患者も病室の方も済まして、表の間の卓に頬肘を突いた儘、縁先の河鹿の鉢をヂツと瞶めてゐた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡台のある間の二三間ばかり向ふは直ぐに病室だつた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "急にその病室から高い笑ひ声が聞えて来ると、私は母と話したことが全部その病室まで聞えたために笑つたのかと気懸りになつた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "で上体をヂイツと擡げて、病室の方をみた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は病室の人達が此方の話を聞いてゐると思つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が徒跣になつて小さい子供のやうに走り廻るので病室の人達は笑つてゐた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "病室は明るく温かい。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺風景な病室の粗末な寝台の上で最期の息を引いた人の面影を忘れたのでもない、秋雨のふる日に焼場へ行った時の佗しい光景を思い起さぬでもないが、今の平一の心持にはそれが丁度覚めたばかりの宵の悪夢のように思われるのである。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人目の子供を産むために、下の児を連れて県病院の施療病室にいる女房は？",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "爆撃でヒビのイツた病室の天井を睨み乍ら寝苦しい夜つれ／″＼に考えた事、酒の席で武山オジサンにでも談して見て呉れ。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "傳染病室から普通の病室へ擔架で移されたのは、六月の中旬頃の事だつた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝生の庭を挾んだ向うには、水色のペンキで塗つたこつちと同じやうな二階建の病室の棟が立つてゐた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また時には窓際の曲木の椅子に腰掛けて、庭の景色や、向う側の病室の窓の中をぼんやり眺めてゐる事が出來るやうになつた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "武井さんが草花を買ひに行つた留守に、私は一人寢臺を靜に降りて、椅子に凭りながら烟るやうな雨脚を通して見える、向う側の病室をぢつと眺めてゐた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、私はその二階の病室の右手から三番目の窓に凭つて、同じやうに庭を眺めてゐる若い女をふと見附けたのであつた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに好い花がございませんの……」と、かう晴れやかに呟きながら病室へはいつて來た武井さんの聲を聞いた時、私は救はれたやうな氣持がして毛布を撥ねのけた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「向うの二階の病室へ若い女の患者が來ましたね……」と、私はその女の事をまだ氣にし續けながら云つた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、私の隣の、そのも一つ先隣の病室の扉が開いて、醫務室の方へ急いだらしい人の足音が私の病室の前を過ぎた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫くすると、また三四人の靜かな足音と囁き聲が遠くの廊下から近づいて來て、その病室の方へはいつて行つた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その病室にはアメリカへ出稼ぎに行つて、肺結核に罹つて、故國で死にたいと云ふ望みから重體のまま歸朝して來た中年の紳士が、その十日程前からはいつてゐたのだつた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳を澄ますと、その病室の方は相變らずひつそりとしてゐた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸くお粥になつたばかりの朝食を食べてゐると、病室の外を通るゴム車の軋りがふと聞えた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、大概の病人は病室から一歩も出ないのに、よく其處此處の病人に就いて知る事が出來た。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この先の向う側の病室に若い支那人の患者がゐますの。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
