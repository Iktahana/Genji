        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どうでもいいけど、北尾の茶番のお相手なんかやっちまったクラッシャー・バンバン・ビガロよ！",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどあの北尾言い逃れ光司との猫またぎの一戦で、ビガロはそこまでプロモーターの意向にべたべたに合わせてしまう本当に気のいいオッサンであることを満天下にさらし、東京ドームの巨大ドツボにはまってプロレスラーとしての命を絶った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラッシャー・バンバン・ビガロの死を悼み、合掌。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "とここまで書いてきて海よりも深く反省したのだが、ほらみろ、構成を決めずに書き始めると、アラン・ケイの目に映った東芝のダイナブックをテーマとしたはずの原稿が、もう東京ドームにおけるビガロの突然死になってしまうでしょう。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
