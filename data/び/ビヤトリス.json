        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ダンテが少年の時ビヤトリスを見て、世の常ならぬ愛を経験した。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後彼は長くビヤトリスを見ることがなかった。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビヤトリスは一人の女｜伴れと共に紅い花をもっていた。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後ビヤトリスは他に嫁いだ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてビヤトリスは凡ての美しいものの運命に似合わしく、若くしてこの世を去った。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文献によればビヤトリスは切なるダンテの熱愛に触れることなくして世を終ったらしい。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテの愛はビヤトリスと相互的に通い合わなかった（愛は相互的にのみ成り立つとのみ考える人はここに注意してほしい）。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテはいかにビヤトリスから奪ったことぞ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は一生の間ビヤトリスを浪費してなお余る程この愛人から奪っていたではないか。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
