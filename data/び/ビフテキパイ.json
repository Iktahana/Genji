        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四季の折々Ｂ夫人の家には四五人のお弟子が招待されて、何時もビフテキパイの御馳走であつた。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂ夫人はビフテキパイが好きで、日本人のコツクさんも夫人の味加減を心得て上手に作つてゐた。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんたちをランチによぶ時はいつもビフテキパイを主食に、あとは細かい物をつけ合せにした。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スープは蛤を白汁で煮たもの、それから大皿のビフテキパイ。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフテキパイには初ものの生椎茸が混つてゐた。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白井・堀井と宝塚ホテルのグリルで、ロシヤスープとビフテキパイ、栗のバゞロア。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の皿は、ビフテキパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
