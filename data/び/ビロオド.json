        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その襟には黒のビロオドを張りました。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも「銀鼠色のルパシュカ」「紺のビロオドの洋袴」といふ、想像する丈でも失笑を禁じ得ないみなりをしてゐる。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾て歐羅巴の都で、ビロオドの服を着て得意がつた日本の藝術家が、或商店に買物に行つて、乞食と間違へられた噂を聞いた。",
              "citation": {
                "source": "貝殼追放",
                "author": "「八千代集」を讀む",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、私の車の中には鳥打帽をかぶつた、汚れたビロオド服の大の男が五人分の席を占めて、ふんぞり反つて寝てゐる。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しまた、私は思つた、なんだ、一人の、酔つぱらつた、疲れた、行儀のない、心の荒んだ、汚れたビロオド服の労働者が五人分の席に寝そべることなんかは。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒ビロオドの長服に、宝石のボタンをつけるなど、いかめしい人物だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの全身が黒ビロオドのやうで腹の紅い、あのはな蜂が捕つたのです。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の幼虫は、白い斑点のある黒いビロオドのやうな虫だ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはよくビロオドのやうな幼虫とまちがへられる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは赤い毛で、ビロオドのやうな幼虫の一種類なのだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが帳の奥の隣室には、母たちや叔母たちが粗ビロオドの椅子にかけながら、クナアク先生が身を屈めて、フロックコオトの裾を指二本ずつでつまんだなり、よく弾む脚で、マズルカの一節一節を演じて見せているところを、柄のついた眼鏡越しに眺めている。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは僕にぼろぼろのビロオドの上着か、赤い絹のチョッキか何かで、歩き廻ってもらいたいんですか。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビロオドのように青い空と、熱い葡萄酒と、甘い肉感でしょう。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし相変らずごく胸｜開の広い燕尾服で、その上、緑の刺繍をしたビロオドの小帽をかぶっている。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし雲の奥に日のあるあたりには、水の上にも、ほの白いビロオドめいた輝きが漂っている。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そのほかの連中は、広間で細君たちと一緒に、前のほうの粗ビロオドの椅子や、壁際の所に腰かけながら、踊りを見物していた。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "幅の広い、粗ビロオドの安楽椅子に、レエスの覆いをかけた一等の車室で、あるひとりの旅の客が身を起した――アルプレヒト・ファン・デル・クワアレンである。",
              "citation": {
                "source": "衣裳戸棚",
                "author": "DER KLEIDERSCHRANK",
                "note": "青空文庫"
              }
            },
            {
              "text": "――彼はビロオドの襟の、裾短かな焦茶色の冬外套を着た紳士である。",
              "citation": {
                "source": "衣裳戸棚",
                "author": "DER KLEIDERSCHRANK",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから彼もその通りにして、あごをビロオドの中へ埋めたなり、煙草をくゆらせながら、早くもなく遅くもなく歩いて行った。",
              "citation": {
                "source": "衣裳戸棚",
                "author": "DER KLEIDERSCHRANK",
                "note": "青空文庫"
              }
            },
            {
              "text": "――彼はビロオドのクッションに背をもたせたまま、大きな燈架を見上げていた。",
              "citation": {
                "source": "幸福への意志",
                "author": "DER WILLE ZUM GLUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階の居間の壁布には、色のあせた風景が描いてあり、濃紅の粗ビロオドの布をかけた、どっしりしたマホガニイの卓のまわりには、堅い背の椅子がいくつか置いてある。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォン・リンリンゲン夫人は、手摺の赤ビロオドの上にのせた左の腕から、手套を脱ってしまっていたので、飾りをつけない手と同様、一面に薄青い脈管の走っている、この丸々したほの白い腕は、たえず彼の眼に入った。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はもう一度、フォン・リンリンゲン夫人の姿を、赤ビロオドの上のその白い腕を、眼の前に見た。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "水はきらめき、素馨は鋭い重苦しい香りを吐き、鳥はまわりの樹々にさえずり、その樹間には重たい、青ビロオドのような空が光っている。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリイデマン氏の席は食卓の下手の端で、美しくない高等中学校長夫人の隣、フォン・リンリンゲン夫人の近くに、彼はきれいなビロオドのクッションの上に腰をおろしていた。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人はふかぶかとしたビロオドの安楽椅子に腰かけていて、その足もとにはペルシア絨毯が敷いてある。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」といいながら、粗ビロオドのクッションの上に、ぺったり腰をおろした。",
              "citation": {
                "source": "鉄道事故",
                "author": "DAS EISENBAHNUNGLUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "老紳士は、端厳に胸を合せたフロックコオトに、黒の蝶ネクタイで、落ち着いた品位を見せて、椅子の背にもたれて坐ったなり、茶色の手套をはめた手を、片方は軽く特等席のビロオドの欄干にのせ、片方で時々、ゆっくりと髭をなでたり、刈り込んだ半白の頭髪をなでたりしていた。",
              "citation": {
                "source": "道化者",
                "author": "DER BAJAZZO",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに反して少女のほうは――彼の娘に違いあるまい――腰かけた身を興ありげに勢いよく乗り出して、扇を持った両手をビロオドの褥に置いている。",
              "citation": {
                "source": "道化者",
                "author": "DER BAJAZZO",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼女は堅い立襟のついた、銀鼠のきっちりした胸衣を着ていて、それには、一面に高く浮き出たビロオドの唐草模様がある。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
