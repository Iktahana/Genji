        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "昼の終りに、地下のスエヒロでビフカツとライスカレー食って、阪急百貨店へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三島カフェーでビフカツ・ライスカレーを食ふ、堀井夫妻と平野は帰京。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひる済んで、如月敏とカブとで、銀座へのし、スコットでポタアジュとヒレビフカツ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "森永でオムレツ、中西でビフカツと飯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "外出せず、中西のビフカツとオムライスで食事すませ、ミルクコーヒーなどのみ、ねころんで揉ませる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローレル・ハーディの短篇を見て、白十字でビフカツと飯を食ひ、座へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終ると、スコットのビフカツと飯、ジャマンベーカリーのパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事は、スエヒロからビフカツとチキンライスですませてしまふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、山野・石田を連れて南のタカザワへ行き、ビフカツとカレーライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰って、女房・姉とで、かどやのグリルへ、ビフカツレツ・カレーライス共にうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュとビフカツ、共によろし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "プランタンのライスカレーとビフカツ、まづい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフカツ、ハムエグス等食って、もう仕方ないから寝台へ入る、いやア熱いの何のって。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
