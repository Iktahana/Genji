        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし他の二つの點で、全くルレーヌの方ではでたらめであり、藝術道の意識など夢にもなく、生涯を通じて酒びたりで、珈琲店の音樂など聽いて悦んでゐたところの、徹底的小學一年生の子供であつた。",
              "citation": {
                "source": "室生犀星君の人物について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "焔は生き物のように、伸びたりちぢんだりして、うごいている。",
              "citation": {
                "source": "朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳やという小料理屋がありますからね、先生、このごろは柳やのおステさんと大あつあつで、いりびたりだ、かなわねえ」　駅へ行き、切符を買い、東京行きの省線に乗り、阿佐ヶ谷で降りて、北口、約一丁半、金物屋さんのところから右へ曲って半丁、柳やは、ひっそりしていた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの子は、なくなった父を好きでして、大学へはいるようになっても、休暇でお城へ帰ると、もう朝から晩まで父のお居間にいりびたりでした。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸びるのが目的でもなく縮むのが本性でもなく、伸びたり縮んだりするのが生きている心臓や肺の役目である。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "児どもはさざめき喜びたりき。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と雑所は、しっかと腕組をして、椅子の凭りに、背中を摺着けるばかり、びたりと構えて、「よく、宮浜に聞いた処が、本人にも何だか分らん、姉さんというのが見知らぬ女で、何も自分の姉という意味では無いとよ。",
              "citation": {
                "source": "朱日記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "苫も何も吹飛ばされた、恐しい音ばかりで雨が降るとも思わねえ、天窓から水びたり、真黒な海坊主め、船の前へも後へも、右へも左へも五十三十。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、恁う言ひます内にも、其の沼が伸びたり縮んだり、すぼまつたり、擴がつたり、動いて居るやうでせう。",
              "citation": {
                "source": "人魚の祠",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来た、これなら海を潜っても濡れることではない、さあ、真直に前途へ駈け出せ、曳、と言うて、板で打たれたと思った、私の臀をびたりと一つ。",
              "citation": {
                "source": "薬草取",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "古の女は、下賤なるも袴着たれば、下裳さへなく唯肌着を紐にて結びたり。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一座の連中は早くも荷物を取｜纏めて、いざ引き払わんと、太夫の夢を喚びたりしに、渠は快眠を惜しみて、一足先に行けと現に言い放ちて、再び熟睡せり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と照れたようにその頭をびたり……といった爺様なのである。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もののいいぶりはきはきして、齢のわりには大人びたり。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わびたりとて肯くべきにあらず、しおしおと引返す本意なき日数こそ積りたれ。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたの家も、私家も、同一に水びたり。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の主人も、テーベのくせに、菌を酒で殺すんだなんて言って、酒びたりになって、自分から寿命をちぢめました」「不安でいけないんです。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、道楽とは言つても、女狂ひや酒びたりの所謂、放蕩とは大いに趣きを異にしてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど無くてならぬものは多からず、唯一つのみ、マリヤは善きかたを選びたり。",
              "citation": {
                "source": "律子と貞子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、道樂とは言つても、女狂ひや酒びたりの所謂、放蕩とは大いに趣きを異にしてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドッテテドッテテ、ドッテテド　二本うで木の工兵隊　六本うで木の竜騎兵　ドッテテドッテテ、ドッテテド　いちれつ一万五千人　はりがねかたくむすびたり」　どういうわけか、二本のはしらがうで木を組んで、びっこを引いていっしょにやってきました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供らが叫んでばらばら走って来て童子に詫びたり慰めたりいたしました。",
              "citation": {
                "source": "雁の童子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドツテテドツテテ、ドツテテド二｜本うで木の工兵隊六｜本うで木の竜騎兵ドツテテドツテテ、ドツテテドいちれつ一｜万五｜千人はりがねかたくむすびたりドツテテドツテテ、ドツテテドやりをかざれるとたん帽すねははしらのごとくなり。",
              "citation": {
                "source": "月夜のでんしんばしらの軍歌",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "波から来る光の網が、底の白い磐の上で美しくゆらゆらのびたりちぢんだりしました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "光の網はゆらゆら、のびたりちぢんだり、花びらの影はしずかに砂をすべりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "波から来る光の網が、底の白い磐の上で美しくゆらゆらのびたりちゞんだりしました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "光の網はゆらゆら、のびたりちゞんだり、花びらの影はしづかに砂をすべりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドツテテドツテテ、ドツテテド　二本うで木の工兵隊　六本うで木の竜騎兵　ドツテテドツテテ、ドツテテド　いちれつ一万五千人　はりがねかたくむすびたり」　どういふわけか、二本のはしらがうで木を組んで、びつこを引いていつしよにやつてきました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
