          "literary": [
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエヲ　一ポン　モツテ　イエイエノ　トグチニ　タツテ、ヒロ　ヒロ　ヒート　カナシイ　オトヲ　フルハセ、一セン　二センヲ　モラツテ　タビヲ　シマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルト　サムライ新美南吉　五ニンノ　サムライガ　タビヲ　シテ　アル　ヒ　ヤマミチヲ　トホリカヽルト、木ノ　下ニ　一ピキノ　サルガ　ヰマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「センサウハ　ドチラデスカ、センサウハ」ト　イク　サキサキデ　タヅネナガラ　コノ　ヒトハ　ヒトツキモ　フタツキモ　タビヲ　シマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア　ナンノ　カゲダラウ」ト　モウ　ヒトリガ　クビヲ　カタムケマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナシサウナ　チビスケハ　クビヲ　タレタママ、ジヨンノ　アトカラ　ツイテユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ジヨンガ　イヒマシタガ　チビスケハ　クビヲ　アゲマセン。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、イヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、「デモネエ、ワタクシ　スコシ　ハデスギヤシナイカト　オモフノデスケレド。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五言律詩の題言に「墨水ニ到ツテ去年ノ遊ビヲ継グ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "（返信）ツートツートトツーツー（１）ツートツートトツーツー（２）ツートツートトツーツー（３）　白ペンキ塗リノ礫架デ私ガグン／″＼お延ビヲスル。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ喜ビヲ買ワンガタメニ負傷ヲシテモ惜シイトハ思ワナイ、ソノ負傷ガ原因デ死ヲ招イタトシテモ、ムシロ望ムトコロデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子ガ詫ビヲ入レニ来テ、デハ東京マデアタシモオ供サセテ戴キマスト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
