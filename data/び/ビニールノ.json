          "literary": [
            {
              "text": "ビニールノ帽子ヲ被ッタ顔ガ頭カラビショ／＼ニ濡レテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭カラポタ／＼落チルワヨ」ビニールノ帽子ヲ脱グ時ニ二三滴予ニモ雫ガカヽッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ガ先ニシャワーヲ浴ビタト見エテ、ビニールノ帽子カラ水ガタラ／＼滴レテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "別ニビニールノ袋ニ包ンダ豆腐ヲ土産ニ持チ、十時頃五子ヲ誘ッテ法然院ヲ訪問。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
