[
  {
    "uuid": "7a3b2ac1-9b41-5060-a6bf-0824ea6447fe",
    "entry": "びしょ濡れ",
    "reading": {
      "primary": "びしょぬれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sopping wet",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然の土砂降りに遭い、全身びしょ濡れになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは水遊びに夢中になり、気づけばびしょ濡れだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "洗濯物を干していたのに、急な雨でびしょ濡れにしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "忽ち大驟雨となったので、蒼くなって駈出して帰ったが、家までは七、八町、その、びしょ濡れさ加減思うべしで。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さまで欲しけりゃ算段のうして、柳の枝を折ぺっしょっても引寄せて取ってやるだ、見さっせえ、旅の空で、召ものがびしょ濡れだ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか私はびしょ濡れになりながら、広場のあちこちを駆けずり廻り、苦しいまでに焦燥を感じた。",
              "citation": {
                "source": "面会",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "こころみにそのひとつをちぎりとり歯にあてると、果実の肉がはち切れるほど水気を持っていることとて歯をあてたとたんにぽんと音高く割れ冷い水がほとばしり出て鼻から頬までびしょ濡れにしてしまうほどであった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女は殆どびしょ濡れに近くなりながら、急に逸作の方を振り向くと、いつもの通り少しも動ぜぬ足どりで、雨のなかを自分のあとから従いて来る。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとう浴衣の袖で、素早く顔の汗を拭い、また少し歩いては、人に見つからぬよう、さっと袖で拭い拭いしているうちに、もう、その両袖ながら、夕立に打たれたように、びしょ濡れになってしまいました。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "路面の雪は溶けかけたままあやうく薄く積っていて、ふたりの下駄をびしょ濡れにした。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "老爺は、びしょ濡れになって、よたよた走り、ううむ、ううむと苦しげに呻くのである。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日目の朝、しょんぼり、びしょ濡れになって、社へ帰ってまいりました。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……番町で古井戸と言うと、びしょ濡れで血だらけの婦が、皿を持って出そうだけれども、別に仔細はない。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "六「銀ちゃん、あたしゃアもはや一滴も駄目でさア」　もう飲みまわるのはよしにしよう――と、坂野は眉毛まで濡れ下ったびしょ濡れの顔を、グッドモーニングの銀ちゃんの肩へより掛らせながら、ひょこひょこ歩いていた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　この時こそ、泥靴の、びしょ濡れの、異様奇体の団員の群集で、いっぱいに充たされた校舎であった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもふたりは強情に彼の名を呼んで、びしょ濡れになってそこらを駈け廻ったが、どうしても彼のすがたは見付からなかった。",
              "citation": {
                "source": "麻畑の一夜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この雨のなかをびしょ濡れになって……。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この雨のなかをびしょ濡れになって藤沢から追って来た以上、なにかの覚悟があるに相違ない。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこへ行ったのだか知らねえが、きのうの夕方、店をしめると直ぐにどっかへ出て行って、びしょ濡れになって雨のなかを夜ふけに帰って来たが、それで風邪を引いたに相違ねえ。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "母もベルもタウイロも私も海亀も豚もタロ芋も鱶も瓢箪も、みんなびしょ濡れ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "焦生と友達は雨にびしょ濡れになって宿へ帰った。",
              "citation": {
                "source": "虎媛",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "難有い、としっとり、びしょ濡れに夜露の染んだ土間を、ぴたぴたと踏んで、もっとも向うの灯は届かぬ、手探りですよ。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "びしょ濡れになった服をまとめて洗濯機に放り込み、新しい下着にジーパンで机についた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれはあま酒の箱を肩にかけて、びしょ濡れになっているらしかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は水でも浴びたように、頭から着物までびしょ濡れになっていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨具をつけていない僕は頭からびしょ濡れになって、宿へ帰りつく頃には骨まで凍りそうになってしまった。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからそっと出てみると、水沢さんはびしょ濡れになって倒れていましたから、介抱して座敷へ連れ込んだのですが、なんだかきょときょとしているばかりで碌に口もきかないんです。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、水沢さんはびしょ濡れになって帰って来て、おまけに何だかぼうとしているのを、誰にも知らせないで、そっと連れ込んで寝かしてやったんですもの。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あなたもびしょ濡れでしたわね。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は十一月の暁、途中から細かい雨がふり出して、傘を持たないわたしは本郷へゆき着くまでにびしょ濡れになった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "女生徒等は盛に草原の中を駆けまわって、コウリンカの濃朱色なのや、女郎花のひょろひょろしたのやを折り、争って居るので腰から下はもうびしょ濡れに濡れ徹って居る。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝露で、下駄がびしょぬれである。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "衣服はびしょぬれになる、これは大変だと思う矢先に、グイグイと強く糸を引く、上げると尺にも近い山※の紫と紅の条のあるのが釣れるのでございます、暴れるやつをグイと握って籠に押し込む時は、水に住む魚までがこの雨に濡れて他の時よりも一倍鮮やかで新しいように思われました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
