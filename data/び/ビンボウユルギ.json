    "definitions": [
      {
        "index": 1,
        "gloss": "shaking one's legs (usu. unconsciously)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は驚いたが、表情には一切の貧乏揺るぎも見せなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "隣の席の人の貧乏揺るぎが気になって、テストに集中できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "無意識のうちに貧乏揺るぎをしていたらしく、母に「行儀が悪い」と注意された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その算盤を預かったのは番頭の総助、四十前後の中年者で、丸屋の身代を貧乏揺るぎもさせないのは、この地味な忠義者の手柄のように、世間では噂しております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "受難の通人",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに縄はかけませんが、両手を左右から押えて、貧乏揺るぎもさせまじき気色です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "縁結び",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ひざをびんぼうゆるぎさせながら、あおむけに空を見ている。",
              "citation": {
                "source": "久助君の話",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "very slight movement",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
