        "examples": {
          "standard": [
            {
              "text": "劇的なビフォーアフターを見せるために、ビフォーの写真を撮っておきましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの頃の自分と今の自分を比べると、まさにビフォーとアフターだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ビフォーの状態を記録に残しておくことは、改善効果を評価する上で重要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "待てよ、あとが〈アイ・ニード・ユー〉で、そのつぎが〈ザ・ナイト・ビフォア〉で、それから〈アナザー・ガール〉か……うん、ジョンのリードは前半ばっかだ」「でしょう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "既にジャック・ロンドンの「ビフォア・アダム」という原人生活を描いた小説には、現代人が毎夜毎夜連続的に祖先の生活を夢に再現するというのがあります。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "第四次元の恋",
                "note": "青空文庫"
              }
            }
          ]
        }
