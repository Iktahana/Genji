        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "葉子の本箱のなかには、別にハムやコオンビイフ、林檎、オレンジなどの食料品があり、もうだんだん寒くなって来たので、朝おきると顔も洗わずに、瓦斯ストオブをたきながら、軽い食事を取るのだったが、創作に悩んで来ると、庸三が邪魔になることもあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはその上に書く、あなたへの、愛の手紙など空想して、コオルドビイフでも噛んでいるのです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはドイツの学者リンド氏の説で、イギリスの学者ビイフ氏の説も略それと一致してゐる。",
              "citation": {
                "source": "十三時",
                "author": "THE DEVIL IN THE BELFRY",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人前三十銭のビイフ・ステエクの上にもかすかに匂つてゐる阿蘭陀芹を。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "コオンド・ビイフの缶を切つたり、枯れ枝を集めて火をつけたり、――そんなことをしてゐるうちに彼是十分はたつたでせう。",
              "citation": {
                "source": "河童",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "コオンド・ビイフの罐を切ったり、枯れ枝を集めて火をつけたり、――そんなことをしているうちにかれこれ十分はたったでしょう。",
              "citation": {
                "source": "河童",
                "author": "どうか Kappa と発音してください。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただビイフシュトロウゲンという奇怪な一皿と、ブルンビアなるアイスクリイムに厚化粧をほどこしたようなデザアトだけは、いささか人類の食に適することをウンテルベルゲル氏の名誉のためにつけ足しておこう。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁当、すし、天どん、うなぎどんぶり、しるこ、萩の餅、そばなどの食堂もあれば、ランチ、ビイフステーキ、ポークカツレツ、蠣フライ、メンチボール、カツどんなどの洋食屋もある。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は焼パンに野菜スウプ、卵を添えたビイフステエク、砂糖漬の果物と葡萄酒、緑色のゴルゴンツォラのチイズの一片と梨を半分食べた。",
              "citation": {
                "source": "衣裳戸棚",
                "author": "DER KLEIDERSCHRANK",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
