[
  {
    "uuid": "ef0156c7-c351-5642-b998-d0a23bf4a550",
    "entry": "備前",
    "reading": {
      "primary": "びぜん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
