        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "棚には色とりどりの瓶詰めピクルスが並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お土産にもらった瓶詰めウニは、ご飯のお供に最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、自家製の瓶詰め野菜を友人にプレゼントした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
