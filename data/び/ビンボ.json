        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただ現在のビンボー類似の作品はあまりに荒唐無稽な刺激を求め過ぎて遠からず観客の倦怠を来たすおそれがありはしないかと思われる。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウはカンシヤクの素！",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコノウチノ人ハドレモミンナビンボウ人バカリナノデ、ビンボウナモノハミンナヨリアツマラナケレバ、カワイソウナモノダ、ト云ッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウ人ッテ、ミンナコウヤッテ、オ父ッチャガ死ニ、オ母ッチャモ死ニ、ジブンモ死ナサレテユクモノダナンテ、何ントイウコトダロウ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はビンボウ故男も逃げて行きましたまつくらい頬かむりの夜だ。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜にいる二日、上海での二日、一歩もキャビンから出なかったとキャビンボーイがいっていた。",
              "citation": {
                "source": "復活祭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシ、ニポン人皆様スキ、ビンボーネ、ノーマネーネ……」　と笑わせて歌う数曲、キス・オブ・ファイヤ、ゴメンナサイ、ポッポちゃんなぞ、夢遊病者のようで、いやポッポちゃんどころか、僕をも夢中にした。",
              "citation": {
                "source": "ジャズ狂時代",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウ・ダナオ、部屋へ来り、夫婦喧嘩をあやまり、酔って、クレージーだったと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
