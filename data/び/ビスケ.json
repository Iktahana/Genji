        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "給仕の少女に九鬼は紅茶とビスケットをくれないかといった。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケットってクッキーのことですかと少女が尋ねた。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケットという古い言葉がクッキーという新しい言葉に代ってしまっているのを初めて知って、自分の住んでいる古い世界と少女の住んでいる新しい世界との間隔に軽い目まいを感じたのである。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「煙のビスケット」が生物のように緩やかに揺曳していると思うと真中の処が慈姑の芽のような形に持上がってやがてきりきりと竜巻のように巻き上がる。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りに追分辺でミルクの缶やせんべい、ビスケットなど買った。",
              "citation": {
                "source": "震災日記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "備えたのはビスケットである。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "菩薩の壇にビスケットも、あるいは臘八の粥に増ろうも知れない。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学士はマッチをすって火をたき、それからビスケットを出しもそもそ喰べたり手帳に何か書きつけたりしばらくの間してゐたがおしまひに火をどんどん燃してごろりと藁にねころんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケットのあるうちは、歩いて野宿して、面白い夢でも見る分が得といふもんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまっくらなとこでもしゃもしゃビスケットを喰べた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学士はマッチをすって火をたき、それからビスケットを出しもそもそ喰べたり手帳に何か書きつけたりしばらくの間していたがおしまいに火をどんどん燃してごろりと藁にねころんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケットのあるうちは、歩いて野宿して、面白い夢でも見る分が得というもんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの宿へ二十年も馴染なのです」　葛岡はと言うと、私たちがこの宿へ入って来てから先生がわたくしにかまけ切ってばかりいるのを見て、結局その方が気楽とでもいうように勝手に褞袍に着換えたり、宿のおかみさんが持出した安ビスケットや山独活の漬ものを撮んだり、コヽアを飲んだり、一人で自分の身を犒っています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ごみを危ながる老女に率いられた幼ない子たちは、小動物園の金網の前で小猿の餌のビスケットを分け与えられています。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "花のしんにはプリマ・ビスケットを積み上げる。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、コメット・ビスケットを積み上げる。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三稜のビスケットが花の弁となり。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中継ぎに捩れて海潮音に酔うて、うつゝなき形に、三稜の弁の形のビスケットが八枚と八枚を積み重ねる。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖の島山は鳶色のヘレンとヘレン・クリームのビスケット。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケット・ルヰ九世、第六次十字軍を起したり、ヱヂプト遠征で捕虜となり自分の身体を自分で買い戻して、お国へ帰ると第七次十字軍を起し、ローマ教会から聖者の位を贈られたその王様の名のビスケット。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カロル・ビスケット。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケットさん方静におやすみなさい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは、しばらくは何もかも忘れて製菓会社の包装室で、ビスケットを化粧箱に詰める仕事を働きました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えて見れば美しさというものにも、製菓会社のビスケット包装室で働いた時以来しばらくお訣れでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――米のビスケット……………ふふふ……大変、｜旨い。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私に取つてかういふ奇蹟的な存在の人が、世間では私の母の廉い仕立ものゝお得意さまであつて、現在、製菓会社の下級社員で、毎日ビスケツトを市中に届けて歩き、月給金○○円の方であるとは、どうにも合点がゆきませんです。",
              "citation": {
                "source": "愛",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お茶は紅茶で、お茶受けにはパンの薄片にバターを塗ったもの、ビスケット、ケーキ、その時々の主婦の思い付きによります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私に取ってこういう奇蹟的な存在の人が、世間では私の母の廉い仕立もののお得意さまであって、現在、製菓会社の下級社員で、毎日ビスケットを市中に届けて歩き、月給金○○円の方であるとは、どうにも合点がゆきませんです。",
              "citation": {
                "source": "愛",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
