        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父は病閹に苦しみ、長い間寝たきりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "病閹のため、彼の気力は日に日に衰えていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "現代医療では、病閹の多くが治療可能になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "たとへば、張三の黒内障が、忽、快方に向つたとか、李四の病閹が、即座に平癒したとか、殆、奇蹟に近い噂が盛に行はれてゐるのである。",
              "citation": {
                "source": "酒虫",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
