        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ピーター・プラングル、ザ、プリックリー、プラングリー、ビーア、ピッカー……」といふ種類のを早口で云はせたりした。",
              "citation": {
                "source": "蓑田先生",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無邪気な諧謔と機智に富んだ洒落とが、ビーアの泡と一緒に口唇から湧き出した。",
              "citation": {
                "source": "老苦",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜はフンク博士の所でビーア・アーベント。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少時、劇に誘はれて大江山の鬼を観たりし事あり、三尺の童子たりし時にすら畏怖の念よりも寧ろ嘲笑の念を抱きたりしを記憶す、而して大江山の鬼は土蜘蛛等と共に中古の鬼物なり、是を彼のバツグビーア、ウイツチなどに比較せばいかに、その妖魅力の差違いかに遠きかは一見して知るべし。",
              "citation": {
                "source": "他界に対する観念",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事などもひどく、ビールやサイダーは、仙台辺で出るフジビーアと云うのが出る。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "我英國の戯曲詩家セークスビーアは説けり。",
              "citation": {
                "source": "弘法大師と景教との關係",
                "author": "イー、エー、ゴルドン",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い色のがカリビーアン・ブルーで、赤いのは確かシシリーアン・レッドと言ったかなあ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
