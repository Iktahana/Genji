    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "帝展というものに対する私の心像を眺める時に先ず眼につくのはあの竹の台の桜の紅葉で、その次には会場の前に並んだ美々しい自動車の群である。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の姿は絹物の美々しいものになった。",
              "citation": {
                "source": "みちのく",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしく美々しい衣装を着た役者がおおぜいではげしい立ち回りをやったり、甲高い悲しい声で歌ったりした。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "美々しい回しをつけた力士が堂々としてにらみ合っていざ組もうとすると、衛士だか行司だかが飛び出して来て引き分け引き止める。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口のホールへ出てみると、美々しいドレスの外人も二組三組そこここに立話をしていたが、まだそんなに込んでもいなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意味からいうと、美々しい女や華奢な男が、天地神明を忘れて、当面の春色に酔って、優越な都会人種をもって任ずる様や、あるいは天下をわがもの顔に得意にふるまうのが羨ましいのです。",
              "citation": {
                "source": "虚子君へ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、福音書の写本などは一見して判るものじゃないから……」と云って、「一四一四年｜聖ガル寺発掘記」の他二冊を脇に取り除け、綸子と尚武革を斜めに貼り混ぜた美々しい装幀の一冊を突き出すと、「紋章学※」と検事は呆れたように叫んだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、その前列で吊具足になっている洗革胴の一つが、これは美々しい獅子噛座のついた、星前立細鍬形の兜を頂いていて、その二つの取り合わせから判断すると、歴然たる置き換えの跡が残っているのです。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故なら、骨牌札を見ると、その人物像はどれもこれも、上下の胴体が左削ぎの斜めに合わされていて、それぞれに肝腎な心臓の部分が、相手の美々しい袖無外套の蔭に隠れているからです。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人連は忽ち美々しい花環のように彼を取りまいて、あらゆる種類の芳香をさながら雲のように辺りに漂わせた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "このねつたいを衆人環視の中ではばからずに言える源太、緋縅か紫裾濃かは知らぬが、ともかくも一方の大将として美々しい鎧兜に威儀を正しながら、地位だの格式だのとけちけちした不純物にいささかもわずらわされることなく平気で天真を流露させることのできる源太。",
              "citation": {
                "source": "余裕のことなど",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その光に照らされて、美々しい夜具が見えていたが、その夜具の襟を洩れて、上品な寝顔の見えるのは金一郎様が睡っておられるのであった。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "美々しい行列が、鳥居をさして練って行くのだが――。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "五、六人の大官が、綺羅星を集めたように美々しい一団となって通りかかった。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "当夜午後九時をすこし廻ったとき、人造大理石の柱も美々しいビルの玄関に、一台の自動車が停った。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "異様の扮装をした十数人の男が、美々しい一挺の輿を守り、若武士の眼前にいるではないか。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "使者と見えて一人の人物――年は若く眉目清秀衣裳大小もまことに美々しい、立派な武士が大刀を提げ今玄関を上がるところであったが、その後につづいて現われたのは、匂うばかりに美しいまだ妙齢の乙女であった。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奇怪な客　というのは数日後、衣裳美々しい立派な武士が、袴広太郎を訪れて、こんなかけ合いをしたからである。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨大な大理石の円柱だの、銅で蔽われた天井だの、黄金を敷いた階段だの、鋼玉を鏤めた石像だの、絹布に刺繍した天蓋だの、美々しい装飾に眩惑され乍ら、私は飽かず堂内を歩き廻っていたものです。",
              "citation": {
                "source": "西班牙の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "社は朱塗金金具で美々しいものであった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "美々しい物の具に三尺の太刀をぬきかざいて、竜馬に泡を食ませながら、これも大音に名乗りをあげて、まつしぐらに「れぷろぼす」へ打つてかかつた。",
              "citation": {
                "source": "きりしとほろ上人伝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "此二つが美々しい装ひで、棚を架いた上に載せてあつた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "美々しい礼服の日清露の顕官が続々到着する。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちのホテル入りは so far 美々しい成功だった。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある驛から二等車に乘りますと、其所に美々しい服裝をした婦人が可愛い水兵服の五六歳の子供と乘つて居ました。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰気極まるこの地下の屍体置場に、このようにも美々しい人物が立並んでいるのは、見る眼にもはなはだ異様であって、この場の風趣に一層の凄味を添えるのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "丹塗りの美々しい籠も、たしかその時のものである。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "王室の紋章を金糸で刺繍した美々しい陣羽織組。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それといふのも四月の朝に、美々しい一人の蒼ざめた騎手、哀れな狂者がおまへの膝に、黙つて坐りにやつて来たため。",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
