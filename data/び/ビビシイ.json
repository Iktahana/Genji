        "examples": {
          "standard": [
            {
              "text": "頂上から見渡す360度のパノラマは、息をのむほど美美しいかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その画家は、光の表現が巧みで、描かれた風景はまるで生きているかのように美美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女のバレエのパフォーマンスは、優雅で、見る者の心を惹きつける美美しいさだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
