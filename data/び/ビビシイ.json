  {
    "uuid": "59f55e59-7657-528e-a912-1e6b5a6f3b00",
    "entry": "美々しい",
    "reading": {
      "primary": "びびしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null,
