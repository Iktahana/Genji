        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分たちは、ルビコン河を渡る英雄ではないのです。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近のテレビコマーシャルで、竹村健一さんが登場して、これからの企業はＤ３Ｃが重要でありそのなかでも特にコンピューターがポイントとなる旨を宣言なすってから、「分かる？",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣ―９８０１の発表当初、パーソナルコンピュータ販売推進本部にはテレビコマーシャルを打つ広告費などとても確保できなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の部屋の戸に鍵もかけずに飛び出したのですからバビコック博士の奥さんは驚いているでしょう。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はバビコック博士夫婦と今夜ライシアム座にウェルシ嬢の演じたトルストイの「復活」を見物しました。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "21いちどでいいんだきみのそばにいくチャンスをくれないか〈ビコーズ〉デイヴ・クラーク・ファイヴ　また圧倒的な緑の季節がやってきて、今年最初の中間試験も終わり、もう緑の濃さに目も慣れてしまった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルビコンは渡らねばならぬ。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノビコオ著、人種論。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はお雪の声に応ずると同時に、了解出来るといふ見得で、どんと胸を叩き、ヤマビコとなつて頭の上を飛んでゐる奇体なワラヒ声を睨みあげた。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さう、恋人で――そして、君のヤマビコ……」「あゝ、それは知らなかつた、道理でキヨちやんは決して僕のところへは……」　私は、悲しみのあまり立ちあがつて、爪立たずには居られないほど強く我とわが耳を釣りあげた。",
              "citation": {
                "source": "ラガド大学参観記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニキーチナ夫人の店へよって、ゲラシモフの詩集 1924 出版と、ノビコフ・プリボーイの短篇集を買った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノビコフ・プリヴォーイが「日本海海戦」を書くことが出来たのは、作家の住宅問題を緩和するために郊外に「創作の家」があったからである。",
              "citation": {
                "source": "近頃の話題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーザーがその留守中にローマに乱の起これるを聞き、出征先より大軍を率いて帰国し、自国に入ろうか入るまいかとルビコン河畔に立ったときは、凡人の考え得られぬ苦心があったであろう。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "外部より見れば、さほどに苦心もなく一｜蹴してルビコン河を越えたらしく見られるも、今もなお歴史上の分岐点として謡われているほど彼の苦心の跡が世界の人心に印してある。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとえ一枚に腰なわを打たれ、はだしで、氷をふんでなあ……いちばん小さいのが、ルドビコといって十二歳、四年生だね。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "やりが胸を貫いたとき、ルドビコは「天国、天国」と言い、指さきがびりびりと動いたそうな。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下を麾いで既にルビコンを渡れる彼は、養和元年六月、越後の住人、城四郎長茂が率ゐる六万の平軍と、横田川を隔てて相対しぬ。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルビコン河は昔ガルリア・チサルピーナ（アルピ内のガルリア）とイタリアとの境を劃せり六四―六六〔スパーニアに〕内亂鎭靜の後イスパニアに行きてポムペイウス一味の者を攻めし事（淨、一八・一〇〇―一〇二參照）〔ドゥラッツオ〕アドリアティコの東岸にあるギリシアの町。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "イビコスの黒鶴等殺す叫や死ぬる歎や7660物に恐れる羽ばたきが聞える。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トイヒマシタガ、ヨシヲサンハモウウミノ中ヘトビコンデシマヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おーい、そこにゐるチビコロたち、ちよつと、みんな来い」　舟は子供たちの手で陸へ押しあげられる。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二歳の少年ルドビコ、十三歳のアントニヨ、十四歳のトマス等も加はつてゐた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "パウロ三木は槍を受けるまで得意の熱弁で説教し、少年ルドビコは槍が腋下に突込んだとき天国々々と叫んだが、暫く両手のみビク／＼動いてのちに絶息。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「軽井沢かしら、強羅かな……ひょっとするアビコかもしれないぞ」「アビコ……どんな字を書くのでしょう」　ハガアスさんが紙とパアカアをよこした。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはいいですが、（孫子）をビコと読むのはどういうわけでしょう」　ハガアスさんに漢字をきかれるとは思っていなかった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "十萬の鐵馬アルベラ（一）のあらしを蹴りて驅けし後三千の精騎ルビコン（二）の流亂して越えし後彼に比べんものやたぞ群山遠く下に見て空に聳ゆるアルプスの高きは君の名なる哉。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "アフリカおよびスペインの大戦役、シシリアの海賊の討滅、ゴールやブルターニュやゲルマニーなどへの文化の輸入、それらの光栄はルビコンの男（シーザー）をおおうている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルビコンを渡ったシーザーは、民衆から来るもろもろの地位をおのれから出るもののように人に授け、元老院に姿を現わさず、エウトロピウスが言ったように、王のごときまたほとんど暴君のごときことを行なった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ルビコンをわたるよ」私はシーザーの気持がわかった。",
              "citation": {
                "source": "穂高岳屏風岩にて",
                "author": "早川鮎子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
