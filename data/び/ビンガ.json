        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サア・リチャアド・ビンガムが、軍隊の司令官として派遣されていたのであるが、十月の初め、ダブリンに到着する早々、彼は陣没した。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを琉球では「ビンガタ」と読み、あの印度の地名「ベンガル」から転化したものと云われる。",
              "citation": {
                "source": "工藝の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽目には、天女――迦陵頻伽が髣髴として舞いつつ、かなでつつ浮出ている。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ残った記念だし、耳の遠い人だけに、迦陵頻伽の歌のように聞きなすったのが、まあ！",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……私と忠蔵がお供でやしたが、若奥様がね、瑞巌寺の欄間に舞つてる、迦陵頻伽と云ふ声でや、　――あの夏になると、此の辺に常夏が沢山咲きませうね――　へい、其の常夏を知らねえだ。",
              "citation": {
                "source": "続銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞い手が歌うところなどは、極楽の迦陵頻伽の声と聞かれた。",
              "citation": {
                "source": "源氏物語",
                "author": "紅葉賀",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと巡り、はやも極楽、絵灯籠｜紅き出口は華やげ楼閣そびえ、頻伽鳥鳴けり。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから極楽に生まれ、浄土へ行っても、自分独りが蓮華の台に安座して、迦陵頻伽の妙なる声をききつつ、百｜味の飲食に舌鼓を打って遊んでいるのでは決してありません。",
              "citation": {
                "source": "般若心経講義",
                "author": "高神覚昇",
                "note": "青空文庫"
              }
            },
            {
              "text": "天人と迦陵頻伽、雲を以て後光の形をなす。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "彫刻修行のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをきいた時の感は、迦陵頻伽の聲とは、かうもあらうかと忝けなかつた。",
              "citation": {
                "source": "四人の兵隊",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると山本先生が、仏教の極楽には蓮花の花が咲いていて、迦陵頻伽という鳥がとても綺麗な声で鳴くそうだが、キリスト教の天国は仏教の極楽とは違って花なぞ咲いていないから、そんな赤い花なぞ描くわけに行かぬ、といって大議論になってしまったことでした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声ざまの美しさは、極楽に棲むとやら承つた伽陵頻伽にも劣るまじい。",
              "citation": {
                "source": "きりしとほろ上人伝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "青銅の鶴は水に濡れた羽交をキラキラと薄陽に光らせ、ああ、今にも飛び立つか、憧がるるがごとくに天心に嘴を差しのばしながら、天竺雪山に棲む迦陵頻伽もかくあろうかと思われる妙音で喨々と唄いつづけているのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからその近所の山には百草もあればまた極楽世界の三宝を囀る迦陵頻伽鳥も居る。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、その素性の知れない女というのが、世にも美しい声の持主で、別に唄を歌ったわけでは無いのですが、話す言葉でまさに迦陵頻伽で、これに比べられる声の美しい人を、レコードに吹込まれて残って居る、近代の名女優サラ・ベルナール以外に私は知りません。",
              "citation": {
                "source": "法悦クラブ",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまたまその間歇遺伝が、此婦人に現われて、異性なる私の耳に、迦陵頻伽と響いたのかもわかりません。",
              "citation": {
                "source": "法悦クラブ",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その迦陵頻伽の声よりも尚お、一段と立ち優る美しさだったのです。",
              "citation": {
                "source": "法悦クラブ",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "千手の手紙には書き洩らしてあるけれども、其処には定めて迦陵頻伽や孔雀や鸚鵡が囀って居るのであろう。",
              "citation": {
                "source": "二人の稚児",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて伽陵頻伽の人鳥が供物を仏前にささげて帰って来ると、誦讃の声につれて菩薩が舞い出す。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伽陵頻伽も二行に対立して、楽を奏しつつ舞う。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "迦陵頻伽かも知れない。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ね、そうなさいよ」　次の間の帳を引けば、当然、山僧が孤床の寝台は、五｜戒三｜帰の菩提の夢、雲冷ややかなはずであるが、どうして、迦陵頻伽の刺繍の襖、紅蓮白蓮の絵障屏も艶かしく、巧雲は顔を袂にくるんだまま、身を捻じ曲げて、「アア」　と、練絹のようにそれへ横たわると、もう身も世もない姿だった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬋娟哥妓袖をつらね、素手弄糸朱唇謡曲迦陵頻伽の声、外面如なるゆゑ自ら双坡楼と家号す、その滑稽此一をもつて知るべし。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオ……何やら美しい……蓮花がにおう……妙なあの音は、笙の音か、頻伽の声か。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……どれ、だいぶ寒い思いをしたから、今夜は八瀬の傾城に会ってその極楽の衾に、迦陵頻伽の声でも聞こう。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、この法の山に分け入って幾日、迦陵頻伽の音にも似た中に心耳を澄まし、血しおの酔いから醒め、われとわが身にかえってみると、彼の胸には、菩提を生じないではいられなかった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "高野の奥の高野杉には、天上の鳥という頻伽の声が、澄みぬいている。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでは、下界でいうもずも、ひよどりも、あらゆる雑鳥も一様に迦陵頻伽のさえずりであった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "宝樹の枝から枝へと飛び交うて居る、色々様々な諸鳥は、白｜鵠、孔雀、舎利、伽陵頻迦、共命などの鳥であろうと思った。",
              "citation": {
                "source": "極楽",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "伽陵頻迦が微妙音に歌って居る空の下で、おかんは積る話を、心のまゝにした。",
              "citation": {
                "source": "極楽",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
