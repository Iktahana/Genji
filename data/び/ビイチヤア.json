        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "説教家としては米国で第一人者と言はれたビイチヤアが、ある時教会でお得意の説教をした。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "説教はいつに異らず面白く出来たので、ビイチヤアは上機嫌で教会を出ようとした。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ビイチヤアはじつと娘の顔を見つめた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "説教家として名高かつたヘンリイ・ワアド・ビイチヤアが、重病にかゝつて、医者のすゝめで誰にも面会謝絶をしてゐた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ビイチヤアは病みやつれた顔に青白い微笑を浮べながらいつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
