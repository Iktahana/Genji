          "literary": [
            {
              "text": "ビツシヨリと汗にぬれた手の平に快くも冷い風が当つたのを感じた。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、本家に戻つて来ると、二枚重ねて着てゐる服は汗でビツシヨリしてゐるし、シヤツも靴下も一刻も早く脱捨ててしまひたい。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はビツシヨリ寢汗をかいて、目が醒める。",
              "citation": {
                "source": "恐怖について",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
