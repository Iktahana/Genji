          "literary": [
            {
              "text": "で、持つたまま大揺りに身躰ごと網を揺れば、矢張揺れて、衣服だか鰭だか、尾毛だか、網の中の婦の姿がふら／＼動くだ。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "厩小屋で、馬が尾毛で、ピシリ／＼と自分の身體をうつ音がした。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "見慣れた尾毛の色が、先ず眼にきたのである。",
              "citation": {
                "source": "黄色い日日",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
