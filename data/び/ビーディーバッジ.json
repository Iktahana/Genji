          "literary": [
            {
              "text": "さっきむこうで、ビーディーバッジをひろったんだ。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きさまたち、おれが、ビーディーバッジをみちにばらまいておいたのにだまされて、やってきたな。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケット小ぞうは、あなの中へおりようとしましたが、ふときがついて、ビーディーバッジをみちにばらまきました。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときです、ビーディーバッジのききめがあらわれました。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
