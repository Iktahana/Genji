        "examples": {
          "standard": [
            {
              "text": "このサラダには、風味豊かな自家製ビネガーをたっぷりかけました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "重曹とビネガーを混ぜてシンクを掃除したら、見違えるほどピカピカになったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この店のオーガニックビネガーは、フルーティーで酸味もまろやかなので気に入っています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "当時の札幌は案外ハイカラな街であったらしく、ヴィネガーもオリーブ油も、簡単に手にはいった。",
              "citation": {
                "source": "サラダの謎",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィネガーと油と塩と辛子とを、いろいろ分量をかえてみても、やはり駄目である。",
              "citation": {
                "source": "サラダの謎",
