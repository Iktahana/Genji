    "definitions": [
      {
        "index": 1,
        "gloss": "fine dress",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新築マンションの竣工検査が行われる数日前に、プロの業者が入り、隅々まで磨き上げる美装作業が完了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は美装を凝らした豪華絢爛なイブニングドレスに身を包み、拍手に包まれながら授賞式の会場に現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高級ホテルのエントランスでは、常にお客様を最高の状態でお迎えするため、毎晩深夜に美装メンテナンスが行われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "バルセロナの市長夫妻が、古風なスペイン服で高い桟敷につくと、金と紅で美装した闘牛士の群が騎馬で出て来て、司会者の前で昔ながらの武士的な挨拶をするのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "引きめぐらした幔幕の内、正面には泰松寺の老師、宗右衛門自身の左右には不具の娘が美装して二人並び、ずつと下つて上品な年増盛りの彼の後妻がつゝましく座つた。",
              "citation": {
                "source": "老主の一時期",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれと同時に日清戦争を相当に遠い過去としてながめうるまでに、その戦役の重い負担から気のゆるんだ人々は、ようやく調整され始めた経済状態の下で、生活の美装という事に傾いていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今なら女優というような眩しい粉黛を凝らした島田夫人の美装は行人の眼を集中し、番町女王としての艶名は隠れなかった。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らないものは芸者でもなし、娘さんでもなし、官員さんの奥様らしくもなしと眼を※って美貌と美装に看惚れたもんだ。",
              "citation": {
                "source": "三十年前の島田沼南",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまのＳＳＳＲ、コサックと農民と労働者が美装の史書へしるした大きな黒い手のあとだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、コペンハアゲンそのものが「こまかい花文字でべったり書かれて、唐草模様の獣皮の表紙に真鍮の鋲を打ち、ゴセックふうの太い釦金で綴じてある」一巻の美装史書だからだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなら一たい、なぜそうこの「儀礼と技芸によって美装されたる牛殺し」が、西班牙民族のうえに尽きざる魅力を投げるか？",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "麺麭屋の仕事場のような温気のなかを饒舌と昂奮と美装とが共通の興味のために集合し、練り歩き、揺れ動いていた。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぞべらも、その撞木娘もともに多く美装した娘であるが、これがまたへんに凄い不思議な謎の味を持っていると思う。",
              "citation": {
                "source": "ばけものばなし",
                "author": "岸田劉生",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪しく尼君は思うのであるが、今度のがものを分明にしてくれる兄の手紙であろう、使いでもあろうと思い、「こちらへ」　と言わせると、きれいなきゃしゃな姿で美装した童が縁を歩いて来た。",
              "citation": {
                "source": "源氏物語",
                "author": "夢の浮橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ・アリは、夜会にでも出席するように美装を凝らして人々を驚倒させた。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも、座席と便所と売店との間を、廿日鼠の如く、無表情にキリキリ舞ひをして歩く美装の淑女は、一体、あれや、なんですか。",
              "citation": {
                "source": "幕間",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "まれに出版される書物を見れば通俗的な何々講習会の講演の原稿が美装を凝らして現われたのにすぎない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "拝殿の前面には、美装の人々が立ち並び、衣冠束帯の神官から清め祓いを受け、白紙に包んだ御供物を貰い、そして右手の通路から退出して来るのである。",
              "citation": {
                "source": "母親",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "山本有三氏は、要するにこの一作によつて、更に古典的な新風をわが文壇にもたらしたといへるが、氏の健康をいくたびか案じさせた長日月の努力が、やうやく酬いられて、今、この美装の名篇を机上に見る愉快は、また格別である。",
              "citation": {
                "source": "山本有三氏作「真実一路」について",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "労働最中に美装した都人士女の訪問でも受けると、彼はます／＼得意である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやという魚は、おいしいとほめるほどでもないが、産卵期が近づくと、にわかに活動が盛んになってきて、頭から横腹、尾の端まで紅殻を刷いたように薄紅の彩が浮かび、美装を誇るかに似て麗艶となるのである。",
              "citation": {
                "source": "楢の若葉",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒水にすむ鮠は、まことに清麗類なき美装の持主に御座候。",
              "citation": {
                "source": "寒鮠の記",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、鱗を白い小さい玉と、紅の小さい玉とが不規則に飾って、まことに美装の持ち主である。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "小冊子なれども斯界の研究書として欠くべからざるものにして、また別に美装したる Masters of Ukiyoye（『浮世絵の名家』）の著あり。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときあちらから、紳士ふうの若い男と、頭髪をカールして、美装した女の人がきかかり、やがて彼とすれちがったが、その人たちは、まんざら学問のない人とは思われなかったのに、やはり徽章には気のつかぬようなようすでいきすぎてしまいました。",
              "citation": {
                "source": "村へ帰った傷兵",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車の爆音が美装した貴婦人の着物が　指環がおれたちの頭上で舞踏しているダンス・マカーブル、……グルルル……ロンド！",
              "citation": {
                "source": "手をさし延べよう！",
                "author": "陀田勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ History of Gambling（博奕史）と云うのが、ことさらに美装して、一番真中に飾られてあったので、それが幾分か彼の頭に突飛な新し味を加えただけであった。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その絵馬には数学の題術を記し、円や三角など色彩を施して美装し、他の絵馬と同じような形式に仕立てて拝殿などに奉納したものも幾らもあった。",
              "citation": {
                "source": "芸術と数学及び科学",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "製本屋さんは惘れて返事も出来なかったであろうが、後年、このお母さんの祈りがかなえられ、堀辰雄の生涯の書物はどれも凝った美装の書物ばかりであった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨木の静寂な影、四角くて意匠の上品な灰色の石、奇麗な蝶々のように飛び廻る美装の子供何百人……それはまことに心を魅するような景色であった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の『シラノ猿猴格闘録』は小型の渋い美装本であるが、僕はそれを手に把つて眤と眺め入りながら、これは大した代物だぞ、と思つた。",
              "citation": {
                "source": "書狼書豚",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち読者諸君はこの物語の初めの方に遡って、これも私が万平ホテルに初めてナリン太子を訪問した時に何か太子と深い交渉のあるらしい美装の一貴婦人に怪訝な思いを懐いたことを記憶しておいでであろうか。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＭＩＳＳ・キャゼリンはすなわちその時にジャヴェリと応接間で話をしていたあの美装の貴婦人なのであった。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
