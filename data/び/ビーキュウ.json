        "examples": {
          "standard": [
            {
              "text": "この映画は、Ｂ級だけど意外と面白かったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はプロ野球のＢ級ライセンスを取得し、将来は審判員を目指している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今回の作品はＢ級のアクション映画だが、派手な演出が意外と癖になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "乙はＢ級の無名選手だが、このレースでは一着を出している。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
                "note": "青空文庫"
              }
            },
            {
              "text": "丙もＢ級の新人で十七歳。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はＢ級から一躍とびあがってＡ級の上位三者をなぎ倒して挑戦者になったが、その落付きと年間のめざましい戦績から、世間の大半は彼の勝利、大山次期名人を疑わなかったようである。",
              "citation": {
                "source": "九段",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがため、店内に居並ぶ客種は普通の寿司屋にみるように、Ａ級、Ｂ級、Ｃ級と混合していないのが特色である。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ級にあらずんばＢ級といった具合で、夜となく昼となく、すさまじい勢いで繁盛この上もない。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番強い選手がアッサリ消える（着外になるの意）のは伊東競輪では特に再々あることで、この日のＢ級の本命選手が次々と敗れているから、こういう噂がとべば、素人は武田の頭や二着の券にはふりむかなくなる。",
              "citation": {
                "source": "光を覆うものなし",
                "author": "――競輪不正事件――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
