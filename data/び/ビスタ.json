        "examples": {
          "standard": [
            {
              "text": "観光列車には、景色を楽しむためのビスタカーが連結されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ビスタカーの大きな窓から、流れるような緑の風景を眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この区間は、特にビスタカーからの眺めが良いことで知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "かつてのテレビスター、２００９年テレビバラエティの主演女優だ。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はコーラスガールやダンサー、テレビスターに弱い。",
              "citation": {
                "source": "理想",
                "author": "THE IDEAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くから聞こえて来る太鼓の音に聞き耳をたてるヒロインの姿から、一隊の兵士の行進している長い市街のヴィスタが呼び出され描き出される。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルニナ群山の中心にあたるベルラヴィスタ Bellavista のアレトから、真北に四里にわたって流れ落ちるこの氷河の空には、四千米突に近い山々が、折り重なり入り乱れて、最高峰のピッツ・ベルニナ Piz Bernina, 4052m. も、やや右よりに仰がれる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはブエナ・ヴィスタ〔一八四九年のメキシコ戦争中の一激戦地〕の前線に半時間踏みとまった人々の勇気よりは、除雪機関車を冬の根城とする人々の長つづきのする快活な勇敢さに打たれる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
