        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "二人の関係は弥久にわたり、今では家族以上の絆で結ばれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "弥久の眠りから覚めたかのように、その古城に再び活気が戻った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この伝統行事が弥久に引き継がれていくことを、心から願っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "手紙慶応三年九月二十四日　渡辺弥久馬あて坂本龍馬-------------------------------------------------------【テキスト中に現れる記号について】：ルビ（例）参がけ：入力者注　主に外字の説明や、傍点の位置の指定（例）是も三大隊斗かとも被存候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年九月二十四日　渡辺弥久馬あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "「相変らずでございます」「曠日弥久というところかな？",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
