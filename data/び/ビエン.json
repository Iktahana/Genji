        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "七　馬は、霜柱を、さくさく砕いて、白い鼻煙を、長く吹いていた。",
              "citation": {
                "source": "寛永武道鑑",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳列棚一ぱいぎつしりつまつた鼻煙壺のコレクションだ。",
              "citation": {
                "source": "夜の鳥",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻煙壺といふから、まあ嗅タバコの入れ物だらう。",
              "citation": {
                "source": "夜の鳥",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
