    "definitions": [
      {
        "index": 1,
        "gloss": "last (on the list)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "テストの成績が発表され、自分の名前がびけにあるのを見て肩を落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "参加者の名簿を確認したところ、私の名前はどうやらびけに記載されているようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "何をやるにも要領が悪く、いつも名簿のびけにいるような子供だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "左に従い来る山々｜山骨黄色く現われてまばらなる小松ちびけたり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二羽の烏の争ひて、　　　　　　さつと落ち入る杉ばやし、このとき大気飽和して、　　　　霧は氷と結びけり。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "海からあがって来た風は軽便の煙を陸の方へ、その走る方へ吹きなびける。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　思はず振向くと、ふと背後に立つて、暮方の色に紛るゝものは、あゝ何處かで見た……大びけ過ぎの遣手部屋か、否、四谷の閻魔堂か、否、前刻の閻王の膝の蔭か、否。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行届いた小取まわしで、大びけすぎの小酒もり。",
              "citation": {
                "source": "鷭狩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その実は昨夜の酒を持越しのため、四時びけの処を待兼ねて、ちと早めに出た処、いささか懐中に心得あり。",
              "citation": {
                "source": "妖術",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "八畳一杯｜赫と陽気で、ちょうどその時分に、中びけの鉄棒が、近くから遠くへ、次第に幽かになって廻ったが、その音の身に染みたは、浦里時代の事であろう。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士　――また冷返る夕嵐、雪の松原、この世から、かかる苦患におう亡日、島田乱れてはらはらはら、顔にはいつもはんげしょう、縛られし手の冷たさは、我身一つの寒の入、涙ぞ指の爪とりよし、袖に氷を結びけり。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "僧都　――袖に氷を結びけり。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「人ッこ一人、……大びけ過ぎより、しんとして薄気味の悪いよう。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　話に聞いた振袖新造が――台のものあらしといって、大びけ過ぎに女郎屋の廊下へ出ましたと――狸に抱かれたような声を出して、夢中で小一町駆出しましたが、振向いても、立って待っても、影も形も見えません、もう朝もやが白んで来ました。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白帆あちこち、處々煙突の煙たなびけり、振さけ見れば雲もなきに、傍には大樹蒼空を蔽ひて物ぐらく、呪の釘もあるべき幹なり。",
              "citation": {
                "source": "彌次行",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "両側に見好げなる仕舞家のみぞ並びける。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "休みながらお話しましょう」　智子はやや呆けた茅花の穂を二三本手でなびけて、その上に大形の白ハンカチを敷いた。",
              "citation": {
                "source": "明暗",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌天竜の水上清み雪祭る族が鬼はよに遊びける「雪祭」幽けきかも「雪祭」幽けきかも、忠はうれしきかも。",
              "citation": {
                "source": "黒檜",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのぼのと呼びける風、電波だけそれに触れてる。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はづかなるあるかなきかの金を得て、かきよせて、市のちまたに米買ふと破れし嚢を手にさげて、これに米、すこし賜べよと乞ひのめば入れて賜びけり、さらさらと入れて賜びけり。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "男ごころよひたぶる恋ふと、下ふかく燃ゆる思の、えは堪へね、なほし堪ふると、遊びつつ遊び彫りけむ、くるしくも寂びて寂びけむ、外には見せずも。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "高うして吹雪すらしか、かすかにも雪煙り立ち、その煙絶えずなびけり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよに風も寂びけり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はづかなるあるかなきかの金を得て、かきよせて、市のちまたに米買ふと破れし嚢を手にさげて、これに米、すこし賜べよと乞ひのめば、入れて賜びけり、さらさらと入れて賜びけり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "男ごころよ、ひたぶる恋ふと、下ふかく燃ゆる思の、えは堪へね、なほし堪ふると、遊びつつ、遊び彫りけむ、くるしくも寂びつつ寂びけむ、外には見せずも。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "高うして吹雪すらしか、かすかにも雪煙立ち、その煙絶えずなびけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪しくも赤き巻髭、髭細の蓮華なす華、咲き盛るその華見れば、おのづから秋も澄みけり、いよいよに風も寂びけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "子の十郎直基（隆基という本もある）は、父が撃たれたと聞くと、せめて父が討死せしところを見ばやと、馬を返す所を、青木所左衛門出で合い、「音に聞えし真柄殿、何処へ行き給うぞや、引返し勝負あれ」と呼びければ、「引くとは何事ぞ、悪い男の言葉｜哉。",
              "citation": {
                "source": "姉川合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方まで庭前の楓の青葉を吹きなびけていた西風がぴったりないで静かな晩であった。",
              "citation": {
                "source": "雀が森の怪異",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペツポの叫びけるやう。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人も我が樸直なるをや喜びけん、書を取りて我にわたしていふやう。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
