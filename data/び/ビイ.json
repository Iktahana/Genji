[
  {
    "uuid": "f893b954-0dcf-5f11-8dd2-8e0b1579c3a5",
    "entry": "微意",
    "reading": {
      "primary": "びい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "small token (of gratitude)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お世話になった先生に、感謝の気持ちを込めて、ささやかな微意を贈りました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "遠方から来てくれた友人へ、お礼として、ささやかな微意ですが、どうぞお受け取りください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "日頃の感謝を伝えたいと思い、上司に少額のプレゼントという名の微意を渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それをここに掲げるのは、故人を愛する人達のために、一つでも多くの思い出を供したい微意に外ならぬ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "――……この危機にのぞみ、我々一同が力を合わせ、外、過激思想、都会の頽風と戦い、内、剛毅、相互扶助の気質を養い、もって我Ｓ村の健全なる発達を図りたい微意であるのであります。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "編者の微意は本文中の「開会の辞」に悉されているから、ここに重ねて言わない。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "凡例",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治の劇談を団菊左の死に止めたのは、“筆を獲麟に絶つ”の微意にほかならない。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "君が結婚しようとする雪江さんは、僕もまんざら知らぬ仲ではないから、君たちの永遠の幸福を祈ってやまぬ僕は、こゝに君に向って恭しく恋愛曲線を捧げ、以て微意を表したいと思うのである。",
              "citation": {
                "source": "恋愛曲線",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分等夫妻の感謝の微意を表すには、この皿を貴下の優秀な蒐集の一部に加えるのが最も適当だと思われる。",
              "citation": {
                "source": "伊太利亜の古陶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬へば高きに登るに、卑きよりし、遠きに至るに近きよりするが如く、小学を治め字句を校讐するは、細砕の末業に似たれども、必ずこれをなさざれば、聖人の大道微意を明むること能はず。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて斯の如く小学に熟練して後に、六経を窮めたらむには、聖人の大道微意に通達すること必ず成就すべし」といっている。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはせめてこの優に培養れた帝劇の女優たちだけでも、もすこし微意を表して、所属劇場で許さなくとも、女優たちの運動があって、かの女の最終の舞台を飾り、淋しい心であろう先輩を悦ばせてもよかったであろうにと思った。",
              "citation": {
                "source": "マダム貞奴",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩が只管我帝室を仰て全國學術の中心たらんことを願ふも、其微意は蓋し此に在て存するものなり。",
              "citation": {
                "source": "帝室論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "父がこの雑談集を公に致しますのも、恐らく法律談は乾燥であるという濡衣を干したい微意でありましょう。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "手と目より偉大なる自然の制裁を親切に感受して、石火の一拶に本来の面目に逢着せしむるの微意にほかならぬ。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして、僕の意味する日本的なることが然ういふ新らたな発展に結びつかうとしてゐるために、特に貴兄のやうな外国文学に堪能な士から日本人をききたいといふ僕の微意も分つていただけるでせう。",
              "citation": {
                "source": "日本人に就て",
                "author": "――中島健蔵氏へ質問――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと共に、此章が、その下された暗示から成長して、ともかくも古代生活の大きな一方面に探りだけでも入れる事の出来た業蹟を見て頂いて、行供養の微意をお目にかけようと思ふのである。",
              "citation": {
                "source": "語部と叙事詩と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも雑誌のためよかれかしと願う微意に外ならざれば不悪御推読願上候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同一の問題に関して、多くの例証を挙ぐる場合に於て、外国の神話よりの例証の簡にして、日本神話よりのそれの、比較的に精なるも、著者の微意の存する所なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "つつがなく日光御用おはたしにあいなるようにと、主人将監の微意にござりまする。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、家庭の御伽話に資せんとするの微意なり。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ余が微意は、さきに述ぶるがごとく、国家の隆治を助けて国民の本分を尽くさんとするにあれば、もしこのことにして幸いに文運の万一を裨補することを得ば、いずれの本懐かこれに過ぎん。",
              "citation": {
                "source": "妖怪学講義",
                "author": "緒言",
                "note": "青空文庫"
              }
            },
            {
              "text": "かういふ利益と亡友に対する追慕の微意がない位なら芥川賞の審査員などもあまり自分の柄ではない。",
              "citation": {
                "source": "或る文学青年像",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ偏にお得意の御愛顧の賜物であると思うと、私は何かしてこの機会に謝恩の微意を表したくなった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこれを私の一存でやったから、あとで「宝石」の編輯の人たちに大変恨まれることになったが、私の微意を察して御カンベンねがいたい。",
              "citation": {
                "source": "私の探偵小説",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "わりあいに私心も少なく、己れを利する目的もなく、多少ともより良い祖国の再建を思っての微意が一部の人々の理解を得たことは幸福であった。",
              "citation": {
                "source": "光を覆うものなし",
                "author": "――競輪不正事件――",
                "note": "青空文庫"
              }
            },
            {
              "text": "中尉遺愛のツワィス望遠鏡とロンジン夜光時計とだけは、懇請に任せ我ら一同よりの微意として、中尉の岳父たるべかりしメラニデス氏にこれを贈りました。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の書を著した作者の微意は、実に其処に存するのである。",
              "citation": {
                "source": "武州公秘話",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とぞ今度の戯曲並びに今後の作を貴下にささげんとの微意を御受け下されたく候。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで、附記で、さんざん、ダボラをふきとばして恐縮ですが、作者の意図するところは、皆さんに、知的な娯楽を提供し、クソ面白くもない世の中に、何日、何時間か、たのしい休養のゲームを贈り物し、一つ無邪気にシカメッ面のシワの洗濯をやりましょう、という微意にほかなりません。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "箱根の峠を越した後再び丹沢山大山の影響で吹き上がる風はねずみ色の厚みのある雲をかもしてそれが旗のように斜めになびいていた。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "金魚藻、梅鉢藻だのという水草が、女の髪の毛のようになびいている中を、子供たちが泳いでいる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた、びいどろといふ色硝子で鯛や花を打出してあるおはじきが好きになつたし、南京玉が好きになつた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
