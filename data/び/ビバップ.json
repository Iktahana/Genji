        "examples": {
          "standard": [
            {
              "text": "夜更けまで、サックスのソロが響き渡るビバップの生演奏に酔いしれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は1940年代に隆盛したビバップのレコードを、熱心に収集している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ビバップは、その後のモダンジャズに革新的な影響を与えた音楽ジャンルだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "このあと、白人のためのつまらないスイングがおこり、スイングと同時に、アメリカのなかで白人に認められる黒人芸術としての集団ジャズがあり、これが、ビーバップという緊張したジャズに解体されると、アメリカから自ら遠くはなれようとする黒人の心の動きになるのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビートの詩人たち同様に、ビーバップの白人たちは、自分の音の世界に内向することによる自己の確認のよろこびに支えられ、黒人たちは、アフリカの複合リズムのなかに再びみつけた黒人の誇りに、支えられていた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
