        "examples": {
          "standard": [
            {
              "text": "その女優は、内面から輝くようなビューティーを持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はビューティーコンテストで優勝し、その美しさが世界に認められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最近の美容業界では、健康的なビューティーが注目されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "戦前のエスキーモの、ファンシー・アイスクリーム、シンバシ・ビューティーは正に銀座名物と言ってよかろう。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビューティーばかりではなく此店のチョコレートと、挽茶のアイスクリームのよかったことも忘れない。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "「令子ちゃん、いつも美しいですね」　ビューティフルを直訳したような「美しいですね」に、慶一は小さく笑った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ハイヌーン』が猛烈社員のようなものの原型なら、シンギング・カウボーイは、日本でも風俗的に言われてはじめた、ビューティフルの原点のひとつだろう。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "剃って、シャンプーして、ついでに前のビューティパーラーでマニキュアをしてみる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
