        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は、ビビッドなオレンジ色のワンピースを着て、パーティー会場でもひときわ目立っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "あの時の衝撃的な出来事は、今でも私の記憶にビビッドな色彩として残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "著者の文章は、情景描写がビビッドで、読んでいるこちらまでその場にいるような感覚になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それがとてもヴィヴィッドでしてね、私はよくその部屋へ行ったものです」　そんなことまで話すＫ君でした。",
              "citation": {
                "source": "Ｋの昇天",
                "author": "――或はＫの溺死",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校の方も、板垣鷹穂氏らの都市生活研究会とかがこしらえたのより遙にヴィヴィッドであるし、生活が出ていてよかった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にヴィヴィッドでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "編輯をする人と出版をする人とでは、この点で全く相反したような見解にいて、今日の文化性としてなかなかヴィヴィッドです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、作者が我々に最も近い、最もヴィヴィッドな問題を小さなエピソードとしてではなく、大きな時代的スケールの中に描き出そうとした努力のなかには、プロレタリア文学の今後の発展に対する一つの重要な暗示が含まれている」と。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家がモチーフをつよく自身の芸術的魂のうちに求めるという態度こそ、現実と自分というものの間に可能な限り自分からのヴィヴィッドで鋭い関係をとらえようとすることになる。",
              "citation": {
                "source": "作家に語りかける言葉",
                "author": "――『現代文学論』にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでは、一人の夢見る能力に恵まれたドイツ人学生について語られるのだが、この学生にとっては睡眠と覚醒における通常の状況が逆転し、眠りの中の人生こそが真実であり、目覚めている時間など、睡眠状態の中で受ける強烈かつヴィヴィッドな興味の合間に存在する長くてつまらない拘留期間に過ぎないのだ。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、いつか見せられた故人のアルバムのなかの數葉の寫眞なんぞともちがつた感じで、彼女の性格の或一面が妙にヴィヴィドに出てゐる、節子の自畫像にちがひなかつた。",
              "citation": {
                "source": "おもかげ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家としての独歩の面目は、到るところに発揮されて、当時の海戦と艦上生活の有様をヴィヴィットに伝え得るものがある。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
