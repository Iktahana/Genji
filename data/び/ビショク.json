[
  {
    "uuid": "f41918e7-3662-561b-ac57-f7c0e53f8ee6",
    "entry": "美食",
    "reading": {
      "primary": "びしょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
