    },
    "definitions": [
      {
        "index": 1,
        "gloss": "gourmet food",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は旅行先で地元の美食を堪能するのが一番の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このレストランは、世界中の美食家たちを唸らせる料理を提供する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "健康を意識しつつも、たまには美食を楽しむのも良い気分転換になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "歌と舞ひと、美食と酒の國です。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうですか、龍宮は歌と舞ひと、美食と酒の國だと私はお誘ひする時にあなたに申し上げた筈ですが、どうですか、御想像と違ひましたか？",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇室ではそれをよみせられ、召し上げられて飽衣美食でもてなしました。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗食故に長寿して居た生命が、美食に遇ってたちまち破損して仕舞ったのだそうです。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂美食に飽きた食通がうまいものを探すのは中流の料理屋に於てである。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "美食探険家はこういう中流料理屋のスペシャリテの中に思わぬ味を探し当てることがあるという。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "都会育ちの美食家の父娘は、夕飯の膳を一々｜伊勢丹とかその他｜洲崎界隈の料理屋から取り寄せた。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていつかそれに気がついてみると、栄養や安静が彼に浸潤した、美食に対する嗜好や安逸や怯懦は、彼から生きていこうとする意志をだんだんに持ち去っていた。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、これこそ貪婪な美食主義のはかない片鱗ではなからうか。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇室ではそれを嘉せられ、召し上げられて飽衣美食でもてなしました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗食故に長寿していた生命が、美食に遇ってたちまち破損してしまったのだそうです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は肥っているが美食に疲れその皮膚は不自然に箍になって弛んでいる。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌と舞ひと、美食と酒の国です。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうですか、竜宮は歌と舞ひと、美食と酒の国だと私はお誘ひする時にあなたに申し上げた筈ですが、どうですか、御想像と違ひましたか？",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は美食に事欠かぬのみならず、天稟から、料理の秘奥を感取った。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二、身一つに美食を好まず。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二、あながち美食を好むにはあらねど、きょうのおかずは？",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し又僻地寒村より都會に出でて、美饌嘉肴を得るに至つたと云ふが如き場合にも、其の失つた良状態が得た所よりも少い時は、同じく其の人の身體状態が良好になる事は、但馬の牛が神戸附近に出でて、美食を得る爲に、俄に毛色も美しくなり、肉置も十分に發達するが如くで有らう。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は毎日海亀の脂や石焼の仔豚や人魚の胎児や蝙蝠の仔の蒸焼などの美食に※いているので、彼の腹は脂ぎって孕み豚の如くにふくらんでいる。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえば、夢の中で摂る美食の所為であろうか、彼は近頃めっきり肥ってきた。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何に彼が夜毎美食に※き足るか。",
              "citation": {
                "source": "南島譚",
                "author": "幸福",
                "note": "青空文庫"
              }
            },
            {
              "text": "美食家の齊の桓公が己の未だ味はつたことのない珍味を求めた時、厨宰の易牙は己が息子を蒸燒にして之をすすめた。",
              "citation": {
                "source": "名人傳",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "美食家の斉の桓公が己のいまだ味わったことのない珍味を求めた時、厨宰の易牙は己が息子を蒸焼にしてこれをすすめた。",
              "citation": {
                "source": "名人伝",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はいったい美食すぎるよ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あっはっはっ、美食家の君にはたまるまい。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "美衣美食の生活者が、美衣美食を知らぬと同じ悲しさが梅三爺の上にもあった。",
              "citation": {
                "source": "土竜",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕達はきつと町にゐる時の何倍もの美食にふけることが出来るだらう！",
              "citation": {
                "source": "ビルヂングと月",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
