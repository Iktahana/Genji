[
  {
    "uuid": "fbbbe745-2f57-5034-89f2-fda72ff66cf4",
    "entry": "美辞",
    "reading": {
      "primary": "びじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
