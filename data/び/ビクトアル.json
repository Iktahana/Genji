          "literary": [
            {
              "text": "』『例のルパンの乳母‥‥』『ビクトアル？",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーニャやビクトアルの如き小魚なら、何もあなたのお手を煩わしはしません。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが今晩、ソーニャと乳母のビクトアルが、階段の蔭の真暗な所で立話をしているのを盗み聞きますと、乳母が召使を呼ぶに『坊ちゃん坊ちゃん』と言ってるじゃありませんか。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビクトアルは今でも奴の事を子供のように思って、いつでもこう呼んでいるのです。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ソーニャとビクトアルは三階に！",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣のビクトアルの部屋へ行った。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
