          "standard": [],
          "literary": [
            {
              "text": "上のサネカズラの和名のほかに、この植物には上に書いたビナンカズラとビンツケカズラ、トロロカズラ、フノリ、フノリカズラ、ビナンセキ、ビジンソウなどの称えがある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ富山県の中部でこの花をケイセバナ、島根県の西端でこれをビジンソウまたはミヤコワスレという名を存するを知るのみである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
