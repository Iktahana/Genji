          "literary": [
            {
              "text": "おもちゃではポペンというものが一時流行した。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹くのと吸うのを交互に繰り返すと、ポペン／＼／＼というふうな音を出す。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "むきになって理屈を言ってる鼻の先へもって来てポペンポペンとやられると、あらゆる論理や哲学などが一ぺんに吹き散らされるところに妙味があったようにも思われる。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
