        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チャムバーレンという人が云った皮肉な詞に「日本人に独自なものは風呂桶とポエトリーだけだ」というのがある。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その不合理不経済なところにポエトリーはあるが現代には少し不向きである。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この論文の始めの序説中、日本人の独創能力に乏しい事を述べた一節に、チャンバレーン博士の言ったという言葉を引いて、「この邦土で純粋に日本固有というべきものはただ二つ、それは風呂桶とそうしてポエトリーである」と述べている。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただこのいわゆるポエトリーがここで何をさすかが問題である。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "八雲氏の夫人が古本屋から掘り出して来たという「狂歌百物語」の中から気に入った四十八首を英訳したのが「ゴブリン・ポエトリー」という題で既刊の著書中に採録されている。",
              "citation": {
                "source": "小泉八雲秘稿画本「妖魔詩話」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "メーテルリンクのエメルソン論が、去年の『ポエトローア』に出たが、まだ見ないのは殘念だ。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "又叙情、世相の二派を立つるときは、世相詩人を以て「ドラマチスト」とし、以て叙情詩人の「リリカル、ポエト」に對したり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンクロフトはうまい、スタンバアグは立派なポエトだ。",
              "citation": {
                "source": "青べか日記",
                "author": "――吾が生活　し・さ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
