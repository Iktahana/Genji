        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポンソンビーの大なる竜騎兵も壊滅していた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンソンビーも七つの槍を被ってたおれていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンソンビーは粉砕されたが、ソマーセットは残っていたのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルコンネの師団が、歩兵と騎兵とに挾撃され、麦畑の中でベストとパックからねらい撃ちにされ、ポンソンビーになぎ払われたこと。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　ポンソンビ・フェーヌ君は英国から遣って来て、もう二十年近くも日本の神道を研究している。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊野は素より日本一の烏の楽土だが、なおこの以外にも何ヶ所とか、烏祭のあるお社をポンソンビ君は知っている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰か我邦にもポンソンビさんの如き人が現われて、丹念に各地の例を比較してくれるとよいがと思う。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正六年、私が香港に行った時、そこのイギリス総督の私設秘書をしている人で、ポンソンビ・フェーン・リチャードという大変な日本通の人がおった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスの名家ポンソンビ家の一人息子に生れ、フェーンという財産家であった叔母の跡取りにもなったので、ダブル・ネーム（二重苗字）を名乗っていた、大した家柄の人であった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
