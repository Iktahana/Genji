        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "槇子は、きッとキャラコさんの方へふりむくと、「おやッ、笑ったナ」　蒼くなって、眼をすえてキャラコさんをにらみつけていたが、突然、「生意気だよッ、貧乏人」　と、叫ぶと、いま、ボーイが置いて行ったばかしの熱いポタアジュのはいった皿を取りあげてキャラコさんの顔へ投げつけた。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "身をかわすひまもなく、皿はまともにキャラコさんの胸にあたって、顎から胸へかけてどっぷりとポタアジュを浴びてしまった。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "青豆のはいったどろどろのポタアジュが、衿から胸の中へ流れ込んで、飛びあがるほど熱いのを、そっと奥歯をかんでこらえた。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼食＝オードヴル、ポタアジュ、車海老のフライ、鶏とヌードル。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼食＝ポタアジュ、よし。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、これから、先ず、オードヴルから、スープは、コンソメ、ポタアジュの二つを平げ、順々に十数種を食うことになるのである。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、スープの部へ入ると、２は、ポタアジュで、３が、コンソメである。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、僕のところへだけ、スープが、コンソメから、ポタアジュと運ばれるので、「おや？",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "悦ちゃんを御馳走してゐた、ポタアジュ、スクラムブルドエグ・ベーコン、ムサカと飯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼食、ポタアジュうまし、ボイル・ディナーとポークソーセージ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリルで食事、ポタアジュ、ポーチエッグ・ノルマンディ、ポークソーセージ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼終り、新大阪へ、グリルで、ポタアジュ、ベーコンエグス、チキン何とか、うまかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "メロンが出て、ポタアジュ、お代りをして、次スッポンのクリームソース、こいつを三つも食ったので、こたへた、鴨のジェリー、トルネードはお代りの元気なし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュの温度がよかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテ・グリで一人で大急行の食事、ポタアジュとミニツステーキのみ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小松へ寄って理髪、バッタリ坂本に逢ひ、珍しや八洲亭でポタアジュ、ハムエグス、タンシチュウ、コロッケ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "終って、東京会館でポタアジュと二皿食って、一時に稽古場へ入る、帝劇三階。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "あやふやだが、一回の仕事故いゝ加減にして、風月へ行って食事、ポタアジュ、鮃、マカロニ、肉、チキンライスそして冷コーヒーに菓子。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座へ出て、風月で一人で食事、ポタアジュ、フィレソール・ノルマンド、マカロニ、チキンパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤を誘って、アラスカで夕食、トマトのポタアジュと、チキンクリーム煮にコーン・フリッター。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木静一と東京会館へ行って食事、ポタアジュ、レタス、ミニツステーキとマカロニ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュ、フィレソール、羊肉のピラフ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュ、舌平目グラタン、スコットライス。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュなどグンと味が落ちた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュとスパゲティ・ミートボール、冷チキン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュ・ハムエグスと肉を食ひ、冷紅茶のんで室へ帰ると又寝てしまった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポタアジュとビフテキ、コーヒーに砂糖少々。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時迄見て、かどやへ寄り、ポタアジュにオムレツ、クリームチキン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロビーで清と遊び、平野と又十一時にグリルへ、ポタアジュとミニツステーキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ないので、山王ホテルで、ポタアジュ、オムレツ、ビフテキ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
