        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ある日、私がパリで散髪をしていると理髪師が私に向ってデ・ジャポネー（日本人）は騎兵は要らぬそうですねといった。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "何のことかと聞くとデジャ（既に）ポネー（小馬）だからといった。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんもりした老樹で、自動車をとめて休んでゐると、子供達が、トンボ・ヤポネーゼつて寄つて来たわね。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ジュヌーコンプランパージャポネーズ（私は日本語がわからん）と云いよる。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "北イタリヤ、殊に此辺では、此ごろ大分、日本式の庭園や植物に興味をもって、ジャルディノ・ジャポネーゼなんて、名のりをあげてるのが少なくないが、矢張日本に於ける洋式庭園と同じくで、頗る変てこなのに感心してしまう。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "我其言に從ひてしか行へり、そを悟る父ははげしき呪咀の言放ちて凄き＊復讐の神女に乞へり、彼の膝攀づべき者の一人だも　455われより生れ出でざれと――其誓願を納受せる深き地底の＊ヂュウス又＊ペルセポネーア恐るべし。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち殆どすべての健康なヒトの腹腔穿刺はトレポネーマ・パリドムの存在を示すが宿主は殆ど意識しないであろう。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし在ったとしても比較的に稀でありトレポネーマ・パリドゥムの寄生が新しい様相を示し1500年の流行後の病気にくらべるとずっと軽症だった筈である。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
