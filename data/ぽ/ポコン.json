        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ウェーヴを弾ね除けた額は、円くぽこんと盛上って、それから下は、大きな鼻を除いて、中窪みに見えた。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の一角がぽこんと凹んだやうな空虚な寂しさであつた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと、ぽこんと跳ね上るように高く水の上に現われ出ました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯がぽこんぽこんと煮えて來ると、卵もぽこんぽこんと鍋の底で運動を始めました。",
              "citation": {
                "source": "クララ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、爆弾の胴中に、ぽこんと四角な穴が明いた。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、壁の上に、ぽこんと四角な窓があいた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "田川先生はもういっぺん水瓜の腹をぽこんぽこんと打診してみて、ちょうどいいかげんに熟れておりますよ、と請け合った。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、腹がむくむくと脹れ上ってきて、セルロイドの人形の腹のように張りきって、叩いたらぽこんぽこんと音を立てて、どうにも始末におえなくなって……。",
              "citation": {
                "source": "幻の彼方",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽこん、とごむ靴ははねかへりました。",
              "citation": {
                "source": "ごわごわごむ靴",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなお腹が、ぽこんと丸く、面白く目立つ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "脚がぶくぶくにはれて、向う脛を指で押すと、ポコンと引っこんで、歩けない娘も帰って来た。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや自然の好は妙なものだ、すらりとした姉の方が、細長い信玄袋を提げて、肩幅の広い、背の低い方が、ポコンと四角張って、胴の膨れた鞄を持っている、と、ふとおかしく思うほど、幻は現実に、お伽の坊やは、芸妓づれのいやな小父さんになりましたよ。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃では最うポコンのベコンでも無くなった。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三もステッキを突きながら所在なさに岩を伝って、葉子たちの姿の見えないような遠いところまで出て行って、岩鼻に蹲居んで爽やかな微風に頸元を吹かれながら、持前のヒポコンデリアに似た、何か理由のわからない白日の憂愁に囚われていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "脳天の中央に、鉄槌様の鈍器で叩き破られた穴がポコンと開いて、真黒な血の紐がユラユラとブラ下がっていた。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "花子さんは夢中になってお友達と羽子をついているうちに、羽子板のうらの美しい姉さんの顔の頬ぺたが、いつの間にか羽子のムクロジに当って、ポコンと凹んでいるのを見つけました。",
              "citation": {
                "source": "黒い頭",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "首をひねられた鶏のように、首をガクリ胸に落し込んで、背筋の先端に大きな関節を一つポコンと露わに見せていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「罪と罰」は實にこの險惡なる性質、苦慘の實况を、一個のヒポコンデリア漢の上に直寫したるものなるべし。",
              "citation": {
                "source": "罪と罰（内田不知庵譯）",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒポコンデリア之れいかなる病ぞ。",
              "citation": {
                "source": "罪と罰（内田不知庵譯）",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒポコンデリイが嵩じて、夢遊病と進んでゐるやも知れぬ。",
              "citation": {
                "source": "鬼の門",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "国男、少々ヒポコンデリアの気味であった。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポコンと穴があいて、血がいくらでも出る。",
              "citation": {
                "source": "牢屋の原",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのことですか、ヒポコンデリーの獅子だという……。",
              "citation": {
                "source": "人間繁栄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒポコンデリーの獅子が失恋したなんて、可笑しいでしょう。",
              "citation": {
                "source": "人間繁栄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　杯を取上げてぐっと飲んでると、ヒポコンデリーの獅子という言葉をふと思い出した。",
              "citation": {
                "source": "人間繁栄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、いつの頃からか、彼はヒポコンデリイに類した苛立しい張りつめた気分になっていた。",
              "citation": {
                "source": "作家的思想",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかし、或る歌人が、トンカツのメランコリー、ビフテキのヒポコンデリーを、歌ったことがあった。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはひどいヒポコンドリイというものだ。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のヒポコンデリーは、日ましにひどくなるばかりだった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "とはいえこのヒポコンデリーの兆候は、だいぶ前からあるにはあったのである。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
