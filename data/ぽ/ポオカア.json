        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近頃、歐米では一｜時の麻雀熱がさめてブリツヂ・ポオカアの遊びに歸つたと言ふし、日本でも花合せの技法がずつと深奧複雜でより感興深いことを説く人もあるが、麻雀には遊びの魅力は魅力として、外にあの牌に觸れるといふ不可思議な魅力がある。",
              "citation": {
                "source": "麻雀を語る",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はシイカとそれから二三人の男が交って、いっしょにポオカアをやった晩の事を考えていた。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――シイカがこんな巧みなポオカア・フェスを作れるとは、彼は実際びっくりしてしまったのだった。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互いに信じ合い、恋し合っている男女が、一遍このポオカアのゲームをしてみるがいい。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何んと巧みな白々しい彼女のポオカア・フェス！",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "街灯の光りを浴びた蒼白いシイカのポオカア・フェスが、かすかに微笑んだ。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巧みなポオカア・フェスができる女でした。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、船客の誰彼を相手にポオカアの勝負をいどみ、もの凄い腕並みを見せた。",
              "citation": {
                "source": "世界覗眼鏡",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
