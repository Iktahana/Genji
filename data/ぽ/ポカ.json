        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大事なプレゼンの日に資料を忘れるなんて、とんでもないポカをやってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "普段は完璧主義の彼が、あんな初歩的なポカをするなんて誰もが驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "将棋の対局でうっかりポカをしてしまい、有利だった局面を一気に逆転された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "尋常一年の弟は唯ポカンとしてゐた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の顔色が急に変るかと思ふと彼は自分のマントと帽子を左手に持つて、右手で私の頬をポカツと擲りつけた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかこの若先生のところで顕微鏡を見せてもらって色々のプレパラートをのぞいているうちに一つの不思議な重大なアポカリプスを見せられた。",
              "citation": {
                "source": "追憶の医師達",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "メキシコの大火山、ポポカテペトルの第一登山が報告されてから、三百年も後になって、シャスタは地図の上に戸籍が入った。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "小刀を井戸の桁の上に置いて水を釣ったが釣瓶を漸くの事引摺り上げると、其拍子に小刀はポカンと音して井戸の中へ落て了った。",
              "citation": {
                "source": "井戸",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "運が悪いと頭を一つ位ポカと喰らせられる。",
              "citation": {
                "source": "井戸",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　乞食はポカンとして居るが、　殿様は独り悦に入って、Ｔ「敵討であろう　喃？",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポカンと空を見上げてゐる兵士もゐた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーシカは、ポカンとして、しばらくそこに不思議がりながら立っていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色の軽はく土は、ポカ／＼と掘り起された。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田はだんだん何だかアテがはずれたようなポカンとした気持になって行った。",
              "citation": {
                "source": "チチハルまで",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "両側に軒の並んだ町ながら、この小北の向側だけ、一軒づもりポカリと抜けた、一町内の用心水の水溜で、石畳みは強勢でも、緑晶色の大溝になっている。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、大噐氏は全く不知案内の暗中の孤立者になったから、黙然として石の地蔵のように身じろぎもしないで、雨に打たれながらポカンと立っていて、次の脈搏、次の脈搏を数えるが如き心持になりつつ、次の脈が搏つ時に展開し来る事情をば全くアテもなく待つのであった。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "みすぼらしい茶の背広に、間に合わせらしい不調和な赤ネクタイを締めていながらも、それこそ新劇の二枚目かと思われる、生白い貴公子然たる眼鼻立の青年であったが、それが今更のようにビックリして純真らしい、茶色の瞳を大きく見開き、薄い、小さな唇をポカンと開いた姿は、一層ういういしい子供らしい恰好に見えた。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それほどまでに二人が艱難辛苦してやッと結婚して、一緒になったかと思うと間もなく、ポカンと僕を捨てて逃げ出して了ったのです」「まア痛いこと！",
              "citation": {
                "source": "恋を恋する人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "前途が全く暗くなってしまったら、とこんな事を思ってポカンとしていると、弟が来てくれた。",
              "citation": {
                "source": "亮の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「や、いささかお灸でしたね、きゃッ、きゃッ、」　と笑うて、技師はこれを機会に、殷鑑遠からず、と少しく窘んで、浮足の靴ポカポカ、ばらばらと乱れた露店の暗い方を。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　火の盛なる頃なれば、大膚脱ぎを誰一人目に留る者も無く、のさのさと蟇の歩行みに一町隣りの元大工町へ、ずッと入ると、火の番小屋が、あっけに取られた体に口を開けてポカンとして、散敷いた桜の路を、人の影は流るるよう。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしがしっかりのみ込みました」　その時です、お月さまがカブンと山へおはいりになって、あたりがポカッと、うすぐらくなったのは。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シグナルもシグナレスも、あまりのことに今さらポカンとしてあきれていました。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度出て来た巡査が三人ばかり飛んで行って、車にポカンと腰掛けて居た黒い硬いばけものを、くるくるくるっと縛ってしまいました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程、引続けて二度狙うのは、自信がない、連発だけれども、」　空を打たれて、手練に得ものを落されたように――且つ器械を検べようとする注意だと思ったように、ポカンと渡すと、引取るが疾いか、ぞろりと紅の褄を絞って小褄をきりきりと引上げた。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "恁うして買つて參ります品物が氣に入らないと、甚いんですぜ、そりや、踏んだり、蹴つたり、ポカ／＼でさ。",
              "citation": {
                "source": "人參",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、其の時の手代の樣子が、井戸に落した音のやうで、ポカンとしたものであつた、と云ふ。",
              "citation": {
                "source": "人參",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "娑婆、人間の処女で……」　また絶句して、うむと一つ、樽に呼吸を詰めて支えると、ポカンとした叩頭をして、「何だっけね、」　と可愛い声。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と魂氣た顏をして、恰で手に持ツてゐた大事な玉を井戸の底へ滑らし落したやうにポカンとなる。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "空は、ドンヨリ曇ツて、南風が灰の都を吹き廻り、そしてポカ／＼する、嫌に其所らのざわつく日であツた、此様な日には、頭に故障のない者すら氣が重い。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰にも默ツて、此處に引込むでゐて、何か出來た時分に、ポカリ現はれて呉れる………屹度大向やンやと來る。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
