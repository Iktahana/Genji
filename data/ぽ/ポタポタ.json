    "definitions": [
      {
        "index": 1,
        "gloss": "dripping",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨漏りの音がポタポタと響き、眠りを妨げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "蛇口から水がポタポタ落ちる音が気になって集中できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あーあ、また雨がポタポタ降ってきたね。傘持ってないのに！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "嘉代吉と人夫が荷を卸して、油紙で庇を拵えてくれるのを、待ち兼ねて、石の中へ潜って寝た、雨はざんざ降りになって、庇から岩を伝わっては、ポタポタ雫が落ちる、防水布の外套に包まれて、ココアを一杯興奮剤に飲んだまま、飯も喰わずにたわいもなく痲痺したようになって寝た。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどボートレースに、櫂からの雫が、河面にポタポタして、小さな円い輪を描いたのに似ている。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は山を包む濃雲に絶望しながらも、屋根へ這い上って、虚空を見ていると、眼の前を灰色の霧は、渦巻いて、髯を伝わる呼吸が、雫となってポタポタ落ちる、鉛筆をポッケットから出して、弟が寒暖計を見て報告する温度を、手帖に記していると、傍から鉛筆の墨が滲んで、文字が紙の上で解体するほどの霧だ。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "振返って見ると、成程自分のあるいた跡は泥水が滴って畳の上にずーッとポタポタが着いて居た。",
              "citation": {
                "source": "少年時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "清夫はお母さんのことばかり考へながら、汗をポタポタ落して、一生けん命実をあつめましたがどう云ふ訳かその日はいつまで経っても籠の底がかくれませんでした。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "清夫は汗をポタポタこぼしながら、一生けん命とりました。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大三は早くその薬をのんでからだがピンとなることばかり一生けん命考へながら、汗をポタポタ滴らし息をはあはあついて待ってゐました。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは音なく砥石をすべり陽の光が強いので洋傘直しはポタポタ汗を落します。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大粒の涙がポタポタ落ちていた。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の腋の下から冷汗がポタポタと滴った。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして鼻血をポタポタと滴らしながらグッタリとなった身体を、力一パイ向うの方へ突き飛ばすと、深夜の廊下に夥しい音を立てて……ドターン……と長くなった。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にも失神しそうにゴックリと唾を飲み込んで、額からポタポタと生汗を滴らしながら大きく大きく眼を瞠った。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、こんな卑屈さも、また自分のためでなく、人の思惑のために毎日をポタポタ生活することも無くなるだろう。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり面白くて、この木をゆすぶって、ポタポタ落としたら、ジャピイ夢中になって食べはじめた。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――今日は四月馬鹿じゃないか」　そうだ、四月馬鹿だ、こりゃ武田さんの一生一代の大デマだと呟きながら、私はポタポタと涙を流した。",
              "citation": {
                "source": "四月馬鹿",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく長い房々した髪毛の蔭からポタポタと涙を滴らし初めた。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事か祈るように両眼を閉じると熱い涙をポタポタとコートの赤土の上に落した。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギイギイギイ――ッ……」　青鬼のようになった三好の両眼が、酸漿のように真赤になった……と思ううちに鼻の穴と、唇の両端から血がポタポタと滴たり出した。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生……先生と思うてなあ……」　と云ううちに奈良原翁の巨大な両眼から、熱い涙がポタポタと滾れ落ちるのを筆者は見た。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をするのかと思うと、その蝋涙を中央の通路のマン中にポタポタと垂らしてシッカリとオッ立てた。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そして無理矢理母の手から受取ると、眼鏡の隙間からポタポタ涙を落しながら、家を飛び出したが、どこへ行くといふ当てもないと判ると、急に気の抜けた歩き方になり、家出の決心がふと鈍つた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐに涙が眼に溢れてポタポタとこぼれて来ました。",
              "citation": {
                "source": "美智子と歯痛",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただもう気がワクワクして胸がドキドキして、身を切るような涙がポタポタと寝間着の膝の上に滴るばかりでした。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と……そんなような事ばかりをグルグルグルと扇風機のように頭の中で考えまわしているうちに、私の全身をめぐっております血液が、みんな涙になって頭の中一パイにみちみちて、あとからあとから眼の中に溜って、ポタポタと流れ出して行くように思いました。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして間もなく腹一パイに血を吸いますと、口からポタポタと吐き出しましたが、その血は皆燃え立つような紅玉になって、サラサラと濃紅姫の胸から寝床や床の上に転がり落ちました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "車輛と車輛との間が、鋼鉄車体のところといわず、連結器のところと云わず、真赤な血飛沫がベットリ附着し、下の方へ雫がポタポタと墜ちていた。",
              "citation": {
                "source": "キド効果",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして顔色を変えるミルキ閣下の目に、金盥のところから血の滴がポタポタと落ち、奥のカーテンの蔭にまでつづいているのが映った。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二秒、一……」　　　　　　　　　　＊　そのとき天野祐吉は額からポタポタと油汗を流し、顔を受信装置のパネルにグイグイと圧しつけ、受話器のあたっている耳は今にも融けそうに真紅にもえていた。",
              "citation": {
                "source": "放送された遺言",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで燐寸の頭を取出し、そこに残った淡黄色の水をいと興深げに眺めていたが、こんどは何思ったものかその水を指先につけて、卓子の上に伸べてあった漫画の水兵の紙面へポタポタとたらし、それをすらすらと拡げていった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――」櫓を降り、変にポタポタと靴の裏にはりつくような地面を事務所の方へ歩きながら、その技師は、バクーの油田が無慮二百七十の大小会社によって無統制に掘りかえされていた時代の恐ろしい競争の状態を話した。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
