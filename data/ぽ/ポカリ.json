[
  {
    "uuid": "5cae2fd7-2332-5c07-86f8-ad239df0b938",
    "entry": "ぽかり",
    "reading": {
      "primary": "ぽかり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "with a whack",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "授業中に居眠りをしていたら、先生に頭をぽかりと叩かれて目が覚めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "いたずらっ子の弟が、兄の頭を後ろからスリッパでぽかりと叩いて逃げていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "空から落ちてきた小さな木の実が、ちょうど私の頭にぽかりと当たった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それがまた喧嘩のはじまりで、気の早い富蔵は相手の横っ面をぽかりとなぐりつけると、藤吉はかっとなって富蔵の胸倉を引っ掴むと、そのはずみに喉を強く絞めたとみえて、富蔵はそのままぱったり倒れてしまったので、藤吉はびっくりして逃げ出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」裁判長なる判事は夢から醒めたやうにぽかりと目をひらいた。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あちらが暗くなると、ぽかりぽかり光り出すと言って、……此家の料理方の才覚でしてね。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とゞろ／＼と踏鳴らしもしない、輕い靴の音も、其の筈で、ぽかりと帽子を脱ぐやうに角の生えた面を取つて、一寸壁の釘へ掛けた、顏を見ると、何と！",
              "citation": {
                "source": "みつ柏",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと悪意でないことは判っていたが、供の又蔵は主人を突き倒されたのと、相手が小身者の子供であるという軽侮とで、その子供の襟髪を引っ掴んでいきなりぽかりぽかりなぐりつけた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "朝顔屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯れた根株の、眉間と水落ちに相当する高さの個処へ小刀で三角の印をつけ、毎日毎日、ぽかりぽかりと殴りつけた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんにぽかりと眉間を殴る。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻りめぐっている水車の十六枚の板の舌を、順々にぽかりぽかりと殴るのである。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "がそのうちに、武助さんがぽかりと河童のやうに頭を出して、舟の方へぬきでを切つた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この段取の間、男は背後の戸棚に※りながらぽかりぽかり煙草をふかしながら、腮のあたりの飛毛を人さし指の先へちょと灰をつけては、いたずら半分に抜いている。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "折つたらぽかりと音を立てて挫けさうである。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして巻煙草に火を点けて、濃くなりまさる暗の中にぽかりぽかりと光らし初めた。",
              "citation": {
                "source": "道",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「や、花火の椀殻だな」　炸裂した後の黒い半分ずつの椀殻が水にぽかりぽかりと漂っている。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日取り換へた処なのに今朝見ると悉くしをれてゐるんだ、変だと思つて、あれだけが皆な一処に活けられる相当大きな花壺なんですがね、験べて見ると中には氷が張り詰めて、持ちあげると胴中からぽかりと割れてしまつてゐるのさ、一滴の水も流れない、珍らしい寒さだ！",
              "citation": {
                "source": "趣味に関して",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "無我夢中で食傷横町の狭くるしい路次を抜け、法善寺の境内にぽかりと出た。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「馬鹿野郎」　半七はその横っ面をぽかりと殴りつけると、怪物はあっと悲鳴をあげた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "幽霊の観世物",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時『ぽかり』と俺は一撃を彼女の頭上に――飛ばすのであるすると女はこの問題を直ぐに氷解してしまふ。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まあ、たとへばお前達を、その屠殺場といふ、街端れの黒い建物の中にひつぱり込んで、額を金槌でぽかりと殴りつけるのだ、すると額からは、血といふ赤いものが流れだして。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "ためしに空鉄砲を放してみよう」といって、井上某が鉄砲を取りに立とうとすると、ぽかりと切石が眉間に当たって倒れました。",
              "citation": {
                "source": "江戸の化物",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "原口さんはぽかりと人の中へ飛び込んだ。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　いううちにぽかり！",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "openmouthed",
