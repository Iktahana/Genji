        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鼓は暫くは何気なくただ、「ぽん、ぽん、――ぽぽぽんぽん」とつづいていただけだったが、そのうちに腹に溜った悪液を押し出す作用をして、一音ごとに首が延び上り、軽くなる腹部とともに鼓の音も冴えて来た。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぽん、ぽん、――ぽぽぽんぽん。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪よりも氷の中の祈りを見よ、というように、――「ぽん、ぽん、――ぽぽぽんぽん。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは前に前にと押し出す音のように、「ぽん、ぽん、ぽぽぽん、ぽん。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぽん、ぽん、ぽぽぽん、ぽん。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "……と……「ポポポ……プポ……ポポポ」という鼓の音が頭の上の老先生の室から起った。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
