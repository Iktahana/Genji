[
  {
    "uuid": "4f2a87bc-324d-590e-ac5f-eeec9a10d4ff",
    "entry": "ポロ",
    "reading": {
      "primary": "ポロ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
