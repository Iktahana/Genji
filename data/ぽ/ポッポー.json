          "literary": [
            {
              "text": "お乳母日傘でハトポッポーなんていった奴とは育ちが違うんだからね……。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "玩具のふくろうを間ぬけな目つきをしてポッポーと吹きならして見たり、とんだりはねたりもんどりうたして見たり、盛花の菊の弁をひっぱって見たりして、私はどれからも満足したふっくりした気分をうけとれないいまいましさに、いつものくせにピリッと眉をよせた。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は三十分おきの簡単な曲）音楽　やんでチョット静かになってから、寂しい、はるかな山鳩の声が、ポッポー、ポッポーとひびく。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
