          "literary": [
            {
              "text": "彼は元来テサリアの首長であり、息子であるマカオンとポダレイリオスは有名な医師になり、トロイ戦争で戦った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホメロスによるとアスクレピオスはテッサリアの王子であり息子のポダレイリオスもマカオンも医療に秀でていた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホメロス―マカオン―ポダレイリオス　叙事詩からは病気およびその治療法について多くの引用を得ることはできないが、ホメロスの著作から彼の時代における医学の状態をある程度は知ることができる。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
