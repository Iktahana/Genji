        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……と早口で云った時には、思わずポオーッと気が遠くなったね。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "火がないと、これとポオー、ウオーと云うように、大きく波をうたせるようにして、長く吹くのです。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ポオー、うえの、うえの、ポオー、あかばね、あかばね――。",
              "citation": {
                "source": "ゆずの話",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時自分がポオーの「影」と云ふ小品を訳したことがあつたが、芥川が五六人の友人や後輩とこの飜訳の噂をして、間違ひだらけで迚も読んでゐられないと云ふ意味のことを言つたとかで、それをその席上にゐた一人のおしやべりが自分の所へ来て伝へた。",
              "citation": {
                "source": "芥川龍之介を憶ふ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
