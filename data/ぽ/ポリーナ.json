        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "戯曲というものは、やっぱり恋愛がなくちゃいけないと、あたしは思うわ……（ふたり、仮舞台のかげへ去る）ポリーナとドールン登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　しめっぽくなってきたわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　それが、医者の不養生よ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべだって、わざと一晩じゅう、テラスに出てらしたり……ドールン　（口ずさむ）「言うなかれ、君、青春を失いしと」（訳注　ネクラーソフの詩の一節）ポリーナ　あなたは、アルカージナさんと話に身が入りすぎて……つい寒いのも忘れてらしたのね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　そんなこと――男の場合、年寄りのうちに、はいらないわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　相手が女優さんだと、いつだって平｜蜘蛛みたい。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　女のひとが、いつもあなたに惚れこんで、首っ玉にぶらさがってきた。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　（男の手をとらえる）ねえ、あなた！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーナ　人間がいないので、退屈なのだ……ポリーナ　（ドールンに）まあまあ、帽子をぬいで！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　向う岸ですわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アルカージナおよびポリーナとキスを交す）ソーリン　ブラボー！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて、ポリーナ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーナ　（ポリーナに）アルカージナさんのような、有名な女優さんにさからうなんて！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　（身も世もあらず）どうしろとおっしゃるの？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドールンとポリーナだけ残る）ドールン　厄介な連中だなあ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　あの人は、よそ行きの馬まで野良へ出したんですの。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　わかってるわ、そう言って逃げをお打ちになるのも、わたしのほかに、身近な女の人が、幾らもおありだからよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　わたし、嫉妬でくるしいのよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（家のほうへ行く）ポリーナ　（いっしょに行きながら）まあ、可愛らしい花だこと！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ、やがてソーリン、メドヴェージェンコ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　（手かごを持って）このスモモを、どうぞ道中めしあがって……。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　ご機嫌よろしゅう、奥さま！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　わたくしたちの時は過ぎて行きますもの！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるさいわねえ……トレープレフとポリーナ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフは枕と毛布を、ポリーナはシーツを持ちこみ、トルコ風の長椅子の上に置く。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　ソーリンさんが、コースチャの部屋に床をとってくれとおっしゃるんだよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーシャ　わたしがするわ……（寝床をつくる）ポリーナ　（ため息をついて）年をとると、子供も同じだねえ……（デスクに近寄り、肘をついて原稿をながめる。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（しゅうとの手にキスしようとする）ポリーナ　（腹だたしげに）いいからさ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　（原稿をながめながら）ねえ、コースチャ、あなたが本当の文士になるなんて、誰ひとり夢にも思いませんでしたよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　（トレープレフに）これで、なかなか好い子さんですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
