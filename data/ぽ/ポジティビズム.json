          "standard": [
            {
              "text": "彼は、実証主義（ポジティビズム）の観点から社会現象を分析した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の研究は、経験的なデータのみを重視する厳格なポジティビズムに基づいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "19世紀のポジティビズムは、科学的知識こそが唯一の真の知識であると主張した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "午後、再びポジティビズム会堂に至りて、会長に面会す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
