  {
    "uuid": "6b47d9da-0495-58b2-bb1e-a7a7ae605126",
    "entry": "ぽこ",
    "reading": {
      "primary": "ぽこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "へっぽこ部長だ、お前は。",
              "citation": {
                "source": "女類",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェーヴを弾ね除けた額は、円くぽこんと盛上って、それから下は、大きな鼻を除いて、中窪みに見えた。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は先客の人に対して議会解散の予想などを喋喋述べて居たが、「こんなへつぽこ役人ではね、」と云つて湧き上る様に笑つた。",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど中学生の質屋通いは見物だろう）　奥へはいって行く時、兵児帯の結び目が嘲笑的にぽこぽこ揺れていたのを想い出した。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の両側から掘って行くトンネルがだんだん互いに近づいて最後のつるはしの一撃でぽこりと相通ずるような日がいつ来るか全く見当がつかない。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "心の一角がぽこんと凹んだやうな空虚な寂しさであつた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ルコックは哀れなへっぽこだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "あってもへっぽこ悪事、動機が見え透いているから、スコットランド・ヤードの刑事どもでも見破れてしまう始末だ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばへっぽこレストレードの発見だが、あれは単なる目くらましで、社会主義者か秘密結社をにおわせて、警察を誤った方へ向かわせたいだけだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "他のへっぽこ占ないは駄目よ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな間にも、いつか木山が仲間が山へ行くのだと、ちやらつぽこを言つて、朝日靴などもつて出かけて行つたが、それを待合に忘れて来たものらしく、靴をおいて来た宿へ葉書を出す出すと言ひながら其れきりになつてしまつたが、考へてみると憎めないところもあつた。",
              "citation": {
                "source": "のらもの",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと、ぽこんと跳ね上るように高く水の上に現われ出ました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンベは日ごろからちゃらっぽこばかりいっている男だから、あいつが何んといったって、俺がそんなことをしたと信ずる奴はなかろう。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを信ずる奴があったら「へえ柿江がかい」と愛嬌にしないとも限らないし、しかしたいていの奴は「ガンベのちゃらっぽこもいい加減にしろ」と笑ってしまうに違いない。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "可愛いいちんぽこから小便が出る。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "子だぬきにちゃらっぽこやられたんじゃござんすまいね」「なにッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」……お、叔父はおれにさう言つたんだ、このおれに、このやくざなおれに、叔父は昔から力瘤を入れてくれた……それだのに、その力を入れて貰つたおれは、四十にもなるのに今だに素寒貧で、愚圖で、馬鹿で、やくざ者で……意氣地なしの大へつぽこ！",
              "citation": {
                "source": "醉ひたる商人",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪岡がぽこぽこと歩くにつれて、蹄の跡が幾つも幾つも赤黒く路面に残った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂ツぽこりの大道の地べたで、上になつたり下になつたり、まるであんこの中の團子のやうに。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "役者になりたいからよろしく頼むなんどと白ばッくれて、一方じゃア、どん百姓か、肥取りかも知れねいへッぽこ旦つくと乳くり合っていやアがる」「そりゃア、あんまり可哀そうだ、わ。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "教師やへツぽこ官吏には六ヶしいとしても、農學校の教授とか、道廳の官吏などは、こツそりさきへまはつて、出る山林や土地を買ひ占めてしまふ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、僕はけふから道廳のへツぽこ官吏になつたよ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたの態度は地方のへツぽこ記者に對する態度でしよう？",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "「病氣になつた時、直ぐよい病院にかけて呉れたらよかつたのに、廣田の樣な、あんなへツぽこ醫者へつれて行て、もう、一週間で直る??もう、十日で直ると云うて、直るどころか、なほ惡うなつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "「病氣になつた時、直ぐよい病院にかけて呉れたらよかつたのに、廣田の樣な、あんなへツぽこ醫者へつれて行て、もう、一週間で直る――もう、十日で直ると云うて、直るどころか、なほ惡うなつた。",
              "citation": {
                "source": "――泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "さばくの井戸っていうのは、さばくのなかで、かんたんな穴がぽこっとあいてるだけ。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポコッと頭が鳴っただろうな。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
