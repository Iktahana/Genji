    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しばらくしてぽーんと弱い爆音が聞こえる。",
              "citation": {
                "source": "耳と目",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、私が骨と皮ばっかりにやせているのがわかると、下へぽーんと投げました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は腰のあたりをくわえられると、ぽーんと海の向うへなげられた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "運のわるいときには悪いことが重なるもので、それから三十分ばかり経った後のこと、技師の一人がこつこつと靴音を響かせて、ぼくの転っている方へ歩いて来たが、その靴先がぼくの身体に当って、ぼくはぽーんと蹴とばされてしまった。",
              "citation": {
                "source": "もくねじ",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その二つの品物を、こわごわ舷側から海中へ、ぽーんとすてたものだ。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "錨のさきに、こっちの綱がうまくかかったと思った刹那に、綱は錨をぽーんとはじいてしまいました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙な形のピストルは、兵曹長の靴にぽーんと蹴られ、はるか向こうの岩かげにとんでいってしまいました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピストルが、ぽーんと上に跳ね上ったと思ったら、ゴンドラの外にとびだした。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と、おもう間もなく、ぽーんといきおいよく穴から跳ねあがってきたのは、正太少年であった。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで三郎は、ゴム風船の口をきつく結んで、手のうえで、ぽーんとついてみた。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーん、ぽーん、ぽーん。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーんとつきあげた風船が、すーっと天井にのぼっていったが、そのまま天井に吸いついたようになって、いつまでも下へ落ちてきそうでない。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっか恐ろしくのぽーんとした大口を開いた様な音からして、あんまりいい感じは与えない上に、その主があの親父さんだと云うのだから又いい笑種にされてしまった。",
              "citation": {
                "source": "二十三番地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーんぽーんという素敵な音だった。",
              "citation": {
                "source": "黒点",
                "author": "――或る青年の「回想記」の一節――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーんと空高く破裂する火花は、子供たちの心をそそる。",
              "citation": {
                "source": "女客一週間",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの十五メートルいじょうもある大きなのが、はじめは海面すれすれに、たいへんな速力でおよいでいると見るまに、少しずつとびあがり、しまいには、すぽーんと、空中にとび出すのだ。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーんとピストルを一つ打つんだぞ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーん　ぽーん　うららかな音がする。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ちょうど近くにいた高※は、得たりとばかり跳び寄って、ぽーんと、その鞠をはるか端王の方へ、蹴わたした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーんと芒の中から蹴鞠が空へとび上がって、あの軽快なお嬢様の姿が両手をあげて自分の名をよぶような気がする。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと共に、船の舳から丸っこい動物の影が、四、五間ほども幅のある船と岸との間の枯れ蘆の沼をぽーんと跳んで、七名のうちの誰か一人の首っ玉へ躍りかかったのである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽーんと、男の影へ向って、菅笠と杖とを投げつけるが早いか、狼狽して、ざざざッと、道もない崖へ逃げ下りた。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五番の松山さんが、突然「あーア」とおおきい溜息をつき、「おーイ、みんな、漕ぐのは止めろッ、寝ろッ寝ろッ」と叫びさま、オォルをぽおんと投げだし、ぼくの太股のうえに、もじゃもじゃの頭を載せました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちはみなこれをもって、調子をそろえて、ぽおん、ぽおんと地面を叩く。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
