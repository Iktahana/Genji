          "literary": [
            {
              "text": "カラコロ　カラコロ　冬の夜更けの下駄の音　コツコツコツ　石屋の職人　カチツカチツ　高天ヶ原　ポカポカポカ　あやまつた　あやまつた「二百みツつう、二百むツつう…………」　湯上りの　お神さんの銀煙管が　キラキラキラ　モールス符号　――ざ……ま……み……ろ……　タッチ……占めた。",
              "citation": {
                "source": "玉突の賦",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより早くポカポカポカポカポカーリ。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも待たずに、ポカポカポカと手前やりやがったんじゃねえか。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
