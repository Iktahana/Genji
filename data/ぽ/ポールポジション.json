        "examples": {
          "standard": [
            {
              "text": "予選で最速タイムを叩き出した彼は、明日の決勝レースをポールポジションからスタートする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "幾度となくポールポジションを獲得してきた彼女の走りは、他の追随を許さない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ポールポジションからのスタートだったが、最初のコーナーでライバルに抜かれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
