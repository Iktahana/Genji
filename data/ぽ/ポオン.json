          "literary": [
            {
              "text": "首をシュッポオンと切ってしまう位、実にわけないはなしだ。",
              "citation": {
                "source": "カイロ団長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あーあ、ところが、これから晩までにもう八百九十九貫九百匁運ばないと首をシュッポオンと切られるのです。",
              "citation": {
                "source": "カイロ団長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっさおい水の上に、艇をポオンと置いてから、約｜一月ぶりに、シャッシャッと漕ぎだすと、一本々々のオォルに水が青い油のように、ネットリ搦みついて、スプラッシュなどしようと思っても、出来ないあんばい。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっさおい水の上に、艇をポオンと置いてから、約一月ぶりに、シャッシャッと漕ぎだすと、一本々々のオォルに水が青い油のように、ネットリ搦みついて、スプラッシュなどしようと思っても、出来ないあんばい。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹き降りの大嵐の中を、こっちの同勢が、近づいて行くと、ポオン、ポオン、音がする。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオン、と爽快な音がし、シュシュッ、と白い泡が吹きだす。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
