        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日の新しい破片は明日の古い破片でなければならないことは歴史のエキストラポレーションが証明する。",
              "citation": {
                "source": "スパーク",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "★ＭＩＴＳのアルテアは、日本では輸入代理店となったＩＥＥコーポレーションから二八万五〇〇〇円で売り出されており、完成品には三九万円の値段がついていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーポレーション街一二六番地ですから、分かります。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーポレーション街一二六番地。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　　　　×　　　　×　　　　×　　　　×　その日の夕方七時、私たち三人は歩いて、コーポレーション通りを会社の事務所のあるほうへ下っていった。",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "稜大使シュレンバーグ伯、またエジプトの女王ナズリ陛下、イタリアは皇甥スポレート侯爵。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "石油は、フランス諸銀行は英国の各銀行と共にロシア・ゼネラル・コーポレーションを組織し、一九一三年にバクーの全生産（石油の四十パーセント）を独占した。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "老夫人のおもなる遺産相続人はエフィム・ペトローヴィッチ・ポレーノフというその県の貴族団長で、高廉な人であった。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の恩人で養育者たるエフィム・ペトローヴィッチ・ポレーノフの家へ引き取られると、彼はこの家のあらゆる人たちをすっかり引きつけてしまって、全く本当の子供と同様に見なされたものであった。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "覚えてるかな、おまえは小さい時分にポレーノフの家にいて、桜ん坊のジャムが大好きだったじゃないか？",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "途上、スポレートで熱を病むだ夜、彼は「故郷へ歸れ。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアン、ミシェル、ロゲー、アルレー、マレー、ポレー・ド・モルヴァン、皆そこにいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺はディクソン・ウェルズ、会社はＮ・Ｊ・ウエルズコーポレーション、つまり父のだが。",
              "citation": {
                "source": "もしも世界",
                "author": "THE WORLDS OF IF",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ成功していなかったが、運の良いことにＮ・Ｊ・ウェルズ・コーポレーションは俺ディクソン・ウェルズが常勤しなくても充分利益を出しながら生き残っていた。",
              "citation": {
                "source": "観点",
                "author": "THE POINT OF VIEW",
                "note": "青空文庫"
              }
            }
          ]
        }
