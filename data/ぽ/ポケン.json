          "literary": [
            {
              "text": "まアとぽけんといたしました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なーにぽけんとしてんのヨ」　目へ涙をうかべながら笑って自分をゆすぶっている桃色のレースの派手なショールをした若い女が姉のサイだとやっと判ると、勇吉は、「おら誰かと思った」　笑いもしないでそう云って、すこし顔を赧くした。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
