        "examples": {
          "standard": [
            {
              "text": "シャンパンの栓がポンと抜けて、華やかなパーティーが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子供が持っていた風船が、トゲに触れてポンと割れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "電球が寿命を迎え、小さな音を立ててポンと切れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "cutesy suffix applied to names",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
