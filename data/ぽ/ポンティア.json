        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼女の自動車は、ポンティアック・カタリーナの２ドアだった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人から借りた、ポンティアック・カタリーナのステーション・ワゴンだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンティアックのステーション・ワゴンまで歩いてきて、その平凡な車体をぼくは佳子に示した。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう十年近く使っていると言っていたから、匂いがしみこんで抜けないのさ」　頭上からまともに陽の当たっている駐車場から、ぼくはポンティアック・カタリーナを出していった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャロリンから借りて乗っていたポンティアック・カタリーナのステーション・ワゴンを、スーパー・マーケットの駐車場に停めたまま忘れて来た。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーケットの駐車場に忘れて来たキャロリンのポンティアック・カタリーナのことだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七八年のポンティアック・ファイアバードだった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はポンティア・ポストゥミアとともに寝てから、その楽しさが忘れられず、いよいよその愛情を募らせ、執拗に結婚を迫った。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
