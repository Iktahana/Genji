        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはやはりこう云う晩にポプラアの枝にかかった紙がヘルメット帽のように見えたのだった。",
              "citation": {
                "source": "蜃気楼",
                "author": "――或は「続海のほとり」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何に又グラウンドのポプラアは憂欝な色に茂っていたであろう。",
              "citation": {
                "source": "大導寺信輔の半生",
                "author": "――或精神的風景画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "信輔は鼠色の校舎の中に、――丈の高いポプラアの戦ぎの中にこう言う囚徒の経験する精神的苦痛を経験した。",
              "citation": {
                "source": "大導寺信輔の半生",
                "author": "――或精神的風景画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もグラウンドのポプラアだけは不相変欝々と茂った梢に寂しい風の音を宿しながら。",
              "citation": {
                "source": "大導寺信輔の半生",
                "author": "――或精神的風景画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼等を乗せた馬車はその時にはもう傾きながら、ポプラアの枯れた道を走っていた。",
              "citation": {
                "source": "玄鶴山房",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に田端のポプラア倶楽部の芝生に難を避けてゐた人人などは、背景にポプラアの戦いでゐるせゐか、ピクニツクに集まつたのかと思ふ位、如何にも楽しさうに打ち解けてゐた。",
              "citation": {
                "source": "大正十二年九月一日の大震に際して",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとポプラア倶楽部の芝生に難を避けてゐた人人もいつ何時隣の肺病患者を駆逐しようと試みたり、或は又向うの奥さんの私行を吹聴して歩かうとするかも知れない。",
              "citation": {
                "source": "大正十二年九月一日の大震に際して",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻、小犬、庭先のポプラア、――それ等は彼の生活に何か今まで感じなかつた或親しみを与へたのだつた。",
              "citation": {
                "source": "或社会主義者",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何に又グラウンドのポプラアは憂鬱な色に茂つてゐたであらう。",
              "citation": {
                "source": "大導寺信輔の半生",
                "author": "―或精神的風景画―",
                "note": "青空文庫"
              }
            },
            {
              "text": "信輔は鼠色の校舎の中に、――丈の高いポプラアの戦ぎの中にかう言ふ囚徒の経験する精神的苦痛を経験した。",
              "citation": {
                "source": "大導寺信輔の半生",
                "author": "―或精神的風景画―",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もグラウンドのポプラアだけは不相変鬱々と茂つた梢に寂しい風の音を宿しながら。",
              "citation": {
                "source": "大導寺信輔の半生",
                "author": "―或精神的風景画―",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから校舎のまはりにはポプラアが何本かそよいでゐた。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "（この界隈は土の痩せてゐる為にポプラア以外の木は育ち悪かつたのである。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポプラアの強い香が目にしみた。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "夢の総量は空気であった",
                "note": "青空文庫"
              }
            },
            {
              "text": "池は、砂丘と、ポプラアの杜に囲まれていた。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "夢の総量は空気であった",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポプラアの杜に、あたまから秋がふけた、時雨が、けたたましく落葉をたたいて、走りすぎた。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "夢の総量は空気であった",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポプラアの杜を越えて、しもたやの燈りが見えた。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "夢の総量は空気であった",
                "note": "青空文庫"
              }
            },
            {
              "text": "池は、砂丘と、ポプラアの杜に囲まれてゐた。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "――夢の総量は空気であつた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポプラアの杜に、あたまから秋がふけた。",
              "citation": {
                "source": "ふるさとに寄する讃歌",
                "author": "――夢の総量は空気であつた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地の四辺を取り囲む深い木立は皆一様に蒼空高く梢を窄めた、欅、樅、樫、ポプラアの類ばかりで、又中に侘しげな柿があり無花果があつた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手には既に湖が見え出して、そのあたりに並木が規則正しく立って居るのはポプラアらしい。",
              "citation": {
                "source": "ドナウ源流行",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その向うに翠の濃い山が見えて、左手には何かポプラアのような木が五、六本かいてある。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
