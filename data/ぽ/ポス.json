        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "蝙蝠が居そうな鼻の穴に、煙は残って、火皿に白くなった吸殻を、ふっふっと、爺は掌の皺に吹落し、眉をしかめて、念のために、火の気のないのを目でためて、吹落すと、葉末にかかって、ぽすぽすと消える処を、もう一つ破草履で、ぐいと踏んで、「ようござらっせえました、御参詣でがすかな。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は何んでも知つてゐた、中学生にしては少し大人つぽすぎるほど各方面の知識に富んでゐた。",
              "citation": {
                "source": "老苦",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はサー、理窟っぽすぎるが、大阪料理の為にこう云いたい。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "釦が二つついていて、花壜の平な側を壁におしつけ、上の釦をぽすんと押すと、花壜は壁にぴたりと附着する。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを離すためには、下の釦をぽすんと押すしかない。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の仕上げの件にしても、聊か色っぽすぎる。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせどうも、すべて色つぽすぎるぢやないか。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（言いながら、眼を素描から引き離そうとしても離せない）……しかしだな、この絵には、だな、そう言う所もあるし、なんと言うか……荒っぽすぎる。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "落着いた味、静かな味、淡い味を知るには、あまりにも荒っぽすぎる。",
              "citation": {
                "source": "昆布とろ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　パイプを　ふかせながら　さんぽする　ババール。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時に家を出て、祖母上等道子も共に晩翠軒で夕食する、あまりうまくなし、掛炉焼鴨の味噌が油っぽすぎる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
