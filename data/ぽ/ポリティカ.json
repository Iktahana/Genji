        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "学問の自由、良心の自由、理性の自由をまもろうという動機に立つ学生の運動を、ノン・ポリティカルであるべしと宣伝する人々自体が、なぜ、現実の学生の動きに対しては、このようにも極度に政治的であるのか、と。",
              "citation": {
                "source": "若き僚友に",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にアリストテレスでは、倫理学（エティカ）の位置は経済学（オイコノミカ――之は純粋にアリストテレス自身のものではないらしいが）と政治学（ポリティカ）とに先立つ処に意味を有っている。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリストテレスの『倫理学』がそれ自身原理的に哲学の一ブランチであったと同じに、そのポリティカは、哲学の原則的な一ブランチだった。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十世紀の有力な諸哲学は――プラトンの『ポリテイア』やアリストテレスの『ポリティカ』のような古典的な手本にも拘らず――不思議にも、政治学を有たないことをその特色とさえするように見える。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
