    "definitions": [
      {
        "index": 1,
        "gloss": "splashing (water)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供たちが水たまりでぽちゃぽちゃ遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お風呂でアヒルのおもちゃがぽちゃぽちゃと浮かんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「猫がお風呂のお湯をぽちゃぽちゃしてる！もう、やめてよー。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "もやい綱が船の寝息のようにきしり、それを眠りつかせるように、静かな波のぽちゃぽちゃと舷側を叩く音が、暗い水面にきこえていた。",
              "citation": {
                "source": "冬の蠅",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長のこの話が終らないうちに、もう小さなやつが大勢、海岸へ出て来たかと思うと、船をめがけて、ぽちゃぽちゃと泳いで来はじめました。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "うっすら明るい梅の下に真白い顔の女が二つの白い手を動かしつつ、ぽちゃぽちゃ水の音をさせて洗い物をしているのである。",
              "citation": {
                "source": "春の潮",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて妻女の始末ぐらいは、当然もう始めているべきが定なのに、香華一つたむけようともせずほったらかしておいたまま、女中のお葉を、ぽちゃぽちゃッとしたべっぴんなんで少し気になるがと仙市座頭がいったお葉なるその女中をそばへ引きつけて、妻女の品とおぼしき形見の着物をたんすの中から取り出しながら、「どうだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "袈裟切り太夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃぽってりと程よく肥っていやがって、身ぶるいが出る位だぜ」「分らねえんだ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「家のお芳をごらんなさい、体がぽちゃぽちゃしていますから、私のような老人じゃ喰い足りねえとみえて、店の若いものに、色目をつかやがってしようがありませんよ。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「洋服はばかに評判がいいんですよ」　お島は日の暮に帰って来ると、急いで窮屈なコルセットをはずしてもらうのであったが、薄桃色肉のぽちゃぽちゃした体が、はじめて自分のものらしい気がした。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服がすっかり体に喰っついて、ぽちゃぽちゃした肉を締つけられるようなのが、心持よかった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "道太は子供が脊髄病のために、たぶん片方の脚が利かないであろうことを聞き知って、心を痛めていたので、今ふみ江の抱いている子供のぽちゃぽちゃ肥った顔を見ると、いっそう暗い気持になって、しばらく口も利けなかった。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃ一人でやっていると、心はなまけた潤おいに満たされ、空腹も忘れてしまう。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃした円っこい四つの感触を掌に感じたのと、胸に擽ったい薄ら寒さが起ったのと、彼女が心持ち顔を赤らめたのとが、殆んど同時だった。",
              "citation": {
                "source": "人の国",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、これをつくるのは、カトリーナ・ヴァン・タッセルのやさしい、かわいい、ぽちゃぽちゃした手だ。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど船べりにおどる川浪がぽちゃぽちゃと、意地悪るい子供のように、絶えず私のかなしい心にからかった。",
              "citation": {
                "source": "洪水のように",
                "author": "徳永保之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃした頬、黒い瞳、ふしぎによく似ています。",
              "citation": {
                "source": "フランダースの犬",
                "author": "A DOG OF FLANDERS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃとかわいらしく太った男の子、それに、大きな優しい、ドルスの目のような美しい目をした女の子たちであった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなぽちゃぽちゃした赤んぼうのぶたは、いまにも生きながら皮をはがれでもするようにぶうぶう鳴いていた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀や四十雀や頬白が時々来ては、あたりを覗って香炉の水にぽちゃぽちゃ行水をやる。",
              "citation": {
                "source": "地蔵尊",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ向うの杭には、常に一艘の小舟が筑波とすれすれに繋がれて、其のあたりには家鴨が始終ぽちゃぽちゃやって居る。",
              "citation": {
                "source": "漁師の娘",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆったりと大きいあぐらのなかに、今よりずっと稚い頃の昭夫がまるっこく抱かれて、赤子のぽちゃぽちゃした顔に、可愛く眼、鼻、口をつけて、こっちを見ている。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃした面の、手拭をかぶって背には籠を背負っていたのが、峠というほどでないにしても、上下一里はある山路の中を、いい気になって、鄙唄をうたいながら来たのを、こちらから呼び止めたのは、雲をつく田山白雲でしたから、「え！",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃぽちゃしたその手足、綺麗な爪、小っちゃな、見るもおかしいほど小っちゃな爪、そして目といったら、まるでもう何もかもわかるような表情をしているんだ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "色が白くぽちゃぽちゃ肥え、顔いっぱいにあいそのいい笑いをうかべ、どうかすると揉み手もやりかねないほど腰が低く、自分ひとりで饒舌っては笑うのであった。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎのランナーは、みんな年が若かつたので、元気にまかせて、担いでゐるのが肥えの筈であることを忘れて、ポチャポチャやりながら駆け出し疾走し始めた。",
              "citation": {
                "source": "運動会の風景",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチャポチャッと可愛いとこがあらア。",
              "citation": {
                "source": "選挙殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし正面の水田の中三、四ヶ所で稲が動いてポチャポチャ水の音がするのは、三、四人の人間が泥掻きと草取りをやっているらしい。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし正面の水田の中三、四ヵ所で稲が動いてポチャポチャ水の音がするのは、三、四人の人間が泥掻きと草取りをやっているらしい。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とりすましたヒネクレ女め、体温まで冷いのじゃないか」「イヤア、案外モチハダか何かで、ポチャポチャあったかいかも知れませんや」　と巨勢博士が処女趣味に似合わしからぬ言辞を弄して、御婦人連をビックリさせた。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの娘が井戸端へ出ると、長屋中まるで御来迎を拝むような騒ぎで」「――」「色白で、ポチャポチャして愛嬌があって、無口なのが玉に疵だが――」「それがどうしたんだ、九尾の狐の化けたのか何んか――」「冗談言っちゃいけませんそんな檜扇で品をつくる代物じゃありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "猿回し",
                "note": "青空文庫"
              }
            },
            {
              "text": "色白の眼の細い、恐ろしくポチャポチャした娘ですが、美人というには少し縁が遠過ぎます。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "暴君の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチャポチャして可愛らしくて、若い男の心をひしと掴まずにはおかない――という噂のお浜が、この物に怯えて雁皮紙のように顫えている娘とは思いもよりません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "九百九十両",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
