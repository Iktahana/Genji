        "examples": {
          "standard": [
            {
              "text": "生まれたばかりの赤ちゃんは、手足がぽちゃぽちゃしていて柔らかい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "小鳥が地面でぽちゃぽちゃと歩く姿が愛らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この子、ほっぺたがぽちゃぽちゃで、つい触りたくなっちゃう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
