          "literary": [
            {
              "text": "ひょいと首を向けて見ると、それは棒高跳のポォルであった。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、結局、竹竿の刺を掌に何度か突立てたのち、彼のポォル・ヴォオルトは二米位で止ってしまった。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポォル・フォォルの夫人が令嬢を伴れて奥の方に来て居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポォル・フォォル氏が遅れて遺つて来た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
