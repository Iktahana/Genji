        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハムラとは隊長といった風のアンゴラ土人語であり、ポンゴーというのは、同じくゴリラのことを土語ではかく言って恐れ戦いているのであった。",
              "citation": {
                "source": "令嬢エミーラの日記",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をつかまれたのだろうか」第九章　ポンゴ　アストリア女王が戻られた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達ポンゴの自動車で遊んでいたのよ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが来ればポンゴは誰にも見向きしないわね」　ジェシの全然知らない女が話しかけてきた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴとは誰なのだろう、ギャロウェイお嬢様との間に親密なお付き合いがあったのかなあといぶかった。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴ、今は行けないの。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "賭けの為ですからね」　ポンゴは歯を見せて喜んだが、ジェシは本名などさっぱり知らない。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴはバカげたことをすればするほど、ビビッとくる特異な性格だ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェシが愛称のポンゴという名前を呼んだり、流し眼をしたことから、ポンゴはすっかり参った。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆっくり旅を楽しみたいものじゃありませんか」　ジェシは笑顔を返し、ポンゴと取りとめのないおしゃべりをした。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴという紳士を使うつもりです。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴは相当いい奴ですが、上流階級ではまぬけを装っています。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴがあなたを待っていると思いますよ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ち主はラッセルズ、別名ポンゴだ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いますぐポンゴと呼んでください。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それじゃ、ポンゴ、いやよろしければポンゴさん。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンゴさん、あなたを信じます。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
