        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「水が飲みたあい」　と、炎天の下で乾物になりさうな程も、焙られて怒鳴りながら駆けて、帰つた子供たちは、井戸に飛びついてポムプを押すのだが、井戸からは一滴の水も出ないのだ。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "出るのは、スー、フー、スー、フー、とポムプの溜息ばかりなのだ。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポムプを除り、竹を抜き、さて井戸屋さんが、縄を伝つて井戸の底へ降りて行つた。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "三台のポムプは、昼夜間断なくモーターを焼く程働き続けていた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ、ポムプへ引いてある動力線の電柱が、草見たいに撓む程、風が雪と混って吹いた。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポムプの鋳型を踏み砕いて飛び退いた。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の中でポムプの音をきき、ああと悦びを覚ゆ。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
