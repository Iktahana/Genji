          "standard": [
            {
              "text": "ある一定期間内に発生するまれな事象の数をモデル化するのに、ポアソン分布がよく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "単位時間あたりに窓口にやってくる客の数は、統計的にポアソン分布に従うことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "滅多に起こらない事故の発生確率を予測するために、ポアソン分布を用いて分析を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "僕の推測が間違っていないとすれば、オーラの発散はポアソン分布に従う確率変数の事象として断続的に発生するらしい。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
