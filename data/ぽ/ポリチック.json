        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "政事における国民論派の大要　国民的政治〔ナショナル・ポリチック〕とは外に対して国民の特立を意味し、しかして内においては国民の統一を意味す。",
              "citation": {
                "source": "近時政論考",
                "author": "陸羯南",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のポリチックスには無論超然主義を執る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一たんポリチックに足を踏みこんだら、それこそ泥沼に落ちたも同じことよ。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由の旨趣その目二、曰くリベルテーモラル（即ち心神の自由）、曰くリベルテーポリチック（即ち行為の自由）なり。",
              "citation": {
                "source": "『東洋自由新聞』第一号社説",
                "author": "中江兆民",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二、リベルテーポリチックは即ち行為の自由にして人々の自らその処する所以の者、及びその他人とともにする所以の者皆この中にあり。",
              "citation": {
                "source": "『東洋自由新聞』第一号社説",
                "author": "中江兆民",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
