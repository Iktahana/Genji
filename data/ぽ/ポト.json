        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「かりにお前さんが、豚のしっぽと言わなくたって、こちとらには、ぴんと来るんだから仕様がねえじゃないか。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやしくも一個の人間を豚のしっぽと較べられるわけのものじゃ絶対に無いんだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがあの、十六歳の春から苦しみに苦しみ抜いた揚句の果に、ぽとりと一粒結晶して落ちた真珠の姿か。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、私が荻窪の下宿にいたとき、近くの支那そばやへ、よく行ったものであるが、或る晩、私が黙って支那そばをたべていると、そこの小さい女中が、エプロンの下から、こっそり鶏卵を出して、かちと割って私のたべかけているおそばの上に、ぽとりと落してくれた。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々それがぽとりと落ちる。",
              "citation": {
                "source": "小豆島",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐は可笑しさうに口を曲げて、キックキックトントンキックキックトントンと足ぶみをはじめてしっぽと頭を振ってしばらく考へてゐましたがやっと思ひついたらしく、両手を振って調子をとりながら歌ひはじめました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎が顔をまっかにして、汗をぽとぽとおとしながら、その坂をのぼりますと、にわかにぱっと明るくなって、眼がちくっとしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂の一とこが円くぽとっとぬれたように見えてそこに指をあててみますとにくにく寒天のようなつめたいものでした。",
              "citation": {
                "source": "サガレンと八月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐は可笑しそうに口を曲げて、キックキックトントンキックキックトントンと足ぶみをはじめてしっぽと頭を振ってしばらく考えていましたがやっと思いついたらしく、両手を振って調子をとりながら歌いはじめました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は表の戸をそっと閉めて、しめっぽい畳の上にあぐらを掻いて、時々に天井裏へぽとぽとと落ちて来る雨漏の音を聴いていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "おや自分は泣いてるなと思って眼瞼を閉じてみると、雫の玉がブリキ屑に落ちたかしてぽとんという音がした。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽとりぽとりと一つ／＼寂しい音をして涙は落つるのであつた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎が顔をまつかにして、汗をぽとぽとおとしながら、その坂をのぼりますと、にはかにぱつと明るくなつて、眼がちくつとしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　他吉は子守歌をうたい、そして、狭い路地をすれすれにひいてはいると、水道場に鈍い裸電灯がともっていて、水滴の音がぽとりぽとり、それがにわかに夜更めいて、間もなく夜店だしが帰って来る時分だろうか、ひとり者の〆団治がこそこそ夜食を食べているのが、障子にうつっていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "処へ、ほんの唯五六人で、ぽとぽとと沈めた拍手があった。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして到頭、一層暗くなっていたその眼からは涙がぽとぽとと流れ出したのであった。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらしなく降りつづける雨に草木も土もふやけ切って、空までがぽとりと地面の上に落ちて来そうにだらけていた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっと音をたてて襲って来る毛の束にしたたか打れた虻は、血を吸って丸くなったまま、馬の腹からぽとりと地に落ちた。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、搖られてぽとりと落ちた露が私の頬を打つ。",
              "citation": {
                "source": "脱殼",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "傭人は大釜の下にぽつぽと火を焚いてあたつて居る。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "樅の棒は見るうちに火がついてぽつぽと燃える。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは一寸白くなった皮膚のおもてが、次第に桃色を帯びてきて、到頭プツリと真赤な血の粒が一点から盛上ると、見る見るそれが大きくなり、やがて糸をひいて、ぽとりと土の上に垂れるのであった。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ではすかんぽといふ。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "職人はたぶん女中の頸をおまけに剃ってやっていたのであろうが、あたしがあんまり跳るので、女中にもなんしょで、ひょいと、あたしのお奴を片っぽとってしまった。",
              "citation": {
                "source": "旧聞日本橋",
                "author": "町の構成",
                "note": "青空文庫"
              }
            },
            {
              "text": "深く、肋へかけたその切ッ先は、ななめに通った床框の一端にポトッ――と赤い糸をひいていました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
