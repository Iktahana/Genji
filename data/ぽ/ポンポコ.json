    "definitions": [
      {
        "index": 1,
        "gloss": "sounding of a drum or hand drum",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お祭りの太鼓がぽんぽこと鳴り響き、活気に満ちていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、おもちゃの太鼓をぽんぽこ叩いて遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "山の奥から、狸の腹鼓がぽんぽこと聞こえてくるようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さっそく、もるもっとの　おいしゃが、いたちの　ぽんぽこに　ふくれた　おなかを　しんさつしました。",
              "citation": {
                "source": "がちょうの　たんじょうび",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　小屋から巻き起つて来る唱歌は、狸よ、狸よ、お寺の庭は、今宵も隈なき月夜の萩の花ざかり、同勢集めて出ておいで、一杯機嫌のお月見で、和尚さんは大浮れ、浮れて浮れてぽんぽこぽん、お前も負けずに打てや打て、ぽんぽこぽんと腹鼓……。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌詞を私は、覚えなかつたのであるが、たしかそんな意味合ひのおどけた童謡で、ぽんぽこぽん……と、腹鼓の擬音を一節毎に合唱するのであつた。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽんぽこぽん／＼のこうらすが聴くも身の毛がよだつばかりに乱脈な調子で繰り返されてゐる。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やつぱり君が居ないと駄目なんだよ、何うも俺達覚えの悪いには吾ながらあきれたね、あんなに百万遍も教はつたナンシー・リーもリング・リング・ド・バンジヨウも乃至は旗の歌といひヤンキー・ドウルも、いざ歌はうとして見ると、おしなべてぽんぽこぽんの歌と同じ節になつてしまふんだよ。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺達の腹がルウテル博士のそれのやうに、ぽんぽこぽんにふくれあがるまで歌つて歌つて歌いぬいて呉れい。",
              "citation": {
                "source": "歌へる日まで",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "full (stomach)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "焼肉をたくさん食べて、お腹がぽんぽこになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "赤ちゃんはミルクを飲んで、お腹がぽんぽこだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昼食後でお腹がぽんぽこなので、午後は眠気に襲われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
