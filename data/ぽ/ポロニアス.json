        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それがハムレツトの台辞よろしくあつて、だんだんあいつが太夫につめよつて来た時に、間の悪い時は又間の悪いもので、奈良茂の大将が一杯機嫌でどこで聞きかじったか、「What, ho! help! help! help!」とポロニアスの声色を使つたぢやないか。",
              "citation": {
                "source": "南瓜",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでほんもののポロニアスなら「Oh! I am slain.」と云ふ所なんだが、刀は切れるし、急所だし、うんと云つたきりお客は往生さ。",
              "citation": {
                "source": "南瓜",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポロニアスは手に入ったもの。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "うるさく嗅ぎ廻わりやあがる』　彼は眉毛一つ動かさぬルパンをジッと見詰めていたが、さすがにこの男がかつて自分がポロニアスと綽名をつけたあの食堂に隠れていた男と同一人だとは気が附かなかった。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポロニアスに同情する。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
