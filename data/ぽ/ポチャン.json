        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やがて森かげの池の水が、ぽちゃんと鳴って、貫一無念のピストルを呑んだ。",
              "citation": {
                "source": "奇賊悲願",
                "author": "烏啼天駆シリーズ・３",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ぽちゃんともどぶんとも音がしない。",
              "citation": {
                "source": "時計屋敷の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽちゃん、と仮橋の下で、小さな水音がした。",
              "citation": {
                "source": "下頭橋由来",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その水が、石でも投げ込んだように、ぽちゃんと、はねたのです。",
              "citation": {
                "source": "おれは二十面相だ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に灰色の煙がムックリと小舟の全体を引っ包んだ中から、友吉おやじの手か、足か、顔か、それとも舷か、板子か、何だかわからない黒いものが八方に飛び散ってポチャンポチャンと海へ落ちた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズルリズルリと下がって来るうちに、見る見る綱が詰まって来てポチャンポチャンと海へ陥ち込む。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕をへし折られては大変ですから、思わずその手を一振り振りますと、それに掴まっていたお婆さんは、まるで紙布のように宙に飛んで、河の中へポチャンと落ちてドンドン流れてゆきました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々ポチャンと音して、魚がはねる。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチャンと水の音がした。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かな池の中へポチャンと小石を抛り込んだ様な会話だ。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
