        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キックキックトントンキックキックトントン　　凍み雪しんこ、堅雪かんこ、　　　　　　野原のまんぢゅうはぽっぽっぽ　　酔ってひょろひょろ太右衛門が　　　　　　去年、三十八たべた。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックトントン、キックキック、トントン、　　凍み雪しんこ、堅雪かんこ、　　　　　　野原のおそばはぽっぽっぽ、　　酔ってひょろひょろ清作が　　　　　　去年十三ばい喰べた。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックトントンキックキックトントン　凍み雪しんこ、堅雪かんこ、　　　　　野原のまんじゅうはぽっぽっぽ　酔ってひょろひょろ太右衛門が　　　　　去年、三十八たべた。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キックキックトントン、キックキック、トントン、　凍み雪しんこ、堅雪かんこ、　　　　　野原のおそばはぽっぽっぽ、　酔ってひょろひょろ清作が　　　　　去年十三ばい喰べた。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟹の子供らもぽっぽっぽっとつづけて五六｜粒泡を吐きました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕がマントをフゥとやって通ったら火がぽっぽっと青くうごいてね、とうとう消えてしまったよ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがまた、真岡、アイヌ語のモウカ「美しい波の上」という美しい語義を持った樺太西海岸での第一の市街から、南へ南へ、終点本斗を指して出た、や、それは今出たばかりの煙の、むくり、むくり、むくり、ぽっ、ぽっぽっである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「富さんの家で何かどたんばたんという音が聞えたから、どうしたのかと思って駆けつけてみると、富さんは湯あがりの頭からぽっぽっ煙を立てて、その叔父さんという人の胸倉を掴んで、ひどい権幕で何か掛け合いを付けているんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "三河万歳",
                "note": "青空文庫"
              }
            },
            {
              "text": "益満は、左手の煙管を口へ当てて、舌の先で、ぽっぽっと音させつつ、右手の刀を、浪人の咽喉の見当へ三尺程のところから、ぴたりと当てて「たって斬ろうと申さん。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚いてふすまを開けますと、ランプの心が多く出て居て、ぽっぽっと黒煙が立ち上って、室内が煙で暗くなっています。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭がぽっぽっとして来て体が宙にういて行く様になった。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、ぽっぽっと、鳩時計が時をうちはじめた。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽっぽっと、湯気の立つ皿の上をながめて、彼は、まだ食べない先から、盛に、ごくりごくりと唾をのみこんでいる。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れやかな日の光に、蓆からぽっぽっと湯気が立っていた。",
              "citation": {
                "source": "丘の上",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽっぽっと火照った顏や、きらきら光る眼や、うまく※らない舌先が、明らかにそれを實證していた。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さ、少しおかけなさい」　ラスコーリニコフは腰をおろした、戦慄はしだいにおさまり、体じゅうが一面にぽっぽっとしてきた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "……貴公よいお年をしながら、巷の人気などにぽっぽっとしてはいかぬぞ」「そんな、軽薄な存念とお考えあることが心外じゃ。",
              "citation": {
                "source": "べんがら炬燵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「凍み雪しんこ、堅雪かんこ、　　　　野原のまんぢゅうはポッポッポ。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「凍み雪しんこ、堅雪かんこ、　　　野原のまんじゅうはポッポッポ。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙片、莨の吸殻などの落ち散った汚い地面はまだしっとりして、木立ちや建物に淡い濛靄がかかり、鳩の啼き声が湿気のある空気にポッポッと聞えた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠慮のない大陸的なヤケに熱い太陽で、その辺から今にもポッポッと火が出そうに思われた。",
              "citation": {
                "source": "人を殺す犬",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁があったと見えて磯はかがりと人いきれとでポッポッと燃えて赤いかがやきは波にゆられて向うの陸に住んで居る人にしらせに行く様に動いて居た。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポッポッ湯気のたつおでん屋の屋台に首を突込んで、箸につみれを突きさした初ちゃんが店の灯を消して一生懸命茶飯をたべていた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "前垂れを掛けたまゝ竹籔や、小川や洋館の横を通って、だらだらと丘を降りると、ポッポッ！",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく湿度計は乾湿ハイグロメーターの湿球のような状態におかれ、水銀は急に熱を奪われて萎縮したことでしょうし、湿度計の方は、その傍に居る人の衣服がポッポッと湯気を出して乾燥中であるために殆んど飽和状態に近い湿度を記録したのでありましょう。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋を出るとき、ふりかえってみると、大川巡査部長は長椅子の上にドッカと腰うちかけ、帽子を脱いていたが、毬栗頭からはポッポッポッと、さかんに湯気が上っているのが見えた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の全身は、圧力から俄かに解放されて、ポッポッと激しい熱感に襲われたのだった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭からポッポッと湯気を出して怒っている警官の顔が見えるようでした。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けさもね、鳩ポッポを教えたらもうすっかりおぼえこんじまって、さあ、俊ちゃん、小母さんにポッポッポを唱って上げれせ。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "風のかげんで、機関のザッザッポッポッという音が、遠くなったり近くなったりする。",
              "citation": {
                "source": "くまと車掌",
                "author": "木内高音",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
