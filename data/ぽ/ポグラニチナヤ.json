          "literary": [
            {
              "text": "安重根　今じゃあ出世してねえ、ポグラニチナヤの税関の主事をしているよ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、手紙を出して頼んであるけれど、僕あポグラニチナヤへ行って、よく相談しようと思っている。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "安重根　（熱心に）先生、ほんとに僕は途中ちょっとポグラニチナヤへ寄って、それから、家族を迎えに（ハルビンへ）行くんです。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "10ポグラニチナヤの裏町、不潔な洋風街路、劉任瞻韓薬房前。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポグラニチナヤに劉東夏という、若いがロシア語の上手な人がいる。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "このポグラニチナヤに途中下車したのも、劉君に同行してもらうためだったのさ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "李剛先生が、きっとこのポグラニチナヤの劉任瞻というお薬屋に寄っているだろうとおっしゃって――。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "安さんは必ずポグラニチナヤに途中下車して、まだそこの劉任瞻という薬屋にいるだろうから、あたしに後を追って渡すようにと言うんでしょう。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "安重根　（急き込む）ポグラニチナヤへ引っ返すか、さもなければチタあたりの、朝鮮人の多いところへ紛れ込むんだ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "次第に述懐的に）そうだ、僕の家に塾があってねえ、あのポグラニチナヤの趙康英や、ハルビンの金成白、それに僕の弟の安定根と安恭根など、みんな一緒に漢文を習ったものさ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
