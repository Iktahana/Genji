        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さう云へば思ひ出すが、ポオレット・パックスといふサラ・ベルナアル座の女優を、一度ピトエフが「海の夫人」に見立てたことがあつた。",
              "citation": {
                "source": "巴里で観たイプセン劇",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレットとマルセル、腕を組みながら、留雄の後ろを通り過ぎる。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレット　　（留雄のゐるのに気づき）お待ちよ、いつかのあれがゐるから……（留雄の肩に手かけ、馴れ馴れしく）何してるの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "留雄　　（振り向いて、さほど驚いた様子もなく、心もち眉をよせて、ポオレットの顔を見る）ポオレット　　あたしよ、忘れたの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレット　　（ちらとマルセルに笑ひかけ）久しぶりね。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレット　　それでおしまひなの。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレット　　あんた、その後、西村さんに会つた。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレット　　怒つてた。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（正面を向く）ポオレット　　いやなこつた、あんな猿。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルセル　　（留雄の顔を見つめ、何か思ひ出したやうに吹き出す）ポオレット　　（マルセルに）何がをかしいんだよ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（パンを投げる）ポオレット　　（マルセルをにらむ真似して）マルセルがね、あんたと何処かへ行きたいつて。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "留雄　　（黙つてパンを投げる）ポオレット　　この娘、支那語で、「ありがたう」つて云へるのよ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポオレット　　うるさいなあ。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "留雄　　（ポオレットの方をにらむ）マルセル　　（留雄を見返り）あの顔。",
              "citation": {
                "source": "古い玩具（一幕六場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
