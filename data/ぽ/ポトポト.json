        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一郎が顔をまっかにして、汗をぽとぽとおとしながら、その坂をのぼりますと、にわかにぱっと明るくなって、眼がちくっとしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は表の戸をそっと閉めて、しめっぽい畳の上にあぐらを掻いて、時々に天井裏へぽとぽとと落ちて来る雨漏の音を聴いていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎が顔をまつかにして、汗をぽとぽとおとしながら、その坂をのぼりますと、にはかにぱつと明るくなつて、眼がちくつとしました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "処へ、ほんの唯五六人で、ぽとぽとと沈めた拍手があった。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして到頭、一層暗くなっていたその眼からは涙がぽとぽとと流れ出したのであった。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからていうもの、君、敵塁の方から速射砲発射の音がぽとぽと、ぽとぽとと聴える様になる。",
              "citation": {
                "source": "戦話",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵塁の速射砲を発するぽとぽと、ぽとぽとと云う響きが聴えたのは、如何にも怖いものや。",
              "citation": {
                "source": "戦話",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖父さんが、本を盗見してゐた自分を叱るとばかり思つてゐた栄蔵は、急にやさしいお祖父さんの言葉をきいて、ぽとぽと涙が出て来た。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "久助君は胸があつくなり、なみだが目にあふれ、ぽとぽとと落ちた。",
              "citation": {
                "source": "川",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "吸い付いたが最後、容易に離れまいとするのを無理に引きちぎって投げ捨てると、三角に裂けた疵口から真紅な血が止め度もなしにぽとぽとと流れて出ます。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷄は刃物で喉を切り裂かれたらしく、その傷口からは生血がまだぽとぽとと滴っていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "水がぽとぽととこぼれたが細君は飲まなかつた。",
              "citation": {
                "source": "水郷異聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水がぽとぽととこぼれたが細君は飲まなかった。",
              "citation": {
                "source": "水郷異聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝ずの番が、ぽとぽと、廊下へ草履の音を立てて、廻ってしまった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぽとぽと液体の滴る音がした。",
              "citation": {
                "source": "ロボットとベッドの重量",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜更けの秋雨がぽとぽとと工場のトタンの庇を打つ。",
              "citation": {
                "source": "虹",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて湯を持つて來た笹原は、早苗の紅茶茶碗を湯であたゝめて、またそれを障子の外へ捨てに行き、とぽとぽと音をさせて、湯氣の立ちのぼる熱い紅茶を靜かに淹れてゐる。",
              "citation": {
                "source": "風媒",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、妙な音が部屋の中でする樣なので細めた灯をかきあげてみると果して隅の一本の柱がべつとりと濡れて、そのあたりにぽとぽとと雨が漏つてゐるのである。",
              "citation": {
                "source": "山寺",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、どこからか、ぽとぽとと水がもってくる。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう午前の一時で、雨が陰気に窓ガラスをぽとぽと打ち、蝋燭はほとんど燃え尽きていたが、そのとき、冷えかけた薄暗い光で、その造られたものの鈍い黄いろの眼が開くのが見えた。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "桑の枝を折ろうとすると、熟しきった赤い実が、ぽとぽとと落ちました。",
              "citation": {
                "source": "芽は伸びる",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時豆腐を箸でおして見ると軽い弾力ができていて、肴の白子かクリームのようにぽとぽとしていい煮え加減になっている、その刹那がうまい。",
              "citation": {
                "source": "湯豆腐のやり方",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "（私の内臓はひきさかれ、濃い血がぽとぽと落ちるのだ。",
              "citation": {
                "source": "四年のあいだのこと",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　母親は、寛い胸から乳房を掴み出し、柔らかいぽとぽと音を立てて陶物に滴れる乳を見ながら、口惜しそうに云った。",
              "citation": {
                "source": "童子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "青ぞらはふるい　ひかりはくだけ　風のきしり　陽は織れど　かなし」　野ばらの木が赤い実から水晶の雫をポトポトこぼしながらしずかに歌いました。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして林の底の萱の葉は夏の夜の雫をもうポトポト落して居りました。",
              "citation": {
                "source": "二十六夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉の青春のさびしさがこんなことにも哀しく現れていると、ポトポト涙を落しながら、道子はペンを取って返事をしたためた。",
              "citation": {
                "source": "旅への誘い",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しょんぼり蚊帳を釣りながら池の食用蛙の鳴声を聴いていると、ポトポト涙が落ちた。",
              "citation": {
                "source": "蚊帳",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "涙が机の上にポトポトと落ちた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　倭文子は、宮田の言葉をきいていると、先刻からのなさけなさが、口惜しさが、急に大つぶの涙になって、ポトポトと膝の上に落ちた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
