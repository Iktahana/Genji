          "literary": [
            {
              "text": "一切の生と、其プロバビリテイとポツシビリテイとを擧げて無價値と斷じ去る者こそ眞正に死を怖れない者であらうが、此の如く斷じ去るは厭世者の誇張である。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は唯自分の持つて生れて來たものを發展させ、淨化させるポツシビリテイを持つてゐるのみであつた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
