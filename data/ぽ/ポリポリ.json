        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "蚊に刺されたところが痒くて、無意識にポリポリとかいてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "乾燥で肌がカサカサして、ついポリポリとかいてしまうんだよね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "くしゃみが出そうになって、鼻のあたりをポリポリとかいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
