    "definitions": [
      {
        "index": 1,
        "gloss": "pawpaw (Asimina triloba)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アメリカ南部に自生するポーポーは、トロピカルな風味の果物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "初めて食べたポーポーの味は、マンゴーとバナナを合わせたようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ポーポーの木は、日本の気候でも育てられるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そして人が訪ねて來ると、時々その笛をポーポーと鳴らしながら、「こいつを吹いとると、人生の寂しさを忘れるわえ。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オッペケペー、オッペケペッポーポー。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の森では、夜になると梟がポーポーと鳴いた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓦斯のポーポーと云う声よりももっと低い様な調子で話しながらしげしげ四方を見廻した。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポーポー湯気がたって、美味そうな匂いがする。",
              "citation": {
                "source": "従妹への手紙",
                "author": "――「子供の家」の物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽笛がポーポーと鳴った。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "轟々、轢轆、プープー、ポーポー。",
              "citation": {
                "source": "聚樂廻り",
                "author": "羽田亨",
                "note": "青空文庫"
              }
            },
            {
              "text": "福島県石川郡には、虎杖をテテポーポーという例があると報ぜられる。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "北秋田の扇田あたりから、鹿角郡にかけてはポーポーといっていた。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋田県北部などの、烏をポーポーと喚んでいる地方では、その藁製の飾り物をポッポカラといっている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "……牛肉を少々買つて、生々と差しつけては見たけれど、恁う、嘴を伏せ、翼をすぼめ、あとじさりに、目を据ゑつゝ、あはれに悄気て、ホ、と寂しく、ホと弱く、ポポーと真昼の夢に魘されたやうに鳴く。",
              "citation": {
                "source": "玉川の草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき先頭に駆っている自動車から、ポポーッ、ポポーッと警笛が鳴りひびきました。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ポポーフという男のくせだ）それは奇麗ずきで、目先をかえたがってこせつくことだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ポポー※（大喪の服をきて、一葉の肖像写真から眼をはなさない）とルカールカー　困りますなあ、奥さま。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ポポー※　ああ、二度とふたたび、外へなんか出ないよ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　（きっぱりと）いいから、もう二度とわたしに、そんな話はしないでおくれ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ルカー　まあ、そんなことを仰しゃるひまに、ひとつお庭を散歩でもなさるか、いっそトビーかヴェリカン〔ともに馬の名〕を馬車につなげと言いつけて、ご近所へ訪問におでかけになっては……ポポー※　ああ！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　あの人は、トビーをあんなに可愛がっていた！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　（身ぶるいして）だれだろう？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）二ポポー※（ひとり）ポポー※　（写真を見ながら）いまに見せたげますよ、ニコラス、わたしがどんなに愛のまことを心得た女か、どんなに人の罪を赦せる女か、ということをね。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "浮気をしたり、もんちゃくを持ちあげたり、なん週間もうちを明けたり……三ポポー※とルカールカー　（登場、おどおどして）奥さま、だれだか、たずねてまいりましたよ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "お目にかかりたいって……ポポー※　でもお前は、こう言ったんだろうね？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　わたしは、お目に、か・か・り・ま・せん！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルカー　それは、よく申しましたが……何しろ、森の主みたいなどえらい男でして、大声でがなり立てて、ずかずかあがりこんで来ますんで……もう、食堂まで来ております……ポポー※　（いらだって）じゃいい、お通し。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　ほんとに困った連中だこと！",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ため息をつく）だめ、だめ、こうなったらもう、ほんとに尼寺へでも行かなくちゃ……（考えこむ）そう、尼寺へ……四ポポー※、ルカー、スミルノーフスミルノーフ　（入りながら、ルカーに）でくのぼうめ、つべこべご託をならべやがる。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ポポー※を見て、威容をつくり）これは奥さま、初めてお目にかかります。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこぶる重要な用件のため、ご静閑をわずらわしますが……ポポー※　（手をあたえずに）どういうご用向きでしょう？",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　千二百……。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポポー※　（ため息をつきながら、ルカーに）いいかい、ルカー、お前わすれないでね――トビーにカラス麦を五百｜匁、おまけにやるように言うんだよ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
