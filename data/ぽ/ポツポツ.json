          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨がポツポツと降り始め、傘を差した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "軒先から雨水がポツポツと落ちてくる音がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "植木鉢に水をやると、土にポツポツと水滴が染み込んでいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
