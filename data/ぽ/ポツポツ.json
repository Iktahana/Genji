[
  {
    "uuid": "9cfb061c-f0ff-57ae-8c16-92f2d0948c70",
    "entry": "ポツポツ",
    "reading": {
      "primary": "ポツポツ",
      "alternatives": [
        "ぽつぽつ"
      ],
      "is_heteronym": false
    },
    "grammar": {
