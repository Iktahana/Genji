        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "胃カメラ検査で、胃壁にできた複数のポリープが確認された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ポリープ切除手術は、日帰りで行える場合も多いと聞いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "喉のポリープは声帯に影響を与えることがあるため、専門医の診察が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
