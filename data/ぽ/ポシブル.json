        "examples": {
          "standard": [
            {
              "text": "困難な状況でも、諦めなければ何でもポシブルだと信じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "アズ・スーン・アズ・ポシブルでこの資料を仕上げて提出してください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ミッション・ポシブルと言えるほど、今回のプロジェクトは成功の確率が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "が、ポシブルだとね」　私は、内心藤枝の説を喜びながらもちよつと、抗議を出して見た。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "インポシブル興味とはパラドックス（思想の手品）のことなり。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただポッシブルでさえあればどんな事件でも探偵小説の筋の中へ織りこまれて、効果をもち得る。",
              "citation": {
                "source": "現下文壇と探偵小説",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポッシブルというのは、現代人の知的水準においてポッシブルであるということを意味する。",
              "citation": {
                "source": "現下文壇と探偵小説",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "無限なる属性の基体としての神は、コンポッシブルの世界の主体、事の世界の主体でなければならない。",
              "citation": {
                "source": "デカルト哲学について",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、この怪奇な、ポッシブル〔わずかでも可能な〕ではあってもプロバブル〔まず確実な〕でない世界の構成が、少しでも拙劣だと、作品の存在理由がよほど希薄になる。",
              "citation": {
                "source": "探偵小説壇の諸傾向",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
