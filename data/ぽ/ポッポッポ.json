            },
            {
              "text": "「凍み雪しんこ、堅雪かんこ、　　　野原のまんじゅうはポッポッポ。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋を出るとき、ふりかえってみると、大川巡査部長は長椅子の上にドッカと腰うちかけ、帽子を脱いていたが、毬栗頭からはポッポッポッと、さかんに湯気が上っているのが見えた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けさもね、鳩ポッポを教えたらもうすっかりおぼえこんじまって、さあ、俊ちゃん、小母さんにポッポッポを唱って上げれせ。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽笛一声、またポッポッポと出てゆく。",
              "citation": {
                "source": "真珠の首飾り",
                "author": "ZHEMCHUZHNOE OZHERELJE",
                "note": "青空文庫"
              }
            }
          ]
        }
