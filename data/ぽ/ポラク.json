        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一八九八年（十五歳）のころ、何人かの親しい友人がいたが、そのうちとくにオスカー・ポラクとの交友は一九〇四年初めまでつづき、少年時代のカフカに影響があった。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポラクはのちに重要な美術史家となったが、第一次大戦で戦死した。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            },
            {
              "text": "このころ、『子供と町』と題する長編の一部分と、すでに書いていたと思われる詩・散文を友人ポラクに送ったが、これらはことごとく散佚してしまった。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            },
            {
              "text": "メラーンからミレナ・イェセンスカ＝ポラクにさかんに手紙を送り、彼女とのあいだは恋愛関係にまで深まった。",
              "citation": {
                "source": "「世界文学大系58　カフカ」年譜",
                "author": "原田義人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
