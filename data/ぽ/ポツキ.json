        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「軽便」の煙突は釜に不釣合に細長くて頂きに網をかむせた盥のやうな恰好のものが載つてゐるので、暴風などにあたつて激しく揺れ過ぎると、中途からポツキリと折れることがあつた。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒な事に、横着きうりは　真中から　ポツキンと二つに　折れてしまひました。",
              "citation": {
                "source": "きりぎりす　の　かひもの",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝が弓のやうに輪を画いて円く曲つたと思ふと、其枝はポツキと折れて大きな親猿は小枝を握つたまゝ二十間もあらうと思はれる高い所から、ドブン！",
              "citation": {
                "source": "山さち川さち",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
