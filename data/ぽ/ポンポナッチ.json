          "literary": [
            {
              "text": "当時のパドヴァにおける有名な教師はアキリニとポンポナッチ（ポンパナティウス）であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンポナッチもピエトロと密接な関係があった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンポナッチのアリストテレス主義は注釈者であるアフロディシアスのアレクサンドロスによるものでありピエトロはこの著者の本を飜訳していた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしポンポナッチは独創的な思想家でもあった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
