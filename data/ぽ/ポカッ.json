        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夕闇のなかでその扇子が恐ろしいほど白っぽかった。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "街は、一層きたなく、ホコリッぽかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人がそのあかしの前を通って行くときは、その小さな豆いろの火はちょうどあいさつでもするようにぽかっと消え、二人が過ぎて行くときまた点くのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ぜんたい雲というものは、風のぐあいで、行ったり来たりぽかっと無くなってみたり、俄かにまたでてきたりするもんだ。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人がそのあかしの前を通って行くときはその小さな豆いろの火はちょうど挨拶でもするようにぽかっと消え二人が過ぎて行くときまた点くのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人がそのあかしの前を通って行くときはその小さな豆いろの火はちゃうど挨拶でもするやうにぽかっと消え二人が過ぎて行くときまた点くのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人がそのあかしの前を通って行くときはその小さな豆いろの火はちゃうど挨拶でもするやうにぽかっと消えて二人が通って行くときまた点くのでした。",
              "citation": {
                "source": "〔「銀河鉄道の夜」初期形一〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "香もなく花も貧しいのぎ蘭がそのところどころに生えているばかりで、杉の根方はどこも暗く湿っぽかった。",
              "citation": {
                "source": "筧の話",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」言ってしまって、如何にも自分の詞が馬鹿気て、拙くて、荒っぽかったと感じたのである。",
              "citation": {
                "source": "白",
                "author": "リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひなげしはみんなあっけにとられてぽかっとそらをながめています。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓を開けたまんまで寝たから、夜風が入って湿っぽかったらただ湿っぽかったで可かろう。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月は、二十日すぎまで山桜が咲いていたし、むこうの段丘にある畑が茶色っぽかったが、いまでは、そこも緑でおおわれている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "坑道の天井からは、永年の埃の堆積が鍾乳石のような形で垂れ下っていて、呼吸をするごとに細塵が飛散してきて、咽喉が擽られるように咽っぽかった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老婦人は子供っぽかった。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ただの家と、その邸内の単純な景色を――荒れはてた壁を――眼のような、ぽかっと開いた窓を――少しばかり生い繁った菅草を――四、五本の枯れた樹々の白い幹を――眺めた。",
              "citation": {
                "source": "アッシャー家の崩壊",
                "author": "THE FALL OF HOUSE OF USHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺達から愚痴ッぽかったら――もう、最後だよ」「見れ、お前えだけだ、元気のええのア。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "喫茶店の台所は狭くて、ゴタゴタしていて、ジュク／＼と湿ッぽかった。",
              "citation": {
                "source": "党生活者",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中は、薄暗くて、むせっぽかった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして酷く憐れっぽかった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先生え――」ぽかっと、古沼に浮きあがった水泡のように、思いがけなく塚原義夫が立ちあがった。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂の中ほどまでやって来ると、視野が改まり、向うに中学の色｜褪せた校舎が見えたが、彼の脚はひだるく熱っぽかった。",
              "citation": {
                "source": "冬日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ、顔は子供っぽかったが、躯は壮丁なみに発達していた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "その青年は、背が極く低くて子供ぽかった。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりは暗かったけれど、その二人の服装が白っぽかったので、鷺太郎にはその輪廓を読みとることが出来、一人はたしか山鹿だ、と断定はしたが、も一人の女性の方は、山鹿と交際していないので誰だったか解ろう筈もなかった。",
              "citation": {
                "source": "鱗粉",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし熱があって、感じが熱っぽかったら気をつけてやめます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜すこし熱っぽかったが、きょうは大丈夫。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "家じゅうしめっぽかったり何かするところのないさっぱりした気分で、例の茶の間に坐って小説よんでいたら、青い八つ手の葉かげが、二月堂の机（黒塗りでふちに赤い細い線の入っているの）の上に青くちらついて、ちょっと、いらっしゃらない？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十日すぎから四月初めの荒っぽかった天気もお思い出しになったでしょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が、あんこで云えば飛切り上等というところまで火が入ってねりがきいていず、ざらついたり水っぽかったりして、それを味わうとき、あなたの胸の内側はいやな思いでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしがしっかりのみ込みました」　その時です、お月さまがカブンと山へおはいりになって、あたりがポカッと、うすぐらくなったのは。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
