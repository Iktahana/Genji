        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なるほど中学生の質屋通いは見物だろう）　奥へはいって行く時、兵児帯の結び目が嘲笑的にぽこぽこ揺れていたのを想い出した。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪岡がぽこぽこと歩くにつれて、蹄の跡が幾つも幾つも赤黒く路面に残った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あめが　ふった　あとなどに　ぽこぽこと　つちから　あたまを　だすので　あります。",
              "citation": {
                "source": "たけのこ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこだけぽこぽこと乾いた土を見たものだ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの仲間によって築かれたま新しい路の上を――草鞋のあしうらにぽこぽこと感ずるまだ軟かい盛土の上を――その男は足ばやに立ち去った。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（とても、逢える筈がない――）　黒吉は、研究所の裏門を抜けると、ぽこぽことした白茶けた埃っぽい道を、当てもなく町端れの方に歩いていた。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈火の明らかでない様子や、足下の地面が乾いてぽこぽこ砂塵をあげるのが、おせいに何となく、田舎の郡役所などの正面を思い起させた。",
              "citation": {
                "source": "午市",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあたりで日常的に、新種の細菌がぽこぽこと生まれたりしない限りはそうなる。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを通り抜けて、一畳｜幅に五畳か六畳を長く敷いた入側見たような薄暗い部屋を通ったが、茶の間でもその部屋でも処※で、足踏につれてポコポコと弛んで浮いている根太板のヘンな音がした。",
              "citation": {
                "source": "観画談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、アメガ　フツタ　アトナドニ　ポコポコト　ツチカラ　アタマヲ　ダスノデ　アリマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに※椎の音聞える間は首斬れず苦痛少しく息むと告げたので、寺で木魚を打ち出したポコポコだそうな。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャカポコチャカポコチャカポコチャカポコ……　　　　　　　九　▼チャチャラカ、ポコポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカラカ、ポコポコ……扨も左様なイカサマ病院。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな本懐｜至極は御座らぬ……ポコポコチャカチャカ……　▼あ――ア。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の喜び天井知らずじゃ……チャカチャカポコポコポコポコチャカチャカポコポコ……　　　　　　　十　▼スチャラカ、チャカポコ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポコポコした疊や、汐つぱい戸障子ながら、岡田村のあの宿へはもういちど行つても惡るくはない氣持ちです。",
              "citation": {
                "source": "大島行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポコポコしたところへ逃げずに、ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうはふとん干してポコポコです、風邪ふせぎに丁度ようございました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、暖炉でポコポコ石炭が燃える冬や、積った雪に似合わしいか？",
              "citation": {
                "source": "小景",
                "author": "――ふるき市街の回想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "中高な門内の道を出ると菊太はチョイと振り返って草の両側に生えて居る道を、ポコポコと小さいほこりの煙をたてて帰って行く。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三番池の周囲の草原の草は皆、かれはてて、茶色になり、朝々の霜で土がうき、ポコポコになって、見通せる限り皆、なだらかなでこぼこになって居る。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑地を隔てた彼方に白々と続いて居る町からの往還をながめやったり小女のせっせと土間を掃いて居る傍に訳もなく立って見たり、遠い向うの木の間から三台の人力が小さくポコポコと立つ砂煙りの中に走って来るのを見つけるまでの間は、お久美さんにとっては居ても立っても居られない苦しい時の歩みであった。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "太い木の枝を杖に突いて、ポコポコ、ポコポコ破れた古鞋の足元から砂煙りを立てながら歩いて来た禰宜様宮田は、とある堤に荷をもたせかけるようにしてホッと息を入れた。",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "広場の土は数十万の勤労者の足に踏みしだかれ、ポコポコになって、昼間の熱気を含んでいる。",
              "citation": {
                "source": "インターナショナルとともに",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポンポコ、ポンポコ、ポコポコポン、ポンポコ、ポンポコ、ポコポコポン。",
              "citation": {
                "source": "狸のお祭り",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをポコポコぶッとばす野球の選手がいるのだから、あんな矢留めは元々子供ダマシのたぐい、座興ではとにかくとして、剣の奥儀として演技するのは大マチガイだ。",
              "citation": {
                "source": "馬庭念流のこと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "プロの捕手もできない芸当を、アマチュアがポコポコ当ててぶッ倒すのは愉快だろうし、できないはずもない。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はやる俗の木魚や朧月　　　　太祇　元来木魚は仏前に置かれて僧の手によって取扱われるべき性質のものであるが、俗間の好事家は、それを居間などに置いて唯ポコポコと打って喜んだり、あるいは人を呼ぶ時の呼鈴の代りにしたりしておる。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃は何かというと木魚を用いるのであるが、またここにもそのポコポコいう音がしておる。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
