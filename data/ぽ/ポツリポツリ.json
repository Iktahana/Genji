        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨がポツリポツリと降り始めたので、洗濯物を急いで取り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "軒下から雨水がポツリポツリと落ち、地面に小さな水たまりができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "涙がポツリポツリと頬を伝い落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
