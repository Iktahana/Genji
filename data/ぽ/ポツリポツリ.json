    },
    "definitions": [
      {
        "index": 1,
        "gloss": "intermittently",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、自分の過去についてポツリポツリと語り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "雨がポツリポツリと降ったり止んだりしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "授業中、先生の問いかけに生徒がポツリポツリと答える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "丁度そのときさっきからどうしても降りそうに見えた空から雨つぶがポツリポツリとやって来ました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度そのときさっきからどうしても降りさうに見えた空から雨つぶがポツリポツリとやって来ました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはは……」　小田の分類によると、三高出身者には、軽佻浮薄派（さしずめ小田がその代表）と、重厚派の二種類あるが、吉井は、「重厚派と見られることを最もいやがっている所の重厚派」であるだけに、ねちねちした口調で、ポツリポツリ語りだした。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが夏も過ぎ秋が深くなって、金木犀の花がポツリポツリ中庭の苔の上に落ちる頃のある夕方、佐伯が町へ出ようとしてアパートの裏口に落ちていた夕刊をふと手にとって見ると、友田恭助が戦死したという記事が出ていた。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしやがて横堀がポツリポツリ語りだした話を聴いているうちに、私の頭の中には次第に一つの小説が作りあげられて行った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「話せば長いが……」　店が焼けてから飲み覚えた酒に、いくらか酔っていたのであろう、天辰の主人は問わず語りにポツリポツリ語った。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　自分の鋭い不意打の決断に、すっかり魂消て了った秋田の顔を見ながら、ニコニコ微笑していた大月は、軈て、煙草の煙を環に吹きながらポツリポツリと言葉を続けた。",
              "citation": {
                "source": "花束の虫",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、議論はともあれ、初めは微酔気味であったのが段々真剣になって低い沈んだ調子でポツリポツリと話すのが淋しい秋の寂寞に浸み入るような気がして、内心承服出来ない言葉の一つ一つをシンミリと味わせられた。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寝よう乎」と寝返りしては復た暫らくして、「どうも寝られない」と向き直ってポツリポツリと話し出し、とうとう鶏の音が聞えて雨戸の隙が白んで来たまでも語り続けた。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二葉亭の歿後知人は皆申合わしたように二葉亭の風に加えて、双眉の間に深い縦の皺を刻みつつ緊と結んだ口から考え考えポツリポツリと重苦しく語る応対ぶりは一見信頼するに足る人物と思わせずには置かなかった。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてポツリポツリと、糠のようなわびしい秋時雨でした。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ震災後今日まで、警察の方でも仕事が多過ぎて手のつけようがないので、仕方なしにポツリポツリとやっている状態ですから、そう隅々まで行届きますまい。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはな」と天草さえない調子で、ポツリポツリと話し出した。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と矢張固くなりながら、訥弁でポツリポツリと両親の言伝を述べると、奥様は聴いているのか、いないのか、上調子ではあはあと受けながら、厭に赤ちゃけた出がらしの番茶を一杯｜注いで呉れたぎりで、一向構って呉れない。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はハンケチの中から茱萸を出しながらポツリポツリと食うている。",
              "citation": {
                "source": "くだもの",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、ポツリポツリ氏の作が「新青年」に発表されるごとに、私はむさぼり読んで、江戸川党となった。",
              "citation": {
                "source": "江戸川氏と私",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌年中、同氏はやはりポツリポツリ発表した。",
              "citation": {
                "source": "江戸川氏と私",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの旧の高輪の学窓のチャペルで、夏期学校で、あるいはその他の説教の会で、捨吉には既に親しみのある半分｜吃ったような声がポツリポツリと牧師の口から泄れて来た。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポツリポツリと雨はようやく濃かになる。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度｜吃った人の口から泄れる言葉のようにポツリポツリと物が言ってあったからで。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂の多い、白く光る地面には、粗毛のような薄茶色の草が一杯に生えて、晩秋の日を吸いながら輝く色々の樹木の間には、Sandstorm をふせぐための、腰の高い木造のバラックが、ポツリポツリ並んで居る。",
              "citation": {
                "source": "無題（二）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒匂河の蛇籠に入れる石をひろいに来て居る老人だの小供だのの影が、ポツリポツリと見える。",
              "citation": {
                "source": "冬の海",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、さも恥かしそうに耳を染めながら、うつむき勝ちにポツリポツリと話し出した。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポツリポツリと居るかも知れぬが。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに連れて半分｜粉炭に埋もれた福太郎の安全燈が、ポツリポツリと青い光りを放ちつつ、消えもやらずに揺らめいたのであった。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "in drops (e.g. of rain)",
        "register": "standard",
