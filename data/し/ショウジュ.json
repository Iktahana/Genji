  {
    "uuid": "f6c19be5-fa27-54ca-8e63-e40f9d1762d7",
    "entry": "松寿",
    "reading": {
      "primary": "しょうじゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
