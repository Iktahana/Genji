  {
    "uuid": "37ce65b4-e666-500c-8e81-ec00f7afd508",
    "entry": "聖衆",
    "reading": {
      "primary": "しょうじゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あゝ梵の聖衆を遠み、　　　　　たよりなく春は来らしを。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥様、お早くいらっしゃい」式部「どれ」（二人は縁先へ身体を乗出して聴く）聖「筏を漕ぐ、浪の音が聞える……あれは聖衆の乗らるる迎えの舟だ。",
              "citation": {
                "source": "或る秋の紫式部",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもう聖衆方、ひと漕ぎでござりまするぞ……こちらへ着きまするか、はいはい。",
              "citation": {
                "source": "或る秋の紫式部",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の信心深い仏徒や居士の終りには、聖衆来迎、紫雲音楽めでたく大往生というのが常である。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "（だんだん顔が輝いて来る）その日から私はあの尊い聖衆のなかの一人に加えられるのだ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは多くの聖衆の群れにかこまれた。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖衆の群れはそれに合わせて仏様を讃める歌をうたわれた。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は姉は今はもはや美しい仏となって聖衆たちと交わり、私たち生き残れる者をあわれみ守っていてくれることと信じます。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "轍の下に往生を遂げたら、聖衆の来迎を受けたにも増して、難有く心得たに相違ない。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ならば手柄にその白刃をふりかざして、法師の後に従うた聖衆の車馬剣戟と力を競うて見るがよいわ。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもない時は立ちどころに、護法百万の聖衆たちは、その方どもの臭骸を段々壊に致そうぞよ。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "表題は如何ともあれ、私は別に、山越しの彌陀の圖の成立史を考へようとするつもりでもなければ、また私の書き物に出て來る「死者」の俤が、藤原南家郎女の目に、阿彌陀佛とも言ふべき端嚴微妙な姿と現じたと言ふ空想の據り所を、聖衆來迎圖に出たものだと言はうとするのでもない。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、脇立ちその他の聖衆の配置や、恰好に、宗教畫につきものゝ俗めいた所がないではないのが寂しい。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖衆來迎圖以來背景の大和繪風な構想が、すべてさう言ふ意圖を持つてゐるのだから。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "金戒光明寺の來迎圖は、唯の山の端を描いたばかりだし、其から後のものは、峰の分れて見えるのは、凡そこから道が通じて、聖衆が降つて來るやうに描かれてゐる。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野家や川崎家のでは、今も言つた來迎の山を「二上」型に描く習慣が脱却出來ず、而も何の爲に、其ほどに約束を守らねばならぬか訣らずなつた爲に、聖衆降臨の途次といつた別の目的を、見つけることになつたと見る外はない。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野家藏のも相好の美しさ、中尊の姿態の寫實において優れてゐるのや、川崎家舊藏の山越圖の古朴な感じが充ち、中尊佛の殊に上體と山との關聯に、日想觀を思はせるものが、十分に出て居るが、二つ乍ら聖衆と中尊との關聯の上に、稍不自然な處がある。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "即、阿彌陀は山の端に留り、聖衆ばかり動いてゐると謂つた畫樣の川崎家の物や、何やら、中尊の背後にした聖衆の動靜に來迎圖離れの感じられる上野氏の物、特に後者は、阿彌陀の立像を膝元近くで書いたところに、山越し像の新樣式の派出を示してゐる。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "山越し像において、新しいほど、御迎講の姿が、畫因に認められるのに、古いほど却て來迎圖の要素たる聖衆が少くなつて、唯の三尊佛と言ふより、其すら脇士なるが故に伴うてゐるだけで、眼目は中尊にあると言ふ傾向がはつきり見えるのは、其が唯阿彌陀三尊に止るなら、問題はない。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "王舍城耆闍崛山に、佛大比丘衆一千二百五十人及び許多の聖衆と共に住んだ樣を圖したものである。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲湧き立つ山下に、佛を圍んで、聖衆・大比丘のある所である。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "表題は如何ともあれ、私は別に、山越しの弥陀の図の成立史を考へようとするつもりでもなければ、また私の書き物に出て来る「死者」の俤が、藤原南家郎女の目に、阿弥陀仏とも言ふべき端厳微妙な姿と現じたと言ふ空想の拠り所を、聖衆来迎図に出たものだ、と言はうとするのでもない。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、脇立ちその他の聖衆の配置や、恰好に、宗教画につきものゝ俗めいた所がないではないのが寂しい。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖衆来迎図以来背景の大和絵風な構想が、すべてさう言ふ意図を持つてゐるのだから。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "金戒光明寺の来迎図は、唯の山の端を描いたばかりだし、其から後のものは、峰の分れて見えるのは、凡そこから道が通じて、聖衆が降つて来るやうに描かれてゐる。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野家や川崎家のでは、今も言つた来迎の山を「二上」型に描く習慣が脱却出来ず、而も何の為に、其ほどに約束を守らねばならぬか訣らずなつた為に、聖衆降臨の途次といつた別の目的を、見つけることになつたと見る外はない。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野家蔵のも相好の美しさ、中尊の姿態の写実において優れてゐるのや、川崎家旧蔵の山越図の古朴な感じが充ち、中尊仏の殊に上体と山との関聯に、日想観を思はせるものが、十分に出て居るが、二つ乍ら聖衆と中尊との関聯の上に、稍不自然な処がある。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "即、阿弥陀は山の端に留り、聖衆ばかり動いてゐると謂つた画様の川崎家の物や、何やら、中尊の背後にした聖衆の動静に来迎図離れの感じられる上野氏の物、特に後者は、阿弥陀の立像を膝元近くで画いたところに、山越し像の新様式の派出を示してゐる。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
