[
  {
    "uuid": "79e4981d-c821-54a8-8a1b-b4187bf07dc5",
    "entry": "新羅",
    "reading": {
      "primary": "しらぎ",
      "alternatives": [
        "しんら"
      ],
      "is_heteronym": false
    },
    "grammar": {
