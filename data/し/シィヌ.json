        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかも、前に老婆のひざまずいていた場所にモデル女シィヌが裸体で低い台に腰かけているし、ヴィンセントが腰かけていた場所には、同じヴィンセントがイーゼルに立てかけた全紙の木炭紙に向ってシィヌを写生しているので、瞬間、前場の光景とダブる。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌは、前の所だけをチョット着物で蔽うて、ダラリとして掛けている。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　……（低く口の中でフンフンと鼻歌。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（シィヌは耳に入れないで歌いつづける）クリスチイネ！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　だってえ、――退屈だもん。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　歌ぐらい歌ったって、いいじゃないか。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　あたしもこれまで、絵かきさんのモデルもずいぶんやって来たけど、あんたのように気むずかしいことを言う人は、まあなかったわね。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィン　それはまた別の――いや、だのに、お前はヂンを飲むから――シィヌ　ピーテルセンの先生がビタースがない時にはヂンだって良いって言ったんだもの、少しなら。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたいは胃腸が弱いから――ヴィン　だから、ビタースなら良いけど――シィヌ　じゃ、お金ちょうだいよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと二、三日すればテオが送ってくれるから、そしたら――シィヌ　一にもテオ、二にもテオだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　へん、そいで、じゃ、私たちの暮しはどうなるの？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "良い絵さえ描けるようになりゃ、金はいつでも手に入るんだから――シィヌ　だのにあんたは、スケッチや水彩画なんぞサッパリ描こうともしないで、そんな汚ならしい真っ黒な絵ばかり描いているんだもの。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　いいわよ、じゃ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（再び画面に向い、喰いつくような眼でシィヌと絵とを見くらべる）シィヌ　そのパンを少しおくれよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　そのさ、木炭を消すのさ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィン　あ、これか……そう、じゃ……（と手元のパンのへりの所を割って、シィヌに投げてやる）ほら。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　なあんだ、へりの所ばかりじゃないのよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　しょうがないわねえ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　なに、いいのよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　フフ、あんたはまた、自分とは何の縁もない私の連れ子を、どうしてそう可愛がれるの？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くで汽船のボウが鳴る）シィヌ　ああ、船が入ったな。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（うわのそらで描いている）シィヌ　ハトバじゃ、いっぱい人が出てるよ、きっと。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　あたしの黒のブラウズねえ、今のはもう痛んじゃってるから、入院するまでに新しいのを一枚こさえてくれない？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（夢中で描き進む）シィヌ　（そういうことには馴れているので、勝手にしゃべる）だって、あたし、今度のお産では、もしかすると死ぬような気がするの。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シィヌ　ですからさ、ブラウズだけでも新しくなにしたいのよ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィン　いや、そんな君、そんな、シィヌ――どうしてそんなこと考えるんだ？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえ、どんなことがあっても――シィヌ　だってさ、あたしなんぞ、いっそ、その方が良いかも知れないんだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心配しないでいい、大丈夫だ、ね、シィヌ！",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
