          "literary": [
            {
              "text": "其晩取つて返して、図書館で浪漫的アイロニーと云ふ句を調べて見たら、独乙のシユレーゲルが唱へ出した言葉で、何でも天才と云ふものは、目的も努力もなく、終日ぶら／＼ぶら付いて居なくつては駄目だと云ふ説だと書いてあつた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "シユレーゲルも悲曲の要素は熱意なりと論じられぬ。",
              "citation": {
                "source": "情熱",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            }
          ]
        }
