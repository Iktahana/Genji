          "literary": [
            {
              "text": "猩々やシンパンジイの猟をしたドユ・シヤイユウは人を避けて穴居してゐるこの猿共の性質の面白いことを報告してゐる。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドユ・シヤイユウは寝た猿に狙ひ寄つたのだ。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドユ・シヤイユウは雄猿を獲たのに満足しないで、雌猿をも殺した。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
