[
  {
    "uuid": "ce0ba16f-1b49-5168-9b15-748fb93989ad",
    "entry": "辛酸",
    "reading": {
      "primary": "しんさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
