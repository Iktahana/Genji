        "examples": {
          "standard": [
            {
              "text": "作業現場では、動きやすい職服が一番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "汚れてもいいように、職服に着替えてから作業に取り掛かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "週末は職服を脱ぎ捨てて、カジュアルな服装でリラックスしたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
