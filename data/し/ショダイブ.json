        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その時孔子は斉の無礼を咎めて、景公始め群卿諸大夫を頭ごなしに叱咤した。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前はまだこの国の諸大夫と近附になっていないから、この鐘が出来上ったら、その祝を兼ねて諸大夫を饗応するが宜かろうと。",
              "citation": {
                "source": "牛人",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾ては自分の目をかけてやった諸大夫連が、誰一人機嫌伺いにさえ来ようとしない。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾ては自分の目をかけてやつた諸大夫連が、誰一人機嫌伺ひにさへ來ようとしない。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "本文に四郎左衛門を回護したと云ふ女子薫子は伏見宮諸大夫若江｜修理大夫の女ださうである。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕へられた人々の中には、公卿の諸大夫、宮方の青侍、処士、町人、画家、近衛家の老女村岡もゐた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ず「上達部、殿上人」であったものが、「諸大夫、殿上人、上達部」になっている。",
              "citation": {
                "source": "『新新訳源氏物語』あとがき",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かような彼が、春秋末期の諸侯・諸卿・諸大夫の下剋上や、僣上沙汰や、権力争いや、利害本位の取引きや、武力抗争等について、深い憂いと怒りとを感じたであろうことはいうまでもない。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三（四九四）　叔孫武叔が朝廷で諸大夫に向っていった。",
              "citation": {
                "source": "現代訳論語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "河内介その人も本来｜但馬の医師の次男坊で、中川家諸大夫田中氏の養子となったものである。",
              "citation": {
                "source": "新撰組",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞観の時は東西三宇ずつで、それが楽人・勅使・諸大夫等の席になっている。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石田、大谷、古田、生駒、稲葉など十二人も諸大夫に任ぜられ、特に、内政の一刷新として、人材五人が選抜され、新たに、五奉行の文官制ができた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "内蔵助の遠縁にあたる者が、近衛家の諸大夫を勤めている。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "景公、諸大夫と郊に迎へ、師を勞ひ禮を成し、然る後反つて（三二）寢に歸る。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "司馬穰苴列傳第四",
                "note": "青空文庫"
              }
            },
            {
              "text": "景公與諸大夫郊迎勞師成禮。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "司馬穰苴列傳第四",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
