[
  {
    "uuid": "37e5e41d-1dac-5e0d-a97a-b5e6d9e6d0ba",
    "entry": "主事",
    "reading": {
      "primary": "しゅじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
