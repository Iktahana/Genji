    "definitions": [
      {
        "index": 1,
        "gloss": "subject",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この文の主辞は「私」だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "文法では、主辞と述語の対応が重要視される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、議論の主辞から逸れないように注意を払った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "＊＊　「韻律なき韻律」という類の言語は、賓辞が主辞を否定することに於て、別の新しき定義を暗示しようとするのである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "論理学命題の規則中に、主辞、賓辞を転倒するの過失を証明せり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ごほうじが　すむと、だんかの　ごしゅじんは　すました　かおで、「はい、ごくろうさま。",
              "citation": {
                "source": "こぞうさんの　おきょう",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアでは、医者が病人のしゅじゅつをするところをみせてくれました。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            },
            {
              "text": "元日の　ことですから、しゅじんの　きゅうべえは　いえの　ものを　みんな　あつめて、とそを　いわい、おぞうにを　たべていました。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしは、このいえのしゅじんだが、うちには、そんな女の子はいない。",
              "citation": {
                "source": "かいじん二十めんそう",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
