          "standard": [
            {
              "text": "テレビ番組で、曰く付きの場所で撮られた心霊写真が紹介された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行中に友人が撮った心霊写真には、誰もいないはずの場所に人影が映っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "インターネット上に投稿された心霊写真の大半は合成や光の反射と判明している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その時ドイルの心霊写真に関する著書などを見たのだが、死後の生存とか、他界との通信などは非常に心ひかれることではあるけれど、その実験方法、暗中に死者の声が聞えたり、姿が現われたり、机が宙に浮いたり、写真の乾板に亡霊が現われたりするいわゆる心霊現象は、どうも信ずる気になれなかった。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
