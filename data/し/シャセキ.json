        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『大和本草』に四国に狐なしというが『続沙石集』に四国で狐に取り付かれた話を載す。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『沙石集』に叡山の二僧相約して、先立ちて死んだ方が後れた者にきっと転生り、所を告ぐべしといった後、まず死んだ僧が残った僧の夢に見えて、我は野槌に生まれたといった。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "予が聞き及ぶところ、野槌の大きさ形状等確説なく、あるいは※鼠様の小獣で悪臭ありというが、『沙石集』の説に近い。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛執に依って蛇となったは、『沙石集』七に、ある人の娘鎌倉若宮僧坊の児を恋い、死んで児を悩死せしめ、蛇となって児の尸を纏うた譚あり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにそれより三世紀早く既に東洋にあったは、『沙石集』を読んで知れる。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『沙石集』『因果物語』等に馬を虐待してその霊に苦しめられた譚多い。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "畢竟、後白河上皇が仰せられた通り、隠すは上人、せぬは仏で（『沙石集』四の二）、日本に清僧は一疋もなく従って鑑識もその用を要せぬからだ。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くは霊異記、新しくは宝物集・撰集抄・沙石集などの逸話集は、やはり、かうした方面からも見ねばならぬ。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙石集に入水往生した僧のことを載せている。",
              "citation": {
                "source": "本朝変態葬礼史",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "話を集めた古事談とか著聞集とか沙石集とかいう類ですら、片端から誰にでも読ませてよいというものばかりでない。",
              "citation": {
                "source": "書物を愛する道",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "つくりをはれば女魚そのなかへを弾着、直に女魚男魚掘のけたる沙石を左右より尾鰭にてすくひかけての河に泝るは子を産んとて也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧之常におもへらく、寒気の頃｜捕たるとをまじへ、なき国の海に通ずる山川の清流に、かの瓶にうつしたるはらゝごを沙石のまゝさけのうみつけたる如くになしおき、此川にてを生ぜんもしるべからず。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
