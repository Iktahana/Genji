        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シヤアボン、シヤアボンといふ簡單な言葉である。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は江戸時代に於ける隱れたシヤアロツク・ホームズであつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学生の頃は、ドイツのエス・フイツシヤアが其発行する文学書に美しい更紗模様の図案を施した。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは江戸趣味に直したエス・フイツシヤア本であつた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、間が悪い時には悪いもので、邸がまだ半分も出来上らない昨今、身代はまたバアクシヤア種の豚のやうに留め度もなく肥り出して来た。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを受けたのは、美人で評判のデヴオンシヤア公爵夫人で、夫人がある時さびしい町角で馬車からおりようとすると、石炭担ぎの労働者が一人｜路の片側にしやがんで、口にくはへたパイプをつけようとしてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕には昔から一度もつかまへることが出来なかつた「シヤアシヤア蝉」とヒグラシが正ちやんのお蔭で標本箱に収まり、もう二学期の学校が始まるねと云ふと、彼はこの夏で学校は止めて神田の或る蓄音機の箱をつくる工場に奉公へ行くことになつてゐるのだと云つた。",
              "citation": {
                "source": "魚籃坂にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の小説に「ジヨン・サイレンス」と云ふのがあるが、そのサイレンス先生なるものは、云はば心霊学のシヤアロツク・ホオムス氏で、化物屋敷へ探険に行つたり悪霊に憑かれたのを癒してやつたりする、それを一々書き並べたのが一篇の結構になつてゐる訣です。",
              "citation": {
                "source": "近頃の幽霊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思ふとこちらの艫にも、シヤアロンの櫂に払はれたのか、真逆様に沈みかかつた、或霊の二つの足のうら！",
              "citation": {
                "source": "LOS CAPRICHOS",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "水車場にはペトルツシヤアがゐる。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰まり新しいシヤアル・フウリエエが世に出ると云ふものだ。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「好いよ／＼、グラツシヤア。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラトンはびつくりして、「グラツシヤア」と一声呼んだ。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "舷へ波がうちつけるのであらう、シヤア、シヤアと、絶え間なく水のはねる音がして、閉ぢた窓が闇の色をぎらぎらと映してゐる。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏国ニヴェエル県シヤアロンに生る。",
              "citation": {
                "source": "「葡萄畑の葡萄作り」後記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、栗はシヤアテエニユといふのだが、料理や菓子に使はれる時に限つてマロン即ち「マロニエの実」を云ふらしい。",
              "citation": {
                "source": "甘い話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "憂悶　　シヤアル・ボオドレヱル大空重く垂下りて物蔽ふ蓋の如く、久しくもいはれなき憂悶に歎くわが胸を押へ、夜より悲しく暗き日の光、四方閉す空より落つれば、この世はさながらに土の牢屋か。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗黒　　シヤアル・ボオドレヱル森よ、汝、古寺の如くに吾を恐れしむ。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "仇敵　　シヤアル・ボオドレヱル若きわが世は日の光ところまばらに漏れ落ちし暴風雨の闇に過ぎざりき。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の歌　　シヤアル・ボオドレヱル一吾等忽ちに寒さの闇に陥らん。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "腐肉　　シヤアル・ボオドレヱルわが魂などか忘れん、凉しき夏の晴れし朝に見たりしものを。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の悲しみ　　シヤアル・ボオドレヱル月｜今宵いよゝ懶く夢みたり。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮方の食事　　シヤアル・ゲラン　歌ひながらに恋人は、飛ぶ蜂の翅きらめく光のかげ、暮方の食事にと、庭の垣根の果実と、白きパン、牛の乳とを準へ置きて、いざや、寄添ひて坐らんと、わが身のほとりに進み来ぬ。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "道のはづれに　　シヤアル・ゲラン道のはづれに日はしづむ。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありやなしや　　シヤアル・ゲランよしや反響のきかれずとも、物には凡て随ふ影あり。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊花の歌　　シヤアル・グランムウランだりやの花｜萎れ葡萄畠の取入れ終りて、餌にあかぬ鴫の鳴く音も絶えにけり。",
              "citation": {
                "source": "珊瑚集",
                "author": "仏蘭西近代抒情詩選",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
