    "definitions": [
      {
        "index": 1,
        "gloss": "commercial paper",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "企業はＣＰを発行することで短期の資金調達を実現している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ＣＰの満期は通常1日から270日の範囲で設定される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "金融危機の時期はＣＰの発行が困難になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "アラン・ケイの種子を蒔く畑を耕したのは、貧相なベーシック・マシンやＣＰ／Ｍマシン、ＤＯＳマシンだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイクロコンピューターが８ビットの時代、ＯＳの標準の座を握ったのはデジタルリサーチのＣＰ／Ｍだった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスキーは16ビットへの移行期、ＣＰ／Ｍの16ビット版とマイクロソフトのＭＳ―ＤＯＳの双方を競わせながらプロモーションを並行して進めたが、古川はここでＭＳ―ＤＯＳの立ち上げに努めた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "てなうちにフロッピーディスクとＣＰ／Ｍが現われて、アプリケーションが商品になった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "８ビット時代の標準ＯＳとなったＣＰ／Ｍの会社だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時はＤＲＩの天下で、ＩＢＭもＰＣを始めるときはＣＰ／Ｍの16ビット版で行こうと当然考えた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "連中は仕方なくマイクロソフトに頼み込んで、ビル・ゲイツはよそから買ってきたＣＰ／Ｍ紛いのＯＳを手直しして売り付け、ＭＳ―ＤＯＳの天下が何が何だかわからないうちにやってきた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただこの世界でもＯＳ屋とＣＰＵ屋だけは独占を享受していて、ここには物事を徹底して素早く推し進める圧力は強くかからないできた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ＶＰｉ３８６は、ＣＰＵとしてインテル製３８６ＳＸあるいはＡＭＤの３８６ＳＸＬ―25のどちらでも採用可能だが、製品性能と電池寿命を特徴とするためには、ＡＭＤの製品が最適である」リリースはエデン・グループの技術部長ニール・フリントの発言をこう引いている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＣＰＵのクロック・スピードが支配する音の重ね合わせには、乗る気もないし聴かされるのもまっぴらだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジム・ホーテンスって、アメリカのＣＰの記者のことか。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがコンピューターの中央処理装置（ＣＰＵ）は、すでにでき上がった形で、マイクロコンピューターという電子部品として提供されていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "試作機の電源を入れなおしたとき、ラジオに雑音が入るのに気付いた後藤氏は、モニタープログラムが起動されてＣＰＵが動くことで雑音が生じていることを直感した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときの発見以来、後藤氏はトランジスターからの雑音をＣＰＵの動作を確認するための指標として使いはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マシンのＣＰＵがそのまま解釈しうる機械語の字句を、人間に理解しやすいように記号に置き換えてある。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで浜田は、発想をまったく切り替えてごく小規模なコンピューターの中央処理装置（ＣＰＵ）を中心にシステムを構成しようと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "このＣＰＵにＲＯＭに収めたプログラムを実行させて求められる機能を実現する。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくまで通信制御装置の開発を目的としている以上、このプロジェクトで浜田たちは、一個の集積回路にＣＰＵを作り付けるところまで踏み込まなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての機能を回路に作り付けてしまうワイヤードロジックに代え、シンプルなＣＰＵとプログラムの組み合わせで機能を組み立てるという発想をより徹底させれば、はじめから一つにまとまったマイクロコンピューターを使うというアイディアが当然浮上してきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした二つの流れからの圧力を受けて、さまざまな機器のエンジニアたちが、複雑な専用回路を作る代わりに簡単なＣＰＵを集積回路化し、ＲＯＭに収めたプログラムによって機能を実現する方が賢明であると判断しはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つのチップにまとめられてはいなかったが、ＤＴ―１は三個のＬＳＩのセットでＣＰＵを構成していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しいシステム１００のＣＰＵには、μＣＯＭ―16と名付けられたこのマイクロコンピューターを使おうと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンピューターにはＣＰＵに加えて、周辺装置を制御するためのさまざまな回路が組み込まれている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＣＰＵだけをＬＳＩ化しても、ほかが従来どおりではメリットも中途半端なものにとどまってしまう。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＤＥＣのタイム・シェアリング・システム用のＴＯＰＳ―10というＯＳを参考にして書いたこのソフトウエアを、彼はＣＰ／Ｍ（Control Program for Microcomputer）と名付けた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミニコンピューター上のインタープを使ってＣＰ／Ｍを書き上げて間もない一九七四年の秋、知り合いのジョン・トロードがこの話に興味を持って、ハードウエアを仕上げる作業を手伝ってくれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "配線むき出しの接続回路でドライブをインテレクト―８につなぎ、まずテレタイプからＣＰ／Ｍを読み込ませると、フロッピーディスクの初期化をすませたＣＰ／Ｍは、準備完了の指示待ちサインをテレタイプに送り返してきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな中でキルドールが新しく提案してきたＣＰ／Ｍに、インテルは興味を示さなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シー・ピー・スクラインがパミールの岩山の奥に「幸福の谷」を発見した記事を読んだときにいわゆる武陵桃源の昔話も全くの空想ではないと思ったことであったが、その武陵桃源の手近な一つの標本を自分は今度雨の上高地に見出したようである。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
