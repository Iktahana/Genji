        "examples": {
          "standard": [
            {
              "text": "潮干狩りで潮吹き貝を見つけ、味噌汁の具にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この磯には、たくさんの潮吹き貝が生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "潮吹き貝は、砂の中に隠れていて、水管を伸ばして潮を吹く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
