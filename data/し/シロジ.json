        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験用紙の裏面の白地の部分に、解答のヒントをメモした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この契約書はまだ白地のままだが、近日中に内容が書き込まれる予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新しいアイデアを思いついたので、急いで白地のノートに書き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
