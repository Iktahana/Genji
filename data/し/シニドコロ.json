    "definitions": [
      {
        "index": 1,
        "gloss": "(fitting) place to die",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「武士たるもの、戦場こそが死にどころである」と彼は覚悟を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "故郷の山で、愛する家族に見守られながら死にどころを迎えたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、自分が長年尽くしてきた場所で死にどころを見つけたかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ただ水に入りさえすれば死ねるものと心得て入ってみたが、さてここが死にどころというのが見当らなかった。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "報国の赤心をつらぬく時機に、その効果をあらわす大切な道具になると存じますので、心中ひそかに、死にどころをえた心地がいたします。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "好漢まだ三十三歳、早くもここを死にどころと見極めて、軍人訓のうちにも見えるいはゆる「生死觀」の眞諦に徹して、血と粉雪にまみれ入つた彼のすがたが眼に見えるやうである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この度の大任こそ、男の死にどころ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
