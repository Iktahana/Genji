          "literary": [
            {
              "text": "オルゴールの曲は『愛馬進軍歌』をやってくれってさ」　木曾のクマちゃん、地金を丸だしにして、あわてて、後につけた。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから三つ、オルゴールは『愛馬進軍歌』なり。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "町へ入ると、ラジオの愛馬進軍歌がきこえてきました。",
              "citation": {
                "source": "夕焼けがうすれて",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鶴八」の漫才、今日も「忘れちゃ」をやり、明日より「愛馬進軍歌」にする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
