[
  {
    "uuid": "98efe41e-fd18-5111-a6c7-d861a67f6074",
    "entry": "酒保",
    "reading": {
      "primary": "しゅほ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
