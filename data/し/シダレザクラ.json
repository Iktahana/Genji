[
  {
    "uuid": "50604090-5994-534d-bc03-5b8653b4f254",
    "entry": "しだれ桜",
    "reading": {
      "primary": "しだれざくら",
      "alternatives": [
        "シダレザクラ"
      ],
      "is_heteronym": false
