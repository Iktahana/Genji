        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はシャキッと返事をしてから教室を出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "冷たい水を浴びるとシャキッと目覚めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しい靴を履くとシャキッと歩けるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "もう悉皆耄碌して、縁側に坐って居睡りをするのが商売だったけれど、百二つで死ぬ時、シャキッとなって遺言した。",
              "citation": {
                "source": "ある温泉の由来",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒を飲んでダラシのない人だけれど、奇妙なことに商売用と聞くとシャキッとなるとか、些っとも俸給の昇らない人だけれど、何ういうものか、友達に畏敬されているとかと思い込ませて置く必要がある。",
              "citation": {
                "source": "秀才養子鑑",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると照正様｜照常様までシャキッとする。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この注意が響きわたると、若様がたばかりか、家庭教師の先生がたまでシャキッとなる。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
