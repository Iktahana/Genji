    "definitions": [
      {
        "index": 1,
        "gloss": "genuine article",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鑑定の結果、その掛け軸は有名な画家の真物であることが確認された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "市場に出回る偽物が多い中、彼の作品は常に真物として評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "本物の感動は、真物に触れた時にしか得られないものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ルレーヌの有名な詩人論“〔Poe`tes Maudits.〕”の中に、※ルレーヌの認めて最も真物の詩人となした五人の詩人中に加へられてゐるのである。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一枚の板で真物同様の色彩が写されるというのがこの種板の優れた特色である。",
              "citation": {
                "source": "天然色写真新法",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて月謝を沢山出した挙句に、いよいよ真物真筆を大金で買う。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故といえば持って行かれたのが真物ではないからである。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "双方とも立派なものではあるが、比べて視ると、神彩霊威、もとより真物は世間に二ツとあるべきでないところを見わした。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ至極面白いんだ、何かの話の具合で我々の人生観を話すことになってね、まア聴いて居給え名論卓説、滾々として尽きずだから」「ナニ最早大概吐き尽したんですよ、貴様は我々俗物党と違がって真物なんだから、幸貴様のを聞きましょう、ね諸君！",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨月謝を沢山出した挙句に、いよ／＼真物真筆を大金で買ふ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故と云へば持つて行かれたのが真物では無いからである。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に何んにもありませんので、親仁殿は惜気もなく打覆して、もう一箇あった、それも甕で、奥の方へ縦に二ツ並んでいたと申します――さあ、この方が真物でござった。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女用文章の中の挿画が真物だか、真物が絵なんだか分らないくらいだった。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすが大阪の牛丼は真物の牛肉を使っていると思った。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯨はとどこおりなく由兵衛の手に渡って、十三日からいよいよ奥山の観世物小屋に晒されることになったが、これはインチキでなく、確かに真物だ。",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は真物かと思った」「須婆田さんはホントの印度人です」「成る程成る程。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが真物でないことは其月にもひと目で判った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "冬の金魚",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつが、その大風呂敷が、真物の大風呂敷なら、追っかけられた泥棒みたいに、どこの軒先きにだって、投げ出して、身軽に逃げ出すことができる。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "扱いだけじゃないんだ、僕らを真物の泥棒猫か、もっと適切にいえば、去勢した馬車馬と考えてるんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそうしている神仏でもあるならば、それは岩見重太郎によって退治されねばならない神仏であって、決して真物ではないのだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "気取り屋よ、君のツラへ私は率直な鉄丸をぶつつけてやらう君の仮面が砕けて下から真物のツラが現れるやうに、我々はもつと憎まれる必要があるのだ――、十万の味方をつくるためにどうして我々は千の敵をつくることを怖れてゐられるだらう。",
              "citation": {
                "source": "小熊秀雄全集-4",
                "author": "詩集（３）小熊秀雄詩集１",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういたしますると、すり替えられた真物というは、よほどのご名品でござりましたろうな」「ええ、もう名品も名品も、内藤家の古島雛と評判されている逸品じゃそうにおじゃります」「なるほど、さようでござりましたか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "因縁の雛、恋の思い雛、行く末かけてと七つの年から誓い祭り飾りつづけた契りのしるしの片雛であるうえに、あまつさえすり替えられた真物は、天下三宝の一つと名を取ったゆゆしき名品なのです――。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "まがい雛をこしれえて売り出すために、どやつか了見のよくねえ人形師が、古島雛の真物を盗み出したというんですかい」「まず十中八、九、そこいらが落ちだよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "真物が姿を見せたら、うわさを聞いて女どももひとりでににょきにょきと姿を見せるにちげえねえから、ひとっ走りいって洗ってきな」「え……？",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "その野郎をかぎ出しゃ、自然といかもの作りの人形師もわかるだろうし、わかれば盗まれた真物の行くえにも眼がつく道理じゃねえかよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねこばばきめた真物も、ついでにこれへ出しな」「なんでござります？",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからけふまでもう二十｜余年、私の長い寫眞物語りのペエジにも悲喜こも／″＼の出來事が繰返されたが、あの刹那にまさる嬉しさがもう再びあらうとは思へない。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞物ぞと呼びつゝ、人々拾ひ取りて勿體なき事かな、盜人などに取られ給はゞいかにし給ふといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "和漢三才圖會二七に、按ずるに三止女は南天竺の國名、此より出でオクシマと稱す、云々、倭より出る者を京奧じまと名け、眞物に似ずとあり。",
              "citation": {
                "source": "女順禮",
                "author": "並にサンヤレの事",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しＳ君、――君がもう少し附け加へることを許すであらうならばだ――（どうしてまた君が遙々と奧州｜下んだりから擔ぎ出して來たあれだけの懸物の中に、一本も眞物と云ふものが含まれてなかつたのでせう？",
              "citation": {
                "source": "奇病患者",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワイリは支那の有名な金石學者、例へば顧炎武とか、錢大※とか、王昶とかいふ人達の、この碑に關する考證を紹介し、支那の學者は一人も、この碑の眞物たることを疑ふ者がないといふ事實を指摘して居る。",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論此の如きは稀有の例外で、支那學者の多數は、この碑の當時の眞物たることを疑はぬ。",
              "citation": {
                "source": "大秦景教流行中國碑に就いて",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
