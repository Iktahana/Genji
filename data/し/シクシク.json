[
  {
    "uuid": "6f38caca-078d-51d4-9914-69204c745db6",
    "entry": "しくしく",
    "reading": {
      "primary": "しくしく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と"
      ],
