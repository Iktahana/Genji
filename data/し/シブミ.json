[
  {
    "uuid": "cad24269-ec36-5026-a9f7-d4c43b9273f7",
    "entry": "渋み",
    "reading": {
      "primary": "しぶみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
