        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の作品には、派手さはないが奥深い渋みがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古民家には、現代の建築にはない独特の渋みが感じられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その着物のデザインは、渋みの中に繊細な美しさを秘めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
