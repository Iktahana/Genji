          "literary": [
            {
              "text": "呪詛諸毒薬、還着於本人と、み仏も説かれてある。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この玉を食中に置かば諸毒を避く。",
              "citation": {
