[
  {
    "uuid": "12f6f77c-18b0-5010-a44b-09658f650981",
    "entry": "しとしと",
    "reading": {
      "primary": "しとしと",
      "alternatives": [
        "シトシト"
      ],
      "is_heteronym": false
    },
    "grammar": {
