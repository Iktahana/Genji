          "literary": [
            {
              "text": "さて、そこに書き綴られた文章は――「レイノジケンニツキ、シキユウ、セキガイセンシヤシンサツエイタノム。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノ写真　ケンシヤウモンコチヤンハ　ダレニ　シヤシンヲ　トツテ　モラヒマシタカ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "広吉茂吉は半郷学校え天子様のシヤシン下るに付而行。",
              "citation": {
                "source": "念珠集",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
