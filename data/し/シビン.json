        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "入院中、夜間にトイレに行くのが困難だったので、看護師さんが尿瓶を用意してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "介護用品店で、使いやすいデザインの尿瓶を探して購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長距離ドライブ中に渋滞に巻き込まれた時、非常用に尿瓶を持っていて助かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "爺さんは階下にわざわざ下りて行くのが大変なので、蒲団の裾の方に尿瓶が置いてあるが、そこで小便をした。",
              "citation": {
                "source": "日本三文オペラ",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿瓶ぐらいの事なら、自分で都合が出来るんですが……エエ。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そろそろ空腹であるが、女中二人と、娘一人っきり（読売新聞の結婚談は大※である）、神経痛で、腰が痛むから、尿瓶を置いて、用を足す位で、勝手へ行って、パンを焼く気にもなれない。",
              "citation": {
                "source": "死までを語る",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓のそばに桃花心木の書机がひとつ、椅子がひとつ、床の上には古新聞や尿瓶や缶詰の空缶や金盥……その他、雑多なものが、足の踏みばもないほど、でまかせに投げちらされている。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八個ならんでいるこれら蓄尿瓶に一々その患者の名札が提げられ、どれも尿の色が死色になっても変っていない、或る尿は殆ど青い木の葉の色をしていて、それが服薬のせいだと判っていても、私にはこのみどりの尿がどれよりも悲しく眼にはいった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてどの人も尿の瓶を提げなければならないし、この大瓶にためて置くことを命じられていて、お互に尿瓶をさげていても恥かしい思いはしなかった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "カテーテルは昼夜の区別なくこれを行い、尿は一さいゴム管によって別の尿瓶にとるという方針であったが、私は身震いしてこれを極度に拒否し続けた。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある者は尿瓶を手にしある者は聴診器を持っている。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だと思うと中風病の老爺が、しびんに遣てる。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "また酒や水が五六升もはひるような大瓶があり、珍しい恰好のものには、丈の高い透し入りの壺をのせる臺だとか、壺と臺とくっついてゐるものだとか、口の周りに人間や馬の小さい形をつけた、飾りつきの壺だとか、また口のついたしびんのような形をしたものもありますが、なかにも不思議なのははさふといふ器物です。",
              "citation": {
                "source": "博物館",
                "author": "濱田青陵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二個のしびんに代るがわる立ち対い、跼んだり立ったりしてみたが、がんとして尿の通りがなかった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥テル子は用意してきた小型のしびんの包みを下ろして、かまわないからわたくしが屏風になりますからなさいましといった。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し事態がもっと穏やかな状態にあれば使えるしびんであるが、こんなに心が混乱していてはこれも使えない、汽車は三メートルくらい高い所を走ってレールについていないようだ。",
              "citation": {
                "source": "われはうたえども　やぶれかぶれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "尿はしびん、大便も上向いたまゝ便器にとる、空中へウンコする気持、西洋便所より上のものがあった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "12040奇しき香をいと多く滴らせし瓶に頼りて願ひまつる。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋へ水を入れたのも、鰹節をかいたのも、汁の実を入れたのも、そして戸棚の味噌の小出し瓶から、杓子で味噌を出して、鍋の中に入れたのも、ことごとくお夏のやったことに間違いもなく、毒が本当に味噌汁の中にあったとすればお夏の手を一度経たことは疑いもありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鬼の面",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋へ水を入れたのも、鰹節をかいたのも、汁の實を入れたのも、そして戸棚の味噌の小出し瓶から、杓子で味噌出して、鍋の中に入れたのも、悉くお夏のやつたことに間違ひもなく、毒が本當に味噌汁の中にあつたとすればお夏の手を一度經たことは疑ひもありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼の面",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
