  {
    "uuid": "965bcde8-2de7-5d2b-8a2b-d5bff141ef0e",
    "entry": "シニ",
    "reading": {
      "primary": "しに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "黒く澄んだ、黄楊の葉の目が、やさしく、ただしシニカルでありたさうに折々見上げる。",
              "citation": {
                "source": "夭折した富永",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど弓削道鏡が自分の同郷出身だといって自慢する人はあまりないかもしれないが、しかし石川五右衛門の同郷者だといってシニカルな自慢を振り廻す人はあるかもしれない。",
              "citation": {
                "source": "夕凪と夕風",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も日が經つて行く内に、「猫又」の一語が表象するシニックな感じが、先生の人柄にぴつたり當て填まるばかりでなく、それが巧に先生を諷し得てゐるやうな氣持がして來た。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろは、独逸、仏蘭西はつい隣りで、マルセイユ、ハンブルク、アビシニヤごときは津々浦々の中に数えられそうな勢。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「メクラソウシニテヲアワセル。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "快活らしい元気な表情の中には、ただ、ゼーヤから拾ってきた砂金を掴み取り、肌の白い豊満な肉体を持っているバルシニヤを快楽する、そのことばかりでいっぱいだった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「停車場で君がバルシニャ（娘）と話しているのをきいたことがあるよ――美人だったじゃないか。",
              "citation": {
                "source": "穴",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二タス二ガ四ニ相等シイのと同じように「隊長ハ鶏ノスキ焼キガ食ベタイ」「二人ハ鶏ノ徴発ニ赴カネバナラヌ」「徴発出来ナケレバ半殺シニナル」という三つの意味は相等しいのである。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "背の低い肥ったバリトン歌手のシニョル・サルヴィは大きな腹を突き出して、「ストロンボーリ、ストロンボーリ」とどなりながら甲板を忙しげに行ったり来たりしていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシニのスタバト・マーテルを聞きながら、こんなことも考えた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "発作の後の悲しみが又犇々と迫る、深い恐怖に顫へ乍らグロキシニアと冷たい鏡を片よせて、私はまた新らしく顫へ初めた素つ裸の感覚から眼を凝らし、耳を聳て、まるで匍ひつくばつた生蕃の児のやうに生々と暗い闇の核心を凝視めた。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "口を噤んだまま正面から私を見返した彼の顔付は――その面皰のあとだらけな、例によって眼のほそい、鼻翼の張った、脣の厚い彼の顔は、私の、繊細な美を解しないことに対する憫笑や、又、それよりも、今の私の意地の悪いシニカルな態度に対する抗議や、そんなものの交りあった複雑な表情で忽ち充たされて了ったのである。",
              "citation": {
                "source": "虎狩",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）正直正太夫と名宣つてからは、其筆と共に態度も様子も変り、新進の作者らには怖れられ、古参連には憎がられもしたが、そのシニシズムは、どちらかといふと、文学界だけの事で、本来の理想は江戸式通人のそれに似たものであつたらしく、常識の豊かな、唯物主義の、楽観家であつた。",
              "citation": {
                "source": "斎藤緑雨と内田不知菴",
                "author": "坪内逍遙",
                "note": "青空文庫"
              }
            },
            {
              "text": "シニカルな気分である。",
              "citation": {
                "source": "鎖ペンを握って",
                "author": "――三月十九日夜――　　山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　トキ　ムカウノ　ムギバタケカラ　コトシニ　ナツテカラ　ハジメテノ　ヒバリガ　ソラニ　マヒアガリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　ステナイデ、コシニ　サシ、ツギノ　ムラニ　ハイリマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オネガヒダ、ワタシニ　キラセテ　クレ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケレド、ワタシニハ　キコエマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモハ　ナカヨシダツタノデスケレド、アンマリ　マンナカノ　ホシガ　サムイ　サムイト　イフノデ　ホカノ　二ツノ　ホシニ　イジメラレタノデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウサギハ、ソンナ　コトニハ　オカマヒ　ナシニ、ミチバタノ　クサヲ　タベテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダイジナ　モノデスカ」「エエ、ワタシニハ　ダイジナ　モノデス」　ソコデ、サカナハ　ヨクガ　デマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カハノ　キシニハ　ハンノキガ　シゲツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサムラヒニ　バケル　トキハ　マゲヲ　ツケテ、ヒゲヲ　ハヤシテ、カタナヲ　オコシニ　サシテネ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うは一つに、彼地にて娶りし仏蘭西ブザンソンの人、テレーズ・シニヨレに餞ける引手箱なりと云う。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そこからフウッと吹き出した鬼気とともに、テレーズ・シニヨレの横顔が現われたのであった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、精緻な輪廓に包まれ、捲毛の金髪を垂れているのが、トレヴィーユ荘の佳人テレーズ・シニヨレの精確な複製だったのである。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにいっそう薄気味悪いことには、擬うかたなくそれが、黒死館で邪霊と云われるテレーズ・シニヨレだったのである。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
