    "definitions": [
      {
        "index": 1,
        "gloss": "dying",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖父の死に際に、家族全員が枕元に集まって感謝の言葉を伝えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は死に物狂いで練習に打ち込み、ついに全日本大会で優勝を果たした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "死に体となっていたプロジェクトが、新しいリーダーの就任で見事に復活した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "みたばかりの死に茫然として、卑怯にも似た感情を抱いて私は歩いてゐたと告白せねばなりません。",
              "citation": {
                "source": "死別の翌日",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう随分生れた時とは心理の構造が変つてをり、さればにや時々今にも死にさうな病気をやるのである。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "『この痛み、もう大きの、参りますならば、多分私は死にましょう。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私死にますとも、泣く、決していけません。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私死にましたの知らせ、要りません。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "芥川君のあの論文、及び最近における彼の多くの感想をよんだ人は、いかに彼が純粹な詩の憧憬者であり、ただ詩的なものの中にのみ、眞の意味の文學があり得ることを、必死に力説してゐるかを知るだらう。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（しかも皮肉なことには、その催眠劑がまた彼を死に導いた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "實に彼は、死によつてその「藝術」を完成し、合せて彼の中の「詩人」を實證した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "世のおとなたちは、織田君の死に就いて、自重が足りなかったとか何とか、したり顔の批判を与えるかも知れないが、そんな恥知らずの事はもう言うな！",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、僕に死を禁ずるその同じ詭弁家が時には僕を死の前にさらしたり、死に赴かせたりするのだ。",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の考え出すいろいろな革新は僕の周囲に死の機会を増し、彼等の説くところは僕を死に導き、または彼等の定める法律は僕に死を与えるのだ。",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬鹿な親でも、とにかく血みどろになって喧嘩をして敗色が濃くていまにも死にそうになっているのを、黙って見ている息子も異質的ではないでしょうか。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて、妹さえ丈夫でございましたならば、私も、少し気楽だったのですけれども、妹は、私に似ないで、たいへん美しく、髪も長く、とてもよくできる、可愛い子でございましたが、からだが弱く、その城下まちへ赴任して、二年目の春、私二十、妹十八で、妹は、死にました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹は、それから三日目に死にました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでよかったら、死にたまえ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（君曰く、残念、プルウストはもう死にました。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "死にもせぬ旅寝の果よ秋の暮枯枝に鴉の止りけり秋の暮　曠野の果に行きくれても、芭蕉はその「寂しおり」の杖を離さなかった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし自分は死にたくても死なれぬ。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともとこの狸は、何の罪とがも無く、山でのんびり遊んでゐたのを、爺さんに捕へられ、さうして狸汁にされるといふ絶望的な運命に到達し、それでも何とかして一條の血路を切りひらきたく、もがき苦しみ、窮餘の策として婆さんを欺き、九死に一生を得たのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、いやにねばつこい口調で歎願して、頸を長くのばしてうなだれて見せて、傍に木の實が一つ落ちてゐるのを見つけ、ひよいと拾つて食べて、もつと無いかとあたりをきよろきよろ見廻しながら、「本當にもう、お前にそんなに怒られると、おれはもう、死にたくなるんだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほつて置いたら、死にますよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、おれはいつそ死にてえ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狸汁の運命から逃れて、やれ嬉しやと思ふ間もなく、ボウボウ山で意味も無い大火傷をして九死に一生を得、這ふやうにしてどうやらわが巣にたどりつき、口をゆがめて呻吟してゐると、こんどはその大火傷に唐辛子をべたべた塗られ、苦痛のあまり失神し、さて、それからいよいよ泥舟に乘せられ、河口湖底に沈むのである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな目に遭つても、死にやしない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやでいやで、死にさうな氣持。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なに、死にやしない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほつて置いたら死にますよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "こごえて死にさうになるまで、竹藪の中を搜し歩いていらして、やつとけふ逢へたくせに、優しいお見舞ひの言葉一つかけるではなし、――」「優しい言葉だけは、ごめんだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その私たちの登山にしてからが、時間不足のために、絶頂の剣ヶ峰ともいうべき、シャスタ・ピークまでは、達しなかったのだから、一個の予察地形図をスケッチしたぐらいの、軽い気分で読んでいただきたい、何も登山記だからと言って、死に身になってコチコチと緊張しなければならない、というものでもなかろう。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "おふくろの方では、水を飲ませといてから殴るのであるから、充分に思ひやりのある処置と信じてゐるのだらうが、殴られる子供の側になつて考へると、何のために、母親が自分を殴るのか、見当がつかないものだから、その抗議として、死にもの狂ひに、あらん限りの悲鳴を上げるのである。",
              "citation": {
                "source": "井戸の底に埃の溜つた話",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
