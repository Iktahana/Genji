[
  {
    "uuid": "ef545b98-ec8e-5e60-a19b-6dde7b6c0fcf",
    "entry": "締め上げる",
    "reading": {
      "primary": "しめあげる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
