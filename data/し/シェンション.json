          "literary": [
            {
              "text": "一人の茶っぽい服を着た女学生が自分の席から、「シェンション」と呼んで手をあげた。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "通訳の終るのをまちきれずに「シェンション」と鋭く呼んだ女学生であった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二度ほど間に「早川シェンション」とよびかけながら。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
