        "examples": {
          "standard": [
            {
              "text": "玄関に立派な門松としめ飾りを飾り、歳神様を迎えるための正月飾りの準備を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最近はアパートのドアにも掛けられるような、小さくておしゃれなデザインの正月飾りが人気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "家の玄関に正月飾りを飾る季節がやってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "此が正月飾りの起りで、山かづら・羊歯の葉・寄生・野老・山藍・葵・榧・山桑など、何れも山づとと見られるものです。",
              "citation": {
                "source": "山の霜月舞",
                "author": "――花祭り解説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此が正月飾りの起りです。",
              "citation": {
                "source": "翁の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
