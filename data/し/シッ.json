[
  {
    "uuid": "23c6de8f-5065-5268-808f-97662779a8c4",
    "entry": "叱",
    "reading": {
      "primary": "しっ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "shh!",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「しっ、静かにして！ 今あそこに珍しい鳥が止まったんだから、逃げちゃうじゃない」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「しっ、先生がこっちに来るよ。早く教科書を出しなさい」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「しっ！ 赤ちゃんがやっと寝たところなんだから、大きな声を出さないで」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それ故彼は、動物を始め植物に至るまで、すべて生物を虐めたり殺したりすることを非常に叱った。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中が蛇を追ったといって叱られ、植木屋が筍を抜いたといって怒られ、はては『おババさま』の姑でさえが、枯れた朝顔をぬいたというので『おババさま好き人です。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし朝顔に気の毒しました』と叱言を言われた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なんて、こんな事を言うと、非科学的だといって叱られるかしら。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車に乗って三鷹の駅前の酒屋へ用達しに来て、酒屋のおかみさんに叱られてまごついている事もある。",
              "citation": {
                "source": "男女川と羽左衛門",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "口をひらけば、何か人生問題を、演説口調で大聲叱咤しさうな氣がして、どうも何氣ない話は、できぬ。",
              "citation": {
                "source": "九月十月十一月",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "男らしく、しっかりした態度で飲め、という叱咤の意味にも聞える。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私は東京の人全部を代表して叱られている形だった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「酒だってあるし、」大隅君は、酒を飲みながら、叱るような口調で私に言うのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、大隅君に叱られても黙って笑っていた。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただもう、やたらに天下国家ばかり論じて、そうして私を叱るのです。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしていいかわからなくなって、天下国家を論じて君を叱ってみたり、また十一時まで朝寝坊してみたり、さまざま工夫しているのだろうが、どうも、あれは昔から、感覚がいいくせに、表現のまずい男だった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叱られて去つた妻君の象が彼の眼底に残つた時、彼は死んだ自分の子供に縋りついて泣いた妻君を思つた、次いで眼の前の母親が同情された。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "叱り飛ばされた妻君は引き返したその足を直ぐに長男の書斎に運んだ。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り叱らぬ先生の前で、生徒達は聞こえよがしに校長の悪口を言合つた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その松の樹には、今は亡き弟と或時叱られて吊り下げられたことがある。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "運転手は子供を叱るので大忙しであつた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "叱られるとドツキリとしたものであつた。",
              "citation": {
                "source": "金沢の思ひ出",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　母は弟を叱るやうに言つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "韋駄天を叱する勢いよく松が端に馳け付くれば旅立つ人見送る人｜人足船頭ののゝしる声々。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど二学期の試験のすぐ前であったが、忙しい中から同郷の友達等が入り代り見舞に来てくれ、みんな足しない身銭を切って菓子だの果物だのと持って来ては、医員に叱られるような大きな声で愉快な話をして慰めてくれた。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかな奴だ、と大いに叱つて、どつさり呉れた。",
              "citation": {
                "source": "先生三人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎朝いただいて居る東奧日報に據れば、私の兄は、いま、縣會に於いてたいへん割のわるい役をして居るやうである、私、いま、兄上に叱咤されるのを覺悟のうへで申してゐるのであるが、勘平役者が黒衣にまはつたやうで氣持がよくない。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お婆さんも、また息子の阿波聖人も、お爺さんがお酒を飮んだつて、別にそれを叱りはしない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は叱りもせず、ほほほと笑ひ、「さうね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と子供を叱るやうな口調で言ひ、「そんな工合ひに家の中で、じつと爐傍に坐つてゐる人と、井戸端へ出て洗濯してゐる人と、どつちが寒いか知つてゐますか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お叱りは、覺悟の上でありました。",
              "citation": {
                "source": "文盲自嘲",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもいま、葛原しげる氏の原稿を拜讀して、そんなに、嚴しいお叱りも無いので、狡猾の小文士は思はず、にやりと笑ひ、ありがたしと膝を崩さうとした、とたんに、いけませんでした。",
              "citation": {
                "source": "文盲自嘲",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "出鱈目にロープなんぞ抛り出しやがって」　彼は叱言を独りで云いながら、ロープの上へ乗っかった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのようにこどもの山神たちにも秀でた性格の傍、叱りたしなめはするがそれによってまた憐れみがかかり懐き寄せられもする欠点なるものがあるのだったが。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
