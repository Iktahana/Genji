        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「しっ、しっ！ この野良猫め、またうちの庭でいたずらをして……出て行きなさい！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「しっ、しっ！ ほら、ハトにエサをあげちゃダメだって看板にあるでしょ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「しっ、しっ！ 汚い手でテーブルに乗るんじゃないよ、シロ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
