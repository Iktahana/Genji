          "literary": [
            {
              "text": "顔を洗つて髪を結つた時、女中のマリイがパンとシヨコラアを運んで来た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "顏を洗つて髮を結つた時、女中のマリイがパンとシヨコラアを運んで來た。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時頃目覚めて床の内にて一碗のシヨコラを啜り、一片のクロワサン三日月形のパンを食し、昨夜読残の疑雨集をよむ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "路地裏の佗住居、ガスストーブの設けとてもなければ、朝目覚めて後も蓐中にて麺麭とシヨコラとを食し、其儘に起出でず、午頃まで読書するなり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
