          "literary": [
            {
              "text": "だから、一体になれず、いつも心理的抵抗がある。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "思想が信念にまで昇華し、信念が思想としての体系をとる過程に於て、これに対する心理的抵抗は、性格の宿命として、思想を思想するもののみの興味を惹くに足る問題である。",
              "citation": {
                "source": "空地利用",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂馬を殺すということに俺は心理的抵抗を感じなかったのだろうか。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
