        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "又ソレヲ聞カナケレバアンナニ憤慨ハシナカッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　オ前ハ二人ヲ殺スノニ何モ物ヲ使オウトハシナカッタノカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレカラ兄ヘ只ハ済マヌカラ、書附ヲ出セト云ウカラ、ソレモシナカッタ、姉ガイロイロ心配ヲシテ、諸寺諸山ヘ祈祷ナド頼ンダトイウコトヲ聞イタカラ、翌年春、挨拶安心ノタメ隠居シタガ、三十七ノ歳ダ」　三十七にもなるどうらくおやじを檻には入れそこなったが、隠居ということで、兄貴たちもまず安心の体。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢丹ノ特選売場ヘ行ッタラ何カシラ見ツカルダロウ」実ハ外ニ少シ考ガアッタンダガ、ソンナコトハ口ニシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ放任主義ダカラ敢テ干渉シナカッタガ、婆サンハ颯子トノ結婚ニハ反対ダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ頻リニコノ天候ヲ気ヅカッテ、モウ一日オ延バシニナッタラト云ッタガ、予モ颯子モ承知シナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ラク二人ノ結婚ハ成立シナカッタニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤ始メカラ、ダンサー上リトノ結婚ナンテ考エラレモシナカッタ筈ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「死ンダッテ何ダ」ト思ッテイタガ、死ニソウナ気ハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ勿論颯子ヲモデルニスル※ヲ石屋ヤ五子等ニ悟ラセハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ拓本ニモトヅイテ彼女ノ足ノ佛足石ヲ作ルノデアルコト、予ガ死ンデカラ骨ヲソノ石ノ下ニ埋メテ貰ウノデアルコト、ヲ知ッタ時ニモ、彼女ハ格別ノ意見ヲ述ベハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………払暁マデ僕ハ一睡モシナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ酔ッタフリモシナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "光ヲ消ス※モ要求シナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
