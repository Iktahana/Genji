  {
    "uuid": "22413bdb-d056-5e99-bcd3-944b69aef25c",
    "entry": "詩豪",
    "reading": {
      "primary": "しごう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
