        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いわゆるイニシアルでも、T. T. とだけでは、例えば自分と同番地の町内につい近頃まで四人もいた。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "斜向うのイギリス銀行、ロイド・ナショナル・プロヴィンシアル・バンクの支店から出て来た髭の生えたプラスフォアのイギリス人が日当りの好さそうな卓を選んで席を取った。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "到頭私はソシアル・ダンスと紅い文字で出てゐる、横に長い電燈を見つけることが出来た。",
              "citation": {
                "source": "町の踊り場",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "スペシアル・ゲイシャ・ガールだ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "週刊『ル・リベルテエル』（自由人）月刊『ラ・ルヴィユ・アナルシスト』（無政府主義評論）との事務所になっているほかに、ラ・リブレリ・ソシアル（社会書房）という小さな本屋をもやっているので、店はみな地並みにあるわけなのだ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "貨物の積み込み方が拙くて、片方へ寄ったのだろうという説も出たが、これは、ダアバンで積荷を請負ったマアシアルという人が出て、ワラタ号の船艙の見取図に就いて説明し、その疑いは氷解した。",
              "citation": {
                "source": "沈黙の水平線",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "とあって、その次行に「記」としるし、それから博士のいわゆる「十五年満期」の「長期性時限爆弾」を「装填シアル物件」が十二個ずらずらと列記してあるのであった。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、まず第一号を読んでみると、一、八角形ノ文字盤ヲ有シ、其ノ下二振子函アル柱時計ニシテ、文字盤の裏ニ赤キ「チョーク」ニテ３０３６ノ数字ヲ記シアルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論ステージ・ダンスなら、こんな滑稽など朝飯前ではあるけれど、少くもダンスホールのソシアル・ダンスに於てこんな飛び離れたフィギュアをするものがあろうか？",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシアル・ダンスの天才は日本人だよ。",
              "citation": {
                "source": "赤げっと　支那あちこち",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に愛乏しく、神経質で、裁きやすい自分は人と交わっているときに自分の態度がまるで心の有様と一致しないアーチフィシアルな気がしてならない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど一度運命が触れ合うてこれほどの交わりになったものをアーチフィシアルに蹂躙するのは最も悪いことと思われます。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "構内監倉の入口にて、枯川は、送れる人々を見返りて、「こゝからは本人だけしか入れないよ」と呵々大笑して、フロツク着たる影は、ツカ／＼と小暗き廊下に没し去れり、皆相顧みて語なし、彼の手には、「エンサイクロペヂヤ、ヲブ、ソシアルレフオーム」伝習録其他数巻を携へたりき。",
              "citation": {
                "source": "筆のしづく",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち彼等が森へ遊びに行くと、奥の叢林の中に白の下袴と絹のスカーフとパラソルとＭ・Ｒというイニシアルのついた麻の手巾とを発見したのである。",
              "citation": {
                "source": "「マリー・ロオジェ事件」の研究",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして極めて高雅な図案でイニシアルを組合わせ、あの文句を刻らせましょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然の深さが、夜の闇、そこで生きているという力一杯の蛙の声々で、非常にポテンシアルな豊饒さで迫って来たのを思い出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "慰問袋も二つ、島田への羊カン、多賀子へのイニシアル入りのコンパクト、皆すみました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点での感想は、私のこの夏を通しての最もエッセンシアルな収穫であり教訓でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "グランパが桜の花を書き、エニシアルを研究し、十二時過に、グリルでランチをとる。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、コロンビア会に彼がスペシアルゲストとして呼ばれて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "むずかしい、ああ云うソシアル・リフォーマーの戦わなければならない或危期であろう。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂木清ベエ氏、（まだ若く、丸く、長椅子にかけるところ、どっか重役風なところ、一寸見えたが）よく話し、イギリスのソシアリズムに疑問なきソシアル・エボリューショニストだ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れどもワン・ピイスを一着したる佐佐木夫人に対するや、慇懃に礼を施して曰、「あなたはソオシアル・ダンスをおやりですか？",
              "citation": {
                "source": "病牀雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "おひるになったんで御飯たべようとすると、いまはまだ食堂があいていません、というんで、高価いスペシアルを部屋へとったの。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、蓋の裏に彫った文字は、房子のイニシアルではないらしい。",
              "citation": {
                "source": "影",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、ひと月ほどまえクリスチャンである友人の結婚記念に贈呈をうけたイニシアルＪ・Ｊときざまれた総銀製大型の万年ペンを、問題の家におきわすれてきたことをその時はじめて気がついた。",
              "citation": {
                "source": "放浪作家の冒険",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルセル・アシアルの「ワタクシと遊んで呉れませんか」をどの一頁でも読みさへすれば、この事は直ちに明瞭に知ることが出来やう。",
              "citation": {
                "source": "FARCE に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシアルにしてからが、已に早くも行き詰つて、近頃は、より性格的な、より現実的な喜劇の方へ転向しやうとしてゐるが、ファルスと喜劇との取扱ひの上に於ける食ひ違ひが未だにシックリと錬れないので、喜劇ともつかずファルスともつかず、妙にグラグラして、彼の近作は概ね愚作である。",
              "citation": {
                "source": "FARCE に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ書生タルモノ平時互ニ相誇ルニアルイハ博覧考証ヲ以テシアルイハ詩若シクハ文章ヲ以テシ皆自ラ謂ラク天下｜己ニ若クモノハ莫シト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
