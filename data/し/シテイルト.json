        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コレヲ調和シテイルト考エル人ガアレバ、ソレハ習慣ニヨツテ感覚ガ麻痺シテイルニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　ミナサンモ　ゴランニナルヤウニ　カメサンハ　ミンナ　イマダニ　ハダカデ　クラシテイルト　イフワケデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテ癌デハナカッタガ、頸骨ノ六番目ト七番目ガ変形シテイルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ニ手ヲ曳カレテ庭ヲ散歩シテイルト、囲イノ中ノ犬舎ニ入レテアル筈ノコリーガドウシタ間違イカ飛ビ出シテ来テ突然予ニ跳リカヽッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ癖他人ガ触ルトツメタクナイ、普通ノ温カイ手ヲシテイルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ二三回支那ヲ漫遊シタコトガアルガ、支那ノミナラズ、日本ノ何処カヲ旅シタ折ニモ、偶然人ガ野外ニ立ッテ拓本ヲ製作シテイルトコロヲ見タコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今後ハ僕ハ、彼女ガコレヲ実際ニ盗ミ読ミシテイルト否トニカカワラズ、シテイルモノト考エテ、間接ニ彼女ニ話シカケル気持デコノ日記ヲツケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ヲ散歩シテイルトイクラカ不安ガ紛レルケレドモ、ソノ散歩ガダンダン不自由ニナリツツアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
