        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "老妓はすべてを大して気にかけず、悠々と土手でカナリヤの餌のはこべを摘んだり菖蒲園できぬかつぎを肴にビールを飲んだりした。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "駅前の菖蒲園を見た、日本的なのがうれしかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "菖蒲は、堀切が有名なりしが、近年蒲田に、菖蒲園出來たり。",
              "citation": {
                "source": "東京の近郊",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "菖蒲園もあり、櫻楓園もあり。",
              "citation": {
                "source": "久地の梅林",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "天気がいいので、堀切の菖蒲園へいってみる。",
              "citation": {
                "source": "脳の中の麗人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀切橋の東岸には菖蒲園の広告が立っているからである。",
              "citation": {
                "source": "放水路",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "百花園から堀切の菖蒲園も近くなって来る。",
              "citation": {
                "source": "向島",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "千住青物市場、為成菖蒲園居。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その辺を一廻りしてただ寒し十二月二十七日　迷子、菖蒲園来る。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "菖蒲園なども開いていて、遊山の人の姿も見られました。",
              "citation": {
                "source": "わが師への書",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
