        "examples": {
          "standard": [
            {
              "text": "新鮮な芝海老の天ぷらは、ぷりぷりとした食感がたまらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お歳暮に高級な芝海老が送られてきて、家族みんなで喜んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "スーパーで特売になっていた芝海老を買って、エビチリを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "鯱と鯨の中へ、芝海老の如く、呑まれぬばかりに割込んで、一つ吻と呼吸をついて、橋場、今戸の朝煙、賤ヶ｜伏屋の夕霞、と煙を眺めて、ほつねんと煙草を喫む。",
              "citation": {
                "source": "大阪まで",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みほ子さんのお好きな芝海老を煮といたよ」「そうお。",
              "citation": {
                "source": "道づれ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十七　海老飯　は芝海老の皮を剥いてブツブツに切って桜飯へ混ぜて炊きます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピラフは（芝海老とチキン、マッシュルーム）クリームソース掛け。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "芝蝦より稍々大きいラングスチンと呼ぶ蝦は鋏を持っている。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この密漁の手長蝦を芝蝦の代りにして、お好み焼の材料に使い、客に売りつけた男があったが、これなど沙汰の限りと云うべきであろうか。",
              "citation": {
                "source": "文学以前",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮物はなんにいたしましょう」「ぜんまいの甘煮と、芝蝦の南蛮煮などはどうです。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子細工のような透明な芝蝦の子。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "舌が口の中に一杯になるほど膨れあがり、唇は芝蝦の子でも跳ねるようにピクピクと痙攣れる。",
              "citation": {
                "source": "葡萄蔓の束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルナアルさんの唇が芝蝦の子のようにピクピクと痙攣り、舌が口一杯に膨れあがる。",
              "citation": {
                "source": "葡萄蔓の束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "たまさかに参詣の旅人をのせてくる村の人は芝蝦や烏貝といっしょにこの寒村のつまらぬ名物のひとつとして私の話をするのであろう。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "餌は袋イソメと芝エビの肉を刻んでつけるが、袋イソメの方が断然成績がいい。",
              "citation": {
                "source": "ガラガラ釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
