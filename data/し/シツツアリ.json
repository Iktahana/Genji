          "literary": [
            {
              "text": "現今ニ於テハ資本制度ノ壓迫ニヨリテ勞働者ハ自由契約ノ名ノ下ニ全然自由ヲ拘束セラレタル賃銀契約ヲナシツツアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――本鑑ノ左舷前方十五度ニ、黒キ大ナル漂流物アリ、一見島ノ如キモノ漂流シツツアリ。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "気温ハ上昇シツツアリ、タダイマ外部ノ気圧計急ニ上昇ヲハジメ、早クモ五百五……”　五百五というところで、文句は切れていた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……気温ハ上昇シツツアリ、タダイマ外部ノ気圧……五百五、……気圧五百五十ミリ程度というと高度三千メートルに近い気圧だ。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "気温ハ上昇シツツアリ……”　そうだ。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
