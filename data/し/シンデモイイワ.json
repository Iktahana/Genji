        "examples": {
          "standard": [
            {
              "text": "「死んでもいいわ」と彼女はつぶやき、彼の胸に顔を埋めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "映画のクライマックスで彼女が「死んでもいいわ」と微笑んだシーンは、観客の涙を誘った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長い別れの末に再会したふたりは、「死んでもいいわ」という言葉で気持ちを確かめ合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そしたら、私、死んでもいいわ。",
              "citation": {
                "source": "汽笛",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このまま死んでもいいわ」「馬鹿なこといわないでちょうだい」　うっとりと眼を閉じていた茜さんの声が、とつぜん、聞きとれないほど低くなる。",
              "citation": {
                "source": "キャラコさん",
                "author": "新しき出発",
                "note": "青空文庫"
              }
            },
            {
              "text": "もういつ死んでもいいわ。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            }
          ]
        }
