        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古風なシヤンデリアにはもう明りがついて、日暮れまへのひとときのやうな靜けさがそこにはあつた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父は鎖國思想の反キリスト教論者であつたが、そんな晩にはアメリカの息子が贈つて寄越したオイル・ラムプのシヤンデリアを燭して、最も簡單な意見を交換した。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父は鎖国思想の反キリスト教論者であつたが、そんな晩にはアメリカの息子が贈つて寄越したオイル・ラムプのシヤンデリアを燭して、最も簡単な意見を交換した。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に鎖を引くと消えるアメリカ製のきらびやかなオイル・シヤンデリアが、ワアツ――といふ観客の熱狂と共に幻のやうに消えて、技手役の照吉が写し出す日章旗のへんぽんたる光景が華麗な色彩を浮べた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "火もシヤンデリアも私の相手には十分ぢやないし、パイロットもさうぢやない。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか高島屋の川勝竪一氏も見て、下から二階、三階へと、天井を拔いて、北歐風の欄をめぐらし、十八世紀風なギヤマンのシヤンデリアをさげ、隨所、椅子にしたり、ソフアをおいた休み部屋にしたらいゝと、頻りに、空想力を働かせてゐたが、とてもぼくにはそんな實行力はない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
