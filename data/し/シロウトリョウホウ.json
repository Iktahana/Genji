        "examples": {
          "standard": [
            {
              "text": "風邪を引いたときは、無理をせず、昔ながらの素人療法でゆっくり休むのが一番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "素人療法で治そうとするのは危険だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "素人療法に頼らず病院に行くべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ファアウマのは丹毒の懼があるから素人療法では駄目らしい。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとか素人療法がないものかと思いなやんでのことであったろう。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに漢法には民間の素人療法や迷信と言つた風のものが大部入りこんでゐるからねえ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎　……素人療法だつて迷信だつて体験的に効果があれば、それでいゝんぢや無いでせうか？",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
