        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アップルパイを焼くときは、シナモンをたっぷり振りかけるのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "シナモンには血行を促進する効果があると言われ、温活に人気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "カプチーノにシナモンの香りが添えられ、贅沢な気分になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "例えば木の皮がすべての点で良いシナモンの外見をしているときに、これが疑いもなく真正のシナモンの木の皮であることを証明するとしよう。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしシナモンの香りが無いかまたは程度が低いとしたら、我々は受け付けない。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことはシナモンの精油についても同じである。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は町における硝石、黒胡椒、およびシナモンの取引をほぼ独占し、真鍮製品、インジゴ、綿、羊毛、塩、索具、鉄、紙、およびあらゆる種類の英国製品の輸入においても、ブラウン商会を除き、他社の追随を許さなかった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、カンショウ（甘松）、シナモン、コショウ、ゴマ、カルダモン、ショ糖、など。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "中国の薬店が輸入していたのは、高価なアサフェティダ（インド産のスパイス）、ナツメグ、シナモン、胡椒、だけであった。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "セロリ、ショウガ、トリカブト、ゲンチアン根、シナモン、アヘン、ツジャ、タケ、コウマの足、スミレ、燃やしたカメの甲、粘土錠、など。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "合理的なアロエ、ダイオウ、ザクロの根、シナモン、ジャコウ、チョウセンニンジン、など、の他に、コウモリの排泄物、ヘビの皮、など。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、又、メニュウを何度も見て、シナモン・トーストを一つ。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はこれへチョコレートを煮て加えたり、あるいは胡麻を加えたり、レモンを加味したり、バニラ、アルモンド、シンナモン、ナットメックなんぞと色々な味をつけて楽みにするが家庭の慰みには極く好いよ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○シンナモンは肉桂の粉、ナットメッグは肉豆※の粉。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "レモンとかバニラとかアマンドとかジンジャとかシンナモンとかナツメッグとか興奮刺撃の性質の物を使ったりライスカレーなぞを食べるのは皆んな胃を刺撃させるためです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
