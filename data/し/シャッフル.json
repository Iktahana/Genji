        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "トランプゲームを始める前に、カードをよくシャッフルして配り直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ディーラーが手際よくカードをシャッフルし、テーブルの全員に素早く配り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子供がカードのシャッフルを練習しているが、まだ上手く橋形に折り曲げられない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "一九六四年、オハイオ州クリーヴランドのＷＨＫ局、ジョニー・ホリデーのヒット・パレード番組では、ボブ・アンド・アールの『ハーレム・シャフル』が終わったところだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "shaking (a container to mix ingredients, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
