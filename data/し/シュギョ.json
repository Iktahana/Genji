        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第三　仏教の部長阿含云、我有罪人、捉令釜煮蓋之、令人守禦、乃至煮死不見神出、故知死無神也、是婆羅門作如是計、迦葉曰、汝若睡時、神識出入、傍人見否、無也。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "（『長阿含経』にいわく、「われに罪人あり、捉えて釜煮して、これを蓋わしめ、人をして守禦せしむ。",
              "citation": {
                "source": "通俗講義　霊魂不滅論",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに近世間有志の人士籌海守禦の事を獻白す。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大国に外征をする勢力があれば、小国にもまた守禦あり機略あり、何ぞ、ただ畏怖しておりましょうや」「ふーむ。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
