[
  {
    "uuid": "973c9cc0-d750-5577-b2ab-af43082829c7",
    "entry": "舌触り",
    "reading": {
      "primary": "したざわり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
