[
  {
    "uuid": "27fcb4af-575b-5c5a-be5c-44a23818d9db",
    "entry": "守戸",
    "reading": {
      "primary": "しゅこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その代りに守戸というものが出来ました。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シュク」は守戸で、昔の陵の番人だという説があります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには有力な反対説もありますが、私はやはりこの守戸の説を取りたいと思います。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "守戸は同じく陵墓の番人でも、賤民であった陵戸とは違って、もと立派な良民です。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "陵戸はいずれ罪人とか、その他社会の落伍者を以てこれに当てたのでありましょうが、守戸はそうではありませぬ。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これすなわち守戸であります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その守戸の十年交替が、ついに永久的のものとなったと存じます。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし守戸はどこまでも良民で、筋がよい。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "延喜式にも明らかに陵戸と守戸とを区別してあります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "守戸はかく筋がよいのでありますけれども、その執る職務は賤しい。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに中世陵墓の制も紊れて、守戸の扶持も行き届かぬ。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "葬儀の世話もする、屍体の取片づけもするという事になって、所謂｜隠坊に堕落してしまっては、名は良民の守戸たるシュクでいても、世間から賤視せられるに至るのは、けだしやむをえなかったでありましょう。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夙が守戸だとの説の反対者は、例の本居内遠翁の「賤者考」で、今もこの説を採っている学者もあります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからばそれが守戸だという説は認め難い。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夙がもと守戸であるからとて、すべての夙村に必ず陵墓がなければならぬ理由はありませぬ。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "守戸が既に守戸として実務を失い、その名も夙と訛って、その根原が忘れられ、隠坊や、掃除や、遊芸や、警固追捕などの職に従事する様になっては、それと同じ事をしている同等階級の特殊民に、夙の名が及ぶのは一向不思議のない事です。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また現にその付近に陵墓がなくても、もと陵墓の付近にいた守戸が、陵墓の荒廃の為に扶持離れがして来る、人口が増して生活に困って来るとなっては、他の村落の付近に移住して、その村の用を足すの賤民となったのも多い事でありましょう。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば後世の夙が、必ずしもことごとく守戸であったとは言えませぬが、本来の夙は守戸で、それは良民であった。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "夙の起原沿革は、別に「夙の者考」に述べておいたが、要するに夙ももとは御陵守の守戸で、初めは良民であったとしても、その職業上から賤まれて、エタとの間に賤しい程度に於いて、そう相違のなかったものらしい。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも後のあらゆる夙が、ことごとく守戸であったというではなく、階級の類似から、その名の及んだものも多かろう。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大和畝傍山麓の洞村の如きも、もと陵戸か守戸かであったと思われるが、後世の地図には「穢多」と書いてある。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "守戸ならば良民で、夙の起原をなしたものと思われるが、それがやはりエタ村になっている。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが「延喜式」にいわゆる「守戸」に相当するものであろう。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「延喜式」には守戸は十年交替となっている。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "解するものこれを以て守戸の後となし、余輩またかつてはその説に従ってみた事があったが、後に至って必ずしもそのしからざることを明らかにした。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「延喜」の諸陵寮式には、各陵墓についてそれぞれ陵戸守戸の数を記してある。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "後いつとはなく諸陵寮の管理も廃し、陵墓多くはその所在を忘れられるようになっては、陵戸守戸の末路も不明になってしまった。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大和河内地方のいわゆる「宿」については、前述の如く、普通に「守戸」の訛りだと説明せられ、その陵墓のない地方のシュクについては、その名が他の同じ階級の賤者に及んだのであろうと説明されていた。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
