        "examples": {
          "standard": [
            {
              "text": "静まり返った京都の寺院で、鹿威しが「コーン」と石を叩く音が響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭師は、水の流れと竹の跳ね返り具合を調整して、鹿威しの音色を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「鹿威しの音を聞いていると、不思議と心が落ち着くね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "山田｜守る僧都の身こそ……何とやら……秋はてぬれば、とう人もなし、とんと、私の身の上でありますが、案山子同様の鹿おどし、……たしか一度、京都、嵯峨の某寺の奥庭で、いまも鹿がおとずれると申して、仕掛けたのを見ました。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
