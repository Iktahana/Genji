[
  {
    "uuid": "9e7d6f5d-ebdb-50a2-92aa-ea9ddba25855",
    "entry": "春慶",
    "reading": {
      "primary": "しゅんけい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
