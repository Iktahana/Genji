[
  {
    "uuid": "86af6518-8dea-572c-b356-a2a8fbe248da",
    "entry": "霜除け",
    "reading": {
      "primary": "しもよけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
