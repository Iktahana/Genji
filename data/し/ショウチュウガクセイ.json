        "examples": {
          "standard": [
            {
              "text": "夏休み期間中、科学館は自由研究のヒントを探しに来た多くの小中学生で賑わっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "地域の防犯ボランティアたちが、放課後の通学路で小中学生の登下校を見守っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小中学生を対象としたプログラミング教室が開催され、子供たちは真剣な表情で画面に向かっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "これら悪夢の食屍鬼どもの間には、小中学生が本を交換するように、冷静な計算に基づいて傑出した遺骨をやりとりする忌まわしい交流があった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "小中学生でも分かる」　ハロルドが黙った。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            }
          ]
