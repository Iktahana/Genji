        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隣りに坐したシワルドが病気かと問う。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "シワルドもフラーと叫んで血の如き酒を啜りながら尻目にウィリアムを見る。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしじゃ」とシワルドが、進めぬ先から腰懸の上にどさと尻を卸す。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「夜鴉の羽搏きを聞かぬうちに、花多き国に行く気はないか」とシワルドは意味｜有気に問う。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワハハハハ」とシワルドは傍若無人に笑う。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりは南の国の面白い話でもしょう」とシワルドは渋色の髭を無雑作に掻いて、若き人を慰める為か話頭を転ずる。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "シワルドの名残の談義だと思うて聞いてくれ。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおそれだ、その酒の湧く、金の土に交る海の向での」とシワルドはウィリアムを覗き込む。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
