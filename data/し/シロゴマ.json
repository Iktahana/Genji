    "definitions": [
      {
        "index": 1,
        "gloss": "white sesame seeds",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "サラダに香ばしい白ごまをふりかけると、風味が格段にアップする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "白ごまは健康に良いと言われており、毎日の食事に取り入れるようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "手作りのパン生地に白ごまをまぶして焼くと、香ばしい香りが部屋中に広がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "小さい角きりの魚をてり焼らしく見せたもの（味は洋風）一口茄子の油煮、ずゐきの白ごま酢（サラダ代り）クツキースとコーヒ。",
              "citation": {
                "source": "季節の変るごとに",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋のずいきは白ごま。",
              "citation": {
                "source": "ともしい日の記念",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お延の平生から推して、津田はむしろごまかされるに違ないと思った。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
