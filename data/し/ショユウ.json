[
  {
    "uuid": "b92c0bd7-4bcf-5370-8a72-1b5383e594a6",
    "entry": "所有",
    "reading": {
      "primary": "しょゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
