  {
    "uuid": "431afcb6-8302-5f2b-aa5a-2dce1061e7c5",
    "entry": "シマイ",
    "reading": {
      "primary": "しまい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
