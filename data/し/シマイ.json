[
  {
    "uuid": "cc05cdd8-76d8-5008-87d7-c5db7c899c32",
    "entry": "姉妹",
    "reading": {
      "primary": "しまい",
      "alternatives": [
        "きょうだい"
      ],
      "is_heteronym": false
    },
    "grammar": {
