    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「仲店のおもちゃ屋で、この手帖を開いてみたら、これ、ここに、シシマイ、と書いてある。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭山が書を頼まれる世の中になってはモウイカン、世の中はオシマイじゃワハハハハハハハ……」　そこいらに遊んでいる子供等が皆、ビックリして家の中へ逃込んだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ、シマイニオ母ッチャ、オ母ッチャトコエヲ出シテヨンダノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノサワギノ最中蚊帳ノ釣手ガフッツリ切レテ上カラ下リマシタノデ、私ハ一気ニ之ヲハネノケテシマイマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし物は考えようで、制作すべきものが、きれいに一段落ついてこれでオシマイとなったら、何やら心淋しく、また制作が恋しくなるのかも知れません。",
              "citation": {
                "source": "靄の彼方",
                "author": "――現代風俗描写への待望――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに働かされると、ワタシモ、ドコカヘ、カエッテシマイタイ。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いながら、手帳と鉛筆をさしつけると、兵部の娘は、直ちに鉛筆を取って認めました、「海岸ヲ西ノ方ヘ向イテ行ッテシマイマシタ、ソノウチ帰ルデショウ」　それを見ると、金椎の眉根が不安の色に曇り、思わず窓の外から海の方を見ますと、真の闇ながら、空模様が尋常でない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、提灯ヘローソク入レマス、オ待チナサイ、ソウシテ、今夜ワタシ、アナタノ淋シイノヲ慰メルタメニ、一晩中、器量一パイウタイマス、ワタシ、知ッテル世界ノ国々ノ唄トイウ唄、ミンナ歌イマス、イチバンシマイニ日本ノ、歌イマス……夜ガ明ケテモカマイマセン」　マドロスは、すっかり興奮しきっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを読むと、「茂チャン帰リマセン、ミドリサンモドコカヘ行ッテシマイマシタ」　　　　　　　　　十六　清澄の茂太郎が、ふと蘆笛の吹奏をやめて、黍畑のあなたを見やった時、せっかく、首をふりかけた表情のない動物が、愕然として恍惚から醒めて、のどを鳴らしはじめました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、国民の批判や審判を拒否する政党というものの存在を容したら、もうオシマイだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房や娘の汚くて意地悪い表現によって、一匹のイワシに泣く己れの姿をシテキされては、もうオシマイであった。",
              "citation": {
                "source": "水鳥亭",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前なんかに可愛がられちゃ、人間はオシマイなのさ。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウ　トウトムガ　オホキナカラダデ、アンマリアバレタ　　　ノデ、フネガヒックリ　カヘッテ、シマイ　　マシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間ホド揉メテイタガ、シマイニオ爺チャン、チョットイラシッテ下サイト、婆サンガ予ヲ呼ビニ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ腹ノ中ヲ隅カラ隅マデ見抜イテイル彼女デアルカラ、マサカ悪ク取リハシマイト思ウガ、………「ソウダ、ヤッパリ会ッタ方ガイヽカナ、二三日ウチニ機会ヲ窺ッテ何トカ巧ク持チカケテ見タラ、………」今日ノ午後、フト予ハ考エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ明日ノコトヲ考エルト、イッソ今直グヤリ直シテ貰ッテ伸ルカ反ルカヲ一挙ニ決シテシマイタクモアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平安朝ヤ鎌倉期ノ五輪塔ニ関スル知識、今宮神社ノ四面佛ノ如来像ヤ菩薩像ノ線彫リニ関スル知識、両膝ヲ揃エテ坐ッテイル蜻蛉石線彫勢至菩薩ニ関スル知識、等々デ彼ヤ彼女等ヲ驚カシハシタモノヽ、颯子菩薩ノ計畫ハ心ノ奥深クシマイ込ンデ、誰ニモ洩ラサナイヨウニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガトウ／＼ハグレテシマイ、浄吉ガ捜シニ戻ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金五郎サンモ、自分ノ女ヲ、友田サンニ取ラレルノハイヤトミエテ、宴会ノ途中カラ、二人トモ、ドコカニ行ツテシマイマシタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、二人ダケノ事ナラ、マダ善カツタノデスガ、今度ノ様ナ事ニナルト、困ツテシマイマス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナカシマイ　能登の鹿島郡などで、仲仕米といふのはダイトマイのことだといふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナカシマイ　能登の鹿島郡などで、仲仕米というのはダイトマイのことだという。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
