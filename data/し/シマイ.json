    "definitions": [
      {
        "index": 1,
        "gloss": "sisters",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女たち姉妹はとても仲が良く、いつも一緒に出かけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私は三姉妹の末っ子なので、いつも姉たちに甘やかされて育った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "二人の姉妹は顔は似ていないが、声がそっくりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さらにまた「三人姉妹」に於ては、トウゼンバツハ氏とマーシヤさんが、次のやうな會話を交してゐる。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故というに、キャリフォルニアからオレゴン州への、境近い街道に、山が聳えて、複式二重の成層火山、シャスタとシャスチナと、二人の容姿端麗なる姉妹が、見る角度に依っては、並んで手を繋ぎ合ってもいるし、また背中合せに丈くらべをしているようでもあり、何となく人｜懐かしい山に見えるからである。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャスタに就いて言うと、氷河地形などは、我が富士山とは似ない方面だが、その他に於て、多くの似顔は、合せ鏡をしている姉妹でもあるかの如くに感じられる、そう思うとき、我々日本人に取って、シャスタ山は、もう錠前を卸した山ではなくなった。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "片っ端から母を異にする兄弟姉妹の間に、何かありはしないか？",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾等が棲む地球はその姉妹なる諸遊星と独楽のように廻りながら太陽の周囲を不断週遊しているのであると講釈する。",
              "citation": {
                "source": "宇宙の二大星流",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」青年は男の子の手をひき姉妹たちは互にえりや肩を直してやってだんだん向ふの出口の方へ歩き出しました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな姉妹は下駄を取り替える。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの姉妹らはいまさらのごとく声を立てて泣く、母は顔を死児に押し当ててうつぶしてしまった。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見つけた彼の母の、その驚き、そのうろたえ、悲しい声を絞って人を呼びながら引き上げたありさま、多くの姉妹らが泣き叫んで走り回ったさまが、まざまざと目に見るように思い出される。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人が上がってきて、また一しきり、親子姉妹がいってかいないはかな言を繰り返した。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより先、一八六九年にロンドンで彼の学友アーサー・バルフォーアの二人の姉妹エリーノア（Eleanor）とイヴリン（Evelyn）とに紹介され、その後しばしば出遭う機会があった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十二月二十七日『東京朝日新聞』）　　　　　　　　　五十五　　　　　　巨船モーレタニア　先日ルシタニア号の話を掲げたが、その姉妹船モーレタニア号に関する概略の数字だけ比較のために挙ぐれば、船の長さ七百六十フィート、幅が八十八フィート、トン数三万二千。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お絹は此娘と從姉妹なのである。",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "其出品は重に習字、※畫、女子は仕立物等で、生徒の父兄姉妹は朝からぞろ／＼と押かける。",
              "citation": {
                "source": "畫の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "※畫室は既に生徒及び生徒の父兄姉妹で充滿になつて居る。",
              "citation": {
                "source": "畫の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その出品は重に習字、図画、女子は仕立物等で、生徒の父兄姉妹は朝からぞろぞろと押かける。",
              "citation": {
                "source": "画の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "図画室は既に生徒及び生徒の父兄姉妹で充満になっている。",
              "citation": {
                "source": "画の悲み",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "島にかえる娘二人は姉妹らしく、頭に手拭かぶり手に小さき包み持ちぬ。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳優のうちに久米五郎とて稀なる美男まじれりちょう噂島の娘らが間に高しとききぬ、いかにと若者｜姉妹に向かっていえば二人は顔赤らめ、老婦は大声に笑いぬ。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉妹は源叔父に気兼ねして微笑しのみ。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　お登久の姉妹に土産の笹折を持たせて帰して、半七はまだ茗荷屋に残っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい姉妹のその後の運命はわからない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "女行者",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ南谿が記したる姉妹の此の木像のみ、外ヶ｜浜の砂漠の中にも緑水のあたり花菖蒲、色のしたゝるを覚ゆる事、巴、山吹の其にも優れり。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和十年五月、映画評論）　　　　　十五　乙女心三人姉妹　川端康成の原著は読んだことはないが、この映画の話の筋はきわめて単純なもので、ちょっとした刃傷事件もあるが、そういう部分はむしろはなはだ不出来でありまた話の結末もいっこう収まりがついていない。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "主役三人姉妹も上出来のようである。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦労にやつれた姉娘とほがらかでわがままな末のモダーン娘との中に立つ姉妹思いのお染の役がオリジナルな表情の持ち主で引き立っている。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんならお熊さんと……」「血を分けた姉妹と申上げたいが、おんなし人間……辰の年の双生児は一緒に育てるものでない。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉妹共に色｜蒼ざめたれど楽しげなり。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この哀れなる姿をめぐりて漂う調べの身にしみし時、霧雨のなごり冷ややかに顔をかすめし時、一陣の風木立ちを過ぎて夕闇｜嘯きし時、この切那われはこの姉妹の行く末のいかに浅ましきやを鮮やかに見たる心地せり。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その空気が、インテリに適してゐるとゐないとに関らず、つまり、世間が観念を必要としようとしまいと、例へば芸術といふものは、観念に依存した事であるといふのである。",
              "citation": {
                "source": "作家と孤独",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
