    "definitions": [
      {
        "index": 1,
        "gloss": "(in one's) possession",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この美術館は、印象派の絵画を多数所蔵している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その美術館は江戸時代の浮世絵を多数所蔵している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "国会図書館が所蔵する明治時代の新聞資料は貴重だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "あるいは昔の所蔵者が有名な人であった場合にはその人に関する聯想が骨董的の価値を高める事もある。",
              "citation": {
                "source": "科学上の骨董趣味と温故知新",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは物理教室所蔵の教授用標本としての楽器であったのである。",
              "citation": {
                "source": "田丸先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女は逸作の所蔵品で明治初期の風俗を描いた色刷りの浮世絵や単色の挿画を見て知っていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常に寛容の人で私の字筋は性格的だから自分で工夫して行かせ度いと云はれ、所蔵する書の本を沢山私に貸与して優れた字の含む風韻とか格といふものを感得させて呉れられた。",
              "citation": {
                "source": "私の書に就ての追憶",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてとても仕切れないほどの所蔵品の手入れを命じたり、観賞するためにあれこれと蔵から出し入れさせられて煩さかつた。",
              "citation": {
                "source": "過去世",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "所蔵の童話の本、全部を投げ打っても、その東の横綱と交換したいと思っていたにちがいない。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "文淵堂所蔵の「狂歌本朝二十四孝」「狂歌調子笛」等は早く嘉永六年に印刷せられたものである。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの看たこの書は文淵堂の所蔵である。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "芥川氏の所蔵に香以の父竜池が鎌倉、江の島、神奈川を歴遊した紀行一巻がある。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の蒐集した資料と、宮廷所蔵の秘冊とを用いて、すぐにも父子相伝の天職にとりかかりたかったのだが、任官後の彼にまず課せられたのは暦の改正という事業であった。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "時には同好者が会合して、めいめいの所蔵品を見せ合うこともあった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "平次と倉造は、伊達の眼鏡や金鎖を所蔵して他所行の着物も二通りあるから、いつでも一着は借すであらう、身装りさへ整へれば断じて水車小屋の人夫とは想像されぬと自負してゐたが、借り物は堪えられぬのだ。",
              "citation": {
                "source": "水車小屋の日誌",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾来富山は益す傾慕して措かず、家にツィシアンの模写と伝へて所蔵せる古画の鑒定を乞ふを名として、曩に芝西久保なる居宅に請じて疎ならず饗す事ありければ、その返とて今日は夫婦を招待せるなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬琴の『※旅漫録』上に、名古屋で見た絵巻物を列した内に「『福富の草子』云々、京にありし日同じ双紙の写しを見たり、橋本氏の所蔵なり（追書に橋本経亮の所蔵を見たり、そを写させしが京伝子懇望により贈り与えたり）、今児童の夜話に花咲爺というものよくこの福富長者の事に似たり、これより出たる話にや」と記す。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃はマダ右眼の失明がさしたる障碍を与えなかったらしいのは、例えば岩崎文庫所蔵の未刊｜藁本『禽鏡』の（本文は失明以前の筆写であっても）失明の翌年の天保五年秋と明記した自筆の識語を見ても解る。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一冊と早大図書館所蔵本とが今残ってる馬琴日記の全部である。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その著るしきは先年の展覧会に出品された広野健司氏所蔵の花卉の図の如き、これを今日の若い新らしい水彩画家の作と一緒に陳列しても裕に清新を争う事が出来る作である。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿岳の傑作の多くは下町に所蔵されていたから、大抵震火に亡びてしまったろうと想像されるが、椿岳独特の画境は大作よりはむしろ尺寸の小幀に発揮されてるから、再び展覧会が開かれたら意外の名幅がドコからか現れるかも知れない。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀州家の当主は、まず何を措いても、所蔵の書画骨董にこんな逸話を添物にして残しておいてくれた、祖先頼宣に対して感謝しなければなるまい。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、お互いに所蔵している古い品物を持ち寄ってそれを鑑賞し批評し合って研究することになったのです。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "竜池会の起ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "観古美術会はさらに一歩進んだ形のもので、会員所蔵の逸品といっても数限りのあること故、一般に上流諸家から秘蔵品並びに宮内省｜御物等をも拝借し、各種にわたった名画名器等を陳列し、それを一般に縦覧を許すことにしました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "竜池会の起ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "また別の日には、父の何年ぶりかの所蔵品の虫干もありました。",
              "citation": {
                "source": "虫干し",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しかし、君、お久良が云ふにはだね――太吉は滅多に他人の前では掛けぬといふ立派な目玉を所蔵してゐるといふが、それはほんたうかね？",
              "citation": {
                "source": "木枯の吹くころ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも例の又貸しであったが、その頃はどこの家にも二種や三種の古い草双紙類を所蔵していたので、湯屋へ来る客が皆それを持って来て、金さんに貸してやると同時に、自分も又貸しをしてもらうのである。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は義太夫の丸本三百余種を所蔵しているそうで、わたしはその中から二百種ほど借りて読んだ。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼家の仮面というのは、頼家所蔵の面という意味か、あるいは頼家その人に肖せたる仮面か、それは判然解らぬが、多分前者であろうと察せられる。",
              "citation": {
                "source": "修禅寺物語",
                "author": "――明治座五月興行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は例の仮面の由来に就て種々考えてみましたが、前にもいう通り、頼家所蔵の舞楽の面というの他には、取止めた鑑定も付きません。",
              "citation": {
                "source": "修禅寺物語",
                "author": "――明治座五月興行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな名剣も貧乏神だけは何うにも出来ないものと見えて、犬養氏は最近和田｜維四｜郎氏の取持で、所蔵の刀剣全部を根こそぎ久原家へ売渡す事に定めた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸つ子に生れ合はせたのを何よりも誇りとしてゐる平岡氏は、飽きつぽい事にかけても立派な江戸つ子で、近頃所蔵の骨董物につくづく飽きが来て、望み人さへあつたら、今が今でも譲り度いやうな事を言ひ出した。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
