        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "庭の小町草の小輪をとってさす。",
              "citation": {
                "source": "一九二七年春より",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅もどきの実はまだ青く、白と黄との小輪の菊の花は、花弁が堅そうに縮んでいました。",
              "citation": {
                "source": "水甕",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            }
