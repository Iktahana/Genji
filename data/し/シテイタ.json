        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガヤノ人タチハ、ソレヲキイテイルウチニ、一人一人ミンナモライ泣キヲシテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ劇場内ハ冷房シテイタガ、コノ冷房ガ予ニハ禁物ナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子モ陸子モ予トハ反リガ合ワナイデ喧嘩バカリシテイタガ、ヤハリ声ヲ挙ゲテ泣ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ恐ラクソウデハナイカト、心中デハ思ッテイルノダガ、ソンナコトハナイダロウト、婆サンノ前デハ否定シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ト申シマスノハネ、アノ顔ヲ見テルト、昔アタシガ贔屓ニシテイタレオ・エスピノザヲ思イ出スンデスノ」「又変ナ名前ガ出テ来タジャナイカ」「エスピノザッテノハフライ級世界選手権ノタイトル・マッチニモ出タコトノアル、フィリッピンノボクサーナノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ寝室ノ右側ニ接シテイタ老夫婦専用ノ便所ヲ、予専用ノモノトシテ椅子式ニ改良シ、寝室ト便所トノ境界ノ壁ヲ刳リ抜イテ、廊下ヘ出ナイデモ行ケルヨウニ、行ケ／＼ニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンカラアンナ注意ヲ受ケタタメニ、却テ神経質ニナッテ、気ニシテイタセイデモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月々ノ家計ハ数年前マデ婆サンガ処理シテイタガ、イツカラカ颯子ガ当ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「腐ッテタラ犬ニヤレバイヽジャナイノ、アナタ達ハ面白ガッテ何デモアレヘ投ゲ込ムンダネ、アンナモノヲ買ワナキャヨカッタ」ソウ云ッテ颯子ハ後悔シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノチラリト見タヾケダッタガ、変ニ冷イ無愛想ナ顔ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ場合ノアルコトヲ、カネテ覚悟ハシテイタケレドモ矢張サスガニ「死ヌ」ト思ウト恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父ト母トハソノ古イ方ノ家ヲ隠居所ニシテ、土地ノ閑静ナノヲ愛シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハソレヲ取リ壊シテ近代建築ニ作リ直し、ソコニ今度ハワレ／＼ノ隠居所ヲ作リタイ考デアルガ、ソレニハ今日マデ婆サンガ反対シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷風ハ戦火ニ焼カレル迄コヽノツイ近クノ市兵衛町ノペンキ塗リノ木造ノ洋館ニ住ミ、偏奇館ト号シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ノ中ニ出テ来タ母ハ、予ノ記憶ニアル最モ美シイ最モ若イ時ノ姿ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼覚メタ後モ、予ハ反芻スルヨウニ夢ノ中ノ母ノ姿ヲ思イ出シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ト浄吉トノ結婚ヲ、予ノ妻デサエアンナニ激シク反対シタノデアルカラ、アノ時分マデ母ガ長生キシテイタラ、ドンナニ反対シタコトデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ十五六歳ニナルマデハ、ナオ彼女ハ昔ノ俤ヲ存シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母モ美シイ足ヲシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十九日ニ予ノ拒絶ニ会ッテカラ、彼女ハスッカリ予ニ愛想ヲ盡カシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日軽井沢デハ努メテ予ト顔ヲ合ワサナイヨウニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トコロデプールヲ作ル費用ハドノクライカヽルンデス」当然コノ質問ガ来ルコトヲ覚悟シテイタノダッタガ、大婆サンモ小婆サンモツイ取リ紛レテコノ大切ナ質問ヲスルコトヲ忘レテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ丈夫デサエアレバコンナ秋日和ノ日ハドンナニ爽快デアロウ、予モ四五年前マデハソノ爽快味ヲ満喫シテイタノニト思ウト、クヤシクモ忌マ／＼シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝室ニ横臥シタキリデ佐々木ガ毎日附キヽリデ看護シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ方ガ病人臭クテ却テ効果的ナンダガ、接吻ノ場合ヲ考エルト、コンナニ髯ボウ／＼トシテイタンジャ都合ガ悪イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人キリノ時ハドウカ知ラナイガ、他人ノ前デハ殊更ソンナ風ニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ云ウノニ、自分ハ昔ＰＱ病院ニ勤務シテイタコトガアッタガ、昨日午後一時間ノオ暇ヲ戴イテ歯ノ治療ノタメ品川マデ参リマシタラ、ソノ歯科医院デ偶然ＰＱ病院時代ノ福島博士ト云ウ整形外科ノ先生ニ出会ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ晩アンナ涙ガ出タノハ、ヤッパリ心ニ死ノ豫感ガ萌シテイタカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
