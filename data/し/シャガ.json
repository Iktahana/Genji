  {
    "uuid": "dc20bd03-0425-5535-85da-01788f1e6c74",
    "entry": "車駕",
    "reading": {
      "primary": "しゃが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
