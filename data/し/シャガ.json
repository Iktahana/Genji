[
  {
    "uuid": "7c7f2463-c64a-542d-849c-fdab4a1e1b5d",
    "entry": "射干",
    "reading": {
      "primary": "しゃが",
      "alternatives": [
        "シャガ"
      ],
      "is_heteronym": false
    },
    "grammar": {
