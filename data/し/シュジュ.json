        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "物語には、小人や朱儒のような不思議な生き物が登場することがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔話に登場する朱儒は、いたずら好きで知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、まるで朱儒のように小柄だったが、力持ちだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "自女王國東度海千餘里、至拘奴國、雖皆倭種、而不屬女王、自女王國南四千餘里、至朱儒國、人長三四尺、自朱儒東南行船一年、至裸國黒齒國、使驛所傳極於此矣。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアでは、医者が病人のしゅじゅつをするところをみせてくれました。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
