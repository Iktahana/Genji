          "literary": [
            {
              "text": "ソレデモ、シバラクダマッタママ、少シズツ大キクユスッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ歩キニクヽテモ、毎日少シズツデモ歩カナケレバイケナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ少シズツ間接的方法デ試シテ見、ソノ反応ヲ見テイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子ノ桟、便所ヤ風呂場ノタイルノ目地、ソレラガスベテ二重ニ見エ、カツ少シズツ歪ンデ見エル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
