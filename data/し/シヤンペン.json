          "literary": [
            {
              "text": "かかる日の薄明に、しどけなき恐怖より蛍ちらつき、女の皮膚にシヤンペンの香からめば、そは支那の留学生もなげくべき尺八の古き調子のこころなり。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "即かりそめの病に飲む一杯の古いシヤンペンの味である。",
              "citation": {
                "source": "桐の花とカステラ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "壜は安物のシヤンペン酒だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "氷に冷したシヤンペンが私達の卓の杯に屡注がれ、領事さんは上機嫌で色色の説明をして下さる。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
