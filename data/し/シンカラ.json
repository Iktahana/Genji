          "literary": [
            {
              "text": "わたしゃシンカラ与一ちゃんが可愛しゅうて可愛しゅうて……」「オホホホホ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも町へ出てウドン屋でも始めようじゃないか」　とその時にお作が云ったのに対して、シンカラ首肯いて見た事を、福太郎は今一度ハッキリと思い出させられた。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "落魄男爵の娘から、こんなレストランの踊り子にかわった妾の身の上話を、シンカラ同情して聞いてくれたり、お料理やお菓子を色々取ったり、お酒をいくらでも飲んでくれたり、お金を持っているだけ、みんな置いて行ってくれたりしたので、妾ホントウに嬉しかったわ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンカラお友達になってみたいと思う人が一人も居ない事がわかりました。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は、　……叔父も伊奈子もシンカラの悪魔ではなかった。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "新高という人はシンカラ無口の人らしいのです。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその時にシンカラふるえ上がってしまって、ミネ子さんのお手紙に書いてある事がウソか本当か尋ねる事が出来なくなりました。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月四日――共働組ノボーシンカラ、オカシナコト聞イタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
