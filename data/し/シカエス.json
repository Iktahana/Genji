        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このプログラムはバグが多いので、最初から仕返して作り直すべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ケーキ作りで失敗したので、材料を買い直して仕返すことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この絵、納得いかないなあ。もう一度、全部仕返そうかな。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
