  {
    "uuid": "13bfb944-554d-5afe-9cdd-fbbae1abee22",
    "entry": "知るべ",
    "reading": {
      "primary": "しるべ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
