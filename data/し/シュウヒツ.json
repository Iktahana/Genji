        "examples": {
          "standard": [
            {
              "text": "書道において、終筆の跳ねが力強いかどうかで作品全体の印象が大きく変わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "先生から「終筆まで気を抜かずに、筆をゆっくりと引き上げなさい」と指導された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は最後の一文字の終筆を書き終えると、満足そうに深く息を吐いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "何故と云つて見給へ……」　原口さんは此間始終筆を使つてゐる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
