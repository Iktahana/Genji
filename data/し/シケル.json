        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は試験に落ちたらしく、朝から顔が時化ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼の表情は時化った。",
              "citation": {
