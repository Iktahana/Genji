    "definitions": [
      {
        "index": 1,
        "gloss": "to be stormy or choppy (sea)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海が時化ているので、今日の漁は中止になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の日本海はよく時化るので、船旅には向かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "台風の影響で外海が激しく時化始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」「困リマス、バロメーの水銀無クナリマス」「……驚いたなあ……また時化るんですか」　運転手は返事せずに、階段の方向へ駈け出した。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根の鉄橋を越えて行くに夏｜蕎麦をつくる畑｜干瓢をつくる畑などあれば埼玉や古河のあたりの夏蕎麥のなつみこめやもおほに思はゞ麥わらをしける廣畑瓜の畑葉かげに瓜のこゝたく見ゆるなど口ずさむ。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "いと恥かしうて、これ習ひ得ざらんほどはと、家に近き某の社に日参といふ事をなしける、思へばそれも昔しなりけり。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "開化郷士と見ゆるもの、　　　いと清純とよみしける、寒天光のうら青に、　　　　　おもてをかくしひとはねむれり。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば御家相続の子無くして、御内、外様の面｜諫め申しける。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴猴も見えねば然にもあらぬやうなりと心まどひしけるが、画ける人のおもひより出でたる菊の花の精なりと後に聞きぬ。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "璧を齎ちて河を渡りける時、河の神の、璧を得まくおもふより波を起し、蛟をして舟を夾ましめ其を脅し求むるに遇ひしが、吾は義を以て求むべし、威を以て劫すべからずとて、左に璧を操り右に剣を操り、蛟を撃ちて皆殺しにしけるとぞ。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "されども尽くる時には尽き易き金銀にて、光りを磨きし餝屋とて日本の長者の名ありしものも、今は百貫目に足らぬ身代となり、是にては中々今までの格式を追ひ難しと急に分別極めて家財を親類に預け、有り金を持つて代々の住所を立退き、大阪の福島に坊主行義の世帯して北に見渡す野山の気色に自ら足れりとしける。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母のいいけるは昨夜夜ふけて二郎一束の手紙に油を注ぎ火を放ちて庭に投げいだしけるに、火は雨中に燃えていよいよ赤く、しばしは庭のすみずみを照らししばらくして次第に消えゆくをかれは静かにながめてありしが火消えて後もややしばらくは真闇なる庭の面をながめいたりとぞ。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この後、童も憂き事しげき世の人となりつ、さまざまのこと彼を悩ましける。",
              "citation": {
                "source": "詩想",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この比喩を教えて国民の心の寛からんことを祈りし聖者おわしける。",
              "citation": {
                "source": "詩想",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "と振離され、得三たちまち血相変り、高田の帯際むずと掴みて、じりじりと引戻し、人形の後の切抜戸を、内よりはたと鎖しける。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "筧の水を受くるとて、嫁菜の莖一つ摘みつゝ、優しき人の心かな、何のすさみにもあらで、其の盥にさしけるが、引とき衣の藍に榮えて、嫁菜の淺葱色冴えしを、菜畠の日南に憩ひて、恍惚と見たる旅の男。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び、名もきかぬ三味線の音が陰々として響くと、――日本一にて候ぞと申しける。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎌倉殿ことごとしや、何処にて舞いて日本一とは申しけるぞ。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "梶原申しけるは、一歳百日の旱の候いけるに、賀茂川、桂川、水瀬切れて流れず、筒井の水も絶えて、国土の悩みにて候いけるに、――　聞くものは耳を澄まして袖を合せたのである。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "また或人申しけるは、容顔美麗なる白拍子を、百人めして、――「御坊様。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その出刃は確かに男の胸を刺しけるなり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍客に驚きて、お通はあれと身を退きしが、事の余りに滑稽なるにぞ、老婆も叱言いう遑なく、同時に吻々と吹き出しける。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かくは断乎として言放ち、大地をひしと打敲きつ、首を縮め、杖をつき、徐ろに歩を回らしける。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "此幾日といふもの楽みにして待ちに待ちたる明日の若雨ふらんには如何にかせんと、檐の玉水の音を聞くさへ物憂くおぼえて、幾度か椽端に出で雲のたゝずまひを仰ぎ見て打囁きしが、程経て雨の小止みしける時、弟はやうやく帰り来りぬ。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "若くは雨の止むこともあらんとの思ひに心休まらで、睡るとも無く睡らぬとも無く時を過ごしける中、いつしか我を忘れて全く睡りに入りけるが、兄上と揺り覚まされて、はつと我に返れば、灯火の光きら／＼として室の内明るく、父上も弟も既衣をあらためて携ふべきものなど取揃へ、直にも立出でんありさまなり。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "其むかし一人住みしける折の事も思ひ出されて、拙くもをかしきことのみ多し。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "谷氏の史に、建文帝、生れて十年にして懿文卒すとあるは、蓋し脱字にして、父君に別れ、儲位に立ちたまえる時は、正しく十六歳におわしける。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "たま／＼燕王の護衛百戸の※庸というもの、闕に詣り事を奏したりけるを、斉泰｜請いて執えて鞠問しけるに、王が将に兵を挙げんとするの状をば逐一に白したり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "本より此の異僧道衍は、死生禍福の岐に惑うが如き未達の者にはあらず、膽に毛も生いたるべき不敵の逸物なれば、さきに燕王を勧めて事を起さしめんとしける時、燕王、彼は天子なり、民心の彼に向うを奈何、とありけるに、昂然として答えて、臣は天道を知る、何ぞ民心を論ぜん、と云いけるほどの豪傑なり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "臣謹んで俯伏して命を俟つ、と言辞を飾り、情理を綺えてぞ奏しける。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to go through hard times",
