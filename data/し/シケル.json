        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "最近は不況で、どの商売も時化ているようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "給料日前で財布の中身が時化ているから、飲み会には行けない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「最近どう？」「相変わらず時化てるよ」と店主がため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to be gloomy",
        "register": "standard",
