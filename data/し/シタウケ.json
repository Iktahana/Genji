    "definitions": [
      {
        "index": 1,
        "gloss": "subcontract",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このプロジェクトでは、専門的な作業を下請けに出す予定です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、塗装工事を下請けに出すために、複数の業者に連絡を取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "下請けに出すことで、コスト削減と納期短縮を目指しています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その日田金を日田の材木屋が下請けのようにして、日田の月隈の奉行所に御座る大公儀の御金奉行の監督を受けながら、九州の諸大名の城下城下におる御用金預り……博多で言えば蔵元屋のような主立った商人にソレゾレ貸付ける。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そげな仕事の下請けしよんなさるとアンタの首へ私が縄かけにゃならん」「インチキにかかる相手が疫病神なら仔細なかろうモン」「ナニ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "編集にまつわるさまざまな作業の中で、もっぱら手間のかかるめんどうな仕事を下請けでこなすプロダクションには、思い入れを育てる余地はなかなかありませんでした。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "編集プロダクションという、いろいろやっかいな作業が吹き寄せられてくる下請けで働いていた私は、はさみとのりを使ったプリプレスの手作業に、一般の編集者よりはよほどなじんでいました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに労働組合を通じて集めた編集者がやりたくない作業のワースト五十を加えて一まとめにしたものを、足元を見て存分に叩ける下請けに回すことにした。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "面倒なことは、下請けに押しつけるにしかず。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "出版社は制作費を抑えようとして外注に出し、そこから利益を捻りだそうと下請けの親父がコストを絞り上げるのだから当然だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは下請けの下請けを確保する。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でもソニーは数多くのパーツを提供してきたが、パワーブック１００ときた日にはさらに一歩進んで、ソニーのＯＥＭ（小さいところがやると下請けは下請けだが、大きいところがやるとこれがＯＥＭという名に化ける）だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場の昨今では、早出、残業、夜業は普通であるし、設備の不十分な下請け工場の簇出と不熟練工の圧倒的多数という条件は、工場内での災害をこれまでの倍にした。",
              "citation": {
                "source": "新しい婦人の職場と任務",
                "author": "――明日の婦人へ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "外聞がわるそうな公売で、東芝の生産した不合格品のストックや、会社として負担になっていたけれども潰してしまえなかった下請け工場の整理が出来て――労働者をクビにすることが出来て――或る意味では悪くなかったというのが現実である。",
              "citation": {
                "source": "正義の花の環",
                "author": "――一九四八年のメーデー――",
                "note": "青空文庫"
              }
            },
            {
              "text": "口の悪い連中には、電電公社の下請けと揶揄されるほどの官需一本やりの会社だったのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "電話局に新設や付け替えを申し込むと、まず電電公社から元請けに仕事がまわされ、そこから下請けの作業グループに仕事が割り振られる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "下請けの値段は一件あたりいくらで、仕事の出来映えは現実のところ関係がない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は谷口組の下請けをやっている菊本氏の家に厄介になりながら、無給で苦力の監督などを手伝わされていたが、ある日、谷口組の親分が『看板の下書きをしろ』というのである。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "取税人というのは政府の収税所の下請けをして、税金を取り立てる人です。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は役所の下請けをした青年団ももとのままではいられなくなって来た。",
              "citation": {
                "source": "青年の生きる道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんそんな大量仕事は、店先で彫りきれる物ではないから、その下請けをする印刻師もどこかに持っていたのであろう。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は人を信じると一本ヤリな質なので、この人の人間にも惚れこんで、会社の専属に取立て、社の請負った桟橋の積込み、沖仕事、石炭の売込みといったような下請けの一切を、古川氏に委せていた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "日進堂は東京の弘報堂の下請けで、新聞広告取次が本業だが、店の一部に化粧品の陳列棚を据え、美容水本舗の看板をかけていた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "教えているのはやはり詩人で、たまに飜訳の下請けなどをしているという背の高いＢだ。",
              "citation": {
                "source": "風",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、下請けみたいなもんじゃな。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "屑拾いこそしなかったが、賃縫いや、ラウンドリーの下請けや、進駐軍ハウスの芝刈りや、闇成金の家掃除、米や薯や魚介の買出し、宝クジ売り。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四の橋のあたりにも、芝浦辺の大工場の下請け工場がいっぱいできた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本急送という会社が原稿輸送員を雇い、その通信社に下請けのようなかたちで、送りこんでいるのだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "天野山金剛寺など」「てまえどもでも、その天野酒を頒けていただき、いってみれば、まあ、その下請けの販ぎ屋でございますが」「では、これは天野酒か」「へえ」「ふウム」　と、ついまた、鼻を鳴らしあって、べつな一人がさらに質した。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それと一緒にひとりでに両手がのびて、こっち向きにつくんつくんしながら手を振って笑う照子を自分の膝へ、自分でも気付かないようなすらりとしたうけとりかたをした。",
              "citation": {
                "source": "杉垣",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其は、大宮権現の由緒と融合したうけひ（ち）と、貴人流離（か）の二つの形式が見える事である。",
              "citation": {
                "source": "愛護若",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "名義人は下請に文句を言った。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "下請は世話役に文句を云った。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
