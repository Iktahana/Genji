[
  {
    "uuid": "bad6bf03-4c01-5c0a-9e11-759cc9eec88e",
    "entry": "思慕",
    "reading": {
      "primary": "しぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
