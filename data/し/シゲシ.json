        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　見る見る繁しくなって、颯と鳴り、また途絶え、颯と鳴り、また途絶え途絶えしている内に、一斉に木の葉に灌ぐと見えて静な空は一面に雨の音。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一径互に紆直し、茅棘亦已に繁し、という句がありまするから、曲がりくねった細径の茅や棘を分けて、むぐり込むのです。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "欅原ただ目に寒く、雨のごとちる落葉あり、よく見ればいよいよ繁し、声立てていよいよ寂し。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見ればいよいよ繁し。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "武装兵の行進、諸｜酋長の来往、漸く繁し。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国橋は天保十年四月に架け換えたのであるが、何分にも九十六間の長い橋で、昼夜の往来も繁しい所であるから、十七年目の安政二年には所々におびただしい破損が出来て、人馬の通行に危険を感じるようになったので、ことしの三月から修繕工事に取りかかることになって、橋の南寄り即ち大川の下流に仮橋が作られていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "金の蝋燭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし敵弾雨よりも繁しくて、徒らに多くの死傷を出すに終った。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかれば良縁の空からざること、蝶を捉へんとする蜘蛛の糸より繁しといへども、反顧だに為ずして、例の飄然忍びては酔の紛れの逸早き風流に慰み、内には無妻主義を主張して、人の諌などふつに用ゐざるなりけり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "星かくれて、銀杏の実落つること繁し。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂道の繁しい人通りの中を左翼の新聞売子が叫びながら通る。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、城主の亡んだＳ城の市民の間では、ひそかに個人の経済活動が分裂しながら繁しくなつた。",
              "citation": {
                "source": "静かなる羅列",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしあらば、梅の花にもならましものを（万葉巻五）この第二句を「恋しけ　しゑや」「恋ひ繁しゑ　や」「恋しけし　ゑや」何れにとる事も出来る。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇多手比日（同巻十一）何時はなも、恋ひずありとはあらねども、得田直比来恋ひの繁しも（同巻十二）あげるもこと／″＼しいが、此が今まで知れて居る、万葉集における用例の総計であらう。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「このごろ」についてゐるのを見ても、「うたてこのごろ……下心ぐし・見まくぞほしき・恋ひの繁しも」と言ふ風に続いてゐるのが、句の転倒するものゝ多い所から、「うたて」が叙述語の様に感じられて来るのだ。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄弟は晩年繁しげと、一座して顔合せはして居たのであつた。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾日も放ったらかしてあった七つになる長女の髪をいゝ加減に束ねてやって、彼は手をひいて、三人は夜の賑かな人通りの繁しい街の方へと歩いて行った。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾日も放つたらかしてあつた七つになる長女の髮をいゝ加減に束ねてやつて、彼は手をひいて、三人は夜の賑かな人通りの繁しい街の方へと歩いて行つた。",
              "citation": {
                "source": "子をつれて",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "門前何とはなく人の徃来繁し。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之二大正七戊午年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから繁しげ通いだした、女は色いろな面を見せた。",
              "citation": {
                "source": "葦",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　又三郎は繁しげ徳右衛門町を訪ねるようになった。",
              "citation": {
                "source": "野分",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾琴　物見のやりとりは、互いに繁しい。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅客の往還と、参府帰府の諸侯は相かわらず繁しいし、街道にお使番の早馬や、他国の使臣の寛々たる歩みを見ない日もなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日米｜俵を脊負ひて五六町へだてたる中村といふへゆく、その道は三国海道なれば人あしも繁し。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後追い追い山高帽子や洋服の礼者も殖え、足取りも大分せわしく、二十五、六年代には電信電話の線もゆきわたり、交通も繁しくなって、追羽子や凧揚げは横町か空地に限られ、娘子供は大不服。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけてこの川尻と、唐人町の河岸すじは、便船に乗る旅客だの、商人の荷駄だの、物売り女だのと、往来が繁しかった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけてここは諸国の者の出入りの繁しい港町。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "池底紅鯉睡　　池底　紅鯉眠り、嶺上白雲滋　　嶺上白雲滋し。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "急きくる涙に咽びながら、掻き口説く言の葉も定かならず、亂れし心を押し鎭めつ、眼を閉ぢ首を俯して石階の上に打伏せば、あやにくや、沒落の今の哀れに引き比べて、盛りなりし昔の事、雲の如く胸に湧き、祈念の珠數にはふり落つる懷舊の涙のみ滋し。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪解くるささやき滋し小笹原昭和八年一月二十七日　鎌倉俳句会。",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
