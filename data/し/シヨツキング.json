          "literary": [
            {
              "text": "年少の諸友に告げよう――僞善とは極めてシヨツキングな言葉である。",
              "citation": {
                "source": "三太郎の日記　第三",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（四）、「厭味」と云ひ「下品」と云ふ言葉も亦僕にとつては極めてシヨツキングな言葉である。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "既往は兎に角、現在に於いては、他人に對しても自分に對しても僕は此シヨツキングな言葉を輕易に使用する事を好まない。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
