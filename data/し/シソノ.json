        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "予乃チソノ美ヲ賛揚シソノ瑕ヲ指摘ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ヲ以テ能クソノ機宜ヲ詳ニシソノ形勢ヲ悉クス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシソノ亜舶ニ投ゼントスルノ前数日也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シソノ既ニ梓ニ上セシ者ハ伝播スルモノ頗多シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモコレト当世ノ務ヲ談ズルヤ議論横ザマニ生ジ口角｜沫ヲ溌シソノ気力｜毫モ前日ニ減ゼズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "定メシソノ刹那ニハ七十年来ノ生涯ニ積ミ重ネタ悪事ノ数々ガ走馬燈ノヨウニ次々ト現レルダロウナ、アヽ貴様ハアンナコトモシタ、コンナコトモシタ、ソレデテ楽ニ死ノウナンテ虫ガヨスギル、今苦シムノハ当リ前ダ、ザマア見ヤガレ、―――ドコカデソンナ声モ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
