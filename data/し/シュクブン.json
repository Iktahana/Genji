        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "仍って向うに行っている服部宇之吉氏と海老名弾正氏、二人とも平和協会の会員だからこの二人に列席してもらうことにしたが、何か日本の会長として祝文でもやってくれということであった。",
              "citation": {
                "source": "大戦乱後の国際平和",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、後に掲げている祝文を送った。",
              "citation": {
                "source": "大戦乱後の国際平和",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしてもこの祝文と品々は、同日までにお届けせねば意味をなさん。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "口のうちで、祝文を唱え、詛を切ること三度。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
