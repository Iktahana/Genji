[
  {
    "uuid": "197c9e41-9966-5a90-a3a2-49385a4b01ac",
    "entry": "主体",
    "reading": {
      "primary": "しゅたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
