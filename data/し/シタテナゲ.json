        "examples": {
          "standard": [
            {
              "text": "野球のピッチャーは、打者のタイミングを外すために、時折、変化球として下手投げを投げる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ソフトボールのピッチャーは下手投げで鋭く曲がる変化球を投げ込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "下手投げの独特の軌道に打者がタイミングを合わせられず、三振に倒れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
