        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのシャアトル行の状況は、リルケがその妻クララに宛てて其日のうちにシャアトルで書いたのと、その翌日巴里から出したのと、二通の手紙に彷彿としてゐる。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "※クララ　リルケにシャアトルにて。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "木曜日零時半　……今、私達はシャアトルに居る。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャアトルの本寺は、巴里のノオトル・ダァムよりも、ずつと傷んでゐるやうに私には思へる。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌年一月、シャアトル行の事があつた。",
              "citation": {
                "source": "日時計の天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
