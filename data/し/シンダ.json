        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここに「シンダレラの教母」と言ってあるのは、その教母が宮殿の舞踏会に行くシンダレラのために魔法で南瓜を馬車に、※鼠を馬に、襤褸著物を美服に変えたからである。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "八洲子　　あれが若し、「ヤスコシンダスグコイ」なら、なほ面白かつたわね。",
              "citation": {
                "source": "歳月",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木氏ニハ数年前ニ心臓ノ期外収縮ガ長ク続イテドウシテモ止マラナイデ困ッタ時ト、眼眩デ苦シンダ時ニ治癒シテ貰ッタ経験ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは　ちっちゃな　ちいさな　おみせで、　ちょうど　おにんぎょうに　ぴったりの　おおきさ　――　ですから　リュシンダと　かぽうぎジェーンは　いつも　〈ジンジャー＆ピクルス〉で　こまごましたものを　かいこんでいました。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "すんでいるのが　おにんぎょうの　ルシンダと　ジェーン。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ　いえの　あるじは　ルシンダなのですが、　えらそうに　めし、　とは　いいつけません。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるひの　あさ、　ルシンダと　ジェーンは　ドールようの　うばぐるまで　ドライヴに　でかけました。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルシンダの　まくらから　うもうを　はんぶん　ぬきだしたところで、　ああ　これは　ほしかった　うもうぶとんに　できると　おもいなおします。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェーンと　ルシンダの　めに　うつったのは、　なんという　ありさま！",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルシンダは　ひっくりかえった　だいどころの　ストーヴに　こしを　おろして、　めを　まるくします。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんだなと　とりかごは　せきたんいれの　うらから　もとに　もどされましたが　――　もぐもぐハンカは　ゆりかごと　ルシンダの　ふくを　あれこれ　せしめました。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんろの　しきものの　したに、　ひんまがった　はくどうかを　１まい　みつけたので、　クリスマスイヴに　もぐもぐハンカと　ふたりで　それを　ルシンダのか　ジェーンのか　とりあえず　くつしたのところへ　つめておいたのです。",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妹より兄へ）　ウルシド、シンダ、サジ、ケイサツヘツレテユカレタ、コチラヘコラレヌカ。",
              "citation": {
                "source": "偽悪病患者",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "埼玉県の東部で幽霊花またはシンダモンバナ（『幸手方言誌』）。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンダ　粃の「しひな」は、もと發音のしにくい語音だつたと見えて、地方毎に大分ちがつた形にかへられて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登半島の各郡では、粃をシンダとも發音して居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンダ　粃の「しいな」は、もと発音のしにくい語音だったと見えて、地方ごとに大分ちがった形にかえられている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登半島の各郡では、粃をシンダとも発音している。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "山腹のところどころに、シンダー・コーンと呼ばれる小さい旧噴火丘がある。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "観測所から頂上までのちょうど半分くらいのところに、赤噴火丘（レッド・シンダーコーン）という円錐がある。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このシンダーは、あんがいに軽くて、また脆いものである。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歩きにくいシンダーの丘を登りつめて、真赤に口をあけた噴火孔の中を覗きこむには、少し勇気がいる。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女のタレにもいろいろ階級があって、若い小娘、おぼこ娘を「シンダレ」、年増を「マダレ」、年寄り「バアダレ」、芸者が「シャダレ」、女郎は「チョウチョウ」、女郎買いは「チョウマイ」。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "（太宰治「津軽」）　私は昭和二十三年の六月十六日に、「ダザイオサムシンダ」という電報を受取った。",
              "citation": {
                "source": "風貌",
                "author": "――太宰治のこと",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
