  {
    "uuid": "ecc067d8-bc1c-5259-933b-c9ce516c9465",
    "entry": "小編",
    "reading": {
      "primary": "しょうへん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かくしてスティーヴンスンはこの一小編によって作家としての名声を完全に確立するに至った。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "この筆初めに当って、自分のこの小編が柳田君の読物から思い出して執筆するに至ったことにつき、ここに深厚の敬意を同君に表する。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "「伊勢人考」も旧稿を捻ねくって間に合わすこととして、いま一編短いものをと昨夕方から書斎に籠って、ほとんど夜を徹して寝床の中で、「紀伊に特有の何楠といふ人名」という小編を書き上げたのは朝の四時ごろであった。",
              "citation": {
                "source": "震災日誌",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯の自然誌など小編の幾つかだけであり副業であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ちつゞく惡鬼ばらひ、屋を壓する黒雲をぬぐつて、景氣なほしに「明月」も、しかし沙汰過ぎるから、せめて「良夜」とでも題して、小篇を、と思ふうちに……四五人のお客があつた。",
              "citation": {
                "source": "十六夜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で私は又、日本橋へ戻つて叔父の知合ひの毛織物輸入商のオフイスに寄宿して餘念もなくタイプライターなどを叩いてゐるうちに「十三人」の第二號に、學生時代に書いたもののうちから鈴木に選ばれた「爪」といふ小篇が載つたのを偶然にも未知の島崎藤村先生に御手紙で讃められ「新小説」の新進作家號に紹介された。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は「池のまはり」といふ小篇を一つ書いたと思ふ。",
              "citation": {
                "source": "貧しき文学的経験（文壇へ出るまで）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間、風邪をひいて寝たはぢめに、いつかの君の小篇小説「からくり」を読み直して、仲々面白かつた。",
              "citation": {
                "source": "〔小林秀雄氏への公開状〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、幾つかの随筆も書き小篇も書いた。",
              "citation": {
                "source": "昭和五年に発表せる創作・評論に就て",
                "author": "「吊籠と月光と」その他",
                "note": "青空文庫"
              }
            },
            {
              "text": "で私は又、日本橋へ戻つて叔父の知合ひの毛織物輸入商のオフイスに寄宿して余念もなくタイプライターなどを叩いてゐるうちに「十三人」の第二号に、学生時代に書いたもののうちから鈴木に選ばれた「爪」といふ小篇が載つたのを偶然にも未知の島崎藤村先生に御手紙で讃められ「新小説」の新進作家号に紹介された。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の大歴史家同じく「遊侠伝」なる一小篇をのこして曰へることあり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、『鈴木藤吉郎』『細木香以』二小篇を読んだ。",
              "citation": {
                "source": "雨の日に",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏が芸術をつくつてゐないといふことは、『細木香以』の一小篇を見てもわかる。",
              "citation": {
                "source": "雨の日に",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの小篇はその特殊なる成立の事情を負うて或る程度まで夫々獨立してゐはするが、少くとも方法的なるものに關しては一の共通の意圖のもとに繋り合つてゐる。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛読に値する二人の新しい作家を同時に友達に得られるなどとは私にとつては全く稀有の現象だつたが、大分前に私は枝原の或る小篇を亦、あまり口を極めて推賞しすぎたゝめに、彼は近頃嘗ての私の賞讃辞をおそれて、創作気分に頓坐を来してゐた。",
              "citation": {
                "source": "泉岳寺附近",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな雑誌としては珍らしい何かの味をもった小篇でその作者の小熊秀雄というひとの名が私の記憶にとどまった。",
              "citation": {
                "source": "旭川から",
                "author": "――小熊秀雄氏の印象――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「無罪の判決」という一小篇探偵小説の中に、なかなか無邪気ならぬ或る種の現代文化の動向を反映しているこの作者は「盲いた月」で一寸したヒステリーに関する科学的トリックを利用しつつ、ウィーンにおける親日支那青年李金成暗殺の物語を語るなかで、「支那人を捕える方法を知っていますか。",
              "citation": {
                "source": "作家のみた科学者の文学的活動",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校で無理に教へる學問などよりも遙に尊いものが、あの小篇の中に潛んでゐる事を思ふと、自分は海外留學の徒事でなかつた事を滿足に思ふのである。",
              "citation": {
                "source": "貝殼追放",
                "author": "愚者の鼻息",
                "note": "青空文庫"
              }
            },
            {
              "text": "寧ろ片々たる小篇に、屡々特異の味はひを見出す人である。",
              "citation": {
                "source": "貝殼追放",
                "author": "「末枯」の作者",
                "note": "青空文庫"
              }
            },
            {
              "text": "この作品が発表された当時、政治や道徳や文学などの見地から、いかに多くの反響を、そして物議を、まきおこしたかは、作者自身が一八三二年に書いている『ある悲劇についての喜劇』という小篇によっても、ほぼ推察することができる。",
              "citation": {
                "source": "死刑囚最後の日解説",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺氏「山晴れ」は農村青年と売られて行く農村の娘との悲劇を牧歌的に抒した小篇、栗林氏「新学期」は農村学童が先生から貰った学用品を、泥棒したのだと思い込んだ両親にどやされるという短篇、どれも農村の現実的な矛盾を剔出しようとする判然とした思想と意志とを表わしている。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "長篇大作が必ずしも優れたりという儀ではがあせん、中篇小篇に優れたものが多くこれ有るんでげすが、とりあえず、長篇大作をペロに（ペロとは外国語ということ）書き改めて、毛唐に見せてやる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方までに小篇三ツ書いた。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "『歓楽』の一篇は初め『新小説』に掲載せし折には何事もなかりし故その頃｜飯田町六丁目に店を持ちたる易風社の主人に請はるるままその他の小篇と合せて一巻となし出版せしめたるに忽ち発売禁止となりぬ。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は永代橋を渡る時活動するこの河口の光景に接するやドオデエがセエン河を往復する荷船の生活を描いた可憐なる彼の『ラ・ニベルネエズ』の一小篇を思出すのである。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は永代橋を渡る時活動する此の河口の光景に接するやドオデヱがセヱン河を往復する荷船の生活を描いた可憐なる彼の「ラ・ニベルネヱズ」の一小篇を思出すのである、今日の永代橋には最早や辰巳の昔を回想せしむべき何物もない。",
              "citation": {
                "source": "水　附渡船",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後海神にて小篇「或夜」脱稿。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後海神にて小篇羊羹脱稿。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十三年九月『麻布襍記』の一書を梓するに当り、再びこの小篇『雨瀟瀟』を取りてその巻初に掲げぬ。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "この度書估野田氏またこの一小篇を取りて刊行せむとす。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
