        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝食にしらす干しを乗せた卵かけご飯を食べるのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新鮮なしらす干しは、磯の香りがしてとても美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "しらす干しと大葉を混ぜて、おにぎりの具にする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "朝食、鮭の最小片、しらす干し入りの浸し、生卵かけて軽く二杯。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
