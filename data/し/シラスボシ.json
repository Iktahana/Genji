    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それを白子干しのように飯にかけて食べるのだ。",
              "citation": {
                "source": "オフ・ア・ラ・コック・ファンタスティーク",
                "author": "――空想半熟卵――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、ふと大根おろしが食べたくなって、八百屋から大根を買って来て、シラス干しをたっぷりふりかけ、勢い込んで食べようとしたら、箸が妙な具合にピョンとはねて、シラス干しが一匹大根おろしをお伴につれて、いきなりぼくの眼の中に飛び込んだのです。",
              "citation": {
                "source": "凡人凡語",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シラス干しが眼の中で泳いでいるなんて、一見風流なようですが、当人としてはメクラになるかも知れないぞと、気が気じゃない。",
              "citation": {
                "source": "凡人凡語",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞼をひっくり返したり、懐中電燈で照らしたりして探したが、シラス干しはいないとのことでした。",
              "citation": {
                "source": "凡人凡語",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
