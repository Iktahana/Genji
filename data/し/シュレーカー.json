        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれが悪魔の聖書とでもいったものでしょうか……これこそ世界中にタッタ一冊しかないと噂に聞いたシュレーカーのＢＯＯＫ　ＯＦ　ＤＥＶＩＬ　ＰＲＡＹＥＲ（外道祈祷書）かと思うと私は気が遠くなって、真夏の日中にガタガタ震え出したものでげす。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者の名前はたしかデュッコ・シュレーカーと読むんだろうと思いましたがね。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソイツを作り出したシュレーカーっていう英国の僧侶さんが、自分の信仰する悪魔の道を世界中に宣伝する文句になっているんですね。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュレーカー（Franz Schreker 1878―1934）　オーストリアの作曲家。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｒ・シュトラウスは別として、ブルックナー、マーラー、シュレーカー、フィッツナーなどという人たちに到っては、アルバム二、三冊を除くほか今のところ僅かに一、二枚しか入っていない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時評判だったシュレーカーのオペラも自作歌詞だったが、今ではあまりきかない。",
              "citation": {
                "source": "歌詞とその曲",
                "author": "信時潔",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
