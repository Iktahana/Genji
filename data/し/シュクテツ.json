          "literary": [
            {
              "text": "辰の痘を病んで死する時、京都に来合せてゐたのが、叔姪の別であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の父の同僚であって叔姪同様に親しくした鈴木老人その他の話に由ると、頗る持余しの茶目であったそうだ。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦国の世の浅ましさ、一夫多妻、叔姪相婚、父子兄弟相｜鬩ぎ、骨肉互いに啄もうとしている。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はその全心を捧げて父母を愛せり、兄妹を愛せり、叔姪を愛せり。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
