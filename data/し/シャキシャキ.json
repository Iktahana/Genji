        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝採りのキャベツはしゃきしゃきとした歯ごたえがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新鮮なセロリをかじるとしゃきしゃきと音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "しゃきしゃきのレタスをサラダに混ぜた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "小松に触る雨の音、ざらざらと騒がしく、番傘を低く翳し、高下駄に、濡地をしゃきしゃきと蹈んで、からずね二本、痩せたのを裾端折で、大股に歩行いて来て額堂へ、頂の方の入口から、のさりと入ったものがある。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "見降している間も、冬を越した霜焼のようやく癒えたその手の、しゃきしゃきと動くのが、微妙に明るい暗示を誘い、何かしら彼はあれだなとすぐ思った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おときも、初茸の淡い香、滑かなようでしゃきしゃきする歯ざわり、噛みしめるとどこかに土のつめたさを含む味をほめた。",
              "citation": {
                "source": "果樹",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこは、大店で、人の住まいが荒そうですし、それにあの、お民さんというお人が、気はいい人なのですけれど、ああいうしゃきしゃきしたお人でございますから、お駒さまも、どんなつらい目をみなすったことか、お察しできますでございますよ」「はい。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうときまると、女は急にしゃきしゃきと立ち動いて、砂馬の手を取って引っ張りあげるようにした。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝豆をハサミでしゃきしゃきと切っていたあの小娘とは思えぬ落ちつき払ったさまに俺は、小娘を短時日にこんなに変えてしまう東京というもののこわさをまざまざと見せつけられたおもいでもあった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉はキメが細かく、シャキシャキしていて、かしわの抱き身などより美味い。",
              "citation": {
                "source": "蝦蟇を食べた話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれをみな捨てているが、わさびの軸の色は青々として清々しく、シャキシャキして歯当りの感触もよし、味もちょっと辛くて、使いようによっては、皮肉にもまたよいものである。",
              "citation": {
                "source": "料理は道理を料るもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "箸洗いなどに配してもシャキシャキして活きる。",
              "citation": {
                "source": "料理は道理を料るもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗中にシャキシャキ軋みながら目まぐるしく展開して行く映画の光線の、グリグリと瞳を刺す度毎に、私の酔った頭は破れるように痛んだ。",
              "citation": {
                "source": "秘密",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャキシャキして鳥の砂ぎもを食べるようだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドサ貫は箸を割ると、せっかちにシャキシャキと箸をこすり合わせ、どうやらひどく空腹だったらしい様子をあらわにしつつ丼を口の前に持って行ったが、急いだせいか、めしの湯気にむせて、苦しそうにせき込むのだった。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "醤油の空樽にどっかと腰かけて、ごっつい植木屋バサミで、枝豆をシャキシャキと枝から切り落している。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
