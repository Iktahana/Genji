          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "オークションで、有名な画家の真筆のスケッチが高値で落札された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古文書は、歴史上の重要人物の真筆であることが判明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "博物館には、文豪の真筆原稿が大切に保管されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "で、紳士たる以上はせめてムダ金の拾万両も棄てて、小町の真筆のあなめあなめの歌、孔子様の讃が金で書いてある顔回の瓢、耶蘇の血が染みている十字架の切れ端などというものを買込んで、どんなものだいと反身になるのもマンザラ悪くはあるまいかも知らぬ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "仇十州の贋筆は凡そ二十階級ぐらいあるという談だが、して見れば二十度贋筆を買いさえすれば卒業して真筆が手に入るのだから、何の訳はないことだ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて月謝を沢山出した挙句に、いよいよ真物真筆を大金で買う。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、紳士たる以上はせめてムダ金の拾万両も棄てゝ、小町の真筆のあなめ／＼の歌、孔子様の讃が金で書いてある顔回の瓢、耶蘇の血が染みてゐる十字架の切れ端などといふものを買込んで、どんなものだいと反身になるのもマンザラ悪くは有るまいかも知らぬ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "仇十州の贋筆は凡そ二十階級ぐらゐあるといふ談だが、して見れば二十度贋筆を買ひさへすれば卒業して真筆が手に入るのだから、何の訳は無いことだ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨月謝を沢山出した挙句に、いよ／＼真物真筆を大金で買ふ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "能は両日催されたが、翁の真筆の賀祝の短冊、土器、斗掻、餅を合せて二百組ほど諸方に送った。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋燈を片寄せようとして、不図床を見ると紙本半切の水墨山水、高久靄※で無論真筆紛れない。",
              "citation": {
                "source": "浜菊",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "本人のてめえだからこそ、直筆だろうと真筆だろうと何枚だっても書けるじゃねえか」「でも、それにしたって、生まれたうちへなにもご家人に化けていかなくたっていいじゃござんせんか」「あいかわらずものわかりの悪いやつだな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "元義かつてその地某家に寄寓せし縁故を以て元義の歌の散逸せる者を集めて一巻となしその真筆十数枚とかの羽生某の文をも併せて余に示す。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「聞いた聞かぬは二の次とし、将軍様真筆のご遺言状、殿の御敵の桑名侯、松平越中守様のお手なんどに。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍様真筆の遺言状など、あるはずはなく、よしあるとも、何んの越中定信なんどの手に……」「かくなりましては万事万端、申し上げまするでござりまするが、将軍様ご真筆のご遺言状、しかも殿にとり不利のお書き附け、将軍様よりご存知のお浦の手へ……」「ナニお浦の手へ？",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ったとおり髪の中に、将軍様ご真筆の遺言状が、油じめりで文字さえ薄れ、もみくちゃになりながら隠されていた。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の腹心の一閣老から、彼もし押して参殿せば、近侍の武士たち身命を賭して、彼を刺そうの計画あることと、桑名侯松平越中守より、将軍家ご真筆の遺言状が、すでに西丸大納言、家斉卿へ捧げられたと、密々に告げられたからだそうな。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人としては、なおくわしく、伊達家所蔵の王羲之の孝経――しかも唐太宗親筆入りという絶代ものの出所来歴を話して聞かせたかったらしいが、話がそこで折れた上に、その後は忙がしく、白雲もまた、いかに伊達家のことなりとも、羲之の真筆は少々割引物として、問いをほごすことをしてみませんでした。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ貞山は角田竹冷邸で秋色の真筆短冊を一見したら「井の端の桜あぶなし」ではなくて「井戸端の」であつたなどと云つてゐたが、あの美文詠嘆調のユニイクな話術であつたからつい／＼「こぼれよね」などと下手に雅めかして発音してしまつたのであらう。",
              "citation": {
                "source": "下谷練塀小路",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗祇の所持の人丸影像は、信実の真筆ではなく、これを手本にして土佐刑部少輔光信に写さした新図であった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが何と、『たけくらべ』の原稿で、むろん正真正銘の真筆であった。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めて、その御真筆に接した時、範宴は、河内の御霊廟の白い冬の夜を思いだした。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、武蔵の画に接すると――といって私はまだ多くの真筆を観る機会にも恵まれていないのだが――一部自分が観た範囲においても、彼の画風というか、溌墨というか、その筆触のあとには、多分に梁楷、牧谿、それから邦人の海北友松や狩野の影響らしいものが、われわれ素人眼にも、すぐ思い出されてくる。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わずかに横物の破墨一、二点が真筆として伝わっているだけである。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世上流布されている武蔵の画のうちには、半分武蔵の真筆で、半分は野田の息子が描いたものもあるわけである。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "印譜の上では、同形を幾箇も見ることができないので、確と知るよしもないが、真筆といわれる作品において、同形同種の印章でも、どうも幾分かの差異が感じられる。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分のような凡眼で見ても、そうして持ち込まれた画幅や書には、一点も真筆かどうだろうと迷うほどな物にも出会わなかった。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "滅多にというより、絶対にといってよい程、真筆はない。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の知人のあいだで、まぎれない真筆として拝見させてもらったのは、済々黌の井芹経平氏から遺物に贈られて持っているＮ氏の達磨図、故Ｕ氏の同図。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、今、武蔵の真筆に接するには、遺墨展か博物館に出陳される折に見るしかない。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
