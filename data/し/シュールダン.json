          "literary": [
            {
              "text": "シュールダンの大広間は中食の人々でいっぱいである。",
              "citation": {
                "source": "糸くず",
                "author": "LA FICELLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで百姓のぜいたくのありたけがシュールダンの店で食われている。",
              "citation": {
                "source": "糸くず",
                "author": "LA FICELLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "このシュールダンというは機敏な奴で一代の中に大分の金を余した男である。",
              "citation": {
                "source": "糸くず",
                "author": "LA FICELLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュールダンの酒店の卓に座して、かれはまたもや事の一部始終を説きはじめた。",
              "citation": {
                "source": "糸くず",
                "author": "LA FICELLE",
                "note": "青空文庫"
              }
            }
          ]
        }
