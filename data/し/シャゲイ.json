        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "武道の一つである射芸は、精神修養にも繋がる奥深い技術だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "武家の子弟は幼い頃から射芸を学び、礼儀作法とともに心身を鍛えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "神社の奉納行事では、社家の者たちが射芸を披露して神前に捧げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "大勢の門下を連れ、厳しい弓具や物々しい騎馬旅装を引っ提げて、権門を叩いて、射芸の宣布に努めて諸国を歩いたとある。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
