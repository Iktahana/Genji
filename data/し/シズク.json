          "literary": [
            {
              "text": "狭い路地の、どうしても干し物のシズクをかぶらずに通れないような道の隅に必ず朝顔だのヒマワリが植えてあるのもみんな同じことである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍しく軒から、雪融けの水が、シズクになって、氷柱を伝って、ぽたぽたと落ちていた。",
              "citation": {
                "source": "雪",
                "author": "楠田匡介",
                "note": "青空文庫"
              }
            },
            {
              "text": "シズクがいきなり警部の首筋を叩いたのだった。",
              "citation": {
                "source": "雪",
                "author": "楠田匡介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
