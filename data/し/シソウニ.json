          "literary": [
            {
              "text": "ヤマキチ　ハ、ソコラニ　タノシソウニ　オヨイデ　イル　サカナ　ニ　イイマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ニモ逃ゲ出シソウニシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ腹立タシソウニ拂イ退ケル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痩セ我慢ヲシテ踊リ場デ休マズ、一気ニ上ッタノデ、苦シソウニ息ガハズム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
