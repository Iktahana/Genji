        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大勢の聴衆を前に、彼は声を絞り上げて熱唱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "遠くの人に呼びかけるため、喉が枯れるほど声を絞り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
