    "definitions": [
      {
        "index": 1,
        "gloss": "sexual interest in young boys",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このアニメのキャラクターデザインは、ショタコン層を意識していると言われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このジャンルはショタと呼ばれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "アニメやマンガの中にショタというカテゴリが存在する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私たちは一緒にマンネリング家を出ると、談笑しながら先日のように、ショタ・シムラの道に沿って馬をゆるやかに進めていった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまぼろしの人力車と私とはショタ・シムラの道に沿って、摺れすれに肩を並べながら黙って歩いて行った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "prepubescent boy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
