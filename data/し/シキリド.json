        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで彼は、勢いよく焚口の仕切り戸を開ける。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　次郎は仕切り戸ごしにそんな話し声をきいていて、泣きたいような喜びを感じた。",
              "citation": {
                "source": "次郎物語",
                "author": "第五部",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰ってゆく由利江を、彼は庭の仕切り戸まで送っていった。",
              "citation": {
                "source": "落ち梅記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋にはめいめいの仕切り戸納があり、自分の物は各自で持つことを許されていた。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると尊氏は、「ほかの侍どもは入れるな」　と、頼春に命じて、廊の仕切り戸を閉めさせた。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
