        "examples": {
          "standard": [
            {
              "text": "神鉄の電車で通勤している乗客が多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "神鉄は有馬温泉へのアクセスが便利だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "神鉄六甲駅で乗り換えて、目的地に向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "だから然ういう偉い小林さんのことはお預けとしておいて、ざっと三十年もの昔、阪神鉄の社長であった頃のことを書く。",
              "citation": {
                "source": "今昔茶話",
