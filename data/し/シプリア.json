          "literary": [
            {
              "text": "一　Ｊ・Ｋ兄「シプリア人と処女の話」の作者の名前は解らぬだらうか？",
              "citation": {
                "source": "痴酔記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから「シプリア人と処女の話」といふのが本来の題名なのか、それとも「アグリタスとジヤステイナ」が原名なのか、君の意見を訊きたい。",
              "citation": {
                "source": "痴酔記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シプリア人と処女の話」の次に吾等の悪魔の現れる作品は「ガンデルシヤイム寺院の会計係テオヒラスの誘惑」であらうか？",
              "citation": {
                "source": "痴酔記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
