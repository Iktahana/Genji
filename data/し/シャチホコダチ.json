        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "体育の授業で初めてしゃちほこ立ちに成功し、クラスメートから拍手をもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼はヨガの練習で毎朝しゃちほこ立ちをして体幹を鍛えることを日課にしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "砂浜でしゃちほこ立ちをしている写真を撮ってSNSに投稿したら、思いがけず大きく拡散された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ああしてあばたの大将が、今度こそはてがらにとしゃちほこ立ちをして出かけたうえは、あわててあとを追っかけていったとて、けんかになるばかりなんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがおりおり玄関で手塚と腕押しをしたりしゃちほこ立ちをしたり、近所の子どもをからかったりする人とは思えない。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "その合間には、しゃちほこ立ちをしたり、とんぼ返りをしたりしました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "doing one's best",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
