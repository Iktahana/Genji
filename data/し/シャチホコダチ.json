          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新入社員は部長の前でしゃちほこ立ちになりながら、震える声で報告書を読み上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「そんなにしゃちほこ立ちにならなくていいよ、気楽にして」と先輩に声をかけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "初めての取引先訪問でしゃちほこ立ちになっていたが、相手の笑顔で少し緊張がほぐれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
