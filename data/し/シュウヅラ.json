        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さあれど、ゆるにしづしづと髪曳きうかぶ底の主面はかたく縛られて、ただほの白き身をなかば、水よりいづる。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そっくりそのまま手前の坊主面に戻って来るんだ。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "門に立ってお辞儀している七兵衛さんを予想したが、おそろしく不機嫌な御亭主面をした七兵衛さんが、薄っ暗い家の中から出て来た。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "その坊主面はちっとも似合ってはいない。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜深くひそかに彼女が、君にそこばくの恵みを与えんとする時、（カトゥルス）どうして君たちは、すぐにわが儘と・冷酷と・亭主面をした権威と・をもってこれにのぞむのか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
