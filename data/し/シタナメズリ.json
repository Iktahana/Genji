        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "宝くじが当たったという話を聞き、彼は期待に胸を膨らませて舌なめずりをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "コンサートの日が近づいて、ファンたちは舌なめずりして待っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新製品の発売を待ちながら舌なめずりしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
