        "examples": {
          "standard": [
            {
              "text": "ろうそくの火を消す前に、心切りで芯を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い道具店で、趣のある心切りを見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "心切りを使うと、ろうそくの燃焼が均一になり、すすが出にくくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "誰かを呼びたい、ような気もしたが、自分の気の迷いで、人を呼ぶのも恥かしかったから、心切りを持ち直して、燭台を見ると、前よりも薄暗いようであった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「閉めさせました」とセルゲイは答えると、心切りで蝋燭の心をつまみ、ストーヴの前に立ちどまった。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "いたし方なく五十吉は寄席で蝋燭の芯切りをし、椙はお茶子に雇われたが、足手まといはお光だ。",
              "citation": {
                "source": "螢",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のすぐ下に千鶴子というのが生れて、その子は札幌で生れ、へその緒を産婆がランプの芯切りばさみで切って（！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
