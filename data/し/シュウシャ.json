      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "the last train or bus (of a day)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "終車が発車する前に、急いで駅に向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "終車に乗り遅れてしまい、タクシーで帰る羽目になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "終車の時間を気にしながら、友人と遅くまで話した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大町では葛行バスの終車に乗り遅れ、「山七」旅館に泊る。",
              "citation": {
                "source": "槍ガ岳",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋谷着は午後十一時十分であったが、玉川線は十時半が終車ゆえ、歩くしかない。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当かいと聞けば、この頃の都電は八時半頃で終車となる由。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ごろ玉川線が十時半終車になったので、甚だ早すぎると思ったが、都電が八時半位で赤電になるなら、玉川線はまだましの方だ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "篠行きの終車だぞーお。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
