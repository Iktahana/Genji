    "definitions": [
      {
        "index": 1,
        "gloss": "with a whistle (e.g. of a kettle)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "やかんの湯が沸き、しゅんしゅんと軽快な音が鳴り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あ、お湯が沸いたみたい！しゅんしゅん言ってるよ」と子供が教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ストーブが温まり、しゅんしゅんと心地よい音を立て始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "きんは、がっかりした気持ちで、しゅんしゅんと沸きたっているあられの鉄瓶を取って茶を淹れた。",
              "citation": {
                "source": "晩菊",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、湯がしゅんしゅんとわく。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務所の方にはいつもサモヴァルがしゅんしゅんいっていて、お得意は輪形のパンでお茶の饗応にあずかった。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "その卓子のうえにはすでに家庭用の大きなサモヴァルがしゅんしゅん沸いて、セーヴル燒きの家族用の茶飮み茶碗が並べてあった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬缶のお湯が、シュンシュン沸いている、あの音も聞えません。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その枕元に近い如鱗の長火鉢の上に架かった鉄瓶からシュンシュンと湯気が立っていた。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い植民道路を、黄色に塗つたシトロエンが、シュンシュンとアスファルトの道路に吸ひつくやうな音をたてて走つてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "攪乳器も糸車も、薬罐のたぎる音も急須のシュンシュンいう音も子供たちのさけびもわたしをあやさない。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生さんのお目ざめは十二時なのに、サモワールは朝からシュンシュン沸いて、お出ましを待っているんですからねえ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、シュンシュンとその水は、自分の身体中で冷たく漣立てて疼くのだ。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大雪でどこも早くから戸を閉めてしまった伊勢佐木町の森閑とした大通りのところどころに、世にも真っ青な瓦斯灯の灯が、シュンシュン音立てて燃えていた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "台所の七輪にかけた鉄瓶が、シュンシュン、鳴っている。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
