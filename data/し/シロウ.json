              }
            },
            {
              "text": "」「ほんとにおもしろうございますわ！",
              "citation": {
                "source": "ブタ飼い",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は高飛車に人をこなし付ける手を覚え、軽蔑して鼻であしろう手を覚えた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論、そんなことで筆頭などゝ認められても、格別嬉しくもないが、そも／＼私が寫眞を初めたのは、十一二の時分のことで、年｜號にすれば、明治三十五六年、流行｜物どころかしろうとに寫眞など寫せるものではないといふやうな考へのある時｜代だつた。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おもしろうござんすか。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈をさしたくない、三十日なり、四十日なり、打ち通すあいだ来ていただきたい、おもしろう見せてあげたいと、そう思ったがどうしました。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌男子なれふぐり締めこそひよろ腰のへなへな臀むしろうつべし照る日に悪しきは沙汰過ぎたり。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人の紹介で、或寺の一室を借りるつもりであつたが、たづねて行つて見ると、いろ／＼取り込みのことがあつて、この夏は客の世話が出來ないと云ふので、またその住持の紹介を得て、しろうとの家に置いて貰ふことになつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "助太刀共に三人共、相当の剣客と見えたのを、羽織も脱がぬ雪駄穿のままあしろうて、やがて一刀の下に斬棄てたまま、悠々と立去る程の御仁のお名前が、江戸市中に聞こえておらぬ筈はないと申しましてな……」「ハハハ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "右に左にノラリクラリと、どんな文句を唄うて、どんな三味線をあしろうて行ったやら。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとならはむしろうらやましそうに見物していた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（いいえ、おもしろうござんすよ。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣室の法学生もおもしろい男で、「や、盛んでしたな、大いにおもしろうございました。",
              "citation": {
                "source": "廃める",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "板も手ごしらえであろう、字ももちろん自分で書いたものらしい、しろうとくさい幼稚な字だ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その二つがどうかしてぶつかり合うと、いつでもほんとうの親切のほうが悪者扱いにされたり、邪魔者に見られるんだからおもしろうござんすわ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（夫人の顔色が葉子の言葉一つごとに変わるのを葉子は珍しいものでも見るようにまじまじとながめながら）たいそうおもしろうございました事。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全くのしろうとだらうか。",
              "citation": {
                "source": "三月の創作",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "が今度の七三郎に対しては、才牛をあしろうたようには行かなかった。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
