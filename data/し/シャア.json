        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "梟奴がびっくりして飛び出しゃあがる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥満のお三どんが、ぶっちょう面をしゃあがって、旦那様とか、先生とかお言いなさい、御近所へ聞えます、と吐しただろうじゃねえか。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "家風に合わねえも、近所の外聞もあるもんか、笑かしゃあがら。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "六十二　ちと黙ったか、と思うと、め組はきょろきょろ四辺を見ながら、帰天斎が扱うように、敏捷く四合罎から倒にがぶりと飲って、呼吸も吐かず、「それからね、人を馬鹿にしゃあがった、その痘痕めい、差配はどこだと聞きゃあがる。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何ともしゃあしましねえ。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、しゃあしゃあと書けたであろう。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ぴしゃあんと雪の原、木霊して、右の頬を殴られたのは、助七であった。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "間髪を入れず、ぴしゃあんと、ふたたび、こんどは左。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもお客も、その黙殺にひるまず、なんとかして一本でも多く飲ませてもらいたいと願う心のあまりに、ついには、自分が店の者でも何でも無いのに、店へ誰かはいって来ると、いちいち「いらっしゃあい」と叫び、また誰か店から出て行くと、必ず「どうも、ありがとう」とわめくのである。",
              "citation": {
                "source": "禁酒の心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この百日紅に油蝉がいっぱいたかって、朝っから晩までしゃあしゃあ鳴くので気が狂いかけました。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとぴたっと鳥の群れは通らなくなり、それと同時にぴしゃあんというつぶれたような音が川下の方で起こって、それからしばらくしいんとしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いきなり証拠物を出しゃあしねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら道楽が強くっても、大家の主人が自分で手を出しゃあしめえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "女が心から「どうせ、あたしゃあ――」と言うときは、もはや他からの如何なる力も抗し難い。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、相手の男だったが、仲人をいれず、自身でしゃあしゃあ出向いて来て、持子さんをいただけないかと言ったのである。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "尼になる気持で……などと云うたら口を縫いこむぞといいきかされていた美津子は、いけしゃあしゃあと、わてとあんたは元から許嫁やないのといった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "細々とした暮しだとうなずけるほどの椙のやつれ方だったが、そんな風にしゃあしゃあと出て行く後姿を見ればやはりもとの寺田屋の娘めいて、登勢はそんな法はないと追いついてお光を連れ戻す気がふとおくれてしまった。",
              "citation": {
                "source": "螢",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　兄はしゃあしゃあとして、得意になっていたが、まだ女学校を出たばかしの花嫁は、婚礼の晩つんなに幸福そうに見えなかった。",
              "citation": {
                "source": "眼鏡",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんと、そこにいたのは、王子くんのほうへシャーっとかまえている、きいろいヘビが１ぴき。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その浴室は、公衆電話函を二つ並べたようになっていて、入口に近い仕切の中で衣類を脱ぎ、その奥に入ると、白いタイルで張りつめた洗い場になっていて、栓をひねると天井からシャーッと温湯が滝のように降ってくるのであった。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かでいい気持じゃないの」　そういってジュリアは奥に入ると、シャーッと白い噴泉を真白な裸身に浴びた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "千鳥もそれに力を得たか、騒ぐのをやめてシャーッと噴泉の栓をひねって、しなやかに伸びた四肢を洗いはじめた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "噴泉はシャーッと勢いよく出ていた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、それと合奏するように、シャーッ、シャーッという狐の声が、物さびしい夜を物さびしくした。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は詩人であり、かの『化石の森』『リンカーン』の作者であるシャーッウドと親友でもあり、また、ルーズベルトの『炉辺閑話』等の文章のブラックチェンバーであったといわれている。",
              "citation": {
                "source": "組織としての図書館へ",
                "author": "――マックリーシュの業績――",
                "note": "青空文庫"
              }
            },
            {
              "text": "下の方からシャーッと機關車のエキゾーストの響。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十三日（土曜）　朝便所へ行くとシャーッと下痢した、昨夜の大雅の洋食がいけなかったか。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
