        "examples": {
          "standard": [
            {
              "text": "医学的には処女膜の有無が性的経験を示す証拠とはならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "産婦人科の医師は処女膜についての正確な知識を患者に説明する責務がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その医学論文は処女膜の解剖学的多様性について詳しく述べている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そんなに妾が疑わしいのなら、妾の処女膜を調べて御覧なさいッて……ソウおっしゃい……失礼な……」　母親はヘタヘタと坐り込んだ。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚処女膜には異常を認めず。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「えゝ、そりゃ其の人に処女膜を破られたの。",
              "citation": {
                "source": "別れたる妻に送る手紙",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
