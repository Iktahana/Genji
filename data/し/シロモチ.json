  {
    "uuid": "729bce22-8e11-5476-80b9-dfef963d2ba2",
    "entry": "シロモチ",
    "reading": {
      "primary": "しろもち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "飛騨では何というか尋ねたいと思うが、信州から越後の方へかけては一般にカラコまたはオカラモチといい、美濃から東海道一帯はシラコモチ、その附近ではまたシロモチというのが普通だから、多分この二つのいずれかだろうと思う。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の名称の最も弘く行われているのは、シロモチ・シラモチまたはシロコモチというのが是に該当する。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
