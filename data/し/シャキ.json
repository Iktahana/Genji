  {
    "uuid": "9da735ec-0d1f-5377-bbca-2411f52ca78e",
    "entry": "社旗",
    "reading": {
      "primary": "しゃき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キャラコさんの居どころをつきとめようとして、東京中の新聞社の自動車が社旗をヒラヒラさせながら狂気のように走り廻っていた。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "フロントに、三角形の社旗を立てている。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋畔の交番所前に、朝日の社旗を振って待つ人影がある。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "下に待たせておいたぼくらの自動車の社旗を見て、何事かと、登って来たものらしい。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その車の隣りに、新聞社の社旗をつけた車が置いてあって、風巻がそこに立っていた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
