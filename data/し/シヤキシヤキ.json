          "literary": [
            {
              "text": "なかなかシヤキシヤキしてるつていふ話だ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでひとつ、世話のしついでだから、そのシヤキシヤキのお嬢さんを、今のうちに、手早く、玉の輿へ乗つけちまはうといふ相談だが、聴いてくれるかね？",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸気がシヤキシヤキ音を立てゝ、汽車が揺れたかと思ふと、もう走り出しました。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆樣のプロフイルを、この海岸にいらつしやつた記念に切らせて下さい」　さういつて、パイプのをぢさんは、テーブルの上の鋏を手に持つてシヤキシヤキと音をさせました。",
              "citation": {
                "source": "影絵師",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "シヤキシヤキと黒いラシヤ紙を切る鋏の音が聞えて來ました。",
              "citation": {
                "source": "影絵師",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
