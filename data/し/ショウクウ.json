        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "行人馬上去　　　　行人馬上に去り、殘燈照空驛　　　　残灯空駅を照せり。",
              "citation": {
                "source": "閑人詩話",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこから出したのか、幅の広い照空灯が、ぶっちがいに、大空の真中で、交叉した。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯は、いつの間にか、消えていた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空隊の光芒は、異分子の侵入した帝都の空を嘗めまわした。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "爆弾の音を聞かされ、照空灯のひらめきを見せられた弦三は、自分の使命のことも何処へか忘れてしまい、「畜生！",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウ、なんだネ」　こっちは、頤髯がある――向う側のビルディングの窓硝子が照空灯の反射で、ピカリと閃いたので、その頤髯が見えた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯が、水色の暈光をサッと上空に抛げると、そこには、必ず敵機の機翼が光っていた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯は、サッと、光を収めた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その真暗な空には、今も尚、照空灯が、青白い光芒を、縦横無尽に、うちふっていた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上からは、噴水のように、青白い光芒を持った照空灯が、飛び上ってきた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "離室への廊下から東南の方を見ると、わが照空灯が十数条、大井町の上空と思われるところへ集まっており、それよりやや左にぱらぱらと火の粉のようなものが落下して行く。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵機が照空灯につきさされながらも、わが砲弾と六百万都民を尻目に悠々と帰って行くので、さらに寒さを感ずる。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯の光の中にしっかり捉えられている。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "九台の僚艇は、全部が六号艇の遭難現場のまわりに集まってきて、四方八方から六号艇のほうへ強力なる照空灯で照らした。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯と照明弾とが、空中で噛み合っていた。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで照空灯に照らし出されたように見える。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「要注意」の信号「火の玉」少尉が、空中の異変に気がついたのは、それからしばらくして、風の中に××陣地のサイレンの響を聞き、それに続いて××陣地にありったけの照空灯が、彼の乗った気球の方に向けられたときだった。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、それから後のサイレンやら照空灯のものものしい騒ぎがはじまるに及んで、彼はやっと或る疑惑を持ったのである。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、腑におちないのは、こうして××陣地ありったけの照空灯が、こっちの気球のあとを追駈けてくることだ。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがの「火の玉」少尉も、すこし不安な気持になって、照空灯の眩しい光芒を手でさえぎりながら、地上の騒ぎをじっと見下していた。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "綱が一本、ぷつんと短く切れて、照空灯の光の中にぶらぶらしていたのである。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上では、こんどは照空灯が、十文字にうごいて、「要注意」を知らす。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大海魔は、しずかに頭をうごかして、ふしぎそうに、まい下りてくる飛行艇を見あげ、照空灯のような目を、ぴかぴかと光らせるのであった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "間近かの照空灯は、聴音隊からの刻々の報告によって、まだ灯火の点かない真暗な鏡面をジリジリ細かく旋廻している。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯が点火したのだ。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "トタンに、照空隊はスーッと消えて、あたりは真の暗にかえる。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "照空灯は、クルリと右へ旋廻すると、また急に左へパッと動いた。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ビルの横腹を染めていた大火光は、その盛りあがった土塊のなかから、照空灯のようにパッとさし出ているのであった。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、照空灯のように燿いていた赤光も、どこかに見えなくなった。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その最中に、突然、飛行島上から、数条の照空灯が、暗い大空に向け、ぱぱーっと竜のようにのぼっていった。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
