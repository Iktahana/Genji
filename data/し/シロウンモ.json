        "examples": {
          "standard": [
            {
              "text": "白雲母は、キラキラとした光沢が特徴の鉱物である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "白雲母は岩石に含まれる鉱物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "白雲母の層状構造が特徴である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "長い湯から上って体を拭くと、分解した白雲母の細片が皮膚からキラキラと銀光を放つ。",
              "citation": {
                "source": "黒部峡谷",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "母岩から分解されて、湯に晒らされた白雲母の細片が、このはかない現し身に、荒唐にして典麗な、原始的の装飾を施してくれたのだった。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
