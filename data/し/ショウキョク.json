  {
    "uuid": "942bed46-678a-54b4-9d57-c40eb97804a6",
    "entry": "小局",
    "reading": {
      "primary": "しょうきょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
