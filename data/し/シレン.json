[
  {
    "uuid": "9b97ea30-fb1c-5566-a007-67e01bc35b88",
    "entry": "試練",
    "reading": {
      "primary": "しれん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
