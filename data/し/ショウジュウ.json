          "literary": [
            {
              "text": "しかも該屍体を大学に於て解剖に付した結果、二十歳前後の少女の屍体にして、特に腰部の燃焼十分なるような燃料を配置したる形跡あり。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "全焼十戸、もう季節に入っていたから珍しくもなかったが、書きようによっては十行乃至二十行は塞げる。",
              "citation": {
                "source": "負けない男",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
