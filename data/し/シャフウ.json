[
  {
    "uuid": "bccb8969-7897-52bc-84b4-14a9b0c123f0",
    "entry": "車風",
    "reading": {
      "primary": "しゃふう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "winter street dust",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "北風が吹き荒れる冬、車風が舞い上がり、街は灰色に染まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "車の通行が多い幹線道路沿いでは、冬になると車風がひどくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "顔に付いた車風を払いながら、彼は急いで家路についた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "しかもその水車風景は、コンスターブルの油絵で見たものとは遠く、小林清親が水彩画から新工夫をして描き上げた、富士を背景とした静岡竜宝山の水車風景の版画（明治十三年版）の方が、ぴたりと胸に来た。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより巨額の公債を有し、衣食に事欠かざれば、花車風流に日を送りて、何の不足もあらざる身なるに、月の如くその顔は一片の雲に蔽われて晴るることなし。",
              "citation": {
                "source": "妖僧記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンドの根元、すなはち壓搾盤をおしさげる胴の形も今樣の蛇腹のギヤではなくて、太鼓型の、水車風に※轉がすすむにつれて釘で止める式のものだつた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [
        "社風"
      ],
      "synonyms": [],
      "antonyms": [],
      "related": [
        "冬",
        "塵"
      ]
    },
    "meta": {
