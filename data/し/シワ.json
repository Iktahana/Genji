  {
    "uuid": "93b9dbd1-c7f3-5ba3-b16d-6aab1dba48aa",
    "entry": "詩話",
    "reading": {
      "primary": "しわ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
