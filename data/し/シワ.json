[
  {
    "uuid": "2e82d98d-176f-541d-8a22-b10c3a5b6d3c",
    "entry": "皺",
    "reading": {
      "primary": "しわ",
      "alternatives": [
        "シワ"
      ],
      "is_heteronym": false
    },
    "grammar": {
