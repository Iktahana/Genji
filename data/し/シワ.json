        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "池に石を投げ込むと、水面に小さな皺が広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風が吹くと、湖の表面にさざ波のような皺が寄る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "朝日を浴びた水面の皺が、キラキラと輝いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
