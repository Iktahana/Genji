        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスレバ長イ間老人ニ取ッ掴マッテオ相手ヲシナイデモ済ムト、考エタノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコト、子供ガ心配シナイデモイヽ、オ前モウ寝ル時間ジャナイカ」「僕寝テタンダヨ、内證デソット見ニ来タンダヨ」「オ休ミ、オ休ミ、子供ガ餘計ナ………」コヽマデ云ッタト思ッタラ、ドウシタ加減カ声ガ鼻ノ奥デ詰マッテ不意ニ涙ガパラ／＼ト落チタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ間ノ涙ハ豫期シナイデモナカッタ涙ダガ、今日ノ涙ハ少シモ豫期シテイナカッタ涙デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤリ損ッタッテ死ニハシナイヨ」「死ニハシナイデモ、気絶シテ今ニモ死ニソウニオナリニナッタリシタラ、ソレヲ見テルダケデモイヤダワ」「コンナ思イヲシテ生キテルクライナラ死ンダッテイヽサ」予ハ殊更ニ悲壮ラシク云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ人ガ優レタ藝術家デアレバアルホド、断乎トシテ刎ネツケハシナイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モットモソンナ面倒ヲシナイデモ、アンナ鍵ハイクラデモ合イ鍵ヲ求メルヲ恐レヌヲ覚悟シ、期待シテイタノカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーソドックスヲ好ム彼女ハ毎年ノ吉例ニ従イ、必ズソノ行事ヲ厳粛ニ行ワナケレバ承知シナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬ガ醸ス激シイ情熱、妻ノ全裸体ヲ思ウ存分見ルノナカッタ法悦境ニ浸リツツアルノヲ思ッテ、自分ノ幸福ヲ感謝シナイデハイラレナイガ、同時ニマタ、コンナ幸福ガイツマデツヅクハズハナイ、イツカハ報復ガ来ルノデアル、自分ハ刻々ニ命ヲ削リツツアルノデアル、トイウ豫感モシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ私カニ思ウノニ、却ッテ僕ガソウシタ方ガ「気ガ楽ニナリ」ハシナイデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アナタノ今ノ良人ノコト、及ビ弘君ノコトハ、御依頼ガナクトモ親戚ノ一人トシテ、親子ノ性質ヲ最モ良ク理解シテイル友人トシテ、及バズナガラ出来ルダケノ事ハスル積リデスカラ、決シテ心配シナイデ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ネ、イマトッテモ安心シテルヨーナ気持、モウ、純ハ、ウワキシナイデショ、サカイさんモ、カンケイナイデショ、トッテモイイ気持、平和』『キリガナイネ、コウシテルト。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
