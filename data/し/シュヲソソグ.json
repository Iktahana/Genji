    "definitions": [
      {
        "index": 1,
        "gloss": "to flush bright red (e.g. of someone's face)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
