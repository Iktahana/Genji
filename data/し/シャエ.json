        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第一場（舎衛城郊外の池、呪術師の娘水を汲みに来り、水甕を水に浸せし儘、景色に見入りて居る。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）第二場（舎衛城内広場、餅施行の札が立って居る。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三場（舎衛城の城壁に沿うて呪術師の娘が帰って行く。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは昨日舎衛城へ行って演若という気狂いの話しを聞いた。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日舎衛城内へ行った阿難はまた娘によって待ち設けられたのである。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『弥沙塞五分律』八に、〈仏、舎衛城に在り、云々。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "また『賢愚因縁経』十二に、舎衛国の婆羅門師質が子の有無を問うと六師はなしと答え、仏はあるべしという、喜んで仏と衆僧を供養す。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "舎衛城中に大長者あり、毎度沙門を招請して供養する。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "舎衛城の中でも最も貧しい、同時に最も心身の清浄に縁の遠い人々の一人である。",
              "citation": {
                "source": "尼提",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ彼の知っているのはこの舎衛国の波斯匿王さえ如来の前には臣下のように礼拝すると言うことだけである。",
              "citation": {
                "source": "尼提",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は「チャム」と云う人種が交趾に残っている、その辺から掘り出す物を見ますると、たいていインドの舎衛城であるとか、迦毘羅城であるとか、インドの名前が付いている。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（たまたま「孝徳紀」の終わりに吐火羅男二人、女二人、舎衛女一人の漂着を報じているのが、空想を刺戟する。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢を串と称する今一つの証拠は、神武紀｜孔舎衛坂の戦の条に「流矢ありて五瀬命の肱脛に中れり云々」。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この寺の本尊である如来は、昔、中天竺舎衛国に、五種の悪疫が流行した時、月蓋長者が竜宮城から閻浮檀金を取り寄せて、釈尊、目蓮長者と三者が心を合せて鋳造した、阿弥陀如来の霊像といわれた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛説にも、比丘有て入舍衞城、次行乞食、至一家、有一女人、語比丘言、作是事來、答言我比丘法、不得作是事、女人言、若不作是事者、我當自傷破身、大喚言比丘強牽我行欲、云々とある（Tardicu, op. cit., p.52; 摩訶僧祇律二四）。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
