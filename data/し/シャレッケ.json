    "definitions": [
      {
        "index": 1,
        "gloss": "fashion-consciousness",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は生まれつき洒落っ気があり、どんな服を着ても素敵に着こなす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最近はファッションに疎くなりがちだが、少しは洒落っ気を持ちたいものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このデザイン、すごく洒落っ気があっていい感じ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "へへへ、嫁取りに文字ったので」「江戸の者は泥棒まで洒落っ気があるな。",
              "citation": {
                "source": "怪異暗闇祭",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつを処罰するためと、もう一つはマタ・アリの正体を暴露する動かぬ材料を獲るためと、一石二鳥、やはりアルセエヌ・ルパンばりに洒落っ気たっぷりのパリー人だ。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "年を取っても貧乏しても気の若さと洒落っ気には何の変りもありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二枚の小判",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜姫を口説きそうでやりきれない」　この期に臨んでも、洒落っ気を捨てない二人でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "火の呪い",
                "note": "青空文庫"
              }
            },
            {
              "text": "この曲者は、恐ろしく洒落っ気がある」「その小舟町に、赤井市兵衛がいるのも確かでしょうね」　お品もたまりかねて口を出しました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "百四十四夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "「洒落っ気は人間の癖だ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "百四十四夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「猿公だよ、ハッハッ、とんだ洒落っ気のある人相見じゃないか」「畜生ッ、どうするか見やがれ」　ガラッ八は大きく舌鼓を打ちました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "死相の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "国府弥八郎は小禄ながら聞えた御家人で、四十年配の分別盛りを、道楽と洒落っ気で暮して居る武家でした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "毒酒薬酒",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のつまらぬ洒落っ気が、それでもあの人を堅気にしたと思うと、まんざら悪い道楽じゃあなさそうだね」「といいなさるのは……」「商売人と見りゃ近づいて盗んだ跡の愁嘆を見せるのが私の道楽さ、はははは」　梅田屋宗兵衛のことばは、温かく力強く三次の胸へ滲込んでいった。",
              "citation": {
                "source": "暗がりの乙松",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　肥つたＭＭ氏は容易に起たなかつたが、勿論彼にも若々しい愛嬌と洒落気は失せてゐなかつた。",
              "citation": {
                "source": "微笑の渦",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕にも洒落気はあるよ。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――中橋氏の狸も例の金沢の選挙無効を聞いて「徳ちやん大あたり」と書く位の洒落気はあつてもよからう。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この齢に成れば、曲りなりにも自分の了簡も据り、世の中の事も解つてゐると云つたやうな勘定ですから、いくら洒落気の奴でも、さうさう上調子に遣つちやゐられるものぢやありません。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも大隈重信の法螺は、百科辞典の範疇を出でないのに対して、法螺丸の法螺はたしかに百科辞典を超越した一種の洒落気と魔力とを兼ね備えている。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇洒落気ばかり強くて、物事に根気が無く、趣味が古くして、進取的気象に乏しい。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」というと、洒落気と茶番気タップリの椿岳は忽ち乗気となって、好きな事｜仕尽して後のお堂守も面白かろうと、それから以来椿岳は淡島堂のお堂守となった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "豪放快活で洒落気があって、一面蕩児の気持ちをさえ備えているところの小一郎である。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いぎりすもふらんすも皆里言葉たびたび来るは厭でありんす　和泉守の狂歌であるがこんな洒落気もあった人物で、そうかと思うと何かの都合で林大学頭が休講した際には代わって経書を講じたというから学問の深さも推察される。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライアンが、鼻をひこつかせて、「鹿はこんな臭いはしやしねえ」「鹿にはあらで――」　洒落気のあるやつで、トレスが応じた。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそうと、相手が洒落気たっぷりの老人だ。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、小唄の一つも聞いて見るほどの洒落気があるならば、何故もっと賢く適当に、独身者として大目に見て貰うような身の処し方をしなかったか、とこう反問するような声を彼は自分の頭脳の内部ですら聞いた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "七十三の姑にもまだ洒落気があるのか、恰好よく結いあがったときなど合せ鏡をして喜んだ。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お七だけは神女の様に天人のやうに穢すことなくそつとしておいて、何か「乙」な工夫はと言ふ洒落気が、とう／＼こんな茶気満々たる書き物を作ることに導いたのである。",
              "citation": {
                "source": "草双紙と講釈の世界",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「女定九郎」「切られお富」は、とりわけ、その狂言に肝腎の洒落気と、嫌がらせと、すつきりした気分をうけつぐ者がなくなるだらう。",
              "citation": {
                "source": "芝居見の芝居知らず",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "駈落ならばまだ洒落気もあるが、実はこの女のために、体のいいお供を仰せつかったようなものだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな腹の耗った男に洒落気があるだろうか。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが精々与里なる男の洒落気であつた。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それがこのボロ船じゃあ、万事が規則ずくめでできているし、洒落気ひとつあるじゃない。",
              "citation": {
                "source": "火夫",
                "author": "DER HEIZER",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸のスリ気質には、ほかの盗児にない一種の洒落気や小義理の固いところがあると聞いていたのを思い合せて、「ははあ、その筆法かな」とうなずいた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年頃にしては、洒落気も色気も見えなかった。",
              "citation": {
                "source": "早春",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
