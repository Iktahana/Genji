        "examples": {
          "standard": [
            {
              "text": "彼は、場を和ませるために、さりげない洒落っ気を交えて話す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "そのコメディアンは、鋭い観察眼と洒落っ気のあるトークで観客を魅了する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「もっと洒落っ気を出して、皆を笑わせてあげなよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
