        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "幸い、舎房には被害がなかった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "本をよんでいたら「宮本さん、もう病舎じゃないよ、普通の舎房へ来たよ」びっくりした。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "病人を公判にひっぱり出したということになってはいけないというので、舎房をかえたのだろう、小細工。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "病舎の見学と云っても、見学団の一行は、舎房の並んでいる廊下をゾロゾロとつっきったばかりだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "３、牢獄は死の場処であると共に、一時的な国営ホテルの舎房であるに過ぎぬ。",
              "citation": {
                "source": "我々は牢獄で何をなすべきか",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "舎房もきっと一緒になることだろうと云ってくれた。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "舎房はやはり仲間の云ったとおりだった。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場でも舎房でも私は仲間に親しめずに終った。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの舎房は旧いままので、鉄格子の、岩乗な舎房であった。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "（工場を終わって舎房に引き上げてからもやはり仕事をしなければならぬので、それにはがっかりした。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか工場は三十日の昼までで休み、私達はそれぞれ舎房へ引き上げたのだったと思う。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は舎房を掃除して、新しい年を待った。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "お正月の間は全然仕事をしないで舎房にいられる、それを聞き、私は楽しく待っていたのだ。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻工では課程をやっていない者は、工場を終わって舎房へかえってからも、就寝前仕事をしなければならなかった。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "免業の日でも舎房での仕事はしなければならなかった。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "舎房の麻台は舎房から出され、工場内へしまわれた。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうすこしでお正月がある、それが過ぎてしまえば、また長いつらい日が続いてゆくのだが、その前にもうすこしでお正月がある、その思いに、工場で舎房での私のべそをかいた、なまけものの心は慰安を求めた。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴をしてきた午後のこと、その時の舎房の看守が私達に「お前達はいいなア。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の舎房にこの七日かそこらに出所する者がいた。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして目録のカードを担当に示して、そのカードの裏面の欄に、いる舎房の番号と自身の称呼番号とを記入してもらうのである。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "三、四日して本は舎房の方に届けられた。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、私がカードをその前に出すと、万年筆を控えたその人は、「お前の舎房は？",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達の一日が暮れて工場から舎房へ引き上げる。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それぞれ舎房に納まったところを、看守がその錠前をおろしてゆく。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思う隙へ、更衣所で手間取ったその一人が、舎房着の帯を締めつつ、あわてて駆けてくる。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などと云っていそいで舎房へ入る私を、わざと背ろから押し入れて、格子扉を閉めるのであった。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "七八〇番とこの若者とは同じ舎房にいた。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "七三五番が仕事の成績が良く、三級に進級し、三級者ばかりの舎房に移るようになった時、七八〇番は云った。",
              "citation": {
                "source": "その人",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
