  {
    "uuid": "6b5769e4-8b03-524f-bcbe-0df81f343bc3",
    "entry": "塩風",
    "reading": {
      "primary": "しおかぜ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
