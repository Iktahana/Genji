          "literary": [
            {
              "text": "この仕事にはアーサー・シュスターが加担し、シジウィック夫人も手伝った。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この計算をシュスター（A. Schuster）が少しばかり改算したものを、私は『宇宙の成立』の一七九頁に紹介しておいた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネーチュアに、シュスターが色々の物理の大家に会った時の印象記が出ていたが、あれも面白かったな。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
