        "examples": {
          "standard": [
            {
              "text": "彼は投資の指南書を読み込み、資産運用の基礎を独学で身につけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "初めての海外旅行に向けて、最新の旅行指南書を購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このマニュアルは、新入社員にとって業務を進める上での大切な指南書だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "末期の和歌が常套に堕してゆく道がこういう指南書にあると思って面白い。",
              "citation": {
                "source": "日記",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "扇工は、その、指南書のさきを読みつづけた。",
              "citation": {
                "source": "元禄十三年",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然という指南書のどこかに簡単な解決方法があるさ。",
              "citation": {
                "source": "四日闇夜",
                "author": "THE FOUR DAYS' NIGHT",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
