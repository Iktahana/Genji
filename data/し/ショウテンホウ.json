          "literary": [
            {
              "text": "商店法により、午後九時を過ぎると、店をしまう規則になっている。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう九時を過ぎましたから、商店法の規則で、品物はうれません。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "商店法なんですから、なんといってもだめです」「なにっ、どうしても売らないと言うのか。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もすこし行ったら「十月一日より商店法実施、皆サンお買物は十時まで！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "商店法に依る十時閉店の街路は、多くの人には生活緊張の感を与えるものであろうが、或る種の人には、世の中から自分だけ取残されたという感を与えるものらしい。",
              "citation": {
                "source": "風俗時評",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
