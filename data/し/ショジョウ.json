[
  {
    "uuid": "f54f17b8-00bd-57e9-8ac8-d525162e1801",
    "entry": "書状",
    "reading": {
      "primary": "しょじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
