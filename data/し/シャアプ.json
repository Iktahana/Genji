          "literary": [
            {
              "text": "最近では、フィオナ・マクレオドと称したウイリアム・シャアプが、これを材料にして、何とか云う短篇を書いた。",
              "citation": {
                "source": "さまよえる猶太人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへピンカートンの友人の米国領事シャアプレスがやってきて、ピンカートンに、歓楽もよいがその結果が恐ろしいと苦労人らしく忠告しますが、結局、他日ピンカートンがアメリカ婦人と正式に結婚する日を祝して乾杯するのでした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ領事のシャアプレスが訪れてピンカートンから手紙がきたことを話します。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
