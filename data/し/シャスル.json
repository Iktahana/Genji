  {
    "uuid": "eac30f07-a4e0-5dcf-95f4-009cfcecb5a1",
    "entry": "射する",
    "reading": {
      "primary": "しゃする",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "existing",
