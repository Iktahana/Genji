        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シイタケ、ミツバ、トマト、サヤインゲン、南瓜、フキその他、ひよひよしてきれいな温室ものばっかり。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "』ジャロンカの小部落のスウシイタで、パアク氏はその長から、この地方は最近非常な凶作なので食料を調達し得ないと云われた。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "その原因は中平がリンゴ園で成功したに対し、久作はシイタケの栽培に失敗したあたりに発しているのかも知れない。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "中平のリンゴ園、久作のシイタケその他、及び三吉の保久呂霊薬である。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "リンゴ園と霊薬は成功したのにシイタケその他が失敗したので、久作は他の二名に遺恨をむすんだらしい。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はすでにシイタケその他のことに失敗したあとであった。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日から、かつてシイタケで失敗した山地の木立を手当り次第叩き切りはじめた。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹の中へシイタケ、ミツバ、ギンナンその他サザエのツボヤキのようにねじこんで炙ったもの。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、あの、根津｜権現のシイタケ飯。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、あのシイタケ飯について、少しく語らなければなるまい。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一高の俳句会　焼けた根津権現は、立派に再建されたそうだが、あのシイタケ飯を売る店が、今もあるかどうか知らない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "シイタケ飯屋の会へ来ても、半白の山羊ヒゲを右手でしごきながら、正宗の三オンス瓶を前において、仙人のような風格だった。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、互選も一段落となったところで、お待ちかねのシイタケ飯である。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "御飯にシイタケをたきこんで、うすく味をつけただけの、あんなものが、どうして、あれほど美味しかったのだろう。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "東北は岩手県の大部分では粃をシイタ、秋田県の男鹿半島などはシダといっている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
