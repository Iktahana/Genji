        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゲーテのファウスト、ダンテの神曲、シェークスピヤのハムレット、カアライルのサアター・レサアタス（Sartor Resartus）、ブラウニングのイースタアデー（Easter Day）とラビ・ベン・エズラ（Rabbi Ben Ezra）等はそれである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "◯十二節―二十一節は有名なる幽霊物語にして、文学的立場より見てシェークスピヤの悲劇マクベス中のそれと比肩すべき者といわれておる。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェーホフや、モーパッサンの短篇を好み、シェークスピヤの豊饒さに驚き、健康になったらこれはみんな読んでみたいと云っていた。",
              "citation": {
                "source": "忘れがたみ",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "シェークスピヤは人間に自由意志のないことをその戯曲で示した。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（斯くの如き對照式の綺語――技巧的な比喩語――を竝ぶることはシェークスピヤの青年期にはイギリス文壇の流行なりしなり。",
              "citation": {
                "source": "ロミオとヂュリエット",
                "author": "ROMEO AND JULIET",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれの優柔不断なところはハムレットそっくりだ」と途々ラエーフスキイは考えた、「シェークスピヤの観察はじつに正しい。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなじく相生座には、川上音二郎、貞奴一座が、シェークスピヤの西洋芝居で大入を取っていた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "分っても、分らなくっても、シェークスピヤは何となくえらく思われるのである。",
              "citation": {
                "source": "軽井沢にて",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "シェークスピヤやゲエテの傑作の中から学生の余興にふさはしい場面を択んで演ずるならまだしも、市井無頼の徒のいかがはしい風習行蔵を描いた唾棄すべき演劇の真似などは言語道断である。",
              "citation": {
                "source": "浜尾新先生",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
