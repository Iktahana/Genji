        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これに多数を意味する接尾音をつけた「シンヌ」はたくさんな山地でこれが「信濃」に似るなどちょっとおもしろいお慰みである。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "下総印旛郡の草原地には、あるいはまたドロボノシンヌギという名も行われている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
