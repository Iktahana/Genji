[
  {
    "uuid": "a4484126-7e6f-5d46-982e-51cdd43ed028",
    "entry": "しっかり者",
    "reading": {
      "primary": "しっかりもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
