    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "金粉の靄馬旅こころ今日うら安し子を抱きて絵馬の馬など眺めまはりつ　　信州別所北向観音坊やよ、あの絵馬を見い。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角、看護婦は凡べて州別名簿に登記してある。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "京師にて吉田の鈴鹿石州、同筑州別して知己の由、また山口三※も小林のために大いに周旋したれば、鈴鹿か山口かの手を以て海外までも吾同志の士通信をなすべし。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども此城は義貞に関係なく、新田の一族である岩松家純が文明元年に家臣横瀬国繁に命じて築かしめたもので、世良田長楽寺の豪僧松陰の私記に拠れば、太田道灌が武州別府へ出陣の節金山へ招待され、滞留両三日の中に只一度金山の四方を見物して、近頃名城の由褒美したとのことである。",
              "citation": {
                "source": "山と村",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高塔山と谷ひとつ隔てた山に、高野山九州別院「東南院」がある。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "京師にて吉田の鈴鹿石州・同筑州別して知己の由。",
              "citation": {
                "source": "留魂録",
                "author": "吉田松陰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
