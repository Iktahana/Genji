          "literary": [
            {
              "text": "当時の武士、喧嘩商買、人殺し業、城取り、国取り、小荷駄取り、即ち物取りを専門にしている武士というものも、然様然様チャンチャンバラばかり続いている訳では無いから、たまには休息して平穏に暮らしている日もある。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "留置場の中の全部は「城取り」でもするやうに、小さい、四角な高い處につけてある窓に向つて殺到した。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
