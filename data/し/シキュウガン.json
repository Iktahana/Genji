        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの女は肺結核の子宮癌で、俺は御覧の通りのヨロケさ」「だから此女に淫売をさせて、お前達が皆で食ってるって云うのか」「此女に淫売をさせはしないよ。",
              "citation": {
                "source": "淫賣婦",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "子宮癌とのことで、今日明日がむつかしかった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "子宮癌とのことだった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今謂ふ子宮癌であらうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角娘は懷姙し本年八月六日姙娠七ヶ月で子宮癌のために病院で死亡した。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "子宮癌、それはただ病気で、そのためだということは分っている。",
              "citation": {
                "source": "猫捨坂",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "容太郎が十五、六歳のとき母は子宮癌で苦しみ通して死んでしまった。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
