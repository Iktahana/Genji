        "examples": {
          "standard": [
            {
              "text": "本日の売上の締め高を確認したところ、目標を大きく上回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会計担当者は、帳簿の数字と現金の締め高が一致するか何度も数え直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予算の締め高が予定内に収まるよう、経費の削減を徹底する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "で、月末になると、鳥屋、牛肉屋、日本料理屋、西洋料理屋、鮨屋、鰻屋、菓子屋、果物屋と、方々から持って来る請求書の締め高が、よくもこんなに喰べられたものだと、驚くほど多額に上ったのです。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
