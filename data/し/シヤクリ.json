        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おやと思ふと斜かひに、兩方へ開いて、ギクリ、シヤクリ、ギクリ、シヤクリとしながら、後退りをするやうにして、あ、あ、と思ふうちに、スーと、あの縁の突あたりの、戸袋の隅へ消えるんです。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "變だと思ふと、また目の前へ手拭掛がふはりと出て……出ると、トントントンと踏んで、ギクリ、シヤクリ、とやつて、スー、何うにも氣味の惡さつたらないのです。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　突然みち子はシヤクリあげて、叫んだ。",
              "citation": {
                "source": "晩秋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は母の顔を見ると一層激しくシヤクリあげ、アノ………アノこんなもの買つちまつたの………弾けも何もしないものを………モウ黄金……黄金機会がなくなつちまつたア――と喚き立升と、母はオヤ、モウあの金貨をつかつてしまひ升たの？",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……シヤクリ上げながら駅の方へ行つた。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミル　（シヤクリ上げながら）うゝん。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
