[
  {
    "uuid": "e81cf0e8-a7bf-5975-9dfb-f3c42097e576",
    "entry": "しかしか",
    "reading": {
      "primary": "しかしか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしかかる無意識的創造も体験の客観化にほかならない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしかしかうした類の思想詩は、純正詩である抒情詩に比して、比較的註釋し易く、またそれだけ註釋の意義があるわけである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかくては人生は無意味となり、我は貴き生の消費者となり、人生の失敗者と堕するに至る。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかくのごとくして出来た科学の別天地はもともと便宜上から所知者を切り離して出来たものであるから、問題が能知者との関係にわたる場合には科学の範囲を脱して、科学ばかりではもう始末の付かぬ事は明らかである。",
              "citation": {
                "source": "文学の中の科学的要素",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかくのごとく収斂するためには逐次の各項の間に一定の条件が満足されなければならぬ。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかういふ心になるまでには、私を教へるために毎日、毎晩、見る者、聞くものについて、母様がどんなに苦労をなすつて、丁寧に親切に飽かないで、熱心に、懇に噛むで含めるやうになすつたかも知れはしない。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかまわずに、「たいへんなやつがあると自分で睨んだから、掘って来たんだって、どうして云ってやらなかったの。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかの女はずっとかの女の内心でいった。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかかる純粋と深刻さで執り行う祭を、修業としての心得を、翁は東国へ来て生い立った娘の神からして始めて聞いた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今、全然失敗して帰ッて来た、しかしかくまでに人々がわれに優しいこととは思わなかった。",
              "citation": {
                "source": "河霧",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "『そうですね、しかしかえってこんな色の方がごまかされて描きよいかもしれません、』と小山は笑いながら答えた。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかれと対座してその眼を見、その言葉をきくと、この例でもなお言い足りないで、さらに悲しい痛ましい命運の秘密が、その形骸のうちに潜んでいるように思われた。",
              "citation": {
                "source": "まぼろし",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは何にしようかと、今夜の相談は切実だが、しかしかえって力がない。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉛筆でザット下図をかいてみたがなかなか似そうもなかった、しかしかまわず絵の具を付けているうちにまもなくともかくも人の顔らしいものができた。",
              "citation": {
                "source": "自画像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしからだの病弱、気力の薄弱なためにその緊張の持続に堪え得ない時には知らず知らず緊張がゆるもうとする。",
              "citation": {
                "source": "笑い",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかなりまで完成に近づいていたには相違ない。",
              "citation": {
                "source": "蓄音機",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかりにそういう人が例外であるとしても、ともかくも毎朝新聞を読むのといいまとまった書物を読むのと比べてどちらが頭脳の足しになるかという事は、はじめから議論にならないような気がする。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その堂々たるノーウォエ、ウレーミヤがかういふ通信員のかういふ通信を平気で掲載する真意は僕も知らんが、しかしかういふ通信が保守臭味の露国人に一般に歓迎せらるゝのは事実である、需用の在る所供給之に従ふ。",
              "citation": {
                "source": "露都雑記",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかねて漠然と感じおそれてゐたものがいよいよ來たといふ豫感があつた。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかうして杉村や高山らとの接觸の面が深く廣くなるに從つて彼らから示される感情には堪へ切れぬものがあつた。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかつて彼が志村との話のなかに於ても云つたやうに、彼は何も自分の取つた道を一般に及ぼし得るものとも、及ぼさねばならぬものとも考へてはゐないし、今日の時代に於て特に意味ある行爲だといふやうな意識も彼自身のなかにはなかつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おかしかしかし樫の葉は白い。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "早う参れッ」　しかしかかって参れと促されても、三日月傷が邪魔になってそうたやすく行かれるわけがないのです。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかういつて自分を慰めながら菊次さんは歩いてゐました、「ところかはれば品かはる、だ。",
              "citation": {
                "source": "百姓の足、坊さんの足",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかしらは、それに答えないで、「わしはこの仔牛をあずけられたのだ。",
              "citation": {
                "source": "花のき村と盗人たち",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかういふ言ひ方は、阿部氏が作家でなければ通用する言ひ方である。",
              "citation": {
                "source": "小熊秀雄全集-20",
                "author": "大波小波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
