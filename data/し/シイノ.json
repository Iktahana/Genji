        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私ハナントナクコンナツマラヌモノヲあなたニ見テモラウノガハズカシイノデス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ僕ハ生キテイルノガ苦シイノダ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチニハ何十人トイウ人ガ、ゴジャゴジャ住ンデイテ、ヤカマシイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハ予テ世間ニ於テ人間ノ美ト醜トニヨル差別待遇ノ甚ダシイノニ大ナル軽蔑ヲ抱イテイタ」とヒルミ夫人はその論文に記している。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、当時、中部｜伊太利のフシイノ地方に、ラルゴ湖という湖水があったのですが、この湖を、時のトロニア氏が、大金を投げて埋めにかかりました。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、提灯ヘローソク入レマス、オ待チナサイ、ソウシテ、今夜ワタシ、アナタノ淋シイノヲ慰メルタメニ、一晩中、器量一パイウタイマス、ワタシ、知ッテル世界ノ国々ノ唄トイウ唄、ミンナ歌イマス、イチバンシマイニ日本ノ、歌イマス……夜ガ明ケテモカマイマセン」　マドロスは、すっかり興奮しきっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリクルシイノデ、ボンコチヤンハオイシヤサマノイツタヤウニ、ビヨウキガナホルノナラ、モンコチヤンノオ家ヘカヘリタイトイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「野村サン、帰リモデモハ大丈夫カシラ」「エヽ、大丈夫ダト思イマス」運転手ノ説ニ依ルト、今日ハ全学連ノ反主流派ノデモダソウデ、二時カラ日比谷ニ集リ、主トシテ国会警視庁辺ヲ襲ウラシイノデ、ソレニ打ツカラナイヨウニスレバイヽト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木氏曰ク、非常ニ忙シイノデ拙宅ヘオ越シ下サルコトヲ望ムガ、往診ノ場合ハ週ニ三回ニシテ戴キタイ、拝見シナケレバ分ラナイガ、オ話ノ様子デハ多分治癒出来ルト思ウ、二三カ月ハカヽルデショウト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュッ、シュッ、ト、トテモ美シイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――冗談ミタイニ云ッテタケド、案外本気ラシカッタワ」「誰デモ女房ニソウ云ワレルト、ソンナ負惜ミヲ云ウモノサ」「彼ニモ誰カ好キナ人ガアルラシイノヨ、アタシト同ジヨウナ過去ヲ持ッタ、何処カノキャバレノ人ラシイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫眼石カ」「エヽソウ、ソレモ小サイノジャ駄目、男ガ篏メルヨウナ大キイノガ欲シイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガオカシイノハ、母ダケガ若キ日ノ姿ヲシテイテ、予ハ現在ノ老人ノマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何デモ結婚後半年バカリ過ギテカラ、「ボルゾイヲ飼ッテ見タイ」ト浄吉ガ云イ出シテ間モナク素晴ラシイノヲ一匹見付ケテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事ノ世話、入浴ノ世話、ブラッシングノ世話ナド手ガカヽルコト夥シイノデ、婆サンカラ女中達マデ不平ガ絶エナカッタガ、何ト云ッテモ浄吉ガ実行サセタコトハ当時ノ日記ニ記シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "短時間内ニ血壓ノ変動ガカヨウニ激シイノハヨロシクナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妻ハソレヲ口ニ出シタ※ハナイガ、ジェームス・スチュアートノ映画ダト缺カサズ見ニ行クラシイノデアル）モットモ妻ガ木村ニ接近スルノハ、僕ガ彼ヲ敏子ニ妻ワセテハドウカトイウ考エガアッテ、家庭ニ出入リサセルヨウニシ、妻ニソレトナク二人ノ様子ヲ見ルヨウニト命ジタカラナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ウニ彼女ハ、世間ノ多クノ父親ト違イ、僕ガ彼女ヨリモ彼女ノ母ヲ熱狂的ニ愛シテイルラシイノニ憤懣ヲ感ジテイルノデハナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………　眩暈ガアマリ激シイノデ、ヤハリ気ニナッテ、児玉氏ノ所ニ行ッテ血壓ノ検査ヲシテ貰ウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻カラ考エテ、妻ハ帰宅ノ途中デアッタラシイノデアルガ、西向キニ歩イテイルノハ、恐ラク僕ヨリ先ニ僕ヲ見付ケテ自分ノ方カラ避ケタノニ違イナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウレシスギテ、カナシイノヨ。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
