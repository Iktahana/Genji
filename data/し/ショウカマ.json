        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その悲しみを打ちあける一人の友達もパン焼釜のある地下室にはいなかった。",
              "citation": {
                "source": "逝けるマクシム・ゴーリキイ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し一日の大部分パン焼釜にしばりつけられているゴーリキイには、その意味が十分わからない。",
              "citation": {
                "source": "逝けるマクシム・ゴーリキイ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八九歳でパン焼釜の前に縛りつけられていた時分、彼は仲間に淫売窟へ誘われた。",
              "citation": {
                "source": "マクシム・ゴーリキイによって描かれた婦人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "處々に掘立小屋あり、炭燒釜あり。",
              "citation": {
                "source": "赤城山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
