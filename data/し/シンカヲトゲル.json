        "examples": {
          "standard": [
            {
              "text": "このソフトウェアは、ユーザーのフィードバックを元に常に進化を遂げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の絵画は、年を追うごとに独自のスタイルへと進化を遂げていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私たちのチームは、困難な課題を乗り越えて大きく進化を遂げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私はあなたが一段の進化を遂げるために死の運命に出遇ったことを祝賀します。",
