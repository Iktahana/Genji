        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シテエ・フワルギエエルの十四番地へ来ると徳永は最う起きて居た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから自分等はシテエ・フワルギエエルの滿谷氏の画室｜近くまで、また地下電車に乗つて行つたが、滿谷氏等はもう祭見物に出掛けた跡であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから自分等はシテエ・フワルギエエルの滿谷氏の畫室近くまで、また地下電車に乘つて行つたが、滿谷氏等はもう祭見物に出掛けた跡であつた。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は汝に妙齡の天女のひとり與ふべし、＊汝のつねにあこがれしパーシテエーを與ふべし、彼は汝と婚すべく汝の妻と呼ばるべし。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "しか陳ずれば喜べる睡の靈は答へ曰ふ、　270『然らば盟へ、＊スチクスの犯すべからぬ水により、片手をもつて豐沃の大地に、他の手を以て耀き光る海に觸れ、盟へ、然らばクロノスと共に深きにある諸神、われの間の證たらむ君今われに妙齡の天女のひとり與ふべし、　275わが身のつねに憧れしパーシテエーを賜ぶべしと。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "直グ運搬車ガ動キ出シテエレベーターデ地下道ニ下リ、長イ暗イ路ヲガラ／＼ト走リ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
