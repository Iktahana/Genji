          "literary": [
            {
              "text": "シカシ、イクラ　シカラレテモ、ヒトツノ　タケノコハ　ドンドン　トホクヘ　モグツテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　イツモハ　シロヤ　ブチガ　チヨツト　アガツテモ　タイヘンニ　シカラレル　ソノタタミカラ、クモノヤウナ　ホコリガ、イツパイニ　マヒアガツテヰマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマノ　トムト　　イヌノ　ジヨンハアマリヨロコンデ、トンダリハネタリシテ、タローサンニ　　シカラレマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクンガアンマリサワグノデ、マタタロー　　サンニシカラレマシタ、ガマタ　スグウレシクテタマラナイノデサワギダシマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
