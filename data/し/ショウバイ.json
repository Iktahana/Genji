[
  {
    "uuid": "c8456e70-a15d-5557-b66c-ae2618d9b95e",
    "entry": "商売",
    "reading": {
      "primary": "しょうばい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
