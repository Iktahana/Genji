[
  {
    "uuid": "fd2cd5e6-d848-5cc9-8875-d3b6b1ffdfff",
    "entry": "神格",
    "reading": {
      "primary": "しんかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
