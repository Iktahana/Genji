[
  {
    "uuid": "5e098831-8596-5f97-b317-66e10d71b57c",
    "entry": "収取",
    "reading": {
      "primary": "しゅうしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
