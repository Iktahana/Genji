          "literary": [
            {
              "text": "蓋シ東山ノ春ニ宜シキヤ探花傍柳ノ樂有リ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋ニ宜シキヤ觀楓採蕈ノ遊有リ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "垂水之水能早敷八師（巻十二・三〇二五）で、ハヤシのハとハシキヤシのハに続けたたぐいである。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コシ　鹿兒島附近では黴も麹も共にコシと謂ひ、又色々の皮膚の病にもコシ・コセカキ・コシキヤマヒといふ語がある。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コシ　鹿児島附近では黴も麹もともにコシといい、またいろいろの皮膚の病にもコシ・コセカキ・コシキヤマイという語がある。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハシキヨシ、ハシキヤシともいう。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この神がシキヤマヌシの神の女のアヲヌマヌオシ姫と結婚して生んだ子は、ヌノオシトミトリナルミの神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
