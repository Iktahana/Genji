        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポタアジュと、ティンボール・アラスカ、コムビネーションサラダと、マロン・シャンティリーのアイスクリーム、それからアイスティーを飲み、程よき満腹で帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロンシャンティリーのアイスクリーム、此処は菓子物はダメだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロンシャンティリーアイスクリームを飲む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "マロンシャンティリークリーム。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "デミタッセ（これは不味）に、マロン・シャンティリー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
