  {
    "uuid": "a915c3cb-cf10-5c6c-8b47-0e1cb37ddf9c",
    "entry": "シタモノ",
    "reading": {
      "primary": "したもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コレハ少シ手習イシタモノナラダレデモ感ジルコトダ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ活字ハ、ソノ美シクナイヒラガナヲソノママ活字ニ移シタモノデ、活字ニ必要ナ様式化サエ行ワレテイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "）三、ヒラガナトイウモノハソノ素性ヲ探ルト、イズレモ漢字ヲ極端ニ崩シタモノニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私ハ夜中ニ何ダカ咽喉ニ冷リトシタモノヲ感ジマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "作中、Ｔ市長ダノ銀座ダノトイウ名詞ガ出テクルガ、コレハ決シテ何処カノ帝都ニアッタ実話ナドヲもでるニシタモノデハゴザイマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "次ぎに「チクマアニノワタシタモノ……モシツカヘバ」……と、そこでしばらく考へてから、やつと「タイヘンナコトニナル」……。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは駆使の役に任ずる低級の使用人を、ハシタまたはハシタモノと称することから察せられるのである。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハシタモノの事は項を改めて次に述べる。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　間人とハシタモノ　武家時代に賤しい身分の召使女をハシタモノまたは単にハシタと呼んだ場合が多い。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "などあるハシタモノ、ハシタワラワ、半物などは、いずれも女子の事の例ばかりなのである。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてハシタまたはハシタモノという名称は何を意味するのであろう。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "けだしハシタモノすなわち下司女は下品であるということから、かくいろいろにその語が用いられる様になったのであろう。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　間人とチュウゲン　下司女をハシタ・ハシタモノと呼ぶに対して、下司男をチュウゲンと呼んだ例も古い。",
              "citation": {
                "source": "間人考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシタモノカト迷ッテイルウチニ歳ヲ取リ過ギテ、モウ現在デハ手術モ手後レニナッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ヲ云ウト予ハ、彼等ノ結婚ヲ許シハシタモノヽ、ドウセ長クハ続クマイト思ッテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷風散人ノ七絶ノ色紙ヲ表装シタモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思エバ予ハ随分長イ月日ヲ生キタモノヨ、数限リモナイ移リ変リヲ経験シタモノヨト、自ラ驚カザルヲ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡イコバルトニ少シ銀糸ヲアシラッタ地色ニ、黄ガカッタ糸ト金糸デ乾山風ノ陶畫ヲ織リ出シタモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デナケレバ綴喜郡宇治田原村禅定寺ノ五輪塔、コレハ吉野時代ノ典型的ナ遺品ダソウデ、コノ式ハ南方ノ大和文化圏ニ流行シタモノダソウダガ、コレモ悪クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平安朝ヤ鎌倉期ノ五輪塔ニ関スル知識、今宮神社ノ四面佛ノ如来像ヤ菩薩像ノ線彫リニ関スル知識、両膝ヲ揃エテ坐ッテイル蜻蛉石線彫勢至菩薩ニ関スル知識、等々デ彼ヤ彼女等ヲ驚カシハシタモノヽ、颯子菩薩ノ計畫ハ心ノ奥深クシマイ込ンデ、誰ニモ洩ラサナイヨウニシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ写真機ハ写シタモノガ即座ニ現像サレテ出テ来ル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
