[
  {
    "uuid": "93e2e667-c241-527d-9659-b0bebb4f5ed0",
    "entry": "下物",
    "reading": {
      "primary": "したもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
