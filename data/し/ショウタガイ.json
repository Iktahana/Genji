          "literary": [
            {
              "text": "アイナイアース、メネラオス二將互に相面し、戰望み鋭刄の槍をおのおの振りかざす、アーンチロコス進み來て王にまちかく並び立つ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "兩將互に相迫り近よる時にメネラオス、アートレ，デース誤りて其槍敵をはづれたり、。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘴曲り爪猛き二羽の荒鷲憤然と、高き岩のへ物凄く叫び戰ふ樣見せて、喊聲高く敵身方二將互にわたりあふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
