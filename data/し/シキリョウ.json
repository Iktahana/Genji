  {
    "uuid": "1740b985-e994-5704-a7a5-e624d2ffefb0",
    "entry": "識量",
    "reading": {
      "primary": "しきりょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "古物ヲ賞鑑スルニ於テ、内外ノ区別ヲ立ツルハ笑フ可キコトニテ、其ノ識量ノ狭隘ナルヲ奈何セン。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に質を存せんと欲する者は先づ須らく理径明透して識量宏遠なるべし。",
              "citation": {
                "source": "文芸鑑賞講座",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、不幸なわが十九世紀に生まれ合わせて、しかもその上に、地球上で最も抽象的な作為的都市であるペテルブルグに住むなどという、とんでもない不幸を持ちあわせた、教養の高い人間に与えられた意識量の、半分どころか、四分の一もあったらたくさんなのだ（実際、街にも作為的なのと、そうでないのとがある）。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れ又曾て人に語りて曰く、大隈伯は其品性識量共に立派なる政治家なり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗟乎公薨ずるの日、享年僅に四十有二、識量漸く長じ、威望次第に高きを加へむとするの時に方り、空しく雄志を齎らして永久の眠に就く。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、あなたは全てを知っているわけじゃない」「知識量の問題じゃない。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
