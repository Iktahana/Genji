          "literary": [
            {
              "text": "モシソウナラバソレハ誤リデ、僕ハ彼女ラヲ同等ニ愛シテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コレハ相馬氏ニハ内証デ、自分デ施シテイルノデアル）シカシ自分ガ珍シクモカヨウニ旺盛ナ状態ヲ維持シ得テイルノハ、恐ラク薬剤ノ利キメヨリモ主トシテ精神的興奮ノシカラシメルトコロデアルニ違イナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服ヲ着タヲシテイルノデアルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
