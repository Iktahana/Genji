          "literary": [
            {
              "text": "アタシモシャワーヲ浴ビマスカラ」ト、自分ダケ浴室ヘ引ッ返シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ近頃家ニイレバ大体イツモコノ時刻ニシャワーヲ浴ビルコトヲ予ハ知ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーヲ浴ビツヽアル彼女ノ全身ハ白地ニ粗イグリーンノ縦縞ノバス・カーテンデ囲ワレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ爺チャンニハソレガ相当ヨ」「セメテコウシテル間、シャワーヲ止メテ貰エナイカナ」「止メル訳ニ行カナイ、触ラレタ傍カラ直グト綺麗ニ流シチャワナイト気味ガ悪イ」予ハタヾ水ヲ呑マサレタ気ガシタヾケダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ガシャワーヲ浴ビニ来サセテクレト云ウノハ、タヾソレダケノコトデナク、何カ魂胆ガアルノデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "服ガ籠ニ捨テヽアル以上、彼ハシャワーヲ浴ビテカラ浴衣ニ着カエテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ガ先ニシャワーヲ浴ビタト見エテ、ビニールノ帽子カラ水ガタラ／＼滴レテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リシャワーヲ止メテ上ゲタジャナイノ」「何カノ報酬ノ積リカネ、ソレニシチャ安スギルナ」「イヤナラオ止シナサイ、無理ニトハ申シマセン」ソシテ附ケ加エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ彼女ガサンダルヒールヲ穿イテ這入ッテ来、ソノマヽシャワーヲ浴ビテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
