          "literary": [
            {
              "text": "早朝、門ニ立チテオ待チ申シテイマス。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクタチ兄ダイハ、ナカヨク、タッシャニ、コノシマニ、クラシテイマス。",
              "citation": {
                "source": "瓶詰地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシハ、アクネンユエ、タダジットシテイマス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンノ、タヨリアリマスカ、ナニゴトモ、トキノクルマデ、ノンキニシテイナサイ、ワタシモ、コトシワ、アクネンユエ、ジツトシテイマス。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "再ビ生キテ皆サマニオ目ニカカレナイコトト覚悟ヲシテイマス。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士ガ君ハ今何シテイルカト問ウノデ、コレ／＼云ウオ邸デ御病人ノ看護ヲシテイマスト答エタラ、ソンナコトカラ旦那様ノ手ノオ痛ミノコトガ話ニ出タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御注文ノ広東犬ハコノ間カラ捜シテイマスガナカナカ見ツカラナイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハツクヅク、斯波君モ我ガ儘ダガアナタモ我ガ儘ダ、今日ノ事ハ二人ノ我ガ儘ガ当然招イタ報イダト云ウ感ヲ深クシテイマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ココノベウインニニユウインシテイマス……ただそれくらいのほんの切り詰めた用件を知らせるだけが、精一杯です。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
