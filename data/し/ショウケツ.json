        "examples": {
          "standard": [
            {
              "text": "金属粉末を型に入れて加熱し、焼結させることで複雑な形状の部品を作る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "このセラミックスは高温での焼結プロセスを経て、驚異的な硬度を得る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "焼結の温度管理を誤ると、製品にひび割れが生じる原因となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その他風にあたれば病気のしょうけつを来します。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
