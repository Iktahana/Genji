[
  {
    "uuid": "35e75e3f-fc83-5df1-bdbc-c99a2326c39d",
    "entry": "止水",
    "reading": {
      "primary": "しすい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
