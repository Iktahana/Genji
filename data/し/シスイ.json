  {
    "uuid": "93733324-8cbf-5714-8986-b17248dfa7df",
    "entry": "市水",
    "reading": {
      "primary": "しすい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大戦の前から住んでいたのだが、ことしの春に爆弾でこわされたので、甲府市水門町の妻の実家へ移転した。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思春期の「自分を知りたい」と言う思いが、富山市水橋町のルーツへの興味に繋がった。",
              "citation": {
                "source": "短く語る『本の未来』",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "千百万円の予算が組まれていた広島市水道局の地図情報システムの基本設計を、富士通が一円で落札したという例のあれですよあれ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "健康恢復と同時に、自らの働きをもって生活するの必要に迫られ、中央局通信事務員、河口鉄工場職工、東京地方裁判｜所雇、その他二三を転々として、東京市水道拡張課の土木監督となり、震災と同時に失職。",
              "citation": {
                "source": "簡略自伝",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウィン市水道の大渠橋がローマ水道の如く慎ましき町を横切って居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シエーナ市水に乏しければ市民費を惜しまずしてこの水を得んとせりといふ一五四註釋者曰。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治四十四年に刊行された「東京市水道小誌」を見ると、明治四十年に岩崎久弥の千川水道会社の所有になった千川上水の旧伏樋だけは掘り起された事実が見えるが、他の大伏樋の迷路は、蜿蜒十数里にわたって今もなお大東京の地下を蜘蛛の巣のように這っているのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
