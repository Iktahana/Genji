    "definitions": [
      {
        "index": 1,
        "gloss": "short flute piece (in kyogen; usu. a lively solo)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "狂言の舞台でしゃぎりの笛が高く鳴り響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このしゃぎりは古い流派の曲である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "師匠からしゃぎりの吹き方を習っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その、しいんとした、静かな部屋に、珍しく襟に顎を差し込んで、うなだれ勝ちな、殊勝なすがたをしているお初、やがて、小屋の方で大喜利の鳴物、しゃぎりの響きが妙な淋しいようなにぎわしさで聴えると、唆られたように顔を上げた。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "笛太鼓のしゃぎりはもちろん、合方の唄三味線など鳴物は一切禁止、俳優の台詞や仕草も劇的誇張はすべて避ける。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "大胴を入れる音と、笛を合せるのと、シャギリの音までも手に取るように響いて来たものであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "如法闇夜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人崩れが狭い出口の方へと押合う間に幕がすっかり引かれて、シャギリの太鼓が何処か分らぬ舞台の奥から鳴り出す。",
              "citation": {
                "source": "すみだ川",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "容赦なく片シャギリの囃子が鳴らされ、歌六という背の高い音曲師がヌーッと上がっていった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "師匠が下り、中入りが過ぎると、にわかに浮き立つようなシャギリの囃子が聞こえてきた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "flute and drum music played after each act but the last (in kabuki)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "歌舞伎公演でしゃぎりが演奏された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "幕が下りるときしゃぎりが聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "しゃぎりの音で次の場面へ移った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
