[
  {
    "uuid": "8cc3ed10-468f-53e0-ac26-11bfe46710e7",
    "entry": "社参",
    "reading": {
      "primary": "しゃさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
