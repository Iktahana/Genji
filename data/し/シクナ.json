        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一度工場外ニ足ヲフミ出シテ見レバ分ル通リ、当工場ハマサニ「Ｙノフォード」タル名ニ恥シクナイ充分ノ待遇ヲ、ソノ時間ノ点カラ云ッテモ、ソノ賃銀ノ上カラ云ッテモ、皆サンニ与エテ居ルノデアリマスカラ、コノ際決シテ、カヽル宣伝ニ附和雷同セザル様、呉々モ申述ベテ置ク次第デアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、ヒラガナノ活字ハソレ自身ガ美シクナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在ノ活字ハ、ソノ美シクナイヒラガナヲソノママ活字ニ移シタモノデ、活字ニ必要ナ様式化サエ行ワレテイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニカイ　アガリマショウ、ワタシ　アヤシクナイ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "古風ナ人情トモ云ヘルガ、嬉シクナイコトモナイ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "オユデ、ウダツタノデ、ジヤガイモサンハイロガマツシロニナツテ、イゼンヨリモ、ウツクシクナリマシタノデ、ミンナオホヨロコビ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツキヨリ、マダヤカマシクナツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサルサンハ　タイソウハヅカシクナッテ、アカイカホヲ　モットアカクシマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン、チツトモオカシクナイカラボンコヲカブリナサイ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トアタリガキウニサワガシクナツタノデ、オ母サンハ目ヲサマシマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハ、オカシクナツテ「アラ、マア、何テヘンナオ子サンダラウ、マルデ、カツパノオバケミタイダワ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷をデイ、寝室をチョーダイなどと云ったし、病気を「悲シイ」、病気ニナルが「悲シクナル」、尊トシヤ、だとか、大いに驚く時に「あな、うたてやな」と今も言うそうだね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャ　チム　ター　ンガ　ツァム　シクナ　ミー　チム　ニャ　シン　ツァム　シク　ゴで、その意味は「鳥の法律が馬の尾〔先〕程破らるならば人の法律は大木程もやぶらるべし」ということなので、その位鳥の法律は厳いものであると言っていろいろそういう例話を引いた話を聞きました事でございました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨッテ自分ハマルクス主義ノ正シクナイ事ヲ完全ニ理論的ニ証明セントシテ研究ヲ始メタガ、ソノ結果ハ却ッテ同主義ハアクマデ正当デアリ、且ツ無産階級解放ノ唯一ノ途デアル事ヲ認メルニ至ッタ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ蔭デ左手ノ神経痛ガ一層痛ミ、皮膚感覚ノ麻痺モ激シクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ滝川ドウフノ他ニ晒シ鯨ノ白味噌和エガ欲シクナッテ追加スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女ラシクナイ食ベ方デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分古ク、二十台グライカラダガ、近頃殊ニ甚シクナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ家ニ来テカラ既ニ十年近クナルノニ、歳月ヲ経ルホドマス／＼美シクナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五尺ニ足ラヌ女モ珍シクナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻、六時頃カラ手ノ冷エ方ガ一層激シクナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "短時間内ニ血壓ノ変動ガカヨウニ激シイノハヨロシクナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御免ナサイネ」声ノ調子ニイツモノ彼女ラシクナイ、ワザトラシイトコロガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ児玉氏ナラ差支エナイト思ッタケレドモ、ソレデモ妻ノコウイウ醜態ヲ見セルノハ好マシクナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「暴ナラズバ僧ラシクナイ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
