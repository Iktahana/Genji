        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして一等お終いに、司令官が言うぜ、『今日縄の下を、縄につかえずに通った者は、大きな体格の良い女房をもらえ』ってね」「ニキミ、シバラ」（馬鹿野郎）　と、林田は朝鮮語で言い返すのだった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "シバラク待ツガヨイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヒ、ヤマキチ　ノ　トモダチデ、イチワ　ノ　オオキナ　タカ　ガ、ヤマキチ　ヲ　ヒロイ　ツバサ　ニ　ノセ、ヒコウキ　ノ　ヨウニ　ソラ　ヲ　トンデ、シバラク　タカイ　キ　ノ　ウエデ、ヤスミマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカ　ハ、ヤマキチ　ヲ　ソコ　ヘ　オロシ、シバラク　ソラ　ヲ　トンデカラ、マタ　ヨウス　ヲ　ミニクル　ヤクソク　ヲ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シバラク　スルト、ウシロノ　カゴカキガ、「シーツ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マヘノ　ハウガ、「モウ　シバラク　マテ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シバラク　スルト　タニ川ノ　オトガ　ドドドドト　キコエテ　キマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、シバラクダマッタママ、少シズツ大キクユスッテイタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴局ノ送信ヲシバラク中止セヨ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ茶ノ間デ妻ヤ敏子トシバラク話シテイタガ、三時過ギニ「麗しのサブリナ」ヲ見ニ行クト云ッテ、三人デ出カケタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ来テ、四人デ食卓ヲ囲ンデイル最中ニ彼女ガドコカヘ立ッテ行ッテ、シバラク戻ッテ来ナイノデ、「ドウナスッタノデショウ」ト木村ガ云イ出シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者ヲ呼ボウカドウシヨウカトシバラク三人デ相談シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテシバラク眼ヲモッテソノ姿態ヲ貪リ食イ、タダ歎息シテイルバカリデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車通リニシバラク立ッテイタケレド、何シロ時刻ガ時刻ダカラ一台モ通ラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから前菜はいうまでもないが、なんでも、美味い料理をどしどし持ってこい」　卓の賑わう間を、お互いに頬杖などして、四壁を見ると、金箔板の聯（柱懸け）に朱を沈めた文字で、風ハ滞ル柳陰太平ノ酒旗酒ハホドク佳人ノムネノ縺レ杏花アマクシテ志イマダシシバラク高歌シテ酔郷ニ入ラム　などとある対句が読まれる。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シバラクシタラアナタハ一切ヲ思イ出サレルデショウ」「どういうことなんだ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トシバラシ（人殺し）も俺をこんなふうに狼狽させはしなかったのだ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
