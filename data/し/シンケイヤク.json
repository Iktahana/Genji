          "literary": [
            {
              "text": "一、大鹿はラッキーストライクと新契約し、三百万円受取ったらしいが、その三百万円は紛失している。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りに阿部の家に寄り、市役所からの新契約書を阿部に見せると、阿部はいかにも我意を得たりというように腹をゆすって哄笑した。",
              "citation": {
                "source": "糞尿譚",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "日劇へ一寸寄り、夢声の漫談をきいて、社長室で新契約のこと、給料値上げのことを話す。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
