        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "太陽がビルの向こうに隠れて、シャドーが街全体を覆った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "シャドーボックスの中に思い出の品を飾っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "顔にシャドーが落ちて、表情が見えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それともエリオット氏が情熱的にシャドーボキシングをしたら。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイ・シャドーのせいかもしれないが、たしかに青い炎のような、ツンと俺の眼を刺す光を俺は見た。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "日没の時間、たとえばいまのように、メイン・ストリートの端に立って町の中心のほうを見ると、海に面した建物はくすんだ黄金色に染まり、海を背にした家なみは淡いシャドーのなかだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀座式のハイカラさが大阪では受けるのだと思ったのは、まだいい方で、たいていは外国映画のメーキャップを模倣し、エキゾチシズムとはアイシャドウを濃くして、つけ睫毛を太くすることだと考えたので、グロテスクな効果だけ残って、失敗した。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪の形、頬紅やアイシャドウの使ひ方なども教はつて、何うにか女給タイプにはなつて来たのだつたが、どこか此処の雰囲気に折り合ひかねるところもあつた。",
              "citation": {
                "source": "のらもの",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い化粧部屋で、ドオランを塗ったりアイシャドウをつけたりしているマネキン達の後から、宿屋の女中達が珍しそうに覗きに来た。",
              "citation": {
                "source": "帯広まで",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真ッ昼間だというのに、黄色のドーラン化粧に、青のアイシャドウ、おまけに垂れ滴るような原色の脣をもった、まるでペンキを塗った腸詰のようなその黴毒女を、春日が、例え噂にもしろ「ネネ」と呼んだ、ということについては、激しい不満を感ぜずにはいられなかった。",
              "citation": {
                "source": "腐った蜉蝣",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬をつれてアイ・シャドウと口紅の濃い女。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャドウ・ブルック　　　　　　　　――「何でも金になる話」の前に――　お昼に、子供達の一行は、或る谿間に集まった。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユースタス・ブライトとその小さな仲間達とは、このシャドウ川の谿で昼食をした。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　　　　　シャドウ・ブルック　　　　　　　――話のあとで――『どう？",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい一二週間前、十二月になってからのことだが、子供達はシャドウの谷川が谿間から流れ出るあたりの岸辺に、たんぽぽが一つ咲いているのを見つけたりした。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "『しかしあなたを慰めるために、あたし達、あなたが玄関や、シャドウの谷川の窪地でして下さったような、昔のお話をまた聞かしていただきましょう。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからシャドウの谷川の縁へ出た。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の娘という娘がみんなパーマネントをかけて頬紅口紅、アイシャドウ、毒々しいまでにメイキアップをして、中には着物を洋装に着代え靴まではきかえて出てくるのがある。",
              "citation": {
                "source": "淪落の青春",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪ヲパーマネントニシ、耳ニイヤリングヲ下ゲ、唇ヲコーラル・ピンクダノパール・ピンクダノコーヒー・ブラウンダノニ塗リ、眉ニ黛、瞼ニアイ・シャドウヲ着ケ、フォールス・アイラッシュデ附ケ睫ヲ着ケ、ソレデモ足リナイデマスカラーデ睫ヲ長ク見セヨウトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝間ハダーク・ブラウンノ鉛筆デ、夜ハ墨ニアイ・シャドウヲ交ゼテ眼張リヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャドウェル救護院からきたんだろ？",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　とアイダが訊くと、「イーストエンドのシャドウェルへ行った。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
