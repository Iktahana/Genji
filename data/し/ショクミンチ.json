        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ブラジルには、多くの日本人植民地が形成され、日系社会が発展しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "当時の政府は、海外への植民地開拓を奨励していました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの地域は、初期の日本人植民地として有名なんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
