    "entry": "塩っぱい",
    "reading": {
      "primary": "しょっぱい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null,
