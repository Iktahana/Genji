        "examples": {
          "standard": [
            {
              "text": "出かける前に、丁寧にシェービングをして身だしなみを整える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "肌の弱い人は、シェービングの際に肌を傷つけないよう注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は毎日のシェービングを欠かさず、常に清潔感を保っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "（西遊記、アレビヤン・ナイト、もしくはシェーヴィング・オブ・シャグパットのようなものの面白味は別問題として論じなければなりません）して見ると私が前段に申した意味が自から御明暸になりましたろう。",
              "citation": {
                "source": "創作家の態度",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が物新しそうにシェーヴィング・ブラッシを振り廻して、石鹸の泡で顔中を真白にしていると、先刻から傍に坐ってこの様子を見ていたお重は、ワッと云う悲劇的な声をふり上げて泣き出した。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
