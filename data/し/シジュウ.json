    "definitions": [
      {
        "index": 1,
        "gloss": "continuously",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は会議の間中、始終厳しい表情を崩さず、周囲には緊張感が漂っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "遠足を楽しみにしていた子供たちは、バスの中でも始終はしゃぎ通しだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "そのプロジェクトの経緯を始終見守ってきた立場として、成功は感無量だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "これは校長が若い時分から、自分の生来根太い狡猾な性質に困り果てながら、聖賢の書を漁つた時に、始終心で云つてたことが、今生徒を前にした今、形を取つて表れて来たのである。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、自分の家ではあまりかからなかったが、親類で始終頼んでいた横山先生という面白い医者があった。",
              "citation": {
                "source": "追憶の医師達",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだかしなくてはならない要件を打ち捨ててでもあるような心持ちが始終につきまとっている。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終『アララギ』を送って頂いておりながらほんの時々しか読んでいないので甚だすまない気がしております。",
              "citation": {
                "source": "書簡（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻と下女とで静かに暮していた処へ急に二人も増したのみならず、姪はいたずら盛りの年頃ではあり、家内は始終ゴタゴタするばかりでほとんど何事も手につかぬような有様であった。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は氷袋を気にして時々さわってみるが、始終無言である。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の少佐の胸のボタンが一つはとれて一つはとれかゝつて居るのが始終私の氣にかゝつた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとく卵が出来上がるまでには管の内側から始終に圧迫を受けている。",
              "citation": {
                "source": "卵の形",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしこんな風でなく始終強さの変らぬ規則正しい波を作る事が出来れば種々の便がある。",
              "citation": {
                "source": "無線電信の近状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから色の不完全な灯光を始終使っていると遂には一種の色盲になる恐れがあると心配している人もある。",
              "citation": {
                "source": "ランプのいろいろ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さす手ひく手の妙、面白の振りの中に錆びた禅味がたゆとうとて珍重されたのは、鯉魚庵の有力な檀越となって始終、道味聴聞の結果でありました。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角の学問の才を切れ端にして使い散らさないように――」　と始終忠告していた父が、その実意からしても死ぬ少し前、主人を養子に引取って永年苦心の蒐集品と、助手の私を主人に譲ったのは道理である。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "好古家の学者に有り勝ちなこの癖を始終私は父に見ているのであまり怪しまなかったけれども、二人で始めての旅で、殊にこういう場所で待たされつつあるときの相手の態度としては、寂しいものがあった。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士は丁寧に礼をして、自分がこの土地の鉄道関係の会社に勤めて技師をしているということから、昨晩、倶楽部へ行ってふと、亡父が死前に始終その名を口にしていたその人が先頃からこの地へ来てＮホテルに泊っていることを聴いたので、早速訪ねて来た顛末を簡潔に述べた。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終習慣的に考えているのは「何か面白いものは無いか知らん。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さぎといふものは、みんな天の川の砂が凝って、ぼおっとできるもんですからね、そして始終川へ帰りますからね、川原で待ってゐて、鷺がみんな、脚をかういふ風にして下りてくるとこを、そいつが地べたへつくかつかないうちに、ぴたっと押へちまふんです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "留学中など始終これで苦しみ通していた。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩年には始終神経衰弱の気味があったが、これはおそらく極度の勤勉の結果であろうと想像された。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "顎の張った人は意志が強いというから、始終チューインガムを噛んで顎骨でも発育したらあるいは意志が強くなるというのかもしれない。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人はアメリカでは始終排斥され侮辱されていても、それとは無関係に寛大な日本人はアメリカ文化にあくがれるのである。",
              "citation": {
                "source": "チューインガム",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この地方の人は始終毒を携帯して歩いている。",
              "citation": {
                "source": "マルコポロから",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また風があると地面の冷えようとするのを始終空気が撫でて行くから空気よりも著しく冷える間がない。",
              "citation": {
                "source": "歳時記新註",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この力を原動力に利用して各種の作業をすれば利益があるだろうという事はよく人の考える事だが、ただ一つ困る事は、風は至って気まぐれ者で、思う時に思うように吹いてくれぬので、始終きまった馬力を要する器械にはちょっと使いにくい。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十月八日『東京朝日新聞』）　　　　　　　　　十五　　　　　　奇妙な病気　始終Ｘ光線を使っている人は往々不思議な恐ろしい病気に罹るそうである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの舞うのは何故かと調べてみると、内耳の一部をなしている三半規管の構造が不完全なため、始終に眩惑を起すからだという事である。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "見送る三次がお絹に、Ｔ「そーれ見なせえお絹さん」　と言って、Ｔ「俺と一緒に居るとお前迄があの通りやくざ者にされちまう」　と言うのを、　始終無言で聞いていたお絹が、　袂で隠して居た十手を三次に示す。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵は相変らずの微笑で始終の様子を見て居ります。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "：入力者注　主に外字の説明や、傍点の位置の指定（例）がらくた-------------------------------------------------------　えたいの知れない不吉な塊が私の心を始終壓へつけてゐた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで始終私は街から街を浮浪し續けてゐた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終私の心を壓へつけてゐた不吉な塊がそれを握つた瞬間からいくらか弛んで來たと見えて、私は街の上で非常に幸福であつた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
