        "examples": {
          "standard": [
            {
              "text": "半導体の設計工程において、シンセシスは回路の機能検証に不可欠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最新のシンセシスツールを導入することで、開発効率が大幅に向上した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼らはシンセシス段階でのエラーを早期に発見し、修正することができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三つの音が協和して一つの和弦を構成するということは、三つの音がそれぞれ互いに著しく異なる特徴をもっている、それをいっしょに相戦わせることによってそこに協和音のシンセシスが生ずる。",
              "citation": {
                "source": "「手首」の問題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
