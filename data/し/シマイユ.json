        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今度｜伝馬町へ行けば仕舞い湯だ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "春の雪解",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕舞い湯のせいか女が多い。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くに銭湯があるとみえて、しまい湯を落とした湯気が、溝から白く立ちのぼってきた。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまい湯をつかっている二人の若い女は笑い声一つたてないでピチャピチャ湯音をたてている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまい湯をつかっている、二人の若い女は笑い声一つたてないで、ピチャピチャ湯音をたてゝいる。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しまい湯までには、まだ多少の時間があるわね。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の荷造りをする男と、一緒に仕舞湯へ入ってべちゃくちゃしながら、肌の綺麗な男の背を流しなどしているところを、台所働きに見られて、言いつけられた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕舞湯をつかった作が、浴衣を引かけて出て来ると、うそうそ傍へ寄って来た。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "あぶないきたない仕舞湯であたゝまる・からりと晴れた朝の草鞋もしつくりなか／＼よい宿だが、なか／＼忙しい宿だ、稲扱も忙しいし、客賄も忙しい、牛がなく猫がなく子供がなく鶏がなく、いやはや賑やかなことだ、そして同宿の同行は喘息持ちで耄碌してゐる、悲喜劇の一齣だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩も冬至の柚湯で仕舞湯に近い濁った湯風呂の隅には、さんざん煮くたれた柚の白い実が腐った綿のように穢らしく浮いていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩も冬至の柚湯で、仕舞湯に近い濁った湯風呂の隅には、さんざん煮くたれた柚の白い実が腐った綿のように穢らしく浮いていた。",
              "citation": {
                "source": "ゆず湯",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが天にも地にもたった一人の身よりである、お八重という白痴の娘を連れて、仕舞湯に入りに来たのであった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日目位からは銭湯の仕舞湯以上に臭くなり、風呂の底がぬる／＼になった。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも、こんな時には留守居役の老女中、お早婆さんが、居睡り半分、仕舞湯に浸っているはずである。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「皆んな居ましたよ、兄さんが仕舞湯から歸つたところを捕まつただけで――」「皆んな一緒に押し込められたんだね」「最初は捨さんだけ別の部屋でしたよ」「フーム」「だつて奧の部屋へ一人で寢て居たんですもの」　こんな話からは、何も引出せさうもありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "新六さんはお寺へ、番頭さんは後々のことの御相談があるとやらで、三河町の御親類を送つて出るし、音次郎さんはひどくくたびれたからと、亥刻（十時）過ぎの仕舞湯へ――」「皆んな忙しいことだな」　平次は宜い加減に合槌を打つて、奧から娘のお萩を呼出してもらひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "心中崩れ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「みんな居ましたよ、兄さんが仕舞湯から帰ったところを捕まっただけで――」「みんな一緒に押し込められたんだね」「最初は捨さんだけ別の部屋でしたよ」「フーム」「だって奥の部屋へ一人で寝ていたんですもの」　こんな話からは、何にも引出せそうもありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "御落胤殺し",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
