    "definitions": [
      {
        "index": 1,
        "gloss": "Smilax riparia (species of climbing plant)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山菜採りの途中で見つけたシオデは、山のアスパラガスと呼ばれるほど美味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「これ、シオデじゃない？ サッと茹でてマヨネーズで食べると最高なんだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "シオデのつるが伸びて、周りの木々に複雑に絡みついている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "山形秋田から津軽へかけての日本海側は、牛尾菜という草を必ず用いる。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミズ・アイ・ホナ・シオデの類、算え上げると二十種以上もあるが、これはすでに『分類山村語彙』に載せたから、ここには再び説かない。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
