[
  {
    "uuid": "512bd8d6-4f76-5488-939a-599bbc07ecf9",
    "entry": "新居",
    "reading": {
      "primary": "しんきょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
