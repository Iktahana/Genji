      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "new home",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "念願のマイホームを購入し、来月には新居に引っ越す予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人が新居に招待してくれたので、遊びに行くのが楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "新居祝いとして、素敵な観葉植物を贈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "初めて大久保の新居に移った時は、春の麗らかな日であって、裏の竹藪で鶯がしきりに鳴いてた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "Tofts の新居に実験室を造ろうと考えてマクスウェルの知慧を借りたりしたが、結局ここにはわずかに四箇月くらいしか居ないことになった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二度目はたしか池袋の方の田舍の新居へこれも弟の篤君と、訪ねたときである。",
              "citation": {
                "source": "淺見淵君に就いて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫同士は古い知己で隣合って新居を持った。",
              "citation": {
                "source": "花嫁の訂正",
                "author": "――夫婦哲学――",
                "note": "青空文庫"
              }
            },
            {
              "text": "青扇もマダムも、まだ彼等の新居に帰ってはいなかった。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "引越したばかりの新居は、ひとを感傷的にするものらしい。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも解説者は小島政二郎氏であって、小島氏は、小説家としては私たちの先輩であり、その人の「新居」という短篇集を、私が中学時代に愛読いたしました。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌る年の二月のよい日に、次郎兵衛は宿場のはずれに新居をかまえた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月の更によい日に習字のお師匠の娘が花嫁としてこの新居にむかえられた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜、火消したちは次郎兵衛の新居にぎっしりつまって祝い酒を呑み、ひとりずつ順々に隠し芸をして夜を更しいよいよ翌朝になってやっとおしまいのひとりが二枚の皿の手品をやって皆の泥酔と熟睡の眼をごまかし或る一隅からのぱちぱちという喝采でもって報いられ、祝賀の宴はおわった。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが突然かの女は郊外の新居といふのから電話して来て、車を廻して寄越し、自宅で蛍見物をさすといふのに、のん気な昔の友人訪問の気持を取り戻して、私は来て見たのであつた。",
              "citation": {
                "source": "過去世",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしの新居は泥の底。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は昨日、その四畳半を去つて、一家と共にこゝの中津川の水の音涼しくも終夜枕にひびく新居に移りぬ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの室にて、日毎に心耳を澄まして聞くをえしヴアイオリンは、この新居にても亦聞きえざるにあらず。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして次郎と君枝は市岡の新開地で新世帯をはじめたが、新居でおこなわれた婚礼の晩ちょっとしたごたごたがあった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "新らしき文化住宅地緑ヶ丘の突端にある此の馬込の新居は、明朗にして簡素、月・霧・燈・火の夜景は亦九十九谷の名にそむかず、少くとも近代詩趣の一年なり。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の内、最も舊い作は『天王寺墓畔吟』中の卷頭、「新居」の一、「白藤」の歌であり、最も新らしい作は『砧村雜唱』中の「※・父母の冬」の一聯である。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩文には「新居より」「殲くして長久なるもの」がある。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私等の新居はこの三崎の向ヶ崎の浜にあつた。",
              "citation": {
                "source": "雲母集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚、此の三崎新居以前事情があつて、十日ばかり同処へ逗留してゐた事がある。",
              "citation": {
                "source": "雲母集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "新らしき文化住宅地緑ヶ丘の突端にある此の馬込の新居は、明朗にして簡素、月・霧・燈火の夜景は亦九十九谷の名にそむかず、少くとも近代詩趣の一年なり。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の内、最も旧い作は『天王寺墓畔吟』中の巻頭、「新居」の一、「白藤」の歌であり、最も新らしい作は『砧村雑唱』中の「※・父母の冬」の一聯である。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠れる都（京に入りて間もなく宿りける駿河台の新居、窓を開けば、竹林の崖下、一望｜甍の谷ありて眼界を埋めたり。",
              "citation": {
                "source": "詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで一同は、先発隊を派遣して新居を求め、いよいよ出発にとりかゝつた。",
              "citation": {
                "source": "吾家の随筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "番町の広い邸宅に比べて、此の新居で臨終の地となつた市ヶ谷の家は何となく淋しく見えた。",
              "citation": {
                "source": "蓑田先生",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで、法師をはだかにして、ありがたい、はんにゃしんきょうの経文を、頭から胸、胴から背、手から足、はては、足のうらまで一｜面に墨くろぐろと書きつけました。",
              "citation": {
                "source": "壇ノ浦の鬼火",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
