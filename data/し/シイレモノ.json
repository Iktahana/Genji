          "standard": [
            {
              "text": "倉庫に新しい仕入れ物が届いたので、検品作業をする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この商品はもう仕入れ物がないのですか？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "回転率の悪い仕入れ物は、早めに処分する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "孔孟の道を百貨店の仕入れ物と一｜緒にするばかがどこにある？",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくの方も非常によかったです、二時間のうちに」　かれはからのおけを見せ、それから売りだめを伯母にわたしてさしいれものの一件を語った。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　覚平はこういって家をでていった、光一ははじめて例のさしいれものは父であることをさとった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            }
          ]
        }
