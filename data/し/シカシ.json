  {
    "uuid": "2922623b-c1b5-55e4-9c35-c5f938ad4a7d",
    "entry": "シカシ",
    "reading": {
      "primary": "しかし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
