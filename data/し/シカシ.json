    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シカシヨク泳ギ、ソシテヨク遊ビマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ朝、海デ泳グカラ、皆、夜ノ心配ヲ忘レマス。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシモウ皆スマセマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシナガラ、我輩ハ君ヲ深ク信ジル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシテ、一時間ノ忍耐ヲ示シテ欲シイ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ハソノ期間ニ、我輩自身ヲ我輩ノ私室ニ密閉シ、君ノ文章ヲ研究シ、シカシテ、我輩ノ答ヲ、我輩ノ能力ノ最大ヲ致シテ書キシタタメルデアロウ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに雨は厭やだな‥‥」と、私はシカシカする眼で空を見上げた。",
              "citation": {
                "source": "一兵卒と銃",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シカシキヅカイスルナ。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ今井の叔父さんはさすがにくたぶれてか、大きな体躯を僕のそばに横たえてぐうぐう眠ってしまった。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼ざしは分らなかッた、――始終下目のみ使っていたからで、シカシその代り秀でた細眉と長い睫毛とは明かに見られた。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんお前はばかじゃない、やッぱりお袋の性を受けてるとみえて、それこそ徹頭徹尾いまのソノ農婦というでもないが、シカシともかくも教育はないの――そんなら人のいうことならハイと言ッて聞てるがいいじゃないか？",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも尚お強情を張ッて行かなければ、「貴君と御一所でなきゃア私も罷しましょう」とか何とか言て貰いたかッた……「シカシこりゃア嫉妬じゃアない……」　と不図何か憶出して我と我に分疏を言て見たが、まだ何処かくすぐられるようで……不安心で。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ人足の留まるは衣裳附よりは寧ろその態度で、髪も例の束髪ながら何とか結びとかいう手のこんだ束ね方で、大形の薔薇の花挿頭を挿し、本化粧は自然に背くとか云ッて薄化粧の清楚な作り、風格｜※神共に優美で。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからと云うものは、塞ぐのでもなく萎れるのでもなく、唯何となく沈んでしまッて、母親が再び談話の墜緒を紹うと試みても相手にもならず、どうも乙な塩梅であったが、シカシ上野公園に来着いた頃にはまた口をきき出して、また旧のお勢に立戻ッた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "満眸の秋色｜蕭条として却々春のきおいに似るべくも無いが、シカシさびた眺望で、また一種の趣味が有る。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意を暁ッたか暁らないか、お勢は唯ニッコリして、「厭な『アイドル』ですネ、オホホホ」「シカシ考えて見れば此方が無理サ、先方には隠然亭主と云ッたような者が有るのだから。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ散らしてしまいたいと思うほど尚お散り難る。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシさすがに心細いと見えて、返えす書に、跡で憶出して書加えたように薄墨で、こう申せばそなたはお笑い被成候かは存じ不申候えども、手紙の着きし当日より一日も早く旧のようにお成り被成候ように○○のお祖師さまへ茶断して願掛け致しおり候まま、そなたもその積りにて油断なく御奉公口をお尋ね被成度念じ※。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国の学者社会に多人数知己が有る中に、かの有名の「ハルベルト・スペンセル」とも曾て半面の識が有るが、シカシもう七八年も以前の事ゆえ、今面会したら恐らくは互に面忘れをしているだろうと云う、これも当人の噺で。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シカシ、毒が無くッて宜」と誰だか評した者が有ッたが、これは極めて確評で、恐らくは毒が無いから懶惰で鉄面皮で自惚で法螺を吹くので、ト云ッたら或は「イヤ懶惰で鉄面皮で自惚で法螺を吹くから、それで毒が無いように見えるのだ」ト云う説も出ようが、ともかくも文三はそう信じているので。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "送り込んでから巫山戯た……道学先生に聞かせたら巫山戯させて置くのが悪いと云うかも知れぬが、シカシこれとても酒の上の事、一時の戯ならそう立腹する訳にもいかなかッたろう。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "がシカシ文三には気に喰わぬ、お勢の言様が気に喰わぬ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ少年の議論家は称讃されたのかと思ッたと見えて、「お勢ッ子で沢山だ、婦人の癖にいかん、生意気で」　ト云いながら得々として二階を降りて往た。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "がシカシ君の事たから今更｜直付けに往き難いとでも思うなら、我輩一｜臂の力を仮しても宜しい、橋渡をしても宜しいが、どうだお思食は」「それは御信切……難有いが……」　ト言懸けて文三は黙してしまった。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "モジ付く文三の光景を視て昇は早くもそれと悟ッたか、「厭かネ、ナニ厭なものを無理に頼んで周旋しようと云うんじゃ無いから、そりゃどうとも君の随意サ、ダガシカシ……痩我慢なら大抵にして置く方が宜かろうぜ」　文三は血相を変えた……「そんな事｜仰しゃるが無駄だよ」　トお政が横合から嘴を容れた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ何の遺恨が有ッて、如何なる原因が有ッて。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シカシ考えて見ればお勢も恨みだ」　ト文三が徘徊きながら愚痴を溢し出した。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ酒でも飲まんじゃー堪らん。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何故またそう Despair を起したもんだネ」「Despair じゃー無いが、シカシ君面白く無いじゃーないか。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を飲めば渇が歇まるが、シカシ水は台所より外には無い。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
