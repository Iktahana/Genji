        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私今日ハ忙ガシカッタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタト云ッテモ三十ソコ／＼デナオ美シカッタガ、見タトコロ年増女ト云ウ感ジデ、トテモ男性トハ思エナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ癖手ノ冷エ方ハマス／＼激シカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十台クライマデハ死ノ豫感ガ何ニモ増シテ恐シカッタガ、今デハソンナコトハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――冗談ミタイニ云ッテタケド、案外本気ラシカッタワ」「誰デモ女房ニソウ云ワレルト、ソンナ負惜ミヲ云ウモノサ」「彼ニモ誰カ好キナ人ガアルラシイノヨ、アタシト同ジヨウナ過去ヲ持ッタ、何処カノキャバレノ人ラシイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽエ別ニ………」「ソウカイ、子供達モ大層元気ラシカッタネ」「有難ウゴザイマス、オ蔭様デ今年モ大喜ビデ」「不断メッタニ見ナイセイカ、三人トモ見違エルホド大キクナッタネ」コヽデ婆サンガ口ヲ挟ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五日ノ午後、最モ痛ミノ激シカッタ日デアッタ、婆サンガ始メテ病室ヲ覗イテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "痛イナガラ嬉シカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御馳走サマ、久シ振ニオイシカッタワ」茶ヲ飲ンデイル颯子ヲ掴マエテ予ハオモムロニ話シカケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛リ上ッテイル部分カラ土蹈マズニ移ル部分ノ、継ギ目ガナカ／＼ムズカシカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシシバ／＼失敗シ、足ノ甲ヤ足ノ裏ヲタオルデ拭イタリ、塗リ直シタリスルコトガ、又タマラナク楽シカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エクスタシーニ入ル前後ニオイテ一層ソノ声ガハナハダシカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "間モナク僕ハ眠ッタラシカッタガ、夢ノ中デモナオ妻ガ二重ニ見エタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………空間ガ空色、頭髪ガ黒、唇ガ真紅、鼻ガ純白、………ソシテソノ黒サモ、紅サモ、白サモ、実物ノ彼女ヨリハハルカニケバケバシク、映画館ノ絵看板ノペンキノヨウニ毒々シカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
