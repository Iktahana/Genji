          "literary": [
            {
              "text": "「トコロデ、ミレバ　モウ　コノ　バシヤモ　ズヰブン　フルボケテ　シマツタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、コハレナイ　ウチニ、ムカシ、コノ　バシヤガ　マイニチ　カヨツタ　カイドウスヂヲ　ミセテ　ヤツテ、ソレカラ　モヤシテ　シマツタ　ハウガ　ヨイト　オモフ」　コドモタチハ　ミナ　サンセイイタシマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチガ　トツゼン　ヒツクリカヘツテ、キゼツシテ　シマツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オマンヂウハ　ナミガ　ミンナ　タベテシマツタノダヨ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボク　オキアガツテ　キヤラメルヲ　カゾヘテ　ハコノナカヘシマツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲ナオリノ式ハ、無事ニ終ツタノニ、女ノ事デ、オタクノ金五郎サント、友田喜造親分ト、ソシテ、ワタシタチノ間ニ、悪イイキサツガ出来テシマツタノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
