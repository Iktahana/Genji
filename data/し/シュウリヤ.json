        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "修理屋さんに頼んで家の雨漏りを止めてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この辺りで信頼できる修理屋を知っていますか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "修理屋の作業は迅速で仕上がりも丁寧だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
