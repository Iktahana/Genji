        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "柄の悪い若いもんが、ドヤ（宿屋）のシャリマ（女中）をどうしたの、あのシャリマはラリコ（淫奔）だなどと言っているのが俺の耳にはいった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "波子はシャリマだった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間じゃシャリマはラリコで通っているが、波子はそうじゃない。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドヤのシャリマだったころ、俺のピストルを見ても驚かなかった波子。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
