        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（さっ、さっ、さっ、　しゅっ、しゅっ、しゅっ、　エイさ、エイさ！",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっしゅっ、　さっ、さっ！",
              "citation": {
                "source": "海の使者",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とかく、大晦日には、思わぬ事がしゅったい致す。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっしゅっとお米をとぎながら、私は、お母さんが可愛く、いじらしくなって、大事にしようと、しんから思う。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "藪を飛び越え森を突き抜け一直線に湖水を渡り、狼が吠え、烏が叫ぶ荒野を一目散、背後に、しゅっしゅっと花火の燃えて走るような音が聞えました。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と言いましたら、山ねこはおおようにわらって、「ふふん、まだお若いから、」と言いながら、マッチをしゅっと擦って、わざと顔をしかめて、青いけむりをふうと吐きました。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこだって毎日行く。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこは、舜一なんだけれども、みんなはいつでもしゅっこといふ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういはれても、しゅっこは少しも怒らない。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからみんなは、いつでもしゅっこしゅっこといふ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、しゅっことは、いちばん仲がいい。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこも、大きな白い石をもって、淵の上のさいかちの木にのぼってゐたが、それを見ると、すぐに、石を淵に落して叫んだ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこは、木の上で手を額にあてて、もう一度よく見きはめてから、どぶんと逆まに淵へ飛びこんだ。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」しゅっこが云った。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこは、手をふってそれをとめた。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」としゅっこが云った。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、たうとう、しゅっこが云った。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月十四日　しゅっこは、今日は、毒もみの丹礬をもって来た。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども毒もみは卑怯だから、ぼくは厭だと答へたら、しゅっこは少し顔いろを変へて、卑怯でないよ、みみずなんかで、だまして取るよりいゝと云って、あとはあんまり、ぼくとは口を利かなかった。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りしゅっこは、そこら中を、一軒ごとにさそって歩いて、いいことをして見せるからあつまれと云って、まるで小さなこどもらまで、たくさん集めた。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゅっこが、あんまり急いで行くもんだから、小さな子どもらは、追ひつくために、まるで半分｜馳けた。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな急いで着物をぬいで、淵の岸に立つと、しゅっこが云った。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――シューシュ、どころか今日このごろは、五銭のバットもすいかねるシュッシュー――と波田もうたった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事窓や、のぞき窓や、その他のすき間からは、剃刀の刃のような冷たい風がシュッシュッと吹き込んだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "小児は争って買競って、手の腥いのを厭いなく、参詣群集の隙を見ては、シュッ。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾丸がシュッ、シュッ！",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々シュッといったり、シャッといったりする。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめの子は、シュッとマッチをすりました。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」セロ弾きは云いながらいきなりマッチを舌でシュッとすってじぶんのたばこへつけました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "首が太いからスポンとはいかない、シュッポォンと切られるぞ。",
              "citation": {
                "source": "カイロ団長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
