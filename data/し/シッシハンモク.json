        "examples": {
          "standard": [
            {
              "text": "長年の嫉視反目から、二人の仲は修復不可能になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の傲慢な態度は、周囲からの嫉視反目を一身に集めることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "嫉視反目を乗り越え、彼らは協力してプロジェクトを進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "十四、役人は、互に嫉視反目するな。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "女性は屡※練絹の外衣の下に襤褸の肉衣を着る）、本能の如き嬌態、女性間の嫉視反目（姑と嫁、妻と小姑の関係はいうまでもあるまい。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼等相互の間では、ひそかに嫉視反目している。",
              "citation": {
                "source": "秦の出発",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらぬ噂となり、不公平な評判となり、嫉視反目、この界隈、住むに堪えずといふことになる。",
              "citation": {
                "source": "犬は鎖に繋ぐべからず",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
