    "definitions": [
      {
        "index": 1,
        "gloss": "to ooze (out)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
