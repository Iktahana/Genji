    },
    "definitions": [
      {
        "index": 1,
        "gloss": "main parachute",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "スカイダイビング中、不運にも主傘が開かず、即座に予備のパラシュートを切り替えることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "訓練兵は、空中で主傘が正常に展開し、空気の抵抗を感じた瞬間にようやく安堵の表情を浮かべた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "降下後に主傘を丁寧にたたみ、次回のジャンプでトラブルが起きないよう入念にチェックする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "落下傘は、主傘を開いていない。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "主傘がぱっと、開いたのは、高度二百メートルのところであった。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "見事に拡がった主傘は無印であった。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、主傘はたちまち焔と化し、一瞬に燃え尽きた。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
