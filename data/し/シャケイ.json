        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供が急に首をかしげるようになり、病院で診てもらったところ、斜頸と診断された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新生児に斜頸が見られたため、早期からリハビリテーションを開始した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長時間の不自然な姿勢が続き、痙性斜頸の症状が現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
