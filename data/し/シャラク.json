[
  {
    "uuid": "b29737b7-3a73-5fc6-900d-8865e6049d20",
    "entry": "洒落",
    "reading": {
      "primary": "しゃらく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "free and easy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はいつも洒落た振る舞いで、周囲を和ませる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "洒落た雰囲気のカフェで、午後のひとときを過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "仕事中でも、時折洒落た冗談を言って場を盛り上げる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "他の多くの友人に對して、芥川君は常に都會人的な洒落や笑談を言つたらしい。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のやうなガサツな田舍者には、洒落なんか解らないと思つたのだらう。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――僕はあなたの小説を読んだことはないが、リリシズムと、ウイットと、ユウモアと、エピグラムと、ポオズと、そんなものを除き去ったら、跡になんにも残らぬような駄洒落小説をお書きになっているような気がするのです。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の句には、芭蕉のやうな幽玄な哲学や寂しをりもなく、蕪村のやうな絵画的印象のリリシズムもなく、勿論また其角、嵐雪のやうな伊達や洒落ツ気もない。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "輕口を言はず、駄洒落を飛ばさないから、Ｋ君をユーモリストだと誰も思はないけれど、挨拶をさせたり、序文を書かせたりしたら、Ｋ君のものは天下一品だ。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも、お上品なお方たちは、洒落が下手だ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「洒落どころぢやありません。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お道化にも洒落にもなつてやしない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お洒落でつつましやかで、おとなしくてお済しで、群っていても実は孤独で、おっとりしていてもなかなか怜悧で。",
              "citation": {
                "source": "五月の朝の花",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "美女は美女なりに、醜女は醜女なりに、いかにも女性の心の弱さ、お洒落さ、見栄坊であることを象徴して好い。",
              "citation": {
                "source": "女性の不平とよろこび",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛の脊髄のスープと云ったような食通を無上に喜ばせる洒落た種類の料理を食べさせる一流の料理店から葱のスープを食べさせる安料理屋に至るまで、巴里の料理は値段相当のうまさを持っている。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「直な柱も杉皮附、つくろはねどもおのづから、土地に合ひたる洒落造り」とは『春色辰巳園』巻頭の叙述である。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "人を馬鹿にしているこの駄洒落は異郷の旅愁をかえって慰めてくれた。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽い駄洒落も時には悪くない。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆生を済度する仏がホトケであるのは偶然の洒落である。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "家庭料理などと、洒落れて居られる家は少いのじゃ。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "地口や駄洒落は床屋以下に流通している時代ではあるまいか。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "洒落た切子細工や典雅なロココ趣味の浮模樣を持つた琥珀色やひすい色の香水壜。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自転車で岡持ちを運んで来る若者は遠路をぶつぶつ叱言いったが、小初の美貌と、父親が宛てがう心づけとで、この頃はころころになって、何か新らしく仕込んだ洒落の一つも披露しながら、片隅の焜炉で火を焙して、お椀の汁を適度に温め、すぐ箸が執れるよう膳を並べて帰って行く。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど斯ふ言ふのが温泉場へ行く人、海水浴場へ行く人乃至名所見物にでも出掛る人の洒落た口調であるキザな言葉たるを失はない。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "洒落た切子細工や典雅なロココ趣味の浮模様を持った琥珀色や翡翠色の香水壜。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この高慢税を納めさせることをチャンと合点していたのは豊臣秀吉で、何といっても洒落た人だ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "不老若返り薬などを年寄に用いてもらって、若い者の邪魔をさせるなどは悪い洒落だ。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし観行院様はまた洒落たところのあった方で、其当時私に太閤が幼少の時、仏像を愚弄した話などを仕てお聞かせなさった事もありました。",
              "citation": {
                "source": "少年時代",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、洒落は返答でないと思ってるらしい。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は高等学校一年生の時に、早くもお洒落の無常を察して、以後は、やぶれかぶれで、あり合せのものを選択せずに身にまとい、普通の服装のつもりで歩いていたのであるが、何かと友人たちの批評の対象になり、それ故、臆して次第にまた、ひそかに服装にこだわるように、なってしまったようである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も今は三十二歳で、こんなに鬚もじゃの大男になって、多少は苦労して来たような気もしているのであるが、やはり、こんな悪洒落みたいな、ふざけた着物を着て、ちびた下駄をはき、用も無いのに公園をのそのそ歩き廻っている。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも非人小舎とは言うものの、その小径の左右に、何処かの火事の焼跡から拾って来たらしい大きな焼木杭が二本、洒落た門構えの恰好に立っているのが、その奥のガラクタ小舎とは不釣合いな奇抜なものに見える。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなりっぱなことを言って、きっとだね」　奴は昂然として、「虚言と坊主の髪は、いったことはありません」「なんだね、しゃらくさい」　微笑みつつ女子はかく言い捨てて乗り込みたり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の体と楽天地のミイラを比較してみて、いろはにほへど散りぬるをと何もかもしゃらくさい気持になった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
