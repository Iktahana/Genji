[
  {
    "uuid": "6924173c-8f3f-5aec-851f-f36435ff3641",
    "entry": "諸例",
    "reading": {
      "primary": "しょれい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
