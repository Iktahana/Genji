[
  {
    "uuid": "50661d72-5370-5bcb-85bb-7c9804e4b3eb",
    "entry": "周覧",
    "reading": {
      "primary": "しゅうらん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "looking all around",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "観光タクシーを一台チャーターして、運転手の解説を聞きながら市内を一通り周覧した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "城下町をゆっくりと周覧しながら、当時の侍や商人の生活に思いを馳せる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "新しくオープンした美術館の展示を隅々まで周覧し、現代アートの世界を堪能した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "故に将士は営に至れば、即ち休息するを得、暇あれば王｜射猟して地勢を周覧し、禽を得れば将士に頒ち、塁を抜くごとに悉く獲るところの財物を賚う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "相覧の子を周覧と云つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "周覧は狭斜に出入し、悪疾に染まつて聾になり、終に父に疎んぜられた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "曾能子刀自は家に周覧の画いた屏風のあつたことを記憶してゐる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "周覧の子ではなからうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "初に少時の失行を云云して、後に其人の後の誰なるを推窮するは憚るべきが如くであるが、周覧の能く過を改め身を立てた人なるを思へば、必ずしも忌むべきではなからうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝知文の東夷周覧（享和元年）にはメノコの女陰を見た和人が償をとられそうになってやっと助かった話を次のように記述している。",
              "citation": {
                "source": "性に関するアイヌの習俗",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            },
            {
              "text": "余も案内を雇い、椅子つきの轎に駕し、三人これをかつぎて半日、市の内外を周覧す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "これより瀬木氏の案内にて、博物館、美術館、公園、宮城等を周覧し、有名なるビール店ホフブランハウスに至りて喫飯せり。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日の周覧を終って、いくらか葡萄酒のほてりが顔色にあらわれていても、男のひとたちのテーブルから笑声は立たなかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日の戦跡周覧の果てに感じている広汎な根ぶかくゆれる抗議、それがどのようにあらわされるのかわからないためにおこっている内部の圧力の高まり。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
