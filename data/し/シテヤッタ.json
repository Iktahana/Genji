          "literary": [
            {
              "text": "また「シテヤッタ」という言葉が広く行われる。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度僕ハ、彼女ガイカナル反応ヲ示スカト思ッテアノ性慾点ヲ接吻シテヤッタガ、誤ッテ眼鏡ヲ彼女ノ腹ノ上ニ落シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ睡ル真似ヲスルノニ都合ガヨカロウト思ッテ飲マシテヤッタノデアル）　彼女ガ睡リ込ンダ（モシクハ睡リ込ンダ風ヲシタ）ノヲ見定メテカラ、僕ハ最後ノ目的ヲ果タス行動ヲ開始シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
