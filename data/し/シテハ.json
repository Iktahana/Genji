        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思イ見ヨ、諸君ハ、現ニ、商埠遙ニ散在シテイル貧窮セル居留民達ノ生命ヲモ財産ヲモ保護シテハイナイノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンノ　オトウサンハ　ソレヲ　キクト、タキクンノ　ハウヲ　キツト　ミテ、「タキ、イジメタリ　シテハ　イケナイヂヤ　ナイカ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "納税資格ガ選擧權ノ有無ヲ決スル各國ノ制度ハ議會ノ濫觴ガ皇家ノ徴税ニ對シテ其ノ費途ヲ監視セントシタル英國ニ發スト雖モ、日本國自身ノ原則トシテハ國民タル權利ノ上ニ立テサルヘカラス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義的議論ノ多クガ大地主ノ土地兼併ヲ移シテ國家其者ヲ一大地主トナシ以テ國民ハ國家所有ノ土地ヲ借耕スル平等ノ小作人タルベシト云フハ原理トシテハ非難ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地ノ國際的分配ニ於テ不法過多ナル所有者ノ存在スルコトニ革命的理論ヲ擴張セズシテハ、言論行動一瞥ノ價値ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ安寧秩序ヲ保持スルコトガ國家ノ唯一任務ナリトセバ、國民ノ死活榮辱ヲ日夜ニ亘リ終生ヲ通ジテ脅威シツツアル此等ヲ處分セズシテハ國家ナキニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校トシテハ簡單ナル事務ニシテ、若シ兒童ノ家庭ノ惡感化ニヨリテ食事ヲ肯ンゼザル者アラバ教師ノ權威ヲ以テ其ノ保護者ヲ召喚訓責スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來取得スベキ新領土ノ住民ガ其ノ文化ニ於テ日本人ト略等シキ程度ニアル者ニ對シテハ、取得ト同時ニ此ノ改造組織ノ全部ヲ施行スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在及ビ將來ノ領土内ニ於ケル異民族ニ對シテハ義勇兵制ヲ採用スル者アルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ其ノ國防ニ於テモ組合ト組合員トノ間ニ雇傭契約ヲ締結スルハ、米ノ建國トシテ英ノ國家組織トシテハ少シモ不可ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮明度、速力ナドニ関シテハモチロン、資材ノウエカラ労力ノウエカラ大変ナ経済ダト思ウガコノ種ノコトハ私ニハヨクワカラナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハ君ヲ愛シテハ居ナイゾ、君モ道子ヲ愛シテハ居ナイデハナイカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "船長は声をふるわせてよむ、――「ワケモワカラナイノニ、攻撃シテハイケナイ。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨリテ直ニ二個師団ノ陸兵及ビ多数武器ヲ大商船隊ニ乗セ、パナマ運河ヲ通過シテハワイヘ向ケ出発セシメタリ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来ノ殺害目的者ニ対シテハ、殺害ノ予告ノミヲシテ方法及ビ期日ヲセザリシ為メ普通月並ナル脅迫状位ニ思フテ覚梧（死ノ）モセズ、遺言モセズ、不意ニ我党ノ手ニ掛リ、卑怯ナル不敏ナル最後トナリシ者アリシニ付キカク明ラカニセリ。",
              "citation": {
                "source": "編輯室より（一九一三年六月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ、名誉ヲ重ンズルノ念強クシテ、時トシテハ殆ド名誉ノ奴隷タルガ如キ観アリ」　こう書いてみて駒井は、果してこれが真実だろうか、どうかと怪しみました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「ワンコヤ、イタヅラシテハイケマセン。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此處原文トシテハ簡潔ニテ氣韵モ高ク感ゼラルレド、譯文ニハ數十字ヲ加ヘタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "譬ヘバ醫術ノ上手ハ、人身ニ於テ内景臟腑ノ結構ノ状、筋骨、皮肉、動靜脈、神經等ノ連絡ヲ其全體ニ渉リテ知ラザル莫キガ如ク、カノ政事家ノ如キハ、大ニシテハ地球上人間社會ノ連絡、小ニシテハ一國中人民社會ノ連絡ヲ知リテ、其一部ニ源因ヲ施セバ他ノ一部ニ結果ノ生ズルヲ知ルニ外ナラズ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "今彼我ノ二書ヲ比較スルニ東武ノ詩人｜大沼枕山ノ事ニ関シテハ彼ハ我ニ比シテヤヤ簡略ナリトイヘドモ中京ノ詩人｜森春濤ノ事ニツキテハ遥ニ精緻ヲ極メタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、外出ニ際シテハ必ズ下穿（猿股、ズロース）ヲ着用シ、更ニ「モンペ」ヲ着装スルコト。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ガ鳥獸魚介ノ肉ヲ食ヒ、時トシテハ人肉ヲモ食ヒシ事、彼等ガ火食ノ法ヲ知リ居リシ事等ハ貝塚發見ノ貝殼、骨類及ビ灰、燒ケ木等ヲ以テ證スベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「コロボックル」ニ最モ好ク似タル人民ハ何所ニ現存スルヤトノ問ヒニ對シテハ、北亞米利加ノ北端及ビ「グリーンランド」ト答フルヲ得ベシ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利器ノ原料トシテハ石、及ビ獸骨獸牙ノ類ヲ用ウ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『玉篇』には「也、今草に莚シテハ藤也」とあり、また「藤ハ艸木ニ蔓生スル者ノ惣名ナリ」ともある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主義トシテハ勿論マルクス主義ヲ信奉シテ居ル。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "………浄吉ハ今デハ颯子ヲソンナニ愛シテハイナイヨウニ見エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
