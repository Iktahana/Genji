        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "プレゼンテーション前はいつも神経が高ぶって落ち着かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの人はちょっとしたことでもすぐに神経質になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験が近づくにつれて、生徒たちの神経が張り詰めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
