  {
    "uuid": "0ce99edb-dcc2-59a1-a02c-4b15d0ba4413",
    "entry": "シタル",
    "reading": {
      "primary": "したる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "桑名藩　　新谷格之介　右者京畿ニ於テ錦旗ニ発砲シタルニ依ツテ羽津光明寺ニ謹慎仰付候ニモ拘ラズ潜カニ脱走ヲ企テ江戸ニ下向再ビ錦旗ニ抵抗致サントシタル段重々不埒至極依テ銃殺ノ上梟首スルモノナリ　　戊辰二月官軍参謀　格之介を除いた十二人の人々は、その年の四月、なんのお咎めもなく無事に帰藩を許された。",
              "citation": {
                "source": "乱世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "書中「何行削除」トアルハ今囘ノ公刊ニ際シ官憲ノ削除シタル所、行數ハ謄寫本ノ行數ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ前世紀ニ續出シタル舊キ哲人等ノ誤謬多キ革命理論ヲ準繩トシテ此ノ法案ヲ批判スル者ヲ歡ブ能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐洲諸國ノ大戰ハ天其ノ驕侈亂倫ヲ罰スルニ「ノア」ノ洪水ヲ以テシタルモノ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此間ハ各地ノ群雄又ハ諸侯が各其範圍ニ於テ土地ト人民トヲ私有シ其上ニ君臨シタル幾多ノ小國家小君主トシテ交戰シ聯盟シタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三期ハ武士ト人民トノ人格的覺醒ニヨリテ各ソノ君主タル將軍又ハ諸侯ノ私有ヨリ解放サレントシタル維新革命ニ始マレル民生國時代ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "即チ維新革命以來ノ日本ハ天皇ヲ政治的中心トシタル近代的民主國ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "米人ノ「デモクラシー」トハ社會ハ個人ノ自由意志ニヨル自由契約ニ成ルト云ヒシ當時ノ幼稚極マル時代思想ニヨリテ、各歐洲本國ヨリ離脱シタル個々人が村落的結合ヲナシテ國ヲ建テタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ投票神權説ハ當時ノ帝王神權説ヲ反對方面ヨリ表現シタル低能哲學ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ宮中ハ中世的弊習ヲ復活シタル上ニ歐洲ノ皇室ニ殘存セル別個ノ其等ヲ加ヘテ、實ニ國祖建國ノ精神タル平等ノ國民ノ上ノ總司令者ヲ遠ザカルコト甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "納税資格ガ選擧權ノ有無ヲ決スル各國ノ制度ハ議會ノ濫觴ガ皇家ノ徴税ニ對シテ其ノ費途ヲ監視セントシタル英國ニ發スト雖モ、日本國自身ノ原則トシテハ國民タル權利ノ上ニ立テサルヘカラス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "善キ傾向ニ發達シタル者ハ惡シキ發達ノ者ヲシテ學バシムル所アルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧富ヲ無視シタル劃一的平等ヲ考フルコトハ誠ニ社會萬能説ニ出發スルモノニシテ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ明示シタル所以ハ此限度ヨリ免カルヽ目的ヲ以テスル外國ノ財産ヲ禁スルヲ明カニシタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "理由ノ第二ハ、公債ヲ以テ悉ク此等ヲ賠償スル時ハ、彼等ハ公債ニ變形シタル依然タル巨富ヲ以テ國家ノ經濟的統一ヲ毀損シ得ベキ力ヲ有スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ貴族ノ土地徴集ヲ決行スルニ、大西郷ガ異議ヲ唱フル諸藩アラバ一擧討伐スベキ準備ヲナシタル先哲ノ深慮ニ學ブベシトスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家改造後ノ將來、私有財産限度ヲ超過シタル富ヲ有スル者ハ其ノ超過額ヲ國家ニ納付スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "最少限度ノ生活基準ニ立脚セル諸多ノ社會改造説ニ對シテ、最高限度ノ活動權域ヲ規定シタル根本精神ヲ了解スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "維新革命ハ所有權ノ思想ガ強力ニヨル占有ニ非ズシテ勞働ニ基ク所有ニ一變スルト共ニ、強者ガ其強力ヲ失ヒテ其所有權ヲ喪失シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來其ノ所有地ガ私有地限度ヲ超過シタル者ハ其ノ超過セル土地ヲ國家ニ納付シテ賠償ノ交付ヲ求ムベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ皇室下附ノ土地及私有地限度超過者ヨリ納付シタル土地ヲ分割シテ土地ヲ有セザル農業者ニ給付シ、年賦金ヲ以テ其所有タラシム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ改造サルベキ社會組織亦人性ヲ無視シタル此等兩極ノ學究的臆説ヲ誘導サルル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "賠償額ノ限度及私有財産ト其加算ガ私有財産限度ヲ超過シタル者ハ前掲ニ同ジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
