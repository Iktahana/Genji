          "literary": [
            {
              "text": "トリストラム・シャンデーと云う書物のなかに、この書物ほど神の御覚召に叶うた書き方はないとある。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その後鼻についてまた研究をしたが、この頃トリストラム・シャンデーの中に鼻論があるのを発見した。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリストラム・シャンデー、ちょっとあんな調子だが、もちろんあんなに七面倒ではない。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
