            {
              "text": "シャンパアニュの原野。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンパアニュの野の総攻撃でめちゃくちゃに遣られたニヴィイユ元帥ら、軍閥がまず承知しない。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はナイフやフォオクを置き、いつか僕の杯にシャンパアニュのつがれるのを眺めていた。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ、シャンパアニュ・プルミエェル街十七番地にささやかなアトリエを構へた。",
              "citation": {
                "source": "一插話",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウイスキイなどは無論酒の数にもはいらぬが、如何に優良な葡萄酒、シャルトルウズ、フィイヌ・シャンパアニュと雖も、一献の菊正宗には遠く及ばぬ。",
              "citation": {
                "source": "書狼書豚",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            }
          ]
        }
