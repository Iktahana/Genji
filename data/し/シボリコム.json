        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "多くの選択肢の中から、自分の本当にやりたいことに絞り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "採用面接では、質問を絞り込んで候補者の本質を見極める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "容疑者を数名に絞り込み、警察は捜査を進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
