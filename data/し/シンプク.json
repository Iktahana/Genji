  {
    "uuid": "74acdb21-13ee-5af7-adea-50c306027cef",
    "entry": "真福",
    "reading": {
      "primary": "しんぷく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
