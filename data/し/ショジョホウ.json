        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "登山隊は未開の処女峰の初登頂を目指して準備を進めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その処女峰は標高8000メートルを超え、登頂はきわめて危険だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "処女峰の初登頂者の名前は山頂に標識として刻まれることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "尤も聰明なる社会は、私が前人未踏の、いわゆる処女峰の征服もしていなければ、冬の山で遭難もしてもいないので先ず三流どころの山岳家と認めているらしい。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は前人未踏の所謂処女峰を征服しようも思わないし、エヴェレストの絶頂に日章旗を押し立てようとも望まない。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
