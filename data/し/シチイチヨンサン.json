          "standard": [],
          "literary": [
            {
              "text": "ある統計家の調べたところに依ると、七百四十三人の男の狂人のなかで、結婚した男の数二百一人に対して鰥夫は五十人、未婚者は四百九十二人といふ比例を示してゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に、千五百十二の中等学校（学生十五万四千）のうち七百四十三校が工芸技術学校となった。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱い風呂で生きかえり、指圧のマッサージを受け、下にもおかぬもてなしのなか、布団に眠るそのパッケージ・ツアーは、ふたりの場合、ひとりが七千七百四十三ドルだという。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
