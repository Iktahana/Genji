        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アキニ、ナッテ、イロイロ、モノイリガ、シテオクレマシタ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテオ前ハ俺ノ行動ニツイテ、昼間飛行島デ別レテカラ後ノコトハ、スベテミナ忘レルノダ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ予ノタメニ腸ダケヲ残シテオクノガ習慣ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸モペッタリシテオ乳ナンゾナクナッチマウシ、肩ノ筋肉モマルデ男ミタイニコチ／＼ニナルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サン曰ク、田園調布ノ鈴木サンニ鍼ヲシテオ貰イニナッタラドウ、鍼デ直ルカモ知レナイカラ頼ンデ見タラト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽジャナイノ、折角楽シミニシテルンダカラ佐々木サンヲ行カシテオヤンナサイヨ」「君ハソレデイヽノカネ」「何デソンナコトヲオ聞キニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシ彼方ヘ逃ゲテクカラ、一人デ勝手ニ泣イテラッシャイ」「ネエ颯子、コレカラ時々『颯チャン』ト呼バシテオクレヨ」「馬鹿ラシイ」「颯チャン」「甘ッタレ坊主ノ嘘ツキ坊主、誰ガソノ手ニ載ルモンデスカ」プリ／＼怒ッテ行ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナカンズクソノ下半身ヲホントウニ残ル隈ナク見ル、下腿部ガヤヤＯ型ニ外側ヘ彎曲シテオリ、遺憾ナガラマッスグトハ云イニクイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ目的ハ、コレラヲ僕ノ日記帳ニ貼付シテオクハ希有ノニヨッテ彼女ヲ極度ニ辱カシメ、彼女ガドコマデシラヲ切ッテイラレルカヲ試シテヤリタイノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "※デモ、木村ハ刺戟剤トシテ利用シテイルニ過ギズ、ソレ以上ノ何者デモナイトシテオイテクレ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「ココニ寝カシテオクワケニモ行クマイ」ト、約一時間後ニ僕ガ云ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテガミクダサラナイノデ……ワタクシタチ……マイニチシンパイシテオリマス……ドウナサツタノ……デスカ……」と判じ判じ読んで、オホホホホホホホと、母は笑い出しました。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その葉書には、いつものように、ゼヒゼヒイラシテクダサイ、オマチシテオリマス……と書いてあったのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、その瞬間、また突然頭に閃いたのは、ゼヒゼヒイラシテクダサイ、オマチシテオリマスという葉書も、そのまた前の葉書も手紙も、ことごとく東京で、ジーナやスパセニアの姿を見た以前のものばかりで、それ以来は何にも受け取っていないということだったのです。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――関門海峡ニハ、タクサンノ外国船ガ入ッテクルコトトナッテ、沖ノ仕事モ増スバカリトナッテ、組デハ、若クテヨイ働キ手ヲサガシテオル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
