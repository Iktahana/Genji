        "examples": {
          "standard": [
            {
              "text": "古い手紙は、長い年月を経て皺皺になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "慌ててポケットに入れた地図が、すっかり皺皺になってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "祖母の手は、長年の苦労を物語るかのように皺皺だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "新型の自動車が走り、しわしわした寒い歩道を、群衆は着ぶくれして歩いてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
