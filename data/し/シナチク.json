    "definitions": [
      {
        "index": 1,
        "gloss": "bamboo shoots boiled, sliced, fermented, dried or preserved in salt, then soaked in hot water and sea salt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ラーメンのトッピングには、コリコリした食感の支那竹が欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "支那竹はメンマとも呼ばれ、麻竹を乳酸発酵させて作られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ビールのつまみとして、ピリ辛に味付けした支那竹を注文した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「それではお前に尋ねるが、リンネルの背広に鳥打帽を冠むり、支那竹の杖を携えた三十七八の紳士が今日、お前の所へ来られた筈だが？",
              "citation": {
                "source": "闘牛",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "単衣に兵児帯、そして太い支那竹のステッキをついて……。",
              "citation": {
                "source": "裸木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那竹と小さい海苔だけしか入ってない、一番安い三十円か四十円のやつでした。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
