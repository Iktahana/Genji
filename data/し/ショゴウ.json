        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このフォントの初号は、見出しに使うと非常にインパクトがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い活版印刷の機械では、初号活字を組むのに熟練の技が必要だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "初号の文字サイズは、ポスターのデザインにおいて重要な要素となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
