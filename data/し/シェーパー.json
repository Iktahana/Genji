        "examples": {
          "standard": [
            {
              "text": "サーフボードのシェーパーは、経験と技術で波に適した板を作り出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "金属加工工場では、最新のシェーパーが精密な部品を生産している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この木工職人は、手作業で木材をシェーパーで美しい形に削り出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "この小屋の主人公であるらしいシェーパードが一匹、雪の積った地面に死んだようになって長く伸びていた。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はサーフボードのシェイパーであり、名前はフレデリック・バーソロミューだと、教えてくれた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この基本的な心がまえの上に、サーフボードのシェイパーだというフレデリック・バーソロミューから聞かされた、日本人カメラマンの話が、たとえばフィルムの表面に一層だけ塗ったエマルジョンのように、定着していた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三日まえ、島の北側で、日系の人が経営している食堂で、サーフボードのシェイパーだという白人の青年と知りあった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この島の北側の小さな食堂で知り合ったサーフボードのシェイパー、フレッド・バーソロミューから教えられた名前だ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
