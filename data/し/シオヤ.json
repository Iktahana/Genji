        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "右には未だ青き稲田を距てて白砂青松の中に白堊の高楼｜蜑の塩屋に交じり、その上に一抹の海青く汽船の往復する見ゆ。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩屋さんとこまできて、あそこからまた帰っていっちゃうんだ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも塩屋さんとこまでくれば、おはやしの音がよくきこえるから、いいじゃないかい。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "三男　　塩屋さんとこまでくるきりだい。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（はやしの音｜止む）長女　　あら、もう塩屋さんとこのまえまできたわ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩屋平助、秋田屋太右衛門の店にて購数種書。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "是年柏岡伝七、塩屋喜代蔵入門す。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（京一郎という男は塩屋の伜だ。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……昔の塩屋と来た日には、盛大もない家であったが……）人気がなくても春の夜は気分において賑やかであった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "京一郎の父で塩屋の主、お才の良人の嘉右衛門が、十数年来孤独に住んでいる、庭の奥の林の中の、廃屋の中の部屋であった。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家は塩屋でござんした」「何、赤穂の塩屋だって？",
              "citation": {
                "source": "赤格子九郎右衛門の娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「北多摩郡の多穀神社、笠島の道祖神、屋張の国の田県神社、印旛郡の熊野神社、奥州塩屋の金精神、信濃の△△、日向の△△、四国の五｜剣山、美濃の山神、いくらもあります！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丙寅五月二日ワイルウヱフ破船五島塩屋崎ニ於テ死者十二人。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し其謡すら、約束通り、旅僧に対して、塩屋の翁の姿で現れたしてが語るのである。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "謡の「八島」で、塩屋の翁の詞の中に、「……源義経と名のり給ひし御骨がら、あつぱれ大将やと見えし。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其から先の塩屋の翁の語りに見えるものは、如何にも物語らしいではないか。",
              "citation": {
                "source": "「八島」語りの研究",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "天の月は一つだが、『影は二つ満つ汐の夜の、車に月を載せて憂しとおもはぬ汐路かなや』とあつて、二箇の桶に月を入れて塩屋へ帰るのである。",
              "citation": {
                "source": "能楽論",
                "author": "野口米次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩屋で諸国一見の僧が、一夜の宿を借りようとして待つてゐる。",
              "citation": {
                "source": "能楽論",
                "author": "野口米次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩屋の女主人は最初断つたが、仕舞に『月の夜影に見奉れば世を捨人、よしよしかかる海人の家、松の木柱に竹の垣、夜寒さこそと思へども蘆火にあたりて御泊りあれ』と僧を家の中へ迎へる。",
              "citation": {
                "source": "能楽論",
                "author": "野口米次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜之助の落ちて行く方面は、日高川に沿うて四十余里の屈曲を塩屋の浦まで出て、船でどちらへ行くか、または高野領を経て西国筋へでも落ちるか、兵馬はそれを測って単身結束してそのあとを追わねばならぬ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "竜神の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、ここにいますと、どちらを見ても陸地は少しも見えないではございませんか」「全くその通りです、地図で見れば、ちょうどこの船のあるところは、磐城平に近い塩屋崎というところの沖に当りますが、ここにいては東西南北みんな海で陸地は見えません、またなるべく陸地の見えないようにと船をやっているのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "都の西の方へ法然の遺骸をかきたてて行くうちに、道路の危険を慮かって、宇津宮弥三郎入道蓮生、塩屋入道信生、千葉六郎大夫入道法阿、渋谷七郎入道道遍、頓宮兵衛入道西仏等の面々今こそ出家の身ではあるが、昔は錚々たる武士達が、法衣の上に兵仗を帯して、法然の遺骸を守って伴についた。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋の水一　昏れがたに大阪から船がはいり、その荷揚げが夜をこめておこなわれたし、一部は店のほうの土蔵へも運び込まれるので、塩屋町にある太橋屋の店は提灯をあかあかと表にかけ列ねて、かなり更けるまで人の出入りが賑やかにつづいた。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩屋町から通町へかけては高松城下の問屋町ともいうべく、多くの老舗が軒を並べていた。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして沖人足や店付きの者が、酒に酔って着荷祝いの唄をはじめると、かれは、そっとぬけだして塩屋町の店へ帰った。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城下の坪井町、藪之内、京町、塩屋町などは、飛火を浴びて一円の火の海と化してしまった。",
              "citation": {
                "source": "日本名婦伝",
                "author": "谷干城夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸亀市がその産地で、特に塩屋はその中心であります。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おらがまた、送って来るから」「だって、おまえは、荒木村へ戻るのでしょ」「一里ぐらい、何度往き来したって……」　話しながら行くうちに、城下端れの塩屋の軒で、塩と子猪の肉とを交換していた牢人ていの男が後からのそのそ追いついて来た。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "道をかえて、塩屋ノ磯へ急いでください」「いや、国府川の川ぐちに、島脱けの舟をつながせてある。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
