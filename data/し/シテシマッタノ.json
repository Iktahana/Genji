          "literary": [
            {
              "text": "私ハオモワズ、コエヲ出シテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、急ニワットナキ出シテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ハアット云ッテ倒レ机ノハシデ頭ヲヒドク打チ、倒レルト同時ニ血ヲハイタヨウデシタガ、ソノママ昏倒シテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番｜肝腎ナハ、―――今度コソ郁子ハスベテノモノヲ木村ニ捧ゲ尽シテシマッタノデハナイカ、ソシテ敏子ノ口ヲ介シテソノ諒解ヲ僕ニ求メテイルノデハナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウノハ、イツゾヤ東京ヘ行ッタ時弘君ニ話シテシマッタノデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
