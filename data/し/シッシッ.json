[
  {
    "uuid": "8f305a53-7b4a-500d-b6b9-6768f827e83d",
    "entry": "叱叱",
    "reading": {
      "primary": "しっしっ",
      "alternatives": [
        "シッシッ"
      ],
      "is_heteronym": false
    },
    "grammar": {
