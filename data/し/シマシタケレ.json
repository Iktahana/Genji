          "literary": [
            {
              "text": "ソノ夜階下ノ座敷ニ泊マル事ニナリ十二時過ニ就床シマシタケレ共、残念デ残念デ眠レマセン。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ電車ニノラウトシマシタケレド、イツパイノマンイン電車デ、ドウシテモノルコトガデキマセン。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "新サンハ、ビックリシテ、ベン解シマシタケレドモ、友田サンハ聞キマセン。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
