      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "in three days' time",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日が月曜日だから、明々後日の木曜日には予約していた商品が届くはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "明々後日から始まる長期休暇を利用して、家族で北海道へ旅行に行く計画を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「明後日でも大変なのに、明々後日まで待ってくれなんて無理な相談だよ」と彼は零した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「明日、明後日、明々後日」と女は指を折つて、「明々後日に決定つたの。",
              "citation": {
                "source": "少年の悲哀",
                "author": "國木田獨歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あす、あさって、明々後日」と女は指を折って、「やのあさってに決まったの。",
              "citation": {
                "source": "少年の悲哀",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日、また明後日、明々後日も、幾度も、本尊の前途を見届けるまでは、貴方は帰さん、誰にも逢わん。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、明日、明後日、明々後日……」　洗吉さんはいつも寝がけには、その間がもぢ／＼されるやうに仰りながら長火鉢の抽斗の鐶を弄つたりなさつて、おくみが縫物の針を送り／＼する前に坐つてお出でになつたりした。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『何有、明々後日になれば、二十人は屹度来あんすでア。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『何有、明々後日にならば、二十人は屹度來あんすでア、保險附だ。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日坂本山王祭、明々後日葵祭拝見候て、南都へ一先罷越可申と存居候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（去る）可児君の声　　それぢや、明日……はいけないと、明後日もなんだから、明々後日にしてくれ給へ。",
              "citation": {
                "source": "可児君の面会日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日、明後日、明々後日……みんな塞つてるから、その次の日……（指を折りながら）十六日だね、さうしてくれ……。",
              "citation": {
                "source": "可児君の面会日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "明々後日は、どうやら俺が真々館へ乗り込んで、一席ずつやり合うというんじゃないか。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしあさっての朝までに、お前がそうしなかったら、もうすぐ、つかみ殺すぞ。",
              "citation": {
                "source": "よだかの星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あした、あさって、しあさって、と。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はホテルに帰ってくると、また気のかわらないうちにとおもって、すぐ帳場にそのことを話し、しあさっての汽車の切符を買っておいて貰うことにした。",
              "citation": {
                "source": "大和路・信濃路",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかわりしあさってがコンサートだから練習しといてね。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あした、あさって、しあさって」　と、松江は三本の指をゆっくりと折り、「六日ざり（名付日）。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあさっては日曜です」「うむ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "シードを取り寄せる関係で、手術は明明後日くらいになるでしょう」　私は一礼して、病室に帰る。",
              "citation": {
                "source": "落日の光景",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうでした」「シードとかいうものを取り寄せる関係で、手術は明明後日くらいになるらしい」「私、何度でも切ってもらう。",
              "citation": {
                "source": "落日の光景",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
