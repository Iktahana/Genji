          "literary": [
            {
              "text": "シャトオブリヤンには、「モイズ」といふ詩劇があるが、一度も上演されなかつた。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲーテはワイマールの宰相であったし、ビクトル・ユーゴーも総理大臣であったし、ずいぶん甘ったるい感傷小説の作者シャトオブリヤンのような人でも文部大臣をつとめていらッしゃった。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちゲーテが作『若きウェルテルの愁』、シャトオブリヤンが作『ルネエ』の類なり。",
              "citation": {
                "source": "矢はずぐさ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
