        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼女の眼のさきで働いているばあさんの垢にしみたような田舎縞が気になるらしかった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」園子は、老人達の田舎縞を知人に見られるのを恥かしがっているのだった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして笑われるだろうと云いながら、やはり田舎縞の綿入れを着ていた。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな田舎縞を着ずに、こしらえてあげた着物を着なされ。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎縞の手織物を着て紺の前垂を掛けた、髪も質素に短く刈ったのが、主人であった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　割合に無口なお里は織りかけた田舎縞の糸をしらべながら、この兄妹の話に耳を傾けていた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も町の商人から木綿の田舎縞や帯を買う必要がない。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに渋さを誇らんが為に計らずも田舎縞、手織縞に帰着する点が実に面白いと思ひます。",
              "citation": {
                "source": "農民自治の理論と実際",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忙しい中で見ると、袷は無双になって、地味な老人縞の万筋の裏が、黄色い田舎縞になっており、世の常の袷とはまったく違っていたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "橋の上の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂人か」「死人や、死人や」「側へ行って、見たろ」「見たろ、見たろ」　田舎縞の縞目も分らぬ程に、汚れて黒光りに光った、ツンツルテンの着物を着た、十歳前後の腕白共が、口々に囁き交して、おずおずと、彼の方へ近づいて来ました。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一賊は黒い着物だったというのに、牧田はいつも白っぽい田舎縞を着ているじゃあないか」「それが例のメリンスの兵児帯なんだ。",
              "citation": {
                "source": "黒手組",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎縞の前をはだけた一人の子が、ピョイピョイと飛んでいた。",
              "citation": {
                "source": "白昼夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お姫様の夢はかやうにしてさめ、糸は機屋へおくられてをかしげな田舎縞が織られた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今張つてゐるのは木綿のごつ／＼した田舍縞で、これは三藏が綿入羽織が一枚欲しいと思つて「綿入の著物が羽織になるものですか」と渥美の細君に聞くと、「兎に角お持ちなさい。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "古びた田舍縞でそれに袂の尖に大きな黒焦げがある。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぢや急がうね」「急ぎませう」と二人は既に乾いたらしい他の張板のをめくつて又田舍縞と色の褪せた紅絹裏とを張る。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅絹裏の張り擴げられた片隅に田舍縞が小さく張り交ぜられる。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからお金が箪笥から出した洗張りをした田舍縞に著替へて床の上に坐つたまゝ淋しさうに其邊を見※した。",
              "citation": {
                "source": "續俳諧師",
                "author": "――文太郎の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舍縞の袷に、淺黒い顏、素朴ではあるが健康さうで、何んとなく頼母し氣なところがあります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "恋をせぬ女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
