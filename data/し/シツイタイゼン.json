        "examples": {
          "standard": [
            {
              "text": "「経営破綻という最悪の事態でも、社長は失意泰然として再建策を練っていた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「試合に負けて悔しくないはずがないが、彼は失意泰然とした態度で勝者を称えた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「どんな困難に直面しても、失意泰然、得意淡然の精神でいたいものだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「公明日月の如し」とか、「我が身命を愛さず唯惜しむ無上道」とか、「得意淡然失意泰然」とかいう辞句は時利あらず、いかような羽目にたちいたろうともわがこころに愧じるところなく、確信ゆるがずという文句である。",
              "citation": {
                "source": "新しい潮",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
