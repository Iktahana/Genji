          "literary": [
            {
              "text": "シャトブリアンを食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグス、トースト、ポタアジュ、シャトブリアン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オルドヴルの豪華版、本場のヴイアベーズ、シャトブリアンとアティショーの煮たのと菓子。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャトブリアンは、あんまりうまいと感じなかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロブスターのチーズ焼、こいつはたんのうしたが、その次が此の前と殆んど同じメニュで、シャトブリアンからアーティショーの肉詰、乾いたチョコレートの菓子。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
