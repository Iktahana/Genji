    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(artistic) accomplishments",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "琴や茶の湯などの諸道を極めるには長年の修行が必要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "江戸時代の文化人は諸道に通じていることが教養の印とされました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "茶道や華道などの諸道は日本文化の重要な要素です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "大宮口は、富士登山諸道の中で、海岸に近いだけに最も低い。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士の登山諸道に、壮麗な神社があるのと対照して、これはこれ、あれはあれでいいと思う。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "安政元年十一月四日五日六日にわたる地震には東海、東山、北陸、山陽、山陰、南海、西海諸道ことごとく震動し、災害地帯はあるいは続きあるいは断えてはまた続いてこれらの諸道に分布し、至るところの沿岸には恐ろしい津波が押し寄せ、震水火による死者三千数百、家屋の損失数万をもって数えられた。",
              "citation": {
                "source": "時事雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その心得はもう一芸のものでなく、諸道に通じます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏道小町はさもなかったそうでござりますが、通一筋道は、まるで、諸道具、衣類、調度が押流されました体裁、足の踏所もござりませなんだ。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "でござりまするから、往来ちりぢりの衣類諸道具、いつの間にやら、半時も経ちませぬ内に、綺麗に掃いたように無くなりました。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭壇の諸道具は、それから七日七晩、蒼い火を挙げて燃えつづけていたという。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "物慾皆無にして、諸道具への愛着の念を断ち切り涼しく過し居れる人と、形はやや相似たれども、その心境の深浅の差は、まさに千尋なり。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに徳兵衛の貧乏いよいよ迫り、ことしの暮は夜逃げの他に才覚つかず、しのびしのび諸道具売払うを、町内の顔役たちが目ざとく見つけ、永年のよしみ、捨て置けず、それとなく徳兵衛に様子を聞けば、わずか七、八十両の借金に首がまわらず夜逃げの覚悟と泣きながら言う。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝黄子澄の言を用い、長興侯耿炳文を大将軍とし、李堅、寧忠を副えて北伐せしめ、又｜安陸侯呉傑、江陰侯呉高、都督都指揮盛庸、潘忠、楊松、顧成、徐凱、李文、陳暉、平安等に命じ、諸道並び進みて、直に北平を擣かしむ。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒天風雪の時に当って宿を仮さなかったり敷物を仮さなかったり、薪や諸道具を供することを拒んだ。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東煮の諸道具を売り払った金で店を改造した。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそらく他の諸道具と一緒に売払われたのであろうと、金兵衛は言っていた。",
              "citation": {
                "source": "兜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺といふものは、俺を組立てゝゐる物質的な要素（諸道具立）と、それをあやつるあるものとで出來上つてゐる器械人形のやうに考へられて仕方がない。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "周章した足利直義は、遂に十二月、高師直、師泰兄弟を総大将として中国、東海、東山諸道の大軍を率いて発向せしめ、最後の決戦を企てた。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸道具をぎっしり積みあげてある土蔵の中は微暗かった。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肺病のある上へ、驚いたがきっかけとなって心臓を痛めたと、医者が匙を投げてから内証は証文を巻いた、但し身附の衣類諸道具は編笠一蓋と名づけてこれをぶったくり。",
              "citation": {
                "source": "葛飾砂子",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "質に取った品は預かり物ですから、衣類にしろ、諸道具にしろ、鼠にかじられたりすると面倒ですから、どこの店でも鼠の用心を怠りません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "知らねえ人が来て、諸道具をどしどし片付けて、近所へ挨拶もしねえで立ち去ったので、近所でも不思議に思っていると云うことです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "和子は急いで我が家へ帰って、衣類諸道具を売り払って四十万の紙銭を買った。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "酉陽雑爼（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "切り回しよく見かけを派手にしている割合に、不足がちな三人の姉妹の衣類諸道具が少しばかりあるだけだ。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "搗屋が臼や釜の諸道具を車につんで来て、家々の門内や店先で餅を搗くのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "この寺ではかねて供養に用いる諸道具を別室に蔵めてあったので、賊はその室の戸を打ち毀して踏み込むと、忽ちに法衣を入れてある革籠のなかから幾万匹の蜜蜂が飛び出した。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "捜神後記（六朝）",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらのたずさえて来た諸道具はみなほんとうの金銀宝玉を用いたものであるので、老女はそれを官に訴え出ると、それらは一種の贓品と見なして官庫に没収された。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "輟耕録",
                "note": "青空文庫"
              }
            },
            {
              "text": "賊はそのひまに、そこらにある金銀珠玉の諸道具を片端から盗んで逃げ去った。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "輟耕録",
                "note": "青空文庫"
              }
            },
            {
              "text": "その穴を突いて望みの大グマ三匹をえ、それから一つ山を越えてコダマのレッチウの小屋にいってみると、鉄砲諸道具をみなそのままにしておいて、肝腎の人間が一人もおりません。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "新七、お力夫婦の外に、広瀬さんという人も加わって、四人で食器諸道具の相談に余念もなかった頃だ。",
              "citation": {
                "source": "食堂",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "『人々の得生、もとより天より下さるゝことであれば、親の自分が言ふやうに子に行へと求めるのではないけれども、先祖より讓られた家督、諸道具、その他すべての物――天よりの預り物と心得て、隨分大切に預り、入念に扱へば間違ひはない。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
