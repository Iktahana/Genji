[
  {
    "uuid": "3c18f8fc-dfa6-5038-8562-71dcc1283d78",
    "entry": "醜婦",
    "reading": {
      "primary": "しゅうふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ugly woman",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鏡に映る自分を醜婦だと思い込み、彼女は外出するのを極端に嫌うようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昔話の登場人物としての醜婦は、しばしばその外見とは裏腹に優しい心を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "外見だけで醜婦と蔑むような態度は、教育者としてあってはならないことだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――醜婦奴、ガウンが百度ひらいたって、糞。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "お絹とは何人ぞ、君驚く勿れ、藝者でも女郎でもない、海老茶式部でも島田の令孃でもない、美人でもない、醜婦でもない、たゞの女である、湯原の温泉宿中西屋の女中である！",
              "citation": {
                "source": "湯ヶ原より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　お出額で鼻が小さくて目じりが下がって、というのは醜婦の棚おろしのように聞こえる。",
              "citation": {
                "source": "破片",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例を申せば、無塩君は醜婦でありましたが破格の出世を致しました。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那の大哲老子の母は非常に醜婦であつたと伝へられて居ます。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸葛孔明は実に立派な人ですが、其の妻を娶るに当つては特と醜婦を択びましたので、当時小歌を作つて其事を囃したものがあります。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "孔明の妻となり老子の母となつては、醜婦の鼻も亦甚だ高い訳ではありませんか。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "斉の賢人の管仲の書に、悪女怨気を盛るといふ語が有りまするが、醜婦が怨みの心を抱いた人相などは有り難くない者の頂上で、愈※悪い相になりませうが、いくら悪女でも仁心を抱いて居れば必ず見づらいものでは有りませぬ。",
              "citation": {
                "source": "運命は切り開くもの",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばキャサリン・ヘプバーン型の美人と醜婦を一人ずつ捜し出すのなどははなはだ容易であろう。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あなたはこんな歯欠けの醜婦をも京へ連れて行こうとなさいますか。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの醜婦どもどうするものか。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等のうちには、戀に燃えて薄命に終ツた美人もあツたらう、また慾に渇いて因業な世渡をした老婆もあツたらう、それからまた尚だ赤子に乳房を啣ませたことの無い少婦や胸に瞋恚のほむらを燃やしながら斃れた醜婦もあツたであらう。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "但、醜婦の醜を恥ぢて美ならむことを欲する者は、其衷情憐むべし。",
              "citation": {
                "source": "醜婦を呵す",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "片足はちんばの乞食で醜婦だが農家出らしいがっしりした骨格で何もかも諦め切ったような放心状態でいます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊谷伊豆守の娘が醜婦で、誰も結婚する人が無いと聞き、其の父の武勇にめでて、「其の娘の為めにさぞや歎くらん。",
              "citation": {
                "source": "厳島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "我不幸にして先妻は姦夫と奔り、孤独の身なり、かかる醜婦と結婚せば、かかる悲哀に沈む事なく、家庭も睦まじく神に仕えらるるならんと云々。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ貴嬢の振舞を聞きて、直ちに醜婦と思い取れる事の恥かしさよ。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、この河を渡るとき、風波の難に逢わない者は醜婦であるということになるので、いかなる醜婦もわざと衣服や化粧を壊して渡るのもおかしい。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "酉陽雑爼（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが私の妻は見るも厭はしい醜婦であります。",
              "citation": {
                "source": "教師",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地問題ニ於テ英語ノ直譯ヤ「レニン」ノ崇拜ハ佳人ノ醜婦ヲ羨ムノ類。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて男ども上陸して各手当り次第に履を穿くと、女ども来って自分の符標ある履はいた男を引っ張り行く、醜婦が美男に配し女王が極悪の下郎に当るもかれこれ言わぬ定めだ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏摩后その故を問うと、某ヴィシュヌを念ずるに一心にして妻がいかにかの一儀を勤むるも顧みず「川霧に宇治の橋姫朝な／＼浮きてや空に物思ふ頃」ほかにいいのがあるんだろうと、九月一日の東京｜然と大焼けに焼けた妻が拙者を詛うて、別嬪でも醜婦でも、一切の物、わが夫に見られたらたちまち破れおわれと詛うた。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに対抗して銀座の或る大ビルの事務所では、事務員に東京生れの醜婦ばかりを集めているとこの頃聴いた。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "齢ア四十一だべえが、村一番の醜婦の巨女だア、加之ハア、酒を飲めば一升も飲むし、甚※男も手余にする位の悪酔語堀だで。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "齡ア四十一だべえが、村一番の醜婦の巨女だア、加之ハア、酒を飮めば一升も飮むし、甚※男も手餘にする位の惡醉語堀だで。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "言ひ伝へによると、白拍子静が母の磯禅師はこゝに住むでゐたのださうで、禅師の血統はその後も伝はつてゐるが、産れる娘は皆｜醜婦揃ひである。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房は世間並に一人あるが、醜婦で稼ぎ人で、加之に子供を生む事を知らないので、金は溜る一方であつたが、夫婦とも揃ひも揃つた吝嗇坊で、寄附事といつたら鐚銭一つでも出し惜みをした。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来彼女は、一口にいえば醜婦といった方がよく、はじめ私は彼女との縁組に不服でしたが種々の深い事情があってとうとう結婚したので御座います。",
              "citation": {
                "source": "猫と村正",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "・ふるさとの夢から覚めてふるさとの雨　入川汐みちて出てゆく船　窓が夕映の山を持つたこの宿のおかみさんはとても醜婦だ、それだけ好意が持てた、愛嬌はないが綺麗好きだから嬉しい。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
