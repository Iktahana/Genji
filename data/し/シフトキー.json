        "examples": {
          "standard": [
            {
              "text": "大文字を入力するときは、シフトキーを押しながらアルファベットキーを叩く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パソコンのショートカットキーには、シフトキーと他のキーを組み合わせるものが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はブラインドタッチで、シフトキーを自然に使いこなしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "またカーソルキーだけを押せばカーソルは隣に移動するが、シフトキーと組み合わせればより遠くへ、コントロールキーと組み合わせればさらに遠くへ飛ぶというアイディアを提案するなど、ゲイツがインターフェイスの改良と統一に関して貢献したのも事実であると鈴木は証言する。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
