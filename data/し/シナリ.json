[
  {
    "uuid": "42540b8b-0087-5b4f-9d6f-f0374eb0bc30",
    "entry": "撓り",
    "reading": {
      "primary": "しなり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bending",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釣り竿の適度な撓りが、大物とのやり取りをスムーズにしてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "弓道の弓の撓りには、張り詰めた緊張感と独特の造形美がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "板の撓りを利用して、スケートボードで高いジャンプを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "江の撓り、とどまらず、また淀めば。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "棒は倒れも撓りもしません。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤蔓に頸根を抑えられた櫂が、掻くごとに撓りでもする事か、強き項を真直に立てたまま、藤蔓と擦れ、舷と擦れる。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "沈丁花、山椒、野木瓜、黐それに泉水ちかく老梅の古木が、蜿々として奇なる枝振りを、見事に撓り、屈らせてゐた。",
              "citation": {
                "source": "異版　浅草燈籠",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "撓り按排が実に美的である。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらのノブを起点として、ちょうど海星のような塩梅に長くて扁平な腕がそれぞれ五本ずつ飛び出し、それらの先端は三角形のかたちに細まって――中央の樽型から離れていく向きに若干撓りながらほぼ水平に伸びていた。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜂の尾と、ラム酒とに、世界は分解されしなり。",
              "citation": {
                "source": "地極の天使",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "開墾地宮沢賢治焦ぎ木のむらはなほあれば山の畑の雪消えて〔以下なし〕　――――――――青年団が総出にてしだれ桜を截りしなり",
              "citation": {
                "source": "開墾地",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あじの方はおよしなりますか、ごついでにいかがです、およしなりますか？",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "禍ひの神といふ者もしあらば、正しく我身さそはれしなり、此時の心何を思ひけん、善とも知らず悪しとも知らず、唯懐かしの念に迫まられて身は前後無差別に、免がれ出しなり薄井の家を。",
              "citation": {
                "source": "雪の日",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてもお父樣は幾年の前にか失せ給ひし、お前さまの親御樣なれば御年もまだお若かりしならんと問へば、いや若しといふほどにはあらず、別れしは八年の前おもへば夢のやうな別れ成しとあるに、さらば御病氣は俄の病にてやありしと、たゝみかけて問へば、何の病氣かは、我が父はこれこの池に身を沈め給ひしなり。",
              "citation": {
                "source": "暗夜",
                "author": "一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "太古の時代より天気予報の試みは行われたれども、分析的科学の発達せざりし時代には、天気を限定すと考えられし条件、あるいは独立変数が極めて乱雑なる非科学的のものなりしなり。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとき材料も場合によりてはあえて非科学的とは称し難きも、とにかく物理学的方法を応用する場合の独立変数としては不適当なるものなりしなり。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "中禅寺の湖をながめて天雲のいはひもとほる湖の上に眞白片帆の舟歸る見ゆ歌袋歌滿ちあふるなめ革のかはり袋のありこせぬかも歌袋の歌は文して格堂にからかいやりしなり。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよ、今宵よりは一時づゝの仕事を延ばして、この子が為の収入を多くせんと仰せられしなりき。",
              "citation": {
                "source": "軒もる月",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "いと恥かしうて、これ習ひ得ざらんほどはと、家に近き某の社に日参といふ事をなしける、思へばそれも昔しなりけり。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴夫人の己れと握手する事はあり得べからざるように思いおるゆえ驚きしなり。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "年若き教師の、詩読む心にて記憶のページ翻えしつつある間に、翁が上にはさらに悲しきこと起こりつ、すでにこの世の人ならざりしなり。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　その信仰や極めて確乎たるものにてありしなり。",
              "citation": {
                "source": "海城発電",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "巡査はこのところを避けんとせしなり。",
              "citation": {
                "source": "夜行巡査",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなとこ雲　東の方に築地をつきたる如く立つ白雲を、かなとこ雲といふよしなり。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまさしく伊豆の山人、野火を放ちしなり。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちあの時はただ愛、ただ感ありしのみ、他に思考するところの者を藉り来たりて感興を助くるに及ばざりしなり。",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "われをしてしばしなりとも汝においてわが昔日を観取せしめよ、わが最愛の妹よ！",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどもなお応ずる者はあらざりしなり。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗客は各々生命を気遣いしなり。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一｜艘の厄介船と、八人の厄介船頭と、二十余人の厄介客とは、この一個の厄介物の手に因りて扶けられつつ、半時間の後その命を拾いしなり。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れど之れ不思議でも何んでも無し、強いて不思議と云へば、日本武士魂なる不思議の威力ありしが為に勝ちしなり。",
              "citation": {
                "source": "警戒すべき日本",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "加ふるに当時遼東半島還附の遺恨問題あり、心ある国民は臥薪甞胆の意気燃ゆるが如く、何時かは世界第一等国民となつて、彼等を見返し呉れんと奮励努力せしが故に、十年の歳月甚だ長からずと雖も、其間に日本の国力は驚くべき発展を為せしなり。",
              "citation": {
                "source": "警戒すべき日本",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "こは後より追々にし出ださんずる悪計の、人に知られんことを恐れしなりけり。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
