        "examples": {
          "standard": [
            {
              "text": "相手の隙を突いて、瞬殺で勝負を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このゲームでは、強力な敵も瞬殺できる武器がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "試合開始わずか30秒で、チャンピオンは相手を瞬殺した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "神々しい小さな厚紙の効果は絶大で瞬殺だった。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不可触、不可視の危険性と言ったら、瞬殺と相まって、可視世界の悪者より一層たちが悪い。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            }
          ]
        }
