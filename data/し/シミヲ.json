          "literary": [
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マサカソレニハ及バンサ」「イヽワヨ、飲マセタゲルワヨ」彼女ガ薬ヲ取リニ出テ行ッタ間ニ、予ハ又一ツノ楽シミヲ考エツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "徒ラニ悲シミヲ増サセルニ過ギナイノナラ知ラセルノハ無駄ナノダカラ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何卒コノ上ハ新シイ恋人ト幸福ナ家庭ヲ持ッテ過去ノ悲シミヲ忘レルヨウニ、ソシテ再ビ同ジ過チヲ繰リ返サヌヨウニシテ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワレ知ル、五慾ノ楽シミヲ貪ルモノハ、必ズ、久シカラズシテ命終ルコトヲ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "卜い給えと乞うと、管輅、易を案じて、――午ノ刻ニ、主ノ親シキ者、猪ノ肉卜酒トヲタズサエテ、訪イ来ラン、ソノ人、東ヨリ来テ、コノ家ニ、悲シミヲモタラス。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
