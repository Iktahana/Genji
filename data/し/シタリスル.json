          "literary": [
            {
              "text": "）生ヘナイ天使ト　ヨク結婚シタリスル。",
              "citation": {
                "source": "内科",
                "author": "――自家用福音――　――或ハ　エリエリラマサバクタニ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車ヲ運転シタガッタリ拳闘ヲ愛シタリスル一面、ガラニモナク生花ガ好キデ、京都ノ一草亭ノ娘婿ガ週ニ二回、イロ／＼珍シイ花ヲ持ッテ東京ヘ出テ来テ教エルノデ、ソノ人ニ就イテ去風流ヲ習ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鞄カラ鍼ノ匣ヲ取リ出シタリ、アルコールデ消毒シタリスル細カイ作業ハ鈴木氏自身デスルケレドモ、常ニ弟子ノ一人ガ附キ添ッテウシロニ控エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシシバ／＼失敗シ、足ノ甲ヤ足ノ裏ヲタオルデ拭イタリ、塗リ直シタリスルコトガ、又タマラナク楽シカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様モ陸子モ人ヲ煽テタリ騙シタリスルコトニカケチャア昔カラ大シタ腕前ダカラナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
