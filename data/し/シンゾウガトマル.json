    "definitions": [
      {
        "index": 1,
        "gloss": "to have one's heart stop beating",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "老人は眠るように心臓が止まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "医療緊急事態では、心臓が止まってしまうことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "事故の衝撃で患者の心臓が止まり、医療スタッフが蘇生処置を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その話をきいているうちに、庸三はにわかに弱い心臓が止まるような感じだった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時は、さすがの怪奇小説家も心臓が止まる思いをしたが、すぐに、それは老人形師の子供らしいトリックであることがわかった。",
              "citation": {
                "source": "悪霊物語",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "掲示を見上げて自分の名が出ていないと、心臓が止まるような心持になる。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの場所ならそれほどでもないのでしょうが、眼ですからね、ほんとうに心臓が止まるような気持でした。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
