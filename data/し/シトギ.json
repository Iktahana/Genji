[
  {
    "uuid": "51d53612-6187-5a4f-8189-e6db4f8e7fe6",
    "entry": "粢",
    "reading": {
      "primary": "しとぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
