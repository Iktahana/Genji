          "literary": [
            {
              "text": "「マノン・レスコオ」をかいたアヴェ・プレボウ、「ポオルとヴェルジイニ」のサン・ピエール、シャトウブリアン。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャトウブリアンの孫の作家がどっかへ亡命し、ＮＲＦの或編輯は自分の頭に玉を射ちこみました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はシャトウブリアンの小説ルネエを読んで北米南部の深林に異様なる憧憬の心を持ち、何とかしてその地方へ行きたいと思って居たのですが、遂にその機会を得なかったのは遺憾でした。",
              "citation": {
                "source": "亜米利加の思出",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
