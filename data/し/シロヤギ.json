          "literary": [
            {
              "text": "白山羊と黒驢馬とは月の光に生れて偶然オレゴン杉のかげで出会った。",
              "citation": {
                "source": "黒い驢馬と白い山羊",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白山羊も暫くで黙り、一寸首を曲げた。",
              "citation": {
                "source": "黒い驢馬と白い山羊",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "向い合わせに立ったまま白山羊と黒驢馬とは、月明りの屋根の上で浮れて居る書生達の唄を聞いて居る風であった。",
              "citation": {
                "source": "黒い驢馬と白い山羊",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "白山羊は、身震いするように体を動かし、後脚の蹄でトンと月光のこぼれて居る地面を蹴った。",
              "citation": {
                "source": "黒い驢馬と白い山羊",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "気がつくと、其処とは反対の赤松の裏にも白山羊が出て居る。",
              "citation": {
                "source": "黒い驢馬と白い山羊",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
