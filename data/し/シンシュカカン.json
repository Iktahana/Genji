        "examples": {
          "standard": [
            {
              "text": "彼女は常に進取果敢な精神で、新しいビジネスチャンスを切り開いてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "困難な課題にも臆することなく、進取果敢に挑戦する姿勢が評価された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このチームは、進取果敢なメンバーが多く、常に革新的なアイデアを生み出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「日本渡航記」は榮之助の才氣横溢で、進取果敢な性格の一面も描き、一ばん下ツ端の小通詞助楢林榮七郎についても、ヨーロツパ文化を自分の眼で見たいと希望するこの青年の激しい性格をも描寫してゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
