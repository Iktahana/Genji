        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "謝源はもうシツカリ自暴自棄に陥つて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　シツカリト　カナヅチヲ　ニギリシメテ、コウババカリノ　マチヘ　マツスグ　アルイテ　ユキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "手巾を欲しがつてる癖に……と考へると、私は其手巾を蒲団の中で、胸の上にシツカリ握つてる事に気がついた。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "線香はシツカリ握つて居ました、堅く。",
              "citation": {
                "source": "雲は天才である",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し鳩胸の、肩に程よい円みがあつて、歩方がシツカリしてゐる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "智恵子は、シツカリと吉野の脱ぎ捨てた下駄を持つた手を、胸の上に組んで、口の中で何か祈祷をしながら、熱心に男のする態を見てゐた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母は相應に名のある家から嫁いで來た人で、年はとつても未だシツカリして居りました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「国に居る人が枕頭へ出て来るなんて――馬鹿な――シツカリしろ。",
              "citation": {
                "source": "出発",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "お鶴はシツカリした体格の女で、肩幅などは下手な男に劣らないほどであつた。",
              "citation": {
                "source": "燈火",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奥様、シツカリと私の肩へつかまるやうに成さいまし。",
              "citation": {
                "source": "燈火",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の手にシツカリと枝を握つて、右の手では、近まはりの柿の實を撫でり取るのが可哀さうにも思はれて來たのである。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "其代りに三十歳から四十歳になると、其の途中で放蕩をし無いで眞面目にやつて行けば、前にシツカリ學問をしたお蔭で、ドシ／＼と報酬額が増して來るのである。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稻造",
                "note": "青空文庫"
              }
            },
            {
              "text": "気をシツカリ持つて、おいしい物をターンと食べる事どす。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……でも、そいつは、君が君の芸術を唯無意識に本能的にばかり押し進めて来てゐて、シツカリと自分の芸術の立つべき地盤に就て意識的に……つまり、もつと理知的に考えてゐなかつた点に理由が有るんぢやないかな。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそれが、まだ大人にもなりきらないのに、それぞれシツカリやつてゐるんだ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利男　……母さんが、もう少しシツカリしてゐて、代り合つて看病でもしてくれるといゝんだけど……。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（自分の両手はふところをシツカリおさへてゐるので香代にされるまゝ）（間。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれにしたつて俺達の方でシツカリしてゐるかどうかで、成り行きも決る。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云つたから、忠治時分は野蠻だつたからよかつたのだ、あの時分から見るともうみんな大家になつてゐますからといふと、シツカリせねばならんですねと大河内君が云つた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜんたい庄造は兎に角として、シツカリ者と云はれるおりんにそのくらゐなことが見えない筈はないのだけれども、今度は慾が手伝つたので、つい無理な細工をしたのかも知れない。",
              "citation": {
                "source": "猫と庄造と二人のをんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
