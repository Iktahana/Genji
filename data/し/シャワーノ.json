          "literary": [
            {
              "text": "コレモ去年大改造ヲ施シ、水槽カラ何カラ何マデタイル張リニシ、シャワーノ設備ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーノ音ガシャー／＼聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシシャワーノ時ダッテ、コヽヲ締メタコトハ一度モナイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシシャワーノ時ダッテ、コヽノ戸締マリヲシタコトハナイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーノ音ガ聞エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「這入リタインデショウ」「別ニ用モナインダケレドネ」「ソレ／＼、興奮スルト滑ッテ転ブワヨ、落チ着イテ、落チ着イテ」今ハ下司板ガ上ゲテアッテ、タイル張リノ床ガシャワーノ水デビショ／＼ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナラ用ヲサセタゲルワ」シャワーノ音ガ止マッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャワーノ音ガシテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ接吻サセタゲルワ」シャワーノ音ガ止ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ浴室ハ予専用ノタイル張リニシテ、シャワーノ設備ヲスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「有楽座ヘ行キマスノ、失礼シチャウワネ」ソウ云エバシャワーノ季節ガ過ギテカラ、長イコト春久ノ奴姿ヲ見セナイガト、チラト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
