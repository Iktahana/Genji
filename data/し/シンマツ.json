        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こゝを以て賽児の徒｜忽にして跡を潜むと雖も、若し秦末漢季の如きの世に出でしめば、陳渉張角、終に天下を動かすの事を為すに至りたるやも知る可からず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "范増（中国、秦末の知将。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "※通（中国秦末から前漢初期にかけての説客）が韓信（前漢の武将）に説く条に骨と肉と気との事を語っているが、人の骨格や肉付きの他に気と云うものがみえる。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
