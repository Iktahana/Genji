        "examples": {
          "standard": [
            {
              "text": "赤ちゃんに名前をつけ、生後14日以内に市役所へ出生届けを提出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "出生届けを受理した職員から、お祝いの言葉をかけられて胸が熱くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "出生届けのコピーは、児童手当の申請など様々な手続きで使用する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "まことにむずかしい名前ばかりつけたもので、今ならば、区役所で、出生届けを突き返されてばかりいなければならない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
