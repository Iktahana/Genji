  {
    "uuid": "deb3742d-5506-593c-a998-81d69142122a",
    "entry": "シタリ",
    "reading": {
      "primary": "したり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と昌作はシタリ顔。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と昌作はシタリ顔に拗ねる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "此間理論上天皇ハ凡テノ土地ト人民トヲ私有財産トシテ所有シ生殺與奪ノ權ヲ有シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ天皇ハ第一期ノ意義ニ代フルニ、此等小君主ノ盟主タル幕府ニ光榮ヲ加冠スル羅馬法王トシテ、國民信仰ノ傳統的中心トシテノ意義ヲ以テシタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ同時ニ宮中ノ廓清ヲ決行シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ大西郷等革命精神ノ體現者世ヲ去ルト共ニ單ニ附隨的ニ行動シタル伊藤博文等ハ、進ミタル我ヲ解セズシテ後レタル彼等ノ貴族的中世的特權ノ殘存セルモノヲ模倣シテ輸入シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ國民教育ノ根本的革命ハ戒嚴令施行中ヨリ實施スベキ者ナルヲ以テ、現時ノ校舍ヲ直チニ使用スベキコトヲ明示シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ戰爭中日本ノ朝鮮ニ於ケル立場ハ英國ノ自耳義ニ於ケル如クナラズ、朝鮮全部ヲ掩有スルニ實力ヲ以テシタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "基督其人スラ彼レノ弟子等ニ向ヒテ明カニ「我ガ神」「汝ノ神」トシテ神其者ニ自他彼此大小高級ヲ差別シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "驕兒「カイゼル」ハ世界的排斥ニ反省セズシテ陷穽ニ墜落シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ亞細亞文明ノ希臘トシテ已ニ強露波斯ヲ「サラミス」ノ海戰ニ碎破シタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「本艦ハ唯今、×国ノ商船隊ト覚シキモノヨリ発シタル無線電信ヲ受信シタリ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "已ニシテ千六百二十年七月、ぶるうすたあ、ぶらうどふおーど、及ビまいるす・すたんでつしゆノ三名ハ先発隊トナリテ和蘭ヲ去リ、英国さうざんぷとん港ニ到リ、倫敦ヨリ来レル一味ノ人ヲ併セテ、八月五日『五月花』号ニ搭ジテあめりかヘト出帆シタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　カゲモ　ヨロコンデ、トンダリ、シツポヲ　クルクルト　フリマワシタリ　シテヰマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、果断ヲ以テ人民ノ通義ヲ破ラント欲シ、屡々国民ノ会議局ヲ廃シタリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、此国ニ裁判ノ権ヲ附与スルヲ拒テ裁判局ヲ廃シタリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、我法律ニ戻リ、我政治ニ異ナル一殊ノ政ヲ以テ我人民ヲ制伏セント欲シ、徒党ヲ結テ其党ノ議定シタル偽法ヲ許シタリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを知っているのは、オノブサンと私だけ、ほかの女中は知りません」　と、ツネは意味深長にシタリ顔をして笑った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その五　万引家族",
                "note": "青空文庫"
              }
            },
            {
              "text": "（６）怡然自樂ノ怡モ樂シムコトナレド、同ジ譯語ヲ用フル事能ハザレバ、少々區別シ、「怡」ノ尤近キハ調和ノ和或ハ調ナレドモ、コレヲ如何ト思ヒ、心やすらげに見ゆト譯シタリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾来交情親善、曾テ調所内ノ一宇ヲ借リ君ト同居シ、又同シク下谷ニ住シ、後｜和蘭国ニ留学ノ日亦同シク霊田ニ住シ、霊田大学法学教授法学博士ヒツスセリング氏ニ就テ欧洲政学ノ要ヲ聞キ、余暇互ニ議論ヲ闘ハシタリ。",
              "citation": {
                "source": "西周伝",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイ……トフヱヲ　ナラシテ、シロイ　ケムリヲ　　　　ダシタリ、クロイ　ケムリヲハイタリ、テッキヨウヲ　ワタッテ、トンネルヲ　ヌケテ、マタトンネルヘ　ハイッテ、ドンドン　ハシッテ　ユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ当初稿ヲ脱セシ時ヨリ既ニ半歳ヲ過ギ一時｜蒐集シタリシ資料ノ今｜蚤クモ座右ニ留メザルモノマタ鮮シトナサズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "集中ニハ花ニ月ニ唱和シタリシ作十ノ六、七ニ居ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因テ二、三ノ従游スルモノト相謀リ諸家ノ麗藻ヲ選ンデ梓シテコレヲ伝ヘントシタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ハ楊維禎ガソノ山水ニ放浪シテ白衣身ヲ終フルニ比シ、一ハ陳其年ガソノ詞場ニ跋扈シ美髯名ヲ得タルニ比シタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
