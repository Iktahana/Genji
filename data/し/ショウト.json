        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "前髪に蝶結びのリボンを巻いた踊子の意気姿、かの女はもとよりショウト・スカウト、ハイヒール、流行色の粧いが艶やかだ。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その掛ける柱をこの地方では竈男と言い、その面をばヒョウトク、あるいはショウトクなど呼んでいる。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "棒寄せの呪文は、人によりて同一ならざるがごとしといえども、ある者の伝うるところによるに、「ショウトクオウガキミニセカレテ」と申す語を用うるなり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木氏曰ク、非常ニ忙シイノデ拙宅ヘオ越シ下サルコトヲ望ムガ、往診ノ場合ハ週ニ三回ニシテ戴キタイ、拝見シナケレバ分ラナイガ、オ話ノ様子デハ多分治癒出来ルト思ウ、二三カ月ハカヽルデショウト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地捜シヨリハソノ方ガ優シダ、私ガ御案内シマショウト京二郎ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は私娼のことをショウトルピーと呼んでいた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのショウトルピーの奴！",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
