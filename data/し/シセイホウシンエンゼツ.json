        "examples": {
          "standard": [
            {
              "text": "首相の施政方針演説は約1時間半続いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "今年の施政方針演説で少子化対策が強調された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "新しい総理大臣の施政方針演説が好評だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "日本の新首相が施政方針演説もしないで公務員法案を押しきろうとすることは、古い政治家の厚顔な腹の力かもしれないけれども、アメリカの大統領選挙の生々しい教訓は、日本のわたしたちにも少くない分量の真実を学ばせた。",
              "citation": {
                "source": "現代史の蝶つがい",
                "author": "――大統領選挙の感想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田再開議会でつめよられているのに施政方針演説をせず、やたら公務員法案を通そうとばかりしている。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
