        "examples": {
          "standard": [
            {
              "text": "同じ制服を着ることで、社員同士の連帯感と集団意識が高まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "強い集団意識は組織の団結力になるが、時に排他的な態度を生むこともある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "災害時には「みんなで助け合おう」という集団意識が、困難を乗り越える原動力になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "芸術家のエスプリにあたるものが、ここでは集団意識の盛上りに外ならない。",
              "citation": {
                "source": "現代美学の危機と映画理論",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "なおＧ・ル・ボンの諸著述は集団意識の論理を取扱っている（例えば Les Opinions et les Croyances）。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
