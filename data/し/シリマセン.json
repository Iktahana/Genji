            },
            {
              "text": "」「サア、ソレハ　カアサンモ　シリマセン。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サア、ソレモ　シリマセン。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハソンナコトハシリマセンカラ大トクイデス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、いきなりキジマツトムハ、キミヲシリマセン、エイエンニ、キミヲキミダト、シラナイソシテ、カレハ、ジンセイヲシリカミトナツテ、ショウテンスル、キミニ、シュクフクアレ、ココロカラ、アリガトウＧ「そのＧと言うのが、Ｍさんと言う人じやない？",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
