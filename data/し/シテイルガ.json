          "literary": [
            {
              "text": "腰椎モ変形シテイルガ、コノ方ハ頸程デナイト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガ心配シテ毎日予ヲ仰向ケニ臥カセ、膝ヲ交互ニ組ミ合ワサセテ脚気ノ検査ヲシテイルガ、脚気デモナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "如来ノ坐像ハイズレモ男性的ニ結跏趺坐シテイルガ、コノ勢至菩薩ハ女性ラシク両膝ヲ揃エテ坐ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ、「コノゴロ僕ノ在宅ノ時ニ妻ガ外出シテイルガアルカラ彼女ヲ連レ出シテ二三時間過シテ来テクレ」ト云ッタカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ重ナリ工合ヤ歪ミ工合ハゴク僅カデ、動作ニ不便ヲ感ズルホドノコトハナク、人ニ気付カレルコトモナイノデ、今日マデソノママニシテイルガ、アノ日カラズット、今モソノ状態ガツヅイテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
