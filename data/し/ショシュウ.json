        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この論文は、その学会誌に所収されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の作品の多くは、この選集に所収されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その情報源は、有名な百科事典に所収されているため信頼できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "（明治四五・六・八―一〇稿／「スバル」明治四五・七／『畜生道』所収）",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正二・一稿／「スバル」大正二・二／『畜生道』　所収）",
              "citation": {
                "source": "公判",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "（「大国民」　大正二・一〇／『遺稿』所収）",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正二年十月十一日作／『文章世界』　大正二・一〇／『遺稿　所収）",
              "citation": {
                "source": "夜烏",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正元・九・四／「スバル」四巻一〇号　大正元・一〇／『畜生道』　所収）",
              "citation": {
                "source": "計画",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正元・八・一四稿／「スバル」四巻九号大正元・九／『畜生道』所収）",
              "citation": {
                "source": "畜生道",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "（歌集『四十女の恋』所収　大正二年）",
              "citation": {
                "source": "鎖ペンを握って",
                "author": "――三月十九日夜――　　山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　略年譜作成にあたり、『日本の詩歌　3』（中央公論社）所収の上田三四二氏による年譜を参照させていただいた。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "――大正十五年（一九二六年）『文藝戦線』十一月号所収『逃走』改題――",
              "citation": {
                "source": "駈落",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Won't it be wonderful when we both have a dynabook.（ぼくら二人がダイナブックを持てるようになったら素敵だね）」（「アラン・ケイ」所収『評伝アラン・ケイ―本当の予知能力とは何か』）　そうか、浜野さんにはそう見えるのか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国で出たハムポルト文庫所収の何かの書に出あったが、今この宅にないから書名を挙げ得ぬ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和三十一年二月、青蛙房刊『綺堂劇談』所収「甲字楼夜話」より）",
              "citation": {
                "source": "怪談劇",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正一四・二・演芸画報）（昭和三十一年二月、青蛙房刊『綺堂劇談』所収「甲字楼夜話」より）",
              "citation": {
                "source": "小坂部伝説",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十一年二月、贅六堂刊『風俗江戸物語』所収）",
              "citation": {
                "source": "江戸の化物",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（甲賀三郎『琥珀のパイプ』春陽堂、一九二六年六月、所収）",
              "citation": {
                "source": "甲賀三郎『琥珀のパイプ』序",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "（掲載誌不詳、『十番随筆』所収）※　旅つれづれ昔の従軍記者　　　　　＊　××さん。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和12・８稿・『思ひ出草』所収）苦力とシナ兵一　昨今は到るところで満洲の話が出るので、わたしも在満当時のむかしが思い出されて、いわゆる今昔の感が無いでもない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（掲載誌不詳、『十番随筆』所収）春の修善寺　十年ぶりで三島駅から大仁行きの汽車に乗り換えたのは、午後四時をすこし過ぎた頃であった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正十二年十月追記『十番随筆』所収）旅すずり（一）心太　川越の喜多院に桜を観る。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わびしさや袖の焦げたる秋の雛（『十番随筆』所収）震災の記　なんだか頭がまだほんとうに落着かないので、まとまったことは書けそうもない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和12・10刊『思い出草』所収）風呂を買うまで　わたしは入浴が好きで、大正八年の秋以来あさ湯の廃止されたのを悲しんでいる一人である。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十二年二月十一日稿『沖縄新聞』所載、『琉球古今記』所収「空道について」参照）",
              "citation": {
                "source": "沖縄人の最大欠点",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十五年十二月（『少年科学探偵』文苑閣、一九二六年一二月、所収）",
              "citation": {
                "source": "『少年科学探偵』序",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "（『現代大衆文学全集』第七巻、平凡社、一九二八年三月、所収）",
              "citation": {
                "source": "『小酒井不木集』はしがき",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "（春陽堂『明治大正文学全集』第八巻昭和四年二月所収）",
              "citation": {
                "source": "探偵物語の処女作",
                "author": "黒岩涙香",
                "note": "青空文庫"
              }
            },
            {
              "text": "文芸の省察としての文芸学が、こういう意味に於て認識論にぞくさねばならぬ所以も、かつて説いた（「認識論としての文芸学」〔本全集第四巻所収〕）。",
              "citation": {
                "source": "哲学の現代的意義",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "★前出『ワークステーション原典』所収、セッション４のディスカッションにおいて、エンゲルバート自身がこの論文に出合った経緯とそのことの自分にとっての重みに関して言及している。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "★『ザ・コンピュータ』（ソフトバンク）一九九〇年六月号、「ＫＥＹＭＡＮ ＵＳＡ　次世代のコンセプターが考えている明日」所収のアラン・ケイへのインタビュー。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "★パラメトロンの誕生の経緯は、『日本のコンピュータの歴史』（情報処理学会歴史特別委員会編、オーム社、一九八五年）所収の「パラメトロン計算機ＰＣ―１とＰＣ―２」に、後藤英一自身によって記録されている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "★ＩＢＭとの特許問題に関する経緯は、前出の『日本のコンピュータの歴史』所収「特許問題とＩＢＭ特許契約」（宮城嘉男）に、明快にまとめられている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
