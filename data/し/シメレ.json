          "literary": [
            {
              "text": "ヘンリ・シメレの監督で、仕事は大いに捗っているようだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "所で、うちのヘンリ・シメレ君は斯うした彼の種族一般と何処か違っている。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "穏和な、我がへンリ・シメレも今日、「浜（アピア）の白人は厭だ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "通訳はヘンリ（シメレ）。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘンリ（シメレ）が実に良く働いて呉れる。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            }
          ]
