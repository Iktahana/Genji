        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "とんでもないシンデレラ姫。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "タンス、鏡台、トランク、下駄箱の上には、可憐に小さい靴が三足、つまりその押入れこそ、鴉声のシンデレラ姫の、秘密の楽屋であったわけである。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、王子さまのいないシンデレラ姫。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラ姫の物語を考えついた人は、よっぽど、お話にもなにもならないほど、不仕合せな人なのだ。",
              "citation": {
                "source": "喝采",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "家人｜謹シンデ、ソノ言ニ遵フ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ　ウグヒスハ　オカアサンウグヒスデ、センダツテノ　コト、ボウヤノ　ウグヒスヲ　ナクシタノデ、タイヘン　カナシンデ　ヰタノデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔から可哀そうな少女のお話の女主人公は継娘ときまっていて、ヨーロッパにも「シンデレラ」の物語がある。",
              "citation": {
                "source": "女の手帖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "物語の終りは、そのようにいじめられた落窪の姫に思いもかけない立派な愛人が出来て、堂々とした生活をするようになる、一種の「シンデレラ物語」であるけれども、ここでまた私たちの目をひくのはこの落窪の姫が非常に縫物が上手で家中の者の縫物をやらせられるという点である。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハソノ間苦シミニ苦シンデ居タヨウデシタガ、ソノ中、清三ガ意識ヲ復シテ動クヨウデシタカラ、思イ切ッテ、道子ノ心臓ト思ウトコロヲ一刺ニ刺シテ此ノ女ヲヤッツケテシマッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラめいたもの、イソップめいたもの、そのどれもこれもが一向に何の反響もない。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら笑っていても日本女は英国人の愛するお伽噺の女主人公美しきシンデレラではなかった。",
              "citation": {
                "source": "ロンドン一九二九年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "真常流注、外｜寂ニ内｜揺クハ、繋ゲル駒、伏セル鼠、先聖コレヲ悲シンデ、法ノ檀度トナル……」　弁信が物々しく、あらぬ方に向って拝礼をしました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この神尾も、この歳になってはじめて手習をはじめている――友達がたずねて来たのを、熊の子じゃあるまいし、檻の内と外で、世間話を聞いて頼シンデいたがイイ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合楽しんでと書くより、頼シンデと書いた方が気分が出ている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、いいつかったしごとをすませると、いつも、かまどの前にかがんで、消炭や灰の中にうずくまっていましたから、ままむすめの姉と妹は、からかい半分、サンドリヨン（シンデレラ）というあだ名をつけました。",
              "citation": {
                "source": "灰だらけ姫",
                "author": "またの名「ガラスの上ぐつ」",
                "note": "青空文庫"
              }
            },
            {
              "text": "美は常に、何か賤しいものが宮殿にまぎれ込む夢のようなもの、シンデレラ姫のようなものとなった。",
              "citation": {
                "source": "現代美学の危機と映画理論",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "象徴主義の芸術は、まだ多かれ、少なかれ、この神の宮居をあこがれて、その中にまぎれ込むところのシンデレラ姫のように、この宮殿の中に、いやしい下婢が入り込むには、まことに、もったいない魔術が入り用なのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラ姫についた妖婆がそれである。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのためみんな少女を『灰むすめ』とよびましたが、ちょっとべんきょうのできる下の方の姉が、もうすこしきれいな名まえでよぼうと、『灰かぶりひめ』といういみの、『シンデレラ』という名まえをつけました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラは灰だらけで、きたなくみえたかもしれませんが、ほんとうの顔は姉たちより百ばいもりりしかったのです。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラのいえの、ふたりの姉も、服がきれいでひときわ目立っていたので、もちろん声がかかりました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、シンデレラにしてみれば、めんどうなことがひとつふえただけでした。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのも、姉たちのはだぎをアイロンがけしなくちゃならないし、フリルをつけなくちゃいけない、ぜんぶシンデレラのしごとなのですから。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラも服えらびによばれ、どんなかっこうがいいかしら、とふたりにきかれました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "じつは、シンデレラはとてもセンスがよくて、ふたりのきる服をいつもアドバイスしたり、あたまをきれいにかざったりしていたのです。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからふたりの姉は、こぞってシンデレラをよびました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンデレラが服をかざっていたときに、ふたりはいいました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シンデレラ、あなたもダンス・パーティに行きたくなくて？",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しかしシンデレラは、かなしそうにほほえんで、いいました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そういうシンデレラに、ふたりはこうかえしました。",
              "citation": {
                "source": "シンデレラ",
                "author": "CINDERELLA, OR THE LITTLE GLASS SLIPPER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
