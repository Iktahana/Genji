        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "尤モ劇場内ハ冷房シテイタガ、コノ冷房ガ予ニハ禁物ナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子モ陸子モ予トハ反リガ合ワナイデ喧嘩バカリシテイタガ、ヤハリ声ヲ挙ゲテ泣ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月々ノ家計ハ数年前マデ婆サンガ処理シテイタガ、イツカラカ颯子ガ当ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ今度ノ京都行ヲカネテカラ楽シミニシテイタガ、京都滞在中ニ一日オ暇ヲ戴イテ奈良見物ヲサセテクレト云ッテイタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ハ茶ノ間デ妻ヤ敏子トシバラク話シテイタガ、三時過ギニ「麗しのサブリナ」ヲ見ニ行クト云ッテ、三人デ出カケタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻ハイクラカ青イ顔ヲシテイタガ、酔ッタ様子ハ見エナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………妻ノ外出時間ガ昨日アタリカラ変更サレルノデハナイカト、カネテ僕ハ豫期シテイタガ、果シテソノ通リデアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
