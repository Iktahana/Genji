  {
    "uuid": "85e5daf8-ec78-5c08-89d4-ee8ff90e2a4d",
    "entry": "仕立て物",
    "reading": {
      "primary": "したてもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
