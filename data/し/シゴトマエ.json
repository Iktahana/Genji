          "literary": [
            {
              "text": "暗い店の中には、仕事前だれをかけて、鳥打帽子をかぶつた老人が鋏をつくつてゐた。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さて、仕事前の一服と……。",
              "citation": {
                "source": "奇賊悲願",
                "author": "烏啼天駆シリーズ・３",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事前、宮へ手紙かく。",
              "citation": {
                "source": "日記",
                "author": "一九五〇年（昭和二十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "商売柄よく旅行をしますが、仕事前に出される軽食と言うと僕は必ず蕎麦を注文します。",
              "citation": {
                "source": "麺くひ",
                "author": "桂三木助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
