[
  {
    "uuid": "f5d29ce3-6747-5e50-a50f-a4e571f6e759",
    "entry": "就眠",
    "reading": {
      "primary": "しゅうみん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
