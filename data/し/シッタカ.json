[
  {
    "uuid": "18ff76c5-8c05-55d1-8a32-a6025938da1e",
    "entry": "知ったか",
    "reading": {
      "primary": "しったか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お前の復讐は、もう私よく思い知ったから、あちらへお行き。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがしかしこの事実を知ったからとて、何をなさって下さるにも及びません。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなにせものばかりで、知ったかぶってごまかして、わずかの学問だか主義だかみたいなものにこだわってぎくしゃくして、人を救うもないもんだ。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "「下郎、思い知ったか。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と知ったかぶりして鞄を持直し、さっさと歩き出したら、其のとき、闇のなかから、ぽっかり黄色いヘッドライトが浮び、ゆらゆらこちらへ泳いで来ます。",
              "citation": {
                "source": "老ハイデルベルヒ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」なぞと、知ったかぶりをして、けれども私は暗い気持であった。",
              "citation": {
                "source": "デカダン抗議",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして私の名前や、それから二十三歳だという事まで知ったか、手紙でお知らせ下さい。",
              "citation": {
                "source": "恥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "観念だけの生活で、無意味な、高慢ちきの知ったかぶりなんて、軽蔑、軽蔑。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉に訊いたら、あるいは消息を知ったかも知れないが、薄情を怒るどさくさ紛れに、つい訊くのを忘れたのを今更残念に思うものの、取って返して訊き直すこともならない。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は恥辱の観念が、人間に取って、死よりも苦しみなのを知ったか。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恥に攻められる人間は、冷たい死を寝床のようにも慕うものであることを知ったか。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "冴子がクリスチャンでなかったことを知ったからではない。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それではまるで轡川の弁護をしている様なものであって、ぼくの意にそぐわないこと甚しかったが、そんなことを言い出したのは、そういう知ったか振りなことを言ってみたい虚栄心からだったのだろう。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった今先、女は彼に三十六歳で始めて女の身体を知ったかの様な感銘を与えたのである。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、悪い、と知ったから、それっきり、私も何にも言いはしなかった。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黙って聞いていれば何事も無かったのに、照子｜様が、それ御存じの知ったかぶりだ。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度浄土宗の信者が他力本願に頼る以上は、なまじっかの小才覚や知ったかぶりを棄てて仕舞わなければならないようなものである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつの間に知ったかと思われるほどである。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔気質のマッカラムが記憶しているのは、教師の目には知ったかぶりでかたくなに映ったジョブズの表情と、彼の強引な物事の進め方だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが木部だったら、出す物の一つ一つに知ったかぶりの講釈をつけて、葉子の腕まえを感傷的にほめちぎって、かなりたくさんを食わずに残してしまうだろう。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子はあまりにわかりきった事を医師がさも知ったかぶりにいって聞かせるようにも、またそののっぺりした白い顔が、恐ろしい運命が葉子に対して装うた仮面で、葉子はその言葉によってまっ暗な行く手を明らかに示されたようにも思った。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "英膳、悲しい別れをそちも泣いてつかわせ」　ひと目でことの仔細を知ったか、早矢の達人の目にも、キラリ露の雫が光りました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くも強敵と知ったか、たじたじとなってうしろに引いたのを、「わッははは。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "千之が遺恨の刃、思い知ったか」「そ、そうか！",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいまそちらへ参りまするでござります」　きき知ったか、奥の仕事べやから、両手をどろまみれのままで、当の藤阿弥がいかにも名ある人形造りらしい風貌をたたえながら、取り次がぬ先に姿をみせましたものでしたから、こわきにしていた髪の毛をつきつけると、鋭く問いただしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "京人形大尽",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の巻き羽織を見て早くもそれと知ったか、顔色変えながらへたへたとそこへ手をついたのを、至極｜鷹揚にいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "門前のつり鐘を打ちのめす意気合いで、みごとに恨みを晴らしてしんぜられよ」　なんじょう黙山の今はちゅうちょすべき、かわいい声をふりあげると、姉上兄上ふたりのかたき思い知ったかとばかりに、大きく袈裟掛けに二太刀切りさげました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "耳のない浪人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では、きさまらも一つ穴の浪人上がりじゃな」「今はじめて知ったかッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "耳のない浪人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
