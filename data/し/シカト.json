        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は上司の指示をシカトして、自分のやり方で仕事を進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "挨拶したのにシカトされたから、ちょっと気分が悪かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おい、シカトするなよ！ちゃんと話を聞け！」と彼は怒鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私は外へ行かぬことにシカト約束を諦めて、二足三足歩むと隣りの店の前へ参り升た。",
              "citation": {
                "source": "黄金機会",
                "author": "若松賤子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ心シテ諸準備御急ギ召サルベク安藤対馬シカト命ジ置キ候」　筆をおくと凛として言った。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
