          "literary": [
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　毎日毎日、雪が降り続ける。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　お爺さんにとつて、こんな、がむしやらな情熱を以て行動するのは、その生涯に於いて、いちども無かつたやうに見受けられた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　まさか、これを口に出して歌ひながら捜し歩いてゐたわけではない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　毎日毎日、雪が降り續ける。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタキリ　スズメオヤドハ　ドコダシタキリ　スズメオヤドハ　ドコダ　まさか、これを口に出して歌ひながら搜し歩いてゐたわけではない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ハ予ニチョット挨拶シタキリ、茶ノ間デ婆サント何カ頻リニ話シ込ンデイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先月行カシタキリナノデ許サナイ訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝室ニ横臥シタキリデ佐々木ガ毎日附キヽリデ看護シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルベク安静ニト云ウノデ、寝室ニ横臥シタキリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
