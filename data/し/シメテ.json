  {
    "uuid": "bf9cde99-1c3c-5a8a-84df-74c018b63e2d",
    "entry": "シメテ",
    "reading": {
      "primary": "しめて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソシテ　シツカリト　カナヅチヲ　ニギリシメテ、コウババカリノ　マチヘ　マツスグ　アルイテ　ユキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ニ私兵ヲ養ヒテ私利私欲ノ爲ニ攻伐シツツアル現代支那ガ政治的ニ統一セル者ト云フ能ハザル如ク、鐵道電信ノ如キ明白ナル社會的機關ヲスラ私人ノ私有タラシメテ甘ンズル米國ハ金權督軍ノ内亂時代ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地主ト投機商人トノ有スル大資本ガ米穀ノ買占メ賣惜ミヲ自由ナラシメテ現時ノ米價騰貴ヲ現出シツツアルヲ見ヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家生産ノ勞働者ニ利益配當ヲ用ヒザル所以ハ、國家ハ全生産ノ永遠的經營ヲ本旨トスルガ故ニ、全國家ノ生産的活動ノ爲ニ或省ニハ殊更ニ投賣ヲ行ハシメテ損失ヲ顧ミザルコトアル如ク、或ル省ヲ犧牲トシテ或省ノ對外競爭ヲ專ラナラシムルコトモアルベキヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等ノ使命的勞働ヲ廢セシメテ全ク天性ニ合セザル勞働ヲ課スルハ、啻ニ婦人其者ヲ殘賊スルノミナラズ、直ニ其ノ夫ヲ殘賊シ其子女ヲ殘賊スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "學制ヲ根本的ニ改革シテ、十年間ヲ一貫セシメ、日本精華ニ基ク世界的常識ヲ養成シ、國民個々ノ心身ヲ充實具足セシメテ、各其ノ天賦ヲ發揮シ得ベキ基本ヲ作ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "更ニ他ノ一理由ハ日本ノ將來ハ陸上ニアルト同一以上ノ程度ニ於テ海上ニ在ルガ故ニ、國民教育ニ於テ只陸軍的模倣ヲナサシメテ海兵的訓育ヲ閑却スルコトノ矛盾ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、政事ノ自由ト云ヘバ、其国ノ住人ヘ、天道自然ノ通義ヲ行ハシメテ、邪魔ヲセヌコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、政事ノ自由ト云ヘバ、其国ノ住人ヘ、天道自然ノ通義下ニ詳ナリヲ行ハシメテ、邪魔ヲセヌコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　平常カラ私ノ愛シテ居ル女ヲ苦シメテ居タ事ガ実ニ憎イノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "政府当局ガ陛下ノ地ト人トヲ把テ如此キノ悲境ニ陥ラシメテ省ミルナキモノ是レ臣ノ黙止スルコト能ハザル所ナリ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦死者共同墓地は、フランス軍のはシメティエ・ナシオナールという名が付いている。",
              "citation": {
                "source": "ヴェルダン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロマーニュにはシメティエ・アメリケエン（米軍共同墓地）があり、付近にはシメティエ・アルマン（独軍共同墓地）が二つほど見られた。",
              "citation": {
                "source": "ヴェルダン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ、軍人ト軍隊ト軍部トヲ混同セシメテハナラヌ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、我諸州ニ内乱ヲ起サシメテ、我州内ノ人民ヲ印度ノ野人ト同様ニ御セント欲スレドモ、印度人殺伐不仁ノ戦ト之ヲ同日ニ論ズ可ケンヤ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "余矢田少属ヲシテ答ヘシメテ曰ク先ヅ遠田志田登米ノ版籍ヲ収メテ然ル後栗原ニ※バントス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "政府当局ガ陛下ノ地ト人トヲ把テ如此キノ悲境ニ陥ラシメテ省ミルナキモノ、是レ臣ノ黙止スルコト能ワザル所ナリ」　かく政府の無為を糾弾して聖明に訴えたのち、さらに救済の方途を述べて、「伏テ惟ルニ、政府当局ヲシテ能ク其責ヲ竭サシメ、以テ陛下ノ赤子ヲシテ、日月ノ恩ニ光被セシムルノ途他ナシ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "続日本紀をお読みになったことはありませんか、あの中の延暦十七年の条に、太政官の法令として――自今、僧侶ノ子ハ一切｜還俗セシメテ以而、将来ヲ懲ス　――と出ているのを見ても思い半ばに過ぎるものがございましょう。",
              "citation": {
                "source": "親鸞",
