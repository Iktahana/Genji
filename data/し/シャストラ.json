        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『記』にまたいわく、猴王作ったてふマントラ・シャストラ（神呪論）を講ずれば力強くて神のごとくなるという。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャストラルで、村長は彼を訪れてきて途を引き返すように勧めた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　司教がシャストラルに帰っていった時、またその途中でも、人々は出てきて不思議そうに彼をながめた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はシャストラルの主任司祭の家に、彼を待っていたバティスティーヌ嬢とマグロアールとを見い出した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
