        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「京伝は俗物、一九は洒落者、そうして三馬は小皮肉家。",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴎外博士の作物の缺點は、とりすましと、小皮肉とであつた。",
              "citation": {
                "source": "詩と散文との間を行く發想法",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
