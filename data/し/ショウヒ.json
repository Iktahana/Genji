[
  {
    "uuid": "7c160428-c3d9-5b58-90e1-6435bcd232c0",
    "entry": "消費",
    "reading": {
      "primary": "しょうひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞"
      ],
