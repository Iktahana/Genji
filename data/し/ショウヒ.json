  {
    "uuid": "83bada7a-fe63-561e-95a6-89d27a89d73f",
    "entry": "小皮",
    "reading": {
      "primary": "しょうひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
