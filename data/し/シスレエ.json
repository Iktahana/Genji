          "literary": [
            {
              "text": "幾百と云ふ蔵幅は大抵モネ、ピサロオ、セザンヌ、シスレエ、ドガア、ルノワアル等近代名家の作家の作品で満ちて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シスレエが珍らしく屋内の人物を描いた「鍛冶屋」や、マネが最初に物議を惹き起した「草の上の昼飯」などもあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはシスレエの型を取つて拵へたのです。",
              "citation": {
                "source": "七月七日",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
