[
  {
    "uuid": "7220e1a2-6cd5-5d83-8ecb-e180cd9f74af",
    "entry": "諸軍",
    "reading": {
      "primary": "しょぐん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
