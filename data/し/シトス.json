        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "實ニ貴族ノ土地徴集ヲ決行スルニ、大西郷ガ異議ヲ唱フル諸藩アラバ一擧討伐スベキ準備ヲナシタル先哲ノ深慮ニ學ブベシトスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "計略ハ密ナルヲ良シトスだの、敵ヲ図ラントスレバ先ズ味方ヲ図レなどという格言は紅国軍部といえどもよく心得ているのであった――というような結末まで、ゆっくり探偵小説に書いていると、いくら枚数があっても……。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "古銭ノ如ク紀元ヲ書セシ物ハ、一目瞭然ニ知ル可シトス。",
              "citation": {
                "source": "好古小言",
                "author": "※上漁史",
                "note": "青空文庫"
              }
            },
            {
              "text": "古來ヨリ此別燦然觀ルベシトス。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "「凡ソ物ノ声、大抵隔ツテ聴クヲ好シトス。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ヤ山水ノ清秀以テ酒妓ノ興ヲ佐ル有テ而シテ後以テ遺憾無シトス可シ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ耳目ヲ憚リソノ人ヲ難シトス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "人倫ノ大ナルハ、父子ヲ先トシ、尊卑ノコトナルハ、君臣ヲ重シトスト。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
