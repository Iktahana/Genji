          "literary": [
            {
              "text": "塩俵を負って腰を曲めながら歩いて行く農夫があった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "お縫はトウトトとよびながら、先ず玉蜀黍の実をまいてやり、どこかへ運ぶ塩俵のつんであるねこぐるまの置いてあるわきの丸っこ石の上で貝殼を叩き砕いては、小舎の中へなげた。",
              "citation": {
                "source": "猫車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、同八日の夜、或る人六人居り、車座におり候に、塩俵天井の下たにふわり／＼として、其人の真中へ落。",
              "citation": {
                "source": "三次実録物語",
                "author": "稲生武太夫",
                "note": "青空文庫"
              }
            }
          ]
        }
