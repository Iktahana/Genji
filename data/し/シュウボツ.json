        "examples": {
          "standard": [
            {
              "text": "反乱を起こした貴族の財産は、すべて没収・収没された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "不正行為が発覚した場合、その利益は収没されることになるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "権力闘争の結果、敗者は財産の収没という厳しい運命を辿った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "Ａは「ペルシア文学近世史」浄書に着手（以下十一日分）一月十二日（水曜）　松屋に行き原稿を買い、しゅうぼつも取って来る。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            }
          ]
        }
