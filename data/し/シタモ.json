        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今の湯具は古の下裳に代用したる下部を蔽ふの衣なり。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "古の女は、下賤なるも袴着たれば、下裳さへなく唯肌着を紐にて結びたり。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢物語に、「二人して結びし紐を一人して相見るまでは解かじとぞ思ふ」思ふに下裳は小児の附紐の如く肌着に着けたる紐なるべし。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "応永に書きたる日高川の絵巻物には、女、裸にて今の湯具めくものを着けて河に入らむとする処を写せり、恐らくこれ下裳なるべし、とおなじ書に見ゆ。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はゞき裳」が、此であつて、下裳の上の表裳だから、おすひ裳である。",
              "citation": {
                "source": "小栗判官論の計画",
                "author": "「餓鬼阿弥蘇生譚」終篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その逃げて来た娘さんに、洗いざらしでもよいわい、何かお前の下裳と胴着かなんぞを、出して上げなされや。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフが狼狽して、愚かにも水差をつかんでかけつけて来ると、アンナは椅子の上にのぼり、両腕を裸にし下裳だけの姿で、火の移ってる窓掛を両手で平然ともみ消していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
