        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "赤いシヤツポもつけられた、春に売られて行くやうに。",
              "citation": {
                "source": "苔人形",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは子供の母親がシヤツポをきせてくれるから。",
              "citation": {
                "source": "どんたく",
                "author": "絵入り小唄集",
                "note": "青空文庫"
              }
            },
            {
              "text": "その赤い筒型のシヤツポが恰度缶詰の缶のやうだつたからである。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに今一層高等なる職業學校、或は大學のやうな所へ子弟を入れるならば、二十歳になつても未だ卒業しない、二十五歳か三十歳近くになると、何うやら斯うやら四角なシヤツポを廢めて、當り前のシヤツポを冠る。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稻造",
                "note": "青空文庫"
              }
            },
            {
              "text": "『お前の所の小僧は、三十になるまでも親の脛を齧り、四角なシヤツポを冠つて居る』と斯う謂はれる。",
              "citation": {
                "source": "教育の目的",
                "author": "新渡戸稻造",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆「ちよいと小さいシヤツポを冠り、洋服で歩いて居ますから知れませんよ。",
              "citation": {
                "source": "明治の地獄",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "へいへい、奥さんの大事な大事なシヤツポや。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
