        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は鉄棒で美しい尻上がりを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "体操の選手が、見事な尻上がりを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "体育の授業で尻上がりの練習をした。",
              "citation": {
