          "literary": [
            {
              "text": "「ワタシネ、ドコカノ　カワイイ　アカチヤンヲ　ダツコシタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ、オ爺チャン、見テ戴キニ来マシタノヨ」「ソッチヲ向イテ御覧、グルット一ト廻リ廻ッテ御覧」帯ハ絽綴ノ袋帯。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ダケド話ハ伺イマシタ、アンタナンカイタラ邪魔ダカラ何処カヘ行ッテラッシャイッテ、追イ出シタノヨ」「ソレデモイヽ、ダガモウ一人邪魔ナ人間ガイル」「ハイ、ハイ、分ットリマス」ソウ云ッテ佐々木モ早速気ヲ利カシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッタ一日デ、アタシヘト／＼ニナッチャッタカラ逃ゲ出シタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
