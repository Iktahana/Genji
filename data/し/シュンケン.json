        "examples": {
          "standard": [
            {
              "text": "王の周りには、知略に長けた俊賢たちが集まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼の俊賢な計らいにより、紛争は未然に防がれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "俊賢の士を登用することが、組織を強化するための第一歩だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "田原藤太十世の孫の俊賢が初めて江州蒲生郡を領したので蒲生と呼ばれた家の賢秀というものの子である。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
