        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "びっくりして見上げましたら、それは古い白縞の単物に、へんな簑のようなものを着た、顔の骨ばって赤い男で、向うも愕いたように亮二を見おろしていました。",
              "citation": {
                "source": "祭の晩",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒んぼの子守がまっかな上着に紺青に白縞のはいった袴を着て二人の子供を遊ばせている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　翌日、午後一時ごろ、白縞の袴を着けて、借りて来た足駄を下げた清三と、なかばはげた、新紬の古ぼけた縞の羽織を着た父親とは、行田の町はずれをつれ立って歩いて行った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "禿頭の父親が猫背になって歩いて行くのと、茶色の帽子に白縞の袴をつけた清三の姿とは、長い間野の道に見えていた。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰襟の服を着けた、白縞の袴に透綾の羽織を着たさまざまの教員連が、校庭から門の方へぞろぞろ出て行く。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうか……」「今日一時頃、御免なさいと玄関に来た人があるですから、私が出て見ると、顔の丸い、絣の羽織を着た、白縞の袴を穿いた書生さんが居るじゃありませんか。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その白縞の袴を着け、紺がすりの羽織を着た書生姿は、軽蔑の念と憎悪の念とをその胸に漲らしめた。",
              "citation": {
                "source": "蒲団",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だから拙者申したのじゃ」と、右門様の笑い声に引きつづき、総髪の大髻に髪を結い、黒の紋附きに白縞袴を穿いた、わたしの見知らないお侍様が凛々しい重みのある澄んだ声で、そう捕吏たちに云いました。",
              "citation": {
                "source": "犬神娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "始め人家の灯で、黒白縞のドガのような漁師の着物の脊中が見えたかと思うと忽ち闇に吸い込まれた。",
              "citation": {
                "source": "黒い驢馬と白い山羊",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち崩れた金剛の構え　中肉中｜丈で色白く、眉目清秀で四十一、二、頬にも鼻下にも髯のない、一個｜瀟洒たる人物が、黒紋付きの羽織を着、白縞の袴を裾長に穿き、悠然とそこに立っていた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルヴァールをへだてた遠くに、赤白縞の日よけをさし出した一軒のカフェーがここから見えていて、つや子の絵の中にそこも入れられているのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩道の赤白縞の日除けの下を色彩の強い服装をした女が靴の留金を燦かせて歩いて行く。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤地に白縞のある西洋南瓜を前にころがして、うなだれて立っているのは、かの甚助じゃあないか！",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――クレムリンの城門の大時計は、十五分毎に雪の広場の上に鳴り、赤白縞の一寸しゃれた歩哨舎があった。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其二　時代の事業　彼れは白縞の綿服に紺太織の袴を着け、籐椅子に凭れて日本製のシガレツトを吹かしながら、反切明亮なる土佐音にて談話を續けたり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            },
            {
              "text": "其二　時代の事業　彼れは白縞の綿服に紺太織の袴を着け、籐椅子に凭れて日本製のシガレツトを吹かしながら、反切明亮なる土佐音にて談話を続けたり。",
              "citation": {
                "source": "明治人物月旦（抄）",
                "author": "鳥谷部春汀",
                "note": "青空文庫"
              }
            }
          ]
        }
