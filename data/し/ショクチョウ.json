        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "蜀鳥の「テッペンカケタカ」という鳴き声が初夏の山里に響き渡った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "夜明け前から蜀鳥が鳴き始め、田植えの季節が来たことを告げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "縁側に座っていると、遠くの竹林から蜀鳥の声がかすかに聞こえてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
