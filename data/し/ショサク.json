        "examples": {
          "standard": [
            {
              "text": "その作家の緒作は、文学全集として出版される予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "美術館には、彼の緒作が展示されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は生涯にわたって数多くの緒作を残し、後世に影響を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そこも一と間きりの長屋で、これという家財道具はなく、がらんとした薄暗い部屋の中で、作次の女房は鼻緒作りをしていた。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
