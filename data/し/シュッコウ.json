  {
    "uuid": "d71e74d7-7128-511a-ba53-c656f7b7430e",
    "entry": "出航",
    "reading": {
      "primary": "しゅっこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "departure (of a boat, plane)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "燃料の補給を終えた輸送機が、深夜の滑走路から出航した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冒険家たちは世界一周を目指し、小さなヨットで太平洋へ出航した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予定より30分遅れて、ようやくフェリーが出航の準備を整えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "午前五時出航なので船客は日が暮れると乗船を始め、私は午後九時頃に及んで荷揚場から黒奴に案内されてデッキに昇っていった。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、マターファ鎮圧の命を受け、明朝払暁、マノノへ向けて出航すると。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、船は既に出航した後だったのだ、あらゆる偉大な策略家がそうであるように。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらもガイオン汽船会社から来ていて、リヴァプールから出航する船について書いてあります。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、四五日たつて、大田黒君の肩に腕を載せてゐるわたしたちの写真がとゞいて来たので、宿のものにかれの在否をたづねて貰ふと、艦隊はきのふの午、出航したといふことであつた。",
              "citation": {
                "source": "岬の春霞",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつ、出航ですか？",
              "citation": {
                "source": "或るハイカーの記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九日の朝の十時だよ出航は」　という事務長の快活な言葉に返事もしなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よし、今のうちに出航だ。",
              "citation": {
                "source": "恐龍艇の冒険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡洋作戦第九号による出航準備だ！",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切の出航準備は成った。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後八時、リット提督はついに出航命令を下した。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "出航用意からはじまってここまで、まるで火事場のような忙しさの中にきりきり舞をしていた飛行島の乗組員たちは、やっと一息つく暇を見出した。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "折よく飛行島は出航準備で島内の警戒がゆるんだので、二人の隠れ場所は安全となったが、それは一時のことである。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "早朝入浴して散歩する、あかつき丸の出航を見送る。",
              "citation": {
                "source": "道中記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時出航、　自分から出した手紙の抜粋、三月一日付、　今日のように春らしい日差しに成って暖で、雨が降ってやんで、水たまりに日が写って居ると法悦に近いような喜びに胸を打れます。",
              "citation": {
                "source": "「黄銅時代」創作メモ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時過ぎに、船は出航した。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "青いペンキ塗りのバラック建ての船会社へ行くと、宿で云つてゐたとほり、この嵐が済まなければ、出航しないのだけれど、たぶん、明後日頃は出るだらうといふ事だつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "出航を知らせる汽笛が鳴り、笛が吹かれた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "探検隊は、古くからある捕鯨港のサレムで勢揃いをし、五月十九日の朝乗船「発見」号には、前檣たかく出航旗がひるがえる。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日、小林、石田氏出航四月十六日（日曜）晴　朝正直さんが、サトルの結果をききに来る。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "処女航海は何事もなく終り、船長も、その試験航海の成績に特にこれと言う異状は認めなかったが、ただ、何うも大洋へ押し出してすこし暴けて来ると、何となく船の安定が悪いように感じて、この第二回の、そして最後の航海に出航する際も、船長は始終ちょっとそれを気にしていたという。",
              "citation": {
                "source": "沈黙の水平線",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "この光景を眺めた僕には、金剛の容易に出航しさうもないのが聊かもどかしく思はれた。",
              "citation": {
                "source": "軍艦金剛航海記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰国への出発は、探検船が出航するのとは大へんにちがって安全なものであった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後二時別府より紅丸にて出航、高浜上陸、汽車にて道後著、入湯一泊。",
              "citation": {
                "source": "つゆじも",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "清二の乗組んだ潜水艦｜伊号一〇一が、出航命令をうけ、僚艦の一〇二及び一〇三と、直線隊形をとって、太平洋に乗出したのは正確に云えば四月三日のことだった。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何処へ行くのであろう」　清二は推進機に近い電動機室で、界磁抵抗器のハンドルを握りしめて、出航命令が出た以後の、腑におちないさまざまの事項について不審をうった。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国の太平洋、大西洋両艦隊は、圧倒的な大航空軍を、航空母艦に積みこんで、今や、舳艫相含んで、布哇を出航し、我が領海に近づきつつある。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "桝形探険隊の出航の話を聞くと、二人で謀議して密航を企てた。",
              "citation": {
                "source": "断層顔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出航のまえに、じゅうぶん調べたんだがなあ。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったくふしぎだ」「密航者しらべをしたときに、怪しい品物がまぎれこんでいるかどうか、それもいっしょに厳重にしらべるよう僚艇に伝えたんですがねえ」「もし、そういう品物がまぎれこんだとすれば、それはやはり出航のすぐまえのことだと思います。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
