[
  {
    "uuid": "72935486-b9e0-51b3-9bed-d09d1f382cf1",
    "entry": "出向",
    "reading": {
      "primary": "しゅっこう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
