          "literary": [
            {
              "text": "ラ・シガール新聞社でいいことが待っているのですか」　記者のビニンが陽気に言った。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがラ・シガール新聞の夕刊がそのうち出れば知れ渡るだろう。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし噂が真実であればラ・シガール紙が詳細に報道するだろうし、上品な紙面が大｜醜聞で赤く埋まるだろう。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "大勢の新聞売り子が道路のそこいら中におり、ラ・シガール新聞の宣伝看板を背負っている。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「知りたいのはですね、陛下がラ・シガール新聞を見たかどうかです。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            }
          ]
        }
