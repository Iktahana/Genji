  {
    "uuid": "b692af3c-0f45-5979-b01b-5016d019c104",
    "entry": "塩竈",
    "reading": {
      "primary": "しおがま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "弁持も洲崎に馴染があってね、洲崎の塩竈……松風｜空風遊びという、菓子台一枚で、女人とともに涅槃に入ろう。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……菓子はこれだ、と袂から二人揃って、件の塩竈を二包。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてそれより塩竈神社にもうでて、もうこの碑、壺の碑前を過ぎ、芭蕉の辻につき、青葉の名城は日暮れたれば明日の見物となすべきつもりにて、知る人の許に行きける。",
              "citation": {
                "source": "突貫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽船で塩竈へ歸らうとしたのである。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "其内に今日は塩竈行の汽船は來ないといふ知せがあつた。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "代が崎を過ぎて塩竈の杉の稍が遙かに見えて籬が島が舳にあらはれた時には船体の動搖は止んだ。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "籬が島のあなたからは塩竈を出た小舟が白帆を揚げて走つて行く。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "白帆を揚げた小舟は又それと行き違ひに塩竈をさして籬が島のあなたへはひる。",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしも松島記念大会に招かれて、仙台、塩竈、松島、金華山などを四日間巡回した旅行中の見聞を、手当り次第に書きなぐるにあたって、この五色筆の名をちょっと借用することにした。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の女　仙台や塩竈や松島で、いろいろの女の話を聞いた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩竈街道の燕沢、いわゆる「蒙古の碑」の付近に比丘尼坂というのがある。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩竈の町は遠い昔から色の港で、出船入り船を迎うる女郎山の古い名が今も残っている。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "春もたけなわなる朧月夜に、塩竈通いのそそり節が生暖い風に送られて近くきこえた時、若い尼は無念無想で経を読んでいられたであろうか。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「塩竈街道に白菊植えて」と、若い男が唄って通った。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "尼も塩竈街道に植えられて、さびしく咲いて、寂しく萎んだ白菊であった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩竈神社の神楽　わたしが塩竈の町へ入り込んだのは、松島経営記念大会の第一日であった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その混雑の中をくぐって、塩竈神社の石段を登った。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの名物という塩竈や貝多羅葉樹や、泉の三郎の鉄燈籠や、いずれも昔から同じもので、再遊のわたしには格別の興味を与えなかったが、本社を拝して横手の広場に出ると、大きな神楽堂には笛と太鼓の音が乱れてきこえた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは塩竈へ来て、こんな珍しいものを観たのを誇りたい。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "孔雀船の舟唄　塩竈から松島へむかう東京の人々は、鳳凰丸と孔雀丸とに乗せられた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩竈神社の神楽を観た時と同じような感じを以って、ただ一種の古雅なるものとして耳を傾けたに過ぎなかった。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "若葉の中には塩竈桜か何かであらう、散り残りの白いあざれたやうな花弁があつて、それが青味だつて吹いて来る風に胡蝶のやうにちらちらと散つた。",
              "citation": {
                "source": "あかんぼの首",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又｜陸奥の塩竈の景色を写したので名高いあの東三条の河原院に、夜な／＼現はれると云ふ噂のあつた融の左大臣の霊でさへ、大殿様のお叱りを受けては、姿を消したのに相違ございますまい。",
              "citation": {
                "source": "地獄変",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "其は庭の片隅に、坊主になる程｜伐られた若木の塩竈桜であった。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "床には抱一上人の横物はとりまして、不動さまに道了さまと塩竈さまのお輻と掛け替り、傍に諸方から見舞に来た菓子折が積んで有りまするが、蒸菓子の方は悪くなるから先へ手を附け、干菓子の方は下積に残って居りまする。",
              "citation": {
                "source": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "author": "粟田口霑笛竹（澤紫ゆかりの咲分）",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争話の駄ボラを吹きながら、無銭飲食、無銭遊興を重ねて、二本松から、仙台、とうとう塩竈まで逃げ落ちた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "松前行きの便船がでるまで待て、というので、一行は一ヶ月ほど塩竈の遊女屋に流連して便船を待った。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは塩竈の鼻ツマミ者になった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "さッそく塩竈へとって返して、造り酒屋の聟におさまったのである。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "」塩がまかれました。",
              "citation": {
                "source": "蜘蛛となめくじと狸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
