        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "着いた日から、一緒に来た友達を二人も引っ張って来て、飯を食わしたり泊らせたりして田舎語の高声でふざけあっていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を聞くと、身狭の乳母は、激しく田舎語部の老女を叱つた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を聞くと、身狭乳母は、激しく、田舎語部の老女を叱りつけた。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を聞くと、身狹乳母は、激しく、田舍語部の老女を叱りつけた。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
