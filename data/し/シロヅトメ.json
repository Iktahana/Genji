          "literary": [
            {
              "text": "……お城勤めをなすってらっしやる、袖ノ井さんのお宅は、こちらでござんしょうか」「はい、はい。",
              "citation": {
                "source": "乳を刺す",
                "author": "黒門町伝七捕物帳",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもなら城勤めだが、きょうは組長屋のわが家に在って、手脚を伸ばしていたのである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変らず、大きな桐紋のついている木綿の陣羽織に、扇子づかいをして、この夏は、せっせと、城勤めに専念していた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "祝言の席から友達と飲みに出てしまって、そのままお城勤めをすまして今帰ってみると、またゆうべの祝言の時刻に近い黄昏なのである。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "垣隣りは、城勤めの黒鍬の者か、足軽のような軽輩な者の住居らしい。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
