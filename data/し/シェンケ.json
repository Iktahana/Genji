        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "白のエプロンをかけた船のナースがシェンケでポルト酒かなにかもらってなめている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オランダ人で伝法肌といったような男がシェンケから大きな釣り針を借りて来てこれに肉片をさし、親指ほどの麻繩のさきに結びつけ、浮標にはライフブイを縛りつけて舷側から投げ込んだ。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スエズで買ったそろいのトルコ帽をかぶったジェルサレム行きの一行十人ばかり、シェンケの側の甲板で卓を囲んで、あす上陸する前祝いででもあるかビールを飲みながら歌ったり踊ったりしていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒッタイト法典では耳を切り落とした補償は12シェンケル片手や片足には20シェンケルであるのに鼻を切り落とすと１ミナまたは60シェンケルであった(13)。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
