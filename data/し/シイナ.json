[
  {
    "uuid": "4a849067-a0ab-59e1-b7f5-a438af60f5c8",
    "entry": "粃",
    "reading": {
      "primary": "しいな",
      "alternatives": [
        "しいだ",
        "しいら"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "empty grain husk",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "脱穀された麦の粃が地面に散らばっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "まだ熟していない粃の果実を摘むのはもったいない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼の話は粃ばかりで、聞くに値しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "尋めあゆむ『きのふ』の落穗、ひろひしは唯｜粃實のみ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて棺のまわりに糠粃を盛りたる俵六つ或は八つを竪に立掛け、火を焚付く。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "初薪のみにて焚きしときは、むら焼けになることありて、火箸などにてかきまぜたりしが、糠粃を用いそめてより、屍の燃ゆるにつれて、こぼれこみて掩えば、さる憂なしといえり。",
              "citation": {
                "source": "みちの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから赤い襷掛に紺足袋穿という風俗で、籾の入った箕を頭の上に載せ、風に向ってすこしずつ振い落すと、その度に粃と塵埃との混り合った黄な煙を送る女もあった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆえに種子はみな粃であるからこれを播いても生えて来ない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は牛や鷄に食はせる家が多いが、以前は是に粉米やシヒナ（粃）を合せて粉に挽いて、テンコ餅といふものをこしらへて食ひ、又は其粉を糯米にまぜても食つた（粒々辛苦）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "安藝の山縣郡では是に粃を合せて、粉にして作つたものをヒキモノ餅と謂つて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユリゴには碎け米や粃、又は色々の屑ばかりが殘るから、飯に炊くことはとても出來ない。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張の日間賀島でも、メザイとコゴメとは同じで、是と小麥糟、大豆の粃などを合せ蒸して糠味噌を作るといふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は十分實の入らぬ粒、即ち粃のことだと謂つて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨサ　滋賀縣南部の各郡から、伊賀の阿山郡にかけて、粃をミヨサといふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ北陸では富山縣でミヨーシ、關東では上總房州の方でミヨセといふのがやはり粃のことらしく、ミヨサの方が類例は多いのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "房州などのミヨセは、粃に限らず庭に落ち散つた屑米を總稱し、今は少なくとも實寄せといふ感じで使つて居るらしい。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンダ　粃の「しひな」は、もと發音のしにくい語音だつたと見えて、地方毎に大分ちがつた形にかへられて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "東北は岩手縣の大部分では粃をシヒタ、秋田縣の男鹿半島などはシダと謂つて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登半島の各郡では、粃をシンダとも發音して居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで考へるのは東京でいふ糠味噌、關西でジンダともいふ粗惡な味噌は、本來はその材料にする粃から出た名であつたらしい。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタジイラ　粃は事によるとシヒナよりもシイラの方が前であつたかも知れぬ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "粃の中の又屑であつて、男鹿半島の馬のシダに當るものだが、之をさう呼ぶのは板の如く扁平な粃の意では無く、もとは汰板（ゆりいた）の上に殘留するシラのことで、乃ちシラが普通の籾であつたことを推測せしめる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャバ　越後の刈羽地方などで、粃の一種の幾分か實のあるものをさういふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカシ　粃をイカシと呼んで居る地方もある（但馬方言集）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐渡の島などのメカスは專ら蕎麥の粃のことで、之を粉にしてメカス團子といふものを作つて居る（佐渡の民謠）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月頃に盛んに漁れる魚で、農家と親しみが多く、瀬戸内海沿岸ではこの魚の名が稻の粃（シヒナ、シヒラ）と近いのを憎んで、マンビキといふ別稱を用ゐて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は牛や鶏に食わせる家が多いが、以前はこれに粉米やシイナ（粃）を合せて粉に挽いて、テンコ餅というものをこしらえて食い、またはその粉を糯米にまぜても食った（粒々辛苦）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "安芸の山県郡ではこれに粃を合せて、粉にして作ったものをヒキモノ餅といっている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユリゴには砕け米や粃、またはいろいろの屑ばかりが残るから、飯に炊くことはとてもできない。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張の日間賀島でも、メザイとコゴメとは同じで、これと小麦｜糟、大豆の粃などを合せ蒸して糠味噌を作るという。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは十分実の入らぬ粒、すなわち粃のことだといっている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミヨサ　滋賀県南部の各郡から、伊賀の阿山郡にかけて、粃をミヨサという。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは、こなひだの爺さんからあづかつてゐる大事の品だが、しかし、お前さんがそんなに欲しいならやつてもいい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
