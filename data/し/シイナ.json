  {
    "uuid": "8e7fc9f5-93b3-5464-bf21-fe393b2aa94d",
    "entry": "シイナ",
    "reading": {
      "primary": "しいな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オカシイナ……オカシイ……。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……オカシイナ……ツイ胴忘れしちゃってチョット思い出せないんですが。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ガスとボンボリ鶴の群――」「石油エンジンコト／＼と」「タイワン館のシイナの子――だ。",
              "citation": {
                "source": "晩春日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノキバノ　フウリン　スズシイナ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "チリリン　チリリン　チン　チリリンカゼハ　ナクトモ　スズシイナ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワン、ワン、ワン、ウレシイナ、ウレシイナ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "開放的で豪快で何一つ心に隠しておくことの出来ないお喋りといふ風であり、彼の経てきた色々の不思議なこと愉快なことを語つてきかせるのであるが、たつた一度ジロリとレシイナを見た男の眼を小左衛門は忘れることが出来ないのだ。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "レシイナは彼の妻でありヒエロニモ四郎の姉であつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "レシイナを見たこの男の眼は、幸福又は平和に対する敵意であつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は天草最大の富豪であり、和漢を始め洋学にも通じたディレッタントで引込思案の男であつたが、レシイナに向けられた陰惨な眼を思ひだすと渾身の勇気がわいてきた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは彼が安穏を欲するからであつたけれども、又、レシイナを熱愛してゐたせゐだつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの陰惨な魂の破壊の影が自分とレシイナの平和にまで及ぶだらうと考へると、曾ては最大の敬意を以て迎へた神父であつたけれども、秘密に殺したくなつてきた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝレシイナお前まで、お前はまさか弟の四郎が天人だと思ふ筈はないだらう。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いゝえ、とレシイナは答へた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてレシイナよ、お前まで俺の分らぬところへ飛び立つてしまひさうな気がする。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はレシイナを思ひだし、そして、その名を呼んでゐた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はたゞレシイナの肉体を想像し、それがある人の自由のまゝであることを考へると、気が遠くなり、彼の感官は分離して、四方八方の予期せざる箇所に苦痛な不安がはゞたくのだつた。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あゝレシイナ、お前だけは私のそばから離れてくれるな。",
              "citation": {
                "source": "わが血を追ふ人々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "四郎の姉が洗礼名をレシイナ（レジナ）といったことは分っている。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レシイナとあるように、彼女が切支丹信徒であることは確かであるし、さすれば良人も切支丹であることは確実だ。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、一揆の計画されつつあるときには、レシイナとその良人とはそれに反対の意向であったと私は思う。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟の四郎が利巧者であったように、姉のレシイナも聡明な女で、嫁して後は良人の良識に同化し、黒幕浪人の策謀や、天人四郎などと大それた知識犬の役を演ずる弟や父について行けなかったのではないかと思う。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知識犬の技巧にはげみ演技の腕をあげて自己｜陶酔を深めてゆく弟と、その指導者の一人ではあるが本当の黒幕ほどに利巧でない父の姿を悲しく眺めていたレシイナとその良人の心を想像し、この二人ほど真剣に、またマジメにこの悲痛なテンマツを始めから終りまで見届けていた目はなかった、と私は考えるのである。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四郎の垢や暗さを救ってくれるものは、姉のレシイナと小左衛門とがそのテンマツを切なく見まもっているマジメで真剣な目だけであろう。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその策謀にのらない正しい切支丹の目は小左衛門とレシイナにあった。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レシイナと小左衛門が事実に於て私の想定するような思想や目の持ち主ではなかったにしても、天人四郎と対照的にレシイナと小左衛門のような思想や目の持ち主を想定しなくては、どうしても救いのつけようがないのが私の考えである。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「オヤ、オカシイナ、ソツチノミミモ立テナサイ」トイヒマシタケレドモ、ウサギハシランカオシテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウ云ウ風ノ吹キ廻シカ、アトガ恐シイナ」「イヽ覚悟ダワ、ソノ積リデイタライヽワ」「ジャ、ソレカラ先ニ聞コウジャナイカ」「マア兎ニ角、ネッキングヲナサイ」結局予ノ方ガ誘惑ニ負ケタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
