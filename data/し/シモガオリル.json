        "examples": {
          "standard": [
            {
              "text": "明日の朝は冷え込むので、畑に霜が降りるかもしれないと予報が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "霜が降りると車の下のフロントガラスが凍りつき、お湯をかける手間が増える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の芝生に一面の霜が降り、朝日を浴びてキラキラと輝いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "代々木の森が明るいぬけ色になり、朝々、霜が降りるようになった。",
              "citation": {
                "source": "鈴木主水",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "物忌みあけの十一月というのは霜月というくらいで、もう霜が降りるから、その時に秋祭をするのは少し無理がある。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「霜が降りるようです。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "天気に詳しくない人でも、夜霜が降りると予想できる。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
