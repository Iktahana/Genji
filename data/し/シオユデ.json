        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新鮮な枝豆を塩茹でして、ビールのお供にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大きなカニを丸ごと塩茹でにして、家族で豪快に食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "塩茹でした野菜は、素材の甘みが引き立ち、そのまま食べても美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "高村光太郎氏も、随筆で見ますと、豌豆を好まれるようですが、自炊なさるので、筋を取って塩茹でにしたのを、油や酢で召上るのだそうです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "青々した枝豆の塩ゆでも悪くない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩ゆでの枝豆、串刺しにした里芋の味噌焼きなぞは半蔵が膳の上にもついた。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "葱を細に切ってヤクミにして食べると塩ゆでにしてあるから誰も豚と思わんよ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビスケット、ホットケーキ、紅茶皿、干柿、鰺の乾物、塩ゆでの車鰕、こまかく裂いた※、南京豆、ビール瓶、コップ、茄子と瓜の味噌漬、林檎と蜜柑、小皿類……。",
              "citation": {
                "source": "塩花",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
