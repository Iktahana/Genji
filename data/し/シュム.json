[
  {
    "uuid": "dd084c3c-a267-50f1-85f9-4ad196480e6d",
    "entry": "主務",
    "reading": {
      "primary": "しゅむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
