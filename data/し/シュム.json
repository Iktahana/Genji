        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この事業を継続するには、主務官庁から特別な許可を得る必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "条約の締結にあたっては、外務省が主務となって各省庁との調整を進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "法律の解釈に関する疑問に対し、主務大臣による正式な見解が示された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
