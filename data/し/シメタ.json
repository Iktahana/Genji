    },
    "definitions": [
      {
        "index": 1,
        "gloss": "I've got it!",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「占めた！探していた限定品が、まだ売れ残っているのを見つけたぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "懸賞の当選通知が届いたのを見て、彼は「占めた、これで旅行に行ける」と喜んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「占めた、ちょうどいいところにタクシーが来た」と彼女は手を挙げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "恐らく富士山麓の宿屋としては、北の精進ホテル以外において、もっとも景勝の地を占めたものであろう。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "パン粉を買い占めたり、チーズを買い占めたり、そして、それを労働者に高くで売りつける。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつもの通りに堤を降りて、ふたりが列んで釣っていると、やがて為さんが小声で占めたと云ったが、なかなか引き寄せられねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、とうとうその欲望が勝を占めた。",
              "citation": {
                "source": "奎吉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お柳、」と思わず抱占めた時は、浅黄の手絡と、雪なす頸が、鮮やかに、狭霧の中に描かれたが、見る見る、色があせて、薄くなって、ぼんやりして、一体に墨のようになって、やがて、幻は手にも留らず。",
              "citation": {
                "source": "木精（三尺角拾遺）",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕立雨の今や来たらんといふやうなる時、天の半を一面に蔽ひて、十万の大兵野を占めたる如く動かすべくもあらぬさまに黒みわたり、しかも其中に風を含みたりと覚しく、今や動ぎ出さんとする風情、まことに一敗の後の将卒必死を期してこと／″＼く静まりかへつたるが中に勃々として抑ふべからざる殺気を含めるが如し。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「占めた」と叫んでお父さんは急いで帰って仲間の蛙をみんなつれて来ました。",
              "citation": {
                "source": "蛙のゴム靴",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私はもう占めたと思いました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の事業を援助する興行物は必ず大入満員を占めた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは占めた、どうかして取って食べてやろうと思ってジッと鉢の中を狙いました。",
              "citation": {
                "source": "ドン",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るとファニーは安楽椅子に仰向きかげんに座を占めた母に抱きついて処きらわず続けさまに接吻していた。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして脚の隠れそうな物蔭に腰から上だけを見せて座を占めた。",
              "citation": {
                "source": "フランセスの顔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばたばたとお孝が立つで、占めた、遁げる、恐れたぞ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "へん、おいらアのせいじゃないぜ、大丈夫知れッこなしだ、占めたもんだい、この分じゃあ今に見ねえ、また大仕事をやらかしてやらあな。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内、痛えという声がする、かすったようだけれども、手応があったから、占めたと、豪くなる途端にお前。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お柳、」と思はず抱占めた時は、淺黄の手絡と、雪なす頸が、鮮やかに、狹霧の中に描かれたが、見る／＼、色があせて、薄くなつて、ぼんやりして、一體に墨のやうになつて、やがて、幻は手にも留らず。",
              "citation": {
                "source": "三尺角拾遺",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは占めたとおもいました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "署長はもうすっかり占めたと思ったのだ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私はもう占めたと思ひました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の袂がびりびりと裂けて断れて取れた、はずみをくって、踏占めた足がちょうど雨上りだったから、堪りはしない。",
              "citation": {
                "source": "化鳥",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "試みに袂を探りて、悪僕より奪い置きたる鍵を嵌むれば、きしと合いたる天の賜物、「占めた。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏関所三　父爺の総六が吩咐けのまま、手織縞の筒袖に、その雪のような西洋前垂、背へ十字に綾取って、小さく結んだ菊模様の友染唐縮緬の帯お太鼓に、腰へ捌いた緑の下げ髪、裳短こうふッくりと、白きは脚絆の色ならず、素足に草履｜穿占めた、爪尖の薄紅。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と握占めた掌を、自分で捻開けるようにして開いたが、恐る恐る透して見ると、「何ぢゃ、蟹か。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "突出した得物の尖が、右の袖下を潜るや否や、踏占めた足の裏で、ぐ、ぐ、ぐ、と声を出したものがある。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝、上野を出て、田端、赤羽――蕨を過ぎる頃から、向う側に居を占めた、その男の革鞄が、私の目にフト気になりはじめた。",
              "citation": {
                "source": "革鞄の怪",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから先はもう家も何も無い上に、仕合わせと人間もまだ追い付いて来ていない様子で、往来には誰も居ないようですから、ヒョロ子は占めたと思いまして、高い屋根の上からその低い屋根の上に両足を揃えて飛び降りますと、その屋根は腐っていたものと見えまして、ヒョロ子と豚吉の重たさのためにズバリと破れました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "占めたと思って、そこから機械体操の尻上りを応用して梯子段の上に出て、あとの硝子窓をソッと閉めました。",
              "citation": {
                "source": "クチマネ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『二十才にして既にひどい心痛は歌ふことを断念せざるを得ざらしめた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、室生の創造した新らしい詩が、どんなに深く私を感動せしめたことであらう、私は日夜に彼の詩篇を愛吟して手ばなすこともできなかつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそうした八雲の悲しい心は、常に最も夫人の心を痛ましめた。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
