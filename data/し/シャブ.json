  {
    "uuid": "d775fc2b-a034-5569-9a2b-641985f9d5ef",
    "entry": "舎武",
    "reading": {
      "primary": "しゃぶ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
