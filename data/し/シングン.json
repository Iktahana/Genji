    "definitions": [
      {
        "index": 1,
        "gloss": "march",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜明けとともに、部隊は敵陣に向けて静かに進軍を開始した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史の授業で、ナポレオン軍のロシア進軍について学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "政府は被災地への救援物資の進軍を急いでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "活動写真の勝利の進軍は教育の縄張りにも踏み込んでくる。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーケストラが大進軍の曲を始めた。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、蒋介石は、これ以上、天津、北京にむかって進軍させる訳には行かなかった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "がドイツでは、ロシアへ進軍した。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十六時間の激戦や進軍の後、和田達は、チチハルにまで進んだ。",
              "citation": {
                "source": "チチハルまで",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう進軍をやめなくちゃいかん。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番｜槍の功名を拙者が仕る、進軍だ進軍だ』とわめいて真っ先に飛び出した。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」大将「ベルギ戦役マイナス十五里進軍の際スレンジングトンの街道で拾ったよ。",
              "citation": {
                "source": "饑餓陣営",
                "author": "一幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう進軍をやめなくちやいかん。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ううん、ただその活動はね、お客へ向って戦争へ行け行けって、やたらに進軍ラッパを吹いたり太鼓鳴らしたりしているの。",
              "citation": {
                "source": "兵士と女優",
                "author": "オン・ワタナベ（渡辺温）",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀子は千葉や習志野へ行軍に行く兵隊をしばしば見たが、彼らは高らかに「雪の進軍」や「ここはお国を何百里」を謳って足並みを揃えていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし国民性の本質が、内奥に於て如何にその外観とちがっているかは、かの日清・日露等の役に於ける兵士の軍歌（雪の進軍と、此処は御国を何百里）が、歌曲共に、哀調悲傷を極めているに見ても解る。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏郷が高清水の方へ進軍して行けば、戦術の定則上、是非其の途中の敵城は落さねばならぬ。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "種子の如く、弓弦の如く、曉天の如く、少男の如く、進潮の勢の如く、進軍の鼓聲の如く、凡そ内より外に對ひて發舒展開せんとするの象は、皆張る氣の相にして、人に就て之を言へば、吾が打對ふところに吾が心の一ぱいになる氣合である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "六百台余の重爆撃機が天地を震撼させて進軍する様は世界を席捲するが如く感じました。",
              "citation": {
                "source": "母と娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでまず第一番に皇后の軍勢を待ちうけて討ち亡ぼそうとおぼしめして、にわかに兵を集めて、摂津の斗賀野というところまでご進軍になりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "聨隊長はこの進軍に反対であったんやけど、止むを得ん上官の意志であったんやさかい、まア、半分焼けを起して進んで来たんや。",
              "citation": {
                "source": "戦話",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "天の時なりと考えた少将は、進軍｜喇叭を吹かしめ、突進させた。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸山、大宮を守る佐久間右衛門尉が五千騎に向って、浅木辺より進軍する武田勢三千、その真先に、白覆輪の鞍置いた月毛の馬を躍らし、卯の花｜縅の鎧に錆色の星冑｜鍬形打ったのを着け、白旗の指物なびかせた老武者がある。",
              "citation": {
                "source": "長篠合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "東の空も白み、里々の鳥の声も聞える頃、盛政の軍は、余呉湖畔を進軍して居た。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時坡州の李如松も亦出登して京城へ進軍しつつあった。",
              "citation": {
                "source": "碧蹄館の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "立花勢は友軍の苦戦をよそに進軍しないから、貞清之を促すと、「諸軍の攻撃によって城は今に陥るであろうが、敵敗走の際に我軍之を追わんが為である。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "進軍して諸軍を顧みるが誰も応じようとしない。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "むろん、之より先、伏見、鳥羽、淀には幕兵を配置していた訳なので、先ずそれらに進軍を命じた。",
              "citation": {
                "source": "鳥羽伏見の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "『太平記』は正行の奮闘は詳説するくせに、此等の諸軍の動静を閑却して居るが、師泰なんか四条畷戦後、北畠軍に大いに進軍を防遏されて居るのである。",
              "citation": {
                "source": "四条畷の戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い列は足並みそろへて進軍した。",
              "citation": {
                "source": "吾家の随筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二週目あたりに飲み水が尽き、内地進軍中のニール将軍の縦隊に連絡が取れるか否かが問題となった。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
