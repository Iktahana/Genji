    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もとは城側の広小路といふところに士族屋敷の一つを構へたとか、其はもうずつと旧い話で、下高井の方から帰つて来た時に、今のところへ移住んだのである。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ寄手は、やや攻めつかれ、守城側の士気のほうが、はるかに振っているかとも思われるのであった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "出ると駈けって、宮城側迄行きホッとする、宮城を背景ならさあ撮れっていふわけ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "籠城側は新手の戦術に出て、城壁にたかる寄手の兵に沸えたぎった熔鉄をふりまいた。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
