        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この祇園の算額につき『増修日本数学史』には東海坊なる人の奉納なるごとくいい、元禄四年……東海坊、山本宗信ノ奉額題ヲ解シテコレヲ京ノ祇園神社ニ掲グ……東海坊、其姓名ヲ知ラズ、蓋シ逸号ナラム……と見えているが、これは誤りであって、明らかに署名されている通りに長谷川鄰完の奉額である。",
              "citation": {
                "source": "芸術と数学及び科学",
                "author": "三上義夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "亭中ニ棋｜一中ノ装ヲ傾ケ匍匐シテコレヲ救ヒソノ家ヲ処分ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "子寿｜欣然トシテコレヲ受ケ改メズンバ措カザルナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "予乃チ抄シテコレヲ梓ニ付シ題シテ『聖武記採要』トイヒ以テ世ニ問フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "辺疆ノ責ニ任ズル者能クコノ篇ヲ熟読シ以テ斟酌シテコレヲ用レバ則チソノ実用アルイハ孫呉ニ倍セン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "因テ二、三ノ従游スルモノト相謀リ諸家ノ麗藻ヲ選ンデ梓シテコレヲ伝ヘントシタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今出シテコレヲ閲スレバ頗遼豕ナルヲ覚ユ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今渡辺生ニ托シテコレヲ還ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "余ニ詩ヲ賦シテコレヲ贈ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃命シテコレヲ延ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽チ声ノ中空ヨリ落ルモノアルヲ聞キ、窓ヲ推シテコレヲ視ルニ、天｜陰リ月黒ク、鴻雁※喨トシテ乍チ遠ク乍チ近シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十三年中野知事ノ嘱ヲ受ケ勅語述義ヲ編シテコレヲ闔県ニ敷ク。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
