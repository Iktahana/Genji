      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、その完成祝いには恋人の女神を連れて来て初入店の式をさせるのです。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨教主は師君、初入道者は鬼卒、漸く修行の積んだものは祭酒、各ひ露を飮む的の仙人では無く、宗教者的の人であつて、さればこそ大衆の崇拜するところとなり、そして其爲に呉の孫策の權威を侵犯したから、そこで壯年の英雄兒孫策の爲に殺されてしまつたのであらう。",
              "citation": {
                "source": "道教に就いて",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初入った貴方がた三人以外に、足跡がないのですからな。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから東町奉行所との間に往反して、けふ十九日にある筈であつた堀の初入式の巡見が取止になつた。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "町奉行になつて大阪に来たものは、初入式と云つて、前からゐる町奉行と一しよに三度に分けて市中を巡見する。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初入学した専門学校を退学されて、行きどころもなくぶらぶらと半年ばかりの月日を過さなければならなかった時には、どんなにあの建物のありがたさが分かっただろう。",
              "citation": {
                "source": "出世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "バートンの『東｜阿非利加初入記』五章にエーサ人の牛畜各名あり。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "銭湯を知らない私は、温泉でさえ気味が悪い様でいやがって居るのだもの、新らしくなりもしず、汚れた水を吸い込む木の槽の肌にはどんな汚れが誰から出て入って居るだろうと思うといくら新らしい湯に最初入ってもいやである。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからわずかな光線が射し込んでいるだけだったので、最初入って来た時には何を見ることも困難であった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "益村は少女たちより先に、初入国の殿にめみえをし、賜盃の席にも出たからよく知っていた。",
              "citation": {
                "source": "滝口",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　初めての国入りだから、初入部の祝いから始まって、いろいろと儀式が多い。",
              "citation": {
                "source": "若き日の摂津守",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほぼ五年に一度くらいの割でおこなわれて来たが、先代の河内守光和が病気がちで、七年あまりも帰国しなかったのと、光辰が初入部であるためとで、領民たちから期待されていたものであった。",
              "citation": {
                "source": "若き日の摂津守",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして初入部をし、鴨猟のことや、伊部村の老婆の話などで、「自分のしなければならないこと」の方向がおぼろげながらわかるようになった。",
              "citation": {
                "source": "若き日の摂津守",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――太祖武徳皇帝いらい、定めおかれた刑法の一として、牢城初入りの流人には、一百｜打の殺威棒をくだす掟だぞ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「爺さんが初入りの患者だぞ」　担架の毛布をのぞいて、兵隊は笑ったが、弁蔵は笑えない顔していた。",
              "citation": {
                "source": "日本名婦伝",
                "author": "谷干城夫人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
