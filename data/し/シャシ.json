    "definitions": [
      {
        "index": 1,
        "gloss": "history of a company",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "社史を編纂するプロジェクトが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "創業100周年を記念して社史が発行された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "社史から企業の経営方針の変化が読み取れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "気合いの入れ具合にはばらつきがあるが、社史を掲載しているところはかなり多い。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この疑問は、同社の正史である『日本電気株式会社七十年史』（日本電気社史編纂室編、日本電気、一九七二年）と『日本電気最近十年史』（同前、一九八〇年）をあらためて追うことで、単純に機構改革、名称変更が繰り返されたためと氷解した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何もやらかしゃしねえよ。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはひどくむしゃくしゃした。",
              "citation": {
                "source": "あけがた",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まんさす、──二年兵ける、しゃしくに。",
              "citation": {
                "source": "入営前後",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親爺の手紙まで、俺れらにゃ、そのまゝ読ましゃしねえんだな！",
              "citation": {
                "source": "前哨",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクセント分解についての詳細は下記URLを参照してくださいhttp://aozora.gr.jp/accent_separation.html-------------------------------------------------------第一双の眼の所有者（むしゃくしゃした若い古物商。",
              "citation": {
                "source": "電車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　浪之助が、　「今の寺の和尚様さ」　伊吉ふと室の隅にぬいであるお類の着物を見て、Ｔ「お類さんを何処へ隠したんだ」　浪之助が「冗談言うねえ」Ｔ「隠しゃしねえよ」　風呂へ入ってらァ、　と云う。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は暑いやら疲れたやら、すっかりむしゃくしゃしてしまひましたので、今のうち一寸床屋へでも行って来ようと思って室を出ました。",
              "citation": {
                "source": "毒蛾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰だってむしゃくしゃしたときは何をするかわからないのだ。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土神は何とも云へずさびしくてそれにむしゃくしゃして仕方ないのでふらっと自分の祠を出ました。",
              "citation": {
                "source": "土神と狐",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三郎の髪の毛が赤くてばしゃばしゃしているのに、あんまり長く水につかってくちびるもすこし紫いろなので、子どもらはすっかりこわがってしまいました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土神は何とも云えずさびしくてそれにむしゃくしゃして仕方ないのでふらっと自分の祠を出ました。",
              "citation": {
                "source": "土神ときつね",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーシュははじめはむしゃくしゃしていましたがいつまでもつづけて弾いているうちにふっと何だかこれは鳥の方がほんとうのドレミファにはまっているかなという気がしてきました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日はわたくしは役所で死んだ北極熊を剥製にするかどうかについてひどく仲間と議論をして大へんむしゃくしゃしていましたから、少し気を直すつもりで酒石酸をつめたい水に入れて呑んでいましたら、ずうっと遠くですきとおった口笛が聞えました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は暑いやら疲れたやら、すっかりむしゃくしゃしてしまいましたので、今のうち一寸床屋へでも行って来ようと思って室を出ました。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　クねずみはあんまり猫の子供らがかしこいので、すっかりむしゃくしゃして、また早口に言いました。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は実は宣伝書にも云って置いた通り充分詳しく論じようと思ったがさっきからのくしゃくしゃしたつまらない議論で頭が痛くなったからほんの一言申し上げる、魚などは諸君が喰べないたって死ぬ、鰯なら人間に食われるか鯨に呑まれるかどっちかだ。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人と衝突して、さっきから無暗にむしゃくしゃして……。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　さあ、学者はむしゃくしゃしてきました。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとまた或日来た青年の手紙は強請的な哀願にしおれて、むしろかの女の未練やら逡巡やらのむしゃむしゃした感情を一まとめにかき集めて、あわや根こそぎ持ち去って行きそうな切迫をかの女に感じさせた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしゃくしゃして来て、僕は、ギタをひいてばかりいた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "麹町にも、とんとごぶさただそうだし、私のところへなんか、年始状だって寄こしゃしない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、自分の今朝までの、あの興奮と緊張とを思い出し、むしゃくしゃして来た。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "余程｜肚の中がむしゃくしゃして居て、悪気が噴出したがっていたのであろう。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "早瀬は恐入った体で、「成程、」「勿論人を見てするこッた、いくら媒酌人をすればッて、人ごとに許しゃしない。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、二十円とられたのが、なんとしても、いまいましく、むしゃくしゃして、口から出まかせ、さんざ威張りちらして、私の夢を、謂わば、私の小説の筋書を、勝手に申述べているだけなのである。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたが勝手に責任感じて、そうして、むしゃくしゃして、お苦しくて、こんどは誰か、遠いところに居る人に、その責任、肩がわりさせて、自身すずしい顔したいお心なのよ。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやり下婢の様を見ているうちに、むしゃくしゃして来た。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "上って浴衣を借りると、実に薄汚なくてくしゃくしゃしている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
