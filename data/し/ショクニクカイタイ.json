          "standard": [
            {
              "text": "食肉解体の作業は衛生管理が非常に重要で、専門の資格を持つ職員が担当する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "食肉解体の工程を見学した学生たちは、命をいただくことの重さをあらためて感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "機械化が進んだ現代でも、食肉解体の精緻な部位分けには熟練した職人の技が欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "健康でよく肥えていた者たちの死体は、四本足のも二本足のも、注意深い食肉解体処理作業員がするように殆どの固形臓器を切除され持ち去られていた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
