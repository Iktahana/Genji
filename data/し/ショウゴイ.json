        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これは少し言過ぎるかも知らぬが、定基の兄の為基、これは系図には、歌人とあり、文章博士、正五位下、摂津守とある。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "又医書一巻元亀の古鈔本にて末云「耆婆宮内大輔施薬大医正五位上国撰」とあり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日彼は正五位監事に補せられ月俸百円を給せられた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "正五位飯田軍造、天狗軍中強豪を以て聞えた木戸の軍造も、下妻の町外れで死骸を張付にかけられ、馬骨とおなじ穴に埋められてゐる。",
              "citation": {
                "source": "天狗塚",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "公延という二度目の名は文明元年すなわち彼の十五歳になるまで続いたが、元服と同時に官は右近衛権少将に進み、名は実隆と改まり、いくばくもなくして正五位下に叙せられ、翌年従四位下となった。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間に公条の方は次第に昇進し、明応二年には美作権介を兼ね、三年には従五位上、六年には十一歳で元服、右近衛権少将に任ぜられ、七年の十二月ちょうど兄の得度する少し前に正五位下に叙せられた。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて此書の編纂は何時であるかと云ふに、頭銜に正五位下行陸奧守兼上野權介とあるから、前に擧げた官歴から推すと、此書の寛平三年以後に成つた事が分る。",
              "citation": {
                "source": "日本國見在書目録に就いて",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治三十三年万国博覧会の巴里に開設せられし時、駐仏公使｜曾根荒助に推挙せられ博覧会事務長官に任ぜられ日本出品事務所所長となり斡旋の功によりて正五位勲四等に叙せられたり。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "從つて彼の譯書にも「海岸砲術備用」とか「海程測驗器集説」等があつて、外交海防に盡すところ多かつたし、のちに父良永と共に正五位を贈られてゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "大物忌神（従五位上勲五等）　　　出羽国飽海郡　　同　　　承和五年五月正五位下。",
              "citation": {
                "source": "山の今昔",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒形神（従五位下）　　　　　　　陸奥国　　　　　文徳天皇仁寿元年九月正五位下。",
              "citation": {
                "source": "山の今昔",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石椅神（正五位上）　　　　　　　陸奥国耶麻郡　　同　　　斉衡二年正月従四位下。",
              "citation": {
                "source": "山の今昔",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄山神（正五位下）　　　　　　　越中国新川郡　　清和天皇貞観五年九月正五位上。",
              "citation": {
                "source": "山の今昔",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "刈田嶺神（正五位上勲九等）　　　陸奥国　　　　　同　　　貞観十一年十二月従四位下。",
              "citation": {
                "source": "山の今昔",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく大宰大弐は職田六町とともに正五位の位田十二町、同じく大宰少弐は職田四町とともに従五位の位田八町。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正五位の年禄は右のごとく換算して四十二石であり、その特別給与は同じく五十四石である。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "久安六年正月六日正五位下、翌｜仁平元年正月六日従四位下。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正五位日下部東作記。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "和銅五年正月二十八日正五位の上勳五等　太の朝臣安萬侶一　古事記成立の過程、文章の用意方針。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "和銅五年正月二十八日正五位の上勳五等　太の朝臣安萬侶一、イザナギの命とイザナミの命天地のはじめ――世界のはじめにまず神々の出現したことを説く。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
