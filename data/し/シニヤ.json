        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近ごろは、独逸、仏蘭西はつい隣りで、マルセイユ、ハンブルク、アビシニヤごときは津々浦々の中に数えられそうな勢。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "快活らしい元気な表情の中には、ただ、ゼーヤから拾ってきた砂金を掴み取り、肌の白い豊満な肉体を持っているバルシニヤを快楽する、そのことばかりでいっぱいだった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はお祝にグロキシニヤの大鉢を持って此処へ訪ねて来た。",
              "citation": {
                "source": "智恵子の半生",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はお祝にグロキシニヤの大鉢を持つて此処へ訪ねて来た。",
              "citation": {
                "source": "智恵子抄",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は借金とりをラ・マンチャの紳士の水車の化け物に見たてゝ戦ひ、女房の妹を口説いてもトボソのダルシニヤ姫になぞらへる。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は借金とりをラ・マンチャの紳士の水車の化け物に見たてて戦い、女房の妹を口説いてもトボソのダルシニヤ姫になぞらえる。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "野蛮なるアンチノオス（訳者注　ハドリアヌス皇帝の寵臣たりし非常に美しきビシニヤ人のどれい）であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
