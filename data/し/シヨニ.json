        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミンナデ　イツシヨニ　ニギヤカニ　フキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ナタネノ　ツボミト　イツシヨニ　ソダツタ　テフテフデスカラ、ナタネノ　花タチトハ　タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレト　一シヨニ、ソノ　ウタヲ、ヨク　ウタツテ　下サツタ、ヤサシイ　オ母サンノ　コトモ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ヒトビトハ　ウマヤ　ウシト　イツシヨニ　ハタケニ　デテ　キテ　セツセト　ハタラキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "リアリズムからナチユラリズム、ナチユラリズムからインプレツシヨニズム、それからこの動的芸術は一歩を進めて出て来てるのである。",
              "citation": {
                "source": "動的芸術",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "動いたまゝのインプレツシヨニズム――私は其処に新しい芸術を認める。",
              "citation": {
                "source": "動的芸術",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアサン　イツシヨニセツセツセ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "三汀及びその仲間の仕事は詩に於ける北原白秋氏の如く、俳諧にアムプレシヨニスムの手法を用ひしものなれば、面白がりて読みしものなり。",
              "citation": {
                "source": "わが俳諧修業",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドナタカ、私ノ家ヘ一シヨニ住ンデ下サル方ハアリマセンカ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲキテ記念ノタメニコホロギサント一シヨニ写真ヲウツシマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタノアサハ　ジヤガイモサンニモサウ言ツテ二人デ一シヨニ、キツト　オミオクリニキテクレタマヘ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人ハ　コンナワケデ、一シヨニマチヘ行ツタノデ、ソノ時カラコツチ、人参ト玉ネギトジヤガイモハ　イツモ一シヨニオ料理サレルヤウニナリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワンコチヤンハソレヲキイテ　一シヨニカナシクナツテ、ワン、ワンナキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレナラ　イツシヨニ　ノハラヘ　イツテミヨウ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテイヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ　フタリハ　イツシヨニ　ワラツテ「マア、ポカポカト　アタタカイヒデ　ゴザイマシタワネエ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
