        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "誰かが懐中をのぞいたならば、すこしふくらんだふところの中に鼠色をした捕縄と白磨き朱総の十手とが、ちゃんと隠されてあることに、きっと感づいたに相違ない。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手にはいつかしら白磨きの、握り太の如意をひっさげていた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤地錦の直垂に、色かんばしい緋縅の鎧、すなわち曦の御鎧を召された、大塔宮護良親王は、白磨きの長柄をご寵愛の家臣、村上彦四郎｜義光に持たせ、片岡八郎その他を従え、窓から窺われる河内平野の、朝霧の景色をご覧になりながら、舎弟｜正季と恩地太郎とを連れた、楠木正成と顔を合わした。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……つもっても見ねえ、この通り羽目は檜の白磨きにして、天井は鶉目、小座敷の床柱には如輪木をつかい、飯台は節無し無垢の欅ぞっき、板場はすべて銅葺にして出てくる徳利が唐津焼。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "かごやの客",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊主畳を敷いた長二十畳で、大きな炉を二カ所に切り、白磨きの檜の板羽目に朱房のついた十手や捕繩がズラリとかかっている。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "小鰭の鮨",
                "note": "青空文庫"
              }
            },
            {
              "text": "その野郎をフン縛つてしまひませう」　懷から白磨きの十手、袂からはくり出す捕繩。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八千兩異変",
                "note": "青空文庫"
              }
            },
            {
              "text": "落つき拂つた圓三郎の頬桁を、白磨きの十手で毆つてやりたいほど、日頃の平次にも似ぬ興奮です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "闇に飛ぶ箭",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で調べてみると、鷹の羽を矧いだ箆深の真矢で、白磨き二寸あまりの矢尻には、松前の人々が使うという「トリカブト」の毒が塗ってあったということです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金色の処女",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻裏を穿いて、白磨きの十手を懐ろに落します。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "橋の上の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で調べて見ると、鷹の羽を矧いだ箆深の眞矢で、白磨き二寸あまりの矢尻には、松前のアイヌが使ふと言ふ『トリカブト』の毒が塗つてあつたと言ふことです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "金色の處女",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、困つたことに八五郎の持つて來た十手は、自分の持つて居る眞黒な房のない十手ではなくて、威勢を示して相手を挫くために、親分の錢形平次から借りて來た、白磨き朱房の申分ない立派な品だつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "盜まれた十手",
                "note": "青空文庫"
              }
            },
            {
              "text": "頬を押へた十手の白磨きが、窓から入る青葉の陽に反映して、温かさうに光るのも、妙に惱ましいシーンでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鬼の面",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺の住んでいる町内で、そんな人を舐めた事をしやがって、ガラッ八、来い」　帯をキュッと締め直すと、白磨きの十手を手拭に包んで懐の奥へ、麻裏を突っかけて、パッと外へ飛出します。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "幽霊にされた女",
                "note": "青空文庫"
              }
            },
            {
              "text": "白磨きのがっちりした飯台が四つ、二列に並べてあり、腰掛も樽ではなく、よく枯らした杉の厚い板で、一人ずつ座蒲団が置いてあった。",
              "citation": {
                "source": "落葉の隣り",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
