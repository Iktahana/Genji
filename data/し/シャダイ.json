    "definitions": [
      {
        "index": 1,
        "gloss": "chassis",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新車の車台番号は、車検証に記載されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新しい自動車の車台は非常に強度が高い設計になって安全性が向上していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "車の重要なエンジンと駆動系全体は強固な車台に支えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "鉄路が悪かったのか車台の安定が悪かったのか、車は前後におじぎをするように揺れながら進行する。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "座席に腰かけた人の右手にハンドルがあってそれをぐるぐる回すとチェーンギアーで車台の下のほうの仕掛けがどうにかなるようにできているらしい。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖母さんが最後に「よいとな」と大きく調子をとって、車台へ登ると蹴込みに敷いてある獅子の毛皮のようなもじゃもじゃした布の上に「つぁらっ」と擦れる音がして、新らしい後歯がかすかに刷毛でのべた様な赤土のあとをつけた。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、その、ちょっとあらかじめ御諒解を得ておきたいのですが、お客様が小人数で、車台が透いております場合は、途中、田舎道、あるいは農家から、便宜上、その同乗を求めらるる客人がありますと、御迷惑を願う事になっているのでありますが。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車使は車台へあがりました。",
              "citation": {
                "source": "やどなし犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の生命を託した車台は、急廻転をして、海へ陥ることから免れた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初、車台が海に面する断崖へ、顛落しようとしたとき、青年は車から飛び降りるべく、咄嗟に右の窓を開けたに違いなかった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "信一郎は車台に近寄って、黙礼した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比谷公園の樹の間に、薄紫のアーク燈が、ほのめき始めた頃から幾台も幾台もの自動車が、北から南から、西から東から、軽快な車台で夕暮の空気を切りながら、山下門の帝国ホテルを目指して集まって来た。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車道の、鋪石が悪くなっている故か、車台は頻りに動揺した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、其処に化石した人間のように立ち止まって、葉桜の樹下闇を、ほの／″＼と照し出しながら、遠く去って行く自動車の車台の後の青色の灯を、何時までも何時までも見送っていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だか見たことのある車台だと云う気がしたのも、無理ではなかった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "車台の床に投げられている彼女の視線には、青年が持っている細身の籐のステッキの尖端だけしか映っていなかった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車に乗る時に買った新聞を読む時に風呂敷包が邪魔になったので、自分の背と車台の羽目板の間に置いたことに気がついた。",
              "citation": {
                "source": "出世",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのせいか、この頃出来た新しい車台は、車掌と運転手の居る処を交通遮断している。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら降りても知れたもので、記者の見たところでは全車台の三分の一位にしか見えなかった。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "車台の数も多く、盛にブーブーやっている。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "市内の電車は車台の多数を焼失したので、運転系統がいろいろに変更して、以前ならば一直線にゆかれたところも、今では飛んでもない方角を迂回して行かなければならない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、いま、転車台でクルリと一廻りして扇形機関庫へ連れ込まれたD50・444号ですが、一寸調べて見ると、何処でいつの間に轢潰して来たのか、こいつがその「ミソ」の部類に属する奴なんです。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛込に来ると、ほとんど車台の外に押し出されそうになった。",
              "citation": {
                "source": "少女病",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "正月は車代が高いのみならず、全市の車台の数も限られているのであるから、大抵の者は車に乗ることは出来ない。",
              "citation": {
                "source": "年賀郵便",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "市内の電車は車台の多数を焼失したので、運転系統が色々に変更して、以前ならば一直線にゆかれたところも、今では飛んでもない方角を迂回して行かなければならない。",
              "citation": {
                "source": "十番雑記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初、車台が海に面する断崖へ、顛落しようとしたとき、青年は車から飛び降りるべく、咄嗟に右の窓を開けたに違ひなかつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "信一郎は車台に近寄つて、黙礼した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "日比谷公園の樹の間に、薄紫のアーク燈が、ほのめき始めた頃から幾台も幾台もの自動車が、北から南から、西から東から、軽快な車台で夕暮の空気を切りながら、山下門の帝国ホテルを目指して集まつて来た。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車道の、鋪石が悪くなつてゐる故か、車台は頻りに動揺した。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、其処に化石した人間のやうに立ち止まつて、葉桜の樹下闇を、ほの／″＼と照し出しながら、遠く去つて行く自動車の車台の後の青色の灯を、何時までも何時までも見送つてゐた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だか見たことのある車台だと云ふ気がしたのも、無理ではなかつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
