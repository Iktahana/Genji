    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "船長はこれが苦労の仕納めだとは全然思っていないようであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "罪はみんな俺が引き受けてやるからナ……それが俺の人助けの仕納めだ……なぞと親父は毎日のように云って聞かせたので、スッカリその文句を暗記してしまった。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（仕納めだ）　と、思った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "――仲間の奴も、見てやがるだろうが、庄吉、一世一代の仕事の仕始めの、仕納めだ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕達の特務も、このたびが仕納めだと思うと、湧きあがってくる感傷をどうすることも出来ないのであろう。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――奉公の、今度こそ仕納めに、出かけることにしよう」と云った。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とてもの事に道楽の仕納めには思ふさま凝つた妾宅建てたきもの何とぞ御暇の節御意匠｜被下まじくや。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "我儘の仕納めだろう」「君！",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら毎日々々の仕事が、いつも仕始めで仕納めなので、仕直しということがないのです」と申しました。",
              "citation": {
                "source": "益子の絵土瓶",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
