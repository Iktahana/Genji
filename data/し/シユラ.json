        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オリイヴ・シユライナア女史の書いたものに、その製作のために段々痩せ衰へる画家があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホルツ・シユラアフなどの作とは、作風が余程古い型にはまつてゐる。",
              "citation": {
                "source": "ペチヨリンとゲザ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「爾はシユラミの婦女のために、吾の娘を葡萄のごとく圧し潰した。",
              "citation": {
                "source": "碑文",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて方向を定め、シユラか極楽かに御供可申奉存候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年十一月十一日　林謙三あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚、母の権利、小児の保護等に対して如何に最善の形式が現はるゝとも女子がかのシユライエルマヘルによつて与へられたる十誡を遵奉すること能はざる間は無効に終るであらう、若しその十誡にして実行されたならば人道を内部より外部に渡つて一新する事が出来るであらう。",
              "citation": {
                "source": "恋愛と道徳",
                "author": "エレン・ケイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
