        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先発投手が九回を一人で投げ切り、完璧なシャットアウトで今季三勝目を挙げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "守備陣が相手チームをシャットアウトに抑え、スタジアムは大きな歓声に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "チームは三試合連続シャットアウト勝ちという球団記録を塗り替えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "夫をシャットアウトしたんだな。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争中極端に外国語をシャット・アウトした反動で、この頃の日本語の中へはさまざまな外国語や片言がなまっておりまぜられてきた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは熱心に敵方のときも大真面目で投げているので、それが不思議でならなかったが、それでも相手方をシャット・アウトに抑えたときの気分は、なんともいえず嬉しかった。",
              "citation": {
                "source": "煙突",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "しょうがねえ、まさにシャット・アウトだ、と彼は思った。",
              "citation": {
                "source": "赤い手帖",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
