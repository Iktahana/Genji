        "examples": {
          "standard": [
            {
              "text": "チームは粘り強い戦いの末、ついに悲願の勝利を収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は数々の難関を乗り越え、医学部入学という目標の勝利を収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「やった！ついにこのプロジェクトで、我々が勝利を収めることができた！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "そのときに至って、わが地球兵団は果して宇宙の強敵に対して必ず勝利を収めるだけの自信があるだろうか。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            }
          ]
