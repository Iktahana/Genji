        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "与惣兵衛は腹をたてて、「ケッコンスルナ　フラチ　カンドウ」　と打ってやると、シヨウチシタ　サガシテミルという電報がきた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ハ外ニ書クコトモナイカラ、コンナ時ニ少シ心ニアルコトヲ記シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チョット失礼イタシマス」ト、予ハ寝台ヲ下リテ浴室ノ戸ノ前ニ行キ、把手ヲ廻シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何度モ何度モ聞キ直シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ試ミニ息ヲ吸ッタリ吐イタリシテミルト、ヤッパリ間違イナクピイピイト鳴ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白クナッテ何度モ試シテミル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
