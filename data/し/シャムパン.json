        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "酔払った連中は、二つ返事で銘々美女を相擁し、威勢よくシャムパングラスを左手に捧げ立った処を、ポッカアンとマグネシュウムが弾けて一同、写真に撮られてしまいました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘いシャムパンのような酒が出る。",
              "citation": {
                "source": "想い出",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "カビの生えた、それも青々と、そして、やたらに穴のあいているのなどを、これがオツなんだと言われて、口に入れてはみたものの、あんまりオツすぎて、プフッと言っちまって、あわてて、甘口のシャムパンを飲んだことなども思い出す。",
              "citation": {
                "source": "想い出",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘いシャムパンと、赤白の葡萄酒の、ほろ酔いである。",
              "citation": {
                "source": "想い出",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "近衛文麿の道楽息子文隆といふのがシャムパンをやたら抜くやら、僕は服部良一をつかまへて議論するやら大さわぎ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "金語楼や伊志井寛もゐて、シャムパンを抜き、のみ又喋る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムパンばかりで白ワインが出なかったのは残念だ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "次のマトン・チャップはその元気なし、とてもうまい、赤葡萄とシャムパンで陶然と夢心地、甲板でコーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネが十時十分、神戸のマルセル・ルキエン迎へに来り、渋谷のシュヴァリエ邸へ、フランス料理、うまい羊肉、赤白のワインにシャムパン、夜あけ迄のむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
