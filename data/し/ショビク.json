        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "重い荷物をしょ引いて、彼はやっと山頂にたどり着いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "漁師は網にかかった大漁の魚を浜までしょ引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供は、気に入らないぬいぐるみをしょ引いて歩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "魔どのがそれしょびくでの。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「貴公、どこへしょびくんじゃ、あの美人をよ、巧く遣りおるの。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しょびくたって何も君、まったくさ、お嬢さんが用があるそうだ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ひきしょびくじょッ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to take (a suspect to the police)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
