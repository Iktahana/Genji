        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アルカージナがソーリンと腕を組んで、つづいてトリゴーリン、シャムラーエフ、メドヴェージェンコ、マーシャが登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　〔一八〕七三年のポルタヴァの定期市で、あの女優はすばらしい芸を見せましたっけ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（腰をおろす）シャムラーエフ　（ふーっとため息をして）パーシカ・チャージン！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　お説には賛成しかねますな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　（大声で）ヤーコフ、ちょっくら一つ、幕をあげてくれんか！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　忘れもしませんが、いつぞやモスクワのオペラ座でね、有名なあのシルヴァ（訳注　イタリアの歌手）が、うんと低いドの音を出したんです。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（彼の腕をささえる）シャムラーエフ　（妻に片手をさしのべて）マダーム？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（シャムラーエフに）お願いだが、なあシャムラーエフさん、あの犬を放してやるように言ってくださらんか。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　駄目ですな、ソーリンさん、穀倉に泥棒がはいると困りますからな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "用事は電話……往来にゃ辻馬車が通る、とまあいった次第でな……ドールン　（口ずさむ）「ことづてよ、おお、花々」……シャムラーエフ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　ほう、皆さんお揃いだ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　ふむ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　（興奮して）よそ行きの？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　奥さん！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　（カッとして）そういうことなら、わたしは辞職します！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（シャムラーエフの去った方角を見やって）まったくやりきれん男だ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "また汽車か、停車場、食堂、カツレツ、おしゃべり……シャムラーエフ　（登場）まことに残念ながら、申しあげます、馬車をお回ししました。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　ちょいと一筆お手紙を頂きたいもので！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフの笑い声が聞える。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ、トリゴーリン、つづいてシャムラーエフ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　（はいりながら）われわれはみな、自然の暴威のもとに老いさらばえていきますが、奥さんは相変らず、じつにお若いですなあ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフは蝋燭（訳注　複数）をともしたり、椅子を並べたりする。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　（口まねをして）馬を……帰らなくちゃ……（厳格に）その眼で見たろう――今しがた停車場へ行って来たばかりだ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "さも申し訳なさそうな物腰）シャムラーエフ　なんとか帰れるさ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ、マーシャ、ドールン、カルタ机につく。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　まあそう急ぐな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　大学生が、お祭さわぎをしてくれてね……花籠が三つ、花束が二つ、それからほら……（胸からブローチをはずして、机上に投げだす）シャムラーエフ　なるほど、こりゃ大したものだ……マーシャ　五十！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　新聞でひどく叩かれてるね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャムラーエフ　（トリゴーリンに）そうそう、トリゴーリンさん、あなたの物が残っていましたっけ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
