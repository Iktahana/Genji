        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これは、ヴォルガ河の沿岸にあるシロコイエ村の貧農たちが、荒れきったブルスキーという土地を貰ってそこで村の富農の侮蔑や陰険なずるさと戦いながら集団農場を組織する経路を書いた長篇である。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たった一つシロコイエの連中はいい仕事をした。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりシロコイエ村の経済状態てものが分らないんだ。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シロコイエ村に、階級闘争が起らなくちゃ成らなかったべえか。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
