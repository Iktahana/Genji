        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "瀬戸内海の島巡りツアーに参加して、直島や小豆島のアート作品を一日かけて堪能した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「老後は小型船をチャーターして、南の島々を自由に島巡りするのが夢なんだ」と彼は語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "フェリーを乗り継いでの島巡りは、時間に縛られないゆったりとした旅を楽しみたい人に最適だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "五月××日　街に、島巡りのサーカスが来たというので、一家総出で見に行く。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サモアにとって禍なことに、彼等白人は悉く――政務長官から島巡り行商人に至る迄――金儲の為にのみ来ているのだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "島巡りは何という島か忘れたが、三つ四つも渡り廻ったと思う。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "このままかえってしまうの惜しく、島巡りを思い立ち、Ｙ、地図を出して御者と相談して居る間に自分、一旦室まで戻ってレインコートをとり、出かける。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この島巡り大満足であった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しいところでは朝比奈三郎島巡りなどという奇抜なのがありますね。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "千万人の凡人共がガリバア旅行や朝比奈島巡りの空想を子供だましと嘲笑している時、ただ一人この空想と真面目に取り組む男があればよいのです。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝比奈島巡りの夢なのです。",
              "citation": {
                "source": "偉大なる夢",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し変った処といえば、獅子狩だの、虎狩だの、類人猿の色のもめ事などがほとんど毎月の雑誌に表われる……その皆がみんな朝夷島めぐりや、おそれ山の地獄話でもないらしい。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "道頓堀から糸屋の娘……女朝日奈の島めぐりで、わしが、ラバさん酋長の娘、と南洋で大氣焔。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい景色じゃないの……明日は早く起きてモーターボートで島めぐりをしてみない」「……ウウン……凪いでいたら行ってみよう」「……だけどコンナ村に住んでいる人間は可愛想なものね。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月廿七日　今日はサンマルコの前で朝食をしていると、給仕がひそひそ声で、十五リラ出せば島めぐりの切符をやると云う。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれに気がつかないと、いつまでも島めぐりを続けて、遂には発狂したり斃れたりします」「先生は、千早館にそのような島のあることを予期していらっしゃるんですか」「有ると思いますよ。",
              "citation": {
                "source": "千早館の迷路",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、ついでに感心すべきものを附記すると、Ｓ・Ｓデゴロという船で一夕の島めぐり。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "檜垣は僕のために島めぐりの案内人をつけようと言って、「そうだ、タイメイならちょうどよかろう。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日後の朝　僕はきゅうにうって変った背広服に色変りのズボン姿の「タイメイ」さん（その中には中島泰明という先日とは別の男が顔を出していた）といっしょに島めぐりに出かけた。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　島めぐりの最初の日は三里ほど歩いて阿古村という部落で一泊する予定だった。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "島めぐりのときにその場所を見つけたのだ。",
              "citation": {
                "source": "石ころ路",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "●ラゴ・マジョーレ　昼過ぎに小舟を雇って、ボロメエの島めぐりに出かけた、岸をはなれると、すぐ船頭の櫂をとって、久しぶりにこぎはじめる、パランツァの街はゆるく流れる波に揺れて、カムパニヤのマドンナの手にとるばかり岸に近いうしろには、冬枯れの山に野火の烟がゆるやかに立ち登る。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "時が移るので、釣を断念し、また舟に上って島めぐりをする。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時が移るので、釣を斷念し、また舟に上つて島めぐりをする。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "時としては、島めぐりに日を重ねて帰ることさえある。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十八　その翌日、駒井甚三郎は、鉄砲を肩にして、従者とては船乗の清八ひとりだけを伴い、島めぐりのためと言って、早朝から出かけました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "田山白雲も、毎日、島めぐりのために出発しますけれども、これは島めぐりというよりも、写景を目的として、任意に出て任意に帰るのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はその頃ちょうど三浦半島めぐりをしたいと思っていたので、少し遠いけれどどうかと提案してみた。",
              "citation": {
                "source": "墓場",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノリのシビが盛大に突ッたッてるのは東京湾だけかと思ったら、塩竈から松島めぐりの観光船の道中がノリシビのなかを漕ぎわけて行くのさ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいたい松島めぐりというのは、どんなに方々見て廻ってもみんな同じ風光だ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ恵まれた湾内の大部分を資源に利用する方が、松島めぐりの観光にも変化がつこうというものだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けば大阪の通人なぞのあいだでは、好きな芸者を道連れに仕立てて、毎年淡路の島めぐりをする者が珍しくないと云う。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥羽もこの附近の島めぐりをなさいますと丁度よろしい一日のお慰みになります。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
