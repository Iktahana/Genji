          "literary": [
            {
              "text": "その後漣が先生の称好塾に入門してから後、偶然この事が解った時、君が漣山人かと天台道士も意外の感に打たれたそうだ。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは、杉浦重剛先生の稱好塾に寓したれば也。",
              "citation": {
                "source": "小石川臺",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "稱好塾に寓せし頃、巖谷小波、江見水蔭も共に寓したりき。",
              "citation": {
                "source": "小石川臺",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
