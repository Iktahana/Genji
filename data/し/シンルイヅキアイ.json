          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "近所のおばあちゃんは、まるで親類付き合いのように私たち家族を可愛がってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長年隣に住む田中さんとは親類付き合いをしており、お互いの家を行き来している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "恩師とは卒業後も親類付き合いのように深い関係が続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      }
