        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "□オモヒデはトシヨリのキヤラメル□意志を忘れて来た男　意志だけ持つてゐる女□老顔のよさは雨露に錆びた石仏のやうなものだらう、浮世の風雪が彼を磨いたのだらう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムライハ　コシカラ　カタナヲ　サヤグルミ　ヌイテ　下ニ　オキ、キモノノ　スソヲ　ハシヨリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ラツパシユニ　ナツテ　リツパニ　ハタラキマス」ト　ワカイ　ヲトコハ　コタヘテ、トシヨリタチノ　マエデ　イサマシイ　ラツパヲ　フイテ　キカセマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　ヰタ　トシヨリハ　フカイ　タメイキヲ　ツイテ、「センサウハ　モウ　タクサンデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "目のさめた時はグツシヨリと汗が出てゐた。",
              "citation": {
                "source": "郁雨に與ふ",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビツシヨリと汗にぬれた手の平に快くも冷い風が当つたのを感じた。",
              "citation": {
                "source": "白明",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、先日の『日本』に伊予松山からの通信として梟が「トシヨリコイ」と鳴くと書いてあつたが、それは誤りで八幡鳩（珠数カケ鳩）が「トシヨリコイ」と鳴くのである。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、本家に戻つて来ると、二枚重ねて着てゐる服は汗でビツシヨリしてゐるし、シヤツも靴下も一刻も早く脱捨ててしまひたい。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツエイハンイハ、ヒジリバシヨリスイドーバシニイタルソトボリエンガン一タイ。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はビツシヨリ寢汗をかいて、目が醒める。",
              "citation": {
                "source": "恐怖について",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョイチョイ背後を振り返りながら、（あんまり速く走るのも、トシヨリに対して考えものだ）　こんなことを思っていたわるように、時々歩みをゆるめたりした。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（トシヨリに鉞、荷が勝っている。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼吾ト汝ハ如何ナル宿因有テカ、一度莫逆ノ交ヲ訂セシヨリ旦暮相離レズ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラズバ、又卑彌呼ノ英略ヲ以テ、國人ヲ服セシヨリシテ、人民自ラ女酋ヲ重ンズル心ヲ生ジ、遂ニ筑紫ノ各地ニ、女酋ノ興起スルニ至リシヤモ知ルベカラズ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あひるさんはベツドの中で、涙でグツシヨリになつて、「ああ、私が月謝の袋屋さんだつたら！",
              "citation": {
                "source": "月謝の袋を失くしたあひるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポチハ　トシヨリノ　イヌデス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三好達治も年をとり、私も退引きならぬトシヨリになっていた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "グイと足を踏み伸せば、首の罠が締つて、そのまゝ縊れ死ぬやうに」「他に變つたことはなかつたのか」「あつしが見付けたときは、すつかり息が絶えて、冷たくなりかけて居ましたが、死に際に、餘つ程ひどく涎を流したと見えて、顎の下のあたりから、首の後ろの罠の結び目へかけて、グツシヨリ濡れて居ました」「他に？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき獲物",
                "note": "青空文庫"
              }
            },
            {
              "text": "八日見という山名の起原に就ては、河原沢村の所伝に従えば八日見山ト申ハ、日本武尊東夷征伐ノ時、東国ノ海陸御巡幸有テ、夷賊追伐ノ御祈トシテ筑波山ニ登ラセタマヒ、遥ニ御覧アツテ、衆山相連ナレル中ニ殊ニ秀タル瞼山戌亥ニ当テ有リ、八日以来、見ヘタリト宣シヨリ、山ノ名ヲ八日見山ト名付ケ給フトナリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地捜シヨリハソノ方ガ優シダ、私ガ御案内シマショウト京二郎ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「我レ東ヲ征チシヨリ、茲ニ六年ニナリヌ、又天皇ノ威ヲ頼リテ、兇徒戮サレヌ。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
