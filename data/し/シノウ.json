          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "顕微鏡で観察すると、子嚢の中に並んだ8つの胞子がはっきりと見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "胞子を包む袋状の器官である子嚢が破裂し、中の胞子が周囲に飛散した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子嚢の形状や配列を調べることは、菌類の種を特定する上で欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "生殖は隠花植物、殊に羊歯植物門類似で、翼端に胞子嚢があり明らかに葉状体ないしは前葉体から進化したものだ。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（尊敬すべき詩人アルタに幸あれ、　スールダッタよ、あのうたこそはわたしのうたでひとしくおまへのうたである。",
              "citation": {
                "source": "龍と詩人",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のはなしのうちの子供、それから大きくなって息子と呼んではなしたのは私のことだと湊は長い談話のあとで、ともよに云った。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アアハハハハ、ランプはあかしのうちだい。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしのうちへ来るかい。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この空は広重のぼかしのうす墨のそら波はゆらぎ汽笛は深くも深くも吼える。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのひなげしのうしろの方で、やっぱり風に髪もからだも、いちめんもまれて立ちながら若いひのきが云いました。",
              "citation": {
                "source": "ひのきとひなげし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それでは御免を蒙りまして、や、こりゃ、お火が足しのうなりました。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのうちにあるものを、紙の上に見えるようにすることができるんです。",
              "citation": {
                "source": "ペンとインキつぼ",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしが表扉に近づくと、驚いたのなんの、鍵が挿さったままで、ふとわたくしのうっかりかと思ったものの、懐探るとちゃんとある。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "この十二ヶ月分もの見出しのうちに色々の冒険談が見つかる。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはわたしのうわおいぐつにそっくりだ。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「わたしのうたは、林の青葉の中できいていただくのに、かぎるのですがね。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのうわぐつすら、くびのまわりに、かけてやったではないか。",
              "citation": {
                "source": "小夜啼鳥",
                "author": "NATTERGALEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「わたしのうたう歌は、すこし調子がちがっている。",
              "citation": {
                "source": "ひこうかばん",
                "author": "DEN FLYVENDE KOFFERT",
                "note": "青空文庫"
              }
            },
            {
              "text": "護国寺前から音羽の通りを、通り魔の通るよう、手足も、衣も吹靡いて、しのうて行くか、と犬も吠えず鼠もあるかぬ寂とした瞬間のうつつに感じた。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、再び飛び散り、再び相寄り、床に伏して、キヤプテンの脚にふまへられる颯爽たる様がある、あしのうらの音が、ヒタヒタと床に、物凄まじく、拍手の音のやうに響き渡る、――また、三十人？",
              "citation": {
                "source": "舞踏学校見物",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごつたすつたやつてたうとうそれぢや自分等へ少しのうち其家を貸してくれろといふのでやつとのこと納得をさせておすがを松山の家へ入れた。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれ、深い事情があるだろう』と、きいたところが、その女郎め『わしのうちは、おとうさんが百姓で貧乏だったところへ、不作が三年続いて、地主に掟米が納められずに、苦しみ抜いたあげく、ついに私が身売りをして、地主に義理を立てることになったの』といったんだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひとり寝は君も知りぬやつれづれと思ひあかしのうら寂しさを　私はまた長い間口へ出してお願いすることができませんで悶々としておりました」　こう言うのに身は慄わせているが、さすがに上品なところはあった。",
              "citation": {
                "source": "源氏物語",
                "author": "明石",
                "note": "青空文庫"
              }
            },
            {
              "text": "直きじきにお手こそ下されねど、侍従もそれで身をうしのうた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その名城も主人をうしのうて、今は狐狸の棲家、荒るるがままに任かしてあるが、白鷺の名を呼ばるる城の壁は、あめ風にくずれもせいで昔ながらに残っている。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾州無宿の久右衛門、破牢の罪により四月五日江戸引きまわしのうえ梟首獄門。",
              "citation": {
                "source": "右門捕物帖",
                "author": "生首の進物",
                "note": "青空文庫"
              }
            },
            {
              "text": "番頭のまなざしのうちにはたしかに鋭い嶮があるのです。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、慌てゝ蛇籠の上に飛びあがる拍子にあしのうらを傷けたとのことであつた。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「太吉を君は一体何う思つてゐるのか知らないが、奴はあれだけ君の世話になつてゐるくせに、わしのうちなどに来て酒に喰ひ酔ふと、徹頭徹尾君の雑言だよ。",
              "citation": {
                "source": "木枯の吹くころ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "云いたい人には云いたいことを云わせておいて　この貧しい夫婦ぐらしのうちに　ほんとの生を愉しもうよ。",
              "citation": {
                "source": "遥かな旅",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしのうちに行って、そしてあたしの奪われているものを、貴郎に手伝ってもらって取返すのよ。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは路に倒れている人を介抱しないばかりか、あまつさえ其の所持品を奪い取るなど罪科重々であるというので、引き廻しのうえ獄門ときまって、かれの首は小塚ッ原に晒された。",
              "citation": {
                "source": "半七捕物帳",
                "author": "化け銀杏",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな時、下手まごつくと首が飛ぶし、それかというて、後込みしとると一揆からひどい目にあうしのう。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
