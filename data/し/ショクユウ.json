        "examples": {
          "standard": [
            {
              "text": "中世ヨーロッパでは、贖宥状を購入することで罪が赦されると考えられていました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "宗教改革の引き金の一つとなったのが、贖宥の販売でした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの時代、贖宥ってどういう意味があったんだろう？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "彼女は奇跡や九日｜祈祷や、紙レースで縁取った信仰画像や、贖宥のことなどを話した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
