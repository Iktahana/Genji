          "literary": [
            {
              "text": "五〇〇〇人の観衆の前で、エルヴィスは『オールド・シェップ』を、うたった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちのタレント・コンテストに参加した彼は『オールド・シェップ』を歌い、二位になって五ドルの賞金を手にした。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときは『オールド・シェップ』と『心のうずくとき』の二曲を彼は歌った。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "バックはそんなに大きくなかつた――体重は百四十ポンドしかなかつた――それは母親のシェップがスコッチ・シェパード種だつたからである。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
