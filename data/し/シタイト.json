        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カンザシヲ　ジブンノ　モノニ　シタイト　オモヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出勤ガシタイト兄ヘ云ッタラ、手前ガ手段デ、勤道具、衣服モ出来ルナラ、勝手ニシロ、オレハ、イカイコト手前ニハイリ上ゲタ故、今度ハ構ワヌトイッタ故、ソノ時ハオレガホホノ下ニハレ物ガ出テイテ寝テ居タガ、少シモ苦労ヲカケマイトイウ書附ヲ出シテ、檻ヲ出デ――」　出たな！",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
