[
  {
    "uuid": "c9d4eb78-a532-57f3-aced-cccd090125f3",
    "entry": "絞まる",
    "reading": {
      "primary": "しまる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
