    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボースン、そのワイアをあれへかけて引っぱるんだ、そら、シャックルがはずれた！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの勇敢なコシャック騎兵までが逃げてきまひた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはシャックリの出た人が気まり悪がる様に、身体の震えていることを気まり悪がった。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "探険家シャックルトンがベルリンへ来たときペンクの私邸に招かれ、その時自分も御相伴に呼ばれて行った。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その席でペンクは、本日某無名氏よりシャックルトン氏の探険費として何万マルクとかの寄附があったと吹聴した。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年、先行するアップル※とＰＥＴを追って、電子機器の販売チェーン、ラジオ・シャックで知られるタンディ社はＴＲＳ―80を発表。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男が芝生を横切って僕たちのほうへ近寄って来た時、僕はトレヴォ氏が咽喉の中で、あッと云うようなシャックリをする時のような声を出したのを耳にした。",
              "citation": {
                "source": "グロリア・スコット号",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから苦しがって、シャックリみたいな呼吸をしいしい狂いまわるの……。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしや他人に看破られはせぬか、知っている者に会いはせぬかとビックリ、シャックリ息を詰めて行きよります。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はボードレール、ヴェルレエヌ、ワイルドなどとともにウォーズウォースやミルトン、マーテルリンクを読み、フローベルやモーパッサンのためにソフォクレス、シャックンタラなどを忘れなかった。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のシャックリは、驚かせると止まりますが、ちょうどあんなようなもので。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャックリの出る私の人生観を一寸匂わしてね。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のように、泣きながら泥の上を引きずられて来た汚れた手で、足の裏を時々ガリガリやりながら思い出したようにシャックリをする。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのシャックリの語尾はまるで羊が鳴いているようにメーと聞えた。",
              "citation": {
                "source": "魚の序文",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハイ」「いゝ名だね」　女は子供のように小さいシャックリを上げて泣いていました。",
              "citation": {
                "source": "清修館挿話",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、この題を見てスグさまドヴォルシャックを連想してくれるような読者ならまず頼もしい。",
              "citation": {
                "source": "ふもれすく",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "右手の露路を越した彼方から、シャック、シャック、シャック、シャックと調子のよい機械の音が響いて来た。",
              "citation": {
                "source": "午市",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな頑固なシャックリでも酒石酸と炭酸曹達があれば直ぐ癒る。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人獣の差別を超えた純粋な精神の交流に心をうたれ、私は涙を流さんばかりだったが、追々ひく息ばかりになり、とうとうシャックリをするようになった。",
              "citation": {
                "source": "海豹島",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャックった道糸が再び海底へ沈んでいく途中、まだ海面に出ている部分の糸が僅かに異状を示したとき合わせれば、百発百中である。",
              "citation": {
                "source": "鯛釣り素人咄",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "（シャックリをしいしい、やっと助け起こされる）ヴィン　僕がお前のことを、どれだけ何しているか、それを考えてくれたら、そんな――シィヌ、僕はお前と結婚しようと思っているんだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同も仕方なくシャックリ上げたりしながらも泣声だけは止めて、ゾロゾロそれについて行く。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父さんが見つけて引っぱり出したけど、何を聞いても黙ってシャックリばかりしている。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、シャックリをする）三平　（柴田に）犬小屋から、へんな人間の足のようなものが突出しているから覗いて見たら、中でスースーいびきをかいて眠っているんですよ。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして再びボンヤリ三平を見て、シャックリをする）柴田　……しかし、そうだとすると、この室に入って来たことになるが？",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼をつぶつて時々シャックリをしている）御橋　（マジマジと見ていたが）ふん。",
              "citation": {
                "source": "夜の道づれ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
