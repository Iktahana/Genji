          "literary": [
            {
              "text": "シェリイ、クライスト、ああ、プウシュキンまでも、さようなら。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダラットぢやシェリイをよく飲んだね」　ゆき子は飯を終つて、またコオヒイを淹れて飲んだ。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シェリイの瓶を転覆してテーブル掛けを台なしにしたが、幸い何人も見ていなかった。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻シェリイを零した処は如何なったかと思って見たらナプキンが置いてあった。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その黒い石棚の上には、上等のサンドウィッチと、さかずきと、シェリイ酒の大壜が二つのっている。",
              "citation": {
                "source": "ルイスヒェン",
                "author": "LUISCHEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "バイロンやシェリイや高青邱など、若死した人の伝記をよんで、自分もまあ四十までは生きないと思いこんでいた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
