        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "羽織も着物も同じ矢絣模様の銘仙で、うすあかい外国製の布切のショオルが、不似合いに大きくその上半身を覆っていた。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しい女は、はずして、膝の上に手首に掛けた、薄色のショオルを取って、撫肩の頸に掛けて身繕い。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽織に、ショオルを前結び。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり卓子の上へショオルだの、信玄袋だのがどさどさと並びますと、連の若い男の方が鉄砲をどしりとお乗せなすった。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い毛のショオルにくるまって荒い飛白のコオトを着ていた。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」顎をショオルに深く埋めてかすかに頸をふった。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "白のカシミヤの手袋を用い、厳寒の候には、白い絹のショオルをぐるぐる頸に巻きつけました。",
              "citation": {
                "source": "おしゃれ童子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "律子は、ちらと振り返っただけで、買い物をまとめて、風呂敷に包み、それから番頭さんにお辞儀をして、それから澄まして三浦君のほうにやって来て、三浦君から十メートルもそれ以上も離れたところで立ち止り、ショオルをはずして、叮嚀にお辞儀をした。",
              "citation": {
                "source": "律子と貞子",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "過る窓から自分は目の醒めるような西班牙風のショオルを見た。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠色の毛糸のショオルをした、……」「あの西洋髪に結った女か？",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日の午後には、午前に想像したように、男は汽車の中で、楽に横になって頭を女の胸にもたせて、足の上にはショオルを拡げて掛けていた。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝台の縁に掛けてあるショオルを取って体に巻いて、椅子に腰を掛けた。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "寔に色の真白な女の如き優男ではありましたが、五尺三寸にも足らぬ小柄な華奢な肢体を真黒なモジリで包み襟元から鼻の辺迄薄色のショオルで隠し灰色の軽々しいソフト帽子を眼深に冠った、一見して旧派の女形然たる千代三とは似ても似つかぬ別人物ではありませんか？",
              "citation": {
                "source": "陳情書",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はショオルを二重に畳んで、掛蒲團の代りに被ぶせた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはこんな淋しいところに家を建てても借りる人があるか知らと、何心なく見返る途端、格子戸をあけてショオルを肩に掛けながら外へ出た女があった。",
              "citation": {
                "source": "元八まん",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二人は一緒に町を歩いてゐた……それからデパートメントストアに入つた……そこで彼女はショオルか半襟かを良人の兄に買つて貰つた。",
              "citation": {
                "source": "煤煙の臭ひ",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "その誰かは、寝衣のまま紅いショオルにくるまって、壊れた足台の上に坐っていました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "セエラはしばらくの間、小さい黒髪の頭を、赤いショオルで被われたアアミンガアドの肩にじっと乗せていました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "セエラは手で膝をかかえ、アアミンガアドはショオルにからだを包んで、「私は、もうとてもたまらなかったのよ。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "セエラはまるまるとしたアアミンガアドが赤いショオルにくるまっているのを見るだけでも、侘しい部屋が少し温まるようでうれしかったのでした。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　アアミンガアドはあまり急いだので、出しなに赤いショオルを落しました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、セエラは赤いショオルが落ちているのを見つけて、それを古いテエブルの上に掛けました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "テエブルに赤いショオルが掛ると、部屋の中は急にひきたって来ました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ショオルを肩にひきしめた佐知子は、津川の側へひき添うようにして歩いた。",
              "citation": {
                "source": "正体",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はショオルのあいだから嬌めかしく、むしろ勝誇ったように笑っていた。",
              "citation": {
                "source": "正体",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
