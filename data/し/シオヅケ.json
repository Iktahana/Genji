        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大量に頂いた胡瓜を、冬の間も食べられるように塩漬けにして保存する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この梅干し、昔ながらの製法でしっかり塩漬けにされているから酸っぱいよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "豚バラ肉を塩漬けにして熟成させ、自家製のパンチェッタを作ってみる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その剥げた薄い膳には干した川魚を煮た椀と幾片かの酸えた塩漬けの胡瓜を載せていた。",
              "citation": {
                "source": "泉ある家",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは塩漬け売りだ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様が今しがた人間を塩漬けにしていたのを、おれはちゃんと見ていたぞ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにもおれは自分が助かりたいばっかりに、二人の仲間を殺して塩漬けにしてしまった。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはこれから二人の塩漬けの人間を生き上らせに行くんだ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤ、ドッコイショ」　と云ううちに、二人の塩漬けの樽と鞄を結びつけた棒を担ぎ上げて、まだお酒の残っている樽を右手に持ちながら梯子段を降り初めました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エー、豚の塩漬けは入りませんか。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョロの塩漬けは入りませんかア。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エー、豚とヒョロの塩漬けやアーイ」　と怒鳴りながら、あっちへよろよろ、こっちへよろよろとしてゆきます。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚とヒョロの塩漬けだ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ生き上らして、自分で歩かしてやろう」　といいながら、無茶先生は二人を塩漬けにした樽を担いで、谷川の処へ降りて来ました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前たちは塩漬けになっていたんだから」「エッ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩漬けに……」　と二人共ビックリして、水を飲むのを止めてふり向きました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはお前たちをこの樽に塩漬けにして、おれはやっとここまで逃げて来たんだ」　と、無茶先生が今までのことを話しますと、二人は夢のさめたように驚きました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはきっと無茶先生が、豚吉とヒョロ子を塩漬けにしてここまで持って来られて、生き返らせられたのであろうと思いましたが、それから先は山が深くてとてもわかりませんから、一先ず村へ帰ることにきめて、今帰る途中なのです。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬籠りには、こいつの塩漬けが一ばんいい。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆さんは、王子を殺して塩漬けにするのを一晩だけ、がまんしてやろうと思いました。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "撲殺されて毛皮は売られ、肉は塩漬けにされ、また野師の手に買われてしまう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええと、皆さん、ここもと御覧に入れまするは、樺太海豹島は膃肭獣の塩漬け肉でござい。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の前部に、ビスケットの半分ばかりはいったタンクが一つと、塩漬けの肉が三樽、それから極めてわずかのコーヒーの実と、砂糖とがある。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前は自分の城を築いたが、こっちはまだ樽のなかから肉の塩漬けをつまんでるんよ。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々はセーラー服をそれぞれ一着ずつと、水の樽をひとつ、肉の塩漬けの入った樽ひとつと、ビスケットの樽ひとつ、コンパスひとつをもらった。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし『尹文子』に周人鼠のいまだの『朝野僉載』に、嶺南の鼠の塩漬けを食うとあり。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、頭に草が生えたとみたのは、かりゅうどの矢が首に当たる知らせで、背中に雪の積もったのは、殺されて塩漬けにされる知らせだというのです。",
              "citation": {
                "source": "夢占",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、列車の中に待っている可愛いアンと、そしてこの塩漬けになったような中国女であった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "食べきれないところは、乾物をこしらえ、塩漬けにした。",
              "citation": {
                "source": "瀞",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州では、小鰡を塩漬けにし、さらに押し酢にして、鮨に作ってこれをいな鮨と唱えているが、これは京都の鯖鮨に似て、随分おいしく食べられる。",
              "citation": {
                "source": "蜻蛉返り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお肴一盤のうちに、塩漬けの鯛が一尾あった。",
              "citation": {
                "source": "にらみ鯛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "であるから、漁場から塩漬けの鯛がきた。",
              "citation": {
                "source": "にらみ鯛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを漁師は、一塩漬けの日陰干しにして山女魚の餌に使うのであるが、人が食べてはうまいものではない。",
              "citation": {
                "source": "冬の鰍",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "holding on to (shares, land, etc.) for an extended period until its value increases",
