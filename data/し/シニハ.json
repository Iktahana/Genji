          "literary": [
            {
              "text": "「ケレド、ワタシニハ　キコエマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダイジナ　モノデスカ」「エエ、ワタシニハ　ダイジナ　モノデス」　ソコデ、サカナハ　ヨクガ　デマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カハノ　キシニハ　ハンノキガ　シゲツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "其證ハ大顱ノ白人モ、始ヨリ大顱タリシニハ非ズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヤ、ヤ、山ナンカ、キョウガ、ハ、ハ、ハジメテナンダ……アタシニハ……カミサンモ……コ、コ、小供モアルンダヨー。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キットソウニ違イナイヨ、アタシニハチャント分ッテイマス」「アハハハハ、ソンナラ颯子ニ聴イテ御覧ナサイ」「笑ウ人ガアリマスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ガ浴室ニイル時、アスコノドーアハマサカ開ケッ放シニハシテ置カナイダロウ、ソノ時ハ戸締マリヲスルデアロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ理由ハアタシニハヨク分ラナイガ、オ爺チャンコソ何カシラ感ヅイテイラッシャルノデハナイデショウカト、乙ニ絡ンデ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
