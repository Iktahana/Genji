        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「明日の社会のテスト、地理と歴史のどっちが範囲だったっけ？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は社会の授業が大好きで、特に世界の国旗や首都について詳しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小学校の社会の時間に、近所のスーパーマーケットの見学に行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
