        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は又、近來といへども自分の態度に、他人を飜弄せむとする興味が全然跡を絶つてゐるとは勿論いへないが、その際に於いてもなるべくシーリヤスな點を避けてゐると思つた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーリヤスな點に觸れる限りに於いては、彼は戲謔の間にシーリヤスな忠告をしようとする目的を持つてゐると思つた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
