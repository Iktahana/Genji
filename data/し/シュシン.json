        "examples": {
          "standard": [
            {
              "text": "サッカーの試合では、主審の判定が勝敗を左右することもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は経験豊富な主審として、数々の国際大会で笛を吹いてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ファウルです！」と主審が叫び、試合は一時中断した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
