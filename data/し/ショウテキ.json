        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大会初戦は、実力差のある少敵だったので、危なげなく勝利した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「こんな少敵に手間取っていたら、本戦では勝てないぞ！」と監督が檄を飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、自分より少敵と見なされる相手にも、決して油断することはなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ジャックリーヌは黙っていて、多少敵意を見せていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
