        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おまけにショウルダアだって、こんなに薄くちゃなってない。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲で編んだ箕帽子を冠り、色目鏡を掛け、蒲脚絆を着け、爪掛を掛け、それに毛布だの、ショウルだので身を包んだ雪装束の人達が私の側を通った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "お幸さんはショウルにくるまつて、その中に肩から顔まで埋めて、寒さうに震へながら戻つて行つた。",
              "citation": {
                "source": "突貫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はショウルで肩を包んで、子供のように歔り上げながら、ＳＯＳを打つフィリップスの指先を、泪で曇った眼で凝視め続けた。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ショウルを引っ掛けて警察へ走ると、前夜自殺室に眠った勇敢なる巡査カミィルを掴まえて、「金曜日の晩、もう一度あの部屋に泊ってみて下さい。",
              "citation": {
                "source": "ロウモン街の自殺ホテル",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸が痛み、頭が痛むと言って、母に叩かせたが、もっと元気に叩いてくれなどと言って、どうかすると掛けてあるショウルを撥飛した。",
              "citation": {
                "source": "芽生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦や附添の女にも別れて、私はショウルに包んだお房の死体を抱きながら、車に乗った。",
              "citation": {
                "source": "芽生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "青空から、快晴な雪解の日につきものの風が渡って、杉の生垣を吹き、朝子のショウルの端をひるがえした――。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして濃い空色のショウルを自暴に手首に巻きつけたモデルのとみ子がつと這入つて来た。",
              "citation": {
                "source": "静物",
                "author": "十一谷義三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同じ瞬間に、その女のショウルと帯の色合ひと横顔の輪郭とがハツキリと彼の記憶に再燃した。",
              "citation": {
                "source": "静物",
                "author": "十一谷義三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
