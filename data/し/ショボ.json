          "literary": [
            {
              "text": "また庶母伊迦賀色許賣の命に娶ひて、生みませる御子、御眞木入日子印惠の命、次に御眞津比賣の命二柱。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
