    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hand-copied sutras",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "禅寺で毎日朝の写経を行っている修行僧たち。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "写経を通じて心を静める修行をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は毎週日曜日に写経の時間を設けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "名門ではございましたそうですが、おちぶれて奥さまと二人、ご自分は昔からの写経をなさり、奥さまは機を織って、しずかにくらしていられました。",
              "citation": {
                "source": "雁の童子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "須利耶さまは知らないふりで写経を続けておいでです。",
              "citation": {
                "source": "雁の童子",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その目的の為めでもなかつたが、私は偶然少女の茶店の隣の表具店に写経の巻軸の表装を誂へに行つて店先に腰かけてゐた。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "※は犬塚氏を去り、鎌倉の寺院に寓し、写経して口を糊した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀三が出っ歯をむき出しにして迎えて、師匠は只今お写経でございますが、と言う。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "加福の師匠は写経の筆をおいて机から離れたところであった。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "師匠の写経をみかけるのは初めてのことだったし、そのことから妙に心が急き立てられるまま尋ねた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の上の写経へわたくしは眼をやった。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "写経に至るまでの師匠の心の裡も漸う汲まれて、筆差しにささった筆のまだ墨の乾き切らぬ穂先を眺めているうちに、不意に、哀感がそこから衝いてきた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな日はお客さんも無し、お遍路さんも来ず、一日中昼間は手紙を書くとか、写経をするとか、読経をするとかして暮します。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初の写経は、師の手に渡ると、ずた／＼に引き裂かれて、火桶に投げ込まれた。",
              "citation": {
                "source": "身毒丸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "写経のことには一言も言ひ及ばなかつた。",
              "citation": {
                "source": "身毒丸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、机に向うて、五度目の写経にとりかゝるのである。",
              "citation": {
                "source": "身毒丸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "源内法師は、この時、まだ写経を見つめてゐた。",
              "citation": {
                "source": "身毒丸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "五度目の写経を見た彼は、もう叱る心もなくなつてゐた。",
              "citation": {
                "source": "身毒丸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、この時代によく読誦せられ、写経せられた簡易な経文であつたと言ふのと、一つは有名な遺物があるからである。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、この時代によく読誦せられ、写経せられた簡易な経文であったと言うのと、一つは有名な遺物があるからである。",
              "citation": {
                "source": "山越しの阿弥陀像の画因",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それで今日では尼僧かのように、いつも一室にとじこもりまして、香をたき花を活け、写経をし古書籍を読み、浮世をすてたようなありさまで、お暮らしなされておられますそうで」「ははあ」　と伊豆守はそれを聞くと、空洞のような声でそう云った。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから写経用の唐紙の巻物をくり拡げる。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この写経には、彼女は老眼鏡をかけ、白昼でも必ず電燈をつける。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや白昼に限るのであって、夜分は決して写経はしない。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は写経をするようになると、或は写経を終えると、あとの寿命は長くない。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "写経が遅々としてなかなか進捗しないのを、ひそかに窺って、二人は却って喜んでいる。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヨは写経の神聖な仕事にかかるのである。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が読経は殆んどせず、写経にばかり凝ってることを、久子はやはり怪しく思い起した。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "写経に凝りだしたのも、特別な求道心からではない。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "内に在るそのものの邪魔になる場合には、逆に、写経の巻物など破り捨てるかも知れない。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヨは卵酒を飲んで、そのお盆を階段口に押しやり、机の上に写経の巻物をひろげ、その上に両手を置き顔を伏せて、眠っている。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "北条団水の「一夜舟」に、京都東山に庵を結ぶ碩学があり、一夜写経に没頭してゐると窓から手をさしのべて顔をなでる者があつた。",
              "citation": {
                "source": "日本の山と文学",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっしゃきょう一日で、三百匁ばかり目方をへらしましたぜ」　それを聞き流しながら、右門もそこにぐったりとからだを投げ出していましたが、と、やにわにむっくり起き上がると、突然くすくす笑いながらいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "村正騒動",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
