          "standard": [],
          "literary": [
            {
              "text": "俗にそれを「シンネコ」というが、実にシンネコでもって大きな船がニョッと横合から顔をつん出して来るやつには弱る、危険千万だ。",
              "citation": {
                "source": "夜の隅田川",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのための「シンネコ」的風景だったのだ。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
