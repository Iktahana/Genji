    "definitions": [
      {
        "index": 1,
        "gloss": "drawing red lines",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "重要書類の訂正箇所には、朱引きをして印鑑を押してください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この図面の変更点は分かりやすく朱引きしておいたよ」と先輩が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "経理担当者は、帳簿の誤記入を丁寧な朱引きで修正した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "近所はどうしたかと見てあるくと、ほかの家の杭はみんな元の通りになつてゐて、わたしの家のまはりの杭だけがなくなつて仕舞つたもんですから、こゝだけが赤い杭の外へこぼれ出して、朱引き外と云つたやうな形になつてゐるんです。",
              "citation": {
                "source": "赤い杭",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "今もいふ通り、誰がしたのか知れませんが、家のまはりの赤い杭を抜いてしまつて、こゝだけを朱引き外にして置くと、不思議に火の手が廻つて来なかつたんです。",
              "citation": {
                "source": "赤い杭",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも彼是真夜中になると、その早桶のおのづからごろりと転げるといふに至つては、――明治時代の本所はたとひ草原には乏しかつたにもせよ、恐らくまだこのあたりは多少｜所謂「御朱引き外」の面かげをとどめてゐたのであらう。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "朱引きそとの、本所松阪町にある吉良邸の一室だった。",
              "citation": {
                "source": "口笛を吹く武士",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "常盤橋際から、朱引き外の本所松阪町へ移った吉良家門内の長屋で、一角はいま、小林の許を辞して、この、じぶんの住いへかえってきたところだ。",
              "citation": {
                "source": "口笛を吹く武士",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフッ、（お妙の顎を掴んで頬ずりのようなことをしてからツイと奥の方へ歩き出しながら）ホ、ホ、御朱引き外も外すぎる、こんな田舎で芸者もできないじゃありませんか。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフッ、（お妙の顎を掴んで頬ずりのようなことをしてからツイと奥の方へ歩き出しながら）ホ、ホ、御朱引き外も外すぎる、こんな田舎で芸者も出来ないじゃありませんか。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから約十五年、市中は云うまでもなく、朱引き外まで、品物を担いで根気よくしょうばいして歩いた。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "鶯ばか",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと馬場下とは高田の馬場の下にあるという意味なのだから、江戸絵図で見ても、朱引内か朱引外か分らない辺鄙な隅の方にあったに違ないのである。",
              "citation": {
                "source": "硝子戸の中",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに朱引内か朱引外か少々｜曖昧な所で生れた精か知らん今まで江戸っ児のやるような心持ちのいい慈善的事業をやった事がない。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どじを踏むと、八丁堀の息のかかる、御朱引内で、十手は持たせねえぞ！",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかれこれ真夜中になると、その早桶のおのずからごろりところげるというに至っては――明治時代の本所はたとえ草原には乏しかったにせよ、恐らくはまだこのあたりに多少いわゆる「御朱引外」の面かげをとどめていたのであろう。",
              "citation": {
                "source": "本所両国",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさしく朱引内を離れて、甲州街道の宿駅を走っているのだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてこの道づれは滞りなく江戸の朱引内を出てしまって、例によっての甲州街道を歩み行くうちに、どちらが先ということもなく、二人が話をはじめる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカラヒク・ハダに就き、代匠記初稿本に、「それは紅顔のにほひをいひ、今は肌の雪のごとくなるに、すこし紅のにほひあるをいへり」といい、精撰本に、「朱引秦トハ、紅顔ニ応ジテ肌モニホフナリ」と云ったのは、契沖の文も覚官的で旨い。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その詮議の峻烈さに唐犬組や夢組も、散りぢりばらばら御府内朱引内から足を抜いてしまった。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中松井田で、自斎は尋ねる剣友があるからとて別れを告げ、千浪と重蔵とは、再び世を忍ぶ天蓋の下、一管の尺八に、流転を託す虚無僧となりすまし、玄蕃の足蹟に気をくばりながら中仙道の宿駅を次いで、江戸の朱引内へ近づいて行く。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここらはもう無論江戸の朱引外ですし、本街道にも外れていますから、めッたに会う人とてはありませんが、出ッくわした者は、あッといって見送る前に腰をぬかしていたかも知れない。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸｜朱引内の境、八ツ山下の木戸を通りこえたのは、やがてその日の七刻過ぎ――。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
