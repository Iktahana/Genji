        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シーダーズ荘にある僕用の部屋には、寝台がふたつあったな。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこがシーダーズ荘だ。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹木はシーダーが目立つて多かつたが、木蓮の白い花が盛りなのを見て、日本よりも季節の後れてることを感じた。",
              "citation": {
                "source": "ウォリクの城",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを読むと町名はいくらでもあり、フロント（前）、パイン（松）、ウィロー（柳）、シーダー（杉）等我国のと同じのもあれば、また「ありあまる喜悦」、「墓の戸」、「一つの色」、「山のそよ風」、「指の谷」及びそれに類似した、極めて奇妙な町名もある。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーダーと葡萄園と果樹園とマンザニタの森に囲まれたヒル・ランチの谿谷に、「狼の家」をたてはじめたのである。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "住所はハムステッド、シーダーロード三四番地です」　犠牲者のスリム氏が皆に提案した。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "シーダーロードは想像を膨らませなくても、薄汚い所らしい。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
