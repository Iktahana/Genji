  {
    "uuid": "78663b15-87f2-57bc-a00c-bdb2a3f2b8e2",
    "entry": "下簾",
    "reading": {
      "primary": "したすだれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
