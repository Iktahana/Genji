  {
    "uuid": "fb86ea7a-9bb8-5a65-a589-2299f580141e",
    "entry": "しつこい",
    "reading": {
      "primary": "しつこい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だらだら　だらだら　しつこい　程だ。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、私たちのように、その人物にしつこい興味など持たない。",
              "citation": {
                "source": "豊島與志雄著『高尾ざんげ』解説",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつらのしつこいのには根負けがしそうだぞ！",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何、旦那さん、癇癪持の、嫉妬やきで、ほうずもねえ逆気性でね、おまけに、しつこい、いんしん不通だ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この淡い苦味は、またさっき喰べた昼食の肉の味のしつこい記憶を軽く拭き消して、親しみ返せる想い出にした。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何というしつこい氏の神経だ。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――しつこい婆につかまって今日一日無駄歩きしちまうのだ。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――しつこい気狂い婆さんね。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがあまりにしつこいのと猥りがましいのとで、帳場にいた金兵衛が聞き兼ねて、大きい声で長太郎を叱り付けた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "デマだよ」「十万円は定期で預けていて、引き出せんのじゃないかね」「しつこいね。",
              "citation": {
                "source": "鬼",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しつこい物怪だからね。",
              "citation": {
                "source": "源氏物語",
                "author": "榊",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜野さん、ちょっとしつこいだろうか。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度の風邪はなかなかにしつこいもんで……もう疾うにお伺ひしてお願ひせんならんことがあつて氣になつとつたんぢやが。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして矢張小さくはしつこいやうな身體の動かしやうで、すつと通つて、紫檀の机の向うに座を占めると、まだ挨拶も交さぬ駿介の顏を、眞正面からじろじろと見た。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "反ツ齒が與へるはしつこい感じにふさはしく、彼はいかにもせかせかと話した。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝に出直せって、しつこいんならさァ。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之女の匂……しつこい油の匂とごツちやになツたやうな一種動物性の匂が、何かの機に輕く鼻を刺戟する。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "「可哀そうに、あなたあまりしつこいから……。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二氏の内の意見についての僕の考えを兄に報ずるに先立って、しつこいようだけれども、もう一度繰り返しておかなければならないのは、あの宣言なるものは僕一個の芸術家としての立場を決めるための宣言であって、それをすべての他の人にまであてはめて言おうとしているのではない、ということだ。",
              "citation": {
                "source": "片信",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しつこい真似すると承知しねえぞ」「利いた風なセリフ吐かすないッ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "うぬこそしつこいじゃねえか。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しつこい真似を致すと、役儀の名にかけてもすてておかぬぞッ」「早い。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガキみたいに、遊んでばっかいやがって」　高志はいつも、足の指のあいだまで、しつこいくらいに洗う。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、寝室に退いてから、疲労のための、しつこい咳が喘息の発作のように激しく起り、又、関節の痛みがずきずきと襲って来るにつけても、いやでも、そう思わない訳に行かない。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
