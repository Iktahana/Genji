[
  {
    "uuid": "5d57bafe-603d-50a7-8cc5-ed7124aefc5d",
    "entry": "執拗い",
    "reading": {
      "primary": "しつこい",
      "alternatives": [
        "しつっこい"
      ],
      "is_heteronym": false
