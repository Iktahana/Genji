        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "手紙は簡単に「トニカク、クワシイ事ヲオ話シマショウ。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッチヲサキニダシマショウカ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエアナタ、ソウシマショウヨ」婆サンガスッカリ凹ンダノヲ見テ、颯子ガイヨ／＼図ニ乗ッテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ春久ト限ッタコトハナイガネ、甘利デモ誰デモイヽガネ」「四阿ヘ来ルト、キットコンナ話ニナルノネ、チット散歩シマショウヨ、足ノ運動バカリデナク、頭ニモ毒ダワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地捜シヨリハソノ方ガ優シダ、私ガ御案内シマショウト京二郎ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は憤慨して、「オ酒ヲ飲ンダトキハ男女性ニカカワラズ、カナラズカガンデ用ヲ足スコトニイタシマショウ」とマジック・インクで大きく紙に書いて正面の壁に貼った。",
              "citation": {
                "source": "愛のごとく",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
