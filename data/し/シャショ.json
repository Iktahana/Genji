    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小野はことし十九で、東京へ出てから足かけ四年になるのであるが、元来が薄ぼんやりした質の男で、いつまで経っても山出しの田舎書生であった。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十年｜前の若い田舎書生の心となって、恐る恐る帝国ホテルに帰って参りました。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "痘痕があって、片目で、背の低い田舎書生は、ここでも同窓に馬鹿にせられずには済まなかった。",
              "citation": {
                "source": "安井夫人",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ連中を相手にして「俺は芝居は嫌ひだ角力の方が好ぎた」などゝうそぶいてゐた自分はまた何といふ愚かな田舎書生だつたことだらう。",
              "citation": {
                "source": "松竹座を見て（延若のこと）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『英国詩人の天地山川に対する観念』などを『哲学雑誌』で田舎書生が驚嘆の目に読んだのは三十余年の昔です。",
              "citation": {
                "source": "漱石さんのロンドンにおけるエピソード",
                "author": "夏目夫人にまゐらす",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学一年級の折、同じく、玉虫さん（三年級）に誘はれて本郷の或下宿に参上したことがあります、漱石さんは不在、『すぐお帰りになるでありませう』と宿の者が曰ふので、其室に通つて待つてゐる間、部屋一面の洋書の堆積に吃驚した田舎書生の自分の姿が今も眼中に浮びます。",
              "citation": {
                "source": "漱石さんのロンドンにおけるエピソード",
                "author": "夏目夫人にまゐらす",
                "note": "青空文庫"
              }
            },
            {
              "text": "他人にはすぐきゅうくつになる田舎書生の私と、いつも高度のハイカラ趣味を持った白秋との、いんぎんにして礼儀のある交際は、そのまま永い間続いた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕見たいな薄穢い田舎書生なんぞ、相手にしてはくれないでせう。",
              "citation": {
                "source": "戯曲体小説　真夏の夜の恋",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心なき田舎書生の目にも田鶴子さんの洋服姿が美しく映ったのだろう。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その四ツ目結の幕の内は、倉院役人の私宅の一つか、とにかく、土上門やら芦垣もあって、彼はそこの田舎書院に、手枕していたものらしい。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
