          "literary": [
            {
              "text": "「顔色ハ白黒ヲ問ハズ眼中涼シクシテ、憂色ヲフクミ左頬ニヱクボアリ、アゴヤヤ長シ」　隠徳の相として挙げられているのは、三項ある。",
              "citation": {
                "source": "奉行と人相学",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼吾ガ生計ノ忙ハシクシテ汝ガ吾レニ力ヲ致スノ厚キ、其ノ面ハ深墨ニシテ其ノ骨ハ稜々タリ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "天候｜悪シクシテ風波ノ険甚シク、九週間ノ後漸クかつど岬ヘ達スルヲ得タレド、彼等ハコノ地ニ殖民ノ権利ヲ有セザリケレバ、更ニ南ニ航シテ進マントセリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オバアサンハヨイネコデスカラ、ケツシテコドモガドンナニヤカマシクシテモ、ドナリツケタリハイタシマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
