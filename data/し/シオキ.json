        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "江戸時代、重い罪を犯した者は公開の場で仕置きされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "奉行所の厳しい仕置きは、人々の間で恐れられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この物語では、悪代官が最後に仕置きを受ける場面が描かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
