    "definitions": [
      {
        "index": 1,
        "gloss": "noon",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "正午を告げるサイレンが鳴り響くと、工事現場の作業員たちは一斉に手を止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "明日の正午までにレポートを提出しないと、単位が認められない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "太陽が正午の位置に来ると、建物の影が一番短くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "正午に、おいで下さるように、という小坂氏のお言葉であった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "文房具と、正午にはパンと牛乳を支給してゐた校内の売店は、「学生が学生の武器である文房具を、学校に来てから整へるやうなことでは不可ない」といふ理由の許に廃された。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "読書は夜中、朝寝て正午頃起きて、それより夜の十二時頃迄歩くなり。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前五時、午前九時、正午十二時、午後三時、午後六時には取入口から水路、発電所、堰堤と、各所から凄じい発破の轟音が起った。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃からそろそろ中心が分裂しはじめ正午頃には新潟附近で三つくらいの中心に分れてしまって次第に勢力が衰えて行ったのであった。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月八日農場実習　午前八時半より正午まで　　除草、追肥　　　第一、七組　　蕪菁播種　　　　第三、四組　　甘藍中耕　　　　第五、六組　　養蚕実習　　　　第二組（午后イギリス海岸に於て第三｜紀偶蹄類の足跡標本を採収すべきにより希望者は参加すべし。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "具体的の例を挙ぐれば、東京市民にとりては「明日正午まで京浜地方西北の風晴」と云い、あるいは「本日午後驟雨模様あり」というがごときは多数の世人に有用有意義なり。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "而るに今朝来、濃霧四辺を閉ざしシセキを弁じ難き趣きありしが、正午前、玄海洋上に望みし時忽ち右舷に当り大艦影を認む。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「すると正午だわね。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "正午過妻とともに本郷の喜福寺へ急ぐ。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時には正午過ぎの「太陽」の強い光がくまなく降りそそいでいた。",
              "citation": {
                "source": "神田を散歩して",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供部屋の裏の縁先にある花壇には、強烈な正午過ぎの日光が眩しいように輝いて、草木の葉もうなだれているようであった。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　玉虫　夏のある日の正午｜駕籠町から上野行の電車に乗った。",
              "citation": {
                "source": "さまよえるユダヤ人の手記より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「第十七回極東ビヂテリアン大会〔〕　一九三一年九月四日正午より。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一千九百二十六年六月十四日　今日はやっと正午から七時まで番水があたったので樋番をした。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "微醉して街の上へ出ると正午のドンが鳴つた。",
              "citation": {
                "source": "太郎と街",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道と空との間にただ一人我ばかり、およそ正午と覚しい極熱の太陽の色も白いほどに冴え返った光線を、深々と戴いた一重の檜笠に凌いで、こう図面を見た。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この汽車は新橋を昨夜九時半に発って、今夕敦賀に入ろうという、名古屋では正午だったから、飯に一折の鮨を買った。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」二十四「翌日また正午頃、里近く、滝のある処で、昨日馬を売りに行った親仁の帰りに逢うた。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日の正午ごろ自分たちの家の前を通っている電線に止まったとんぼを注意して見ると、やはりだいたい統計的には一定方向をむいているが、しかし、太陽に尻を向けるという仮説には全然適合しない方向を示していた。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど正午であるから、たとえどちらを向いてみても目玉を照らされるのはだいたい同じだから、少々この場合には何か他の環境条件に支配されているだろうと思われた。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが正午のベルだか笛だかで解放され向こう一時間の自由を保証されて食堂へかけ込む。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和二十年八月十五日正午に、私たちは兵舎の前の広場に整列させられて、そうして陛下みずからの御放送だという、ほとんど雑音に消されて何一つ聞きとれなかったラジオを聞かされ、そうして、それから、若い中尉がつかつかと壇上に駈けあがって、「聞いたか。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "正午ちかく、警察のひとが二人、葉藏を見舞つた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月八日農場実習　午前八時半より正午まで　　除草、追肥　　　第一、七組　　蕪菁播種　　　　第三、四組　　甘藍中耕　　　　第五、六組　　養蚕実習　　　　第二組　（午后イギリス海岸に於て第三紀｜偶蹄類の足跡標本を採収すべきにより希望者は参加すべし。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "このサ中に何処へ行たもんじゃろか……あの朝寝坊が……」　それから毎日のように晴れ続いた福岡博多の狭い町々に、蔵元屋の騒動の噂が隈もなく行き渡ってしまった三日目……三月十三日の正午下り。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人は正午前から来ている客である。",
              "citation": {
                "source": "疲労",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "文公は留守居と言われたのですぐ起きていたいと思ったが、ころがっているのがつまり楽なので、十時ごろまで目だけさめて起き上がろうともしなかったが、腹がへったので、苦しいながら起き直って、飯を食ってまたごろりとして、夢うつつで正午近くなるとまた腹がへる。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドッコイ、ドッコイ、ドッコイショと、爺様のような懸声をしながら漸く河を渡り、やがて町付という寒村に来掛かれば、もう時刻は正午に近い。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "時刻は正午間近なので、朝飯の不足に腹が減って堪らず、ここは掛茶家ではないが、一同は御免｜候えと腰を下し、何か食う物は無いかと聴くと、何も食う物は無いが、焼酎に漬物位なら有るという。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
