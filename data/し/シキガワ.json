    "definitions": [
      {
        "index": 1,
        "gloss": "fur rug",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寒い冬の夜には、暖炉の前に敷き皮を敷いてくつろぐのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ネイティブアメリカンの文化では、動物の敷き皮が生活に深く根付いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "床に敷き皮を敷くと、部屋全体が温かい雰囲気になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "御鎧に立つところの矢七筋、御頬にも二の御腕にも、お傷を受けられて血流れ出で、全身を紅にお染めになりながら、敷き皮の上にお立ちになり、大盃を三度まで、さも快よく傾むけさせられれば、木寺相模は敵の首級を、四尺三寸の太刀先に貫き、お前に出て舞い出した。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一まいの敷き皮のように、ぺちゃんこになってしまったのです。",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "又長岡のほとりにてはかの斗棒のけづりかけの三尺ばかりなるに、宝づくしなどゑがきたるをさして勧進す、これは小児にあらず、大人のいやしきがわざなり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊の皮の敷皮にも坐れまいじゃないか。",
              "citation": {
                "source": "鼠",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは強い決心を以って父の前に出ると、師直はいつの間にか寝道具を取り払わせて、紫紺地に巴の模様を白く染め出した直垂を着て、敷皮の上に武者あぐらを掻いていた。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大泉伴左衞門は軍書の卷物をのせたる机を横にし、大きい手あぶり火鉢を前にして、敷皮の上に坐つてゐる。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二章　鬚深き横面に貼薬したる荒尾譲介は既に蒼く酔醒めて、煌々たる空気ラムプの前に襞※もあらぬ袴の膝を丈六に組みて、接待莨の葉巻を燻しつつ意気｜粛に、打萎れたる宮と熊の敷皮を斜に差向ひたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけても正面敷皮の上に寛々と胡座した武士はひときわ威風｜四辺を払って、一座の頭目と一眼で知れた。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かゝる所に敷皮うちしき、蓑うちきて夜を明かし、日を暮らす。",
              "citation": {
                "source": "学生と先哲",
                "author": "――予言僧日蓮――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人が、馬から下りて、敷皮の上へ、腰を下すか下さない中に、檜皮色の水干を着た、白髪の郎等が、利仁の前へ来て、かう云つた。",
              "citation": {
                "source": "芋粥",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは組のうちでたしかに見た男」　夜歩きをして壬生へ帰った翌朝、隊長の近藤勇から使が来て、急に会いたいというから兵馬は、勇の前へ出ると、勇は刀架に秘蔵の虎徹を載せて、敷皮の上に、腕を拱き端然と坐っていたが、兵馬を見る眼が、今日はいつもより険しい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁信が熊の敷皮の上に横になったのは、そのあとのことで、横になると肱枕にスヤスヤと寝入ってしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "宏大なる一室に紙帳を釣らせて、その中に敷皮を敷いて、白絹の陣羽織に白金物打った鎧を着て、坐っているのが大谷刑部少輔吉隆である。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大谷刑部は以前と同じ姿形で一方の敷皮の上に胡坐している。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと相対して、烏帽子大紋の容貌優秀なる大名が一人、同じように敷皮の上に座を構えている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵の場合に於て、この男は、素肌に盲目縞の筒袖一枚以上を身に纏うことを必要としないように出来ているし、夜分に於ても、それ以上の夜具があってもよし、なくてもよいことになっているが、今宵の場合は特に疲れが激しいから、用が済むと共にこの敷皮の上に寝そべったまま、ついに夜更けに立至ったものと思われます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "畜生谷の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この子熊のために親の敷皮を買ってやった時から、定まったなりゆきでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "畜生谷の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "真「蟇ぢやアない、敷皮です、彼所に敷いてあるから御覧なさい。",
              "citation": {
                "source": "八百屋",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "筏　（３）　そういう僥倖は二度とは訪れず、将校も兵も胃の緊縮に苦しんで帯革や靴の敷皮を噛み、自分の尿をとって飲んだ。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう僥倖は二度とは訪れず、将校も兵隊も胃の緊縮に苦しんで帯革や靴の敷皮を噛み、尿をとって飲んだ。",
              "citation": {
                "source": "海難記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢の私語、たわやげる瑪瑙の甘寢、「にるばな」よ、艶も貴なる敷皮に嫋びしなゆるあえかさや。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙は燬けぬ沙は燬けぬ、蹠のやや痛きかな、渚べの慣れし巖かげに身を避けて、磯草の斑に敷皮の黄金をおもひ、いざここに限りなき世の夢を見む。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "車は、京の七条、六条から引廻され、夜に入って、槙島へもどると、野に敷皮をのべ、「お腹を召されよ」　と、情けの脇差を、扇にすえて差出したが、玄蕃允は笑って、「斟酌、御無用」　と、縄も解かせず、従容、首を斬らせた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "重房は車の中から若君を下すと敷皮の上に坐らせた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、千本松原まで来ると、六代の御輿が下され、敷皮が敷かれた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第十二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷にはカモシカの敷皮がある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「敷革を入れれば、なんとかなるだろ」「うん」「でも、その頭だと、アイヴィーは無理だな」　扉口の姿見のまえに立って、足もとを見ている慶一の横から、高志がまじめにいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒井甚三郎は、さのみ悲しむ色もなく打通って、「勉強しているな」「はい、おかげをもちまして」　一学は何ともつかず返事をして、取って置きの敷革を出して主人にすすめる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
