          "literary": [
            {
              "text": "名古屋白壁町の大塩氏は其後なり。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "棠園さんは置鹽氏、名は維裕、字は季餘、通稱は藤四郎である。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "駿河國志太郡島田驛で桑原氏の家は驛の西端、置鹽氏の家は驛の東方にあつた。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "堂の妻ためは大下の置鹽氏から來り嫁した。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
