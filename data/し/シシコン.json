          "literary": [
            {
              "text": "私は急に気が変って、食事がすむと汽車を待ち合わせて、ウリ湖畔のシシコン Sisikon まで切符を買った。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルンネン Brunnen からルツァーンの湖の枝わかれしたウルネル・ゼーに近く沿うて、午後二時半、シシコンの停車場に着いた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "テルス・カペルレ　Tellskapelle　シシコンはウリの湖水の東岸で、停車場のまわりに散らばった、古ぼけた村である。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
