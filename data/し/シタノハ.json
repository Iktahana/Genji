          "literary": [
            {
              "text": "問　被告ガ道子ヲ殺ス気ヲ起シタノハイツ頃カ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンヲ殺害シロト命令シタノハ動坂三郎ニ違イアリマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ七十七歳ノ今日ニナリ、既ニ左様ナ能力ヲ喪失シタ状態ニナッテカラ、男装ノ麗人ナラヌ女装ノ美少年ニ魅力ヲ感ジ出シタノハナゼカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモマア、ホンノ一時的ノ現象ダッタンデゴザイマスネ」ホットシタノハ佐々木バカリデハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新築シタノハ予ノ父デアッタガ、父ハ大正十四年、予ガ四十一歳ノ時ニ死ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ東京ヲコンナ浅マシイ乱脈ナ都会ニシタノハ誰ノ所業ダ、ミンナ田舎者ノ、ポット出ノ、百姓上リノ、昔ノ東京ノ好サヲ知ラナイ政治家ト称スル人間共ノシタコトデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………　昨夜妻ガ帰宅シタノハ九時デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
