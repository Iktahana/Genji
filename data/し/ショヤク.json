        "examples": {
          "standard": [
            {
              "text": "その外国語の小説は、彼によって初めて日本語に初訳された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古典文学の初訳版は、非常に貴重な資料だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "作家は、自分の作品が初めて外国語に初訳されることを喜んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "1999（平成11）年12月24日初訳※挿絵は、Vilhelm Pedersen (1820-1859) によるものです。",
              "citation": {
                "source": "はだかの王さま",
                "author": "THE EMPEROR'S NEW SUIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "1999（平成11）年4月初訳　　　2000（平成12）年10月改訳　　　2008（平成20）年4月16日修正※挿絵は、シドニィ・パジェット（1860-1908）によるものです。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "1999（平成11）年12月24日初訳　　　2014（平成26）年3月24日微修正※挿絵は、Hans Tegner (1853-1932) によるものです。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "2003（平成15）年4月1日初訳　　　2014（平成26）年3月24日微修正※この翻訳は「クリエイティブ・コモンズ 表示 2.1 日本 ライセンス」（http://creativecommons.org/licenses/by/2.1/jp/）によって公開されています。",
              "citation": {
                "source": "罪と覚悟",
