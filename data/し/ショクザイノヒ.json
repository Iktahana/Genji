        "examples": {
          "standard": [
            {
              "text": "ユダヤ教徒にとって、贖罪の日は最も神聖な日の一つである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "贖罪の日は、断食と祈りを捧げることで罪を悔い改める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家族は贖罪の日を厳かに過ごす準備をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "断食は元来モーセの律法では、『贖罪の日』において守るべきことが規定せられているだけであったが（レビ記一六の三一）、バビロン捕囚後しだいに断食の日が多くなり、熱心なパリサイ人は毎週第二日と第五日と二日も断食日を守るようになっていた。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
