          "literary": [
            {
              "text": "シャロンヌ街の各居酒屋はまじめで喧騒であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シャロンヌ街と向き合ったある酒場では、革命の役員らが選ばれた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "モントルイュやシャロンヌやヴァンセンヌやベルシーなどから市場にやって行く青物商らは、たいてい皆サン・タントアーヌ街の方へぬけて行くのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "モントルイュ市門とシャロンヌ市門との間だ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
