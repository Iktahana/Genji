          "literary": [
            {
              "text": "正真正銘の逸品揃いに違いないという確信が、いよいよ益々高まって来るばかりです。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆州さまのお腰元となると、またやけに絶品ぞろいなんだからな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ツでも、何万、何十万という珍品ぞろいだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、盗掘をまぬかれたせいか、または特に貴人の墓のせいですか、中から現れたものはピカ一の名品ぞろいでしかも多くが昔のままの姿をそっくり今にとどめていたのです。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十八　踊る時計",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
