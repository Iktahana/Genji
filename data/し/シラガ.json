  {
    "uuid": "b71ce1fa-0053-5e14-951c-27804c64d557",
    "entry": "シラガ",
    "reading": {
      "primary": "しらが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タチマチ　シラガノ　オヂイサン　それでおしまひである。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂を下るとき、そのなかの素足の女半ば青きシラガミススキの蔭にゆきて、青き弁当の包を取り出しながら連のあとより急ぎゆく。",
              "citation": {
                "source": "春の暗示",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかげよりまた四十前後の女園丁三人手拭の頬冠りして出て来る、坂を下るとき、そのなかの素足の女半ば青きシラガミススギの蔭にゆきて、青き弁当の包を取り出しながら連のあとより急ぎゆく。",
              "citation": {
                "source": "桐の花",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "長者の頭にシラガが生えそめたころにようやく生れた一粒種だから、一夜ごとに二握りの黄金を百夜にかけてしぼらせ、したたる露をあつめて産湯をつかわせたと云われていた。",
              "citation": {
                "source": "夜長姫と耳男",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧｜南部領にはウバガシラとウバシラガというのと二つあって、姥白髪の方が印象は深いが、私は姥頭の方が舞の姿から出た名で、一つ古いもののように思っている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワカは仙台領以北でオカミといい、南部領ではモリコともまたイタコともいう巫女のことであるが、関東以南のイチコ・梓神子・大弓などいう婦人と違うことは、弓や幣束の代りに木に刻んだ二つの人形を手に持つことで、その人形を奥郡ではオシラガミ、阿武隈水域ではシンメサマというのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "さては桃生郡には竹のオシラガミがあるのか。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "またツブラオホミの女のカラ姫と結婚してお生みになつた御子は、シラガの命・ワカタラシの命お二方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでシラガの太子の御名の記念として白髮部をお定めになり、また長谷部の舍人、河瀬の舍人をお定めになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、清寧天皇・顯宗天皇・仁賢天皇清寧天皇　御子のシラガノオホヤマトネコの命（清寧天皇）、大和の磐余の甕栗の宮においでになつて天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇はオホハツセノワカタケの天皇の御子、春日の大郎女と結婚してお生みになつた御子は、タカギの郎女・タカラの郎女・クスビの郎女・タシラガの郎女・ヲハツセノワカサザキの命・マワカの王です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇がお隱れになつて、天下を治むべき王子がありませんので、ホムダの天皇の五世の孫、ヲホドの命を近江の國から上らしめて、タシラガの命と結婚をおさせ申して、天下をお授け申しました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "またオホケの天皇の御子のタシラガの命を皇后としてお生みになつた御子はアメクニオシハルキヒロニハの命お一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
