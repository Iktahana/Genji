  {
    "uuid": "acd11db5-1e2f-5a0a-9720-d14b81a44ec5",
    "entry": "職司",
    "reading": {
      "primary": "しょくし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "人の世に処する、必らず何事の職司を有せずんばあらず、或は命を官に受け、或は業に民に就く。",
              "citation": {
                "source": "主のつとめ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "職司の種類の中には、主につけるものにあらずして、その表面は極めて格好に且つ怡楽きものなるに似たれど、終りには、死を意味するものあり。",
              "citation": {
                "source": "主のつとめ",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "（立つ）大野　いや、これであなた、休職司法官などの身分にしては、すこし不相応にこった建てかたの家でして、チョット自慢したい点もなくもないといった――（ツヤ子に）ツヤ君、こちらは、これからこの家に来ていただく薄田中佐どのだ。",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
