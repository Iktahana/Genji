        "examples": {
          "standard": [
            {
              "text": "OSやドライバは、代表的なシステムソフトウェアです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "システムソフトウェアのアップデートは、セキュリティ強化のために重要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このシステムソフトウェア、すごく快適に動くね！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ＣＣＣはＰＤＰ―10の購入に際して、システムソフトウエアのバグを継続的に発見しているあいだは代金の支払いを猶予するという契約をＤＥＣと結んでいた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "地域の電力使用量に対応して、水力発電所の発電量を自動的にコントロールするシステムの開発を地方自治体から請け負っていたＴＲＷは、使用するＰＤＰ―10のシステムソフトウエアのバグに悩まされ、この環境に習熟したプログラマーを求めていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "回路図からさまざまな技術情報、システムソフトウエアの核となるＢＩＯＳの中身にいたるまで、ＩＢＭはＰＣのすべてを全面的に公開する方針を打ち出した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
