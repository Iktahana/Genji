        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "イギリスでも、エリザベス女皇時代には、大抵の男は八フヰートもあつたさうだから、シエークスピアも、ベーコンも、今の文学者達にくらべると馬のやうにのつぽだつたに相違ない。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "否シエークスピアの客観的なるだに尚且つ全く当代の英国民性を脱却し得ざりしにあらずや。",
              "citation": {
                "source": "国民性と文学",
                "author": "綱島梁川",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその人に教へられて、シエークスピアハウスとか云ふ宿屋へ入つた。",
              "citation": {
                "source": "幼少の思ひ出",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処には、幾つかの部屋々々に、シエークスピアの作品に取材した壁画が描かれてゐたやうであつた。",
              "citation": {
                "source": "幼少の思ひ出",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は、予定通り、シエークスピアの生家、夫人ハサウエーの生家、シエークスピアの墓のある寺院や、図書館などを巡覧し、劇場で『ロメオとジユリエツト』を見物し、一シルリング払つて、遊覧船に乗つて、綺麗なエボン河を、二三十分間ほど上り下りしたりして、一日一晩を過した。",
              "citation": {
                "source": "幼少の思ひ出",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "米國製のリーダーさへろくに讀めない年少學徒に、シエークスピアを學ばせた。",
              "citation": {
                "source": "語學修業",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "シエークスピアの古語を小學讀本同樣に讀み覺えたつて、西洋の哲學を聞き噛つたつて實社會に出て多く役に立たないのである。",
              "citation": {
                "source": "語學修業",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "教師の譯語をテキストに書き入れてやうやく覺えたシエークスピアにどれほどの價値があるだらう。",
              "citation": {
                "source": "語學修業",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
