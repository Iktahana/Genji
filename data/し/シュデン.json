[
  {
    "uuid": "8191a5d9-1fec-57b2-8884-9562aeae6a61",
    "entry": "主殿",
    "reading": {
      "primary": "しゅでん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
