          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "不手際によりご迷惑をおかけしたことを、深く深謝いたします。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "顧客からのクレームに対し、社長は深謝の意を表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の無礼な態度に対し、家族が代わりに深謝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
