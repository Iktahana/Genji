  {
    "uuid": "79041a54-5d5f-5c43-b639-fe9da1c1d1cd",
    "entry": "深謝",
    "reading": {
      "primary": "しんしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞",
