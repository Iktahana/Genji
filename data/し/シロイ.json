    "definitions": [
      {
        "index": 1,
        "gloss": "white",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は真っ白なウェディングドレスを着て、とても美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の朝、窓の外には白い雪景色が広がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その猫は白い毛並みが特徴で、青い目が印象的だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "夏としなれば、高山に、真ツ白い嘆きを見たり。",
              "citation": {
                "source": "夏と私",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが知らぬ、とほきとほきとほき深みにて　青空は、白い雲を呼ぶ。",
              "citation": {
                "source": "夏は青い空に……",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "感想中原中也　地方の詩のグループも多いことだが、どういふものか、ずつと以前から大連と神戸にだけ面白いものが見られるのだつた。",
              "citation": {
                "source": "感想",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都は嘗つて小生自身二年間ゐて、詩人にとつては有難い土地だと思つてゐるので、京都あたりからもつと面白いものが出てもよかりさうなものだと、かねがね思つてゐたが、仲々出なかつた。",
              "citation": {
                "source": "感想",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜景萩原朔太郎高い家根の上で猫が寢てゐる猫の尻尾から月が顏を出し月が青白い眼鏡をかけて見てゐるだが泥棒はそれを知らないから近所の家根へひよつこりとび出しなにかまつくろの衣裝をきこんで煙突の窓から忍びこまうとするところ。",
              "citation": {
                "source": "夜景",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――読んでみて面白いものはある。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々はドストエフスキーを読みバルザックを読み、※ルレーヌを読むが、そして面白いといふのであるが、果してそれらの「流れ」、つまり持続を面白いといつてゐるのであらうか、それとも部分々々を面白いと思つたものであらうか？",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やりつぱなし」が比較的面白いからといふので、買はれたつて、当人としても世間としても浅墓なことである。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、面白いから笑ふので、笑ふので面白いのではない。",
              "citation": {
                "source": "宮沢賢治の世界",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白い限りでは人は寧ろニガムシつぶした顔をする。",
              "citation": {
                "source": "宮沢賢治の世界",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて彼にあつては、「面白いから面白い」ことだけが、その仕事のモチーフとなる。",
              "citation": {
                "source": "宮沢賢治の世界",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も此の外観は真の詩からなつてをり、彼はそれを、全ての本物の芸術家の如く、天才の一撃で以てその暗い色と蒼白い色とを強調することに依つて獲得してゐる。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその暗い色と蒼白い色との衝突が、彼の詩の魅力と異様性とをなす所のものである。",
              "citation": {
                "source": "トリスタン・コルビエールを紹介す",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くに白い家と緑や赤の屋根がみえる。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれもこれも白い菱形の小さな凧で、僕の魂の如くはかなく風に浮揚してゐる。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると私は白い糊の付いた看護衣の、長い四角い顔の、スリッパを穿いた男を想ひ出すのである。",
              "citation": {
                "source": "一つの境涯",
                "author": "――世の母びと達に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――（少し早口になる）「私は自分が向ふへ歩いてゐるのか、自分が向ふから蒼白い顔で歩いて来てるのか分らない時がある――十字路で、みんなの元気な顔、殊には出遇つて互に喜ばしさうな挨拶を交はしてゐる人達をみる時。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りこつちでは、例へば白い西洋皿の上に、鰯の頭が三つ、コロコロと這入るところを、よつくとみて、どうせ対手は嗤つてゐるのだから一寸、ホンの一寸した目礼くらゐで自分の所に帰つてゆけば、却々シツクリした気持だつて味はへるやうなもんぢやないか。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "『今日私、面白い所見つけました。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし何となく陰気に薄暗くじめじめして、妙に気味の悪い厭な感じがしたので、夫人が直覚的に反対したにもかかわらず、ヘルンは一見して大いに気に入り、『面白いの家』『面白いの家』と、子供のように嬉しがって、是非それを買おうと言った。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私あの家、面白いの家と思いました』と幾度も繰返して口惜しがった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "化物屋敷の一件以来、おそらくは『面白いの家』という言葉などが、一種の反語として家族中に流行し、すべての不潔の家、陰気な家などを指す代名詞になったであろう。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人がそれを読んできかすと、ヘルンはすっかり上機嫌になってしまい、『いかに面白い。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに面白い』と、子供のように手を拍って悦びながら、『私、その人大好きです。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白い坊さんでしょう。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻翼の所はおしろいが剥落ちてゐて、一寸突いたらビリビリと破けさうな感じがする。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "大概は勇ましくまた殺伐な戦闘や簒奪の顛末であるが、それがただの歴史とはちがって、中にいろいろな対話が簡潔な含蓄のある筆で写されていたり、繊細な心理が素朴な態度でうがたれていたりするのをおもしろいと思った。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人辻本工学士に拠ると信濃越中の国境に聳えている祖父ヶ岳は、「種蒔き爺さん」が笊を持った具合に現われるので、山腹雪解の頃、偃松が先ずその形に蔓って、出るのではないかという話である、偃松の仲間入は最もおもしろい。",
              "citation": {
                "source": "雪の白峰",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、私にはこのアステーア、ロジャースの踊りのデュエットは見ていてやっぱりおもしろい。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけがわからないくせにやっぱりおもしろいのが不思議である。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
