  {
    "uuid": "d8186813-990e-5ab2-a0c5-90ca06b85b38",
    "entry": "シロイ",
    "reading": {
      "primary": "しろい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ酔ひの勇気がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ醉ひの勇氣がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　シロイ　ミチヲ　ヒトスジニ　ハシリマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーン、ツマンナイネ、ア、シロイ　ハツパガ　トンデ　ユク」「アレハ　ハツパヂヤ　ナイコト、テフテフヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツピキノ　シロイ　テフテフガ　フウセンダマノ　トコロヘ　マイニチ　トンデ　キテ、イチンチヂユウ　アソンデ　イクノデシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「テフテフサン、サヨナラ」　ケレド　シロイ　テフテフハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ソノ　アトカラ　シロイ　テフテフハ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロイ　テフテフハ　シンパイサウニ、「コレカラ　ドコヘ　イクノ」ト　フウセンニ　キキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロイ　テフテフモ　ソノ　アトニ　ツイテ　ノボツテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イイエ　ワタシ　ツイテ　イキマス」ト　シロイ　テフテフハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、シロイ　テフテフハ　ツイテ　イキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナク、アカイ　フウセンダマト　シロイ　テフテフハ　ミエナク　ナツテ　シマヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝顏・晝顏・夕顏等、其名の如く其時に開き、西洋でもオシロイ花を、開く時に因んで、四時（フオワ・オークロック）と呼ぶ。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し皆さん、その下手なまぐれ当りでオモシロイのが写つたらお土産にお目にかけますから、待つてゐて下さい、余り待甲斐のあることでもありませんがね。",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "参詣するものが、みなオシロイの粉をふりかくることになっている。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな女社長ないですよ」　アキ子は鼻をピクピクさせて、よろこび、約束の日に鼻の頭に粉オシロイをペタペタたゝきつけ、タケノコで資金を作って、でかける。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくまアあんな馬鹿騒ぎができたものだと夏川は思ふが、あれぐらゐ傍若無人の馬鹿騒ぎになると、あたりが呑まれてその気になつてしまふもので、オコノミ焼の母親まで一ぱし芸者めく気持になつてオシロイもぬりかねない打ちこみ方になつたから笑はせる。",
              "citation": {
                "source": "母の上京",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "香具師の親分ときいて、このバカな内儀が何年間つけたこともないオシロイなどぬりたくり、チヤホヤしたから、それからは親分が見廻りにくるたび御休憩の家となり、親分御食事中はほかのお客はお断り。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "オモッシェなア」　というのは、ワー、オモシロイナア、ということである。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで花が咲いたような美しい特別の着物を年中着せられている上に、七ツ八ツから紅オシロイまでつけているのである。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "花天狗流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "大は反物、オムツカバー、メリヤスシャツの類からポマード、オシロイ等の化粧品、シャボン、ブラシ、鋏、ナイフ、ヘアピン等の日用品一切にわたって売り歩く。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイ……トフヱヲ　ナラシテ、シロイ　ケムリヲ　　　　ダシタリ、クロイ　ケムリヲハイタリ、テッキヨウヲ　ワタッテ、トンネルヲ　ヌケテ、マタトンネルヘ　ハイッテ、ドンドン　ハシッテ　ユキマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い女はオシロイや香油などの化粧料の匂いのために、似たような匂いの人がウンと居ますが、ルリさんはあまり化粧はしないと見えて、ハッキリとそれがかげるのです。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "景子は、そのまま僕の方へは目もくれないで、ゴシゴシとじやけんにオシロイのハケを動かしていましたが、急に「困るなあ、立川なんて言つて、やつて來られたんじや！",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかたが無いからシワやブクブク太りを、オシロイやドウランでごまかして、ハダカになつたり、腰を振つたりしてね、フフフ！",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻の下をグイと伸してオシロイのパフを叩きつけたり、思いきり目をむいて横を見たり、實にコッケイなことをします。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "興味があるとか、奇妙であるとかいうことを意味する言葉はオモシロイで、直訳すれば「白い顔」となり、白い顔が奇妙な観物であった昔の時代から伝って来た。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
