    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは大崎の大崎義隆の臣の里見隆景から事起って、隆景が義隆をして同じ大崎の巨族たる岩出山の城主氏家弾正を殺させんとしたので、弾正が片倉小十郎に因って政宗に援を請うたところから紛糾した大崎家の内訌が、伊達対大崎の戦となり、伊達が勝てば氏家弾正を手蔓にして大崎を呑んで終おうということになったのである。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "秤り炭二十銭、線香十銭、これが今日出山の目的の買物だつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "出山の釈迦はコスメチックを塗ってはおらん。",
              "citation": {
                "source": "趣味の遺伝",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "独逸から帰って来てからの漣は出山の釈迦が成覚したように小説家たる過去を忘れてお伽噺の小波となってしまった。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　浮雲の山をいずる者輪菌然たり――浮雲出山者輪菌然。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで出山の釋迦や。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髮も短く刈り、着物もさツぱりして、出山の釋迦といふ姿は少しもないのみか、親の老僧が殆んど骨と皮とに痩せてゐるのに比べて、これはデク／＼と肉付きがよかつた。",
              "citation": {
                "source": "ごりがん",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "江口君三たび論ずらく、「プロレタリア文学勃興と共に、俄かに色を染め加へし赤大根の輩出山の如し」と。",
              "citation": {
                "source": "八宝飯",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "崩平という山を一巡すると湧出山という山が見え出す。",
              "citation": {
                "source": "別府温泉",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "左候て、三十出山とて僅か五年の間に生老病死を免れる事を悟り、生れもせねば老いもせず病も死もせぬ事を悟りて出で来りて、それから世の人を教化せられた。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "千葉県君津郡八重原村）　これとちょうど正反対の例は、陸前の岩出山の近く、うとう阪という阪の脇にありました。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮城県｜玉造郡岩出山町）　驚きの清水というのは、普通の池や泉とちがって、人のような感覚をもった活きた水ということであったようです。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に北に進みますと岩出山という町に達します。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
