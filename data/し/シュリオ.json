          "literary": [
            {
              "text": "どうもわたしの妹婿のシュリオだって、おまえに仕事を見つけてやることはできないだろうしね。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュリオはニヴェルネ運河の水門守をしているのだが、知ってのとおり植木｜職人の世話を水門守にしてもらうのは無理だからね。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シュリオのおかみさんはどうしました」とわたしはたずねた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ」「まあ、シュリオさんは、水で死にましたよ……」「ええ、水で死んだ」「そう、あの人は水門に落ちて、くぎにひっかかって死んだのだ。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            }
          ]
        }
