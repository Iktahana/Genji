        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ツボミタチハ　ビツクリシテ、ダマツテ　シマヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムライハ　一シヨウケンメイ　ニゲマシタガ　イキガ　キレタノデ、ミチバタヘ　バツタリ　スワツテ　シマヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フエフキハ　ツギノ　マチヘ　ハイル　ミチデ、ヒロツタ　カナヅチヲ　フリアゲ、クシヤント　フエヲ　クダイテ　シマヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　オトウサンハ　キメツケテ　シマヒマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウトウ　コノ　タケノコハ　ホカノ　タケノコタチト　ワカレテ、カキネノ　ソトニ　アタマヲ　ダシテ　シマヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スルト、アサツユハ、ハノ　サキカラ　ピヨイト　ハナレテ　プツント　ヂベタヘ　オチテ　シマヒマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　トツゼン　マンナカノ　ホシガ、ダマツテ　ツート、下ノ　ハウヘ　スベツテ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　スタスタト　モリノ　ハウヘ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヌスビトハ　パント　コヒツジト　トリカヘツコ　シマシタガ、ヒヤクシヨウノ　テニ　ブラサゲラレタ　コヒツジガ　カワイソウニ　ナツタノデ、トリカヘツコヲ　ヤメテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "センサウノ　タメニ　ワタクシタチハ　ハタケヲ　アラサレ、タベル　モノハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミドリイロノ　ペンキハ　アメノ　タメニ　ハゲテ　シマヒ、ワガネハ　アカク　サビテ　ヰマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンハ　マタ　ウバグルマニ　ノツケラレテ、イツテ　シマヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タウトウ　チヤウサンハ　ハラヲ　タテテ　シマヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤレヤレ」ト　チヤウサンハ、タウトウ　クルマノ　ナカニ　ヘタバツテ　シマヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンデ　オヒロヒナサイ」　ヲンナノ　コハ　コマツテ　シマヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲンナノ　コハ　ナキナガラ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　フタリハ　イツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ユウガタニ　ナツテ、タイヤウガ　オチテ　シマフト　ヒロツパノ　マンナカノ　マルイ　カゲハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　トキ、コモリハ　フウセンノ　イトヲ　ハナシテ　シマヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マモナク、アカイ　フウセンダマト　シロイ　テフテフハ　ミエナク　ナツテ　シマヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヒルサンモコマツテシマヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレニハ私モホントニコマツテシマヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、田舎ノ景色バカリカイテヰルノニアキテ、街ノシヤセイヲシヤウト思ツテ、街ニキマシタガ、田舎者ノ玉ネギサンハ道ニマヨツテシマヒマシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トモウシマシタノデ、二人ハ、ハラガタツヤラ、ハヅカシイヤラデコマツテシマヒマシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、マスマスオコリマシタガ、シカタガナイノデ、オザシキノアンラクヰスニコシヲカケマシタラ、タウトウキモチガヨクナツテ、マユヲシカメタママネムリコンデシマヒマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、玉ネギサンノ　ノツテヰル汽車ノ中ヘハイツテイツテ、席ニコシヲ下シテ、グウ　グウ　グウ　グウ眠リコンデシマヒマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤントボンコチヤンハ恥カシイヤラ悲シイヤラデ、メチヤ、クチヤニオコツテシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンハジブンノヘヤニカケコンデシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ、オゲンクワンカラ、ソトヘカケダシテイツテシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「マア――ソンナ――コト――」　カメコオバサンガ「ダツテ――イイエ――ヤツパリ――」　ソシテ　フタリトモ、コヱガ　ダンダン　チヒサクナリ、クチガマワラナクナリ、ヤガテ　グツスリ　ネムリコンデ　シマヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
