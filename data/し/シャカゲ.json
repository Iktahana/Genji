          "literary": [
            {
              "text": "別言すれば結果は源因の写影たるに外ならず。",
              "citation": {
                "source": "罪過論",
                "author": "石橋忍月",
                "note": "青空文庫"
              }
            },
            {
              "text": "この写真は、石川富士雄君の厚志による複写影である。",
              "citation": {
                "source": "鵠が音",
                "author": "追ひ書き",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏、余に送るに写影および著書をもってす。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "門生田中は凡例の一に、「此篇ハ朝夕講習ノ餘話ヲ集録ス故ニ往々錯雜ヲ免レズ其説多クハ一千八百五十二年我嘉永五年撰スル所ノ和蘭人フアン・デン・ベルグ氏ノ「理學原始」ヨリ出ヅ直寫影鏡ハ數年前吾師既ニコレヲ實驗シ蒸汽船ハ本藩已ニコレヲ模製ス他ノ諸器ハ未歴驗セズト雖其理亦疑フベキコトナシ」と書いてゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
