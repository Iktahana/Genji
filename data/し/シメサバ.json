        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "脂の乗ったしめ鯖を薄く切り、わさび醤油でいただくのが最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "居酒屋で注文したしめ鯖は、酢の締め具合が絶妙で酒が進む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "母が作る自家製のしめ鯖は、市販のものよりも酸味がまろやかだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しめ鯖の中毒かもしれないが、そうではなかったかもわからない。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しめ鯖はうまかったし、匂いも変っているようではなかった。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋しくおぼしめさば南無阿弥陀仏を唱えてください。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれその御子を出して、稻城の外に置きまつりて、天皇に白さしめたまはく、「もしこの御子を、天皇の御子と思ほしめさば、治めたまふべし」とまをしたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
