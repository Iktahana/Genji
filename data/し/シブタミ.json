        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十六日、朝いと早く暗き内に出で、沼宮内もつつと抜けて、一里ばかりにて足をいため、一寸余りの長さの「まめ」三個できければ、歩みにくきことこの上なけれど、休みもせず、ついに渋民の九丁ほど手前にて水飲み飯したため、涙ぐみて渋民に入りぬ。",
              "citation": {
                "source": "突貫紀行",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩手県の渋民村辺を描いているものに石川啄木の『天鵞絨』があります。",
              "citation": {
                "source": "文学に現れたる東北地方の地方色",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "両側百戸足らずの家並の、十が九までは古い茅葺勝で、屋根の上には百合や萱草や桔梗が生えた、昔の道中記にある渋民の宿場の跡がこれで、村人はたゞ町と呼んでゐる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "好摩午後三時着の下り列車で着いて、俥だから線路伝ひの近道は取れず、態々本道を渋民の町へ廻つて来たものであらう。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙を届けるべく、智恵子は渋民に帰つた翌日の午前、何気なく加藤医院を訪づれたのであつた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉野は病める智恵子と共に渋民を去つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　渋民村に秋風が見舞つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋民の小学校にありし頃よく用ひし事あり、丁子と云ふ名はよけれど、之を硯に擦るに、恰も軽石に踵の垢を磨く時の如き異様の音す。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋民の村の平和なる大気最も多く沁みたるべし。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "閑古鳥――　渋民村の山荘をめぐる林の　あかつきなつかし。",
              "citation": {
                "source": "悲しき玩具",
                "author": "―一握の砂以後―",
                "note": "青空文庫"
              }
            },
            {
              "text": "○啄木は岩手県岩手郡の玉山村という小さな村に生れ、隣の渋民村の学校で勉強しました。",
              "citation": {
                "source": "啄木と賢治",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "啄木が病んで郷里の渋民村に帰る時、三円だか五円だかを貸した時のである。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "渋民村からはじめて東京へ出て来た当座の石川啄木は、有名人を訪問するのが趣味で、片っぱしから門をたたいた。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "兩側百戸足らずの家並の、十が九までは古い茅葺勝で、屋根の上には百合や萱草や桔梗が生えた、昔の道中記にある澁民の宿場の跡がこれで、村人はただ町と呼んでゐる。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "好摩午後三時着の下り列車で着いて、俥だから線路傳ひの近道は取れず、態々本道を澁民の町へ廻つて來たものであらう。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙を屆けるべく、智惠子は澁民に歸つた翌日の午前、何氣なく加藤醫院を訪れたのであつた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉野は病める智惠子と共に澁民を去つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『秋の聲まづ逸早く耳に入るかゝる性有つ悲むべかり』　澁民村に秋風が見舞つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "五山は秀でて水清く秀麗の氣をあつめたるこのみちのくの澁民の母校の友よいざさらば文の林の奧深く理想の旗を推し立てむ。",
              "citation": {
                "source": "唱歌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れ澁民小學校卒業式に歌へる。",
              "citation": {
                "source": "唱歌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "一心は高し岩手山思ひは長し北上やこゝ澁民の學舍にむつびし年の重りて二梅こそ咲かね風かほる彌生二十日の春の晝若き心の歌ごゑにわかれのむしろ興たけぬ三あゝわが友よいざさらば希望の海に帆をあげよ思ひはつきぬ今日の日のつどひを永久の思ひ出に（明治四十年三月作）",
              "citation": {
                "source": "唱歌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
