  {
    "uuid": "5fed0ed8-bf8b-5f52-9072-bc2d3e30cfe2",
    "entry": "種々相",
    "reading": {
      "primary": "しゅじゅそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
