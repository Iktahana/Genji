          "standard": [
            {
              "text": "彼は30年に及ぶ執筆生活に終止符を打ち、引退を決意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "都会の喧騒を離れ、信州の山小屋で静かな執筆生活を送っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "デビュー以来、私の執筆生活は常に締め切りとの戦いでした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "なぜならばこの人は私の父の代以来親しい交りをつづけている先輩で、前々から私に「満州事変前後の内閣の事情を一度書け」と熱心に執筆生活に入ることをすすめていた前歴があるからである。",
              "citation": {
                "source": "“指揮権発動”を書かざるの記",
                "author": "犬養健",
                "note": "青空文庫"
              }
            }
          ]
        }
