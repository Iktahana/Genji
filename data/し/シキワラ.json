        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "厩舎の掃除を終えた後、馬が眠りやすいように新しい敷き藁をたっぷりと広げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の寒さから守るため、犬小屋の中に厚めに敷き藁を詰めてやった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "畑のイチゴが泥で汚れないよう、株の周りに敷き藁を敷き詰める作業を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "坂の方から門内へ流れる秋のつめたい雨水は、傾斜にしたがって犬小舎の底をも洗い、敷き藁をじっとりぬらしている。",
              "citation": {
                "source": "犬三態",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏が黄色い敷き藁を狂気のようにかき回していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "褪せた匂いのする牛のそばに敷き藁の中に寝ころんで、クリストフはパンをかじった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうえ、かわいそうなことには、しきわらの上に、ポトポトと血のしたたったあとが残っているのです。",
              "citation": {
                "source": "虎の牙",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "――徒歩立ちの面々はすぐ新しきわらじをは穿け。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く歩き、餌を食うとさも疲れたように、麦藁を短く切った敷藁の上に行って横たわった。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "柵をはずして、二人が糞に汚れた敷藁を出して新らしいのに換えていると、にや／＼しながらいつも他人の顔いろばかり伺っている宇一がやって来た。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚が新らしい敷藁を心地よがって、床板を蹴ってはねまわった。",
              "citation": {
                "source": "豚群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり向うの敷藁に頭を埋めてくるっと寝てしまったのだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚は身体の置き場もなく鼻で敷藁を掘ったのだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "敷藁も新らしくしてね。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "豚が又畜舎へ入ったら、敷藁がきれいに代えてあった。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひろびろとしてゐて、敷藁も厚く、清潔である。",
              "citation": {
                "source": "東旭川村にて",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでにその一週間前から、牛は一切の仕事から解放され、牛舍内はつねにも増して清潔に、新しく取り替へられた敷藁はたつぷりと厚かつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二匹の山羊は、敷藁の上に、顏と顏を向ひ合せ、やや圓い形になつて寢てゐた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　棚の隅には小屋から出した敷藁が広げられてゐた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　と近所に住むお婆さんに笑はれたほどに、敷藁の取り替や、床板のお掃除に、一生懸命になりました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速それに近づいて箱の中の敷藁をひつ掻きまはすと、やれやれ嬉しや、出て來たのは小さな紙束だ。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "――厩の中から、ムレた敷藁の匂いがきた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄れた白つぽい日の目は酒場の床に吐散らした痰のやうで、黄いろい金雀花の敷藁と、黄いろい秋の金雀花を照してゐる。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "山本さんは帰って来て、あなたの枕が豚小屋の敷藁よりも汚いって言ってたからよ。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐怖に満ちて一寸｜立竦み、敷藁をくぐって先達の婦の膝の間を抜けようとしたのだ。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして腹立たしげに唾をべっと吐き出すと再び敷藁の上へごろりと横になった。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "小舎の敷藁――若しあるとして――もぐちょぐちょであろう。",
              "citation": {
                "source": "吠える",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）歌うのを、鎖の鳴るのを、敷藁のさわつくのを、恋人が聞いているとは、夢にも知らんのだ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "十　竜太郎は、悪臭のする、じとじとと湿った敷藁のうえで、ボンヤリと眼を開いた。",
              "citation": {
                "source": "墓地展望亭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんも驚き、豚もびっくりして、ガサガサと敷藁をけとばして小屋の中をとびまわった。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "前田氏の方からは、麦稈の敷藁だけを提供してやる。",
              "citation": {
                "source": "コロラド通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "零下十五度くらいまで下る土地であるが、敷藁がうんとあり、牛もたくさんいるので、屋根のないところにおいても、大丈夫だそうである。",
              "citation": {
                "source": "コロラド通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに引かへ、垣根の方の長瓢は敷わらも吊もかけなかつたので、地面につけた尻の先がすこし黒いしみになりかけて来た。",
              "citation": {
                "source": "瓢作り",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
