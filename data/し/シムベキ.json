        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "哲学ハ、知ヘノ愛デハナクテ、真実ノ知トシテ成立セシムベキ様ノ体系知デアル、ヘエゲル先生ノコノ言葉、一学兄ニ教エラレタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人一千萬圓ノ私的産業ニ至ラバ其ノ事業ノ基礎及ビ範圍ニ於テ直接且ツ密接シテ國家社會ノ便益福利以外一點ノ私的動機ヲ混在セシムベキ者ニ非ラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "又被告ハ辯護士ノ外ニ自己ヲ證明シ辯護シ得ベキ知己友人其他ヲ瓣護人タラシムベキ完全ノ人權ヲ有スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ニ百利アリト假想スルモ存置セシムベキ除外例ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "勞兵會ヲ作ラシムベキ宮廷ノ權臣ト腐敗將校トハ、實ニ日本ニ「レニン」ノ宣傳ヲ導クベキ内應者ナリト云フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、御親兵ヲ置き、帝都ヲ守衛セシムベキ事。",
              "citation": {
                "source": "船中八策",
                "author": "慶応三年六月十五日",
                "note": "青空文庫"
              }
            },
            {
              "text": "総テ這地ノ隆盛ナル反ツテ旧趾ノ南浜新駅ヲ羞シムベキ景勢ナリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の模様を新聞は云う、「……此ノ盛式ハ東京知事ノ面前ニテ行フト有ル故ニ、大久保公ハ何処ニ御座ルカト見レドモ我輩ハ其顔ヲ知ラネバ何分ニモ見当ラズ、唯怪シムベキハ此正座ニ髭ガ生エタ猟師ヲ見タルノミ。",
              "citation": {
                "source": "ハイカラ考",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
