        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "脚絆穿で、むかし傀儡師と云った、被蓋の箱を頸に掛けて、胸へ着けた、扮装は仔細らしいが、山の手の台所でも、よく見掛ける、所化か、勧行か、まやかしか、風体怪しげなる鉢坊主。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺の見收めといふ積りで山門をのぞいて見たら石垣の上の一｜畝の茶の木を白衣の所化が二人で摘んで居る所であつた。",
              "citation": {
                "source": "炭燒のむすめ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　　　　　＊　　　　　＊　　　　　＊下手より五六の学僧（学頭、所化長順、所化乗円其他）登場。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し先頭の所化乗円は『妙法院』と記されたる提灯を持ちたり。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　所化長順が気が狂うてござる。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　（長順に）御宗門を疑ふが、狂はいで何としようぞ。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　その証拠が立つか。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　黙り召され！",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　聞きしにまさる長順が乱心。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化乗円提灯を翳して伊留満に迫る。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち所化長順群より離れ、舞台の中央に来り、舞妓白萩にすれ違ひ、長順　ふつ、其方は……白萩袖を翳して退く。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　　　　　＊　　　　　＊　　　　　＊所化等　（遠くの方にて）羯諦、羯諦、波羅羯諦、波羅僧羯諦。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）第一の所化　（一歩前に踏み出し乍ら）やれ、口惜や、南蛮寺の妖術めに化されておぢやつたとは。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　（忽ち長順の領を捉へて）こや、長順。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　お主は血相かへて何する積りぢやえ。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　何と、吉利支丹へ入門とな。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　やあい、同学衆よ。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化等　え、邪宗へ改宗ぢやてや。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　長順今ぞ思ひ知れ！",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化等『南無阿弥陀仏、南無阿弥陀仏』と唱へ乍ら、杖を以て長順を打つ。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の所化　（長順を顧みつつ）やい、長順、荘厳光明の究竟道、般若波羅密多には行きもせえで、女人の袖に隠るるとは、はて、さて、お主たちに善う似合うた邪宗門の勤行よな。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化等　此日己過、命即衰減、如少水魚、斯有何楽。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化等　諸衆等、当勤精進、如救頭燃、但念苦空、無常勤慎、莫放逸。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化等のうち、或は首を回らして長順を顧るものあり。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "学頭　（所化等に）天魔波旬の誘惑に、方々は心を労すると見ゆるな。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所化等　南無阿弥陀仏。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
