        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その古文書には、深奥な教えが記されており、解読には長い年月を要した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の哲学は非常に深奥であり、理解するにはかなりの知識が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "深奥な議論が交わされ、参加者たちは新たな知見を得た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
