[
  {
    "uuid": "bb84a739-efa0-594f-ba8c-c76a34a59d71",
    "entry": "商流",
    "reading": {
      "primary": "しょうりゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
