        "examples": {
          "standard": [
            {
              "text": "有名な書道家が展覧会で新作を公開した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は若い頃から書道家を目指して修行していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この書道家の作品は国際的に高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「日本書道家辞典」と「禅語辞典」と、森於菟氏の「解剖台に凭りて」なり。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとまた、書家の書好ましからず、と墨象一派の新書道家がご都合よろしくこれを楯にとらうとする。",
              "citation": {
                "source": "棋家の文章など",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――といつても、古格をそのまゝかた寫しにしてゐるいはゆる書道家の書などとは同日にかたるべきものでなく、かれ自身の、靈山子の假名として、あざらかに獨創のいのちをもつてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
