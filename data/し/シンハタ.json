          "literary": [
            {
              "text": "茨の生える新畑は、谷から頂へ向けて、ところ斑に黝んでいた。",
              "citation": {
                "source": "土竜",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ろの方はその頃｜新畑町といった所、それからまた田圃であった。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "名高かった店などの印象",
                "note": "青空文庫"
              }
            },
            {
              "text": "新畑町の有名な幸竜寺も、たんぼの幸竜寺でとおっていた。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
