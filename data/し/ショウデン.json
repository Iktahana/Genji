      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "entry into the sanctum of a shrine or temple",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大切な儀式に際し、神職は神殿へ昇殿した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "祭りの日、許可された者だけが本殿へ昇殿できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "格式の高い寺院では、特定の祭事においてのみ、僧侶が内陣へ昇殿する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "しかも、白河上皇が、従来藤原氏の爪牙たる源氏に対抗せしめるため、伊勢平氏たる平正盛、忠盛父子を御信任遊ばされたので、忠盛は西海に於ける海賊討伐に功を立て、瀬戸内海に平家の勢力を扶植すると共に、中央に進出して、鳥羽院の昇殿を許されるに至つた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民タル人權ノ本質ニ於テ、羅馬ノ奴隷ノ如ク、又昇殿ヲモ許サレザル王朝時代ノ犬馬ノ如ク、純乎タル被治者トシテ或ル知者階級ノ命令ノ下ニ其ノ生死ヲ委スベキ理ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "近日のうちに、忠通が病気を押して昇殿する。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "量長は長近より五代目に当る公義の子で、文化九年十二月十三日誕生、文政八年三月廿八日十四歳を以て元服、越後｜権介に任じ、同日院昇殿を聴され、その後｜弾正少弼を経て修理大夫に至り、位は天保十三年十二月廿二日従四位上に叙せられたことまでは、地下家伝によつて知ることが出来る。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどういうものか、あまり位が進まないで、いつまでもただの近衛の武士で、昇殿といって、御殿の上に上ることを許されませんでした。",
              "citation": {
                "source": "鵺",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く天子の御所へなど昇殿すべき器のものではないが、上より召されたから二度までも殿上へ参ることになった。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "といっても、たかだか、受領職にある身では、とても昇殿を許されるというところまではいかない。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時にあっては、昇殿を許され殿上人と親しく交わることが、及びもつかない栄誉であったから、この律義で賢い田舎武士、忠盛の心に昇殿を望む気持が頭をもたげてきたのは当然のはなしである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき備前守だった忠盛は、但馬国の国司に任ぜられ、その上、あんなに待ち望んでいた昇殿を始めて許された。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は、昇殿も許され、殿上人に伍して舞う身ながら、元はといえば、お前なんか、伊勢の田舎ものじゃないか、ひっこめ、ひっこめ、というわけなのである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この謀みに多く加わっていた北面の武士とは、白河院の時に始めて置かれたものだが、この時代になると、相当羽振りをきかしたもので、中には、五位以上に叙せられ、昇殿を許された者もあり、公卿を公卿とも思わぬ連中が多かった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大内守護として長年勤めていたが、昇殿は許されなかったのである。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "人知れぬ大内山の山守は　　木がくれてのみ月を見るかな　この歌が目にとまり昇殿を許されたうえに、正下四位を与えられたが、頼政はさらに三位の位にのぞみをかけた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第四巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、昇殿は許されなかった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "至極上手の女にあらざれば此おはたやを建る事なければ、他の婦女らがこれを羨事、比諭ば階下にありて昇殿の位をうらやむがごとし。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らく一生つとめても五位の昇殿、国守になる位で、四位はなかなかむつかしかったろう。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときの作者は院をも合せて二十三人、定家は間もなく昇殿を許され、正四位下に叙された。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで天皇親政の内裏では、やはり面ただしいことが大切で、歌会なども思うままにというわけには行かず、当時の新派の歌人は多く地下の人で、内裏の昇殿は許されてもいず、九条家や土御門家などに集っているだけで、打って一丸とした歌壇というものはなかった。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九『正治百首』によって後鳥羽院の仙洞に昇殿を許された数々の歌人のうちで、定家は光っていた。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それくらいだから、長年、禁門の衛府にありながら、彼のみは、昇殿もゆるされなかった。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "若年から御所の衛りに立つ弓取の身として、それだけは頼政も、痛恨事としていたとみえて、ある時、殿上の人に、所懐の和歌をそっと示したところ、帝のお耳にはいって、　――あわれな心根、昇殿をゆるしてやれ。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、昇殿をゆるされた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天子に政事を奏するため、董卓が昇殿したので、呂布はいつものように戟を執って、内門に立っていた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "禁中へ伺候すると、帝は、階下遠く地に拝伏している玄徳に対し、特に昇殿をゆるされて、何かと、勅問のあって後、さらに、こう訊ねられた。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはなべて、位階が欲しい、いかめしき官職名にありつきたい、また昇殿の栄を欲しがっている。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "武家では、昇殿の資格など滅多にえ難い。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきに、昇殿をゆるされ、位記では、途上の牛車もはばかりない身分である。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そう言い終ると、五右衛門は仔細ありげに十字を切って、「――南無さつたるま、ふんだりぎや、守護しょうでん、はらいそはらいそ……」　と、おかしげな呪文を唱えたので、佐助は危く噴きだしかけたが、辛うじて堪えた。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、五右衛門もさる者であったから、いつまでも蟇の我慢という洒落に、甘んじていず、再び「南無さつたるま、ふんだりぎや、守護しょうでん、はらいそはらいそ……」　と、必死の呪文を唱えたかと思うと、沛然と雨を降らした。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "entry to the imperial court (in the Heian period)",
        "register": "standard",
