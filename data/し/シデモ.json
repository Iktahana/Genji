          "literary": [
            {
              "text": "答　モシ私ノ云ッタ事ニ対シテ、清三ガ少シデモ耳ヲ傾ケテクレタラ、私ハ清三ヲ殺サズニスンダカモシレナイノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ美シサニ於テＡヨリＢガ少シデモ劣ッテイタノデハイケナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレ老人ニハ知ラセテ置イタ方ガ都合ノイヽコトガアルノダカラ、ソレナラ少シデモ早ク知ラセテ因果ヲ含メテヤッタ方ガ功徳ニナルト、考エタカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少シデモ長ク保存シテ置キタイト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
