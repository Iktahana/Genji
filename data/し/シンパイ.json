    "definitions": [
      {
        "index": 1,
        "gloss": "heart and lungs",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "心肺停止の状態から、救急隊員が蘇生処置を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "健康診断で心肺の状態を詳しく検査した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "マラソン選手は、優れた心肺機能を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "伏して観る、朝廷｜陵替、綱紀崩擢、群雄国に乱るの時、悪党君をあざむくの日にあたりて、備、心肺ともに酸く、肝胆ほとんど裂く。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みなさん」と　もるもっとは、しんぱいそうに　して　いる　みんなの　かおを　みまわして　いいました。",
              "citation": {
                "source": "がちょうの　たんじょうび",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、どうしたの」　と、しんぱいして。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイちゃんのいなくなったとおなじように、しんぱいしていらっしゃるわ。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、そうおもうと、うれしいし、しんぱいでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "もみの木はせっかくのかざりを、ひとつもなくすまいと、しんぱいしました。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜は、とうとう女の子が、畑から家にかへりませんでした、母親はしんぱいして、あくる朝早くに、さがしにでかけました、すると、畑のまんなかに、女の子の鍬がなげだされてあるきりで、女の子のすがたは見えません。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥロットは、しんぱいでたまらなくなりました。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも何だかしんぱいでもありました。",
              "citation": {
                "source": "乞食の子",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそく憲兵隊へしらせなきゃいかん」　憲兵軍曹である良太おじさんは、じつはミドリのお父さまが、ある大事なご用をひきうけて旅にでたのに、いつまでたってもかえってこないのをしんぱいして、ちょうどいま、たずねてきたところなのでした。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こうしておけば、スパイ団にみつかるしんぱいはないだろう。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "高一は「地底戦車」を発明したお父さまが、敵国からにらまれていることがしんぱいでなりません。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "高一とミドリは、しんぱいでもあり、またおおよろこびです。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを村人がしんぱいして、それとなくわけをたずねたが、左平はいつもかぶりをふって、「何も、しんぱいなぞしていない、そんな話はもうごめんだ」　と、耳を貸すのもきらった。",
              "citation": {
                "source": "時計屋敷の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと機の高度をあげればよいわけであるが、これ以上あげると、エンジンの馬力がたいへんおちるしんぱいがあった。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲がうずまいて、うごきだしたぞ」　と、しんぱいそうである。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "山にぶつからなければいいが……」と、ひごろおちついた木谷博士が、しんぱいそうに席から腰をあげた。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しんぱいいりません」　このとき、ひじょうに香の高い香水が、房枝の鼻をぷーんとついた。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かならず、しんぱいいりません」　そういうと婦人は、英語で、べらべらと喋りだした。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しんぱいいりません。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしが、手落なくしますから、しんぱいいりません」　と、しきりに房枝をなぐさめたのであった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちは、皆でしんぱいしているのですからね。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれッ、そばへいっちゃ、いけないのかなあ」　もぐらが、一郎にかみつくといけないと、お百姓さんは、しんぱいしているのであろうか。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ、もぐらの数は多いし、それに、ここは、べらぼうにひろいから、もぐらの行方を、いちいちしんぱいする必要はなかった。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しんぱい村山籌子-------------------------------------------------------【テキスト中に現れる記号について】：入力者注　主に外字の説明や、傍点の位置の指定（例）（母でてゆく。",
              "citation": {
                "source": "しんぱい",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）-------------------------------------------------------「けふは、あんまり　いたづらばかり　したので、もう　ぼくは　いい　こに　なれなく　なりや　しないかと、しんぱいだ。",
              "citation": {
                "source": "しんぱい",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "）「かあさんは　ああ　いふけれど、しんぱいだなあ。",
              "citation": {
                "source": "しんぱい",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三根夫は伯父に同情し、そしてまた仕事に熱心すぎる伯父の健康についてしんぱいになった。",
              "citation": {
                "source": "怪星ガン",
