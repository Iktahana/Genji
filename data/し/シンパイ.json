  {
    "uuid": "facb1122-532b-55f0-b21e-6177f67d8ca1",
    "entry": "神拝",
    "reading": {
      "primary": "しんぱい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
