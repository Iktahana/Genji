          "literary": [
            {
              "text": "甲はいわゆる書家の書というものであって、現在でいえば、よくある書道展覧会などに出陳されているような物を指すことが出来る。",
              "citation": {
                "source": "美術芸術としての生命の書道",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ近い例を挙げますと、申し上げて甚だ悪いようですが、上野あたりに催されます書道展覧会などを見ますと、若い人でも、名のない人でも、きちんとした俗にいう正しい書き方で書いておる字が沢山あります。",
              "citation": {
                "source": "よい書とうまい書",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代高僧の書道展などと呼称するものが、デパートに催される際、私はいつも現代高愚僧に満つと叫ぶのが常だ。",
              "citation": {
                "source": "現代能書批評",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
