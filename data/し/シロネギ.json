        "examples": {
          "standard": [
            {
              "text": "鍋物には、たっぷり白ネギを入れると美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "刻んだ白ネギは、ラーメンのトッピングに欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この白ネギは甘みがあって、生で食べても美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "このときは白ネギを使った。",
              "citation": {
                "source": "ゲテ魚好き",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "公会堂の小使室から洩れて来るかすかな明かりに照らされて、整然とならんだ刀が、八百屋の店先の白ネギの列のようである。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
