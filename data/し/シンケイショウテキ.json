        "examples": {
          "standard": [
            {
              "text": "神経症的な完璧主義は、時に仕事の効率を妨げることがあります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「彼の神経症的な言動は、周囲の人を困惑させることもあったよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の神経症的な性格は対人関係にしばしば支障をきたす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ブレイクは過去の邪教の驚くべき痕跡を発見したのだが、その邪教に関する知識によって悪化した本人自身の過剰な想像力と神経症的な不均衡とを考えれば、最後の逆上した走り書きを解釈することができる。",
              "citation": {
                "source": "闇をさまようもの",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
