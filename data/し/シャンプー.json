        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "髪を洗うときは、まずシャンプーで汚れを落とす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行用に、ミニサイズのシャンプーを持っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あ、シャンプー切らしてた！誰か買ってきてくれない？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "お辰はすかさず、「敬さん、剃刀でもシャンプーでも用あったら、注文したっとくなはれや」　と、言った。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンプー、これは口があいています。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいかげんに、あがれよ」　高志はシャンプーと桶をもって、浴槽のきわまでくる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンプーを頭にこすりこみ、慶一は目をつぶって、高志がいると思われる方向に顔をむける。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄さんが、髪を洗うのに、シャンプー（花王や何か）つかいすぎて今前のところがひどい有様になっているのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンプーとか歯みがきとか、要心ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンプーのためのシンクが店の奥にあった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンクに向けて上体を乗り出させ、節子はヨシオの髪のシャンプーを始めた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はい」「こんなにつけてると、毎日洗わないといけないわね」「そうなのです」「たいへんだわ、これは」　シャンプーの液を掌に受け、節子はそれをヨシオの髪にまぶした。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャンプーを終え、タオルで水を拭き取り、さらにドライアーを使って、節子はヨシオの髪を乾かせた。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗って乾かしてから、ばっさりいきましょう」　シャンプー台へ、彼女はヨシオを連れていった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯で濡らしたヨシオの髪に、掌に取った大量のシャンプーを、彼女は何度も彼の髪にまぶした。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "剃って、シャンプーして、ついでに前のビューティパーラーでマニキュアをしてみる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが二階のビュティ・パーラーの髪の焼ける臭気と、鏝のかみあう響と、シャンプする水の流れる音に交錯した。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡猴が一たび自涜を知れば不断これを行い衰死に及ぶは多く人の知るところで、一八八六年板ドシャンプルの『医学百科辞彙』二編十四巻にも、犬や熊もすれど、猴殊に自涜する例多しと記し、医書にしばしば動物園の猴類の部を童男女に観するを戒めある。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
