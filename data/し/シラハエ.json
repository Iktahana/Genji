          "standard": [],
          "literary": [
            {
              "text": "小網にかかれる白鮠のわれもかひなく驚きて、唯恐れある物狂、ここに道なし、快樂なし。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "古来いろいろな解釈があるらしいけれども、梅雨に入って吹くのをクロハエ、梅雨半に吹くのをアラハエ、梅雨晴るる頃より吹く南風をシラハエという『物類称呼』の説に従って置く。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
