    },
    "definitions": [
      {
        "index": 1,
        "gloss": "clam digging (at low tide)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末は家族で潮干狩りに出かけ、たくさんのアサリを採った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "潮干狩りには、熊手とバケツが必需品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃の楽しい思い出といえば、潮干狩りで夢中になったことだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "手前等は引き潮の時に潮干狩りでもしやがれ。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "終戦の年の五月の頃であったが、私は焼野原をテクテク歩いて、羽田の飛行場の海へ、潮干狩りに行った。",
              "citation": {
                "source": "釣り師の心境",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "四面焼け野原となって後は、配給も殆どなく、カボチャや豆などを食わされ、さすがに悲鳴をあげたという程のこともないが、半分は退屈だったから、潮干狩りとシャレてみたのである。",
              "citation": {
                "source": "釣り師の心境",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れてはじめての潮干狩りであった。",
              "citation": {
                "source": "釣り師の心境",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、海老床の若い者や藤吉部屋の勘弁勘次や、例の近江屋の隠居なぞが世話人株で、合点長屋を中心に大供子供を駆り集め遅蒔きながら、吉例により今日は品川へ潮干狩りにと洒落こんだのである。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "怪談抜地獄",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れてきたので、東京から連れてきた女たちに潮干狩りをさせる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は上り框に寝ころんだまま、しおひがりだよ、早く床取ってくれ、と怒鳴り返した。",
              "citation": {
                "source": "蜆",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははははは」　よく訊いてみると、きのうは旧暦の三月三日で大潮にあたるというので、老人は近所の人たちに誘われて、ひさしぶりで品川へ潮干狩に出かけると、花どきの癖で午頃から俄か雨がふり出して来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年は三月三日の節句に小雨が降ったので、江戸では年中行事の一つにかぞえられているくらいの潮干狩があくる日の四日に延ばされた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは朝から日本晴れという日和であったので、品川の海には潮干狩の伝馬や荷足船がおびただしく漕ぎ出した。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの船でも午飯をすませて、再び潮干狩をつづけていると、やがて夕七ツ（午後四時）を過ぎたかと思うころに、かの男は又ふらふらとあらわれた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "命に別状のなかったのをせめてもの仕合わせにして、きょうの潮干狩の群れはさんざんの体でみな引き揚げた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはもうかの潮干狩から半月ばかり後であった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の噂も七十五日で、潮干狩の噂はだんだんに消えて行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かあったか」　潮干狩の一件以来、幸次郎は半七に催促されるのが苦しいので、築地河岸の船頭はいうまでもなく、芝浦から柳橋、神田川あたりの船宿をまわって、絶えず何かの手がかりを見つけ出そうと焦っているうちに、けさ偶然にこんなことを聞き出したのである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあいだの潮干狩に出て来た奴もやっぱりそれだろう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "清次が乗せた潮干狩の客は、かの怪しい男となにかの関係があるらしい。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "かたがたこの潮干狩の一と組を詮索すれば、自然に彼の正体もわかるに相違ない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことしの三月四日、喜兵衛が同類四人とおとわを連れて品川の潮干狩に出てゆくと、かの怪しい男がそこらを徘徊しているのを見た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、その警告の通りに恐ろしい颶風が吹き出して、潮干狩の人々を騒がしたので、喜兵衛はいよいよ驚かされた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう煎じつめてみると別に変った人間でもないんですが、ただ不思議なのは潮干狩の日に颶風の来るのを前以って知っていたことです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "海坊主",
                "note": "青空文庫"
              }
            },
            {
              "text": "海老１　潮干狩の季節が来た。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮干狩に往って、貝を拾い、魚を獲るのは、それぞれ異った興味があるものだ。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日は父に連れられて、皆で潮干狩に行くのだつた。",
              "citation": {
                "source": "潮干狩",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮干狩のうわさも過ぎて、やがては初夏のにおいも近い。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮干狩、この寒さでやる人もあるかしら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "虹ヶ浜に潮干狩があるのでしょうね、やっぱり。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "洲崎は春は潮干狩、冬の月には千鳥と風流がられた。",
              "citation": {
                "source": "花火と大川端",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京で羽田の潮干狩に行って汚いのにこりた。",
              "citation": {
                "source": "栄螺",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、蘆葦茅草が枯れ枯れに叢をなしているところ、それが全く断れて石ころの堆いところ、その間を、茸狩か、潮干狩でもするような気分で、うかうかと屈伸しながら歩んで行くと、当然、到着すべき一つの地点に達して、そこで初めてお雪ちゃんが、あまりのことにまた驚愕狼狽しなければならぬことになりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
