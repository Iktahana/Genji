          "literary": [
            {
              "text": "モシソレ薫風南ヨリ来ツテ水波紋ヲ生ジ、新樹空ニ連ツテ風露香ヲ送ル。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "石黒氏ノ近業ハソノ名ノ示スガ如ク往昔郷閭ノ私塾ナリシ有隣舎ノ沿革ヲ調査シソレガ師弟ノ伝ヲ述ベタルモノニシテコレスナハチ拙稿『下谷叢話』ノ記述スル所トホボソノ事ヲ同ジクスルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシソレニハ一切、加勢無用」と。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
