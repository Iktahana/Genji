      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "commerce and industry association",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地元の商連が主催するイベントには、多くの人が集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "商店街の活性化に向けて、商連が新たな取り組みを始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "商連の会議では、地域経済の課題について活発な議論が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "政商連と結託して、金のためにばかり、動いてゐるらしいのだ。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "四時、菊水楼上の、京都芸術クラブの座談会へ、紳商連のお道楽の集りらしく、客種よし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そとがわは、けしょうれんががはげおちたままの、きたない建物ですが、内部には手いれがしてあるらしく、なにかの会社の事務所になっていて、夜も小使いの一家が、そこにとまっているようすでした。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
