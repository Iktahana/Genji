  {
    "uuid": "2eb1edf6-c9d6-5904-863e-a44d0c0a72ee",
    "entry": "沼岸",
    "reading": {
      "primary": "しょうがん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
