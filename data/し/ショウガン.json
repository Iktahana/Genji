[
  {
    "uuid": "c2e65c97-1cb3-5c75-8365-a3938ac52d15",
    "entry": "賞玩",
    "reading": {
      "primary": "しょうがん",
      "alternatives": [
        "しょうかん"
      ],
      "is_heteronym": false
    },
    "grammar": {
