    },
    "definitions": [
      {
        "index": 1,
        "gloss": "impertinent",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「お前ごときが口出しするとは洒落臭い！」と上司に一喝された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "洒落臭い態度を取る新人に、先輩は指導に苦慮していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供が大人ぶって洒落臭いことを言うので、思わず笑ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「そんなりっぱなことを言って、きっとだね」　奴は昂然として、「虚言と坊主の髪は、いったことはありません」「なんだね、しゃらくさい」　微笑みつつ女子はかく言い捨てて乗り込みたり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の体と楽天地のミイラを比較してみて、いろはにほへど散りぬるをと何もかもしゃらくさい気持になった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "……敵呼ばわりしゃらくさいわい！",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとすぐ引きかえして来て、「しゃらくさい、とおっしゃるだけで。",
              "citation": {
                "source": "仇討たれ戯作",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、大ざっぱに言えば、人間と人間とを結び合うものは、愛などというしゃらくさいものでなく、もっぱらこのオセッカイとか出しゃばりとかの精神ではないでしょうか。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああいうしゃらくさいお化粧は、もっと実のある・もっと精の強い・食物を取ることができない俗人どもをごまかすだけのもので、アフェルがタキトゥスの中で非常に明瞭に示しているとおりでございます。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなしゃらくさい真似をしたって、あの審判者にあの暴露をやめさせることはできるものではない。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しゃらくさいわッ」　呂宋兵衛は、民部の第一刀をひッぱずして、いきなり鬼のような手で彼の右手をねじあげた。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウム、しゃらくさいやつめら！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かッ、そのそっ首を」「しゃらくさい」　ふたりは花栄を入れなかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものは気をつけていうものぞ」　彼の反撥を食うと、かえって、仮借は無用と、玄蕃も六郎左も、その傲岸を、露骨にして、「しゃらくさい小理窟を」　と、せせら笑った。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "何をしゃらくせえまねしやがるんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卒塔婆を祭った米びつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちらと磯五を見た久助の眼に、何でえ、しゃらくせえ、といいたげな気持ちが走り過ぎたが、磯五は、すっかりいい気にたばこをふかしていて、気がつかなかった。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが人間ならば、おきまりの「やあ、抜きゃがったな、しゃらくせえ、水道のお兄さんの身体へ、なまくらが立つものなら立ててみろ」とかなんとか、啖呵を切りながらも用心を改めるところなのですが、犬ですから、その見境いがありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "また例のおどしだと思ったものだから、負けん気の千太、ふふんと鼻で笑って、なにをしゃらくせえ、と言うつもりなのが、ただ、「ウワ、ウワ」　としか言えない。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "野伏大名",
                "note": "青空文庫"
              }
            },
            {
              "text": "しゃらくせえ野郎、そのだらしねえ様は何だ、乳｜臭え小僧のくせに、宵の口から酒喰らいやがって、女とじゃれるなあ、みっともねえ、市廻りの恥｜曝しだ、それでいておいらの仲間だと言えるかよ。",
              "citation": {
                "source": "蕎麦の花の頃",
                "author": "李孝石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「野郎、何をしゃらくせえ」　藤作の入ってきたことがわかったら、それだけでこび権は手をはなしたであろう。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふざけるな、しゃらくせえや、なにょうぬかす。",
              "citation": {
                "source": "泥棒と若殿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「捜してみてもしも有ったらおれにも少し分けて呉れ」「ふざけたことを云いやがる、しゃらくせえや、ばかにしやあがるな、野郎、みていろ、そこを動くと命あねえぞ」　こう脅迫して、こちらがじっとしているのを認め、そろそろ家捜しにとりかかった。",
              "citation": {
                "source": "泥棒と若殿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそうではないかもしれない、「やい」とか「しゃらくせえまねをするな」というような罵しり声は、慥かに床下のほうから聞えて来た。",
              "citation": {
                "source": "泥棒と若殿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「しゃらくせえッ」　いきなり、※殺羊の張保は、楊のからだを羽ガイ締めに締めあげながら、四ツ辻の蔭へ向って大きく吼えた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を、しゃらくせえと俺が口のなかで罵ったとき、医者が、「対支非干渉のスローガンで、無産政党は共同闘争に出ているが、スローガンや声明だけじゃ駄目だな。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワッ」　よろめき眼を抑え、引いたのに代って八五郎が、「洒落臭え女郎！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（土間へ踏み込む）三蔵　　洒落臭え。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "文太郎　（政吉の腕を解き、攻勢となり）野郎っ、洒落臭え。",
              "citation": {
                "source": "中山七里　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
