          "literary": [
            {
              "text": "他の娘も笑いながら、「房ちゃん、シイコが出ますかネ」　お房は半分眠っていた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "クワシイコトハ物理学者ニ聞カナイトワカラナイガ、多分直線ノホウガヨリ少ナイエネルギーデヨリ多クノ距離ヲ行ケルノダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア、オアガリ、オイシイ」「有難う、ほんとにふっくりして、おいしそうなこと」「オ饅頭、支那ガ本場アリマス、金椎サン上手、オイシイコト請合イ」　かくて二人は、ふっくりしたお饅頭を二つに割って、半分ずつ旨そうに食べている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トイフウレシイコトダラウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤカマシイコトバカリシテ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "親不孝ノ予ニシテハ珍シイコトデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「経助坊チャンハイジラシイコトヲ仰ッシャイマスノネ」ト、佐々木ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（又予トシテモ、ソンナ厚カマシイ耻カシイコトヲ臆面モナク頼ム勇気ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
