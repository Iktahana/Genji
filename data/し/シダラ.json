    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "加助がお槙にフシダラなことをしかけて当家を追放されたのは五月五日、節句の日だね。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二　密室大犯罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸方が如何にシダラがなくなったと言い条、まだ千二千の兵くらいでビクリとでもすると思っているのは大きな了見違い。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……御朱印外も常陸の方の生れは生れだけど、小さい時からの深川育ち、もともとこんなにシダラがなくはない。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……御朱印外も常陸の方の生まれは生まれだけど、小さい時からの深川育ち、もともとこんなにシダラがなくはない。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シダラ　ウテト　テテガノタマエバ　ウチハンベリ　ナラビハンベリ　アコメノソデ　ヤレテハンベリ　オビニヤセン　タスキニヤセン　イザセンイザセン　――くそっ！",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
