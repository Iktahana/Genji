        "examples": {
          "standard": [
            {
              "text": "各地から集められた情報を集束し、一目で状況が把握できるダッシュボードを作成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "集束された電力網は、一つの変電所にトラブルが起きても他のルートで補完できる強みがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バラバラだった組織の力を集束させることで、不可能と思われた目標を達成することができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
