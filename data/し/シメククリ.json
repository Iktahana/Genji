        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "現場の締めくくり役として、彼は細部まで厳しくチェックを怠らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "プロジェクトの締めくくりが甘いと、後で思わぬトラブルを招くことになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は若手社員の締めくくりを任されており、教育にも熱心だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
