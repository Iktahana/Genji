    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゲンマンしたんですもの。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしお願いがわがままだったらそれでもかまわない、やっぱり私は私の心にあるこれほどの愛情が当然に必要とする具体性としてこのゲンマンの指を出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、貫太の声は聞えず、ただ、娘たち二人が、両方から、勢ひ込んで、「きつとね」「ぢや、ゲンマン……」と、彼の言質をとらうとしてゐる様子がうかがはれた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、ゲンマンしましょう！",
              "citation": {
                "source": "詩劇　水仙と木魚",
                "author": "――一少女の歌える――",
                "note": "青空文庫"
              }
            },
            {
              "text": "きみが切れば切る」「僕も若様がお切りになれば切ります」「それじゃ約束しておこう」「ゲンマンですよ」「なんだい？",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンマンてのは」「約束を破れば拳固で一万たたくんです」「それじゃ僕もゲンマンだ」「ゲンマン！",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はあ」「それじゃゲンマンをして帰る」「まだよろしいです」「いや、もう帰る。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、ゲンマン」「はあ」一家｜団欒　正三君は三度めの帰宅だった。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし逢ったら、私死にます”“逢わない、誓う、ゲンマン　一生、逢わない”　十八日、よる。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
