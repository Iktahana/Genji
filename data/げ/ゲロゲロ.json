    "definitions": [
      {
        "index": 1,
        "gloss": "throwing up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その子どもは酔ってげろげろと吐いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "乗り物酔いして、彼はげろげろしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "蛙かやかやこやこや、ころころ、げろげろ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから胸がむかむかして、げろげろとやってしまった。",
              "citation": {
                "source": "四次元漂流",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "法座の上の僧正の、たゞひとりの講讃まではつきり拡声機によつて聞かれたことは、好奇心を満足はさせたかもしれぬが、読経のあひまに喉に痰がひつかゝつて、げろげろとあさましく痰を吐くその音まで境内一杯に拡声放送されたのには失笑した。",
              "citation": {
                "source": "君臣相念",
                "author": "龜井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドタリと音を立てて草の上にたおれると、すぐに両手を突張って起き上ろうとしたが、そのまま全身を綟じらしてゲロゲロ、ゲロゲロと白いものを嘔き始めた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の裏通りの二人の幸福が女中のゲロゲロによって暴露されようとしつつあった。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｃが失神する位の蒼さを呈したのと、ゲロゲロでもって完全にＢ夫婦にも合点が行った。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "この悪ザルめ、それっといって、みんなでいま食った餅をゲロゲロと吐き出して、サルの面に投げつけた。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒海にもてあそばれ、船中、ゲロゲロの慘状だつたが、ぼくは、波洗ふ甲板の上に出で、身を帆柱にしばりつけた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の身体が敵に逢った海老みたいに、非常な速度で水中にもんどり打ったかと思うと、彼は七転八倒の有様で、水面に浮き上り、したたか飲んだ泥水を、ゲロゲロと吐き出した。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
