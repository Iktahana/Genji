        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜の池からはカエルがげろげろと泣いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "夏の夜、げろげろというカエルの声が聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "田んぼからはげろげろとした蛙の合唱が響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
