        "examples": {
          "standard": [
            {
              "text": "核爆発の数秒後に原子雲が上昇し始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "広島に投下された爆弾の原子雲は高さ数千メートルに達した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "原子雲の形状は気象条件によって変わる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "熱帯の太陽にやきつくされたサハラ沙漠の上空には、五色の原子雲が渦まき、その雲はぐんぐんとのびあがって、この事宙航空船のあたりまで追って来たのである。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにして、Ｘ号はサハラ沙漠で最期をとげ、その最期の地の上空にたなびく原子雲のまわりを、二三度｜旋回した宇宙航空船は、ふたたび機首をめぐらして、日本の国、三角岳へ向かったのだった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この放射能原子雲の流れゆく果てはどこか。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
