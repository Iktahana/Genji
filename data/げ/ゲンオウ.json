  {
    "uuid": "7ba58cba-26bb-5cd7-9fbe-38b8d88374af",
    "entry": "現王",
    "reading": {
      "primary": "げんおう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（先王の子にして現王の甥。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、念のために一つお伺いして置きますが、ハムレットさま、あなたは、勿論、現王のお人がらを信じていらっしゃいますね？",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムレットさまは、現王の愛情を信じていらっしゃるのです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先王にも、現王にも、またハムレットにも、みんなに、だまされていたのです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と私が、その指に巧みなブリリアントカットの宝石があるのに目を付けて訊ねると、「これはオランダの現王家からだ。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲八金天大明権現王子と神様の合資会社で、混雑千万、俗臭紛々｜難有味少しもなく、頭痛胸悪くなりて逃げて行く。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなった先代のクヌード・ドラーゲ公も商務大臣を、そしていくらか現王室とも繋がりがあるように聞いていた。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "現王子駅前に川がある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "現王アムラト三世も、彼らの例にならって同様の憂目を見ようとしている。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
