        "examples": {
          "standard": [
            {
              "text": "スマートフォンの見過ぎによる「テキストネック」は、典型的な現代病だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "運動不足や偏った食生活からくる生活習慣病は、深刻な現代病と言える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "常に何かに追われているような焦燥感も、一種の現代病かもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それは一種の現代病でせう。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば現在の世代は、ウィルヒョウおよび彼の偉大な同時代人が現代病理学の確実で深い基礎を作っていた1870年代に我々を取り巻いていたものとは、非常に異なる影響のもとに育っている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
