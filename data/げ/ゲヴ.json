        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "例えばシャーロック・ホームズはレストレードを翻弄し、ルコックはゲヴロルを物ともしない。",
              "citation": {
                "source": "ヂュパンとカリング",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌三三年にはデュッセルドルフに移ってそこに腰を据えたが、二年後の一八三五年には名誉あるライプチッヒのゲヴァントハウス音楽会の指揮者に任ぜられ、そこで始めてショパンやクララ・ヴィーク（後のシューマン夫人）に逢った。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲヴァントハウスの指揮者としての五年間は、おそらく幸福の権化のような人間メンデルスゾーンでさえ、最も平和な生活と、満ち足りた幸福を味わった時であったろう。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライプチッヒ、ゲヴァンドハウス弦楽四重奏団は、シューベルトの『鱒の五重奏曲』を入れている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイ・ゲヴ・マイ・ウワーズ」した以上、それは取り戻せないことなのである。",
              "citation": {
                "source": "ピーター・パン",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはこれをゲヴァラの『書簡集』の中で読んだばかりである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊＊　アントニオ・ド・ゲヴァラ（Antonio de Guevara, ou Antoine de Guevare）の著 〔Livre dore' de Marc Aure`le〕 のこと。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
