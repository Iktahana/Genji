        "examples": {
          "standard": [
            {
              "text": "人類学では原始共産制の社会構造を研究する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "原始共産制では生産物が共同で管理されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "マルクス主義者は原始共産制から発展する社会の段階を論じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そこで一部落の住民が共産体をつくつて、所謂原始共産制が出現する。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば人々は原始共産制・封建制・資本制等々の段階を分ち、又或る段階の資本制を第一期・第二期・第三期等々の段階に分ける。",
              "citation": {
                "source": "再び「科学の歴史的社会的制約」に就いて",
                "author": "――岡邦雄氏に答える――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
