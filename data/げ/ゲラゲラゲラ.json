        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると倒れた方のまっ二つになったからだがバタッと又一つになって、見る見る傷口がすっかりくっつき、ゲラゲラゲラッと笑って起きあがりました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云いながら、又ゲラゲラゲラッと笑って、これも楽屋へはいって行きました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲラゲラゲラと崩れるように」　またも月子の声がした。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると怪物の一団は、ゲラゲラゲラと笑いだしたように思った。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲラゲラ、ゲラゲラゲラ！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲラゲラゲラ、ゲラゲラゲラ、そこでな、一つ頼みがある」「そう来るだろうと思っていた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつのまにここへ登っていたか、或いは三人が来る以前に、その岩蔭で昼寝でもしていたのか、とにかく、三人が意気込んで、右のところまで談論を続けて来た時分に、突然、途方もなく締りのない声でゲラゲラゲラと笑い出したものです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に最前から我慢していた中番頭も手代も小僧たちも、果ては次郎吉までがいっしょになってゲラゲラゲラゲラ笑いだした。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　すさまじい雷火の焔が、パッと立ったせつな、ゲラゲラゲラと十字架のかげで大きく笑う声がした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
