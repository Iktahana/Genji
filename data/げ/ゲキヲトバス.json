        "examples": {
          "standard": [
            {
              "text": "主将は練習に身が入らない部員たちに檄を飛ばし、意識を改革させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "監督はベンチから「まだ終わってないぞ！」と選手たちに檄を飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "倒産寸前の会社を立て直すべく、新社長は社員全員に檄を飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "第三に従兄のところへ檄を飛ばす。",
              "citation": {
                "source": "恩師",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "盟国の仇として旗幟をかかげるとせんか、その名分は諸侯へ檄を飛ばすに足る。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            },
            {
