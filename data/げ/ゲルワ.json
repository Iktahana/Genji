        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「マサカソレニハ及バンサ」「イヽワヨ、飲マセタゲルワヨ」彼女ガ薬ヲ取リニ出テ行ッタ間ニ、予ハ又一ツノ楽シミヲ考エツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、オ気ノ毒ネ、アタシハ行ッテ参リマス、アトデ話シタゲルワ」ソウ云ッテ颯子ハサッサト出テ行ッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナラ用ヲサセタゲルワ」シャワーノ音ガ止マッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ接吻サセタゲルワ」シャワーノ音ガ止ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャント今夜ハ佐々木サンノ代理ヲシテ上ゲルワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
