        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "このやうにプラトンは世界を、イデアの世界とゲネシス（生成）の世界との二つに分ち（いはゆる二世界説 Zweiweltentheorie）、知識と意見とを兩者にそれぞれ一義的に屬せしめ、更に人間における二つの活動、理性と感性とをまたこれらのものにそれぞれ一義的に屬せしめた。",
              "citation": {
                "source": "認識論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "プラトンはイデアの世界とゲネシスの世界とを區別した。",
              "citation": {
                "source": "認識論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は現實をそれの生成の道に於て、ゲネシスに於て把握しない。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
