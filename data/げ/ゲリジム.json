        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "此れこそゲリジム山、昔サマリヤ人のエルサレムに対抗して神を拝せし跡、今山頂の建物は回教徒遥拝所なり、と案内者は説明す。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝに谷は三叉をなし、街道はゲリジム山麓を西に折れてナブルスの邑に到る。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭上には「此山」ゲリジムの山聳ふ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "南はゲリジム山、北はエバル山に挟まれたる谷なり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲリジムの山頂には古き建物の跡多く、エバルの山には一面に覇王樹茂れり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはモーセの五書以外には聖書を認めず、またユダヤ人がエルサレムの宮にて礼拝するに対し、彼らはゲリジムの山にてエホバを祭った。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
