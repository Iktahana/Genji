        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "バットやチェリーやエアシップは月並みだと思ったが、しかし、ゲルベゾルテやキャメルやコスモスは高すぎた。",
              "citation": {
                "source": "中毒",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中には口紅で赤く染ったゲルベゾルテの吸殻が三本転がっている。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはドス黒い、ゲルベゾルテとは似ても似つかぬ、明かに下等な巻煙草の灰である。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、「済みませんけど、一本下さい」と、ゲルベゾルテを一本貰って火を点じた。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
