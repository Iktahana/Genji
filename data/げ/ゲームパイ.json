          "literary": [
            {
              "text": "パイの話のついでに、最近、新橋のアマンド（喫茶でなく、洋食の店の方）で、久しぶりで、ゲームパイを食ったことを報告しよう。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハムエグスのジェリーとゲームパイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤山一郎とホテ・グリへ行き、オニグラ、カネロニー、ゲームパイ、コーヒー。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
