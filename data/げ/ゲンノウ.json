  {
    "uuid": "8413528b-6e8c-550f-aeb7-94e0a2119d86",
    "entry": "ゲンノウ",
    "reading": {
      "primary": "げんのう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そんなに俺んちが憎ければ、なんで、へえ、おおつぴらに俺とこさやつて来て、この頭あ、ゲンノウでもつて叩き割らねえ？",
