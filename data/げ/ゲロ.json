    "definitions": [
      {
        "index": 1,
        "gloss": "vomit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "二日酔いで、朝からゲロを吐きそうだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "乗り物酔いで気持ち悪くなり、思わずゲロが出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "飲みすぎには注意しないと、後でゲロと戦うことになるよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "夏の暑い日には、よく、カゲロウが、この木のこずえのまわりを、とびまわります。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲロウは、いかにも楽しそうに、ふわふわダンスを踊ります。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、そのたびに、カゲロウは言いました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、カゲロウは言いました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、かぞえかたが、ちがうだけですもの」　こう言うとカゲロウは、また、空にはねあがって、ダンスをしました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲロウは、まるで、ビロードと、しゃでできているような、自分のうすい、きれいな羽を、うれしく思いました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり、においが強いので、カゲロウは、なんだか、ちょっと酔ったような気がしました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲロウは、昼のあいだの、いろいろな楽しみのために、ぐったりと、つかれを感じました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲロウは、ゆれている、やわらかな草のくきの上に、そっととまりました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、カゲロウは死んだのです。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かわいそうになあ、小さなカゲロウさん！",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっというまの、みじかい命だったねえ」　夏のあいだじゅう、くる日も、くる日も、カゲロウは、同じダンスをしました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、カゲロウは、いつも、同じ眠りにつくのでした。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "親のカゲロウも、子供のカゲロウも、孫のカゲロウも、みんな、同じことをくりかえしました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのカゲロウも、同じように幸福で、同じように楽しんでいました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゲロウは、ダンスをしています。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "この木の、三百六十五年という一生は、カゲロウにとっての一日と、同じことでした。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドタリと音を立てて草の上にたおれると、すぐに両手を突張って起き上ろうとしたが、そのまま全身を綟じらしてゲロゲロ、ゲロゲロと白いものを嘔き始めた。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この下僚は、少しも楽しみだと思っていないし、実際その放送の夜には、カストリという奇妙な酒を、へんな屋台で飲み、ちょうど街頭討論放送の時刻に、さかんにげえげえゲロを吐いている。",
              "citation": {
                "source": "家庭の幸福",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの横丁へ来て、料理屋の間にはさまった間口の狭い格子づくりのしもた家の前を通るたびに、よしんば酔漢のわめき声や女の嬌声や汚いゲロや立小便に悩まされても、一度はこんな家に住んでみたいと思うのであった。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はあの、所謂上流サロンの鼻持ちならないお上品さには、ゲロが出そうで、一刻も我慢できなくなっていますし、また、あのおえらがたとか、お歴々とか称せられている人たちも、僕のお行儀の悪さに呆れてすぐさま放逐するでしょう。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "○（ゲロン　ゲロン　ダダ　プップッ）やあ大変○（ババン）うわーい　破裂したい○ニャンちやん　ニャンちやんおや気｜絶してゐる○よし　一つ活を入れてやれ（ポン）ウーム……○あ！",
              "citation": {
                "source": "小熊秀雄全集−22",
                "author": "火星探検―漫画台本",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "confessing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
