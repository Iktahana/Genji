    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かへつて、エゲツナイところに、この作家の強みがあるのではあるまいかと思つたくらゐであつた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女に対して常に自信満々の田島ともあろう者が、こんな乱暴な恥知らずの、エゲツない攻略の仕方を考えつくとは、よっぽど、かれ、どうかしている。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い路地を這入ったところにある見るからに不景気そうな家で、青い花電気のさしている見世窓のガラスへ弓形にローマ字でカフェ・マンゲツとしるしてあった。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "（マンゲツ……満月と云う意味かしら）　と井深君はそんな事を思い乍ら雪をはらって其処の二階へ上がった。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それから二人はその家をカフェ・マンゲツを出た。",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "棚には葡萄酒やら苺水やらラムネの瓶やら、空罎にペーパだけ張ツた、罐やらが二三十本も並べてあツて、店頭には古ゲツトを掛けた床几の三ツも出してあツた。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は彼がゲツチンゲンで修業してゐる頃で、年歯にすると二十二三の時の事である。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアゲテ　ヰタ　イシコロヲ、ポーント　ムカウノ　キニ　ナゲツケテ、マタ　コヒツジヲ　フトコロニ　イレ、スイタ　オナカヲ　オサヘナガラ　一ツノ　ムラヘ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カハノ　キシニハ　ハンノキガ　シゲツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてはつと気が注いて後を見ると、※間に懸つたゲツセマネの基督は吃驚したやうに顫へて居た。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ゲツゲツと喉を鳴しながら彼は、顔を顰めた。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、去年あたりから酒を飲み過す日ばかりを続けて来たので、いくらか胃を痛めてゐるらしく、常にゲツゲツと生唾気を吐いたり、異様に喧ましい咳を発するやうになつてゐた。",
              "citation": {
                "source": "「或る日の運動」の続き",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は左の手の平で胸板を撫でたり、「ゲツ、ゲツ、ああ苦しい！",
              "citation": {
                "source": "僕の運動",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘリオトロープ、ヴアイオレツト、ムゲツト、……一つ一つみつ子はレツテルの横文字を読んで見た。",
              "citation": {
                "source": "香水の虹",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "青白い月光に、片頬丈ゲツソリとこけたのが、透き通る様に見える。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきから、開いたまゝの窓の処を見てゐると、ボヤツと見えるのは、今のゲツソリ頬のこけた人の顔だしかも半面鮮血淋漓、ゾツとして眼をしばたゝくと、窓は矢つ張りあいたまゝで、斜に、月の光が画の様。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "法螺忠は何か一言云ふと、あははと馬のやうに大きな黄色の歯をむき出して笑ひ、それに伴れてゲーツ、ゲーツと腹の底から込みあげる蒸気のやうなゲツプを遠慮会釈もなく放出して「どうも胃酸過多のやうだ。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲（蛙）は両腕を左右にひろげ、ゲツコゲツコと蛙の啼声をしながらピヨンピヨンと跳ね跳ね、乙（蛙ではない方）を追ひます。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ゲツセマネの橄欖はゴルゴタの十字架よりも悲壮である。",
              "citation": {
                "source": "西方の人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンゲツスエマデニタイイン。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゲツセマネの橄欖はゴルゴタの十字架よりも悲壯である。",
              "citation": {
                "source": "芥川龍之介論",
                "author": "――藝術家としての彼を論ず――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて姉の君を訪れてみれば、こは又意外、かのエゲツなきヤミ屋の奴めが社長とくる。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手をじらしたり、イヤがらせたり、皮肉ったり、つまり宮本武蔵の剣法のコツをみんな心得ていて、ずいぶんエゲツないことをやる。",
              "citation": {
                "source": "文人囲碁会",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来が保守的な性癖で事を好まぬ家康で、狸どころか番犬のやうな気の良いところもあるのだが、ええママヨとふてくされて齧りつくと忽ち狂犬の如くになつたので、アラレもなくエゲツないやり口が寧ろ家康の初々しさを表してゐると見てもよい。",
              "citation": {
                "source": "家康",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "流行のコゲツキという奴、どこも同じ風ですなア。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
