  {
    "uuid": "131d0a47-acc2-5047-8a44-06476fcb14b4",
    "entry": "ゲツ",
    "reading": {
      "primary": "げつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
