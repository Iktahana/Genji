[
  {
    "uuid": "811650c2-e4fe-509f-b444-aea51af8ee4c",
    "entry": "げえ",
    "reading": {
      "primary": "げえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
