        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "葵の一種のゲラニヤが真紅の花をもり咲かせた夕暮の美しさは、河波の上に迫って来る薄明の思いにもさし映り、梶はふと過ぎて来た空が慕わしく、胸に溢れて来るのを感じた。",
              "citation": {
                "source": "罌粟の中",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "踊子の口に銜えたゲラニヤの花が、皮膚の中から咲き出しながら、踊る襞の間を真紅になって流れていった。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝が頭に触れそうに垂れているリンデンの街路樹、葉の間を真直に伸びている砥のような路、建物の窓々には真紅のゲラニヤの花が咲き列っている。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今もなおゲラニヤの花の咲き競っている風景はカイゼルの名残である。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
