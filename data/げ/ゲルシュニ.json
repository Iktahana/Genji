        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そろそろ、なまずが煮えたぜ」　小皿に自分がさきに取って、「ロシアのテロリストと言えば、ゲルシュニの話を斎田さんはしなかったか」「俺が聞いたのは、もっぱら支那革命の話だ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲルシュニと斎田さんと、どんな関係があるんだ」　ゲルシュニはロシアのテロリストの偉大な指導者である。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「斎田さんはゲルシュニに会ってるんだ」　事もなげに砂馬が言うのに、え？",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺も斎田さんからその話を聞いたときは、たまげたな」　脱獄したゲルシュニはウラジオストークへ逃げのびて、そこで船に乗って日本へ潜入し、そしてアメリカへ渡った。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゲルシュニが日本へ来たときは、孫文もちょうど日本にいて、この二人を梶川悲堂なんかがこっそり会わせたんだ。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゲルシュニ……か」　酔った俺は、げっぷみたいにくりかえし、これをつぶやいていた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゲルシュニ……か」　名は聞いていたが、もちろん本人に会ったことはない。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのゲルシュニを思え。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "「戦闘団」というのはＳ・Ｒ党（社会革命党）の別働隊として、かのゲルシュニがつくったテロリスト組織である。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
