        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十六世紀のバイエルン人、ウルリッヒ・シュミットの『ラプラタ征服記』のドミンゲズの英訳四三頁に当時のドイツ人信じたは、、井中にあるを殺すには、鏡を示して自らその顔の獰悪なるに懼れ死にせしむるほかの手なしと。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ヲ害シテ私ヲ利スルノ義ニモ非ラズ、唯心身ノ働ヲ逞シテ、人々互ニ相妨ゲズ、以テ一身ノ幸福ヲ致スヲ云フナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の間敢て霜にも雪にもメゲズ平たく地面にへばりついてその深く羽裂せる根生葉を四方に拡げ、日当りのよい処に生えている者は暗褐色を呈しているが日蔭げの場処に在る者は緑色である。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春日明神ニ祈念シテ、何処ヘモ逃ゲズ、タダ運命ヲマカスノミ）　と誌しているほどであるから、京都の市民が、かつての平家が都落ちの時のように、また、木曾義仲が乱暴を働いたように、義経の兵も、存分な狼藉を働いて行くであろうと、怖れ顫いていた。",
              "citation": {
                "source": "日本名婦伝",
                "author": "静御前",
                "note": "青空文庫"
              }
            },
            {
              "text": "――魏宮ノ上、雲ハ憂イニ閉ジ、殿裡ノ香煙、朝ヲ告ゲズ、日モ夜モ祭ヲナシテ、哭ク声タダ大イニ震ウ　とある古書の記述もあながち誇張ではなかったに違いない。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
