        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三月九日（金曜）　今日は、ビクトーリア・ゲンリホブナと家を見に行く。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月二十八日（水曜）　ビクトリア・ゲンリホブナの稽古三月二十九日（木曜）　ビクトリア・ゲンリホブナ病気なり。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ曰く「大分居るよ、これは」四月二日（月曜）　ビクトリア・ゲンリホブナのところへ行く。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月四日（水曜）　モヤ、夜ビクトリア・ゲンリホブナのところ、ノボさんが稽古をして呉れる由。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、エリセーフへよって、ビクトリア・ゲンリホブナの見舞、夢の話をきいた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙがしまいかけたときベルがなってビクトリア・ゲンリホブナが来た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
