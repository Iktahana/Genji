        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海外からの賓客をもてなすため、赤坂の一流料亭に芸者を呼ぶことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は芸者としてのプライドを持ち、立ち居振る舞いから言葉遣いまで一切妥協しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お座敷での芸者の役割は、単に芸を見せるだけでなく客同士の会話を円滑にすることだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "芸者屋をしている表店と彼女の住っている裏の蔵附の座敷とは隔離してしまって、しもたや風の出入口を別に露地から表通りへつけるように造作したのも、その現われの一つであるし、遠縁の子供を貰って、養女にして女学校へ通わせたのもその現われの一つである。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸者というものは、調法ナイフのようなもので、これと云って特別によく利くこともいらないが、大概なことに間に合うものだけは持っていなければならない。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "快活で事もなげな青年で、家の中を見廻しながら「芸者屋にしちゃあ、三味線がないなあ」などと云った。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いき」を若い芸者に見るよりはむしろ年増の芸者に見出すことの多いのはおそらくこの理由によるものであろう｛１｝。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷風は『歓楽』の中で、「其の土地では一口に姐さんで通るかと思ふ年頃の渋いつくりの女」に出逢って、その女が十年前に自分と死のうと約束した小菊という芸者であったことを述べている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸の遊女や芸者が「婀娜」といって貴んだのも薄化粧のことである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜田川守貞の『近世風俗志』に「首筋に白粉ぬること一本足と号つて、際立たす」といい、また特に遊女、町芸者の白粉について「頸は極て濃粧す」といっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「素足も、野暮な足袋ほしき、寒さもつらや」といいながら、江戸芸者は冬も素足を習とした。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルベール・メーボンはその著『日本の演劇』のうちで、日本の芸者が「装飾的および叙述的身振に巧妙である」ことを語った後に、日本の舞踊に関して次のようにいっている。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "年若い芸者を二人連れた若旦那の一組がコーヒーをのんでいる。",
              "citation": {
                "source": "千人針",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の芸者はそれぞれ一つずつ千人針の布片を手にもったままで女学生と何かしら問答している。",
              "citation": {
                "source": "千人針",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「否エ妾になれって明白とは言わないけれど、妾々ッて世間で大変悪く言うが芸者なんかと比較ると幾何いいか知れない、一人の男を旦那にするのだからって……まあ何という言葉でしょう……私は口惜くって堪りませんでしたの。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの演芸の声だけでなくて演芸者自身がその声にくっついて忽然として自分の家庭に侵入して来るように感じる。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は自分のあとを嗣がせるつもりで、子供のときから一生懸命に長唄を仕込んだが、お俊は肩揚げの下りないうちから男狂いをはじめて、母をさんざん泣かせた挙句に、深川の実家を飛び出して、上州から信州越後を旅芸者でながれ渡って、二、三年前に久し振りで江戸に帰ってくると、深川の母はもう死んでいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "合気の術は剣客武芸者等の我が神威を以て敵の意気を摧くので、鍛錬した我が気の冴を微妙の機によって敵に徹するのである。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、さすがは　うでの　ある　ぶげいしゃです。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは新町の花むらの内芸妓で小笛という者です」「な、なに」勘太夫は身ぶるいをした、「げいしゃ、芸妓だと」「芸妓は芸妓ですが」直二郎はそろそろ脇のほうへ身をずらし始める、「もとは武士の生れで性質もよろしく、気も凛として」「こいつ、待て」　勘太夫はいきなり掴みかかった。",
              "citation": {
                "source": "明暗嫁問答",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその階級の低いものは、無智な貧しい人人と共に、裏街の家の小さな神棚や、農家の暗い祭壇や、僅かばかりの小資本で、ささやかな物を賣つて生計してゐるところの、町町の隅の駄菓子屋、飲食店、待合、藝者屋などの神棚で、いつも侘しげに生活してゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして都會の狹い露路裏に、稻荷の鳥居をくぐる藝者等は、彼等の弗箱である客や旦那等が、もつと足繁く通ふやうに乞うてるのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその階級の低いものは、無智な貧しい人人と共に、裏街の家の小さな神棚や、農家の暗い祭壇や、僅かばかりの小資本で、ささやかな物を賣つて生計してゐるところの、町町の隅の駄菓子屋、飮食店、待合、藝者屋などの神棚で、いつも侘しげに生活してゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の父は、うちで何か饗應があると必ず、遠い大きなまちからはるばる藝者を呼んで、私も五つ六つの頃から、そんな藝者たちに抱かれたりした記憶があつて、「むかしむかしそのむかし」だの「あれは紀のくにみかんぶね」だのの唄や踊りを覺えてゐるのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "○○百貨店○○支店の一行は和服が多く、此方は藝者を揚げて三絃の音を響かせて居るが、肝心の本職の藝者の歌謠の節※はしが大分危なつかしく、寧ろ御客の中に一人いゝ聲を出すのが居て、それがやゝもすると外れかゝる調子を引戻して居るのは面白い。",
              "citation": {
                "source": "伊香保",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先づ四馬路の菜館で廣東料理に舌皷を打ち、或る外國人のバアでリキユウルをすすり、日本料理屋で藝者達の長崎辯を聞き、更にフランス租界の秘密な阿片窟で阿片まで吸つてみた。",
              "citation": {
                "source": "麻雀を語る",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の呼び賣りの出現から腕無し藝者の妻吉の話が出る。",
              "citation": {
                "source": "日曜日から日曜日まで",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論、藝者の感じではなかつた。",
              "citation": {
                "source": "女盗",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、もうその時分から夫の彼女に對する愛情は冷えてしまつて、藝者狂ひは始めるし、家では姑にいびられて、とどのつまりが離縁と云ふのさ。",
              "citation": {
                "source": "Ｓ中尉の話",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで藝者は、娼妓は？",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "細木香以に就いては、森鴎外くはしくこれを述べて居る故、われら小倉袴のぶんを以てかれこれ言ふべきではないが、通人とは、世人が考へて居られる如き、藝者末社をひきつれ、自らを何のや主人と稱して長唄の稽古にいそしみ、その巷に於いて兄さん兄さんと呼ばれて居る樣の、そんなふざけたものではないやうである。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、生れて三十何年以上にもなる讀者だけが、ああ、あの松か、と藝者遊びの記憶なんかと一緒にぼんやり思ひ出して、つまらなさうな顏をするくらゐが關の山であらうか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、葛原勾當日記の、假名文字活字日誌を土臺にして、それに私の濁創も勝手に加味し、盲人一流藝者の生活を、おぼつかなく展開してみたものでした。",
              "citation": {
                "source": "文盲自嘲",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
