        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大ジョッキとフライビンズを註文し、息の根の停りさうな苦しさを我慢しながら、三分の一ばかり飲んで、ゲエーとおくびを出して、フーフー赧い顔で唸つてゐると、いきなり耳を引つ張られた。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちなみに、ハイフンは「積極的反対票」、つまり、「ひっでえ曲、ゲエー」ということ）。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "：入力者注　主に外字の説明や、傍点の位置の指定（例）なる口-------------------------------------------------------　　　上　ゲエープツ、ああ酔つたぞ酔つたぞ真実に好い心持に酔つて。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬶が怒らうが、小児が泣かうがサ、ハハハハゲエープツ、ああ好い心持だ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
