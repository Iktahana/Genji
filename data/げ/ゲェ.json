        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たとえば、すでに三十近かった、ぼく達のキャプテン整調の森さんでさえ、出発の二三日前、あるいかがわしい場処へ、デレゲェション・バッジを落してきたのです。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの豹変を表現するために材料となったものは、即ちシットリン、トロツキー・メルシェ、イヴォン、ヴィクトオル・セルデ、ルゲェ、ルドルフ其の他の諸家の研究だ。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲェテの「ファウスト」は、やはり、巨大な文学的狼火に応はしい響きをもち、トルストイの「戦争と平和」は、功利文学のトツプを切る題名と称すべきだ。",
              "citation": {
                "source": "標題のつけ方",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャベだのアンニャだのシッペタだのゲェルマッチョ（蛙のこと）などという下賤な言葉は禁止される。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "花天狗流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……あれ、ピゲェの一九三八年の｜変り型よ。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コテイの｜袖無しに、ピゲェのだぶだぶズボン。",
              "citation": {
                "source": "キャラコさん",
                "author": "海の刷画",
                "note": "青空文庫"
              }
            },
            {
              "text": "柴田　うむ、どうも――なんだ、（もう一つゲェと言って、ツバを吐く）いや、なんでもない。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花岡　だからさ――村子　ゲェ！",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "啓蒙時代のこの力強い思想は恐らくかれの一生涯を養つてゐたのだらうが、かれは不幸にしてゲェテのやうに生物学上の発明をせずに世を終らねばならない。",
              "citation": {
                "source": "鴎外を語る",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
