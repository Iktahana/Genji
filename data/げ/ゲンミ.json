          "literary": [
            {
              "text": "つまり、材料の原味そのものの話である。",
              "citation": {
                "source": "材料か料理か",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "原料の原味を殺すな　原料の原味を殺さないのが料理のコツのひとつであります。",
              "citation": {
                "source": "日本料理の基礎観念",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "材料の精選とともに材料の原味を殺さぬこと、その味というものは、科学や人為では出来ないものでありますから、それを貴ぶのであります。",
              "citation": {
                "source": "日本料理の基礎観念",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
