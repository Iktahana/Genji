[
  {
    "uuid": "0b2de67e-ce41-55c9-af54-a6af99dabd19",
    "entry": "下卑",
    "reading": {
      "primary": "げび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
