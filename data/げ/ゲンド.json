[
  {
    "uuid": "1ce63811-180b-5081-ad05-0ab4b84f28ec",
    "entry": "限度",
    "reading": {
      "primary": "げんど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "limit",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "もうこれ以上は私の忍耐の限度だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "アルコール摂取は一日の限度を守りましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のわがままも、そろそろ限度を超えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ことに今年は実際に小春の好晴がつづき、その上にこの界隈の銀杏の黄葉が丁度その最大限度の輝きをもって輝く時期に際会したために、その銀杏の黄金色に対比された青空の色が一層美しく見えたのかもしれない。",
              "citation": {
                "source": "初冬の日記から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、一体そういう自由がこの世に有り得るものか、どの程度までそれが可能であるか、またその可能限度まで自由を許すことが、当該学者以外の多数の人間にとって果していつでも望ましい事であるか。",
              "citation": {
                "source": "学問の自由",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "栗本は、出された甲のすべっこい、小さい手を最大限度に力を入れて握ったと見せるために、息の根を止め、大便が出る位いきばった。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の家屋が木造を主として発達した第一の理由はもちろん至るところに繁茂した良材の得やすいためであろう、そうして頻繁な地震や台風の襲来に耐えるために平家造りか、せいぜい二階建てが限度となったものであろう。",
              "citation": {
                "source": "日本人の自然観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして多くの草の全体重と花だけの総体重との比率にはおおよそ最高最低限度がありそうな気がしてこれも何かわれわれのまだ知らない科学的な方則で規定されているのではないかという気がするのである。",
              "citation": {
                "source": "高原",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どこの部隊だって、兵タイにゃ、最大限度の馬力をかけさしているんじゃないか？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、機関銃のつつさきを最大限度に空の方へねじ向けた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "波長がこの範囲にあってもその運ぶエネルギーが一定の限度以上でなければ感じる事ができない。",
              "citation": {
                "source": "物理学と感覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "振幅が一定の限度以下でも同様である。",
              "citation": {
                "source": "物理学と感覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　身長と寿命　地震研究所のＩ博士が近ごろ地震に対しての人体感覚の限度に関する研究の結果を発表した。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの根気くらべのような競技は、およそ無意味なようでもあるが、しかし人間の気力体力の可能限度に関する考査上のデータにはなりうるであろう。",
              "citation": {
                "source": "記録狂時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "忍ぶことにも限度が在る。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互ひに相手の神經へふれまいふれまいと最大限度の注意をしつつ、おのれの神經をも大切にかばつてゐる。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡瀬は蓄音機の機械をどれだけ複雑にすれば、最小限度の複雑化によって最大の効果を挙げうるかを数理的に解決したかったのだ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で力み出す力には、自ずと限度があります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋愛は、男女対等の立場に置かれて、しかも異性としての特長がある限度までは相反する方が却って両者の愛は増すのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし人間の脳力には限度がありまして、嫉妬とか邪推とかの方面にばかり鋭くはなりますが他の方面は無力になり、意志力なども弱くなって、前後の見境いなく騒ぎ出したり、急に陽気になって笑い出したり、先刻までひどく嫌っていた人を急に好きになったりします。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "差別にも平等にも、自ずからそれ相当の価値と限度があって、病に対する対症療法のようなものです。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり人間のすることには限度がある。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃんと、狂い方の限度――というか、型の中で狂っていますよ。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いくら長いといっても、限度はある。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "告白の限度という事にも言及しました。",
              "citation": {
                "source": "みみずく通信",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る程度の地位も得た、名声さえも得たようだ、得てみたら、つまらない、なんでもないものだ、日々の暮しに困らぬ程の財産もできた、自分のちからの限度もわかって来た、まあ、こんなところかな？",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の事情は語らない母親も「お罪障消滅のため寺方に上った身が、食べ慾ぐらい断ち切れんで、ほんまに済まんと思うが、やっぱりお罪障の残りがあるかして、こればかりはしようもない」この述懐だけは亦ときどき口に洩しながら、最小限度のつもりにしろ、食べもの漁りはやめなかった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵野のことは委しかったが、それにも限度があった。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の力の限度を知り、あきらめて、謙譲に学ぶ事。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきおい、自分の力の限度以上の事を、うかと引き受け、酔いが醒めて蒼くなって後悔しても、もう及ばぬ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "送金の限度に就いて言うのを忘れたが、あ、散策の必要も言い忘れたが、まあ、また後で手紙で言ってやる事にしよう。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十七八歳を限度として、それよりわかい青年、すべて、口にいわれぬ、人知れない苦しみをなめているのだ。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかのにんげんどうよう、きみは自由だよ。",
              "citation": {
                "source": "影",
                "author": "SKYGGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
