    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "層雲四月号所載、井師が扉の言葉『落ちる』を読んで思ひついたが――落ちるがまゝに落ちるのにも三種ある、一はナゲヤリ（捨鉢気分）二はアキラメ（消極的安心）三はサトリ（自性徹見）である。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはアキラメでもなければナゲヤリでもない、むろんサトリでもない、いわば、老のオチツキでもあろうか。",
              "citation": {
                "source": "三八九雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが急にナゲヤリな気を出し、仕事をなまけ初めたので、私も実は不思議に思っていたのですが、すると間もなくあんな大事をやってしまったんです。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「これ、ペラゲヤや！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば五等官夫人のチェフタリョワだの、佐官夫人のペラゲヤ・グリゴーリエヴナ・ポドトチナだのといったあんばいに……。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは木曜日にはいつも、五等官夫人チェフタリョワのところへ行きますし、佐官夫人ペラゲヤ・グリゴーリエヴナ・ポドトチナだの、その娘さんで、とても綺麗な令嬢だのも、やはり非常に懇意な知り合いなんですからねえ。",
              "citation": {
                "source": "鼻",
                "author": "ニコライ・ゴーゴリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウャトカ県のピョートル・ワルソノフィエヴィッチの家でも話したが、そこには彼の許嫁の妹のペラゲヤ・エゴーロヴナと、姪のソフィヤ・ロスチスラーヴナヤと、その腹異いの姉妹であるソフィヤ・アレクサンドロヴナとマクラトゥーラ・アレクサンドロヴナがいたのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "（九月八日）百二十○雑誌『ホトトギス』第五巻第十号東京俳句界の中に茂山の雫や凝りて鮎となり　　　　耕村といふ句を碧梧桐が評したる末に「かつ茂山をシゲヤマと読ますこと如何にも窮せずや」とあり。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "レーニンの指導する社会民主労働党のロンドン会議に出席したりしたゴーリキイは、感激をもってロシアの労働運動の広汎、複雑な発展の過程を描写しようとし、革命的な労働者ウラソフの闘争と息子の生活につれての母ベラゲヤの社会に対する目のひらかれて来る過程を中心に置いた。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーリキイはベラゲヤをネロ時代キリスト教殉教者のように描いた。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五坪の應接は、俗に“ゲヤ”と田舍でいふ屋根裏じかのいはゆる下屋である。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
