[
  {
    "uuid": "5adc31c5-fa3e-596f-9ff3-125479a56605",
    "entry": "下野",
    "reading": {
      "primary": "げや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "resigning from (public) office",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年続いた汚職事件の責任を取り、彼はついに政治の世界から身を引いて下野することを決意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "引退して下野した後は、田舎で趣味の園芸を楽しみながら、静かに余生を過ごしたいと考えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "野心家だった彼が、あっさりと役職を辞して下野したというニュースは、周囲を大いに驚かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ここに細川方の幕僚で丹波を領している細川｜下野守教春も、その数に洩れず、急いで国元へ引返して行きました。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍山頂に便を催おし、叢の中に男体山を眺めながら、上野と下野の国境上に真黒な塊を残す。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "足跡は常陸、磐城、上野、下野、信濃、越後の六ヶ国に亘り、行程約百五十里、旅行日数二週間内外、なるべく人跡絶えたる深山を踏破して、地理歴史以外に、変った事を見聞し、変った旅行をしてみようというのである。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "頂上には一個の石標があって、ここは常陸と下野の国境である事を示す。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで九郎兵衛に返書を齎らさしめ、守屋｜守柏、小関大学の二人を京へ遣ったが、政宗の此頃は去年大勝を得てから雄心｜勃々で、秀吉東下の事さえ無ければ、無論常陸に佐竹を屠って、上野下野と次第に斬靡けようというのだから、北条征伐に狩出されるなどは面白くなかったに相違無い。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "白河を越え、下野にかかり、遊行上人に道しるべした柳の陰に歌を詠じ、それから那須野が原へとかかった。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉妹三人の夫たる叔父甥三人は、良兼を大将にして下野を指して出発した。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "下野から南に下つて小次郎めを圧迫しようといふのだ。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何程の事かあらん、一当てあてゝやれと、此方からも下野境まで兵を出したが、如何さま敵は大軍で、地も動き草も靡くばかりの勢堂しく、掻楯ひし／＼と垣の如く築き立てゝ、勢ひ猛に壮んに見えた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵はきたなくも下野の府に閉塞されてしまつた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "良兼、護、今は父の後を襲ふた常陸大掾貞盛、良兼の子の公雅、公連、それから秦清文、此等が皆職を帯びて、武蔵、安房、上総、下総、常陸、下野諸国の武士を駆催して将門を取つて押へようとする。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレッといふので下野国へと押出した。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬は竜の如く、人は雲の如く、勇威｜凛に換へられたが、斯様いふ時になると新任者は勝手に不案内で、前任者は責任の解けたことであるから、いづれにしても不便不利であつて、下野の新司の藤原の公雅は抵抗し兼ねて印鑰を差出して降つて終つた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "古より東国には未だ曾て無い大動揺が火の如くに起つて、瞬く間に無位無官の相馬小次郎が下総常陸上野下野を席捲したのだから、感じ易い人の心が激動して、発狂状態になり、斯様なことを口走つたかとも思はれる。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀郷は下野掾で、六位に過ぎぬ。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の意味で云へば、将門の勢が浩大で、独力之を支ふることが出来無かつたから、下野掾の身ではあるが、尺蠖の一時を屈して、差当つての難を免れ、後の便宜にもとの意で将門の許を訪ふたといふのであるから、咎むべきでは無い。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "将門の弟の将頼は下野守に、上野守に常羽御厩別当多治経明を、常陸守に藤原玄茂を、上総守に興世王を、安房守に文室好立を、相模守に平将文を、伊豆守に平将武を、下総守に平将為を、それ／″＼の受領が定められた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで上野下野武蔵相模たちまちにして旧官は逐落され、新軍は勢を得たのかと想像される。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄明等大敗して、下野下総｜界より退いた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は下野軍が風の利を得た。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "天平神護二年六月には、大隅国神造新島、弘仁九年七月には、相模、武蔵、下総、常陸、上野、下野の諸国、天長七年一月には、出羽に地震があった。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶安には元年四月に相模、武蔵、山城、同二年二月に伊予、安芸、山城、その六月に武蔵、下野、この翌月に武蔵の大地震があったが、六月の地震には江戸城の石垣が崩れ、諸大名の屋敷町屋が潰れたので、江戸の人心に動揺の兆があった。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万治二年二月には、岩代、下野、武蔵に大きな地震があった。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人はなお一気には山かげに遠ざかり兼ね、太田の町外れからバスがあるのを幸い、下野の平野を山の遠輪に沿うて横へ利根川べりの妻沼の聖天まで走らせました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うすくこく松原みえて下野や都賀山つゞき雲はれにけり　　清水瀧臣　之を過ぎて、北は透※たる群峯の迫りて、細流なほ激して走るものあり。",
              "citation": {
                "source": "草津行",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵は入り替り立ち替りで暫くも止まることは無いが下野の矢板の在から來た人が長逗留をした。",
              "citation": {
                "source": "竹の里人〔一〕",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の日、下野黒羽城主大関高増に手紙をやり、「今日箱根峠に打ち登り候。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "下野に近い片品川の上流に沿うた高原を歩いた時、その邊の桑の木は普通の樣に年々その根から刈り取ることをせず、育つがまゝに育たせた老木として置いてある事を知つた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "草鞋の話旅の話",
                "note": "青空文庫"
              }
            },
            {
              "text": "近江の佐々木社より佐々木氏、下野の宇都宮の社司より宇都宮氏、香椎・宇佐の両社領より大友氏勃興せるがごとし。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "反応を要求しない親切ならば受けてもそれほど恐ろしくないが、田舎の人の質樸さと正直さはそのような投げやりな事は許容しない。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "going out of power (of a party)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "世論の厳しい批判にさらされた与党は、総選挙で大敗を喫し、結党以来初めての下野を余儀なくされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "下野した野党として、まずは党勢の立て直しを図り、次回の選挙での政権奪還を目指さなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長きにわたる政権担当期間を経て、ついに下野することになった彼らの表情には、隠しきれない疲労が滲んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
    ],
