  {
    "uuid": "f0144560-18e9-5c6b-bfe0-9d2f89b72162",
    "entry": "ゲヤ",
    "reading": {
      "primary": "げや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
