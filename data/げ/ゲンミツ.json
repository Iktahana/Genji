    "definitions": [
      {
        "index": 1,
        "gloss": "strict",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の研究は厳密な分析に基づいており、信頼性が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生はレポートの提出期限に厳密なので、遅れないように注意が必要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この実験には厳密な温度管理が求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "私は厳密な論理に拠つた、而して最後に、最初見た神を見た。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳密に云へば、テーマとその発展も同時的存在である。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "（此処らをもつと厳密な言葉で書くに書けないこともないが、私は読者の頭を信用したいし、徒らに侃々にもなりたくない）。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳密に云へば天才者とは、無機的要素を人間能力なるものゝあらん限りに於て見る者のことぞ。",
              "citation": {
                "source": "地上組織",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "セイラーが、乗船する時には、厳密な体格検査がある。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然現象に関する言葉でさえ既にかようであるから、まして社会の特殊な現象に関する語は他国語に意味の上での厳密なる対当者を見出すことはできない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより、客観的、主観的の別は、必ずしも厳密には立てられないむしろ便宜上の区別であるから、いわゆる客観的芸術にあっても「いき」の芸術形式が形成原理として全然存在しないことはない。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "具体性に富んだ意味は厳密には悟得の形で味会されるのである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、サンサンス、マスネエ、ドゥビュッシイ、リヒアルド・スュトラウスなどの作品中の或る旋律を捉えて厳密なる意味において「いき」と名附け得るであろうか。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし厳密な必然性ではない。",
              "citation": {
                "source": "かれいの贈物",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮りに如何に博学多識の学者を案内として名所見物をするとしても、その人の所説にはそれぞれ何か確かな根拠はあるかもしれないが、それらの根拠を一つ一つ批判的に厳密に調べてみても一点の疑いのないという場合はむしろ稀であろう。",
              "citation": {
                "source": "科学上における権威の価値と弊害",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳密なる意味において「物理的孤立系」なるものが存せず、すなわち「万物相関」という見方よりすれば、一つの現象を限定すべき原因条件の数はほとんど無限なるべし。",
              "citation": {
                "source": "自然現象の予報",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「大きさ一様なる棒」とか「平面」とか「球面」とかいうものも厳密には実現し得られない事も忘れてならない。",
              "citation": {
                "source": "物理学実験の教授について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳密に云えば孤立系（isolated system）などというものは一つの抽象に過ぎないものである。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとき履歴の影響は厳密に云えばいつまでも全くは消滅しないものと考えられる。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし厳密に云えば、かくのごとき抽象的の状況は実現する事の出来ぬものである。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは別問題として、厳密な意味において普遍的な正確な方則が可能であろうか。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷電導体内部における電場の零なる事からクーロンの方則の厳密な事を証するが常であるが、吾人の実験し得る導体の大きさに制限のある事を忘れてはなるまい。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気の抵抗や、風の横圧や、周囲の物体より起る不定な影響を除去した時に始めて厳密に適用さるべきものである。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体人の談話を聞いて正当にこれを伝えるという事は、それが精密な科学上の定理や方則でない限り、厳密に云えばほとんど不可能なほど困難な事である。",
              "citation": {
                "source": "アインシュタインの教育観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代の音韻と題しておきましたが、現今の言語研究の上に「音韻」と「音声」とを区別して使うことがございますけれども、先ずこのお話では、格別そういう厳密な区別を設けないで、ただ音韻と言っておいたので、つまり言語の音のことでございます。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　科学上の学説、ことに一人の生きているアダムとイヴの後裔たる学者の仕事としての学説に、絶対的「完全」という事が厳密な意味で望まれうる事であるかどうか。",
              "citation": {
                "source": "相対性原理側面観",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "上村海軍少佐の懇切なる教示と、嚴密なる校閲とを受けたるは、啻に著者の幸福のみにはあらず、讀者諸君若し此書によりて、幾分にても、海上の智識を得らるゝあらば、そは全く少佐の賜なり。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の眞理とは嚴密な科學的方法によつて到達し得たものではないぢやないか。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三に至つて作者は再び嚴密に自己に立還つて來た。",
              "citation": {
                "source": "水野仙子氏の作品について",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚がどんな惡いことをしたのか知らないが、天網の恢々を漁網の嚴密なのに持つて行つて、漁業家の主人を世俗的に喜ばせた筆者の氣轉が思ひやられる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "嚴密に云へば、この一ヶ年半ばかりを、自分を苦しめたりまた自分の利益になつたりしたところの憑き物が、今や落ちてしまつたのだと思へた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "耶蘇は『女を見て色情を起したるものは、その心既に姦淫したるなり』と云つたが、スヰデンボルグはこの意から推して、最も極端に、又最も嚴密に、善惡の區畫をつけたのである。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃、渠等の口吻を眞似て、理想とか向上主義とか※ぶものが多い，然し、これは最も善を僞はるもの等で、僞善者の最下級である、道學的根性の最も嚴密に墮落した標本である。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しその尊重を逆に將來に向つてまで維持しようとして一切の「驚くべき事」に手を以て蓋をする時、其保守的な概念を嚴密に究明して來たならば、日本が嘗て議會を開いた事からが先ず國體に牴觸する譯になりはしないだらうか。",
              "citation": {
                "source": "歌のいろ／＼",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
