[
  {
    "uuid": "50bcf6d5-1f0d-57cd-889d-f27af0efaec2",
    "entry": "月下",
    "reading": {
      "primary": "げっか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
