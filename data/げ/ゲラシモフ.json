        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゲラシモフ（プロレタリアートの詩人）ニキーチナ夫人のところで会う。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、モヤ私のために、ベラ・イムベルのエボージボートヌイを読んでくれ、ニキーチナ夫人の本から、ヤコブレフ、ゲラシモフの伝を読んでくれた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲラシモフは全生活を革命的生活にすごして来たが、ヤコブレフは農民出のインテリゲンチャで苦しみがあるらしい。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニキーチナ夫人の店へよって、ゲラシモフの詩集 1924 出版と、ノビコフ・プリボーイの短篇集を買った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだよくないよし、ゲラシモフが出て来た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　○ゲラシモフが居た。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
