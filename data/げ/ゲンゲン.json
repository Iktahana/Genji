      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それほど私はあのお便りの言々句々が好きなのである。",
              "citation": {
                "source": "散華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "後生だから早く勉強して、りっぱな人物になってくださいよう」　その音柔媚なれども言々風霜を挟みて、凛たり、烈たり。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　兒玉の言々句々、肺腑より出で、其顏には熱誠の色動いて居るのを見て、人々は流石に耳を傾むけて謹聽するやうになつた。",
              "citation": {
                "source": "日の出",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年の一言々々は、美奈子のこじれかからうとした胸を春風のやうに、撫でさするのであつた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "（後略）　言々誠意の溢れるのを見る事が出来る。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "青年の一言々々は、美奈子のこじれかかろうとした胸を春風のように、撫でさするのであった。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の百姓達は、坊さんの云ふ一言々々に、「南無阿彌陀」を云つて、ガサ／＼した厚い、ひびのよつてゐる掌でじゆずをならした。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉が齒からもれて、一言々々の間に、シツ、シツといふ音が入つた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "判事の云う一言々々に句読点でも打ってゆくように、ハ、ハア、ハッ、と云って、その度に頭をさげた。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の眼は涙ぐんで、一言々々に昔を思い出す様子だった。",
              "citation": {
                "source": "夏の夜の冒険",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "且つ倉庫を開いて天下の急を救へなど、言々肺腑より出でたり。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "読みあげる言々句々は状景となって動いていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一転して仙道の話となるや、木食仙人の独擅場で、言々句々精彩を発し、わけても延命術、尺地術、吸気術、飛天術、断食待饑術に至っては、微細に渡ったものである。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞き澄ましていた範之丞は、熱を持った熊太郎の言々句々に、若い、純な、血に燃え易い心を、燃やしたかぶらせ膝進ませたが、「その陰謀と仰せられるは？",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しながら後に彼が獄中に於てものした日記や、神戸牧師其他に訴えた手紙を読むと、言々血を吐く如く、鬼気迫って遂に読み下し得ないものがある。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代では、作者の企図だとか、役者の間の伝来とかで、自ら狂言々々の主役以下の役割はきまつて居る。",
              "citation": {
                "source": "雑感",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻の一言々々は毒を含んでいて、しかも彼女はどこがわたしの最も痛いところかよく心得ているので、そこを狙って刺をさすのです。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ね、つらいだろうがここはひとふンばりして、もとどおり陽気に元気にいきいきとやってくれたまえ、たのむ」　連盟の危機をうれい、富士男を鼓舞するゴルドンの言々句々は、せつせつとして胸にせまる、富士男は感激にぬれた眼をあげた。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "女主人は顔で若奴の坐している長火鉢の横を示しながら、「ようここへお園さんと二人で並んで私とこのとおりに話してはりましたがな、家でもお園さんとよう泊まりやはった」　彼女の語ることは向うではその心でなくても言々句々縦横無尽に私の肺腑を刺した。",
              "citation": {
                "source": "霜凍る宵",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は半ばその母に対する一種のなつかしさ、半ば自分に対する悔恨から、その手帳をはじめて手にとったが、それを読みはじめるや否や、私はそこに描かれている当時の少女になったようになって、やはり母の一言々々に小さな反抗を感ぜずにはいられない自分を見出した。",
              "citation": {
                "source": "楡の家",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "出来るだけの保護は必ず与へるから』　対話はこれに過ぎざりしも、言々急所を刺したればか。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛田　　（なんと返事のしやうもなく、たゞ、相手の一言々々に頭を下げてゐる）老人　　では、御免下さい。",
              "citation": {
                "source": "運を主義にまかす男",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "声も扉ごしにふと耳にしたことがありましたが、それは一言々々尾をひくやうな物静かな柔和な声音で、しかもその底に妙にはつきりした物に動じない気勢が感じられました。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "一挙一動、言々句々、ケチならざるはない。",
              "citation": {
                "source": "吝嗇神の宿",
                "author": "人生オペラ　第二回",
                "note": "青空文庫"
              }
            },
            {
              "text": "入鹿蝦夷が殺される皇極天皇の四年間だけでなく、その前代の欽明天皇の後期ごろから、何千語あるのか何方語あるのか知らないが、夥しく言葉を費して、なんとまア狂躁にみちた言々句々を重ねているのでしょうね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の年もＡ級優勝、挑戦者となり、はじめ二敗、つづく二局を二勝して二対二にもちこみ、第五局目モミヂの対局に於て、「ぼくの勝ちですよ」　言々句々に再びウヌボレが現れていたのはモミヂの女中たちすら指摘するところである。",
              "citation": {
                "source": "九段",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一言々々は葬の鐘の音のやうに響いた――「みんなのこの髷は剪つてしまはぬといかん。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、一言々々を明瞭に、穩やかに、確固たる調子で、しかし大聲ではなく續けて云つた――「それはたゞ前の結婚といふことに在るのです。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその泣き方は入念のものであって、霊柩が家を出る時から泣き始めて、死者の生前の家庭生活の内面を巧みに泣き語り、特に若い漁師が結婚後間もなく遭難した場合や、また愛児を残して永眠した場合などには、泣女の言々句々、悲痛を極めて遺族は言うまでもなく、葬列の人々をして断腸の思いあらしむると云うことである。",
              "citation": {
                "source": "本朝変態葬礼史",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロッティはセエラの方にすり寄って、一言々々に夢中になっているうち、いつの間にかもうおしまいになってしまいました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
