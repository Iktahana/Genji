          "literary": [
            {
              "text": "裸になつてゲンゲンの花の上に跳び上つた。",
              "citation": {
                "source": "檀一雄「リツ子・その死」",
                "author": "――創芸社刊――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからげんげんの賛は上ツフサ睦岡村ニ生レタル「ワラビ」ガ知ラヌゲンゲンノ花という歌、これは蕨真がげんげんの花を知らなかったので先日来た時に説明してやった事があるのである。",
              "citation": {
                "source": "病牀苦語",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンゲンの花太きたばにこしらえて自ら手に持ちたらんも、何となくめめしく恥かしくてちひさき女の童にやりたるも嬉し。",
              "citation": {
                "source": "わが幼時の美感",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲公英などちひさく黄なる花は総て心行かず、ただゲンゲンの花を類ひなき物に思へり。",
              "citation": {
                "source": "わが幼時の美感",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
