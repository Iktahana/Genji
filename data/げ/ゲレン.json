        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "六分ゲレンの一じゃからちょうど一プロの一｜瓦じゃ。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二沢のゲレンデで、私位よく、勇ましく転んだ者はないと云うことであった。",
              "citation": {
                "source": "生活",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿「夫は何うも往かぬな、併しさういふのには魔睡剤を用ゆると直に癒るて、モルヒネをな、エート一ゲレンは一｜厘六｜毛、一グラムとは一｜匁と申して三｜分ゲレンとは三｜割にして硝盃に三十｜滴が半ゲレンぢやが、見て居れ斯ういふ工合にするのだ。",
              "citation": {
                "source": "華族のお医者",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "編輯長もゲレンデに穴をあける組ですか。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際池のくるみからグライダー小屋あたりは、所謂ゲレンデーであるから女学生の滑り場であらう。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうなると、霧ヶ峯は全部ゲレンデーに相違ない。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう大観すればスキー場霧ヶ峯はゲレンデーのみではなく山スキーの霊場であつて、菅平と比肩すべきものである。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "５　コーチ・マニア　所謂ゲレンデで、斜面の中途に立ちどまり、知人、不知人の差別なく、コーチするマニア。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "６　用心マニア　いつ、どこで、雪崩にあうか分らぬからとて、赤い雪崩紐を引きずってゲレンデを上下、左右し、常に腰にショベルを下げているマニア。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一本杖、両杖半分ぐらいの時代で、とても変てこりんな漫画式のものだが、おかしなことに、現代日本の各ゲレンデで、この本にあるような変てこりんなシーロイファを、ちょいちょい見受ける。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲレンデのそれよりもはるかにのぼりやすいようだ。",
              "citation": {
                "source": "穂高岳屏風岩にて",
                "author": "早川鮎子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
