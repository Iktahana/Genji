        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "蒼白い流れはもう暴らい瀬になって、頂には、春もすでになかばを過ぎた今でも、雪に包まれてあろうハーゲン・ゲビルゲ Hagen-Gebirge と、東に横たわるテンネン・ゲビルゲ Tennen-Gebirge の谷間いを、ビショッフスホーフェンからシュワルツァッハの停車場に着いた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　ドイツとチェッコスロヴァキアの国境をなすリーゼンゲビルゲに行ったのも、思えば昔のことである。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "登ったのにリーゼンゲビルゲ（巨人山脈）中のシュネーコップフ（雪頭山）である。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "十五年ばかり前の秋、ドイツにいてリーゼンゲビルゲの麓に行き、シュネーコップフというのに登った。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『イッヒ・コンメ・フォム・ゲビルゲ・ヘル』なんて、まるで叱られてるようなもんで。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
