        "examples": {
          "standard": [
            {
              "text": "回路に過大な電流が流れないよう、限流特性に優れたヒューズを導入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "短絡事故が発生した際、限流リアクトルが瞬時に電流を抑制し、機器の損傷を防いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この新型の遮断器は、高い限流性能を備えており、配電システムの安全性を高めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
