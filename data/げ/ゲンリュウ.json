    "definitions": [
      {
        "index": 1,
        "gloss": "source (e.g. of a river)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "利根川の源流を求めて、登山隊は険しい山道を数日間かけて登り続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この小さな湧き水が、やがて大河へと成長する源流なのだと思うと感慨深い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ダム建設が源流の生態系にどのような影響を及ぼすか、慎重な調査が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "沙漠の水は画的であると共に、富の源流でもあった。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし自分が以下に試みに随筆的に述べてみたいと思う自己流の俳句観のはしがきのような意味で、やはり自己流の俳句源流説を略記して一つには初心読者の参考に供し、また一つには先輩諸家の批評を仰ぎたいと思うのである。",
              "citation": {
                "source": "俳句の精神",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも最近の雑誌などを読むと、ＧＵＩの源流探しはマッキントッシュ、リサとたどってゼロックス、パロアルト研究所のアルト（例のアラン・ケイ大人の作だ）あたりで止めておくのが流行りのようだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この考える作業の支援をいかに行うかというテーマの追及は、一九六〇年代からいわゆるワークステーションの源流となるアイデアと技術の開発の中で進められた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "随分思い切った法螺話のようだが、わが邦でも昔摂津で美酒出来る処の川上に賤民牛馬皮を剥ぎ曝すを忌んで停止せしむると翌年より酒が悪くなったといい、紀州有田川の源流へ高野の坊主輩が便利する、由ってこの川の年魚が特に肥え美味だなど伝うると等しく多少拠る所があったものか。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれが北上の源流になつてゐるんだから面白いぢやないか？",
              "citation": {
                "source": "水源を思ふ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今日これから行かうとしてゐるのは、沼田から二里ほど上、月夜野橋といふ橋の近くで利根川に落ちて來てゐる赤谷川の源流の方に入つて行つて見度いためであつた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今日これから行こうとしているのは、沼田から二里ほど上、月夜野橋という橋の近くで利根川に落ちて来ている赤谷川の源流の方に入って行って見度いためであった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし中岩橋、籠岩を序幕として、それから瀧の湯附近、更に進んで川治の温泉附近、そこから谷は深く山又山の中に穿つやうに入つて行つて、その源流の鬼怒沼まで十五六里が間、人家は皆山に架し溪に枕み、水の鳴ること佩環の如く、全く別天地を其處に開いて見せるのであつた。",
              "citation": {
                "source": "日光",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "（例へば支那の府志の中に雍州府志を擧げ、呂氏春秋の注者高誘を※誘と記せるが如し）時として著者の意見にも如何はしく思はるゝ節もなきにあらざれども、要するに其の人に絶せる炯眼を具して、博覽の餘に自然に著述源流の學を、髣髴として把捉し得たる者なることは、疑ふべくもなし。",
              "citation": {
                "source": "敬首和尚の典籍概見",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "領主　　暫時叫喚の口を閉ぢよ、先づ此疑惑を明かにして其源流を取調べん。",
              "citation": {
                "source": "ロミオとヂュリエット",
                "author": "ROMEO AND JULIET",
                "note": "青空文庫"
              }
            },
            {
              "text": "犀川の源流の一つである奈良井川は駅の後方に近く流れ、山がやや迫って山駅の趣が先ず目に這入る。",
              "citation": {
                "source": "木曾御嶽の両面",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "犀川の源流の一つである奈良井川は驛の後方に近く流れ、山が梢々迫つて山驛の趣が先づ目に這入る。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九六四（昭和三十九）年にカリフォルニア大学のバークレー校で始まり、六〇年代後半の世界的な学生運動の源流となったフリースピーチ運動。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで行われた講演と質疑応答を原稿化し、歴史的な参考論文を再録した『ワークステーション原典』は、パーソナルコンピューターが引き継いだ技術の源流をたどろうとする者にとって、きわめて示唆に富んだ貴重な資料である。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "組み立てキットＴＫ―80日電パソコンの源流を開く　ＴＫ―80を通して覗いた生まれ立てのパーソナルコンピューターの世界は、大内の目には創世の混沌に支配されているように見えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九六〇年代後半、世界をおおった学生反乱の源流を生み、カウンターカルチャーの巨大なゆりかごとして機能した西海岸のはみ出し者たちの中には、コンピューターを管理と支配の象徴としてとらえる意識が根を張っていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、 Zwagri のその点をさぐって暗河道をふさぐか、それとも「天母生上の雲湖」へわけいって源流を閉じるか、――その二者以外に遮断の方法はないと考えていた。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、Zwagri のその点をさぐって暗河道をふさぐか、それとも「｜天母生上の雲湖」へわけいって源流を閉じるか、――その二者以外に遮断の方法はないと考えていた。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "薩摩独自の剣法、瀬戸口備前守が発明したと伝えられる示現流（一名、自顕流、自源流。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "遼河源流の一つである渾河（一名瀋水）を北西に望んで、東へ延びた沃野の中に位置し、西は満鉄線に沿うて鉄道附属地に東北より西南に長方形を成した日本の新市街が、奉天駅から放射状に浪華平安の二大街を貫通し、それに大小の街区が分布され、舗道、並木、上下水道、欧風建築等の整然とした文化都市を実現してゐる。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑いもなくこれは、海にそそぐ川の源流である、日はだんだんかたむきかけたので、一同はここに一｜泊することにきめた。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、人形源流考　人形の起源に就いて地元の古老は次のやうな興味の深い傳説を聞かせてくれた。",
              "citation": {
                "source": "淡路人形座訪問",
                "author": "竹内勝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新村出先生は、日本に於ける鷹狩り源流についての権威である。",
              "citation": {
                "source": "鷹狩りと操り芝居と",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして其源流は宴曲まで溯る事が出来る。",
              "citation": {
                "source": "江戸歌舞妓の外輪に沿うて",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿楽能にも「開口」を演ずる場合は、主役と「もどき」（まぜ返し役・道化方の源流）とが、かけあひもし、同音にも謡うた。",
              "citation": {
                "source": "江戸歌舞妓の外輪に沿うて",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、世間では如何にも華かに見える風の「名文」或は「名作」らしい美妙斎のこてこての表現に比べて、あくまで地道な直ぐな態度で口語に依る新しい日本の文章を書かうと努めた二葉亭の表現は明かに後年の口語体の文章の源流になつたと言つていい。",
              "citation": {
                "source": "言文一致",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "美妙斎などの変奇な文体から見ると、遥かに立派な文章でこれを見る時、その頃まだ硯友社の小説家たちが、文章を弄んでゐたのに対し、これは二葉亭の源流にも一本清らかな流れが加つたのを感じられるのである。",
              "citation": {
                "source": "言文一致",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "私どもが今日の日本の文体が、ここまで口語に近づき、これほどの調節をもつやうになつたに就いて、その源流となつたものを考へる事と、源流を生んだ母胎を知る事が大切であると思ふのである。",
              "citation": {
                "source": "言文一致",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
