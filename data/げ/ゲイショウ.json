[
  {
    "uuid": "02737fc9-84f5-5c73-921c-d6f7c3cb13fc",
    "entry": "芸娼",
    "reading": {
      "primary": "げいしょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
