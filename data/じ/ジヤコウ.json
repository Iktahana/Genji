          "literary": [
            {
              "text": "水兵が呉れた駄菓子の袋をポケツトに入れて、ぽつぽつと噛じりながら歩かうとした時、一羽のジヤコウアゲハがわたしの眼の先を飛んでゐるのを発見した。",
              "citation": {
                "source": "或るハイカーの記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスヂ其他（２）アゲハ……クロ（５）キ（３）カラス（７）ジヤコウ（６）アヲスヂ（３）△鞘翅。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜番のお爺さんの孫である三ちやんは、お爺さんに似ない意地悪であつたが捕虫の業は抜群で、二三日前にもタマムシを六個、その次にはジヤコウを二個、クマバチ一個などと捕獲した。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺はジヤコウをとつたぞ。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
