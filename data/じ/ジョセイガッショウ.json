        "examples": {
          "standard": [
            {
              "text": "高校の女声合唱部は全国大会で金賞を受賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その女声合唱団のハーモニーは本当に美しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "音楽祭で女声合唱のコンサートが開かれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "童声或は女声合唱（童ぶり）亀の甲に揺られて、潮の瀬に揺られて、かぶりかうぶり海の子、棹やらな、附いまゐれ、波かぶりかぶるに、み船へと移らせ、名をのれ早や早や、み船へまゐ出るは臣ぞとそれまをす。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけても歌詞のない女声合唱の「シレーヌ」は面白い。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
