[
  {
    "uuid": "088d913c-f5bb-5b23-8cd9-30d885682643",
    "entry": "自暴",
    "reading": {
      "primary": "じぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "despair",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験に三度落ちた後、彼は自暴に陥り、しばらく部屋から出てこなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "失業して貯金も底をついたとき、彼は自暴の淵に立たされたが、友人の言葉で踏みとどまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "恋人に去られた夜、彼女はどこか自暴めいた気持ちで深夜の街を一人歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "謝源はもうシツカリ自暴自棄に陥つて居た。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自暴自棄になり、毎夜の如く市中の酒場を飮み※り、無茶苦茶にバカの浪費をして、自殺の場所を探してゐる。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが虎猫は急にひどく怒り出して、折角かま猫の出した弁当も受け取らず、手をうしろに廻して、自暴にからだを振りながらどなりました。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れの心は眞底から哀愁に搖り動かされ、自暴自棄にさいなみ苦しめられた。",
              "citation": {
                "source": "實驗室",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前のニヒリスチックの気持の時は全く灰のように冷えてしまって、それは神経衰弱的な恐迫観念がときどき槍尖のように自分を襲って来たが、しかし、最後の落ち着きどころは空虚と見究めがついていたので、まだ自暴自棄の痛快味があった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こうなったら、もう自暴だ。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが人間がある激烈な心の衝動をうけてその心が四分五裂の苦に苛まれるとき、これを逃れるには自暴自棄の態度が一番宜いのです。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の顔は全く無気力と自暴自棄との色に曇っているのだ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "自暴自棄にならないように、もし未だ居りましたら、よくおきかせ下さいませ。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小野はひどく自暴酒でも仰ったと見えて強か酔っぱらっていましたが、私の顔を見るといきなり私の胸に取り縋って泣き出したのです『――勘弁しておくれよ、勘弁しておくれよ――長い間俺の面倒を見てくれた君だもの、俺の気質ならよく心得ている筈じゃないか。",
              "citation": {
                "source": "遺書に就て",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "「恨ましやすんな、諦めなされ、　日の眼拜まぬ牢屋の中で、　　手錠、足械悲しいけれど、　長い命ぢやもうあるまいに　何うせ自暴だよ……」　皺嗄れた殆ど聴取れない程の聲で、恁う唄ふのが何處ともなく聽えた。",
              "citation": {
                "source": "虚弱",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜もまた自暴酒を呷っているであろう、獣のような親爺の顔も目に浮かんで来た。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀子は一年いるうちに、いつか嫌いであった酒の量も増していたが、その晩は少し自暴気味に呷り、外へ出ると酔いが出て足がふらふらしていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして憎悪の激情に逆上しながら、自暴自棄になって拳銃を乱発した。",
              "citation": {
                "source": "ウォーソン夫人の黒猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい神経衰弱から、僕は絶望的な自暴自棄に陥ったので、折角｜正に出版を待ってる著作を、自分から怠惰に投げ出してしまった。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は青年期の有り余る覇気をもちあぐみ、元来の弱気を無理な非人情で押して、自暴自棄のニヒリストになり果てていた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いらっしゃいいらっしゃいと雛妓を膝元へ呼んで、背を撫でてやりながら、その希望のためには絶対に気落ちをしないこと、自暴自棄を起さないこと、諄々と言い聞かした末に言った。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのお方の御環境から推測して、厭世だの自暴自棄だの或いは深い諦観だのとしたり顔して囁いてゐたひともございましたが、私の眼には、あのお方はいつもゆつたりして居られて、のんきさうに見えました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（前略）あのお方の御環境から推測して、厭世だの自暴自棄だの或いは深い諦観だのとしたり顔して囁いていたひともありましたが、私の眼には、あのお方はいつもゆったりしていて、のんきそうに見えました。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此書の末の方には憤怨｜恨※と自暴の気味とがあるが、然し天位を何様しようの何のといふそんな気味は少しも無い。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿母が死んだあとで、段々馬場も寂れて、一斉に二｜頭斃死た馬を売って、自暴酒を飲んだのが、もう飲仕舞で。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其所で疳は益々起る、自暴にはなる、酒量は急に増す、気は益々狂う、真に言うも気の毒な浅ましい有様となられたのである、と拙者は信ずる。",
              "citation": {
                "source": "富岡先生",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは佐伯自身の病欝陰惨の凸凹の表情を呈して、頽廃へ自暴自棄へ恐怖へ死へと通じているのだと、もうその頃は佐伯はその気もなく諦めていたらしい。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して一旦別れ別れになつた私の最愛の女性が、その後曩の牢舎のくるしみから肺病といふ恐ろしい不治の病に罹つて、自暴自棄に身も霊も破りはてたのを見つけ出した時、私は飛んで行つて彼を救ひ出した。",
              "citation": {
                "source": "雪と花火余言",
                "author": "東京景物詩改題に就て",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからどうしたか判りませんが、もうこうなっては東京へも帰られず、けっきょく自暴自棄になって、自分の好むがままに生活することに決心したのであろうと思われます。",
              "citation": {
                "source": "鰻に呪われた男",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
