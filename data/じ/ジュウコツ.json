        "examples": {
          "standard": [
            {
              "text": "Archaeologists discovered ancient 獣骨 at the dig site, providing clues about the diet of early humans.",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "The museum displayed a collection of fossilized 獣骨 from prehistoric megafauna.",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "She used 獣骨 tools for grinding pigments in her ancient craft demonstration.",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "牝馬の腹に獣骨の管を挿入れ、奴隷にこれを吹かせて乳を垂下らせる古来の奇法が伝えられている。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩漬肉の貯蔵庫、　撲殺人の粗末な宿所、その外の砂地に散乱した白い獣骨、鬱金色の岩菊。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "また相撲社会では獣骨（ガラ）をソップと云い、やせた相撲とりをソップという。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "村人が寄り集ひ、草庵を取毀したところ、仏壇の下に当つた縁下に、大きな獣骨を発見した。",
              "citation": {
                "source": "閑山",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯れ木、枯れ草、馬糞、牛糞、獣皮、獣骨、髪の毛などによって、出来あがっている燃料であった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この努力は報われ、土手に深い溝が掘られた部分に夥しい人骨および獣骨を見た。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "村人が寄り集い、草庵を取毀したところ、仏壇の下に当った縁下に、大きな獣骨を発見した。",
              "citation": {
                "source": "閑山",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "船から上がる時、その一人一人の兵を見ると、足はみな裸足だが獣骨の足環をはめ、半身の赤銅のような皮膚を剥き出しているが、腕くびに魚眼や貝殻の腕環をなし、紅毛｜碧眼の頭には、白孔雀や極楽鳥の羽根を飾って、怪美なこと、眼を疑わすほどだった。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "牝馬の腹に獸骨の管を插入れ、奴隸に之を吹かせて乳を垂下らせる古來の奇法が傳へられてゐる。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑ひ事では無い、既う何か出ても好い頃だと、心中いろ／＼苦悶して居るが如何も出ない、破片、獸骨、そんな處しか見出さぬ。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "大森貝塚の發掘",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨て其の土偶※　何しろ泥土を落して見るべしと、車夫をして、それを洗ひに遣つて見ると、豈に圖らんや、それは獸骨の一｜部、大腿骨の關節部が黒焦に燒けて居るのであつたので、これは／＼と一｜同苦笑ひ。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "大森貝塚の發掘",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、二十｜坪ばかりの貝殼を、殘らず綺麗に取出して、他の藪の方に運び、其所で綺麗に、貝は貝、石は石、土は土と、篩で分けてあるに拘らず、石器も、土器も、獸骨も、何も出て居らね。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "疑問の加瀬貝塚",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝塚に於て發見さるる獸骨貝殼の中には往々黒焦げに焦げたるもの有り。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "匙としては貝殼に柄を付けたるもの用ゐられ、肉差しとしては獸骨を割りて磨り尖らしたるもの用ゐられしならん。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "圖中石皿の右に在るは獸骨器の尖端なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "獸骨器の右に畫きたるは魚骨器なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ふに此利噐は前に掲げたる獸骨器と等しく、銛の尖端として用ゐられしものなるべし。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死亡者は如何に取扱ひしか、普通の塲合は反つて知り難けれど、死者中の或る者を食ふ風習の有りし事は、貝殼、獸骨、等に混じて破碎せる人骨の遺れるに由りて知るを得るなり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利器ノ原料トシテハ石、及ビ獸骨獸牙ノ類ヲ用ウ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
