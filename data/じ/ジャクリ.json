          "literary": [
            {
              "text": "ジャクリーヌという手回しのいい男は、労働者が通りかかるとだれかまわずに近寄って行った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャクリーヌがニコチン中毒にちかいチェーン・スモーカーで、ケネディが強度の近眼であった事実を知って投票した人たちは、得票差よりもさらにすくなかったにちがいない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
