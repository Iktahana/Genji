  {
    "uuid": "e43df6c2-2eff-57ed-b661-89f90dacc4d7",
    "entry": "寺中",
    "reading": {
      "primary": "じちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "in a temple",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寺中の僧たちは毎朝、読経に励んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "寺中の庭園は見事な景観を誇っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "寺中の雰囲気は静寂に満ちていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "その時６１＝玄関　雪崩れ込む捕方の一隊、寺中は大混乱の巷と化します。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時61＝玄関　雪崩れ込む捕方の一隊、寺中は大混乱の巷と化します。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の寺中に又一ツの小堂あり。",
              "citation": {
                "source": "甲冑堂",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――因にいふ、芭蕉に用のある人は、六間堀方面に行くがよい――江戸の水の製造元、式亭三馬の墓は、淨心寺中雲光院にある。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし女の乳のない寺中で赤子を育てるのは難儀なので、乳の代りに飴をあたへてゐた。",
              "citation": {
                "source": "小夜の中山夜啼石",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十四日には一同京都に着し、紫野大徳寺中｜高桐院に御納骨いたし候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムパニアの野にゆきては、香爐を提げて寺中の職をなさんやうなし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この寺中に又一ツの小堂あり。",
              "citation": {
                "source": "一景話題",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一軒の門にこのくらい咲いた家は修善寺中に見当らねえだよ。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには森厳寺という寺があって、その寺中に淡島明神の社があります。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前はゆうべ此の寺中に泊まったのか」「いいえ、自分の寺へ帰りました」と、教重は答えた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "夜叉神堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "やれ有難やと喜んで、再び奉納小屋の方へ引っ返そうと致しますと、この頃は夜の明けるのが早くなったのと、開帳中は特に早起きをいたしますので、寺中ではもう雨戸を繰るような音がきこえます。",
              "citation": {
                "source": "半七捕物帳",
                "author": "夜叉神堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "兜の一件は、世間にこそ秘していたが、寺中にはもう知れ渡っていたので、その噂を聴くたびに教重はひやひやした。",
              "citation": {
                "source": "半七捕物帳",
                "author": "夜叉神堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来の人や近所の者が五、六人たたずんで内を覗いていたが、寺中はひっそりと鎮まっていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "地蔵は踊る",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いもよらぬ椿事｜出来、その上に寺中の者共の不調法、なんとも申し訳がござりません」　地蔵を踊らせて賽銭稼ぎをするような山師坊主と、多寡をくくっていた半七らは、すこしく予想がはずれた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "地蔵は踊る",
                "note": "青空文庫"
              }
            },
            {
              "text": "その報告におどろかされて、寺中の者共は駈け付けた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "地蔵は踊る",
                "note": "青空文庫"
              }
            },
            {
              "text": "長慶の初年に、その寺中に住む人で毎夜門外の宿舎に眠るものがあった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "宣室志（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからまた五、六日の後、村民の斎に呼ばれて、寺中の僧は朝からみな出てゆくと、その留守の間にかの土龍の姿が見えなくなったので、人びとはまた驚かされた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "宣室志（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "去るに臨んで番語で猴に言い付ける、たまたま訳史聞き得て来って呉に告げたは、客、猴に教えて汝飲まず食わずば必ず縛を解かるべし、その時速やかに逃れ去れ、我は十里外の小寺中に俟ち受けんというたと。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "河内の道明寺中興住持の尼、覚寿は菅丞相の伯母で、菅神左遷の時、当寺に行き終夜別れを惜しむ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "城中の人と寺中の僧と、死んだ者の数はかの神の告げに符合していた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "夷堅志",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、東の廊下をあるき、さらに西の廊下をさまよっていると、その西廊のはずれに薄暗い室があって、そこに一つの旅というのは、旅先で死んだ人を棺に蔵めたままで、どこかの寺中にあずけて置いて、ある時機を待って故郷へ持ち帰って、初めて本当の葬式をするのでございます。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "剪燈新話",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたもずいぶん薄情なかたでございますね」　否応いわさずに彼を寺中へ引き入れて、西廊の薄暗い一室へ連れ込むと、そこには麗卿が待ち受けていて、これも男の無情を責めました。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "剪燈新話",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴代の寺僧の大きな位牌のまんなかに、むずかしい顔をした本寺中興の僧の木像がすえてあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集の者は、もう半分分捕りでもする気になり、勝手に振る舞い、果ては上野の山の中へ押し込んで行き、もう取るものがないと見ると、お寺の中へ籠み入って、寺中の坊さんたちの袈裟衣や、本堂の仏像、舎利塔などを担ぎ出して、我がちに得物とする。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "上野戦争当時のことなど",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の住んでいない寺中では、僧侶が針や鋏を持つことが無いとも云えない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "白蝶怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "市の天王寺中学で、ある実業家の子供が時計を盗まれた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜこんなことを知つているかというと、私は映写室を探して迷宮のような本願寺中をさまよい歩いたのである。",
              "citation": {
                "source": "映画の普及力とは",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三恵寺へまた拝登する、いかにも山寺らしい、坐禅石といふ好きな岩があつた、怡雲和尚（温泉開基、三恵寺中興）の墓前に額づく、国見岩といふ巨岩も見た、和尚さん、もつと観光客にあつてほしい。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "清水寺中を歴観し台上に休してかへる。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
