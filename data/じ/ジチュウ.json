    },
    "definitions": [
      {
        "index": 1,
        "gloss": "self-annotation of one's writings",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の著作には多くの自注が付けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "作者の自注によると、この表現は当時の方言である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古典の自注を読むことで、著者の意図がより明確になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "（不許）［自注１］　これは何と不思議な心持でしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父上［自注２］が、顔から脚から押して見てむくんでいないと仰云ったので、それでは本当かと、却ってびっくりしたほどです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父上は十二月六日に林町［自注３］にお出でになり父［自注４］にも会われ、いろいろのお話を伺いました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "籍のこと［自注５］ももう余程前からの話なのですが、やっと今度お話になられ、私も非常に満足です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕飯を壺井さん［自注６］と三人でスキヤキをたべて、それから東京駅へお送りして行って、九時ので大阪までお立ちになりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は島田の父上［自注７］の御好物の海苔をおことづけ願いましたし、べったら漬もあるし、まあ東京からおかえりらしいお土産が揃って結構でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄さんがあなたのシャツ類を編んでいてくれたのが待っていて、お茶をのんであのひとはかえり、私は島田の母様［自注８］が私へ下さったお手染のチリメンの半襟を又眺めなおして、いただいたコーセンをしまって、手伝いに来ているお婆さんをやすまして、それからドテラを着てね、さて、と机に向ったわけなのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラー、チブスになるわよ、とスエ子［自注９］等は恐慌的な顔付をしたが、まさかそれは大丈夫でしょうから、どうぞ御心配なさらないで下さい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六畳の方に山田のおばあちゃん［自注10］のくれた机をおいて、四畳半へテーブルと、あなたのつかっていらした本棚をおきおさまっている次第です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "達治さん［自注11］がこの一月二十日頃に入営することを叔父上がお話しになりましたか？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは御存知ないことだけれども、一昨年の十月末から国男夫婦［自注12］がケイオー病院のそばに家をもち、私はずっとその二階で暮して居りました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その家は、林町の母［自注13］が本年六月十三日に肺のエソでなくなり、（私が臨終の僅か五分前に辛うじて淀橋［自注14］からかえって会う事が出来た後、）引はらって、国男夫婦は林町にかえりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代文化社というところで私の最近の評論感想集［自注15］を出すそうで、多分一月頃出版の運びになるだろうと思って居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小説集には島木健作「癩」、平田小六という「囚われた大地」という長篇小説をかいた元隆章閣の人などもはいっているし、婦人作家では私のほかにいね子［自注16］、松田さん［自注17］なども居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――原泉夫妻［自注18］は四谷の大木戸ハウスというアパートで細君はトムさん［自注19］の新協劇団第一回公演では「夜明け前」に巡礼をやり、今やっているゴーゴリの芝居では何をやっているか、旦那さんの方はきっと徹夜して小説かいてるでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この近所には千葉で三年ばかり暮すことになった山田さんの奥さん［自注20］もいるし、河野さくらさん［自注21］が留守中のひとり暮しをして居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（附録終り）　［自注１］（不許）――この第一信は「不許可」で顕治にわたされなかった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注２］叔父上――顕治の父の実弟、山口県熊毛郡光井村にすんでいた。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注３］林町――本郷区駒込林町二一　百合子の実家。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注４］父――百合子の実父、中條精一郎。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注５］籍のこと――百合子入籍の件、顕治と百合子は一九三二年二月本郷駒込動坂町に新居をもった。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注６］壺井さん、栄さん――壺井栄。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注７］島田の父上――顕治の実父、宮本捨吉。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注８］島田の母様――顕治の実母、美代。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注９］スエ子――百合子の妹。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――廣瀬河畔を逍遙しつつ――附録散文詩自註　　前書　詩の註釋といふことは、原則的に言へば蛇足にすぎない。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故にこの「自註」は、實には詩の註解と言ふべきものでなく、かうした若干の詩が生れるに至る迄の、作者の準備した心のノートを、讀者に公開したやうなものである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからこの附録は、正當には「散文詩自註」と言ふよりは、むしろ「散文詩覺え書」といふ方が當つてゐるのだ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とノヴアリスが言つてるが、この私の覺え書的自註の中にも、本文とは獨立して、それ自身にまた一個の文學的エツセイとなつてる者があるかも知れぬ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――廣瀬河畔を逍遙しつつ――附録散文詩自註前書　詩の註釋といふことは、原則的に言へば蛇足にすぎない。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
