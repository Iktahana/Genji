        "examples": {
          "standard": [
            {
              "text": "部長が出張中は課長が部長代行として事務を見ることが慣例になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "定年後も嘱託として週三日出勤し、引き継ぎが完了するまで事務を見ることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "支店長が急病で倒れ、本店から派遣された担当者が当面の事務を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そこは半蔵が清助を相手に庄屋本陣の事務を見る部屋にあててある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "また吉川家の遠縁にあたる吉川氏は、万般の事務を見る人だが、ニコニコした気持のいい、最も愛想のよい顔をしていた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
