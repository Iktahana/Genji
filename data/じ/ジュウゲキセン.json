        "examples": {
          "standard": [
            {
              "text": "その町では捜査当局と犯人グループの銃撃戦が繰り広げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "警察は建物に立てこもった容疑者との銃撃戦を慎重に進めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "映画の終盤は派手な銃撃戦で観客を釘付けにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そして二月二十八日、機動隊は浅間山荘に突入、銃撃戦ののち五人を逮捕して人質を救出。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「銃撃戦には遅すぎたな」　とデンが繰り返した。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い間隔を置いて、次の半時間は散発的に銃撃戦になった。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
