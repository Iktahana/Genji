    "definitions": [
      {
        "index": 1,
        "gloss": "noisily (playing an instrument)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はアコースティックギターをジャカジャカとかき鳴らしながら、自作の歌を情熱的に歌った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "文化祭のステージで、軽音部のバンドがジャカジャカと激しいリズムで演奏を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんなにジャカジャカ弾いたら近所迷惑だよ」と母に注意されてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ジャカジャカと引鳴らせ、糸瓜の皮で掻廻すだ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　　　瓜や茄子の花ざかり　　　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　瓜や茄子の花ざかり　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男",
                "author": "第一話　旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではジャカジャカジャンジャンとなにか弾け」「…………」「よう。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さあさ、浮いた、浮いた、ジャカジャカジャンじゃ。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえらもその気で、もっとジャカジャカやらんといかん！",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯うして聴いていると、如何しても琴に違いないと、感心して聴惚れていると、十分と経たぬ中に、ジャカジャカジャンと引掻廻すような音がして、其切パタリと、琴の音は止む……ともう茶の間で若い賑かな雪江さんの声が聞える。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の中、庭先には、アメ屋や、オデン屋や、フーセン屋や、オモチャ屋などが店をだして、村の祭礼と同じようにピイピイ、ジャカジャカやっている。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかり途方に暮れてしまっていると天の助けかすぐ脇の一膳めし屋へ、額へ即効紙を貼った汚い婆さんがジャカジャカ三味線を弾いて、塩辛声で瞽女唄のようなものを歌って門付をやっているんです。",
              "citation": {
                "source": "初看板",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "センター街は然し、元町に比べれば、ジャカジャカし過ぎる。",
              "citation": {
                "source": "神戸",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "incessantly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
