    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "線香花火がベートーヴェンのソナタであれば、これはじゃかじゃかのジャズ音楽である。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ旅の事で、何を極って、きちょうめんにしなければならんというでもなし、一向気取らない女主人で、夜も坊ちゃんを真中へ、一ツ蚊帳に寝るほどだから、お茶漬をさらさらで、じゃかじゃかと洗ってしまえば埒は明く。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷では、じゃかじゃかじゃん……ここらは本職だわね。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいにくその日は南風楼が非常に繁昌して、となり座敷では三味線をひいてじゃかじゃか騒ぎ立てる。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "塀のじゃかじゃか出た針金越しに別の建物の平屋の翼が見下せた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父や母につれられて、おばさんの家などに行くと、おばさんにすぐ三味線をじゃかじゃか鳴らして貰って、自分は手拭を頭の上にちょいとのせ、妙な手つきや腰つきをして、「猫じゃ、猫じゃ……」とひとりで唄いながら、皆にひと踊り踊ってみせた。",
              "citation": {
                "source": "花を持てる女",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
