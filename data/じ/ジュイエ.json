          "literary": [
            {
              "text": "諺を知っている追放人仲間は成程彼が珍らしく七月十四日のキャトールズ・ジュイエの祭まで土地に居残るつもりだなと簡単に合点した。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか、カトルーズ・ジュイエの前後の、まる三日か四日ほどの期間だった気がする。",
              "citation": {
                "source": "ジャンの新盆",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
