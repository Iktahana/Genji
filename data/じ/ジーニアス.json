        "examples": {
          "standard": [
            {
              "text": "彼は、音楽の才能に恵まれた、まさに「ジーニアス」と呼ぶにふさわしい人物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その発明は、彼の「ジーニアス」から生まれた、画期的なものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「君のアイデアは、まさに『ジーニアス』だね！」と、教授は高く評価した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "サツカレーの『虚栄市』『ニウカムス』ヂツケンスの『ヒツクウイク』『二市物語』などを読んだり、ウイルキー・コリンスの『白衣婦人』『イビル、ジニアス』を読んだりした。",
              "citation": {
                "source": "紅葉山人訪問記",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちジニアスを要するのである。",
              "citation": {
                "source": "「二銭銅貨」を読む",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『之ではならぬ、僕のジニアスは哲学だ。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄一は実業に自分のジニアスがあるとは思はない。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "何という驚くべき、インジニアスな復讐だろう。",
              "citation": {
                "source": "恐ろしき錯誤",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
