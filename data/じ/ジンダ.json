    "definitions": [
      {
        "index": 1,
        "gloss": "salted rice-bran paste for pickling",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祖母が作るきゅうりの糂汰漬けは、夏には欠かせない一品だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "糂汰に漬け込むことで、野菜の旨味が引き出される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "伝統的な漬物を作るため、糠床に糂汰を加えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これは徒然草の中に、世捨人は浮世の妄愚を払ひ捨てゝ、糂汰瓶ひとつも持つまじく、と云ふ処から出て居るのださうでありますが、全くこの庵にも、糠味噌壺一つ無いのであります。",
              "citation": {
                "source": "入庵雑記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "薄暗いランプの光で寒竹の皮をむきながら美しい絵を思い浮べて、淋しい母の横顔を見ていたら急に心細いような気が胸に吹き入って睫毛に涙がにじんだ。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の吐いたものは泥の代りに血ににじんだ臓腑であった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "獣の血臭いにおいがして翁の唇の端から血の色がうっすりにじんだ。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうしたらあの氣詰りな丸善も粉葉みじんだらう」　そして私は活動寫眞の看板畫が奇體な趣きで街を彩つてゐる京極を下つて行つた。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは三月なかばの花見｜日和といううららかな日で、ぶらぶら歩いている二人のひたいには薄い汗がにじんだ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "帯取りの池",
                "note": "青空文庫"
              }
            },
            {
              "text": "十四人が、汗のにじんだ手拭をさげ、石鹸は一ツも持たずに、マッチ工場から、貧民窟とは反対側の雑草が青濃く茂っている広場を横ぎった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日目の朝、頬冠りを取って顔を洗っていると、祖母は、彼の頭に血がにじんだ跡があるのを見つけた。",
              "citation": {
                "source": "まかないの棒",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうしたらあの気詰まりな丸善も粉葉みじんだろう」　そして私は活動写真の看板画が奇体な趣きで街を彩っている京極を下って行った。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青磁の徳利にすすきと桔梗でも生けると実にさびしい秋の感覚がにじんだ。",
              "citation": {
                "source": "青磁のモンタージュ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初は連れとであつたが、此頃は松田はよくひとりでやつて来て、羽衣と云ふ女を買ひなじんだ。",
              "citation": {
                "source": "二黒の巳",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "動悸が激しくし出して、冷い汗さへ肌ににじんだ。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "「口惜しいけれど、おいしいわよ」　お絹は唾液がにじんだ脣の角を手の甲でちょっと押えてこういった。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "母無くして権高な父の手だけで育ったためか、そのとき中性型で高貴性のある寂しさがにじんだ。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふことから、私は兄のレコオドの洋樂よりも邦樂の方に早くなじんだ。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それからキミョウニナオル丸、牛豚開店までやりやがって、按摩ン許が蒲生鉄斎、たつじんだ、土瓶だとよ、薬罐めえ、笑かしやがら。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "加奈子は何となしの悲哀に薄く涙のにじんだ眼で眺めて、崖の上のテニスコートに落ちる帰朝後四日目の太陽を惜んだ。",
              "citation": {
                "source": "豆腐買い",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "順平の眼に思わず涙がにじんだ。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　その小さい緑の古宝玉はよく香料のうつり香の新しい汗のにじんだ私の掌にも載り、ウイスキイや黄色いカステラの付いた指のさきにも触れる。",
              "citation": {
                "source": "桐の花とカステラ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いまにこの家へなじんだら、はなし飼ひにしてやればいゝよ。",
              "citation": {
                "source": "小犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすると又、娵に來て三月程立つて、夫と里へ徃つたとき、お母樣が、「お前はめつたに人になじむといふことのない子だつたに、好く高山さんになじんだものだ」と云つたことを思ひ出す。",
              "citation": {
                "source": "半日",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "働くと決心した以上、軽井沢へ付いて行って、早く子供達になじんだ方がいい。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人連の労働者のやうな酔つぱらひをやり過して、歩かうとして右側を見ると赤いにじんだやうな行燈が眼についた。",
              "citation": {
                "source": "水郷異聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西日が射し込んで来て、じっとりと額に汗がにじんだ。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと振り向くと、園井は物差の横ににじんだインクをせっせと吸取紙で拭っているなど、園井の勤務振りは一分の隙もなかった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨は煙のようで、遠くもない八幡の森や衣笠山もぼんやりにじんだ墨絵の中に、薄く萌黄をぼかした稲田には、草取る人の簑笠が黄色い点を打っている。",
              "citation": {
                "source": "竜舌蘭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし一気に書かれ、そのあと吸取紙をかけたのなら、インクで真っ黒ににじんだりはしない。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
