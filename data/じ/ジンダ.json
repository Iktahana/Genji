        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ずんだ餅に使われる糂汰は、枝豆の豊かな風味が特徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お盆には、収穫したばかりの枝豆で糂汰を作ってお供えする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は東北地方出身で、糂汰を使った料理には目がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
