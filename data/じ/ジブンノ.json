          "literary": [
            {
              "text": "カンザシヲ　ジブンノ　モノニ　シタイト　オモヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノ　トキ、ジブンノ　アタマニハ　カンザシハ　サセナイ　コトガ　ハジメテ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストハ　ウシロヲ　ミルト、ソコニ、ホントウニ　ブカツカウナ　ジブンノ　カゲガ　アリマシタノデ　アカク　ナリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タヾシ、私ノウチニハ、オ皿トナイフトフオークガ一ツヅヽシカアリマセンカラ、オイデ下サル方ハ、ドウゾ、ゴジブンノオ皿ト、ナイフト、フオークヲモツテイラシツテ下サイ。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンハジブンノヘヤニカケコンデシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　オマツリニジブンノ　キルキモノト、コドモタチニ　キセルキモノノコトデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノオマツリニ　ジブンノ　キルキモノト、コドモタチニ　キセルキモノノコトデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
