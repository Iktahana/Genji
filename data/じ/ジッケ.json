  {
    "uuid": "f59e9e0d-a312-5ecb-b3fc-a42ab6351f02",
    "entry": "習気",
    "reading": {
      "primary": "じっけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
