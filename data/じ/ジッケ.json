[
  {
    "uuid": "35c1b1bf-2497-5e33-b296-f72e0b5eb3f1",
    "entry": "実化",
    "reading": {
      "primary": "じっけ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
