    "definitions": [
      {
        "index": 1,
        "gloss": "syllable repetition (indicating plurals)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
