[
  {
    "uuid": "d78e081b-b58a-5a8d-915b-febeb11f0186",
    "entry": "ジタバタ",
    "reading": {
      "primary": "ジタバタ",
      "alternatives": [
        "じたばた"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と",
        "動詞-サ変"
      ],
