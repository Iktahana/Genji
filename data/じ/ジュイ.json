        "examples": {
          "standard": [
            {
              "text": "樹齢数百年の大ケヤキが弱ってきたため、専門の樹医に診断を依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "樹医は幹の状態を詳しく調べ、栄養剤の投与と土壌の改良を提案した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "街のシンボルである桜を守るため、樹医が定期的に剪定と病害虫のチェックを行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
