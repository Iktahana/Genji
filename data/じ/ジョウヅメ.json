        "examples": {
          "standard": [
            {
              "text": "その会社では、契約社員から正社員への登用、いわゆる定詰の機会が多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は長年勤め上げた結果、晴れて定詰となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "多くの企業が、安定した組織運営のために定詰の社員を重視している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "もと豊後の杵築の藩士で、大阪｜中の島にあった藩の蔵屋敷の定詰であったが、御一新後大阪府の貫属となって江戸｜堀に住んでいた。",
              "citation": {
                "source": "神仙河野久",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、山沢さんに死なれてから、彼の生活は、案の定詰らない、張合いのないものになってしまった。",
              "citation": {
                "source": "三郎爺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――見習医は二人、これと新出医長だけが定詰で、入所している患者の治療は、殆んどこの三人に任されたようなかたちだったし、かよって来る患者に対しても、他の医員たちは熱意がなく、治療のやりかたも形式的な、投げやりなものが多いようであった。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "狂女の話",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "daimyo or feudal retainer who lived and/or served in Edo for a fixed period of time (Edo period)",
        "register": "standard",
        "nuance": null,
