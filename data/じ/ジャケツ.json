        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕は、ジャケツを着て来なかったので。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャケツを着て来なかったもので、どうもいけません。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、何せ、ジャケツを着て居りませんので。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを僕に、たいへん聞かせたい御様子でありましたが、僕はジャケツを着て居りませんでしたので、非常に寒く、落ちついて承る事が出来ませんでした。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶色のダブダブしたジャケツを着て、女優さんどころか、いや、言うまい。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は女学校時代のつぎはぎだらけのスカートに、それからやはり昔スキーの時に着た黄色いジャケツ。",
              "citation": {
                "source": "恥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此のジャケツは、もうすっかり小さくなって、両腕が肘ちかく迄にょっきり出るのです。",
              "citation": {
                "source": "恥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さすぎるジャケツの袖口は、ほころびている。",
              "citation": {
                "source": "恥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」見ると、木戸にいる時と同様、紺の股引にジャケツという風采であった。",
              "citation": {
                "source": "黄村先生言行録",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は黄色い毛糸のジャケツを着て、ものものしくゲエトルをつけ、女ものらしい塗下駄をはいていた。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色いジャケツを脱いでワイシャツ一枚になり、「これは面白くなったですねえ。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "レンコオトも帽子もなく、天鵞絨のズボンに水色の毛糸のジャケツを着けたきりで、顔は雨に濡れて、月のように青く光った不思議な頬の色であった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "傾斜面に倒れた縁なし帽や、ジャケツのあとから、また、ほかの汚れた短衣やキャラコの室内服の女や子供達が煙の下からつづいて息せき現れてきた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "汚れたジャケツは、吃驚して、三尺ほど空へとび上った。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事が起ったのか一分間ばかりジャケツが理解できないでいるさまが兵士達に見えた。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャケツに抱き上げられた子供は泣声を発しなかった。",
              "citation": {
                "source": "パルチザン・ウォルコフ",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたらにわかにそこに、つやつやした黒い髪の六つばかりの男の子が赤いジャケツのぼたんもかけず、ひどくびっくりしたような顔をして、がたがたふるえてはだしで立っていました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀田は赤い毛糸のジャケツを着てゐるんだ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら俄かにそこに、つやつやした黒い髪の六つばかりの男の子が赤いジャケツのぼたんもかけずひどくびっくりしたような顔をしてがたがたふるえてはだしで立っていました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしたら俄かにそこに、つやつやした黒い髪の六つばかりの男の子が赤いジャケツのぼたんもかけずひどくびっくりしたやうな顔をしてがたがたふるえてはだしで立ってゐました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀田は赤い毛糸のジャケツを着ているんだ。",
              "citation": {
                "source": "台川",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（手早く帽とジャケツとを脱ぎ捨て、大いなる白の前掛を取出して掛く。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "これフェルナンドのを、あなたのジャケツに編み縮めてあげるのよ。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　リサは自分の言うことだけ言ってしまうともとの実直な姿勢に直ってせっせとジャケツを直しにかゝった。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "値をきくと、指を一本出したので、煙草の五円に較べれば一皿一円のカレーライスは廉いと思い、十円札を出すと、しかし釣は呉れず、黒いジャケツを着たひどい訛の大男が洋食皿の上へ普通の五倍も大きなスプーンを下向きに載せて、その上へ白い飯を盛り、カレー汁を掛けるのだった。",
              "citation": {
                "source": "世相",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑がかったスコッチのジャケツを着て、ちぢれた金髪を無雑作に桃色リボンに束ねている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
