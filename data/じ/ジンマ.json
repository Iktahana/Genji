[
  {
    "uuid": "99e06fb4-2421-5896-ba82-1f1f8e23bf3d",
    "entry": "蕁麻",
    "reading": {
      "primary": "じんま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
