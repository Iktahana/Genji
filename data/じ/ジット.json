  {
    "uuid": "8b2d4269-07ea-551a-87c8-421c0f015fda",
    "entry": "ジット",
    "reading": {
      "primary": "じっと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（「門は」「門を」は「モンナ」「モンノ」となり、「実は」「実を」は「ジッタ」「ジット」となった）四　第三期の音韻　第三期は江戸初期から今日に至る三百三四十年間である。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "開墾地落上白髪かざして高清は、　　　　　ブロージットと云へるなり。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブ、ブ、ブロージット。",
              "citation": {
                "source": "ポランの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この愉快な人生にプロジットしよう」　その青年にはだいぶ酔いが発して来ていた。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのプロジットに応じなかった相手のコップへ荒々しく自分のコップを打ちつけて、彼は新しいコップを一気に飲み乾した。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしよし、プ、プ、プロージット。",
              "citation": {
                "source": "ポラーノの広場",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集が一度にプロージット・ノイヤール、プロージット・ノイヤールと叫ぶ。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "遅れて来る人々もあちこちの横町からプロージット・ノイヤールと口々に叫ぶ。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "巡査もにこにこして、時々プロージットの返答をしている。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰って寝ようと思ったら窓の下でだれかプロージット・ノイヤールと大きな声がして、向こうの家からプロージットプロージットとそれに答えているのが聞こえました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺々の鐘が鳴り渡ると爆竹がとどろいてプロージット、プロージットノイヤールという声々が空からも地からも沸き上がる。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ専門領域に深く踏み込んだ困難で膨大な翻訳作業を、最終的に誰が取りまとめたかが正しくクレジットされていない点は、「歴史は人が作る」という観点からも、本書の唯一の瑕疵として引っかかる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "★家庭用のテレビをディスプレイに使ったアップル※では、カラーのビデオ信号は光の三原色の赤（Ｒ）、緑（Ｇ）、青（Ｂ）を一本の信号線で送るコンポジット（複合）形式が採用されていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "次善の策であるクレジットカードによる決済も、実績のない小さなところには、カード会社が対応してくれません。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯心ばかりは主とも親とも思ッて善く事えるが、気が利かぬと言ッては睨付けられる事何時も何時も、その度ごとに親の難有サが身に染み骨に耐えて、袖に露を置くことは有りながら、常に自ら叱ッてジット辛抱、使歩行きをする暇には近辺の私塾へ通学して、暫らく悲しい月日を送ッている。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "文三も暫らくは鼻をも潰していたれ、竟には余りのけぶさに堪え兼て噎返る胸を押鎮めかねた事も有ッたが、イヤイヤこれも自分が不甲斐ないからだと、思い返してジット辛抱。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「若しそうなればもう叔母の許を受けたも同前……チョッ寧そ打附けに……」ト思ッた事は屡々有ッたが、「イヤイヤ滅多な事を言出して取着かれぬ返答をされては」ト思い直してジット意馬の絆を引緊め、藻に住む虫の我から苦んでいた……これからが肝腎｜要、回を改めて伺いましょう。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレジットはなんであれ、あれは純粋にサー・ポールの曲で、ジョンはまったく関係ない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はジット室の中に閉ぢこもつて、この屋根の上を駈け廻る物音を聞いた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして十二時の時計が鳴り始めると同時に、さあ新年だと云うので、その酒を注いだ杯をてんでんに持って、こつこつ打ち附けて、プロジット・ノイヤアルと大声で呼んで飲むのです。",
              "citation": {
                "source": "かのように",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボイルの洋服が、汗でジットリと背について、白い首筋と黒い断髪と、全体がなにか親しい、生々しい感じであった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユージット一　一家の危機は過ぎた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は、ユージットになろうと思うのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はユージットになろうと思うのでございます。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
