        "examples": {
          "standard": [
            {
              "text": "地元民のお勧めの店に連れて行ってもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "地元民はその出来事を昔から知っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "地元民との会話から地域の歴史を学んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "地方專賣局といふやうな役所は、その仕事の性質上、地元民との接觸は始終のことに違ひない。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは暗い森をたたえた山脈の岩場に建っており、近寄る地元民とてなく、一般人なら即座に気を滅入らせざるを得ない。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
