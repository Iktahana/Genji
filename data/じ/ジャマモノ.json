[
  {
    "uuid": "98869981-c9a9-52c7-b7bf-f2e5c16e9d36",
    "entry": "邪魔者",
    "reading": {
      "primary": "じゃまもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
