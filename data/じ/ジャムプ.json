          "standard": [],
          "literary": [
            {
              "text": "そこに　（熊本秋子、二十歳、Ｋ県出身、Ｎ体専に在学中種目ハイ・ジャムプ記録一｜米五七）と出ているのを、何度も読みかえしました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに　（熊本秋子、二十歳、Ｋ県出身、Ｎ体専に在学中種目ハイ・ジャムプ記録一米五七）と出ているのを、何度も読みかえしました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "村はずれにはスケート場やシーフェルトがあって、此の天気にも、気楽な奴等が、中には覚束ないのも混って騒いでいたが、ジャムプなどは、後の日ノルウェイで見たものにくらべれば、いささか小供だましの感がある。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞いて見ると二月頃までは御客もかなりあるそうで、雪を排らうと湖水は立派なスケート場になるし、山の麓には、シー・ジャムプなどもあると云うことだ。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャムプなどゝいう足のバネに依存するスポーツとなると、足の毛が一本ぬけたぐらいの重量の変化がしつこく感じられるぐらい、コンディションに敏感になりすぎてしまうのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は元来インターミドルで優勝したジャムプの選手で、又、野球も選手、投手であつた。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとてスキーをはいて三日目のお嬢さんが、ジャムプをやりに、右側の急斜面を登る筈はない。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "テレマーク、クリスチャニヤ、ジャムプ・ストップ……近藤リーダアは時おり注意を与えた。",
              "citation": {
                "source": "針の木のいけにえ",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
