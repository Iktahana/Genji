        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時服一かさねに例の歌の消息がある。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は其時服裝にも、動作にも、思想にも、悉く當世らしい才人の面影を漲らして、昂い首を世間に擡げつゝ、行かうと思ふ邊りを濶歩した。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「会業日、苦雨新晴、乃廃業、与余語天錫、山本恭庭、木村駿卿同遊石浜墨陀諸村途中作、時服部負約」の五律五首、「首夏与余語天錫、山本恭庭、木村駿卿同集石田子道宅」の七絶三首、「初夏過太田孟昌宅」の七絶二首、「再過太田孟昌宅、与余語、山本二医官及木村駿卿同賦」の七律一首等がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから殉死者遺族が許されて焼香する、同時に御紋附｜上下、同｜時服を拝領する。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林城三となって後、金千両を水戸様へ献上して葵の時服を拝領してからの或時、この御紋服を着て馬上で町内へ乗込むと偶然町名主に邂逅した。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大中納言、参議中将、五位の諸太夫等には時服二｜領ずつ下し置かれる。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の父も御時服二重と銀二十枚とを頂戴した。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "御時服というは大きな紋の付いた綸子の綿入で、大名等へ賜わるは三葵の紋、倍臣には唐花という紋のついたものであった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に老松、東北、高砂の囃子を観世、宝生（但金春、金剛と宝生は輪番で勤める）、喜多の三流の大夫が演じ、それが済むと三人の大夫は、拝領の時服を纏つて弓矢の立合を舞ふのである。",
              "citation": {
                "source": "よくぞ能の家に",
                "author": "二十四世　観世左近",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが了ると白綸子、紅絹裏の時服を拝領して、それを素袍上下の上に壺折つて、三人で弓矢立合を舞ふこと昔の如くである。",
              "citation": {
                "source": "よくぞ能の家に",
                "author": "二十四世　観世左近",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時服屋を呼んで来た。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでバラモン僧正が来ると直ぐ僧正に任ぜられて、時服を賜い荘田を与えられて大安寺に寓せしめられた。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……勝をとったほうには、奉行へご褒美として時服ひと重。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "丹頂の鶴",
                "note": "青空文庫"
              }
            },
            {
              "text": "此年より兩商は將軍家の拜謁を辱ふして、時服を拜受し竹島の名産｜蚫を奉貢す。",
              "citation": {
                "source": "他計甚※（竹島）雜誌",
                "author": "松浦武四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時服一と揃えとあれば、その反物の名柄から染め色、原価と売価、仕立て賃などまで問い詰めるので、要屋主従はたちまち返答に窮した。",
              "citation": {
                "source": "改訂御定法",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "総奉行　茂庭｜周防　白銀百枚、時服十。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の者たちには、それぞれ白銀二十枚、時服四ずつを賜わりました。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "「献上の品は包永の太刀、馬代黄金五十枚、棉二百｜把、そして拝領したのは新藤五国光であった」　十二月十五日に、柴田｜外記、片倉小十郎、津田｜玄蕃らが登城、それぞれ太刀、銀馬代、時服を献上し、白書院にて将軍に謁した。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "献上品は友成の太刀、白銀三百枚、時服二十領。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "時服、黄金など与えて、鄭重に、領外へ送り出すがよい」「は。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "利家は、かれのこの行動が、一片の旧恩にたいする感謝から出たものと聞いて、「ちか頃、しおらしい奴ではある」　と、黄金二枚に、時服など与えて、以後、自分の茶堂に召抱えた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに、又左衛門利家を親柱となし、以後の安泰を守られよ」　そういって、それぞれに、黄金、時服、佩刀などの賞を頒かった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "心配すな」　秀吉はこの少年使者がよほど気にいったとみえ、その夜は大坂城に泊めて馳走し、翌日、時服と刀を与えて、郷里へ帰した。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時服部老と井上へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくしてから、「流浪の望みでござります」「そうか」　沢庵のほうへ向って、「彼に、時服と路銀をやれ」「ご高恩、沢庵からも、有難くお礼を申します」「お汝から、改まって礼をいわれたのは、初めてだな」「ははは、そうかも知れませぬ」「若いうちは、流浪もよかろう。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮中の喪儀や諸民の弔祭は大へんなものだったが、定軍山の塚は、故人の遺言によって、きわめて狭い墓域に限られ、石棺中には時服一着を入れたのみで、当時の慣例としては質素極まるものだったという。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝右衛門などは、殊に、十七士が細川家に永預けになる場合は、当然お召抱えの沙汰があろうし、また、時服と同時に、大小の入用はきまっているから、その時に役立つようにと、秘蔵の古刀、新刀十本を、疾くから刀屋へ手入れにやって、独りで、澄ましこんでいた。",
              "citation": {
                "source": "べんがら炬燵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
