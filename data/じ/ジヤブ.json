          "literary": [
            {
              "text": "綾さんは店頭に盥を持出して、ジヤブ／″＼何やら洗濯をしてゐた。",
              "citation": {
                "source": "昔の女",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど竹丸は矢つ張り風呂の中で、ジヤブ／＼やつてゐた。",
              "citation": {
                "source": "天滿宮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "とても暑くてたまらないので、先生たちが、上へあがつて休んでゐる間に、大いそぎで、ジヤブジヤブと水をはねかへして、およぎました。",
              "citation": {
                "source": "お猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤブ、ジヤブ　ト。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナミハ　ジヤブリ、サラ、サラ、ト　ジロウノ　ハダカノアシニ　カカツテハ　ヒイテユキマス。",
