        "examples": {
          "standard": [
            {
              "text": "彼は役作りのため、その役柄を地でいくように演じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は常に自分らしさを地でいく生き方を貫いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの作家の作品は、登場人物の感情を地でいくような描写が特徴だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すっかりその弟子たちに心づけをしてしまったあと、自分の家の春の仕度万端をすますと、大晦日にはお恥しいが圓朝、印袢纏一枚「何もかもあるだけ質に置炬燵、かかろうひまのふとんだになし」落語の「狂歌家主」をそっくり地でいく境涯となってはしまっていたのだった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにより音曲とモソモソした八さん熊さんと地でいくそそっかし屋と、これだけでこの間のうちまでとは比べものにならないくらい私の噺は明るくおかしく華やかになってきました。",
              "citation": {
                "source": "初看板",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同じでいくら秀才でも職業にぶつからなければしようがないのでしょう。",
              "citation": {
                "source": "道楽と職業",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
