        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジェノヴァにもう一日居て、それから、あまりその名聲を知られてゐない偉大な Claus Sluter（譯註十四世紀の彫刻家）の作品を鑑賞するためディジョンにちよつと立寄る積りで居ります。",
              "citation": {
                "source": "リルケ書翰（ロダン宛）",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "休養所、コンラッド氏　ダーチャー〔別荘〕の主人六月十八日（月曜）　ジェノトジェルにゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海アルプス」と呼ばれる一群はジェノアからフランスに入る時、その裾野を通ったに過ぎなかった。",
              "citation": {
                "source": "吹雪のユンクフラウ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ジェノア・ピサ経由、羅馬行き急行！",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノアは、真夜中に擦過するに相違ない。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "外部の重い闇黒のなかで、もうジェノアが近づいているに相違なかった。",
              "citation": {
                "source": "踊る地平線",
                "author": "長靴の春",
                "note": "青空文庫"
              }
            },
            {
              "text": "コモをはなれると、すぐ甲板の食堂に出て、カプリ・ロッソを飲みながら、水にせまるジェノの鼻をぐるっと廻ると、モンテ・ビスビノ Monte Bisbino, 1323m. の山頂に、四条の残雪が、きらりと船の帆柱に近く仰がれる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "予曾て黎明リヰエラ・ヂ・レ※ンテを過ぎて、檸檬、橄欖の木の間から、風に飽いた數隻の帆船が、將に白まむとする東天に向へるのを望みて、十字軍時代に於けるジェノア市民の傲然たる意氣を想ひ起こした。",
              "citation": {
                "source": "足利時代を論ず",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔堺港の納屋衆が、淡路島かくれに西せる渡唐船を見送つた意氣は、正に此のジェノア市民の壯心と相伯仲するものであると思ふ。",
              "citation": {
                "source": "足利時代を論ず",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノベエジ僧正（〔Abbe' Genovesi〕）は前世紀の中頃この学説をナポリにおいて教え、シニオル（N. W. Senior）は一八三〇年頃これをオックスフォードにおいて教えた。",
              "citation": {
                "source": "純粋経済学要論",
                "author": "ELEMENTS D'ECONOMIE POLITIQUE PURE OU THEORIE DE LA RICHESSE SOCIALE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドールン　ジェノアですね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　なぜジェノアなんです？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに類似の租税はそれほど重くはないが、ミラノ公国や、ジェノア共和国や、モデナ公国やパルマ、プラチェンティア、及びグァスタルラの諸公国や、法王領にある。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は曰く、『オランダかジェノア領かの真実の富を減少し、他方その住民数を同一ならしめるならば、それらが遠隔諸国から供給を受けるという力を減少するならば、穀価は、この衰退の原因またはその結果として必然的にそれに伴わざるを得ぬ所の銀の分量の減少と共に下落することなくして、饑饉価格にまで騰貴するであろう。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　私にはその正反対のことが起るであろうと思われる、すなわちオランダ人またはジェノア人が一般に購買する力の減少は、しばらくの間穀価を、その輸出国並びにその輸入国において、その自然価格以下に引下げるかもしれぬが、しかしそれが穀価をこの価格以上に引上げ得るということは、全く不可能である。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "需要が増加され穀価がその以前の価格以上に騰貴し得るのは、オランダ人またはジェノア人の富を増加せしめることによってのみである。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "穀物を購買するためにオランダ人またはジェノア人は貨幣を欲し、そしてこの貨幣を得るために彼らはその余計物を売らざるを得ない。",
              "citation": {
                "source": "経済学及び課税の諸原理",
                "author": "PRINCIPLES OF POLITICAL ECONOMY AND TAXATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノバの人コロンブスでも必要ではなかつた！",
              "citation": {
                "source": "金談にからまる詩的要素の神秘性に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノア、ナポリ、マルセーユなどの一流ホテルに泊って、新航路開発の豪奢な披露宴をやっている。",
              "citation": {
                "source": "悪の花束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノアとマルセーユで同様の試みをしているうちに、予期以上のセンセーションを巻きおこし、一躍、新聞の「社交だより」の花形に成上った。",
              "citation": {
                "source": "悪の花束",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士はマルコに「お前のおかあさんはジェノア人でしょう。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノアの子が国から遠く来たからって泣くことがあるものか。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノアの児は世界にほこる子だぞ。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルコはジェノアたましいの声をきくと急に元気づきました。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああそうだ、わたしはジェノアの児だ。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェノアからブエーノスアイレスまで母親をたずねて一人で来た子です。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルコがジェノアを出た時は四月の末でしたがもう冬になっているのでした。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "大雨のためにジェノヴァとピサとの間の隧道が崩壊した、ということが旅客らに伝えられた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ガキャア／＼云ウノヲ聞イテ、颯子ガネグリジェノマヽ駈ケ付ケテ来、「レスリー、コレ！",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
