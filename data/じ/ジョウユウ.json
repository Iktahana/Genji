        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "室羅伐城の大長者の妻が姙んだ日、形貌非常に光彩あり、産んだ女児がなかなかの美人で、生まるる日室内明照日光のごとく、したがって嘉声城邑に遍かった。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "英吉利旦那は、和蘭の城邑さんなんかとはすっかり肌あいが違って、ものやさしいことが好きで、不思議にも、奴隷牧畜がきらいでした。",
              "citation": {
                "source": "ヤトラカン・サミ博士の椅子",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "時弟猾又奏曰、倭国磯城邑有磯城八十梟帥。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、高尾張邑或本云、葛城邑。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗子城邑ヲ納メラルヽモシカモ朝廷更ニ駿遠参三国ヲ賜ヒ、先祀ヲ奉ゼシム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "街衢井然トシテ商估肆ヲ列ネ隠然トシテ一諸侯ノ城邑ノ如シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「即ち我は吾民イスラエルをエジプトより導き出せし日より我名を置べき家を建しめんためにイスラエルの諸の支派の中より何れの城邑をも選みしことなし但ダビデを選みてわが民イスラエルの上に立しめたりと言たまへり。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
