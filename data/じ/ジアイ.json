        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "自愛の精神を持つことは、幸福な人生を送る上で重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "他人を愛するためには、まず自分を自愛することから始めるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は自己肯定感を高めるために、自愛の習慣を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
