        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "キミョムリョジュノライ　すると　なたねばたけの　なかに　うさぎが　いて、「こぼうず　あおぼうず。",
              "citation": {
                "source": "こぞうさんの　おきょう",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュピターとジュノーの間に生まれた息子で、美丈夫の典型とされている。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "またはジュノウのまぶたより、ヴィイナス神の息よりもなほ臈たくもありながら、菫の色のおぼつかな。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "またはジュノウのまぶたより、※イナス神の息よりもなほ※たくもありながら、菫の色のおぼつかな。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュピターの妻ジュノーの嫉妬がつのって、到頭哀れなアナキネはジュノーのために蜘蛛にさせられてしまった。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュノーとアナキネの関係が織り紡ぐ仕事における奴隷と主人との関係、義務を与えるものと、義務づけられたものとの関係を語っている。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "サミイは約一年前に、アラスカのジュノウで、アン・ルロイに逢ったもので、当時サミイは、同地の小学校で教鞭を執っていたのだが、肺病が進んで悲観しているところへ、アン・ルロイの同情が、二人の仲を友情から同性愛にまで進めたのだった。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "美人で独身のヘドウィッグ・サミュエルスンは、北ダコタ州、ホワイト・アウスの農夫の娘で、一九二五年に州立マイノット女子師範学校を出たのち、同州ランダ市の小学校に奉職し、そこからモンタナ州、ホワイトホウル小学校へ移って二年後にアラスカのジュノウへ転職したのだった。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔具合はいかがですか〕「ニエワージュノ」〔よくない〕そしたら夜室へ入って来て、何日出るかはっきりした日をしらせてくれ、新聞に出されたりするとやり切れぬ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日ピロージュノエ〔ケーキ〕なんかはグーロチナヤ〔パン屋〕の店に一つもなし。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "モージュノ、イェスチ〔食べられるか〕？",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちは文学の仕事をしているから――けれども、わたしたちはあなたがたの仕事について知りたいと思って居ります」　白黒のなりの女は、役所風に、「モージュノ（出来ます）」と云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "保が死んだとき、八月のゼラニウムが濃い桃色の花を咲かせているパンシオン・ソモロフの窓ぎわで、懇篤なヴェルデル博士が、蒼ざめている伸子の手をとって、あなたはまだ若い、生きぬけられます（モージュノ・ペレジワーチ）と云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュノネの怨みを受け、これに欺かれてゼウスの榮光を見んと願ひ、見るに及びてその身燃ゆ（『メタモルフォセス』三・二五三以下及び地、三〇・一―三註參照）七―九〔宮殿の階〕諸天。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日、ジュネーヴから後任にジュノー博士を送りたいといってきているが、アメリカ経由で来るのはいかんとかなんとかしきりに反対している始末だから」「公認慈善団体の軍の認可を得るには、どのへんへぶつかればいいのか。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙港の華盛頓大学の学生は、go-getting の気性がさかんで、加奈陀に伐木夫に傭われたりアラスカの袖珍工場へ行ったりするが、学生のシイズンは二、三日で行けるケチカンかジュノオあたりがせいぜいで、こんな荒っぽい契約に出てくる向う見ずなやつは一人もいない。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはケチカンやジュノオでさんざんやっているので、鮭時になるとすぐに高罐の罐叩きに廻ったが、どうしたものかしばらくすると、三番台のマリオという伊太公が引っこんで、そのかわりにモオリーがやって来たのにはあきれた。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしフランスがジュノオであり、フィリップが地下の王神だとすれば、その結論は火を見るより明らかではないか？",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら誰が、いくら助けを呼んでもむだだったとき、ジュノオが「天の神々に諾かれざるか、われはアケロンを嗾かさんのみ」とおしまいに叫んだことを知らないほど無知であろうか？",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイレル老人をして、自分の孫娘はリュドヴィジのジュノーに似た鼻をもってると断言させるには、彼に多く説きたてるの要はなかったろう。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "若いローマの母親はジュノ・ルキナからプローサやポルトヴォルタの14人以上の女神にお願いすると言われている（ウィジントン）。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンナノトテモ欲シインダケレド、オ高クッテ手ガ出ナイワ」ト、墺太利製ラシイベージュノスウェードノ、口金ニサファイヤノイミテーションラシイ石ガ這入ッテイルハンドバッグノ前デ、颯子ハ頻リニ嘆声ヲ発シテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、タイトル・マッチガ始マロウトスル時大層スマートナ奥サンガ一人、片手ニベージュノハンドバッグヲ持ッテ、片手ニ自動車ノキーヲ振リ廻シナガラ這入ッテ来テ隣ニ腰カケタンダソウデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧首都ジュノウの平均気温は、一番寒い一月でも、零下三・二度にすぎない。",
              "citation": {
                "source": "アラスカの氷河",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの氷河にもあるわけではないが、今いったマラスピーナ氷河や、ジュノウの近くのメンデンホール氷河には、ときどき一抱えもある大きい氷の単結晶が発見されている。",
              "citation": {
                "source": "アラスカの氷河",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンデンホール氷河の単結晶　ジュノウの近くに、メンデンホールという氷河があって、その末端は、ジュノウのごく近くまできている。",
              "citation": {
                "source": "アラスカの氷河",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
