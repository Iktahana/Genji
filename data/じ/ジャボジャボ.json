          "literary": [
            {
              "text": "じゃぼじゃぼという奇怪な音が隣室から聞えた。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は一体、どんな事をやらかして居られるのか、じゃぼじゃぼという音ばかり、絶えまなくかまびすしく聞えて来て、時たま、ううむという先生の呻き声さえまじる有様になって来たので、私たちは不安のあまり立ち上った。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、さっと浪がひいて、私はただ薄暗い湯槽の隅で、じゃぼじゃぼお湯を掻きまわして動いている一個の裸形の男に過ぎなくなりました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルソン島の南端を廻って、目的地のカシグランに着き、海軍の士官二名と陸軍のＲ大尉とが上陸するのに、僕も通訳としてついて行ったが、ここが物すごい遠浅で、ボートが砂に坐り込んでしまい、四人ともジャボジャボ水の中を歩いた。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
