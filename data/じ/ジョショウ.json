    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼らは話される対話の痕跡を歌劇から注意深く消し去って、モーツァルトやベートーヴェンやウェーバーらの作品のために、自己流の叙唱を書いた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリストフはコリーヌの批評を聞いたために、ワグナー派の朗吟法の重苦しさやまた多くの醜さなどに、いっそう敏感となっていたので、言葉と歌とを劇中で併合させ叙唱の中に結合させるのは無意味なことで自然に反する手法ではないかと、疑念をもっていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして絃をかきならしながら、押しせまるような叙唱で、諧謔をテラスへむかって投げあげる。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
