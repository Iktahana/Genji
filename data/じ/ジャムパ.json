          "literary": [
            {
              "text": "それは、ジャムパンに入っているような安いジャムではない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "苺のジャムパン飛んで来い。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　仲間の一人が、真面目な顰面をし、緑色のジャムパアの衣嚢から何か出してやった。",
              "citation": {
                "source": "七階の住人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠慮がちな物音だのに、それがいやに自分にも耳立って聞えるような明け方の電燈の下で羽織の紐を結んでしまうと、サイは立鏡を片よせて、中腰のままそのつもりでゆうべ買って来ておいたジャムパンの袋をあけた。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "建物の横手に大型トラックが来ていて、手拭で頭をくるりと包んだジャムパー姿の若い人が三四人で、トラックの上から床几をおろしているところであった。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校の時から胸をそらした覚えがないんだよ、オレは」　このジャムパーは私が昨日散歩の道でふと目にとめると、むらむらその気になつてしまつて、散々ねぎつて（但し時間的に）買つて、彼の宿へ届けて、今度くるとき着ていらつしやい、と置手紙を残してきたのだ。",
              "citation": {
                "source": "花火",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャムパンを食べ牛乳を飲んで、相応の気焔を上げる。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボサボサしたジャムパンを俺は食いはじめた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
