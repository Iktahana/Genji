        "examples": {
          "standard": [
            {
              "text": "仕事帰りに自動車教習所に通い、ようやく普通免許を取得することができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自動車教習所の教官に「S字カーブが苦手だね」と指摘され、何度も繰り返し練習した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「うわ、今日の自動車教習所の予約、もう埋まっちゃってる。早めに取っておけばよかったな」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "自動車教習所のような環状の道には徒労感が伴うし、岬の果てや盲腸線といった想像は淀みに通じる。",
              "citation": {
                "source": "鉄道模型の夜",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車教習所の貸しコースへ出かけていき、ぼくのカワサキでミーヨを大排気量車の免許試験にそなえさせるためだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、家賃がないのは助かるし、なによりもいいことには、その家から歩いて三十分ほどのところに、広い自動車教習所がある。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
