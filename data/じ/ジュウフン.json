          "literary": [
            {
              "text": "三　乱軍の中に気を失った李陵が獣脂を灯し獣糞を焚いた単于の帳房の中で目を覚ましたとき、咄嗟に彼は心を決めた。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "厚い毛皮の陰に北風を避け、獣糞や枯木を燃した石の炉の傍で馬乳酒を啜りながら、彼等は冬を越す。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこらの足痕は、狐のか狸のか、鳥糞獣糞、すべて異界のものだった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "厚い毛皮の陰に北風を避け、獸糞や枯木を燃した石の爐の傍で馬乳酒を啜りながら、彼等は冬を越す。",
              "citation": {
                "source": "狐憑",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "４．百姓は獸糞を掃除する熊手に凭れて牛小屋のなかから外を見てゐた。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
