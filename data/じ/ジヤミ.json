        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ベンジヤミン・フランクリンは僧侶さんのやうに菜食主義で暫く押し通して来たが、ある時何かの折に魚を料つてゐた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "バタ附とジヤミ附とを半斤づゝ、へい。",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤミは苺のが生憎切れまして、左様で御座いますか、どうもお気の毒さま。",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が、バタ附を買つて帰ると、ジヤミ附がいゝつて云ふんですつて。",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、ジヤミ附を買つて帰るとバタ附でなくつちやならないんですつて。",
              "citation": {
                "source": "麺麭屋文六の思案（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
