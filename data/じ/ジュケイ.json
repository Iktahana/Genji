[
  {
    "uuid": "571eafae-1fcc-5824-954c-dbed8add19d3",
    "entry": "受刑",
    "reading": {
      "primary": "じゅけい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
