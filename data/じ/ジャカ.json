        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ジャカジャカと引鳴らせ、糸瓜の皮で掻廻すだ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな中で統計技官のヘルマン・ホレリスは、紋様の織り込みを自動化したジャカード織機と自動ピアノから、統計表作りの革新のヒントを得る。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャカードも自動ピアノも、カードにあけた穴の位置によって機械の動作を制御している点に着目したホレリスは、個人のデータを一人一枚同様の穿孔カードに記入することで、集計から手作業を追放できると考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯うして聴いていると、如何しても琴に違いないと、感心して聴惚れていると、十分と経たぬ中に、ジャカジャカジャンと引掻廻すような音がして、其切パタリと、琴の音は止む……ともう茶の間で若い賑かな雪江さんの声が聞える。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではジャカジャカジャンジャンとなにか弾け」「…………」「よう。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さあさ、浮いた、浮いた、ジャカジャカジャンじゃ。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえらもその気で、もっとジャカジャカやらんといかん！",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　　　瓜や茄子の花ざかり　　　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　瓜や茄子の花ざかり　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男",
                "author": "第一話　旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャカジャン、ジャンジャンという三味線の響は、お縫の洗いものをしている土間から暗い村の夜の中へまで響きわたって行く。",
              "citation": {
                "source": "猫車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ごろ、足元の軽いひろ子でさえ、編笠をかぶり、編笠の内側に出ている編めのジャカ、ジャカに髪の根を気持わるくひきつられながら、女看守につきそわれて歩いたときは、やっぱりああいう工合に、のろく、重く、一歩一歩と歩いた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、バタビアがジャカルタに、マレイがマライにそれぞれ改名。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくの話し相手はジャカルタの観音様さ」　アンちゃんは、もはや物を言わなかった。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の中、庭先には、アメ屋や、オデン屋や、フーセン屋や、オモチャ屋などが店をだして、村の祭礼と同じようにピイピイ、ジャカジャカやっている。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "北平の陸軍刑務所を振出しにして、南京の中央刑務所、仏印のパクセ俘虜収禁所、昭南の第一拘禁所、泰緬鉄道建設で俘虜大量虐殺の問題を起している有名なタンピサヤ収容所、ジャカルタの蘭印俘虜収容所……Ｂクラスの収容所まで数えたら何カ所だったかちょっと思いだせない。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔補〕上に書いたジャガタラズイセンは爪哇水仙の意を表わしたものなれど、これは決してジャワのジャカトラの産ではなく、それはメキシコの原産植物であって我邦へは嘉永年間に舶載せられたものである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンジャカ、ジャンジャカと三味線をひく。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "じやがたらはジャカルタ。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっかり途方に暮れてしまっていると天の助けかすぐ脇の一膳めし屋へ、額へ即効紙を貼った汚い婆さんがジャカジャカ三味線を弾いて、塩辛声で瞽女唄のようなものを歌って門付をやっているんです。",
              "citation": {
                "source": "初看板",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
