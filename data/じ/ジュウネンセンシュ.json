        "examples": {
          "standard": [
            {
              "text": "あのベテラン選手は、まさに十年選手と呼ばれるにふさわしい活躍ぶりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "十年選手の投手が登板すると、球場の雰囲気がぴりっと引き締まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女はチームの十年選手として、若手に練習の心構えを教え込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "veteran (at a job)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
