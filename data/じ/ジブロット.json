        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マトロート（魚料理）にジブロット（肉料理）という名だけで知られてるふたりの女中が、ユシュルー上さんを助けて、青葡萄酒の壜や、瀬戸の皿に入れて空腹な客に出す種々な薄ソップなどを、テーブルの上に並べた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートとジブロットが彼らを迎えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブロットはジョリーとレーグルに謝意を表わして、食卓の上に葡萄酒の一瓶を添えた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブロットはグランテールを見て、食卓の上に葡萄酒の瓶を二本置いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブロット、灯を持ってこい。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「バトロート、ジブロット、ぼうグランテールに酒をどばせるな、ばかな金ばかり使ってる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "マトロートとジブロットも、人々の間に交じって働いた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブロットは漆喰の破片を運んで行ききしていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユシュルーお上さん、こないだジブロットが敷き布を窓からふるったというので、警察から調べられて違警罪に問われたというじゃないですか。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "球突場の広間では、ユシュルー上さんとマトロートとジブロットとが、恐怖のため三様の変化を受けて、ひとりは惘然としひとりは息をはずましひとりはほんとに目をさまし、古布巾を引き裂いて綿撒糸をこしらえていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
