          "literary": [
            {
              "text": "こんなことなら電気メスを持ってくるんだった……」　といっているとき、ジジジーンと、壁にかけてある大きなベルが鳴りひびいた。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、またベルがジジジーンと、喧しく鳴った。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジジーンと、突然玄関のベルが鳴った。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれは脳髄がジジーンと痛みを覚えたばかりだった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして玄関脇の押し釦を少年の指先が押すと、奥の間のベルが喧しくジジーンと鳴るであろう。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちの車の硝子が、護謨毬をたたきつけたかのようにジジーンと音を立てた。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
