        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "両国は、平和維持を目的とした新たな条約を締結した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "条約の内容を詳細に検討し、その義務を理解する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "歴史上、多くの条約が世界の秩序を形成してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "この国のブルジョワと支那の新政府の間には近く提携と一つの目標をもった条約が結ばれるであろう。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀色の絞られた水平線まで彼女は片脚あげて、恋愛の条約による奥の手を英介氏にひらめかすのであった。",
              "citation": {
                "source": "職業婦人気質",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の女房との条約に基いて、店の狐は翌日から姿を隠してしまった。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "条約による土地委員会とチーフ・ジャスティスとは、間もなく任期を完了するでしょう。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この媾和条約違反から、夏の陣が起るのであるが、惣堀だけを潰す約束であったのに、二の丸三の丸の堀まで潰したので、大阪方が憤慨したと云う説、いや初めから二の丸三の丸を潰すことを大阪方も認めていたと云う説もあって、決しがたい。",
              "citation": {
                "source": "大阪夏之陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が、沼田の城代となった猪俣範直と云う武士が、我無しゃらで、条約も何にも眼中になく、真田領の名胡桃まで、攻め取ってしまったのである。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "太閣は、北条家の条約違反を怒って、遂に小田原征討を決心したのである。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "安政元年ペルリは再び浦賀に入港して、前年提出した通商条約の国書の返答を求めた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "終に日米間に神奈川条約が締結され、下田及び函館の二港が互市場として開かれて、安政三年には米国領事ハリスが、米国旗を掲揚して下田に駐在した。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "同四年には江戸、大坂、兵庫、新潟の四港を開くことが約され、同五年には、イギリス、ロシア、オランダ、フランスとの通商条約が結ばれた。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、将軍継嗣問題と通商条約問題とでは、井伊の傲岸不遜は言語に絶した。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の輿論たる一橋｜慶喜を将軍世子に就けることに反対して、紀州｜慶福を推したことと、勅許を待たずして日米条約に調印したことである。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶然ふたりが出会った『緋のエチュード』のあの頃から、国家間の深刻な紛争を防ぐという申し分ない首尾の「海軍条約事件」に乗り出したこの頃に至るまで。",
              "citation": {
                "source": "最後の事件",
                "author": "THE FINAL PROBLEM",
                "note": "青空文庫"
              }
            },
            {
              "text": "日米安全保障条約を結び、核兵器を大量に持つアメリカと軍事同盟関係にあることとの整合性を考慮して、政府、外務省はこれまで、核兵器の違法性に言及することを避けてきました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本は、著作権保護の国際的な枠組みであるベルヌ条約に加盟している。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "条約では、著作財産権の保護期間は作者の死後五〇年までとされており、我が国の著作権法もこれにそっている。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "保護期間には、「３世代が含まれるのが公正妥当」とする考え方は、『ベルヌ条約逐条解説』（クロード・マズイエ著、黒川徳太郎訳、著作権資料協会、一九七九年七月二五日発行）においてＷＩＰＯ国際事務局著作権、広報ディレクターの肩書を持つ著者が示している。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ベルヌ条約逐条解説』に寄せた序文で、ＷＩＰＯ事務局長アルパード・ボグシュは、「ＷＩＰＯ国際事務局の任務は条約の管理に責任を負うことであり、このような解説を行うことはその権限に属するものではないから、本書はベルヌ条約の規定に関する有権的解釈を意図するものではない。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、我が国は、平和条約に基づいて定められた戦時加算により、連合国民の著作権については、すでに「死後50年」を越えて保護している実態があることから、この問題を整理しつつ保護期間の延長を図るべきである。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルヌ条約では、著作権の保護期間は作者の死後五〇年までとされている。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルヌ条約では、保護期間に異なりのある場合には、短い国の規定が適用されると定められている。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ日本に義士なき乎、ああこの国辱を雪がんと欲するの烈士、三千七百万中｜一人も非ざる乎、条約改正なき、また宜なる哉と、内を思い、外を想うて、悲哀｜転輾、懊悩に堪えず。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風な彼女は、自ら求めることがなくて単に公然の条約の下でさへあれば、全く遊女の如き無貞操観念に支配されてゐるのであつた。",
              "citation": {
                "source": "小川の流れ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国の独立戦争もレキシントンから巴黎条約までが七年間である。",
              "citation": {
                "source": "二十五年間の文人の社会的地位の進歩",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポーツマウスの条約に挙国の不平が沸騰した時に偶然東京朝日の編輯局で書いた「ひとりごと」と題する桂首相の心理解剖の如きは前人未着手の試みで、頗る読者に受けたもんだ。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "国際公法だの仲裁条約だのというはまさかの時には何の役にも立たない空理空文である。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして此列國同盟の鎭壓條約は、屡々提議されましたが、曾て成立したことはありません。",
              "citation": {
                "source": "A LETTER FROM PRISON",
                "author": "‘V NAROD’ SERIES’",
                "note": "青空文庫"
              }
            },
            {
              "text": "國内ノ革命黨ハ依然トシテ志ヲ得ズ、露國又依然トシテ強大ヲ維持シ講和條約ハ單ナル休戰條約トシテ調印セラレタリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "石、金屬或は木に法律、條約、戰勝のことどもが彫り付けられる場合の如きである。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の次第に付、外國軍艦は一と先づ大阪表引拂候得共、右御條約御許容と申義一應被仰出は御座候とも、此迄の御條約面御改、且兵庫も御開港被成間敷趣に候得ば、其分にては外國にて決して承伏仕間敷、又々不遠内、事件指起可申、詰りの所、唯今より愚察仕候に、公武の御間柄、此儘に御合體相成間敷哉に奉存候。",
              "citation": {
                "source": "御時務の儀に付申上候書付",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
