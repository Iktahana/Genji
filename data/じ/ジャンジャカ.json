        "examples": {
          "standard": [
            {
              "text": "太鼓をじゃんじゃか叩いてお祭りを盛り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちがピアノをじゃんじゃか弾いて遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "隣の部屋からじゃんじゃかギターの音が聞こえてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "若い女が五、六人、真赤な着物を着て、おでんの入った鍋の向うに坐り、じゃんじゃかじゃんじゃかと三味線をひっぱたくのである。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "和泉橋の脇にある観水楼とかいう二階造りの料亭で、芸妓も十人ばかり来て、じゃんじゃか騒いだ。",
              "citation": {
                "source": "思い違い物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
