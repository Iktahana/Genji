        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一八二〇年か二一年ごろ、アントレピードという小さな定期｜編纂物を当時編集していたジャンリー夫人が、プティー・ピクプュスの修道院の一室にはいりたいと願ってきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンリー夫人は小説を書いたことがあったのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャンリー夫人は迷信家でまたラテン語学者であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "四つと四つはジャンリー夫人の音であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
