[
  {
    "uuid": "b6b1730a-1b23-5ef2-abc9-dd08785ee019",
    "entry": "実弟",
    "reading": {
      "primary": "じってい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "biological younger brother",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私には実弟が一人おり、彼とはとても仲が良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、実弟の大学の学費を援助している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "実弟が家業を継ぐことになり、家族みんなで喜んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "菊五郎の実弟にて和事を得意としていたるが、晩年は団十郎張りとなりて評判よく、その死は楽屋の内外に惜しまる。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "俊雄君は、鈴岡さんの実弟だ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実弟のハリー・ピナーが発起人で、分担額に従い社長として取締役会に参加しており、自分がこちらへ渡っているのを知ってましたから、いい人間を手頃に見つけてくれと。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "当代よりは廿六世以前、山城国延暦寺乗運公の実弟、増誉上人といふ人がこの沼津の地に来り、以前鬱蒼として茂つてゐたと伝へらるゝ松原が相模の北条と甲斐の武田との戦ひの戦略から一本残らず伐り払はれ、見る影もない荊棘の曠原となつてゐたのを嘆き自ら植樹に着手した。",
              "citation": {
                "source": "沼津千本松原",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺子を中心として野枝さんの伯父さん老夫妻と大杉の実弟と、大杉の異体同心たる数四の同志に守られていた。",
              "citation": {
                "source": "最後の大杉",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "火事の際に焼け死んだ看護婦長の黒焦になった屍体を何時迄も記憶から除く事の出来ない私に取って、婦長の実弟である若い薬剤師と時々顔を合せるのは随分とつらい刑罰であった。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらが、私の実弟で洋吉と申します。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ宜しく」　キャプテン深谷氏の友人黒塚と云うのは、見たところまだ四十を五つと越していない、かっぷくのいい隆としたアメリカ型の紳士で、夫人の実弟洋吉と云う方は、黒塚氏に較べて体も小さく年も若く色の白い快活そうな青年だ。",
              "citation": {
                "source": "死の快走船",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、道補の実弟に、奥州｜金華山の住職をしている人があって、是非私を貰いたいといい込んで来ました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "私の子供の時のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち一郎妻とし子の実弟であります。",
              "citation": {
                "source": "ある抗議書",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は角野一郎の妻の実弟です」と、云いました。",
              "citation": {
                "source": "ある抗議書",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "俊夫君の推定のごとく、主犯人は遠藤博士の実弟で、某強国から多額の金を貰って毒瓦斯の秘密を奪うために、書生の斎藤を買収して博士を殺したのだと白状したそうです。",
              "citation": {
                "source": "髭の謎",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔父は園田孫兵衛と言いて、文三の亡父の為めには実弟に当る男、慈悲深く、憐ッぽく、しかも律義真当の気質ゆえ人の望けも宜いが、惜かな些と気が弱すぎる。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "京都の西川一草亭氏は、相馬御風氏の論文を見て、こんなに始終人生の事ばかり考へて居ては、嘸肩が凝つて溜るまいと、自分の実弟で予て相馬氏と知合の津田青楓に訊いてみた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "市原は、神戸で相当な請負業を営んでいる彼女の実弟であった。",
              "citation": {
                "source": "墓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が窪から来る原田夫婦や、未亡人の実弟桜井｜須磨右衛門は、いつもそれを慰めようとして骨を折った。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなった三右衛門がためには、九つ違の実弟である。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "実弟須磨右衛門は親切にはしてくれるが、世話にばかりなってもいにくいので、未亡人は余り忙しくない奉公口をと云って捜して、とうとう小川町｜俎橋際の高家衆大沢｜右京大夫基昭が奥に使われることになった。",
              "citation": {
                "source": "護持院原の敵討",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田は私の実弟で、あの家の養子に行ったのです」「そうですか、それはお気の毒でした。",
              "citation": {
                "source": "彼は誰を殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに宗十郎の実弟には、評判の高い田之助があったし、有明楼は文人画伯の多く出入した家でもあったので、お菊はかなりな人気ものであった。",
              "citation": {
                "source": "明治美人伝",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "右につき本社は各方面に向つて精探せし結果、婦人は麻布区宮村町六七正二位勲一等伯爵枢密院副議長芳川顕正氏養子なる子爵曾禰安輔氏の実弟寛治氏の夫人鎌子（廿七）にして長女明子あり、男は同邸の自動車運転手倉持陸助（廿四）なることを突止めたり。",
              "citation": {
                "source": "芳川鎌子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "［自注２］叔父上――顕治の父の実弟、山口県熊毛郡光井村にすんでいた。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "時に本塾の教員｜小幡仁三郎小幡篤次郎の実弟。",
              "citation": {
                "source": "故社員の一言今尚精神",
                "author": "福澤諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュッド医師の実妹ケリイ・ジュッドというのが玄関に現れて、何ら隠すところなく兄のジュッド医師と、その義弟――ルウス・ジュッド夫人の実弟――バアトン・マッキンネル青年とが、丁度家に居るというのだ。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず岩村県令も同志社の親分株の林有造氏の実弟であるから、これもその主義は頗る賛成であった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時、公暁を勤めて居た先代尾上菊五郎は、実弟坂東家橘の、思ひがけない死に目に逢はねばならなかつた。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋本の嗣子が亡くなったので、実弟の谷さんを順養子にして、いさちゃんを妻わしたのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋本の敬さんが、実弟の世良田某を連れて来た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "社長の実弟で低能に近い、「分家さん」と呼称するところの重役は、私をうっとしい娘だと云った。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、実際は親分ではなくて、親分の実弟だそうだが、私の聞きちがいか、紹介者が面倒がって端しょッて教えたせいか、私は熱海の大火まで、なんとか組の親分ズバリだと思いこんでいた。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
