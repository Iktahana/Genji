  {
    "uuid": "d916a09c-70f6-5cdc-ac4b-1f5250c95120",
    "entry": "純心",
    "reading": {
      "primary": "じゅんしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
