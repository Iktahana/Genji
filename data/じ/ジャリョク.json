          "literary": [
            {
              "text": "しかるにその人の眼、第一に女陰の方へ惹かれて、邪力幾分か減散すれば、次に寺院を睥んでも、大事を起さぬ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "節分の夜、豆｜撒くなども、鬼が無数の豆を数え拾う内に、邪力衰うべき用意であろう。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "庚申堂に捧ぐる三角の袋｜括り猿など、パンジャブ辺でも邪視を防ぐの具で、一つは庚申の避邪力を増さんため、一つは参詣者へ庚申の眼毒が強く中らぬべき備えと知らる。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
