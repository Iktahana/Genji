    "definitions": [
      {
        "index": 1,
        "gloss": "gesture",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "言葉が通じなくても、ジェスチャーを使えば意思疎通ができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のジェスチャーはオーバーで、いつも皆を笑わせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はさりげないジェスチャーで、私に助けを求めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、その物悲しい表情というのは、あきらかにジェスチャーであり、母に対する思慕など、少しもなかった。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日でも邪視にたいしてイタリアで使われている「コルナ」は人差し指と小指を立てて中指と薬指をたたみそこへ親指を添えるジェスチャーであって、ローマ人がレムーラーリア（＊死者の霊を追い出す祭り）で使ったものである。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋは、前に乗り出してその両手を眼から離さなかったけれども、そのジェスチャーの意味はわからなかった。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中ベルギー大使館の手前で外人に英語で道を尋ねられ、不器用なジェスチャーで迎賓館の方向を示した。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その傍らで、一人の男が、様々なジェスチュアをもつて何事かを物語つてゐる。",
              "citation": {
                "source": "Ｒ漁場と都の酒場で",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "終章のモラルも、ジェスチュアが目立って甘たるい。",
              "citation": {
                "source": "今日の作家と読者",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェスチュアでなく民主化を実現する政府を。",
              "citation": {
                "source": "民主戦線と文学者",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "共産党は、対外的なジェスチュアとしてだけ文化綱領をかかげ、文化政策を云々しているのだろうか。",
              "citation": {
                "source": "孫悟空の雲",
                "author": "――『近代文学』十月号平野謙氏の評論について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一様に日傘をささないというようなことは、外見の上では一つのジェスチュアであるけれど、健康の上にどれだけ有益なのだろう。",
              "citation": {
                "source": "女の行進",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は、憎らしいから、うんと憎らしい顔をしてみせるので、ここいらでこんな顔も見せておこうという意識されたジェスチュアはない。",
              "citation": {
                "source": "子供の世界",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "心に恃むところがある、ということをジェスチュアとして持っている文章である。",
              "citation": {
                "source": "今日の文章",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、ジェスチュアの多い、勇ましい、そしてわかりやすい文章の続出という時代的な潮流に或る刺戟をうけつつ、その傾向とは異って、学問的に解決して行こうとする努力を示しているのである。",
              "citation": {
                "source": "今日の文章",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "帆村はジェスチュア交りで、一語一句をハッキリ読みあげていった。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニオが壇上で大きなジェスチュアをする。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええおい、まったくこれはばかばかしいことじゃないか」　とポールが大きなジェスチュアをしながらペンをそそのかすように言った。",
              "citation": {
                "source": "十八時の音楽浴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、ユリのジェスチュアは云々。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ジェスチュア※　そう思う。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の生活は、両脚を手拭でしばってピョンピョンとびする遊戯のようにその間をとんで来ているわけですが、この頃では手拭をほどいてかけ出そうとはせず、手拭はつけたまま、そっちへひとの目も自分の目もやらないように顔や両手でいろんなジェスチュアをする。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "表現とジェスチュアとの区別、見さかいを失った鈍感さ、として。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆者はたっぷり、いい気持に、一種調子の高いジェスチュアをも加えて文章を進めているのであった。",
              "citation": {
                "source": "信義について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このジェスチュアは東條自身にとって、一層世界の憎悪を集め、検事団の道義的憤怒をそそった。",
              "citation": {
                "source": "平和への荷役",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍人としてさえ恥を知らないジェスチュアによって東條の人気を挽回することで、その努力の一歩前進させることを期待したファシズム勢力があることこそ、わたしたちの警戒しなければならない最大の危険である。",
              "citation": {
                "source": "平和への荷役",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あら尊と音なく散りし桜花」という東條英機の芭蕉もじりの発句には、彼の変ることない英雄首領のジェスチュアがうかがわれる。",
              "citation": {
                "source": "新しい潮",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルーマンが公約した民主的政策が実現されるか、それともブルジョア政党らしいジェスチュアに終るかということに対して注目し監視しているのは、アメリカの民衆ばかりではないのである。",
              "citation": {
                "source": "現代史の蝶つがい",
                "author": "――大統領選挙の感想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらゆる国の人民にとって「平和」はジェスチュアではない。",
              "citation": {
                "source": "いまわれわれのしなければならないこと",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェスチュアでない世界平和と民主的社会の建設のために誠実な努力をつづけている世界のすべての人がＭＲＡの本体を見きわめているこんにち、片山哲氏が大財閥の三井一門とコーでもてなされて「ＭＲＡの機動部隊を日本に派遣されたい」と切望しているのは、チルチル、ミチルの旅にしては人民に対する罪がふかすぎる。",
              "citation": {
                "source": "再武装するのはなにか",
                "author": "――ＭＲＡについて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家であるわたしが、指導的なジェスチュアなどというものを知らず、同志とよばれるものの具体性さえ知らないで、未熟さをむき出しに心情的に行為したことについて、十六年後のこんにち、わたしはなお、いくつかの感想を抱いている。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第十巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さい門、リラの茂、薄黄色模様の絹の布団、ジャケツ、黄色のクッションにもたれて欧州婦人のジェスチュアをする五十五歳の光子クーデンホフ夫人。",
              "citation": {
                "source": "無題（八）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああいうところの奥様ポーズというもの、帳場の奥様ジェスチュアと同一である。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯村という爺、拒絶のジェスチュアたっぷりで、一寸すみっこに永く人と居たりしていないようにしている。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
