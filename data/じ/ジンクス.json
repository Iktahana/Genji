        "examples": {
          "standard": [
            {
              "text": "試合前に新しいスパイクを履くのは彼のジンクスで、ずっと勝ち続けていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「13日の金曜日に大事な決断をしない」というジンクスを長年信じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "連勝中の選手が同じユニフォームを洗わないのはよくあるジンクスだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "作中の主人公の名前にも、運と不運があるという一種の妙なジンクスを私は決して信じないが、語感のよかったことは確かであろう。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
