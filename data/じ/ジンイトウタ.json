        "examples": {
          "standard": [
            {
              "text": "「人為淘汰」（人工淘汰）は、自然淘汰とは異なるプロセスだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "農業では、病気に強い品種を選ぶ「人為淘汰」（品種改良）が行われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「人為淘汰」（人工選択）によって、生物の進化が加速されることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "農産物や養蚕や家畜は人為淘汰に関する農業技術を抜きにしてはそれ自身不可能な存在だし、又工業技術を離れて今日の農村生活を生活することは出来ない。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
