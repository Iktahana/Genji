[
  {
    "uuid": "1b956fb6-9e1e-54bf-a410-ea86ea585ff3",
    "entry": "上善",
    "reading": {
      "primary": "じょうぜん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
