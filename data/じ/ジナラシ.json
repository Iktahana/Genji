[
  {
    "uuid": "4757450f-f582-5fc4-ae14-f32a35bfd9d1",
    "entry": "地ならし",
    "reading": {
      "primary": "じならし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
