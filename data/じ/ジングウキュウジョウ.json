        "examples": {
          "standard": [
            {
              "text": "神宮球場のナイターは雰囲気が独特で、球場飯も美味しいと評判だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "東京六大学の早慶戦が神宮球場を埋め尽くしたファンの前で繰り広げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ヤクルトの本拠地である神宮球場は都心にある貴重な屋外球場だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが少年の日の寝床に溢れたあの終わりを恐れる涙を、一九九〇年七月十一日、神宮球場脇のイベント会場、ＴＥＰＩＡで開かれたマイクロソフトワークス（以下ワークスと書く）の発表会場で、なんとオレはまざまざと思いだしてしまった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそれを神宮球場へ見物に行った。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの広い神宮球場に、見物人は私ひとりである。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかく、神宮球場でたった二人で野球を見物したのであった。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "真向から吹きつけてくる青く透きとおった風を感じながら、耳のなかに、かつて通った神宮球場の歓声や選手たちの掛声をよみがえらせ、怒ったように力いっぱいぼくは投げつづけた。",
              "citation": {
                "source": "煙突",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
