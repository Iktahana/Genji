[
  {
    "uuid": "f0f54d81-865f-5259-adbd-710c2988b640",
    "entry": "叙情詩",
    "reading": {
      "primary": "じょじょうし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
