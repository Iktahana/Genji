[
  {
    "uuid": "9e69118b-48dd-5b4b-8cbf-e8aa21cb1d6b",
    "entry": "地団駄",
    "reading": {
      "primary": "じだんだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
