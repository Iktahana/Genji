    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フォックストロット、ジダンダ、ステップせよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "警察で勘当の話をつけてもらう」　平作はジダンダふんで警察へ戻ってきたのである。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで格闘するように、全力をこめて、ジダンダふんだ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　正宗菊松の眼はランランとかゞやき、髪はみだれ、神の怒りが乗りうつったように、はげしくジダンダふむ。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "光子はジダンダふんだ。",
              "citation": {
                "source": "投手殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　一寸法師が立ち上ってジダンダふんで怒りだした。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "怒りがなかなかとまらぬらしくアチコチ駈けずりまわってはジダンダふんでいる。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なんだい、ジダンダふんだって一メートルじゃアはえないや。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうしてみると、動機の上でも位置からでも辰男が最有力の容疑であるが、糸子の嘲りに対してジダンダふみ駈けまわって必死にこらえていたあの有様はどう解釈すべきだろうか。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろあのジダンダはとうてい殺人のできない弱気な小心な性格を現しているのではなかろうか。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "九太夫はあのジダンダになんとなく好意をいだいているのだ。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻はジダンダふんだが及ばなかった。",
              "citation": {
                "source": "能面の秘密",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
