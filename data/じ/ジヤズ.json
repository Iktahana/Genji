        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "踊り手の立込んで来る夜の九時十時になると、急ぎ立てるやうなジヤズと、目間苦しく回転して行く幾十組かの男女の旋回が、彼の神経を疲からせた。",
              "citation": {
                "source": "老苦",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶蝶がジヤズでお飛びだ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "向ひのラヂオが賑かだ、どこからかジヤズのリコードが響いてくる、ジヤズ／＼ダンス／＼、田舎の人々でさへもう神経衰弱になつてゐる。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "と決心すると、胸一杯にけたゝましいジヤズが巻き起つた。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などゝいふ合唱が繰り返されるジヤズ・ソングを歌ひながら、マメイドといふ、ちよつと美しい娘がゐる居酒屋を出発点にして賑々しく発足した。",
              "citation": {
                "source": "喜劇考",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "◇　若し、日本音楽を愛し、歌舞伎劇を愛し、紫の色を愛で、白緑の色を好み、紺蛇の目を好き而も、近代ジヤズに魅力を感ずる女性あらば、如何なる香水がふさはしいか。",
              "citation": {
                "source": "「香水の表情」に就いて",
                "author": "――漫談的無駄話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑沓の人混のなかを歩いてゐると、あちこちから洩れてくる雑音のなかに、奇妙に哀しい調子をもつたジヤズのギターの音がある。",
              "citation": {
                "source": "火の子供",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤズの音に踊らされて地上を飛び歩くやうな奇妙に哀しい切ない恰好は無数の泣号のなかから湧いて出た一つの幻かもしれない。",
              "citation": {
                "source": "火の子供",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "説教源氏節は誰が何と言つても、名古屋のもので、名古屋情調をたつぷり持つたものだが、今はもう、安来節などに押されて、大須から程遠からぬ旧末広座を活動小屋にした松竹座で、アメリカ本場に劣らぬジヤズが聞けるなど、時の力は恐ろしいものである。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤズが僕の感覺の上に生まの肉を投げつける。",
              "citation": {
                "source": "不器用な天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤズが僕の咽頭をしめる。",
              "citation": {
                "source": "不器用な天使",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "表通りのレコード屋であらう、和製ジヤズの胸につかへるやうな騒音が、ひとしきり彼を焦ら立たせた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和戦前、ジヤズ化された阿呆陀羅経は「笑の王国」が採上げて、渡辺篤三益愛子の両君が歌つた。",
              "citation": {
                "source": "寄席風流",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "マニラはジヤズが多く、メルボルンは合唱や獨唱が多い。",
              "citation": {
                "source": "ラヂオ閑話",
                "author": "成澤玲川",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りにまた、基地立川のあくどいネオンとジヤズが、夜々、混血兒の數を加へてゆく世代にもなつてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "河童戯言　近頃の流行兒は、ジヤズの新人と、河童ではないかとおもふ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤズ界は、黎明的なバンド陣を展開して、いまやぼくらの古いジヤズ觀念では語れないものになつてきたが、スター河童氏となら、一語を交じへるぐらゐな資格が、ぼくにだつてあるかもしれない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また歐米文化が氾濫し、ジヤズとか、銀座街の緩んだ雰圍氣が社會に瀰漫した時代には、これではいけないといふ反省から宗教的に心が動いて、親鸞、法然、弘法といふ人たちが小説や、劇となつたと思ふのである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれを題材にしようと思つたのは滿洲事變より少し前で、ジヤズとかデカダンの風靡した時代で、私は前にも述べた通り意識的に「よし俺は野性を書かう」と思つたのである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて、自分たちの周圍にジヤズが横溢した時、祖先の生活を振返らうぢやないか、俺たちの祖先は國難に遭つた際どう切拔けたか、自分自身の修養鍛錬といふものにどれほどの力をもち、どれほどの生命力をもつてぶつつかつたか、それを振り返るために書き出したのが、あの宮本武藏といふ相當野性な男のことであつた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
