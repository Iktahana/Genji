        "examples": {
          "standard": [
            {
              "text": "実業団体が主催する全国大会に、地域の企業代表チームが参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "実業団体の会員企業は500社を超え、業界全体の意見を代表する力を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "実業団体の方針に従い、全加盟企業がデジタル化推進に取り組むことが決められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "さて私は米国へ行て六ヶ所の大学で講演し、その外、教育会、婦人会、実業団体等、様々の会へ招待されて演説し、一切で百四十四回演壇に立った。",
              "citation": {
                "source": "人格を認知せざる国民",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ実に法典実施延期論の開戦であって、英法派は法学院を根拠として戦備を整え、仏法派は明治法律学校を根拠として陣容を整え、双方とも両院議員の勧誘に全力をつくし、或は意見書を送付し、或は訪問勧説を行い、或は商工会その他の実業団体より請願書を出さしめなどした。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
