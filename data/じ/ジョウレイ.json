        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は、悪霊を払い清めるための浄霊の儀式を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "寺院では、定期的に信者たちのための浄霊が行われています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「うわ、ちょっと怖い話なんだけど、昔、うちの近所で浄霊してもらったんだって。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その景色の素晴らしさは実に今眼に見るがごとく豪壮雄大にして清浄霊妙の有様が躍々として湖辺に現われて居る。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
