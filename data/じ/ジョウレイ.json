        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "市は、騒音に関する独自の条例を制定しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この地域では、建物の高さに関する条例が厳しく適用されています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この町って、夜遅くになると窓を開けちゃいけない条例があるんだって。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
