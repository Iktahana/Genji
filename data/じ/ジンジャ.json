  {
    "uuid": "9f4782a3-4b63-50c3-82a5-61e7c10602af",
    "entry": "ジンジャ",
    "reading": {
      "primary": "じんじゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二　ロバータ　前に見た「コンチネンタル」と同じく芸人フレッド・アステーアとジンジャー・ロジャースとの舞踊を主題とする音楽的喜劇である。",
              "citation": {
                "source": "映画雑感（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれから多賀ちゃんと池袋で会って、有楽町へ出てフレッド・アステアとジンジャ・ロージャースの「カッスル夫妻」というのを（映画よ）観ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○ジンジャービスケットは玉子三個、砂糖四杯、バター大匙三杯、を能く掻混ぜ生姜粉大匙一杯半、メリケン粉大匙十杯、ベーキングパウダー茶匙二杯、モラッセス即ち砂糖蜜大匙四杯を加えて能く混ぜ牛乳を入れて好い加減にこね展し棒にて延ばし前法の如くに焼くなり。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "レモンとかバニラとかアマンドとかジンジャとかシンナモンとかナツメッグとか興奮刺撃の性質の物を使ったりライスカレーなぞを食べるのは皆んな胃を刺撃させるためです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の照明が消されると、たちまちその上に小卓と椅子が押し出されて、そこで一組の男女がジンジャア・エールを飲みだした。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "この塩はビスケットや生姜パン（ジンジャー・ブレッド）のパン屋さんたちもまた主として使っている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "まどのうえに　かかげられた　なまえは　〈ジンジャー＆ピクルス〉。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは　ちっちゃな　ちいさな　おみせで、　ちょうど　おにんぎょうに　ぴったりの　おおきさ　――　ですから　リュシンダと　かぽうぎジェーンは　いつも　〈ジンジャー＆ピクルス〉で　こまごましたものを　かいこんでいました。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジンジャー＆ピクルスでは　あかみずたまの　ハンカチが　どうか１まいと　せいどうか３まいで　うられています。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジンジャー＆ピクルスとは　おみせを　いとなんでいる　ふたりの　おなまえです。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジンジャーは　ちゃトラの　オスねこで、　ピクルスは　テリアいぬ。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみせの　ひいきには　ハツカネズミも　いたのですが　――　そのこたちだけ　ジンジャーを　どうも　こわがっていて。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　ジンジャーの　へんじは　おもくるしい。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　ジンジャー＆ピクルスでは　どこまでも　ツケが　ききました。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジンジャーと　ピクルスが　こわくても　それでも。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっと　おしはらいが　ないので、　ジンジャーと　ピクルスは　うりものに　てを　つけて　たべるしかありません。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピクルスは　ビスケットを　たべ、　ジンジャーは　タラのひものを　くちに　しました。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひげひげサミュエルに　もう１ど　おかんじょうを　おくってみよう、　ねえ　ジンジャー、　ベーコンの　ツケが　はくどうか２２まいと　どうか９まいぶんも　ある。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　かえすのは　ジンジャーだ。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と　かえす　ジンジャー。",
              "citation": {
                "source": "ジンジャー＆ピクルスのはなし",
                "author": "THE TALE OF GINGER AND PICKLES",
                "note": "青空文庫"
              }
            },
            {
