        "examples": {
          "standard": [
            {
              "text": "青年期は、情緒不安定になりやすい時期ですが、成長の証でもあります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、別れた恋人のことを考えて、情緒不安定になっているようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "情緒不安定な状態が続くと、日常生活に支障をきたすことがあります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "情緒不安定が目立つようになり、不安感や鬱病に似た症状にとりつかれ始め、記憶喪失よりもそちらのほうが、治療の対象としては重要になった。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "記憶が戻ってから、一時、マーシアは情緒不安定のきわみにあったという。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
