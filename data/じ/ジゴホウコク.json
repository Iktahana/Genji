        "examples": {
          "standard": [
            {
              "text": "急ぎの案件だったので、上司には事後報告で済ませてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "事前承諾なしに進めるのはいいが、必ず丁寧な事後報告を忘れないでくれ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "トラブルの対応に追われ、結局クライアントへの連絡は事後報告となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "四年前、京橋際のビルディングの一室を借りて、好日書院という特殊出版を初めた時でも、私など一言の相談も受けず、更に驚いたことには夫人へも一言の相談もなく、みな事後報告に過ぎなかったのである。",
              "citation": {
                "source": "十一谷義三郎を語る",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると忽ちＳ子さんとごたごたして、私の知らないところで進捗して、事後報告をされて、Ｓ子さんは下宿代が送られなくて家がなくなったとさわいで、目白へ一緒に来たわけです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "広瀬さんは社長室へ来て、事後報告をして行った。",
              "citation": {
                "source": "人生正会員",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "事後報告で簡単に済ませた。",
              "citation": {
                "source": "ロマンスと縁談",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
