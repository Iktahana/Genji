        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "煙草屋の二階の窓には、その時、たじたじとよろめくような大きな人影がうつったかと思うと、ゆらめきながらその影法師はジャリーンと電気にぶつかり、途端に部屋の中が真ッ暗になった。",
              "citation": {
                "source": "銀座幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とジャリーン伊集院、捨て身に流して払ったが、颯と左へ飛び退いた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "包囲された山影宗三郎　一人の敵を袈裟掛けに、切って落とした宗三郎、そこを目掛けてもう一人の敵、突いて来たやつを太刀を廻し、ジャリーンとばかり横へ払った。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
