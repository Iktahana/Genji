        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お前のお母さん（お民）もあれで痔持ちだが、このおれの清々したこころもちを分けてやりたいようだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも痔持ちというやつは、自分ながらむつかしい顔ばかりしていて、養子（正己のこと）にはきらわれどおしさ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分痔持ちなのだろう。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "その証拠に殆んど過半は痔持ち疝気持ちです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "船中、一個の蒲団付きまたはトウ付きの椅子、腰掛けのなきには、痔持ちの拙者は閉口した。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
