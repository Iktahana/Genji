        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国会では、新しい法案が上提され、審議が開始されました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "議員は、国民の声を反映した法案を上提することを目指しています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この問題について、早急に議論を深めるため、関連法案を上提する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その式台を上った所に、突棒や、袖搦や刺股や、また古ぼけた馬上提灯などが、並んで懸けてあった昔なら、私でもまだ覚えている。",
              "citation": {
                "source": "硝子戸の中",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学の大衆性と云っても、科学の啓蒙活動と聞いても、丁度日本の議会に婦選案を上提するようなものであったものだ。",
              "citation": {
                "source": "最近日本の科学論",
                "author": "――緒論の部―一般的特色について――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
