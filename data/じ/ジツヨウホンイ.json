        "examples": {
          "standard": [
            {
              "text": "彼の語学学習は実用本位で、文法の細かいルールより会話で通じることを最優先にしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "実用本位の家づくりを希望する施主に、設計士はシンプルで動線の良い間取りを提案した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "そのブランドは装飾を排した実用本位のプロダクトで支持を集め、ミニマリスト層に人気がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "品物について考へてみても、物の利用価値といふことはもちろん第一に計算に入れなければなりませんが、あまり実用本位といふことにのみ気を取られ、文化価値を全く閑却したものは、いはゆる殺風景となるのであります。",
              "citation": {
                "source": "文化とは",
                "author": "――力としての文化　第一話",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
