[
  {
    "uuid": "046a28c8-c515-5580-891f-c3096b78e777",
    "entry": "準縄",
    "reading": {
      "primary": "じゅんじょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "a level and inked string",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先代の教えを人生の準縄として、彼は困難な状況でも迷うことなく突き進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "学術的な研究においては、客観的な事実こそが判断の準縄となるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "社会人としての行動が、公序良俗の準縄を逸脱しないよう常に自戒している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "瓜核顔の、鼻の準縄な、目の柔和い、心ばかり面窶がして、黒髪の多いのも、世帯を知ったようで奥床しい。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰が度量を定めたりしや、誰が準縄を地の上に張りしや」は地の目方、長さ、幅等を汝が与り知るや、人知の微弱なる到底これを知る能わず、ただ地を造りし神のみ知るとの意である。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "読書の量の程度が人間の人格の準縄の一つである。",
              "citation": {
                "source": "家庭の読書室",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "――規矩準縄△規――円くするブンマハシ△矩――四角にする定木△準――平坦にする定木△縄――直くする器　そんなことが書いてあつた。",
              "citation": {
                "source": "極夜の記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然の情｜合から流れる相互の言葉が、無意識のうちに彼等を駆つて、準縄の埒を踏み超えさせるのは、今二三｜分の裡にあつた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然の情合から流れる相互の言葉が、無意識のうちに彼等を駆って、準縄の埒を踏み超えさせるのは、今二三分の裡にあった。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十にして惑わずというのは孔子さんが定めた古い規矩準縄でない。",
              "citation": {
                "source": "四十不惑",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "平明な朝の光の中に、平次の顔の穏やかさ、夜店物のケチな盆栽ばかり集めて、その規矩準縄にはまらぬ、勝手な発育を楽しむ平次の心境には、岡っ引らしさなどは微塵もありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "欄干の死骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "文法は国語のありのまゝの整理でなくして、国語を理想的に整理する規矩準縄と考へられたからである。",
              "citation": {
                "source": "国語学と国語教育",
                "author": "時枝誠記",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤原時代の文芸、特に源氏物語は、この時代の教養の準縄となり、その地盤の上で新しい創造がなされた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
