          "literary": [
            {
              "text": "『ええ』、とは云つたものの医者の顔をジツクリと思ひ浮べてみるのであつた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりに自我の強い芸術は、無意識、つまり法悦的境地を欠くから、感覚の性質が如何によくとも、人をジツクリと楽ませることが出来ない。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "活眼をひらいて相撲道の前途を観測したら、ジツクリと大きな腕を拱いて、名案良策を編み出さずにはゐられなかつたのである。",
              "citation": {
                "source": "八百長くづれ",
                "author": "栗島山之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
