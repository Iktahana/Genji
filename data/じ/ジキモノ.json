          "literary": [
            {
              "text": "二月の朔日に直物といって、一月の除目の時にし残された官吏の昇任更任の行なわれる際に、薫は権大納言になり、右大将を兼任することになった。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "李中行　はは、わたし達は正直物だ。",
              "citation": {
                "source": "青蛙神",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃まだ元気で居た日本一の正直物、大井憲太郎という爺さんが、眼の色を変えて担ぎ込んだ話のようにも思うが、とにかくこんな話だ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
