    "definitions": [
      {
        "index": 1,
        "gloss": "intense cold",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬の山岳地帯は、甚寒（じんかん）の候となり、人々は暖を求めて移動する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "甚寒（じんかん）の中、兵士たちは夜通し陣営を守った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "突然の甚寒（じんかん）に、凍てつくような風が吹き荒れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "結城の弘経寺は寂寞たる山間にあって、猿の声悲しく風の甚寒い処であったことは、梅痴枕山二家の作にしばしば言われている。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚寒にいたれば他所より稿をもとめて作りおきたる※に入りて眠る。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
