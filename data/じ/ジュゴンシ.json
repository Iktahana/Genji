          "literary": [
            {
              "text": "」「呪禁師の言はあたった。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "）にも、或は方式の上にも、仏家及び其系統に近づいた呪禁師の影響が沁みこんでゐる。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかひゞとは神人でもあり、芸人でもあり、呪禁師（※）でもあつた。",
              "citation": {
                "source": "国文学の発生（第四稿）",
                "author": "唱導的方面を中心として",
                "note": "青空文庫"
              }
            },
            {
              "text": "欽明天皇十三年に仏法が伝わって後も、僧尼・律師・呪禁師・沙門等の称はあるが、法師の通称はみえておらぬ。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
