[
  {
    "uuid": "4a13b40b-8587-5517-9954-e1b8b4d9db93",
    "entry": "じゃが芋",
    "reading": {
      "primary": "じゃがいも",
      "alternatives": [
        "ジャガイモ"
      ],
      "is_heteronym": false
    },
    "grammar": {
