          "literary": [
            {
              "text": "車ノ中デモ杉田氏ハ頻ニ博士ノ態度ヲ賞讃シテ已マナイ、佐々木ハ「思イ切ッテヤッテシマエバヨカッタンジャナイデショウカ」ヲ繰リ返ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ高インジャナイデショウカ」席ニ着クト佐々木ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウ云ウ意味カラハ法然院ガ一番適当ジャナイデショウカ」ト、曼殊院ノ階段ヲ下リナガラ五子ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
