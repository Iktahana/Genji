        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今は、クリステンダム物語を読みつゝあるが苦闘の日に病ひされて未だジヨーンズが（底なしの池）のほとりに駒をすすめたあたりまでしか達してゐない。",
              "citation": {
                "source": "読書と生活",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「竜巻村のジヨーンズ」といふ称号を獲得した。",
              "citation": {
                "source": "三田に来て",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私は、「竜巻村のジヨーンズ」といふ尊称を享け入れて、陶然と眼をかすめた。",
              "citation": {
                "source": "武者窓日記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
