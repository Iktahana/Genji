        "examples": {
          "standard": [
            {
              "text": "ハサミが髪の毛をジョキジョキと切る音が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "庭師が枝をジョキジョキと剪定していました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あっ、もう！そんなにジョキジョキ切らないでよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "細君は鋏を引寄せて、自分でその反物をジョキジョキとやりながら、「でも、よくしたものだ。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "単なる插話という以上の子供と大人の生活のいきさつが圧縮されて出ているので、こまかに事柄を追ってみれば、ここに叱る母の無理なさ、つい鋏でジョキジョキやってしまった子供の邪気なさ、その家ではその頃子供に切りぬき絵を買ってやることに心づかないでいる庶民ぐらしの肌合いというものが、まざまざと出ている。",
              "citation": {
                "source": "「保姆」の印象",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六｜親を失い財帛不足孤苦無援の木耳にね」　ジョキジョキ不気味の音がした。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじさんは、いつも元気で、小さい店先で、子供たちの頭を、ジョキジョキ刈っています。",
              "citation": {
                "source": "子供の床屋",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで鉄砲をうつのはやめにして、そのかわり、はさみをだして、ねむっているオオカミのおなかを、ジョキジョキ切りはじめました。",
              "citation": {
                "source": "赤ずきん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、陽気が暖かになると、折々今日のような風に、海水帽にもんぺを穿いて、芝の間に繁殖するぺんぺん草や車前を取ったり、芝刈器で、ジョキジョキ芝を刈ったりした。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
