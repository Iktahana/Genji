    },
    "definitions": [
      {
        "index": 1,
        "gloss": "child",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「孺子、教えるべし」という言葉の通り、彼は幼いながらも非常に聡明だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その賢者は、集まった孺子たちに人生の教訓を優しく語り聞かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "孺子のあどけない笑顔は、戦火に疲れた人々の心を束の間癒した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "女は隅へ蹙められたやうに成つて居たが軈て毛孺子の黒い笠の紐を締め直して、輕くなつた籃を擔いて去つてしまつた。",
              "citation": {
                "source": "佐渡が島",
                "author": "波の上",
                "note": "青空文庫"
              }
            },
            {
              "text": "里見の防禦使となって堂々対敵しても逃路に待ち伏せする野武士のような役目を振られて、シカモ首尾よく取り逃がして小水門目輩｜孺子をして名を成さしめてる。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が弱き者のしいたげらるるを見る時は、必ず常に、孺子をとらえて井中に投ぜんとするを目撃するがごときの感をなすも、ひっきょうこれがためである。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども孺子の為に辱めらるること此に至る。",
              "citation": {
                "source": "八宝飯",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "又孺子を廢して皇帝となるに及び、劉といひ、周にありては陳、齊にありては田、濟南にあつては王といふ、尚書にも「惇序九族」といふ事あれば、この五姓を以て宗室となすべしといひて、自ら堯の禪をうけた虞舜の氣取をした。",
              "citation": {
                "source": "楊雄と法言",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "張飛はくわっと口をあいて、「孺子っ。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、曹仁自身も先に立ち、「周瑜孺子。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたたび、われの忠言を聞け」　こう城へ向っていうと、やがて※昭は、櫓の上に姿をあらわして、「孺子。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "東蔵赤面閉口していると、磐次磐三郎はまたいわく、真の狩人はかくのごときことのみにあらず、なおかくあるべきにとて、さらにまた気を吐けば前の尾嶺に忽然として出現ましませしは南無ありがたや三十三観音、金色燦爛、微妙清音、まんじゅしゃげを雨と降らせたまいてダンスをしたもう。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉たちと山で私ははじめて珠数花（まんじゅしゃげ）を手折った。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今でも真紅なまんじゅしゃげを手に持って、川の見える崖道を、華やかに笑いながら、ハンカチを手にして少し婀娜っぽく、その花にまけず美しく見えた豊子姉の姿が忘れられない。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕王手を拍って笑って、李九江は膏梁の豎子のみ、未だ嘗て兵に習い陣を見ず、輙ち予うるに五十万の衆を以てす、是自ら之を坑にする也、と云えるもの、酷語といえども当らずんばあらず。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "本県の中学は昔時より善良温順の気風を以て全国の羨望する所なりしが、軽薄なる二豎子の為めに吾校の特権を毀損せられて、此不面目を全市に受けたる以上は、吾人は奮然として起つて其責任を問はざるを得ず。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "滞在の当時君らを手本として万事君らの意の如くする能はざりしのみならず、今日に至るまで君らが東洋の豎子に予期したるほどの模範的人物となる能はざるを悲しむ。",
              "citation": {
                "source": "『文学論』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "本県の中学は昔時より善良温順の気風をもって全国の羨望するところなりしが、軽薄なる二｜豎子のために吾校の特権を毀損せられて、この不面目を全市に受けたる以上は、吾人は奮然として起ってその責任を問わざるを得ず。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "依然として市井の一｜豎子に過ぎぬ。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかれども蕪村は成功する能わずして歿し、かえって豎子をして名を成さしめたり。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかれども蕪村は成功する能はずして歿し、かへつて豎子をして名を成さしめたり。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし「お手打の夫婦」以下蕪村の作品を見たとすれば、後代の豎子の悪作劇に定めし苦い顔をしたことであらう。",
              "citation": {
                "source": "芭蕉雑記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程ダンテの地獄の火は、今も猶東方の豎子をして戦慄せしむるものがあるかも知れない。",
              "citation": {
                "source": "後世",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロオデルもしこれを聞かば、或は恐る、黄面の豎子未王化に浴せずと長太息に堪へざらん事を。",
              "citation": {
                "source": "骨董羹",
                "author": "―寿陵余子の仮名のもとに筆を執れる戯文―",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が折花攀柳の遊宴を恣にしたるが如き、彼が一豎子の私怨よりして関白基房の輦車を破れるが如き、将彼が赤袴三百の童児をして、飛語巷説を尋ねしめしが如き、平氏が天下に対して其同情を失墜したる亦宜ならずとせず。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗て、馬を彼等と並べて、銀兜緋甲、王城を守れる平門の豎子が、今は一門の栄華を誇りて却て彼等に加ふるに痴人猶汲夜塘水の嘲侮を以てするを見る、彼等の心にして焉ぞ平なるを得むや。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰山既に倒れ豎子台鼎の重位に上る、革命軍の意気は愈躍る。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "我義仲が、富樫入道仏誓をして守らしめたる燧山城の要害、先平軍の手に帰し、次いで林六郎光明の堅陣、忽ちにして平軍の撃破する所となり、遂に革命軍が血を以て購へる加賀一州の江山をして、再び平門の豎子が掌中に収めしむるの恨事を生じたり。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "止ぬるかな、止ぬるかな、革命の健児一たび逝きて、遂に豎子をして英雄の名を成さしむるや、今や七百星霜一夢の間に去りて、義仲寺畔の孤墳、蕭然として独り落暉に対す。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "孟子に據れば、仲尼の徒桓文の事を道ふものなし公孫丑上と言ひ、荀子にも仲尼の門五尺の豎子も五伯を稱するを羞づ仲尼篇と言つてゐる。",
              "citation": {
                "source": "尚書稽疑",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "豎子策戦を知らず、徒に壮語を弄して一時の快を何とかなす、然し、つとめて声を和げ、余勢をかつての前進は常に最も容易であるが、遠く敵地に侵入して戦線をひろげ兵力を分散して有力な敵の主力を邀へることは不利である。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔為ニ惜ム先生ノ空シク道ヲ講ズルヲ／嗤フ可シ豎子ノ漫ニ名ヲ成スヲ〕の聯句を見る。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍家の権威として、「豎子！",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
