        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "名はフィリップ・ジヤルルック三十八九、シリヤ人にしてクリスチアンなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤルルック君車上より声かけしが、寤めず。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は白馬、栗毛はジヤルルック君、イブラヒム君は余が荷物を駄せし黒に跨る。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "杏多き所にて、ジヤルルック君｜一風呂敷買ひ来りしかど、余はエルサレムに、杏に中てられたれば食はず。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "前を見ればジヤルルック君は土耳其帽の上に白手巾を被り、棒縞の白地（筒袖にして裾の二方を五寸ばかり開く）に五寸幅の猩々緋の帯して栗毛を歩ませ、後を顧みれば馬士のイブラヒム君土耳其帽を横ちよにかぶり、真黒く焼けし顔を日に曝し、荷物の上に両足投げ出して、ほくほく歩ます。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
