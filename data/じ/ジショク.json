  {
    "uuid": "11349ff1-0258-54b6-b40f-8953dfcdd67f",
    "entry": "辞職",
    "reading": {
      "primary": "じしょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
