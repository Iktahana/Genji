    "definitions": [
      {
        "index": 1,
        "gloss": "human rights",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "国連の場で各国代表が人権侵害の実態を厳しく訴えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "弁護士は拘置所での処遇が人権を著しく侵害していると訴状に記した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "子どもの人権を守るために、この条約は世界中で批准されるべきだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「でも、基本的人権というのは、……」　と、誰かが言いかけると、「え？",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人権」なる言葉を思い出す。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "著作権保護期間の延長は、憲法が「侵すことのできない永久の権利として、現在及び将来の国民に」与えると約束している、基本的人権を制約しかねない。",
              "citation": {
                "source": "「天に積む宝」のふやし方、へらし方",
                "author": "著作権保護期間延長が青空文庫にもたらすもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二　上京一　故郷を捨つ　政府が人権を蹂躙し、抑圧を逞しうして憚らざるはこれにても明らけし。",
              "citation": {
                "source": "妾の半生涯",
                "author": "福田英子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから弥一右衛門の追腹、家督相続人権兵衛の向陽院での振舞い、それがもとになっての死刑、弥五兵衛以下一族の立籠りという順序に、阿部家がだんだん否運に傾いて来たので、又七郎は親身のものにも劣らぬ心痛をした。",
              "citation": {
                "source": "阿部一族",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "人権の蹂躪、人間に対する侮辱、それは正義の観念があくまでも強かった若杉さんにとっては、身の毛もよだつほどの不平であったのです。",
              "citation": {
                "source": "若杉裁判長",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついででござるが、ご主人権右衛門殿に不慮の災を与えた憎むべきつじうら売りの下手人は、さきほど同僚の者が板橋口でめしとりましてな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卍のいれずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "また文学戦線の問題も歴史的推進力を明瞭にしながら人権を守るという点をはっきりして、よりよく生きる可能の向上としておしすすめることで、民主的なものについて最後の線を守ることで前線に立つという最後の一線がなくてはならず、どなたもおいでなさいのお手々つないで式では前進しない。",
              "citation": {
                "source": "批評は解放の組織者である",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは獅子文六という方は喜劇を経験したでしょう　〔以下四枚分欠〕　きのうの読売に各地人権擁護委員会に訴えられた人権蹂躙事件の五〇パーセントは警官の職権濫用であった。",
              "citation": {
                "source": "東大での話の原稿",
                "author": "一九五〇・十二月八日",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、権力そのものが人権蹂躙を許している幅のひろがりである。",
              "citation": {
                "source": "東大での話の原稿",
                "author": "一九五〇・十二月八日",
                "note": "青空文庫"
              }
            },
            {
              "text": "追放を考えても　すべて　人権蹂躙、読売は　地方刑罰条令が「国会を通らずに地方自治体できめて、それをムヤミにつくることを非難している。",
              "citation": {
                "source": "東大での話の原稿",
                "author": "一九五〇・十二月八日",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことは、過去の日本が、外国の力なしには封建制度も鎖国制度も独力で打破することができなかつた事実、個人の基本的人権さえも自力でつかみ得なかつた事実とまつたくその本質を等しくするものである。",
              "citation": {
                "source": "戦争責任者の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬場辰猪は、明治四年頃ロンドンで法律を学び、自由党解散の前年「天賦人権論」を著し、獄中生活の後、渡米してフィラデルフィアで客死した。",
              "citation": {
                "source": "文学における今日の日本的なるもの",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本が近代資本主義の国として出発したとき、既に改正されるべきはずであった資本主義社会の枠内での婦人の人権が、今日ようやく認められて来た。",
              "citation": {
                "source": "貞操について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛を貫徹する自由こそ基本的人権の最も人間らしい要素の一つなのである。",
              "citation": {
                "source": "貞操について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争中という言葉が、今日いわれる場合、私たちは一言の説明を加えないでも、それが苦しかった時代、無茶な抑圧のあった時代、人権がふみにじられていた時期として、心が通じ合う。",
              "citation": {
                "source": "世界の寡婦",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "憲法で、男女同等の基本的人権が認められるようになった。",
              "citation": {
                "source": "世界の寡婦",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会のあらゆる面での男女の差別待遇は、憲法によって確認された基本的人権における男女の平等な権利にたって徐々に改善されていくでしょう。",
              "citation": {
                "source": "国際民婦連へのメッセージ",
                "author": "――「女性を守る会」から――",
                "note": "青空文庫"
              }
            },
            {
              "text": "憲法が基本的人権といっている、その人権も勤労と生存のすべての条件が人間らしく守られているときにこそはじめて実際の人間として確立されるものです。",
              "citation": {
                "source": "自覚について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、すべての男女が生きてゆくために働いている毎日の勤労で、男女平等でないなら、五月三日から実際の効力をもちはじめる新憲法で、国民たる男女は、性別にかかわらず平等であると認められた基本的人権は、字の上だけのそらごとになってしまいます。",
              "citation": {
                "source": "メーデーと婦人の生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚と、その分離である離婚が「人間の尊厳」のために男女の間に平等な人権であるならば、私たちは憲法にいわれているすべての人民は働くことが出来る、すべての人民は教育をうけることが出来る、という条項を、徹底的に実現してゆかなければならない。",
              "citation": {
                "source": "離婚について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本のわたしたちは、憲法の抽象的な人権擁護の文句を、実質のあるものにしてゆこうと、計画的に努力していないでしょうか。",
              "citation": {
                "source": "新しい卒業生の皆さんへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の政権が、こんにち言論を抑圧し、正義をまげて労働者階級を弾圧し、民主的発展を挫折させるために、捏造している幾つかの政治的事件の裁判でのように、人民の基本的人権さえも法律によってふみにじられることはあり得ないからです。",
              "citation": {
                "source": "宋慶齢への手紙",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由を守り、ファシズムと奴隷教育に反対する意志の表現は、誰にとっても基本的人権の問題だし、われわれが税を払って政府を養っている以上それと全くひとしい権利を保証された社会的行動の一つです。",
              "citation": {
                "source": "新しい抵抗について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々が誠意をもって、少数者の利益のためにでっちあげられる戦争に反対を声明し、日本の人々をこめる世界の人民の平和を護ろうとするならば、こんにちの日本の現実において、もっとも発端的な人権に加えられているでっちあげを徹底的に排除しなければうそであると思う。",
              "citation": {
                "source": "それに偽りがないならば",
                "author": "――憲法の規定により国民の名において裁判する――鈴木裁判長",
                "note": "青空文庫"
              }
            },
            {
              "text": "その理由は、この事件の取調べは、検事側の威嚇と独断と術策によってすすめられたもので、人権は蹂躙された。",
              "citation": {
                "source": "それに偽りがないならば",
                "author": "――憲法の規定により国民の名において裁判する――鈴木裁判長",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一回の公判廷において、被告とともに公訴とりさげを主張し、あるいは、法の公正と人権擁護のために立ったのは、自由法曹団の弁護人ばかりではなかった。",
              "citation": {
                "source": "それに偽りがないならば",
                "author": "――憲法の規定により国民の名において裁判する――鈴木裁判長",
                "note": "青空文庫"
              }
            },
            {
              "text": "川口検事が立って、（一）検察側はだんじて拷問、人権蹂躙を行っていない。",
              "citation": {
                "source": "それに偽りがないならば",
                "author": "――憲法の規定により国民の名において裁判する――鈴木裁判長",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日には店に毛氈をしきつめてしじんけんをかざる家があつた。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
