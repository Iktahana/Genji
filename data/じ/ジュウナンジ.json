          "literary": [
            {
              "text": "学者は仔細に「憧憧往来、朋従爾思」という文を味うべきである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその女が愈※生家を辭する時、父は之を戒めて、謹愼從爾舅之言。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "といひ、母は之を戒めて、謹愼從爾姑之言。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "『穀梁傳』隱公二年にはその言葉として、謹愼從爾舅之言。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "家を出るに際して、兩親から「謹愼從爾舅之言。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "謹愼從爾姑之言」と言付けられたのであつて、舅姑には絶對に服從しなければならぬのであります。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫁に行く時には、「謹愼從爾舅之言。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "謹愼從爾姑之言」と教へられるのみである。",
              "citation": {
                "source": "支那の古代法律",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
