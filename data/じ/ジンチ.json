  {
    "uuid": "1badaf7b-8d60-554b-a3bf-7ed1ef04d1e2",
    "entry": "人地",
    "reading": {
      "primary": "じんち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
