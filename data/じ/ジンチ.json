    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "合わせて十二体ござりましたゆえ、十二地蔵とも、また女人地蔵とも申しまして、一真寺においでのころから評判のお地蔵さまでござりました」「なに！",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あちらの六体のお施主も、これをご寄進なさいましたかたがたも、みんなそろうて女のかたばかりでござりますゆえ、だれいうとなく一真寺の女人地蔵といいだしたのでござります。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰にこもって日参をしてみたが、生き仏さまにはとうからもう女人地蔵がついているんだ、それもこの背中の名まえどおり六人もそろってね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、永代橋のあの一件、お詮議にお越しでござりまするな」「さよう、この六体はまさしくあちらの分かれ地蔵とはご因縁の女人地蔵とにらみましたが、急にこのような杭垣設けられるとは、どうした子細でござります？",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "田に米蒔きて稗得しや、米獲て倉に滿たざるや、人地の幸を思ひ見ば、鼠に糧を惜まざれ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那では明朝の宮中元日に驢の頭肉を食うを嚼鬼と呼んだ、俗に驢を鬼と呼んだからだ（インドでも驢を鬼物とし、故人驢車に乗るを夢みるは、その人地獄へ行った徴という）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわく、秦の繆公の時陳倉の人地を掘りて羊状で羊でなく、猪に似て猪でない物を得、繆公道中で二童子に逢う、曰くこれをと名づけ、地下にありて死人の脳を食うと、※いわく、かの童子を陳宝と名づく、雄を得る者は王、雌を得る者は伯たりと。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "狂人地獄をスカラカ、チャンまで。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その残忍非道な人間のために、こんな狂人地獄に陥れられて、一生涯、飼い殺しにされているなんて……僕にはトテモ我慢が出来ないのですから……」「ウン……まあやって見るさ」　正木博士は如何にも気のなさそうにこう云った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三角洲は東中洲と申しまして、博多織で名高い博多の町と、黒田様の御城下になっております福岡の町との間に挟まれておりますので、両方の町から幾つもの橋が架かっておりますが、その博多側の一番南の端にかかっております水車橋の袂の飢人地蔵様という名高いお地蔵様の横にありますのが私の生家で御座いました。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、五日前にも二人、昨日も昨日とて赤ん坊が一人地に呑まれるように見えずなったという――。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうここで敗北して発狂するか、それとも思いがけないアイデアを得て辛くも常人地帯に踏みとどまるか。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その芸題が面白いので、『名人地獄』とこういうのですよ……わっちはそこで猶予なく、木戸を潜って覗いたものです。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵看板も美しく、「名人地獄」と記した文字も、躍り出しそうに元気がよい。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イラハイイラハイ、今が初まり、名人地獄、鼓賊伝、イラハイイラハイ、今が初まり！",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏の文章が音楽的であることはかつて本紙で「名人地獄」を紹介したときにも述べたのであるが、それはまさに当然の結果であって、しかも氏は、たえず「進化」ということを念頭に置いておられる。",
              "citation": {
                "source": "国枝史郎氏の人物と作品",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三人地面へつばした。",
              "citation": {
                "source": "ピムキン、でかした！",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて、常世人と言ふ名も変り、其形貌性格や対人地位なども易つて行く一方には、原形に止り、或は、二つの形を複合した信仰も出て来ました。",
              "citation": {
                "source": "翁の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙港から二千八百｜浬、アラスカのダッチハーバーの北十度、北氷洋に近い冷涼たる無人地方だ。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "また無人地の太古以来の寂寞がかえってくる。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "辺疆の苔原のなかに聳え立つロバトカ山の火口壁から、東経百四十度の線にそって南下し、カムチャッカ県の荒漠たる無人地と、波荒い鉛色のオホーツク海の下を横断して、南樺太の恵須取山の旧火口へ抜ける、千六｜粁、約四百里の蜿蜒たる熔岩隧道！",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段の下では子供が一人地面に腹ばいになって泣いていたが、門の向う側のブリキ屋の仕事場から聞えてくる騒音がいっさいの物音を打消してしまうので、子供の泣き声はほとんど聞えぬくらいだった。",
              "citation": {
                "source": "審判",
                "author": "DER PROZESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "女人地獄使、永断佛種子、外面似菩薩、内心如夜叉、―――こう書いてある所を見ると、たとい心は夜叉のようでも、面は美しいに相違ない。",
              "citation": {
                "source": "二人の稚児",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地によっては少しずつのちがいがあるが、岩手県の紫波郡ではこれを七人地蔵といって話している。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイヌ人地名のわかりやすい理由は明白である。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺がもし存在していたら煩悶したに違いないやり方で、今俺の虚像は煩悶の演技をしているだけなのだ」　人工恒星“ラビュリントス”にはまた一人地球人のテロリストが侵入する。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやともかく大都督周瑜に対して抗弁はよろしくないと、諸人地に額をすりつけて、「国の功臣、それに年も年、なにとぞ憐みを垂れたまえ」と、哀願した。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
