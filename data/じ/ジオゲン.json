          "literary": [
            {
              "text": "ジオゲンを御覧なさい、彼は樽の中に住んでいました、けれども地上の諸王より幸福であったのです。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『貴方の云うジオゲンは白痴だ。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやそうと、私は誰かとジオゲンの話をしましたっけ、貴方とでしたろうか？",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『ジオゲンは勿論書斎だとか、暖い住居だとかには頓着しませんでした。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
