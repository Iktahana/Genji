          "literary": [
            {
              "text": "ところが事務所にはたった一人髪をてかてか分けて白いしごきをだらりとした若者が椅子に座って何か書いてゐた。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "行燈のかげには清き女の童物縫ふけはひ、そがなかにたわやの一人髪あげて戸外すかしぬ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄白斎は、険しい眼をして「人髪は？",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "壇上の品々――人髪、人骨、人血、蛇皮、肝、鼠の毛、猪の糞、牛の頭、牛の血、丁香、白檀、蘇合香、毒薬などというものは、人を呪い殺すために、火に投じる生犠の形であった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
