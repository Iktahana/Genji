  {
    "uuid": "7ef078f1-2fa9-5e35-b415-2bc7621dd22f",
    "entry": "樹洞",
    "reading": {
      "primary": "じゅどう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
