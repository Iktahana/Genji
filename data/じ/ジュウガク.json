        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "従学四年、業｜大に進んで、潜渓門下の知名の英俊、皆其の下に出で、先輩｜胡翰も蘇伯衡も亦自ら如かずと謂うに至れり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "初め狩野派の加藤文麗を師とし、後｜北山寒巌に従学して別に機軸を出した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この年に森｜枳園は、これまで抽斎の弟子、即ち伊沢蘭軒の孫弟子であったのに、去って直ちに蘭軒に従学することになった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭軒に従学する前二年の事である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽斎の父｜允成の門人で、允成の歿後抽斎に従学した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "允成が栗山に従学した年月は明でないが、栗山が五十三歳で幕府の召に応じて江戸に入った天明八年には、允成が丁度二十五歳になっていた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "艮斎、漁村の二家に従学していた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "成善が従学してからは、成斎は始終正教に侍していたのである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "天保九年の生れで、抽斎に従学した安政四年には二十歳であった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百が専六をして元秀に従学せしめたのは、実にその人を獲たものというべきである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "成善が従学した時は三十三歳になっていた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "専六は成善に紹介せられて、先ず海保の伝経廬に入り、次で八月九日に共立学舎に入り、十二月三日に梅浦精一に従学した。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時又一人の壮者が来て従学した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒石は明和の初に、伊勢国桑名で南宮大湫に従学した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "職を罷めて辛島塩井に従学しようと思つてゐながら、病に罹つて死んだのは事実であらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "稼圃が来り航した時、恐くは多く居諸を過すことなく従学したであらう。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅泉が其時従学したとすると、年正に十九であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは渋江抽斎伝に枳園が癸未の年に始て蘭軒に従学したことを言つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "霞亭は寛政九年に京に入つて、直に文台に従学した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼山陽に従学した間も亦同じである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "榛軒は為に師を択んで従学せしめ、家業を襲ぐことを得しめた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "常庵は少うして榛軒に従学し、其内弟子となつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "榛軒歿後には渋江抽斎に従学した。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで私に従学したいと云って名告り出た人に、Ｆ君のような造詣のあったことは曾て無い。",
              "citation": {
                "source": "二人の友",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌年余十五歳、家君の喪にあひ、十六歳の春余家母に従つて京に入り、再び津島氏に従学し、門人と為ることを得たり。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし同時に若様がぜひご及第をなさるように骨を折ってください」「はあ」「きみだけ及第して、若様がお落第をあそばすようなことがあると、主従学級がわかれてしまいます」「はあ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」壽阿彌は天民と共に山本北山に從學した。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
