[
  {
    "uuid": "3ef1aad7-b447-5494-89d5-2df899b3de6c",
    "entry": "情実",
    "reading": {
      "primary": "じょうじつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
