    },
    "definitions": [
      {
        "index": 1,
        "gloss": "personal considerations",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公的なプロジェクトにおいて、情実が絡むような選定は絶対にあってはならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あの上司は、部下を評価する際にどうしても情実が入りがちだと噂されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "情実に流されることなく、公平な立場で判断を下すのが彼の信条だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "勿論外国にしろ、多少とも此の世の中は左様なものではありますが、高い程度の技術ではともかく、凡そ常識の既に認める範囲にある技術では、我が国程に台所情実は場を占めてないやうであります。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰助は、幕の蔭よりこれを見て、躍り出んと思えども、敵は多し身は単つ、湍るは血気の不得策、今いうごとき情実なれば、よしや殴打をなすとても、死に致す憂はあらじ。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸国の介や守や掾やは、騒乱を鎮める為に戮力せねばならぬのであるが、元来が私闘で、其の情実を考へれば、強ち将門を片手落に対治すべき理があるやうにも思へぬから、官符があつても誰も好んで矢の飛び剣の舞ふ中へ出て来て危い目に逢はうとはしない。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "前座のような情実でもあって、一旦内へ入れたものなら、猫の児の始末をするにも、鰹節はつきものだ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は前者の方が空元気であらうとも、何となく熱情があつて、ただ私も文壇のことは知らないんだが、まさか、文壇には彼等の言ふやうな馬鹿々々しい情実なんてある筈がない（今にして思へば、やつぱり彼等のそんな言葉はヒステリツクだつたんだ。",
              "citation": {
                "source": "貧しき文学的経験（文壇へ出るまで）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく私は住家もなくなり、町に住むことが出来なくなり、私自身は平気なのだが、様々な周囲の情実が作家生活を許さなくなり、私は、カバンを一つぶらさげたゞけで、再び都の居住者となりました。",
              "citation": {
                "source": "西部劇通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯ういふ教師が其頃まだ世間に存在して居たといふのは不審に思はれるやうであるが、それを馘つて畢ふことが忽ち其一族に悲惨な目を見せなければならないので情実といふものが幸に余命を繋がしめて居たのである。",
              "citation": {
                "source": "隣室の客",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで情実のためにどう計らおうというようなことも皆はしなかった。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父祖からの情実的な遺産は僕はもう沁々と閉口したよ。",
              "citation": {
                "source": "熱い風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの外面的な情実から、家族は国家の柱石、資本主義の根拠地となっている。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "強ひて言へば、自分の気持などを考へることが面倒で且余りに莫迦気てゐるのが醜くく感ぜられたやうであつたが、単純な彼の頭脳の働きはたつたそれだけのことでもうこんがらかつてしまつて、その原因である些細な情実までは想ひが至らなかつたのである。",
              "citation": {
                "source": "公園へ行く道",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "照子と彼との関係が、その間男の心が如何に不自然に働いたかは、（それは彼の度し難い性癖かも知れないが）その後彼が延子を恋するやうになつてから、どんなにそのコヂれた感情の為に苦しむでゐるかといふ、たゞ延子との相対関係に反映した情実だけに止めて置く。",
              "citation": {
                "source": "坂道の孤独参昧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はこの不景気にも珍しく、いろんな情実関係から就職口の三つや四つは大学卒業前から話があった。",
              "citation": {
                "source": "縁起に就いて",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "群集心理にのみかられて、付和雷同する場合にはとんでもない「価値の転倒」が行われる惧れがあるが、情実や交友関係に左右された幇間的批評よりも、厳正を失うおそれは少ないと言えよう。",
              "citation": {
                "source": "日本の近代的探偵小説",
                "author": "――特に江戸川乱歩氏に就て――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり、今度のそれも大若衆がやったのであろうなど腹の中で考えて一層不安が増し、取り沙汰が喧しくなるという風で、物情実に騒然たる有様であった。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "一度家に帰り父に誡められたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間から課長の所に来ているのだから、我輩もまだ深くは情実を知らないのです」　ト聞くとお勢は忽ち眼元に冷笑の気を含ませて、振反って、今｜将に坂の半腹の植木屋へ這入ろうとする令嬢の後姿を目送ッて、チョイと我帯を撫でてそしてズーと澄ましてしまッた。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "はははは」　皺延ばしの太平楽、聞くに堪えぬというは平日の事、今宵はちと情実が有るから、お勢は顔を皺めるはさて置き、昇の顔を横眼でみながら、追蒐け引蒐けて高笑い。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人の自由と情実を毫も斟酌して呉れない器械の様な社会があつた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろんな情実が絡み合っているようにも思える。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「市設紹介所」　　和久井門平　小市民の下級知識労働者が、市の職業紹介所へ行って、かかりの者の官僚主義や、得たいのしれぬ情実採用に痛めつけられ憤る心持を、この作者は細々と書いている。",
              "citation": {
                "source": "小説の選を終えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう父の一面に公私混同をきらう気質がよくあって、仕事のことになると、家族であるなしということの情実に支配されることを極端にさけていたと思われます。",
              "citation": {
                "source": "父の手帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「私は一さい情実に捕われないことにしています……書いたものを買うなら別だが」　一つの插話にすぎないが、私は、氏の編輯者道とでもいうべきものの一端を見るように思った。",
              "citation": {
                "source": "狭い一側面",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "放送委員会は、新会長の選出にひきつづきプログラム編成上の改善、放送技術の向上および協会内に巣喰う情実のくもの巣をはらって、放送現状の各機構が民主化されることを希望したが、協会内の旧勢力は、表面上退陣したのちもさまざまな形に変ってその影響を新首脳部の日和見的な打算と結合させた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし設備と教師のそろっている私立中等学校への入学志望者は殺到して、そのために情実入学の事実は昨今（一九四八年三月初旬）の新聞に具体的に報道されている。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終第一義的に情実にまげられないやうに活きやうと努力してお出になるかたとしてはそれも誠に余儀ないことだと思ひます。",
              "citation": {
                "source": "編輯室より（一九一五年一月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "却つてお頼みして無理にいやなのをわざ／＼お書き下さるのも御迷惑と思はれますし私の方でもお願ひして書いて頂くからにはどうしてもつい出さねばならぬと云ふやうにわるい情実をこしらへることになりますからほしくてたまらないのをだまつて下さるのを待つてゐるのです。",
              "citation": {
                "source": "編輯室より（一九一五年四月号）",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外面的にはずつと私娼が勝れてゐるやうに見えても案外情実のからみついた彼れ等の社会は矢張りさうたやすくぬけられるものでもないやうに思はれます。",
              "citation": {
                "source": "青山菊栄様へ",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
