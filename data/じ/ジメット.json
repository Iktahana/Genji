        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女はじめっとした口調で「また失敗したよ」と呟き、目を伏せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "会議室の空気がじめっとした沈黙に包まれ、誰も最初に口を開こうとしなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「そんなじめっとした顔するなよ」と先輩が笑いながらコーヒーを差し入れてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
