  {
    "uuid": "5e1d9590-4ac3-59f0-a62e-bdd28b828909",
    "entry": "尽処",
    "reading": {
      "primary": "じんしょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鯨浪暁来堆作山、寒烟鎖海路難攀、南風吹雨天将雪、船入濠陽尽処湾。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "天為屋壁海為筵、自笑吾身亦似船、東去西来無定宿、南溟尽処送今年。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "船入南阿尽処郷、環湾皆屋一街長、阜頭風月冬如夏、人去人来晩納涼。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "未飽南阿尽処遊、与船有約向欧洲、月残喜望峰頭暁、風冷大西洋上秋、旭影生霓知雨到、星光入水見波収、二旬無物迎吾意、只対白雲寄客愁。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "繞海峰巒自作屏、曲湾尽処客舟停、那西七月夏猶浅、入眼山田麦漸青。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "西州将尽処、石屋繞山根、白壁映丹瓦、看疑画裏村。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "孤舟衝雨立、冷霧鎖春洋、南米尽処暮、波間島影長。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "在此西球尽処郷、微臣堪喜祝天長、満場奏楽春如湧、舞踏声中拝聖皇。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の村の盡処に千艸屋と云って草花を作って居る家の有るのは御存じでしょう」成る程余は知って居る、曾て其の家の小僧が偽電報の件を余に知らせて来て十ポンドの褒美を得て去った事まで此の話の初めの方へ書き込んで置いた積りだ。",
              "citation": {
                "source": "幽霊塔",
                "author": "黒岩涙香",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
