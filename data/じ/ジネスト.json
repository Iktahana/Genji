        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それが自分のパリイに出たあとで再縁して、今ではマドレエヌ・ジネストと名告っている。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "スウルヂェエにしろ、ジネストにしろ、いずれも誰にも知られない平民的な苗字で目下自分の交際している貴夫人何々の名に比べてみれば、すこぶる殺風景である。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジネストは情なしの利己主義者でございます。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二にはジネストの奥さんの手紙が表面には法律上と処世上との顧問を自分に託するようであって、その背後に別に何物かが潜んでいるように感じたからである。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジネストの奥さんはおいでかね。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジネストの奥さんに、わたしが来て待っているとそう云ったかね。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "――――――――――――――――――――　ピエエル・オオビュルナンとマドレエヌ・ジネストとは再会せずにしまった。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
