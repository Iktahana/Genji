        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二三町出るとブールバール・デジタリアンの大通りです。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「爆撃機ハ九機ノ編隊七箇ヨリナル」「爆撃編隊ハ高度約二千メートル、針路ハ真西ナリ」「針路ヲ西南西ニ変ジタリ」「只今上空ヲ通過中ナリ」　こうしてＳ国の空襲隊の様子は、手にとるようにわかって来た。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、仇討ちの見物人に分るのは、仇討のイワレ、インネン、双方のイデタチ、武者ぶりの観察からはじまって、又五郎が赤鬼の顔、ジリジリとすすむと、数馬がジタリジタリ油汗をしたたらせる、そういうことなのである。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "心眼の復讐などと大きなことを云いながら、又五郎がジリジリすすむ数馬がジタリジタリ油汗、それぐらいしか書けないので、心眼が泣くのである。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジイサンはジタリジタリ脂汗をしたたらせて顔面蒼白息をきらして後退する。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時代ノ人民ハ快樂少ク、生命短ク、老衰ヲモ感ジタリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノタメニ脳ガ充血シ、眩暈ヤ複視現象ガ起ッタリ意識ノ昏濁ガ生ジタリスル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなったら　ベジタリアンにでも　なって　自分の　しっぽでも　かじるしかないわいな！",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間じゅうバター、チーズ、ミルクといった動物由来の食物を摂取していたため「ベジタリアン」というわけではなかったが。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼、先駆、殿ニアルトキハ、軍中何トナク心ヲ安ンジタリ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
