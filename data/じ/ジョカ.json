    "definitions": [
      {
        "index": 1,
        "gloss": "Nüwa (mother goddess of Chinese mythology)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
