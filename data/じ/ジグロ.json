          "literary": [
            {
              "text": "帯無地黒琥珀、織出截棄。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "七通りと言えば、地白、地赤、地黒、総模様、腰模様、裾模様、それに紋付ときまったものさ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "盾の地板は金なれど、鑄られし耕地黒くして、鑄る妙工の巧みより眞の物を見る如し。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京では埼玉の越ヶ谷辺の地黒というどじょうが上物で大きく、以前、うなぎの大和田あたりで盛んに蒲焼きにして、「どかば」と称して、一時人気を呼んだものである。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "歳費辞退の性質、日本各新聞の輿論と安蘇の利己論との区別を見ても、天地黒白の大差を知るべし。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
