[
  {
    "uuid": "205071f7-b620-5d46-a45d-f24b96c06c8d",
    "entry": "女優",
    "reading": {
      "primary": "じょゆう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
