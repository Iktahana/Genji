[
  {
    "uuid": "bd8f4f9e-ac49-53d5-bf3e-83409b77db02",
    "entry": "ジワジワ",
    "reading": {
      "primary": "ジワジワ",
      "alternatives": [
        "じわじわ"
      ],
      "is_heteronym": false
    },
    "grammar": {
