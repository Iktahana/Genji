          "literary": [
            {
              "text": "主人はじめ其他の人々も無論普通礼服で、法印等｜法体の人々は直綴などであったと思われる。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠は粗末な直綴を纏うて、出発した。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「我、汝が為めに箇の直綴を做得了れり」　与次郎老人が味なことを言い出しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで老人は破顔一笑して、諄々と直綴の説明をはじめたようです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "木蘭色の直綴を着ているが、紅い蹴出しなどをしていないところを見ると、ころび比丘尼ではなく、尼寺にいたものらしく思われる。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "都鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
