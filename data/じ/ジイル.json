          "literary": [
            {
              "text": "「タンタジイルの死」などの思ひ出される感じである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダダの詩人ジャン・コクトオが『エッフェル塔上の結婚』を発表し、未来派の作家ジイル・ガリイヌが『春の日のどよめき』を、ララ夫人の組織する『芸術と活動』社の試演舞台に上せたことも附記して置かう。",
              "citation": {
                "source": "仏国現代の劇作家",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてアルジイルやチュニスやエジプトの話をした。",
              "citation": {
                "source": "幸福への意志",
                "author": "DER WILLE ZUM GLUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アルジイルにいたフランス人の医者がね、僕にこういったっけ。",
              "citation": {
                "source": "幸福への意志",
                "author": "DER WILLE ZUM GLUCK",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュネーヴではホテルがざわつくので、一人でフランス領に近い奥の方のボーセジイルというところに借家をしていた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "語による混合置換法はアージイル伯がジェームズ二世の謀反した時に用いたものとして有名である。",
              "citation": {
                "source": "探偵小説の「謎」",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
