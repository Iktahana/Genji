        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何しろ『ジンゲジ』も一しょじゃ、……」　僕等は前の「嫣然」のように彼等の一人に、――黒と黄との海水着を着た少女に「ジンゲジ」と言う諢名をつけていた。",
              "citation": {
                "source": "海のほとり",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジンゲジ」とは彼女の顔だち（ゲジヒト）の肉感的（ジンリッヒ）なことを意味するのだった。",
              "citation": {
                "source": "海のほとり",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず「君は『ジンゲジ』にしろよ。",
              "citation": {
                "source": "海のほとり",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
