        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "剩へ野町、野田寺町、地黄煎口、或は鶴來往來より、野菜を擔荷ひて百姓の八百物市に赴く者、前後疾走相望みて、氣競の懸聲勇ましく、御物見下を通ること、絡繹として織るが如し。",
              "citation": {
                "source": "鐵槌の音",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "起りは地黄煎、即ち地黄といふ苦い藥を煎じたのに、水飴を混じて飮みやすくしたものの名であつたといふ（浮世鏡三）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "地黄は藥と言はうよりも寧ろ強壯劑であつた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分は後者が地黄煎の故智を學んだものであらう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "起りは地黄煎、すなわち地黄という苦い薬を煎じたのに、水飴を混じて飲みやすくしたものの名であったという（浮世鏡三）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "地黄は薬と言おうよりもむしろ強壮剤であった。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分は後者が地黄煎の故智を学んだものであろう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
