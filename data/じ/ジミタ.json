          "literary": [
            {
              "text": "画題は「マリポサ・ローハ（赤い蝶）」……学名はなんというのか、シジミタテハに似ているが、それともちがう。",
              "citation": {
                "source": "蝶の絵",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ、佛ヲ冒涜スルヨウナ気狂イジミタ考案ノ実現ニ、ソノ人ハ喜ンデ手ヲ藉スデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今マデノヨウナ譫語ジミタ云イ方デハナクテ、底力ノアル、訴エルヨウナ、叫ブヨウナ声デ呼ンダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
