        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして自分のエゴイズムをジャスチファイし、わがままを振舞いながら、隣人の愛のみの受くべき冠にあずからんことを要求している。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし他人の運命をおもんぱかる人はただの一つの行為でもジャスチファイすることはできなくなるであろう。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自分の態度をジャスチファイして曰く、「個性は多様である、自己の思想をもって他人を律してはならない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの信念にジャスチファイされて勇ましくかつ公けに他人に働きかけた。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいまだ童貞なる青年が、肉交を、思想上においてジャスチファイするのを愚かだとは思わない。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は学生への同情の形で、その平板と無感激とをジャスチファイせんとする多くの学生論、青年論の唯物的傾向を好まぬものだ。",
              "citation": {
                "source": "学生と生活",
                "author": "――恋愛――",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓを殺さなければならない理由は、まったく主観的のもので、おれは良心を安んじさせるためにジャスチファイする必要はないと思う。",
              "citation": {
                "source": "蜘蛛",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
