    "definitions": [
      {
        "index": 1,
        "gloss": "sizzling (of cooking meat, fat, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "フライパンで肉がじいじいと音を立てながら焼けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "熱した油に具材を入れると、じいじいと音を立てて香ばしい匂いが立ち込めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "炭火の上で脂の乗った魚がじいじいと焼けるのを見ていると、食欲がわいてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "残らず、薄樺色の笠を逆に、白い軸を立てて、真中ごろのが、じいじい音を立てると、……青い錆が茸の声のように浮いて動く。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいじい蝉がまたそこらの木立に熬りつき出した。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいじい蝉の声も時には雲と梢を閑かにする。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋燈が、じいじいと鳴る。",
              "citation": {
                "source": "霰ふる",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "木立のところどころで、じいじいという声がする。",
              "citation": {
                "source": "杯",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝉はじいじいと鳴いている。",
              "citation": {
                "source": "杯",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁の下でじいじいと刻んでゆくような虫の声が又もや耳についた。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいじいと怪しく灯ざしが鳴いたかと見るまに、またパッと灯りが消えた。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとともに、暗かったへやの中には、けはいを知った娘の手によって、あわただしく短檠がともされ、じいじいと陰に悲しく明滅するあかりのもとに、その姿のすべてがパッと浮かび上がりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "千柿の鍔",
                "note": "青空文庫"
              }
            },
            {
              "text": "じいじいじいと、放電のような音もきこえる。",
              "citation": {
                "source": "宇宙女囚第一号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙管の針の先きで、飴のような阿片の丸が慄えながらじいじいと音を立てた。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、頭の上でじいじいと油蝉が鳴き出した。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "互に視線を避け合っている笑顔の間で、ランプのホヤがじいじい静かに蝉のように音を立てた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になってじいじいとやかれた時には、くろだいのはだからおいしそうなあぶらが出ていました。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんはみかけによらぬ料理好きで、ちょいちょいと短時間にうまいものをつくる才能があって、火鉢でじいじいと炒ためてくれるハムの味、卵子のむし方、香のもの、思い出して涎が出るのだから、よっぽど美味かったのに違いない。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "炉の上へ雪が降つて居るのではなくて、是れは暖炉の縁などへ雪の塊りが置かれて居て、じいじいと音がして解けて行く趣きである。",
              "citation": {
                "source": "註釈與謝野寛全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうあと一週間で、この地球が粉々にとびちってしまうというのに、博士は何をそんなに熱心に研究しておられるのですか」　博士はしきりに電気火花をじいじい言わせて、ガラス管の中にある青黒い紐のようなものにあてていた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしの研究の、じゃまをしてはいかん」　博士は、目盛を直しては、またじいじいと電気火花をとばし、ガラス管の中をのぞきこんでいる。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかじいじいじいと妙な音がしている。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、部屋の中から、じいじいじい、じいじいじいというかなり高い物音がひびいてきた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ扉の向うでは、あいかわらずじいじいじいと奇妙な物音がしつづけであった。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫色の電灯がかすかな光をだしているだけで、どこかでしきりにじいじいじいと変な音がしていた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそ、あまりふしぎで、気もちがわるくて仕方がないよ」　そういっているとき、小食堂の天井にとりつけてあるブザー（じいじいと蜂のなくような音――を出す一種の呼鈴）が鳴りだした。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁の下でいつの間にか鳴き出した虫がジージー、ひつっこく千世子が寝つくまで鳴きつづけた。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジージーと明らかに相手をよんでいる音がきこえるが、中中相手は出て来ない。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジージーと放電の音響がきこえ、Ｘ線は実験室の壁をとおして内部へ入ってゆくようでした。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "武夫の耳にはジージーという怪物の怪しい呻り声が聞えてきた。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはジージーと微かな音を立てて見る見るうちに横に小さい円を描いて伸びていった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その途端にジージーガチャリガチャリと機械の動き出す音が聞えだした、と思うと正面の鉄壁が真中から二つに割れ、静かに静かに左右へ開いていった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、君を入れて、水を止めなければならん」　シムソンがこう云った時に、机の上の電話器がコツコツジージーという微かな変な音を立てました。",
              "citation": {
                "source": "計略二重戦",
                "author": "少年密偵",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "chirring (of cicadas, etc.)",
        "register": "standard",
