        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "因テ二、三ノ従游スルモノト相謀リ諸家ノ麗藻ヲ選ンデ梓シテコレヲ伝ヘントシタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫻｜任藏（東湖に從游尤經濟に志す從四位追贈）にも追々差越候處、是も豪傑疑なく廉潔の人物、其上博識に御座候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
