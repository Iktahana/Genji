        "examples": {
          "standard": [
            {
              "text": "専門書を探すなら、品揃えが豊富な駅前のジュンク堂へ行くのが一番確実だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ジュンク堂の店内で、時間を忘れて棚の隅から隅まで本をチェックするのが週末の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "探していた洋書がジュンク堂に在庫があることをネットで確認し、すぐに取り置きを依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
