[
  {
    "uuid": "0370b627-7f17-5b6e-a541-287355af24d0",
    "entry": "人造",
    "reading": {
      "primary": "じんぞう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
