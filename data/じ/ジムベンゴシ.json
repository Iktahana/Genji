        "examples": {
          "standard": [
            {
              "text": "イギリスでは事務弁護士が契約書の作成や不動産取引の法務を担当し、法廷には法廷弁護士が立つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "会社の顧問として事務弁護士を雇い、日常的な契約審査を任せることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "遺産相続の手続きについて、地元の事務弁護士に相談してみるよう弟に勧めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "『その紳士の名前はウィリアム・モリスといいまして、事務弁護士なんですよ。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "間接税務局の事務弁護士が作った起訴および有罪判決のリストを見ると、多くの卸醸造者および小売ディーラーがこれらの違反者のうちで非常に多くを占めていることが判る。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下の言及は偽物の製造および真正コーヒーの混ぜ物処理を行った不正により有罪宣告をされた人たちにたいして間接税務局（現在は存在しない）の事務弁護士（solicitor）が行った訴追を示したものである。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            }
          ]
        }
