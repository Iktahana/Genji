        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "蒸気のラジエーターが、白い湯げを吐いていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしたち二人と雛妓はオレンジエードをジョッキーで取り寄せたものを飲みながら頻りに扇風器に当った。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が寡聞なので、今、その他に例となる樣な善い劇を擧げることは出來ないが、小山内薫氏がジエームスヒウンカアと云ふ人の書から抄譯して、新小説に紹介せられた瑞典の劇作者ストリンドベルヒ――これは、前に論じたスヰデンボルグと同國人――の著『伯爵令孃ユリエ』を引いて見よう。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の不明瞭な意識を、自分の明瞭な意識に訴へて、同時に回顧しやうとするのは、ジエームスの云つた通り、暗闇を検査する為に蝋燭を点したり、独楽の運動を吟味する為に独楽を抑へる様なもので、生涯｜寐られつこない訳になる。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一人小説家のヘンリー・ジエームスを訪ねて往つた男がある。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジエームスは無趣味な男だね、いつも速記者に書かすのだつて。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ムニユイジエー」は指物師の事だが、さういふと、領事は二つ返事で直ぐ承知して、門の修繕は愚な事、齲歯の手当から、臍の掃除まで指物師にさし兼ねない程にこ／＼顔である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "紳士とは誰あらう、イリノイス州の上院議員ジエームス・ミルトン・レヰス氏であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "植民館の設立者として名高い、米国のジエーン・アダムス女史が、ある時大西洋通ひの汽船に乗つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君が愛詠したウヰリアム・モリスの詩――ジエーソンの一生――の冒頭のやうであつた、その光景は――森に育つたジエーソンは、山向ふの村を指して、妻と子と、家畜とそして一袋の金貨とを携へて、旅路にのぼつた――といふあれさ。",
              "citation": {
                "source": "附「歌へる日まで」",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエー・エス・ミル。",
              "citation": {
                "source": "櫻と狆と愛國心",
                "author": "コスモポリタンの心理",
                "note": "青空文庫"
              }
            },
            {
              "text": "フルゥツパーラで、オレンジエードを飲んでその女のひとと別れると、谷村さんは、久し振りで肩で笑いながら下宿へ帰つて行きました。",
              "citation": {
                "source": "清修館挿話",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうすれば、村松さんを救いだせるだろうか」　冷たい安ホテルの一室の、もう冷えかかったラジエーターの傍に椅子をよせて、帆村はいろいろと、これからの作戦を考えつづけた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラジエーターの上には官庁のマークの入った小旗がたてられていた。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにのせた「母の話」は、その追憶風の小説『ピエール・ノジエール』の中の一｜章で、これだけ読めばアナトール・フランスがみんなわかるというようなものではありませんけれど、まずまず、どんな人か見当がつくでしょう。",
              "citation": {
                "source": "母の話",
                "author": "アナトール・フランス",
                "note": "青空文庫"
              }
            },
            {
              "text": "シケリアの最初の王ロージエーロ（ルツジエーロ）の末女、一一五四年に生れ、同八五年皇帝ハインリヒ六世の妃となりてフリートリヒ二世を生み、一一九八年に死す傳説に曰。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "シジエーリ、パリの宗教裁判所にて異端の罪を受け、抗辯の爲イタリアのオルヴィエート（その頃ローマの法廷ありし處）にいたり、かしこにて一僧侶の手に斃ると（スカルタッツィニ註參照）〔シジエーリ〕シジエーリ・ド・ブラバンテ。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして私がまだ一杯のオレンジエードを飲んでしまわないうちに、そのＴ君が元気よくはいって来た。",
              "citation": {
                "source": "旅の絵",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ本の中に畑ちがひのジエームス・ジヨイスのたつた一つの戯曲「追放者」が交つてゐた。",
              "citation": {
                "source": "過去となつたアイルランド文学",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエームス・ワツト。",
              "citation": {
                "source": "誤まれる姓名の逆列",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西の作家ジエーンライブラハは小説“New Beauty”の中に解放せられたる理想的美人を描き出さんと企ててゐる。",
              "citation": {
                "source": "婦人解放の悲劇",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスの海軍大臣は同じ一七七〇年代の安永年間に海軍大佐ジエームズ・クツクに訓令して日本本土沿岸を探險せよといつてゐる。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからわたしたちは水車の町であるカステルノーダリを下って、中世の都会であったカルカッソンヌへ、それから貯水溝のめずらしいフスランヌの閘門（船を高低の差のある水面に上げたり下ろしたりするしかけのある水門）をぬけてベジエールに下った。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギュスターヴ・ド・モリナリ、フレシエ、フェルディナン・エドゥアール・ブュイソン、メリメ、マルー・ブラン、ヴォルテール、ラメ・フルーリー、父デューマ、ジャン・ジャック・ルソー、メジエール、ミラボー、ド・マザード、クラルティー、コルタンベール、フレデリック二世、および、ヴォギューエ氏。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
