          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "肌触りの良いジャージー素材のワンピースは、長時間着ていても疲れにくい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ストレッチ性の高いジャージー生地を裏地に使っているため、このジャケットは動きやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子供服には、丈夫で洗濯にも強いコットンジャージーの素材がよく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "長いジャージーのトレイニング・パンツをはいてきたのに、その上から蚊に刺されたらしい。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一は、この学校が女子にブルマーズをはかせず、両サイドに白いストライプが入った、オレンジ色のジャージーの上下を着せたことを、高い見識と評価している。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて四号には、ニュージャージー州ルーズベルトに住むハイスクールの三年生、エリック・ミューラーの書いたタイニーベーシックのソースリストが掲載された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころ彼は、ニュー・ジャージー通いの渡船の着くコートランド・ストリート行の鉄道馬車に乗り込んでいた。",
              "citation": {
                "source": "“能筆ジム”",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あゝ、わしはニュー・ジャージーのわしの農場の雇人に支払う小銭を作ってくることを忘れた。",
              "citation": {
                "source": "“能筆ジム”",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュー・ジャージーの農夫たちは、この土地のこの種の店にとっては上得意なので、主人は「札で四十ドル、銀貨で十ドルなら両替いたしましょう」と云いながら、バアーの上に十ドル札四枚を並べ、十ドルを銀貨でニンゲルに手渡たした。",
              "citation": {
                "source": "“能筆ジム”",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナー船長は、微苦笑を浮べながら、数年前、彼等夫妻が十一月、ニュー・ジャージーの海岸で難船した話をつけ加えた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "サザンプトンへ行ってジャージー島経由でフランスへ渡る。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "半袖の白いラグビー・ジャージーに、はき古したブルー・ジーンズ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オークの壁板のリヴィングルームには、ブラック・ウールを纏ったポーラ・ハート、白の翠玉と緑のジャージーに真珠を纏ったモニカ・フリントが待っていた。",
              "citation": {
                "source": "愛と月の犬",
                "author": "R. マッケナ　R. McKenna",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェイマスへ行き、ジャージー島へ渡るつもりです。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェイマスへ着いたら、漁船を借りて、ジャージー島まで行きます。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャージー島からグランビルまでは帆船で簡単に行けます」　考えれば考えるほど、スライトに賛成したくなった。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、ぼろ船でジャージー島からグランビルへ渡る途中、嵐で遭難しました。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つはねずみ色の天鵞絨で作った身長わずかに五六寸くらいの縫いぐるみの象であるが、それが横腹の所のネジをねじると、ジャージャーと歯車のすれ合う音を立てながら走りだす、そうしてあの長い鼻を巧みに屈伸して上げたり下げたりしながら勢いよく走るのである。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌一九九三（平成五）年二月、幕張で開かれたマッキントッシュのショーに出かけてみると、ボイジャージャパンを名乗るところが小さなブースを出していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボイジャージャパンではツールキットの日本語化を進めている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき僕は、『パソコン創世記』をボイジャージャパンから出したいと強く願った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、パーソナルコンピューターの黎明期を描きながら幻のように消えていった『パソコン創世記』が、もしも電子メディアを掘り起こそうと歩みはじめたボイジャージャパンの志に包まれて復活することになれば、自分にとってとても美しい物語がそこに生まれると僕には思えてならなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな頃、コンピューターを使って新しい形式の本を作ろうとするボイジャージャパンの試みを知った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようやく体が少し動くようになったころ、ボイジャージャパンの試みを知った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが映像編集の物理的条件が整わず、結果的にはボイジャージャパンに一か月あまり居候して、作業させてもらうことになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが集められた寄付金で、過去には選手個々人にジャージを買い与えたという噂を聞いた熱心なサポーターは、一転して寄付金の詳しい決算報告と残金の扱いに関する方針の提示を後援会に要求します。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただし一九九二年十月に、米ボイジャー社と日本のソフト制作者グループとのジョイントベンチャーによって、日本法人のボイジャージャパン（正式名称、株式会社ボイジャー）が設立されており、一九九三年三月のリリースをめどに日本語化の作業が進められている。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈ボイジャージャパン〉という文字を見て、「ああ、あの会社だ」と懐かしさに似た気持ちがわいてきます。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボイジャージャパン　ボイジャージャパンには、評価記事の件で確かめたい点があって、すでに電話を入れていました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林の指摘に従えば、ボイジャージャパン社長の萩野正昭さんは、最後まで〈江戸〉を引き継いだ家の生まれです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどこの作業を通して彼らが共有した新しいメディアへの確信は、萩野さんをボイジャージャパンの設立へと向かわせることになりました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "『メロディー・メーカー』紙の元編集長で本人とも親交のあったレイ・コールマンの『ジョン・レノン』をだらだら読んでいったこの日の夜、エキスポでもらってきたボイジャージャパンのパンフレットを開いたのは何がきっかけだったのでしょう。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど「今までなら本にならなかったものを本にする」、「売れない本を作ってやるぞ」と大見得を切るボイジャージャパンから、消えていったあの本を出してもらうことができれば、私にとってはとても美しく感じられる物語りが生まれると、その時私はふと、そう思いました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
