          "literary": [
            {
              "text": "その秋には平戸にオランダの商館が出来、ジャックス・スペックスが商館長として数人の館員と共に駐在することになった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "お互に背負い合ったり、羽根をついたり、我々のジャックストンス〔お手玉に似たもの〕に似た遊技をしたりする。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしかしたら、エイジャックス、ユリシーズ、ホメロスが愛したそんな輩だったかもしれない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
