[
  {
    "uuid": "4484c9a3-af85-5ac7-8dd1-7ce9662f44d3",
    "entry": "濁",
    "reading": {
      "primary": "じょく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
