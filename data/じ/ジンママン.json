          "literary": [
            {
              "text": "〈５〉　ロバート・ジンママン１「レコーディングのとき、ボクは、ミュージック・スタンドに、火のついたタバコを一本、のせておく。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "４　ボブが一〇歳のとき、父親のエイブ・ジンママンはピアノを買った。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、ヒビングのフェルドマンズ・デパートメント・ストアでパートタイムの売りことして働いている金髪の美しいミセス・ジンママンによると、息子のボブは家出などしたことは一度もなかったという。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "６　ジンママンというユダヤ系の名をディランにかえたのは、詩人ディラン・トーマスにあやかってのことだと信じられている。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジンママン、という名がまったく好きじゃなかったのよ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
