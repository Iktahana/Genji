          "literary": [
            {
              "text": "名をジュセッポ・ルッサナとかいって、黒田の宿の裏手に小さな家を借りて何処かの語学校とかへ通っていた。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人のジュセッポの事を近所ではジューちゃんと呼んでいた。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュセッポの家で時ならぬ嵐が起って隣家の耳を※てさせる事も珍しくない。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな時にはかたくななジュセッポの心も、海を越えて遥かなイタリアの彼方、オレンジの花咲く野に通うて羇旅の思いが動くのだろうと思いやった事もある。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて二階から見下ろしたジュセッポにいつの間にか似てくるようだ。",
              "citation": {
                "source": "イタリア人",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
