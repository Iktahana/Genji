        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まことの神はジュデアの国、ベレンの里にお生まれになったジェズス・キリストばかりです。",
              "citation": {
                "source": "おしの",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェズスは我々を救うために、磔木にさえおん身をおかけになりました。",
              "citation": {
                "source": "おしの",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジェズスは我々の罪を浄め、我々の魂を救うために地上へ御降誕なすったのです。",
              "citation": {
                "source": "おしの",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェズスは二人の盗人と一しょに、磔木におかかりなすったのです。",
              "citation": {
                "source": "おしの",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に勿体ない気のするのは磔木の上からお叫びになったジェズスの最後のおん言葉です。",
              "citation": {
                "source": "おしの",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
