[
  {
    "uuid": "5b0c6ca6-6aef-55cc-aa59-729448b15090",
    "entry": "砂利",
    "reading": {
      "primary": "じゃり",
      "alternatives": [
        "ざり"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "gravel",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭に砂利を敷いて、雰囲気を変えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は砂利道を自転車で走るのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "工事現場には、たくさんの砂利が山積みになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "屋上の砂利の上に関東八州の青空。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "風が強くて干し物がいくつか砂利の上に落ちている。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うへ越して交番に百花園への道を尋ね、向島堤上の砂利を蹴って行く。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関を出れば人々も砂利を鳴らしてついて来る。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水害の名残棒堤にしるく砂利に埋るゝ蘆もあわれなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "港口浅せたるためキールの砂利に触るゝなるべし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "凍結した霜夜の街を駆け行く人力車の車輪の音――またゴム輪のはまっていなかった車輪が凍てた夜の土と砂利を噛む音は昭和の今日ではもうめったに聞くことの出来ないものになってしまった。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは昔この道路の水準がずっと低かった頃に砂利をつめた土俵を並べて飛石代りにしてあった、それをそのまま後に土で埋めて道路面を上げたのであるが、砂利が周囲の湿気を吸収するために、その上に当るところだけ余計に乾燥して白く見えるとの事であった。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "観覧車も今は闃として鉄骨のペンキも剥げて赤※が吹き、土台のたたきは破れこぼちてコンクリートの砂利が喰み出している。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "表の通りでは砂利をかんで勢いよく駈ける人車の矢声も聞える。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "心象※松の木に風が吹き、踏む砂利の音は寂しかつた。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽光がやけに鋭く、砂利を焙った。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "又少し離れた處には大きな土管がいくつも砂利の上にころがしてあつた。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭青年は急いで川砂利の上へ飛び下り、娘の傍へ駈け寄って、抱き起しながら「どうしたのですか」　と訊くと、娘は力無い声で、昨日から食事をしないので饑えに疲れ、水でも一口飲もうと、やっと渚まで来たが、いつの間にか気が遠くなってしまったというのでした。",
              "citation": {
                "source": "鯉魚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ですからもしもこの天の川がほんたうに川だと考へるなら、その一つ一つの小さな星はみんなその川のそこの砂や砂利の粒にもあたるわけです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の赤砂利、陰影だけで出來あがった赤砂利の層。",
              "citation": {
                "source": "うろこ雲",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うの淵の岸では、庄助が、しばらくあちこち見まわしてから、いきなりあぐらをかいて、砂利の上へ座ってしまった。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」その人は、あわてたのをごまかすように、わざとゆっくり、川をわたって、それから、アルプスの探険みたいな姿勢をとりながら、青い粘土と赤砂利の崖をななめにのぼって、せなかにしょった長いものをぴかぴかさせながら、上の豆畠へはいってしまった。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子どもらはみんな砂利に上ってしまった。",
              "citation": {
                "source": "さいかち淵",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただその大部分がその上に積った洪積の赤砂利や、それから沖積の砂や粘土や何かに被われて見えないだけのはなしでした。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばその岩には沈んでできた縞のあること、木の枝や茎のかけらの埋もれていること、ところどころにいろいろな沼地に生える植物が、もうよほど炭化してはさまっていること、また山の近くには細かい砂利のあること、殊に北上山地のへりには所々この泥岩層の間に砂丘の痕らしいものがはさまっていることなどでした。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはやはり北上山地のへりの赤砂利から、牡蠣や何か、半鹹のところにでなければ住まない介殻の化石が出ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "所々に壺穴の痕があって、その中には小さな円い砂利が入っていました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この砂利がこの壺穴を穿るのです。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら流されて行く砂利はあまりこの高い所を通りません。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬の蹄の底の砂利をふむ音と水のばちゃばちゃはねる音とが遠くの遠くの夢の中からでも来るように、こっち岸の水の音を越えてやって来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三十尺の高さに噴き上げている水と蒸気を止めるために大勢の人夫が骨を折って長三｜間、直径二インチほどの鉄管に砂利をつめたのをやっと押し込んだが噴泉の力ですぐに下から噴き戻してしまうので、今度は鉄管の中に鉄棒を詰めて押し入れたらやっと噴出が止まった。",
              "citation": {
                "source": "箱根熱海バス紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は君の靴の紐を解くだに足りないもの、數ならぬ砂利の一つだと書いた。",
              "citation": {
                "source": "室生犀星に與ふ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頸すじは、汗につもった土ほこりで、気持悪るく、じゃりじゃりしていた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋼砥の上で金鋼砂がじゃりじゃり云いチュウリップはぷらぷらゆれ、陽がまた降って赤い花は光ります。",
              "citation": {
                "source": "チュウリップの幻術",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
