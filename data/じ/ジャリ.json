        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あそこの砂利、元気いっぱいに遊んでいるね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔は近所に砂利がたくさんいて、いつも賑やかだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「おい、砂利！そんなところで遊んじゃダメだぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
