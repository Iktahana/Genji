          "literary": [
            {
              "text": "勝安芳氏の答書　従古当路者古今一世之人物にあらざれば、衆賢之批評に当る者あらず。",
              "citation": {
                "source": "瘠我慢の説",
                "author": "書簡",
                "note": "青空文庫"
              }
            },
            {
              "text": "右者従古来掃除役人之名小法師と名付、今以知行御切米被下之。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "釈文に「魯読易為亦、今従古」とある。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
