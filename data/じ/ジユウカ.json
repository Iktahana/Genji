        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自由科というのもあって、それは回数券です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（c）自由科の諸芸＊＊の中でも、真に我々を自由にする学芸からまず始めようではございませんか。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それら自由科の諸芸は、いずれもそれ相応に、人生の何たるかを教え、人生をいかに生きるべきかを教えるのに役立っております。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゼノンはその『国家』の巻頭に、自由科の学芸をすべて無用だと宣言した。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
