        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "インターネットサーフィンで時間つぶしをするのは、もはや日常風景だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験勉強をせずに、漫画を読んで時間つぶしをしてしまったと後悔した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「ああ、また時間つぶしちゃった…宿題終わらない！」と彼は頭を抱えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
