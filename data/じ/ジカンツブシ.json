[
  {
    "uuid": "6c9e7a9f-9ebb-5b6a-b532-ee4ffb5f3b99",
    "entry": "時間つぶし",
    "reading": {
      "primary": "じかんつぶし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
