    },
    "definitions": [
      {
        "index": 1,
        "gloss": "killing time",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "待ち合わせの時間までカフェで時間つぶしをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行中、長時間のフライト中は読書をして時間つぶしをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は退屈な会議中、スマホをいじって時間つぶしをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「死線を越えて」という長編を読み、とんだ時間つぶしをしたと愚痴を言っていたのを、私は幼い時に聞いて覚えている。",
              "citation": {
                "source": "苦悩の年鑑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたし達もほかに遊びどころがないから、まあ時間つぶしに出かけて来るんです。",
              "citation": {
                "source": "マレー俳優の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それは酒にも飽き、玉突きにも疲れた跡で、ほんのから勝負をして自分の家へ歸りたくない夜の時間つぶしに過ぎなかつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はわざと作り笑いをもって平気をよそい、お貞やお君さんや正ちゃんやと時間つぶしの話をした。",
              "citation": {
                "source": "耽溺",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ時間つぶしにやつてゐた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ鶏だけは、暑さにもめげずに、台所の登り口の下のからからにかわいた地面を、しきりにあしでほじくりながら、どうにか時間つぶしをしていましたけれど、そこにはもう鶏たちも先刻ご承知のとおり、穀粒ひとつだって残ってはいないのです。",
              "citation": {
                "source": "夢がたり",
                "author": "TO, CHEVO NE BYLO",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は時間つぶしに、買いこんだ農奴全体の詳細な表を新らしく拵らえたり、旅行鞄の中から捜し出した＊10ラワリエール公爵夫人の著書を読んだり、手箱の中からいろんな持物や書附を出して調べたり、二三の書類を改めて読み返してみたりしたが、何をしても矢張りひどく退屈だった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "（世間ではこの歌から予めを抜いたやうな歌を作つて歌と思つてゐるらしいが、いらぬ時間つぶしである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀕死の病人のために、下らない売薬を買ひに来て時間つぶしをした愚劣さが思はれて、ムシヤクシヤして、怒つたやうな声を出した。",
              "citation": {
                "source": "イボタの虫",
                "author": "中戸川吉二",
                "note": "青空文庫"
              }
            },
            {
              "text": "子鮒とか泥鰌とか、ろくなものはいないだろうが、大食いの懶け者には、手頃な時間つぶしだ。",
              "citation": {
                "source": "ものの影",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "読書とひそかな無駄話が時間つぶしでした。",
              "citation": {
                "source": "落雷のあと",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、熊の木彫での時間つぶしとは、どうしたことであろう。",
              "citation": {
                "source": "山上湖",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "勤め人が最高なのは面白い社会諷刺画＝つまり勤め人は机の前から動かないというだけで、そんなに暇で、こんな重くるしい印刷物をも時間つぶしにかく多く読むということになるのだ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "山に這入れば髪も刈れず、幸い、時間つぶしに筋向いの理髪所に行く。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時頃、朝昼兼用の食事をして、新聞にまた隅々まで眼を通したり、ぼんやり空想に――空想という奴は、時間つぶしに一番いいんだ。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "君なんかには分るまいが、待つということが、単に食事を待つんでもいい、結構な時間つぶしなんだ。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、一たん列車から下りて、あの山路を越えていかねばならないが、あの重い機械化された部隊が、あの※を越えていくのは、たいへんな手間でもあり、時間つぶしであった。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとに、ムダな時間つぶしだわ。",
              "citation": {
                "source": "髪の毛と花びら",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "周平は時間つぶしに日本の神話を聞かしてやり始めていたが、それを続けるのもつまらなかった。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間つぶしの相手なんか真平よ。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「じゃあ時間つぶしというのを取消しましょう。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたくしども自分の腕で御飯をいただいております者には、時間つぶしをする余裕なんかございませんわ。",
              "citation": {
                "source": "可愛い女",
                "author": "DUSHECHKA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ時間つぶしにしかならないんです。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "強いて言えば、明日までの時間つぶしに、過ぎた日を散歩している、とでも言えるか。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「結構、自分で時間つぶしをしています。",
              "citation": {
                "source": "光は影を",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時間つぶしを、僕は最初に敢て間尺に合はない仕事と感じたのも無理はあるまい。",
              "citation": {
                "source": "個人的な余りに個人的な饒舌",
                "author": "＝龍之介対潤一郎の小説論争＝",
                "note": "青空文庫"
              }
            },
            {
              "text": "興味中心の通俗小説もかけなければ教師や翻訳や編輯などの仕事もできないわたしは、あひもかはらずさういふとぼけた時間つぶしの外何もすることがなかつた。",
              "citation": {
                "source": "故郷を辞す",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "學者といふものは隨分時間つぶしなことをやるものだ。",
              "citation": {
                "source": "光る生物",
                "author": "神田左京",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、時間つぶしに一段一段、階段の数をかぞえながら三階へ降りて行った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "理由は、時間つぶしだというのであった。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "wasting time",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
