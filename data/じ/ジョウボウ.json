[
  {
    "uuid": "36d6fb1b-b44e-5bee-b522-1391ff0480b5",
    "entry": "条坊",
    "reading": {
      "primary": "じょうぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
