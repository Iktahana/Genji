    },
    "definitions": [
      {
        "index": 1,
        "gloss": "temple's territory",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "かつて、多くの寺院は広大な寺領を持ち、経済的な基盤としていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その古刹は、江戸時代から続く広大な寺領を今も維持している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "寺領内では、寺の規則が適用され、住民はその慣習に従って生活していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "廿五日、壬子、陸奥国平泉保の伽藍等興隆の事、故右幕下の御時、本願基衡等の例に任せて、沙汰致す可きの旨、御置文を残さるるの処、寺塔年を追ひて破壊し、供物燈明以下の事、已に断絶するの由、寺僧各愁へ申す、仍つて広元奉行として、故の如く懈緩の儀有る可からざるの趣、今日寺領の地頭の中に仰せらると云々。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この寺は昔、今川義元公が戦死者の菩提のために、わざと風景のよい山の中腹に建てられたもので、寺領も沢山に附いておったが、その後、信長公、秀吉公、東照宮様と代が変って来るうちに、その寺領もなくなり、久しく無住の荒れ寺となって、妖怪が出るというような噂まで立っていた。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめてと云うので西春日井郡｜小木の里に政秀寺という菩提寺を建て寺領二百石を附した。",
              "citation": {
                "source": "桶狭間合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し後には、余りに其の寄寓が多いので費用がかさみ、盛んに、その寺領である諸国の荘園に、用米の催促をして居るのである。",
              "citation": {
                "source": "応仁の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼處は全山が寺領で、それこそ空を掩ふ大きな杉がぎつちりと生ひ茂り、銃獵を許さぬのであゝまで鳥が多いのだらうと思はれた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "若葉の頃と旅",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえなぞ知るめえが、高野はこの世のあの世、ひと足お山の寺領へ逃げ込めば、この世の罪は消滅、追っ手、捕り手、入山禁制のお山だ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺領の掟すらも弁えぬめくら武士が、目に角立ててのめくら説法、片腹痛いわッ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "開基は了誉上人、始祖家康の生母がここに葬られているために、寺領六百石を領して、開山堂、弁財天祠、外久蔵主稲荷、常念仏堂、経堂、無縁塚坊舎が三カ寺、所北寮が百軒、浄土宗関東十八｜檀林中の随一を誇るだけあって、広大壮麗言うばかりない大伽藍です。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ひはまた廷臣の鼻の上を走る、と叙任を嗅出す夢を見る、或ひは獻納豚の尻尾の毛で牧師の鼻を擽ると、僧め、寺領が殖えたと見る。",
              "citation": {
                "source": "ロミオとヂュリエット",
                "author": "ROMEO AND JULIET",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところどころ、左右から相逼る寺領の白い築地の間に、やっと人一人通れる位の壊れた石段道が、樟の若葉からしたたる夕闇がくれ、爪先のぼりに風頭山へ消えているのが眺められた。",
              "citation": {
                "source": "長崎の印象",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は寺惣代会が開かれる日だ、そして私に寺領の畠を貸すか貸さないかが議せられる日だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら寺領が借れるらしい、さつそく大工さんと契約しよう、其中庵まさに出来んとす、うれしい哉。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺領借入の交渉が頓挫した、時々一切を投げだしたいやうな気分になる、こんなにまでして庵居しなければならないのか。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は書きたくない手紙を三通書いた、書いたといふよりも書かされたといふべきだらう、寺領借入のために、いひかへれば、保證人に対して私の身柄について懸念ないことを理解せしめるために、――妹に、彼に、彼女に、――私の死病と死体との処理について。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇がお寺を崇拝されると、お寺が寺領を沢山持つ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（前略）その日バタリア僧院の神父ヴェレリオは余を聖餐式に招きたれど、姿を現わさざれば不審に思いいたる折柄、扉を排して丈高き騎士現われたり、見るに、バロッサ寺領騎士の印章を佩け、雷の如き眼を※りて云う。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝにては彼等の如く相會して、寺領の收入を處理する意〔父〕祖先一一五―一一七〔族〕アーディマリ家。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして丘の上には赤い鐘楼のある白い寺だの、ライラックのさきそろった寺領の庭だの、ジャスミンの花にうもれた郵便局だの、大槲樹の後ろにある園丁の家だのがあって、見るものことごとくはなやかです。",
              "citation": {
                "source": "真夏の夢",
                "author": "ストリンドベルヒ　August Strindberg",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は自分の土地を荘園へ寄進して脱税をはかるという風潮が全国一般のことになったから、国有の土地が減少して寺領とか権門勢家に所属する荘園がふとって、貴族や寺院は富み栄えて貴族時代を現出する。",
              "citation": {
                "source": "土の中からの話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を見て居た寺の婢女が、其はまだ若い、まう半月もおかねばと言つて、寺領の一部に、蓮根を取る爲に作つてあつた蓮田へ、案内しよう、と言ひ出した。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を見て居た寺の婢女が、其はまだ若い、まう半月もおかねばと言つて、寺領の一部に、蓮根を取る為に作つてあつた蓮田へ、案内しよう、と言ひ出した。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "其を見て居た寺の婢女が、其はまだ若い、もう半月もおかねばと言って、寺領の一部に、蓮根を取る為に作ってあった蓮田へ、案内しよう、と言い出した。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "又は自分の土地を荘園へ寄進して脱税をはかるといふ風潮が全国一般のことになつたから、国有の土地が減少して寺領とか権門勢家に所属する荘園がふとつて、貴族や寺院は富み栄えて貴族時代を現出する。",
              "citation": {
                "source": "土の中からの話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はこの国に仏寺も多く、御朱印といい諸大名の寄付といって、寺領となっている土地も広大なものだ。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "この勢いのおもむくところは社寺領上地の命令となり、表面ばかりの禁欲生活から僧侶は解放され、比丘尼の蓄髪と縁付きと肉食と還俗もまた勝手たるべしということになった。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、彼ら僧侶が遠く藤原氏時代以来の朝野の保護に慣れて、不相応な寺領を所有するに至ったためである。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
