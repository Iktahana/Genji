[
  {
    "uuid": "d5d8d1df-66ef-54dd-9a19-49cdc2222e90",
    "entry": "女婦",
    "reading": {
      "primary": "じょふ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
