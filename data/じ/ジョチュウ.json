[
  {
    "uuid": "242b19d1-c3c5-5962-83e8-d04c6ba75f83",
    "entry": "女中",
    "reading": {
      "primary": "じょちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
