        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マンローによればこれはおもにツキジデスを訳したものだそうであり中には誤謬もあるそうである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　八代龍太へ――「ヘンジデンニテタノム」（一九三三、十、十九、相州夜見村にて）",
              "citation": {
                "source": "水車小屋の日誌",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘンリー、お前の雄弁は生れながらの筈ではなかつたのに、あの説明振りは、共和党を弾劾したわれらのプレジデントの演説よりも素晴しいものだつたぞ。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　その頃私はこのＳ大学協会のレジデント（寄宿人）だった。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分ノ感ジデハ、此ノ空間ヲ往来シテイル電波ノ諸相ニツイテノ研究ハ、ホンノ手ガツイタバカリダト思ウ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "因て急に鉛筆を執りファプリシュースの一段を草して之を懐にし既にワンセンヌに至りジデローを見るも猶お去気奪湧し血脈狡憤して自ら安んずること能わず。",
              "citation": {
                "source": "文士としての兆民先生",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジデロー一誦して善しと勧めて更に敷演して一論を完結せしむ。",
              "citation": {
                "source": "文士としての兆民先生",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "が翌朝十時ごろ私は寝床の中で弟からの電報を受け取ったが、チチブジデキタ――という文句であった。",
              "citation": {
                "source": "父の出郷",
                "author": "葛西善蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮れるともなくぼんやりと明るい北の白夜――そうすると、街角に立つ人影も、尾を垂れて小路へ消える犬も、港の起重機のかすかなひびきも、すべてがひとつの浪漫のなかに解けこんで、人はごく自然に、最も陰鬱な人生のトラジディさえ肯定出来る心状に落ちるのだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "別称チチアネルロ（大匠の息）ジョコンドデジデリオジヤニイノ（この人十六歳の青年、甚だ美し。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "石欄より登り来る階段の上にはデジデリオ、アントオニオ、バチスタ、パリスの四人｜茵絨毯の上に寝そべりている。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ、アントオニオ、バチスタ及びパリス、気づかわしげに、また物聞きたげに、二人の方に進み寄り話しかける。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　生命を創造したチチアノが死ぬと云うのか。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　（欄干に倚りかかっているジヤニイノに。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　誰かよく生きる、彼の後に。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ　（少女たちに。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝の反対派、皇甥李光明一派から密旨を受けた暗殺者が、十二月廿七日のプレジデント・フウヴァー号で横浜に到着しています。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝を退位させて、その後へ皇甥李光明を押し上げようという皇甥擁立派の密旨を受けた暗殺者が、つい一週間ほどまえすなわち十二月二十七日のプレジデント・フウヴァ号で日本に到着している。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝の反対派、李光明一派の密旨を受けた暗殺者が、十二月二十七日のプレジデント・フウヴァー号ですでに横浜に到着し、明日の午前四時、大使が拝謁に行く以前に暗殺してしまう計画があると、何者かが警視庁へ密告して来た。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはいいんだが、……実はね、俺を殺そうという李光明一派の刺客が、二十七日のプレジデント・フウヴァ号で横浜に着いている。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜、プレジデント・ラインのウイルソン号が復航で入港した。",
              "citation": {
                "source": "復活祭",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……プレジデント・フーヴアの楽長が、あっけにとられて、盃を持ったままあんぐりと口をあいていましたっけね……」「レエヌさん、……レエヌさん……」「……ああ、気の毒なママ。",
              "citation": {
                "source": "キャラコさん",
                "author": "鴎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモクラシートハ、ジンミンノタメノ、セイジデアル。",
              "citation": {
                "source": "子どもの世界",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ苦シイ俺ハ遊ブ▽ノすりつぱーハ菓子ト同ジデナイ如何ニ俺ハ泣ケバヨイノカ　　　　　×淋シイ野原ヲ懐ヒ淋シイ雪ノ日ヲ懐ヒ俺ノ皮膚ヲ思ハナイ記憶ニ対シテ俺ハ剛体デアルホントウニ「一緒に歌ひなさいませ」ト云ツテ俺ノ膝ヲ叩イタ筈ノコトニ対シテ▽ハ俺ノ夢デアルすてつき！",
              "citation": {
                "source": "破片ノ景色――",
                "author": "△ハ俺ノ AMOUREUSE デアル",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタト云ッテモ三十ソコ／＼デナオ美シカッタガ、見タトコロ年増女ト云ウ感ジデ、トテモ男性トハ思エナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スポンジデ背中ヲザット流スクライガ関ノ山デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
