  {
    "uuid": "7fbec37a-fc4d-58c2-b393-7239674ad023",
    "entry": "孰",
    "reading": {
      "primary": "じゅく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "久しうありて仰ぎ見るに、空なる月と水のかげと孰れを誠のかたちとも思はれず。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰か主の心を知りし、孰か彼と共に議することを為せしや、孰かまずかれに施えてその報を受んや、そは万物は彼より出、かれに倚り、かれに帰ればなり、願くは世々｜栄神にあれ、アーメン。",
              "citation": {
                "source": "基督信徒のなぐさめ",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "バサリ三十三　其の中の孰れが言ふ？",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰も首垂れた二人の中へ、草に甲をつけて、あはれや、其でも媚かしい、優しい腕が仰向けに落ちた。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "摂理なる観念は敢てキリスト教に限らずこれ一般宗教通有のものでありますがその解釈を誤ること我が神学博士のごときもの孰れの宗教に於ても又実に多々あるのであります。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "新鮮な色彩が眼に、芳醇な香が鼻に、ほろ苦い味が舌に孰れも魅力を恣にする。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に続く木川子、それにかく申す吾輩、殿軍としては五尺六寸ヌーボー式を発揮した未醒画伯、孰れも着茣蓙を羽織って、意気揚々｜塩原へこそ乗りこんだり。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰れも薄気味悪るいギョロギョロした眼を光らして、吾等一行を見送っている。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初登りはダラダラであるから孰れも平気の平佐。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬上孰れも汗ダクダク。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰れも勇気｜凛々、今日を限りにこの痛快無比の旅行と別るるのが残多いようにも思われ、またこの行を了ったという得意の念もあった。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸の有志家｜杉田恭介君、川又英君、及び水戸中学出身の津川五郎君で、孰れも健脚御自慢、旅行は三度の飯より好きだという愉快な連中だ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そもそもこの八溝山というのは、全く海抜三千三百三十三尺という不思議な高さで、山中には三水と唱える金性水、竜毛水、白毛水の清泉が湧き、五つの瀑布と八つの丘嶽とまた八つの渓谷とがあって、孰れも奇観だ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも孰にせい、私が思うたほどの事件でない、とだけは了解したのじゃけれども、医学士などは、出たら目じゃろう。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "後なる一人は、中脊の細い男で、眞中の、其の盲目婦の髮の影にも隱れさうに、帶に體を附着けて行違つたのであるから、形、恰好、孰れも判然としない中に、此の三｜人目のが就中朧に見えた。",
              "citation": {
                "source": "三人の盲の話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰方か乳母の兒で、乳※妹。",
              "citation": {
                "source": "霰ふる",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あゝ、其の姨捨山と云ふのは孰れでございます。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孤驛既に夜にして、里程孰れよりするも峠を隔てて七｜里に餘る。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰方か乳母の児で、乳姉妹。",
              "citation": {
                "source": "霰ふる",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が、孰方を向いても一面の泥田、沼ともいわず底が浅い。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘の姿は、次第に橋を距って、大きく三日月｜形に、音羽の方から庚申塚へ通う三ツ角へ出たが、曲って孰方へも行かんとせず。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と老人は膝を刻んで、恰も此の問を待構へたやうに、「其の儀は、とかくに申しまするが、如何か、孰れとも相分りませぬ。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　泉殿に擬へた、飛々の亭の孰れかに、邯鄲の石の手水鉢、名品、と教へられたが、水の音より蝉の声。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "閨の紅麻艷にして、繪團扇の仲立に、蚊帳を厭ふ黒髮と、峻嶺の白雪と、人の思は孰ぞや。",
              "citation": {
                "source": "五月より",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより談は其事の上にわたりて、太祖、その曲直は孰に在りやと問う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰か云ふ　挾む所無しと、耿々たるもの　吾胸に存す。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "世を挙って　孰か客に非ざらん、離会　豈偶なりと云はんや。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "孰か我が役を罷めしぞ、使君の　力なり。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
