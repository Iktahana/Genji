        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "年ごとにジエンツアノにて執行せらるゝ、名高き花祭の期は近づきぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ジエンツアノはアルバノ山間の小都會なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエンツアノの祭も明日のことなれば、止まればとて遲るゝにもあらず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエンツアノの市にて、ネミといふ湖に向へる方にありき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫しありて、日の光は最早水面に及ばずなりて、ネミとジエンツアノとの家々の屋根をさまよへり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエンツアノを立ちしは月あかき夜なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエンツアノの花祭に往きし途すがらの事なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われはジエンツアノ市を過ぎて、我母の車に觸れてみまかり給ひし廣こうぢを見き。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼かりし日の事を語りて、地下の石窟に入りて路を失ひし話よりジエンツアノの花祭に老侯の馬車の我母を轢殺せし話に至りしときは、姫の驚｜一方ならざりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑ふためにも歌ふためにも、ジエンツアノの葡萄酒を飲むためにも、ピエンツアの無花果を食ふためにも、その外の事をするためにも、永遠に開く時は無い。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで己は話をしながらも盛んにジエンツアノの葡萄酒を飲み続けて、肴には果物を食つた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "己はもうジエンツアノの葡萄酒を随分飲んでゐる。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジエンツアノの葡萄酒やピエンツアの無花果の事がある。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は毎晩己にジエンツアノの葡萄酒一杯を薦める。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの日に飲んだジエンツアノの葡萄酒に酔つて見た夢ではあるまいかと考へた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
