    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これが抽斎歿後の第四十八年に至るまでの事略である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが抽斎歿後の第五十二年から第五十六年に至る事略である。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事略式でそして粗餐ということだったが、それらの人々が大抵、ネクタイピンを光らし、ズボンの折目も正しく、中にはモーニングを着込んだものもあって、東洋軒の広間で、白布の上に花を飾った食卓をとりまいて、礼儀正しく食事をしてるところは、如何にも立派だった。",
              "citation": {
                "source": "道化役",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "万事略式でいゝらしい。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此れ皆家に妻子を蓄へ、口に腥を著けて其の身を駈使せん（以下宿衛舎人の事略す）。",
              "citation": {
                "source": "濫僧考",
                "author": "河原者・坂の者・宿の者・非人法師",
                "note": "青空文庫"
              }
            },
            {
              "text": "（土佐群書類従豊永郷葬事略記）　この記事は明治三年に認められたものであるが、かなり古風な葬儀と異態な作法を伝えている。",
              "citation": {
                "source": "本朝変態葬礼史",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（６）新井白石の『琉球国事略』島津重豪及び赤崎※幹の『琉球談記』などを見ても知らるるなり。",
              "citation": {
                "source": "南嶋を思いて",
                "author": "――伊波文学士の『古琉球』に及ぶ――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
