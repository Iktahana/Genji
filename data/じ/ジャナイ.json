  {
    "uuid": "8c908974-f264-591a-b022-179601258552",
    "entry": "ジャナイ",
    "reading": {
      "primary": "じゃない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――バカヤロウ、アレハ、カンゴクジャナイカ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "不折ハ今｜巴里ニ居テコーランノ処へ通ッテ居ルソウジャナイカ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "不折ハ今｜巴里ニ居テコーランノ処ヘ通ッテ居ルソウジャナイカ。",
              "citation": {
                "source": "『吾輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハネーのネーなんかイラネエジャナイカ、と怒ったってムリだ。",
              "citation": {
                "source": "敬語論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "開幕前に幕内遠く本宿の町の方に当って多数の団扇太鼓の急速な囃、調子をつけて鳴り、それに合せて多数老若男女の群集が走りながら叫び立つる「エジャナイカ！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（言っているところへ、本宿の方の騒音急に激しくなり、エジャナイカ！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸を出る時も千住あたりでエジャナイカ、エジャナイカであちこち叩きこわしが始まっていたが。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんしろ、御聞きの通りのエジャナイカ騒ぎで本宿辺は散々にぶちこわしが始まっていると申しますし、それに何でも噂では百姓一揆がここを通るんだとかで、あれやこれや、ボンヤリ店を開いていて傍杖でも喰うた日にはたまりましねしね……。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙太はいい加減に茶椀を長五に渡してしまい、また急にはげしく聞えて来はじめたエジャナイカのどよめきに耳を傾けるようにして黙っている――間。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると町方衆も楽じゃねえね、エジャナイカの上に何でもここを一揆が通るんだって？",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今聞えて来るエジャナイカの叩きこわしは何のための騒ぎだい？",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エエジャナイカの騒音。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（いっているところへ、本宿の方の騒音急に激しくなり、エジャナイカの声々が潮のように起る）何だありゃ？",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんしろ、お聞きの通りのエジャナイカ騒ぎで本宿辺は散々にぶちこわしが始まっていると申しますし、それに何でも噂では百姓一揆が此処を通るんだとかで、あれやこれや、ボンヤリ店を開いていて傍杖でも喰うた日にはたまりましねしね……。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙太はいい加減に茶椀を長五に渡してしまい、また急にはげしく聞えて来はじめたエジャナイカのどよめきに耳を傾けるようにして黙っている――間）（六尺棒をかい込んだ番太、左より走り出て来て、奥の町の方へバタバタと駆け抜けようとし二人をヒョイと見てギックリ立止る……）番太　……な、な、何だ、お前達は？",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると町方衆も楽じゃねえね、エジャナイカの上に何でも此処を一揆が通るんだって？",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ五時ダネ、オ婆チャン、コレカラ銀座ヘ出テ晩飯ヲ喰ッテ帰ロウジャナイカ」「銀座ノドコヘ」「浜作ヘ行コウヨ、コノ間カラ鱧ガ喰イタクッテ仕様ガナインダ」颯子ヲ呼ンデ浜作ニ電話サセ、カウンターノ席ヲ三四人分取ッテオイテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日己ハ死ヌンジャナイカナ」ト、日ニ二三度ハ考エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論ソレヲオ爺チャンニ出シテ下サイナンテ云ウンジャナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヽ、何カノ時ノ用心ニアレハ取ットク積リナノ」「何云ッテルンダイ、オ前ノ亭主ハマダ四十台ジャナイカ。",
              "citation": {
