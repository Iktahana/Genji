    "definitions": [
      {
        "index": 1,
        "gloss": "is not",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「そんな失礼なことを言ったのは僕じゃ無い！」と、彼は顔を真っ赤にして否定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今日は仕事じゃ無いから、一日中パジャマのままでゆっくり過ごすつもりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "見た目が派手なだけで、中身はそれほど大したもんじゃ無いから期待しすぎない方がいい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その女はいってえ何者だろう」「ねえ、もしや川から出て来たんじゃ無いかしら」と、お徳は摺り寄ってささやいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「兄さんじゃ無い？",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「愚図々々してないで早くあの坊主を捕えていらっしゃい」　「しかし何処に居るのか分らんじゃ無いか」　「馬鹿ねえこの人は」　とお兼。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「兄さん金を送る事を忘れたんじゃ無いかしら」　「そんな事あるまい」と浪之助。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「宿を間違えてんじゃ無い？",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは、ウメカワじゃ無いんだ。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さんこれじゃ乞食も同然じゃ無いか。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがどうだろう、のべつ貧乏の仕通しでその貧乏も唯の貧乏じゃ無いよ。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ばかりじゃ無い、……雁、燕の行きかえり、軒なり、空なり、行交う目を、ちょっとは紛らす事もあろうと、昼間は白髪の仮髪を被る。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "白地の看板を見上げながら……「僕はヒョットしたら、是は村井さんのイタズラじゃ無いかと思うんですが……」　そう云って村井の行動の怪しい点を一つ一つに拾い出した時の自分の微苦笑じみた気持までもハッキリと思い出したのであった。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間会ったじゃ無いか。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "賭博でも打ったのかい」「……そんな処じゃ無いんだ。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ担がれないよ」「馬鹿……冗談じゃ無いぞ。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴が居ると星田の事は尻ベタのホクロまで知って居るんだが、きょうに限って居ないもんだから編輯長がプンプン憤って居るんだ」「村井はモウ事件に引っかかって居るんじゃ無いかな」「ウン。",
              "citation": {
                "source": "殺人迷路",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽象論じゃ無いんです。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それは、どうにかなるさ」「おい、笑いごとじゃ無いぜ。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは、坂田藤十郎が、芸の工夫のため、いつわって人妻に恋を仕掛けた、ということになっていますが、果して全部が偽りの口説であったかどうか、それは、わかったものじゃ無いと私は思って居ります。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――いいえ、そういうわけじゃ無いんです。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいえ、あなたのことじゃ無いんです。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "来てくれるひとが無いんじゃ無い、いてくれるひとが無いんじゃないかな？",
              "citation": {
                "source": "桜桃",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、それはラジオじゃ無い！",
              "citation": {
                "source": "鬱屈禍",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と足音をひそめて私が近寄ると、氏は極々あたりまえの顔をして「炎天の地下層にですな、小人がうじゃうじゃ湧こうとしてるんじゃ無いですかな。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君達、僕に構わずにゆっくり泳いだら好いじゃ無いか。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "てんで、まるで、違うじゃないか！",
              "citation": {
                "source": "海",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "川だなんて、ひどいじゃないか。",
              "citation": {
                "source": "海",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　織田君を殺したのは、お前じゃないか。",
              "citation": {
                "source": "織田君の死",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮肉や諷刺じゃないわけだ。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も用心しなくたっていいじゃないか。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はっきり言ったっていいんじゃないかしら。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな工合いの名前のおかげで、おめえの恰好もどうやらついて来たじゃないか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
