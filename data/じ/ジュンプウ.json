[
  {
    "uuid": "bce1d3eb-cc9e-5f82-bb9f-b8f2d8d39c3f",
    "entry": "順風",
    "reading": {
      "primary": "じゅんぷう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
