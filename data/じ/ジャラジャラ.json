        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は女性にジャラジャラと話しかけていたので、周りの目を引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その店には、ジャラジャラとした態度で客引きをする者が多かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "パーティーで彼は、見知らぬ女性にジャラジャラと絡んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
