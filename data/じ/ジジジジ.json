        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜なべ最中に、よくランプがジジジジと音たて、やがて消えて行った。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "源十郎が、灯心を摘んで油をくれると、ジジジジイと新しい光に、濃い暁闇が部屋の四隅へ退く。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の目醒しは、引越し祝にＮ氏から贈られたもので、普通の目醒し時計のようにジジジジとただやかましくなるのではない。",
              "citation": {
                "source": "木蔭の椽",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後二時の海辺の部屋の明るさ――外国雑誌の大きいページを翻す音と、弾機のジジジジほぐれる音が折々するだけであった。",
              "citation": {
                "source": "明るい海浜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジジジジジジーと鳴るあの耳鳴り、花園の中でその耳鳴りが聴えて来た。",
              "citation": {
                "source": "外に出た友",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、――人穴城の八方にしかけてある自鳴鉦がいっせいに、ジジジジジジジジッ……とけたたましく鳴り渡る。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうか」　と、微苦笑をもらしながら、しばらく、腕をこまぬいて黙想に耽っていたが、やがてジジジジジと机の自鳴鐘が鳴り出すと共に、「お、支度だぞ」　と、九番という木札のついている牢の合鍵をはずして役室を出て行った。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、部屋のどこかで、ジジジジ……と、ブザーが鳴りました。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸火屋の台ランプが、風もないのに、さまよう魂魄を暗示するかの如く、ジジジジと音を立てて、異様に明滅していた。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
