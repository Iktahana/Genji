[
  {
    "uuid": "858648e0-25af-5cb6-93bf-63e7b4a13a34",
    "entry": "人脳",
    "reading": {
      "primary": "じんのう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "human brain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人脳は、地球上で最も複雑な構造を持つ器官の一つである。脳科学の研究は、人脳の機能解明に貢献している。「へぇ、人脳ってこんなにすごい機能を持ってるんだ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人脳の複雑さはいまだに完全に解明されていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "科学者は人脳の可塑性について研究を進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "人脳発生図い　大脳ろ　視神経葉は　小脳に　延髄　次に胎内における人間の脳髄の発生の順序を見るに、比較解剖の結果とほぼ同様な事実を見いだすことができる。",
              "citation": {
                "source": "脳髄の進化",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実験の主な目的は、多くの参考人の言から綜合すると、人間は血液をどの程度に失えば死ぬのか、血液の代用として生理的食塩水をどれ程注入することができるか、どれだけ肺を切りとることが可能か、人脳の切開はどこまでいけるか、心臓の手術は如何、というようなことらしかった。",
              "citation": {
                "source": "戦争医学の汚辱にふれて",
                "author": "――生体解剖事件始末記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の父は明治四十三年本島人脳丁（樟脳採取人夫）の首を伐って逃亡した。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
