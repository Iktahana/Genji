          "literary": [
            {
              "text": "尽人事俟天命、あしたに道をきけばゆふべに死すとも可なり、――こゝに安心決定の鍵がある。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "その詩に曰く、　　日本井上円了博士遠訪于哲孟雄金剛宝土贈詩和之万死奔亡救国危、余生身世入須弥、何当空谷来鸞嘯、了尽人天更不悲。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "水盡人疲、海長陸遠。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
