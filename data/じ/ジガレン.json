          "literary": [
            {
              "text": "ジガレンがほしくてアプアプした。",
              "citation": {
                "source": "日記",
                "author": "一九四七年（昭和二十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者が来て、「腸胃熱でなければ、この頃はやっている、無名の熱かも知れません、もう少し様子を見ましょう」と云って心臓のためにジガレンを調えてくれた。",
              "citation": {
                "source": "一つの芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう大丈夫ですが、覚醒したら、臨床訊問をするといっていますから、念のためジガレンを打っておきましょう」　久美子は無言のまま、マジマジと隆の顔を見あげた。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジガレンの注射を……」　大池は心臓発作をおこしかけている。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
