        "examples": {
          "standard": [
            {
              "text": "週末の夜、ジャズクラブで興奮するようなジャムセッションが繰り広げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ミュージシャンたちは、即興のメロディーを奏で、熱気あふれるジャムセッションを楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「今夜はみんなで集まって、気楽なジャムセッションをしよう！」と友人が提案した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ボブとは、ジャム・セッションをよくやった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは都心での第何回目かのジャム・セッション（第一回目だったかもしれない）のときで、あまり広くないホールには最初から熱気がこもっていた。",
              "citation": {
                "source": "愛のごとく",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れてから私がジャズを聞きにゆくこともあり、ジャム・セッションに行ったのも、あれは初夏だったから、ちょうどそのころだったのではないかと思う。",
              "citation": {
                "source": "愛のごとく",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
