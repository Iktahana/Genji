        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヤー、オーチェン、ジャーリ、チトー、ウィ、ウェジャイチェ」〔あなたが帰られるのは私はまったく残念です〕ハハハ、だと。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "パジャーリスタ、コームナタ（どうぞ、部屋）って云ったら、ハラショー、ハラショーでした」「どこです？",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パジャーリスタ、オムレツ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パジャーリスタ、カツレツでやっていますから、大丈夫です」　艷のいい顔を吉之助は屈托なさそうにほころばした。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パジャーリスタ・チューチ・チューチ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それが彼らの習慣なんです」「オリガ・ペトローヴァ、わたし、思うとおりを云って、いいでしょうか」「どうぞ」　パというところで一旦区切って、オリガは力を入れてジャーリスタと云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうぞ」　彼女はパジャーリスタとは云わないで、よく街頭の物売女がいうようにぞんざいにパジャーリチェと云った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
