  {
    "uuid": "28860522-b9a2-576f-b263-9358f1a1745f",
    "entry": "ジサ",
    "reading": {
      "primary": "じさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "霧の庭に、アジサイに似た赤い大きい花が燃えるように咲いていた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の頃、お蒲団の模様に、真赤なアジサイの花が散らされてあるのを見て、へんに悲しかったが、やっぱり赤いアジサイの花って本当にあるものなんだと思った。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "爆撃でヒビのイツた病室の天井を睨み乍ら寝苦しい夜つれ／″＼に考えた事、酒の席で武山オジサンにでも談して見て呉れ。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤ」は、この「オジサン」が来ると、喜んでいっしょについてあるくのである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見ると、それはまさしくわが親愛なる「オジサン」である。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "フジサンヤウミガミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "フジサンヤウミノミエルアイビキ！",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "読んでみると章坊の手らしい幼い片仮名で、フジサンガマタナクと書いてある。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何の事なんです、これは」「ほほほ」「フジサンというのは」「あたしでございます」「ああ、お藤さんとおっしゃるんですか」「はい」と藤さんは微笑みながら、立って押入れを探す。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ターザンのオジサンという子供の人気もの――折竹にはそういう反面もある。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "爾時ヴェンガイン村に一素女あり、ジサと名づく、貞操堅固、儀容挺特、挙世無双だった。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジサ女、年中何の月にも属せず、太陽天に停まって動かぬと信ぜらるる日を択び、身に罟を被ったのみ故、裸とも著衣とも言えぬ。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "王大いに悦び救済の法を諮うと、ジサそれは容易な事、国内に荒野が多い、それへ人民の一部分を移して開墾しなさいと勧め、王これに従って見事に凶難を免れた。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この王も年若くて美男だったから、相談たちまち調ってジサを娶り挙国｜極めて歓呼した。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "古スウェーデン三大祭の一たるジサ祭はこの記念のために始められたので、かの国キリスト教に化した後も、毎年二月初めの日曜にこれを祝うて今に絶えぬと、ロイドの『瑞典小農生活』に出づ。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジサ、本名ゴア、原農産物を護る女神という。",
              "citation": {
                "source": "十二支考",
                "author": "羊に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……山羊髯のオジサン。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのオジサンを知っているかね君は……」　呉一郎は、若林博士の蒼い、長い顔を見上げたまま、こころもちうなずいた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それじゃこのオジサンは誰だか知っているかね」　と云い云い自分の鼻を指した。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "機関銃にひっかけられたとかで、右の腕が附根の処から無くなり、左手の食指と、中指と、薬指の三本も亦、砲弾の破片に千切られて、今は金鵄勲章の年金を貰いながら郵便配達をやっているという話で、見るからに骨格の逞ましい、利かん気らしい、人相の悪いオジサンであった。",
              "citation": {
                "source": "眼を開く",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オジサンが見世物になるのけエ」　と訊いてやったら、義歯を抓んでいた親爺が眼を細くしてニコニコした。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オジサンの事かい」「ソレ見い。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
