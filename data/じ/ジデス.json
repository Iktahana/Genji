          "literary": [
            {
              "text": "マンローによればこれはおもにツキジデスを訳したものだそうであり中には誤謬もあるそうである。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アメリカニポーラロイド（Polaroid）トイウ写真機ガアルノヲ御存ジデスカ」ト云ウノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脈ハ大分ヨクナッテイルノデ連レテ帰ルハ私ヲオ信ジニナッテ下サイ、オ嬢サンガスベテ御存ジデス」ト云ッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリス、アメリカノジデス。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてプロコピオスは病気と症状の進行を、医者の眼で見て、ツキジデス（Thucydides）がアテネの疫病を記載した巧みさと熱意で張り合った。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
