[
  {
    "uuid": "250a293b-afcd-5cdd-adb2-6dd9403a08bf",
    "entry": "祖父祖母",
    "reading": {
      "primary": "じじばば",
      "alternatives": [
        "ジジババ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
