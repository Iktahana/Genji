        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あいつ、昔はすごかったらしいけど、今じゃただの爺だよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの爺さん、いつまでも昔の栄光にしがみついてるよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「爺さん、いい加減にしろよ！」と、怒った若者が叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
