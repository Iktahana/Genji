        "examples": {
          "standard": [
            {
              "text": "バスの中で、若い女性が座席を爺さんに譲った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "公園でチェスをしている爺さんたちが、真剣な顔で盤面を見つめている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "隣の家の爺さんは、いつも庭の手入れを丹念にしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
