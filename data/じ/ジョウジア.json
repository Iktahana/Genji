          "literary": [
            {
              "text": "傷の手当のために、ジョウジア街の市営病院へ移すことになった。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベイスウォウタア、ベルグレヴィア、サウス・ケンシントン、それにこのメイフェアの四つが、いっぱんに倫敦市内で一ばん高級な住宅街となっているが、メイフェアの持つ歴史と香気にくらべれば、ジョウジアン時代以後に出来た他の三つの区域は、厳正な意味で倫敦的であるべくあまりに生々しい。",
              "citation": {
                "source": "踊る地平線",
                "author": "黄と白の群像",
                "note": "青空文庫"
              }
            },
            {
              "text": "で――どうでせう――その方とジョウジアァナお孃さんとは駈落しておしまひになつたのですよ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
