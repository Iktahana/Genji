[
  {
    "uuid": "bb54da8f-d5fa-5306-8558-a8a313df8261",
    "entry": "十才",
    "reading": {
      "primary": "じゅっさい",
      "alternatives": [
        "じっさい"
      ],
      "is_heteronym": false
    },
    "grammar": {
