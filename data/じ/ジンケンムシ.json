        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "工場では従業員を深夜まで無賃で拘束するという人権無視の慣行が長年続いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「あんな人権無視の採用試験を平然と実施していたとは、企業の体質が問われる」と専門家は批判した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "人権無視と言わざるを得ない強制収容の実態が内部告発によって明らかになり、国内外で批判が高まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "人権がある以前に、人間には、当人の諾否なく、その人権を附与するという人権無視がある。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和時代に「大君の辺にこそ死なめ」と、全国の学生にたいして暗記を要求し、高らかにうたわしめた文部省の政策は、じつに人権無視のはなはだしきものであつた。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
