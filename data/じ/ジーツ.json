        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "シンのあたりが秋の虫のやうにジーツといふ音をたてゝゐた。",
              "citation": {
                "source": "明るく・暗く",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "シンがジーツと音をたててゐた。",
              "citation": {
                "source": "ランプの明滅",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジーツといふ音は止んでしまつても所在のない彼は指先をネジから離さなかつた。",
              "citation": {
                "source": "ランプの明滅",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は眼を釘付けにされたやうにジーツと鏡の中を見詰めてゐる。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガソリンは随分捜したの……（フロシキ包みを差し出したまゝ、おびえた様な顔をして、しかし目を大きく開いて、赤井の顔をジーツと見詰めてゐる）赤井　さうか、ありがたう。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……三人の子供も、五郎の傍に横に一列に並んで、きまり悪さうにお辞儀をしたまゝ寝台の上の美緒をなつかしそうにジーツと見ている。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎　……（容態にさはりはしなかつたかと、ジーツと美緒を見詰めながら、努めて落着いた調子で）馬鹿だよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
