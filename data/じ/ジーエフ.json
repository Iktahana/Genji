        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ファジーエフの「壊滅」の中のレビンソンなどつよく心にのこっています。",
              "citation": {
                "source": "これから書きます",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、お断りした如く、ジーエフが何のことだか知らない。",
              "citation": {
                "source": "擬似新年",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、なお用心ぶかく、「いや、ジーエフは持つてないよ」　と、さもわかつているという顔で答えた。",
              "citation": {
                "source": "擬似新年",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "おじさまは職業から、ジーエフをお持ちになつていた方がよいと思いますよ」というのである。",
              "citation": {
                "source": "擬似新年",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説を作る時、ジーエフがあつたら、気持も若やぎ体験も増して、大いに役立つことがあるだろうという、甚だ思いやりがあり、且つ大いに適切な忠言だつたわけだが、私の方では、そういう上等の写真機で、たとえば前述の火災現場など写してきたら、小説を書く時の役に立つ、という意味だと思つてしまつた。",
              "citation": {
                "source": "擬似新年",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、やはり、大いにジーエフを知つている顔をして、「いや、あれは、まだ高いだろう。",
              "citation": {
                "source": "擬似新年",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いやりのある、優美な顔をした、この富める青年は、忽ちにして呵々大笑し、ジーエフとは何であるかを私に説明し、私の方は、顔を逆さに撫でられたみたいで、ウームと唸つたが追いつかない。",
              "citation": {
                "source": "擬似新年",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
