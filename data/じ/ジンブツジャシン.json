        "examples": {
          "standard": [
            {
              "text": "このアルバムには、家族の古い人物写真がたくさん収められている。プロのカメラマンが撮影した人物写真は、表情が豊かで魅力的だ。「わあ、この人物写真、すごく雰囲気があるね！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロのカメラマンは人物写真を撮るとき、被写体の目線に特に注意を払う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その人物写真集は、著名人たちの素顔を捉えた傑作だと高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "風景画などの中には、その点景人物のことごとくは、当時の人物写真の美人を切り抜いて貼りつけてあるものがある。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
