          "literary": [
            {
              "text": "君はつねにかのジアナリズムを排してゐる。",
              "citation": {
                "source": "風は草木にささやいた",
                "author": "跋",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しジアナリズムぐらゐが何だ。",
              "citation": {
                "source": "風は草木にささやいた",
                "author": "跋",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕等には文壇のジアナリズムぐらゐではすまない大きな蠱惑や侮辱が絶えず攻めよせて來る。",
              "citation": {
                "source": "風は草木にささやいた",
                "author": "跋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「作品」がそれだと言ふほど大袈裟にほめるわけにもいかないが、ジアナリズムの悪徳をもたぬことは確かである。",
              "citation": {
                "source": "想片",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "兒童文學の新興機運に直面して新に兒童文學の分野に於ける各々の再檢討が問題とせられねばならぬ、童話會がマンネリズム、それはジアナリズムの影響する所の最も大きな童話に於て必然的なものではあるが、さて吾々がこの雰圍氣にどこまで入つて行かうとするか。",
              "citation": {
                "source": "リズム（詩の）に就いての再考察",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            }
          ]
        }
