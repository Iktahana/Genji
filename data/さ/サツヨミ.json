        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、幸か、不幸か、二三冊読んでいるから、まさかに剃刀を逆手に取って、可愛い娘のために、その恋の敵を、暗殺しようとは思わなかった。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "電子本三冊読んでから、レビューをやんなさい」と命じられたときのことだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本もかなり厚いのばかりが二十数冊読めた。",
              "citation": {
                "source": "骨を削りつつ歩む",
                "author": "――文壇苦行記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "金　劇烈な三面記事を、写真版にして引き伸ばしたような小説を、のべつに五六冊読んだら、全く厭になった。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢さんは女学校でスコツトの物を一二冊読んだ事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の本の上に腰をかけて、足の下を吸殻だらけにしいしい一冊読んじゃってから、私の処へ持って来て、「オイ君。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢山読んで知つてゐれば、一冊読んだ本が十冊にも二十冊にもなつて頭に響いて来るのである。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、二冊読む間は祖母たちも黙認してくれた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "われらの如く頭から歌を陳腐に思ふ者は、幾冊読みてもますます陳腐と頭痛を感ずるのみにて、何の結果もなけれど、彼陳腐な歌を作りて自ら喜ぶ歌よみをして、『古今集』以下の勅撰集を始め、代々の歌集をつづけさまに読ましめば、まさかに陳腐を感ぜざるを得ざるべし。",
              "citation": {
                "source": "人々に答ふ",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどう云うものかと思ってその沢山の中の二三冊読んで見ました。",
              "citation": {
                "source": "現今の少女小説について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一冊読了することさえ出来るかどうか。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ヵ月に一冊読めないから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他『弓張月』『朝夷巡島記』『侠客伝』『美少年録』等を初め、五、六冊読切の馬琴物は大概読んでしまった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これでおしまい、とうとう一冊読んでしまいました」　紙数にして五十枚ほどの一冊を、お雪はスラスラと読みおわって、巻をとざしながら、「つまり王昭君という方は、絵をかく人に美人にかいてもらえなかったために、あんな運命になったのですね、美人薄命というのを、裏から行ったようなものですね」と言いました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切経の一冊読むにも一千頁は読まなくてはならぬ、自然に深入りして、仏教の蘊奥とまではいかなくても大分詳しい所まで調べようというようなことになって来たのであります。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーテルリンクの蜜蜂の本を一冊読んでみても知れるとおり、人間以外の世界には、われわれの了解とはまるで性質の違うた了解が幾通りもあるように思われるが、もしもさようとすれば、了解を人間の専売のごとくに考え、わが有する種類の了解のほかには了解はないと独断するのは少しく早計ではあるまいか。",
              "citation": {
                "source": "我らの哲学",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーラン一冊読んだわけではないのだから、教理なぞは勿論何一つ知識のないくせに、私の気持の大半はアラビヤの砂漠をこえ、メッカ・メジナへ辿らうとしてゐた。",
              "citation": {
                "source": "分裂的な感想",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田原へ引越す匆々三好達治さんにすゝめられて、シドチに関する文献を数冊読んだ。",
              "citation": {
                "source": "篠笹の陰の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田原へ引越す匆々三好達治さんにすすめられて、シドチに関する文献を数冊読んだ。",
              "citation": {
                "source": "篠笹の陰の顔",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にはまた、俳句を作るがために参考書も二、三冊読んでみたし、句集も一、二冊読んでみたが、どうもまだどうして作ったらいいのか判らぬという人があります。",
              "citation": {
                "source": "俳句の作りよう",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこれまであなたの著書を二三冊読んだことがあります。",
              "citation": {
                "source": "清水幾太郎さんへの手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だのに多くの貧乏な家の子弟はだ――そう、たとえば、今の金吾君でもいい、あれで僕等と同じ年頃の青年だよ、それがただ貧しく生れついたと言うだけの理由でああして泥んこになって働らくだけで本一冊読めはしない。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯も今日は止めにして哲学の本を一冊読み上げて終はうと思ひ立つた。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごく面白いと自分で思う書物を一冊読むにも、数か月かかって、しかも一週間もたてば、その本の名も内容も忘れてしまった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば本一冊読むのにも、こちらの立場まで戻って来て探してくれたりした。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国の本を一冊読むと、その夜は夢にも幻にもその国の言葉が頭に浮ぶというから大変な人であった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が短歌を始めた事のなりゆきは、昭和三十五年の秋に拘置所の図書を一冊読んでであった。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界的太宰治　ヨーロツパの近代人が書いた「キリスト傳」を二、三册讀んでみて、あまり感服できなかつた。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜更けて珊瑚集を一册讀了しました。",
              "citation": {
                "source": "大島行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに私のやや不滿なのは、この近代活版術の始祖、日本のグウテンベルグとも謂はるべき人についての記述は、どの著書でも二三頁であつて、どの文章でも出典が同じらしく、幾册讀んでも新らしいものを加へることが出來ないことだつた。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
