      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "cheat",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "カジノでイカサマをするサマ師が捕まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は友人を騙してお金を巻き上げるサマ師だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの男は信用できない、きっとサマ師に違いない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "真実か虚偽か、本気か冗談か、平気か狂気か、イカサマ師か怪物か、そうして有罪か無罪か判断に苦しむ大胆さ、しかも生前の主人ダメス王の真価値は勿論、神の権威の軽重までも計りそうな意気組を示しております。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あるイカサマ師の手に落ちていたのを見つけ出し、勝手ながら連れ戻したままの姿で出場させた次第です。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "女客は立止って珠を見て、幾分かで買うと、イカサマ師はそのまま一つ処にはいない、という風に、維新の際の武家高家の零落流行に連れて、零落者と見せかけてのイカモノ師が多かったなどは、他の時代には見られぬ詐偽商人です。",
              "citation": {
                "source": "江戸か東京か",
                "author": "淡島寒月",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ハイカラ野郎のペテン師の、イカサマ師の……」　と云ひかけて居ると、椽側をどたばた云はして、二人ばかり、よろ／＼しながら馳け出して来た。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ハイカラ野郎のペテン師の、イカサマ師の……」と云いかけていると、椽側をどたばた云わして、二人ばかり、よろよろしながら馳け出して来た。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤミ屋、サギ師、イカサマ師のブンザイで、上流家庭へ立入るなどゝ、身の程も知らず、さがりなさい。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "我利々々のダマシ屋の卑怯ミレンなイカサマ師だわねえ」　小花は喚きたてたが、久五郎が例の生れながらに授った手という奴で、うなだれて、よわよわしげに侘びしい笑いを浮かべている様子を見ると、ノレンにスネ押しと思ったか、プイと立って外へとびだした。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう出来事に当って、華頂氏の立場におかれた人間が半狂乱の逆上的忿怒や絶望を味うことがないとすれば、その非人間性はイカサマ師の天性に類するもので、賞讃さるべき理由は見出されない。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その七　宮様は一級紳士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのイカサマ師のおかげで幸福になった遺族たちは、そんな註文を出して故人への感謝の念をあらわそうとしたのだが、その註文の芸術的執行人にとっては、それが死に値いしたというわけである。",
              "citation": {
                "source": "かもじの美術家",
                "author": "TUPEJNYJ HUDOZHNIK",
                "note": "青空文庫"
              }
            },
            {
              "text": "海外に遊学して外国の事情にも通じた天下の名探偵ともあろうものが、イカサマ師の外国人の足跡を外務省へ調べにくるとは大笑いではないか。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十四　ロッテナム美人術",
                "note": "青空文庫"
              }
            },
            {
              "text": "根吉　　イカサマ師だったんだ、気がついた時より奴が逃げた方が一足先。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂兵衛　そのイカサマ師が俺に似てるのか。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（甚太を指ざし）イカサマ師は俺みたいに旅人姿か。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカサマ師といわれた船印彫師辰三郎（三十五、六歳）堅気に見える粋な服装かたちで、眼を配りつつ来る。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "根吉　　堅気に化けたイカサマ師なんだ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "この家のイカサマ師の仲間だというなら、次手に睡らせてやってもいいぞ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手はイカサマ師とはいえ、人を殺したにはちがいなかった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "イカサマ師はあの人じゃなくて、あの人をふんじばった方がイカサマ師。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサマしい氣がして、一人で出すわけには行きません。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
