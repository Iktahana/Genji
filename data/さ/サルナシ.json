        "examples": {
          "standard": [
            {
              "text": "秋になると、山で採れた猿梨が甘酸っぱくて美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "猿梨はキウイフルーツの原種の一つで、小さくて皮ごと食べられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、裏山で猿梨を探して食べるのが夏の楽しみだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「半蔵さま、お粂さまの荷物はどうなさるなし。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと比較にならねどわが邦にもサルナシという菓あり。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし平安朝廷の食膳を記した『厨事類記』に猴喜んで食う故に猴桃とも名づくとあれば、邦名サルナシは支那名を和訳したのか。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
