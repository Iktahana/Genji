          "literary": [
            {
              "text": "元町のサノヘで又革の手提げ一つ買ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "トア・ロードへ出て、清の玩具と小さなベレエを買ひ、元町のサノヘで又ネクタイを一つ買っちまった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "元町へ、サノヘでネクタイ二本、輸入物だが停止価格で三円九十銭といふ安さ、籐のステッキを――これから大いに歩かねばならぬことで――買ふ、これも十五円ウィンナ製。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サノヘイで、ネクタイ掛けを買ひ、ぶら／″＼してると座員数名に逢ひ、本庄でお茶をのみ、宝塚へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人になって元町のサノヘイでネクタイ、ツータルの黒がゝったグリーンの、藤山に一つお揃ひのを買ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "元町を行くと、サノヘイで藤山に会ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑い中を元町ブラをして、サノヘでネクタイ一本求め、阪急会館へ入り冷房で一いきして、「水戸黄門」と「綴方教室」を半分宛見る、「綴方」は稍可。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "元町へ出て、サノヘで買ものしてると、ワンサ人がたかり、くさる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
