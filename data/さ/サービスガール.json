        "examples": {
          "standard": [
            {
              "text": "老舗の洋食店では、制服をビシッと着こなしたサービスガールがテキパキと動いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ホテルのラウンジで、サービスガールにコーヒーのおかわりを注文した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は大学時代、披露宴会場でサービスガールのアルバイトをしていたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "満州国官吏は無論男の場合であるが、それが女の場合になると、満州サービスガールがある。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年の一月に親切で有名な東京飯田橋職業紹介所の鳴物入りの宣伝で、之は千人程の中から選ばれた三十二人の代表的インテリガールが、「帝国ホテルよりも大きな」ハルピンのアジア・ホテルのサービスガールとなって送られて行った。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルのサービスガール、之を訳せば「宿屋のお女中」に外ならない筈ではないか。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
