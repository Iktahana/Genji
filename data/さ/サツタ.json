        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレト　一シヨニ、ソノ　ウタヲ、ヨク　ウタツテ　下サツタ、ヤサシイ　オ母サンノ　コトモ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノアイダ、オクツテ、クダサツタ、ハナノクスリ、オツイデノトキ、スコシオクツテクダサイ、センジテノムト、ノボセガ、ナオツテ、カホリガ、ヨロシイ。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ラセテ下サツタ方ニハ、オ礼ヲ一円サシアゲマス。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ボストン・バッグを引きよせてサッと開き、その中にハダカで詰めこんである一万円のサツタバを三つばかり掴み出して、水たまりのそばの地めんにほうり出す）ほらよ！",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐山　……（ボンヤリ、サツタバの方を見ている）花岡　二千や三千のことで、強盗や人殺しをしている人間だって、ある。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥でドシン、ドシンと音）村子　……（その方をチョット振り返ってみてから、歩いて来て、サツタバを拾いあげ、バタバタと泥をはたき落して、佐山の方に寄って、それを相手の手に持たせる）取っときなさいよ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐山　いや……（リュックをまとめにかかって、手の中のサツタバに気づき、右手ではリュックの紐を持ちあげたまま、その左手のサツを見ている。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（ポカンと口を開いて花岡の顔を見ていたが、やがてわれに返って、よごれた上衣のポケットからサツタバを引き出して、それを見る。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……また更にサツタバを見る。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテガミクダサラナイノデ……ワタクシタチ……マイニチシンパイシテオリマス……ドウナサツタノ……デスカ……」と判じ判じ読んで、オホホホホホホホと、母は笑い出しました。",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
