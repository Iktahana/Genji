          "standard": [],
          "literary": [
            {
              "text": "奉行ヲヤメサセナサイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ辞儀サセタイ校長サン。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サセックス州、ホーシャムの南だ。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなのに、ここイングランドはサセックスのただなかで――いえ、このことはみな明朝ご相談できればと存じます。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　曇りで霧も深い一一月の夕べのこと、ランベリの宿チェカーズに荷を預け、我々は馬車で、曲がりくねった長いサセックスの泥道を抜け、ようやくファーガソンの住む、周囲に何もない古い地主屋敷へと辿り着く。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "が一八六九年か七〇年に欧州へ帰って参りまして、サセックスのホーシャム近くに小さな館を構えました。",
              "citation": {
                "source": "橙の種五粒",
                "author": "THE FIVE ORANGE PIPS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニカ　タベサセテ　クダサイ」ト　タノミマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オバサンハ　アカチヤンヲ　ミチコサンニ　ダツコサセテ　クレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、ソノ　トキ、ジブンノ　アタマニハ　カンザシハ　サセナイ　コトガ　ハジメテ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ　ナホスニハ、イタチサンニ　オモヒキリ　オナラヲ　サセルヨリ　シカタハ　アリマセン」　ヤレヤレ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラックの『俚薬方篇』五九頁に、英国サセックスの俗頸｜腫れた時、蛇を頸の上に挽きずり、罎に封じ固く栓して埋めると、蛇腐るに随って腫れ減ずと見ゆ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "Chichester はサセックスのロンドンの南東にある都市。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "と言うのは、その話ってのが、そもそも私の過去に致命的な打撃を与えた、苦しい思い出だからなんです……さあ、この穢らしい手紙なんですが……どうぞ、ご覧下さい……　お懐しいオサセン様。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "お懐しいオサセン様。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもお懐しいオサセン様。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもああお懐しいオサセン様。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも恋しいオサセン様。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてああ恋しいオサセン様。",
              "citation": {
                "source": "とむらい機関車",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウソン氏はこれより先数年前、英国サセックス州のビルトダウンの共有地に近い畑で道路を作るために土を掘った時、人間の顱頂骨の小さな片を発見したことがある。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "左図はマグレゴア氏の製作に成る『曙の人』の模型にして英国サセツクス州にてその遺骨を発見されし約十万年ないし三十万年前の人の面影である。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケイサツニツゲタリ、コノハナカゴヲウゴカスト、スグバクハツサセマス、ワタクシタチノブカガ、イツモチャントミテイマス。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "的ヲ外レテ落チタ砲弾ガ空中高ク水柱ヲ奔騰サセル。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしサセックスにおいて農業資本が増加し農業利潤が減少するならば、過剰の資本はロンドンやマンチェスタやリヴァプウルやその他サセックスよりも有利に商工業に用いられ得る場所に移動するであろう。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしもしサセックスが独立国であるならば、こうはなり得ず、そして今日ロンドンに送られる小麦は国境内の商工業者を支持するために差し止められるに違いない。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモ、オイシイゴチサウヲタベサセテアゲマス。",
              "citation": {
                "source": "犬さんと、くもさんと、かへるさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　ソコヘ車掌サンガキテ、三匹ヲ　コシカケニ　コシカケサセテクレマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メヲパチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲオリマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　メヲ　パチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲ　オリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
