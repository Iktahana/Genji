[
  {
    "uuid": "ac6d2d35-d9f6-5a78-8745-eef8ea019391",
    "entry": "燦々",
    "reading": {
      "primary": "さんさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞-たる",
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "brilliant",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夏の太陽が燦々と降り注ぎ、ビーチは多くの人で賑わっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の未来は、燦々たる光に満ちていることだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "授賞式で、彼の功績が燦々と称えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "村も畑も燦々と輝いた。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯崎の海岸通を朝の燦々たる日光を浴びて眩しそうに顔をしかめた彼女が、半町ほど向うから歩いて来るのを見た時、ぼくはドキッとした。",
              "citation": {
                "source": "ひとりすまう",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "気を取り紛らす燦々たる星がなければ、永くはその凝澄した注視に堪えないだろう。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "燦々たる星は、もはやここではただの空の星ではない。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "コバルト色に深く澄み渡つた南の空に、大粒の宝玉のやうに燦々と光り輝く十字星は、天空一ぱいに散乱する群星を圧してゐた。",
              "citation": {
                "source": "星",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手を截り去れば手また生じ、脚を截り去れば脚また生じ、金の頭金の手金の脚家｜充満となりて、爛々燦々と輝きわたりければ、この事王の耳に入りしが、仔細を問ひ玉ふに及びて、これ善行の報なりと知れ、福人なりとて売薪者を急に一聚落の長に封ぜられしとぞ。",
              "citation": {
                "source": "印度の古話",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　やがて、水の流を前にして、眩い日南の糸桜に、燦々と雪の咲いた、暖簾の藍もぱっと明い、桜湯の前へ立った。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの葛飾にゐた頃にしろ、私は字を削り句を削り、一念に彫心鏤骨の極を尽した、が、了ひには、思ひつめた「白金の唖」のやうになつて、ただ燦々とした涙ばかりが頬を伝うた。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の緑が、そうして白楊のそよぎが燦々と光り、街の屋根が見え、装飾された万国旗の赤、黄、紫が見え、青い海が見え、檣が見え、私たちの高麗丸が見え、ああそうして、白い鴎の飛翔が見えた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "背景は燦々たる白光、　飛沫黒き波濤の連続、オホーツク海の水平線。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "燦々たる岩の群と、ごろた石の河原と両岸のいきるる雑草の花とだ。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日に比して少からず減じた水量のために河中の巌石という巌石は、ことごとく高く高くせり上って、重積した横の、斜の斧劈も露わに千状｜万態の奇景を眼前に聳立せしめて、しかも雨後の雫は燦々と所在の岩角、洞門にうち響きうち響き、降るかとばかりに滾れしきる。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "見おろす一面の河幅は光り、光の中に更に燦々たるものが光って、その点々を舷側に、声なく浮ぶ小舟がある。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に木星の白い輝きの明るさは、燦々と、まことに四邊を拂ふばかりである。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると悟空の心臓には常に倍した偕々勃焉の血潮が蘇り、口腔からは燦々たる火気をフーフーと吐いて奮然と立ち上つた。",
              "citation": {
                "source": "闘戦勝仏",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、極彩色の孔雀が燦々と尾羽を円くひろげた夏の暑熱と光線とは、この旅にある父と子とを少からず喜ばせた。",
              "citation": {
                "source": "白帝城",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "燦々たる岩の群とごろた石との河原だ。",
              "citation": {
                "source": "日本ライン",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日に比して少からず減じた水量のために河中の巌といふ巌は、ことごとく高く高く糶り上つて、重積した横の、斜めの斧劈も露はに千状万態の奇景を眼前に聳立せしめて、しかも雨後の雫は燦々と所在の岩角、洞門のうち響きうち響き、降るかとばかりに滾れしきる。",
              "citation": {
                "source": "日本ライン",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "）の袖を翻へし、うらうらとする陽を突いて燦々と輝く大長刀を、杖に構へてがらんがらんと曳きながら一本歯の大高下駄を履き込んで、一歩は高く雲の峰を踏み越え、一歩は深く地なる悪魔を踏みにぢる概をもつて、のつしのつしと歩みを運ぶ大天狗が、神輿の行列の先頭に立つて、練り出すといふのが竜巻村の祭礼の風習である。",
              "citation": {
                "source": "バラルダ物語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで一層気をつけてみると、そうやって、しおたれ浴衣を着た私は空が燦々した真夏の青空であることを理解し、青桐の葉がふっさりとした緑であることも知ってはいる。",
              "citation": {
                "source": "芸術が必要とする科学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽は燦々と降り灑ぎ藪の向も、どうやら火が燃えてゐる様子だ。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽は燦々と降り灑ぎ藪の向うも、どうやら火が燃えている様子だ。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの物象は、そのみすぼらしさのまゝ、動物らの喚び出した燦々とした書割の中に溶け込んでゐた。",
              "citation": {
                "source": "鳥獣剥製所",
                "author": "一報告書",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく書かない振事劇を書いて、喜の字のお祝いにデジケートすることで、もとよりこれは「燦々会」同志の労をかりて、先生に読んで頂くばかりでなく見ていただく心組みだったのだ。",
              "citation": {
                "source": "古い暦",
                "author": "――私と坪内先生",
                "note": "青空文庫"
              }
            },
            {
              "text": "今こそ、無産階級意識が、大｜炬火の如く燦々と輝やき出したのであった。",
              "citation": {
                "source": "十姉妹",
                "author": "山本勝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「歸つてきて、燦々會で、澤山ためこんでおいた、そつちの演劇の講義を受けもつてくれない？",
              "citation": {
                "source": "あるとき",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミサ子が女学校時分ここを通る毎に感じたような、自信ありげな、燦々光るような雰囲気は、この頃の丸の内のどこの隅にもない。",
              "citation": {
                "source": "舗道",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "燦々と輝く電燈を吊した新興商店街を抜けると、見覚えの道が、黒く柔らかに武蔵野の森に続いていた。",
              "citation": {
                "source": "蝕眠譜",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして正面を眺めますと、御堂の犬防ぎが燦々と螺鈿を光らせている後には、名香の煙のたなびく中に、御本尊の如来を始め、勢至観音などの御姿が、紫磨黄金の御顔や玉の瓔珞を仄々と、御現しになっている難有さは、また一層でございました。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく素晴らしい天候、燦々と照り映える強烈な日光は、とても目をあけていられないほどだが、ところが一体どうしたことか、肝心の雪眼鏡が一夜にしてどこかへ消えてしまったので、詮方なく眼をごく細めに開いて登高を開始した。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
