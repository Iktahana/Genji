        "examples": {
          "standard": [
            {
              "text": "コンサート会場では、最後列からでもステージ全体が見渡せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "コンサートの最後列から舞台を見ると、演奏者の表情まではよく見えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "映画館で最後列の席を取ったのに、前の人の頭が少し邪魔で画面が欠けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "初枝「あら、いゝえ」前進している最後列の生徒、何気なく振り向く。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "身ぶりで、やめておく、と伝え、慶一は令子と最後列に坐った。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "駆逐戦隊の横列を先頭に、それにやや後れて潜水戦隊がつづき、その次に前後左右を軽巡洋戦隊にとりまかれて飛行島の巨体が進み、最後列には特務艦や病院船、給油船が臆病らしく固まり、殿には巡洋艦を旗艦とする別の駆逐戦隊がしっかり護衛していた。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は遺族の最後列に立っていた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞之助も、席を捜している時間がないので、立っている人々の肩の間から覗いていたが、ふと気が付くと、一間ばかり離れたところに、見物人の最後列に立って、ライカを舞台の方に向けて、ファインダーに顔を押し着けている男のいるのが、板倉に紛れもなかった。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
