        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よきサマリヤ人と悪しきサドカイ人とは、隣り合せに住んでいるのではないか。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は偽学偽弁に長じたるパリサイ人を罵れり、彼は罪に充ち汚れに満てるサマリヤの女を救ひに入らしめたり、彼は生命を人間に備へたり、彼は死を人間より絶たんとせり、凡そ斯の如きことは極めて平々坦々たるが如しと雖、其実は無量の深味あるなり。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初にサマリヤへ布教した、ピリポの肖像に相違なかった。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていずれにせよ、私はいかなる場合にも、彼の「よきサマリヤ人」のよき意志を共存者に対して失うことを自らに許さぬであろう。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれだけの周囲が自分に許さるるかは、その人の器の大小によるのでありますまいか、キリストはサマリヤの娼婦にもただちに近づいて説教しました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔のサマリヤ境に近きシンジルの村はづれにて、路傍橄欖樹下に三頭の馬を繋いで昼寝する男あり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "已にサマリヤの境に入れるなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "此れこそゲリジム山、昔サマリヤ人のエルサレムに対抗して神を拝せし跡、今山頂の建物は回教徒遥拝所なり、と案内者は説明す。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "井の傍なる壁に基督サマリヤの婦人に語り玉ふ小さき画額を掲ぐ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ、サマリヤの婦人は指し、基督は目して居玉ふなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナブルスは旧約のシケム、ふるき所にて此処のサマリヤ人の会堂に秘蔵するモーゼの五経は有名なるものなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリヤの墟址　五日。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリヤは概してユダヤよりも地味まされり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち昔のイスラエル王国の首都サマリヤにて、後ヘロデも此処に壮麗なる府を建てぬ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅の興　サマリヤの廃墟より山いくつか越えてシレーと云ふ山腹の村の近くにいたり、馬を繋ぎ、無花果の枝の下に潜り入りて、毛布を地に敷き、少し早けれど携へたる牛乳、パン、ジヤム等にて昼食し、午憩す。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は終日サマリヤの山を行けるなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "エニンは昔のエンガンニム、海抜約六百五十｜呎、人口二千｜左右の小邑、サマリヤの山尽き下ガリラヤの平原起る所の境にあり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "エルサレムよりサマリヤを経て一路エニンに到る迄、常に山上、または峡谷を過ぎて来り、エニンより一歩北すれば忽ち下ガリラヤの野、パレスタイン第一のエズレル平原、またの名エスドレロン平原に下りぬ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "此大平原は、北はナザレ一帯｜上ガリラヤの連山、南はサマリヤの連山、東はキルボア山、小ヘルモン山、西はカルメル山脈に囲繞されたるほゞ三角形の盆地にて、南北の最長約七里、東西の最長十一二里もあらん。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはアイルランドの民話で、ユダヤ、サマリヤ、ガリラヤの国々がすぐ彼等の村々に続いてゐるやうにも聞える話である。",
              "citation": {
                "source": "イエスとペテロ",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "このようにヘブライ語の聖書には「律法」、「預言者」、「知恵」の三つの部分があり、サマリヤ人はこの中「律法」だけを聖書としてもっていた。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスの時代には、ユダヤ人の住む地は今のパレスチナの南部であるユダヤ地方、北部であるガリラヤ地方、並びにヨルダン川の東部であるペレヤ地方に大別され、ユダヤとガリラヤとの間にあるサマリヤ地方とその住民は、社会的、宗教的に別個の集団をなしていた。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "イエスの生誕当時ユダヤ全国を治めていたヘロデ大王はすでに死に、今ではユダヤ、サマリヤの二地方はローマ帝国の直轄となり、ガリラヤ及びペレヤはヘロデ大王の子ヘロデ・アンチパスがその国守に任ぜられていた。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　ユダヤ及びサマリヤ伝道　共観福音書はイエスのガリラヤ及び異邦伝道を主に記述し、ユダヤ伝道については最後の上京の時の一週間を記すのみである。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反しヨハネ伝では、イエスのガリラヤ伝道の記事は簡略であるが、ユダヤ及びサマリヤ伝道について詳しい。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時のユダヤ滞在の後、イエスはサマリヤを経由してガリラヤに帰った。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガリラヤとユダヤとの通路はペレヤ経由とサマリヤ経由との二つがあったが、普通に前者がとられ、後者によるものは稀であった。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリヤ人は、もとはイスラエル民族の一部であったが、その後人種的にも混血の結果純粋さを失い、宗教生活もユダヤ人と離れて別個に営んでいた。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユダヤ人とサマリヤ人とは互いに他を蔑視して、平生交際せざる間柄であったから、ユダヤ人はガリラヤとユダヤを往復するに際しても、サマリヤを避け、東に迂回してペレヤを通過する道を選んだのである。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
