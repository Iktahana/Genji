        "examples": {
          "standard": [
            {
              "text": "株式市場でのサヤ取りは、リスクとリターンのバランスが重要です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "外国為替市場で有利なサヤ取りの機会を見つけました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はデイトレーダーとして、短期的なサヤ取りで利益を上げています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
