        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "春になると、庭へ、ヒアシンスや馨水仙が不断に咲き満ちると云うことであった。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽の熾な火熱の中に、燃えながら咲き満ちる華の美しさではなくて、沈黙の月光が、蒼白く顫える中に燦めく氷華のような美くしさなのである。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か一つの転機が、彼女の上に新らしい刺戟と感動とを齎しさえすれば、一旦は霜枯れたそれ等の華も、目覚ましい色をもって咲き満ちる可能性が、一つ一つの細胞の奥に巣籠っていたのである。",
              "citation": {
                "source": "地は饒なり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上に咲き満ちる花と、瞬く小石と、熟れて行く穀物の豊饒を思え。",
              "citation": {
                "source": "地は饒なり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
