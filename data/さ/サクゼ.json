          "literary": [
            {
              "text": "尊王攘夷と開港佐幕と、昨是今非の紛々たる声に交って、黒船来の恐怖心が加わった、地に鬱積している不安動揺の声なのである。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨是今非、轉々として底止する所を知らず。",
              "citation": {
                "source": "美的生活を論ず",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "然りと雖も人老ゆるに及んで身世漸く落寞の思いに堪えず壮時を追懐して覚えず昨是今非の嘆を漏らす。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
