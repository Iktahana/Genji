        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アブレーロスを槍をもてアーンチロコスは打ち取りぬ、アガメムノーン、民の王、王は倒せりエラトスを、サトニオエース清流のほとりに近く、嶮要のペーダソス市に住む者を――又ピュラコスの逃げ行くを　35打ちて倒せりレーイトス、ユーリピュロスはメランチオス。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "こなたアカイア軍勢は將ヘクトール去るを見て、　440ます／＼勇を振りおこし、トロイア軍に攻めかかる、中にはるかに拔きんじてオイリュウスの子アイアース、鋭き槍を振りあげて突けり敵將サトニオス。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の仙女と契りつゝ彼を生めるはエーノプス、サトニオイス岸の上、牛を牧ひたるエーノプス。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "英雄の王たるアガメムノンは、轟々たるサトニオの大河に洗わるる峻嶮なる都市に生まれたるエラトスを打ち倒しぬ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
