        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "歌人仲間が短册會を起して金を拵へ、細君の藥代として送つてよこして呉れたもその時であつた。",
              "citation": {
                "source": "樹木とその葉",
                "author": "貧乏首尾無し",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころよりは少し前になるとおもふが（誰かしらべて確めて欲しい）、若山牧水君が病氣で靜養してゐるころ、見舞のために歌壇で短册會を催したことがある。",
              "citation": {
                "source": "北原白秋君を弔ふ",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
