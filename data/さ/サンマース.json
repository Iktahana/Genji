          "literary": [
            {
              "text": "ロンドン寓所を友人サンマース氏の宅に定む。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝、サンマース氏の監督せる公立小学校を参観す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンマース氏夫婦および大場氏、余を送りて停車場に至る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "水谷、大場両氏のここに迎うるありて、ともに駅前の料理店に入りて会食し、これより自動車を雇いて、スタンフォードヒルなるサンマース氏宅に帰寓す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国滞在中は、サンマース氏の厚意をになうことすくなからず、また根岸氏の歓待をかたじけのうす。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
