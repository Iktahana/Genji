        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "為れることはすべて為れた、あとは結果を待つばかりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「君の望むことは為れるだろうか？」と彼は尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "為れるべきことは、もう為れたはずだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
