[
  {
    "uuid": "78e6aaea-fbb4-5b6e-840e-39b1f498a206",
    "entry": "為れる",
    "reading": {
      "primary": "される",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段"
      ],
