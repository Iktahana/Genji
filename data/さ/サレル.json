    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧士ナドニ反抗サレルヤウデハ奉行ノ威徳ガナイノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが觀るところの演劇は、緑肥えたる葡萄圃、行人｜絡繹たるサレルノ街道、其背後の暗碧なる山脈等を道具立書割として、自ら悲壯劇の舞群となれるポムペイ市の死の天使の威を歌へるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "脚底の波打際を見おろせばサレルノの市の人家｜碁子の如く列れり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅の初一日の宿をばサレルノと定めたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレルノ騷壇の光は今既に滅せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "公子は更に語を繼ぎてさま／″＼の事をいひ出で、人々のこれに答へなどするひまに一行は早くサレルノに到りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはサレルノにてみまかり給ひし法皇グレゴリヨ七世（獨帝と爭ひて位を逐はれ、千八十五年此に終りぬ）の遺骨を收めし龕なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行は車に上りてサレルノに歸らんとす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕にサレルノに還りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜襲　天氣好き日の朝舟出して、海より望めばサレルノの美しさは又一しほなるを覺えぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　ミツルクンミタイナ　ヨワムシニマデ、バカニ　サレルト　オモウト　ハラガ　タツテ、「ヒゲサンガ　ナンダイ！",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの医薬の処方や健康回復法の心得書のあるものはラテン語の詩句中にそのままの言語で出ており、これは中世における最高の医学専門学校であったサレルノ（Salerno）の大学で教授されたものである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一の女　　第二の女　　第三の女　　非番の老近侍　　帝の供人同宮人数多　　法王の供人数多及び弟子達　　イタリー、サレルノの農夫の老夫婦　　人民数多、及び不信心な遊び者　　　　第一幕　　　　　第一場　　　　場所　　ヘンリー王の城内の裏手景　近侍達の住んで居る長屋体の建物の中央にある広場。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "静かに幕　　　　第二幕　　　　　第二場　　　　場処　　イタリー、サレルノの一農家（法王の仮居する家）景　舞台の略中央に、貧しいながらも白い清潔な帳を垂れた寝台が置いてある。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ次ノ瞬間ニ殺サレルト思イマシタ。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（邪魔ニサレルコトダッテ度々デスヨ！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊惰ナ階級ノ贅沢ナル生活ヲ連想サレルナラバ、ソハ、別荘卜云フ言葉ガ悪イノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人ハ　コンナワケデ、一シヨニマチヘ行ツタノデ、ソノ時カラコツチ、人参ト玉ネギトジヤガイモハ　イツモ一シヨニオ料理サレルヤウニナリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中世の家庭医学書である有名なサレルノ養生訓は次のように言っている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "プトレマイオスの有名な「アルマゲスト」はすでに1160年にサレルノ（サレルヌム）の医学生たちによってギリシャ語の原稿から翻訳された(5)。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナポリの南東方向およそ30マイルにサレルノがあり、ここは古い学問のランプを灯し続けていて、中世における医学教育の中心になった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "この都市がいつ作られたかは明らかでないが、サレルノの医師は９世紀の中葉には知られており、この頃から大学が作られ始めるまで、偉大な医学校であるだけでなく、病人や怪我人の有名な保養地であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "1100年ごろのニコラウス・サレルニタヌスによる「解毒剤」は中世によく使われた薬局方の本であり、近代の薬局方の多くがこの本に従っていると思われる。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "この学校で最も優れた人はコンスタンティヌス・アフリカヌスであり、彼はカルタゴ出身であって広範囲の旅行の後で11世紀の中葉にサレルノに到達した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての他の本よりもこの医学校を有名にさせたのは「サレルノ養生訓（Regimen Sanitatis）」で、時には「医術の華（Flos Medicinae）」とも呼ばれた本であり、家庭医学を詩にしている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "この本はサレルノで治療を受けたノルマンディ公ロバートに献呈され、「イギリス王のために……（Anglorum regi scripsit schola tota Salerni……）」と書かれている。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
