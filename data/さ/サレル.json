  {
    "uuid": "f1528870-33c1-56e7-b083-dfce729fa9db",
    "entry": "サレル",
    "reading": {
      "primary": "される",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
