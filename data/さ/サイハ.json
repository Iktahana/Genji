[
  {
    "uuid": "1041a3fd-1d10-50ec-b5bf-052cf77e52f2",
    "entry": "歳破",
    "reading": {
      "primary": "さいは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Saiha",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年は歳破の方角に旅行するのは避けた方がいいらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歳破は、日本の陰陽道における凶方位の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歳破を避けるために、引越しの日取りを調整した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ただその方角は鬼門で歳破金神に当っていると思ったことと、暗いランプの光りに照されて隅の煤けた柱に頭の磨り切れた古箒が下っていた。",
              "citation": {
                "source": "老婆",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、太歳神、大将軍、大陰神、歳刑神、歳破神、歳殺神、黄幡神、および豹尾神の八神である。",
              "citation": {
                "source": "迷信解",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいはひその夜も月が出てゐた。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいはひ、山崎氏には、淺見、尾崎兩氏の眞の良友あり、兩氏共に高潔俊爽の得難き大人物にして帷幕の陰より機に臨み變に應じて順義妥當の優策を授け、また傍に、宮内、佐伯兩氏の新英惇徳の二人物あり、やさしく彼に助勢してくれてゐる樣でありますから、まづこのぶんでは、以後も不安なかるべしと思ひます。",
              "citation": {
                "source": "砂子屋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞいちばんのさいはひに至るためにいろいろのかなしみもみんなおぼしめしです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「けれどもほんたうのさいはひは一体何だらう。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっとみんなのほんたうのさいはいをさがしに行く。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おんちゃんごはんおあがんなさいって」「おはんなさいははははは」　父は両手を回し、大きな背にまたふたりをおんぶして立った。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はもうあのさそりのやうにほんたうにみんなの幸のためならばそしておまへのさいはひのためならば僕のからだなんか百ぺん灼いてもかまはない。",
              "citation": {
                "source": "〔「銀河鉄道の夜」初期形一〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいはひにして、大過無き出發となつてくれたらよいと、いまはそれを祈るばかりである。",
              "citation": {
                "source": "『パンドラの匣』あとがき",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいはひ峠上の茶屋が、こゝへ新築をいたすのでございます。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、この言葉を考へ出した男にさいはひあれ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のあのいやらしい告白も、僕のこの小説になにかのニユアンスをもたらして呉れたら、それはもつけのさいはひだ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く全くこの公園林の杉の黒い立派な緑、さはやかな匂、夏のすゞしい陰、月光色の芝生がこれから何千人の人たちに本当のさいはひが何だかを教へるか数へられませんでした。",
              "citation": {
                "source": "虔十公園林",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人はからだがまるで象のやうにふとって、それににせ金使ひでしたから、にせ金ととりかへたほんたうのお金も沢山持ってゐましたし、それに誰もにせ金使ひだといふことを知りませんでしたから、自分だけではまあこれが人間のさいはひといふものでおれといふものもずゐぶんえらいもんだと思って居ました。",
              "citation": {
                "source": "よく利く薬とえらい薬",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはそのひとのさいはひのためにいつたいどうしたらいいのだらう。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいちばんのさいはひに至るためにいろいろのかなしみもみんな、おぼしめしです。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「けれどもほんたうのさいはひは一體何だらう。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕、もうあんな大きな闇の中だつてこはくない、きつとみんなのほんたうのさいはひをさがしに行く、どこまでもどこまでも僕たち一緒に進んで行かう。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、償ってください、償ってくださいは、もう言う力がありませんでした。",
              "citation": {
                "source": "ツェねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さいはひに、火の粉でない。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時も、さいはひ何處の窓も戸も閉込んで居たから、きなつ臭いのを通り越して、少々小火の臭のするのが屋根々々の雪を這つて遁げて、近所へも知れないで、申譯をしないで濟んだ。",
              "citation": {
                "source": "火の用心の事",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道幅もやゝ傾くばかり、山の手の二人が、さいはひ長棹によらずして、たゞ突き出された川筋は、むかしにくらべると、（大）といひたい、鐵橋と註し、電車が複線といひたしたい。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八つどきに、しのびて、こまつやへゆき、さて、みな、てらまゐりせられて、ただ十三四なる、わらはの、るすをもりして、い申されければ、しかたなく、折をさいはひと、のたれこみ、ねたり、おきたり、くふたり、琴をひいたりして、さびしく御ざ候なり。",
              "citation": {
                "source": "盲人独笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、一さいは過ぎて行きます。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつさいは祕密だだがなんて青い顏をした奴らだおれの腕にぶらさがつて蛇のやうにつるんでゐた奴らだおれは決して忘れないおれの長い歴史からあいつらは死よりも恐ろしい祕密だ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがじつさいはそこに鐘はあつたのです。",
              "citation": {
                "source": "鳥右ヱ門諸国をめぐる",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしじつさいは空に鐘なんかとんではゐませんでした。",
              "citation": {
                "source": "鳥右ヱ門諸国をめぐる",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
