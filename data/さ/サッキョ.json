        "examples": {
          "standard": [
            {
              "text": "医療廃棄物の安全な削去方法について検討する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い橋の老朽化した部分の削去作業が始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "不要なデータをシステムから完全に削去する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "故に水戸で大日本史を編纂するに當り義公の英斷で神代を削去つたことが傳へられてゐる。",
              "citation": {
                "source": "天津教古文書の批判",
                "author": "狩野亨吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "笞と杖とは共に、臀を打つ竹の棒であるが、我が『令義解』（卷十、獄令）に、凡杖皆削去節目。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "黴あるものはその上皮を削去りて料理に用ゆべし。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
