        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三月十一日圍碁厭盡紛紛世上爭　　厭尽す紛々たる世上の争、但留客好對楸に対す、不問客從何處到　　問はず客の何処より到るかを、堪嗤衰翁索居情　　嗤ふに堪へたり衰翁索居の情。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史は人をして古今の人物に交はらしむ、人は更に離群索居独り静思を楽しまんと欲す。",
              "citation": {
                "source": "凡神的唯心的傾向に就て",
                "author": "山路愛山",
                "note": "青空文庫"
              }
            },
            {
              "text": "○　そもそもわたくしは索居独棲の言いがたき詩味を那辺より学び来ったのであろう。",
              "citation": {
                "source": "西瓜",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧社分散シ索居ノ嘆ナキ能ハズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類は社会的動物であって離鮮索居の孤寂が忍び難く、友を求めて共に歓楽するを喜ぶ。",
              "citation": {
                "source": "婦人問題解決の急務",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
