        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "時は初秋、一味清涼の秋風が空には流れても、山間の雑木林にはささ栗の毬がまだ青く揺れてゐる頃であつた。",
              "citation": {
                "source": "神童の死",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒々と揺れてゐるものは、孟宗のほづえ、ささ栗のそばの榧の木、枯枝の桐の莟、墓原の香のけむり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
