          "standard": [],
          "literary": [
            {
              "text": "そして、遠くで聞くも近くで聞くも同じやうな一種の錆声で、矢張低く呑気に『豆腐ア』と、呟やく如く叫んで過ぎた。",
              "citation": {
                "source": "葬列",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　錆声が、野太く叫んだ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔の蒼白い、頬骨の高い、眼の凄い、義太夫語りの様な錆声をした婆さんである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おしだすようなこの錆声、すこし訛のあるずの音、舌が縺れるようなこの早口な言いかた……。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野介の錆声が、耳鳴りに聞える。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
