        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして「幡随院」をつとめ、「雛妓」をつとめて、「活動のロッパ」のみ休演、サトウロクローに僕の役、石田がサトウの役又代りにて相つとめ、僕は宿へ帰ったものである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "発信控小国英雄　滝村和男　三益愛子　川村秀治　伊藤松雄　正岡容　太田一平　山野一郎　上山雅輔　中野実　渡辺篤　サトウロクロー　大庭六郎　石村宇三郎十一月九日（土曜）　退院――新大阪ホテルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクロー酔払って大辻に「浪子は悪趣味だ、よしなさい」と言ひ、大受け。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤とサトウロクローの二人が休んじまった、「人生勉強」も代役が多くて弱ったが、「金剛五郎」と来ては全くひどいことになった、渡辺の役を横尾泥海男、サトウの役を田島がやり、しどろもどろで何うやら終った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月五日（月曜）　観音様へ参詣し、本屋へ吉川英治の「金忠輔」を注文して、座へ来ると、今日サトウロクロー休み、「サクラ日本」の役は堀井が代る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月六日（火曜）　サトウロクローの口がくさかった、きいてみたら大蒜を食ってるんだそうだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクローが「芝居の世の中は大傑作だ」と賞める。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ後、サトウロクローを、毎日舞台で踏み台にするから一杯飲ませようと、大庭六郎と共に銀座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月二十五日（水曜）　今日は、不意にサトウロクロー休みで、堀井英一が代役。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "表へ寄ってみると、鈴木ケイ助ってのが此の次から入ると言ふ、相談無しに入れちまふとはひどい、サトウロクローは、古川・大辻並の金を呉れなきゃーと申出て来たから断はると言ってた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部すんで、サトウロクロー・大庭等と公園裏のドン／″＼焼屋へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺が帰って来たので、「まだニンニク食ふ気か」と言ったら、サトウロクローと共演すると、ツバをかけられる、ロクローは病人故、予防にのむと言ふのだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋は早速変ることになり、僕・生駒がサトウロクローを抱いて、金龍の昔の部屋へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひる終って入浴し、部屋で大阪屋の丼シチュウ赤を終って白を食ってると、サトウロクローのとこへ、花井淳子がどなり込んで来た。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月二十五日（木曜）　座へ出ると、サトウロクローが今日は中耳炎のやうな具合で休むと言って来た由、「二つのネクタイ」は斉藤紫香が代役した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「世直し」も、ボヤ／″＼してるので、サトウロクローが投げちまって、腹が立った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクローが独立を夢みて、十二月旗挙の計画進みつゝある由。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東来り、サトウロクローは、決してそんな計画は無いと否定してるさうだ、うまく行かなかったのだらう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクローの名、今日の都に新宿歌舞伎座出演と出てゐる、又、斉藤紫香にもさそひをかけたりしたことがハッキリした以上、早く処置したい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクローの問題、事務所側にクビの意志がないから、之以上進展しさうもないが、しゃくにさはる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑の王国脱退のサトウロクローと、剣劇の鳥居正が来り、夜中となり、十円置いて帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクロー来訪、浅草の正月は喜劇八座の競争だと言ふ、滝村来り、三月「ハリキリボーイ」阪田英一が脚色、大谷俊夫が監督の由。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、サトウロクローが休んでゝ、代役だし、めちゃくちゃなのですぐ出ちまひ、笑の王国のヴァラエティをのぞく。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳の話では、渡辺篤が、何やら画策してゐるらしい、サトウロクローや関時男に連絡をとってゐる由。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サトウロクロー入座希望、条件無しで頼むと言ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時東宝ビルへ、那波氏と会ひ、サトウロクロー並に山野一郎を入れる件につき相談、十月は撮影、十一月が大阪、十二月は「ロッパの大久保彦左衛門」を撮ることを主張する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の中で新聞を見ると、「都」にサトウロクローの緑波一座入りが出てゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二等車、同行サトウロクロー、藤田と北村、すぐセリフを覚えにかゝる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方サトウロクローとはる／″＼神戸へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林一三来り、サトウロクローをハチローと間違へたりして、面喰はせる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
