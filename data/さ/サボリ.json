        "examples": {
          "standard": [
            {
              "text": "彼のサボりは先生の怒りを買い、保護者に連絡が入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "学校のサボりが続くと、進級判定に大きく影響する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "最近のサボりが習慣になってしまった結果、成績が急落した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "べつに、ローカルなテニス・ブームが起こったわけではなく、運動部のなかで、テニス部がいちばんサボりやすそうに見えたからにすぎない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかばかしいや」　そういう気持で、城介たちはほとんど働かず、昼間の勤務はサボり、夜は酒ばかり飲んでいた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
