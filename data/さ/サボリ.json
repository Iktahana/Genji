        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のサボりは先生の怒りを買い、保護者に連絡が入った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "学校のサボりが続くと、進級判定に大きく影響する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "最近のサボりが習慣になってしまった結果、成績が急落した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "べつに、ローカルなテニス・ブームが起こったわけではなく、運動部のなかで、テニス部がいちばんサボりやすそうに見えたからにすぎない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばかばかしいや」　そういう気持で、城介たちはほとんど働かず、昼間の勤務はサボり、夜は酒ばかり飲んでいた。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "船員を漁夫とにらみ合わせて、仕事をさせ、いい加減に馬鹿をみせられていたことが分ると、彼等も時々「サボリ」出した。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、同じ学課でも、図画や作文を好み、外国語に熱中し、仮に体操の時間を頭痛がすると称してサボリ、許可されてゐない書物など読み耽るものがあつたら、これこそ「文弱」の尤なるものであらう。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生はムサボリ食った。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その報復として、舌をかみ切って死んで見せることも出来ないばかりか、待ちかねたようにムサボリつく自分の姿のみすぼらしさに、先生は、堪りかねて涙ぐんだ。",
              "citation": {
                "source": "遺恨",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
