        "examples": {
          "standard": [
            {
              "text": "日本から輸出された車が、中古車として再輸入されるケースが増えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "一度輸出した商品を再輸入する際には、関税の適用に注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その企業は、海外工場で生産した部品を再輸入している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それから最近徳川時代になつて又支那文化の再輸入が殆ど三百年間續きました。",
              "citation": {
                "source": "日本國民の文化的素質",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は日本が昔の奈良朝、平安朝時代の支那人から受取つた所の文化を殆ど皆失つて、さうしてまだ徳川時代の支那文化の再輸入して來なかつた時代、日本が非常に戰亂に荒らされて暗黒の時代となつてゐた足利時代、特に應仁、文明以後に於て之を調べる必要があると思ひます。",
              "citation": {
                "source": "日本國民の文化的素質",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
