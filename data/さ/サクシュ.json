      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "exploitation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの企業は、労働者を不当に搾取していると非難されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "発展途上国の資源が先進国に搾取される構造は、今も続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "歴史を学ぶと、いかに多くの人々が権力者に搾取されてきたかがわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それは、ひどい搾取下にある島民たちで生活されているが、見たところは、パラダイスであった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、どんな者にも搾られはしない」　これ以上搾取されることが厭になった、と云う訳でもあるまいが、安田の死体が、未だ海の中へ辷り込まない、その夜、一人のセイラーと、一人の火夫とが、「又酔っ払った」　第三金時丸は、沈没する時のように、恐怖に包まれた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "自作農は、直接地主から搾取されることはない。",
              "citation": {
                "source": "小豆島",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し誰れかから間接に搾取されている。",
              "citation": {
                "source": "小豆島",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "対岸には、搾取のない生産と、新しい社会主義社会の建設と、労働者が、自分たちのための労働を、行いうる地球上たった一つのプロレタリアートの国があった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士たちは、内地で、自分を搾取するブルジョアジーの利益のために、支那へ来ても、苛まれ、酷使されている。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地の職場にも、飢餓と、酷使と、搾取がある。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "太ッタ大資本家共ハ、鈴文ヤ松駒ノ如キ階級的裏切者ヲ買収シ、諸君カラノ搾取ヲマスマスヤサシクシ、諸君ノ妻ヤ子ヲ、飢ニヒンセシメ、諸君ヲモ絞殺スル反動ノ城塞ヲ固クスルモノデアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼奴ハ内地ニ於テ、労働者農民ヲ搾取シ、蹂躪シテイル奴デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "薪問屋は、中間搾取をやる商売だ。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルチネは、「夜」に於て、××××戦争には反対しているが、虐げられ、搾取された無産階級が団結して遂行する××××は、これを肯定しているのである。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "抑圧者、搾取者に対する、被圧迫階級の戦争には、吾々は同感せざるを得ない。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、広大な植民地と市場を独占した資本家は、自分では何等働かずに、搾取によって寄生的な生活をする。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は、種々様々な方法によって搾取される。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」（レニン）　資本家は、国内の労働者から搾取した利潤以外に、こうして、植民地から莫大な利潤をかき集めてくる。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――これは、帝国主義ブルジョアジーが××によって、プロレタリアートを搾取する、その準備にやる行為の一ツである。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はその軍国主義によって、現在の搾取制度を一日でも長く、確実に維持しようとしている。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松平氏は資本家で搾取者であったろうが、彼の闘志と赤色趣味とは今のプロレタリア運動にたずさわる人々と共通なものをもっていた。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "氷海の無辜の住民たる白熊に対してはソビエト探険隊員は残虐なる暴君として血と生命との搾取者としてスクリーンの上に映写されるのである。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "詳細な事実は確かでないが、なんでもさるかに合戦の話に出て来るさるが資本家でかにが労働者だということになっており、かにの労働によって栽培した柿の実をさる公が横領し搾取することになるそうである。",
              "citation": {
                "source": "さるかに合戦と桃太郎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにその子供を使嗾して親爺の金を持ち出させた親ざるはやはり一種の搾取者である。",
              "citation": {
                "source": "さるかに合戦と桃太郎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫れで私自身が何等労働するの結果でもなく小作人から労働の結果を搾取する事は私の良心をどうしても満足せしめる事が出来なかつた。",
              "citation": {
                "source": "狩太農場の解放",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、つまり今の言葉で云う搾取階級も被搾取階級も、何れも是れも「力の発動」に任せられていた世であった。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って彼、杉山茂丸は、その上海や香港に於て、東洋人の霊と肉を搾取しつつ鬱積し、醗酵し、糜爛し、毒化しつつ在る強烈な西洋文化のカクテルの中に、所謂｜白禍の害毒の最も惨烈なものを看取したに違いない。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "水はそのありたけの勢力を機械に搾取されて、すっかりくたびれ果てて、よろよろと出て来るのである。",
              "citation": {
                "source": "軽井沢",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いまは搾取階級なんだ」「勤めているんだろう？",
              "citation": {
                "source": "街頭の偽映鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分たちの生活が人間以下のものであることを自覚した彼らが、そして一方に自分たちの労働を搾取することによって豪奢な生活を構えている前田賢三郎を見ると、彼らは当然要求すべきものを要求せずにはいられなかった。",
              "citation": {
                "source": "仮装観桜会",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、それはあなたの過失によって、あなたが職工たちから搾取したものじゃありませんか？",
              "citation": {
                "source": "仮装観桜会",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "milking (e.g. a cow's teat)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
