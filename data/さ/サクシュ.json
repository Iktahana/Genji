[
  {
    "uuid": "3db56aff-a52a-5cbf-82ee-c3c13f2ed526",
    "entry": "搾取",
    "reading": {
      "primary": "さくしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
