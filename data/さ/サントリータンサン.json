        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サントリータンサン、登起波（米沢）の牛肉粕漬、ローストポーク。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は、サントリータンサン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン、マカロニと卵のグラタン、ひどく不味いのでつまらない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "先きに、餃子でも食ひながら飲むからと言ひ、サントリータンサン。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン、そしてリゾール・パイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン、チーズトースト、伊藤にお任せの、ビーフ・ミニツステーキ風、バタライス、マッシュポテト添。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
