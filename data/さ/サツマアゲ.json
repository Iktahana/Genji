        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "居酒屋で、熱々のさつま揚げをつまみにビールを飲んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このさつま揚げは、魚のすり身に野菜などを混ぜて揚げたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「さつま揚げに大根おろしと醤油を添えるのが、私の定番の食べ方。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "小僧さんの持っている木箱にはさつまあげ、鮭のごまふり、鯛の飴干し二人は同じような笑いを感受しあって日本橋に立ちました。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――明日は明日の風が吹くから、ありったけのぜにで買って送りましょう……小僧さんの持った木箱にはさつまあげ、鮭のごまふり、鯛の飴干し二人は同じような笑いを感受しあって日本橋に立ちました。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "―明日は明日の風が吹くから、ありつたけのぜにで買つて送りませう……小僧さんの持つた木箱にはさつまあげ、鮭のごまふり、鯛の飴干し二人は同じやうな笑ひを感受しあつて日本橋に立ちました。",
              "citation": {
                "source": "蒼馬を見たり",
                "author": "蒼馬を見たり",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
