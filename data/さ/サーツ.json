          "literary": [
            {
              "text": "棄てた水がサーツと流れて溝へ落ちる音が、暗夜に非常に清々しく聞かれた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "またサーツと一と切り吹抜けて行く涼しい風。",
              "citation": {
                "source": "吉原百人斬",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の家畜小舎には、サーツバシとパングリと云う二匹の牝牛がいました。",
              "citation": {
                "source": "唖娘スバー",
                "author": "ラビンドラナート・タゴール　Rabindranath Tagore",
                "note": "青空文庫"
              }
            },
            {
              "text": "スバーは小舎に入って来ると、サーツバシの首を抱きました。",
              "citation": {
                "source": "唖娘スバー",
                "author": "ラビンドラナート・タゴール　Rabindranath Tagore",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーツと水の如く流れ込む月光、その光の中に曲者は、三間あまりの高さにある唐木の上に這ひ上がつて、一本々々切口のあたりを覗いてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "幽靈の手紙",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
