        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ビフテキは中が生焼で截ると血が出る位だから牛肉中に潜伏する真田虫の原虫がよく死なん。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その外鱒、シビ鮪、鮭、カマス等の肉中には真田虫の原虫を含む。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に鱒と鮭の生肉を長く食しおれば人の腹中に必ず真田虫を生ず。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
