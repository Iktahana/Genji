        "examples": {
          "standard": [
            {
              "text": "洗面台に置いてあるサボンは、オーガニック成分で作られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "高級なサボンを使うと、肌がしっとりとした感触になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このサボンは南フランスで製造されており、香りが素晴らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それから、サボンへ寄り、ハイボール二杯やり、宿へ帰ったのは、十二時すぎ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
