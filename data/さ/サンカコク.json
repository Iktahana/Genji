        "examples": {
          "standard": [
            {
              "text": "国際会議には、世界各国から多数の参加国が集まりました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この条約の参加国は、環境保護のために協力していくことを誓った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今年のオリンピックには、過去最多の参加国が名を連ねています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "国連参加国の内部で、公然と科学の暴力を使用せよと叫んでいる者たちがあることは、もはやかくしようのない世界の事実である。",
              "citation": {
                "source": "「人間関係方面の成果」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち戦争の惨害は従来の武器とは全く比較にならぬほど広汎にして深刻となり、且つ孰れの戦争参加国にとってもその残虐なる被害は不可避となったのである。",
              "citation": {
                "source": "原子力の管理",
                "author": "仁科芳雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
