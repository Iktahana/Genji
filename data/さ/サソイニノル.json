        "examples": {
          "standard": [
            {
              "text": "怪しい投資の誘いに乗ってしまい、大金を失った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "同僚の誘いに乗って、初めてキャンプを体験した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最初は気が進まなかったが、彼の熱心な誘いに乗ることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "うっかり皆のように誘いに乗ることはあっても、とうていわたしの霊魂は、たくさんの物事をかかえこむ人々につきものの、様々な心配や不安に堪えるだけの力を持たず、この内部の騒ぎのために忽ちに破裂してしまうだろう。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "陛下のことを思いますと、私がお誘いに乗る権利は全くございません」　国王が熱を込めてお尋ねになった。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵も、寄手の長囲策と、粮食の涸渇にあせって、時折は、戦いを挑んで来るが、秀吉は厳重に令して、「彼の誘いに乗るな」　と、かたく部下の妄動をいましめ、封鎖の手をゆるめなかった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
