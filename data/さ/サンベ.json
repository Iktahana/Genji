        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「三遍」サンベン、「三杯」サンバイ。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "人工骨など医療用セラミックスの製造と販売にあたるニューメディカルと、人工宝石のクレサンベールの二つの子会社を設立してセラミックスのあらたな応用分野を開こうと試みる一方で、宝石用台座の加工にあたる日本キャストと、通信、音響、事務機器メーカーのサイバネット工業に資本参加していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそ一粒種の坊ちゃんですから、親御さんたちはそれこそサンベアットム　ヘセアットム　コテしてゐる方です。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生や奥様のお顔の色を見たゞけでもサンベヱンする様です。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリムゼルでも、グラン・サンベルナールや、サンゴタールでも、自動車の使えない山の奥の往来には、御客ばかりでなく、小荷物も頼めるから非常に便利である。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて文化元年正月、かの地を発船し、マルゲシ、サンベイッケ等を経て、七月の初めカムシカツカに着き、翌月発船して九月長崎に帰る――　という物語。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "午時、電車にてサンベルナルド町に至る。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはサンベルナール種の老犬で、クリストフが家の前の腰掛にすわっていると、眼の血走ったその太い頭を、彼の膝へもたせに来た。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンベリ近辺に到達するまでに？",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンベリで水道各社のほとんどが取水する。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだなあ、サンベリとオックスフォード間のどこかで腸チフスが大流行したとしよう。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンベリティからメイフェアまでグランドジャンクション社の給水系だから苦しむだろう。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "心臓をサンベというが、それもアイヌ語と同じ形である。",
              "citation": {
                "source": "日本語とアイヌ語の関係",
                "author": "――マタギという言葉の存在について――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
