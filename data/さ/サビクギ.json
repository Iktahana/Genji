          "literary": [
            {
              "text": "何時の間にか看視の眼を眩まして廊下の隅から錆び釘を抜き取って、また咽喉へ突き立てたのだ。",
              "citation": {
                "source": "双面獣",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨居にあるのは小さな錆び釘で、正月の輪飾りをかけた残りのものだった。",
              "citation": {
                "source": "浅間噴火口",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし大きな錆び釘を持っていたら、お願いだから私を思いっきり突いて。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
