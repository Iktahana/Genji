        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "最後の一曲はサツフオオの死を題とす。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツフオオの美はアヌンチヤタに似て、その戀情の苦は我に似たり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "（十六世紀の伊太利詩人タツソオと前七世紀の希臘女詩人サツフオオとの傳は今煩を憚りて悉く註せず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "題にはタツソオあり、サツフオオあり、地下窟ありき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛋白石色のあの空がふつと渦巻く海に見え、波間にもがく白い手の老けたサツフオオ、死にきれぬ若い心のサツフオオをありあり眺めて共に泣く。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "路は一すぢ、この先にサツフオオの住む家があろ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て行ことして今一度泣くサツフオオが目に見える。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
