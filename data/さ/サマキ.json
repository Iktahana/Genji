          "literary": [
            {
              "text": "レスター伯がエリザベス女皇をケニルウォースに招待致し候節も慥か孔雀を使用致し候様記憶｜致候。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "逢坂の関ふきもどせ花の風　　すて女女とていかにあなどる花の風　　簪　簪はたしか遊女だった様記憶する。",
              "citation": {
                "source": "桜花を詠める句",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「類聚名物考」には溺器の樣記しあれど、陶製の物有たと聞ぬ。",
              "citation": {
                "source": "蓮の花開く音を聽く事",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            }
          ]
        }
