          "literary": [
            {
              "text": "大きな西洋紙に書いた原稿の初めの方が二、三冊机の上にあった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも日曜などには、食事がすむと、炉の傍らに腰を下ろして、何か難かしい神学の書物を一冊机の上にのせて読み、近くの教会の時計が十二時を打つと、厳粛に感謝して床につくのが、習慣であった。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "駿介はそれと、もう一册机の上にあつたのとを手に取つて見た。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
