        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は修学旅行をサボって、友人と別行動をしていたことが後で判明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "仕事をサボっていたことが監視カメラに記録されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "毎週金曜日に授業をサボる癖がついてしまっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "たまにサボるのも良いですね」苦しい弁解だった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺ア仕事サボるんだ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ずるけてサボるんでねえんだ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "――俺アずるけてサボるんでねえんだど」「それだら、そんだ」「…………」　その日、監督は鶏冠をピンと立てた喧嘩鶏のように、工場を廻って歩いていた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "資本家新聞は、あらゆる労働運動の上に、実によくサボる。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、同盟罷工そのものをサボる労働者が、労働団体が、あるのには少々驚かされた。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "共産党やＣ・Ｇ・Ｔ・Ｕが何かやれば、社会党やＣ・Ｇ・Ｔがサボる。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその共産党がまた、無政府党のやることとなると一々にサボる。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サボる必要ないんですもの。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "下役人がサボる、不正をやる、人民につらくあたる。",
              "citation": {
                "source": "役人の頭",
                "author": "末弘厳太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで全部か」「ほかに会友というのがいますが、みな子供ばかりで」「〈サボ・クラブ〉改称〈四代目クラブ〉だって……サボ・クラブというのは、戦争をサボるクラブというわけなのか」「とんでもない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その変つた面について言ふんだが、地方ぢやアルバイトとかなんとかで、学校をサボる奴は少いわけだな」「さうだ、比較的少い。",
              "citation": {
                "source": "計算は計算",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は幼稚園の時からサボることを覚えたもので、中学の頃は出席日数の半分はサボった。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がここにねころんでいるのはいつものことで、学校をサボる私の仲間はここへ私を探しにきたものだ。",
              "citation": {
                "source": "風と光と二十の私と",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "セーラーたちが、食事をそれほど待ち、むさぼるのは、それが自分自身のためにする（これは資本家のために、再生産することにもなる）唯一の生活手段であるからだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボースンはそれを気にして、彼は、特に、一円を理髪代として貸した――菓子屋の来た時に彼は月二割の利子をむさぼるところのボースンの金を、一円借りたのである。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちは、それこそ、「むさぼるように」遊んでいた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻よりこの二人の子供は、島の外廓に築かれた胡麻石の塀からやっと顔だけを覗きこませ、むさぼるように島を眺めまわしているのだ。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもそれは、いかにも図々しい事のようだから、そこの小さい窓から庭を、むさぼるように眺めるだけで我慢する事にした。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三郎も、むつとした様子で、語調を変へて、「天から貰つた自分の実力で米塩の資を得る事は、必ずしも富をむさぼる悪業では無いと思ひます。",
              "citation": {
                "source": "清貧譚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、おのれの作品が眼のまえで、むさぼるように読まれて居るのを眺めるこの刺すような歓喜！",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は、自動車の窓から、街の奉祝の有様を、むさぼるように眺めていた。",
              "citation": {
                "source": "一燈",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せいぜい華やかにやるがいい、と今は全く道義を越えて、目前の異様な戦慄の光景をむさぼるように見つめていました。",
              "citation": {
                "source": "女の決闘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、自分の恍惚状態を夢のようにむさぼるばかりだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、一夜中、親爺のその煙草の臭いをむさぼるように嗅いだ。",
              "citation": {
                "source": "入営前後",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "密輸入につきものの暴利をむさぼるだけではなかった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏教では、この性欲などを三毒（貪・瞋・痴）のうち、貪（むさぼる本能欲）の中に入れて餓鬼の性質にしていますが、この貪を転向浄化せしむる時は、一切の善を求めて止まざる性質となりまして、遂には完全無欠の人格者すなわち仏陀の位にまで達せられると言うのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっと……」　男は食堂の女を呼んで、「――この娘に、にぎり寿司食わせてやってくれ、それからビールもう一本……」　にぎり寿司が来ると、娘はむさぼるように口へ放り込んで、またたく間に食べてしまい、皿についている飯粒を、舌の先でペロペロと拾った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼も夜も忙しい人は出勤前のわずかな時間までも心せわしさをむさぼるかのように急いで新聞を読む代わりに、さなくばめったに口をきく事のない家族とよもやまの談をかわすもいいだろう。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてかくしのキャラメルを取り出して三つ四つ一度に頬張りながら南方のすそ野から遠い前面の山々へかけての眺望をむさぼることにした。",
              "citation": {
                "source": "小浅間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
