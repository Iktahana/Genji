          "literary": [
            {
              "text": "犠牲者を出さないように全部で、一緒にサボルことだ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、通い詰めていた喜屋武家を時々サボルことになった。",
              "citation": {
                "source": "私の青年時代",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなこんなで、学校には愛想が尽きてサボル日が続いていた。",
              "citation": {
                "source": "私の青年時代",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            }
          ]
