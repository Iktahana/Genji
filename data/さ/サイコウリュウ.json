        "examples": {
          "standard": [
            {
              "text": "証拠隠滅の恐れがあるため、裁判所は被告人の再拘留を決定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "被疑者は一度釈放されたが、新たな証拠が浮上したため再拘留された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "裁判所は逃亡の恐れがあるとして、容疑者の再拘留を認める決定を下した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "あした囚人を再拘留するだけです。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "カトリーナが証言を終わると、裁判が休廷し、囚人らが二時十五分に再拘留されました。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーシは二週間、再拘留され、マンチェスター刑務所へ収監された。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
