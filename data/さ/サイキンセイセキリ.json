        "examples": {
          "standard": [
            {
              "text": "旅行先で細菌性赤痢に感染してしまい、大変な思いをした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "細菌性赤痢は、衛生状態の悪い場所で発生しやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この地域では、細菌性赤痢の集団発生が報告された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "細菌性赤痢を否定することができない、発熱、しぶり、水様便、嘔吐、発汗を伴う下痢が見られた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘロポントスは細菌性赤痢または腸チフスかパラチフスまたはコレラに罹っていたのであろう。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの病気が同時に存在することを仮定しなければならないし種々の髄膜炎やたぶん急性の細菌性赤痢もしばしば見られたであろうがこの時代の著者たちが観察した症状からは特定の診断を下すことができない。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
