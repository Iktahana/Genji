        "examples": {
          "standard": [
            {
              "text": "電源の差し込みが甘く、電化製品が動かなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "壁の差し込みにプラグを挿すと、電気が通じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外旅行には、現地の差し込みに対応した変換プラグが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "spasm of pain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
