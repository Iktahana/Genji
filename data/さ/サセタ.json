        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オ辞儀サセタイ校長サン。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ如何ニ技巧ガ巧妙デアッテモ、モト／＼予ノ趣味デハナカッタノデ、タッタ一遍好奇心ヲ満足サセタヾケデ、ソレキリ同性ト関係シタコトハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ夏軽井沢ヘ行ッテイタ留守ニ寝室ト浴室ト便所トヲ作リ直サセタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナラ用ヲサセタゲルワ」シャワーノ音ガ止マッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ接吻サセタゲルワ」シャワーノ音ガ止ンダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハ牽引ヲオ止メニナッテ、安静ニナスッテイラシッタ方ガヨウゴザイマスネ」ソウ云ッテ佐々木ハ予ヲ無理ヤリニ寝室ヘ運ビ、横臥サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日ハオ爺チャン、ネッキングサセタゲマショウカ」「ネッキングッテ何ノコトダネ」「ネッキングヲ知ラナイノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事ノ世話、入浴ノ世話、ブラッシングノ世話ナド手ガカヽルコト夥シイノデ、婆サンカラ女中達マデ不平ガ絶エナカッタガ、何ト云ッテモ浄吉ガ実行サセタコトハ当時ノ日記ニ記シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二年後ニソノボルゾイハテンパーデ脳症ニ罹ッテ死ンダガ、今度ハ颯子ガ正体ヲ現ワシテボルゾイノ代リニグレイハウンドヲ飼ッテ見タイト自分カラ云イ出シ、犬屋ニ注文シ捜シテ来サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ彼女ヲソウサセタノニハ予ニモ責任ガナイコトハナイガ、浄吉ノ奴ハ亭主ノ癖ニ最初カラ彼女ニ一目置クヨウナ素振ヲ見セテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ座敷ヲ汚サヌヨウニ、ボーイニ命ジテ大型ノシーツヲ二枚持ッテ来サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右足カラ先ニ少シ高ク擡ゲテ、下カラソレニ色紙ヲ当テ、足ノ裏デ印ヲ捺スヨウニサセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ竹翠軒ニ電話ヲカケ、直チニ色紙ヲモウ四十枚届ケサセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度ハ方法ヲ改メテ、足ノ裏ノ朱ヲ一遍キレイニ洗イ落シ、足ノ趾ノ股マデモ一本々々拭イ取リ、立ッテ椅子ニ掛ケサセテ、予ハソノ下ニ仰向イテ臥、窮屈ナ姿勢ニ堪エナガラ足ノ裏ヲ叩キ、色紙ノ上ヲ両足デ蹈マセテ捺印サセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当ハアナタシカ存在シナイノニ、アナタノ五感ニ訴エル擬似現象ハ、アナタ以外ノ存在ヲアナタニ納得サセタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
