        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "真偽看破ノ良策ハ、一作、失エシモノノ深サヲ計レ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "中ノ　サムライハ　マツサヲニ　ナツテ　フルヒダシマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウサギハ、ソンナ　コトニハ　オカマヒ　ナシニ、ミチバタノ　クサヲ　タベテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は三十四年目で始めて、彼女が有坂イサヲと云う姓名で、籍は二里近く離れた柳田村にあることを知った。",
              "citation": {
                "source": "秋の反射",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ三時頃なのでゝもあらう、店にはミサヲと百合子と二人きりで新聞を読んでゐた。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ミサヲも百合子も眉も顰めながら、ひどく心にかゝる風であつた。",
              "citation": {
                "source": "「リラ」の女達",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのつもりで、これを日本文字に直してみよう」右廻し――ソオイナ左廻し――イ右廻し――サヲトセノナチ左廻し――ドニアニ右廻し――ダモオ左廻し――ラ「どうだい！",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「砲声ハマスマス激シサヲ加エテイッタ――」「砲声」というと、人造人間はユラユラと三歩前進してとうとう室の中央へ出てきた。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "石原は原アサヲと一緒になって学校やめさせられたけれども、彼の学者的実力は決していかがわしいものではないのだそうですが。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕『婦人公論』安成二郎が原アサヲのことを書いた、「恋の見合」。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノマヒゴノヤウスノヘンテコリンナコトトイツタラ※　水ノ中ニムヤミト長クツカツテヰタトミヘテ、アタマノ毛ハ一本、一本、サカダチ、カホモカラダモマツサヲ、クチビルハムラサキ色。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何といふ姓かね」「サヲトメといふんです。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよつとかはつてゐますしやらう」「サヲトメとはどう書くのかね」「五月女と書くんです」「……五月女……ステキだなあ。",
              "citation": {
                "source": "老残",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "四阿マデ三十メートル餘デアルガ、コノトコロ日々脚ノ運動ガ不自由サヲ加エ、今日ハ昨日ヨリモ一層歩キニクイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノセイカ手ノ痛ミガ激シク、足ノ運動ガ不自由サヲ増ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ東京ヲコンナ浅マシイ乱脈ナ都会ニシタノハ誰ノ所業ダ、ミンナ田舎者ノ、ポット出ノ、百姓上リノ、昔ノ東京ノ好サヲ知ラナイ政治家ト称スル人間共ノシタコトデハナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガ石ヲ蹈ミ着ケテ、「アタシハ今アノ老耄レ爺ノ骨ヲコノ地面ノ下デ蹈ンデイル」ト感ジル時、予ノ魂モ何処カシラニ生キテイテ、彼女ノ全身ノ重ミヲ感ジ、痛サヲ感ジ、足ノ裏ノ肌理ノツル／＼シタ滑ラカサヲ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "比較対照のために爰にカラサヲの例を挙げてみると、是も明らかに支那から入って来たものであるが、この方はかえって新たに一種の共同作業を促している。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラサヲの方言は上方ではクルリ棒、茨城県などではフルチガヘシ・フルチボーまたはフリボーとも謂っている。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで棹をさし渡して御船に引き入れて、サヲネツ彦という名を下さいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
