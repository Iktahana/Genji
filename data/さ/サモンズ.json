        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "レコードには、昔のコロムビアに、マードック、サモンズ、スクワイヤーのがあるほか、久しく吹込みのなかったもので、メニューイン兄妹とチェロのアイゼンベルクのレコードは、その渇望を満たしたという意味で高く買われたのかも知れない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかにコロムビアにはフランチェスカッティ、ラス、サモンズなどがある。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "サモンズは電気以前に活躍したアーティストで、当時のファンにとっては回顧的な興味を持つだろう。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔はサモンズやカテラルやスクヮイヤーと組んで、ソナタやトリオの大物をじゃんじゃん入れていたが、近頃はポリドールで時々出すだけ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気以前サモンズやマードックと組んで入れたトリオが評判であった。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "マードック、サモンズ、スクヮイアーのベートーヴェンの「大公トリオ」は採らない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
