          "literary": [
            {
              "text": "サツサツと横なぐりの夏の雨である。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "利鎌の動く毎に、サツサツと音して臥る草には、萎枯れた桔梗の花もあつた。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "否、髷やら中指やら簪やらが目に立つと言つて、宿屋の新しい手拭で姉さんかぶりをしてそして土地のものであるかのやうにしてサツサツと歩いた。",
              "citation": {
                "source": "島の唄",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "恁ふ左の手を懐中にしてサツサツと筆を動かされる。",
              "citation": {
                "source": "写生帖の思ひ出",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツサツと帰つてお父さんにさうおいひ。",
              "citation": {
                "source": "小むすめ",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツサツと歸つてくろ。",
              "citation": {
                "source": "旱天實景",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　平次は八五郎を促して梯子を降りると、其處で待つてゐる彌太八に、何やら囁いてサツサツと外へ出るのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき鎌いたち",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
