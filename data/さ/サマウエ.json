          "literary": [
            {
              "text": "庄屋様上りの百姓政治家は帝都の中央では対手にされなかった。",
              "citation": {
                "source": "四十年前",
                "author": "――新文学の曙光――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねんねんよ、ねんねんよ、内の坊やのおめざには、ああかいお日様上げませう。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その当人の器量次第では、妾と思はぬ、奥として待遇ふほどに、そこを万々承知して一ツよい奴、いゑ何よいお嬢様上りのものを、周旋してくれまいかとの、仰せを蒙りましたので。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "組屋敷の門内で仕事をしなきゃ、市ヶ谷の尾州様上屋敷へ荷がついてからだろう」「市ヶ谷の上屋敷じゃありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "この老爺は小田原在の百姓で水右衞門といふのださうですが、村から御領主大久保加賀守樣上小川町の御屋敷にお屆けする、公用金百兩を、月當番二人で江戸まで持つて來ることになつたところ、一人は急病で動けなくなり、水右衞門たつた一人で、覺束ない乍ら江戸まで持つて來たといふのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "盜まれた十手",
                "note": "青空文庫"
              }
            }
          ]
        }
