        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ベテランの料理人は、絶妙なさじ加減で素材の味を引き出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
