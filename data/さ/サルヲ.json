        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サルヲ、最悪ノ猿ト雖モ、最善ノ人間ヨリ悪ヲ行フ所｜尠ク、マタ猿ハ阿諛ヲ知ラヌナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルヲ、猿ノ赤キ雙頬ハ羞恥ノ花火ヲ揚ゲシ故ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アノ　サルヲ　キラウ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ダメダ　ダメダ、キミラノ　ウデデハ　サルヲ　トリニガシテ　シマフ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビヨウキノ　サルヲ　キツテモ　シカタナイト　イフノデ、五人ノ　サムライハ、ソノ　サルヲ　ツレテ　ユキマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、マイニチ　イツテモ　イツテモ　ヒロイ　ノハラデ　タベモノガ　ナイノデ　サルヲ　コロシテ　タベナクテハ　ナラナク　ナリマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "では近代学者が不案内にも強いて妄りにこれをそうした訳はどうかとたずねてみれば、それは初め先ず明治三年（1870）出版の博物館、天産部、植物類の『博物館列品目録』に「サルヲガセ、松蘿 Usnea longissima Ach.」と出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
