    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大仁の町を過ぎて、三福、田京、守木、宗光寺畷、南条――といえば北条の話が出た。",
              "citation": {
                "source": "半島一奇抄",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐうたら手記※私にも三楽といふやうなものがないこともない、――三楽といふよりも三福といつた方が適切かも知れない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "三福の食堂へ五人行って二人きまった。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日、三福寺の上野青ヶ原へ農兵の調練を見に行ったかよ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ創立ノ妓楼トイフモノハ則曰ク松葉屋、曰ク大黒屋、曰ク小川屋今東楼ニ改ム曰ク吉田屋後ニ滅却ス現在ノ吉田屋ハ自異ル曰ク金邑屋後ニ岩村楼ニ革メ又吉野屋ニ革ム此ノ他｜局店ハ曰ク三福長屋、曰ク恵比寿長屋等各三四戸アリ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それでは」「気をつけて行かっしゃい」　危なかしい足どりの勝則が、「三福湯」の角へ消えるのを見送ってから、玄関を入った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉井家の隣りに、「三福湯」という風呂がある。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは十年ほど昔、大石、金五郎、それに、山本佐四郎という質屋を加えて、三人共同経営ではじめたので、「三福湯」という名をつけたのであるが、後、大石一人に譲った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "原田とノブとが、「三福湯」の角まで来ると、三々五々、玉井家から、運動員が出て行く。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、明治十五、六年から二十三、四年頃の女義界は、東玉、京枝を大将として、三福（後の素行）、清花、小政、小住、小伝、花友などに綾之助、これが第一期。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいて、小土佐、小清、錦、越子、住之助、鶴蝶、熊梅などに三福、綾之助を持ち越して、これが第二期の花形。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "三福は声よりも節で渋い芸風、「寺子屋」や「野崎」で鳴らした。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "一席やって（25）、三福食料デパートで、ビフテキとすしを食って、浅草へ帰り、よるの部をやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三福でビフテキとすしを御馳走になり、屋上で浴衣の写真をとり、マイクを通して店内に一言やり、帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食を新橋の三福でとらうと出かける。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "三福の地下でカツレツを食ひ、まづし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月二十七日（木曜）　母上と道子、三人で三福の食堂で食事。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て、三福の二階で鳥のたゝきなべを食ひ、座へ出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おだてては」「今夜は、稼ぎがあったかね」「三福亭で、お侍様を三人揉みました」「それやあ、よかった」「……旦那」　お吉は、揉みながら、顔のそばへ顔をすり寄せて囁いた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんだい」「三福亭のお客様が云ってましたが、土佐の坂本｜龍馬様が、この十五日に、京都で、殺されましたってね」「ふむ……」「ほかに、若いお侍がもう一人」「それも、斬られたのか」　露八は、勤王党の若い武士が刺客の害に遭ったという話を聞くと、すぐに弟の八十三郎を思ってひそかに気遣うのだった。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
