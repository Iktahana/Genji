  {
    "uuid": "83f62a94-ec7e-5848-9d1e-a851f8b7e3fb",
    "entry": "三福",
    "reading": {
      "primary": "さんぷく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
