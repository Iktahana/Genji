        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "己の右左にゐる役人には、意見を交換するに適当な人物がゐないので、己は向側に坐つてゐるプロホル・サヰツチユの方を見た。",
              "citation": {
                "source": "鰐",
                "author": "ドストエウスキー　Fyodor Mikhailovich Dostoevski",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのイスケヨリ姫のお家はサヰ河のほとりにありました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "その河をサヰ河というわけは、河のほとりに山百合草が澤山ありましたから、その名を取つて名づけたのです。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "山百合草のもとの名はサヰと言つたのです。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "その歌は、サヰ河の方から雲が立ち起つて、畝傍山の樹の葉が騷いでいる。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
