        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "所詮ハ筏ノ上ノ組ンヅホツレツデアル、ヨロメキ、ヨロメキ、君モ、私モ、ソレカラ、マタ、林氏、寝ル間モ烈シク一様ニ押シ流サレテ居ルヨウダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、居留民ノ生命財産ノ保護、国旗ノ尊厳トイウガ如キ言葉ニ迷ワサレテハナラヌ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ津浦鐵道ガ南北ニ分割サレテ列車ヲ直通スル能ハズ、南段ノ英資ニ對シテ北段ノ獨資ナルハ先ヅ投資的分割ニ現ハレタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "露西亞ノ外蒙古進出ニ押サレテ日本亦内蒙古ニ進出シテ防備ヲ試ミントスル軍閥ノ支那保全策ハ、或ル程度ニ於テ支那ヲ保全シツツ或ル程度ニ於テ支那ヲ分割スル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ君チャンヤ弟ヤ妹バカリノコサレテシマッタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウ人ッテ、ミンナコウヤッテ、オ父ッチャガ死ニ、オ母ッチャモ死ニ、ジブンモ死ナサレテユクモノダナンテ、何ントイウコトダロウ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一オトッツァンは年寄りだし、それにさんざんジラサレテ、くたくたに体をつからせている上に、持ち物というものがご自慢物ではあるが、二十貫の鉞というのであるから。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アア　縒リタグル熱風ノ一陣ニ　斃サレテ　イチメンノ砂ト無為ト。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "晒サレテ　灌木ト死馬ノ間。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒニ　テラサレテ　オマンヂウガ　ウマク　ヤケルマデ　ジロウハ　ウマニナツテ　スナノウヘヲ　トホクマデ　カケテユキマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川幕府ノ末徴サレテ昌平黌學問所奉行トナル。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "秋月古香略傳",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホキナ　コヱデナニヲ　ネゴトヲイッテルノ」トオカアサンニオコサレテ、ハジメテ　ユメダッタ　トワカリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――震災デ、家ヲ焼カレ、両親ヲナクシテ、一人ボッチニナリ、ワルイ親類ニダマサレテ、芸妓ニウラレ……　とまでいいかけて、急に　――馬鹿らしい。",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ッタナ、僕ハトウニ食ベチャッタンデ、梅肉ヲ下ゲテ行ッチャッタンダ」「梅肉ダッテコヽニアルワ」ト、颯子ハ鱧ト一緒ニ自分ノ梅肉ヲ廻シテヨコシナガラ、「梅肉ダケ別ニ取リマショウカ」「ソレニハ及バナイ、コレデ結構」颯子ハタッタ二片ダケシカ食ベナイノニ、梅肉ガワリニ穢ラシク喰イ荒サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅肉以上ニ喰イ散ラサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩カズニイルト、今ニ本当ニ歩ケナクナリマスト嚇カサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ三十分グライ一人デ寝室ニ待タサレテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦災ノ時ニ又モウ一度改築シタガ、隠居所ダケハ奇蹟的ニ火災ヲ免レタノデ、今モナオ父母アリシ日ノ姿ノマヽニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "抵抗スル隙モナク簡単ニ予ハ押シ倒サレテ芝生ニ仰向ケニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナトコロデ押シ倒サレテ若シ打チドコロガ悪カッタラドンナコトニナルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エライ目ニオ会イニナリマシタソウデ」「ナアニ何デモアリマセンヨ」「兎ニ角見セテ戴キマショウ」臥カサレテ手ヤ足腰ヲ委シク検査サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記ノ内容ヲ読マセハシナイガ、コウ頻繁ニ看護婦ノ必要ガ起ルト、佐々木ニハ或ル程度察知サレテモ仕方ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ二十分バカリ待タサレテイル間ニ同博士ト談話ヲ交シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無鉄砲ノヨウデ、実ハ甚ダ臆病デ用心深イ筈ノ予ガ、佐々木ノ言葉ニソヽノカサレテ頻リニ左様ナ危険ナ注射ヲシテ貰イタク感ジルノハ、ドウモタヾゴトデナイヨウニ思エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅イツル／＼シタ板ノ上ニ臥カサレテイロ／＼ノ形ニ体ヲ彎曲サセルベク命ゼラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "観世音ニハ多少ノ破損ガアルケレドモ勢至像ハ全ク完全ニ保存サレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勢至ハ観世音ト同様ノ装身具ヲ着ケ、正面ノ宝冠カラ瓔珞、天衣、光背等ニ至ルマデ丁寧ニ刻ミ出サレテイ、宝冠正面ニハ宝瓶ヲ現ワシ、両手ヲ合掌シテ立ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このやうに一尊を台座・光背共に一石で作り出した石佛としては全国的に最も古い年号をもつ像で、また鎌倉時代石佛の様式の基準をこれによつて求め得る点で貴重な遺品である」ト記サレテイルガ、予ハコノ写真ヲ見テ、フト思イ付イタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
