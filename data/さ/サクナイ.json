        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――そこで、どんどんから忍川の柵内へ、池のまわり、雪の原へ迷込んだ次第であったが。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "柵内柵外の木々の紅葉は大分散り果てたが、それでもまだ名残の色を留めて居て美しい。",
              "citation": {
                "source": "取返し物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「みんながよくそういいますで」　私たちはいつのまにか、城の正面の柵内にはいりつつあった、軽い足どりで。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして私も彼も、敢て一歩をその柵内に踏み入れやうとは決して願ひませんでした。",
              "citation": {
                "source": "道",
                "author": "――ある妻の手紙――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その柵内に直立して、天を突くさかさ掃木の樣に高い白楊樹の數々と、昨年の火災に燒け殘つた輪廓ばかりの道廳の赤煉瓦とを再び見ると、急になつかしい友人に近づいて來た氣になる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "柵内に繁茂してゐる、脊の高いアカダモや、ドロや、柳やの森をのぞむと、然し、渠は、數ヶ月前の月の夜に、友人と共にその間を散歩しながら、今囘着手した事業の成功を身づから保證したことがあるのを思ひ出す。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "細いどぶの樣な川――それが柵内に流れ入る――に渡した橋を渡ると、道の眞ン中に、一本のアカダモの大樹が立つてゐる。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐久間、滝川両軍の浮足を見て居た家康は、使をやって柵内に入り防禦すべく命じた。",
              "citation": {
                "source": "長篠合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "昌景即ち人数を二手に分け、大久保勢の柵内に逃げ帰るを防いだ。",
              "citation": {
                "source": "長篠合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川の兵｜馳り寄って首を奪い、柵内に逃げもどろうとするのを志村追かけ突伏せてとり返す事を得た。",
              "citation": {
                "source": "長篠合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場の柵内には町長だの兵事係りだの学校生徒だの親類友だちだのが集まって、汽車の出るたびごとに万歳を歓呼してその行をさかんにした。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に、川柳作者のお好みの題材である「内儀」「女房」について、推理川柳の広い柵内にはいるものを少し拾ってみよう。",
              "citation": {
                "source": "江戸推理川柳抄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "本年の象狩には一百頭の象を柵内に追込む事が出来た程の大猟であつた相だ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧場は、やや離れたところにあって、山に放牧されてある数百の羊の群が、二頭の番犬に前後をまもられて、柵内に帰って来る趣きは、これまた油絵そのままである。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "形式として、一まず税関の柵内を通り過ぎる。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜなら、一度石が乗馬像の下の鉄柵内へ逃げこんだときなど、かれは歩道にしゃがんで白い手を伸ばしていろいろに骨を折ったあげく、ようよう石を摘み出して、非常な満足のうちにまた音高く蹴って行ったくらいだから――小石と一しょに吹き溜りの落葉が茶に銀に散乱する。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "余は鶏柵内のミズクサの木の根を深く掘って、薦に包んだまゝ眠った様なデカの死骸を葬った。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史的社会的な現実物の連関は、決して経験の柵内を匍匐するものばかりを産み出すのではない。",
              "citation": {
                "source": "認識論とは何か",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者番兵に掴み出さる番兵に掴み出さる　で翌朝六時に食事を終えてじきに猟宮に出掛けて行きまして、まず番兵の居らぬ所から柵内に入りましたが、総理殿下の対面所がどこに在るか沢山な天幕であるからいくら捜してもちっとも分らない。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは二時になると、ほとんど裸体になって柵内に並び、番号をとった上で、正門を出て海に入る。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼の命令を待つまでもなく、あたりにいた郎党は、館、柵内の味方へむかって、事態をどなり歩いていたので、馬を曳き出し、武器を押っとり、前後して、甲冑の奔流が、諸門から往来へ、溢れ出ていた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "桔梗よっ……」　将門は、広い柵内を、走り廻り、走り廻り、炎へ向って呼びぬいた。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それがやむと、両側の柵内で、金鼓が鳴り、楼の上では用意！",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自身、出迎えて、柵内の接官亭に請じ、つぶさに秦明の口から、こんどの事件の表裏やら、また秦明自身の境遇の一変をも、聞いたのだった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「待っていた」　と、ばかり柵内からの銃火は直ちにそれへ答えた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "潮あいを測っては、柵内から柵外へと、織田、徳川の槍組は、「それッ――」と、ばかり甲軍の両翼へ突撃して来た。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "よかろうッ」　信長は、すぐ成政をして、柵内の全軍の上へいわせた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "観測地点は小学校の裏庭の一部にあって、十本の海水浴用の日傘も点々として派手な色彩で観測点の柵内を色彩っていた。",
              "citation": {
                "source": "英国日食班の印象",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "柵内の片隅には石油発電機が設けてあって、当日の午前中に運転試験を済ませて万一の場合に備えてあったことも用意の周到さを示す一つであろう。",
              "citation": {
                "source": "英国日食班の印象",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれの終身間者牢は、この自然の地形と、人為の柵内とに局限されている上に、また、ここと麓の間には、三ヵ所の山関があって、たえず詰役の山番がいるから、どうしたって遁れだすことはできない。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
