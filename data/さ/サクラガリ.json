    "definitions": [
      {
        "index": 1,
        "gloss": "looking for or at cherry blossoms",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末は家族みんなで公園へ桜狩りに出かける予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "桜狩りのシーズンになると、観光客でどこの名所も賑わう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今年は少し遅めの桜狩りになったが、それでも満開の桜を楽しめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "いつのことであったか、そなたの故郷の闘鶏野の辺り、春の弥生の桜狩りに行った折。",
              "citation": {
                "source": "人柱築島由来",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "……何の何の、今日は昨日と違い、雷鳴り雲も見えませぬゆえ、その二里ほどを、桜狩りしつつまいろうとの心ぐみにござります」「おうそのような、優しい計らいであったのか」　廉子はよろこんだ。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "一例として桜狩美人の腹や減却す人間に鶯鳴くや山桜　人里離れた深山の奥、春昼の光を浴びて、山桜が咲いているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い出す木曽や四月の桜狩。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の四月は今の五月、五月に桜狩があるのだとすると、これは確に寒い筈だ。",
              "citation": {
                "source": "鵞湖仙人",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜嵐や太閤様のさくら狩　　その女ちぎれおつ牡丹桜の風雨かな　　沼菽女　閨中の美女をあつめて豪華をつくした太閤の桜狩も、花の盛りも一夜の嵐にむなしくなったと詠じたものか、すきものの太閤を諷したものか。",
              "citation": {
                "source": "桜花を詠める句",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "『太平記』の事が話頭に上ると、わたくしは今でも「落花の雪にふみまよふ片野あたりの桜狩」と、海道下りの一節を暗誦して人を驚すことが出来るが、その代り書きかけている自作の小説の人物の名を忘れたりまたは書きちがえたりすることがある。",
              "citation": {
                "source": "十六、七のころ",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "山人の垣根づたひや桜狩明治三十九年藤の茶屋｜女房ほめ／＼馬士つどふ明治三十九年四月二十三日　俳諧散心。",
              "citation": {
                "source": "五百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きい殿でござったな、久方ぶりでござる」　桜狩の女のうちから、宮内は慎九郎の妻を偶然みつけ出した。",
              "citation": {
                "source": "討たせてやらぬ敵討",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿様と美女と桜狩の狼藉　蛇使いの娘お金を、南条左馬之助の長屋へ入れるまでには、一と通りならぬ献立が必要でした。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第八夜　蛇使いの娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "主君本田北見之守の下屋敷は、向島の小梅で、名題の桜の名所、丁度花も満開という三月十二日、毎年の例になって居る桜狩がその広大な庭園で催されました。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第八夜　蛇使いの娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲は桜狩というのだそうで、巧拙はわからないが、たいそう華やかであり、振の派手な舞いぶりであった。",
              "citation": {
                "source": "竹柏記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひそかに、たまたまの桜狩など、大いによかろう。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇后の実家方、西園寺ノ入道｜実兼の北野の別荘に、桜狩の行幸があった日のことだった。",
              "citation": {
                "source": "私本太平記",
                "author": "婆娑羅帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "桜狩中の一瑣事を捉えたのである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
