        "examples": {
          "standard": [
            {
              "text": "彼の部下への接し方はサディスティックで、職場の雰囲気を暗くしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "そのホラー映画の悪役は、サディスティックな笑みを浮かべながらゆっくりと迫ってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "審査員の一人がサディスティックな批評を連発し、出場者を次々と泣かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それから最後に、今日一種の魅力になっている傾向に、懐疑的な、自分にたいするサディスティックな自虐的な追求をとおして、人間性の再確認と正義の建設への意企を表現しようとする試みがされています。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常にこくめいに、ブリューゲルの絵の方法のように、ほとんどサディスティックに描いている。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
