        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二ツノ　ホシハ、ソノ　ヨルモ、オシダマツテ　アツチコツチト　ナクナツタ　ホシヲ　メデ　サガシテ　ヰマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ、イロイロ　サガシタガ、アマリ　ヨイ　キカイガ　ナイノデ、ラツパヲ　カツテ、「コレヲ　サカサマニ　シテ　ミミニ　ツケテ、ラツパノ　シリカラ　キキナサイ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日、高イ木ノ枝ニ腰カケテ、四方ヲミマワシテ、何カヲサガシテヰル様子デス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三　三匹ノコグマサンハ、ソレヲキイテ、方々サガシマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "与惣兵衛は腹をたてて、「ケッコンスルナ　フラチ　カンドウ」　と打ってやると、シヨウチシタ　サガシテミルという電報がきた。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――関門海峡ニハ、タクサンノ外国船ガ入ッテクルコトトナッテ、沖ノ仕事モ増スバカリトナッテ、組デハ、若クテヨイ働キ手ヲサガシテオル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ鷲ヲサガシニマイリマス。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
