        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ほえから元氣出さないかんわいおもて、持つていたかんてきに火一杯いこして、鍋に魚入れてグツ／＼たきながら、火燗の熱いやつをやつてたんや。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "十ヶの八百やザル、十ヶの魚入れなどを、もう一人の当番と各戸から集めました、朝九時頃。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまっちゃんは糸で編んだ網に入れてある、薄い硝子の金魚入れから水が洩って廻るように、丸い大きな眼に涙を一ぱい溜て堪えていた。",
              "citation": {
                "source": "源泉小学校",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりももっと、幼年時代、新京極あたりの賑やかな町を通っても、金魚店の前に立っているだけで、自分で思うように、しゃくって買った覚えのない、丸い硝子玉の金魚入れがほしかった事を、思い出すともなく思いだしていた。",
              "citation": {
                "source": "モルガンお雪",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は渋面をしながら、重い金魚入れを下げて、足を早めた。",
              "citation": {
                "source": "金魚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "片手で吊革につかまりながら、片手でやたらに肱を張って、金魚入れをかき抱くようにした。",
              "citation": {
                "source": "金魚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "無事に下宿の近くの停留場まで来ると、大きな金魚入れを下げては中々降りられなかった。",
              "citation": {
                "source": "金魚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は人並に揺られて、金魚入れを落してしまった。",
              "citation": {
                "source": "金魚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
