        "examples": {
          "standard": [
            {
              "text": "運動会では、色とりどりの旗が何竿も立てられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "神社の参道には、奉納されたのぼり旗が十竿以上並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "国際会議の会場には、各国の国旗が一竿ずつ掲げられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
