        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三人目の子供を産むために、下の児を連れて県病院の施療病室にいる女房は？",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれもやはり、十三人目の椅子に坐るべきおせつかいな性格を持つてゐた。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月一日の朝まだき、神々の御父ジュピタア様の宮殿へおまいりの途中で逢った三人目の男のひとを私の生涯の夫ときめよう。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君が二十世紀の都会の街路で、このような、うらないを、暮靄ひとめ避けつつ、ひそかに試みる場合、必ずしも律儀に三人目のひとを選ばずともよい。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度で三人目である。",
              "citation": {
                "source": "砂糖泥棒",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人目は男子だったが、上の二人は女だった。",
              "citation": {
                "source": "窃む女",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『この月になってからでも今朝のが三人目だよ、よくよくこの踏切はけちがついていると見える。",
              "citation": {
                "source": "郊外",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人々々に人形だの、雛の道県だのを持ってる、三人目の、内裏様を一対、両手に持って、袖で掻合して胸に押着けていたのがお夏さん、夜目にも確か、深川中探したって、およそその位なのはないのですからね、……助かった。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人目が、「水の心配などいらぬ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "然らば拙者が見事にあの飾り太刀せしめてお目にかけようよ」　引き出物の景品にそそのかされでもしたかのごとく、三人目が飛び出して引きしぼったが、的中したのは同じ四本です。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お次はどなたじゃ」　涼しい声で言いながら、莞爾として三人目の稽古台を促しました。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "言ううちに三人目もまたあっさり芋虫にしたようじゃ。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三匹並んで長くなっておるところは、どうみても一山百文口よ喃」　いかさまその言葉のごとく、三人目もすでに脾腹の一撃に出会って、手もなくそこへのけぞったところでした。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人目は何じゃ」「鳶の七五郎と申します。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人目の子どもが生まれた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの縁にいた三人目の男を見知ったものはないか」　側には本多正純を始めとして、十余人の近臣がいた。",
              "citation": {
                "source": "佐橋甚五郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三人目は喬僉知と申しまするもので」家康は冷やかに一目見たきりで、目を転じて一座を見渡した。",
              "citation": {
                "source": "佐橋甚五郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも十三人目の十三郎というのが才子で、その方が可哀がられているらしい。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の左二三人目に児島がすわっている。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故そういうかというに、後威能が亡くなり、次の三人目の妻がまた亡くなって、四人目の妻が商家から迎えられる時、威能の父文蔵は喜んで仮親になったからである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "抽斎が三人目の妻徳を娶るに至ったのは、徳の兄岡西｜玄亭が抽斎と同じく蘭軒の門下におって、共に文字の交を訂していたからである。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく抽斎に始てアンチパチイを起させたのは、三人目の徳であった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢は瑞仙の三人目の妻である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "瑞仙が三人目の妻沢を娶つたのは何時であつたか知らぬが、其二人目の妻寿慶が寛政二年に死んだ後、三年に大坂より京都に徙つた時には、京水の記に「女於千代を従え」と云つてある如く、妻は無かつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "此推定にして誤らぬならば、瑞仙の三人目の妻沢は寛政七年若くは八年に、養子祐二のゐる処へ迎へられたのである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
