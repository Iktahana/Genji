    "definitions": [
      {
        "index": 1,
        "gloss": "liquor-soaked",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "飲みすぎで意識が朦朧とし、体が酒浸りのように感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "床にこぼれたジュースで、カーペットが酒浸りになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "リストラされた後、彼は毎晩酒浸りの生活を続け、みるみるうちに痩せ衰えていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それでも、この連中はみんな、酒浸りのために黒ずんだ顔色、ぼんやりした朦朧たる眼、固く結んだ蒼い唇、などで区別がつくのだ。",
              "citation": {
                "source": "群集の人",
                "author": "THE MAN OF THE CROWD",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、長を主張する者と、百名づつの足軽を借りうけて、長短の槍試合をすることになつたが、長を主張した者の方では連日足軽共に槍の猛訓練を施すにも拘らず、秀吉の方は連日足軽を御馳走ぜめにし、散々酒浸りにさせるばかりで、一向に槍術を教へない。",
              "citation": {
                "source": "死と鼻唄",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は主膳に酒を飲ませておいて――ではない、主膳が昨晩から酒浸りになって、今は熟睡しているのをよいことにして、体のいい置いてけぼりを食わせて、みんな出払ってしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその最中に殿様は酒浸りになっている。",
              "citation": {
                "source": "我が圓朝研究",
                "author": "「怪談牡丹燈籠」「江島屋騒動」「怪談乳房榎」「文七元結」「真景累ヶ淵」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "今松は、酒浸りで過ごした。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "フラー(4)は彼を酔っ払い医者の例とし、彼の身体は酒浸りの潮が引いたり満ちたりしている海だと言った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "源太の酒浸りが始まった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事のうえの嫉妬ではなく、それまでのじだらくな遊蕩や、酒浸りの習慣から縁を切って、すべてを絵にうちこませるために、わざとそんなふうに邪険なことをしたのではないか。",
              "citation": {
                "source": "扇野",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "千太郎のことを思いだしたら、それが気になるのだろう、博奕場へもゆかず、朝から酒浸りになっている。",
              "citation": {
                "source": "枡落し",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊達家の宿舎とはべつの、湯治客の泊る棟で、ふじこという女中をひきつけたまま、連日、酒浸りになっていた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "一家の母が打ちのめされ、取り乱す一方で、酒浸りのごろつきが高価な椅子に座り、臭いタバコを吹かしていた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし他の二つの點で、全くルレーヌの方ではでたらめであり、藝術道の意識など夢にもなく、生涯を通じて酒びたりで、珈琲店の音樂など聽いて悦んでゐたところの、徹底的小學一年生の子供であつた。",
              "citation": {
                "source": "室生犀星君の人物について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の主人も、テーベのくせに、菌を酒で殺すんだなんて言って、酒びたりになって、自分から寿命をちぢめました」「不安でいけないんです。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、道楽とは言つても、女狂ひや酒びたりの所謂、放蕩とは大いに趣きを異にしてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、道樂とは言つても、女狂ひや酒びたりの所謂、放蕩とは大いに趣きを異にしてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、近ごろになって、私はまるで酒びたりになり、それが自分の遺伝的な気質に狂おしいくらいの影響を与えて、いよいよ自分を抑えきれなくなった。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかも服部と英則が茶屋酒を酌み交してゐるところへ迎へにやらされたが、英則は万十郎をつかまへて、「わたしはもう全く生きた心地もない、たゞ行雄のことを考へて、半時でも一時間でもそれを忘れたいばかりで、酒びたりになつてゐるだけなんだ。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「実は、あの――何というか『ブレーキ』に入り浸って酒びたりになっている女のひと……」「ああ、それは丘田お照のことだ」と速水は早口にいった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯晝飯の膳にウヰスキーかビールを、夕飯の膳にはまた改めていはゆる晩酌を、といふ風に酒びたりになつてゐる者に果して眞實の酒の讚が書けるものだらうか。",
              "citation": {
                "source": "樹木とその葉",
                "author": "酒の讃と苦笑",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「酒びたりとなって、不平不満をいいつづけて、悶えているそうにござります。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前へ大弥太は坐り込み、酒びたりや性慾づかれで、眼袋などの出来ている顔へ、多少テレた表情を浮かべたが、「まずご免、のっけに謝まる。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから彼は安んじて、酒びたりな日毎を迎えながら、幻のような幸福を楽んでいた。",
              "citation": {
                "source": "素戔嗚尊",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、興宗といふ畫家が――美術院派の畫家で、有名な「落葉」の屏風を殘した今村紫紅の兄さん――いつものやうに父とお酒を飮みながら――興宗は大酒で、父とは年齡が違ふが、うまがあふので、ちよくちよく來てはお酒びたりになつてゐた――何時かはなしが「郭子儀」の幅のことになつて、もしかするとそれは楓湖でせう。",
              "citation": {
                "source": "「郭子儀」異變",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "シモンは朝から酒びたりになっていた。",
              "citation": {
                "source": "カストリ侯実録",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "金があつて、身體が丈夫で、酒が強くて、――あばたで、力自慢で、あまり女の子には持てませんがね」「隨分醉つて居たのか」「朝からの酒びたりで、二三升は呑んだことだらうと思ひます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美しき獲物",
                "note": "青空文庫"
              }
            },
            {
              "text": "お隣の加積屋安兵衛などは、借金が棒引にでもなると思ったか、朝っから酒びたりで歌っている」「…………」「この様子じゃ、形見分けと身代の始末で、どんな騒ぎが始まるかも知れない。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "二度死んだ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「暫く厄介になるよ」　こう云って二階の端の、いつもの四帖半へおちつき、二三日は酒びたりになっていた。",
              "citation": {
                "source": "桑の木物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主任弁士の沢木七郎は朝から酒びたりで、オセロオの説明に浪花節を入れたり、ファスト・ヴァイオリンを弾いていた安土竜太郎は向う鉢巻でユウモレスクの曲弾をやったりして、気の良い山手の客の度胆をぬいていた。",
              "citation": {
                "source": "溜息の部屋",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　昌平はそれから三日三夜、酒びたりになって遍歴した。",
              "citation": {
                "source": "七日七夜",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、お父っつぁんが亡くなってからぐれだし、仕事はそっちのけで酒びたりになり、悪遊びに浸りきるようになった。",
              "citation": {
                "source": "枡落し",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
