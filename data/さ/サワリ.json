        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の客に対する触りが丁寧なので、お店の評判も良い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "上司は部下への触りが厳しく、皆少し恐れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "人と接する際の触りがとても優しいので、誰からも好かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
