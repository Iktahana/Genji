  {
    "uuid": "e1e6a7cd-7d8d-569f-ad65-b70a1823c7a3",
    "entry": "ササギ",
    "reading": {
      "primary": "ささぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ちょっと、デザインが変わりましたね」　二羽のカササギが、円盤をかこんで立っている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらも「片手」は円盤を押さえているが、右のカササギは「左手」を腰にやり、左のカササギは「右手」を「ナンバーワン」とでもいうように、突きあげている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事に多く米を用い、米のスープあり、またササギを食す。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが電信の針金に、鴉やカササギがとまっていて、赤んぼみたいに啼き立てては、みんなを起こそうと精を出す。",
              "citation": {
                "source": "ねむい",
                "author": "СПАТЬ　ХОЧЕТСЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いい気になって、カササギよろしく婦人解放論をまくし立てたり、まあそんな恋愛感情におぼれているうちに、身代はんぶんがた、すっちまいましたよ。",
              "citation": {
                "source": "熊",
                "author": "МЕДВЕДЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊につい十日ほどまへ、遠智の岡ノ上に新たにおこされたミササギに、宝ノ太后と、間人ノ先后と大田ノ皇女と、――この親子三代のなきがらを合はせ葬つた日は、夜来の雪が日ねもす野山をこめて降りしきり、夜ふけてからは吹雪にさへなつて、これは何かの前兆ではあるまいかと、心ある人の胸をさわがせたほどの大雪だつた。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一方ミササギの造営はしきりに督促され、役夫三千あるひは五千ともいはれながら、牛の歩みのやうにさつぱり捗らない。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミササギをおこすこと自体に逆らはうといふのではない。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "つひにミササギも出来あがつて、三人の貴女のなきがらは、降りつむ雪の覆ひのもとに、しづかに葬られた。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミササギのほとりは、深い檜の森におほはれて、雪はあの夜のままの厚さで凍てついてゐた。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "久作は天皇なみのミササギをつくろうというのだ。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "天照大神からはじまり久作らしき天皇で終る最後に、「この天皇眼の下に大保久呂あり保久呂天皇の相なり裏山のミササギに葬る」　とあって、どうやらあの山と石室が保久呂天皇のミササギであったことが判明したのであった。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれが保久呂天皇のミササギとは知らないものだから、こわしてしまって気の毒したが、その代りお前の命は助かったし濡れ衣もそそがれたからカンベンしてくれや」　と云って駐在所から送りだされたのであった。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡れ衣とは知らず一同が手を下してミササギをくずしてしまったが、これは警察の命令で仕方がなかったのだから、まげてカンベンしてもらいたい。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前がそうしろと云うなら部落全員が力を合せて元のようなミササギをつくるから。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日から久作はミササギで仕事にかかったが、十日あまりで石を全部谷へ投げこみ、地ならしして、ミササギが畑になっていたのである。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺された場所がオーカミイナリの古文書に祖神のミササギと称している古墳の中であった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰云うとなく村の噂が語り合ったものですが、加治さんの土蔵から神の矢の主が持ち去った黄金がオーカミイナリの祖神のミササギと称するものの中に隠されているんじゃないかと推量した定助が深夜掘りにでたものではないかというのです。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "大神様のミササギの中で殺されていたな。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこはオーカミイナリの子孫が自分の祖神のミササギであると称している聖地です。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもそのミササギの穴の下から一ツでも盗まれた金箱が出たとすれば、それによって本当の犯人の一生は泰平無事を約束される結果になるかも知れません。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーカミイナリの祖神のミササギに金箱を埋めることは定助を納得させるに充分な理由があったでしょうが、そのミササギの中で定助を神の矢で殺すことは、相棒の口を永遠に封じると同時に土蔵破りの犯人をくらませる役にも立ち、定助殺しの犯人をもくらます役に立つものでした。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十七　狼大明神",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝦夷と入鹿は自分を天皇になぞらえて、宮城やミササギをつくッていたそうだが、それにしでもだね、大臣が殺されたなんてことは、その前後にフンダンにありますね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰くありげとは、天皇の名とか、ミササギの場所とか、そういう事が記載されているらしい所に限って欠字になっているのさ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前年の条には、祖先の廟を葛城の高宮にたて八をやり、自分と入鹿のミササギをつくったことが記されている。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかく、大和を中心にした夥しい古墳群（ミササギも含めて）は小心ヨクヨクたる現代人のドギモをぬくに充分な巨大きわまるものだね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛鳥の幻――吉野・大和の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
