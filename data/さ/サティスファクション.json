        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は新しい仕事に大きなサティスファクションを感じ、毎日やる気に満ちている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "顧客からのサティスファクションを高めることが、この企業の目標である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "プロジェクト完了後のサティスファクションは、チーム全員で共有された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ローリング・ストーンズは、慶一にとっては、デイヴ・クラーク・ファイヴより落ちる、三流のバンドだが、〈サティスファクション〉よりは、こっちのほうが好みではある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、〈サティスファクション〉で聴かれる、この時代に、こんなものが存在するのが信じられない、ばかげたドラム・ブレイクにくらべれば、〈ゲット・オフ・オヴ・マイ・クラウド〉のイントロのドラムは、はるかにパワーがある。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「〈サティスファクション〉でも、やるわけ？",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファズを手にした人間は、どうしても〈サティスファクション〉のリフを弾かずにはいられない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
