[
  {
    "uuid": "24842d09-281c-5a6c-9600-4d0756997792",
    "entry": "サイダ",
    "reading": {
      "primary": "さいだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
