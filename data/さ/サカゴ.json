[
  {
    "uuid": "287d42e8-4f85-5e56-8dcd-cdca7c62e16f",
    "entry": "逆子",
    "reading": {
      "primary": "さかご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
