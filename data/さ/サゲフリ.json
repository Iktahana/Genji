        "examples": {
          "standard": [
            {
              "text": "突然の停電で、エレベーターが急停止し、乗客は恐怖の「下げ振り」を体験した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "飛行機が乱気流に巻き込まれ、一時的な「下げ振り」に見舞われたが、パイロットは冷静に対処した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "崖から転落するような「下げ振り」の感覚に、彼は思わず悲鳴を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "大工はさげふりと差金で柱や桁を測る。",
              "citation": {
                "source": "触覚の世界",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
