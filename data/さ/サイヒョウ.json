[
  {
    "uuid": "b8812da0-a0f2-547d-af14-96674a2a3d75",
    "entry": "砕氷",
    "reading": {
      "primary": "さいひょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞",
        "動詞-自動詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "ice breaking",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "流氷に阻まれ、船は砕氷しながら進んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "砕氷作業は、極寒の海で非常に危険を伴う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "南極観測船は、分厚い氷を砕氷する能力を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "と、来た来た、氷を蹴砕き蹴砕き、さっきの砕氷船が。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "新鋭砕氷船「水戸君には話しておいたことだが、あの怪汽船ゼムリヤ号はソ連船なんだ」　と、ホーテンスは語り出してドレゴの顔を見た。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず君達を喜ばせるだろうと思うことは、あのゼムリヤ号は最新鋭の砕氷船だということだ」「砕氷船！",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうか、砕氷船か」　聞き手の両人は、目を瞠った。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それも並々ならぬ新機軸を持った砕氷船なんだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の幅で六十パアセントに圧縮されても沈みも壊れもしないで平気でいられるという凄い耐圧力を持った砕氷船なんだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その雑誌の一隅に、新鋭砕氷船ゼムリヤ号のことが小さい活字で紹介してあったのさ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼け落ちたとはいえ、その資料はヘルナー山頂に横たわり、今も我々の監視下にあるんだからね」　ホーテンスとドレゴは、新鋭砕氷船の特質につき大きな興味を沸かしているのだった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一体砕氷船というものは、そんなに強い耐圧構造を持っていなければならないものかね」　水戸が、疑問をなげかけた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕なら、そんな莫迦げた耐圧力を持った砕氷船なんか作りやしないよ」　と、ドレゴが、寒帯住人らしい自信を持っていい切った。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だがねえ、仮にゼムリヤ号のような砕氷船が百隻揃って北氷洋や南氷洋に出動したと考えて見給え。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると砕氷船ゼムリヤ号は事件直前において大西洋を航行中だったんだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、ゼムリヤ号がソ連船であり、そして驚異の性能を持った新鋭砕氷船であり、その行動も事件発生の三週間前から杳として謎に包まれているのにも拘らず、ソ連側からは一向何らの弁明すら発表されていないのはどうした訳かというのであった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは優秀砕氷船です。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日われらの売出そうとする砕氷船の如きは、もはやわれらがその技術を秘密の埒内に停めて置かなければならないようなそんな特殊なものではなくなったのだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "深夜の大西洋　その翌日から、ドレゴは何と心を決めたものか、港へ出ては船主関係の人々を探し出しては、すばらしいヤクーツク造船所製の砕氷船を買わないかと、外交員商売を始めた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「砕氷船なんか買ったって、使うことはありゃしないよ」　と相手がいおうものなら、ドレゴは待ってましたという風に唇を甜めて、「使うことは大有りさ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ以上酒を呑めといっても呑めやしないぜ」「儲けるのがいやならいやでいいが、この砕氷船を買っとけば、いざ戦争というときには原子爆弾よけには持ってこいなんだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは長生きしたいなんて、一度もいったことはねえぞ」　ドレゴは、話のわからない船主の間を辛抱強く訪ねて廻って、くりかえし砕氷船の売込みに奔走した。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "すばらしい耐圧力を持った砕氷船でさ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが由三の小さいひょうたん形のチンポへ飛んだ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
