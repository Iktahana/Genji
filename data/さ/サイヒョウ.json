        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夜空には、きらきらと輝く細氷が舞っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の朝、窓の外には美しい細氷が見られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "細氷が空気中に漂い、幻想的な風景を作り出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "少しずつ少しずつ、しかしながら、輪郭は西の空に峻厳なる姿を際立たせていき、裸の、荒涼たる、黒々とした峰々を見分けられるようになると、南極の赤い陽に照らされ虹色に光る細氷の雲を挑発的な背景としたそれらの姿は次第に奇妙な幻想的な感じになっていった。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが由三の小さいひょうたん形のチンポへ飛んだ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
