        "examples": {
          "standard": [
            {
              "text": "山中で出会ったのは野良犬ではなく、集落に住む里犬だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "里犬が畑のあぜ道をのんびりと歩き回っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旅人が峠を越えると、村の里犬が尾を振りながら駆け寄ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "その足跡は里犬よりも大きく、糞は毛と骨で――雨晒しになったのを農夫が熱の薬に用いる。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「埋もれた青春」、その一つ一つに特別な感じと思いをうける、私にはそんなにはなされないほどのものではないけれ共一番始めにある埋れた春の幼い二人の子供の気持には落椿のはかなさといぬはりこの色の様に平凡なものでありながらはなれがたいなつかしみをうけた。",
              "citation": {
                "source": "日記",
                "author": "一九一四年（大正三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
