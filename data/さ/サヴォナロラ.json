          "literary": [
            {
              "text": "例のサヴォナロラは、そんなのは邪教だと云って獅子のように怒っていた由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サヴォナロラはメディチの勢力と戦った。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてあの大きなナポレオンの絵のほかに、なおルウテル、ニイチェ、モルトケ、アレキサンデル六世、ロベスピエエル、サヴォナロラなぞの肖像が、それぞれ異った体裁で、部屋中ほうぼうにかかげてある。",
              "citation": {
                "source": "予言者の家で",
                "author": "BEIM PROPHETEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
