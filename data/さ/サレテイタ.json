          "literary": [
            {
              "text": "予ハ三十分グライ一人デ寝室ニ待タサレテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コトニ足首ノトコロガ十分ニ細ク括レテイナイノガ缺点ダケレヲ許サレテイタダケデ、コノ素晴ラシイ肉体ヲ眼デ視ルヲ得ル夫ハ、今カラ新シイ結婚ヲ始メルノト同ジダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテソノ麻痺状態ニ置カレテイタ期間ハモノノ二三十分ニ過ギズ、間モナク遮断サレテイタ神経ノ通路ガ復舊シ、失ワレタ記憶ガ戻ッテ来テスベテガ平生ノ通リニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
