        "examples": {
          "standard": [
            {
              "text": "手紙の追伸の後に、さらに重要なことを記す際に三伸と書くことがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "三伸で書かれたメッセージには、彼の強い思いが込められていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "これは個人的な連絡なので、あえて三伸として付け加えました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "すると、学生さんはふりかえって、『おじいさんしんぱいしなさんな、ぼくは、一つだけもらって、あとはおいてゆきますよ。",
              "citation": {
                "source": "新しい町",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
