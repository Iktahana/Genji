[
  {
    "uuid": "ad6149f8-c629-51f7-80ab-f1114f3ad310",
    "entry": "諭し",
    "reading": {
      "primary": "さとし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
