[
  {
    "uuid": "77a2275d-5b6a-5155-858a-a51f99ceb903",
    "entry": "魚釣り",
    "reading": {
      "primary": "さかなつり",
      "alternatives": [
        "うおつり",
        "いおつり"
      ],
      "is_heteronym": false
    },
