    "definitions": [
      {
        "index": 1,
        "gloss": "fishing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "週末は家族で海へ魚釣りに出かけるのが楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "父と二人で堤防に出かけ、魚釣りをしながら一日のんびりと過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "初めての魚釣りでアジが釣れたとき、子どもは飛び上がって喜んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "魚釣りも、蝗取りも、米櫃の空なことを忘れさせなかつたのだ。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから署長は押し入れからふだん魚釣りに行くときにつかふ古いきゅうくつな上着を出して着ておまけに乗馬ズボンと長靴をはいた。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月　若きものの、山深く暑を避けたるが、雲の峰高き巖の根に、嘉魚釣りて一人居たりけり。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、それだけならば別に問題にもならないのであるが、重兵衛はこの二、三年来、自分自身はめったに網打ちに出たこともなければ、魚釣りに出かけたこともなく、ほとんど懐ろ手で暮らしているのである。",
              "citation": {
                "source": "深川の老漁夫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠頭魚釣りは、魚釣の遊びの中にても一ト風異りて興ある遊びなり。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年五月の中の頃、鼠頭魚釣りの遊びをせんと思ひ立ちて、弟を柳橋のほとりの吾妻屋といふ船宿に遣り、来む二十一日の日曜には舟を虚うして吾等を待てと堅く約束を結ばしめつ、ひたすらに其日の至るを心楽みにして、平常のおのれが為すべき業を為しながら一日と日を送りけり。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬉しきはそれのみならず、竿の長さは鼠頭魚釣りに用うべき竿の大概の定めの長さ一丈一尺だけ有りながら、其重さの旧より用ゐしものに比べてはいと軽きもまた好ましき一つなれば、我が心全く足りて之を購ひつ、次を以て我が知らぬ新しき事もやあらんと装置をも一ト揃購ひぬ。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "白鼠頭魚はかく「きゃたつ」に騎るなどといふこと無く、一つ船の中にて親子妹脊打語らひながら釣るべければ、女など伴はんには白鼠頭魚釣りをよしとするとぞ。",
              "citation": {
                "source": "鼠頭魚釣り",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日は魚釣りに行くんだぞ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそ釣りにでも行ってみようかと思い立って、八月なかばの涼しい日に、家の釣道具を持出してかの尾花川へ魚釣りに出かけた。",
              "citation": {
                "source": "水鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「毎日魚釣りをして淋しく暮している」はずの柳吉が、こともあろうに芸者を揚げて散財していた。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "主な楽しみといえば、銃猟や魚釣り、あるいは貝殻や昆虫学の標本を捜しながら、なぎさを伝い桃金嬢の林のなかを通ってぶらつくことなどであった。",
              "citation": {
                "source": "黄金虫",
                "author": "THE GOLD-BUG",
                "note": "青空文庫"
              }
            },
            {
              "text": "「水ん中に居ちや仕事するにも仕事はなしさなあ、それからみんな棒の先へ鈎くつゝけて魚釣りしたのよ、庭で幾らでも鮒釣れるつちんだから知らねえものが見ちや酷く困んねえ奴等だと思ふ位なもんだんべのさ」おつたは一｜杯の茶を啜つて喉を濕した。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢庵より上る利益の計算のために必要な算盤や、コムパス達は、今日の土曜と明日の日曜とを利用して、魚釣りに出かけるのである。",
              "citation": {
                "source": "工場の窓より",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は午前中は読書執筆に費し、午後はその天竜河や、その支流に山女魚釣りに出かけるのだが、この山女魚は、全く意想外の処に住んでいて、釣った人間を驚かせる。",
              "citation": {
                "source": "信濃の山女魚の魅力",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと、魚釣りと云うものは、詐欺なのだ。",
              "citation": {
                "source": "信濃の山女魚の魅力",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大尉は忙がしい暇をぬすんで、自分の好きな魚釣りに出て来た。",
              "citation": {
                "source": "火薬庫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとかして大尉が確かにあすこで魚釣りをしていたという証拠をつかまえて、自分をあざけっている朋輩どもを降参させてやりたいようにも思ったが、この上にそんなことを考えるべく彼はあまりに疲れていた。",
              "citation": {
                "source": "火薬庫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべ逢った魚釣りの人もやはりその狐ではなかったかとも思われた。",
              "citation": {
                "source": "火薬庫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚釣りに致しましょうか、馬乗りに致しましょうか。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」技師長「おれはその間、魚釣りにでも行ってこようや」職工長「魚釣りにねえ。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "上海脱出以来すでにもう幾旬、魚釣りばかりに日を送っていたために、あれほどすごい切れ味を見せていた博士の能力もここへ来てだいぶん焼鈍されたように見えたが、実はそれほどでもない。",
              "citation": {
                "source": "軍用鮫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕だって、ずいぶん下品なことをしたいのだけれど、みんな笑って、――」魚釣る人のすがたが、眼にとまった。",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "此以前僕が此處へ來た時の事である、或日の午後僕は溪流の下流で香魚釣を行つて居たと思ひ玉へ。",
              "citation": {
                "source": "都の友へ、Ｂ生より",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔館は台地のはななれば〕宮沢賢治館は台地のはななれば鳥は岬の火とも見つ香魚釣る人は藪と瀬を低くすかしてわきまへぬ鳥をまがへる赤き蛾は鱗粉きらとうちながし緑の蝦を僭しつゝ浮塵子あかりをめぐりけり",
              "citation": {
                "source": "〔館は台地のはななれば〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食わん魚釣って売るつもりか」「おりゃ昔から売るのも買うのも嫌いや」「……？",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「食わん魚釣って売るつもりか」　――「……？",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚釣幾度か釣り損ねてようやく得たる一尾に笑靨傾くる少年帰ってオッカサンに何をはなすか。",
              "citation": {
                "source": "半日ある記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてお話し致しますのは、自分が魚釣を楽んでおりました頃、或先輩から承りました御話です。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚釣（此の灣内ではもろ鰺が良く釣れるさうだが）の下手なの迄が讒謗の種子にならうとは、私も考へなかつた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
