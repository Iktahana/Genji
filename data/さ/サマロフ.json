        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "椅子10・31（夕）　オルガ・サマロフ女史がある時音楽会を開いた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともと見え張りの男だけに椅子が無いなと気が注くと、いきなりその晩の演奏者サマロフ女史の許へ駈けつけた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "シベリアで、ステパン・サヱリイツチユ・サマロフといへば、それを知らない流浪人はない。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年程前にそのサマロフが亡くなつたといふ事を聞くと、わたくしでさへわざ／＼牧師さんの所へ行つて、ミサを読んで貰ひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマロフさんは実に好い人でした。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その晩サマロフさんは、自分の家の石段の上に出て、煙草を喫んでゐますと、わたくし共のヂツクマン谷で焚いてゐる火が見えたのです。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前方の内に一人位サマロフを知つてゐる奴があるだらう。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "監獄長のサマロフさんだ。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時ダルジンがサマロフさんに言ひました。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞこれから先も、サマロフの事を悪く思はないでくれ。",
              "citation": {
                "source": "樺太脱獄記",
                "author": "コロレンコ　Vladimir Galaktionovick Korolenko",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマロフ　Olga Samaroff　アメリカ生れの女流ピアニストで、昔からビクターの赤盤に入っている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
