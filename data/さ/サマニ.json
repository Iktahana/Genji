    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼はいつも手紙の終りに『オババサマニヨロシク』とか『オババサマニ可愛イ言葉』とか書いている。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ、イロイロ　サガシタガ、アマリ　ヨイ　キカイガ　ナイノデ、ラツパヲ　カツテ、「コレヲ　サカサマニ　シテ　ミミニ　ツケテ、ラツパノ　シリカラ　キキナサイ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キサマニソウイナシトワカル。",
              "citation": {
                "source": "ざんげの塔",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔ふほどに気分は大きく、陶然とする僕は、北溟ニ巨魚アリ身ノ長　数千里仰ギテハ三山ノ雪ヲ吐キ横サマニ百川ノ水ヲ呑ム　と非常にうたふのであつたが、そんなに広い処なので、誰もゐないと同様で、どこにも迷惑などは及ぼさぬのであつた。",
              "citation": {
                "source": "自烈亭",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎の読本兎ノ学校ノ読本ハ意地ワル神ニダマサレタ因幡ノ国ノ白ウサギ泣イテヰタレバ泣クナヨトナサケノ深イ神サマニタスケテモラツタ物語リ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "再ビ生キテ皆サマニオ目ニカカレナイコトト覚悟ヲシテイマス。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレモ　ユリコサン　ニアケマス　オトウサマカ　ナニヲシテ　イマスカ　オカアサマニ　オキキナサイ　オカシイデショウ　　　〇六・三・二六」　ロンドンから母宛に来た手紙の中に封じこめられたものであったのでしょう。",
              "citation": {
                "source": "写真に添えて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手紙にはこうあった、ボクノ　大スキナ　オ母アサマキョウ　ボクハ　七ツニナリマシタ　七ツトイウト　モウ　イイ子ニナラナクテハイケナイ年デス　ボクハ　コノ年ヲ　ボクヲ生ンデ下サッタ　オ母アサマニ　オ礼ヲ云ウタメニ　ツカイマスオ母アサマガダレヨリモスキナオ母アサマノ子ロベエル　手紙はこれだけだった。",
              "citation": {
                "source": "ある自殺者の手記",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハエリマキモ外タウモキテヰナカツタノデ、ハクシヨン、ハクシヨン、ハクシヨントクシヤミガツヅケサマニデマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
