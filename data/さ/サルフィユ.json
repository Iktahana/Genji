        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　サルフィユは、楽屋の入口で舞台を覗いてみた。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がペテロでもサルフィユでもなかったので――彼は騒擾のなかに咳をした。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれの才能はサルフィユを見るだけにも足りない。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽隊　鯨波　拍子「フレンド、シップ、ダンス」「おいらのサルフィユ、しっかりせえ。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルフィユは先ず彼の剣を突き出した。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "声――　声　怒　怒　火花　憤怒「おいらのペテロ」「おいらのサルフィユ」「しっかりせえ」「それッ」「右だ」　カチン――カチン　恐るべき光景　笑うべき光景　観客は両人の事情を露さえ知らなかった。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルフィユは背撃を食って、身体の中心は落下に奪われた。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この記念すべき光景――　この記念すべき言葉――　狼煙のように、サルフィユの言葉は空中へ突進した。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ペテロとサルフィユとの心理は一応｜呑込めるが、話としてもその表現はイージーゴーイングだね、しかし大へんすばらしい思いつきだよ……」　彼の親友青沼白心は、突然投げつけるように言って、折り立てた膝の間へ自分の顎を挟んで、庭の隅の方を※めていた。",
              "citation": {
                "source": "あめんちあ",
                "author": "富ノ沢麟太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
