        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この生地はハサミでさっくり切れるので、縫い物初心者にも扱いやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭の草木をさっくりと剪定して、すっきりさせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は難しい問題をさっくりと解決して見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
