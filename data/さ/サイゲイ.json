[
  {
    "uuid": "18a07649-6351-5a88-88dc-e54b872a4217",
    "entry": "才芸",
    "reading": {
      "primary": "さいげい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
