          "literary": [
            {
              "text": "自分は、八畳の灯の下に、一閑張の小机を出し、白く糊の新らしいサビエットを拡げ、夕餐の用意をした。",
              "citation": {
                "source": "小さき家の生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、サビエットを卓子の上になげ出して玄関に出て見た。",
              "citation": {
                "source": "犬のはじまり",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、すきや橋の手前の七宝屋によってリリアンのサビエットリングを買う。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            }
          ]
