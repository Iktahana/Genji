        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "巧言令色足恭、怨ヲ匿シテ其ノ人ヲ友トスルハ、丘｜之ヲ恥ヅ　とか、生ヲ求メテ以テ仁ヲ害スルナク身ヲ殺シテ以テ仁ヲ成スアリ　とか、狂者ハ進ンデ取リ狷者ハ為サザル所アリ　とかいうのが、それだ。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ都市ノ私有地ヲ許サザルガ故ニ、設定セラレタル地上權ヨリ利得ヲ計ルコトヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レヲ途方モナキ一夫一婦制ニ對スル反逆ト考フルハ、恰モ政治的特權者ニ向ツテ叫バレタル政治ノ自由ヲ平等ナル國民間ニ脱線セシメテ、相犯サザル各自ノ自由ヲ蹂躙スルコトモ等シク政治ノ自由ナリト云フ低能者ノ昏迷ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ガ日本ノ西海道ナル所以ヲ明ニスルトキ百般ノ施設悉ク日鮮人ノ融合統一ヲ來サザル者ナク、獨立問題ノ如キ希フト雖モ生起セザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "天道宣布ノ爲メニ選バレタル日本國民ハ將ニ天譴ニ亡ビントスル英國ノ二ノ舞ヲ爲サザルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シナガラ政治ノ自由經濟ノ自由戀愛ノ自由ガ他ノ社會的生活ヲ犯サザル自由ノ意味ニ於テ、思想ノ自由信仰ノ自由亦絶對的ノ者ニ非ルハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ信仰ガ強固ニシテ犧牲ヲ甘ンズル事例ヲ擧ゲテ對抗スルナラバ宗教ノ低級ナル者ニ於テ斯ル例ノ他ニ無數ナル者ヲ擧グ可ク、更ニ斯ク頑迷移サザル者多キガ故ニ殺スベシト云フ囘教ノ信仰ニヨリテ答ヘザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國民ノ義務ニセヨ、父母妻子ノ負擔アル男子ヨリ其ノ勞働ヲ奪ヒテ何等ノ賠償ヲナサザルコトハ國家ノ權利ヲ濫用スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一藩人士翁ノ名ヲ聞キテ襟ヲ正サザルナシ。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人｜一度、アレナノ会堂ニ赴キテ、ジョットーノ描キタル、ユダノ口吻スル耶蘇ノ面貌ヲ見タランモノハ、粛然トシテ恐レ、茲ニ神人ナザレ村ノ青年ヲ見ルト共ニ、ジョットーノ偉才ニ襟ヲ正サザル無カルベシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモコノ寒キ天地ノ中ニ、掘立小屋ヲ作リテ、辛ウジテ彼等ノ肉体ヲ入レテ、而シテ、生活ノ第一歩ヨリ踏ミ出サザルベカラズ、ソノ艱苦経営知ルベキナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "マタ有隣舎ノ主人｜鷲津氏ノ事ニツイテ見ルモ彼ハ啻ニ遺秉ヲ拾ツテ遺サザルノミナラズマタ郷老ノ口碑ニ採ル所多シ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ是等遺跡ノ中ニハ石器ノ他更ニ利器ヲ出ダサザル所有ルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ其責ヤ実ニ政府当局ノ怠慢曠職ニシテ、上ハ陛下ノ聰明ヲ壁蔽シ奉リ、下ハ家国民生ヲ以テ念ト為サザルニ在ラズンバアラズ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
