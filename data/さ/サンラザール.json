          "literary": [
            {
              "text": "八月二十五日（金曜）　パリ、英米軍の包囲下にあって、全市で激戦中、エトワール、モンパルナス、サンラザール等。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "同夜サンラザール停車塲で、一刑事のために彼の錦が一行李の中から発見された。",
              "citation": {
                "source": "探偵小説アルセーヌ・ルパン",
                "author": "EDITH AU COU DE CYGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンラザール通の直ぐ近くです。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
