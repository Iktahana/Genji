      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "three wise monkeys (who \"see no evil, hear no evil, and speak no evil\")",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日光東照宮の三猿は、「見ざる、言わざる、聞かざる」の教えを象徴している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は三猿のように、余計なことには関わらない主義だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「うわー、可愛い三猿の置物だね！」彼女は笑顔で言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "明治二十六年予、故サー・ウォラストン・フランクス（『大英百科全書』十一版十一巻に伝あり）を助けて大英博物館の仏像整理中、本邦祀るところの庚申青面金剛像に必ず三猿を副える由話すと、氏はそれはヒンズー教のハヌマン崇拝の転入だろうと言われた。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時パリにあった土宜法竜師（現に高野山管長）へ問い合わせたところ、青面金剛はどうもハヌマンが仕えた羅摩の本体韋紐神より転化せるごとしとて、色々二者の形相を対照し、フランクス氏の推測｜中れるよう答えられた（一九〇三年ロンドン発行『ノーツ・エンド・キーリス』九輯十一巻四三〇頁已下、拙文「三猿考」）。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『嬉遊笑覧』に『遠碧軒随筆』を引いて、庚申の三猿はもと天台大師三大部の中、止観の空仮中の三諦を、不見、不聴、不言に比したるを猿に表して伝教大師三猿を創めたという。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同例で庚申の三猿も伝教の創作じゃなかろう。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを庚申の三猿もて表わしたというが通説だ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば僻地盗難繁かった処々は、庚申に祈りて盗品を求め、盗もまた気味悪くなってこれを返却した例多く、庚申講を組んで順次｜青面金剛と三猿の絵像を祭りありく風盛んなり。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは衢の神たる猿田彦大神を青面金剛すなわち三猿の親方と同体と心得、道家のいわゆる三尸が天に登って人の罪悪を告ぐるを防がんため、庚申の夜を守って長寿を保たん事をかの大神に祈るの意を述べたと見える。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代政治のとり方は、庚申堂に建ててある、三猿の石碑そっくりだ。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其から丁度三年間といふもの私は全く俳句界から手を引いて、所謂見ざる聞かざる言はざる三猿主義を極め込んでゐたのであつたが、其間に私が当初の希望通り小説（写生文）に熱衷することが出来たのは初めの二年間許りであつて、あとの一年になつてからふと健康を損じなか／＼思ふやうには筆が取れぬことになつてしまつた。",
              "citation": {
                "source": "進むべき俳句の道",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三猿揃つて庚申横町は洒落たものだな。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "庚申横町",
                "note": "青空文庫"
              }
            },
            {
              "text": "三猿揃って庚申横町は洒落たものだな。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "庚申横町",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お、三猿が刻んである――苔がひどいから、一寸解らないが」　空善は屏風岩の正面の苔を払って、ほのかに見える三猿を指さしました。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、叩くのは言葉の綾だろう、押して見られるが宜い」「斯う」　山浦丈太郎は肩を三猿に当てて、ウーンと押しました。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯触った位では開かぬように、この通り岩扉の根にゴロタ石が積んである」　雲水空善は、早くも扉の仕掛を見破ったものか、三猿を彫んだ大岩の前に積み重ねた、ひと抱えほどの岩を幾つも幾つも取除きました。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これでよし」　と言った時は、三猿の岩はその根のあたりに、少しばかりの隙間さえも見せて、明かに龕灯返しの一枚扉ということが解ります。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どれ」　山浦丈太郎が立って、三猿の左の方、何んにも彫んでないところを押すと、岩はキシミながら動いて、人間が漸く通れるほどの口を開けました。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "三猿亭の猿は矢張り三匹共丈夫でいてくれなければ困る。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにお母さんは文一君の好いところ丈け知っていて悉く謹直な片山さんの感化だと思い込むから、例の見ざる聞かざる言わざるの反対を行く三猿亭主人がお気に召さない。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやかたさまがおおせだ、お前さんえんとつを下りてけって！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
