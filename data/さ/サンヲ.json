          "literary": [
            {
              "text": "トコロガ、ミンナト　ハナレテ、オカアサンヲ　ナクシタ　カアイサウナ　コドモガ　ヘイニ　モタレテ　ヰマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカアサンハ　ミチコサンヲ　ミルト、「ナニヲ　ソンナ　オカシナ　テツキ　シテルノ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ、　「実ハ此処ニ居ル道子サンヲ殺シテ自分モ死ヌ気デ来タノダ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンヲ殺害シロト命令シタノハ動坂三郎ニ違イアリマセン。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "人参サンハ　ジヤガイモサンニダマツテ、一人デ玉ネギサンヲ　オクツテユカウト思ヒマシタケレド、ソレデハ、ドンナニ玉ネギサンガカナシガルデセウ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、人参サンハ決心シテ、ジヤガイモサンノオ家ヘカケコンデ、眠ツテイルジヤガイモサンヲユスブリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサント人参サンガオドロイテ　ジヤガイモサンヲ汽車カラ引ツパリオロサウトウロタヘテヰルウチニ、ガタン、ゴトント　汽車ハ三人ヲノセタママ　ウゴキ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリヨクニアフノデ、オ母サンハ山羊ノ写真ヤサンヲヨンデ、キネンノ写真ヲトツテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トバンニンニオレイヲ言ツテ、ヨシヲサンヲウケトリマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ婆サンニオ覚エノ悪イノハ、コンナ場合、婆サンヲ無視シテ予ノ気持ヲ迎エヨウトスルカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレハソウト、陸子ガ面白イコトヲ聞イテ来マシタンデ、オ爺チャンニモオ耳ニ入レテ置キタイト思イマシテネ」「アヽソウ」又何カイヤナコトヲ云イニ来ヤガッタト思ッテイルト、「オ爺チャン油谷サンヲ覚エテラッシャルデショウ」「ブラジルヘ行ッタ油谷ノコトカ」「アノ油谷サンノ息子サンヲ御存知？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヽジャナイノ、折角楽シミニシテルンダカラ佐々木サンヲ行カシテオヤンナサイヨ」「君ハソレデイヽノカネ」「何デソンナコトヲオ聞キニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日ダケ確カニ佐々木サンヲオ預リシマス、オ爺チャンモドウゾ御無理ヲナサラナイヨウニ」「オ早ウ」ト、颯子ガ睡ソウナ眼ヲコスリ／＼隣室カラ這入ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜、ワタシトコノカカエ芸者ノオ京サンヲ、友田サンガ、世話セヨ、トイウ話ガアツタ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "年十三昭和二年一月四日、火告別式　火葬田端泊平松サンヲミル　芥川に平松麻素子さんを紹介された日。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
