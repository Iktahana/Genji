    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――そうかと思うと一方においては、病弱ほとんど死に瀕しておられる、将軍様後継者に関する件につき、死に物狂いに策動し、自分の自由になるお方を立て、ふたたび権勢を盛り返そうと、苦心しているとの噂もある。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "辰男も糸子も同様後列であるから糸子についで、往復に危険の少い位置である。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍之助を助け度いと思うなら、直ぐ様後を追うがよい。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
