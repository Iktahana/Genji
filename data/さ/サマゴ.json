  {
    "uuid": "290025bf-84b4-53bb-b380-2ee07d6a6a70",
    "entry": "様五",
    "reading": {
      "primary": "さまご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "糸屋平兵衛様五升お貸し――なんてしみたれな借りようをするんだい。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "野袴を穿き、編笠をかむった、立派なみなりのお侍様五人が、半僧半俗といったような、円めたお頭へ頭巾をいただかれ、羅織の被風をお羽織りになられた、気高いお方を守り、こなたへ歩いて来るからでした。",
              "citation": {
                "source": "怪しの者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様五本もたいらげたではないか。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月三十日　金　○お客様五月五日　水　二三日不思議に定りない雨が降り続く。",
              "citation": {
                "source": "日記",
                "author": "一九二〇年（大正九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく書あて参りました御願書に、今朝から散々お願えしても、他所村の百姓衆は愚か、同じ真壁の同じ元村、同じ新田の衆、近所隣りから名主様五人組の組内の人まで誰一人としてお名前を下さる方あねえですて！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく書きあて参りました御願書に、今朝から散々お願えしても、他所村の百姓衆は愚か同じ真壁の同じ元村、同じ新田の衆、近所隣りから名主様五人組の組内の人まで誰一人としてお名前をくださる方はねえですて！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんだ美形ぞろいでの、左様五人くらいはおったと思うが――外に十五、六の前髪立ちの少年が一人、岡持や樽を持込んで、お燗をしてくれた若い男が二人」「大がかりの仕事でございましたな」　あまりにも巧奇な企みで、悔をいうほかはありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "かしこ五月三日山崎富栄拝吉田様五月九日　四月二十九日、古田さんと、神田駅で待ち合わせて、ここ大宮市の一隅に修治さんと生活する。",
              "citation": {
                "source": "雨の玉川心中",
                "author": "太宰治との愛と死のノート",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
