        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大道芸人が見事な皿回しを披露した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "皿回しは、バランス感覚と集中力が必要な芸だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、テレビで見た皿回しに感動した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "かなしやメエリイゴラウンド、さみしや手品の皿まわし、春の入日の沈丁花がどこやらに。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の間から印度洋のタイクツをまぎらすために、色々な余興が多かった、演芸会があったその時には一寸赤いたすきがけで俺は皿まわしをやってやったよ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがすむと、長い竹の先で、皿まわしをして見せました。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後獅子の国柄で、獅子舞いは一向に珍しくはなかったが、その年の一行には唐渡り秘伝皿まわしというのが一枚加わっていて、彼はこの妙技にほれこんだのである。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンドン、ドンドコドンドン」　辻へ箱を下し、人をあつめて、皿まわし、タマの使い分け、虫の鳴きマネ、などをやってみせる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄賃にアメとセンベイがもらえて、面白くもない字を習う必要もなく、皿まわしを習うことができるから、大そうな喜びようで、寺小屋の繁昌すること、みんな心をそろえて、「チョーセイ、チョーセイ、チョーセイ、チョーセイ」　と、咒文を唱えながら、一心不乱にセンベイをひっくりかえして焼いている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事時には、皿まわしをやる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前のは唐渡り祥碌流という皿まわし、それから、海道筋を興行中に、彦根の山中にて里人から習い覚えた鳥刺しの一手、その後に美濃、熊野、阿蘇、伊賀、遠江、甲斐、信濃、阿波等の山中に於きまして里人の鳥刺しの手を加えて工夫いたしましたが、別に流名はございません」「しからば、貴殿が開祖でござるな。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは城下の馬場はずれに立って、皿まわしの大道芸人の口上をまね、れいの竹生島で菊村宮内からもらってきた水独楽の曲廻しをやりだした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」へは、三崎座の看板前、大道の皿廻しほどには人だかりがするんだから、考えたんだよ。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物を開いて飯を食って満足しているのは綱渡りが綱を渡って飯を食い、皿廻しが皿を廻わして飯を食うのと理論において異なるところはない。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "学問は綱渡りや皿廻しとは違う。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「尾羽うち枯らした浪人時代――いや、今とても浪人ではござるが、もっとミジメな浪人時代、食うに困って浅草へ出、習い覚えた皿廻し、大道芸を売りましてな、日々の生活を得てござるよ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "皿廻しをする者がありました。",
              "citation": {
                "source": "エミリアンの旅",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "地獄極楽の見世物やら、刀玉採りの大道芸、皿廻しの掛け声、煮込屋の屋台、焼鳥屋の煙など――。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
