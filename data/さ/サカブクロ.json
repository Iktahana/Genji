        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あの水祭はここで催され藍玉の俵を載せ、或は葡萄色の酒袋を香の滴るばかり積みかさねた小舟は毎日ここを上下する。",
              "citation": {
                "source": "水郷柳河",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "禿頭の老人鼻低く体丸く肥え、毎も大きな酒袋を携ふ。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前に並べた酒袋の座布団と、吉野｜春慶の平膳が旅籠らしくなかった。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "３酒袋を干すとてぺんぺん草をちらした。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近の閑談　　　　　○　袋にもいろいろある、紙袋、酒袋、オペラバッグ、四季袋、足袋、カポタングレース等。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "メフィストフェレス二本足の酒袋奴。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "胆嚢は酒袋のようなものである。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
