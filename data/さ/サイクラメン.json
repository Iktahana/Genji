          "literary": [
            {
              "text": "今度はＩ君がサイクラメンとポインセチアを届けてくれた。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイクラメンのほうは少し生育が充分でなかった。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのせいだか自分にはサイクラメンという名前よりこの名のほうがなんとなくふさわしいような感じがする。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイクラメンもおおかたしなびてしまった。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
