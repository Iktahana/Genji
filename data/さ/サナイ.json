[
  {
    "uuid": "f8cd28e4-0138-5d37-b5c2-646a98044799",
    "entry": "哨吶",
    "reading": {
      "primary": "さない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
