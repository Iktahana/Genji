        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "煖炉棚には、なまなましい木目込人形、アイヌの手彫りの木箱、さびくちた古い鉄の五重塔、其他。",
              "citation": {
                "source": "坂田の場合",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、どうしたことでせう、さびくちた鉄やブリキのきれ、よごれた紙くづ、きたない陶器のかけら、そんなものばかりで、外には何もありませんでした。",
              "citation": {
                "source": "悪魔の宝",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "しみくひ、さびくさり、ぬすびとうがちてぬすむ所の地に財をたくはふる事なかれ。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しみくひ、さびくさり、ぬすびとうがちてぬすまざるところの天に財をたくはふべし。",
              "citation": {
                "source": "日記",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
