        "examples": {
          "standard": [
            {
              "text": "論文を投稿する前に、同僚に査読を依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "学術雑誌に掲載される論文は、厳正な査読を経て選ばれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "査読の結果、修正が必要な箇所がいくつか指摘された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし出版社の査読者の評定は悪く原稿は送り返された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "言いましたよ、まだ査読されておらず、編集長の机に鍵をかけて保管してあるのでしょう、同種の面白い小説と同じ所ですと。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            },
            {
              "text": "投稿される小説、記事はすべて名前、住所、日付を書いて台帳に登録され、適切な順番で全部査読されます。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
