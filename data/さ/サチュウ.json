    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そはあたかも砂中に真珠を拾うが如くである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きるとは、再の我に帰るの意にして、再の我に帰るとは、願にもあらず、望にもあらず、気高き信者の見たる明白なる事実なれば、聖徒イノセントの墓地に横はるは猶埃及の砂中に埋まるが如し。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きるとは、再の我に帰るの意にして、再の我に帰るとは、願いにもあらず、望みにもあらず、気高き信者の見たるあからさまなる事実なれば、聖徒イノセントの墓地に横たわるは、なおエジプトの砂中にうずまるがごとし。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "本邦では十八年前予英国より帰著の翌朝、泉州谷川で初めて見出し、爾後紀州諸郡殊に温かな海浜の砂中に多く、従来西人の記載に随えば少なくとも三種は日本にありと知ったが、自分永年の観察を以てすればこの三種は確乎たる別種でなく、どうもポリサックム・ピソカルピウムてふ一種の三態たるに過ぎぬごとし。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "上ってみると、なるほど砂中からニュウと出ている銀色の板――。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行は非常な興味をもって、これを砂中から掘りだしてみた。",
              "citation": {
                "source": "月世界探険記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨財を砂中に埋ずむべからず。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し黄金は砂中に在つて人間の手に触れない方が黄金の質を汚さないで好い。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは視点の相違である、愛を力説する人は、金を砂中に拾ひ上げる人だ。",
              "citation": {
                "source": "愛人と厭人",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "射的場の砂中から拾い出された一個の銃弾が主人公なのである。",
              "citation": {
                "source": "書かれざる作品",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂中に黄金の粒を探す者のような眼付で、十一谷君は古い反故るいをかきまわしたことであろう。",
              "citation": {
                "source": "十一谷義三郎を語る",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、砂耕法と稱して、純粹の硅砂中に植物を植ゑて各種の養分を與へても、同樣の試驗が出來るのである。",
              "citation": {
                "source": "ヴィタミン研究の回顧",
                "author": "鈴木梅太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり余は汀の砂中に顔の半分を埋めたのである。",
              "citation": {
                "source": "決戦川中島　上杉謙信の巻",
                "author": "――越後守安吾将軍の奮戦記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大仏造像の功徳によって、仏神感応して始めて我が国に出現した陸奥小田郡の黄金は、その実或いは平地の川の砂中から発見したのであったかもしれぬが、それが歌人の口に上っては、「陸奥山に黄金花咲く」となる。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "河流の所まで砂中に新しい水路を掘るには、幾日も労苦しなければなりません。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして水流が彼等を漸竭するのを待って、私は陶器を求めて砂中をさぐった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことをさせておくのは宝を砂中に捨てておくようなものではないか。",
              "citation": {
                "source": "備前名弓伝",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "気軽な中に認められる誠意を砂中の金のごとく愛する。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは砂中に黄金を捜す倦怠な仕事とさしたる変りはない。",
              "citation": {
                "source": "地方の民藝",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
