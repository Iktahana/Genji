        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "記事の最後にサマリーがまとめられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プレゼンテーションの冒頭で、本日のサマリーを述べます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は会議のサマリーを配布資料として用意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "よきサマリヤ人と悪しきサドカイ人とは、隣り合せに住んでいるのではないか。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠く幾つかの壁を隔てた彼方で、四つの絃楽器は、あるいは荘厳な全絃合奏となり、時としては囁く小川のように、第一提琴がサマリアの平和を唱ってゆくのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は偽学偽弁に長じたるパリサイ人を罵れり、彼は罪に充ち汚れに満てるサマリヤの女を救ひに入らしめたり、彼は生命を人間に備へたり、彼は死を人間より絶たんとせり、凡そ斯の如きことは極めて平々坦々たるが如しと雖、其実は無量の深味あるなり。",
              "citation": {
                "source": "実行的道徳",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前九時すぎにアフリカの東端、サマリランドの一角が左に現れる。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "下の機関室から油だらけになった火夫らしい若者が上って来たのに、サマリランドを指差して、あれは何という島ですかと船客の一人が訊ねた。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "同州ポウトランド市、グッド・サマリタン病院で看護婦の訓練を受けたのだ。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピリピの分封地、ベタニヤの町、エリコ、サマリアの小村では、人々が安らかに眠っていた。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初にサマリヤへ布教した、ピリポの肖像に相違なかった。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛という徳を自己のものとしたいならば、私たちは芸術品を作り出して与えるよりも先きに善きサマリア人のごとくに隣人に仕えることを学ぶべきである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は牧師や、伯母の注意があったにもかかわらず、キリストがサマリアの女と井戸端で語った例などを思い、どのような人でも愛を求めてくるものを斥けてはならないとて、この女とも公けに交わった。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリアの淫婦に話しかけた耶蘇には、彼女を説服して神の国の民となす力があった。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれはかの「善きサマリア人」のごとくに触れ合う個々の隣人に仕えることによって、最も生き生きとした、実践的な実の籠った愛を贈ることができるのである（拙文「隣人の愛」参照）。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていずれにせよ、私はいかなる場合にも、彼の「よきサマリヤ人」のよき意志を共存者に対して失うことを自らに許さぬであろう。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれだけの周囲が自分に許さるるかは、その人の器の大小によるのでありますまいか、キリストはサマリヤの娼婦にもただちに近づいて説教しました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリタン婦人施療院委員会は、ラジウム不足のため新患者の治療を拒絶せざるの止むなきに到れり、ラジウム購入費三〇〇〇ポンドに対して仮令いかに僅少なる献金も最大の感謝をもって受領されるべし。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリタン婦人施療院、会計ケンシントン卿。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「善いサマリア人」や「放蕩息子の帰宅」はかう云ふ彼の詩の傑作である。",
              "citation": {
                "source": "西方の人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリアムネの死後はサマリアのマルタケが閨房の勢力を独占していた。",
              "citation": {
                "source": "処女の木とアブ・サルガ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔のサマリヤ境に近きシンジルの村はづれにて、路傍橄欖樹下に三頭の馬を繋いで昼寝する男あり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "已にサマリヤの境に入れるなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "此れこそゲリジム山、昔サマリヤ人のエルサレムに対抗して神を拝せし跡、今山頂の建物は回教徒遥拝所なり、と案内者は説明す。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "井の傍なる壁に基督サマリヤの婦人に語り玉ふ小さき画額を掲ぐ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ、サマリヤの婦人は指し、基督は目して居玉ふなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナブルスは旧約のシケム、ふるき所にて此処のサマリヤ人の会堂に秘蔵するモーゼの五経は有名なるものなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリヤの墟址　五日。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "サマリヤは概してユダヤよりも地味まされり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち昔のイスラエル王国の首都サマリヤにて、後ヘロデも此処に壮麗なる府を建てぬ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅の興　サマリヤの廃墟より山いくつか越えてシレーと云ふ山腹の村の近くにいたり、馬を繋ぎ、無花果の枝の下に潜り入りて、毛布を地に敷き、少し早けれど携へたる牛乳、パン、ジヤム等にて昼食し、午憩す。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は終日サマリヤの山を行けるなり。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃は、新聞の日曜版に出る週間サムマリイをテキストにして、前週の時事についてお話しし合うことになり、私は定日である毎火曜日の午後、自宅から、必要な新聞紙一枚を携えて行くことにしているが、殿下は、御自分で常侍官候所に往き、そこの新聞掛けから必要の綴じ込みを片手に提げてお出でになるのが、常になった。",
              "citation": {
                "source": "この頃の皇太子殿下",
                "author": "小泉信三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
