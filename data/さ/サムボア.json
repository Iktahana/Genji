        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "谷崎先生は、円タクを途中で止めて、「一寸待ってて呉れ」と、北浜の、サムボアという酒場へ寄り、「赤い葡萄酒一本」と命じて、やがて葡萄酒の壜を持って来られた。",
              "citation": {
                "source": "食べたり君よ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入り、稽古あとは任せて、何しろ宵から遊べる日は今日だけだから、サムボアへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サムボアから、大雅へ、相変らずうまいものを食はせる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊知地といふジャズ青年来訪、サムボアへ連れて行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もと一座にゐた西田が、今里新地てふところへ案内したいと言ふので、大庭と一緒に南のトミヤサロン（此処はサムボアに次ぐよさだ）でブラック・ホワイト五杯ひっかけて行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹具合悪いからハネて、サムボアで、上等ウイのキャメオを少々のみ、トースト、オムレツといふところで、帰宿。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜、サムボア他でマッチを何百個と貰って来た、これは受けるであらう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ十時半、中島清輔・吉田修造等とサムボアへ行く、今夜は飲んで風邪を追っ払ふつもり。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "山野・石田を連れてサムボアへ寄り、それから大雅へ寄る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ十時十何分、青年部五六名連れてサムボアへ行って芸談しながらのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、山一を誘ってサムボア、それから大雅へ行き、のみ食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
