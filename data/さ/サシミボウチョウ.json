        "examples": {
          "standard": [
            {
              "text": "寿司職人は、研ぎ澄まされた刺身包丁で魚を捌いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "刺身包丁は切れ味が命なので、常に手入れを怠らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "家庭でも刺身包丁があれば、より美しく魚を盛り付けられる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それがある時台所で出入りの魚屋と世間話をしながら、刺身包丁を取り上げて魚屋の盤台の鰹の片身から幅二分くらい長さ一尺近い細長い肉片を巧みにそぎ取った。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
