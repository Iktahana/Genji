        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "将軍、独裁官田中ハ、諸君ヲ山東ニマデヨコサシメタル田中ハ諸君ノ階級ノ最悪ノ敵デアルコトヲ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "更ニ他ノ一理由ハ日本ノ將來ハ陸上ニアルト同一以上ノ程度ニ於テ海上ニ在ルガ故ニ、國民教育ニ於テ只陸軍的模倣ヲナサシメテ海兵的訓育ヲ閑却スルコトノ矛盾ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ノ理由ハ其ノ中食ニ一塊ノ「パン」薩摩芋麥ノ握飯等ノ簡單ナル粗食ヲナサシメ、以テ滋養價値等ヲ云々シテ眞ノ生活ヲ悟得セザル科學的迷信ヲ打破スルニアリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏シテ惟ルニ政府当局ヲシテ能ク其責ヲ竭サシメ以テ陛下ノ赤子ヲシテ日月ノ恩ニ光被セシムルノ途他ナシ。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、新ニ官史ヲ命ジテ此国ニ送リ、国内ニ群集シテ我州民ヲ煩ハシメ、我州民ノ膏血ヲ竭サシメタリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、我諸州ニ内乱ヲ起サシメテ、我州内ノ人民ヲ印度ノ野人ト同様ニ御セント欲スレドモ、印度人殺伐不仁ノ戦ト之ヲ同日ニ論ズ可ケンヤ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "政府当局ガ陛下ノ地ト人トヲ把テ如此キノ悲境ニ陥ラシメテ省ミルナキモノ、是レ臣ノ黙止スルコト能ワザル所ナリ」　かく政府の無為を糾弾して聖明に訴えたのち、さらに救済の方途を述べて、「伏テ惟ルニ、政府当局ヲシテ能ク其責ヲ竭サシメ、以テ陛下ノ赤子ヲシテ、日月ノ恩ニ光被セシムルノ途他ナシ。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
