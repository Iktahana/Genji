[
  {
    "uuid": "1864eabf-e2a7-57a7-adce-4d2241fbe3fe",
    "entry": "咲くり",
    "reading": {
      "primary": "さくり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "文語四段-カ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "佛よわたしは愛する　おんみの見たる幻想の蓮の花瓣を青ざめたるいのちに咲ける病熱の花の香氣を佛よあまりに花やかにして孤獨なる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに見よその時脚下に咲ける美花は来世の欲求であり、進んではまた来世の希望である。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二部、花咲ける野の朝。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　僕はポケットから鴎外訳の「ファウスト」を取り出し、れいの、花咲ける野の場を、それこそ、天も響けと読み上げた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "生ける犬を屠りて鮮血を啜ること、美しく咲ける花を蹂躙すること、玲瓏たる月に向うて馬糞を擲つことの如きは、言はずして知るベきのみ。",
              "citation": {
                "source": "蛇くひ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶子さんを見ると、流れに任せてなよ／＼と、どこの岸にでも漂い寄って咲ける萍の花の自然の美しさを感じずにはいられない。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃心して人に問う、甲冑堂の花あやめ、あわれに、今も咲けるとぞ。",
              "citation": {
                "source": "一景話題",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "画家　（一人、丘の上なる崕に咲ける山吹と、畠の菜の花の間高き処に、静にポケット・ウイスキーを傾けつつあり。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に、風邪薬を一｜貼、凍傷の膏薬一貝買ひに行つた話は聞かぬが、春の曙、秋の暮、夕顔の咲けるほど、炉の榾の消ゆる時、夜中にフト目の覚むる折など、町中を籠めて芬々と香ふ、湿ぽい風は薬屋の気勢なので。",
              "citation": {
                "source": "処方秘箋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "桔梗、刈萱、女郎花、我亦紅、瑠璃に咲ける朝顏も、弱竹のまゝ漕惱めば、紫と、黄と、薄藍と、浮きまどひ、沈み靡く。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忘憂　萱草のさま／″＼の草の間より独り抜け出でゝ長閑に咲ける、世に諂はず人に媚びず、さればとて世を疎みもせず人に背きもせざるおもむきあり。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "藪椿のもさ／＼と枝葉茂れるが中に濃き紅の色して咲ける、人は賤しといふ、我はおもしろしと思ふ。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "わびすけの世をわび顔に小さく咲ける、人は見るに栄無しといふ、我はをかしと思ふ。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに八重の淡紅に咲けるが、晴れたる日、砂立つるほどの風の急に吹き出でたるに、雨霰と夕陽さす中を散りたるなど、あはれ深し。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "名も無き小川のほとりなる農家の背戸の方に一本二本一重なるが咲ける、其蔭に洗はれたる鍋釜の、うつぶせにして日に干されたるなんど、長閑なる春のさま、この花のあたりより溢れ出づる心地す。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "川を隔てゝ霞の蒸したる一ト村の奥に尽頭に咲き誇りたるを見たる、谷に臨みて春風ゆるく駐まるべき崖下などの小家包みて賑はしく咲けるを見たる、いづれをかしき趣あらぬは無し。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の後など古き茅屋の棟に咲ける、おもしろからずや。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "珍しや花のねぐらに木づたひて谷の古巣をとへる鶯　やっと聞き得た鶯の声というように悲しんで書いた横にはまた「梅の花咲ける岡辺に家しあれば乏しくもあらず鶯の声」と書いて、みずから慰めても書かれてある。",
              "citation": {
                "source": "源氏物語",
                "author": "初音",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちやって行ってはいけませんよ」　とお言いになっても、薫の迷惑そうにしているのを御覧になって、女郎花咲ける大野をふせぎつつ心せばくやしめを結ふらん　とお言いになった、冗談のように。",
              "citation": {
                "source": "源氏物語",
                "author": "総角",
                "note": "青空文庫"
              }
            },
            {
              "text": "渚の薔薇紀の南、白良の渚、荒き灘高く砕けて天暗う轟くほとり、ひとならび夕陽をうけて面ほてり、むらがり咲ける色｜紅き薔薇の族よ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ戸に咲ける罌粟ひとつ知らえぬ汝等、いかで、さは深き館の内心を。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ひ亂るる人の子は、紫野ゆき、萌野ゆき、紅梅咲ける君が戸へ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "我｜嘗て、夕ぐれ野路を辿りて黄に咲ける小花を摘み、涙せきあへざりし感懐を叙したるの詩あり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "年｜歴た物で鼻｜尖に白毛生じ、背には小木生じて花の白く咲けるよりこの名を負いしという。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "風の光に鷄頭の黄なるがあまた咲ける見てけふも野に立つ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "人のいやしき手にて作られし物と變りて、百種の野花思ひ／＼に咲けるぞめでたき。",
              "citation": {
                "source": "北村透谷詩集",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "みゝずのうたこの夏行脚してめぐりありけるとき、或朝ふとおもしろき草花の咲けるところに出でぬ。",
              "citation": {
                "source": "北村透谷詩集",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで人類の或る部分が今日なほ幼年期にとどまるとき、他のものは活溌な少年期、花咲ける青年期に、更に他のものは力強き壯年期に達してをり、然るに二三のものは重々しい老年期にまで、生の高頂にまで推し進んでゐるのである。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
