        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "最後の直線で、その馬は驚異的な「差し足」を見せ、トップに躍り出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ジョッキーは、ゴール直前で馬の力を最大限に引き出し、「差し足」を誘発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「まさか、あんな「差し足」で勝つなんて！観ていて鳥肌が立ったよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
