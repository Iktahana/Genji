        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トコロガ、オツウヤノバンニ、キテイタ人ガオソクナッテカラ目ヲサマシテミルト、ホトケサマノ前ニソナエテイタモノガ、ドレモコレモ一ツノコラズナクナッテイタコトガ分リ、大サワギニナッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノサワギノ最中蚊帳ノ釣手ガフッツリ切レテ上カラ下リマシタノデ、私ハ一気ニ之ヲハネノケテシマイマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の辺の湿地は、一面のサワギキョウで濃紫の花が目醒むばかり咲き揃って、猶所々にエンビセンノウの真紅が夜火の如く群落をして居る。",
              "citation": {
                "source": "女子霧ヶ峰登山記",
                "author": "島木赤彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日│　　　七・〇〇│一〇・三〇│　　　十七日│　　　六・五〇│一〇・四〇│　　　十八日│　　　六・三〇│一一・三〇│　　　十九日│　　　六・四〇│一一・〇〇│　　　二十日│　　　六・四五│　　　――│戸台さん盲腸サワギ　　二十一日│朝八時―一二。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六ヒゲナシ山羊サン　ヲ見テミンナ　オコルヤラ、泣クヤラ大ヘン　ナ　サワギニナツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイタリ、タタイタリ、コスツタリ、ナカハ　タイヘンナサワギデス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクンガアンマリサワグノデ、マタタロー　　サンニシカラレマシタ、ガマタ　スグウレシクテタマラナイノデサワギダシマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "またこれをヤブランとすれば、これはまた大いに実（黒色）の生るもので、決して実成らぬ如きのサワギではない。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コワいのと、さびしいのとで、私はねむるどころのサワギではない。",
              "citation": {
                "source": "お泊り",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、マモナク、ニッポンジュウガ、オオサワギニナルダロ、オレガ、シゴトヲ、ハジメルカラダ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
