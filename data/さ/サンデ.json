        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "後日になって、倫敦のサンデー・ビクトリアル紙は左の如く当日の模様について述べた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのような夜半には、私もまた、菊池寛のところへ手紙を出そうか、サンデー毎日の三千円大衆文芸へ応募しようか、何とぞして芥川賞をもらいたいものだ、などと思いを千々にくだいてみるのであるが、夜のしらじらと明け放れると共に、そのような努力が、何故とも知らず、馬鹿くさく果無く思われ、『やがて死ぬるいのち。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天満京阪裏の古着屋で一円二十銭出して大阪××新聞の法被を仕込み、売るものはサンデー毎日や週刊朝日の月おくれ、または大阪パックの表紙の発行日を紙ペーパーでこすり消したもの、三冊十五銭で如何にも安いと郊外の住宅を戸別訪問して泣きたんで売り歩く。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し霧がかかってはいるが、サンデニからボアのほうまでも見渡される。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "★ビル・アトキンソンはカリフォルニア大学サンディエゴ校（ＵＣＳＤ）でジェフ・ラスキンに教わった経験を持っており、スティーブン・レヴィの『マッキントッシュ物語』（武舎広幸訳、翔泳社、一九九四年）によれば、同大学でラスキンが主宰していたアングラ劇団の演出を手伝ったことがあった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "カリフォルニア大学サンディエゴ校（ＵＣＳＤ）で開発されたＵＣＳＤパスカルは、Ｐコードを採用し、代表的なマイクロコンピューターに幅広く対応していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて師匠の存在はテレビ屋さんの知るところとなり、サンデープロジェクトという日曜朝の番組からお声がかかった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニュー・ヴォードヴィル・バンド〈ウィンチェスター・カテドラル〉、ナンシー・シナトラ〈シュガー・タウン〉、彼女の父親の〈ザッツ・ライフ〉、ロニー・ダヴ〈クライ〉、ボビー・ヴィントン〈カミン・ホーム・ソルジャー〉、サンディー・ポウジー〈シングル・ガール〉。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも、例によって高志は、サンディーちゃんはかわいい声してる、〈シングル・ガール〉はいい曲だ、などといっているし、鼻歌のレパートリーに〈シュガー・タウン〉を加えているが。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディス・プログラム・イズ・コンパイルド・バイ・ケイ・アンド・ユアーズ・トゥルーリー、キープ・ユア・ヘッド・アップ、ティル・ネクスト・サンデイ、バイバイ」　ワラのあいさつが終わると、〈バルボア・ブルー〉が大きくなり、二〇秒ほどでフェイドアウトした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二学期までは、この寮で漫画雑誌を見かけることはなかったが、最近はあちこちの部屋に、「サンデー」や「マガジン」が転がっている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "キイテ　ヰタ　トシヨリハ　フカイ　タメイキヲ　ツイテ、「センサウハ　モウ　タクサンデス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和11・７「サンデー毎日」）鳶　去年の十月頃の新聞を見た人々は記憶しているであろう。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和２・４「サンデー毎日」）ゆず湯一　本日ゆず湯というビラを見ながら、わたしは急に春に近づいたような気分になって、いつもの湯屋の格子をくぐると、出あいがしらに建具屋のおじいさんが濡手拭で額をふきながら出て来た。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和11・８「サンデー毎日」）歯なしの話　七月四日、アメリカ合衆国の独立記念日、それとは何の関係もなしに、左の上の奥歯二枚が俄かに痛み出した。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭10・３「サンデー毎日」）最後の随筆目黒の寺　住み馴れた麹町を去って、目黒に移住してから足かけ六年になる。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」昭和十一年十二月作「サンデー毎日」",
              "citation": {
                "source": "牛",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和十一年四月作「サンデー毎日」",
              "citation": {
                "source": "鯉",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」昭和十二年十二月作「サンデー毎日」",
              "citation": {
                "source": "虎",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和七年十一月作「サンデー毎日」",
              "citation": {
                "source": "鼠",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」昭和九年十月作「サンデー毎日」",
              "citation": {
                "source": "夢のお七",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "明る土曜はまず平常の通りで、次が「イースター・サンデー」また買物を禁制される。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "男と女との胸釦の相異５・28サンデー毎日　今日は一ついつもとはぐつと趣向をかへて、変つた小話を幾つか書き集めてみることにする。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十四万石の駄洒落６・11サンデー毎日　ついこなひだのこと、侯爵細川護立氏のところへ、春陽会の若い画家五六人が饗ばれて往つたことがあつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはかうさ――　　もしもし亀よ　　　　亀さんよ……」器用な言葉の洒落６・18サンデー毎日　前号に細川護立侯のことを書いたから、今日はその御先祖細川幽斎のことを少しく書いてみよう。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "美術批評家と夏蜜柑７・９サンデー毎日　日本の宴会には、よくお客同志の余興づくしといつたやうなものがあつて、それあるがために自分の隠し芸を、人前に押し売りをする事の出来る楽しみもあるが、どうかすると、自分が芸無しのために飛んだ恥をかゝされることがよくある。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
