          "standard": [
            {
              "text": "担任の先生が黒板に「将来の夢」と作文の題を書くと、教室がざわついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "作文の題が「平和」と発表された瞬間、子どもたちはいっせいにうなりはじめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "何を書くか迷っていたが、作文の題を見てすぐに祖父のことを書こうと決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
