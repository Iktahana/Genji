        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今年の畑は豊作で、多くの幸を得ることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "山の幸、海の幸をふんだんに使った料理が並んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "努力の末に得られた幸は、何物にも代えがたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
