          "literary": [
            {
              "text": "小泉医師の指示によりサリドン一錠、アダリン二錠投与。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月二十日（火曜）　夜中に歯痛、サリドンのんで寝る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方雨の中を堀ビルの寺木ドクトルへ行くと、あひにく留守で代診、サリドン錠てふ薬を教へられたので安心する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽屋入りすると、サリドン服み、胃散服み、一寸経って、アリナミン、フローミン服む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
