[
  {
    "uuid": "23cf7806-a210-5c0f-af5b-66bd5b69479d",
    "entry": "探し回る",
    "reading": {
      "primary": "さがしまわる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null,
