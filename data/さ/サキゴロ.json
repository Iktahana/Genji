    "definitions": [
      {
        "index": 1,
        "gloss": "recently",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "先ごろオープンしたばかりのカフェに行ってみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先ごろ発表された研究結果が、大きな注目を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先ごろ、長年の友人と偶然再会した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どっどど　どどうど　どどうど　どどう　　　青いくるみも吹きとばせ　　　すっぱいかりんも吹きとばせ　　　どっどど　どどうど　どどうど　どどう　　　どっどど　どどうど　どどうど　どどう　先ごろ、三郎から聞いたばかりのあの歌を一郎は夢の中でまたきいたのです。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がこの農場を何とか処分するとのことは新聞にも出たから、諸君もどうすることかといろいろ考えておられたろうし、また先ごろは農場監督の吉川氏から、氏としての考えを述べられたはずだから、私の処分についての、だいたいの様子はわかっておられたかとも思います。",
              "citation": {
                "source": "小作人への告別",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本線シグナルつきの電信柱、おまえの叔父の鉄道長に早くそう言って、あの二人はいっしょにしてやった方がよかろうぜ」　見るとそれは先ごろの晩の倉庫の屋根でした。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔭さまをもちまして………あのお宅さまでは奥様も御機嫌およろしゅう御座いますか」「先ごろから少々わずらって居ますがさしたることもありません。",
              "citation": {
                "source": "荘子",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとて取留めた証拠もなしに、多年無事に勤めている奉公人、殊に先ごろは自分の供をして長い道中をつづけて来た義助を無造作に放逐することも出来ないので、ただ無言のうちにかれらを監視するのほかはなかった。",
              "citation": {
                "source": "鼠",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "すこし別なことではあるが、先ごろ青山学院で監督か何かしていたある外国婦人が死んだ。",
              "citation": {
                "source": "弓町より",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、先ごろ李陵の使いとして漠北から「戦線異状なし、士気すこぶる旺盛」の報をもたらした陳歩楽だけは（彼は吉報の使者として嘉せられ郎となってそのまま都に留まっていた）成行上どうしても自殺しなければならなかった。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "母妻子を族滅された怨みは骨髄に徹しているものの、自ら兵を率いて漢と戦うことができないのは、先ごろの経験で明らかである。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなことが先ごろの週刊タイムスに出ていた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和十年十月十六日）　　　　　　　＊　先ごろ警視庁で東京市のギャング狩りを行なったときに検挙された「街の紳士」たちの中に、杯やコップを噛み砕いてくちびるから赤い血を出して相手を縮みあがらせるというのがいた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その地に着いたのはつい先ごろ　仄暗い極北の地から――聳え立つ奇怪の荒野から　　　宙の果て、時の果てから。",
              "citation": {
                "source": "ポオ異界詩集",
                "author": "エドガー・Ａ・ポオ　Edger A. Poe",
                "note": "青空文庫"
              }
            },
            {
              "text": "故郷にさまよい出たのはつい先ごろ　あの仄暗い極北の地から。",
              "citation": {
                "source": "ポオ異界詩集",
                "author": "エドガー・Ａ・ポオ　Edger A. Poe",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんな人の頼んだ絵など、いっそいつまでも出来ない方がようござります」　この藩の用人荒木｜頼母の伜千之丞は、伝兵衛の推挙で先ごろ千倉屋へたずねて来て、澹山に西王母の大幅を頼んで行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "旅絵師",
                "note": "青空文庫"
              }
            },
            {
              "text": "「本邦にて最も重要なる位置にある某汽船会社の所有船○○丸の事務長は、先ごろ米国航路に勤務中、かつて木部孤※に嫁してほどもなく姿を晦ましたる莫連女某が一等船客として乗り込みいたるをそそのかし、その女を米国に上陸せしめずひそかに連れ帰りたる怪事実あり。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "移転以来、花を生けて眺めるという気分にもなれず、花を生けるような物も具えていないので、先ごろの天長祝日に町内の青年団から避難者に対して戸ごとに菊の花を分配してくれた時にも、その厚意を感謝しながらも、花束のままで庭の土に挿し込んでおくに過ぎなかった。",
              "citation": {
                "source": "十番雑記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時東京からの扈従記者は新聞では国民新聞の坂本氏、通信社では電報通信の小山氏、日本通信の吉田氏らであつた、その時の新聞班の係長はつい先ごろまで、千葉県や群馬県の県知事をしてゐた県忍氏で県氏はその当時北海道庁の事務官であつたため新聞班の係長に選定されたのである。",
              "citation": {
                "source": "石川啄木と小奴",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一体ゆうべは何処へなにしに行きなすったんだ」「中の郷｜元町の御旗本大月権太夫様のお屋敷へ伜の名代として罷り出まして、先ごろ納めましたるお道具の代金五十両を頂戴いたしてまいりました」「元町へ行った帰りなら源森橋の方へかかりそうなもんだが、どこか路寄りでもしなすったか」「はい。",
              "citation": {
                "source": "半七捕物帳",
                "author": "広重と河獺",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に先ごろお酉にむかって、酔ったまぎれに、こんなことを云った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "かむろ蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その月の晴れた日に勘蔵が新らしい袷を着て、干菓子の折を持って、神田三河町の半七の家へ先ごろの礼を云いに来た。",
              "citation": {
                "source": "半七捕物帳",
                "author": "熊の死骸",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは口では一人残らず民主主義を唱えているが、その大部分はにせものであつて、本質は、先ごろの暗黒時代の政治家といささかの差異もない。",
              "citation": {
                "source": "政治に関する随想",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなこととは夢知らぬ彼の息子夫婦はある日近ごろひどく評判の降って湧いたそんな繁華の町にきてみると、そこの御殿の女殿さまというのは、先ごろ自分らがカヤの小舎に入れて焼き殺したはずの老婆なので驚き、かつあきれます。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい先ごろも復活祭の式の最中に各会堂へ共産党員があばれこみ、口笛に合わしてだんすをはじめ礼拝を妨害した事件があったという。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい先ごろまで幕のむこうに隠しておいてわずかに小穴から覗かせたという作も、いまは全部公開している。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ごろ来朝していた作家シーモノフが、日本の出版界にもそれを衷心から希望したとおり、ソヴェト同盟の出版事業は直接に人民文化の仕事として企画され運営されている。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ごろ何かのグラフィックに大学教授の老先輩が男女学生を集めて面白可笑しく学生アルバイト漫談をしている記事がのっていた。",
              "citation": {
                "source": "生きつつある自意識",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって、先ごろ、文学の外にいると考えられている人々の間から、文芸評論に類似する発言が迎えられた現象もおこした。",
              "citation": {
                "source": "「下じき」の問題",
                "author": "――こんにちの文学への疑い――",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ごろも、甚だ野暮な次第であるが、三組の夫婦づれで心斎橋を散歩した時、あまりにのどが乾いたのでお茶でも飲みましょうといったが、その適当な家がないのだ、ふと横町に多少静からしい喫茶の看板を発見してドアを開けると、これはまた例の青暗い家だった。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ごろ女中のお梅が市場へ蛸を買いに行った時、なるべく足の沢山あるのを下さいといったら魚屋のおやじが、蛸の足は昔から八本ときまってますと答えた。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人、先ごろからの、東本願寺問題に、才腕ある連枝だとの評が高い。",
              "citation": {
                "source": "九条武子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも無理のないのは、その辺、紅毛人の散歩場なのでもあるし、つい先ごろまでは、人中で肌などあらわすようなことは、死んでもしないというふうに女はしつけられていたのだから、白昼衆目の見る前で、島田の娘の水泳ぶりには、記者も驚いたのであろう。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
