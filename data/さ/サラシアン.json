        "examples": {
          "standard": [
            {
              "text": "和菓子の材料として、さらし餡は非常によく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "さらし餡を使った上品な練り切りは、茶道の席で喜ばれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この店では、自家製のさらし餡を使ったどら焼きが人気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "近ごろ理学士｜藤野米吉君が、液の代わりに製菓用のさらし餡を水で練ったものの層に熱対流を起こさせる実験を進めた結果、よほどまで、上記自然現象の機巧の説明に関する具体的な資料を得たようである。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
