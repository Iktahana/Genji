        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "教会では、信者たちが捧げ物を祭壇に運んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "神殿には、人々が持ち寄った色とりどりの捧げ物が並べられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その村では、豊作を祈願して毎年大きな捧げ物をする習慣がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "咲競ふた花は美しさと、その貴い香水のにほひとを合せて、春の女神への捧げ物として居りました。",
              "citation": {
                "source": "駒鳥の胸",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏前に親王方もさまざまの捧げ物を持っておいでになったが、源氏の姿が最も優美に見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "榊",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮中、東宮、院の后の宮、中宮をはじめとして、法事へ諸家からの誦経の寄進、捧げ物なども大がかりなものが多いばかりでなく、この法会に志を現わしたいと願わない世人もない有様であったから、華麗な仏会の式場が現出したわけである。",
              "citation": {
                "source": "源氏物語",
                "author": "御法",
                "note": "青空文庫"
              }
            },
            {
              "text": "○布施置きて吾は乞ひ祷む欺かず直に率行きて天路知らしめ　〔巻五・九〇六〕　山上憶良　これも同じ歌で、「布施」は仏教語で、捧げ物の事だから、前の歌の、「幣」と同じ事に落着く。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "結願の時種々の捧げ物を取り出でたのを法然は不受の色を表わして、「念仏というものは自らの為の勤めである。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちやうど王様の足許にいろんな家来が捧げ物を供へるやうな恰好だ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "予が全身は、彼女の前に捧げ物となる。",
              "citation": {
                "source": "一青年異様の述懐",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "この長期にわたる疲れる食事および暗示的な準備は、厳粛な祈りと捧げ物の儀式を伴い、このシンボリズムは想像を強く刺激するものであった」(14)。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから上を眺めると僧侶がチーズ・ケーキとイチジクを叩く聖なるテーブルから；それから回る捧げ物台に何が残っているか見る、そして見つけたものを神聖なものとして一種の袋に入れる？",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "エピダウロスの捧げ物テーブルから病例や治療の性質をよく知ることができる。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "第22図　コス島アスクレピオス医学校第23図　コス島アスクレピオス医学校の図（1902-1904の発掘による）．第24図　捧げ物第25図　眼病のさいの捧げ物（左）　第26図　現代ドイツにおける眼病のさいの捧げ物（右）　キリスト教との戦いにおいて、異教はアスクレピオス寺院を最後の砦とした。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度遥か彼方のガンジスで、インドラ神の僧侶が行う血の捧げ物に対し釈尊が抵抗したように。",
              "citation": {
                "source": "夕映えのむこうの国",
                "author": "時代を超えた童話",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の誓ひは、空しく、彼女の捧げ物は、僞りだ――僕には何も彼も見えて、分つてゐる。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはギリシャ起源の祭りであり、祈りと捧げ物の時であった。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘビたちはアスクレピオスの化身として崇拝され、病人によって祭壇において「ポパナ」すなわち捧げ物のケーキを与えられる。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "言い換えると幾らか金がかかりそれが捧げ物であった。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々日本人のヌサまたは捧げ物は、出来るかぎり清く汚れなくして、元は最も神の御座に近く進らせんとして、時としては眼に見えぬ霊体の所在を標示する樹枝や斎串の木に、直接に結わえつける習わしがあったらしく、今でも片田舎にはそれが多く見られる。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの家のえんとつからも、貧乏なお百姓さんの家の、ちっぽけなえんとつからさえも、ちょうど、ドルイド教徒のさいだんからのぼる煙のように、かんしゃをこめた、ささげものの煙が、うす青く立ちのぼりました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "女神が捧げものを徹して持ち帰る姿が望まれた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は人からあらゆる捧げものを要求する。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫婦、親子、兄妹の愛さえも、それは天皇と国家への捧げものと見られなければならず、そこには別離の愛惜と生命への不安と絶対的な権力への疑問抗議は、当時の日本人の心に存在してはならなかったのであった。",
              "citation": {
                "source": "解説（『風知草』）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつりなる言葉は、長上に献ずる義から、神の為の捧げものを中心にした祭儀といふのが、古意なのである。",
              "citation": {
                "source": "たなばたと盆祭りと",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "列席の秀才や、淑女は、鼻汁をすすりながら、神妙に席をくずさず構えているのは、多分、この祭礼と供養が済みさえすれば、あの捧げものの田つ物と、畑つ物と、かぐの木の実とは、公平に分配してもらえるか、或いは自由競争で取るに任せるか、その未来の希望を胸に描いて、それを楽しみにおとなしくしているものらしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもてむきの解説では聖マイケルはキリスト教の聖者であるが、ほんとうはもつとずうつと古い、異教時代の神か英雄であつたらしく、マイケルを祭る儀式といふのは非常に古いふるいにほひを持つてをり、ミケル祭の供へ物に仔羊を殺すしきたりも、或はキリスト教以前にはもつと野蛮な捧げものをしたのかとも疑はれる。",
              "citation": {
                "source": "ミケル祭の聖者",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でも小木の鎭守の社の前には道祖神とならんだ數個の陰陽石に捧げものが絶えません。",
              "citation": {
                "source": "相川おけさ",
                "author": "村松おけさ、佐渡牛などのこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "朕もまた、そのような捧げものをせざるをえなかったお前たちの愛情に劣らぬ歓びをもって、これを受け取るだけの礼を知っています。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "いえ、朕はかかる捧げものは、どんな宝よりも富よりも尊きものと思います。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "その女が山国の女軍の女たちにその鳥の姿で現はれる時は彼等は捧げものをして戦さの支度をする。",
              "citation": {
                "source": "鷹の井戸（一幕）",
                "author": "AT THE HAWK'S WELL",
                "note": "青空文庫"
              }
            },
            {
              "text": "いでやこの涙を捧げものにして詩人の墓を訪おう。",
              "citation": {
                "source": "面影",
                "author": "ハーン先生の一周忌に",
                "note": "青空文庫"
              }
            },
            {
              "text": "お礼が捧げられ治癒した臓器を示す捧げものが作られた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
