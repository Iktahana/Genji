[
  {
    "uuid": "1d8d1169-6f6c-5e23-b023-194e7d3da106",
    "entry": "さつま芋",
    "reading": {
      "primary": "さつまいも",
      "alternatives": [
        "かんしょ",
        "サツマイモ"
      ],
      "is_heteronym": true
    },
    "grammar": {
