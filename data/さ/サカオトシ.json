[
  {
    "uuid": "ea72e50b-86ab-5309-9136-7e74b238d055",
    "entry": "逆落とし",
    "reading": {
      "primary": "さかおとし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
