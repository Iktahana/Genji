        "examples": {
          "standard": [
            {
              "text": "戦国時代の武将は、敵陣に逆落としをかけて奇襲を成功させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "スキーヤーは急斜面を逆落としの勢いで滑り降りた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "経済状況は逆落としのように悪化していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
