        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もしこれがアイヌだとすると、隣国｜讃岐は「サンノッケウ」すなわち顎であろう。",
              "citation": {
                "source": "土佐の地名",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は「ゾ　ウサンノタメシヨウガ　ツヤスミヘンジ　ヨウ」カエラヌ」ツルキチ」鶴さんからオトラ婆さんに宛てたものだった。",
              "citation": {
                "source": "電報",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣの発表直後の八月二十四日、アップルは地元紙のサンノゼマーキュリーに「本気でウエルカム、ＩＢＭ殿」と全面広告を打った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロサンゼルスのローカル空港からバスにでも乗る感覚でサンノゼに飛び、会場のコンベンションセンターを訪ねると、そこにはもっと大きな衝撃が古川を待ち受けていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "年下の少年に披露したことに満足することなく、ウォズニアックはクリームソーダコンピューターに世間の注目を集めようと、地元の『サンノゼマーキュリー』紙の記者に連絡をとった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンノゼの自宅からメンローパークで開かれた初めての集会に出かけていって以来、ピットマンは欠かさずクラブの集まりに顔を出した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一九七七年二月、サンノゼで開かれたウエストコースト・コンピューター・フェアーをのぞいた体験が、その後の古川の進路を決定づけた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは誰だと、若い女に聞けば、ワタシノダンナサンノオ母サンと答へた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは誰だと、若い女に聞けば、ワタシノダンナサンノオ母サンと答えた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレト　一シヨニ、ソノ　ウタヲ、ヨク　ウタツテ　下サツタ、ヤサシイ　オ母サンノ　コトモ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヒルノ　ヤスミノ　トキ、ヨシダセンセイニ　イヒツカツテ　タキクンハ、トウサンノ　トコロヘ　ホンヲ　モツテ　イキマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　トウサンノ　ウシロカラ、「オトウサン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オマエハ　ナゼ　オカアサンノ　イフ　コトヲ　キカナイノ」ト　オカアサンノ　タケガ　キキマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソラヨ」ト　カアサンノ　デンデン蟲ハ　コタヘマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コヒツジハ　オカアサンノ　オチチガ　コヒシク　ナツテ　キテ、「メイ　メイ、オカアチヤン　オカアチヤン　オチチ　ノミタイ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、アカチヤンハ、コトリヲ　ミナイデ、ミチコサンノ　カホヲ　ミテ　ヰテ　ニツコリ　ワラヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ、オテテデ　ミチコサンノ　ネクタイヲ　ツカミマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ソレハ、オヂイサンノ　ミミガ　キイタノデハ　アリマセン、ココロガ　キイタノデス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンノキノ　シタデ　オカアサンノ　タヌキガ　コドモノ　タヌキニ　バケル　コトヲ　ヲシヘテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　オサムラヒニ　バケル　トキダヨ」　オカアサンノ　タヌキハ　ガツカリシテ　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　タクサンノ　フウセンノ　ウチ、イチバン　チヒサイ　アカイ　フウセンダマト、タイヘン　ナカヨシデシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シ我工場ハ幸イニシテ、皆サンノ勤勉努力にヨッテ、ソノ些々タル影響モ受ケテイナイノデアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして出来上った南瓜のような顔の横へ「ネーサンノカオ」と書いておいた。",
              "citation": {
                "source": "火",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
