        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "君は尼寺に居給ふとき、「プサルモス」の歌を聽き、又古の聖の上を綴りたる韻語を學び給ひしならん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "就中、アポリネエルやサルモンやラジゲやコクトオや。",
              "citation": {
                "source": "訳詩集「月下の一群」",
                "author": "その著者堀口大学に与ふ",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヴァン・ゴオルはサルモンのあるものと共に、僕にはわかりにくいものだ。",
              "citation": {
                "source": "訳詩集「月下の一群」",
                "author": "その著者堀口大学に与ふ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてサルモンはわからぬなりに好きだし、これはわからぬなりにきらひだ。",
              "citation": {
                "source": "訳詩集「月下の一群」",
                "author": "その著者堀口大学に与ふ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の祐筆が記した若年ごろの日誌を見ても、御本丸ニ御座成サルモ、常ニ御座之間ニハ一人モ罷リ在ラズ。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（トカチ国ホンベツ町字チエトイ、清川ネウサルモン婆さんから、更科源蔵氏採集――『北海道伝説集』171ページ）（７）地獄穴という訳語は正しくないので“いわゆる地獄穴”とした。",
              "citation": {
                "source": "あの世の入口",
                "author": "――いわゆる地獄穴について――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
