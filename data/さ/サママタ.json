          "literary": [
            {
              "text": "◯宮様又もや御放送。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀林院様又御意なされ候は、唯｜黄泉路の障りとなるはその方どもの未来なり、その方どもは心得悪しく、切支丹の御宗門にも帰依し奉らず候まま、未来は「いんへるの」と申す地獄に堕ち、悪魔の餌食とも成り果て候べし。",
              "citation": {
                "source": "糸女覚え書",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて一人の女の子が、「よう、御姉樣又何時もの樣に叔母さんごつこ爲ませうよ」と云ひ出した。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
