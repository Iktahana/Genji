      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "drinker",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はかなりの左党で、毎晩ビールを欠かさない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "我が家の父は無類の左党で、日本酒が大好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "左党の集まりで、各地の銘酒が振る舞われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "国民政府に於て左党の政策の欠如が右党に幸して、彼等は尨大な小ブルジョワを党に獲得し、南方の多くのブルジョワも三民主義の名に隠れて党に参加した。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "革命的左党は右党派軍隊に絶滅され、国民党は共産分子を除外して孫文の国民党はブルジョワ階級の走狗となった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝から酒、それもよろしい（Ｍさんのところは造り酒屋で、Ｍさんはその主人で、しかもさうたうの左党だ）、お土産として生一本を頂戴する、酒銘として幾山河は好いでないこともないが、牧水の門人としてのＭさんの心意気が見えてうれしい、殊に傍書の「白玉の」の歌はうれしい。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "有らゆる迷信や、右党若しくは左党の狂信に惑わされない民衆を。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘーゲル左党と呼ばれたこの一団は、ドクトル・クラブを組織していて、十九歳のマルクスはこのグループに入った。",
              "citation": {
                "source": "カール・マルクスとその夫人",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい近頃、僕は吹田氏の訳したヴンデルバンドの『十九世紀独逸思想史』という書を瞥見したが、その中でもヘエゲル左党の一人によって書かれた「奇異なる」一個の著作として辛うじてその存在を認められている位なものである。",
              "citation": {
                "source": "自分だけの世界",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "Hegel 派の極左党で、無政府主義を跡継ぎに持っている Max Stirner の鋭利な論法に、ハルトマンは傾倒して、結論こそ違うが、無意識哲学の迷いの三期を書いた。",
              "citation": {
                "source": "沈黙の塔",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにはまた紹興老酒の高級品があり、左党の喜ぶところであるが、それでいて喧騒な人声は少い。",
              "citation": {
                "source": "北支点描",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやひよつとするとこの色どりは、おととしの政変――それに伴ふ左党の圧倒的進出の、反映であるのかもしれない。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "門外に見張っていた部下から翌朝になって前夜の男は独立左党の領袖ランジュルー代議士で生活困難家族多数という報告が来た。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "左党の反対は卑劣にして不信実である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "口実を得ようと欲する時に左党は革命を説く。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "左党と極左党との間に席を占め、未来の吉凶を顧慮しないので民衆から愛せられ、かつて皇帝によく仕えたので群集から愛せられていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、いわゆる左党の人が、甘いものは一切やらないというのが、何うも判らない。",
              "citation": {
                "source": "甘話休題",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく物恋うるこころに変りはないけれども、自分はそれにも増して、「知る」ということの惧ろしさとうれしさを始めて感じ出した。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜ごとにＫ市の本町通りで開かれる市にいつもきまって出現した、おもちゃや駄菓子を並べた露店、むしろの上に鶏卵や牡丹餅や虎杖やさとうきび等を並べた農婦の売店などの中に交じって蓄音機屋の店がおのずからな異彩を放っていた。",
              "citation": {
                "source": "蓄音機",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔法使いは、ちょうど、人間が小さなカナリアにおさとうをなめさせてやるようなぐあいに、自分の口から、ヒキガエルにえさをやっているところでした。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば、菓子屋のおばさんのところでもめったに売っていないような、すてきにおいしい、小ブタのさとう菓子を持っていました。",
              "citation": {
                "source": "眠りの精",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤルマールは通りすぎるときに、その小ブタのさとう菓子のはしをつかみました。",
              "citation": {
                "source": "眠りの精",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、お姫さまがそれをしっかりとにぎっていたので、さとう菓子は二つに割れてしまいました。",
              "citation": {
                "source": "眠りの精",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "一週間ののち、少女はまた飛び立つような身軽るさとうれしさとに輝く盛夏の日光を、限りなく身一っぱいに浴することが出来た。",
              "citation": {
                "source": "咲いてゆく花",
                "author": "素木しづ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その馬車のうちがわは、さとうビスケットでできていて、こしをかけるところは、くだものや、くるみのはいったしょうがパンでできていました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で自分の食べるものを料理するという事にもかつてない物珍しさとうれしさとを感じた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、つみかさねてあった荷物が、がさがさとうごきだしました。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼いわたしにとって菊人形は面白さとうす気味わるさとのまじりあった見ものだった。",
              "citation": {
                "source": "菊人形",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉原の土手下で夜を明した時、どこのものかが名物の土手の金つばをくれたが、その大きさとうまさを何時までも忘れなかったと言った。",
              "citation": {
                "source": "木魚の顔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに時刻がおそければおそいほど、渡し船のさびしさとうれしさとがしみじみと身にしみる。",
              "citation": {
                "source": "大川の水",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争がすんだら、たくさんおさとうが来るから、そしたらおしるこをどっさりたべようねっていっていました。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさとうは台湾でたくさんできていたのだそうです。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさとうって、どうしてつくるのでしょう。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
