        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "デモ、オ母サンハモンコチヤンニモ、ワンコチヤンニモ、ニヤンコチヤンニモ、ソレゾレオイシイオ菓子ヲ下サイマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "御療治ノ最中ニ失礼ダト存ジマシタケレド、先日颯チャンカラオ願イシマシタラ御承知下サイマシタソウデ誠ニ有難ウゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ直グ脈ヲ取ッテ見テ、「プルスガ九十以上ゴザイマスネ、ドウカナサイマシタンデスカ」「イヽヤ別ニ」「血壓ヲ測ラシテ戴キマショウ」否応ナシニ書斎ノソファニ寝カサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ不思議デゴザイマスネ、無理ニ力ンデ堅イオ通ジデモナサイマシタカ」「イヽヤ」「何カアッタンジャゴザイマセンカ、ドウモ不思議デゴザイマスネ」佐々木ハ頻リニ首ヲ傾ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜ハオ寒ウゴザイマスカラ明日ニナサイマシタラ」佐々木ガ驚イテ制シヨウトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
