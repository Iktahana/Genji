        "examples": {
          "standard": [
            {
              "text": "真言宗では、身・口・意の３密を整えることで仏との一体化を目指す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "阿字観の瞑想を通じて、自己の３密を宇宙の生命へと融合させていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "護摩祈祷の最中、導師は３密の加持を行い、人々の願いを仏に届ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
