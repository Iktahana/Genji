[
  {
    "uuid": "5ce8f3c3-3345-5dac-a921-4d8eb43e8c3c",
    "entry": "猿麻桛",
    "reading": {
      "primary": "サルオガセ",
      "alternatives": [
        "さるおがせ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "old man's beard (any lichen of genus Usnea)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "森の中には、木々にサルオガセがぶら下がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "サルオガセは、その名の通り老人の髭のように見えるコケの一種だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "清流のそばの木々には、美しいサルオガセが群生している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "サルオガセの垂れる針葉樹の間からも、同じように起る。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "根曲り竹も、楊の根も、樅の肌も、はた長くしな垂れるサルオガセも、その柔嫩の手に、一旦は、撫でられぬものはない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝には紗をかぶったように苔が垂れ下り、サルオガセが灰色のかたまりとなってし噛みついていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルオガセがぶら下ったり、山葡萄が絡んだり、其自身針葉樹林の小模型とも見らるゝ、緑、褐、紫、黄、さま／″＼の蘚苔をふわりと纏うて居るのもある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頂上附近にはサルオガセをつけた栂や五葉松が多い。",
              "citation": {
                "source": "奥秩父",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くには半ば葉の堕ちた巨木の枝が参差として「サルオガセ」が頼りなげにかかっている。",
              "citation": {
                "source": "白峰の麓",
                "author": "大下藤次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルオガセ　地衣類植物（Lichenes）に昔からサルオガセと呼ぶものがあって、書物に出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちそれはサルオガセ科（Usneaceae）の Usnea plicata Hoffm. var. annulata Muell. である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このサルオガセは山地の樹木に着いて生じ、長さは六五センチメートルばかり（二尺一寸五分ばかり）に出入りして無数に分枝し、ふさふさとして垂れ下っており、帯黄白色で直径は太いところで二ミリメートルばかりもあり、その外面が短かい管のような環になってひび割れがしているのが特徴である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふるくからサルオガセと呼んでいた地衣は主としてこの品を指し、それはこの属中で第一等長大な形状をしていて著しいから、人々の目につきやすい。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルオガセは猿麻は績んだ麻を纏い掛けて繰る器械であるが、このサルオガセの場合は麻糸の意として用いたものだ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに我国近代の学者は Usnea longissima Ach. をもってサルオガセと呼んでいるのは、昔からのことを考え合わすとじつは不徹底である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんこれもサルオガセの一種（私はこれをナガサルオガセと呼んでいる）には相違ないが、しかし昔から書物に出ているサルオガセそのものではない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの人々は日本で前からサルオガセといっている品を正当に掴むことが出来ないでいるのは残念である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルオガセを Usnea plicata Hoffm. var. annulata Muell. とした初めは私で、私は、これを大正三年（1914）十二月に東京帝室博物館で発行した『東京帝室博物館天産課日本植物｜乾※標本目録』で公にしておいた。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サルオガセの名はこれを松蘿、一名女蘿として源順の『倭名類聚鈔』に出ており、和名をマツノコケともしてある［サルオガセは松蘿でもなければ女蘿でもない、マツノコケは古く深江輔仁の『本草和名』に末都乃古介と出て、これは松蘿を元として製した名であるからこれもサルオガセにはあたっていない。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "小野蘭山の『本草綱目啓蒙』にはサルオガセの一名をサルノオガセ、ヤマウバノオクズ、ヤマウバノオガセ、サルガセ、キリサルガセ、クモノハナ、キヒゲ、ハナゴケ、キツネノモトユイとしてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この蘭山の文でみても、サルオガセは上に述べた品であることが自から明かである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩崎灌園の『本草図譜』にサルオガセの図が出ているが、その品は明かに Usnea plicata Hoffm. var. annulata Muell. である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひねもす、日はただサルオガセのまといついた一本のエゾ松が立っている荒れた沼地の表面を照らし、小さな鷹が頭上を舞い、シジュウカラが常磐木の葉がくれにさえずり、シャコと兎がその下にこそこそやっている。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の上の唐檜に、恐ろしく長いサルオガセがぶら下っている。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "巒気か、冷気か、雲が迅いか、日がかげるか、自動車の捲き起す疾風か、私たちの胴ぶるいこそは繁くなると、　ああ、古蒼なさるおがせが椴松の高い枝にかかっている。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その枝々のあのさるおがせ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、黒椴、　さるおがせ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "透視台に立つ神官の骨もあらわにやせた肉体は絶壁に危うくかかる老松を思わせたが、梢にさがるさるおがせにも似た、白ひげに飲みこぼしたバリウムがべっとりついているのもわびしかった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さるおがせって言うだと。",
              "citation": {
                "source": "帰途",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さるおがせですね。",
              "citation": {
                "source": "帰途",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さるおがせって言うのだそうです。",
              "citation": {
                "source": "帰途",
                "author": "水野葉舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "また小松や小灌木の枝には「さるおがせ」がひげをたれているところを見ると、この渓谷の如何に霧深いかを想像させる。",
              "citation": {
                "source": "雲仙岳",
                "author": "菊池幽芳",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるおがせのような油煙がついている。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
