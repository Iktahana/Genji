          "literary": [
            {
              "text": "婆サンカラアンナ注意ヲ受ケタタメニ、却テ神経質ニナッテ、気ニシテイタセイデモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事ノ世話、入浴ノ世話、ブラッシングノ世話ナド手ガカヽルコト夥シイノデ、婆サンカラ女中達マデ不平ガ絶エナカッタガ、何ト云ッテモ浄吉ガ実行サセタコトハ当時ノ日記ニ記シテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンガ行ッテシマッテカラ一人デ静カニ考エテ見ルト、アンナニ怒ラナイデモヨカッタ、颯子ガ婆サンカラ聞イテドンナ風ニ取ッタカト、シキリニ気ニナッテ仕様ガナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「佐々木サンカラ伺イマシタガ、大丈夫デスカオ爺チャン、オ痛イコトハオ痛イデショウガ、ソンナコトヲナサラナイデモ今ニキット直リマスヨ」婆サンハ気ガ気デナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ思ウッテ、ドウイウガアルノカ」「ママハシヤハリマセン、木村サンカラ聞イタノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
