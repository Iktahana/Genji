        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はいつも人の話に差し出てきて、自分の意見を主張する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そんなに差し出るものではない、と先輩に注意された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の親切心は分かるが、少し差し出すぎではないか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」「牝鶏のあしたすると言うて、牝鶏が差し出るからよ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に殺されたというわけでも無し、自分で首を縊ったのでございますから、検視のお役人方も別にむずかしい御詮議もなさいませんでした」「御検視が無事に済めば結構、わたし達が差し出るにゃあ及びませんが、ともかくもお悔みながらお店まで参りましょう。",
              "citation": {
                "source": "半七捕物帳",
                "author": "正雪の絵馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら蛙が可哀そうだといって、自分も弱い女の癖に、うっかり差し出るからこんなことになるのだ。",
              "citation": {
                "source": "蟹満寺縁起",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "差し出るようですが、私は少し位は持っています。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "谷中時代の弟子のこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "京の女はこまかいそろばんをはじくというが、あんな女房を持っているとは、おうらやましいことだ」　詰りきった下士の台所を切りまわすには、亭主の内証を知っているほうが便利だろうが、まだ祝言もすまない長屋の青女房が、勘定割場まで差し出るのは、少々、念が入りすぎている。",
              "citation": {
                "source": "奥の海",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "人生の端っこをのぞいたばかりなのに、なにもかも知りぬいているみたいに、いい気になって差し出るのは、やめたほうがよろしかろう。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかし、なにか事情のあることか知れないし、自分が差し出るような性質のことではないので、そのことには触れなかった。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」院長も差し出る力はなかった、大司教が言われたことであるから。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大会からさしでる希望の光、激励と協力の光がアジアのすべての婦人に幸福への道をてらし、何をどのようにたたかうべきかについてゆるぎない方向を示すことを信じてうたがいません。",
              "citation": {
                "source": "新しいアジアのために",
                "author": "――アジア婦人大会によせて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "暁の光のさし出る前に、夜というものはその暗さを、ひときわ強めるものであるが、その時刻が今であった。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わたしたちがさし出る場合でもないし――」「……それでもこのごろは、わたくしもいくらか心が落付いて参りましたの。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑木林の楢に絡む自然薯の蔓の葉が黄になり、藪からさし出る白膠木が眼ざむる様な赤になって、お納戸色の小さなコップを幾箇も列ねて竜胆が咲く。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つには自分にも出来もしない癖に差出るまでもないと思うからである。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月雨で田圃が白くなり、雲霧で遠望が煙にぼかさるゝ頃は、田圃の北から南へ出る岬と、南から北へと差出る※とが、宛ながら入江を囲む崎の如く末は海かと疑われる。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は時と妥協しなかったので、時は彼の道に差出ることをはばかり、彼を屈服することができないのでただ遠方でため息しているだけであった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "三成など青二才の差出る幕ではないのに、この人を差しおいて三成だ秀家だと手間のかゝつたこと、これぐらゐの道理がお分りにならぬか、といふ鼻息であつた。",
              "citation": {
                "source": "二流の人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お淺は三十六の美しくも何んとも無い平凡な女ですが、確り者らしさや、小意地の惡さは相當で、主人の妹の配偶で、何彼と差出る與三郎に對して、あまり良い感じを持つて居ないことは事實かも知れません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "隱れん坊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なぜいけないのですか、矢竹つくりだけなら屋敷へさがってもできると思いますが」「どうあろうと、そのほうなどの差出るところではない。",
              "citation": {
                "source": "城を守る者",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家臣の差出るところではない」「いや、あなた様に危害を加えるのではありませぬ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
