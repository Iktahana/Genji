        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "九　銀子はちょうどつまらなそうに独りでサロンにいて、グラフを読んでいたが、サアビス掛りのボオイが取り次ぎ、均平が入って行った。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "松次は看板借りであり、鳥屋で昼間からの玉数も記入された伝票をもらうと、舟遊びはサアビスに附き合ったのだったが、さっそく分松の家で衣裳を着かえ、松の家の前にならんで棺の来るのを待っていたのだった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は今絶望のどん底にあるものらしかったが、客にサアビスする隙々に、詩作に耽るのであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷を一つ二つサアビスして廻ると、きまって酔っていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "この商売にしては一風かわったマダム小夜子のサアビスぶりに、集まって来るのはことごとく文学者、画家、記者といったようなインテリ階級の人たちばかりであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "小夜子の家では、いつもと違って、サアビスぶりはあまりよくなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "小夜子はあまりお馴染でもない座敷だと、少しサアビスをしてから、息ぬきに銀座辺へタキシイを飛ばすこともまれではなかった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱロサアビスとやらでございませんと。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君はサアビスがうまい。",
              "citation": {
                "source": "二つの失敗",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼食を、所長さんの御招待で頂き、サアビスに踊ってくれたのが、当時のスタア、ロジタ・モレノ嬢でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんながらッ八のサアビスじゃあお気に入りますまいけれど……。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、がら金に恥を掻かせないで、愉快にサアビスをさせて頂戴よ。",
              "citation": {
                "source": "影",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
