        "examples": {
          "standard": [
            {
              "text": "鏡像は、すべてが左右逆になっているように見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "鏡に映った文字は左右逆になってしまうので、読みにくい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このポスターを左右逆にしてみたら、デザインがより調和した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが、上下逆さまにならない代りに、今度は左右逆さまになることを彼は気がつかなかった。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、谷川岳の道標を書かせると、上下が逆さまだというのに気がついて、頭だけ逆さまにならないようにそろえるまでは気がついても、今度は左右逆の方向から書かないとアベコベの方向を指してしまうということまでは気がつかないような脆さがある。",
              "citation": {
                "source": "我が人生観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
