[
  {
    "uuid": "26e30c91-0942-563b-98b4-0e4d0d9f1989",
    "entry": "サバサバ",
    "reading": {
      "primary": "サバサバ",
      "alternatives": [
        "さばさば"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "副詞-と",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "relieved",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "試験が終わって、やっと肩の荷が下りてサバサバした気分になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、長年の悩みが解決して、とてもサバサバした表情をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "心配していたことが杞憂に終わって、サバサバとした気持ちで一日を過ごせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "それにしても、今日の温泉旅館に宿泊する人たちは思い切ってサバサバしたものである。",
              "citation": {
                "source": "温泉雑記",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろサバサバしている。",
              "citation": {
                "source": "東京文壇に与う",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の私の態度と来たら、まるではたの人がはらはらしたくらい、不機嫌そのものであったから、もう私は嫌われたも同然だと、むしろサバサバする気持だったが、暫らくして来た返事は不思議にも気に入ったとのことで、すっかり驚いた。",
              "citation": {
                "source": "天衣無縫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "黙殺してしまうと、サバサバした。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは送り狼になりたくたい」　そう思ったので、小沢はもうサバサバした声で言った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、何かサバサバした気持だった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊都子のように問題がサバサバとあっけなく過ぎて行きそうには思えなかったのだ。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "散髪屋も畳屋も同じ手職稼業でたいした違いはないようなものの、おたかにしてみれば口惜しいほど格式が落ちたと思われ、だから断るにもサバサバした気持だった。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "散髪屋も畳屋も同じ手職稼業でたいした違いはないようなものの、おたかにしてみれば、口惜しいほど格式が落ちたと思われ、だから断るにもサバサバした気持だった。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "どえらい目に会わすぜ」　それきりオトラは顔を見せず、他吉はサバサバした。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　娘の手に渡して、やっぱりただの夜の花だったのか――と、且つはがっかりし、且つはサバサバして、あとも見ずに清閑荘の玄関へはいって行った。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴子に見捨てられた銀造は満州へ走り、その後消息は絶えたので、サバサバしていると、終戦になりひょっくり内地へ引揚げて来た。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "麻雀にはダンス以上に自信はあったし、それで儲けた金を旅費にしようとセントルイスを出た途端思いついてみると、何かサバサバと気持がよかった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "悩んでいるかと思うと、あんなヒロポンマニアとは別れた方がましだと、サバサバしたり、不義の子を孕んだといって泣いたり、あんたの子うむのうれしいわとやに下ったり、ああ、おろしてしまいたい。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "色男を気取らず、見栄も張らず、けちで通った五十男らしいいやがらせを言っているのが、むしろサバサバしたたのしみであり、一杯十円の珈琲の高さが安くなるこの享楽にまさる享楽がほかにあろうか。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、かえってサバサバした気持で大阪駅から中之島公園まで歩きました。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼の敵愾心は人々を最初から敵と決めていたから、憎まれてかえってサバサバと落着いた。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはは……」　赤井はサバサバとした笑いを、久し振りに笑った。",
              "citation": {
                "source": "昨日・今日・明日",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "刀の手入を済ましてから宿の湯に這入ってサバサバとなった平馬は、浴衣がけのまま二階に上ろうとすると、待ち構えていたらしい宿の女中が、横合いから出て来て小腰を屈めた。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、冗談めかしく、サバサバ云ってのけて、準之助氏は、新子に姉についての詫言など、云わせまいとする。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だか、くすぐったいような、妙にサバサバしたような、安心したような気持になっちまって、でも活動は一時間ぐらいしか見なかったのよ。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼の敵愾心は最初から彼等を敵と決めていたから、憎まれてかえってサバサバと落ち着いた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、いま豹一がそんな可愛げのない表情を見せてくれることは、彼女にとっては、むしろサバサバするようなものであった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそ嫌いだと言われた方がサバサバするのだった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サバサバしちゃったとこで、それから海だ！",
              "citation": {
                "source": "意欲の窒息",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまで、経歴不明の神秘性がある――とかなんとか云われるのは心外であったが、この機に残らずぶちまけてサバサバとしてしまいたい。",
              "citation": {
                "source": "一週一夜物語",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へん、間抜けな泥棒め、盗むものに事をかき、あんなつまらねえ物を盗みやがった」　それで、却ってサバサバして、江戸をさして引返して行った。",
              "citation": {
                "source": "大捕物仙人壺",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心配しないでちょうだいね」　変にサバサバしているのです。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、どうも、無理にしているようなところがミジンもなくて、明るくホガラカにサバサバしているのですから、手がつけられない気分にさせられてしまうのです。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "frank",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は思ったことを何でもサバサバと言うので、時に誤解されることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼のサバサバした性格は、裏表がなく付き合いやすいと評判だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「大丈夫だよ」と、先生はサバサバと生徒に答えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
    ],
