          "literary": [
            {
              "text": "エルサレムと世界の最後。",
              "citation": {
                "source": "聖書の読方",
                "author": "来世を背景として読むべし",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああエルサレム、エルサレム、予言者たちを殺し、遣されたる人々を石にて撃つ者よ、牝鶏のその雛を翼の下に集むるごとく、我なんじの子どもを集めんと為しこと幾度ぞや」という所まで読んで、思わず声を挙げて泣いたあの夜を、忘れたか。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "怒った時には、縄切を振りまわしてエルサレムの宮の商人たちを打擲したほどの人である。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧士ナドニ反抗サレルヤウデハ奉行ノ威徳ガナイノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ホンジツヲモツテキンユシユツハカイキンサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『センダガヤノシヨウジヨゴロシノハンニンケンキヨサレマシタ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "所詮ハ筏ノ上ノ組ンヅホツレツデアル、ヨロメキ、ヨロメキ、君モ、私モ、ソレカラ、マタ、林氏、寝ル間モ烈シク一様ニ押シ流サレテ居ルヨウダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "林房雄トイウ名ノ一陣涼風ニソソノカサレ、浮カレテナセル業ニスギズ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあくる日、私たちは愈愈あこがれのエルサレムに向い、出発いたしました。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "待ちに待った過越の祭、エルサレム宮に乗り込む、これが、あのダビデの御子の姿であったのか。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああエルサレム、エルサレム、予言者たちを殺し、遣されたる人々を石にて撃つ者よ、牝鶏のその雛を翼の下に集むるごとく、我なんじの子らを集めんと為しこと幾度ぞや、然れど、汝らは好まざりき」馬鹿なことです。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "努メテ厳粛ナル五十枚ヲ完成サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、居留民ノ生命財産ノ保護、国旗ノ尊厳トイウガ如キ言葉ニ迷ワサレテハナラヌ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思えば自分はそのエルサレムへ急ぐ巡礼だった。",
              "citation": {
                "source": "小さき良心",
                "author": "断片",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼信紙をとつて、彼は先づ、「シケイヲセンコクサレタ」と書いた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ所以ハ」「サレバ、友ヲ選ベバ悪人、交レバ阿諛追従ノ徒ニ若クハナシトハ、下界人間共ノ以テ金言ト成ス所ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ朝ニ猿ヲ友トセリ」「昼ニ書ヲ読ミシハ？",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サレバ、書ハ読ミタル者ヲ聰明ニ成ストハ限ラザルモ、読マザル者ハ必ズ阿呆ニナラン」「夕ニ武道ノ稽古ヲ成ス所以ハ」「サレバ、今ヤ天下麻ノ如ク紊レ、武ヲ知ラザレバ皆目知ラザルニ等シキ世ナリ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "土人の売りに来たものは絵はがき、首飾り、エジプト模様の織物、ジェルサレムの花を押したアルバム、橄欖樹で作った紙切りナイフなど。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スエズで買ったそろいのトルコ帽をかぶったジェルサレム行きの一行十人ばかり、シェンケの側の甲板で卓を囲んで、あす上陸する前祝いででもあるかビールを飲みながら歌ったり踊ったりしていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "神戸からずっといっしょであった米国の老嬢二人も、コンチャーの家族も、いよいよここで下船して、ジェルサレムへ、エジプトへ、思い思いに別れて行くのであった。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもその頃は、芭蕉の流れを汲むものが、奥の細道を辿るのは、エルサレムの宮殿、近代の学者たちの洋行で、奥州めぐりを済まさないと、一人前の宗匠とは言われない。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがそんなことをほざく奴には、ＴＭＮだとか B'z だとかいった連中の、人の息遣いの欠如したブザー早押しクサレ音楽を、反吐を吐くまで聞かせてやるからな。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが觀るところの演劇は、緑肥えたる葡萄圃、行人｜絡繹たるサレルノ街道、其背後の暗碧なる山脈等を道具立書割として、自ら悲壯劇の舞群となれるポムペイ市の死の天使の威を歌へるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
