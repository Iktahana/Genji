        "examples": {
          "standard": [
            {
              "text": "財布の中には、数枚の札片（さつびら）しかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼は、その場しのぎで持っていた札片をすべて使ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「昨夜、飲みすぎたせいで、持っていた札片を全部使い果たしたよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "貧乏な旅行者の私達は卻つて文字通りに哈爾賓の街で札片を撒いて歩いたのである。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
