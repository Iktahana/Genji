        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サウシテ私ヲオ父様ノ所ヘ返サナイト『アグニ』ノ神ガオ婆サンノ命ヲトルト言ツテヤリマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテ陽がしずかに照っておりました。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音は長くつづき、夜明けまできこえ、サウシテひどいスコールが来ました。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "村上さんのほうはいそがしくて、一日中主計科や庶務科や電話室にいて、夜おそく隊から疲れて帰って来ると、すこしばかり物を食べ、サウシテたくさんコッピーを飲みました。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテどこまでも岸について帆で走り、強い風が吹きだすと、舟を岸にあげて、何日でも休みます。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテ背中においている寄生虫や、えぼし貝をとるために、船の底に背中をこすりつけてくるので、刳舟などはいっぺんにひっくりかえされてしまうのであります。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか変ったこと、サウシテそれが村上さんの気持をまぎらすものであれば、どんな辛いことでもよいと、そんなことまでねがうようになりました。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテその上に、何千羽とも知れない鴎の群が、飛び降りまた空へ飛びあがって騒ぐので、空の太陽も暗くなり、その声で耳がツンボになりそうでした。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウシテ前へかがんで血を吐きました。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノコトワ、本ヲヒロウタ人ニキイテ下サイ、サウシテワタシヲ此所カラダシテ下サイ、アナタワ、キレイデ、カシコイ人デスカラ、キツト助ケテ下サイマス。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
