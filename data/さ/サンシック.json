        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "じいさんは、四ツばかりでもうそれ以上食えなかった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上食欲は不断よりも進んだ。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそも、学問を飯の種にするということは、本来誤った考えでありますけれど、学者だとて人間である以上食わずに生きて居ることは出来ません。",
              "citation": {
                "source": "新案探偵法",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "大概フスマや糠ですから三合以上食べます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食べないと言つたつて、入れたものがない以上食べない筈はない。",
              "citation": {
                "source": "歯と眼の悪いおぢいさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先生、生卵はいかゞです」と三藏が言ふと、「鷄卵でやすか鷄卵も一つはよございますが、二つ以上食ふと不消化でやすな。",
              "citation": {
                "source": "俳諧師",
                "author": "高濱虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、食器を使う業者の無関心ということが、今日、料理上食器の不振を来たし、よい食器皆無の因をなしているのであります。",
              "citation": {
                "source": "食器は料理のきもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十一願、飢渇の衆生に上食を得しむるの願。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○此地の人、上食は粟に稗小豆をも交て喰ふ。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜜柑を今日は十以上食べた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "機上食と、鹿児島でうどんを少量。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
