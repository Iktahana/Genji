[
  {
    "uuid": "b1c85721-1083-5bd6-a261-61f2154ef9c0",
    "entry": "才蔵",
    "reading": {
      "primary": "さいぞう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
