    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我々は「サケ」と「シャケ」が間違ったら飛んでもない間違いを起しますが、アイヌ人は「サケ」も「シャケ」も音としては同じことなんです。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サケノミゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふもサケナシデーだつた、いやナツシングデーだつた、時々、ちよいと一杯やりたいなあと思つた、私は凡夫、しかも下下の下だ、胸中未穏在、それは仕方がない、酒になれ、酒になれ通身アルコールとなりきれば、それはそれでまたよろしいのだが、そこまでは達しえない、咄、撞酒糟漢め。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがの私も今日ばかりは、サケのサの字も嫌だ、天罰てきめん、酒毒おそるべし／＼、でも、雪見酒はうまかつた／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "村のデパートで、サケ一杯とタバコ一袋とを借りた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "サケとスシとを与へられた、ありがたや。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "八幡は労働都市だけあつて、たべもの店が多くて安い、そこで私もサケとビールとシヨウチユウとのカクテルを飲んだ。",
              "citation": {
                "source": "行乞記",
                "author": "北九州行乞",
                "note": "青空文庫"
              }
            },
            {
              "text": "イリコ五十目十五銭、ミヨウガ三十ばかり二銭、サケ三合二十四銭が今日の途中の買物だつた。",
              "citation": {
                "source": "行乞記",
                "author": "山口",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の所得（銭七十九銭、米二升一合）今日の買物　一、五銭　キセル　　　　　　一、三銭　シヤモジ　　　　　　一、四銭　ハシ　　　　　　一、弐十四銭　サケ　八月十三日からりと晴れてゐる、身心もさつぱりしてゐる、今日は昨日の分まで行乞しなければならない。",
              "citation": {
                "source": "行乞記",
                "author": "仙崎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……また一杯、サケ一杯では酒屋の前を素通りした位にしか感じないから、シヨウチユウにした、――破戒の破戒だ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……樹明来、サケとトウフとカルモチンとザツシとを持つて。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一日ぶりのアルコール、いやサケはとてもうまかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "暮れてから、樹明君が学校の仕事を持つて来庵、投げ出された五十銭銀貨二枚を持つて、私は街へ出かけて買物――サケ（これはマイナスで）、トウフ、マツタケ、サカナ、シンギク、バンチヤ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日でサケナシデーが三日つゞく、飲みたいのをぐつと抑へて、――つらいね！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後はそゞろあるき、ポストを口実にしてＭ店まで出かけて一杯二杯、ほんにサケノミはいやしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコールを飲まないでサケを飲め。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後、敬君来訪、サケサカナ例の如く、こゝろよく酔ふ、同道して山口の或る人を訪ねる、おとなしく用をすませて戻る、めでたし／＼／＼。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼう／＼たり、サケはナミダかアブラかチかアセか。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方またポストへ、ついでに藤君を訪ねる、にぎやかな、あたゝかな家庭かな、御馳走になる、サケ、サカナ、タバコ、……ほろ／＼気分で帰つてすぐ寝た、句も夢もない一夜であつた、人のなさけのありがたさよ。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オオ　マブシイ」ト　ドノ　ツボミモ　ハジメハ　サケビマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ」ト　ヲンナノ　コガ　サケビマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "チドレヤガレラで鶏をトコ、アルチャゴおよびトボでトフィ（ワリス同前）、ファテ等でト、セサケ等でトア、エロマンガでツオ、ネンゴネでチテエと名づくるなど攷え合すと、本邦のトトは雄鶏の雌を呼ぶ声に由ったものらしい、魚をトトというは異源らしい。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ソノ……サケハ……オレノ……キモノ……テツケジャ……。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンハ急ニ、キャットサケンデ、ハネオキルト、ソトヘトビ出シタ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今から浅黄の帯揚なぞが〆められるもんですか」とお雪はナサケないという眼付をした。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に、ナサケないじゃ有りませんか……男というものは可恐しいものですネ……私が旦那の御酒に対手でもして、歌の一つも歌うような女だったら好いのかも知れないけれど――三吉さん、時々私はそんな風に思うことも有りますよ」　苦笑したお種の頬には、涙が流れて来た。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、私もネ、寧そその児を引取って自分の子にして育てようかしら、と思ったり、ある時は又、みすみす私が傍に附いていながら、そんな女に子供まで出来たと言われては、世間へ恥かしい、いかに言ってもナサケないことだ、と考えたりしたんです。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
