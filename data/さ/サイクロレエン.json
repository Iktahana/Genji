          "literary": [
            {
              "text": "ベニスに着いてから、竜の口が出入り道になっているサイクロレエンに乗りました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "降りたった六人は、今更のように聳えたつサイクロレエンを眺めて、感にたえた顔をしていましたが、有沢さんの悲鳴を誰かが言いだすと、途端に、みんなゲラゲラと大笑いがとまりませんでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはサイクロレエンから降りたった後、なにもかもが飛び去ったあとのような心地よさで独り、岸にたち、潮風に、髪の毛をなぶらせながら、青黒くひかる海を、虚心に、眺めていました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
