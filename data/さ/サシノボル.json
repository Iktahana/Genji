[
  {
    "uuid": "bdc57d74-2ff3-5474-92c3-d8ac5d78ace6",
    "entry": "差し上る",
    "reading": {
      "primary": "さしのぼる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
