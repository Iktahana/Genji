    "definitions": [
      {
        "index": 1,
        "gloss": "to rise (e.g. sun, moon)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "東の空から、まもなく朝日が差し上るだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "満月が山の端からゆっくりと差し上る様子は幻想的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "夏の太陽がぎらぎらと差し上り、気温はぐんぐん上昇した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "海を越えたる百萬の大御軍の雄叫びは旗雲高くさしのぼる日にこそ勇めまのあたり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹹涸川堰の下の葦むらに行々子鳴きて鳰はお堀に水路舟行二十日、再び沖端に帰りて、人々と共に楽しむと柳河まで小舟に棹さしのぼる。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてさしのぼるに東のかたに山のよこをれるを見て人に問へば「八幡の宮」といふ。",
              "citation": {
                "source": "土佐日記",
                "author": "紀貫之",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間生活への思意が複雑明瞭になって来る度につれて、さながらしずかにさしのぼる月の運行に準じてあたりの山野が美しい光に溢れて来るように、人間の美しい精神の輝きとしての責任の感情もひろく、深く、大きいものとなってゆくのである。",
              "citation": {
                "source": "女の歴史",
                "author": "――そこにある判断と責任の姿――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しずしずとさしのぼる旭は、霊峰富士の頂に、金色の光を放っているではないか。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　風おちぬ　しづもる屋根に白白と　雪おもしろく月さしのぼる。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "青山という名のいわれは、夏山の峰の緑の木の間から、有明の月のさしのぼるすがたをいう。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第七巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さしのぼる明るさや響や波動が内部に感じられるようでしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に挙げた淀川両岸の絵本に出ている橋本の図を見ると月が男山のうしろの空にかかっていてをとこやま峰さしのぼる月かげにあらはれわたるよどの川舟という景樹の歌と、新月やいつをむかしの男山という其角の句とが添えてある。",
              "citation": {
                "source": "蘆刈",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "めざすは八塩の温泉を越えて秩父路へ、そして江戸へ、日輪のさしのぼる東へ、東へ。",
              "citation": {
                "source": "夜明けの辻",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の出る朝には、岡崎の草庵を二人の輦が出た、夕月のさしのぼる黄昏れには、二人の輦が、吉水から帰った。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな月のさしのぼるのを見ながら、「親不孝ばかりした」　驕慢児の眼にも、真実の涙が光った。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "綸言豈疑義あらんやと人はみな耀く目を以て答え、血のさしのぼる面をもって決意をあらわしていた。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ久しぶりな身心地」　と、彼は浴後のからだを、縁の柱にもたせて、折ふしさしのぼる夏の夜の新月がこぼすソヨ風にしばし虚心を吹かせていた。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに陽がさしのぼる。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "南北の流れにては月の出づるところ東岸に迫られて妙ならねど、東西の流れにては月は直に河水の水面よりさし昇るところなれば、見渡す眺めも広※として、浪に砕くる清き光の白銀を流すが如くいと長く曳きてきら／＼と輝くなど、いふにいはれぬ趣きあり。",
              "citation": {
                "source": "水の東京",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌中の紋理の『て』の字が見え初むる時より、寸々に明るく分々に明るくなつて、拇指の腸處の細紋が見え、指の木賊條の縱の纎いのが見え、漸く指頭の渦卷や流れ紋の見ゆるに至るまで、次第次第に夜が明け放るゝに及び、やがて日がさし昇るに及ぶ、其の間に天地の氣が人の氣に及ぼすもの無しとは誰か言ひ得よう。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "掌の紋理の「て」の字が見え初める時から寸々に明るく分々に明るくなって、拇指の膨らみの細紋が見え、指の木賊条の縦の繊いのが見え、次第に指頭の渦巻や流れ紋の見えるまで次第々々に夜が明け放たれて、やがて日がさし昇る。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "空いと澄みて、一むらの雲なく、夕つ方より東のかたを打ながめてあれば、しばしして山ぎは少しあかり、次第に光しげく、今少しすれば、大きやかなる、少しく赤みかゝりたる月さし昇る。",
              "citation": {
                "source": "月",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "野末なる三島の町の揚花火月夜の空に散りて消ゆなりうるほふとおもへる衣の裾かけてほこりはあがる月夜の路に天の川さやけく澄みぬ小夜更けてさし昇る月の影は見えつつ路ばたの木槿は馬に喰はれけり　（芭蕉）　この句は私の大好きな句である。",
              "citation": {
                "source": "樹木とその葉",
                "author": "秋風の音",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は窓を下すと、顔を外に突き出して、さし昇る太陽を眺めた。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は悦びにうっとりしながら、さし昇る朝日を受けて金色に輝いている窓枠を眺めたり、往来に始まっている人や車の動きに耳を傾けたりした。",
              "citation": {
                "source": "接吻",
                "author": "ПОЦЕЛУЙ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてさし昇る月を仰いで独り哭いた。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、その前には、やがて播磨灘の闇をひらいて、大きくさし昇る太陽の祝福が燦としてあった。",
              "citation": {
                "source": "茶漬三略",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは、いつも暮になると安宅先生は校長先生の家の正月のために鴨や野鳥を撃って差上る習慣を思い出しました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでお電話を差上るので御座いますが……その若様の御身の上について大切な御報告を申上げたい事が御座いますので……ハイハイ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中でこの帽子をドウ仕末しようかと考えましたが、結局アナタ（お祖父様）に差上るよりほかに道がないと気が付きました。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタに差上るのならばドンナに身分不相応なものでも恥かしくないことが、わかると同時に、日本の国体のありがたさがイヨイヨハッキリと心に映じました。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "御通告申上ましたように、詳細は後日決算報告を御手元へ伝記と共に、差上る事になっておりますので、ここでは荒方工事の報告を致します。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "月給なども出来るだけは致しまするが、然しこの月給などといふものはどのみちほんの些細なもので、これは霊感の大小によりまして、その都度配当を差上ることに致さうと斯様考へてをります。",
              "citation": {
                "source": "盗まれた手紙の話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
