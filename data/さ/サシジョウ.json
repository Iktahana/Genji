        "examples": {
          "standard": [
            {
              "text": "古びた木の扉には、錆びた鉄製の挿錠がしっかりと取り付けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "泥棒が侵入できないよう、ドアに二重の挿錠を施した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "鍵を回すと、挿錠がゆっくりと動く音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その瞬間、誰かが扉の挿錠をがちゃがちゃさせた。",
              "citation": {
                "source": "ウィリアム・ウィルスン",
                "author": "WILLIAM WILSON",
                "note": "青空文庫"
              }
            }
