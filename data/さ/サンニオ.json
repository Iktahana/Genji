          "literary": [
            {
              "text": "「オホキナ　コヱデナニヲ　ネゴトヲイッテルノ」トオカアサンニオコサレテ、ハジメテ　ユメダッタ　トワカリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ婆サンニオ覚エノ悪イノハ、コンナ場合、婆サンヲ無視シテ予ノ気持ヲ迎エヨウトスルカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャンノオ世話ハ、オ婆チャント佐々木サンニオ願イスレバイヽジャナイノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ハ奧サンニオ渡シシタ　芥川夫人は鵠沼に置いてあつた荷の中から差當つて必要な品物、子供の着物かなにか、それを取りに田端から一寸見えた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
