        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "この幼年の長次こそ、誰あらう今尚宮城前に威風颯爽たる馬上の勇姿を止める彼の楠公の銅像を鋳造した岡崎雪声氏ではあつた。",
              "citation": {
                "source": "名工出世譚",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は十六になったので、いずれ追われるに相違ないと内々心で覚悟しながら尚宮中にとどまっていた。",
              "citation": {
                "source": "喇嘛の行衛",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
