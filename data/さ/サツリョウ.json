        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "映画のロケーションでは、撮了の報告があると、スタッフから歓声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "製作総指揮は撮了を祝うため、キャストとスタッフ全員で夜明けまで祝杯を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "撮了から編集作業が始まるまで、通常は数週間の準備期間がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "「映画には撮了という日があるのよ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "撮了の日をきめておくと、その日に向けて気持ちが集中すると思うのよ」　言うことがいちいち正しい、と原田は思った。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
