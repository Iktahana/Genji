        "examples": {
          "standard": [
            {
              "text": "印刷工房では、一日の作業の最後に刷了の記録をつける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この本の刷了は夜中の二時に完了し、翌朝に出荷の準備が始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "版画家は刷了してから、すべての作品に署名と日付を記入する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
