    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "舌のない客と鑑別ければ左室の通称「｜悪い側」の方へ入れる。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後、昨年夏、再び心臓障害と高血圧に苦しみ、十二月、電気写真によって心臓の肥大と左室機能障害、尿中に多量の蛋白が発見され、絶対安静をいいわたされました。",
              "citation": {
                "source": "文学について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二月三十日（木）　左室刺戟反応障害、心臓キノー不全、蛋白が出ている由。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "山口はわたしの左室、大杉は右室に入れられました。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
