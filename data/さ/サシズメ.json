        "examples": {
          "standard": [
            {
              "text": "差し詰め、今日のところはこれで終わりにしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行の準備はまだ完璧ではないが、差し詰め、必要なものは揃った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "差し詰め、現状維持が一番賢明な選択だろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
