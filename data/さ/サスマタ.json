[
  {
    "uuid": "953d6e87-55f5-5d5f-99e5-8e4b8597d865",
    "entry": "刺股",
    "reading": {
      "primary": "さすまた",
      "alternatives": [
        "サスマタ"
      ],
      "is_heteronym": false
    },
    "grammar": {
