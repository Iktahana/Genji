    "definitions": [
      {
        "index": 1,
        "gloss": "sasumata",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "不審者が学校に侵入した際、先生は刺股を持って対応した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "江戸時代の番人は、刺股を使って犯罪者を取り押さえたそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最近の防犯訓練では、刺股の使い方も指導される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "殊にお掛屋の株を買って多年の心願の一端が協ってからは木剣、刺股、袖搦を玄関に飾って威儀堂々と構えて軒並の町家を下目に見ていた。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればこそ支那一流の刺股行孝といふ風習は、唐以後に限つて、隋以前に見當らぬのである。",
              "citation": {
                "source": "支那人間に於ける食人肉の風習",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "首には、流木の刺股をくくりつけられ、頭はまた妙な格好で、高く天竺玉に結び上げられている。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その式台を上った所に、突棒や、袖搦や刺股や、また古ぼけた馬上提灯などが、並んで懸けてあった昔なら、私でもまだ覚えている。",
              "citation": {
                "source": "硝子戸の中",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "成親の最後の様子はいろいろ伝えられていて、始め毒殺を計ったが失敗し、遂に二丈のがけの上から突き落し、下に刺股（刃物に柄をつけたもの）をたててこれで体を貫いて死んだといわれる。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第二巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――かける足もとを、からみたおす刺股、逃げるをひきたおす袖がらみ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　奥庭までは白壁門、多門、二ヵ｜所の難関がまだあって、そこへかかった時分には、いかに熟睡していた侍や小者たちも眼をさまし、警鼓警板をたたき立て、十手、刺股、槍、陣太刀、半弓、袖搦み、鉢ワリ、鉄棒、六｜尺棒、ありとあらゆる得物をとって、一時に、ワーッと侵入者のゆく手を食いとめにかかった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで潘璋の部下の馬忠というものが、熊手を伸べ、刺股を懸けて、遂に関羽を捻じ圧え、むらがり寄って高手小手に縛めてしまった。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすまた、もじり、棒、まさかり、こういうものだって馬鹿には出来ねえ、出来るだけ手入れをするがいい」　副頭領の楠右衛門、四人の小頭、十人衆、いわゆる家の子郎党が、クルクルクルクルと立ち働く。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また槍や、さすまた、袖搦み、などという道具のほかに、鉄炮が（関所の格によって数の差はあるが）並べてあり、これはその係りの者がいて、中の一｜挺だけはつねに弾丸を充填し、いつでも火繩がかけられるようになっていた。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その刺叉形をした鬼箭が、確かと棧の間に喰い入っていたので、また後尾の矢筈に絡みついている彼女の頭髪も、これまた執拗に離れなかったので、夫人の身体はその一本の矢に釣られて宙吊りとなり、しかも、虚空の中でキリキリ独楽のように廻転を始めたのであった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、太い刺叉が二本、その両側に立てられていて、その上の鉄棒には、首を打ち落された仔鹿の胴体が結びつけられてあった。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "乱心者よと押取り囲む毬棒、刺叉を物ともせず。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ようし待っておれ、今にその罰で閻魔の庁へ行ってから鉄の刺叉にさされて、じりじりと鬼に火焙りにされるからな！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういってな、鬼どもがお主を真赤な刺叉で火焙りにするわさ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "）の株を買って、町人ながらも玄関に木剣、刺叉、袖がらみを列べて、ただの軽焼屋の主人で満足していなかった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の右手には紅白の幔幕、突棒刺叉捩など、さも厳しく立て並べてある。",
              "citation": {
                "source": "首頂戴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "組子は突棒、刺叉、槍、長刀を取って、弁慶に打ってかかるから、弁慶も金剛杖では間に合わず、ついに太刀の鞘を外して、縦横無尽にそれを斬り散らす騒ぎになったから、見物は喜びますけれど、道庵は身の毛をよだてました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "白雲が、話題の鼻を折られていると、その前へ繰込んで来たのは、たしかに物騒な一行で、抜身の槍、突棒、刺叉というようなものを押立てた同勢が、その中へ高手小手に縛めた一人の者を取押えながら、引き立てて来たのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此方は数十人の役人、突棒刺叉鉄棒などを携えて、取押えようと必死になって働いて居りますが、何しろ死者狂の罪人ども、荒れに荒れて忽ち役人も三四人｜打倒されました。",
              "citation": {
                "source": "後の業平文治",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一に弓、二に弩、三に鎗、四に刀、五に剣、六に鍵矛、七に楯、八に斧、九に鉞、十に戟、十一に鉄鞭、十二に陣簡、十三に棒、十四に分銅鎌、十五に熊手、十六に刺叉、十七に捕縄、十八に白打。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それっ獲ったぞ」　とたんに、彼の上へ、棍棒、鈎棒、鳶口、刺叉、あらゆる得物の乱打が降った。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またどうぞ、近くへお越しのせつには」　門のほうでは、はや部下たちが、槍、棒、刺叉などの捕具を持って勢揃いし始めている。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺叉を持って、火事場へでも出てきたような威勢である。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その楊制使のなれの果てさ」「やっ、こ、これはどうも……」と、男は手の刺叉も抛り出して「知らぬことじゃあございましたが、なんとも、とんだご無礼をいたしました」「おや、おや。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "バチバチ燃えひらめく火光の裡を「――御用っ、御用っ」と叫ぶ刺叉、野太刀、棒、槍などを持った捕兵の影が、煙をくぐって躍り入る。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとからは大小数十隻の捕盗船が、舳に官旗をひるがえし、捕兵の弓や矛や刺叉を満載して、白波を揚げながら迫ッて行く。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――逃がすな」　水へ向って射込んでも、矢は用をなさず、刺叉で掻き廻しても、投げ鑓を抛りこんでも、笑うが如き泡沫が一面ぶつぶつ明滅するのみである。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやもっと、物々しいのは、町会所の柵門で、刺叉やら鳶口のごとき物まで並べたて、火事｜櫓には、人間が登って、四方へ小手をかざしているふうなのだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟、今夜のうちに、罠弓、毒矢、それから弩弓、そうだ刺叉も持って行こう。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
