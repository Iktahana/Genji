    "definitions": [
      {
        "index": 1,
        "gloss": "to stop",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "母親は子供が危ない場所へ行くのを差し止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "政府は有害な製品の販売を差し止める措置を取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "悪質な行為を差し止めるため、法律が改正された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "父の館へ出入りを差し止めるとも言った。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（後に出る変態性欲用具の項参照）　こうした上流の人士が民心の頽廃を嘆いて、吾が児の活動見物を差し止めるのかと思うと可笑しい。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日の出兵を差し止める道は、今夜中に成田頼母を倒すよりほか、道はないと存ずるが、方々の御意見は？",
              "citation": {
                "source": "仇討禁止令",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "門の処に、楯と矛とを樹てゝ、外敵を差し止める事をした。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでお奈良さまを口実にして実は私のオナラを差し止めるのが何よりのネライだったのです」「そう云っていただくと涙がでるほどうれしくはございますが、万事は拙僧の不徳の致すところで」「あなたは家内の本性を御存知ないからまだお分りにはなりますまいが、夫婦の関係というものは強いようで脆いものですな。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "いさぎよく位を避けて隠退しよう、一橋慶喜をあげて朝廷の命をきこう、ついては謹んで叡旨を奉じ豊後伊豆両人の登城は差し止めるがいい、それを言って将軍が奥へはいった時は、すすり泣く諸臣の声がそこにもここにも起こった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方で支那の有名な小説を忠実に翻訳すると、他方では風俗を害するからというてその発売を差し止める、兵式の教師が国防の忽にすべからざることを説くと、学生らは国際精神に反するというてこれを排斥する。",
              "citation": {
                "source": "人間生活の矛盾",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『おれはただこうして勝手に歩いているんだから、だれもこれを差し止めるわけにはゆかないぞ』部屋へ入って来たボーイは、幾度も立ちどまって、わたしをじろじろ眺めた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "書くと気が付くからこれを差し止める。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "周平は、余計なことを云うと思ったが、さしとめるわけにもゆかなかった。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしがこういってお前をさしとめるわけは、もう少したてば、きっとわかって参ります、なるほど危ないことであったと、お前はあとから気がついてくるでありましょう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "慢心和尚の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "両親はきっと差止めるように思われたし、兄弟は親し過ぎて揶揄うぐらいのものであろうから。",
              "citation": {
                "source": "快走",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして県庁に帰ると、属官を呼び出して、月が瀬の狗は動物虐待だから、屹度差止めると厳しく言ひつけた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り明日になるとキット差止めるとか何とか威かして来るにきまっているんだ。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお光は差止める様に言つた。",
              "citation": {
                "source": "厄年",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字に書いてはならない、書くと氣が付くから差止める。",
              "citation": {
                "source": "公益に有害の鑛業を停止せざる儀に付質問書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそうされたって「売り物、買い物」それを差止める権利は毛頭無い。",
              "citation": {
                "source": "別れたる妻に送る手紙",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "留守で幸い、梅ちゃんの前だが、親方は怒ってやしませんか」「いいえ、別に」「金助の野郎、出入りを差止めるなんていいやしませんでしたか」「そんなことはいいやしませんよ」「それで安心……」　金助は大仰に胸を撫で下ろす真似をしながら、ソロソロと上り込みました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あやまったと申すまでは登城を差止めるぞ」「…………」「立て、目障りじゃ」こんなに光政の怒ったことはない、側に控えている二名の小姓は蒼くなっていた。",
              "citation": {
                "source": "備前名弓伝",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野呂はれいによって、どんな権利で差止めるのかと文句を言ったが、結局は庭の半分だけを使用するという事に落着きました。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の不行跡はます／＼擴がりひどくなつて、それがあまりに烈しいのでたゞもう手荒な遣り方しかそれをさし止めることが出來なくなつて來ました。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田も榎本の苦衷を知っているだけに、さすがにその立場を気の毒に思ったが、さりとて被害民の言い方も当然のことと思えば、さし止めるわけにもゆかず困惑した。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "由紀は居間へはいってすぐに披いた、父の手跡で当分のあいだ出入をさし止めるという意味が書いてあった、つまり絶縁状である。",
              "citation": {
                "source": "日本婦道記",
                "author": "藪の蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもお気の毒ながらこうなっては、それらの人の力で差しとめることはできませんね、音頭を取る茂ちゃん、踊り出さないわたしでさえも手がつけられないのに、留守をしている人たちに、どうしてこの踊り狂う人たちの血気を抑えることができましょう。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなると、きっとお上のお声がかりということになるにきまっている、お役人が出向いて来て力ずくで差しとめるということにきまっているよ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかし、そんなものも見当らぬ以上、私の散歩を差しとめる権利はない。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「最初のうちは、隨分、世話をしてくれた人もありましたが、心掛けが惡くて勘當した伜を世話するなら、出入りを差しとめると文句を言はれて、親類も知己も手を引いてしまひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "江戸の夜光石",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来筋に住居する町家その他の家族と召使いのほかは、他人一切の滞留を差し留めるともある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "さしとむるむぐらやしげき東屋のあまりほどふる雨そそぎかな　と言い、雨を払うために振った袖の追い風のかんばしさには、東国の荒武者どもも驚いたに違いない。",
              "citation": {
                "source": "源氏物語",
                "author": "東屋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
