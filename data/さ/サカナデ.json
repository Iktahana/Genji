[
  {
    "uuid": "3adcf210-df01-58d7-9f3c-141d94dfc8bd",
    "entry": "逆なで",
    "reading": {
      "primary": "さかなで",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
