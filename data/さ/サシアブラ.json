        "examples": {
          "standard": [
            {
              "text": "機械の稼働部には、定期的に「差し油」をして滑らかさを保つ必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "古い時計のゼンマイには、微量の「差し油」が不可欠だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このミシン、最近音がうるさいんだよね。そろそろ「差し油」が必要かな。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "神はいつも下等な差し油で手をまっ黒によごしているんだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあれ車の鐵の輪、軸に黄金のさし油注げば空を疾く截りて大音震ふ電働機や、その勢の渦卷の奧所に聽けよ靜寂を、――活ける響の瑠璃の石、これや「眞」の金剛座。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
