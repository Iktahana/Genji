[
  {
    "uuid": "d3315f54-a262-5378-89f4-fdd11addf4fe",
    "entry": "さらっと",
    "reading": {
      "primary": "さらっと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "smoothly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は難しい質問にもさらっと答えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "汗をかいても、このシャツは肌にさらっとした感触だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は話をさらっと流して、次の話題に移った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "地面の挨をさらさらさらっと掃除する、てまへなんぞに用はない。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地面の挨をさらさらさらっと掃除する、てまえなんぞに用はない。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」キリストはそう呟いて、かれの一切の希望をさらっと捨て去った、刹那の姿を巧みにとらえた。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、謙吉に時世をみる眼があったからだろうか、暖簾や、伝統などに執着せずさらっと止めたことは、多くの競争者のなかにあってマネキン人形などつくるよりも、大光斎としては有終の美であったにちがいない。",
              "citation": {
                "source": "方子と末起",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋髪に結った髪がばかに綺麗にさらっとカールしていて、黒襟のかかったはでなお召の着物をきていた。",
              "citation": {
                "source": "椎の木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども酷暑の刺身として、チビリチビリ酒でも飲む者には、ちょっと摘まむには、いかにもさらっとして涼味がある。",
              "citation": {
                "source": "道は次第に狭し",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、さらっとした涼味だけでよいのではないか。",
              "citation": {
                "source": "道は次第に狭し",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "肌ざわりのさらっとしたかたびらを着たいなあ。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭から、さらっとしたうす陽が、さし込んだ。",
              "citation": {
                "source": "口笛を吹く武士",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議なことにそんな場合には、いつも額いている私の頭の上で、さらっと幣の音が致します。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、沖縄の豆腐はかたいので、チャンプルーにしても水気がなく、出来上りがさらっとしている。",
              "citation": {
                "source": "チャンプルー",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "グライドがさらっと言った。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　話はさらっと片づいた。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒だって江戸のあっさりしたほうが口に合うし、初めはやさしいと思った女にしても、馴れてみればべたべたした感じで、江戸の女たちのさらっとした肌合にはかなわない。",
              "citation": {
                "source": "おさん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "動きかたは無限の変化をしますし、たとえば立っているときのふとしたポーズでも、立ちかたはさまざまにありますから、表情もいろいろです」「この絵を、さらさらっと描いてしまうのね」「そうです」「これだけ描けて、なぜあなたは芸術家にならないの？",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "粘ったところのまったくない、あくまでもさらっとした距離感であり、なにごとにせよ相手に無理に引受させることをいっさいしないかわりに、相手に対する過剰な期待もなにひとつ持たないという、わかりやすいと言えばたいへんにわかりやすい距離の取りかただ。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "涼しげでさらっとしていて、なにをしていても常にどことなく品があった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし恵子よりはるかによく喋り、恵子のやや重みをともなった静かさに対して、友人はきわめてさらっとして軽かった。",
              "citation": {
                "source": "夏と少年の短篇",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "軽くてほんとにさらっとした、悲しくなるほどに澄んだ笑顔で」「高校生のときのことで、ほかになにか語ってもらえますか」「美代子は一年生のときから演劇部で活動してました。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、吹く風は、さらっとして、気持いい。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お嬢さま、その男をもう一度見たらわかりますか」　ビートリスはこの重要点をさらっと流した。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
