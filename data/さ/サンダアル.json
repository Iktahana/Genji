          "literary": [
            {
              "text": "Talaria　翼の生えた靴、或はサンダアル。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならずサンダアルを片つぽだけはいた希臘神話の中の王子を思ひ出させる現象だつた。",
              "citation": {
                "source": "歯車",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならずサンダアルを片っぽだけはいた希臘神話の中の王子を思い出させる現象だった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕はあらわにて、その上膊には蛇形の黄金の環をはめ、サンダアルを穿ち、黄金の細工の帯を締めている。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホールでは、もう黒いエナメルの長靴と銀刺繍のサンダアルとが、軽やかなステツプを踏んでゐます。",
              "citation": {
                "source": "けむり（ラヂオ物語）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
