        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "咲枝は疲れが出て、背中をいたがり、おふろのとき、私がサロメチールを背中じゅうにフーフーいってぬってやります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょう、サロメチール買って、私の脚へよくすりこんだから、かえる迄にびっこは直さなければなりません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サロメチールつけたので、びっこ大分楽です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四畳半でお手紙よんで、それから風呂に入り、サロメチールをぬって、きょうは肩の痛いのも背中の痛いのも大分楽です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下女工の流し作業で盛大に製産されているのはペニシリン軟膏とかサロメチールまがいの薬であり、高貴薬では六神丸以上にＢ12である。",
              "citation": {
                "source": "安吾新日本風土記",
                "author": "第二回　富山の薬と越後の毒消し≪富山県・新潟県の巻≫",
                "note": "青空文庫"
              }
            },
            {
              "text": "吸入し、アスピリンのみ、サロメチール塗り、アダリンのみて十二時眠る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハシラが大分祟って、とてもキヤ／＼してかなはない、背中からサロメチールを塗り、腹へは懐炉を入れて、公会堂の日日新聞主催東北救済の会へ出て、一席やる（30）。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "食事に出る元気もなく、昼終ると入浴し、サロメチールを塗って、横になってゐた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
