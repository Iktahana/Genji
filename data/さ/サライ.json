[
  {
    "uuid": "7b9d719c-6b79-5fbe-b2f4-25b7f212767d",
    "entry": "竹杷",
    "reading": {
      "primary": "さらい",
      "alternatives": [
        "さらえ"
      ],
      "is_heteronym": false
    },
    "grammar": {
