      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "farmer's rake",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭の手入れのために、竹でできた竹杷を購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "農作業で、土や落ち葉を竹杷でかき集めるのは大変な作業だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "竹杷を使って水路のゴミを浚い、流れを良くした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そうして尚さらいけないことには、そのときの太宰の服装がそっくり、馬場のかねがね最もいみきらっているたちのものだったではないか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに調子が単純で弾ずる人に熱情がないからなおさらいかん。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "刹那に、躍り出た仲間は娘を車中へさらいこむ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」大学士は別段気にもとめず、手を延ばして状袋をさらい、自分の衣嚢に投げこんだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」貝の火兄弟商会の赤鼻の支配人は云いながらすばやく旅費の袋をさらい上着の内衣嚢に投げ込んだ。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはいきなりその大きな男は人さらいだと思った。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくたちが戦ごっこをしに山に遊びに行って、その乞食を遠くにでも見つけたら最後、大急ぎで、「人さらいが来たぞ」といいながらにげるのだった。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからは畳を歩行く跫音もしない位、以前の俤の偲ばるる鏡台の引出の隅に残った猿屋の小楊枝の尖で字をついて、膝も崩さず母親の前に畏って、二年級のおさらいをするのが聞える。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "色紙、短冊でも並びそうな、おさらいや場末の寄席気分とは、さすが品の違った座をすすめてくれたが、裾模様、背広連が、多くその席を占めて、切髪の後室も二人ばかり、白襟で控えて、金泥、銀地の舞扇まで開いている。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから僕も久し振りに英語のおさらいだと思って雄弁にやりました」若者は笑いながら舌で唇を嘗めた。",
              "citation": {
                "source": "母子叙情",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして尚さらいけないことには、そのときの太宰の服裝がそつくり、馬場のかねがね最もいみきらつてゐるたちのものだつたではないか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はい、」　と娘が引取った、我が身の姿と、この場の光景、踊のさらいに台辞を云うよう、細く透る、が声震えて、「お爺さんが留守の時も、あの、戸を閉めた中に居て、ような、いつも留守してくれますのえ。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、開き直って、今晩は、環海ビルジングにおいて、そんじょその辺の芸妓連中、音曲のおさらいこれあり、頼まれました義理かたがた、ちょいと顔を見に参らねばなりませぬ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "口も利けない始末ですがね、場所はどこです、どこにあります、あと何階あります、場所は、おさらいの会場は。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おさらい……おさらいなんかありませんわ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鶏卵と、玉子と、字にかくとおんなじというめくらだけれど、おさらいの看板ぐらいは形でわかりますからね、叱られやしないと多寡をくくって、ふらふらと入って来ましたがね。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさらいや、おおさえや、そんなものは三番叟だって、どこにも、やってやしませんのさ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前さんも、おさらいにおいでなすったという処で見ると、満ざら、私も間違えたんじゃアありませんね。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おさらいは構わないが、さ、さしあたって、水の算段はあるまいか、一口でもいいんだが。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ではその元気で、上のおさらいへいらっしゃるか。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、おさらいの看板が見えるから、衣裳をつけた踊子が涼んでいるのかも分らない、入って見ようと。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさらいのあとで、お湯に入る……ッてこれが、あまりないことさ。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは、この浄瑠璃のおさらいをちっとも不思議に思わずに、家の前を通り過ぎて濠川に架っている小橋を渡り、明るい人形町通りへ出ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさらいも監督する。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "安倍川の川さらいの仕事です。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おさらいと明日の下読が済むと、筆入やカバンを奇麗に掃除して、鉛筆を上手に削って、時間表に合せた書物や雑記帳と一所に入れて机の上に正しく置きました。",
              "citation": {
                "source": "白椿",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと行って来ますから、貴君はおさらいをしていて頂戴ね。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴君は、下へ行っておさらいをしていらっしゃい！",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だってえ、おさらいといっても、僕は今日まだ、何にも先生にしてもらっていないんだもの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
