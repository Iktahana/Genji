        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の言葉は、彼の心に小さなさざ波を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "発表されたニュースは、株式市場にさざ波を起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "会議室に流れる緊張感は、さざ波のように広がり、皆を不安にさせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
