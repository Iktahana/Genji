        "examples": {
          "standard": [
            {
              "text": "砂防林は土砂崩れを防ぐために、危険な斜面に計画的に植林されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この砂防林がなければ、麓の村は毎年の土砂流出の危険にさらされるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "砂防林の育成には数十年の時間がかかるため、世代を超えた取り組みが必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "二三十年の砂防林の松が頭だけ埋め残されて、栽えたばかりの小松のように見える。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
