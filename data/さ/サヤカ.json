[
  {
    "uuid": "90b4f2e1-3e90-5d04-a61f-4cb7f187cc5e",
    "entry": "明か",
    "reading": {
      "primary": "さやか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
