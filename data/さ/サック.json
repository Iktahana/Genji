        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もちろんそうでない場合もまたはなはだ多いようであるがだいたいにおいては自然にそうなるべきはずのものではないかと思われ、そういう意識をもって作句してもしかるべきではないかと思うのである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと同時に作句ということが決してそう生やさしい仕事ではないことが想像されるであろうと思われる。",
              "citation": {
                "source": "俳句の精神",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "――執着を去れ、酒から作句から、私自身から。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "西光寺の奥の院南郷庵の庵主となった放哉は、酒と作句に明け暮れる。",
              "citation": {
                "source": "尾崎放哉選句集",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "梶と高田は曲縁の一端のところですぐ兼題の葛の花の作句に取りかかった。",
              "citation": {
                "source": "微笑",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "高田の披講で一座の作句が読みあげられていくに随い、梶と高田の二作がしばらく高点を競りあいつつ、しだいにまた高田が乗り越えて会は終った。",
              "citation": {
                "source": "微笑",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼にしてはむしろ句の善悪よりも、前からの真紀子との間の自分の立場を明瞭に語りたい意の動きで、彼女の作句の中からそれに適当したものを択んだにちがいないことは分っていたが、それでも矢代は愉快ではなかった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "但こは類別上の便宜をいふ者なれば実地の作句はその時の情況によりて作るべく、四季の名目などにかかはるべきに非ず。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "故にその作句数千、十中の八、九は狂体もしくはしやれ滑稽に属するものなり。",
              "citation": {
                "source": "俳諧大要",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "古事古語の使用は談林一派の生命ともいふべく、彼らが作句の一半はこの部に属すべき者なり。",
              "citation": {
                "source": "古池の句の弁",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そう云う偉い人を知らずにいるのは不本意だったから、その飯田蛇笏なるものの作句を二つ三つ尋ねて見た。",
              "citation": {
                "source": "飯田蛇笏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内に僕も作句をはじめた。",
              "citation": {
                "source": "飯田蛇笏",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "乳責りなく児、葱ぬく我、足袋つぐ妻の句は作者の境遇がうみ出した生活の為めの作句である。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹿島の孫娘の文子が、冬亭のところへ作句の手ほどきを受けにくるようになったのは、日華事変のはじめごろだったろうか。",
              "citation": {
                "source": "西林図",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "――自分の作句が活字となって現われたのは実にこの『俳諧』を以て初めとする。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく作句に苦心して熱心であった事は古今有数の一人とせねばなるまい。",
              "citation": {
                "source": "俳句はかく解しかく味う",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までどうも作句の上に不満足な点があった、どうかしてそこを逃れ出て新しい境地に入りたいと懊悩していたが、それがこの句を得たと同時に合点がいった。",
              "citation": {
                "source": "俳句とはどんなものか",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時俳諧宗匠として世間に勢力のあった者から申せば蓼太でありましょうけれども作句の技量からいったらいうまでもなく、蕪村を推さなければなりません。",
              "citation": {
                "source": "俳句とはどんなものか",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が前の作句の例に現在の住まっている土地である鎌倉やその他自分の身辺のことを主として取ったのは、材料は決して遠きに在るものでなく、きわめて手近いところに在ることを明らかにしたいがためでありました。",
              "citation": {
                "source": "俳句の作りよう",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は今回は以上のべたような句作法によって、句作法というよりはこういう研究法を積んで、古句の意味、あるいはその作句上の苦心のあとを十分にさぐり、それを自分の句作に応用することをおすすめするのであります。",
              "citation": {
                "source": "俳句の作りよう",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし動植物としたのはきわめて少数であってたいがいは人間としての作句でありました。",
              "citation": {
                "source": "俳句の作りよう",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれも圓朝自らの作句とおもうが、いかにもそれぞれの人らしい感じのでている上にさして月並でない。",
              "citation": {
                "source": "我が圓朝研究",
                "author": "「怪談牡丹燈籠」「江島屋騒動」「怪談乳房榎」「文七元結」「真景累ヶ淵」について",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の作句を集めた和綴の本が二冊、わたしの家の二階の書物棚の上に古雑誌とともに積み重ねてあったが、それ等も何時の間にか多くの反古とともに紙屑屋にでも売られてしまったのであろう。",
              "citation": {
                "source": "三等郵便局",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏目漱石の作句に二つ面白いのが存するが、『虞美人草』で、京都に来た宗近君が琴の音をきく所に、隣家の連翹がみえるところが描かれてゐるのは、人々の容易におもひ出す所であらう。",
              "citation": {
                "source": "連翹の花",
                "author": "新村出",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、作句したり自由な空想に愉しみ耽けることができる。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
