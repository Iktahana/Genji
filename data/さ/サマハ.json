          "literary": [
            {
              "text": "葉子は黙って、書いては消し書いては消しする字をたどって見ると、「ネーサマハイイコダカラ『アメリカ』ニイツテハイケマセンヨヨヨヨ」　と読まれた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタツムリガ　ツノヲ　フツテルノヲ　ミテ　ヰルト、王サマハ、子ドモノ　ジブン、何ダカ、カタツムリノ　ウタヲ　ヨク　ウタツタ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "王サマハ、「デンデン　ムシムシ」ト　口ノ　中デ　イヒナガラ、ニハヲ　グルリト　マハツテ　キマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　王サマハ、カタツムリヲ　ツブサナイデ、青イ　ハノ　上ニ　ソツト　ノセテ　ヤリマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシヤサマハヨクヨク、シンサツシテ、ソレカラ、「ボンコチヤン、アナタノ病気ハモンコチヤンノ所ヘカヘレバスグナホリマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
