        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たった一冊出て仲間は四散した。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は創作集を、つづけて二冊出版した。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "短篇集を四冊出しています。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊藤公の書いた七絶の半折を掛けた床の間の前に、革包が開けてあって、その傍に仮綴のinoctavo版の洋書が二三冊、それから大版の横文雑誌が一冊出して開いてある。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊藤公の書いた七絶の半折を掛けた床の間の前に、革包が開けてあって、その傍に仮綴の inoctavo 版の洋書が二三冊、それから大版の横文雑誌が一冊出して開いてある。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ大きな印刷ものが五六冊出て来た。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この御神さんは浜のものだとか云って、意気な言葉使いをしていたが、新しい折手本を二冊出して、これへどうぞ同なじものを二つ書いて下さいと云った。",
              "citation": {
                "source": "満韓ところどころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "博文館の方からは、『食後』と『藤村集』と二冊出したが、『藤村集』の方は長原さんにお願ひした。",
              "citation": {
                "source": "装釘に就て",
                "author": "『春』と『家』及び其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は何事かと思いつつ包をとくと中からいつぞやのノートが一冊出てきた。",
              "citation": {
                "source": "先生の顔",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "月給は十八円で、電車のパスが二冊出るんだ。",
              "citation": {
                "source": "死までを語る",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は最近本を三四冊出しました。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とてもいいところへ引越したのねと云うと、詩集を一冊出したので、これからは大変景気がよくなるだろうと云う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供は新聞包みをごぞごぞと開けて、婦人雑誌を二冊出した。",
              "citation": {
                "source": "子供たち",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく一冊出て来た。",
              "citation": {
                "source": "並木",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年は或は暮れに近づいて二冊出るかもしれません。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが音楽の方はおくれていて、まともな音楽史一冊出ていず、芸術史にしろ、今日の到達点において書かれたのはないから教育上閉口です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十冊出した本やで四冊ですからね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――彼女はふと女学校の教科書にそんなことも書いてあったように感じ、早速｜用箪笥の抽斗から古い家政読本を二冊出した。",
              "citation": {
                "source": "たね子の憂鬱",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると書籍部と札を出した台に、Quarto 版の本が一冊出てゐた。",
              "citation": {
                "source": "本の事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "』といって、古本を一、二冊出してくれた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（書物を一冊出して見せる。",
              "citation": {
                "source": "LOS CAPRICHOS",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなのが三四冊出来た。",
              "citation": {
                "source": "大野人",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて土田杏村は英語でこの種の本を一冊出版した（著者自身による邦訳も出ている）。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "全集は大正十二年の八月までに七冊出ましたばかりで、あの大震災になったのです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢田部先生は罷職後も植物志を続けねばいかんといい、教室に出てきて『日本植物図解』を三冊出版されたが、後は出なかった。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "また先生歿後『日本植物編』が一冊出版された。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから鶴子に自分は近い中に哲学の著作を一冊出すと云つた事を思ひ出す。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、ノオトを一冊出した。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三好達治と私の口論も贔屓からわたり合っただけで、お互に本一冊出して貰ってさえなかった。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "おせいの家への借金もかなりの額になつてゐたが、三年經つたが、長篇どころか、この夏貧弱な全收穫の短篇集一册出せたきりで、その金もおせいの家の借金へは※らず、自分の父の死んだ後始末などに使つてしまつた。",
              "citation": {
                "source": "おせい",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
