        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「さあさあ、どうぞこちらへ」と老人が客を招いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "「さあさあ、時間がありませんよ」と店員が急かした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "「さあさあ、さっさと支度をしなさい」と母が子どもに声をかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
    ],
