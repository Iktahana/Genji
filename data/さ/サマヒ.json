[
  {
    "uuid": "20fb4c33-875b-562f-8ed2-e5e81093b83b",
    "entry": "様日",
    "reading": {
      "primary": "さまひ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
