[
  {
    "uuid": "b5590f6a-f63c-5c4c-9a90-751f4cc7c910",
    "entry": "賛美歌",
    "reading": {
      "primary": "さんびか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
