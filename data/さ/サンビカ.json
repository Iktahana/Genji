    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hymn",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "教会の礼拝では、美しい賛美歌が聖歌隊によって歌われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は子供の頃から賛美歌を歌うのが好きで、聖歌隊に入っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "結婚式で流れる賛美歌のメロディは、感動的で心に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "牧師が賛美歌の番号を知らすと、堂のすみから、ものものしい重い、低い調子でオルガンの一くさり、それを合図に一同が立つ。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰ってどうしたか、聖書でも読んだか、賛美歌でも歌ったか、みな忘れてしまいました。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "好き日なり、媼たち、さらばまづ祷らまし賛美歌の十五番、いざさらば風琴を子らは弾け、あはれ、またわが爺よ、なにすとか、老眼鏡ここにこそ、座はあきぬ、いざともに祷らまし、ひとびとよ、さんた・まりや。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月四日　日曜で早朝楽隊が賛美歌を奏する。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうひとりは、むくみのある強面で、首が太く、窓のそばでポケットに両手を突っ込んで、誰でも知っている賛美歌を口笛で吹きながら立っていた。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "賛美歌というものだろうと考えた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、それはリグヴェーダ（Rig-Veda）の第一〇巻目の中にある見事な一二九番の賛美歌で、訳してみるとこうである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下に太陽神に対する美しい賛美歌を挙げる。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "学問のために学生を保護し　　彼らを上品に、清潔に保つ　　これこそ大学の存在理由　　ＩＢＭの機械に栄光あれ　賛美歌一一一番「おお、来れ、すべての信ずる者」は、次のように改竄された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあなたの熱心な祈りをきき、賛美歌を共にうたいました。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓地でも賛美歌が歌われた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "純心の生徒たちは、工場に動員されていたが、燃ゆる火の中で賛美歌をうたいつつ、次々と息絶え、灰になっていった。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夜私は教室の小笹君たちを患者の手当てに出したが、その話によると、女学校から東のほう二百メートルの川端に真夜中幾人かの合唱するラテン語の賛美歌が続いたり絶えたり聞こえていたそうである。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ゆうべの賛美歌はこの修道女たちが歌っていたのであろうか？",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく従姉のエリザベトを訪ね、彼女から祝いをのべられたとき、「わが魂主をあがめたてまつり、わが精神わが救い主なる神によりて喜びに堪えず、そはその召し使いのいやしきを顧みたまいたればなり……」という賛美歌をうたった。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもこの絵に何百年か前、名もない職人がこめた信仰の力におのずから引き出された賛美歌であったにちがいない。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで賛美歌を歌っている修士のように。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "賛美歌の声に送られながら私は再び夜の町に追い出されたのである。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "中なる馬上の客も、多くは知らね賛美歌の種をきらして、人に習はぬ「忍路高島」を歌ふ。",
              "citation": {
                "source": "馬上三日の記",
                "author": "エルサレムよりナザレへ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フラウエンブルクの司教座聖堂参事会員（カノン）であるその町の医師が、賛美歌作者としても、生涯も、終わりに近づいて、生涯に１つの研究である「天球の回転について（De revolutionibus orbium coelestium）」を印刷所に送った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は独り言をいったり、馬鹿野郎と自分をけなしてみたり、あるいは賛美歌の断片や感傷的な歌曲や戦の行進曲や酒の唄などをごっちゃにないまぜて、太い声で歌っていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども彼はその賛美歌的性質を存続させまいと用心した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその賛美歌的性質を残すまいと用心した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くの教会堂では、十七世紀の古い鐘が、不揃いな恐ろしく調子はずれな声で、十五分ごとに、単調な賛美歌の断片を歌っていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「山路越へて、ひとりゆけど……」　賛美歌をうたってゐる時もある。",
              "citation": {
                "source": "乞はない乞食",
                "author": "添田唖蝉坊",
                "note": "青空文庫"
              }
            },
            {
              "text": "偉大な賛美歌が聞こえます、愛と幸せを歌っています。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディアコヌス作と言われる洗礼者ヨハネ降誕の有名な賛美歌(6)はたぶん歌詞からみて風邪を治す力があると信じられていた(7)。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "願わくばかくて臓腑は洗われ心の汚物溜めよりすべての禍の清められんことを人の双方に健康の贈物をもたらすゆえ皮膚の手入はたいせつなり感情と知性が健やかに保たるる時慰めのよき望みあり（松藤訳）第２の賛美歌は次の歌詞で始まる教皇の放血にかんするものである(10)。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗やみのうちから伝わって来る賛美歌で、夜の暗い恐ろしい静寂のうちにおける祈祷と和声との光耀であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "賛美歌の後、鐘の鳴った後、鈴の鳴らされた後、喪鐘の後、祭式の後、そこに突然｜蜜蜂の羽音よりもなおやさしい娘らの声がわき上がってくる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
