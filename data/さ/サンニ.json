        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「権輿」ケンニョ、「山野」サンニャ、「専要」センニョー。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オババサンニ可愛イ言葉。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "緒方サンニハ、子供サンガアッタネ。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　コハゴハ、ホンヲ　トウサンニ　ワタシマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オバサンハ　アカチヤンヲ　ミチコサンニ　ダツコサセテ　クレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ　ナホスニハ、イタチサンニ　オモヒキリ　オナラヲ　サセルヨリ　シカタハ　アリマセン」　ヤレヤレ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテラノ　コゾウサンニ　バケル　トキハ　コロモヲ　ツケテ　デルノダヨ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソレデハ、オテラノ　コゾウサンニ　バケテ　ミヨツト」　コドモノ　タヌキハ　コゾウサンニ　バケテ　ミマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "またインドで曙光神アスヴィナウは、日神スリヤその妃サンニアと牡馬牝馬に化けて交わり生んだので三輪の驢車に乗り、日神自身は翡翠色の七頭の馬に一輪車を牽かせて乗ると類似して、ギリシアの日神ヘリオスは光と火を息する四の雪白馬が牽く車に乗る（第六図）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ私ハ別ノ手段デ、モットモット皆サンニ、思イ知ラセマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きょうは何日……」「……五月……ジュ……サンニチ……」「エッ……十三日……ほんとか……」「……ホント……です……」　と云ううちにアダリーは壁際の小｜卓の上に置いてある新聞を取って見せた。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度工場外ニ足ヲフミ出シテ見レバ分ル通リ、当工場ハマサニ「Ｙノフォード」タル名ニ恥シクナイ充分ノ待遇ヲ、ソノ時間ノ点カラ云ッテモ、ソノ賃銀ノ上カラ云ッテモ、皆サンニ与エテ居ルノデアリマスカラ、コノ際決シテ、カヽル宣伝ニ附和雷同セザル様、呉々モ申述ベテ置ク次第デアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "動坂氏ハ其ノ翌朝、ツマリ三十日朝、貴女ノ妹サンノ千代子サンニ、ウッカリ夫レヲ話シタノデス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの外になお、私は三百人を下らない印度人、ゴザイン族、及びサンニアス族が、毎日この場所で、ラマの恩恵で養われる、と聞いたのである１）。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "タウタウ、シンセツナネズミサンガ、ソツトアヒルサンニイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　アヒルサンハ、三匹ノコグマサンニ、イヒマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタノアサハ　ジヤガイモサンニモサウ言ツテ二人デ一シヨニ、キツト　オミオクリニキテクレタマヘ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人参サンハ　ジヤガイモサンニダマツテ、一人デ玉ネギサンヲ　オクツテユカウト思ヒマシタケレド、ソレデハ、ドンナニ玉ネギサンガカナシガルデセウ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクル朝、ボンコチヤンハ、ボーイサンニ「バウシノオ父サン」ノオ家ヲキイテ、トコロトバンチヲカイテモラヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンノ下ノ小犬ノコトハオ母サンニ言ワナイデ下サイ九月三日午後七時半　ナイテイルカラカクシテモワカッテシマウト思イマス　小犬のことは、そのほかにも数通あった。",
              "citation": {
                "source": "アンゴウ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "クマノ　トムト　　イヌノ　ジヨンハアマリヨロコンデ、トンダリハネタリシテ、タローサンニ　　シカラレマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムクンガアンマリサワグノデ、マタタロー　　サンニシカラレマシタ、ガマタ　スグウレシクテタマラナイノデサワギダシマス。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オホキナ　コヱデナニヲ　ネゴトヲイッテルノ」トオカアサンニオコサレテ、ハジメテ　ユメダッタ　トワカリマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラスプーチンのほうでは、皇帝をパパ、またはニキ、皇后をママまたはサンニイと呼び捨てにし、冬宮のそばのグロホワヤ街に邸宅をかまえ、霊感の訪れがあると夜中でも夜明けでも勝手に宮中へ参入するという破格の待遇を受けるようになった。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "真砂座時代紅葉山人ノ「夏小袖」ノオ嬢サンニナッタ時、予ハ特ニ彼女、デハナイ彼ニ魅惑サレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ニ行クホド暑クナリマス」正直ノトコロ、予ハ手ノ痛サニ閉口シテ晝ノ部ヲ見ルノハ止メヨウカト思ッテイタノダガ、婆サンニ窘メラレタノデ却ッテ依怙地ニナリ、痛イノヲ怺エテ明日ノ晝ニ又来ヨウカト思ッテイタノダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ婆サンニオ覚エノ悪イノハ、コンナ場合、婆サンヲ無視シテ予ノ気持ヲ迎エヨウトスルカラナノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
