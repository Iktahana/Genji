[
  {
    "uuid": "7ea68c71-8c78-5c46-8408-e828fc748ef9",
    "entry": "産業",
    "reading": {
      "primary": "さんぎょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
