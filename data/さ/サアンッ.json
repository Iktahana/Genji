        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――お通さあんっ、お通さあん！",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は最後の一つの念願として、兄さあん！",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "折りかさなって岩からてんらく、ざぶと浪をかぶって、はじめ引き寄せ、一瞬後は、お互いぐんと相手を蹴飛ばし、たちまち離れて、謂わば蚊よりも弱い声、『海野さあん。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、この場合は窪んだ腹に緊く締めつけてある帯の間に両手を無理にさし込み、体は前のめりのまま首だけ仰のいて「お母さあん」　と呼ぶ。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母さあん、お母さあん」　薄紙が風に慄えるような声が続いた。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ危な、危な、おすめさあん、早く来て呉んなさい、早く、早く」と婆やは大仰に喚いた。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "新井田氏の玄関によろけこむと、渡瀬は拳固で涙と鼻水とをめちゃくちゃに押しぬぐいながら、「奥さあん」　と大声を立てて、式台にどっかと尻餅をついた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊ちやんが生垣へ覗いて、「叔父さあん／＼。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その動揺の一隅から、「二年生甲組、大津太郎さあん、大津太郎さあん……大きな声で返事して下さあい！",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "けさあんなことがあって、じぶんは磯五につれられて出て行ったのだから、どんなに気もちをわるくしていらっしゃるかもしれない。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「屑屋さあん、そこへ行く犬ころを押せえて下せえ。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとうさあんと呼ぶんだよ。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おうい、丸木さあん」　千二は、遂に悲鳴をあげた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おゝい、お米さあん。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三田さあん、三田さんと違ひまつか。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わざと三田の給仕役は自分ときめてゐたが、變つた女が目の前にあらはれると、急ち好奇心を動かす野呂は、部屋を距てた向ふから、「おときさあん、おときさあん。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩は、おばさあん……。",
              "citation": {
                "source": "別れの辞",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人の女給は意味ありげな目配せをしあって、素頓狂な大きな声で、登美子さあん……と叫びたてた。",
              "citation": {
                "source": "南さんの恋人",
                "author": "――「小悪魔の記録」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どこも痛くねえ」「おーい、婦長さあん！",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆ちゃんは窓から顔を出して「吉田さあん、吉田さあん」と叫んでみた。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "樽ちゃんも並んで顔を出して「井上さあん、ミッちゃあん」と叫んだ。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを聞きつけると子供はもう嬉しそうに飛びかかって、「与八さあん――」　父を知らず、母を知らずと言った児は、父と母とを一緒にしたよりも強い懐かしさでこの太った男に抱きついてしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "竜神の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「弁信さあん、しっかりなさいよ」　お銀様は、砕けるほどかたく弁信を抱きしめて、あらん限りの声で叫びましたが、その声は今までと違って、天来の力が籠ってでもいたように――そこで、声と、力とが、神に通じたか、以前よりも、もっと頼もしい息づかいで唸りを立てました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「宇津木さあん――何してらっしゃるのよ」「あっ！",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、弁信さあん」　茂太郎は声をあげて助けを求めるの叫びを立てようとするのを、がんりきの百蔵が早くも、合羽の中へ抱え込んでしまって、「おとなしくしな」　哀れむべし。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　一日の疲れでとろとろと眠つてゐると、「当直さん、当直さあん。",
              "citation": {
                "source": "続癩院記録",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ヴェランダへ出て）六号室のみなさあん……。",
              "citation": {
                "source": "速水女塾",
                "author": "四幕と声のみの一場よりなる喜劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
