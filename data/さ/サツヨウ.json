        "examples": {
          "standard": [
            {
              "text": "彼の論文は複雑な理論を撮要し、分かりやすくまとめられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この本は経済学の基本を撮要した入門書として高く評価されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "講義の最後に、教授は一時間の内容を撮要して、主要なポイントを説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "葯の字を Anther に用いたのは榕菴氏の創意で圭介氏はこれを糸頭と訳し『植物学』では単に嚢といい、降て明治十一年発行の松原新之助氏纂述の『植物綱目撮要』ならびに同氏講義の『薬用植物篇』には花嚢といい、同十四年刊行の丹波敬三、高橋秀松、柴田承桂三氏合著の『普通植物学』では粉嚢と訳してある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈三百二十五葉〉宗教の事に与聞する権利を論ずる章（撮要）　〈上略〉回教征戦の名実につきては、なお深く推究せざるべからず。",
              "citation": {
                "source": "「ヒリモア」万国公法の内宗教を論ずる章（撮要）",
                "author": "COMMENTARIES UPON INTERNATIONAL LAW",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
