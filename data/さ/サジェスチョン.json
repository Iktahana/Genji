          "standard": [
            {
              "text": "会議では、新しい企画についていくつかのサジェスチョンが出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼のサジェスチョンのおかげで、問題が解決に向かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "もっと良い方法がないか、何かサジェスチョンがあれば教えてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "何かしら安心のサジェスションは無いかと悶え苦む｜現代の児を主人公とした小説を書きたいと思ふんだ。",
              "citation": {
                "source": "茗荷畠",
                "author": "眞山青果",
                "note": "青空文庫"
              }
            },
            {
              "text": "越野は近所に住んでいたばかりに、火事の手伝いから避難所まで引受けて、随分面倒を見て呉れたんだが、その日はその日で妙子の死因について非常に重大なサゼッションを与えて呉れたのだった。",
              "citation": {
                "source": "恐ろしき錯誤",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
