        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "最近、飲みすぎて酒太りになってしまったので、ダイエットを始めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はお腹が出ていることを気にしているが、酒太りはなかなか解消できないらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "健康診断で、医者から酒太りを指摘され、飲酒量を控えるように言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "末の健坊が誰やらに抱かれて吃驚して四下を視廻してゐる面、福田女史に何か言はれてはにかむだやうな富坊の面が見える、大きな三山主筆の面が見える、酒太りの風浪兄の面も見える。",
              "citation": {
                "source": "旅日記",
                "author": "東海道線",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒太りのファシスト倉吉親方だった。",
              "citation": {
                "source": "鋳物工場",
                "author": "戸田豊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、酒太りらしく肥滿した乘客が呟いて、「お願ひだから、その窓を締めて下さい。",
              "citation": {
                "source": "新婚旅行",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "振り向くと、隣の係長室から出てきたのであろう、制服姿の小西が酒太りのした赤い顔をタオルで拭きながら、ばかに元気な様子で近づいてきた。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と酒肥りにでつぷり肥つた紳士は、教授の掌面に載つた果物を見ながら言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "母の肉身の弟ではあつたが、顔に小皺の寄つた、痩せて背の高い母には毫も肖た所がなく、背がずんぐりの、布袋の様な腹、膨切れる程酒肥りがしてゐたから、どしりどしりと歩く態は、何時見ても強さうであつた。",
              "citation": {
                "source": "刑余の叔父",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "白髯の翁も、はたや、絹傘の若き少女も、少年も、また、靴鳴らし煙草吹く海産商も、丈高き紳士も、孫を背に負へる痩せし媼も、酒肥り、いとそりかへる商人も、物乞ふ児等も、口笛の若き給仕も、家持たぬ憂き人人も。",
              "citation": {
                "source": "詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒肥りにデブデブ肥っていて体量も二十貫位ありそうに見える。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍属の高村は、ひとあし踏み出して乱れた隊長の乗馬に、自分の馬首を追い縋って並べ立てながら「は」　と、答えておいて、あ、は、は、は、はッと酒肥りのした太腹を破ってふき出した。",
              "citation": {
                "source": "シベリヤに近く",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒肥りした体格と言い、物々しく鉾をひっさげた様子と言い、ひとかど手なみのすぐれたものと、思われでもしたのであろう。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人の顔が――血のけを失った、この酒肥りの老人の顔が、その時ばかりは、平生とちがった、犯しがたいいかめしさに、かがやいているような気がしたからである。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだね」　彼は、酒肥りのした厚い瞼の間から、じろりとルイザの抱いているものの方を見た。",
              "citation": {
                "source": "顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒肥りの大ざっぱな瀬戸は、即座に賛成した。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十五六の酒肥りのした醜い中年者で、平次をハタと睨んだ眼には容易ならぬ忿怒が燃えます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "蹄の跡",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
