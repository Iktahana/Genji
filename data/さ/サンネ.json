          "literary": [
            {
              "text": "シャスサンネ(Chassanee)という人があった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャスサンネ（〔Chassane'e〕）という人があった。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ馬鹿サンネ、私がアナタニ身ヲ任セタノハカラカッタカラダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコ　ノ　オバアサン村山籌子　タイヘントシトツタオバアサンネコガ、オヒルコロニナツテメヲサマシテ、ベツドノウヘヘオキアガリマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
