  {
    "uuid": "c8c3b78d-983c-5d10-911b-15f2c106ec94",
    "entry": "三会",
    "reading": {
      "primary": "さんね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
