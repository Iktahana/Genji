        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼信紙をとつて、彼は先づ、「シケイヲセンコクサレタ」と書いた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ労働ニ害サレタ手ハ思ウヨウニ自分ノ感力ヲ現ワス事ガデキナイデ困リマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハテ、コンナ　ウツクシイ　花バタヲ　ダレガ　アラシタノダラウ」ト　ヲトコガ　タホサレタ　イツポンノ　ケシノ　花ヲ　オコシテ　ヤラウト　スルト、ソノ　ネモトニ　シンチユウノ　ラツパガ　ヒトツ　オチテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲンキヲ　ダシテ、フミアラサレタ　ハタケヲ　タガヤシ、ムギノ　タネヲ　マキマシヨウ」ト　ヲトコハ　ヒトビトニ　イヒマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ斯ル建國ニモ非ズ又斯ル低能哲學ニ支配サレタル時代モナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語國民ノ淺薄ナル思想ヲ通ジテ空洞ナル會堂建築トシテ輸入サレタル基督教。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "排日ノ聲ガ支那ト米國トニ一齊ニ擧レル所以ハ日露戰爭ニヨリテ保全サレタル支那ト、日露戰爭ヲ有力ニ後援シテ日本ニ支那ヲ保全セシメタル米國トガ、天ニ代リテ當年ノ保全者ニ脚下ノ陷穽ヲ警告スル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シナガラ若シ此ノ日本改造法案大綱ニ示サレタル原理ガ國家ノ權利ヲ神聖化スルヲ見テ「マルクス」ノ階級鬪爭説ヲ奉シテ對抗シ、或ハ個人ノ財産權ヲ正義化スルヲ見テ「クロポトキン」ノ相互扶助説ヲ戴キテ非議セント試ムル者アラバ、其ハ疑問ナク「マルクス」ト「クロポトキン」ノ智見到ラザルノミト考フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正八年十月十四日ノ午後一時カラ二時ノ間ニ、××デ警察署長ガ三人ト、判事ヤ検事ガ四人ト、松島｜見番ノ芸妓二名ガ殺サレタ事件ノ原因ヲ調ベテ下サイ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴官ガコノ事件ヲ、本気デ調査サレタ事ガワカリマシタラ私ガ貴官ノ御宅ニ出頭シテ、真相ヲオ話シシマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルバン、君チャンガ何カニビックリサレタヨウニ、フト目ヲサマシタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "御納メ下サレタク願ヒ奉リ候。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎の読本兎ノ学校ノ読本ハ意地ワル神ニダマサレタ因幡ノ国ノ白ウサギ泣イテヰタレバ泣クナヨトナサケノ深イ神サマニタスケテモラツタ物語リ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ屍体ハ油倉庫ノ中ニ投ゲ入レラレ、放火サレタカラ灰ニナリマシタ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンガ何故殺害サレタカ分リマセンガ、其ノ殺害ヲ一番早ク云イ当テタノハ動坂三郎氏デス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "予等ノ所持品ハ没収サレタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴局ハ左ノ事実ヲ其筋ニ急報シ、至急調査開始ヲ依頼サレタシ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、二、ソノ色、黒褐色ノ水甕ニシテ、底ヲ逆ニスルト、赤キ「ペンキ」デ４０８４ノ数字ガ記サレタルモノ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "此処数日間ニ密輸サレタル数量ハ時価ニシテ五十万るーぶりニ達ス。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ完全ニ蒸焼サレタル芋ハ、蓋ヲ取去リテ取出シ、蓋ニ具ウル保温室内ニ常ニ保温セシメ置クモノナリ。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二条　土地ハ一切ノ（公然タル若クハ隠蔽サレタル）賠償ナクシテ今日限リ全労働大衆ノ使用ニ帰スルモノトス。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱気ニ刺サレタ網膜ヲズリ墜チテ　何トイフ莫大ナ旅程デアラウカ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナホ数字ニ関スル詳細ハ本社又ハ現地事務所ニツイテ問ヒ合サレタク、毎年三月下旬ヨリ十月下旬マデ、旅費二三等何レモ片道本社負担ニテ現地御案内ノ準備ガデキテヰル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、いかにも面白くもなさそうに、観衆の声援に対して、アベコベに、自分はお前さんたちのオモチャじゃないんだ、というようなフテクサレタ態度を示したものである。",
              "citation": {
                "source": "戦後新人論",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "訊問一、鞭打チニヨル（訊問予備）　「ナゼオ前ハ逮捕サレタカ」と質問スル。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "此人民ハ敬神ノ心乏カリシヲ以テ、「ゼウス」神ノ爲ニ絶ヤサレタリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○三時代ノ前後ヲ示ス好例ハ「スウィッツァーランド」ノ湖ノ底ト「デンマルク」ノ※炭層トニ於テ發見サレタリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
