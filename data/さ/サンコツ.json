    "definitions": [
      {
        "index": 1,
        "gloss": "scattering of ashes (cremated remains)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "故人の遺志を尊重し、海での散骨を選んだ家族もいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "最近では、自然に還る散骨が注目されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "散骨は、故人を偲ぶ新しい形として広がりを見せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "皇子薨じて宇治山上に葬るとは日本紀にあるが、散骨の事は記紀その他の古書にかつて見当らぬ。",
              "citation": {
                "source": "火葬と大蔵",
                "author": "焼屍・洗骨・散骨の風俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしながら藤原吉野の当時には、皇子は散骨の式によって葬られたとの説の信ぜられておった事は疑いなく、そしてそれが流例となって、「後世之に傚ふ」とあってみれば、古来遺骨を散ずるの風のかなり行われていたことは、立派に承認せねばならぬ次第となる。",
              "citation": {
                "source": "火葬と大蔵",
                "author": "焼屍・洗骨・散骨の風俗",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
