          "literary": [
            {
              "text": "「カイン」「サタン」の詩二つながら人界の災殃を賦し、「イパティイ」は古代衰亡の頽唐美、「シリル」は新しき信仰を歌へり。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "物憂き羊小舎のかどに、すぐだちて、災殃のごと、死の羊群を誘ふ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "物憂き羊小舍のかどに、すぐだちて、災殃のごと、死の羊群を誘ふ。",
              "citation": {
                "source": "海潮音",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばしの別れだが、使命は重かつ大、どこでどんな災殃にあうかもしれぬのだ。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            }
          ]
        }
