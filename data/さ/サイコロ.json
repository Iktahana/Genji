        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ボードゲームを始める前に、まず骰子を振って順番を決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "賭博では、骰子の出目によって勝敗が左右される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「もう一度骰子を振ってみよう！」彼は希望を込めて小さな立方体を投げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三｜段池谷信三｜郎は骰子を頭上にかざして禮拜する。",
              "citation": {
                "source": "麻雀を語る",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "骰子だのルーレットだのトランプだの将棋だのドミノだのいうものは、そんな目的のために猶太人が考え出して世界中に教え拡めたものである。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "花札、骰子、穴一、銭占、豆握り、ヤットコドッコイのお椀冠せまで、何でも御座れの神｜憑りで……」「うううむ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その振袖娘の振る骰子が、内部に錘玉の付いたマヤカシ骰子と言う事実を存じておりまするのは今の処、広い博多に私一人かと存じますので……」「コレコレ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは然るべき本職の博奕打が、お熊さんの振る骰子に疑いをかけて、あとでコッソリ噛み割ってみたものに相違ない。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "息も吐かぬ間に骰子を掏り換えて、何の事もない愛嬌笑いにして見せると言う……おかげで蔵元屋の毎晩の上り高は大したものであろうが……これと申すもモトを質せばお熊さんの両親の不心得から起ったことで、お熊さんには何の罪も科もないこと。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お熊さんの振るカラクリ骰子が、どうやら本職の博奕打の眼に掛かって来たと思うと、一身一家の破滅を恐れた継母が惜し気もなく毒薬を粥に交ぜて殺いたもので、大事な御縁談、金の蔓の一人娘も、背に腹は代えられぬとは申せ、最初からその覚悟でお熊さんを育てたもので御座いましょうか。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "意志の力と自由によつて、宇宙が自分に都合よく、プロバビリチイの骰子の目が、思ひ通りに出ることを信じてゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "賭博の興味は、その氣まぐれな運をひいて、偶然の骰子をふることから、必然の決定されてる結果を、虚數の上に賭け試みることの冒險にある。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし何様しても天下を敵に廻し、朝命に楯をついて、安倍の頼時や、平泉の泰衡の二の舞を仕て見たところが、骰子の目が三度も四度も我が思う通りに出ぬものである以上は勝てようの無いことは分明だ。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが世の中のお定まりで、思うようにはならぬ骰子の眼という習いだから仕方が無い、どうしてもこうしてもその女と別れなければならない、強いて情を張ればその娘のためにもなるまいという仕誼に差懸った。",
              "citation": {
                "source": "太郎坊",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は過日家を出てから、もうとても今じゃあ真当の事ア遣てる間がねえから汝に算段させたんで、合百も遣りゃあ天骰子もやる、花も引きゃあ樗蒲一もやる、抜目なくチーハも買う富籤も買う。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶詳しく省察すれば輾轉して休まざる一の骰子の或は一を示し或は六を示して居るやうなもので、本是一個物である。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに盆茣蓙の真中に伏せてあった骰子壺が引っくり返ると、和尚の負けになったらしく、積上げられた寺銭が、大勢の笑い声の中にザラザラと崩れて行く。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "仁輪加なんか無論わかりそうにないノッソリした奴が多いのであるが、その中でも代表的と見える色の黒い、逞ましそうな奴が、骰子の目に切った生鰤の脂肉の生姜醤油に漬けた奴を、山盛にした小丼を大切そうに片手に持って、「ええ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は玉の指環があります」　二人は双六の骰子を手にした。",
              "citation": {
                "source": "崔書生",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "投ずべきかな君骰子を――の歌でもやつて呉れ、我願ふところは富にあり――といふ。",
              "citation": {
                "source": "真夏の夜の夢",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "この馬また蹄で地を敲きて嚢中の銭や骰子目を数え中て、主人が名ざす人に物を渡し観客中からもっとも女好きな紳士を選び出し、後足二本で立ったり跳ねたり踊ったり、一六〇〇年バンクスを載せてロンドンのセントポール伽藍の屋頂を越えたという。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一人の男の腹がけの中からは骰子が二つ取出された。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "骰子は投げられたのだと云ったような、思い詰めた心持で、その二階に消える足音を聞いていた。",
              "citation": {
                "source": "真珠夫人",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして汽車の中で、通訳として随行していたＳ氏にノートブックを幾冊となく買わせ、何をするかと思うと、帽子をぬいで、その中へ骰子を二ついれて、帽子を揺り動かしては中の骰子をころがして二つの骰子の表へ出た数の和を記していき、それを記したノートブックが欧州旅行中に十数冊もたまったということである。",
              "citation": {
                "source": "黒岩涙香のこと",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一つは自分が荘家になったときに、骰子の目をごまかして、自分の前の十七憧の比較的左端にある二枚又は四枚にかくしてある飜牌をとることである。",
              "citation": {
                "source": "麻雀インチキ物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、はじめ一寸骰子を振り、人がよく見ないうちに「五だ。",
              "citation": {
                "source": "麻雀インチキ物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一度」と言ってすばやく骰子をとりあげて振り「十三！",
              "citation": {
                "source": "麻雀インチキ物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論本当の骰子の目は五でもなく、二度の合計が十三でもない。",
              "citation": {
                "source": "麻雀インチキ物語",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる倶梨伽羅紋々ふうのものもあったが、そのほかにまたたとえば天狗の面やおかめの面やさいころや、それから最も怪奇をきわめたのはシヴァ神の象徴たるリンガのはなはだしく誇張された描写であった。",
              "citation": {
                "source": "蒸発皿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナポリに勤務しているドイツ兵が警備にあたっていて、トランプやさいころ遊びをやっていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男は、ほかの男の子たちといっしょに駆けまわっていた小さいころから、もうプルチネッラでした。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、ヨハンネスが小さいころにおぼえた、美しい歌でした。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、わたしは、あのぼっちゃまを、小さいころ、昼も夜も、だいてあげたのに。",
              "citation": {
                "source": "アンネ・リスベット",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
