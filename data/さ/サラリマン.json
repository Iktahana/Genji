        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "紳士も、淑女も、モガも、モボも、サラリマンも職業婦人も、ブルもプロも、掏摸も、巡査も動いてはいけない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は立石君に、丸ビルサラリマン生活見学の案内を頼んであるので十一時、家を出て、大阪信託へ行き、オフィスの陣立、月給支払日の光景等いろ／＼話をきく、すべて十月の「ハリキリボーイ」のためである。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "客席を見渡すと、今月は出しものゝ関係か、老人が多い、学生サラリマンが少い、考えるべし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＰＣＬで、「ハリキリ」の中に徳山のサラリマン歌謡てのを入れることにした。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
