        "examples": {
          "standard": [
            {
              "text": "古い駅前の商店街の再開発により、モダンな複合施設が完成した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "都市の再開発計画には、地元住民の意見を反映させることが重要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この再開発事業で、300軒以上の店舗が新しいビルに移転した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "駐車場として使用されていた、ほったらかしのただの空き地は、再開発されて新たな住宅地になった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この店の土地も含めて、付近一帯を再開発し、巨大なショッピング・センターがやがてつくられる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
