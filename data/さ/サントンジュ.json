          "standard": [],
          "literary": [
            {
              "text": "第二編　大市民一　九十歳と三十二枚の歯　ブーシュラー街やノルマンディー街やサントンジュ街などには、ジルノルマンという爺さんのことを覚えていて喜んで話してくれる昔からの住人が、今なおいくらか残っている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのジョルジュ・ポンメルシーはごく若くしてサントンジュ連隊の兵卒であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントンジュ連隊はライン軍に属することになった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "またブルターニュとサントンジュにはラ・モンターニュと名乗る一族がある。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（c）それはわたしの周囲の諸方言、数え上げればポワトゥ弁、サントンジュ弁、アングモワ弁、リモージュ弁、オーヴェルニュ弁などと同様に、ぐずぐず・だらだらした・張りのない・言葉である。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
