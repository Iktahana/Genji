  {
    "uuid": "f94fa084-e916-5ebf-9cb7-d2454be9a600",
    "entry": "さわさわ",
    "reading": {
      "primary": "さわさわ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "のをあある　とをあある　やわあもろこしの葉は風に吹かれてさわさわと闇に鳴つてる。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かすかな気配ではあったが、しかし不思議にも秋風に吹かれてさわさわ揺れている草自身の感覚というようなものを感じるのであった。",
              "citation": {
                "source": "泥濘",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ところが、あの噴水のそばには、あのさわさわと鳴る水のそばには、わたしの愛する人、わたしの生死をその手に握っている人が、たたずんで、わたしを待っているのよ。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでわたしは、あの人と一緒に、あの庭の暗がりへ、木立のそよぐもとへ、噴水のさわさわ鳴る陰へ、姿を消してしまうの……とね」　ジナイーダは口をつぐんだ。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "手が少ないために刈取りがおくれてゐた稻は實もはじけんばかりに熟れ切つてさわさわと音を立ててゐた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗愁なにごとぞ、夕まぐれ、人はさわさわ、新開のはづれなる坂のあき地にうづくまる。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はればれとひびき合ふ　松かぜ、このさわさわ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "青野さわさわや、ひきまとふ我が荒絹、　鴉の、青鴉の　後に蹤きて。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "老鶏さわさわと起つ風の音響けば、鶏は羽ばたきぬ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "下り来て、行きすぎざまに、さわさわと背見せゆく、さわさわの背の薄、またかがやけり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯どころのうしろの山の、秋山の、その柔かき草山の、このもかのもにさわさわと音する薄、穂薄の、今日来て見れば、揺りかがやけり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなあはれ、我も見て、妻も出て、二人ながむるさわさわ薄、そのさわさわ薄。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "孟宗と月さわさわと揺るるものあり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "目か醒めし、夜風か出でし、さわさわと揺れて遊べり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "目に見えてさわさわさわと、照り浮ぶ孟宗の、あな、一きは強き狐光のその月に、さながら生きて踊るかに、近明りして、勢ひ舞ふ、かと見ればまた、何か暗く薄かげりして、揺らぎ止み、揺らぎ騒立つ。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "揺れそよぎ、独り遊ぶと、揺れそよぎこの目の外に、またさわさわと音立ててゐる。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "下りて来て、行きすぎざまにさわさわと背見せゆく、さわさわの背の薄またかがやけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯どころのうしろの山の秋山のその柔かき草山のこのもかのもにさわさわと音する薄、穂薄の、今日来て見れば、揺りかがやけり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "孟宗と月　さわさわと揺るるものあり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "目に見えてさわさわさわと、照り浮ぶ孟宗の、あな、一きは強き、狐光のその月に、さながら生きて踊るかに、近明りして勢ひ舞ふ、かと見れば、また、何か暗く薄かげりして、揺らぎ止み、揺らぎ騒立つ。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "揺れそよぎ、独り遊ぶと、揺れそよぎ、この目の外に、また、さわさわと音立ててゐる。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆の一叢舟に触れて、さわさわと声するをりから、岸辺に人の足音して、木の間を出づる姿あり。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "小川の直ぐ向ふの笹籔が、サワサワと秋風に吹かれて音立てゝゐた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝六時頃、この見附を、客人で通りました時は、上下、左右すれ違うとサワサワと音がします。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "灰色の女学校がある、石塀の中からは、たそがれ色の往来へ若葉が吹きこぼれて、サワサワと葉ずれの音をたてゝゐる。",
              "citation": {
                "source": "瑪瑙盤",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "処女の体を呑んだ紙帳は、ほんのちょっとの間、サワサワと揺れたが、すぐに何事もなかったように静まり、その上を、眼白や頬白が、枝移りしようとして翔けり、その影を、刹那刹那映した。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半分意識しているのね、他の半分の意識が変に明るいようなサワサワしたような工合で、盛にうわことが云いたい気がするの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "蟻があわてて駈け廻って、その御飯粒をくわえ、サワサワ音が聞えそうに、足を動かして逃げ出した。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云うそれだけのうちで、何を訊ねようにも種が無いので、先生が後を向ききりになると一緒に、今までひっそり閑としていた教室中には、急に小蜂のうなるような囁や、せわしい身じろぎの音が、一しきりサワサワ、サワサワと鳴り渡った。",
              "citation": {
                "source": "面積の厚み",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「念には及ばぬ」　やがて、刀を提げる音、サワサワと鳴る袴の音。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
