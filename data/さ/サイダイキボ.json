        "examples": {
          "standard": [
            {
              "text": "その地震は国内観測史上最大規模のもので、広い地域に甚大な被害をもたらした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "今年の花火大会は最大規模の打ち上げ数を誇り、全国から多くの観客が集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "政府は過去最大規模の経済対策パッケージを閣議決定したと発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "最大規模の拡張ベーシックと名付けられた一二Ｋバイト版は、単体では七五〇ドル。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＩＢＭ ＰＣ用のベーシックのもととなったのは、沖電気のｉｆ８００用に書かれた八ビット機用としては最大規模を誇るバージョンだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この最大規模の実験を活用するのに必要なのは、コレラの致死的な襲撃が起きるかも知れない個々の家にどの会社の水が供給されるかを、知ることだけがすべてであった。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドミン　もう史上最大規模で動き出しているんだ。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            }
          ]
        }
