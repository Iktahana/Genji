          "literary": [
            {
              "text": "」じゃむこうに御託の昼間の書信｜慥に落手いたし候、好材料に候えども、お前様身に取りては極めて危険なものを見られ候。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田君は神学校へ入ったが、赤羽君は私達同様身の振り方がつかない。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
