        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サヴエート同盟の市街、ブラゴウエシチェンスクと、支那の市街黒河とを距てる「海峡」は、その日から埋められた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "演説を傍聴さしてもらうぞ」　支那人、朝鮮人たち、労働者が、サヴエート同盟の土を踏むことをなつかしがりながら、大きな露西亜式の防寒靴をはいて街の倶楽部へ押しかけて行った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして国境外では、サヴエート同盟に物資が欠乏していると、でたらめを飛ばした。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーブル紙幣は、サヴエート同盟の法律によって国外持出しを禁じられていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっぱい喰わされたのはサヴエート同盟だった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本軍が撤退すると、サヴエート同盟の経済力は、シベリアにおいても復旧した。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "火酒がだめになると、今度は贅沢品でサヴエート同盟の資本主義的分子を釣った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからおもむろに、支那人の手によって、国境をくぐりぬけ、サヴエート国内へもぐりこんで行った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "商品とかえられて持ちだされてきいたルーブル紙幣は、十二銭内外で、サヴエート国内でただ一カ所密売買をやっている、浦潮の朝鮮銀行へ吸収されて行った。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、漁業会社は、普通相場の五分の一にあたる安いルーブル紙幣を借区料としてサヴエート同盟へ納めるのだった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうすれば、こういう側面からのサヴエート攻撃の根を断つことができるか！",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
