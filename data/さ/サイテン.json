[
  {
    "uuid": "91127167-bfb4-5992-aca9-8a7e267eabb4",
    "entry": "再転",
    "reading": {
      "primary": "さいてん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
