          "literary": [
            {
              "text": "予等ノ所持品ハ没収サレタリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ、彼ニ従フトコロノモノモ、屈強ナル壮年男子ニ限リタレドモ、コノ信神渡航者ノ一行ニハ、オヨソ信仰ヲ共ニスル限リ、老幼男女ノアラユルモノヲ抱容スルコトヲ許サレタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此人民ハ敬神ノ心乏カリシヲ以テ、「ゼウス」神ノ爲ニ絶ヤサレタリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○三時代ノ前後ヲ示ス好例ハ「スウィッツァーランド」ノ湖ノ底ト「デンマルク」ノ※炭層トニ於テ發見サレタリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃、総督ノ愛顧ニ狎レテ、トカク盗ミヲ働キ、ソノ※品ヲ、自己ノ小僕部屋ニ匿シオキ、十五日夜半モ又、夫人ノ深窓ヨリ金銀珠玉ヲ盗マントシテ、ツイニ衛兵ノ手ニ縛サレタリ　重罪ノ上、更ニコノ重科ヲ重ネタルカド、尋常ニ非ズ、中央ノ処断ヲ待ツノ間、土牢ヲ申シ付ク「やっぱりおれは騙されていたのか？",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
