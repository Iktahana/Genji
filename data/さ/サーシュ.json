          "literary": [
            {
              "text": "「サーシュカ、半壜買って来い！",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "お父さんや、お母さんや、ワアニヤ叔父さんや、ドウーニヤ叔母さん、それから、けんか相手の弟のレワにボーリヤと、目の黒い妹のサーシュにもあへるのです。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーシュカもまねをして、こはれたお人形をもつてきました。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とサーシュカがいひました。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            }
          ]
        }
