    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "天變を重大視した古の史籍に見ゆる記事や、野蠻人をして初めて鐡の用を知らしめた西大陸の事實や、禪僧をして詩を賦せしめた落星灣の口碑、凡そ此等の事の載籍に見ゆるものは少くないにしても、實際は何程多かつたことか知れぬ。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに載籍に考ふるに、千蔵は頼公遷の通称である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "載籍調べも研究ではないか。",
              "citation": {
                "source": "妄想",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "載籍以来の昔より今日並に今後迄一行に書き将ち去るべき歴史の本項なり。",
              "citation": {
                "source": "文士としての兆民先生",
                "author": "幸徳秋水",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度食事の頃だったので、マダムは昼餉のテーブルに鶴子を案内して、亡夫の遺著を編輯するについて、第一に社寺または古器物の写真の不足しているのを補うためにこれを買集める事、第二には仏蘭西の本邸に儲えてある東洋の書画載籍の整理を依嘱するため適当な日本人をさがして本国へ同行したいという事を語った。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "）原文夫學者載籍極博。",
              "citation": {
                "source": "國譯史記列傳",
                "author": "伯夷列傳第一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
