        "examples": {
          "standard": [
            {
              "text": "東京、大阪、名古屋の三大都市を巡る出張スケジュールは、移動距離が長くて体力的にきつい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "三大都市圏に人口が集中しすぎることで、地方の過疎化が進むことが社会的な課題となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「三大都市を新幹線で結ぶルートは、まさに日本の経済の背骨と言えるだろう」と経済評論家が述べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "試みに三大都市の住民の学校程度の比例をとつてみると面白いが、これは誰も正確に数字を云ひあてることはできない。",
              "citation": {
                "source": "都市文化の危機",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
