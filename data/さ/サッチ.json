[
  {
    "uuid": "fbb88623-b530-500a-bb2c-c8893c350a0d",
    "entry": "察知",
    "reading": {
      "primary": "さっち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-サ変",
