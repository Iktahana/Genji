        "examples": {
          "standard": [
            {
              "text": "物干し竿として、丈夫なさお竹が使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "縁日でさお竹屋さんが「さお竹ー！」と独特の声で呼び込みをしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭の奥に立てかけられたさお竹は、年季が入って良い色になっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「あたしゃただの躯じゃないんだからね」とみさおは主張する、「あたしのおかずはべつにするよ」　たとえこまぎれ肉にしろ鮪のあらにしろ、みさおだけは一と皿べつにおかずをつける。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
