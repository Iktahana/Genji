    "definitions": [
      {
        "index": 1,
        "gloss": "stand-up paddle surfing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
