          "literary": [
            {
              "text": "白い顔の男や、サムプルのやうに洋服を着た女が、相もかはらずぞろ／＼歩いてゐた。",
              "citation": {
                "source": "青い風",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでに布地のサムプルも一緒に封入しておきましたからお心のまゝにお選びになつて下さい。",
              "citation": {
                "source": "〔婦人手紙範例文〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "巖本さんからの手紙、何とも云われない、女らしい、あの人の肉体そのままのしなやかな、サムプルな、もの。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らくは世界を支配する彼等のサムプルとするにも足りないものであらう。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
