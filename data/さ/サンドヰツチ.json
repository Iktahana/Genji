        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サンドヰツチを、二切たべて、よした。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とさきばしつて、大船のサンドヰツチ、國府津の鯛飯、山北の鮎の鮓と、そればつかりを當にして、皆買つて食べるつもりの、足柄に縁のありさうな山のかみは、おかゝのでんぶを詰らなさうに覗きながら、バスケツトに凭れて弱つて居る。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にサンドヰツチが沢山這入つてゐる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "籃を取り巻いた連中は、サンドヰツチを食ひ出した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂車の附いてゐる車であるのに、持つて乗つたビイルの栓を抜いて、革包からコツプを出して飲んで、折詰のサンドヰツチをむしや／＼食つてゐる。",
              "citation": {
                "source": "魔睡",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うを見れば、サンドヰツチの男は口を開いて鼾をかいてゐる。",
              "citation": {
                "source": "魔睡",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅麺麭のやうな二宮宗に、ちよつぴり性慾を撮み込んだ、恰でサンドヰツチのやうな女が生るに相違ない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大船でサンドヰツチを買つた時から、Ｍ君は帳面方を引受けて居て呉れた。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場からサンドヰツチでも買つて、お午過ぎまで遊んて來ませうよ。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サンドヰツチ、喰べようか。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも袋からとり出したサンドヰツチを指先につまんだまゝ空腹も忘れたかのやうであつた。",
              "citation": {
                "source": "山峡の村にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「妾、サンドヰツチ持つて行くわ、先生のお部屋で喰べられて――」「掃除しておきませう。",
              "citation": {
                "source": "女に臆病な男",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さかんに呼んでやがら、不良共が――」　百合子は片手を高くひらひらと伸して、「サンドヰツチをあげるから、あがつておいで……」　と叫んだ。",
              "citation": {
                "source": "まぼろし",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処で、バスケツトを開いて玉子のサンドヰツチを喰べた。",
              "citation": {
                "source": "Ｆ村での春",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツセ・アングレエズ」、「サラド・ルツス」其れからサンドヰツチを油で揚げた様な物で名が解らないから仮に梅原が名を附けた「サンドヰツチ・ムネ・シユリイ」に「タルト」と云ふ菓子。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯いつも變らないのはサンドヰツチマン位なもので、二歩あるいて三歩止どまり、三歩あるいてはちからない咳をして居た。",
              "citation": {
                "source": "星より來れる者",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもサンドヰツチマンだけはべつな車道と人道との間をこつこつあるいて、悲しや「戀はやさし」の唄を唄ふのである。",
              "citation": {
                "source": "星より來れる者",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
