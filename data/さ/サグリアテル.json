[
  {
    "uuid": "d48f0362-5db9-5e0f-ba03-eccf1c8e7a59",
    "entry": "探り当てる",
    "reading": {
      "primary": "さぐりあてる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
