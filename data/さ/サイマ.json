        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミナサン、ゴキゲンヨクオヤスミナサイマセを云ったあとですよ。",
              "citation": {
                "source": "人造人間事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……中に、ステパンの会話の力で判断してだろう、片仮名で、「オナツカシキペテロフサマ、ソノゴオカワリモアリマセンカ、ユウベ、マテイタノニキテクダサイマセン、ナゼデスカ、シドイシト、ワタシノココロモシラナイデ。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "隙を見て巡航船へ避難し、ほうぼうの態でヴォクセニスカをあとにサイマ湖へ出た。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かしら新しい宗教の発祥地として運命づけられていなければならないこのサイマ湖！",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実私は、このときサイマ湖上の無韻の音をその生長の行進曲と聞いたのだった。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "一日一晩、船は神域のサイマ湖を航行した。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人は袋のようなサイマの水路を自分の掌みたいに心得ていて、そしていつも船橋に立ってアナトウル・フランスを読んでいた。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "また別の船でサイマ湖を奥へ進む。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月九日さよなら　幸恵より　愛する御両親様　　　　　　　　御前に伊藤元子宛（北海道・名寄）大正十一年五月頃（東京発信）御タヨリヲ下サイマシテ、ホントウニ有難ウゴザイマシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、オ母サンハモンコチヤンニモ、ワンコチヤンニモ、ニヤンコチヤンニモ、ソレゾレオイシイオ菓子ヲ下サイマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその紫花のものを特にフジマメ、カキマメ（垣豆の意）、ツバクラマメ、ガンマメ、ナンキンマメ、ハッショウマメ、センゴクマメ、サイマメ、インゲンササゲ、トウマメといい、この漢名は鵲豆である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御療治ノ最中ニ失礼ダト存ジマシタケレド、先日颯チャンカラオ願イシマシタラ御承知下サイマシタソウデ誠ニ有難ウゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ／＼伯父サンハイクラデモ長生キナサイマスナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ直グ脈ヲ取ッテ見テ、「プルスガ九十以上ゴザイマスネ、ドウカナサイマシタンデスカ」「イヽヤ別ニ」「血壓ヲ測ラシテ戴キマショウ」否応ナシニ書斎ノソファニ寝カサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ不思議デゴザイマスネ、無理ニ力ンデ堅イオ通ジデモナサイマシタカ」「イヽヤ」「何カアッタンジャゴザイマセンカ、ドウモ不思議デゴザイマスネ」佐々木ハ頻リニ首ヲ傾ゲテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外デハアンマリアンナ真似ハナサイマセン、旦那ガ御覧ニナッテイラッシャル時ニヨクアンナ真似ヲナサルンデス」ト野村ハ云ウガ、ソウダトスレバ、コレモ予ヲ揶揄スル積リナノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウナサイマスカ、博士モ決シテ無理ニスヽメテハオラレマセン、オ気ガ向カナケレバオ止メニナッタ方ガヨロシイト云ッテオラレマスカラ、マアヨクオ考エニナリマシテ、―――」コノ間ノ晩、子供ニ不意討チヲ喰ッテ泣カサレタコトガ未ダニ胸ニ残ッテイ、コンナ場合ニ何トナクアレガ不吉ノ前兆ノヨウニ思イ出サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデ結局墓石ノ形式ハドレニオ決メナサイマスカナ、実ニイロ／＼ト専門家モ及バヌホド御存知デイラッシャイマスノデ、私ナゾハ何トモ申シ上ゲヨウガゴザイマセンガ」「僕自身モドウシテイヽカ分ラナイノデ迷ッテルンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜ハオ寒ウゴザイマスカラ明日ニナサイマシタラ」佐々木ガ驚イテ制シヨウトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鄭板橋ノ書ガゴザイマスガ御覧ニナッテ下サイマスカ」「ソレヨリ君、突然妙ナオ願イヲスルヨウダガ、アッタラ売ッテ貰イタイモノガアルンダ」「何デゴザイマス」「紅絹ノ裂ヲ二尺バカリト布団綿ヲ一ト塊、分ケテ戴キタインダガネ」「変ッタ御用ヲ承リマスナ、一体何ニナサルンデ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、気を落ちつけ、何かいおうと試みては、なおもつきあげてくる笑いを押えようとして息をつめている父親に、「饅頭か、リンゴか、サイマットか」と、その好物を一つ一つゆっくりとたずねた。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイマットとはパイナップルという重吉の言葉であった。",
              "citation": {
                "source": "暦",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "民部サマカラ若君ヘ申シアゲテクダサイマシ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノコトワ、本ヲヒロウタ人ニキイテ下サイ、サウシテワタシヲ此所カラダシテ下サイ、アナタワ、キレイデ、カシコイ人デスカラ、キツト助ケテ下サイマス。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
