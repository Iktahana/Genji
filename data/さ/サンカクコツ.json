        "examples": {
          "standard": [
            {
              "text": "転倒して手首を強打した彼は、レントゲン検査で三角骨に骨折が見つかり、ギプスで固定された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "解剖学の実習で、三角骨が月状骨や有鉤骨と関節を形成していることを模型で確認した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "手根骨のなかでも三角骨は骨折しにくい部位だと医師に説明されたが、強い衝撃には注意が必要だという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "親骨の三角骨だけ楽にとれる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
