        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ハネると、土屋・石田・大庭を連れて、サンボアへのみに行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、石田・大庭・伊東を連れて、サンボアでのみ、竹梅へ行って散財する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、渡辺を連れて、サンボアからジャパン、すしを食って帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて屋井とサンボアでウイをのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、藤山一郎来り、北浜のサンボアへ行き、結婚一年の乾杯をする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、藤山・大庭とサンボアへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、サンボアから、むしゃくしゃするので竹梅へ行き、ダレながらのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、サンボアでのみ、又々竹梅へ行って、意味なくのびる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺を誘って、サンボアへ、明石鯛の味忘れられず、野田屋からとらしたのを肴にのむ、うまい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥田増雄来たり、サンボアで乾杯し、南へのして大和屋の地下で又のむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "北浜のサンボア迄のして、カメオなんていゝのがあるので快く飲む。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時すぎたので打ち切り、藤山・サトウ・石田を連れてサンボアへ、ウイをのみ、帰りにヤキメシを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネてサンボアへ山野・大庭とで行くと、小田末造がゐた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンボアの酔客中、味覚通らしいのが一寸面白いことを言った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、又サンボアへ、弘美館のオルドヴルとって食ひ、野球ゲーム五千五百以上入って十銭でカクテル一杯のんだ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネてから、雨の中を又サンボアへ行き、南へ出てパオンてふバアへ入る、きたなくてつまらず。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、サンボア行き、すしやで、ロクローの悪口を言ふその心根のいやしさに石田を怒る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "白井鉄造夫妻見物、少々風邪気味、サンボアでのみ早目に帰宿し、ルゴール塗り、アスピリンのんでねる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて又サンボア、紀の松てふ料理屋でよせ鍋が名物とあり、食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、又サンボアへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、サンボアへ呼び、ウイスキソーダでプロヂットする。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて又々サンボア、正弁丹吾のおでんとって食べる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "又サンボア、軽く飲み、伊東・山野で歩いて帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、サンボアへ行き、弘養館のカツとオムレツとって食ふ、帰宿一時すぎ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "織田信恒子爵来り、明日満州へ出発とのこと、サンボアへ案内し、南の万花てふ魚すきへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物のバルベ・ルキエン・レヴィーの三外人とサンボアへ行き、チェリオ／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンボアへのして、ウイをのむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハリキリボーイズ四人を連れてサンボアへ行き、飲ませる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、自転車の鈴木義豊を誘って、サンボアをふり出しに、パオンへ行き、すしを最後に。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネ頃三郎が来り、大庭・石田・伊東を連れて、サンボアへ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
