        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "参勤は、江戸幕府が諸大名を統制するために設けた制度である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "加賀藩の参勤は、その規模の大きさで特に有名だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「参勤の道中って、どれくらいの費用がかかったんだろうね？大名も大変だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
