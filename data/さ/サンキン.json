  {
    "uuid": "4643da9e-b66d-53ce-bc4b-4d5987520f01",
    "entry": "参覲",
    "reading": {
      "primary": "さんきん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
