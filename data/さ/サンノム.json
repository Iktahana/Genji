        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は、マハン・サンノム老人の経営する素人下宿に住居しているのだった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンノム老人は、神のように心の広い人で、元は船長であったそうだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "水戸がこの家へ下宿するようになったのも、この三平が薦めたものであって、どういうわけかサンノム老人を贔屓にしていた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はサンノム老人の姪で、水戸なんかの泊っている下宿屋で働いていて、主人のサンノム老人を助けていたのだ。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケノフスキーが水戸と同じくサンノム老人の下宿にいることは勿論知っていた。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミリーはサンノム老人の下宿の勝手許から、白いエプロンで手を拭きながら出て来た。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンノム老人の下宿へも帰れない現状において、どうしてエミリーに会えるだろうかというのだった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
