          "literary": [
            {
              "text": "其ノ屍体ハ油倉庫ノ中ニ投ゲ入レラレ、放火サレタカラ灰ニナリマシタ。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄サンガ何故殺害サレタカ分リマセンガ、其ノ殺害ヲ一番早ク云イ当テタノハ動坂三郎氏デス。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "訊問一、鞭打チニヨル（訊問予備）　「ナゼオ前ハ逮捕サレタカ」と質問スル。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハコレヲ読ミサエシナケレバ、意識ヲ失ッテイル最中ニ何ヲサレタカ知ラナイハズナノデアルカラ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
