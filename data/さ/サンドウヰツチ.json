          "literary": [
            {
              "text": "サンドウヰツチ売の爺は驚く。",
              "citation": {
                "source": "緑の種子",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち汽車に附着いて来た新らしい野菜の匂が新聞やサンドウヰツチの呼声に交つてプラツトホームの冷え冷えした空気に満ちわたつてゐる。",
              "citation": {
                "source": "新橋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それより後方の甲板に立食場は開かれ、案内致されし私は僧正の君の勧めにて、サンドウヰツチ、アイスクリイムなどの御馳走を戴き候。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻　　あたし、サンドウヰツチ買ふの。",
              "citation": {
                "source": "紙風船（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫　　よし、おい、サンドウヰツチ。",
              "citation": {
                "source": "紙風船（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
