        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ルーベンスやゲーンスボローやないしはアルマタデマに無くしてセザンヌ、ゴーホあるいはセガンチニなどに存するところのものである。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョコンダの絵と、ルウベンスの模写が出ている。",
              "citation": {
                "source": "二科会その他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョコンダの模写を見ると本物の価値が始めてよく分るし、ルウベンスの模写を見ると、ルウベンスの大幅が到る処のギャレリイにのさばっている理由が明白になると思う。",
              "citation": {
                "source": "二科会その他",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "物理学輪講会はルーベンスが座長であったがプランクもほとんどいつも欠かさず出席してこの集会の光彩を添えていた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻眼鏡でぬうっと澄ましていて、そうして何でも実によく知っているルーベンスの傍に、無邪気で気軽く明るいプランクがいて、よくわれわれでも知っているような実験的の事実を知らないで質問する、若い連中が得意になってそれを説明するのを感心して謹聴していた。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "容貌も醜くないルーベンス型に属していた。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィレンチェ派学ぶはミケランジェロ、ヰンチイが幽霊、和蘭派学ぶはルウベンス、ファン・ヂイクが幽霊、我国のアルブレヒト・ドュウレル学びたりとも、アルブレヒト・ドュウレルが幽霊ならぬは稀ならむ。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラシカルな、ルーベンスなどに非常に能く似たような絵も描いている。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "半月形をしたルーベンス眉や、唇の両端が釣り上ったいわゆる覆舟口などと云うのは、元来淫らな形とされている。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "リエベンスタイン城も同様で母が人柱として子を賣つた。",
              "citation": {
                "source": "人柱の話",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この手は、ルーベンスの素描を參考にして描いたのだ。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーベンスは日本になくたつていいし、ダ・ヴインチは世界に一人あればもう澤山だと思つたが、この青年に言つても無駄だから、その事は默つて歸した。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ベンスン殺人事件』『カナリア殺人事件』『グリーン殺人事件』『僧正殺人事件』その他に近作一つと都合五つの長編小説を著わし、他に若干の短編小説がある。",
              "citation": {
                "source": "ヴアン・ダインの作風",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに大実業家の家だけあつて実に堂々たるものだ、階段の壁の所に、ルーベンスの三人の女が立つている、なんとかいう画の写真がかかげてある。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さつきのルーベンスの『ドライ・グラチェン』に気がついたかい。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはルウベンスの描いた「宝角を持つ三人のニンフ」であった。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから怪盗はこのルウベンスの名作に必ずや手を出すにちがいないと思った。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあ、さすがはルウベンス。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウベンスの「宝角を持つ三人のニンフ」の画面をじっと見ていたが、やがて軽くうなずくと、小さい机を傍へ引寄せ、その上に黒い包を載せて、解いた。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵具の材料も吟味はしてあるんだが、なにしろルウベンスそっくりの筆致を出したところは恐れ入った。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはルウベンスの「宝角を持つ三人のニンフ」に似た怪画であった。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると怪しむべし、画面のニンフや宝角が急に薄れて行き、一分半ばかり経つと、ルウベンスの画はすっかり消え去って、その替りに、その下から拙劣な林間を画いた風景画に変ってしまった。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはどうだ」　と烏啼の愕くのを、にやりと笑った袋探偵は、「これでお分りでござろうが、手前の方にも模写の腕達者が控えて居りましてね、風景画の上に、ルウベンスの名画を一夜で描きあげる画家が居ますのさ。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "レムブラントを詩とし、ルーベンスをゴブラン織として。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "立派な牛舎に桃色の乳房をぽってりと垂らしてルーベンスの描いた女のように、つやつやと見事にねそべっていられず、自分のしっぽで、べたくそのすこしついたおしりの蠅を追いながらのたのたといろんな坂や谷を歩いてゆく、そういう牛でいいと思います。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜はヴェルハーレンのかいたルーベンスの伝記、活字が大きいので読んで面白うございました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーベンスの偉大さと美しさと無意味さが公平に見られていて、この詩人が一方でレンブラントを書き、優れたレンブラント伝とされているのも興味があります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーベンスの浅薄さとよろこびの横溢を理解してその対蹠的芸術家として真の大芸術家としてレンブラントを書いているのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "決定的なものだが、ルーベンスなどはそういう人間のつきつめたもの、その真実、そういう永遠性はちっともないと云っているのは本当ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
