  {
    "uuid": "35bfb45b-5c0a-55fc-8db7-9150f01e0612",
    "entry": "篦棒",
    "reading": {
      "primary": "べらぼう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "篦棒奴、娘が可愛ければこそ、己れだってこんな仕儀はする。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「其※こと云つたつ位、打ん擲らつら篦棒臭え」打ち消す聲が聞えた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「篦棒、さうだ軟けえ面で風吹く處歩けるもんぢやねえ」爺さんはむきに成つていつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「篦棒、以前のことなんぞ、外聞惡りい、俺らなんざこんで隨分無鐵砲なこたあしたが、こんで女にや煎れねえつちやつたから」と首に珠數を卷いた爺さんが側でそれを見て居て呶鳴つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「篦棒いつまでたつても夫婦にも成れねえやうな奴等なんでやつかむかえ。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「篦棒に寒い晩だなどうも」　と又四つ又は火鉢へ手を翳す。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「篦棒め、イナゴもバツタも同じもんだ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「篦棒め、イナゴもバッタも同じもんだ。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人間という動物は自惚れと迷信で固まっているものだ」ぐらいの事はウスウス知っていないではなかったが、それにしてもコンナまで篦棒なものであろうとは、この時がこの時まで気が付かなかった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな篦棒な話があるものか……と云うんだろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "話が篦棒に固苦しくなった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "篦棒めえ、キチガイだって腹は減るんだ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『何をパチクリしていやがるんだ篦棒めえ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……何だ……貴様は社会主義者か……」「……篦棒めえ人道主義者だ……このまんま帰れあ死体遺棄罪じゃあねえか。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ若かったもんだから……篦棒めえ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ篦棒な苦心した機関長はタントいないだろうと思うがね。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな篦棒な話が在るかって反対もしてみたんですがね。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "波打際の恰好に見おぼえがあるんだ」「篦棒めえ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヒヤア、抜ける抜けるとか何とか詰らねえ声を真夜中出しやがるんで……篦棒めえ、抜ける程の別嬪と思ってやがるのか……ってんで、背中を一つドヤシ付けてやりましたらヤット正気付きましたがね。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……妙な性分であっしは気が長い時にゃヤタラに長いんですが、何かの拍子にカーッとしちまうと、それから先が盲滅法に手ッ取り早いんで……篦棒めえ日本人じゃねえか。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな篦棒な話が……」「イエイエ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "篦棒めえ、誰だと思っていやがるんだ」　と大見得を切って立ち上っても、臆病者の鼻の表現は必ず魘えた色を見せております。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「身体は売っても心は売らぬ」という篦棒なのが出て来るのもこの意義からであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エエッ……コンナ篦棒な……不公平な……。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはあんまり篦棒な話で、多分、或るデモ主義者かゴロ付きの一人が思い付いてやった事を、市会議員の所業と結びつけた一片の噂に過ぎないであろうが、それにしても、こんな事にまで結び付けられ易い、東京の或る種の市会議員の平生の素行が忍ばれるではないか。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もこの式の習慣は日本全国にあるのであるが、彼等の「カリ」はタチがタチだけによっぽどヒドかったらしく、しかもそれが又彼等のプライドと結び付いて、篦棒に利くパスが出来上ったわけである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "篦棒に高い金を出したものよ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも、相手のそんな篦棒な太っ腹が本当らしく思われなくなったので、彼は肚の中でと思った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "へん篦棒め何が当城だ。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなべら棒な話ってあるかい。",
              "citation": {
                "source": "老年と人生",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
