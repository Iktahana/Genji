[
  {
    "uuid": "9fe0b8ed-1625-5d43-8a5a-6045c33a7040",
    "entry": "箆棒",
    "reading": {
      "primary": "べらぼう",
      "alternatives": [
        "ベラボー"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "extreme",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その要求は、べらぼうに高すぎた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「これはべらぼうだ！」と彼は怒鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はべらぼうな値段で品物を売りつけようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「一円九十銭の日当の中から、日に、五十銭の米を二升食われて、九十銭で着たり、住んだり、箆棒奴！",
              "citation": {
                "source": "セメント樽の中の手紙",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷物の重いばかりでなく、箆棒に前途ばかり急いで、途中ろくろく休む事も出来ねえ。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えゝ、箆棒、一日の手間鍛冶屋へ打つ込んちあなくつちやなんねえ」彼は呟いた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日は若え衆等行くと思つてはあ、夜まで置けねえんだな」「極つてらあな」「そんだつて箆棒、若え衆等だつてさうだことばかりするものぢやねえ、詰んねえ」憤慨してかういふものも「外聞惡いも何にも知んねえんだな」嘲笑の意味ではあるが何處となく沈んで又斯ういふ者も有つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんでも、南のおつかさん行きたけりや連れてくつちつたんだぞ」「箆棒、そんなことされつかえ、踊なんざあ後幾日だつてあらあ、今夜らつから行かねえつたつてえゝから、他人に云はれつとはあ、其れに乘つてあふり／＼出たがんだから」勘次は一｜概に叱りつけた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「箆棒に大かく成つたつけな、此の馬鈴薯はなあ」一人がいつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えゝ箆棒な」と相手はいつて畢つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「箆棒に迂遠つけえ唄だな、此の夜の短けえのに眠つたく成つちやあな」側から惡口を吐いた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「箆棒、つん燃したくつて、つん燃すもの有るもんか」爺さんは少し激して「過失だもの後で何ちつたつて仕やうあるもんぢやねえ」と獨で力んだ。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふ皮膚病に罹つて鹽湯に入ると箆棒に痛痒い。",
              "citation": {
                "source": "南太平洋科學風土記",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先日も前大統領タフト氏が田舎に旅行して、途中で道連れになつた農夫を相手に、近頃農産物の値段が箆棒に高くなつた事を話して、「まるで以前の三倍もの値がするのだから遣りきれない。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気灯のつく今日そんな箆棒な話しがある訳がねえからな」と王様の肩へ飛車を載せて見る。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで免状をもらって、連隊へ帰って来ると、連隊の方でも不思議に思って、そんな箆棒な話がある訳のもんじゃねえ、きっと何かの間違だろうッてんで向へ聴合せたんだ。",
              "citation": {
                "source": "躯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、じっと眼を据えると、ふん、こいつも箆棒だ、誰も覗いちゃいねえじゃねえか。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "』ちえつ、箆棒め、顏はといへば、膀胱の氷嚢みたいで、縮れた一つまみきりの前髮を頭の天邊へ持つて行つて、油で變な渦卷型に固めつけてゐれあ、それでいつぱしのど偉い人間のやうなつもりでゐやあがるんだ。",
              "citation": {
                "source": "狂人日記",
                "author": "ZAPISKI SUMASHEDSHAWO",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寒いッたッて、箆棒に寒い晩だ。",
              "citation": {
                "source": "今戸心中",
                "author": "広津柳浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何を、箆棒、怖いものか」「行け！",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに探しても目つからないなんて、どう考えたって箆棒だよ。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからチョロッカにその辺りに、うっちゃってあろうとは思われないが、盗みにかけちゃ俺らは天才、その俺様が克明に、こうも手順よく探すのに、目つからないとは箆棒だよ。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えい箆棒、気を付けろい！",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "箆棒め、先生だつて、出来ないのは当り前だ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "箆棒め、先生だって、出来ないのは当り前だ。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "明かるい空を見て、しょぼしょぼした眼を、二三度ぱちつかせたが、箆棒め、こう見えたって人間でえと云った。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――実に田口という男は箆棒だね。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "騙された君よりもよっぽど田口の方が箆棒ですよ」　敬太郎には騙された自分の方が遥かに愚物に思われた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの箆棒の田口に、一つ取柄があると云えば云われるのだが、あの男はね、いくら悪戯をしても、その悪戯をされた当人が、もう少しで恥を掻きそうな際どい時になると、ぴたりととめてしまうか、または自分がその場へ出て来て、当人の体面にかかわらない内に綺麗に始末をつける。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ行くと箆棒には違ないが感心なところがあります。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでも田口が箆棒をやってくれたため、君はかえって仕合をしたようなものですね」「なぜですか」「きっと何か位置を拵らえてくれますよ。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしぁ、べらぼうめ、そんな苦情は、おれのとこへ持って来たって仕方がねえや、ばさばさのマントを着て脚と口との途方もなく細い大将へやれって、斯う云ってやりましたがね、はっは。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「べらぼう」も引き合いに出たが、これについて手近なものは 〔(Skt.)prabhu_〕 また parama でいずれも「べらぼう」の意がなくはない。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
