          "standard": [],
          "literary": [
            {
              "text": "日本で始めてイタリーのベルカント唱法を教えたのはサルコリィでした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "堕落したがってる上流の若い娘らにとっては、ベルカン式の好読物だった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸屋根の背後の壁はちょうど、ベルカン（訳者注　フランスのやさしい叙情詩人）の向こうに見ゆるミルトンのごときものであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュワルツの発声法は、ベルカント風にドイツ風を加味したもので、イタリー、フランスのオペラにもよかったが、ワーグナーにもまた我らが想像し得る最高の美しい表現を与えた。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
