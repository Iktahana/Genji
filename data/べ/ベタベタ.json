        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "油絵具をキャンバスにベタベタと厚く塗っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は壁にポスターをベタベタと何枚も貼っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お好み焼きのソースをベタベタと塗って食べるのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
