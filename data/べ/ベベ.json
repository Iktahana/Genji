  {
    "uuid": "b4b21a5e-cc84-5b97-9fe3-cadd3a710087",
    "entry": "ベベ",
    "reading": {
      "primary": "べべ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
