[
  {
    "uuid": "01c3973c-2b92-5d63-a291-1c1eef45e5e5",
    "entry": "べった",
    "reading": {
      "primary": "べった",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
