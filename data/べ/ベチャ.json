        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしたら、ジャピイ食べちゃった。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この、うなぎも食べちゃおうか。",
              "citation": {
                "source": "メリイクリスマス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、恋のへちまのと、べちゃくちゃ喋るのが面倒だった。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきれたばかですねえ、僕の話聞こえますか、僕の……」「若さま、さっきから何をべちゃべちゃ言っていらっしゃるのです。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一、ノルデは三べん胴上げのまま地べたにべちゃんと落とされた。",
              "citation": {
                "source": "ペンネンノルデはいまはいないよ　太陽にできた黒い棘をとりに行ったよ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "べちゃべちゃと喋らずと、早く仕事を片付けるんだ！",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "また黒いちごや、オランダいちごをつみにきて、そこいらじゅうおもしろそうにかけまわって、べちゃくちゃおしゃべりしている百姓のこどもたちも、気にかからないようでした。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれが出て行くとそこらを片着け多勢の手で夕飯の餉台とともにお櫃や皿小鉢がこてこて並べられ、べちゃくちゃ囀りながら食事が始まった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の荷造りをする男と、一緒に仕舞湯へ入ってべちゃくちゃしながら、肌の綺麗な男の背を流しなどしているところを、台所働きに見られて、言いつけられた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ろくでもねえことをべちゃくちゃとやる暇があったら、晩のお総菜の才覚でもしておきな」「いいえ、そりゃいたしますがね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "右門はべちゃくちゃとさえずっている岡っ引きの伝六をあとに従えて、ずいと中へはいっていきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべちゃんはどこへ行ったときいたとき、けわしくねめつけた父親のまなざしも疑惑を強める種なのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "六十人からの子どもがべちゃべちゃ騒ぎだしたとなると、またやかましいんだからな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほんではほら、山芋でも持って行ったらいがべちゃあ。",
              "citation": {
                "source": "芋",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神様の、おなさけだべちゃあ！",
              "citation": {
                "source": "芋",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そんより、医者さでも掛かるようになったら、なんぼ損だかわかんねえべちゃ、爺つあんはあ！",
              "citation": {
                "source": "山茶花",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「卵が、なんぼか溜まってる筈だべちゃ。",
              "citation": {
                "source": "山茶花",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "貼り紙おばは、寺に泊まっている間、毎晩のように、私の家まで湯に這入りに来たが、彼女は、一晩中べちゃべちゃと一人で饒舌っていた。",
              "citation": {
                "source": "再度生老人",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「十六七坪も拓すの、なかなか骨だべちゃ？",
              "citation": {
                "source": "土竜",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう、てえげに起きだらいかべちゃは。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかなか丸や三角を並べちゃいられない」「そりゃおめでたい」と云った甲野さんは洋卓越に相手の頭をつらつら観察した。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "母　　　そんなものを、おまえはたべちゃいけないんですよ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "時候が好くて、窓を明けているときは、我々学生が通ると、いつもべちゃくちゃ盛んにしゃべっている娘共が、皆顔を挙げて往来の方を見る。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでいつまで調べちゃあいられねえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "地蔵は踊る",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした家へ大小をさした人が悔みに来るのは、すこし不似合いであると見えて、ほかの女たちもみな林之助に眼をあつめて、今までべちゃべちゃしゃべっていた者も一度に口を結んでしまった。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "○わすれて行った本　届ける　つい　そこだって○なべやきうどんを云いつけにゆく○待っている　約束のハガキのよみちがい○お菓子のこと「あら　それをみんなたべちゃっちゃ駄目よ」○気持よさそうなので　そうすると　ローソクの灯が　急にぱっと明るくなったように　くつろいで楽に居心地よくなった。",
              "citation": {
                "source": "無題（十三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お雑煮をたべちゃってから、今日こそ仕事と二人とも机に向い、夕飯を間にはさんで『女芸』の日記のつづき十五枚書き終った。",
              "citation": {
                "source": "日記",
                "author": "一九三一年（昭和六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうみんな食べちゃったわ」と元気に返事した。",
              "citation": {
                "source": "小村淡彩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしたんだか、まだ写真を送ってよこさないんだがね」「江の島で撮ったんですか」「ああ、子供ら五人ズラッとハア並べちゃってね。",
              "citation": {
                "source": "突堤",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕二つも食べちゃった。",
              "citation": {
                "source": "小波瀾",
                "author": "ЖИТЕЙСКАЯ　МЕЛОЧЬ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
