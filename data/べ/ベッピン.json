[
  {
    "uuid": "449887af-000e-58fc-ae2a-2a93fe26bd85",
    "entry": "別嬪",
    "reading": {
      "primary": "べっぴん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
