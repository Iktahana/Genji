        "examples": {
          "standard": [
            {
              "text": "この呉服屋には、他ではなかなかお目にかかれない別嬪の反物が揃っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "市場の兄ちゃんが「今日は別嬪のマグロが入ってるよ！」と威勢よく声をかけてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "骨董市で見つけたこの伊万里焼の小皿は、傷一つない正真正銘の別嬪だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
