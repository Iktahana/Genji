          "literary": [
            {
              "text": "George Joseph Smith はベスナル・グリインの保険会社員の家に生まれた。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "マチアはかれが御者に向かって、ベスナル・グリーンへ馬車をやれと言いつけているのを聞いた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベスナル・グリーンはきっとわたしの一家の住んでいる大きな公園の名前にちがいなかった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベスナル・グリーンは夜見るよりも昼見るとさらにひどい所であった。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェストエンドからベスナル・グリーンまでの距離はかなり遠いのである。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
