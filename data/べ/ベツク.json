        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "観光客ちらほら、むつまじいアベツクもゐた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "激しい労働の疲れで、熟睡を盗んでゐる者の、仮の寝姿は、わずかに廊下のランプに明るんでゐる障子の内で蒲団の山々の合間に、恰度「波の戯れ」と題するベツクリンの作画に見るかのやうな怪奇美に溢れてゐた。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その画はベツクリン流の前派かと見らるゝ如き幽邃な怪奇に満ちて、裸女の姿が最も堅実な筆致で写実的に描かれてゐた。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベツクリンの絵の中の怪物の心地がした。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分達は幾つかの美術館を訪うて、ラフワエル、チチアン、ベラスケツ、ムリリヨオ、リユウバンス、※ン・ダイク等外国の傑作の多く集められて居るのに益を受けた許りか、レンバツハ、シユインド、フオオエバツハ、ベツクリン等｜独逸近代の大家の名品に初めて接する事の出来たのを嬉しいと思つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "又ベツクリン其他独逸近代の大家の作品は其理想主義と云ひ其手法と云ひ自分には李太白の詩を読む心地で遠い世界へ引入れられる感がした。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アロナ附近でベツクリンの絵の「死の島」は之に由つたのだらうと想はれる湖上の島を眺め乍ら昼食を取つて居ると、同じ卓へ向合せに着いた姉妹の英国婦人の、少し容色の劣つた姉の方が頻りに拙い仏蘭西語で僕に話し掛けて「日本は我英国と兄弟の国だ」とか「ゼネラル乃木が何うだ」とか愛嬌を撒いた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ノルマンデイ海岸のバルベツクに少年がはじめてお祖母さんと一しよに到着した晩のことである。",
              "citation": {
                "source": "旅の繪",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベツクの姿も大きく映つて来た。",
              "citation": {
                "source": "芝居と僕",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "イブセンが「死の目覺め」の主人公、彫刻家のルウベツクは何故に、傷付ける其のモデルから、「作品は第一、活ける人間は第二。",
              "citation": {
                "source": "歡樂",
                "author": "永井壯吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり氏はベツクリンあたりの絵の気分に近い。",
              "citation": {
                "source": "明治詩壇の回顧",
                "author": "三木露風",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど見給へ、アベツク、醉つぱらひ、高級車、あらゆる逸樂と贅美な流れをまへに、かれは少しも、さもし氣でない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、愛人らしい男女一對の仲よきチンドン・アベツクは、もつとも、心おきなく微笑できる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "片方は炭の買出しの女の人達、それから片方は蝶々と背の高いアベツク達、その中にお茶の先生が入つてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神とのアベツク　赤ンぼが生れる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉と神とは、アベツクなものだと聖書は言ひきつてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
