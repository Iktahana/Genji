        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "露西亞ニ民有論ノ起ルハ正當ナルト共ニ、愛蘭ノ貴族領ガ國有タルベキモ可能ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ノ徴集シ得ベキ資本ノ概算ハ推想スルヲ得ベキモ、其眞實ヲ去ル甚ダ遠キコトハ○○○○○ノ調査徴集ヲ必要トスル所以ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ母其人ノ生活ハ母自身ノ維持スベキモノトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ女學校特有ノ形式的課目女禮式茶湯生花ノ如キ又女子ノ專科トセル裁縫料理育兒等ノ特殊課目ハ全然廢止スベキモノトナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ最モ急進的ナル羅馬字採用ヲ決行スルトキ、幾分文字ノ不便ハ免ルベキモ言語ノ組織其者ガ思想ノ配列表現ニ於テ悉ク心理的法則ニ背反セルコトハ、英語ヲ譯シ漢文ヲ讀ムニ凡テ日本文ガ顛倒シテ配列セラレタルヲ發見スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レバ将来、精神科学ノ諸般ノ学理ガ、一般ノ常識トシテ普及スルニ到ラムカ、同様ニコレヲ応用セル犯罪ガ、旺盛ナル流行ヲ示スベキハ論ヲ俟タザルベク、而シテソノ犯行ノ恐怖、戦慄ニ値スベキ事、現代ノ所謂、唯物科学応用ノ犯罪ノ比ニ非ザルベキモ亦自明ノ理ナルベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ犯跡ヲ完全ニ抹殺スベキモノトス。",
              "citation": {
                "source": "人造人間殺害事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本願ハ左記理由ニ仍リ拒絶スベキモノト認ム。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "愕いて、これを読み下すと、拒絶スベキモノト認ムという主文は同じで、その理由としては、次のようなことが綴られていた。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "公告決定通知本願ハ拒絶ノ理由ヲ発見セザルヲ以テ、公告スベキモノト決定セリ　輝かしい日だ、雪は降りしきっているが……。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「勇気ノ盛ンナルコト、忍耐力ノ強キコト、感情ヲ抑制スルノ力ハ驚クベキモノアリ」　これは考えものだ……ことに今日のような頽廃を極めた時代を、かえって諷誡しているような文字とも思われるが、しかし、よく考えてみると、古来、日本武人の一面には、たしかにこの種の美徳が存在していた。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「仇英、字ハ実父、十洲ト号ス、太倉ノ人、呉郡ニ移リ住ム、呉派ノ第一流トイハレシ周東村ニ学ビ、人物鳥獣、山水楼観、旗輩車容ノ類、皆、秀雅鮮麗ト挙ゲラレ、世ニ趙伯駒ノ後身ナリト称セラル、特ニ流麗細巧ヲ極メシ歴史風俗画ニ於テハ艶逸比スベキモノナク、明代工筆ノ第一人者トイフベシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国王ノ行ヒヲ論ズレバ不仁惨酷ノ他ニ記スベキモノナク、専ラ暴政ヲ以テ我諸州ヲ抑圧セリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "篷ノ避クベキモノナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "○石時代ト稱スベキモノヽ存在ハ今ヨリ凡六十年前「デンマルク」及ビ「スウエーデン」ノ學者ノ考定セシ所ニシテ、此名モ彼等ニ由リテ始メテ用ヰラレタルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「コロボックル」ノ体質ニ付キテハ推考ノ根據トスベキモノ甚ダ少シ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモ世上ノ反マルクス主義論ハ矛盾百出迷理錯雑一モ理論トシテ取ルニ足ルベキモノハナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コノ点ハ諸君ノ熟慮ヲ待ツベキモノナリ」　と、さう述べてゐる――この宣伝文の筆者は、賤民があの最下層住宅区の高さ一メートル、巾は三分の二メートル、長さ一メートル半の場所のなかで自己の自由な意志で運動出来ることを喜べる者と想像してゐるらしいのは寧ろ滑稽であつた。",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
