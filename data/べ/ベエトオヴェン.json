        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "庄平、十吉（合唱する）「友を選らばば書を読みて、六分の侠気四分の熱……」壁のベエトオヴェンのデス・マスクは歌わない。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "或額縁屋の飾り窓はベエトオヴェンの肖像画を掲げていた。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はこのベエトオヴェンを滑稽に感ぜずにはいられなかった。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「坐浴、――ベエトオヴェンもやはり坐浴をしていた。",
              "citation": {
                "source": "歯車",
                "author": "芥川竜之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は特にベエトオヴェンのソナタ第二部のうちから天真なものを選んだ。",
              "citation": {
                "source": "恩人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから續けて、ベエトオヴェンの「ロオマンス」とバッハの「Ｇ線上のアリア」を彈いた。",
              "citation": {
                "source": "四葉の苜蓿",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとすぐベエトオヴェンが好きかどうかという、高等中学校長夫人の問に答えなければならなかった。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
