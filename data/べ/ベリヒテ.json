          "literary": [
            {
              "text": "試みに世界における物理化学に関する研究論文の文献を集録した『フィジカリッシェ・ベリヒテ』及び『ケミカル・ニュース』の最近のものについて日本人の論文の数を検して見ると約三プロセントくらいのものである。",
              "citation": {
                "source": "学位について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "線香花火の紹介がベリヒテに出ていますね。",
              "citation": {
                "source": "線香花火",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その論文の紹介が独逸のベリヒテという雑誌に出た時、「マツバ」や「チリギク」の火花の名は羅馬字で書いてあった。",
              "citation": {
                "source": "寅彦夏話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
