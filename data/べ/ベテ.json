        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "着物、ハダカヲ包メバ、ソレデイイ、柄モ、布地モ、色合イモ、ミンナ意味ナイ、二十五歳ノ男児、一夜、真紅ノ花模様、シカモチリメンノ袷着テ、スベテ着物ニカワリナシ、何ガオカシイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼナラバ、我輩ハ英語ニ於イテ、聞キトルコトモ、言ウコトモ、ソノホカノコトモ、スベテ赤子ノ如キデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」日本、古来ノコノ日常語ガ、スベテヲ語リツクシテイル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スベテノ言、正シク、スベテノ言、嘘デアル。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "新人もベテランもない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケシは、建設部のベテランの見事な仕事ぶりを思い出していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もちろん、まったくできないという話じゃありませんよね」　浜田から打診を受けた情報処理事業グループのソフト開発のベテランは、そう答えてから面を上げ、たずねるような視線を浜田に投げた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来の同社のパーソナルコンピューターと同様、半導体が本業の電子デバイス事業本部による、ベティとコードネームで呼ばれたマシンは、情報によればＣＰ／Ｍ―86をメインのＯＳとし、グラフィックスを機能強化しているとのことだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベティのスペックで浜田がもっとも恐れたのは、このマシンが一Ｍバイトの五インチドライブの採用を予定していた点だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがジョブズはその後、自らが招いたベテラン経営者のジョン・スカリーとの意見の対立から、アップルを追われることになった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一千万人規模のベテラン・ユーザー層、百万人規模のコンピューターのプロに、アシストはそれぞれ別系統の製品を用意するという。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが大ヒットとなったアシストカルクのＵＮＩＸ版を出したり、ＭＳ―ＤＯＳ版にも一万九千四百円でより強力な製品を出したりと、ベテラン・ユーザーやプロにもターゲットを広げている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベテラン編集者や印刷のプロには、現在のポストスクリプトの手並みはド素人のやっつけ仕事に見える。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウサギハ、ソンナ　コトニハ　オカマヒ　ナシニ、ミチバタノ　クサヲ　タベテ　ヲリマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スズメト　ポストト　ガイトウハ、ケイキキユウト　マルイ　カゲヲ　ミクラベテ　ウラヤマシガリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この扉のは、ヘロデ王ベテレヘム嬰児虐殺之図と云うのだがね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正八年十月十四日ノ午後一時カラ二時ノ間ニ、××デ警察署長ガ三人ト、判事ヤ検事ガ四人ト、松島｜見番ノ芸妓二名ガ殺サレタ事件ノ原因ヲ調ベテ下サイ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度工場外ニ足ヲフミ出シテ見レバ分ル通リ、当工場ハマサニ「Ｙノフォード」タル名ニ恥シクナイ充分ノ待遇ヲ、ソノ時間ノ点カラ云ッテモ、ソノ賃銀ノ上カラ云ッテモ、皆サンニ与エテ居ルノデアリマスカラ、コノ際決シテ、カヽル宣伝ニ附和雷同セザル様、呉々モ申述ベテ置ク次第デアリマス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアー、コトモアロウニ、ジブンタチノ死ンダオ母ッチャニアゲタモノヲ、君チャンヤ弟ヤ妹ガ、ムチウニナッテ、タベテイルデハナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "長イアイダ、タベモノヲ見タコトモナカッタトコロヘ、ハジメテソウシキノオソナエモノヲミルト、モウ矢モタテモタマラズ、目ガクラクラットシテ、ソレニ小サイ弟ヤ妹ナノデ、死ンダオ母ッチャニワルイトオモイナガラ、スキヲネラッテ、ミンナデムチュウニナッテタベテシマッタンダッテ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ベテレヘムの女ごらよ。",
              "citation": {
                "source": "妻",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　僕はそう思いながら、たぶんその巡査どもの視線を浴びながらだろう、ル・リベテエル社の中へはいって行った。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈敵ハ幾万アリトテモ　スベテ烏合ノ勢ナラズ　烏合ノ勢ニ非ズトモ　味方ニ正シキ道理アリ　邪ハソレ正に勝チ難ク……〉二　万十郎は剣舞で練へあげた「満身の鉄骨と憂国の血涙」と自ら誇る五尺の体躯を（彼は丈が真実五尺であつたが、十七貫もあるといふ固太りの布袋であつた。",
              "citation": {
                "source": "サクラの花びら",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし太陽がアルクトゥルスあるいはベテルギュースと同じ距離にあったとしたら肉眼ではとても認められないであろう。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘールの研究室で行われた比較研究の結果によると、アルクトゥルス、それよりもなおベテルギュースのスペクトルが太陽のスペクトルと相違する諸点がちょうど黒点のそれと同様である。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "従ってこれらの巨星、なかんずくベテルギュースの光を吸収するガスは太陽の光球雲よりも低温度にあることを推定することができる。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ベテルギュースのように著しく光の強い赤色の星もあるにはあるがしかしこの赤い色はこの星の雰囲気かあるいはその付近にある微塵の吸収によるものと想像される（『宇宙の成立』六四頁及び一六三頁参照）。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
