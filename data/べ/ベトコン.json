        "examples": {
          "standard": [
            {
              "text": "ベトナム戦争を描いたそのドキュメンタリーには、ベトコンのゲリラ戦の様子が記録されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "密林の奥深くに張り巡らされた複雑なトンネルは、ベトコンが米軍に対抗するために作ったものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はかつて、ベトコンの兵士としてジャングルを駆け抜けた日々を、静かに語り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "“ヴェトコン”もまた、敵ではない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェトコンが発射する迫撃砲は、すべて不発に終るとよい。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェトコンがいかに残忍であるか、また、私たちがヴェトコン全員を英雄にし、アメリカ兵をみんな一種の犯罪者みたいに扱っているではないかということに関して、二、三人の人たちから私は電話をもらったことがある。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェトコンすべてが英雄だとも聖人だとも、私は考えていない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、最も多く殺しているのは、ヴェトコンだろうか、それとも、アメリカ軍だろうか。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この一〇年間に、ヴェトコンは一万人ほどの民間人を殺した。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェトコンか、それとも、アメリカか。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェトコンは、あるひとつの村にしのびこみ、腐敗した指導者の喉を切り裂く。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たち平和運動者は、ヴェトコンに味方しているのではない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
