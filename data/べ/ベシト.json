        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "金五百円ハヤガテ君ガモノタルベシトゾ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "マサニ鬼雄トナツテ、異日兵ヲ以テ吾ガ国ニ臨ムモノアラバ、神風トナツテ之ヲ禦グベシト。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ貴族ノ土地徴集ヲ決行スルニ、大西郷ガ異議ヲ唱フル諸藩アラバ一擧討伐スベキ準備ヲナシタル先哲ノ深慮ニ學ブベシトスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "前世紀的社會主義ニ對スル一般且ツ有理ノ非難、即チ各人平等ノ分配ノ爲メニ勤勉ノ動機ヲ喪失スベシト云フ如キ非難ヲ此ノ私有財産限度制ニ移シ加フルヲ得ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私産限度超過者ガ法律ヲ遵守セズシテ不可行ニ終ルベシト狐疑スル勿レ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義的議論ノ多クガ大地主ノ土地兼併ヲ移シテ國家其者ヲ一大地主トナシ以テ國民ハ國家所有ノ土地ヲ借耕スル平等ノ小作人タルベシト云フハ原理トシテハ非難ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ原則ト云フ者アラバ、只國家ノ保護ニヨリテノミ各人ノ土地所有權ヲ享受セシムルガ故ニ、最高ノ所有者タル國家ガ國有トモ民有トモ決定シ得ベシト云フコト是レノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ル時代ノ社會主義者ノ市立ノ家屋ヲ考ヘシ如キハ市民ノ全部ニ居常且終生劃一ナル兵隊服ヲ着用セシムベシト云フト一般、愚論ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ガ國家自ラノ義務ト權能トヲ無視スルコトヲ畏ルベシトナス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹千萬圓以上ノ生産業ガ國營タルベキ爲ニ起ル疑惑ハ事業家ノ奮鬪心ヲ挫折セシムベシト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸上ノ鐵道ナルガ故ニ山間僻村ノ支線ヲモ國有トシ、海上ノ鐵道ナルガ故ニ全世界ニ通ズル幹線ヲモ民有トスベシトハ道理ニ合セザルモ甚シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ投票神權説ニ累セラレテ、鮮人ニ先ヅ參政權ヲ與ヘテ政治的訓練ヲナスベシト考フルハ、其ノ權利ノ根本タル覺醒的生長ヲ閑却シタル愚人ノ云爲ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コーラン」ト共ニ劒ヲ示シテ殺スベシト云フ信仰ト殺ス勿レト云フ信仰トヲ兩立セシムルニ、liberty ナル「アルフアベット」七個ニ依頼セントスルガ如キ淺薄ナル信念ニテ何ノ信仰ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ信仰ガ強固ニシテ犧牲ヲ甘ンズル事例ヲ擧ゲテ對抗スルナラバ宗教ノ低級ナル者ニ於テ斯ル例ノ他ニ無數ナル者ヲ擧グ可ク、更ニ斯ク頑迷移サザル者多キガ故ニ殺スベシト云フ囘教ノ信仰ニヨリテ答ヘザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ「ヴェルサイユ」ニ救ハレタル同盟ノ誼ニヨリテ英國ノ支那本部併合ニ報謝スベシト云フカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ米獨其ノ他ヲ糾合シテ世界大戰ノ眞個決論ヲ英國ニ對シテ求ムベシト云フコト是レナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "同書第一巻、政治の部の註に、本文自主・任意・自由ノ字ハ、我儘放盪ニテ、国法ヲモ恐レズトノ義ニ非ラズ、総テ其国ニ居リ、人ト交テ、気兼ネ遠慮ナク、自分丈ケ存分ノコトヲナスベシトノ趣意ナリ、英語ニ之ヲ「フリードム」又ハ「リベルチ」ト云フ、未ダ的当ノ訳字アラズ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ヨリ先キ廿九日両氏ヲ問、時ニ西曰、近日西客来ル、其時件ニ付テハ曽テ木桂ヨリ来書アリ、其儀ニ曰ク、両国論ヲ合テ云々ト、故ニ此国ニ来ラバ先ヅ其事件云々ヲ委曲、使ヲ以達可ク、然ラザレバ其西客ニ一名ヲ付て送ルベシト。",
              "citation": {
                "source": "坂本龍馬手帳摘要",
                "author": "坂本龍馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "古來ヨリ此別燦然觀ルベシトス。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "秘密探偵の書綴る報告書は裁判所の速記録と同じくところ／″＼古めかしい漢文調の熟語、「二人ハ奇貨措クベシトナシ」なんど言ふ語句と、極めて卑俗な口語とが混用されてゐて、時には却つて筆者の面目を躍如たらしむる処に別種の面白味がある。",
              "citation": {
                "source": "来訪者",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "期ハ当ニ九日ヲ以テスベシト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ソ遠国ニ赴任スル者日ニ行クコト十里ニシテソノ地ニ到レバ則三十日以内ニノ額ヲ闕イテ以テ破程ノ費ヲ補フベシト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
