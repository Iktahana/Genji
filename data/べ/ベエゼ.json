          "literary": [
            {
              "text": "ベエゼしてもならぬと、お医者に言われました、と笑って私に教えた。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』文太郎君は仕立下ろしの春外套を羽織ると、それでも毎朝と変らぬ真心こめたベエゼを、エミ子に捧げて威勢よく玄関へ出て行きました。",
              "citation": {
                "source": "四月馬鹿",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベエゼルブブの呪術は？",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だって、最初のベエゼをそんな浮世のボオフラのような男にくれてしまったのだろう……。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人でかぶったマントの中で、マッチをすりあわして、お互いに見あった顔、一度のベエゼも交した事もなく、あっけない別離だった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
