    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "飯が済んでから、お作が台所へ出ていると、新吉とお国が火鉢に差し向いでベチャクチャと何か話していた。",
              "citation": {
                "source": "新世帯",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の口からは申し分のないロシア語などは一言も聞かれず、その代り彼等は、フランス語やドイツ語や英語ならうんざりするほど知っており、そのうえ発音も一から十までちゃんと心得ていて、フランス語は鼻声を出したり、ｒの音をにごし、英語はベチャクチャと小鳥の鳴声みたいに喋りたてる。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊達巻の寝巻姿にハデなお召の羽織を引掛けた寝白粉の処班らな若い女がベチャクチャ喋べくっていた。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤーイ、何をベチャクチャしてるのだい！",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二人はベチャクチャと喋った揚句に、打連れてこの堂を出かけて行きました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "女子と小人の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷で今までベチャクチャ喋っていた時とガラリと態度が変って、唄と戦争するような物凄い真剣な気魄がこもるのだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして捕虜はみんな私達｜小児の顔を見て、ベチャクチャ喋りながら、ニコニコ笑って通った。",
              "citation": {
                "source": "戦争雑記",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "満員の盛況だったが、このとき僕が驚いたのは、座敷でベチャクチャ喋っていたり踊っていたりしたのでは一向に見栄えのしなかった舞妓達が、ダンスホールの群集にまじると、群を圧し、堂々と光彩を放って目立つのである。",
              "citation": {
                "source": "日本文化私観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここみたいな村の往来で写生をしようとすると、老幼男女が周囲を取り巻いて、ベチャクチャ喋舌り続けるから、非常に不愉快である。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "「近い内に、ちっとも証拠の残らない様な方法で、お前を殺してやるのだぞ、お前がそうして、女の様にベチャクチャ喋れるのも、もう長いことではないのだ。",
              "citation": {
                "source": "屋根裏の散歩者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "直々の御用なんてえのは」「ベチャクチャいってくれんでもいい。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍋焼き饂飩の熱いのをフウフウ吹いて食べ終ると、今夜の客はどうだったの、目明しがどうしたのと、お蝶には意味の分らない会話がベチャクチャ交わされていましたが、そのうちにべつの部屋で、お千代を中心に銭の音をさせて、皆も鶴吉夫婦も、それぞれ枕について寝入りました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "気持よくやってゐたが「弥次喜多」の時、ボックスの中で楽士同士がベチャクチャ喋り、腹が立ち、係りをどなる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ帰ると、夜も八分の入り、「ガラマサ」の時道具裏で高声放談、腹が立って芝居してゐられない位、大道具と照明部がベチャクチャやってゐたものゝ由。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新婚二人三脚」の最中、張物の裏で小道具がベチャクチャ喋ってゐるので、引込んで叱る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大道具の音我慢ならず、その上張物の裏でベチャクチャやるので、カンが立って居られなくなる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
