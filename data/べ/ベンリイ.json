          "literary": [
            {
              "text": "ほかに、島の人だろう、ホンダのベンリイのおじさんがいた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンダの実用オートバイ、ベンリイのＣＤ１２５が一台、あった。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シフトがベンリイとはちがうよ」　ちらと、ミーヨは、ぼくの顔を見た。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ベンリイとはずいぶんちがうのね」「うまい」　ミーヨの目が、きらりと光った。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
