        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "転勤する彼を囲んで、昨夜は居酒屋で遅くまで別杯を交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "卒業式の後、恩師の家にお邪魔して、ささやかな別杯をいただいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "これでお別れかと思うと、注がれた別杯のお酒が少し苦く感じられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それならこれから皆していつそ輕井澤まで出掛け、其處の蕎麥屋で改めて別杯を酌んで綺麗に三方に別れ去らうではないか、と。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷄をとり、うどんをとつて別杯を擧げた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "岡寛斎近日東京出府に付、於飯田宅別杯相催す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉田は温泉行の最上と別杯をあげて激励して、「だから最上先生、安心してお湯につかつてきなさい。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその晩の汽車で帰る彼を大阪駅に送り、別杯さめやらぬままにウトウトしながら郊外電車で帰宅した。",
              "citation": {
                "source": "女靴下の話",
                "author": "西東三鬼",
                "note": "青空文庫"
              }
            },
            {
              "text": "親鸞上人御忌執行中なるも、好意にて別杯を具せらる。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそれは、お楽しいことで……ま、いらっしゃい、しばらくのお別れだ、別杯でも挙げましょうや」　到頭席へ引っ曳ってきた。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし別杯ぐらいは、つきあえよ。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばしの別杯というので、その夜は三人仲よく杯を交わしていたが、やがてのこと。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸大将も、惜別のことばを繰返しながら、最後の別杯をあげて、各※、休息に退がった。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では、ここで別れの中食をとろう」と、一亭のうちで、また別杯を酌んだ。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こよいは、そちや菊王も交じえて、心ゆくまで、別杯を酌もうよ。",
              "citation": {
                "source": "私本太平記",
                "author": "婆娑羅帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼等のあわただしい移住は、それは何も僕たちに関係した事では無いかも知れないけれども、しかし、君のその「ノオ」の手紙が、僕と君が上野公園で別盃をくみかわしたあの日の前後に着いたとしたら、この菊屋一家の移住は、それから四、五日後に行われた事になる。",
              "citation": {
                "source": "未帰還の友に",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けふも大霜で上天気である、純な苦味生さんと連れ立つて荒尾海岸を散歩する（末光さんも純な青年だつた、きつと純な句の出来る人だ）、捨草を焚いて酒瓶をあたゝめる、貝殻を拾つてきて別盃をくみかはす、何ともいへない情緒だつた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "八時から一時まで白船居、おちついてしんみりと別盃を酌んだ、身心にしみ入る酒だつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それならこれから皆していっそ軽井沢まで出掛け、其処の蕎麦屋で改めて別盃を酌んで綺麗に三方に別れ去ろうではないか、と。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏をとりうどんをとって別盃を挙げた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに別盃というので自然飲む速度も早く、酔うのも早かった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "『玄竹、今のは別盃ぢやぞ、但馬守の生命も今夜限りぢや。",
              "citation": {
                "source": "死刑",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もその際家族と別盃を酌んでいよいよ生死の別れをした。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとなく別盃を酌むために行きたい気はしたが、新聞記者と文学者とに見られて又もや筆誅せられる事を恐れもするので、「公園は具合のわるいことがあるんだよ。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六日目の正午、最後の酒を分配し、それで別盃をあげた。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙公は、出発に際し九十九谷の崖下に穴居する※を訪うて別盃を酌み、一青年学徒に扮して厩橋城下へやってきた。",
              "citation": {
                "source": "純情狸",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "数右衛門の行を祝って、どこかで別盃を酌むには』　近くの磯茶屋で、そのまま歓送の宴が張られた。",
              "citation": {
                "source": "※かみ浪人",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、夏目と鵜飼の両名は、そのまますぐに江戸へ急いでしまえば、この奇禍にも遭わなかったろうに、不動院を出ると間もなく、鵜飼六太夫の方から口を切り、幸手の網屋で今宵は別盃を酌もうと云い出し、抜け道をとってそっちへ廻った。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ツ別盃の前に別れの一曲を吹こうではないか」　と興に乗じて云いだした。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり今宵は別盃じゃ、まあ一盃受けてくれい」「オヤ、ではお近いうちにお国元へでも？",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
