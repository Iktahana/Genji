        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ラモンの三度目のわかい妻ベホックは目をさましていて、その日琴の音と黒い眼つきとで彼女に不思議な歓びを与えてくれたアイルランドの青年のことを思いつづけていた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベホックの長い髪がその眼にも顔にも乱れかかって目を見えなくした。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベホックは無言で立っていた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベホックは音もさせず進み出てその槍を拾いあげ、影のようにうごき出した。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぎの瞬間ラモンはベホックを見つけた。",
              "citation": {
                "source": "剣のうた",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
