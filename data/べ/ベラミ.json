        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "『ベラミイ』は性慾がまだ社会を対照にしすぎてゐる。",
              "citation": {
                "source": "西鶴小論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "河内のキャンプで、私は、ベラミーつて小説を読んだけど、貴方は、あの中の主人公ね……。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえってから丸善に行って、『アンナ・カレニナ』、『生物学ト哲学ノ境』、『ペリアストメリサンダ』、『アラジィン、パロミダス』、『ベラミー』ヲ買ってくる。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十八日（水曜）　一日、「アンナ・カレニナ」と、「ベラミー」をよむ。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ベラミー」の中に現われて来る女の心理状態に刺激されて内省的に自分の女としての心持をよく味って見るとたしかにそう云うところがある。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "京華ダンスホールに一年、西銀座の「ベラミ」というバアに一年、それから大阪……これが北川千代の歴史だった。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "永田という私服は奥まった机の前へあさひを連れて行くと、いきなり、「君は六年前、銀座の『ベラミ』というバアで女給をしていたことがあったね」と、おっかぶせた。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "北川千代が「ベラミ」で女給をしているとき、末延薩夫という男を天城の猟山へ誘いだして崖から突き落した。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗教｜糺問所の刑僧は、みな善良素朴な人間ばかりで、残忍な拷問法を考えだしたベラミン僧正などは、衣についた蚤をあわれんで、払いのけることさえしなかったということである。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスのものは、学校でフランス語をやった関係で非常に親しさを持っていたが、翻訳のあるものは、大抵翻訳でゴマ化し『ベラミー』などはその頃の当局がやかましくて翻訳がなかったから、原本の弁慶読みを始めたが、それもおしまいまでは続かなかった。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "銭形平次以前",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋の焼物ではベラミンにこの美しさがある。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "面白い事にこのベラミンは既に二百年も前から日本で大に賞美せられた。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
