          "literary": [
            {
              "text": "こゝが家ぞ、と途すがら一言も物いはざりしベネデツトオ告げぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "わがかはゆきベネデツトオよ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃げ込みたる男は、あたりを見※はし、ベネデツトオが銃の壁に掛かりたるを見出しつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど此世には、この子の親といふもの、われとベネデツトオとの外あらず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベネデツトオの歸るまでは、外に出でんやうなし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
