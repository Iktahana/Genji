          "literary": [
            {
              "text": "（ベリリと腰のオダリスクの片方をやぶき捨て、片方のモモの円柱を斜めにグイとあげ、最下等の媚びと軽蔑とを混ぜて、自分のからだを男に投げ与えるゼスチュア。",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう言いながら、彼女は、自分の胸のＶの所に右手をかけると、ベリリと言わせてワンピースの布を下へ向つて引き裂きました。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピクピクしているやつを、両手で顎を持ってベリリ真二つに引き裂く。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
