          "literary": [
            {
              "text": "ベルネクラブの食事は、とてもうまかった、これも馴れてしまふと、うまくなくなる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「青春」のピアノは、ベルネクラブのボスが来てるので、「ベルネ作曲のふぐの引越」とやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから神戸のベルネクラブ、オルドヴルから、えびのニューバーグ、鶏、しまひに火のついたパンケーキ・スゼット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルネクラブで夕食、ボイルビーフとキャベジうまし。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "元町のベルネクラブ、オルドヴル、フロッグレッグー脂こくなくてうまかった、次の犢の煮込、シャムピニオンのうまかったこと、パンケーキ・スゼット。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
