        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二十歳にもなっているぼくを、坊主なぞ呼ぶのは、可笑しいのですが、早くから、父を失い、いちばん末ッ子であったぼくは、家族中で、いつでも猫ッ可愛がりに愛されていて、身体こそ、六尺、十九貫もありましたが、ベビイ・フェイスの、未だ、ほんとに子供でした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "チヤアルズ・キングスレエの『ウオタア・ベビイス』といふ子供の読み本を覗いた事のある人は、もつと／＼長い、まるで蛇のやうな語に出会して、ぎよつとした事がある筈だ。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "うちにはベビイ・オルガン一台あるきりで其で教則本をあげた。",
              "citation": {
                "source": "親子一体の教育法",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥だちよくくりくりと丸くて、夏の白いベビイ服の短袖から、くびれて可愛い腕がむき出ている。",
              "citation": {
                "source": "権力の悲劇",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうふた昔三昔のことで、私が五つぐらいと云えば明治三十年代の終りから四十年代のはじめにかけての時期になるが、その時分うちに一台のベビイ・オルガンがあった。",
              "citation": {
                "source": "きのうときょう",
                "author": "――音楽が家庭にもたらすもの――",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっぱり、ベビイ・オルガンで教則本の三分の一ほどやったのであった。",
              "citation": {
                "source": "きのうときょう",
                "author": "――音楽が家庭にもたらすもの――",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真デ思イツイタガ写真機ガ欲シクハナイデスカ、「パテエ・ベビイ」ハイカガ？",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
