  {
    "uuid": "95d2aa24-2b45-5e24-97dd-c06e03c5fb80",
    "entry": "ベタン",
    "reading": {
      "primary": "べたん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まったくのろのろと人間の頭で想像の出来る限りの、ゆっくりした足どりで、磨りへった階段に、濡れた長靴の跡をベタンベタンとつけながら階下へ降りると、彼はまた長いこと後頭部をボリボリ掻いていた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "手錠を嵌られると、不貞腐れてその場へベタンと坐り込み、まるで夢でも見たように、妙に浮かぬ顔をして眼をパチパチやり出した。",
              "citation": {
                "source": "三狂人",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は室内に這入ると、そのまゝベタンと板の間の上へ坐って頭も得上げず、作りつけた人形のようにじっとしていた。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "清水晴風さんの『うなゐのとも』という玩具の事を書いた書の中にも、ベタン人形として挙げてあるのはこれで、肥後熊本日奈久で作られます。",
              "citation": {
                "source": "諸国の玩具",
                "author": "――浅草奥山の草分――",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は上方風にベッタ人形といっているが、ベタン人形と同じものですよ。",
              "citation": {
                "source": "諸国の玩具",
                "author": "――浅草奥山の草分――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
