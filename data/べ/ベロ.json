        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "スニーカーを履く時に、ベロの部分が靴の中に巻き込まれてしまったので、指で引っ張り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この登山靴のベロは、雨水や砂が入り込まないように本体と一体化した構造になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "靴紐をきつく締めすぎたせいか、ベロが足の甲に当たって痛いので少し緩めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
