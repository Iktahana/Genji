[
  {
    "uuid": "caa32e3e-0fd7-58b9-88b7-cd360a81840c",
    "entry": "ベロ",
    "reading": {
      "primary": "ベロ",
      "alternatives": [
        "べろ"
      ],
      "is_heteronym": false
    },
    "grammar": {
