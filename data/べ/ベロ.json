    "definitions": [
      {
        "index": 1,
        "gloss": "tongue",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あ、アイスクリームが垂れそう！」と言いながら、彼女はペロッとベロを出して舐めとった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "医者に「ベロを出して、あーと言ってください」と言われ、喉の奥を診察してもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "猫が自分の体をザラザラしたベロで毛繕いしている様子を、リビングのソファーから眺めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "刑事が小卓のコップのそばにあった紙袋を取り上げて調べているのをのぞいて見たら、袋紙には赤インキの下手な字で「ベロナール」と書いてあった。",
              "citation": {
                "source": "Ｂ教授の死",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　猫はばかにしたように尖った長い舌をベロリと出しました。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おととしの秋ね、ベロナールで自殺しちゃったの」　自殺というのはじぶんで死ぬことだというくらいは、久助君にだってわかるが、そんなことばを使うものは、久助君のいままでのなかまには、ひとりもいなかったので、ただもう、めんくらうばかりである。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "色が氣味惡く白く、絶えず舌を出して赤ん坊の樣にベロ／＼音を立て、涎を垂れ、意味も無く手を振り足を摺る。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "色が気味悪く白く、絶えず舌を出して赤ん坊の様にベロベロ音を立て、涎を垂れ、意味も無く手を振り足を摺る。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の片隅の洋服掛に美事なタキシードが掛けてあって、その上下にベロア帽とカンガルー皮の靴と銀頂のスネーキウッドの杖が置いてある。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "最前から秤の傍に待っていたラマムはこの様子を見ると、ベロベロと舌なめずりをしながら他の鼻を探しに暗黒世界に去りました。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは酒を止め、昼は蝶を採り、夜はベロナールの利くまでの間母に音楽を聴かせた。",
              "citation": {
                "source": "わが生活より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一六一〇年頃出たベロアル・ド・ヴェルヴィルの『上達方』三九章にも似た話あって遥と面白い。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "就いて想い出すはベロアル・ド・ヴェルヴィルの『上達方』三十九章にアルサスのある地の婦女威儀を重んずる余り七日に一度しか小便せず、火曜日の朝ごとに各の身分に応じ隊伍を編み泉水に赴き各その定めの場について夥しく快げにかつ徐かにその膀胱を空くる。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベロアル・ド・ヴェルビュの『上達方』に婦人は寺で天女、宅で悪魔、牀で猴と誚り、仏経には釈尊が弟の難陀その妻と好愛甚だしきを醒まさんとて彼女の瞎雌猿に劣れるを示したと出づ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベロアル・ド・ヴェルヴィユの『上達方』に、鶏卵の笑談あまたある。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その留守中は淋しそうにションボリして時々悲しい低い声を出して鳴いていたが、二葉亭が帰って来て格子を開けると嬉しそうに飛付き、框に腰を掛けて靴を脱ごうとする膝へ飛上って、前脚を肩へ掛けてはベロベロと頬ぺたを舐めた。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "刺身の一と皿位は独り占めにベロリと平らげてなお飽足らずに、首を伸ばして主人が箸に挿んで口まで持って行こうとするのをやにわに横取りをする。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫めの方でも大甘垂れに甘垂れて舌を出してはベロベロと二葉亭の顔を舐めた。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "負けぬ気の椿岳は業を煮やして、桜痴が弾くなら俺だって弾けると、誰の前でも怯めず臆せずベロンベロンと掻鳴らし、勝手な節をつけては盛んに平家を唸ったものだ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の顔さえ定かならぬ薄暗い室に端座してベロンベロンと秘蔵の琵琶を掻鳴らす時の椿岳会心の微笑を想像せよ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒストリー・オフ・インテレクチュアル・デベロップメント。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い間口にしなかったのと、疲労し過ぎていたので、ベロベロに参って了った。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスの批評家ハイレア・ベロックは小説の近い将来における滅亡を主張している。",
              "citation": {
                "source": "文芸は進化するか、その他",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ベロナールを粉にして、そつと徳利の中に溶し込んでやつたのよ。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それで、ベロナールなんて持つてゐたんだね。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "遥拝すると、白髪の鬘をつけたオベロン王が、白孔雀の扇を胸先に構へてゐるチタニア妃と厳かに同乗してゐる。",
              "citation": {
                "source": "変装綺譚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "tongue (of a shoe)",
        "register": "standard",
