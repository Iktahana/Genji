        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "レコオド・ボックスにもベエトオベンの晩年のクヮルテットだけは揃えてあるのだが、今更かけて見よう気もしない。",
              "citation": {
                "source": "狼疾記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "成程帽子の下から長い髪の毛が食み出してはゐるが、それは音楽家がベエトオベンの頭を真似た自慢の髪の毛だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "嬰児はベエトオベンの楽譜や、ワグネルのオペラの上へ、口の悪い批評家のやうに時折は水をしかけるやうな事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうかといつてベエトオベンのクロイツェルソナタのやうな肉体や血のひしめいた懊悩を感じさせるものとも違ふ。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベエトオベンの音楽をきいて、芸術がどんなもんだか、考え直してくれないかな。",
              "citation": {
                "source": "安吾巷談",
                "author": "教祖展覧会",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
