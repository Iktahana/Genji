        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それで、私は、ちょうどぴったりとくる一つの例を、エーベルハルトの大戦に関する類例集の中から、拾い上げることができました。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばレムブラントの生涯はベルハーレンが詩人らしさで描いています、しかし私が新しく書いたっていいわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルハーレンが、レンブラントの描く人間はいつも窮極においてのっぴきならぬ情熱のどんづまりにおいて描かれている。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――○――　夜、皆で青山の通りを散歩し、佐藤氏の『都会の憂鬱』、光太郎訳ベルハーラン、春夫『一九二二年の詩文集』等を買う。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十『明るい時』と云うベルハアランの小さい詩集がある。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "テープノ寸法モ測ッテアッタニ違イナイト思ウガ、ウッカリ丸メテシマッタノデ調ベルハ書カナイデオイテクレ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十時、新宿ベルハウスでウイをのみ、家へ電話をかけてみたら明日八時より撮影ときいて、のむ元気なくなり、すぐ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "石田守衛を連れて、デンツーで夕食、ポタアジュと鶏カツ食って、芝浦のサーカス、ベルハムストンの天幕へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
