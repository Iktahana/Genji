      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "机を向かい合わせた同僚にも格別異状などは見えなかったそうである。",
              "citation": {
                "source": "馬の脚",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬の真似をすることには格別異存はないにしても、さすがにあたりの人目だけは憚っているのに違いなかった。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし五円だけ割愛することには、格別異存も持たなかつた。",
              "citation": {
                "source": "続野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "極惡大逆者の邸宅を破壞することは、已に周時代から實行されて居り（『禮記』檀弓下參看）、又犯罪者の教化不行屆について、地方の長官や教官が責任を負ふことは、漢時代から實行されて居る（『漢律考』卷四參看）から、格別異とするに足らぬ。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "――財産の方に就ては家族の間にも格別異存が無かつたそうだが、家系断絶の一件は頗る苦情が出たそうだ。",
              "citation": {
                "source": "大野人",
                "author": "木下尚江",
                "note": "青空文庫"
              }
            },
            {
              "text": "格別異っても居りませぬが、ただ現界の山よりは何やら奥深く、神さびて、ものすごくはないかと感じられる位のものでございます。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花子が、真名古ほどの頑固な心をもとりとめなくさせるほど美しかったということには、格別異存はないが、真名古がそれに心をひかされたことに文句があるのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は近頃外国のものも、我国のもあまり読まないから何とも断言は出来ないけれども、一体今迄の探偵小説にはあまり特別異常な事ばかりで、家常茶飯事の中には探偵小説が無いらしいのだが、又それが自然な現象でもあるのであるが、探偵小説の世界にも一ぺん自然主義的洗礼を与へて見たいものだ。",
              "citation": {
                "source": "寸感",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅の鋳物師らがきて焼いた炭には、格別異な臭いもなかったろうけれども、その代わりには彼らの歌、彼らの物語は永く耳に残った。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵農一致　士農工商の内、工の半分以上商の九分通りまでが、もとは農から出たものであって、農工商をそれぞれ別異なる階級のごとく見るのは誤りであることは、前に申す通りである。",
              "citation": {
                "source": "家の話",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに今は田畠や山林となっていてなおその地名を存する者などは、何か普通の農民にあらざる者が居住したために、その地を別異にする風があった結果かと認められる。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
