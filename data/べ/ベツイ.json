  {
    "uuid": "d8f4a27c-384f-56a5-aaf2-bd9de5274ee8",
    "entry": "別異",
    "reading": {
      "primary": "べつい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
