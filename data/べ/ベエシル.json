        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』とベエシル・ハルワアドは絵筆を措いて云った。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　10　ベエシル・ハルワアドもまたシビルの死を知ったのでドリアンを訪れた。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そこでベエシル、彼女の僅かばかりの接吻と口説との思い出に、一つ彼女の姿を画いてはくれまいか。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドリアンは其処で、ベエシル・ハルワアドの画いた己れの絵姿と向き合って、更に鏡の中に本当の自分の姿を映して見比べているのであった。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドリアンはヘンリイ卿の晩餐に招かれてその帰りがけに、霧深い町角でゆくりなくもベエシル・ハルワアドと出逢った。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "』とベエシルは云った。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベエシル、カーテンを除け給え！",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は阿片窟で会った若い友の悲惨極まる運命もまたベエシルの云った如く自分に関りがあるのだろうかと思い返した。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それはそうと、ベエシルの失踪とそれからあのキャンベル君自殺事件を知っているかね？",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェームス・ヴェンはセルビイの墓地に名も知られずに葬られたし、アラン・キャンベルは自分の研究室でピストル自殺を遂げたし、ベエシル・ハルワアドの失踪も永遠の秘密としてやがて人々から忘れ去られるだろう。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドリアン・グレイは絶望のあまり曾てベエシル・ハルワアドを刺した同じ短剣でその絵姿を刺し貫いた。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
