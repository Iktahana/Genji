[
  {
    "uuid": "cbf9a08f-87fd-5a8e-9ede-df7e6965a178",
    "entry": "ベトベト",
    "reading": {
      "primary": "ベトベト",
      "alternatives": [
        "べとべと"
      ],
      "is_heteronym": false
    },
    "grammar": {
