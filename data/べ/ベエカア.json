        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同じ太平洋岸でも、有名な航海者「ヴァンクウバア」が、フッド火山や、ベエカア火山や、レイニーア火山を発見してから、三十四年も後に、シャスタは、やっと存在を認められた。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地の人たちは、この森林帯の立派さを艶説しているが、レイニーア火山や、ベエカア火山の、それに競べると、さほどの物ではない。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八九七年に女のことで投獄されたジョウジ・ベエカアなる男が、まずスミスの変名のはじまりで、その後、ライセスタアでいちじ菓子屋をしていたこともある。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブラッシで艶出しをかけるとジョセフィン・ベエカアみたいになるな。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
