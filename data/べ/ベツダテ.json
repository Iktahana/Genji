    "definitions": [
      {
        "index": 1,
        "gloss": "separate arrangement (e.g. of payments)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
