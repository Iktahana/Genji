        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は彼女に会った瞬間から、ベタ惚れしているのが見て取れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "初めて訪れたイタリアの街並みに、私は完全にベタ惚れしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「彼のことをベタ惚れしてるから、どんなことでも許しちゃうんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "意地わるの男がアルカンなどときまっていて、ピエロはコロンビーヌにベタ惚れなのだがふられ通しで、色恋に限らず、何でもやることがドジで星のめぐり合せが悪くて、年百年中わが身の運命のつたなさを嘆いているのである。",
              "citation": {
                "source": "土の中からの話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "意地わるの男がアルカンなどときまつてゐて、ピエロはコロンビーヌにベタ惚れなのだがふられ通しで、色恋に限らず、何でもやることがドヂで星のめぐり合せが悪くて、年百年中わが身の運命のつたなさを嘆いてゐるのである。",
              "citation": {
                "source": "土の中からの話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベタ惚れ、ベタベタ、見栄も外聞もなくなるのですな。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前が八幡樣の御神馬の生れ變りで、金はウンと出來るが、女の子は出來ないといふ、有難い本を讀んでゐたところだ」「イヤになるなア、金なんざ百も欲しくねえが、江戸の良い娘がベタ惚れといふ卦が出ませんかね。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "嫁の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
