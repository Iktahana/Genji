          "literary": [
            {
              "text": "ある者はド・メェーストルのごとくそれを讃美するであろう、またある者はベッカリアのごとくそれを呪うであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルイ・フィリップは自らベッカリア（訳者注　刑法の緩和改進を主義とするイタリーの学者）の著書に注釈を施した。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして弱小な者ではあるが、喜んで自ら斧の一撃を加えて、多くの世紀をさかのぼる昔からキリスト教諸国の上につっ立っている古い磔刑台に、六十年前ベッカリアが与えた切り口を、力のおよぶかぎり大きくしたいのである。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンテスキューはベッカリアを生んだ。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
