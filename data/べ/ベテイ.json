        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マアー、コトモアロウニ、ジブンタチノ死ンダオ母ッチャニアゲタモノヲ、君チャンヤ弟ヤ妹ガ、ムチウニナッテ、タベテイルデハナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の共通の友達で、ベテイ・マレイという女薬剤師なども、ルウス・ジュッドは時どきヒステリカルになって、アンへ物を投げつけたりなど、野獣のように暴れることがあったと言った。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビフテキデモ鰻デモ過度ニナラナイ程度ナラ差支エナイトノコトナノデ、何デモオイシク食ベテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡レタ足ノ裏ガ蠱惑的ニ、顔ノヨウナ表情ヲ浮カベテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、今朝ハ、ダン／＼意識ガハッキリシテ来ルニ従イ、ソノピイピイト云ウ声ガ、現ニ佐々木看護婦トベッドヲ並ベテイルコノ部屋ノ中デ聞エテイルノニ違イナイコトニ心ヅク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ伏見区竹田内畑町ニアル安楽寿院五輪塔、水輪ガ下ノ方デ細マッテ壺形ニナッテオリ、火輪ノ軒ノ反リガ厚ク、ヤダルミノ工合ガ風輪空輪ノ形ト共ニ鎌倉中期カラ後期ニ移ル頃ノ代表的ナ遺品デアルト、川勝政太郎氏ガ述ベテイルアノ作品、アレナドハドウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
