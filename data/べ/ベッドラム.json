          "literary": [
            {
              "text": "人々は、その頃は、ベッドラム★にある芝居を見るのに金を払ったと同じように、オールド・ベーリーの芝居を見るのに金を払ったものであった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベッドラム　　ロンドンの古くからの有名な瘋癲病院。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ベッドラム」はベスリヘム（ベツレヘム）の転訛。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "もと修道院であったが後に精神病院となったロンドンのセント・メアリー・オヴ・ベスリヘムを略してベッドラムと言ったのである。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
