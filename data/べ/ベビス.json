          "literary": [
            {
              "text": "煙草を吸いに友人のベビスの部屋へ来たのですが、王子が御用聞きにお出ましになられた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベビスはいますか」　マザロフが奥部屋から出て、中扉を閉め、そっけなく言った。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、ベビスはどこへ行きましたか」　マザロフ王子が皮肉交じりに答えた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ベビスの居場所や行先はこれっぽっちも知らない。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの若造のベビスは最近護衛官をやめた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            }
          ]
        }
