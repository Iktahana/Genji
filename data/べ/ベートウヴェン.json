          "literary": [
            {
              "text": "あとはベートウヴェンの第五。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、下からは寿江子のかけているラジオでベートウヴェンの「土耳古行進曲」が響いて居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の人間らしいそういう美を表現する可能をもっているのは音楽家ではベートウヴェンです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう春江、国男来て居、ベートウヴェンのシムフォニー No. 7, op 92. と No. 3, op 55 (Eroica) のスコーアと、菫の花束とをお土産にくれる。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
