  {
    "uuid": "3a320818-c08f-51ff-8f01-2f58b4869081",
    "entry": "べた雪",
    "reading": {
      "primary": "べたゆき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "雪はもとよりべた雪だった。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはこのべた雪の連想から、いまわたしの頭にこびりついて離れない例の逸話を思い出したらしい。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、これはべた雪の連想からできた物語としておけ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "名状しがたい憂愁をいだきながら、わたしは窓に近よって通風口を開き、霏々として降ってくるべた雪の、どんよりと黄いろい薄闇を見透かしたものである……　とうとうわたしの部屋にかかっているやくざな柱時計が、じいじいとしゃがれ声で五つ打った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "依然として降りしきる生暖かいようなべた雪を浴びて、全身真っ白になっていた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "べた雪は綿のように降りしきっていた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日の天気といったら……べた雪で……いやになっちまう！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "墓場はじとじとしてぬかるみだらけ、それにべた雪が降っていようという寸法さ、――なにも、きみなんかのために、お天気だって遠慮する手はないからね。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはこの場を遁れたくてたまらなかったのだ……べた雪が依然として、綿屑のように降りしきっているのもかまわず、わたしは家までずっと歩いて帰った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "18　無定形の雪　以上述べた雪の各種類のどれにも属せしめられない無定形に近い雪も沢山降るのである。",
              "citation": {
                "source": "雪",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
