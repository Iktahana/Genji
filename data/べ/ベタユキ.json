        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝からしとしととベタ雪が降り続き、足元が滑りやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ベタ雪が積もると重くて、車の運転が大変になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「このベタ雪じゃ、雪だるまも作りづらいな。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "背中はじっとりと汗ばんで、雪は相変らずのベタ雪である。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤石とのコルに近づくと、またもやベタ雪となり、団子になってしまうアイゼンが煩わしかった。",
              "citation": {
                "source": "春の遠山入り",
                "author": "松濤明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
