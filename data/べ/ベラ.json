[
  {
    "uuid": "b7d8c600-9bd0-5c26-ad37-ff512bd71d5d",
    "entry": "遍羅",
    "reading": {
      "primary": "べら",
      "alternatives": [
        "ベラ"
      ],
      "is_heteronym": false
    },
    "grammar": {
