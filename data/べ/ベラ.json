    },
    "definitions": [
      {
        "index": 1,
        "gloss": "wrasse (any fish of family Labridae)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "磯釣りで、色鮮やかな遍羅が釣れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "浅瀬の岩礁には、様々な種類の遍羅が生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "獲れたての遍羅は、刺身にすると美味しいらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "文部省の、その衝に当つた役人は、事務よりも先づ主観を述べられた。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前に仮令対策を述べられたとしても、その対策たるや凡そ見当が付くと云へませう。",
              "citation": {
                "source": "我邦感傷主義寸感",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はなぜこうべらべらしゃべってしまうのだろう。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も述べられたことから益するのは述べた人自身かそれと非常に相似的芸術家に役立つだけである。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の壇へ御洗米と塩とを純白な皿へ盛ったのが御焼物の鯛をはさんで正しく並べられる。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番大きな下の壇へは色々な供物の三宝が並べられる。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単な言葉と理屈で手早くだれにもわかるように説明のできる事ばかりが、文明の陳列棚の上に美々しく並べられた。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "異人種から戦勝の祝のことばを述べられる。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな中堅作家の作品と並べられて、はじめて僕の下手さ加減が、わかつた。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてまた、お鈴さんに連れられて、もとの小綺麗な茶の間にかへると、そこには、大小さまざまの葛籠が並べられてある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お爺さんは苦笑して、座敷に並べられてある葛籠をちらと見て、「みんな大きい。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小渋川よりも、川幅が狭くて、谷地が、かえって濶いだけに、徒渉の回数は少い、深山の渓流としては、先ず安楽な方で、小渋川や、槍ヶ岳の蒲田谷などとは、深さと、急と、嶮しさとにおいて、到底、比べられない。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "消防組、青年団は、何のために護衛し、非常線を張り且つ（調べられる）か？",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「年賀はがきの宛名を一つ一つ書いてゆく間に、自分の過去の歴史がまるで絵巻物のように眼前に展べられる。",
              "citation": {
                "source": "年賀状",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "海軍服は小石を拾っては氷の上をすべらせて快い音を立てている。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにつけても久振りに伯母の福慈の女神のことが思い較べられて来るのであった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそのなにかしらと感じていたものが、ふと生けるものの、女性の胎内とはかかるものではないかと思い浮べられて来たときに、女はわれ知らず、身体が熱くなり、顔の赭くなるのを覚えた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に不思議や亀縮んでいた異性に対する本能の触手が制約の撻を放れてすくと差し延べられるのを感じた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の方が却って男の不器用を察して気ずつない思いを紛らすために、わきを向きながら小さな声で唄ったなど　　黥ける利目など　　黥ける利目　これは、男の顔を、ちらと見たとき、自然と思い浮べられた歌の文句だった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッションとやらが起らずに、ほとんど生涯勤めて来た座敷の数々、相手の数々が思い泛べられた。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」○チョコレートを食べられる暇さえある職業だったら職業というものは何という好もしいものでしょう。",
              "citation": {
                "source": "現代若き女性気質集",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女性のよろこびを考えるうちに「化粧」が思い浮べられた。",
              "citation": {
                "source": "女性の不平とよろこび",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝸牛はどれでもこれでも食べられるのではなくて、レストラン・エスカルゴ等で食べさせるのはブルゴーニュという地方で産するものである。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る養殖家の話では巴里で一年に食べられる蝸牛の数は約七千万匹で、それを積み重ねると巴里の凱旋門よりも高くなるというから大したものである。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなに沢山ある貝が食べられないものかと子供の時によく考えたことだが、それがフランスへ行って、始めて子供の時の不審を解決することが出来た。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こっちはすぐ喰べられます。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしぁ、べらぼうめ、そんな苦情は、おれのとこへ持って来たって仕方がねえや、ばさばさのマントを着て脚と口との途方もなく細い大将へやれって、斯う云ってやりましたがね、はっは。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうすると、水銀がみんな蒸発して、喰べられるやうになるよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとある日いたちに見附かって食べられさうになったんですって。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
