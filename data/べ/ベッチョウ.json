[
  {
    "uuid": "e02868cc-3c58-5b52-b126-355c944819ba",
    "entry": "別帳",
    "reading": {
      "primary": "べっちょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
