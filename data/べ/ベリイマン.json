          "literary": [
            {
              "text": "ビュウラ・ベリイマンという掃除婦がある。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "名札も附いていないし、頭文字もないので、誰の荷物とも判定の下しようもないが、其処へ置き放しにする訳にもいかないので、掃除婦ベリイマンは、何心なく、そのスウツケイスの掛金に指を当ててみた。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "いささかの好奇心も手伝って、ベリイマンがスウツケイスの蓋を開けて見ると――。",
              "citation": {
                "source": "アリゾナの女虎",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
