        "examples": {
          "standard": [
            {
              "text": "古い壁紙をベリベリと剥がしていく作業は、意外と爽快感がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "粘着力の強いガムテープをベリベリと音を立てて剥がしたら、下の塗装まで落ちてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "封筒をベリベリと雑に破いて、中に入っていた招待状を取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
