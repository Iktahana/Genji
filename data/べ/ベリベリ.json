        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "麦藁のべりべりと裂ける音が、不思議に悲しく胸に迫つた。",
              "citation": {
                "source": "夏帽子",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "不思議に思って傘を少し傾けようとすると、その途端に傘がべりべりと裂けた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "半鐘の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "画像がべりべりと引き裂かれた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "べりべりッという厭やな音がして、学士の洋服が引裂けると、右腕が急に自由になった。",
              "citation": {
                "source": "恐しき通夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりに着物を引張るので、その垢じみた単衣はべりべり裂け始め、その下から爬虫類のようにねっとりした光沢のある真白な膚が剥きだしになってきた。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラ十は、封筒と白紙とを重ねて、べりべりッと破った。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、どうするんだ」　ハルクは、無言で、いきなり、べりべりと音をさせて、右脚の入っているズボンを、ひきさいた。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして胸のあたりをさすっていたが、やがて上衣をまくって白い襯衣をひきだし、べりべりと破った。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "よわったな、じゃこうしてみよう」　と、帆村は、棒をひっこめると、ハンカチーフをべりべりとさいて大急ぎで紐をつくり、それを棒のさきにくくりつけた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は折角書いた原稿用紙を鷲づかみにすると、べりべりと破いて、机の下の屑籠のなかにポイと捨てた。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いつまでもそうしていられないことを、よく知っていた高一は、体をかがめて、自分のズボンのうらのきれを口でくわえると、べりべりとやぶりました。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（それを取って、見もしないでべりべり破って竈の火にくべてしまう）ざまを見ろ！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は船宿「吉井」へいって道具を借りて来ると、店台をべりべり引き剥がしにかかった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしているうちに、べりべりと音がして、怪物の黒シャツの胸のところが、やぶれました。",
              "citation": {
                "source": "夜光人間",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "はさまれたズボンが、べりべりとさけて、やっと、はさみからのがれることができました。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "キット……俺あ見てたんだが」「ベリベリッと音がしたじゃねえか。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベリベリッと音がして、ちぎれたお光の片袖を手に握ったまませい子がはねとばされて、床の上に倒れる。",
              "citation": {
                "source": "廃墟（一幕）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドシン、ベリベリベリッ、ドサン、ガチャンと、まるでイノシシがあばれるような物音。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「しまッた」　ベリベリッと破れた笠が自斎の手に残ったかと思うと、玄蕃は脱兎の如く蓆を衝き抜いて裏口へ逃げ出し、同時に一刀を抜いてきた金井一角が後ろから不意打ちに、「素浪人ッ」　と斬りつけてきた。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "外へ、どんと仆れた雨戸は、彼女の体をまろばせて、次に、平次郎の荒い足にベリベリッと踏み破られた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
