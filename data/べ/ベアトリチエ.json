        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "神曲に見えたるベアトリチエとの戀は、夙く九歳の頃より始りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベアトリチエとの淨き戀、戰爭の間の苦、逐客となりてアルピイ山を踰えし旅の憂さ、異郷の鬼となりし哀さ、皆我詩中のものとなりぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "案内者は其右手の女群の一人がベアトリチエだと教へて呉た。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しベアトリチエは詩人が空想の女で史実には何の憑拠もないらしい。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベアトリチエは正宗氏の言ふやうに女人よりもはるかに天人に近い。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しダンテを読んだ後、目のあたりにベアトリチエに会つたとしたならば、僕等は必ず失望するであらう。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベアトリチエも亦同じことであらう。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもかう云ふベアトリチエはベアトリチエ自身を示さないにもせよ、ダンテ自身を示してゐる。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが祈に添ひてベアトリチエと諸聖と、合掌祈念するをも、うけさせ給へや。",
              "citation": {
                "source": "びるぜん祈祷",
                "author": "ダンテ・アリギエリ　Dante Alighieri",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
