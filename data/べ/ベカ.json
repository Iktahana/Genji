        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "異人ハタヨルベカラズ、就イテ少シク学ブダケデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "間皿は季節柄ラ・ベカッセ・シヴリである。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホップのつるが、両方からのびて、門のようになっている白樺の木には、「カッコウドリ、トオルベカラズ」と書いたりもしました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてゆらめく瓦斯の光とベカベカな狂言ビラとにドリアンは足を止めた。",
              "citation": {
                "source": "絵姿",
                "author": "The Portrate of Dorian Gray",
                "note": "青空文庫"
              }
            },
            {
              "text": "見料モ亦忘ルベカラズ」「わははははは。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水　満洲の水は悪いというので、軍隊が基地点へゆき着くと、軍医部では直ぐにそこらの井戸の水を検査して「飲ムベシ」とか「飲ムベカラズ」とか云う札を立てることになっていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、その札に曰く「人馬飲ムベカラズ」　人間は勿論、馬にも飲ませるなと云うのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも満洲の水も「人馬飲ムベカラズ」ばかりではない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（世紀ノ更新ヲ十進數ニ依リテ思考スベカラズ）。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十世紀ノ人類ハ聰明ト情意ヲ増進シテ「然リ然リ」「否ナ否ナ」ニテ足ル者ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本國民ハ心ヲ冷カニシテ天ノ賞罰斯クノ如ク異ナル所以ノ根本ヨリ考察シテ、如何ニ大日本帝國ヲ改造スベキカノ大本ヲ確立シ、擧國一人ノ非議ナキ國論ヲ定メ、全日本國民ノ大同團結ヲ以テ終ニ天皇大權ノ發動ヲ奏請シ、天皇ヲ奉ジテ速カニ國家改造ノ根基ヲ完ウセザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "（兩者ノ救フベカラザル迷妄ヲ戒シム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ノ短所ナリト考ヘテ新ナル長ヲ學ブ者ト速斷スベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人ノ自由ナル活動又ハ享樂ハ之レヲ其ノ私有財産ニ求メザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本ニ於テハ國民生活ノ基礎タル土地ノ國際的分配ニ於テ將來大領土ヲ取得セザルベカラザル運命ニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ土地問題ハ單ニ國内ノ地主對小作人ノミヲ解決シテ得ベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私有財産限度ト私人生産限度トヲ同一視スベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞理ハ一社會主義ノ專有ニ非ズシテ自由主義經濟學ノ理想ニ亦犯スベカラザル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ又生産方針ニ干與スルノ權ハ國家全局ノ生産成績ヲ達觀シ得ベキ衆議院ニ於テセザルベカラザル所以トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ賠償ヲ別途ニ命ジテ同居ヲ父ニ強ヒザル所以ハ、遺棄シタル事情ガ背徳ニセヨ又ハ積極的活動ノ爲ニセヨ干渉スベカラザル別事ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "下掲國家ノ權利ニ説ク如ク、日本ハ最モ近キ將來ニ於テ極東西比利亞濠洲等ヲ其ノ主權下ニ置クトキ、現在ノ歐米各國語ヲ有スル者ノ外ニ新タニ印度人支那人朝鮮人ノ移住ヲ迎フルガ故ニ、殆ド世界凡テノ言語ヲ我ガ新領土内ニ雜用セシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主權國民ガ西比利亞ニ於テ露語ヲ語リ濠洲ニ於テ英語ヲ語ル顛倒事ヲナス能ハザルナラバ、日本領土内ニ一律ナル公語ヲ決定シ彼等ガ日本人ト語ルトキノ彼等ノ公語タラシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "精神的價値等ヲ擧ゲテ遊戲ノ本旨ヲ傷クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ガ全亞細亞ノ盟主タル大使命アルナラバ、人倫ノ大本ヲ嚴守勵行スル立法ハ實ニ一日ヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
