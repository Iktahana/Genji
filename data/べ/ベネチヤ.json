          "literary": [
            {
              "text": "「クララの光りの髪」とアッシジで歌われたその髪を、真珠紐で編んで後ろに垂れ、ベネチヤの純白な絹を着た。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "クララは床から下り立つと昨日｜堂母に着て行ったベネチヤの白絹を着ようとした。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エジプトとかベネチヤとかいふ漂浪者の群のやうにも。",
              "citation": {
                "source": "一少女",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            }
          ]
        }
