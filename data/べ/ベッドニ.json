        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "婆サンハソレ以前カラモ時々自分ダケ茶ノ間デ寝テイタガ、ベッドニシテカラハ完全ニ別レ／＼ニ寝ルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦ガ予ノ隣ノベッドニ寝ルノハ夜間ダケデ、晝間ハ普通自分ノ部屋ニイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ノイナイ夜ハドウスルカト云ウト、婆サンガ代リニ佐々木ノベッドニ寝ルコトニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベッドニ戻ッテ十五分モ経ツト又尿ヲ覚エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ寝室ノベッドニ腰カケテ一ト休ミシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ家ノ庭ニモ稀ニ蟋蟀ガ鳴クコトハアルガ、コノ寝室ノベッドニ寝テイテ聞エルノハオカシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "又×××号室ニ戻ッテベッドニ横タワル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ昨日一日ノ無理ナ活動ガ祟ッテ、頸ノ周リ、肩、腰、等々ノ痛ミガ激シク、昨夜モ夜ッピテ安眠出来ナカッタノデ、再ビアダリン三錠トアトラキシン三錠ヲ飲ミ、佐々木ニ命ジテ背中ヤ肩ヤ腰ニサロンパスヲペタ／＼貼ラセテベッドニ這入ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――僕ハ何トナク四角ナ壁デ仕切ラレタ安アパート風ノ一室ヲ聯想シ、畳デナクベッドニ寝テイル姿ヲ描イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時僕ガ寝室ニ入ッタ※ハ彼女ハスデニベッドニイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
