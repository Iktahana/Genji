      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "splash",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "洗い物をしていたら、洗剤の迸りが目に入って痛い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "激しい波が岩に当たり、冷たい潮の迸りが顔にかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水たまりに飛び込んだ子供のせいで、泥水の迸りが通行人を襲った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仲蔵なかば、独り言の様に、Ｔ「立派な親が　ないからだ」　尚も強く、Ｔ「立派な家柄がないからだ」　遂に常日頃心の底に秘めて居た欝憤が涙と共に迸り出た。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "次にチョッキの隠袋から、何か小さなものを出して、火縄でそれに点火したのを、手早く筒口から投げ入れると、半秒足らずくらいの後に、爆然と煙が迸り出て、鈍い爆音が聞える。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんだん目が馴れて来ると弾が上がって行く途中の経路を明瞭に認める事が出来る、そして破裂する時に、先ず一方へ閃光のように迸り出る火焔も見え、外被が両分して飛び分れるところも明らかに見る事が出来る。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ややもすれば筆の先に迸りでようとする感激を、しいて呑みくだすように押えつけた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぬいも反射的に立ち上ってその方に行きかけたが、二人が触れあわんばかりに互に近寄った時、渡瀬の全身から何か脅かすようなものが迸りでるのを感じて、急いで身をひるがえしてもとの座になおった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分でも知らずに長く抑えつけていた孤独の感じが一度に堰を切って迸りでたかと淋しかった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巧妙な作戦といふよりも、溢れてゆく彼の性格の迸りであるのを知つた。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何という太く逞しい自分の悪血の迸りだ。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "左舷の當番水夫は今や確に星火迸り、火箭飛ぶ慘憺たる難破船の信號を認めて居るには相違ないのだが、何故か平然として動ずる色もなく、籠手を翳して其方を眺めて居るのみ。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "月は慘たり、月下の海上に砲火迸り、硝煙朦朧と立昇る光景は、昔がたりのタラント灣の夜戰もかくやと想はるゝばかり。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "春枝夫人の嬋娟たる姿は喩へば電雷風雨の空に櫻花一瓣のひら／＼と舞ふが如く、一兵時に傷き倒れたるを介抱せんとて、優しく抱き上げたる彼女の雪の腕には、帝國軍人の鮮血の滾々と迸りかゝるのも見えた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "八蔵は泰助に恨あれば、その頭蓋骨は砕かれけん髪の毛に黒血｜凝りつきて、頬より胸に鮮血迸り眼を塞ぎ歯を切り、二目とは見られぬ様にて、死しおれるにもかかわらず。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小賊肯かずして、則ち刀を執つて其の指を切つて珠を盜むや、指より紅の血衝と絲の如く迸りぬ。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲団から畳に転がり落ちた銀瓶からドッと水が迸り流れた。",
              "citation": {
                "source": "あやかしの鼓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "老父には真剣に娘の身の上を想う電気のようなものが、迸り出した。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬中、寒さに閉ぢ籠められてゐた天地の情感が時至つて迸り出るのだが鬱屈の癖がついてゐるかして容易には天地の情感が開き切らない。",
              "citation": {
                "source": "小町の芍薬",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時その永遠なる底の深みから、強過ぎる、焔が迸り出るので、己達は驚いて立ち止まる。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "割り口説いて云えば斯様でもあるが、何もそれが一ツ一ツに存在しているのではなく、皆が皆一緒になって、青黄赤白、何の光りともない毒火の※となって迸り出て掩いかかるのであった。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫の焔が迸り出たようだった。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ是の如く其の物より立騰り、若くは横迸り、若くは游離するものにして、有るが如く無きが如く、見る可きが如く、見る可からざるが如きものをも、名づけて氣といふ。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "其傍になまぐさき血の迸りかゝれる痕を見りと言へば、水にて殺せしにあらで、石に撃つけてのちに水に入たりと覚たり。",
              "citation": {
                "source": "鬼心非鬼心",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "血が迸り、子路は倒れ、冠が落ちる。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その言葉の終りは唐紅の血となりて初花の鼻と唇より迸り出づる。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "厭がってヒンヒンと鳴いては後去りする豚を無理矢理に枠の中に引っ張り込んで繋ぐ……、尚も悲鳴を上げて泣き続けているのに、大きな薪割様の刃物で、ガンと額に一撃を喰わせる……、するとその額から鮮血が、弾かれたように迸り出て、四辺のものが紅に染められる。",
              "citation": {
                "source": "首を失った蜻蛉",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウードレーの胴衣の前からは、血が迸り出た。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "力を併せて、金盤一つさし上げたるがその縁少しく欹だちて、水は肩に迸り落ちたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍の口よりは、水高く迸り出でゝ、又盤中に落ちたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "の並木の道を走り、白き鵝鳥は、柳の影うつれる靜けき湖を泳ぎ、機泉は積み累ねたる巖の上に迸り落つ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故、この女タイピストの指の悪戯をよささないわけに行かなくなったかと云うに、銀塊急落の最も大きい原因は、印度でおこなわれた幣制の改革と、支那商人の思惑のとばっちりからであった。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "角から二軒目の店の二階にはぼんやり灯影が窓からさしていて、やっぱり世間の生活のとばっちりが橋の上にも沫ねついているのを感じる。",
              "citation": {
                "source": "橋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
