[
  {
    "uuid": "c7415add-c2af-56a1-87c7-8cd1e48b1b6e",
    "entry": "迸り",
    "reading": {
      "primary": "とばっちり",
      "alternatives": [
        "とばしり",
        "とばちり"
      ],
      "is_heteronym": false
    },
    "grammar": {
