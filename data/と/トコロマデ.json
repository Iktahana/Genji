          "standard": [],
          "literary": [
            {
              "text": "フウセンダマト　テフテフハ　タカイ　タカイ　トコロマデ　キマシタノデ、マチガ　ツミキザイクノヤウニ　チヒサク　ミエマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ心アタリノ方ハ私ノトコロマデオ知ラセ下サイ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼニ　フカレテ、ゴミハ　ウエキノ　トコロマデ　トンデキマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴ノ助手ヲスル時、彼女ハブリュウデエッフェル塔ノ模様ノ附イタポロシャツヲ着テ、膝ノトコロマデノトレアドルパンツヲ穿イテイルノガ、素晴ラシクスッキリト意気ニ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
