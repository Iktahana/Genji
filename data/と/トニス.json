          "standard": [],
          "literary": [
            {
              "text": "その頃エジプトの一青年、美娼トニスを思い煩うたが、トが要する大金を払い得ず空しく悶えいると、一霄夢にその事を果して心静まる。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "リード達のスコットランド学派が、ケンブリッジ・プラトニスト達（カッドウォース其他）の後裔であることは無意味ではない。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "真理は直観的に判定出来るとする一切の直観説・神秘説（その内にはスコットランド常識学派もケンブリッジ・プラトニストやシャフツベリ卿も含まれる）は、最も常識的にアッピールする力を持っていると共に、正に常識というものの自己信念はこの明白説をいつも仮定しているのだ。",
              "citation": {
                "source": "認識論とは何か",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "515515　トリートニス湖上に生る。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」(11)　何世紀にもわたってエジプトの医師たちは高名であり、オデュッセイアでトニスの妻ポリダムナはエジプトのヘレンに薬草を与えて言った。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルカドウカ分ラナイガ、大工ヲ呼ンデ滑リ台ト滑車ヲ作ラセ、医療器械屋ヲ招イテ首ノ寸法ヲ測ッテ貰ウコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局コルセットハ止メルコトニシ、滑リ台ニ寝テ頸ノ牽引ダケヲスルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "依ッテ今回モ来週カラ来診ヲ乞ウコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ蔭デ、今日ノ後楽園ノタイトルマッチハ諦メルコトニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本日颯子同伴帰京ノ積リデイタトコロ、子供達ノ学校モ始マルノデ、豫定ヲ早メテ明二十四日皆々引キ揚ゲルコトニスルカラ、明日一緒ニ帰リマショウ、モウ一日オ延バシナサイト婆サンガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオプラトニストは人が直感的にエクスタシーと呼ぶ能力によって「絶対」を知ることができると信じていた。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
