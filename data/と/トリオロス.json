        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "正月の松飾を門から取り下ろし、どんど焼きが行われる神社へと運んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高い棚の奥にしまっていた古いアルバムを、脚立を使って丁寧に取り下ろした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "壁に掛けてあった先代の遺影を取り下ろし、新しく作り直した額縁に入れ替えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "甲の浦沖を過ぐと云う頃ハッチより飯櫃膳具を取り下ろすボーイの声｜八ヶましきは早や夕飯なるべし。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝村人僧の教えのままに、馬頭と金魚、および三足鶏の屍を見出し、また寺の乾の隅の柱上より槌の子を取り下ろす。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "権六は長押に掛けられてある重籘の弓を取り下ろすと、鏑矢雑えて矢三筋弓に添えて小脇に抱え、つと駈け抜けて先頭に立った。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りがかりにたなのひとつからびんを取り下ろすと、〈オレンジ・マーマレード〉とはられてあるのに、とてもがっかり、中身はから。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は大脳の棚の下をそゝくさとゆきゝして幾品かの食品をとりおろす。",
              "citation": {
                "source": "大脳は厨房である",
                "author": "富永太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らはついで掛釘にかかる軛をとりおろす、騾馬のひくべき其軛――黄楊の軛に鈕あり、手綱のための輪を具ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そして仕度が出来あがると、心得たもので、咲子は爪立して、けんどんのうへから燧石を取りおろすと、下駄を穿いてゐる蝶子の後ろからかち／＼切火をして、皆んなを笑はせた。",
              "citation": {
                "source": "チビの魂",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、今なお驚き怪しんでいる道具屋のおやじと質屋のおやじとをしりめにかけながら、立ち上がって箱だなの中からさっき見ておいたお茶わんを取りおろすと、一座の者に二つの茶わんの中をさし示しつつ、明快流るるごとき鑑識のさえを見せました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "青眉の女",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして埃だらけの棚から、小出しに粉を入れておくらしい小さな瀬戸焼の壺を取りおろすと、ぶきつちよな手つきで、そのなかから茶碗へと粉を移し取りました。",
              "citation": {
                "source": "小壺狩",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "棚のお膳を取りおろすのだ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは死骸を取りおろす」「一人で大丈夫ですか」　平次はそれには返事もせずに、先ず死骸の首から千両箱を取りおろしました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事場の一方に作りつけてある棚から、蓋付きの平桶を取りおろすと、おすえは乾いた布切で中をよくぬぐった。",
              "citation": {
                "source": "さぶ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "賊の死骸を取りおろす役目は、管内の消防夫｜粂さんという、威勢のいい、梯子乗りの名人であった。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ駱駝を払い退けて動いた」と宗近君は頭陀袋を棚から取り卸す。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どことなく頬の辺を上気させ、眼をせわしく動かして棚から小鉢などを取り卸す。",
              "citation": {
                "source": "黄昏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "牡猿（篩を取り卸す。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "早く取り降ろすくふうしろ」「だって、このとおり上っちゃいけねえし、手は届かねえんだからね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸い、芝居も休みであれば――」　雪之丞、涙をおさえて、茶棚からとり下ろす、酒罎、杯――　――いよいよ大事の迫った今日お師匠さまと、こうしてお杯をいただくも、これが限りになろうとも知れぬ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……これは尋常なことではいかんぞ」　かれは即座に心をきめた、火桶の火を埋め、身支度を直し、久しく長押に掛けたままの愛槍をとり下ろすと、燈火を消して住居を出た。",
              "citation": {
                "source": "足軽奉公",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
