        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「……コノ日、北風強ク時化トナル。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「喧嘩口論、悪人成敗、命ノヤリトリ、白刄クグリ、ヨロズ退屈凌ギトナルベキ荒事ナラバ何ナリトモ御相談ニ応ズベク候間、遠慮ノウ当館ヘ申出デ可然候。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "西ヨリ来ッテ妻トナル。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ又生産方針ニ干與スルノ權ハ國家全局ノ生産成績ヲ達觀シ得ベキ衆議院ニ於テセザルベカラザル所以トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上兒童ノ權利ハ自ラ同時ニ母性保護トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ母又ハ女子ニ負荷セシメザル所以ハ、愛情アリト雖モ扶養能力ナキガ故ニ、結局其ノ兄弟又ハ娘ノ夫ノ負擔トナリテ立法ノ精神ヲ殺ス者トナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ女學校特有ノ形式的課目女禮式茶湯生花ノ如キ又女子ノ專科トセル裁縫料理育兒等ノ特殊課目ハ全然廢止スベキモノトナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ハ直チニ思想トナリ思想ハ直チニ支配トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此ノ立法ガ男子ノ道念ニヨリテ行ハレザルナラバ忌ムベキ婦人勞働トナリ婦人參政權運動トナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ其ノ兵質ガ、前註説明ノ如ク今ノ少尉級ニ匹敵スベキヲ以テ自ラ現役年限ノ短縮トナルベク、一年又ハ一年半ノ軍隊的軍艦的訓練ハ如何ナル專門的使命アル者モ身心ノ根源ヲ培養シテ其ノ使命ノ大成ヲ準備セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞ノ徹底的理解ハ自ラニシテ正々堂々タル宣布トナル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眉目ノ寸法、配列等ガ当ヲ得レバ美人トナリ、マタ当ヲ得ザレバ醜人トナル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一日に出かけ、十八日にかえる筈だったところ、十八日にツゴウニテカエリ一九ヒトナル電報が来て、やれやれと思って居りました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ今ヤ柳北ト二子ハ皆青天白日ノ人トナルヲ得テ、高橋子モ亦筆墨ノ勲ヲ奏シテ快ク本社ニ凱旋シ、以テ本日ノ賀筵ニ盍簪相娯ムヲ得レバ、吾徒復タ何ゾ汝ヲ怨ミ汝ヲ責ムルヲ為サンヤ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "御申上なれバ、京師柳馬場三条下ル所、楢崎将作死後五年トナル。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "左降シテ嶺南ニ流レテ新州ノ百姓トナル。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「先ヅ槍ヲ以テ敵ニ向ヒ、切折ラレテ後、棒トナル、又棒切折ラレテ半棒トナル……」　そこで彼は独流の型を使いはじめました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "真常流注、外｜寂ニ内｜揺クハ、繋ゲル駒、伏セル鼠、先聖コレヲ悲シンデ、法ノ檀度トナル……」　弁信が物々しく、あらぬ方に向って拝礼をしました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ此理性ト云フ者ハ、經驗ニ因テ愈々練熟ヲ極ムレバ、即チ知識トナル。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "徳川幕府ノ末徴サレテ昌平黌學問所奉行トナル。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "秋月古香略傳",
                "note": "青空文庫"
              }
            },
            {
              "text": "頃之ニシテ妙法院親王ノ召ニ応ジテ侍読トナル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡ソ人ノ子トナルヤ父母ヲ顕スヲ孝ノ終トス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマダイクバクナラズシテ転ジテ杵築侯ノ別業トナル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
