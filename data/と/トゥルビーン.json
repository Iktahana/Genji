          "literary": [
            {
              "text": "『トゥルビーン家の日々』だの『インガ』だの『パン』だの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トゥルビーン家の数日」という国内戦時代の中ブルジョア層を主題にした脚本などは一九二七・八年モスクワ芸術座で上演され、ひどく評判だった。",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが「トゥルビーン家の数日」も「赤紫の島」も上演禁止になった。",
              "citation": {
                "source": "新たなプロレタリア文学",
                "author": "――アレゴリーと諷刺――",
                "note": "青空文庫"
              }
