        "examples": {
          "standard": [
            {
              "text": "城壁の中に敵の軍勢を完全に取りこめるという、大胆な作戦が決行された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "猛吹雪によって登山客たちが山小屋に取りこめられ、救助を待っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "部屋の隅に追い詰めて、逃げ場がないように取りこめる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "たぶん腹をすかして帰ってくるのだろうと、竈突に土鍋をかけて粥を炊き、なけなしの鳥目をはたいて、何年か前の塩ぶりか、石のように固くなったのを買ってきて、焼いて向付けにし、すぐでもとりこめるように、飯櫃と箱膳を出しそろえて待っていたが、なかなか戻ってこない。",
              "citation": {
                "source": "奥の海",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
