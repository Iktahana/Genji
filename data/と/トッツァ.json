        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その後も、一八六六年にはクリストッツァの戦いで勝ち、海軍もまた、リッサ島の海戦と伊太利艦隊を破った！",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だいトッツァン……又止めるんか」「ウン。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ドンナ考えかえ……トッツァン……」「考えチウてほかでもない。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オイ、オトッツァン。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "（こんなオトッツァンに抱き縮められるのは厭さ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしどんなにヒイキ目に見ても、深林地帯のこの競走は、オトッツァンの方が負けるでしょうよ。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一オトッツァンは年寄りだし、それにさんざんジラサレテ、くたくたに体をつからせている上に、持ち物というものがご自慢物ではあるが、二十貫の鉞というのであるから。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ひとのいいオトッツァンには相違ないんだからなあ）　ひどく気の毒になって来た。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（さりとてオレ、あのオトッツァンに、殺されてやるほどの義理はなし。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも二幕全部を完全にやったわけではなく、私が可憐な村娘サントッツァを、サルコリィが若き兵士トゥリドオをやり、帝劇女優の音羽かね子が馭者アルフィオの女房ローラになって、第一幕の有名なサントッツァとトゥリドオの二重唱を中心に抄演したのでした。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトッツァンのナイショ話なんてものは、倅はききたくないやね。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに対して、亭主をオトトと云うが、軽蔑しきって云う時には、トッツァという。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、トッツァマとマの字がつくと尊敬の意がふくまれる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "このカボチャトッツァめが」　こう言って怒られると、どうすることもできない。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でもオレの村では毎朝目がさめると、オトッツァン、ツツガナキヤ、とあいさつしてウレシ涙にくれるほどツツガ虫をこわがっていらア。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の主人をオトッツァンと呼ぶ。",
              "citation": {
                "source": "瀬戸内海の島々",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョキは其オトッツァンが漕ぐのである。",
              "citation": {
                "source": "瀬戸内海の島々",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトッツァンは賣れ殘りだけを載せて夜中には町へ歸り、朝になると再び迎へに行くのである。",
              "citation": {
                "source": "瀬戸内海の島々",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
