          "literary": [
            {
              "text": "）　エルンスト・トルレル――「独逸男ヒンケルマン」「変転」（独逸男ヒンケルマンは戦争で睾丸を失った男の悲痛な生活を書いたものであるが、多分に人道的である。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　ピランデルロ、マリネッチ、トルレル、チャペック、ハァゼンクレイフェル、ゲーリング、オニール、カイゼル等々々。",
              "citation": {
                "source": "他界の味其他",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲーリンク、トルレル、カイゼルらのすべてがまたこの嘆きの中に一様に沈むのである。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホドラー、ムンク、キリコ、初期のピカソ、また文学ではゲーリング、トルレル、カイゼルの中に、このような機械によって隔てられる人間の距離の感覚を把えていたのである。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
