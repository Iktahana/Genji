        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "樺太の新聞からの拔萃で、トマリオロの宿屋に於いて、隣室にとまつてゐたごけ志願者を僅か二十錢の違ひで買ひそこねたとある。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠には、樺太トマリオロの奧なる石炭鑛を見に行つた時に、初めて意識して吸つた強いオゾンのにほひとそれが與へた元氣とを、いまだに忘れられない。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一六（大正五）年　樺太泊居（トマリオロ）の高等小学校二年を一五歳で卒業。",
              "citation": {
                "source": "小熊秀雄全集-1",
                "author": "短歌集",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
