        "examples": {
          "standard": [
            {
              "text": "コンピュータネットワークのトポロジーを星型からメッシュ型に変更した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "位相幾何学、すなわちトポロジーは、連続的に変形しても変わらない性質を扱う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "都市の道路網のトポロジーを解析し、交通渋滞の緩和策を提案する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ちょうどメビウスの輪を描くようにするわけです」「この人工恒星“ラビュリントス”と同じように、トポロジーの原理を応用したわけだな」「そうです。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の体のあらゆるトポロジー、つまり白黒のプリントの無限階調が表現する曲面のすべてに、雄弁でしかも静かな影が、緊迫感をたたえて宿っていた。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（思うにかかる物理的、無機的、個体を個体なりに最も抽象的に一般的にテーマとするのはトポロギーなる幾何学だろう。",
              "citation": {
                "source": "辞典",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "この立場にある心理學者のうちレヴィン（K. Lewin）という人はかかる過程をトポロヂイ解析で數式化して表現しようとし『トポロギー心理學の原理』（外林・松村譯、生活社）という本を出した。",
              "citation": {
                "source": "心理學",
                "author": "矢田部達郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンドンはレヴィンの力の概念も、場の概念も、B＝f（P, E）という式も、現代物理學から見れば兒戲に類するものであり、そのトポロギーも數學でいうトポロギーとは凡そ似つかぬもの而もそれに方向を附け加えてホドロギーなどというものを作ることは數學上不可能だという。",
              "citation": {
                "source": "心理學",
                "author": "矢田部達郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
