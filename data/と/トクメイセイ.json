        "examples": {
          "standard": [
            {
              "text": "インターネットの普及により、匿名性が高まったと同時に、新たな問題も生じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は匿名性を利用して、誰にも知られずに活動していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "報告の公平性を保つため、アンケートは匿名性を重視して実施された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "なにもかもごっちゃになってぼんやりとした印象しか残っていない一九五〇年代のアメリカン・ロックンロールのなかでも、最も匿名性の高い、完結したロックンローラーだった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェームズ・ディーンは、だから、曲名も歌手名も記憶してはいないけれど、ラジオのヴォリューム・コントロールをあげたときのロックンロールのシングル盤とおなじ性質の匿名性を持っていた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "テネシー州のメンフィスにひっこしてからの少年時代のエルヴィス・プレスリーは、ミシシッピー河をすぐちかくに持つと同時に、「良きアメリカ少年」として匿名性を持って、一九四〇年代の終りから五〇年代にかけて、下層中産階級のハウジング・プロジェクト住居のなかに埋っていたのだ。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
