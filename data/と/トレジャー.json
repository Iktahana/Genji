        "examples": {
          "standard": [
            {
              "text": "海賊の物語には、いつも隠されたトレジャーの伝説が登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "博物館には、古代文明が残した貴重なトレジャーが多数展示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古い地図が示す場所には、まだ誰も見つけていないトレジャーが眠っているかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
