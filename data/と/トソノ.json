        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アメリカから持って来たすばらしい――と彼は考えていた――技術に、これだけの兵站をそろえて、そしてこれが、彼の――「十数年ノ後、全道ノ富貴、内地トソノ隆ヲ争フベシ」と断じたおもわくに合致した。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカレドモ十数年ノ後、全道ノ富貴ハ内地トソノ隆ヲ比スルニ至ルベシ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルトソノ時不意ニ清三ガ目ヲサマシテ誰ダト叫ンダノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今晩一晩ダケデス、明日コノ川下ルト海ニ出マス、海ニ出ルトソノ黒船ガ待ッテイルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕山が同人集第三編に「温卿ノ書ハ帖ノ出ルゴトニ輙唐宋ノ名家トソノ工巧ヲ争フ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸山ソノ麓ヲ擁シ扶輿磅※タルコトソノ幾十里ナルヲ知ラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハマイ朝学校ヘ行ク時ニ、キツトソノウサギヲダイテ、ナデテヤリマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハジットソノ顔ヲ見ツメテイタガ、ナイト・テーブルノ抽斗カラ手鏡ヲ出シテソレヲ予ニ突キ付ケテ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢ガコンナニ生々シイ色ヲ帯ビテ見エルノハ神経衰弱ガヨホドヒドイ証拠ダナト、夢ノ中デハッキリトソウ思イナガラ、僕ハジーットソノ夢ヲ視ツメテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
