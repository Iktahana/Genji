        "examples": {
          "standard": [
            {
              "text": "今年度の図書費が削減されたため、新しい本の購入が制限されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "図書費を効率的に使うために、人気のある本を優先的に購入している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "図書費の不足は、学校の図書室の蔵書数に影響している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、入力や校正が無償のボランティアであったとしても、サーバーの使用料や図書費、事務用品等の消耗品代など毎月の出費がある。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし一年の図書費が三百円ほどに過ぎない研究室としては、この購入は相当に慎重を要するものであった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
