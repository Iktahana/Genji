        "examples": {
          "standard": [
            {
              "text": "刺身のつまに添えられた鮮やかな赤い鶏冠海苔が、料理の彩りを引き立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "海藻サラダの中に、コリコリとした食感の鶏冠海苔が入っていてアクセントになっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鶏冠海苔は、その形状が鶏のトサカに似ていることからその名がついたと言われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "汐干に遠く現われる東｜上総の磯の石畳は、ヒジキの薄緑が地の色をなし、その隙々にトサカノリの幽かな紫を交えている。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
