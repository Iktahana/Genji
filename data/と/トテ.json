        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "真実を知らんがとて、彼は危険な場所に足を踏み入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "平和を求めんがとて、多くの人々が立ち上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "失われた時間を取り戻さんとて、彼は猛勉強を始めた。",
