        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "どんなに困難な状況とて、諦めるわけにはいかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "たとえ明日世界が終わるとて、今日すべきことをするだけだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女が反対するとて、私はこの計画を推し進めるつもりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
