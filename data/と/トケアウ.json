    "definitions": [
      {
        "index": 1,
        "gloss": "to melt together",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕焼け空のオレンジと紫が、水平線の向こうで溶け合うように混ざり合っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水彩絵の具を画用紙の上で滲ませると、色が自然に溶け合って美しいグラデーションになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冷たい牛乳にチョコレートソースが溶け合い、甘いココアが出来上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "血肉も骨も筋も一つに溶け合うのは恋しい可愛い人ばっかりだ。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が立合うて、思うには、祖父祖母、親子姉妹、海山百里二百里と、ちりちりばらばらになったのが、一つ土に溶け合うのに、瀬戸ものの欠が交っては、さぞ疼かろう。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "血も肉も一つ身体になって溶け合うのは、可愛い恋しい人ばかりだ。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "霞たつ暖い日で、山は空と溶け合うて、ややともすればその輪廓を見失うほど、杳かに、そして幽かなものであった。",
              "citation": {
                "source": "白峰の麓",
                "author": "大下藤次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "永久に溶け合うことの出来ぬ黄色人種と白色人種との争いを解決するには、民族の文化上の独立が必要だ。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、性わるないたずら気というものは、たやすく真の感情と溶け合うものである。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一種の恐怖を交えた賛嘆をベートーヴェンに対して持っていたグリルパルツァーは彼についてこういった――「彼は、芸術が自然の本然的な気まぐれな諸要素と溶け合うような恐るべき点まで達した」と。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、あなたが望んでいるとおりに溶け合うかしら。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "完全に溶け合うと僕は思う。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれとおぬしとは、心も溶け合うて、こうして一つ夜を語り合ったりしているが、あのお通は、どうしてるだろう。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十九歳で母がその生涯を終る最後のときまで、母と私との間に真からとけあうことの出来ないものとしてのこされた決定的な点が、この時代に芽立った。",
              "citation": {
                "source": "母",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "労働者階級のファシズム反対という声と、学者たちが学問の自由のために叫ぶファシズム反対の声は、国内的にひとつ響きにとけあうばかりか、国際的にこだまする声である。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫婦の真の愛情というものは言葉で表現できないもので、目で見合う、心と心が一瞬に通じあい、とけあう。",
              "citation": {
                "source": "お奈良さま",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "父と母とは、とけあう事が出来なかったのは、当然だったでしょう。",
              "citation": {
                "source": "落ちてゆく世界",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "百姓も貴族もいっしょになり、あらゆる階級の人がひとつの、あたたかい寛大な、喜びと親切の流れにとけあう。",
              "citation": {
                "source": "クリスマス",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "たがいに畑ちがいの仕事であったためについ疎遠にすぎ、きょうだいながら打ちとけあうこともなく過ぎた年月が多かった。",
              "citation": {
                "source": "日めくり",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今夜だけはやむを得ないが、明日の晩からは寝所をべつにできるからね」と良人はまた云った、「お互いの気持がとけあうまで、むりなことはしないようにしよう」　わたくしは「はい」と答えたが、声にはならなかった。",
              "citation": {
                "source": "やぶからし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がふと寺の縁に立つと、あの富士と自分と融け合う三昧が現前したのである。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は愛という一つの神秘に融け合うのに、あまりに現世のままの我が肉体や心が邪魔になるので御座います。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお、文楽で科白が地の文に融け合う美しさに陶然としていたので会話をなるべく地の文の中に入れて、全体のスタイルを語り物の形式に近づけた。",
              "citation": {
                "source": "わが文学修業",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもこの際読者の網目と前句作者の網目と付け句作者の網目とこの三つのものが最もよく必然的に重なり合い融け合う場合において、その付け合わせは最もすぐれた付け合わせとして感ぜられるのである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち解けたときの女の様子や口の利き方には心を惹かれるところがあったが、温かい感情の融け合うようなことはあまりなかった。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になると、お銀は子供を抱え出して、坂のうえあたりまで一緒について来たが、子供に「ハイちゃい」をして下宿へ入って行く笹村は、下宿の空気とはどうしても融け合うことのできぬあるものが、胸にこだわっていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の血と、その子の血とを一つ器にそそぎ入れて、それが一つに融け合うかどうかを試したのである。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "閲微草堂筆記（清）",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十三　面と向って夫としっくり融け合う事の出来ない時、細君はやむをえず彼に背中を向けた。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "綱手は、自分の暖かみと、益満の暖かみとが一つに融け合うのを感じると、すぐ、次の瞬間、二人の肌も融け合い、二人の血が一つになって、流れているような気がした。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつに融け合う夫婦生活は尊い。",
              "citation": {
                "source": "女性の諸問題",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし人と人とのつながりとはこうした機微がなくては、有機的に融け合うものでないのではあるまいか。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、あらゆる情熱も憎悪も自然の平和の中に融け合う。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分以外の本当に唯一な人と思う人さえ本当にはいっしょに融け合う事はむずかしいのです。",
              "citation": {
                "source": "成長が生んだ私の恋愛破綻",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
