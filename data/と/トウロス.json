          "literary": [
            {
              "text": "プラサ・デ・トウロスに、午後四時から今年の季節中でも指折りの闘牛があるのだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ単身徒歩で登場して牛に直面し、機を見て急所へ短剣の一撃を加えて目出度く仕留めるのが、３のマタドウル・デ・トウロスだ。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれは、このバンデリエイルと次ぎのマタドウル・デ・トウロスに多い。",
              "citation": {
                "source": "踊る地平線",
                "author": "血と砂の接吻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
