        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マドゥムアゼルは、この通り、ジュリアン・トレミユ大尉の写真をまだ部屋に飾つてゐるんだ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、この気高い女性の許へ、悲しい報らせだけを持つて来たのに、彼女は、その耐へがたい悲しみと同時に、僕のトレミユ大尉に対する友情と、更に、彼女へのささやかなサーヴィスを、満足を以て受け容れてくれた。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、僕をトレミユ大尉の身代りとして、今夜ひと晩、彼女のそばにおいてやるといふのだ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "マドゥムアゼルの涙を腹いつぱい飲んで、それをトレミユ大尉とやらの墓の前で吐き出すがよい。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
