          "literary": [
            {
              "text": "……なんだ、妙な面をするな、こんなトボケタ小娘だから、なにも知るまいと思って、さんざ出汁がらにしゃぶりゃがったが、事件のありようは元すえまで、なにもかにも知ってるんだぞ。",
              "citation": {
                "source": "金狼",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "トボケタこと言うナイ、吾等の研究はマダ終っていないでなお前途遼遠ダ。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トボケタこと言うナイ、われらの研究はマダ終わっていないで尚前途遼遠ダ。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第一部　牧野富太郎自叙伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "トテトテ、トテーと明るいトボケタ音を立てて馭者がラッパを吹き鳴らす。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が見ても、まるで子供のママゴトみたいで、トボケタ話だと思ってたんだ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
