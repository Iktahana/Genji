        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "高邁ノ精神ヲ喚起シ兄ガ天稟ノ才能ヲ完成スルハ君ガ天ト人トヨリ賦与サレタル天職ナルヲ自覚サレヨ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務長ガ無電ヲ神戸港ノ司令部ニ打ツ　兵来リテ汽車ニテ○○へ急グ　航行中ノ運送船ヨリ縄梯子ヲ降シ、モーターボートヨリ兵乗リウツル。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ内兜を見せる吾輩ではなかったので、引つぎ引つぎ傾けているうちに、忘れるともなく友吉親子の事を忘れていた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマオカマサヨシクンゴフサイガ、シナヘイノギセイトナッタコトヲオクヤミモウシマス、イサイハアトヨリ、ニホンジンクラブ　務の顔色はみるみるかわった。",
              "citation": {
                "source": "白っぽい洋服",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑彌弓呼素　　從來此の人名を讀むに、多くは素の字をモトヨリの義として、下の不和につけて讀めども、余は之を上につけて人名の中に入れたり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "此楼モトヨリ浴ス可ク又酔フ可ク又能ク睡ル可シ。",
              "citation": {
                "source": "上野",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ何ノ趣アランヤ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ行為ニヨッテ害ヲ被ッタ者ガアリトスレバ、モトヨリ彼等ガ不正ナノデアルカラ、従ッテ何等気ノ毒ニ思ヒヤウハナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハコルセットヨリ柔イ布デ頤ヲ吊ルダケデアルカラ、コルセットホド窮屈デハナイガ、首ヲ動カセナイコトハ同ジデ、天井ヲ睨ンダマヽデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトヨリ僕ハ彼女ニ都合ノヨイ、彼女ノ耳ニ痛イヨウナヲ書ク気ニナッタノハ、彼女ノアマリナ秘密主義、―――夫婦ノ間デ閨房ノトシテ聞キタガラズ、タマタマ僕ガ猥談メイタ話ヲシカケルトタチマチ耳ヲ蔽ウテシマウ彼女ノイワユル「身嗜ミ」、ア　偽善的ナ「女ノラシサ」、アノワザトラシイオ上品趣味ガ原因ナノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "那波支配人より電報で九日迄マチネーをやる案に賛成して呉れ返事待つとのこと、腹が立つ、「ゴカンベンネガフトヨリコトバナシ」と返事させる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
