        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "流浪の末に故郷へ戻り、彼はようやく堵に安んずる思いがした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "新しい土地での生活にも慣れ、一家はようやく堵に安んずるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長い放浪生活に終止符を打ち、小さな村で堵に安んずることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
