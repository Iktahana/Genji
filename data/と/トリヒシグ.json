        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "巨大なプレス機が、廃車となった自動車を無残に取り拉いでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は怒りに任せて、空き缶を片手で軽々と取り拉いでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "事故の衝撃で、車のボンネットが原型を留めないほどに取り拉がれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "さればその日の糧を猟らうにも、鹿熊なんどのたぐひをとりひしぐは、指の先の一ひねりぢや。",
              "citation": {
                "source": "きりしとほろ上人伝",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時もし私に彼らをとりひしぐだけの力があつたならば彼らを数珠つなぎにして雀の餌にしたであらう。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡瀬はそのどれをも取りひしぐ自信を持っていた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし彼が現在の位地として、さすがに一人の侍女の訴えを楯にして表向きに頼長を取りひしぐわけにもいかないのを知っているので、彼はあふるるばかりの無念をこらえて、しばらく時節を待つよりほかはなかった。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二番目の「髪結新三」では家主長兵衛をつとめ、万事が師匠の仲蔵写しということであったが、これも愛嬌があり過ぎて相手の新三を取りひしぐ力が足りなかった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「戻って来い」　思った通り、今度は取りひしぐような強い声であった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この第一問で小僧を取りひしぐつもりでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "三つの死",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人と一人で、あの怪物を取りひしぐ程の勇者があろうとは思われぬ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは何とも説明し難いものではあるが彼をして現代の青年の仲間入りしようとする勇気を無雑作に取拉ぐ薄気味悪い力を持っていた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
