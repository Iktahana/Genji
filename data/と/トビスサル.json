    "definitions": [
      {
        "index": 1,
        "gloss": "to leap back",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然茂みから大きな蛇が現れ、彼は驚いて数メートル後ろに飛び退った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "剣道の試合で、相手の鋭い突きを間一髪のところで飛び退ってかわした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "熱いスープが鍋から跳ねた瞬間、火傷をしないよう本能的に飛び退る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "白糸あなやと飛び退る遑もなく、「偸児！",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒョイと二、三歩飛び退ると、俄然態度を一変した。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "止まった刀を手許へ引き、一間あまり飛び退ると、長庵は刀を背後へ廻した。",
              "citation": {
                "source": "村井長庵記名の傘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ビクッとして一二歩飛び退るようにする。",
              "citation": {
                "source": "おりき",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秀陳は仰天してひと飛びに三歩ほど飛び退ると、息も詰りそうなオロオロ声で、「安南帝国皇帝附き諜報部長宋秀陳」「その下級官吏が俺と同じホテルに泊っているというのか。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "この巨人は黒い雷雲を呼び、次いで、飛び退る世界の上に吠え立てる悪魔めいて、その力の切っ先を唸らせた。",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "音もなく飛んだ刀は壮士の小鬢をかすめて、再び刃の音の立つ時、壮士は鳥の如く後ろへ飛び退る、竜之助は透さずそれを追いかける、受けて、また後ろへ飛ぶ途端に、無残や大の男は、石に躓いて※と横ざまに倒れる――この時まで壮士は足駄を穿いていたものです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は後へとびすさるなり人家のある方へ逃げて往った。",
              "citation": {
                "source": "断橋奇聞",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とびすさると同時に左膳の手には、慣れきった乾雲の冷刃がギラリ光った。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると音もなく飛びすさるものがあって、数歩の前に富士が、くっきり、雪の褶の目を現わして聳え立った。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま熱情に燃えさかっている青年が、もし自分の老いさらぼうた後の姿を見せつけられたなら、恐れ戦いて飛びすさることだろう。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "太刀風三寸にして疾知した泰軒うしろざまに飛びすさるが早いか、ちょうど眼前に虚を噛まされておよいでいる突き手を、ジャリ……イッ！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェリチャーニノフがやむを得ず飛びすさると、たちまちのうちにいろんな馬車や群衆が割りこんで來て、彼はぐんぐんと押しへだてられてしまった。",
              "citation": {
                "source": "永遠の夫",
                "author": "ドストエーフスキイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "京姫が汚いものから飛退くように飛びすさると、「無礼者」　奥取締の老女の声と一緒でした。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "夢幻の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二人は互いにぱっと飛びすさると、胸を波打たせて、拳を腰にあてたまま突っ立った。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛ぶと、宙を翔る威力には、とび退る虫が嘴に消えた。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
