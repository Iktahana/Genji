          "literary": [
            {
              "text": "サレバ朝ニ猿ヲ友トセリ」「昼ニ書ヲ読ミシハ？",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "天候｜悪シクシテ風波ノ険甚シク、九週間ノ後漸クかつど岬ヘ達スルヲ得タレド、彼等ハコノ地ニ殖民ノ権利ヲ有セザリケレバ、更ニ南ニ航シテ進マントセリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○英国王、洋中ニ於テ我国人ヲ捕ヘ、強テ之ニ武器ヲ与ヘ、其本国ニ向テ其親戚朋友ヲ伐タシメントセリ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "音讀ナラバカヽル區別ナシ、今假リニ林盡くる所、即ち水源なりトセリ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ澳斯太利人ノ言語ニハ、正義、罪業、罪罰ニ對スル言語ナク、人種下等ノ國ニテハ、仁惠、恩徳等ノ事ハ理會スベカラザルノ事トセリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            }
          ]
        }
