        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "文壇、コノ四、五｜年ナカッタコトダ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それゆえに、８０８６とＧＤＣ、そして互換ベーシックによって「速いＰＣ―８８０１」として生まれたＰＣ―９８０１は、スタートダッシュを決めることができたのだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろんオートダイヤル、電話帳などの機能があって、自動受信、保存後の転送などが可能。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "想像のなかの慶一の視線は、いきなり先生の胸に合ってしまい、あわててティルトダウンして、乱れ籠におかれた、汗のしみついた下着に固定する。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナント　イフ　イサマシイ　オトダラウ」　ヲトコノ　ヒトハ　ムネヲ　オドラセナガラ　アシヲ　ハヤメテ　イキマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ、ドウシタ　コトカ、ゲタニ　バケル　コトダケハ　タイヘン　ウマイ　モノデ　アリマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トダ人蛇咬を療するに、女の髪を捻り合せて、創の近処三所括り呪言を称う（リヴァルス著『トダ人篇』）。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし女の髪といい、三という数がインドのトダ人の呪術にもあるが面白い。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "インドのニルゲリ山間などは虎はあれど人を殺す事至って稀だが家に飼った水牛を害する事しきりだ（リウァース著『トダ人族篇』四三二頁）。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "リヴァースの『トダ人族篇』にいわく、トダ人信ずある特殊の地を過ぐるに手を顔に中て四方を拝せずば虎に食わると。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "またいう最初の神ピチーの子オーン、水牛とトダ人を創造し、今は冥界の王たり。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "トダ人水牛を失う時は、術士｜私かに石三つ拾い夜分牛舎の前に往き、祖神に虎の歯牙を縛りまた熊｜豪猪等をも制せん事を祈り、かの三石を布片に裹み舎の屋裏に匿すと、水牛必ず翌日自ら還る。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとい林中に留まるも石屋裏にある間は虎これを害せず、水牛帰って後石を取り捨つ（リヴァースの『トダ人族篇』二六七頁）。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度のトダ人水牛の牧場を移す式に、司僧の助手童を詛ひ、次に忽其詛を除く事有り。",
              "citation": {
                "source": "詛言に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに寝台の横でトロトロ燃えているペーチカの明りでよく見ると、妾の手や足は凍傷で赤ぶくれになっていて、針金の痕が蛇みたいにビクビクと這いまわっている上から、黒茶色の油膏薬がベトベトダラダラ塗りまわしてあるじゃないの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンボウ人ッテ、ミンナコウヤッテ、オ父ッチャガ死ニ、オ母ッチャモ死ニ、ジブンモ死ナサレテユクモノダナンテ、何ントイウコトダロウ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ少シ手習イシタモノナラダレデモ感ジルコトダ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウソン氏はこれより先数年前、英国サセックス州のビルトダウンの共有地に近い畑で道路を作るために土を掘った時、人間の顱頂骨の小さな片を発見したことがある。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "――眞鍋は、大粒な最も素晴しいコバルトダイヤを妻へ送つてやつた。",
              "citation": {
                "source": "ボルネオ　ダイヤ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷里ノ方ヘハ、海ニ墜チテ死ンダトダケオ伝エクダサイ」　とうとうやったな――と、長谷部大尉は思った。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（邪魔ニサレルコトダッテ度々デスヨ！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こちらはその返電に「クルシイクルシイヘトヘトダ」と打つた。",
              "citation": {
                "source": "講演軍記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆ンナオレガ悪イカラ起ッタコトダト気ガツイタ……も出来がいい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トイフウレシイコトダラウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎は三人の中で一番年長で、前途を苦にして航海中気が変になり、ポートダーヴィンの精神病院へ入れられたというクヨクヨした小心者だが、戸田のほうは商業学校出の店員あがりに似あわぬ悪党｜面で、いよいよとなったら街へ出てホールド・アップもやりかねないドキッとさせるような殺気を身につけていた。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "トダさんのお嬢さんと結婚いたしますこと、ご報告にあがりたかったのですケレドモ、あなたはご病気だそうで、今日まで遠慮しておりましたのです」　戸田の娘がどうしたというんだ。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メルボーンにわたくしが少年でおりましたころ、あなたやトダさん、またヤマゼキさんのいる国のお嬢さんと結婚するなどと考えたことはありませんでした。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ムキミナコトダ）ラヂエエタアの近くで昇天するサヨホナラ。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
