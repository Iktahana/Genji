[
  {
    "uuid": "90075eb1-bd83-51e1-82d3-7f31421de130",
    "entry": "泊まり込む",
    "reading": {
      "primary": "とまりこむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
