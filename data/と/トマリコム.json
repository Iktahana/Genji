    "definitions": [
      {
        "index": 1,
        "gloss": "to stay overnight",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "研究に没頭するあまり、大学の実験室に泊まり込むことがよくある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "大雪で電車が止まり、駅の待合室に泊まり込む羽目になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "徹夜の抗議活動のために、公園にテントを張って泊まり込む人々がいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "都合によると、今夜は泊まり込むようになるかも知れないから、君ひとりで寂しいだろうが、まあ我慢してくれたまえ。",
              "citation": {
                "source": "西瓜",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎青年と主人伊志田氏とのたっての頼みを拒みかね、主治医の友人というふれ込みで、有本医師と名乗って一郎の看病と護衛のために、当分、邸内に泊まり込むことになったのである。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫌いな変装までして、伊志田邸に泊まり込むことになったのも、この美青年の不思議な牽引力によるものであった。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が九ツ十ウくらいの時まで、其奴が伯父伯母の姪の婿の嫁入さきの忰の孫の分家の新屋だというのを、ぞろぞろと引率して、しなくも可い、別院へ信心参りに在方から出掛けて来て、その同勢で、久の実家だと泊り込むんです。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はこゝに泊り込むつもりですから新五郎は兄と一つ蚊帳に這入る。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚五郎も満足して万事の手筈を定め、お安は藤沢の叔母が病気だという口実で、主人の喜多屋から幾日かの暇を貰って、浅草辺の或る浮世絵師の家に泊り込むことになった。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつと旅屋を見つけて、泊り込むと、直ぐと南京虫がちくちく螫しに来るので、迚も寝つかれない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "支倉さんの手紙が手に這入るまで旦那は泊り込むんだよ」「まあ」「ちょっ、そう驚いて許りいないで、茶でも出せ」　浅田はそう云って長火鉢の前にどっかと坐った。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿屋は一行の大勢で泊り込むので、相変らず酒を飲んで雑談に夜を更かしなかなか面白かった。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央停車場の広場をへだてた、ホテル・ヴィクトリヤに泊り込む。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "湖水に沿うた停車場のピンツガウエル・ホーフに泊り込む、客は勿論私きりで、室には火の気もないから、外套なしではいられなかった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルとはいかにも体裁はいいが、建て物からしてすでに小屋で、天井の低い、建てつけの悪い、寝室と名づけたのが、二階に六つばかりあるだけで、グリンデルワルトから、日帰りで遊びに来る客はあっても、大降りにでも出会わさなければ泊り込むものは殆んど無いそうで、宿帳を開けて見ても、知った名前はとんと見当らない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場からダンリーという山駕籠に乗って直にサラット師の別荘〔ラハサ・ビラ〕に参りましたが、大変立派な別荘で私はそこへ泊り込むことになりました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅館というたところが宿屋になって居るという訳ではなく、シナ人がそこへ出て来た時、泊り込むだけになって居るまでの事で別段宿屋の主人というものもない全く無主の旅館　です。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "その僧侶はどこへ泊り込むかというと一般に町家です。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　その晩から、ガラツ八は中江川平太夫の家に泊り込むことになりました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八五郎の戀",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分神田へ帰らねえことにして、音羽へ泊り込むとしようか」　銭形平次がそんな事を言うのですから、よくよくの難事件と見込んだのでしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "活き仏",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方花房一郎は、関子の刺された現場を一応調べてから、直ぐ石井家へ引返して、暫らく自由に調べて見度いから、当分泊り込むかも知れないと言い出しました。",
              "citation": {
                "source": "悪魔の顔",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっしは今晩から、姿をやつして、あの木賃宿に泊り込むときめましたよ」　八五郎は大乗気です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "猿回し",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇田川町の喫茶店は、暖房屋のころから懇意にしていたので、そこに泊り込むわけにはいかなかったが、朝の十時にはもうその店の一隅のボックスにぼくは腰かけていて、夜の十一時十二時まで、殆ど毎日ねばりつづけて暮した。",
              "citation": {
                "source": "私の青年時代",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日からお春どんの代りに私が泊り込むことにして、お春どんは連絡係になって貰おう。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただお春が時々そっと訪ねるらしく、今もそのアパートに住んでいること、啓坊とは内々交際しているけれども先方の家へ泊り込むようなことはしないらしいと云うことを聞いて、まあまあそれならと、いくらか安心していたような訳でした。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "當分神田へ歸らねえことにして、音羽へ泊り込むとしようか」　錢形平次がそんな事を言ふのですから、よく／＼の難事件と見込んだのでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "活き佛",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　その晩から、ガラッ八は中江川平太夫の家に泊り込むことになりました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八五郎の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事の関係で、泊り込む職人が二人ふえたし、そうでなくとも子供たちといっしょでは、どっちのためにも具合が悪いからである。",
              "citation": {
                "source": "ちいさこべ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいてい店の者に断わられるが、強引に泊り込むときもある、そうすると彼もその宿に泊って、明くる朝のことを頼む、あの侍が出立するときは起こしてくれと頼み、一と晩じゅうこちらからどなりたてる。",
              "citation": {
                "source": "ひとごろし",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばん困るのは、千太郎のいないときに、ごろつきのような男が泥酔して泊り込むことで、そういうときには懇意にしていた近所の家へ頼んで、母子が泊めてもらうより仕方がなかった。",
              "citation": {
                "source": "枡落し",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが病みつきとなって、それ以来、彼は出来る限り、二人の隣室へ泊り込むことを目論んだ。",
              "citation": {
                "source": "蟲",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
