    "definitions": [
      {
        "index": 1,
        "gloss": "transactions",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長年の信頼関係に基づき、この企業とは30年以上にわたって取引を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ネットオークションで高額な商品を落札し、慎重に取引を進めることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "違法な薬物の取引が行われているという情報を得て、警察が張り込みを開始した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしともかく、それらの音楽によつて多くの人々が、好い気持にされてゐるのだから文句はないのだが、然しもと／＼気分の暈縁なぞといふオボコイものを聴いて喜んでゐる連中が取引のこととなると俄然骨ばつてくるし、而も楽々骨ばれるやうに前以て備へてゐるので、「音楽と世態」なぞと今並べてみたくなるのである。",
              "citation": {
                "source": "音楽と世態",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへははやり唄の作者や唄本の発行者も集って来て本の取引かたがた町のはやり唄に対する気受の具合を話し合う。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この機構の背後には色々の人間がさまざまの用談をし取引を進行させており、あらゆる思惟と感情の流れが電流の複雑な交錯となってこの交換台に集散しているのである。",
              "citation": {
                "source": "雑記帳より（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "取引先々の好意がなくて到底やりとおせられるものでない。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それには私達、どんな取引きだってするというのよ」　小初のきつい眼から涙が二三｜滴落ちた。",
              "citation": {
                "source": "渾沌未分",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女の前身は外人相手の娼婦なので、魑魅子には東洋の古典の絵巻にあるような繊細なこころは、あいにく持っていなかったが、女取引所にあらわれる体温によって花咲いた男性の手管を、侵略に委せて刺青した、肉体的異国的な地図と感情を失ったエモーションの波、そこに愛情の新らしい鋳型を僕は見出すのだ。",
              "citation": {
                "source": "東京ロマンティック恋愛記",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダム・レムブルグは商取引所に於ての最近の銀の相場の高騰にあって、軍閥の勝利をたしかめると同時に同志の破滅を予感した。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "希臘商人が自転車で忙がしく商取引所方面に疾走し出すころ、マダム・レムブルグが瀝青の浮いた黒襦子の着物をつけて朝のミルクのなかで接吻をすると、海峡を船脚｜迅く航行する汽艇、陳独秀が汕頭に行く姿を指さすのであった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――他国と他国との秘密な取引所、個々の個人の制限のない政治的な争い、投機的な現在支那の商業上の競争、周期的経済恐慌。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "希臘商人が自転車で忙がしく商取引所方面に疾走し出すころ、マダム・レムブルグが瀝青の浮いた黒襦子の着物をつけて朝のミルクのなかで接吻をすると、海峡を船脚迅く航行する汽艇、陳独秀が汕頭に行く姿を指さすのであった。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、不眠症になるような取引を申しこまれたのはどこのマクロー様かね。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妾はいつも間違いのないようにお取引を致しますかわりに、それだけに、駈引のある商人的なお取引はいやなのでございます。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "値違い八千円をもってお取引いたすことにしまして、私が代理人としてこれから登記所へまいります。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "天満天神に朝｜詣りした五花街の女たちが、ふたたび睡るころ、北浜｜界隈は車だまりから人力車が一掃されて、取引市場をとりまいた各商店では、踊子がつけた腰の鈴のように電話が絶えまなく鳴り渡った。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "この界隈の連合委員会の事業振興の決議案にもかかわらず、閑散とした取引市場をとりまいて、日一日と失業者と、彼らの飢えが生産余剰と反比例して街の広場に堆積して行った。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "問屋と取引のある或る宿屋では内地米三十俵も積重ねる。",
              "citation": {
                "source": "外米と農民",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は医科の小使というものが、解剖のあとの死体の首を土に埋めて置いて髑髏を作り、学生と秘密の取引をするということを聞いていたので、非常に嫌な気になった。",
              "citation": {
                "source": "愛撫",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人公の老富豪が取引所の柱の陰に立って乾坤一擲の大賭博を進行させている最中に、従僕相手に五十銭玉一つのかけをするくだりがある。",
              "citation": {
                "source": "映画雑感（４）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はこの女と、ほんの二、三度、闇の物資の取引きをした事があるだけだが、しかし、この女の鴉声と、それから、おどろくべき怪力に依って、この女を記憶している。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さかなくさくて、ドロドロのものを着て、モンペにゴム長、男だか女だか、わけがわからず、ほとんど乞食の感じで、おしゃれの彼は、その女と取引きしたあとで、いそいで手を洗ったくらいであった。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "店と言っても家構えがあるわけでなく鮪や鮫を売る問屋の端の板羽目の前を借りて庇を差出し、其の下にほんの取引きに必要なだけの見本を並べるのであった。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、近頃はまだ噂の行き亘らぬ吉原方面に場所を変え、そこを取引先との交際場にも、自分の憂さ晴らしにも使うようになった。",
              "citation": {
                "source": "とと屋禅譚",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは、極端に現した二例であって、およそ普通の場合には、汽船なら汽船という概念があり、一円には一円という概念があって人間の間に行き亘り、大掴みの感じの上で了解が取引されております。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今日すぐ取引をすると云ふのかい。",
              "citation": {
                "source": "瘢痕",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人聲を密めて、手代に、「いや、些と其のな、商業の取引上、俺に貸金のあるものが參つたで。",
              "citation": {
                "source": "人參",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "藏庫は河岸に揃つて、荷の揚下しは船で直ぐに取引きが濟むから、店口はしもた屋も同じ事、煙草盆にほこりも置かぬ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、われら式が、一念發起に及んだほどお小遣を拂いて、羅の褄に、すツと長じゆばんの模樣が透く、……水色の、色氣は（たつた）で……斜に座らせたとした所で、歌澤が何とかで、あのはにあるの、このはにないのと、淺間の灰でも降つたやうに、その取引たるや、なか／＼むづかしいさうである。",
              "citation": {
                "source": "木菟俗見",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "守吉の申出で、一回の勝負を私達は五銭と定めてゐたのだが、実際のとりひきはその単価で行ふとしても、せめて口だけでは景気好く零を二つ加へた勘定で話し合はうではないか――と、それも彼の発案で、此方も賛成してゐたのだ。",
              "citation": {
                "source": "泉岳寺附近",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "正三もその路をひとりひきかえして行った。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "正三もその路をひとりひきかへして行つた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
