  {
    "uuid": "8ef5f20f-b430-5fb4-b5a7-532840a533bc",
    "entry": "トド",
    "reading": {
      "primary": "とど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アラ磯ニ浪ノヨルヲ見テヨメル大海ノ磯モトドロニヨスル波ワレテクダケテサケテ散ルカモ　一言の説明も不要かと存じます。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "在学中の彼は試験官の銘々の癖をよく呑込んで、例えばトドハンター先生の出す問題を予知したりした。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "公｜爵、男｜爵、老政客、天文學｜博士、實業家など、藝苑では一時｜的に中村時｜藏や千｜葉早智子なども住んでゐたし、シロタやトドロヰッチ夫人のピアノ彈奏を立ち聽きした事もあるし、所謂見｜越の松｜風の淑女も幾人か住むといふやうな物｜靜かな屋｜敷町でもある。",
              "citation": {
                "source": "下手の横好き",
                "author": "―將棋いろいろ―",
                "note": "青空文庫"
              }
            },
            {
              "text": "トドハンターの本を教科書として使っていた。",
              "citation": {
                "source": "田丸先生の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "）と聞く時分から、テケテケテン、テトドンドンと、村のどこかで……遠い小学校の小児の諸声に交って、静に冴えて、松葉が飛歩行くような太神楽の声が聞えて、それが、谺に響きました。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで旦那が、御覧じやした通りの体裁、や、抜けつ潜りつ、こやの軽いのにゃ飽倦ッちゃって、二人とも大汗になって、トド打掴え、掛けたのを外しにかかると、俯向けに倒れながら、まだ抵抗う気だ。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中にゃあ勝ちもした負けもした、いい時ゃ三百四百も握ったが半日たあ続かねえでトドのつまりが、残ったものア空財布の中に富籤の札一枚だ。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤い衣服を着る結局が汝のトドの望なのかエ、お茶人過ぎるじゃあ無いか。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "入って右側に売店とビュフェがあり、文具、日用雑貨、菓子、飲料などを買ったり、ホットドッグ、スパゲティ、ラーメンといった軽食をとることもできる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はい、お待ちどう」と、高志のまえにホットドッグがふたつ、薄緑色の皿にのって出てきた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犬じゃあるまいし、骨なんか愛してたまるかよ」　高志はターンテーブルのカヴァーをあけ、アダプターをおき、ホットドッグを口にくわえ、溝にふれぬように、両手でレコードをのせた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "サブマリンサンドというのは、大魔神のホットドッグのようなものだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おまえのぶん」　高志がテーブルにおかれたホットドッグを、慶一のほうに押しやる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側はトド丸太の桁、アカダモの縁ぶち、並びに板、蝦夷松及びヒノキの垂木。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "放浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "但し、本島に於て主なる木材トドマツ、エゾマツ、落葉松の三種にして、就中落葉松は材質強く、土中又は濕地にも腐朽せざる點よりして、枕木には、適當するも、伐木工賃及び運搬費の關係と利益少きとの爲め、北海道の栓、タモ等の枕木に及ばず。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四、トドマツ、エゾマツはマオカ附近にても之を拂下ぐることを得るも、マオカ附近には落葉松なし。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ダンダン　センサウノ　アル　トコロニ　チカヅイテ　キタラシク、トキドキ　トホクノ　ハウカラ　カスカニ　タイハウノ　トドロキガ　キコエテ　キマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が何の気なしにそれを剥がして見ると、内側の洋皮紙に――イワン・トドロイッチよりニコライ・ニコラエヴィッチ大公に贈る――と認められてあった。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大公の死後に、手ずから書かれた備品目録の中から、カライクの宝冠と皇帝の侍従長トドロイッチから贈られたこの置洋燈が紛失しているのです。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トドハンタアといへば、名高い数学者で、加之に語学の達人で、希臘、羅甸はいふに及ばず、英仏独伊露の現代語から、ヘブリウ、アラビヤ、ペルシヤ、サンスクリツトの東洋語にも通じてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "師匠のド・モルガンは自分が風琴家であつただけ、トドハンタアが音楽に聾なのをよく調弄つたものだ。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、トドハンタアは、全くの所その音律などは少しも判らなかつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登の雲津村数千軒の津なりしに、猩々上陸遊行するを殺した報いの津浪で全滅したとか（『若狭郡県志』二、『能登名跡志』坤巻）、その近村とどの宮は海よりトド上る故、トド浜とて除きあり、渡唐の言い謬りかとある。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "トドは海狗の一種で、海狗が人に化ける譚北欧に多い（ケートレーの『精魅誌』）。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "一向｜埒明かずとあってカリブ人、また鼠を遣わすとこやつ小賢しく立ち廻ってたちまち獏の居所を見付けたが、獏もさる者、鼠に向いわれと同類の汝がわが食物を得る場を垢の他人の人間に告げたって、人間ほど薄情な者なければ、トドの詰まりは狡兎死して良狗煮らるだ。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは他事でもない、その脳髄と自称する蛋白質の固形物自身が、古往今来、人体の中でドンナ役割をつとめているのか、何の役に立っているものか……という事実を、厳正なる科学的の研究にかけて調べてみると、トドのつまり「わからない」という一点に帰着する事だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トドのつまり、まあ考えて見ようから「止むを得ぬ」程度までに変化して終うから、かように名前をつけたものと推察されるのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして最早、スッカリ原始生活に慣れ切っている久美子と、四人の子供達が、澄み切った真夏の太陽の下で、丸裸体のまま遊び戯れている姿を、そこいらのトド松の蔭から、心ゆくまで垣間見た訳ですが、その時のＡの驚きはドンなでしたろう。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから蛇によって象徴された執念深い肉慾に二人が囚われて、信仰をなくしちゃって、エデンの花園を逐われてから、お互いの裸体が恥かしくなったお蔭で、子供がドンドン生まれ初めてこの地上に繁殖し初めたんだから、トドのつまりこの地上で栄えるものはエホバの神の御心じゃない。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
