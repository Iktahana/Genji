        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは折々フットボールが飛んで来て窓硝子が割れるので、校長の考案したことであつた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "千の天使が　　バスケットボールする。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはフットボールの内部のようなものだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "海へころがり込んだフットボールのような万寿丸は、霧のために、目隠しをされたものであるから、九マイルの速力をどうしても、もっと下げなければならないはずであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "その外の娯楽は乗馬、クリケット、フートボール、クロケー、射的などであった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスケットボールが好きで、ＹＭＣＡへ行って、お夕飯ぎりぎりでなきゃ帰って来ないの、ほほほ」　子供のように夫を見做しているような彼女の口振りに、夫を愛していないとも受取れない判断を下すことは、復一に取ってとても苦痛だった。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "バスケットボールをして、この子がボールを拾い当てます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その新文化の最も目ざましい表象として維新時代の夢のまださめ切らなかった生徒たちの心に強い印象と衝動を与えたものはベースボール、フートボール、クリケット、クロケーそれからボートレースなどの新遊戯であった。",
              "citation": {
                "source": "野球時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホワイトボードを使って説明しはじめたゲイツのアイディアは、鈴木のまとめた結論と同じだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣き虫で学校でも友達をうまく作れないジョブズは、野球やフットボールなどの団体スポーツになじめなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの背後に写っているホワイトボードには、一見すれば無作為な数字や記号が並んでいる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬にはゲートボール場になっている向かいの広場が見渡せていたのが、葉が育ち、小さな実がなり始めると、ボールを叩く高い音は聞こえても朝起き鳥の元気なプレイヤーの姿は見えなくなった。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "）作戦にも腰を抜かしたが、やはり衝撃のポイントは、読売巨人軍が『球技の王者』の座をかけてオール・ブラックスに、あるいは戸部三丁目ゲートボール愛好会に挑戦状を叩き付けるがごとき発想の跳び方にあった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬のあいだはゲートボール場になっている向かいの広場が見渡せていたのが、葉が育ち、小さな実がなり始めると、ボールを叩く高い音は聞こえても朝起き鳥の元気なプレイヤーの姿は見えなくなった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからフツトボールを二個、ただ轉がして遊ぶにいいでせう、しかしこれは學校のですからお貸しするのです、御用がすみましたら何卒お返し下さい、とこれはそれを持つて來てくれた學校の小使ひの口上だつた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつちではまた比較的大きな子供三四人づつ兩方に別れて、フツトボールを轉がし合つてゐる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "タッチフットボールをする子どもたちを、ゆっくりとパーンでとらえる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は偶然の思付からフートボールの革袋をむいてゴムへ一杯に空氣を吹き込んだ。",
              "citation": {
                "source": "教師",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "フツトボールがひかるんだ。",
              "citation": {
                "source": "ひかる",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フットボールが飛んできて、兵太郎君の頭にあたりでもすると、かれはふらふらとよろめいて、地べたの上にところきらわずばったりたおれ、あたりどころが悪くて、自分はおだぶつしてしまったのだというようすをして見せるのであった。",
              "citation": {
                "source": "川",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "久助君はまだ、人間がフットボールにあたって死ぬところを見たことはないが、もしそういうことがあるならば、きっと兵太郎君がするとおりの所作をして死ぬだろうと思っていた。",
              "citation": {
                "source": "川",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、フットボールがあたったくらいのこととはちがって、かなり長く、下腹部をひやしたのである。",
              "citation": {
                "source": "川",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "單純ナル遊戲トシテ男子ガ撃劍柔道ニ遊ビ女子ガ長刀鎖鎌ヲ戲ルルハ其興味ニ於テ「ベースボール」「フートボール」等ト雲泥ノ相違アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "金ピカの猿股一つになった木乃伊親爺の相手になって、禿頭の上に逆立ちしたり、両足を捉まえて竹片みたいにキリキリと天井へ投げ上げられたり、バスケットボールみたいに丸くなって手玉に取られたりするのであったがトテモ面白かった。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎斑のシヤツを着てまくわ瓜のやうなフツトボールを蹴つてゐる一群もあつた。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "天幕の波打つ峯と峯との間から突如として飛び上るフットボール。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "学科の済んだあとで、毎日そんな遊戯をやらされていたが、そのほかにもよくフットボールや綱引をやった。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも『オールライト、スウィートボーイス』と云って、嬉しそうに、少し踊るような風で参りますのでございます。",
              "citation": {
                "source": "思い出の記",
                "author": "小泉節子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
