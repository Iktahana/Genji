        "examples": {
          "standard": [
            {
              "text": "この多角形の全ての頂点は凸角であり、内側に凹んだ部分はどこにもない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "設計図を確認すると、建物の角の部分は鋭い凸角を描くように指定されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "数学の問題で、多角形の内角が凸角か凹角かを判定するアルゴリズムを考えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "身をまもるに便利な凸角があればそれにこもる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
