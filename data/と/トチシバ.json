          "literary": [
            {
              "text": "昔の灰の木を今日の植物学者はトチシバとかクロバイとかいって居る。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから書物には山礬をクロバイとかトチシバなどと書いてあるけれども、それは間違って居る。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくトチシバを灰の木といって居ったので、それで灰に用いて居ったのではないかと思いますが、その灰汁の工合に依って色が違うようなことがないとも限らん。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
