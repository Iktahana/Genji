        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「だいじょぶよ、もし時間が気になんなら、それ飲みながらいっしょに歩いていけばいいよ」　娘はすぐ粗末なラシャのトッパアを着て出てきた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずりあがったトッパアを直してやり、力を貸して立たせた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るみに出てきた娘は、寒そうに両腕でトッパアの胸をかかえていた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よせ」片手でけんめいにトッパアをおしはなして彼は少尉の腕に爪を立てた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
