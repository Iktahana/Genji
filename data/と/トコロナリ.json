        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "斎の西遊を慫慂して、「長崎は一とほり見ておきたき処也」と云つた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ当年北畠親房が一時たてこもりたる処也。",
              "citation": {
                "source": "秋の筑波山",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "則天照大神始自天降之処也。",
              "citation": {
                "source": "日本文学の発生",
                "author": "――その基礎論――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども人たる者は生活間は苦んで国に対し亦世に対するが為めに労苦を実行するは此れ人たるの本分なりとする時は、或は不幸にはあらずして却て大幸福なりとすべく、予は大満足として、生活間に於て地獄と極楽との真味を最も能く知れるを以て大に誇る処也。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼田君から示された見聞録にも、「勘定致候処也」など説明してあるのである。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月にいたりても野山一面の雪の中に、清水ながれは水気温なるゆゑ雪のすこし消る処もあり、これ水鳥の下る処也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛に列をなすは雁行とて兵書にもいへり、人のしる処也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔より祀る処也、その縁起は聞もらせり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "房總の里見が武相の北條と戰ふには、必ず據りさうな處也。",
              "citation": {
                "source": "國府臺",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "古戰場としては、小利根の彼方の國府臺、里見氏と北條氏と相戰ひし處、多摩川の此方の分倍河原、義貞が北條の軍と戰ひ、足利成氏と上杉房顯と戰ひ、北條氏康と上杉朝興と戰ひし處也。",
              "citation": {
                "source": "東京の近郊",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢口の渡は、多摩川の川筋かはりしにつれて、むかしとは異なれど、新田義興の遺恨をとゞむる處也。",
              "citation": {
                "source": "東京の近郊",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "口には、味醂酒と思へど、野田は、八村みな桃なる一大美觀をひかへたる處也。",
              "citation": {
                "source": "春の郊外",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸川の左岸に接して、奧州濱街道に當れる處也。",
              "citation": {
                "source": "春の郊外",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "天の橋立は、四十二町の長洲の、松を帶ぶる處也。",
              "citation": {
                "source": "明治神宮と松",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "菅の堤の櫻を見たるついでに、必ず訪はざるべからざる處也。",
              "citation": {
                "source": "菅の堤の櫻",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝは武藏の國府のありたる處也。",
              "citation": {
                "source": "菅の堤の櫻",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝは小金井の櫻の區域終りて、新武藏野の櫻の區域始まらむとする處也。",
              "citation": {
                "source": "千川の櫻",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "津の宮の鳥居河岸は、船舶の集散する處也。",
              "citation": {
                "source": "北總の十六島",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺の名の示すが如く、日蓮の誕生したる處也。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝは、日蓮の少時修業せし處也。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "品川灣より鹿野山を望むに、連亙せる山上に、ぴよこんと、獨りつき出でて、尖りて最も高く見ゆるは、即ちこの白鳥神社のある處也。",
              "citation": {
                "source": "房州の一夏",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒直、その上、石の不動のある小堂のみが殘りて、御利益は、既に盡きけむ、荒れて寂しき處也。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "これむかし、甚兵衞が禁を破り、鐵鎖を切つて、雪の夜半に、宗吾をわたしたる處也。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "水中の森は、甚兵衞が舟をつなぎて、雪にうづもれ、寒風にさらされて、宗吾の歸り來たるを待ちし處也。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒樓相接して、夏は鮎狩に賑ふ處也。",
              "citation": {
                "source": "久地の梅林",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "湊と云へど、わづかに小なる漁舟を通ずるばかりの處也。",
              "citation": {
                "source": "常磐の山水",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝに來りて、はじめて金の三山に圍まれたる處也。",
              "citation": {
                "source": "妙義山の五日",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝはむかしならば、辨慶の戻り岩とでも云ふべき處也、黒田伯之にかはりたるは、伯の威名一世に高かりしを知るべし。",
              "citation": {
                "source": "妙義山の五日",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "溪谷としても、さばかりの事はなけれど　路急にして、老樹多く、巨藤もありて、妙義の三山中にては、とびはなれて幽邃をきはむる處也。",
              "citation": {
                "source": "妙義山の五日",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "三谷へだたれる彼方のやゝ下の處也。",
              "citation": {
                "source": "妙義山の五日",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
