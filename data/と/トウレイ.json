  {
    "uuid": "9834c3ac-f957-589a-aafe-d70783e6fd1f",
    "entry": "唐令",
    "reading": {
      "primary": "とうれい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小中村清矩博士は嘗て、我が國の令は國風習慣を斟酌して、唐令を變改せる所多いに比すると、我が律は唐律に模倣せる所著しいのは、新に成文の律を作り難ければ、大抵は唐律の法文をその儘に採用した結果ならんと主張されたが（『日本古代法典』卷一緒言）、その實彼此の律文に可なり相違がある。",
              "citation": {
                "source": "支那の孝道殊に法律上より觀たる支那の孝道",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "令できめられた制度において唐令から学ばれたものは、前の例であって、儒教道徳の教の如きは、後の例である。",
              "citation": {
                "source": "日本歴史の特性",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [],
      "antonyms": [],
      "related": []
