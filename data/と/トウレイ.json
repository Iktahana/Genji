        "examples": {
          "standard": [
            {
              "text": "居合の演武では、最初に厳かな刀礼が行われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試合開始の合図とともに、両選手は互いに刀礼を交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "武道では、刀礼は相手への敬意を示す大切な作法だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "大将閣下の女王である」　ラッツィン大将が刀礼して、しわがれ声で言った。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            },
            {
              "text": "がらっととりこし苦労とうれいとを捨てたラツールのフランス人らしい性格に、玉太郎は強い感動をうけた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
