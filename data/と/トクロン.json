        "examples": {
          "standard": [
            {
              "text": "大学院の「現代政治特論」の講義では、最新の国際情勢について熱い議論が交わされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "今学期は専門分野をより深めるために、物理化学特論の単位を履修することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は教育学特論のレポートを書くために、連日図書館に籠もって資料を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そうすれば空間の理論は判断論の特論として形づけられるかも知れない。",
              "citation": {
                "source": "性格としての空間",
                "author": "――理論の輪郭――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
