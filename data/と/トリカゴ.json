    },
    "definitions": [
      {
        "index": 1,
        "gloss": "birdcage",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "窓際にある鳥かごの中で、十姉妹が朝日を浴びながら楽しそうにさえずっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "掃除のために鳥かごの扉を開けると、インコが待ってましたとばかりに部屋へ飛び出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "アンティーク風の白い鳥かごを、観葉植物を飾るためのインテリアとして購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "部屋一ぱいに、れいのかつぎの商売道具らしい石油かんやら、りんご箱やら、一升ビンやら、何だか風呂敷に包んだものやら、鳥かごのようなものやら、紙くずやら、ほとんど足の踏み場も無いくらいに、ぬらついて散らばっている。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「月」は毎句にあり、「ガラス戸」が六、「鳥かごの屋根」と「森」と「ランプ」が各二あるが、そのほかにもいろいろの景物が点綴され、ほととぎすや白雲や汽車やブリキや紙や杉木立ちやそういうものの実感が少しずつ印象され、また動作や感覚の上でもだいぶ変化が見えている。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥かごと云ふよりは、鳥箱といふ方が、よくわかるかもしれません。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥かごは、早速、「バタバタ云っちゃいかん。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥かごは、早速、「泣いちゃいかん。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、さう気がついて見ると、小さなガラスの窓は、鳥かごの顔、正面の網戸が、立派なチョッキと云ふわけでした。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよさうきまって見ると、鳥かごは、もう、一分もじっとしてゐられませんでした。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の鳥かごも、いただきました。",
              "citation": {
                "source": "ナイチンゲール",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして白いハンケチを鳥かごにかけてしまいました。",
              "citation": {
                "source": "幸福のうわおいぐつ",
                "author": "LYKKENS KALOSKER",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お茶わかしさんがうたわないというなら、かってにさせたらいいでしょう、おもての鳥かごには、小夜鳴鳥がいて、よくうたいます。",
              "citation": {
                "source": "ひこうかばん",
                "author": "DEN FLYVENDE KOFFERT",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へんだなあ」　とおもったのですが、そのとき印度服をきた鳩つかいが、金ぴかの鳥かごを手にさげて、ぶたいにあらわれました。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝飯後、例によって鳥かごの掃除。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ、泣き乍ら、鳥かごを開いて、鳥を放ち、実際的の家財処理について相談する。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いってみると、鳥かごのなかでカナリヤが死んでいました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とベスは、涙ぐんで、からの鳥かごを見あげました。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その朝の河岸に近く舫ってある船、黒ずんで流れない神田川の水、さては石垣の上の倉庫の裏手に乾してある小さな鳥かごまでが妙に彼の目に映った。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "圃には、花が咲いていましたから、その花を訪ねて、山から小鳥が飛んできたのだろうと思って、いいなき声のする方を見向きますと、おじいさんが、たくさんの鳥かごをさおの両方にぶらさげて、それをかついでこちらにやってきたのであります。",
              "citation": {
                "source": "酔っぱらい星",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてみんなが、ふろしきをかけた鳥かごを見ながら、かわいらしいなどと話をしていると、また、ばたばたといって、ほかのうぐいすがかかったのであります。",
              "citation": {
                "source": "子うぐいすと母うぐいす",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく鳥かごをかけた、戸口の柱の小刀の削り痕もそのままであります。",
              "citation": {
                "source": "山へ帰りゆく父",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、私は、鳥かごから、いかるがを無理に追おうとしました。",
              "citation": {
                "source": "自由",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、餌をやり、水を換えてやってから、鳥かごを、戸口の柱にかけてやりました。",
              "citation": {
                "source": "ある日の先生と子供",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽が、いちばん早く、ここにかけてある鳥かごにさしたからであります。",
              "citation": {
                "source": "ある日の先生と子供",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "高々とそびえる竿のうえの鳥かごでは、ねぼけたウズラが何やらぼそつきだすし、馬屋の壁のなかでは肥えふとった馬が一匹、いかにも切なそうな鼻息を立てる。",
              "citation": {
                "source": "ムツェンスク郡のマクベス夫人",
                "author": "LEDI MAKBET MCENSKOVO UEZDA",
                "note": "青空文庫"
              }
            },
            {
              "text": "かんなくずの山だの、かんなだの、のみだの、のこぎりだの、ひわを入れた鳥かごや、たらいまである。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのも　ポッターさんの　にぐるまを　作りおえたばかりなのに、　さらに　鳥かご　２つを　注文されてしまったのです。",
              "citation": {
                "source": "ちょびひげサミュエルのはなし",
                "author": "まきまきパンのまき",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴さんたちの庭は変化なくこの頃は鳥かごの並ぶこと十三。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鳥は捕まえて、鳥かごに入れた、ニコリ」　グライドが満足げにほほ笑んだ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、さっそく鳥かごをなおして、ヤッローをその中に入れてやりました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "家々にカナリアもどき鳥を一羽、ペンキ塗りの鳥かごに入れて、客間の窓にかけている。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時、とりかごは、急に、ははあおれは先生なんだなと気がつきました。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
