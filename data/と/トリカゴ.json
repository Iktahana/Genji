[
  {
    "uuid": "2ad3911b-c5d1-530f-b0b0-f615b59b1787",
    "entry": "鳥かご",
    "reading": {
      "primary": "とりかご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
