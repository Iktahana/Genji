        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "思想は一つの意匠であるか鬱蒼としげつた森林の樹木のかげでひとつの思想を歩ませながら佛は蒼明の自然を感じたどんな瞑想をもいきいきとさせどんな涅槃にも溶け入るやうなそんな美しい月夜をみた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな瞑想をもいきいきとさせどんな涅槃にも溶け入るやうなそんな美しい月夜をみた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもです、自然の和みのなかに溶け入る黄金の針のやうに微動し戦慄する感受性を開花させないならば、人工香料の平面的な、固定的な、直線的な表情でも、十分に酔ふことが出来るかもしれない。",
              "citation": {
                "source": "「香水の表情」に就いて",
                "author": "――漫談的無駄話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼方は蜒々雲に溶け入る抗愛山脈。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は何ごとかを念じることによって、忽ちそのなかに溶け入ることが出来るのではないかとおもった。",
              "citation": {
                "source": "夢と人生",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひたと我下にある大地ああ、よい　初夏よ私は　母の懐　野天に帰り心安らかに生命の滋液を吸う胡坐を組み只管イスラエルの民のように父なる天に溶け入るのだ。",
              "citation": {
                "source": "五月の空",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽、二上山の山の端に溶け入るやうに消えて、まつくらな空ばかりの、たなびく夜になつて居た。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽、二上山の山の端に溶け入るやうに消えて、まつくらな空ばかりがたなびいた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽、二上山の山の端に溶け入るように消えて、まっくらな空ばかりの、たなびく夜に、なって居た。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」このような本質概念を通じて、即ち本質の照観に溶け入るべき概念的な言葉の意味を通じて、現象は記述されるのである＊＊。",
              "citation": {
                "source": "空間概念の分析",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "エクランでは銀色に溶け入るやうな脚をした一人の踊子が、乱れた食卓の上で前｜屈みに佇んで、不思議に複雑な笑ひを漏した。",
              "citation": {
                "source": "青いポアン",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "まる一と月、わづかな水をすらもどし続けた父には、ながい地獄苦の償ひに、溶け入るやうな静かな臨終が来た。",
              "citation": {
                "source": "母たち",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしはおかしなことをいうとおもってでももうお遊さんは八十ぢかいとしよりではないでしょうかとたずねたのであるがただそよそよと風が草の葉をわたるばかりで汀にいちめんに生えていたあしも見えずそのおとこの影もいつのまにか月のひかりに溶け入るようにきえてしまった。",
              "citation": {
                "source": "蘆刈",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの取り澄ました権高い妻のどこから出るかと思われるほど、それは甘い甘い絶え入るような声、そして溶け入るような含み笑いであった。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は何やらひそ／＼と話して溶け入るやうに、ニツコリとします。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "美少年國",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほの温かくて、秋の空氣の中に、溶け入るやうな白い頬の魅惑、おど／＼した大きい眼、丸ぽちやで、笑くぼが淀んで、阿里道子のえり子のやうな無邪氣な口調など、フエミニストの八五郎を、有頂天にさせるには充分でした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "乘合舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "「其処を入ると、関所破りになりますよ、御存じですか、旦那」　振り向くと、思いも寄らぬ近々に女の首、草叢の中から半身を出して、溶け入るように莞爾するのです。",
              "citation": {
                "source": "大江戸黄金狂",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の女の持って居る滴るような媚態や、溶け入るような魅力は人業の意力の抵抗を超越した悪魔の誘惑です。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第四夜　恋の不在証明",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどどどっ……と廻廊の一角へ馳けて、ひらりと欄を越えた平四郎の影は二、三名の者を刎ねとばして、裏山の闇ふかく――いやもう小禽の声に明けかけた水色の黎明の中へ、溶け入るように紛れてしまった。",
              "citation": {
                "source": "夏虫行燈",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲翔は、ほほ笑みながら、青空へ溶け入る小禽の影を見送っていた――これから生きる自分のすがたと同じものにそれが見えたからであろう。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "読むものが、そのときどきの心のまま、ひとりでにその小説の世界へはいって、いつかそこに表現されている世界にとけ入るような戸口がついていないように、伸子には息づまって感じられるのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂糖と、穀粉そしてわたくしの意匠は血と肉とになって人々に融け入る。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "午前は、樹明さん、敬治さん、冬村さんと四人連れで、其中庵の土地と家屋とを検分する、みんな喜ぶ、みんなの心がそのまゝ私の心に融け入る。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはおのずから、神と偕にある世界、仏に融け入る境地へみちびく。",
              "citation": {
                "source": "物を大切にする心",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "空想は重く、思惟は萎えてただ　只管のアンティシペーションが内へ　内へ肉芽を養う胚乳の溶解のように融け入るのだ。",
              "citation": {
                "source": "海辺小曲（一九二三年二月――）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は美くし、安し、今こそ小き我等も一つの恋と一つの歌をもて無限の世界に融け入るなれ。",
              "citation": {
                "source": "晶子詩篇全集拾遺",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "我を没して自然の中に融け入ることができるからである。",
              "citation": {
                "source": "『青丘雑記』を読む",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが朧ろに、空に融け入るように、ふうわりと浮かんでいる。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが朧ろに、空に融け入るやうに、ふうはりと浮んでゐる。",
              "citation": {
                "source": "月夜の東大寺南大門",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルレスはシャビエルと同じく日本人に信頼し、日本人の生活のなかに融け入ることを念とした。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
