        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同書によれば、アップルのマッキントッシュ向けにアプリケーションを書く契約をビル・ゲイツが交わしてから三週間もたっていない、一九八二年二月十四日、「シアトルタイムズ」紙はマイクロソフトで撮ったゲイツとポール・アレンの写真を掲載した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "モリ南方高地からかけて、ズグナ・トルタ山、マッギオ山、カムポ山、アルメンテラ山を経て、コロー山にわたる伊軍第一陣地は、夕刻までに大半破壊されてしまった。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "羊飼はちょっと吃驚したが、「ああ、あの洞穴は、このエトルタのものはみんな令嬢室と呼んでるだあ。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行目は　エトルタの下手　二行目は　令嬢室　三行目は　フレオッセの砦の下　五行目は　エイギュイユ・クリューズ　しかし四行目は他の行と違っている。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトルタの光井さんのヴィラで」「そうだったかしら」「パパがすこしさらってあげよう。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトルタの光井さんのヴィラでパァティがあったとき、林檎酒に酔っぱらってテラスからおっこちたことがあったね。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトルタどころのさわぎじゃない。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "リューシは　ふみこしだんの　うえに　のぼって、　リトルタウンうらの　おかに　めを　むけました　――　そのおかを　みあげると　うえのほうが　くもに　つっこんでいまして、　まるで　てっぺんが　ないみたいです！",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしこしの　つよい　リューシは　ぜんそくりょくで　おかを　かけあがりまして、　きゅうな　さかみちを　のぼりに　のぼった　――　そのさきでは　――　リトルタウンも　はるか　したのほうに　とおざかってしまって　――　ここから　いしを　なげれば　えんとつに　あてられそうなくらい！",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちが　ゲイツガースの　ぶんで、　このみっつが　リトルタウンからのだね。",
              "citation": {
                "source": "チギウィンクルおばさんのはなし",
                "author": "THE TALE OF MRS. TIGGY-WINKLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "エトルタの有名な空ろ岩のことだね、ルパンの美術館と云われた」「そうだ空ろの針！",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
