          "literary": [
            {
              "text": "「にはとりのくせに、なくなんて生いきだ。",
              "citation": {
                "source": "泣き虫の小ぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "きたないふうをした、ひとりのくずやが、大きなくずかごをかついで、園井さんのやしきのうら門から、勝手口へ、ノコノコとはいってきました。",
              "citation": {
                "source": "灰色の巨人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どちらにもせよ、平さんはたった一人の友達――ともいえないだろうが、ともかくただ一人の知人を失い、また自分ひとりのくらしに戻った。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかんとなればいかほどつよく作るとも一丈のうへこす雪におし崩るゝゆゑ、かろくつくりおきて雪のはじめには此垣をとりのくるなりと語りし事ありき。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関の間には、またひとりのくっきょうな男が、かたをいからして立ちはだかっていましたが、一同を見ると、にこにこしてうなずいてみせました。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
