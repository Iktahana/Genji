          "literary": [
            {
              "text": "一八八三（明治十六）年　四月、学齢未満であったが、国生小学校に入学。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "草の芽、木の芽、昆虫の卵、戸外では発育していよう、洞窟の中の生物といえば、年齢未詳の月子ばかりであった。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は従軍を願い出たが、適齢未満のゆえをもって許されなかった。",
              "citation": {
                "source": "「あかい花　他四篇」あとがき",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
