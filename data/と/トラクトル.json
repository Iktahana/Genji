          "literary": [
            {
              "text": "夏休みが来ると、毎朝早く、赤旗がヒラヒラ風にひるがえるトラクトル（耕作の機械）にのっかって畑に出て行くペーチャの姿を、村の人がみんな嬉しそうに見送った。",
              "citation": {
                "source": "ペーチャの話",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからトラクトルと一緒に新しい文化が農村に及んで来るわけである。",
              "citation": {
                "source": "ソヴェト・ロシアの素顔",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "スターリングラードの耕作トラクトル工場見学に行って、ずうっとドンの炭山まで視察だ」　見学団も各工場から出る。",
              "citation": {
                "source": "ソヴェト労働者の夏休み",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
