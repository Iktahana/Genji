    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　子供は白い女唐服を着ながら広い部屋のなかを、よちよちと笹村の跡へついて来ては歩いていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それには女唐服を着て、お前が諸学校へ入込んで行かなければならぬのだがね」「駄目です駄目です。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "百二　横浜に店を出している知合いの女唐服屋で、お島が工面した金で自分の身装をすっかり拵えて来たのは、それから大分たってからであった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い夏の女唐服に、水色のリボンの捲かれた深い麦稈帽子を冠って、お島が得意まわりをしはじめるようになったのは、それから大分たってからであった。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "其内獅子王だけは唐服を着して居り、又蟻は頭の上に止ったように描かれてあるのが子供心に殊に面白かった。",
              "citation": {
                "source": "春水と三馬",
                "author": "桑木厳翼",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、その大さは矢張り五｜寸許、蒼味がかった茶っぽい唐服を着て、そしてきれいな羽根を生やして居るのでした。",
              "citation": {
                "source": "霊界通信　小桜姫物語",
                "author": "浅野和三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○世に渡唐の天神といひて唐服に梅花｜一枝を持玉ふを画く。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は唐服が好きで時々着用したようで、また非常に似合いまして、唐宋時代の文人墨客を髣髴させます。",
              "citation": {
                "source": "美術学校時代の岡倉先生",
                "author": "板谷波山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
