[
  {
    "uuid": "430a50f9-68c5-523e-b02a-99d6b6dc0f43",
    "entry": "泊り客",
    "reading": {
      "primary": "とまりきゃく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
