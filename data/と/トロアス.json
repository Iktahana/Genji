          "literary": [
            {
              "text": "トロアスの兵黒き蟻の群の如く獲を載せて岸に達せば、その夢いかでか醒めざることを得ん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "君がために恥を忘れ、君がために操を破りたるわれは、トロアスに向けて一｜隻の舟をだに出さゞりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は聖パウロの旅行同伴の医学顧問であり、トロアスからピリピ、ピリピからエルサレム、カエサリアからローマ（62AD）、の３回の旅行を一緒にしていたからである。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
