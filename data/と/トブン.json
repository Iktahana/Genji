        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これは、二階の客人がちょいとぶん殴って見せた跡だよ。",
              "citation": {
                "source": "老ハイデルベルヒ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのなかへ蛙たちは、とぶんとぶんととびこみました。",
              "citation": {
                "source": "二ひきの蛙",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「小僧に捲きつけられた鋼のロープだが、上の鉤のところはやっと外して来たが、あとは足首から切り離そうとしても、固くてなかなか切れやしない」「そんな長いものを引張っていらっしゃるなんて、ご苦労さまですね」「な、なにをッ」岩は子分をピシャリとぶんなぐった。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま叩き落とすから、目を離さないようにネ」「アラ甲虫なの」「さあ、叩き落とすよ」　武夫はなおも身体をのばし、腕にウンと力を入れておいて、竹も折れよとばかり巨大な甲虫をピシリとぶん殴った。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっとぶどう酒が入っているのよ」「ぶどう酒が入っている樽が、どうして空をとぶんだい。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと十分もすれば、原子爆弾の爆発がおこって、あの研究所はこっぱみじんに吹っとぶんだ。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大団円「いよいよジャンガラ星は自力で宇宙をとぶんだそうだが、いったいどこへ行くつもりだろうか」　その夜ふけ、寝床にはいった川上少年は、となりに横になっている山ノ井に話しかけた。",
              "citation": {
                "source": "宇宙の迷子",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家梅野十伍は、拳固をふりあげて、自分の頭をゴツーンとぶん擲った。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "水勢は忽ちそれを捉らえて穴の内面を漏斗形にグルグルグルグルとぶん廻した。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、「わッ」　と悲鳴をあげ、咽喉を抑えると飛び上がり、道場をキリキリとぶん廻ったが、やがてドッタリと床へ倒れ、二、三度左右へノタウッたが、すぐ手を拡げ足を延ばし、咽喉から血筋を床へ引き、凍ったように動かなくなった。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も宮がその音で床をしいているのを、　　　彼の眉としまった　少しへの字にした口許とを　　　　　Обара の気持　何だか宙で一つぐるんとぶんまわって　自分の体の上下がわからなくなったような　自分のこの社会におけるあり場所がわからなくなった感じ。",
              "citation": {
                "source": "心持について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（と、どっかにぶっつけた肘をこすっている）栄二　傍に寄るとぶん殴るぞ！",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつめ、とぶん殴ってやりたいほど、僕は胸がすっきりした。",
              "citation": {
                "source": "慾",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは役場の助役の子で阪井巌というのがかれを見るとぶんなぐるのである。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者がもつとぶん撲らないからだ。",
              "citation": {
                "source": "覚え書",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "うっかりボクが使い走りにでるとぶん殴られる怖れがあるし」「誰がぶん殴るんですか」「政界官界財界のボスのコブンだな」「社員ならぶん殴られないのですか」「そうでもないらしいがね。",
              "citation": {
                "source": "左近の怒り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手になる房吉は、事情を知らないから、さすがに江戸の剣客は研究熱心、勉強のハリアイがあると大いに喜んで、毎日せっせとぶん殴っては追い返す。",
              "citation": {
                "source": "花咲ける石",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚図々々するとぶんなぐるぞ」「趙司晨の妹はまずい。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "よけいな口きくとぶんなぐるぞ」とおせきはやっと我にかえって勝をたしなめた。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、どなって、女房に、「もっとぶんなぐれ、癖になる」　そしたら、女房がまた元気を出してボクをなぐった。",
              "citation": {
                "source": "恐妻家庭円満術",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理に入ろうとするとぶん擲ぐるという勢い。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに王仁だけでなく、私たち全体を茶化し皮肉るところがあるせいで、こいつが何か言うたびに、私はポカリとぶんなぐってやりたくなる。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくの父は、銀行員であって給仕からたたきあげられた人で、家族にとっては怖い存在で、実は恋愛していますなんて相談を持ちかけるには、余りにも古風な人で、想像しただけでも、中学生のくせに恋愛しているとは何事だ馬鹿者奴と、きっとぶんなぐられてしまうより外にはどうにもならない予感がするのであった。",
              "citation": {
                "source": "私の青年時代",
                "author": "山之口貘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そこで最初の王は自分の宝石箱を開け、赤く描き込まれた巻物とぶん回しと鏝とを大工に渡しました。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、月世界へとぶんだよ。",
              "citation": {
                "source": "電人Ｍ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十めんそうは、どうして空をとぶんですか」「それは、二十めんそうがフランスの発明家から買った、せなかへとりつけることのできる、すごく小さなヘリコプターなんだよ。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
