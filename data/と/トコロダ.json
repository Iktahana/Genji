          "literary": [
            {
              "text": "ソレカラ、アソコニハ、サカナ　ト　イウ　キレイナ　オヨグ　モノ　ガ　イテ、ソレハ、ソレハ、オモシロイ　トコロダ　ト　タカ　ハ、ヤマキチ　ヘ　オシエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、マダオ休ミニナラナインデスカ」「今寝ルトコロダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏ヲ送ッテ出ルヲ云エバ、実ハソウシテ貰ウ方ガ僕ノ望ムトコロダッタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
