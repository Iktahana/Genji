        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アルプスのモン・ブランにもなく、シエラ・ネヴァダのマウント・ホイットニイにも見られない町である。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車の窓からも、その中の最大（といっても長さは二｜哩半位しかないが）のホイットニイ氷河が、銀流しに光っているのが見える。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "後の路を取れば、九千尺の高度から、ホイットニイ氷河の末端が出現して、「クレッヴァス」や、堆石の状態がよく判明するということであった。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "永久ニ、コレハ、許サヌコトニイタシマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は「クレオパトラとアントニイ」や「サロメ」など、新しい洋画を欠かさず見ていたが、弁士にもお座敷での顔馴染があり、案内女にも顔を知られて、お座敷がかかれば、そっと座席へ知らせに来てもくれた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしているうちに、彼は酷い胃のアトニイに罹った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "多少は快くなつた筈の胃のアトニイは相変らずで、食べものが不自由なので、後戻りした形だつたが、気管支もひどく悪くなつてゐた。",
              "citation": {
                "source": "佗しい放浪の旅",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀元後二世紀頃にクロオディアス・プトレミィアスといふ数学・天文学・地理学に通じた男がゐたさうで、この男の生涯についてもはつきりしたことは何も伝はつてゐず、僅かにアントニイがエヂプトで現つを抜かしてゐた頃アレクサンドリアを見聞し、アントニイの死後まで生きてゐたことが解つてゐるだけです。",
              "citation": {
                "source": "『ユリイカ』挿話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく観察すれば、日本にも随分アントニイ、コルソフや、ニチルトッフ、ハーノブのやうな人間はあるのだ」と言つて話し出した。",
              "citation": {
                "source": "重右衛門の最後",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニイもそう云う例に洩れず、クレオパトラの鼻が曲っていたとすれば、努めてそれを見まいとしたであろう。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニイもきっと我我同様、クレオパトラの眼とか唇とかに、あり余る償いを見出したであろう。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "況やアントニイの眼をやである。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――胃酸過多、胃アトニイ、乾性｜肋膜炎、神経衰弱、慢性結膜炎、脳疲労、……　しかし彼は彼自身彼の病源を承知してゐた。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "十年間の多産豊饒な漱石の文学作品を見渡すと、ごく大づかみないいかたではあるが、藤尾風な趣味的・衒学的女は初期の作品に現れただけで姿を消し、藤尾の性格の中から、ゴーチェの「アントニイとクレオパトラ」を愛読するロマンティックな色彩をぬき去った女の面が、次第に現実的に発展させられて来ている。",
              "citation": {
                "source": "歴史の落穂",
                "author": "――鴎外・漱石・荷風の婦人観にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その広場のかたすみ、橄欖樹のこかげに、トニイは店をだしています。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてトニイは、そのやたい店のよこに、木の箱に腰かけて、本を読んでいます。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニイは十五歳です。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の前に人がたちどまると、トニイは本をふせ、顔をあげて、にっこり笑います。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、トニイのやたい店は、橄欖樹のかげのなかにあります。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある晩、その広場の、トニイのところからちょうど向こう側に、一人の少女が立っていました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニイは気になって、時々その方をながめました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女はあちこち逃げまわり、広場をよこぎってきて、トニイのやたい店のかげにかくれました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼんやりつっ立っている少女の姿を、トニイはじろじろながめました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「向こうで何をしていたんだい」とトニイはたずねました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなところに立っていたって、花は売れやしないよ」　少女はトニイを見つめました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "トニイはいいました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "よろしい、僕はこの絵はがき屋のトニイだ、僕の店をすこしかしてやろう。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の名はなんというんだい」「マリイっていうの」「ふーん、マリイか」　トニイはやたい店のよこの方をすこしかたづけ、そこにマリイのもっている花をならべました。",
              "citation": {
                "source": "街の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
