        "examples": {
          "standard": [
            {
              "text": "庭の土を掘り起こしたところ、戸閉蜘蛛の巣穴の蓋が現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "戸閉蜘蛛は地中に穴を掘り、精巧な扉を作って身を隠す習性がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "昆虫採集に詳しい先生が、戸閉蜘蛛の巣の構造を子供たちに説明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「とたてぐもの一種なんだよ。",
              "citation": {
                "source": "蜘蛛",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれはころあいを計ってかねて足許にふせてあったとたてぐもの一種を放した。",
              "citation": {
                "source": "蜘蛛",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            }
          ]
