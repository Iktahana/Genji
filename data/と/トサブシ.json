        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さうして「茶よりや蕎麥掻でも拵えろな、腹あつためるにや蕎麥掻の方がえゝや」　といふと「蕎麥掻はえゝな、そんだが鰹節はなにか土佐節か」と四つ又は啄を容れる。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「へゝたえしたことをいふな、何處で聞いて來た」「どこつておら土佐節でなくつちや喰つたことあねえんだ」　百姓の家に松魚節のあらう筈はないのである。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰹節屋の小僧が一生懸命に土佐節をささらで磨いている。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "味噌を選ぶは勿論、ダシに用ゐる鰹節は土佐節の上物三本位、それも善き部分だけを用ゐる、それ故味噌汁だけの価三円以上にも上るといふ。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七月×日）　坊さん簪買うと云うた……窓の下を人夫たちが土佐節を唄いながら通って行く。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷愁をおびた土佐節を聞いていると、高松のあの港が恋しくなってきた。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月×日坊さん簪買ふたと云うた……　窓の下を人夫達が土佐節を唄いながら通って行く。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランマンと吹く風に、波のように蚊屋が吹きあげて、まことに楽しみな朝の寝ざめ、郷愁をおびた土佐節を聞いていると、高松のあの港が恋いしくなった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "土佐節なら、武士に通じるけれど、犬とは何だ？",
              "citation": {
                "source": "求婚三銃士",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「土佐半紙」の名は「土佐絵」、「土佐犬」、「土佐節」などの如く、土佐に因むものとして広く聞えます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
