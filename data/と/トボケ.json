    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのころ毎日のように渓間を遊び恍けていた私はよくこんなことを口ずさんだ。",
              "citation": {
                "source": "交尾",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでいつもながら少し揶揄い気味に、「転んでも、たゞでは起きない相手の胸倉って何よ」　と恍けて訊いてやりますと、母は今度は両袖の口を指先で掴んで背中が痒いように左右に引いて、上体をやけのように身揺ぎ一つさせると同時に、「お巫山戯でないよ。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "へん、いくら、おまえさんが恍けたって、ちゃんとおっかさんには判ってるのだから。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その恍けた大きな眸とぶつかった時、智子は少なからず狼狽した。",
              "citation": {
                "source": "或る母の話",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と空恍けたやうにいふ。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と空ツ恍けるやうに、ちらと空を仰ぎながら、「とすりや、そりや俺がお前を擇んだのぢやない、俺の若い血がお前に惚れたんだらう。",
              "citation": {
                "source": "青い顏",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰の顏を見ても、恍けてもゐなければ笑ツてもゐない、何か物思に沈むでゐるのでなければ、一生懸命になツてゐるか威張ツてゐるか、大概此の型に定ツてゐるから、何れも何か目的と意味を持ツて大眞面目であるに違ない。",
              "citation": {
                "source": "解剖室",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘定のだらしのないのは、大抵のこの稼業の女の金銭問題にふれたり、手紙を書いたりするのを、ひどく億劫がる習性から来ているのであったが、わざと恍けてずるをきめこんでいるのも多かった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが今ごろどうして来たのか、珍らしい人が来たものだと、わざと恍けていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お島は女が二階から降りて来ぬ間に、手捷こくそこらを掃除したり、朝飯の支度に気を配ったりしたが、寝恍けた様な締のない笑顔をして、女が起出して来る頃には、職人たちはみんな食膳を離れて、奥の工場で彼女の噂などをしながら、仕事に就いていた。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいち自分の年さえ忘れるくらいですもの」　嫂のこの恍け方はいかにも嫂らしく響いた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがお前はいつまでも言葉を左右に託して、空恍けている……」　　　　　　　　二十二「空恍けてると云われちゃちっと可哀そうですね。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがお前はいつまでも言葉を左右に託して、空恍けている……」　　　　二十二「空恍けてると云われちゃちっと可哀そうですね。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ夜が明けたかなんて恍けて……。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう夜が明けたかなんて恍けて……。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつでもこの小紋の羽織の寐恍けたのばかりは恐れるね。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度其中には、例の種牛も恍け顔に交つて居た。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度そこへ来て、座りもせず、御辞儀もせず、恍け顔に立つた小娘は、斯細君の二番目の児である。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "水草を越して流れるほど勢の増した小川の岸に腰を曲めて、三吉は寝恍けた顔を洗った。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
