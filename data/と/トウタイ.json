  {
    "uuid": "3b471f94-d756-5253-bf4a-0d0db352eede",
    "entry": "当体",
    "reading": {
      "primary": "とうたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
