        "examples": {
          "standard": [
            {
              "text": "子どもの誕生日に図書カードを買ってあげたら、その子は毎週末に図書館に行くようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "図書カードの残高が少なくなったので、新年に新しいものを購入することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "図書カードは本好きへの贈り物として重宝されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "これにより、作品登録・管理がシステム化され、インデックスや図書カードも自動的に生成されるようになった。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
              }
            },
            {
              "text": "校正済みのテキストファイルを整えて、ＺＩＰ圧縮、ＨＴＭＬ化、エキスパンドブック作成、さらに図書カード作成、インデックス作成、〔そらもよう〕への告知……。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
              }
            }
          ]
        }
