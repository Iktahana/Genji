        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはモデルン劇場に出てゐるトムスキイ劇団であつて、主要な俳優は悉く本格的な修業を経てゐるらしく演し物も却々こつたものをやつてゐた。",
              "citation": {
                "source": "生活文化の建設",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこぢや、毎晩のやうに、ウフトムスキイとウオトカを飲んだもんだ。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ウフトムスキイ公爵とかい？",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ウフトムスキイ公爵とそんなに懇意なら、どつかで会つたかもしれないね。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それみろ、ウフトムスキイの相棒で、酒飲みのユダヤ人……。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウフトムスキイ公爵まではよかつたが、あとがいけなかつた。",
              "citation": {
                "source": "放浪者",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それでちゃんと分かっているじゃあないか」と、トムスキイが批評をくだした。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうして僕の祖母がプント（賭け骨牌の一種）をしないかが僕には分からないのだ」と、トムスキイは言いつづけた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイはパイプをくわえると、うまそうに一服吸ってから、またそのさきを語りつづけた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイは断乎たる口ぶりで答えた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君は三枚ともまぐれ当たりに勝つ方法を知っているおばあさんが生きているのに、彼女からその秘密を引き出し得なかったのか」「むろん、僕もいろいろに抜け目なくやっては見たのだがね」と、トムスキイは答えた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえば、公爵夫人も随分お年を召されたことだろうね」「なにをおっしゃっているのです、おばあさま」と、トムスキイはなんの気もなしに大きい声で言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイは若い婦人とあとに残った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "え、おまえはどうしてナルモヴが工兵隊だろうなどと考えたのだ」　こう言い捨てて、トムスキイは祖母の部屋を出て行った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイが彼の祖母の伯爵夫人に、友達の一人を紹介してもいいかと訊いたとき、この若い娘のこころは烈しくとどろいた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしナルモヴが、工兵士官でないと聞いて、彼女は前後の考えもなしに、自分の心の秘密を気軽なトムスキイに洩らしてしまったことを後悔した。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが不思議なことには、今夜の舞踏会の席上で、ポーリン・Ｎ公爵の令嬢がいつになく自分と踊らなかったので、すっかり気を悪くしてしまったトムスキイが、おまえばかりが女ではないぞといった復讐的の態度で、リザヴェッタに相手を申し込んで、始めからしまいまで彼女とマズルカを踊りつづけた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君の親しい人の友達からさ」と、トムスキイは答えた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そのヘルマンという男はね」と、トムスキイは言葉をつづけた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイが選んだ婦人はポーリン公爵令嬢その人であった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "公爵令嬢はいくたびもトムスキイと踊っているうちに、彼とすっかり仲直りをして、踊りが済んだのちに彼は公爵令嬢を彼女の椅子に連れて行った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイの言葉は、舞踏中によくあるならいの軽い無駄話に過ぎなかったが、この若い夢想家のリザヴェッタの心に深く沁み込んだ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイによってえがかれた半身像は、彼女自身の心のうちに描いていたものと一致していたのみならず、このいろいろのでたらめの話のお蔭で、彼女の崇拝者の顔に才能があらわれていることを知ると同時に、彼女の空想をうっとりとさせるような特長がさらに加わって来たのであった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、トムスキイの言葉が彼女の心の中でこう反響しているのに気がついた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            },
            {
              "text": "トムスキイは大尉級に昇進して、ポーリン公爵令嬢の夫となった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
