        "examples": {
          "standard": [
            {
              "text": "衝突の激しい衝撃でエンジンの部品が飛び離れ、道路脇のガードレールを突き破った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "集団で木の枝に止まっていたカラスたちが、天敵の接近を感じて一斉に四方へ飛び離れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この二つの解決案はあまりに内容が飛び離れていて、議論の余地が見当たらない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "源八は、（もうその手は食わない）　というように、樹の下から飛び離れると、脇差の先を、宙へ構えて、「ただ小次郎とだけでは分らぬ。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お綱が蝶のように飛び離れると一緒に、三次、隼人、為なども、腰を立てて凶猛な気配りになる。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "お捨てになつちや嫌」　しかし、すぐに、狂気から醒めたやうに、三吉の体をとび離れると、空虚な声でつぶやくのであつた。",
              "citation": {
                "source": "悪夢",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
