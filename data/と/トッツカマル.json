        "examples": {
          "standard": [
            {
              "text": "逃げ回っていた容疑者はとうとうとっ捕まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "悪さをしていた子供たちは先生にとっ捕まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "スリはデパートの出口でとっ捕まり、客に取り囲まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "博士だって、老人だから、そのうちにくたびれて、警官にとっつかまるだろう」　二人は、だんだん気がかるくなったようにみえた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方の五時以後に外出すると、憲兵にとっつかまるんだぞ」「よく聞えますから、大きな声をしないでちょうだい」「探しにやろうかと相談していたところなんだぞ。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "気味が悪いからこんな銭すてっちまいましょうか」「それは、ともかく、こんなところでマゴマゴしていると、また客にとっつかまる。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "両国の大鯨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおって、また、とっつかまるで！",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに居ってまた、とっつかまるで！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
