  {
    "uuid": "74ded49d-27f3-59d1-94ef-c78fa9c26fc5",
    "entry": "トガ",
    "reading": {
      "primary": "とが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もとはポルトガル語だといい聞かされて初めてそうかと知るくらいのものである。",
              "citation": {
                "source": "外来語所感",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "と御冗談めかしておつしやいましたけれども、或いは、御陽気に見えながらその御胸中には深い御憂悶を人知れず蔵して居られたのでもございませうか、その辺の事は私どもには推量も及ばぬところでございまして、ナンニモ、スルコトガナイ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、夢デ見タコトガアリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和八年四月、鉄塔）三　春（ハル）のラテン語が ver であるが、ポルトガル語の 〔vera:o〕 は夏である。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真機のピントガラスに映った自然や、望遠鏡の視野に現われた自然についても、時に意外な発見をして驚くのは何人にも珍しくない経験である。",
              "citation": {
                "source": "津田青楓君の画と南画の芸術的価値",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十年十一月十六日『東京朝日新聞』）　　　　　　　　　三十九　　　　　　赤茄子の伝来　洋食に用いるトマトの来歴を調べた人の説によると、この植物は十六世紀の中頃に南米ペルーからスペインあるいはポルトガルに渡りそれから欧洲に拡がったものである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "女皇陛下の電話　昨年の暮ポルトガルの女皇アメリー陛下がパリに御滞在中の出来事である。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでターバンを巻いた印度人、皮膚の色褪せたペルシヤ人、半黒焼のマレー人、亡国的なポルトガル人などの群に交って北京を出発してから半ヶ月後、支那の現代のシステムに出現した支那女との恋を棄てて北京以来の友である陳子文と米良は病み疲れていた。",
              "citation": {
                "source": "地図に出てくる男女",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリツク怒濤、実ハ楽シキ小波、スベテ、コレ、ワガ命、シバラクモ生キ伸ビテミタイ下心ノ所為、東京ノオリンピック見テカラ死ニタイ、読者ソウカト軽クウナズキ、深キトガメダテ、シテハナラヌゾ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　頃はポルトガル第一の科学者モンテス博士の南極探検船が、ある夜秘密にセントウベス湾を出発した、二カ月ほど以前の事である。",
              "citation": {
                "source": "南極の怪事",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上はコルテス博士がポルトガルの海岸にて拾上げし、不思議なる瓶中より出でし不思議なる書面なり、記者はもはや多く記さず、賢明なる読者諸君は、なにゆえに近頃ヨーロッパの学者社会より、幾度の失敗にも懲りず、しばしば不思議なる南極探検船の派遣せらるるか、その秘密をば知りたもうべし。",
              "citation": {
                "source": "南極の怪事",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "小十郎は夏なら菩提樹の皮でこさえたけらを着てはむばきをはき生蕃の使うような山刀とポルトガル伝来というような大きな重い鉄砲をもってたくましい黄いろな犬をつれてなめとこ山からしどけ沢から三つ又からサッカイの山からマミ穴森から白沢からまるで縦横にあるいた。",
              "citation": {
                "source": "なめとこ山の熊",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ポントというのはポルトガル語で港のことだ。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ結果、俺ハ双生児ノ片割レデアルトイフコトガ判明シタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その船はつい二三年｜前、オポルトウの北方数｜哩のポルトガルの沖合いで沈んでしまった。",
              "citation": {
                "source": "入院患者",
                "author": "コナンドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "一味はあの不運な蒸気船ノーラ・クリーナ号の乗客に紛れたが、その船は数年前、ポルトガル沿岸、オポルトの北数リーグのところで乗客もろとも消息不明となった。",
              "citation": {
                "source": "患者兼同居人",
                "author": "THE RESIDENT PATIENT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともかく、そのアヒルは、ポルトガル種と呼ばれました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "その卵から生れてきたものは、みんな、ポルトガル種と呼ばれました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポルトガル種と言われるだけで、もうかなり重要なことなのです。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのけたたましい鳴き声を聞くと、気分がわるくなってしまうわ」と、ポルトガル種の奥さんは言いました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれこそ、ポルトガル調よ！",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって、そういう性質は、わたしの血の中に、このポルトガル種の血の中にあるんですもの」　こんなふうに、ポルトガル奥さんが、おしゃべりをしていると、その歌をうたう小鳥が落ちてきました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そりゃあ、あのならず者の、ネコらしいやりかただよ」と、ポルトガル奥さんは言いました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポルトガルなら、こんなことはないと思うわ」　そして、その歌うたいの小鳥を、かわいそうに思いました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポルトガル種でない、ほかのアヒルたちも、同じようにかわいそうに思いました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしたちは、それを口に出して言いはしないけど、みんなそう感じてはいるのよ」「それじゃ、わたしが言いましょう」と、ポルトガル奥さんは言いました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、わたしたちの義務なんですもの」　こう言うと、ポルトガル奥さんは、水桶の中にはいって、水をピシャピシャはねかしました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは、親切な行いというものよ」と、ポルトガル奥さんは言いました。",
              "citation": {
                "source": "アヒルの庭で",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
