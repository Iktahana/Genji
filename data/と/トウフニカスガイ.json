        "examples": {
          "standard": [
            {
              "text": "どんなに注意しても聞く耳を持たない彼に、いくら言っても豆腐に鎹だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの人にアドバイスしても、いつも豆腐に鎹だからもう諦めたよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「何度言えばわかるんだ！」「いくら言っても豆腐に鎹なんですよ、部長。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "東　年寄の冷水西　豆腐に鎹　老人のなまじひに壮者を学ぶを危めるは東の諺、鉄釘至剛なるも至軟の物を如何ともする能はざるを歎ぜるは西の語。",
              "citation": {
                "source": "東西伊呂波短歌評釈",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうです、意気なお方に釣合わぬ……ン、と一ツ刎ねないと、野暮な矢の字が、とうふにかすがい、糠に釘でぐしゃりとならあね。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
