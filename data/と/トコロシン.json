          "literary": [
            {
              "text": "市中到る処新緑賞すべし。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "當年知事たりし三島通庸は、山形縣に、福島縣に、栃木縣に、到る處新道を開けり。",
              "citation": {
                "source": "鹽原新七不思議",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、衣帶の知れぬ遠處新來の神をも、まれびとに對して懷いた考へ方に容れる事になつた。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            }
          ]
        }
