          "literary": [
            {
              "text": "イザ食べようという時｜小口から極く薄く切って溶き芥子を添えるのだ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからパンの方へバターを塗りその上へ溶いた芥子を塗ってパンの間へ牛肉のロースか鳥のロースを挟んで小さく切っても出来ますが、丁寧にすればその肉を肉挽器械で挽いてバターと塩と溶き芥子と外に細かく刻んだ玉葱でも交ぜて少し煉るようにしてパンの間へ挟むとようございます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
