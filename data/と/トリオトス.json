[
  {
    "uuid": "235ace56-699b-597d-8775-fdea11274436",
    "entry": "取り落とす",
    "reading": {
      "primary": "とりおとす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行"
      ],
