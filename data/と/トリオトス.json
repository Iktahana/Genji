      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to drop",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "驚きのあまり、手に持っていた湯呑みを床に取り落としてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "滑りやすい素材のスマートフォンを、不注意で排水溝の隙間に取り落とした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "あまりの重さに耐えかねて、運び出し中の家具を一瞬取り落としそうになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "網棚に絵の具箱をのせる空所もなかったのでベンチにのせかけて持っているうちに、誤って取り落とすと隣に立っていた老人の足に当たった。",
              "citation": {
                "source": "写生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそこで危く双眼鏡を取り落とすところであった。",
              "citation": {
                "source": "風船美人",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして全ての読み手と全ての書き手は、二つの世界の間でなんらかのものを取り落とす。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも感に堪えたように幾度か掌面にひねくり廻しているうちに、どうしたはずみにか、つい御器を取り落とすような粗忽をしでかした。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人や支那人だって、ある時代の要求に応じて、その弁髪や丁髷を切り落す時は、生命の玉を取り落とす以上に感じたことであったらしい。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あっ」と叫んで持っていた刀を手からポロリと取り落とす。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、うなるとたんに思わず刀を取り落とす。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きょうあるとこで棺を担ぎ出していたが、あやうく取り落とすところだったよ」わたしはだしぬけに大きな声でこういった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はハンカチを取り落とす。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのつど僕は、それを取り落とすことなく、空中で捕まえなくてはいけなかった。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜のからんからんに乾いた空気の、その底でうつかり　咳をとりおとすと発止！",
              "citation": {
                "source": "雪",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして電灯が消えていたのは、ほんの三十秒ほどのあいだでしたが、それにしても、少年たちでさえ、そんな入り口の近くでは、だれもつまずかなかったのに、日ごろ注意ぶかい名探偵が、懐中電灯をとりおとすなんて、少しへんではありませんか。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は箸を取り落すほど、がっかりした。",
              "citation": {
                "source": "デカダン抗議",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然如来の光背の辺で、後光が燦いたのだ」「なに※」熊城が思わず莨を取り落すと、「ああ、貴方は実に怖ろしい人だ！",
              "citation": {
                "source": "後光殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正気を失わないものが、嬉しいと云う自覚だけを取り落す訳がない。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "政宗はいつに変らぬ亭主のねばり強さに感心させられたが、それでも腹のなかではもしか俺だったら、初めに手にとり上げたが最後、どんなに熱くたって釜の蓋を取り落すような事はしまいと思った。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "……………………と………インキ壺の中に何か落ち込んでいるのに気がついて、ペン先で二三度突つき、その中の一個をかき上げると、ハッとしてペン軸を取り落す。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そのうしろから突然にパッと光線がさす――◇美人の手…………ハッとしてハンカチを取り落す。",
              "citation": {
                "source": "涙のアリバイ",
                "author": "――手先表情映画――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてぶるぶると震え出しながら、力なくブローニングを取り落すと、がっくりとうなだれたまま志免警視の方に両手をさし出した。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿屋の主人はこの時まで、自分のおかみさんや子供達が真黒になって泣いているのを見て、ボンヤリ突立っておりましたが、忽ちピストルを取り落すと、無茶先生の前に跪いて、真黒な顔を畳にすり付けながら、「どうぞどうぞお泊り下さいお泊り下さい」　とピョコピョコお辞儀をして、手を合わせて拝みました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな妾が一人でした事だって……ですから貴方は……あなたは早く逃げて頂戴……同罪になるといけないから……店の金庫の合牒はイナコよ……サヨウ……ナラ」　彼女が受話機を取り落す音がした。",
              "citation": {
                "source": "鉄鎚",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫は益々呆れてしまって、思わず手に持っていた書物をパタリと地上に取り落すと、間もなく颯と吹いて来た秋風に、綴じ目がバラバラと千切れて、そのまま何千何万とも知れぬ銀杏の葉になって、そこら中一杯に散り拡がった。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌て者の日本人はすっかり驚いて、日本魂までデングリ返らせた結果が、今日では処構わず爆弾を取り落すような悲しい民族的精神となり果てた。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "うつかりそんなものを見せでもすれば、過失を装うて石の上にでも取り落す位ゐのことは第八にとつては朝飯前だ。",
              "citation": {
                "source": "木枯の吹くころ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、突いた後で気が弱ってすぐその場へ取り落す方が自然ではなかろうか、と勘次は考えた。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "のの字の刀痕",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう少しで風呂敷包を取り落す所だった。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時葉巻用のパイプを取り落す。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――男、兇器を取り落す。",
              "citation": {
                "source": "撮影所殺人事件",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのその頃のお住ひは、名古屋の撞木町ではありませんか」　このひと言を耳にすると、さすがの産婆も、赤ん坊を取り落すかと思ふほど、驚いて、「名古屋、撞木町、そのとほりでございます。",
              "citation": {
                "source": "記憶のいたづら",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「助次郎、すぐ身を起し、流しもとから、菜切ばう丁をぬき持たうとするが、刑事に、ぐいと腰なはを引かれて取り落す。",
              "citation": {
                "source": "戯曲二十五篇を読まされた話",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
