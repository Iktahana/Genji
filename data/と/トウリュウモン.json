        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "難関試験の合格は、まさに登竜門だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このコンクールは、若手デザイナーにとっての登竜門となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "プロの世界への登竜門をくぐるために、日々努力している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "三　登竜門ここを過ぎて、一つ二銭の栄螺かな。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "登竜門というものは、ひとを市場へ一直線に送りこむ外面如菩薩の地獄の門だ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "情けない事には、巴里の如くその玉を引取るべき画商がなく、展覧会は完全に登竜門の大競技場となり漫歩の背景となりつつあるが為めにこの常設館のイルミネーションの中で完成されたる滋味ある宝玉も同居するのだから、甚だそれはねぼけた存在と見え勝ちである。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "照近江のお鯉という名は、時の宰相の寵姫となる芽出度き、出世登竜門の護符のようにあがめられた。",
              "citation": {
                "source": "一世お鯉",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからスカラ座はいわばメトロポリタンに出る登竜門みたいな役割と格式を持っているのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はかくの如くにして、彼等の登竜門が今や目前に開かれたるを感じたり。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "この意味で、新劇協会の舞台は、凡ゆる前途ある俳優の道場であり、展覧会であり、登竜門である。",
              "citation": {
                "source": "俳優養成と人材発見",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ふにその時分、大貫と私とは既に「新思潮」を登竜門として大いに文壇に活躍しようとする意気込みを示してゐたから、或はそんな事が彼の負けじ魂を刺戟したのではなかつたであらうか。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは堂々たる小説家の小説の類ではなく、雑誌の隅っこに、やっと半頁くらい掲載された何十行かの詩と、それを発表している詩人の名前が、毎月の登竜門となって羨望の眼で読まれた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって当時は文壇人という者が非常に少なく、徳富さんに招ばれるということが、一つの登竜門になっていた。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに又、文芸評論家や一般の評論家達の登竜門が、ブック・レヴューであるということ、現代の有名な評論家の多くがブック・レヴューの筆者としてまず世に出たという例、これは相当著しい事実なのである。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのためすっかり痩せてしまって、晩年の尾崎紅葉みたいな顔になったと、友達に冷やかされたが、ともかくも当時秀才の登竜門だった一高の入学が叶って、首尾よく一高の健児になりすまし、あらゆる文芸運動から遠ざかって、もっぱら向陵の健児ということで、野次馬学に精進した。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "銭形平次以前",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜は、「九九鱗」といって、八十一枚ウロコがあるそうだが、登竜門といって、出世魚とされている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、若いフランクはその両親の望みを裏切って作曲に没頭し、作曲界の登竜門とも言うべき、ローマ大賞を狙って努力を続けたために、父親の激しい反対を受けて、作曲も学業も断念し、故郷のベルギーに帰らなければならなかった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の巡査だが、当時はそれが唯一の登竜門で、邏卒から大臣まで出世をした人が大勢ある。",
              "citation": {
                "source": "村の成功者",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　登龍門ここを過ぎて、一つ二錢の榮螺かな。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "登龍門といふものは、ひとを市場へ一直線に送りこむ外面如菩薩の地獄の門だ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の士族気質から唯一の登龍門と信ずる官吏となるのを嫌って、碌でもない小説三昧に耽るは昔者の両親の目から見れば苦々しくて黙っていられなかった。",
              "citation": {
                "source": "二葉亭四迷の一生",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「文学の道場として、また文壇への登龍門として、同人雑誌の貴重さに及ぶものはない。",
              "citation": {
                "source": "しかし昔にはかえらない",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "火野葦平が「文壇登龍門」とし、「道場」という同人雑誌も、そこから現在の文壇有名人の大部分が出て来ているというならば、その底には、それらの同人雑誌が当時にもっていた何かの前進性、敢て試みる文学上の何かの勇気があったわけであった。",
              "citation": {
                "source": "しかし昔にはかえらない",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一定の成功を示しているか、それともまだ緒についたばかりであるか、というちがいはあるにしろ、こんにち、人民生活の独立と自由と平和をねがって、文学もその心の叫びとし、行動と信じている人々の間で、同人雑誌は、少くとも在来の文壇とジャーナリズムの上に「老舗」たらんとする「文壇の登龍門」や「道場」ではない。",
              "citation": {
                "source": "しかし昔にはかえらない",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "科擧は支那人にとつての登龍門である。",
              "citation": {
                "source": "歴史上より觀たる南支那の開發",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "側から見て此頃が荷風君の經歴で暗黒時代でないかしらと思はるゝのは、當時の文士の登龍門である文藝倶樂部や新小説へ時々作品を發表して居るにかゝはらず、他の方向へ身を轉換しようとしたのである。",
              "citation": {
                "source": "永井荷風といふ男",
                "author": "生田葵山",
                "note": "青空文庫"
              }
            },
            {
              "text": "小杉さんは第四回の文展（明治四十三年、三十歳）へ「杣」を出品して三等賞となつてゐたが、ヘンな言葉ながらこれが登龍門の小杉さんとしての第一関となつたやうである。",
              "citation": {
                "source": "小杉放庵",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "「登龍門」はヘンな言葉ながら当時は文展も今日のやうなものでないから、字のまゝに登龍に値したらう。",
              "citation": {
                "source": "小杉放庵",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
