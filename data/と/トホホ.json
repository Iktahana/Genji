        "examples": {
          "standard": [
            {
              "text": "「せっかく買ったアイスを落としちゃった、トホホ…。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「財布を忘れてレジで立ち往生なんて、トホホな一日だよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「楽しみにしてた遠足が雨で中止だなんて、トホホすぎる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "トホホ」　と、才蔵は泣きだした。",
              "citation": {
