        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "胴が丸く嘴の長い瀬虫（トビゲラ）と称するグロの虫まで、佃煮になっているではないか。",
              "citation": {
                "source": "ザザ虫の佃煮",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハサミ虫のようなトビゲラは、背中の二節目ぐらいをちょんがけにする。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "武蔵嵐山から小川町の間で競技会があったときに、あのへんでは川虫がとれないと思って前の日に多摩川でトビゲラをとって持って行き、一等賞をもらったことがある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "釣り場でとる餌は、イタドリの虫、棚グモ、イナゴ、赤トンボ、川虫のチョロ、トビゲラ、白の蛾、青葉かげろう……。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "トビゲラの巣虫のほうは、河原を見て歩くと、石にクモの巣が張ってあるような石があるから、そういう石を起こすとわけなくとれる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
