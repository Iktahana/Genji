          "literary": [
            {
              "text": "アプトン・シンクレアの「ジャングル」「ボストン」、エルンスト・トルラーの戯曲、リベディンスキーの「一週間」、ロープシンの作品など。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルラーなどがあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナチスから追われて国外に亡命したトーマス・マンの全家族、フォイヒトワンガー、ルドリヒ・レーン、エルンスト・トルラーなどは、それぞれ国外で反ファシズムと世界文化擁護のための活動をしていた。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第十一巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は「わが貧弱なペンクラブ」がトルラーのために起ったことを誇っているのである。",
              "citation": {
                "source": "ペンクラブのパリ大会",
                "author": "――議題の抜粋についての感想――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
