        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もう一人の客はトルドリューボフといって、あまりぱっとしない先生だった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よかろう、一人あたま七ルーブリ当たりとすれば」とトルドリューボフはいい出した。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃ礼儀上、受けるには受けるだろうが、その代わり、シャンパン半ダースくらいは提供するだろうよ」「ふむ、われわれ四人きりで、どうして半ダースなんか」ただ半ダースということばかり気にしながら、トルドリューボフが注意した。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つまり、むかし折合いが悪かったからこそ、いま仲間入りがしたいというのかもしれないじゃないか」「ふむ、きみの心持ちなんか……そんな高遠な感情なんか、だれにわかるものかね」トルドリューボフはにたりと笑った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もうこれくらいでよかろう」と、トルドリューボフは立ちあがりながらいった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルドリューボフは見向きもしないで、申しわけのように顎をしゃくった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの鈍感なトルドリューボフが、さぞ泰然自若とした鈍い軽蔑の目でわたしを眺めることだろう。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とトルドリューボフはたずねた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トルドリューボフはシーモノフのほうへ振りむいた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくに通知するのを怠ったんじゃないか、それは……それは……それは……もう馬鹿げてる」「馬鹿げているだけじゃなくて、まだほかに何かあるよ」無邪気にわたしの肩を持ちながら、トルドリューボフはこうつぶやいた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの左手にはトルドリューボフ、右手にはシーモノフ、ズヴェルコフはむかいに坐った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "フェルフィーチキンは彼とならんで、トルドリューボフの隣りに陣取った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルドリューボフは食事の手を止めて、さももの珍しげにわたしをじろじろ見廻し始めた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくにいわせれば、それはむしろ貧弱なくらいだ」とトルドリューボフは本気でいった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは、愛すべき親友の行を送るために、隔てのない会合を開いたのに、きみはぐずぐず文句ばかりいって」トルドリューボフはわたし一人だけのほうへ向き直って、ぞんざいな調子でこういった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きみはもう今から酔っぱらっているんだね」トルドリューボフは、馬鹿にしたようにわたしのほうを尻目にかけながら、やっとのことでいやいやわたしの存在を認めることにした。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルドリューボフは盃を挙げた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」我慢の緒を切らしたトルドリューボフが、もの凄い剣幕でわたしのほうへ振り向きながら、こうどなりつけた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくはまず自分のほうからテーブル・スピーチをやって……それから後で乾盃するつもりだよ、トルドリューボフ君」「なんていやな野郎だ！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」テーブルを拳固で撲りつけながら、トルドリューボフは唸るようにいった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トルドリューボフは噛んで吐きだすようにいった。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とトルドリューボフが応じた。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とトルドリューボフは力み返った。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルドリューボフは何やら馬鹿げた歌をうたいだした。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのトルドリューボフなんか、特別ひどく撲ることだろうな。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
