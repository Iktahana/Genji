        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "初めてノートルダームに行った日はここから乗合馬車に乗ってまずバスチールの辻まで行きました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "市庁の前で馬車を降りてノートルダームまで渦巻の風の中を泳いで行きました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「年ふるみ像のみ前にひれふしノートルダームのみ名によりて祈りまつる、わが神のみ母よ……」というような文句であります。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人通りはなくて朝霧にぬれたベンチが横たわり、遠くにノートルダームの双生塔がぼんやり見える。",
              "citation": {
                "source": "音楽的映画としての「ラヴ・ミ・トゥナイト」",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "1000 人　○病院の若い助手は医者でないのは、ビールジャ・トルダー〔職業紹介所〕でする、ベズラボートヌイ〔失業者〕と同じ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の P.M に　四月十五日からビールジャ・トルダーでセゾンニク〔季節労働者〕の登録をあつかうことが出て居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "室は二つに分かたれている、私の仲間にはシーを携えた身軽な連中で、所謂一等室の真ン中には、ノートルダームの塔の上から盗んで来た様な独逸人がたった一人、船をわがもの顔にそっくりかえっている。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノートルダームは下りてしまった、ウェッギスから霧の湖を、たえず木魂を左り側の崖から聞きながら、私達はヴィツナウ Vitznau に着いた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅館御料理カフェー・ノートルダーム。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「村長さんはなんと言いましたえ」「会わなかったよ」「どうして会わなかったのさ」「うん、おれはノートルダームで友だちに会った。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
