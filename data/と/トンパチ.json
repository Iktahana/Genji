        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして夜はトンパチといふ酒をのむ。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンパチは当八の意で、一升の酒がコップ八杯の割で、コップ一杯が一合以上並々とあるといふ意味だといふ。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日トンパチ屋で会ふと向うから話しかけて文学の話を始めたから、バカヤロー、私は怒鳴つて帰つてきた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町では酒屋が居酒屋で、コップ酒を飲ませ、之れを『トンパチ』とよぶのである。",
              "citation": {
                "source": "居酒屋の聖人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンパチ屋の常連は、近所の百姓と工場の労務者達であつたが、百姓の酔態といふものは僕の想像を絶してゐた。",
              "citation": {
                "source": "居酒屋の聖人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、この二人が、揃つてトンパチ屋の常連なのである。",
              "citation": {
                "source": "居酒屋の聖人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方になると、もつくり起きて、トンパチ屋へ行く。",
              "citation": {
                "source": "居酒屋の聖人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は酔つ払つて良く気焔をあげる男だけれども、多分、僕の一生のうちに、取手のトンパチ屋で飲んだ時期が最もおとなしい時期となるに相違ない。",
              "citation": {
                "source": "居酒屋の聖人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "茨城県の利根川べり、取手界隈ではこの居酒屋のコップ酒を「トンパチ」という。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンパチは「当八」の意だと土地の連中は云っている。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の飲み助どもは「トンパチやんべい」　といって居酒屋へ集ってくる。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを「トンパチ」と言い、「当八」の意だそうである。",
              "citation": {
                "source": "日本文化私観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の百姓達は「トンパチやんべいか」と言う。",
              "citation": {
                "source": "日本文化私観",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
