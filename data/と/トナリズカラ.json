          "literary": [
            {
              "text": "一騒ぎ鎮まりましてから、門口では隣ずから、内では部屋々々の御見舞。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣ずからの寒暄の挨拶が喰付きで、親々が心安く成るにつれ娘同志も親しくなり、毎日のように訪つ訪れつした。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            }
