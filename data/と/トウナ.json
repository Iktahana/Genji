[
  {
    "uuid": "c675e10c-5ff9-56d2-8fcf-eb1d5c4c050f",
    "entry": "唐菜",
    "reading": {
      "primary": "とうな",
      "alternatives": [
        "トウナ"
      ],
      "is_heteronym": false
    },
    "grammar": {
