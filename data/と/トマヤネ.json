          "literary": [
            {
              "text": "小船の苫屋根は竹で編んだ円頂で黒くすすけている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、※な女の顔がもう苫屋根の下にくっきりと見えた。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "絹糸のような雨が絶えず苫屋根の外にあった。",
              "citation": {
                "source": "蛇性の婬",
                "author": "雷峯怪蹟",
                "note": "青空文庫"
              }
            },
            {
              "text": "泊っている荷舟の苫屋根が往来よりも高く持上って、物を煮る青い煙が風のない空中へと真直に立昇っている。",
              "citation": {
                "source": "深川の唄",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "備えつけの二艘の艀舟は苫屋根の両がわに縛りつけられたままになっている。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "遠島船",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
