        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「しばらく不在にするので、郵便局で留め置きの手続きをしてきた」と隣人が言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "私書箱がいっぱいだったので、超過分の郵便物は留め置き扱いにされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "留め置き期間が過ぎた荷物は、差出人に返送されてしまうので注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
