        "examples": {
          "standard": [
            {
              "text": "年寄りっ子として育った彼は、親の経験を財産として持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その年寄りっ子は、同年代の子どもたちより成熟している傾向がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "年寄りっ子の親は、人生経験が豊富なことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
