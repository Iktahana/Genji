[
  {
    "uuid": "e03b1cd8-437f-544b-b47b-5b69bfc6e4ef",
    "entry": "取次ぎ",
    "reading": {
      "primary": "とりつぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
