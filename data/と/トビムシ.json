        "examples": {
          "standard": [
            {
              "text": "観葉植物の植木鉢に水をやっていると、土の表面で小さな跳び虫が跳ねているのに気づいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "跳び虫は土壌の中の有機物を分解して栄養に変えてくれる、実はガーデニングの味方だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "湿度の高い地下室に大量発生した跳び虫を駆除するために、除湿機をフル稼働させて対策する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "せめて蝶飛虫にでもなれば、ひら／＼と空に舞ひのぼつて、あの山の頂へ、俤びとをつきとめに行かうもの――。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめて蝶飛虫にでもなれば、ひらひらと空に舞いのぼって、あの山の頂へ、俤びとをつきとめに行こうもの――。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "跳虫の小さな雲のような楽しい群れは、行く人の足の上に騒々しく飛び続ける。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜跳虫のように飛び跳ねている。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
