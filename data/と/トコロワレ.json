    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そしてこの感情によって裏づけられている社会行動は至る処吾々の眼に余っている。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "主として対ソヴィエト・対アメリカの外交政策が問題になったらしく、新聞には色々と書いてあるが、結局の処吾々に判る処は、何か無理に抽象的な報道だけだから、今の六十五字の方が却って五相会議の発表された限りの真髄に当るわけである。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕事師倶楽部の為す処吾人未之を審にせず若し徒に名を国粋にかり実は手拭をくばって花会を催すの類に過ぎざらんか吾人は文身の兄貴も亦当世の才子隅には置けぬと感心せんのみ。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "道徳風俗習慣を比較しても我國民の最も重んずる處は彼之を重んぜず、彼重んずる處吾却て之を輕んずると云ふ事がある、それが知らず識らずの間に彼等の感情を害し又彼より輕蔑せらるゝ事となります。",
              "citation": {
                "source": "支那研究に就て",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
