        "examples": {
          "standard": [
            {
              "text": "彼は祖父が特別攻撃で命を落としたことを知り、戦争の悲惨さを改めて胸に刻んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "資料館には特別攻撃に出撃した若者たちが家族に宛てた手紙が展示されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歴史家は特別攻撃が戦局に与えた軍事的影響を冷静に分析した論文を発表した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "父の松本庄八は、太平洋戦争末期、予科練を経て特別攻撃隊に編成されていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "特別攻撃隊の卵にでもなっていたであろう。",
              "citation": {
                "source": "わが童心",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、ときにはその繊弱な、か細い緊張した歌声に合わせて、「神風特別攻撃隊」や「学徒出陣の歌」や「丘の夕月」を、われ知らず小さく口ずさんだりするのだった。",
              "citation": {
                "source": "軍国歌謡集",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
