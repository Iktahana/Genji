[
  {
    "uuid": "a1066824-aea4-594f-8068-47f68f1e3229",
    "entry": "得意げ",
    "reading": {
      "primary": "とくいげ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞",
