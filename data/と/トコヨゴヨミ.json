          "literary": [
            {
              "text": "トコヨゴヨミ――好い、好い、これが好いこれが好いと思って、嬉しそうに膳を叩いた。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田式トコヨゴヨミ――二、三度口でよんで見て、「矢張、式なんて言う字がない方が好い。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマダトコヨゴヨミ、それで好い、それで好い。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "刑事はヤマダトコヨゴヨミなどと読んでいた。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "暦だということだけはわかるが、トコヨゴヨミとは何ういう暦だか刑事はよくわからなかった。",
              "citation": {
                "source": "トコヨゴヨミ",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            }
          ]
        }
