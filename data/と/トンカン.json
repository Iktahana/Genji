        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それは鍛冶屋で、トンカン、トンカンと鉄砧を撃つ鏗い響が、地の底まで徹る様に、村の中程まで聞えた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは鍛冶屋で、トンカン、トンカンと鐵砧を撃つ鏗い響が、地の底まで徹る樣に、村の中程まで聞えた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の中でやたらにトンカントンカンと音がする筈ぢやが、その音の聞えて来る方角へは行かぬことぢや。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして屋敷でも建ててえ時には、そっくり此奴を参考にして、トンカントンカン建てるがいい。",
              "citation": {
                "source": "天主閣の音",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンカンと云う鉄の響が、近来警鐘の如く儂の耳に轟く。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（トンカン、トンカン、トンカンと次第に遠ざかり消える）鈴の音は続いて行く。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、そこが卜斎の細工小屋か、東のすみにぽッと明るい焔がみえて、トンカン、トンカン、槌と鉄敷のひびきがしている。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、その年も暮れて、待つに長い山上の春がやっと訪れ初めた翌年の三月初めの頃、智深はぽかんと麓の空を眺めやっていたが、そのうちにふと、トンカン、トンカン、鍛冶屋の鎚音が風にのって聞えてきた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
