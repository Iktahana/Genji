        "examples": {
          "standard": [
            {
              "text": "駐車場が空いているのに、わざわざ隣に停める人をトナラーという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "そのトナラーのおかげで、彼は車を傷つけられるのではないかと心配した。",
              "citation": {
