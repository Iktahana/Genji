[
  {
    "uuid": "a594d53a-9768-55b7-979b-619e233a6267",
    "entry": "賭する",
    "reading": {
      "primary": "とする",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-サ変-特殊",
