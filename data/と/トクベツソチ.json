        "examples": {
          "standard": [
            {
              "text": "災害地域に対して特別措置が取られることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "経済危機への特別措置として中小企業向けの融資制度が設けられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この問題には通常の対応では足りず特別措置が必要だと判断された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "巴里の再審裁判所は受理せず、ポアンカレ大統領に特別措置を請願したが、これもきかれなかった。",
              "citation": {
                "source": "青髯二百八十三人の妻",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つは、大企業のみ税金の特別措置をとっておる、措置法を改正して、大企業からもっとより多く税金をとるべきであると、私どもは主張するのであります。",
              "citation": {
                "source": "浅沼稲次郎の三つの代表的演説",
                "author": "浅沼稲次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
