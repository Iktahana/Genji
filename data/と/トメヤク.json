          "standard": [],
          "literary": [
            {
              "text": "それから市会議長の辞職、マアマアの止め役に到るまで、扨たくんだり、こしらえたりと申し上げねばならぬ。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大辻が酔っ払ってゝ例の通り自分を売りたがる嫌な演説、僕も一席やり、樋口がイキリ立ち、谷幹が荒れ、多和と林寛の喧嘩から柳が出たり、けどその間僕が専ら止め役、なだめ役だったのはよかった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "箭四郎の方が、年上であるけれど、介がいつも止め役だった。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
