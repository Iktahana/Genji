  {
    "uuid": "f5d2eb26-a70d-5b29-9def-1334d60997a7",
    "entry": "点る",
    "reading": {
      "primary": "ともる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "南ならば南、西北なら西北といつでも風向に応じて盤の豆ランプが点るのである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば人形が電灯を持って立っているのならば灯が点ると同時に電灯を高く振りあげる。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のテーブルの上の電気スタンドの場合にしますと、もしスタンドに、停電かなんかで、因の電気が来ていなければ、私がいくら骨折って縁にスイッチを捻りましても灯が点るという結果が出て来ません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず、会心の男が出来て、これはと思うその胸へ、グザと刃を描いて刺す時、膚を当てると、鮮紅の露を絞って、生血の雫が滴点ると言います。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋はまた石もて造り、大理石の白き血潮は、ぎやまんの壺に盛られて夜となれば火｜点るといふ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はやも見よ、暮れはてし吊橋のすそ、瓦斯点る……いぎたなき馬の吐息や、騒ぎやみし曲馬師の楽屋なる幕の青みをほのかにも掲げつつ、水の面見る女の瞳。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十一年八月　　蜜の室薄暮の潤みにごれる室の内、甘くも腐る百合の蜜、はた、靄ぼかし色赤きいんくの罎のかたちしてひそかに点る豆らんぷ息づみ曇る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "からら、からら、ら、ら、ら……烏いまはたはたと遠く飛び去り、窓にただ色あかき燈火点る。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯点る、さあれなほ梢はにほひ、全くいま暮れはてし下枝のゆらぎ……四十一年八月　　雨の日ぐらしち、ち、ち、ち、と、もののせはしく刻む音……河岸のそば、黴の香のしめりも暗し、かくてあな暮れてもゆくか、駅逓の局の長壁灰色に、暗きうれひに、おとつひも、昨日も、今日も。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今宵またかなたに点る紅の円き燈。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが脳のなかにか、室のうつつにか、火点るごときそのけはひ、遊戯夜に入る。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "沖の鰤船にも灯が点る。",
              "citation": {
                "source": "蜜柑山散策",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に豊かな灯が宗近家の座敷に点る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分心を蒲鉾形に点る火屋のなかは、壺に充る油を、物言わず吸い上げて、穏かな※の舌が、暮れたばかりの春を、動かず守る。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "第六章　数日前より鰐淵が家は燈点る頃を期して、何処より来るとも知らぬ一人の老女に訪るるが例となりぬ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "燈の点るには未だ間ありと見るなるべし。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "前の燈籠は馬首、後のは馬尾を添えたから、あたかも火の点る馬に乗った体だったとあるより見れば、この類の考案は欧州特有のものでなかったろう。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、万の窓々に一時に灯りが点るキネオラマといふ見世物を例に思ひ出して、祖母の提言を無稽に嗤つた。",
              "citation": {
                "source": "蔭ひなた",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "騎士はそのうちの一つの窓に、間もなく点るであらうランプの光りを待たなければならなかつた。",
              "citation": {
                "source": "鸚鵡のゐる部屋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ランプが点る部屋に恋人が閉されてゐる筈であつた。",
              "citation": {
                "source": "鸚鵡のゐる部屋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "病室の妻や、病院の姿が、真暗な雨のなかに点る懐しい小さな灯のようにおもえた。",
              "citation": {
                "source": "秋日記",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "日は短し、暗さは暗し、いつ暮れるともなく燈火を点るようになりましたのです。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蝋燭の日中に並び点る火影には、黒い着物のまま石段の上にひざまずいて、戦地にある人のために無事を祈ろうとするような年若な女も居た。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍人たちは、赤色灯点る局舎のあちらこちらに、射斃され、非戦闘員である機械係りや、アナウンサーは、不抵抗を表明した。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の駅駅に点る黄な灯の色をしたトツパアスもあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜はその片側に灯が一つ点る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にもう少し暗くなると、狭い温泉町の入口に高く一つ電燈が点る。",
              "citation": {
                "source": "夏遠き山",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今夜ローソクが点る樅の木を買って君達のホテルへ行くから、お茶でものませて、ということになった。",
              "citation": {
                "source": "モスクワの姿",
                "author": "――あちらのクリスマス――",
                "note": "青空文庫"
              }
            }
          ]
        }
