          "literary": [
            {
              "text": "○日露戦争この方十年来｜到処予の目につくは軍人ともつかず学生ともつかぬ一種の制服姿なり。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼君手を拍ちて、「可し、汝が觀る處予が心に合へり、予も豫て杢をこそと思ひけれ、今汝が説く所によりて、愈々渠が人材を確めたり、用ゐて國の柱とせむか、時機未だ到らず、人には祕せよ」とぞのたまひける。",
              "citation": {
                "source": "十萬石",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
