        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノ全然正反對ナル發達ハ社會生活ノ凡テニ於ケル分科的發達トナリテ近代史ニ連ナリ、彼ニ於テ婦人參政運動トナレル者我ニ於テ良妻賢母主義トナレリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義ノ原理ガ實行時代ニ入レル今日トナリテハ其レニ附帶セル空想的糟粕ハ一切棄却スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ母又ハ女子ニ負荷セシメザル所以ハ、愛情アリト雖モ扶養能力ナキガ故ニ、結局其ノ兄弟又ハ娘ノ夫ノ負擔トナリテ立法ノ精神ヲ殺ス者トナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人格權ノ歴史的覺醒タル民主々義ガ哲學的根據ヲ缺如シタル民本主義トナリテ輸入サレツツアル「デモクラシー」。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ノ亡國的腐敗ハ悉ク事大的國是トナリテ現ハレ、日清戰爭ニ於テハ清國ニ從ヒ、日露戰爭ニ於テハ露西亞ヲ迎ヘ、聊カモ英國ト自耳義ノ結托ニ似タル者ナカリシハ開戰原因ヲ顧レバ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ノ世界的天職ハ當然ニ實力援助トナリテ現ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ハ英獨協商ノ相手方ヲ日本ニ代ヘタルガ故ニ、今ヤ該協商ノ目的タリシ中部支那以南ノ領有ヲ現實ナラシメントシテ茲ニ青海四川甘肅ヲ包有セル西藏濁立ノ要求トナリテ現レタルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "已ニシテ千六百二十年七月、ぶるうすたあ、ぶらうどふおーど、及ビまいるす・すたんでつしゆノ三名ハ先発隊トナリテ和蘭ヲ去リ、英国さうざんぷとん港ニ到リ、倫敦ヨリ来レル一味ノ人ヲ併セテ、八月五日『五月花』号ニ搭ジテあめりかヘト出帆シタリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カノ天文家トナリテ霧點ヲ究メ、本草家ニテ紅雪ヤ酵草ヲ極メ、蟲學ニテ水蟲ヲ極メ、古體學ニテ古世界ノ禽獸、蟲魚ヲ究ムルガ如キ、物理上ノ諸學術ニテ其精微ヲ悉クスノミナラズ、又心理上ノ學術ニテモ、道徳ヲ説キ、法律ヲ論ズルモ其源ハ人性マデ溯リテ、其淵源ヲ究メタキ者ナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド大車ニ用ヒ、敵備ヘ十段十一段トナリテハ利アラズ。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
