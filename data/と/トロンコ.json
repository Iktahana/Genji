        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "とトロンコの据眼で、提灯を下目に睨む、とぐたりとなった、並木の下。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　　　　＊　　　　＊「おたけさんのクレオパトラの眼がトロンコになったよ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "などと云っている俺の方が仁にあうと云うのだろう」「そうよ」とお蔦はトロンコの眼をした。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おおそれではご承知か」　声をはずませトロンコの眼をし、膝を進めて梶子は云った。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎、途中で眠くなって、トロンコになって、形勢危しと見たおふくろさんは、一生懸命、電車の窓から、「アラ、トラックよ、何のせてるんでしょう」などとやって、やっと歩かせて辿りつきました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "健坊がおきたら参りましょう、今二時、昼ねよ、健坊はね、さっきわたしに抱かれて体をじかに撫でられているうちにトロンコになって眠ってしまったのよ、笑い乍ら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
