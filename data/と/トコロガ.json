[
  {
    "uuid": "42fe3d91-2ae4-5b03-9b3d-369568401940",
    "entry": "所が",
    "reading": {
      "primary": "ところが",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "接続詞"
      ],
