      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "even so",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は毎日猛練習に励んでいた。所が、大会直前に怪我をして欠場することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "簡単に直ると思っていた。所が、中を開けてみると想像以上に深刻な故障だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "予報では晴れのはずだった。所が、朝からどんよりとした雲が広がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "所が今年になつて「新生」を受取るやうになつてから、漸く出たなとおもつた。",
              "citation": {
                "source": "感想",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてニツコリするのだが、ニガムシつぶした所が芸術で、ニツコリする所は既に生活であるといふやうなことが云へる。",
              "citation": {
                "source": "宮沢賢治の世界",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が芥川君の周圍に集る人々は、たいていその同型な人物ばかりであつたので、交際の廣いわりに、心境が孤獨で寂しかつたのだらう。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後年に於ける室生君の教養と趣味生活とは、芥川君との交際によつて學ぶ所が確かにあつた。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その點で僕の思想は、芥川君に共鳴する所が多くあつた。",
              "citation": {
                "source": "芥川君との交際について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近尾崎君は、私を通じて芥川君の人格につき知る所が多かつたのである。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "所がこれがまた私にとつて不滿であつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の遺書に於てすらも、尚且つ藝術家の態度を持し、どこにも取り亂した所がなく、安靜なる魂の平和（精神の美學的均齊）を失つてゐない。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮りにその要求の満足される場所が生活の方に転移するとしても、転移したら転移したとしての詩心の表現物、即ち詩は要求されるのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所が火事であるための驚きと、心の感動と、言換れば偶然と必然とを、混同しない程度に比例して芸術非芸術があるとはシモンズの謂ふ所だ。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所がもう一匹の奴がゐることを知つた時一寸、大変な災難が来たやうな気持になつた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてにつこりするのだが、ニガムシつぶしてゐる所が芸術世界で、笑ふ所はもう生活世界だと云へる。",
              "citation": {
                "source": "芸術論覚え書",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が一日、予告もなく府庁の学務課から参観に来て、校長には二言三言だけ普通の話をして立去つた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "所がヴァニティの方が魂のことの方より少しゝか先に進まなかつたので、そして両方大きかつたので、或時期に至つて魂のことの方が先になつたのです、晩熟しました。",
              "citation": {
                "source": "小林秀雄小論",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "石でも当つて、まああれなんかは当り所が好かつたけれど。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶の舌ゼンマイに似る暑さかな暖かや蕊に臘ぬる造り花臘梅や雪うち透かす枝のたけ「蝶の舌」の句は、ゼンマイに似ているといふ目付け所が山であり、比喩の奇警にして観察の細かいところに作者の味噌があるのだらうが、結果はそれだけの機智であつて、本質的に何の俳味も詩情もない、単なる才気だけの作品である。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "所が不思議なことには、今の日本の子供たちは、さういふ妙な似而非童話を、却つて悦んで聽くといふ人があるのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間でも建築でも、田舎風の煤ぼけた者ががやがや混み合つて居るのでなくして、都会風の明るい感じの者で、小ぢんまりとして居る所が好い。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の家の中庭を突つきつて街路へ出たり、狭い石垣の下を通つて横丁へ出たり、勝手口のやうな裏道を迂廻したり、小さな坂を登つたり降りたりする所が多い。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の伊香保は、何となく感じが黒ずんで陽快な所がない。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本郷区役所がコンクリートの豆腐に変った。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "三番と掛札した踏切を越えると桜木町で辻に交番所がある。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "松魚の刺身のつまに生のにんにくをかりかり齧じっているのを見て驚歎した自分は、自宅や親類の人達がどうしてにんにくを喰わないかと思って母に聞いたら、あれを食うと便所が臭くなるからいけないと云うことであった。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "盆踊りのまだ行なわれている所があればそこにはどこかに奈良朝以前の民族の血が若い人たちのからだに流れているような気がしてしかたがない。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この青い所は海で……このとび色をして居る所が山で御座います。",
              "citation": {
                "source": "地図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれだけの煙だと、さうさね、日本の國を二十ほど寄せ集めたくらゐの廣大な場所が燃えてゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここが龍宮なんです、この場所が。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてその学校が何処にあるやら、そのお役所が何処にあるやら、それは雲の中のことで分りません。",
              "citation": {
                "source": "家族",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "山腹に眼をうつすと、あの雪の中で藍になって雪が消えたように見える所がある。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは、お互に、励まし合ひ、研究し合つたが、私にも、Ｎにも、カン所がつかめなかつた。",
              "citation": {
                "source": "遺言文学",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
