        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして食後に木で鳥笛を拵らへて、それを自分で吹き鳴らしなどした。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくの間は森の中、鳥笛の音で充たされた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洞門の出口にわれを待つ友がたそがれに吹く青き鳥笛　是れは同じ時に塔の沢から湯本の玉簾の滝を見に出かけた途中で、洞門の出口に友人の西村伊作氏が背を寄せて、土産物店で買つて来た笛を吹いて居たのであつた。",
              "citation": {
                "source": "註釈與謝野寛全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手に手に吹矢の筒、弾弓、鳥笛などをもてあそび、べつの一組は、階の口を立ちふさいで、通せンぼをしているとしか思われない群れである。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕獲のためには、あんたはトリック、鳥笛、おとりを使うんだ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
