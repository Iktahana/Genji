[
  {
    "uuid": "984a9074-0db0-5b40-b375-37a214c02773",
    "entry": "取り潰す",
    "reading": {
      "primary": "とりつぶす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to dissolve (an organization, company, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "不祥事が発覚したその財団法人は、主務官庁によって強制的に取り潰された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長年親しまれてきた地元の商店街も、再開発によって多くの店が取り潰されてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "かつての名門チームだったが、経営難から運営会社が解散し、チーム自体も取り潰された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "国威が落ちる、取り潰すがよい！",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西園寺家をはじめ、持明院統をとりつぶすには、絶好な機会と、考えられたからだった。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "取潰すとあれば親類縁者が一騒動起すであろう」「イヤ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "名君、勇君とあれば、御連枝でも構わず取潰すが、三代以後の大公儀の目安（方針）らしい。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あまりのことに手嚴しく申しますと、父上の手文庫から中條流の傳授書を持出し、この道場を取潰すと申します」「フーム」「それはあの晩のことで御座いました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "懷ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "下總の領地の百姓一｜揆はこのまゝぢや濟むまいから、それよりその有難いお墨附を種に、お孃さんを救ひ出してはどうだと、――これは俺が智慧をつけた」「へエ、親分も人が惡い」「三千五百石のガタピシした家を取潰すよりは、好きな同士を一緒にしてやる方が洒落てゐると思つたよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "若黨の戀",
                "note": "青空文庫"
              }
            },
            {
              "text": "大場の御家を取潰す迄もあるまい。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "名馬罪あり",
                "note": "青空文庫"
              }
            },
            {
              "text": "「では承わる」「――――」「貴殿、大義親を滅すという言葉を御存じか」「――――」「美濃国郡上、越前国大野、三万八千石の百姓何万人を、地獄の苦しみから救う為に、見事金森家を取潰す気になられぬか」「父上御一人は兎も角、金森の家中何百人を路頭に迷わせても？",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "大名の倅",
                "note": "青空文庫"
              }
            },
            {
              "text": "大場の御家を取潰すまでもあるまい。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "名馬罪あり",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あまりのことに手厳しく申しますと、父上の手文庫から中条流の伝授書を持出し、この道場を取潰すと申します」「フーム」「それはあの晩のことでございました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "懐ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば取潰すことが無理なら、分割して力を弱める策だけはとらなければならない。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "また御政治の方針からいっても、大藩の封地は、できる限り、削り取るか、取潰すか、せねばならぬ。",
              "citation": {
                "source": "柳生月影抄",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの父なぞは、いっそもう商売をやめてしまおうかなぞと言ったくらいでしたが、母や同商売の人にも意見されて、もう少し世の成行きを見ていようといううちに、京橋のまん中に遊廓なぞを置くのはよくないというので、新島原は間もなくお取潰しになりまして、妓楼はみんな吉原へ移されることになりました。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "主君の御癇癖も昂まるばっかり……取潰し結構。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなったら島津の取潰し役は差詰め肥後で、肥後の後詰は筑前じゃ。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "音に名高き初花楼も取潰しのほか候まじ」　と声をひそめて眼をしばたゝきぬ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その話によりますと昨日のこと、御城内で御家老様はじめお歴々がお寄合いになりまして、お目付の松倉様のお話をお聴取の上、大公儀からのお咎めのかからぬうちにと言うて至急に蔵元屋をお取潰しの御評議が決定りましたとの事で、最早どうにもならぬと言う良助さんのお話……」「ソレ見た事か。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに徳川幕府の初めには、諸侯の配置を整理して幕府の基礎を固くするがために、大名取潰しの政策を行い、末期養子の禁を厳にして、諸侯が嗣子無くして死んだときは、直ちにその封土を没収した。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "大名取潰しの結果は浪人の増加である。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "幕府がいったん取潰した家を再興した先例はいくらもある。",
              "citation": {
                "source": "四十八人目",
                "author": "森田草平",
                "note": "青空文庫"
              }
            },
            {
              "text": "政道に不平を抱いているかのように推測られ、幕府の諸侯｜取潰しの政策に口実を与えるような危険な状態になった。",
              "citation": {
                "source": "鈴木主水",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "町方の耳に入つては、もうどうにも仕樣が無いが、表沙汰になれば、お上の評判のよくない大野田家は、取潰しになるにきまつて居る、伜一つの命にも代へられないから、この一件は是非内證にしてくれといふのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "井戸端の逢引",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻斬が表沙汰になると、どんな家でも取潰しの上、本人は切腹だ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "辻斬綺談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「去年お取潰しになつた、讃州丸龜の山崎｜志摩守樣の御下屋敷跡ですよ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "土藏の中にあつたのは、昨年三月、八歳の當主虎之助｜治頼が死んで、公儀から御取潰しになつた、丸龜四萬五千石の城主、山崎家の財寶ばかり。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "側用人丹下村右衞門は先代｜志摩守歿後ドサクサ紛れに三萬六千兩の黄金と、夥しい財寶骨董をこの土藏に取込み、山崎家取潰しの時これを目録から除外させて、ほとぼりのさめた後、持ち出すつもりで居たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "「主家の御取潰しに紛れて、大金と寶物を取込むとは太い奴ぢやありませんか」　八五郎が腹を立てるのも無理のないことです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "五つの命",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御法度の悪いことをしていたにしても、主人を訴人して菱屋を取潰した金蔵が、主人の娘のお茂さんと祝言するというのは見ちゃいられません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金蔵の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "大塚御薬園は、その後まもなく取潰しになり、天和元年護国寺建立の敷地として召上げられた事は人の知るところです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金色の処女",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実は全くその通りで、北条家は取潰し、萩野は間もなく岩井家に縁付いて、幸せに送りました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "辻斬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
