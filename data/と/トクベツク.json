          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "深圳は中国初の特別区として指定され、外資系企業が次々と工場を設立した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "経済学の授業で、中国の特別区が改革開放政策においてどのような役割を果たしたかを調べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "珠海は特別区に指定されてから、わずか数十年で人口が数倍に膨れ上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "special administrative region of China (e.g. Hong Kong)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
