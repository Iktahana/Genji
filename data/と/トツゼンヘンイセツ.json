        "examples": {
          "standard": [
            {
              "text": "メンデルの法則が再発見された後、ドゥ・ブリースは突然変異説を提唱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "進化生物学では、ダーウィンの自然選択説と突然変異説が重要な議論の対象となる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は、生物の多様性を説明する上で突然変異説がどれほど重要かを強調した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それのみかダーウィン＝スペンサー系の進化論の信奉者として、彼はおそらく突然変異説など念頭に思い浮べもしなかったろう。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
