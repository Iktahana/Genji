  {
    "uuid": "150f9596-7bac-52f3-94d6-e2b6e1977e87",
    "entry": "討平",
    "reading": {
      "primary": "とうへい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
