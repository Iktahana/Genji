        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今年は年回りが悪いから、新しい事業を始めるのは控えたほうがいい」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "九星気学によると、私の来年の年回りは最高だそうなので今から楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あちゃー、家族全員の年回りがバラバラで、方位除けに行くのも一苦労だよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "悪い年回りはむしろいつかは回って来るのが自然の鉄則であると覚悟を定めて、良い年回りの間に充分の用意をしておかなければならないということは、実に明白すぎるほど明白なことであるが、またこれほど万人がきれいに忘れがちなこともまれである。",
              "citation": {
                "source": "天災と国防",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ世の中に、運命が自分の誕生の日の十干十二支（年回り）や、九宮二十八宿（星回り）なんぞによって前定していると信じたり、又は自分の持つ骨格や血色なんぞに因って、前定しているものと信じて、そして自分が幸運でないことを嘆く者ほど、悲しむべき不幸な人はない。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうもことしは年回りがよくない。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「九太夫さん、どうもわたしは年回りがよくないと思う。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも年回りがよくないと見える。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "易のおもてで言いますると、この卦に当たった人は運勢いまだ開けずとあきらめて、年回りを畏れ、随分身をつつしみ、時節の到来を待てとありますな。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の多いとしまわりで弱ります。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九が年廻り悪いので、十八で結婚したのだ、が、その頃は十七位で結婚したのがいくらもある。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今年も来年も年廻りがわるいから、明後年にでもなったら、療治をしましょうよ。",
              "citation": {
                "source": "爛",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も異性間に不人望な主人をこの際ことさらに暴露する必要もないのだが、本人において存外な考え違をして、全く年廻りのせいで細君に好かれないのだなどと理窟をつけていると、迷の種であるから、自覚の一助にもなろうかと親切心からちょっと申し添えるまでである。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年はどういう不運な年廻りか、元旦※々皇帝の殺人事件が起り、その皇帝をあろう事か溜池署の巡査部長が繩を打って召捕ってしまう。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と易者はすぐに筮竹を把って口の中で何か呟きながらデスクの上に算木を並べ、「お年廻りは離中断の卦に当ります。",
              "citation": {
                "source": "つゆのあとさき",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙なことをいうようだが、おれの回想のなかで産声をあげた小さな魂は、幸か不幸か、そんな年廻りを身につけて生れて来たのだ。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こいつは干支や年廻りのせいでしょうか、親分」「お前は何のせいだと思う」「人間の仕業ですよ、親分」「何だと」　ガラッ八は大変なことを持って来たのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "火の呪い",
                "note": "青空文庫"
              }
            },
            {
              "text": "「干支や年廻りなら、酉とか申とか、たった一年で済むことじゃありませんか。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "火の呪い",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こいつは干支や年廻りのせゐでせうか、親分」「お前は何んのせゐだと思ふ」「人間の仕業ですよ、親分」「何んだと」　ガラツ八は大變なことを持つて來たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "火の呪ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「干支や年廻りなら、酉とか申とか、たつた一年で濟むことぢやありませんか。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "火の呪ひ",
                "note": "青空文庫"
              }
            },
            {
              "text": "卒業前に文官試験を取ったというんだから、余程の秀才らしい」「此方は成績じゃ今更｜敵わない」「成績よりも何よりも年廻りが問題になっている。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "余りお芽出度い年廻りでない。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "年廻りが年廻りでございますからね」　とお母さんは言葉を改めて悃願した。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "年廻りが悪くて、疫病神たちが往来する時は、いつもそうだった様に、今夜も特別眠れないのである。",
              "citation": {
                "source": "性に関するアイヌの習俗",
                "author": "知里真志保",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
