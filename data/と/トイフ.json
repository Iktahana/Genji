        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と幽かにお笑ひになつておつしやつて居られた事もございますし、また、政所、侍所ナドト等シク、都所トイフモノヲ設ケタラドウカ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そろそろ、トルストイ、ドストイフスキーが煮えて来た。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソハヒマビマニトリテ来シ、　　木ノ芽ノ数ヲトリカハシ、アルイハ百合ノ五｜塊ヲ、　　　　ナガ大母ニ持テトイフ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト俺ハ現在ノ父母ノ子デナイトイフ理論ガ成リ立ツ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ結果、俺ハ双生児ノ片割レデアルトイフコトガ判明シタ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "敬ニシテ礼ニ中ラザルヲ野トイヒ、勇ニシテ礼ニ中ラザルヲ逆トイフ　とか、信ヲ好ンデ学ヲ好マザレバソノ蔽ヤ賊、直ヲ好ンデ学ヲ好マザレバソノ蔽ヤ絞　などというのも、結局は、個人としての子路に対してよりも、いわば塾頭格としての子路に向っての叱言である場合が多かった。",
              "citation": {
                "source": "弟子",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "行クニノゾンデ、継イデ見ンコトヲ約シ、ソノ館舎ヲ詢ヘバ、豊陽館ナリトイフ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "遂ニ自ラ号シテ斗南狂夫トイフ。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそも衣装の歴史を繙けば――長い事だからこれはトイフェルスドレック君に譲って、繙くだけはやめてやるが、――人間は全く服装で持ってるのだ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それに彼奴、厭に偉がるのね、ドストイエフスキーが何う云つてゐるとか、ボ※リー夫人を読んだことがあるかとか、恰で此方を文学少女かなんぞのやうに考へてゐるのさ、あんなことを云ふ人に限つてドストイフスキーなんて解つてゐるもんか。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドストイフスキイなどの小説の持つてゐる同情などゝいふことも、矢張この対社会が多いと思ふ。",
              "citation": {
                "source": "社会劇と印象派",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドストイフスキイもある意味に於いて矢張その一人である。",
              "citation": {
                "source": "真剣の強味",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴンクウルの作品の中には、ドストイフスキイやトルストイのやつた箇の研究、又は性格の研究、又はもつと下つて要求に捉へられた博愛、艱難に捉へられた同情、さういふものはすべて入つてゐるのである。",
              "citation": {
                "source": "自からを信ぜよ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ゆえなら教育書の中にフロオベルの『センチメンタル・エヂュケイション』がまぐれて入っていたり、地理書の棚の中にドストイフスキーのサイベリアを舞台にした短編集がまじって入っていたりしたからであった。",
              "citation": {
                "source": "日本橋附近",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「心細イコトヲ云ハナイデ欲イヨ、だつでい――僕トイフ息子ノアルコトヲ忘レタンデスカ？",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今月ノ君ノ写真ハコノ前ノ君ニクラベルト見チガエルホド大キクナツタ、余モコノトホリ元気ダ、余ハ今年ノ夏ヲミシガントイフ湖ノソバデオクル。",
              "citation": {
                "source": "断唱",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "富岡も加野も文学好きで、富岡はトルストイファンであり、加野は漱石信者であり、武者小路の心酔者でもあつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "音ハ耳ヲ聾スルバカリノグオーツトイフ音デ、生來之ニ比較スベキ音ヲ聞イタコトガナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "又今戸八幡デ旋風ニ遭ヒ、身體ガ浮イタトイフ老婆ノ實驗談ヲ聞イタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生はなほこれらの史料を過信することを戒められ、兎モ角モ人間ノ眼デ見タ證據程當テニナラナイモノハナイトイフ、心理學上ノ事實ハ、吾々ノ忘レテナラナイ誡デアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々真夜中ニ私ノ体ヘ、『アグニ』トイフ印度ノ神ヲ乗リ移ラセマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱気ニ刺サレタ網膜ヲズリ墜チテ　何トイフ莫大ナ旅程デアラウカ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで無耶郷のトイフェルスドレック教授なる人物の書物が出て来て、衣服の考察が始まるという仕組みである。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーライル＝トイフェルスドレックは自分が或いはサンキュロットであるかも知れぬ、と弁疏している。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子十二歳ニ至レバ総テ剣法ヲ学ビ、夜間就眠スル時ノ外ハ剣ヲ脱スルトイフコトナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「仇英、字ハ実父、十洲ト号ス、太倉ノ人、呉郡ニ移リ住ム、呉派ノ第一流トイハレシ周東村ニ学ビ、人物鳥獣、山水楼観、旗輩車容ノ類、皆、秀雅鮮麗ト挙ゲラレ、世ニ趙伯駒ノ後身ナリト称セラル、特ニ流麗細巧ヲ極メシ歴史風俗画ニ於テハ艶逸比スベキモノナク、明代工筆ノ第一人者トイフベシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "交番ニユキマスト、カワイラシイ女ノ子ノオマワリサンガヰテ、帳面ヲシラベテクレマシタガ、サツパリ玉ネギサンノスンデヰル村トイフノガ分リマセンデシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア、アナタハ、何トイフ近眼デセウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "何トイフウレシイコトダラウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
