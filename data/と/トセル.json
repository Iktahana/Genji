          "literary": [
            {
              "text": "「註」ハ固ヨリ説明解釋ヲ目的トセルモ、語辭悉ク簡單明瞭、時ニハ只結論ノミヲ綴リシ者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "歐洲ノ中世史ニ於ケル騎士ガ婦人ヲ崇拜シ其眷顧ヲ全ウスルヲ士ノ禮トセルニ反シ、日本中世史ノ武士ハ婦人ノ人格ヲ彼ト同一程度ニ尊重シツツ婦人ノ側ヨリ男子ヲ崇拜シ男子ノ眷顧ヲ全ウスルヲ婦道トスル禮ニ發達シ來レリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由契約トセル所以ハ國民ノ自由ヲ凡テニ通セル原則トシテ國家ノ干渉ヲ背理ト認ムルニ依ル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "滿十六歳以下トセルハ下掲ノ國民教育期間ナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ兒童ノ權利トシテ兒童其者ヲ權利主體トセルハ、父母ノ如何ニ係ラズ、第二ノ國民タル點ニ於テ國民的人權ヲ有スルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ女學校特有ノ形式的課目女禮式茶湯生花ノ如キ又女子ノ專科トセル裁縫料理育兒等ノ特殊課目ハ全然廢止スベキモノトナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ眞個父兄的愛情ヲ以テ、斯ル短時日間ニ此ノ道義的使命ヲ果タシ、以テ異民族ヲ利得ノ目的トセル白人ノ所謂植民政策ナルモノニ鐵槌一下セザル可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "是レ徴兵制ヲ明確ニ永久ノ制度ナリトセル所以ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ガ早ク已ニ支那ヲ財政的准保護國トセルコトハ説明ノ要ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "周知ノ如ク英獨協商ハ香港ヲ根據トセル英國ト青島ヲ根據トセル獨逸トガ、支那分割ノ亞佛利加大陸ノ如ク實現スベキコトヲ確信シテ、北支那ヲ獨逸ニ中央支那以南ヲ英國ニ妥協シタル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "×領ハワイ島パール軍港ニ集リタル×ノ大西洋及ビ太平洋合同艦隊ハ、吾ガ帝国領土占領ノ目的ヲ以テ、今ヤ西太平洋ニ出航セントセルモ、ハワイ根拠地ノ防備ニ一大欠陥アルヲ発見セリ。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
