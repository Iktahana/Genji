        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノホカニモ水死人、サマザマノスガタデ考エテイルソウデス、白イ浴衣着タ叔父サンガ、フトコロニ石ヲ一杯イレテ、ヤハリ海ノ底、砂地ヘドッカトアグラカイテ威張ッテイタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤノ　アタマノ　トコロニ　大キナ　モノガ　アルデセウ？",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンデンムシハ　オトモダチノ　デンデンムシノ　トコロニ　ヤツテ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アノ　コヒツジハ　ウマサウダ」ト　イツテ、ヌスビトハ　ソノ　コヒツジヲ　コツソリ　ヌスンデ　フトコロニ　イレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアゲテ　ヰタ　イシコロヲ、ポーント　ムカウノ　キニ　ナゲツケテ、マタ　コヒツジヲ　フトコロニ　イレ、スイタ　オナカヲ　オサヘナガラ　一ツノ　ムラヘ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ　フトコロニ　コヒツジヲ　イレテ、「シカタガ　ナイカラ、コノ　コヒツジハ　オレガ　ソダテテ　ヤラウ」ト　ヒトリゴトヲ　イヒナガラ　ヤツテ　ユクウチ　トツプリ　ヒガ　クレマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ダンダン　センサウノ　アル　トコロニ　チカヅイテ　キタラシク、トキドキ　トホクノ　ハウカラ　カスカニ　タイハウノ　トドロキガ　キコエテ　キマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウダ、コノ　キノドクナ　ヒトビトヲ　タスケテ　ヤラネバ　ナラナイ」　ヲトコハ　アチラ　コチラノ　ムラニ　ノコツテ　ヰル　ヒトビトヲ　ヒトトコロニ　アツメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……曰く……　――余ノ調査研究セルトコロニ依レバ、既ニ往昔ヨリコノ種ノ犯罪ガ行ワレツツアリシ事実ヲ認ムルヲ得ベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカルトコロニ、イツマデモイルベカラズ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカルトコロニイルベカラズ云々というあの拙い文章の脅迫状ね。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハ夫ガ倒レルト悲鳴ヲアゲナガラ夫ノトコロニカケヨッテ介抱シヨウトシマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次に曰く、三、丈が二尺グライノ花瓶、口ニ拇指ヲ置キテ指ヲ中ニサシ入レテ花瓶ノ内側ヲサグリ、中指ガアタルトコロニ、小サク５０９８ト墨書シアリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "商標ノトコロニ星印アリ　□□4□と、第五段めの四桁数字が出てきた。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、本願ト同様ナル着想ハ、本願出願以前ニ、帝国領土内ニ於テ存在シ、且｜遍ク知ラレタルトコロニシテ、例エバ奈良唐招提寺金堂ニ保管セラレアル千手観音立像ハ、四十臂ヲ有ス。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "金椎ノ談ニヨレバ、救世主ハ大工ノ子ニシテ――耶蘇ノ教フルトコロニヨレバ、娼婦、税吏、異邦人、姦淫セル女等ガ却ツテ、驕慢ナル権者、偽者ナル智者、学者ヨリ光栄アル壇上ニ置カルルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザウサン　サルサン村山籌子　アルトコロニ　タイヘン　オギヤウギノヨイ　ザウサンガアリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "水ガ口ヨリ鼻腔ニ及ビ、完全ニ窒息スルトコロニテ止ム。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛ンダトコロニ邪魔ガ這入ッテ腰ヲ折ラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平衡感覚ヲツカサドル神経ハドコヲ通ッテイルノカ知レナイガ、イツモ後頭部ノトコロ、チョウド脊髄ノ真上ノトコロニ空洞ガ生ジタヨウナ感ジガシ、ソコヲ中心ニ体ガ一方ヘ傾クノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ地球トイウ惑星ノ日本トイウトコロニ生マレ、擬似体験げいむノぷろぐらまあトイウ職業ニ就ク。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "成敗利鈍ニイタリテハ、臣ガ明ノヨク及ブトコロニ非ザル也。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもきかねば追ッ払う」「でも、窮鳥フトコロニ入レバの古語すらあるではございませんか。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
