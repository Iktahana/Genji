          "literary": [
            {
              "text": "ミズグルマノ　マワツテ　ヰル　ソバデ　パンヲ　モツタ　ヒトリノ　ヒヤクシヨウニ　アツタノデ、「オイ　コヒツジト　パント　トリカヘツコ　シナイカイ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヌスビトハ　パント　コヒツジト　トリカヘツコ　シマシタガ、ヒヤクシヨウノ　テニ　ブラサゲラレタ　コヒツジガ　カワイソウニ　ナツタノデ、トリカヘツコヲ　ヤメテ　シマヒマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヒルサンハ大ヨロコビデ自分ノ洋服トトリカヘマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ大ヘンヨロコンデ、ボンコチヤンノリボンヲ前ヨリモモツトモツトキレイナノニトリカヘテ、キレイナ桃色ノ箱ニイレテ、空色ノリボンデソノ箱ヲシバリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "便通及繃帯トリカヘ。",
              "citation": {
                "source": "呉秀三先生",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
