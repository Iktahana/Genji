        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソシテ蚊帳ノ中ニ入リ熟睡シテ居ル道子ノ上ニ馬乗リトナッテ、両手デイキナリ咽喉ヲシメヨウトシタノデアリマス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカットナッテイキナリ拳固ヲ堅メテ頭ヲ突キマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ヤ彼女ハ卯木家ニ於テ確乎タル地歩ヲ占メルニ至リ、浄吉ニ取ッテモ、ソウ云ウ意味デ缺クベカラザル存在トナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンノ一分間グライデ、ソレカラアトハ朦朧トナッテシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――関門海峡ニハ、タクサンノ外国船ガ入ッテクルコトトナッテ、沖ノ仕事モ増スバカリトナッテ、組デハ、若クテヨイ働キ手ヲサガシテオル。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと続けて」「……同ニ長干ノ里ニ居リ両小｜嫌猜ナシ十四、君ノ婦トナッテ羞顔未ダ嘗テ開カズ頭ヲ低レテ暗壁ニ向イ千｜喚一トシテ廻ラズ十五、始メテ眉ヲ展ベ願ワクハ塵ト灰ヲ同ニセン常ニ存ス抱柱ノ信豈上ランヤ望夫台十六、君遠クヘ行ク……」　城太郎はふいに起って、じっと聞き入っていたお通を促した。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
