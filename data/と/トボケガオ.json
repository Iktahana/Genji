          "literary": [
            {
              "text": "丁度其中には、例の種牛も恍け顔に交つて居た。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度そこへ来て、座りもせず、御辞儀もせず、恍け顔に立つた小娘は、斯細君の二番目の児である。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は東京でごわす」　と恍け顔に言｜淀んで、見れば手に提げた菎蒻を庭の隅へ置きながら蹣跚と其処へ倒れそうになりました。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は東京でごわす」　と恍け顔に言淀んで、見れば手に提げた菎蒻を庭の隅へ置きながら蹣跚と其処へ倒れそうになりました。",
              "citation": {
                "source": "旧主人",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "腹蔵のない話が、こうして景気を付けてはいるものの、それはほんの酒の上、心の底は苦しいので、「先生、足の骨を折られて死んだものがごわしょうか」　と恍け顔に聞いて見る。",
              "citation": {
                "source": "藁草履",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
