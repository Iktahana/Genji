    "definitions": [
      {
        "index": 1,
        "gloss": "knife grinder (person)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "切れなくなったハサミを研ぎ屋に持っていこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔ながらの研ぎ屋が、今もこの商店街で営業している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "研ぎ屋の店先には、いつも研磨の音が響いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "みすぼらしい身なりの一団が、街角で煙草を吹かしながら笑っていたり、刃物研ぎ屋が路上研磨をしていたり、二人の近衛兵が子守の女性と歓談していたり、めかし込んだ青年が幾人か、口に葉巻をくわえてうろついていたりしていた。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "取っ組み合いの喧嘩が始まってしまい、二人の近衛兵が一方に加勢、刃物研ぎ屋がもう一方に加勢したので、騒ぎはあっという間に大きくなった。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまさんにハガキ弐枚、とぎやさんに四枚、やまいもほりさんに六枚書いてあげた、代筆をくれやうとした人もあるし、あまり礼もいはない人もある。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかけやさん、とぎやさんと遅くまで話す、無駄話は悪くない（いかけやさん、とぎやさんで飲まないものはない）。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか、とぎや専門という商売もあるのだから、いつも大工の鉋のようによく切れるようにしておかなければ、料理をしようとする時にまごつくのがオチだ。",
              "citation": {
                "source": "だしの取り方",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜熊本の町を散歩して旅館｜研屋支店の前を通ったとき、ふと玄関をのぞき込むと、帳場の前に国見山が立っていて何かしら番頭と話をしていた。",
              "citation": {
                "source": "相撲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤三郎はそのまま土手の方へ行こうとして、フト研屋の店を覗込んで、「よくお精が出るな。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おうおうと遠近に呼交す人声も早や聞えず、辻に彳んで半身に雪を被りながら、揺り落すごとに上衣のひだの黒く顕れた巡査の姿、研屋の店から八九間さきなる軒下に引込んで、三島神社の辺から大音寺前の通、田町にかけてただ一白。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でも広徳寺前｜辺に居る、名人の研屋が研ぎましたそうでございますからッてね、紫の袱紗包から、錦の袋に入った、八寸の鏡を出して、何と料理屋の玄関で渡すだろうじゃありませんか。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　というと研屋の五助、喚いて、むッくと弾ね起きる。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "同宿は女の油売、老いた研屋、共に熊本県人、そして宿は屋号が示すやうに熊本県人だ、お互に熊本の事を話し合つて興じた。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "此宿の主人は旧知だつた、彼は怜悧な世間師だつた、本職は研屋だけれど、何でもやれる男だ、江戸児だからアツサリしてゐる、おもしろいね。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の光のとどかない暗い隅で、研屋の男の廻り砥石と肉切庖丁との間から火花が散り、金ものの熱する匂いがした。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この村にシャレル爺さんという研屋を商売にして村中を廻って歩く爺さんがありますがね、この前の土曜日でした。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "研屋の店先とその親爺との描写はこの作者にして初めて為し得べき名文である。",
              "citation": {
                "source": "里の今昔",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "研屋は今でも折々天秤棒を肩にして、「鋏、庖丁、剃刀研ぎ」と呼わりながら門巷を過るが鋳掛屋の声はいつからとも知らず耳遠くなってしまった。",
              "citation": {
                "source": "巷の声",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "研屋の店先とその親爺との描写は此作者にして初めて為し得べき名文である。",
              "citation": {
                "source": "里の今昔",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴族も大道の研屋も、華族も平民も、殿上人も町人も、皆その魔女の臣下である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あツ、ついあの」若い處女らしく初めて眞つ赤になつた娘は、「あの、研屋五兵衞の娘糸と申します」――さう言つて縁側に手を突きました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　御徒士町の研屋五兵衞は、一｜介の町研屋から身を起して、後には武具刀劍萬端の拵へを扱かひ、七｜間間口二軒建の店を張つて、下町切つての良い顏になつて居りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "その研屋五兵衞が、昨夕酉刻半過ぎ入谷の寮で、直刄の短刀で左首筋を貫き、紅に染んで死んでゐたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝は檢死が濟んで、何も彼も父が惡いことになり、遺書は三輪の萬七親分から、町方御役人の御手に差上げることになり、葬ひの濟むのを待つて、改めて御沙汰がある相でございます」「――」　多分、研屋は缺所、家族は所拂ひにもなるでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "寮と言つても、研屋五兵衞が贅を盡した建築で、入口の右は居間と女中部屋とお勝手と風呂場、左はお糸の部屋で、その先二た間置いて、一番奧が五兵衞の殺された部屋になつて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その五郎助は昨夜｜酉刻から戌刻までの間何處に居たんだ」「本所の御屋敷から呼出されて、晝過から參り、戌刻過に漸く歸つて來ましたが」「あとは昨夜店をあけた者はあるまいな」「へエ――」「ところで、これはよく氣をつけて正直に返事をして貰ひ度いが、研屋の暮し向は近頃どんな具合になつてゐるんだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「幸ひ石川樣が融通して下すつて研屋の身上を建て直したやうなわけでございます」「どれほどの融通だ」「三千五百兩ほどでございます」「少し大きいな」　いかに公儀御用達でも、三千五百兩は大金です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも心易いと言ふだけの研屋に貸すのは、何か事情がありさうにも思へるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "番頭の言ふことが本當なら、僞の貞宗は研屋の手で作らせたが、盜まれたといふ刀の鍔や柄や鞘は五兵衞が何處からか持つて來たのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "研屋五兵衞の遺書が表沙汰になると、御腰物方が三人、腹切り道具になるが――」　笹野新三郎が暗い顏をするのも無理のないことでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「外でもございません――研屋五兵衞の遺書に伽羅の匂ひの浸み込んで居たことを御存じでせうか」「――」「最初は結構な煙草かと思ひました、――恥かし乍ら、伽羅や沈香といふものを、嗅いだことも無い私で、あれが伽羅と判るまでに、飛んだ苦勞をしましたよ」　平次は淋しく笑ひます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那、まだありますよ、――身上を潰してしまつた研屋五兵衞に、三千五百兩といふ大金を融通したのは、ありや、何の爲でした」「ぶ、無禮なことを言ふな、金の貸借は町人の常だ、――」　岡つ引の差圖は受けぬわい――と言ふ積りでせうが、さすがにそれは口の中で噛み潰しました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "買つた遺書",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
