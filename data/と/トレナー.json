        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「トレナーさん、いい劇団だといいのですが」　と令夫人。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台監督のバノン・トレナー氏がほほ笑んで、「おまかせください、チャレンジャー奥様。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台監督のトレナーがいいわけして、「一緒に来られませんでした。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "根っからの悪人じゃなく、出来心に負けた哀れな人達ですね」「ゆうべオールドチェスター刑務所で事故があったのじゃないですか」　とトレナー氏が訊いた。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええ、トレナーさん、とてもひどかったかもしれません。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "上演時間が近づくにつれ、舞台監督のトレナー氏が不安になり始めた。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレナー氏がじろじろ見て、口をあんぐり。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にお目にかかったことはありませんが」　とトレナー氏がほほ笑んだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日は食べてなくて、夜遅く食事しようと思っていたので、何も口にせず駆けつけなければなりませんでした」　トレナー氏は、ただただ望外の喜びだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレナー氏がメークを確認し、承認した。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレナー氏には半時間で出ると言ってください。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき、でっぷり肥った威厳のある老執事が、トレナー氏にあわてた様子で近づき、何事かささやいた。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "とても頑固なのでございます、はい」　トレナー氏が居間に急いだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒルハウスさん、どういうことですか」　とトレナー氏が息をのんだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルを鳴らし、執事に会い、ええ、このざまです」　トレナー氏が瞬時に考えをめぐらした。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレナー氏がおもむろに言った。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に、簡単ですよ」　やがてチャレンジャー卿が浮かぬ顔で書斎に戻ってきて、「トレナー氏が正しいよ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが遠くへは行かれまい」　トレナー氏が答えて、「いまごろ高跳びしていますよ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "一台の行方不明の車が一時間半後に戻り、話によればまさにトレナー氏が言った通り。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
