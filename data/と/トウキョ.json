[
  {
    "uuid": "60f63ea0-676f-5a06-9dc4-686485e6a6fd",
    "entry": "逃去",
    "reading": {
      "primary": "とうきょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
