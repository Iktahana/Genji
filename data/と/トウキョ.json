  {
    "uuid": "78246f61-8f5b-5240-bb72-196fb2d01c0a",
    "entry": "東去",
    "reading": {
      "primary": "とうきょ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
