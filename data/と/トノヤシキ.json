          "literary": [
            {
              "text": "いま一※ほどしたら屋敷をぬけ出して、少納言殿屋敷までそっと走ってくりゃれ」　千枝太郎は心得顔にうなずくと、泰親はさらに声を忍ばせて言った。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥平大膳殿屋敷の近くから、脇坂淡路守の土塀に沿うて、いつしか三人は芝口を源助町の本街道へ出ていた。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "梅雨に咲く花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「拙者、納谷殿屋敷へ参る者じゃ」「まア、坊ちゃんが。",
              "citation": {
                "source": "鸚鵡蔵代首伝説",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「服部兄妹を貴殿屋敷へ、誘き入れられたご好意については、九十郎お礼申す。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこの幾棟かの家屋のうちの、最大の、最良の、御殿屋敷風なのを選んで、戸を排してみると厳しく釘づけになっているが、それを合点の上で兵馬は、無理に押破って、御殿の中へ参入しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "加賀さまの赤門で名代の前田加賀守の御守殿屋敷。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "氷献上",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
