        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十、世ノ中ニハ、ソノ気ニナルノハワケハナイガ実行ガ面倒ダトイウ問題ト、実行ハ簡単ダガナカナカソノ気ニナレナイ問題トガアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ産ヲスルマデハ、イクラ物好キナ彼奴トテモ手ヲ出ス様ナコトガアルマイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、ヨシヲサンノオカアサンハ、ソノマヒゴヲドコカデ見タコトガアル子ダト思ヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十四年八月に、飛騨の高山の町で同町の二木長右衛門氏に聞いた話では、「馬糞ナドニ生エル馬糞菌ヲ喜ンデ食フコトガアル」とのことであった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンモ団十郎ノハ見タコトガアルカモ知レナイガ、記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若イ時ニタッタ一遍ダケ奇怪ナ経験ヲシタコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バレリーナニナロウト思ッテ、バーレッスンヲ一二年受ケタコトガアルノデ、チョットグライ立ツコトハ立テタンデスガ、サア今デモ立テルカ知ラ」ッテ、ソンナ話ヲシタコトガアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ風デ何楽シミニ生キテルノカト、人モ思ウダロウシ、自分デモ思ウコトガアルガ、幸イト云ッテイヽノカドウカ、不思議ナコトニ食慾ト睡眠ト便通トハ至ッテ満足ニ行ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ忰ノ湿ニシバ／＼オ伝ノ美シサニツイテ語ッタコトガアルソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ春久ガ夜間ハ忙シイケレドモ、晝間ハ自由ガ利クト語ッテイタコトガアルノヲ、聞キカジッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一ツ気ニナルコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレ老人ニハ知ラセテ置イタ方ガ都合ノイヽコトガアルノダカラ、ソレナラ少シデモ早ク知ラセテ因果ヲ含メテヤッタ方ガ功徳ニナルト、考エタカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新シ物好キノ颯子ハ去年台所ヘディスポーザーヲ取リ附ケタガ、彼女ニ依レバ「マダ食ベラレル筈」ノ薩摩薯ヲ放リ込ンダト云ッテ、オ節ガヒドク叱ラレテイルノヲ見タコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼底出血ノ恐レハナイカト、検査シテ貰ッタコトガアルガ、眼底ノ血壓ニモ格別ノコトハナク、予ノ年齢トシテハ相当デアルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老人ニハヨクアルコトデゴザイマス」「ジャ、君ハ前カラ知ッテタノカ」「ハア、近頃ハ毎朝伺ッテオリマシタ、ピイピイッテ、オ可愛ラシイオ声デ」「婆サンニモコノ声ヲ聞カシテヤロウ」「知ッテラッシャイマスヨ、ソンナコト」「颯子ガ聞イタラ笑ウダロウナ」「若奥様ダッテ御存知ナイコトガアルモンデスカ」五日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治ノ中期、二十七八年頃ノ或ル天気ノイヽ日ニ、母ガ我ガ家ノ門前ヲ歩イテ行キ、幼童ノ予ヲ往来デ見カケタコトガアルノカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガドウシタンダ」「アタシモ覚エテナインダケレド、鉾田トハ仕事ノ関係カラ近頃懇意ニオナリニナッテ、時々オ目ニカヽルコトガアルンデスッテ」「ダカラサ、ソレガドウシタト云ウノサ」「イヽエネ、ソノ油谷サンガ先週ノ日曜ニ御近所マデ参リマシタカラッテ、御夫婦デ鉾田ノトコロヘオ寄リニナッタンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨク考エルト、颯子ノ手前好キヲ装ッテイルニ過ギナイノダト云ウコトニ、自分デモ気ガ付クコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前ニモ度々コンナツメタサノ経験ヲシタコトガアルガ、ソシテ大体真冬ノ寒中ニソウナルコトガ多イノダガ、必ズシモ冬トハ限ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ今日ノヨウニ、九月中ニコンナコトガアルノモ珍シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸子ハ泣イテマシタガネ」「何ヲ泣クコトガアルンダ」「五子モ出テ来ルッテ云ッテマシタカラ固ク止メテアルンデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ二三回支那ヲ漫遊シタコトガアルガ、支那ノミナラズ、日本ノ何処カヲ旅シタ折ニモ、偶然人ガ野外ニ立ッテ拓本ヲ製作シテイルトコロヲ見タコトガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナシタイコトガアル、ヨンデクレ。",
              "citation": {
                "source": "海底の魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
