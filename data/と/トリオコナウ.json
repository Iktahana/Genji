[
  {
    "uuid": "45367f5a-5cc2-5e2f-b393-88520f499806",
    "entry": "執り行う",
    "reading": {
      "primary": "とりおこなう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
