      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "anyway",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "兎に角、今日中にこの報告書を仕上げなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「兎に角、まず落ち着いて話を聞いてくれ」と彼は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "兎に角やってみて、うまくいかなければそのときに考えよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "兎に角それらの作品の、その「流れ」、「持続」、「終始」といふやうなものを見たことはなく、而もたゞ読んだりしてゐるうちに、従来持つてゐたものさへも、失つたのである。",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして兎に角にも自己流の珍らしい建築を完成した。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども兎に角、教師達が彼に威勢の好い声を掛始めたといふことが彼を安心させた。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども兎に角私が毎日のやうにする天才気取りといふものに、何時しらず父も母も祖母も圧服された体になつてゐたからだ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「Ｍなんて、兎に角今の中学校なんかが猫のやうな善良さで押し通せる奴つたら、延膸が大脳の割合に発達してゐないで、大脳が一通り悪い意味のエゴイスチックな発達をした奴だ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、猫入らずまで混ぜてあったのだが、兎に角私は、滅茶苦茶に甘いものに飢えていた。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "本田富次郎の頭脳が、兎に角物を言う事の出来た間中は、彼は此地方切っての辣腕家であった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれは君にもお鉢が廻るんだろうが、兎に角警戒を要する。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ、兎に角火に当らないとやり切れないのであった。",
              "citation": {
                "source": "坑夫の子",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角この浚渫機械の小屋と土手は恐らくこの美しい上高地の絵の上にとまつた蠅か蜘蛛のやうな気のするものである。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一歩門を出さへすれば、つい其處の路地にでも川岸にでも電車停留場にでも、兎に角うちの庭とは比較にならない程いゝ題材が、勿體ないやうに無雜作に、顧みられずにころがつて居る、わざわざ旅費を出して幾日も汽車を乘り※す必要などはないやうに思はれる。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "此間Ｍ君と會つた時、いつか一緒に大宮へでも行つて見ようかといふ話をした事を思ひ出して、兎に角大宮迄行つて見る事にした。",
              "citation": {
                "source": "寫生紀行",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "無意味なことで彼等は暮らしていると思っていることの上に一種の愛感を持ってこれまで世話して来たムッシュウ・ドュフランは彼等の急にしょげた様子を見てこれが当り前だとも思い、それ見たことかとも思わぬでもなかったが、兎に角今は自分の世話子達である。",
              "citation": {
                "source": "巴里の唄うたい",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の中の一人で音楽好きの男の子があるのを幸いに、これを作曲家に仕立てて、優劣は別としても兎に角、自分の胸から出るものを思うまま表現できる人間を一人作り度いと骨折っているのである。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角真のフェミニストは質的のものだ。",
              "citation": {
                "source": "女性崇拝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角中流以下のレストラントには必ず何人かの常客がいて、毎日同じテーブルに同時間に同じ顔を見ることが出来る。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角現代では新しいという事が概念になり常識になったから少しも新しくはありません。",
              "citation": {
                "source": "新時代女性問答",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "與四｜郎が方に變る心なければ、一日も百｜年も同じ日を送れども其頃より美尾が樣子の兎に角に怪しく、ぼんやりと空を眺めて物の手につかぬ不審しさ。",
              "citation": {
                "source": "われから",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君も語れ予先ず語らんなど云える前言に対しても何分此の儘止められぬ、ままよ書過しは書過しとして兎に角今少し後を続けて見ようと決心した。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論其の当時にあっては予も総べての希望を諦め老親の膝下に稼穡を事とする外なしと思ったが、末子たる予は手許に居るというても、近くに分家でもすれば兎に角、さもなければ他家に養子にゆくのであるから、老親の希望を遺憾なく満足させるは、少しく覚束ない事情がある。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等の歌から受ける興味の程量は読者の嗜好に依て相違のあるべきは勿論であるが、兎に角生命の脈々たる歌であるのだ。",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は兎に角自分は時々は是非訪問することと極めたのである。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角僕は心おきない人と盃を交すのが好きだ。",
              "citation": {
                "source": "気まま者の日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角元気で頑張ってる。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "手紙を早く出せよ」　七五郎、傍から、　「石松、兎に角、草鞋をぬいで上れよ、俺ァ一ッ走り吉兵衛親分を呼んで来るから？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角姉さんとおっ母さんと僕と一しょに住って見るという事が、出来ない事もあるまいと思うのです。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "）兎に角生活していますよ。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角あなたは旧思想の方ではございませんのね。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、兎に角梯子段の下までは一しょに行きましょう。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角愉快らしい顔をしていらっしゃるわ。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
