[
  {
    "uuid": "c601b85b-5cc5-584b-9928-d47125a37bde",
    "entry": "兎に角",
    "reading": {
      "primary": "とにかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
