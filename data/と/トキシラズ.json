        "examples": {
          "standard": [
            {
              "text": "時鮭は、脂が乗っていて身が柔らかく、非常に美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "北海道の特産品である時鮭を味わうのが、夏の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この時期の時鮭は、特に新鮮で人気が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その時鮭の尻尾のところに屹度藁草履のかはりに銀貨や白銅のおひねりをつけたりもする。",
              "citation": {
                "source": "田舍の新春",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            }
          ]
