        "examples": {
          "standard": [
            {
              "text": "彼の部屋には、趣味で集めた模型が所狭いと棚に並べられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "小さな商店の店頭には、季節の野菜や果物が所狭いと積まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "壁一面に、世界各国で撮ってきた写真が所狭いと貼ってある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "赤坊の洟が出た時には、その所狭い胸に挟めてあつた紙を出して、てづから洟を拭つてやつた。",
              "citation": {
                "source": "三等車の中（スケッチ）",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁には争議のスローガンや、組合本部からの激励文、ファッショがかつた文字を書いた張紙などが、壁に所狭いまでに張られてあつた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "机や椅子や戸棚などが所狭いほど置かれているところを見ると、事務室であることに間違いがない。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "七八百万円にのぼる国防献金、街頭至る処に所狭いまでに氾濫している千人針婦人、これは生きた事実である。",
              "citation": {
                "source": "挙国一致体制と国民生活",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "と見おろす広場は、所狭いまでに大小の植木がなぎ倒され、それにまざって幾人とも数えきれぬ裸形の死人。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "所狭いまでに手文庫や櫃！",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車通りに面した事務所には、相変らず所狭いまでに各種の器具機械類が並べられて、三人ばかりの日本商人が注文欲しげな顔で売り込みに控えていた。",
              "citation": {
                "source": "ナリン殿下への回想",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、村役場員、駐在所員、区長、消防｜頭、青年会長、同幹事といったような、村でも八釜しい老若が一ダースばかり下座に頑張って、所狭しと並んだ田舎料理を盛んにパク付いては、氏神様から借りて来た五合、一升、一升五合入の三組の大盃を廻わしている。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その側には美しいギリシャの彫刻や、近代名家の彫刻が所狭しと置かれてあった。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "フロアにも人がどうにか歩けるほどの間隔だけを取って、本棚がいくつも所狭しと立っていた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのテーブルには古い手稿やベラム革のカバーのついた化石じみた古書が所狭しと散らばっていた。",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "火まつりが行われる扇山を頂点とした、三角形のなだらかな丘に家や建物が所狭しと建ちならんでいる。",
              "citation": {
                "source": "湯けむり",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦時下、幸運にも空襲の被害に遭わなかった尾道には名刹古刹が所狭しと建ちならび、それらが縦横無尽に石段で繋がれている風景は穏やかな海と相まって、名勝として広く人々に知られている。",
              "citation": {
                "source": "くじらようかん",
                "author": "澤西祐典",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらの小屋は椰子の葉ぶきの竹製、切り立った崖の側面を所狭しと這いうねっていた。",
              "citation": {
                "source": "象を撃つ",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間も汪克児は、ところ狭しと独りでふざけ廻って、馬の尻っ尾を引っ張ったり、駱駝と白眼めくらをしたり、自分の鼻の孔へ指を入れて嚏をするやら、もんどりを打つやら、しばらくもじっとしていない。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "さしもの師のところだと、うちじゅうに、いろんなものがところ狭しとおかれている。",
              "citation": {
                "source": "カシタンカ",
                "author": "КАШТАНКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる日から茅町のささやかな圓朝の住居の中には、ところ狭しと唐紙のような、障子骨のような、衝立のような、屏風のようなものの、いずれも骨組ばかりのものがとっ散らかされはじめた、とんと経師屋の店先のごとくに。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
