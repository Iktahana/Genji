        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タケノコタチハ　トホクヘ　イキタガツテ　シヨウガ　ナイノデ、オカアサンノ　タケガ、「ソンナニ　トホクヘ　イツチヤ　イケナイヨ、ヤブノ　ソトニ　デルト　ウマノ　アシニ　フマレルカラ」ト　シカツテ　ヲリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イクラ　シカラレテモ、ヒトツノ　タケノコハ　ドンドン　トホクヘ　モグツテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツパト　ハツパノ　アヒダニ、トホク　ミエル　モノ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ダンダン　センサウノ　アル　トコロニ　チカヅイテ　キタラシク、トキドキ　トホクノ　ハウカラ　カスカニ　タイハウノ　トドロキガ　キコエテ　キマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンダン　ミミガ　トホク　ナツタノデ、ミヤコニ　ヰル　ムスコノ　トコロヘ、「ミミガ　トホク　ナツタカラ、ヨク　キコエル　キカイヲ　カツテ　オクツテ　クレ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハ、ソノ　ラツパヲ　ヨロコンデ　ツカツテ　ヰマシタガ、ミミハ　ドンドン　トホク　ナツテ、トウトウ　ツンボニ　ナリマシタ。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒニ　テラサレテ　オマンヂウガ　ウマク　ヤケルマデ　ジロウハ　ウマニナツテ　スナノウヘヲ　トホクマデ　カケテユキマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
