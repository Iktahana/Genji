    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やっぱり怒れず、そのまま炎天の都塵、三度も、四度も、めまいして、自動車にひかれたく思って、どんどん道路横断、三里のみちを歩きながら、思うことには、人間すべて善玉だ。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "啄木、永く都塵に埋もれて、旦暮身世の怱忙に追はれ、意ならずして故郷の風色にそむくうちに、身は塵臭に染み、吟心また労をおぼえぬ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "都塵未曾到　　都塵未だ曾て到らず、湛寂無加之　　湛寂之に加ふるなし。",
              "citation": {
                "source": "閉戸閑詠",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時彼女は、何の髪飾りもなく服も質素でありまして、遙かな白塔に見入ってるその姿は、都塵を離れた清楚さを帯びて、歌曲にふさわしいものでありました。",
              "citation": {
                "source": "白塔の歌",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが、京、大阪、江戸あたりの今日この頃ならば、生首の二つや三つ転がっていたからとて、そんなに驚くがものはない時節柄ではありますけれど、何をいうにもここは都塵を離れたる天地の、飛騨の高山の真中のことですから、その上下を震駭させて、凄惨なる人気をわかしてしまったのも無理はありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "新開地らしい、自然と人工の不調和は見られるが、地勢は一体に広闊で、南面の明るさがあり、もう日は可なり高くなつてゐたにも拘らず、爽やかな微風が時々土のいきれを払つて、所謂都塵を離れたといふ感が深かつた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "小伜が、都塵を離れ、広濶たる水上に清い大気を吸って、のびのびと自然に溶け込んでいる姿を見た。",
              "citation": {
                "source": "小伜の釣り",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼けつく都塵を避けて品川、金杉、築地、月島、神田川などの舟宿へ行けば午後三時頃からもう舟は出漁の準備をしている。",
              "citation": {
                "source": "夜の黒鯛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "氣をつけて見れば春は、不公平なく都塵のなかにも訪れてゐるし、また、ほんとの靜寂といふものも、われら凡夫の身には、實は都心にあるといへよう。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "古事記、日本書紀を讀まなくとも、唯ひとつの精神を一身に堅持してさへ居れば、野に耕すも、鐵槌を打ちふるふも、都塵と山澤に汗して働くも、すでに、皆國體を身に體してゐる人といへるのだ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
