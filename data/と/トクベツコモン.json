        "examples": {
          "standard": [
            {
              "text": "元外交官が政府の特別顧問に就任し、中東和平交渉の戦略立案を支援した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "社長は業界に精通したコンサルタントを特別顧問として招き、事業再編を進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "特別顧問の報告書には、現在の経営体制の課題が率直に指摘されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "おまえは特別顧問になる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四〇七の「整備」――要するに、できあがったラックを運びあげ、棚に機材やレコードをならべて、結線をするだけのことだが――には、「特別顧問」の慶一はもちろんのこと、部員でもなんでもない、山崎や柾生まで駆りだされた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「特別顧問」が、これに参加しない理由はない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
