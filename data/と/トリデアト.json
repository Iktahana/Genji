          "literary": [
            {
              "text": "戦国時代の土豪の拠った砦跡である。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よかろう」と数右衛門が云った、「明朝四時松山の砦跡だぞ」　孝也は馬を返した。",
              "citation": {
                "source": "月の松山",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ではさよなら、桂」孝也は口の中で云った、「どうか仕合せで、――」　孝也は砦跡のほうへ出ていった。",
              "citation": {
                "source": "月の松山",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "砦跡の道へ寄ったほうに、日野と大道寺が立っていた。",
              "citation": {
                "source": "月の松山",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
