        "examples": {
          "standard": [
            {
              "text": "彼の説明が納得できなかったので、もう一度問い直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "先生に質問の意味を問い直すと、丁寧に教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "上司の指示に疑問を感じ、その意図を問い直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」　しばらく無言が続いた後、お蓮がこう問い直すと、声はやっと彼女の耳に、懐しい名前を囁いてくれた。",
              "citation": {
                "source": "奇怪な再会",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈結局は何だったんだろう〉　成功のレールに乗ってひた走りはじめたＰＣ―８００１を前に、松本は自分自身をマイクロコンピューターに向かわせたものはなんだったのかを、繰り返し問いなおすようになっていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
