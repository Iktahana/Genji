          "literary": [
            {
              "text": "モウ一年ニナルノニ、彼奴ハ故郷ニジットシテイテ、ドコニモ働キニ行コウトシナイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚太郎オジサン殺サンゴトシナサイ殺サンゴトシナサイシカシ、ソレデモ、オジサンワ剣ツキ鉄砲デ突カンナラン。",
              "citation": {
                "source": "山東へやった手紙",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ヲ連発シテ容易ニ動コウトシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウナルト予ハイツモノ癖デ依怙地ニナリ、直グニハ立チ上ロウトシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰向ケニ寝テ、ツント鼻ヲ天井ニ向ケテ、眼ヲツブッタマヽ何モ予ニ話シカケヨウトシナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "連レ添ウテ二十何年ニモナリ、嫁入リ前ノ娘サエアル身デアリナガラ、寝床ニハイッテモイマダニタダ黙々ト事ヲ行ウダケデ、ツイゾシンミリトシタ睦言ヲ取リ交ソウトシナイノハ、ソレデモ夫婦トイエルデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハマタ僕ガ足ノ fetishist デアルヲ知ッテイナガラ、イヤ知ッテイルガユエニ、メッタニソノ足ヲ僕ニ見セヨウトシナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三戸郡の村々では、ヌサといっても通ずるが、あるいはこれはヒサゲトシナという家もある。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "トシナは年縄で、東京でいう注連縄のことを意味し、ヒサゲは手に持って提げることである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダッタラ何故オマエモ諦メテヲ体カラ生ヤソウトシナイノダ。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
