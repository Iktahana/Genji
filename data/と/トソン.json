[
  {
    "uuid": "83bbe4f3-c6e8-5776-b7ef-de3247441815",
    "entry": "渡宋",
    "reading": {
      "primary": "とそん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
