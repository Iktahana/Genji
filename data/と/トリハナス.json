        "examples": {
          "standard": [
            {
              "text": "喧嘩を始めた二人の間に割って入り、力ずくで取り離した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "絡まった糸を一本ずつ、丁寧に時間をかけて取り離していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "母鳥が雛を外敵から守るため、近づこうとする蛇を激しく威嚇して取り離した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "非常な力を宿した儘死んでいる指を一本ずつ開いて、屍骸を取り離すのが大変だった。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかして、外よりこの毛に触るるときは、たやすくこれを取り離すことを得べし。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "よって考うるに、その毛、果たして肉中より生ぜしものならば、これを取り離すときに、いくぶんか引き抜くがごとき感覚を起こすべき道理なり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、貧と不幸とは必ずしも徹頭徹尾取離すことの出来ぬ関係にあるものでは無い。",
              "citation": {
                "source": "貧富幸不幸",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
