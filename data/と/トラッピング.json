        "examples": {
          "standard": [
            {
              "text": "印刷のズレによる白窓を防ぐため、隣接する色を少し重ねるトラッピング処理をデータに施した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "高精細な美術印刷では、色の境界線が不自然にならないよう絶妙なトラッピングの設定が求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "デザインソフトの自動トラッピング機能を使ってみたが、やはり手動で調整した方が仕上がりが綺麗だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
