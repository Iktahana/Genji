  {
    "uuid": "2fb3b98b-342e-5457-868a-6f2ad00f792d",
    "entry": "トロウ",
    "reading": {
      "primary": "とろう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしメストロウィークを崩したような大物になると、どうにも自分などのようなものの好意の圏外に飛出してしまう。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペーターの息子、イワン・ペトロウイチが手綱を取っている橇に、大隊長と副官とが乗っていた。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イワン・ペトロウイチは速力をゆるめた。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大隊長はイワン・ペトロウイチに云った。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "できあがった個体の遺伝子を種が変わるほどひん曲げようと、放射線を浴びせたりレトロウイルスを束にしてぶち込んだりすれば、個体がおしゃかになるだけだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "細長いテーブルのまえに、奥から、慶一、高志、ワラの順に坐り、フロントロウを形成している。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おなじく」「ぼくは、そんなになんども、日本くんだりまでこられないから」　フロントロウの三人に拒絶され、山崎はまた大きくため息をついて、義晴を見た。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついぞ今まで車のはいって来たことなどはないので、不思議に思って、清三が本堂の障子をあけてみると、白い羅紗の背広にイタリアンストロウの夏帽子をかぶった肥った男と白がかった夏｜外套をはおった背の高い男とが庫裡の入り口に車をつけて、今しもおりようとするところであった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年前にイタリヤンストロウの意気な帽子をかぶって、羽生の寺の山門からはいって来たその人――酔って詩を吟じて、はては本堂の木魚や鐘をたたいたその人が、第二軍の司令部に従属して、その混乱した戦争の巴渦の中にはいっているかと思うと、いっそうその記事がはっきりと眼にうつるような気がする。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストロウスキーの『パスカル』、ブトルーの『パスカル』等々の文献を集めて読み始めた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのたおやかな古文の妙、たとえば真名盤の香を瑰の芳烈なる薫か、ヘリオトロウプの艶に仇めいた移香かと想像してみると、昔読んだままのあの物語の記憶から、処々の忘れ難い句が、念頭に浮ぶ。",
              "citation": {
                "source": "『新訳源氏物語』初版の序",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと舵のコントロウルを失って、遠く南極洋へ彷徨い出たのだろう。",
              "citation": {
                "source": "沈黙の水平線",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "若く見て貰ひたいなンて愚かな事だ」　富岡は今度は、コアントロウの瓶を出して来て、栓を開けた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけのわからないとまどひで、富岡はコアントロウをぐつとあふつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はダラットが一寸よくなつて来た……」「幸田ゆき子は、加野には似合はないよ」　加野は、コアントロウを手酌でやりながら、血走つた眼で、天井の動かない扇風機の白いプロペラを見上げてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "加野がまだ食堂で残りのコアントロウをかたむけてゐた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子はストロウを二本とって保に渡し、自分も同じだけのストロウをコップにさした。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　保は、少年らしい真面目さで覗いたが、泡が立っている時には、もう一本のストロウを黄色の液体が昇って行かないのを発見すると、本懐そうに体を揺って、ふきだした。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――そうかしら――私、自分が弱いと思ってよ、例えば佃とのことにしろね、私が、もっと図太く腹を据え切って、あのひとをコントロウルできれば、状態は変るのよ。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただビイフシュトロウゲンという奇怪な一皿と、ブルンビアなるアイスクリイムに厚化粧をほどこしたようなデザアトだけは、いささか人類の食に適することをウンテルベルゲル氏の名誉のためにつけ足しておこう。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は、黙つて、ストロウを唇にはさむ。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は、飲み終ると、同時に、ストロウを咬いたまゝ、顔をあげる。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、眼と眼とで、深い微笑を交しながら、次第にストロウの先を近づけ合ふ。",
              "citation": {
                "source": "喧嘩上手",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の長髮のアカイア族、さはれ勵ませ迅速に鬪はんため――盟約を踏みにじりしはトロウエス、彼を未來に待つものは死と荒廢の二つ也。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロウエス又ダルダノイ其衆共に一齊に、集議の席に坐を占めて使者の歸を待てる時、　415歸り來れるイダイオス、彼らの中に立ち乍ら、齎らし來る使命述ぶ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "文界及び劇界に於てもハンフレイ・ワアズ或はクライド・フイチエスの如きが群衆の偶像であるにひきかへ、エマアソン、トロウ、ホイツトマン、イブセン、イエツ、ステフエン・フイリツプスの如き天才の美を認識する者は極めて少数に過ぎない。",
              "citation": {
                "source": "少数と多数",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒人の真の保護者はボストン、ロイド・ガリゾン、ウエンデル・フイリツプス、トロウ、マアガレツト・フラア、セオドル・パアカア等の少数者によつて代表せられた。",
              "citation": {
                "source": "少数と多数",
                "author": "エンマ・ゴルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "また水素塩酸〈ヒトロウジン、コロリン〉・水素硝酸〈ヒトロウジン、ニトロウジン〉など皆この理なり。",
              "citation": {
                "source": "化学改革の大略",
                "author": "清水卯三郎",
                "note": "青空文庫"
              }
            }
          ]
