        "examples": {
          "standard": [
            {
              "text": "トゥデーの天気は晴れで、絶好の行楽日和だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "トゥデー中にこの仕事を終わらせなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "トゥデーは、私にとって忘れられない一日となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ミーはトゥデーははあパウ・ハナじゃけえ。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、円海山までいってたら、いまごろ、ひでえことになってたな」　高志がナップザックからラジオを出し、ぬれていないことをたしかめ、スウィッチを入れると、グラス・ルーツの〈レッツ・リヴ・フォー・トゥデイ〉が飛びこんできた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビーチボーイズは『ペット・サウンズ』『トゥデイ』『エンドレス・サマー』の三枚、ストーンズは『ホット・ロックス』があります。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "36昨日と今日のあいだには百万年の時間が流れたみたいだ〈ビトウィーン・トゥデイ・アンド・イエスタデイ〉アラン・プライス（アニマルズ）　小さなレコード屋だ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
