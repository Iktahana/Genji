          "standard": [
            {
              "text": "「あの人も随分年を食ったな」と久しぶりに会った友人の顔を見て思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "見た目より年を食っていると、よく言われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "若く見られていた彼も、いつの間にか年を食ったようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "存外、年を食うて大きなずうたいをしているに拘らず、いろはのいの字も知らない鼻たらしがいたり、小さくても、年も少ないのにずいぶん過ぎた読書力を持っていたりするものもあり、概して平均した教育を持っていないことを知った与八は、説教だけではいけないと、今度はお松さん直伝の教育にとりかかりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "胆吹の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
