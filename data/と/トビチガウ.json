    "definitions": [
      {
        "index": 1,
        "gloss": "to flit about",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "春の陽気に誘われて、色とりどりの蝶が花畑のあちこちを忙しそうに飛び違っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕暮れ時の河川敷では、無数のコウモリが餌を求めて複雑な軌道で飛び違う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "深い森の中では、小鳥たちがさえずりながら枝から枝へと絶え間なく飛び違っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それはそれは名状し難い速さで廻っているかと思うと急に花火の開いたようにパッと散乱してそのまた一つ一つの片が廻転しながら縦横に飛び違う。",
              "citation": {
                "source": "赤",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔面の他の部分の表現が鼻を中心として飛び違うために、その十字線が丁度鼻の上に結ばって一種の錯覚を起すものである。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "毒々しい、薄っぺらな色彩のバラック街……眼まぐるしく飛び違う車や人間……血走った生存競争……そんな物凄い刺戟や動揺めきをうけた柔かい少年少女の脳髄は、どれもこれも神経衰弱的に敏感になっている。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっと左右へ飛び違う。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども彼は落葉だけ明るい、もの寂びた境内を駆けまわりながら、ありありと硝煙の匂を感じ、飛び違う砲火の閃きを感じた。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――と云う手筈になるところを、飛び違った若侍は、「こっちもこうだあァ――ッ」と浴びせかけ、飛び違う間に抜いた太刀を、ヌ――ッとのすと振り冠った。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは近くあるいは遠く、警鐘の物すごき合奏、早くも駆けつけた消防車のサイレン、提燈の火と共に、群り来る群集、エンジンのうなり声、飛び違う消防手、火の粉の雨、逃げまどう人波、泣き声、わめき声。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、一寸気を許すと、眩暈の様に、青や赤の風船玉みたいな物が、目の前を、滅多やたらに飛び違う。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "剥げかかった漆喰の壁に向ってじっと横臥していると、眼の前を小さな虫のような影がとびちがう。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "信号だっ、火だっ」「伝馬っ」　総員は、右に左に、それこそとびちがうように走って、非常配置の部署についた。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "裸の男がとびかかるのははっきり見たが、あとは六人の躯が縺れあい、とびちがうので、誰が誰とも見分けがつかなかった。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "徒労に賭ける",
                "note": "青空文庫"
              }
            },
            {
              "text": "二本のけんが、目にもとまらぬはやさでとびちがうので、まるで、銀色のにじがきらめいているように見えます。",
              "citation": {
                "source": "ふしぎな人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇治の姫君たちとはどれもこれも恨めしい結果に終わったのであったとつくづくと思い続けていた夕方に、はかない姿でかげろう蜻蛉の飛びちがうのを見て、ありと見て手にはとられず見ればまた行くへもしらず消えしかげろふ「あはれともうしともいはじかげろふのあるかなきかに消ゆる世なれば」と例のように独言を言っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "蜻蛉",
                "note": "青空文庫"
              }
            },
            {
              "text": "迷信深い魯西亜の水兵どもは、綾に飛びちがう火光を外目にして、祈祷歌を、平然と唱え続けているのだ――それは沈厳な、希臘正教特有の、紛う方ない水葬儀だったのである。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高台のあたりで烏がなき、雀が八方に飛びちがう。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず神鳴も急に凄じく鳴りはためいて、絶えず稲妻が梭のように飛びちがうのでございます。",
              "citation": {
                "source": "竜",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、島田邸のまわりは、夜にはいると、懐中電灯の光があちこちに、チラチラして、まるで、ほたるが飛びちがうような、美しくも、ぶきみな光景となりました。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしの村白雲のうちにかくれて、藏王權現堂花の間にうづもれ、顧れば疊々として諸峯遠く連なり、山腹深く落ちて谷のかなたに飛びちがふは、山雲の風に亂るゝなり。",
              "citation": {
                "source": "山家ものがたり",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは石のやうに水底へ沈みながら、数限りもない青い焔が、目まぐるしくおれの身のまはりに飛びちがふやうな心もちがした。",
              "citation": {
                "source": "沼",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に当りぬべく覚えて大に驚きたる中に、よく心得たる者｜押静め、先づ下に坐せしめて言を交へずしてある程に、大石の頭上に飛びちがふばかりにて其響｜夥しかりしが、暫くして止みければ、立上りて行きける。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
