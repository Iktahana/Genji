        "examples": {
          "standard": [
            {
              "text": "古い和綴じの本は、美しい綴じ糸で装飾されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "綴じ糸が切れて、本がバラバラになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "修復師は、丁寧に新しい綴じ糸で本を直した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "なけりゃ下から貰って来る」　七輪を机のわきに持ちこんで食べ終ると、重吉は戸棚をあけて、田舎風に青い綴じ糸が表に出ている褞袍をぐるぐると畳んで新聞紙に包んだ。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま眠ってしまうかというとそうではなく、しばらく静かにしておりますと、閉じた目の前に美しいさまざまな色彩が浮かぶ、昔見た美しいとじ糸のついた絵日傘が浮かぶ、いつか見た絵巻物が鮮やかに展開する。",
              "citation": {
                "source": "画筆に生きる五十年",
                "author": "――皇太后陛下御下命画に二十一年間の精進をこめて上納――",
                "note": "青空文庫"
              }
            },
            {
              "text": "茶色の表紙に青いとじ糸を使い、中の紙も日本紙で片面だけに字をすったのを二つ折りにして重ねとじた、純日本式の読本でした。",
              "citation": {
                "source": "くまと車掌",
                "author": "木内高音",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――こりゃあ、とじ糸ですがね」　母親は国風に、こまかく青い綴糸を表に出して夜着のようにどてらを縫ってよこしたのであった。",
              "citation": {
                "source": "道づれ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "とじ糸も新らしい、ふくよかな丹前の色が眼につく。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「つつがなく彼の地へ渡れるならば、この先へ魚かかるべし」　と、のたまいて、裳のすそのとじ糸に、縫い針を曲げて、食後のめし粒を餌にして……、と書いてある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
