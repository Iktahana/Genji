[
  {
    "uuid": "7f9d26b8-b5f6-57a3-b391-647dbb9559e8",
    "entry": "飛び跳ねる",
    "reading": {
      "primary": "とびはねる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
