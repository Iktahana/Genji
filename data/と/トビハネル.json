    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to jump up and down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭に設置した大きなトランポリンで、子供たちが汗をかきながらいつまでも楽しそうに飛び跳ねている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "サヨナラ勝ちを決めた瞬間、ベンチの選手たちが一斉にグラウンドへ飛び出して飛び跳ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水槽の中で新鮮な魚が激しく飛び跳ね、買い物客の服に生臭い水しぶきがかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」　そういって、その瓶を目よりも高く差し上げると、また飛び跳ねる馴鹿の仔のように活溌に走り出した。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "興奮した馬が飛び跳ねるごとに、どこか角にぶつけて、さらに興奮を高める。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "池には飛び跳ねる小魚もいぬのであった。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりは飛び跳ねるように、先頭をきって横断歩道をわたる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ａ子は頻りに半身を折り曲げたり、飛び跳ねる恰好をしたり、重たいものを投げるかのやうな姿をとつて、Ｒ子に示してゐた。",
              "citation": {
                "source": "風媒結婚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに対して、笠間由子は、物々しく割烹着を着こんで、飛び跳ねる世津子を、後から抱きかかへるやうに引き寄せ、立つたまま、「お帰りなさいませ」　と、誰よりもはつきり云つた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "水をかき回し、餌を求めて大きく飛び跳ねる。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジェニファーが持って来てくれている、マーマレード入りの熱いコーヒーをすすり、砂浜を飛び跳ねるように走っては、冷えた全身に体温をとり戻した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛び跳ねるがごとく上下に揺れ、思わず大惨事を予想してののしった。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、滝のザンザと落ちる前で銀色のヴェールをふって、水の精が踊り、数人の火の精がとびはねるだけのこととなった。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "波のやうにとびはねるヒヤシンスよ、しづかに物思ひにふけるヒヤシンスよ。",
              "citation": {
                "source": "藍色の蟇",
                "author": "大手拓次",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　ダッシュが　よろこんで　とびはねるって　おもったのに、　なのに　かみついてきて！",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "目も向けられないような濃い雪の群れは、波を追ったり波からのがれたり、さながら風の怒りをいどむ小悪魔のように、面憎く舞いながら右往左往に飛びはねる。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子は思わずぎょっとして夢からさめたように前を見ると、釣り橋の鉄材が蛛手になって上を下へと飛びはねるので、葉子は思わずデッキのパンネルに身を退いて、両袖で顔を抑えて物を念じるようにした。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛びはねるようなフルートのイントロが流れる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "――飛びはねる毎に明るい翼がきらきらと陽に映えては、また草の中に姿をかくす……。",
              "citation": {
                "source": "ダニューヴの花嫁",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さえ、いゝよ、上げてやンな、この子は熱いのきらひだよ」　子供は飛びはねるやうにして流しへ出て來たが、體ぢゆうが茹でたやうにぱつと赤い色にそまつてゐる。",
              "citation": {
                "source": "うき草",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがヒイヤロ、ヒュイヤロウと鈴を振る形（それがあたかも権兵衛が種蒔く型、そしてときどき後ろを振り返って、ホウと鳥でも追うようなしぐさをやる）カラス飛び（カラスの飛びはねるようなしぐさ）などの口伝などがあるので云々（山本鹿州氏談）。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が眼を覚して、蚊帳から出されて、両親の膝の上で飛びはねる時なんか、武田は首をひねって眺めながら、しきりに一人で感心していた。",
              "citation": {
                "source": "裸木",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "手を振り振り、飛びはねるように歩いてゆく、少女の後から、のっそりした杉本の姿が、ついていった……。",
              "citation": {
                "source": "傷痕の背景",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "堯は笑い乍ら飛びはねるようにして出て来るのであった。",
              "citation": {
                "source": "生と死との記録",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "上の部屋で傍若無人に飛びはねる粗暴な物音で眼をさました。",
              "citation": {
                "source": "黒い手帳",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛びはねる面白さのために石ころの間を登ったり滑ったりする、まったくの子｜山羊であった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉にならない声を喉の奥で発しながらナナエは椅子のかたわらに立ち、飛びはねるように一回転した。",
              "citation": {
                "source": "少女時代",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんはいつのまにか自分も子供たちにまじり、克子の手をとって歌にあわせて首をかしげさせようとしたり、両手をしなやかに動かせようと説明するのだが、克子はその手をふりほどき、皆の笑うのもかまわずやたらに飛びはねることよりしなかった。",
              "citation": {
                "source": "赤いステッキ",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彼の小さな身体は飛びはねる恰好で、暗の中に消えて行った。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、令子を抱きしめ、なんどか、小さく跳びはねる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに較べると学校はひろく勝手気ままに跳びはねることができるのだ。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "流星がとぶのも、隕石がひらめくのも、この谷間では国じゅうのどこよりも頻繁だし、悪夢の魔女は九人の供をひきつれて、ここで跳びはねるのが好きらしい。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄は横板を半分に折った座席から立ってくると、跳びはねるような震動のなかで、彼の首に自分の絹のマフラアを巻いた。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
