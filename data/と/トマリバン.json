        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今週の土曜日は私が泊まり番なので、外出はできない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "泊まり番の最中に機械が故障し、対応に追われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "泊まり番の引き継ぎを終えて、ようやく家路についた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "――どうも大分横道にそれてしまいましたが……で、その夜明けのポンコツの知らせを受けて私と吉村君とそれから矢張り泊り番だった工夫の三人ばかりとで取敢ずガソリンカーで現場へ出掛けたのです。",
              "citation": {
                "source": "穴",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三日の夜は余が泊り番であった。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜の泊り番に当ったのは、小柴静夫という上席の書記で、元園田氏の秘書をした事もある男だから、先ず絶対に信用されている人間だ。",
              "citation": {
                "source": "女記者の役割",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "役署の手すきにちょっと様子を見に来たまでだ」「じゃあまた、ご出勤ですか」「こん夜は泊り番さ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつが」　小屋｜仲間は愕いて、泊り番の職方目付を起しに行った。",
              "citation": {
                "source": "宮本武蔵",
                "author": "二天の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
