        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "製品に関する多数の問い合わせが、カスタマーサービスに寄せられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ご不明な点がございましたら、遠慮なく当部署までお問い合わせください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そのウェブサイトにはよくある質問と問い合わせフォームが用意されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "花袋も何かでビョルンソンのことを書いていたかと記憶しているが、それについて花袋に問い合わせの手紙を出した。",
              "citation": {
                "source": "紀行文家の群れ",
                "author": "――田山花袋氏――",
                "note": "青空文庫"
              }
            },
            {
              "text": "十六　野中兼山が「椋鳥には千羽に一羽の毒がある」と教えたことを数年前にかいた随筆中に引用しておいたら、近ごろその出典について日本橋区のある女学校の先生から問い合わせの手紙が来た。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠義一途の用人は、きのう中にすこしは何かの手がかりは付いたかと問い合わせに来たのであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "朝顔屋敷",
                "note": "青空文庫"
              }
            },
            {
              "text": "※翻訳についてのお問い合わせは、青空文庫ではなく、訳者本人（http://www.alz.jp/221b/）までお願いします。",
              "citation": {
                "source": "はだかの王さま",
                "author": "THE EMPEROR'S NEW SUIT",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで早速、私に宛てた至急親展で、事のアラマシを通知して、事実かどうかを問い合わせて来た訳ですが、その手紙を受取った時には私も、思わずシインとなりましたよ。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方の読者への勧誘状を書いたり、問い合わせに対する返事を書いたりして、彼女はどうかすると、八時頃まで残ることさえあった。",
              "citation": {
                "source": "接吻を盗む女の話",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手元の案件のうちでは、ひとつだけやや込み入った事件の問い合わせが、マルセイユからあるのだが、それ以外は惹かれるものが何もない。",
              "citation": {
                "source": "同一事件",
                "author": "A CASE OF IDENTITY",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリーヴランドへの電報で、ドレッバー氏の過去の経歴のある点について問い合わせたか、と。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリーヴランドの警察署長へ電報を打ち、イーノック・ドレッバーの結婚関連事項に絞って問い合わせだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓もついでに問い合わせたが、人間の通れるほどの大きさはないという。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "※翻訳についてのお問い合わせは、青空文庫ではなく、訳者本人（https://www.alz.jp/221b/）までお願いします。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、武揚の妹のおっとである江連という人から、諭吉のところへ手紙でといあわせてきました。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            },
            {
              "text": "母やきょうだいが心配していますので、江戸のしんるいにといあわせましたが、だれも、自分が政府ににらまれるのをおそれてか、ただの一どもへんじをくれません。",
              "citation": {
                "source": "福沢諭吉",
                "author": "ペンは剣よりも強し",
                "note": "青空文庫"
              }
            },
            {
              "text": "泰造は、その日の夕方、外出から帰って来るといあわせた伸子に、朝のできごとを話した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "空家の怪　警察署から、警視庁に電話でといあわせますと、透明怪人事件のかかりの中村係長が、明智事務所にとまっていることが、わかりましたので、また、そこへ電話をかけ、中村係長はすぐに、かけつけてくることになりました。",
              "citation": {
                "source": "透明怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他、個々の問合せには応じ難い。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大津の料理屋で働いている彼女の友達から、近況問合せの手紙が来た、その返事を書いてくれと、彼女は言い、「どんな風に書きましょう」豹一が訊くと、「わてのこのお腹のなかにたまってる、いやや、いやや、思う気持を一ぺん正直に書いてほしいんどっせ」そして、彼女はこまごまと、「身の上話」をはじめた。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　駿河台のお邸にては、夜に入りても御前様の御帰館無きより、心当を問合せ、御親類中へ使者を向くるに、いずくにも見えさせたまわず、皆目｜御立寄これなきよし。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりあえず、マンチェスター駅よりは三分の一ほど手前のセント・ヘレンス駅へ問合せの電信をうってみると、次のような返電があった――『リヴァプール駅長ジェームス・ブランドへ、――臨列、遅刻なく四時五十二分当駅通過、――セント・ヘレンス、ダウサー。",
              "citation": {
                "source": "臨時急行列車の紛失",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "葬の前に、お嬢様のお好な花はなんであつたかと、諸方から問合せがあつた。",
              "citation": {
                "source": "薔薇",
                "author": "ROSEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になってから、彼は葉子の母に当てて問合せの電報を打ってみたが、　ヨウコマダツカヌ　という返電の来たのは、その夜も大分｜更けてからであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "墨汁師の新年の書信に問合せの結果が記してあったが、それは頗る覚束ない口吻であった。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正15・８「時事新報」）私の机　ある雑誌社から「あなたの机は」という問合せが来たので、こんな返事をかいて送る。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな表の状袋を用るくらいでは少々我輩の手に合わん高等下宿だなと思ながら「ナイフ」で開封すると、「御問合せの件に付申上候。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃柳田國男氏に問合せしに、柳谷謙太郎氏明治九年十月九日より十六年三月三十一日迄、桑港領事として留任せりと答へらる。",
              "citation": {
                "source": "秘魯國に漂著せる日本人",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢田福岡県知事から内務当局へ宛て一つの問合せを発した。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "四（封書――宛名、麹町区丸ビル七階Ｎ……法律事務所内弁護士法学士Ｙ・Ｔ……宛）　前略、亡父の「署名」に関する御問合せの御手紙拝見いたしました。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで嵯峨の彼女の寺まで行つて私立探偵のやうに問合せて廻つた。",
              "citation": {
                "source": "現代詩",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（周知のように前もって役人を手懐けておかないことには、ちょっとした問合せや照会だって、なかなか受附けてくれるものではない。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つ心当りを問合せてみましょう」　女教師の旦那は引受けてくれた。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
