[
  {
    "uuid": "92b28eaa-09b6-59cb-88b7-05f459ec4972",
    "entry": "鳥屋",
    "reading": {
      "primary": "とや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
