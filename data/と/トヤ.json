  {
    "uuid": "4f0737c6-1a39-518e-b828-be69e785a787",
    "entry": "トヤ",
    "reading": {
      "primary": "とや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ノッソリ出テ来テ、蠅タタキノ如ク、バタットヤッテ、ウムヲ言ワサヌ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草の「ハトヤ」という喫茶店に似て、それよりももっとはなやかで、そしてしみじみした千日前らしい店だった。",
              "citation": {
                "source": "神経",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日はいよいよ鷹が貰えると思ってさんざんに待ちかねて、やっとその日になってみると鷹は今ちょうどトヤに入っているからもう二、三日待ってくれというのである。",
              "citation": {
                "source": "鷹を貰い損なった話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る男の手記、彼はま夜中にひとり踊る、何を踊る、ステテコ、ステテコ、オツトヤレコラ、ハクシヨイ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガチヨウノ　タンジヨウビ新美南吉　アル　オヒヤクシヨウヤノ　ウラニハニ　アヒルヤ、ガチヨウヤ、モルモツトヤ、ウサギヤ、イタチナドガ　スンデ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏からきこえて来る工場のエンジンの音と、隣のトヤに飼つてある鶏の鳴声と、障子に映る樹木の影と、唯それのみが伴侶となるばかりであつた。",
              "citation": {
                "source": "間居",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "伏姫が山入した富山（トミサンと呼ぶ、トヤマでもトミヤマでもない）の如きも、『八犬伝』に形容されてるような高峻な山ではない。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俺が卵を売つた金で酒をぶらさげて帰る時だけは、奴等は、緑山寺さんだとか、大師さんだとかと云つてちやほやする癖に、此頃鶏がトヤについて俺の収入の道が絶えたとなつたら、忽ち手の裏を返しやがるんだよ。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寒玉子で一番大いに儲けてやらうと、たくらんでゐたところが、つい先頃鼬の奴にねらはれてあらかた生血を吸はれてしまつた上に、残つた連中が五羽ながら雄でね、二羽の雌と来たらそれ、そのトヤといふものにつきやあがつて、さん／″＼の態たらく……」「そ、それあ、どうも――」　と私は上の空で同情した。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノコトハ子規ノ書イタモノニカタカナ文ガ多イコトヤ、宮沢賢治ノ病中作デアル「雨ニモ負ケズ」ノ詩ガカタカナデアルコトナドデ間接ニ証明サレルガ、ナオソレニツイテイササカインチキナガラ力学的ニ考察シタ文章ヲ他ノ場所ニ発表シタカラココニハ書カナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その侘し気なバスケット物語が、トヤについたこの人達の幾日かの生活をものがたっている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ははあそうか、烏組で使うトヤ駕籠だな。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トヤ駕籠を舁いでいた駕籠舁きの足さ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐ろしい恐ろしいトヤ駕籠だ！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち烏組のトヤ駕籠である。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「島津家の女忍び衆、烏組発明の捕り物道具、さあトヤ駕籠だトヤ駕籠だ！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしお前さんに遁がれられたら、その時かぎりトヤ駕籠を廃し、それこそ妾達一人残らず、お前さんに降参してもいい。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くトヤ駕籠の現われない前に、逃げてしまえばよかったんだよ」　するともう一人が憎々しく、「腕がないのさ、つまるところね。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際烏組のトヤ駕籠の、不思議を極めたカラクリを、どうして破ってよいものか、見当が付いていないのであった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせ、トヤ駕籠の恐ろしさは、充分知っているのであった。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と諦めたお絹、トヤ駕籠の戸を睨み付けた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えトヤ駕籠の戸を開けても、二人を同時に捕えることは出来ない。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人を捕えているその間に、他の一人に切り立てられ、その上肝腎のトヤ駕籠でも、破壊されたら大変である。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一世の梟雄島津太郎丸　浜路を乗せたトヤ駕籠一丁、御器所の方へ走って行く。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜三太、嘉市というトヤ駕籠使いの名手、その二人に託しましたれば、まず間違いなくおびき出し、連れ参ることと存ぜられます」「うむ、その山影宗三郎だが、たしかその方と御岳山中で、甲斐の徳本と想像される、薬草道人とかいう不思議な隠者を、中心にして争った、その水戸家の侍だな？",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トヤ駕籠帰りましてございます」「おおそうか」と太郎丸、「で、獲物は？",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、建物の角を廻り、現われたのは例のトヤ駕籠、トンと下ろすと二人の駕籠舁き、平伏をしたものである。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　眼を覚ました二人の者、ギョッと驚いて飛び上がったが、もう遅い、スルスルスル、トヤ駕籠の中へ引っ込まれた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃例のトヤ駕籠は、島津太郎丸の大屋敷の、表の門へ横着けされた。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
