          "literary": [
            {
              "text": "メヲパチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲオリマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデモ　メヲ　パチパチサセテ、ナントカシテ　ネムラナイヤウニ、ホネヲ　オリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同ジ辻堂ノ中デ五六丁離レタ所ニオ誂エ向キノ家屋ガ一軒売リ物ニ出タノデ、何トカシテソレヲ買イタイノダガ、ソレニハ金ガ二三百萬足リナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ聞カサレルト、予モ何トカシテ居残ル算段ヲシナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ又何トカシテ人ニ知ラレマイトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
