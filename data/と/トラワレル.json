[
  {
    "uuid": "4e465173-26b0-5b35-8d83-ac0c37236257",
    "entry": "囚われる",
    "reading": {
      "primary": "とらわれる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
