        "examples": {
          "standard": [
            {
              "text": "故障の影響で、工場のラインが一時的に止まっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "断水により、マンション全体の水が止まってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "薬を飲んだおかげで、ようやく咳が止まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "to alight",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
