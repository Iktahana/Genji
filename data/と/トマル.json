[
  {
    "uuid": "73f002e0-6009-5c60-8d2b-39b9a6d6a22b",
    "entry": "止まる",
    "reading": {
      "primary": "とまる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
