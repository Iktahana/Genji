        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "泊まり場所をさがしながら先刻うろついていた旅人である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガンたちは森の中の沼地に泊まり場所を見つけて、そこに舞いおりました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、今夜の泊まり場だ。",
              "citation": {
                "source": "穂高岳屏風岩にて",
                "author": "早川鮎子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これほど高くて、自由で、感じのいい泊り場所はめったにない。",
              "citation": {
                "source": "涸沢の岩小屋のある夜のこと",
                "author": "大島亮吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は近所の便利なところに、泊り場所ぐらいは見つけられた筈だが、夜遅く、電車で僕の家へやって来た。",
              "citation": {
                "source": "好人物",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃあ己にゃ持って来いの泊り場所だ。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つてその泊り場も一定してゐた訳ではなく、或る時は隅田川の上流の人気ない浅瀬に、或る時は都市の中央に架つた巨大な橋の下に。",
              "citation": {
                "source": "水に沈むロメオとユリヤ",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、もうすでに夜も遅く、また今では自分が欲しようと欲しまいとこの一家とすっかり結びついているのだから、ここに泊まることはほかの理由からならおそらく耐えがたいだろうが、この結びつきを考えに入れると、この村ではいちばん自然な泊り場所であるように思われたのだった。",
              "citation": {
                "source": "城",
                "author": "DAS SCHLOSS",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩の名はこの泊り場所を指示する為のものらしい。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一の鞍部に着いた時は、そろそろ泊り場所を探してもよい時刻であった。",
              "citation": {
                "source": "秋の鬼怒沼",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最う泊り場所を探さなければならない時刻になった。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泊り場所は直ぐ此処と決った。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「好い泊り場所だ」、誰かそんなことを言った者がある。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泊り場所をきめなければならないので、四方に目を配りながら独り前進を続けていると、ふと岩の上に見慣れない一羽の鳥がいるのを発見した。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "好い泊り場所を探しあてる望も絶えたので、尾根の窪みの稍や平らな所へ天幕を張ることにした。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は心の内に、焔をあげてパチパチ燃え上る熾な焚火を想像して、早く泊り場所へ着きたいものだと思った。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕合谷の方にも好い野営地がないので、今下りた沢の突き当りの大岩が堰き止めた乱石の上を平にして泊り場所とした。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "居ながら瀑が見られるので其処を泊り場所とした。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもなければ好い泊り場所も得られない。",
              "citation": {
                "source": "朝香宮殿下に侍して南アルプスの旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道には迷う、その揚句にいい泊り場所を見つけたと、よろこんではいって来たのが、この天童谷の切支丹村。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕合谷の泊り場へおりる所は、黒部特有の、大きな熊手でかいたような縦皺の一つだったが、綱で（硫黄沢の経験から、こんどはロープを用意していた）下った崖下の、雨にむれて、むせるばかりの、土と草のにおいは、今でも身近にあるように感じられる。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをくり返したが、私も焦りと根負け気味で、今日は薬師を越えて水のある泊り場を探さねばならず、こんなことをしていたら日が暮れてしまう。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分だけ泊り場所を移したことも、この老人には藩用の都合でといいつくろってあるくらいだった。",
              "citation": {
                "source": "銀河まつり",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "外の団員達も、それぞれ木賃宿とか、遊廓とか泊り場所が分っていて、残らずアリバイが成立した。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
