    "definitions": [
      {
        "index": 1,
        "gloss": "to melt (metal)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
