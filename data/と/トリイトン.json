        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こは貝殼持てるトリイトンの神の像に造り做したる、美しき噴井ある、大なる廣こうぢの名なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "瀧のほとりには、喇叭吹くトリイトンの神二人海馬を馭したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "童は斯く歌ひて、「トリイトン」の石像を指したり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "北山おろし劇しうして、白雪街を籠め、廣こうぢの石の「トリイトン」に氷の鬚おふるときは、我喜限なかりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かゝる日には年ゆたかなる兆とて、羊の裘きたる農夫ども、手を拍ちて「トリイトン」のめぐりを踊りまはりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "長き※衣を着て、噴水のトリイトンの神のめぐりに舞ふ農夫、一人の匍匐ひたるが上に一人の跨りたる侏儒抔、いたく姫君の心にかなひて、始はこれに接吻し給ひしが、後には引き破りて棄て給ひぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが熱き炎の都、都なる煉瓦の沙漠、沙漠なる硫黄の海の広小路、そのただなかに、饑ゑにたるトリイトン神の立像、水涸れ果てし噴水の大水盤の繞には、白琺瑯の石の級ただ照り渇き痺れたる。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、此の海の何處かで、半身を生温い水の上に乘出したトリイトンが嚠喨と貝殼を吹いてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、この海の何処かで、半身を生温い水の上に乗出したトリイトンが嚠喨と貝殻を吹いている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等と（海の怪物として。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等とこゝに来るに先だちて、われ等早く思ふよしありき。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等とわれ等の手に載せ、かしづきて来ぬるもの、君等の心を悦ばせざらめや。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等と治まれる世の祭せむと、カベイロイの神等を迎へ来ぬ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "8185　　　　ネエレウス族とトリイトン等と三柱をば迎へまつりぬ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等と実は七柱の神おはせり。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "8195　　　　ネエレウス族とトリイトン等とわれ等は知らず。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネエレウス族とトリイトン等とこの祭執り行ふわれ等の誉8210いかに高く挙がるかを見よ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ネエレウス族とトリイトン等と過ぎ去る。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
