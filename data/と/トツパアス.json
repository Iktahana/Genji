          "literary": [
            {
              "text": "ロオズ・トツパアス、エメラルドなどが皮の袋の中からざらざらと音を立てて出されるのは、穀類の様な気持がする。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の駅駅に点る黄な灯の色をしたトツパアスもあつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオズ・トツパアス、エメラルドなどが皮の袋の中からざらざらと音を立てて出されるのは、穀類の樣な氣持がする。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の驛驛に點る黄な灯の色をしたトツパアスもあつた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
