        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そのかわり、牛が三頭、犢を一頭連れて、雌雄の、どれもずずんと大く真黒なのが、前途の細道を巴形に塞いで、悠々と遊んでいた、渦が巻くようである。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "炬燵の上には、猫が咽も鳴らさず巴形に眠って居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "臥牛山を心にした巴形の函館が、鳥瞰図を展べた様に眼下に開ける。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "臥牛山を心にした巴形の函館が、鳥瞰圖を展べた樣に眼下に開ける。",
              "citation": {
                "source": "熊の足跡",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして舞台を斜めに、巴形の進路をとりつつ、渦巻のように中心まで一瞬間に迫って行く。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの手は、（順序をよく覚えていないが、）とにかく最初の巴形の行進に引きつづいて、次の瞬間に猛烈に踊られたものである。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めの出と同じ行進が、前よりも小さい巴形の進路の上を、前よりも短く踏まれた。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
