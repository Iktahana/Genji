          "literary": [
            {
              "text": "処構わず舞って見せたくなる。",
              "citation": {
                "source": "能とは何か",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌て者の日本人はすっかり驚いて、日本魂までデングリ返らせた結果が、今日では処構わず爆弾を取り落すような悲しい民族的精神となり果てた。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めのうちはそれでも夜になると家に帰つて来たけれどしまひには疲れて来れば処構はずそこらへごろりと横になる。",
              "citation": {
                "source": "吸血鬼",
                "author": "ジョン・ポリドリ",
                "note": "青空文庫"
              }
            },
            {
              "text": "／＼」と叫び續けてゐるおせいの顏や頭と處構はず打つたり蹶つたりしてゐたが、ヒーツと云ふ悲鳴を聞いて、手足を止めておせいの顏を視ると、口からタラ／＼血が出てゐたので、自分もゾツとした。",
              "citation": {
                "source": "蠢く者",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            }
          ]
        }
