        "examples": {
          "standard": [
            {
              "text": "援軍が来るまで時を稼がなければならない状況だった",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は巧妙に言葉で時を稼いでいた",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この作戦は敵をかく乱して時を稼ぐ目的がある",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ところで酒でも飲めればまず旦那のお相手ともなり、芸者とともに暫時を稼ぐことも出来るわけかも知れないが、不幸にして僧帽弁に穴のあるものにとっては歓楽どころの騒ぎではないのだ。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "時を稼ぐためにである。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼らの最期や、そうした支えも、山上の行宮にとっては、時を稼ぐに大きな任務をとげていたといえよう。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ主軍のための時を稼ぐ――それも幾刻か――には過ぎますまいが。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
