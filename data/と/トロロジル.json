        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "精進料理では薯蕷汁が一品として出されることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "薯蕷汁の素朴で優しい味わいが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "蕎麦に薯蕷汁をかけて食べるのが季節の食べ方だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そんな比羅絵を、のしかかって描いているのが、嬉しくて、面白くって、絵具を解き溜めた大摺鉢へ、鞠子の宿じゃないけれど、薯蕷汁となって溶込むように……学校の帰途にはその軒下へ、いつまでも立って見ていた事を思出した。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なあんだ、それではあの、とろろ汁の指導者が、この目前の食通氏であったのか。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「でも、とろろ汁は？",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸子へ参りました」　なるほど障子に名物とろろ汁、と書いてある。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは奥座敷といっても奈良漬色の畳にがたがた障子の嵌っている部屋で永い間とろろ汁が出来るのを待たされた。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸子の宿の名物とろろ汁の店といってももうそれを食べる人は少ないので、店はただの腰掛け飯屋になっているらしく耕地測量の一行らしい器械を携えた三四名と、表に馬を繋いだ馬子とが、消し残しの朝の電燈の下で高笑いを混えながら食事をしている。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "老婢が「とろろ汁が出来ました」と運んで来た。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "煮て食うつもりか、とろろ汁にするつもりか」「どうするつもりか知りません。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣人同志でもあり、宿役人同志でもある二人の友だちは、しばらく街道から離れる思いで、尽きない夜咄に、とろろ汁に、夏の夜のふけやすいことも忘れていた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯉の塩焼だの、しめじの汁だの、とろろ汁だの、何の缶詰だのと、勝手なことを云いながら夜遅くまで飲み更かした。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "註文しておいたとろろ汁が出来ていた。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "とろろ汁は出來のよしあしを問はず生來の好物だし、斯うした山國の常として漬物だけには非常な注意が拂つて漬けられてゐるので確かにうまい。",
              "citation": {
                "source": "樹木とその葉",
                "author": "草鞋の話旅の話",
                "note": "青空文庫"
              }
            },
            {
              "text": "田芹のおひたしに、大きな塗椀の中にはぷつぷつと泡立っているとろろ汁が入っていた。",
              "citation": {
                "source": "茶粥の記",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　七兵衛ふりかえると、店先でとろろ汁を食べているのは、薩※峠で競争をしかけた、銀ごしらえの変な男。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても早い、自分がちょっと清水港で用を足している間に、本街道を早くもかけ抜いて、ここでとろろ汁を食っているのだから、七兵衛もなんだか一杯食わされたような気持がするのでありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これから名代の宇都谷峠へかかるのでございますから、草鞋でも穿き換えようじゃあございませんか」「そうしましょうかな」　二人はとろろ汁を食べて、草鞋を穿き換えて、いざ、とこの茶店を出立しました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの家でも食物などは、それぞれに癖のあるもので、今晩はとろろ汁です、などといわれると困りました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その梅や若菜の時分に東海道を旅して鞠子の宿について、そこのとろろ汁を食べもするであろう、と乙州の旅行を思うて挨拶を贈ったのが発句。",
              "citation": {
                "source": "俳句への道",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "東海道を通って行くうちに、だんだん春らしくなって来て梅も咲こう、若菜も摘まれよう、またまりこの宿についた時分には、そこの名物であるとろろ汁は是非とも食べて行ったらよかろう。",
              "citation": {
                "source": "俳句への道",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理屋料理ではあるが、あわびのとろろ汁というのがある。",
              "citation": {
                "source": "東京で自慢の鮑",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きのいい青黒の雄貝を、多量の塩で揉み固め、石のようになったのを、おろし金で薯をおろすようにおろし、それを自然薯と等半にすり混ぜて、とろろ汁をつくる。",
              "citation": {
                "source": "東京で自慢の鮑",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "――芋汁というのは、とろろ汁の中へなにか白身の魚と青い物がはいっているらしく、男はその汁で酒を一本飲み、次いで、酒と甘煮を注文した。",
              "citation": {
                "source": "へちまの木",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれが好きでの……余りたべて連れあいの筑阿弥どのに穀つぶしよと、いたく怒られたことがある」「ホ、ホ、ホ、とろろ汁のことでございますか。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ではきょうは、美味いとろろ汁が喰えるというものだな」「兵庫様も好きなら、またいくらでも掘って来るが」「はははは。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あつらえたとろろ汁、まにあわず、下のプロペラ船が、「出るようっ」と、呼んでいる。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "干鮎の煮びたし、とろろ汁、わらび、しいたけ。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
