        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "顔を見知っているというわけでもないのに、それでも強く、とむねを突かれた。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどそのとき――お寺の、大きな塔の上で、とけいが、五つうちましたが――カイは、ふと、「あッ、なにかちくりとむねにささったよ。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と亀田先生がいふと、良寛さんはとむねをつかれたやうに、はつとして、そばにおいてあつた徳利を掴むや、さあつと麓の方へ走り出した。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　海蔵さんは、とむねをつかれたような気がしました。",
              "citation": {
                "source": "牛をつないだ椿の木",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「…………」　無言でそういう様子を見詰め、太郎左衛門はとむねをついた。",
              "citation": {
                "source": "あさひの鎧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えて見れば、私は、彼の行方が知れなくなった時、あの縁側に佇み、青葉をつけ始めた樹木を眺めながら「さては」ととむねをつかれた時、やはり泣かなかった。",
              "citation": {
                "source": "文字のある紙片",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハハ」と語る処へ突然表より大原の駆け込み来るにお登和嬢ハッと思いてとむねを衝けり、何事が起りしぞ。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたしがゐるのに、何が不足なんだとむねを叩いてみせた。",
              "citation": {
                "source": "神のない子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、とむねを衝たれて、振りかえると、後になった杉蔵も、いつのまにどこから持ち出したか、同様に素槍を持って、伊織と権之助の背後を脅かしているのだった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ごとだ」「ただ今、異な女性が、折入ってお目にかかりたいと、訪ねておいでなされましたが」「女が」　高氏は、とむねをつかれた。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、仲時の話に高氏はとむねをつかれて、「……では先ごろ、小松谷のおやしきを頼って行った母子の者が、そのままご邸内で、お世話になっているというのですか」　と、意外そうに反問した。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにか、とむねを突かれたふうでもある。",
              "citation": {
                "source": "私本太平記",
                "author": "世の辻の帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "と人々はとむねをつかれた。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤鶴もこれにはとむねをつかれたらしい。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云う母の声に私はとむねを突かれた。",
              "citation": {
                "source": "前途なお",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
