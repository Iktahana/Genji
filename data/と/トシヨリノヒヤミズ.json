        "examples": {
          "standard": [
            {
              "text": "彼は年寄りの冷や水で、大怪我をしてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "年寄りの冷や水で、周囲に迷惑をかけてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その年配者の言動は、まさに年寄りの冷や水だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "年寄りの冷や水も夏は涼しい。",
              "citation": {
                "source": "涼味数題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "年寄りの冷や水はどこにでもある。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の年寄りの冷や水は、いつも、君の顔の中に点滅する「ともすれば涙ぐもうとする、ひ弱い、良家の子供」の、幸せな将来を祈っていたのだ。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それこそ年寄りの冷や水といわないばかりに。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
