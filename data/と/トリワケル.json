        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "収穫したばかりのリンゴを、近所の人たちに配るためにいくつかずつ取り分ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "母親はケーキを公平に取り分けるために、ものさしを使って慎重にカットした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "利益を取り分ける段階になって、共同経営者たちの間で醜い争いが起きた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "主婦は、それを他の小皿へ取り分けるために部屋を出て行った。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょいと見る眼遣いの時に、眼の球が同じ横に往きながらも、松五郎の方を見る時は上の方へ往くが、僕の方を見る時は、下眼で、何んだか軽蔑して見るような眼つきだ、鰌の骨抜を皿へとりわけるにも、僕の方には玉子の掛らない処を探して、松五郎の方へばかり沢山玉子の掛った処が往くと、一々気になって来ます。",
              "citation": {
                "source": "霧陰伊香保湯煙",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "りよは、弁当の食べさしを腰掛に置いて、リュックから商売物の茶袋を引き出して、鼻紙に少し取りわけると、「これ、やかんに入れてかまひませんか？",
              "citation": {
                "source": "下町",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンコウの身のうまいところと、臓物のうまいところだけ、まず取りわける。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理は普通、大鉢か大皿に入れて出し、各自の皿にとり分ける。",
              "citation": {
                "source": "捨てる文化",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
