        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヴェルディはイタリアからパリへ出て来て、ここで椿姫の芝居を見てから、早速このトラビアタを作曲したんだそうですよ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台のトラビアタは今は高潮に達していた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "モスク※へ着いて二年目、と云っても五六ヵ月経ったばかりの或る夜、私は連れの友達とオペラ劇場へ、ラ・トラビアタをききに行った。",
              "citation": {
                "source": "時計",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エキスペリメンタリヌイ〔劇場名〕で、トラビアタ〔歌劇「椿姫」〕をきく。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "チョコレート二十、ドロップ十個を嚥下し、けろりとしてトラビヤタの鼻唄をはじめた。",
              "citation": {
                "source": "ろまん燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくはね、カルメンよりトラビヤタの方がすきだよ」とかれがいった。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてトラビヤタをかけてひとりでなにもかも知っているような顔をして首をふったり感心した表情をしたりした。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜この劇場にトラビヤタを見物した同一劇場とは思えないように変っている。",
              "citation": {
                "source": "アーニイ・パイルの前に立ちて",
                "author": "小林一三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
