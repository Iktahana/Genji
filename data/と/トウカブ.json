          "literary": [
            {
              "text": "東株ビルデングの石造の大建築が、人物をザンバのように呑みこんでいた。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "東株百五十円だそうだ。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘗ての『朝日新聞』のニュース（東株改組案）による株式市場の混乱は立会い停止にまで導いたけれども、併しその影響の仕方の社会的意義から云えば、該パンフレットの方が遙かに深刻だったと云わなければならぬだろう。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶々『朝日新聞』記者による暴露記事のヒットとして、東株機構改革大蔵省案なるものが物議をかもした。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "一例は『朝日新聞』経済記者のスクープによる東株暴落事件である。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
