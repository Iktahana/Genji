        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今さら後悔した所で、失われた時間は二度と戻ってはこない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "どんなに高い時計を買った所で、一日の時間は誰にとっても24時間だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「彼に謝った所で、許してくれるとは到底思えないよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
