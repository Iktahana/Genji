        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "地所七十坪ほど家屋｜付壱万五千円の由坂地なれば庭｜平ならぬ処自然の趣面白く垣の外すぐに豊川稲荷の森に御座候間隠居所妾宅にはまづ適当と存ぜられ候。",
              "citation": {
                "source": "雨瀟瀟",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生の講演が済んだ後、校長さんが、先生に何にか御礼の品物でも上げ度いがと云われるので、先生に御話した処自分は何にも礼を貰わないでも宜しい。",
              "citation": {
                "source": "日本その日その日",
                "author": "序――モース先生",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘次もそれを知らないのではないが、今の處自分には其の餘裕がないのでおつぎがさういふ度に彼の心は堪へず苦しむので態と邪慳にいつて畢ふのであつた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "實際の處自分の心は弱いのである。",
              "citation": {
                "source": "教師",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "雜誌の立つ處自ら現時の諸文學的流派の外にあらざる可らず。",
              "citation": {
                "source": "無題",
                "author": "月刊文藝雜誌　樹木と果實　初號三月一日發行",
                "note": "青空文庫"
              }
            },
            {
              "text": "急ぎ起きて『あかでしも朝寝しつ』と言ひ／＼、衣整なつて『おん口占に酬いまつらむ、笑ひなしたまひそ』とて、『良夜更易盡、朝暾已上※、願如梁上燕、棲處自成雙。",
              "citation": {
                "source": "『聊斎志異』より",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
