        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "このシステムは、複数のデバイスの動作を中央で統括している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "支店の営業活動は、本社のマーケティング部が統括している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "国家の安全保障を統括する機関が、新たな脅威に対応するため強化された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
