        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "わたしの堕ちた地獄は等活地獄。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私服正服の警官四十数名監視、反小原派の帝大教授、その夫人、竝に父兄等活躍す。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、滑稽なことに、この一等活々したエピソードの場面は、実は「フットボーリスト」全三幕を通じて最もバレーらしくない部分なのだ。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
