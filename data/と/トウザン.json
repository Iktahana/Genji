  {
    "uuid": "9b7e88e0-e362-50a4-81ac-ae8103292539",
    "entry": "当山",
    "reading": {
      "primary": "とうざん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "this mountain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "当山は、古くから地域の人々に信仰されてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "当山では、毎年恒例の祭りが盛大に行われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "当山の山頂からは、絶景が広がり、多くの登山客を魅了している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "門の柱に、毎月十五十六日当山説教と貼紙した、傍に、東京……中学校水泳部合宿所とまた記してある。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（――この、提灯が出ないと、ご迷惑でも話が済まない――）　信仰に頒布する、当山、本尊のお札を捧げた三宝を傍に、硯箱を控えて、硯の朱の方に筆を染めつつ、お米は提灯に瞳を凝らして、眉を描くように染めている。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……納所どころか、当山の大和尚。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山では住持のわしに言わずに人は留めぬ。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしが知らぬから、そのものは当山にいぬ。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山は勅願の寺院で、三門には勅額をかけ、七重の塔には宸翰金字の経文が蔵めてある。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山の開祖｜伝教大師の遺骨を納めてあるという浄土院へゆく路と四明ヶ嶽へ行く路との分れ目の所に一軒の茶店のあるのが眼についた。",
              "citation": {
                "source": "青年僧と叡山の老爺",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "壱、参、五、七、四カ日に当山。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏道修行を思いたち、かく推参つかまつったが、うわさによれば当山は求道熱心の者を喜んでお導きくださるとのお話じゃ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山は悪魔退散邪法｜調伏の修法をつかさどる大道場のはずゆえ、さだめしご坊たちもその道のこと詳しゅうご存じであろうが、ただいま江戸にて丑の時参りに使われる場所は、どことどこでござる」「なるほど、そのことでござりまするか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝元荒す鼠賊風情を要らぬ匿い立て致さば、当山御｜貫主に対しても申し訳なかろうぞ」「黙らっしゃい。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "御身にお直参の格式がござるならば、当山当院には旗本風情に指一本触れさせぬ将軍家｜御允許の寺格がござる。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「和尚様、五百両と申しましたところで、当山におかせられましては何のお役にも立ちますまいが、私にとりましては聊か身分に過ぎた寄進かと存じまする。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "是より三日大坂ニ下り、四日に蒸気船ニ両人共ニのり込ミ、長崎ニ九日ニ来り十日ニ鹿児島ニ至り、此時京留居吉井幸助もどふ／＼ニて、船中ものがたりもありしより、又温泉ニともにあそバんとて、吉井がさそいにて又｜両りづれにて霧島山の方へ行道にて日当山の温泉ニ止マリ、又しおひたしと云温泉に行。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十二月四日　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺の僧｜当山のなど云ひ出づれ秋風のごと住み給へかし　姥捨の長楽寺での作。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山もおいおいとはつこうなりまして何よりで、もうこれでケーブルがかかりますと申し分御座りまへん。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、新門跡夫人の父君、九条｜道孝公が、家扶をつれて急いで東京から来着し、主な役僧一同へ、――かねて双方の間に約束いたしおきたることは、もし当山に万一の事ありし時は、速かに私が罷り出て、精々御助力いたすべく――　これはみな、前記山中氏の著書のなかにあるから、信頼してよいものと思う。",
              "citation": {
                "source": "九条武子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山の許可を受けて、都合によりここより一切登山を止めておりまする。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははあ――」　八郎太は、さも感心したようにいったが「当山の許しを得たと仰しゃれば、是非もござらぬが――念のために、許可状を拝見致しとうござる」　後方にいた侍が、険しい眼をして、八郎太の方へ向き直った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人が「あの坊主は、当山でえらいのか？",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山石碑の立はじまり』『左手うへの鳥居三本は出羽国米沢上杉公。",
              "citation": {
                "source": "仏法僧鳥",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上手に見えてあるのは当山の蛇柳です』『右手鳥居なかの一本は奥州仙台｜伊達政宗公。",
              "citation": {
                "source": "仏法僧鳥",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山石碑の立はじまり』『左手うえの鳥居三本は出羽国米沢上杉公。",
              "citation": {
                "source": "仏法僧鳥",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上手に見えてあるのは当山の蛇柳です』『右手鳥居なかの一本は奥州仙台伊達政宗公。",
              "citation": {
                "source": "仏法僧鳥",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その西原君が当郡の視学として転任されたのは、多年埋没して世に忘れられていた当山の大遺蹟が、いよいよ世に出るべき機運を造ったものだ。",
              "citation": {
                "source": "周防石城山神籠石探検記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "当山にはかねて山姥の穴として知られた四つの穴がある。",
              "citation": {
                "source": "周防石城山神籠石探検記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそも当山における神籠石の遺蹟は、古人は既に熟知していたものと見えて、元禄十年の撰にかかる石城神社の縁起には、明らかに、当山は高天に聳え諸方に秀でて、虚空に高し。",
              "citation": {
                "source": "周防石城山神籠石探検記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "目をかけていたゞきとうざんす」　長範はゴリラの熊蔵と将棋をさしていた。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
