[
  {
    "uuid": "21c825a7-5838-5975-af70-2344419e48bc",
    "entry": "頓と",
    "reading": {
      "primary": "とんと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
