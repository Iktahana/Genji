  {
    "uuid": "7aebec15-93a3-51de-b909-42288d0cd1d8",
    "entry": "とんと",
    "reading": {
      "primary": "とんと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
