      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ものに屈託するなどいうことはとんと知らなかった糟谷も、にわかに悔恨の念禁じがたく、しばしば寝られない夜もあった。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩は茲で、アラヽギ諸同人に忠告を試みたい、我諸同人の歌は、概して形式を重じ過ぎた粉飾の過ぎた弊が多いやうであるから、石川君の歌などの、とんと形式に拘泥しない、粉飾の少しもないやうな歌風を見て、自己省察の料に供すべきである。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "水にぬれた紙のごとく、とんと手ごたえがなく、頸も手も腰にも足にも、いささかだも力というものはない。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とんと落ちなば名は立たん、どこの女郎衆の下紐を結ぶの神の下心」によって女郎は心中立をしたのである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十になってからになさい」　けれども、そう言われても私は、きょとんとしていました。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「行くところまで行くか」「キザですわ」「この野郎」　上原さんは私の肩をとんとこぶしで叩いて、また大きいくしゃみをなさった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸顔で色が白く、まつげの長い二重瞼の大きい眼の眼尻が少しさがって、そうしていつもその眼を驚いたみたいにまんまるくって、どんな話にでも首をつっ込んで来て、たちまち、けたたましく笑い、からだを前こごみにして、おなかをとんとん叩きながら笑い咽んでいるのだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどい猫脊で、とんとせむし、――君、ちよつと眼をつぶつてそんなふうの男を想像してごらん。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをなんだい、麹町にも此の頃はとんとごぶさた、ましてや私の存在なんて、どだい、もう、忘れているんですよ。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "麹町にも、とんとごぶさただそうだし、私のところへなんか、年始状だって寄こしゃしない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんとん、博士の脊中を軽く叩いたひとがございます。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こう言いながら、火鉢を少し持ち上げて、畳を火鉢の尻で二、三度とんとんと衝いた。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご亭主は、きょとんとした顔になって、「へえ？",
              "citation": {
                "source": "ヴィヨンの妻",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と相州さまは、きよとんとして居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と低いお声で言つてお首を傾け、きよとんとしていらつしやるのでした。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」けれどもお顔には、いささかも動揺の影なく、澱みなく言ひ終つて、やつぱりきよとんとして居られました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょとんと眼をひらいて、「あ、もう、そんな時間になったの？",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と勝太郎はきょとんとしている。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんと肩をたたかれた。",
              "citation": {
                "source": "新樹の言葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶四郎君は起き上り、チョッと言って片足で床板をとんと踏む。",
              "citation": {
                "source": "雀",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と尋ねてみた事さえあったが、その時、周さんは、きょとんとした顔をして、「いや、あなたの言葉の抑揚は、強くてたいへんわかり易い。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はきょとんとして、「はあ？",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんと私の肩を叩いたものがある。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜の粕漬でも食べさせたいが、どうしたわけだか、このごろ酒粕もとんと無いてば。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とＮ君は、きよとんとして、「しからば、さらにお尋ねいたしますが、このテイザン和尚は、」テイザン和尚と言つた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前のとし、私の家の八十八歳の祖母も、とんと経験が無い、と言つてゐるほどの大洪水がこの金木町を襲つたのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓からとびだした醤は、そのとき運悪く柊の木の枝にひっかかり、顔も手足も血だらけにして歯をくいしばっていたが、金博士の声を耳にしてびっくり仰天、狼狽する途端に、すとーんと地面へ落ちて、いやというほど腰をうちつけた。",
              "citation": {
                "source": "戦時旅行鞄",
                "author": "――金博士シリーズ・６――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、一旦とまっていた戦車の天井の、とーん、とーんという音が、また聞えだした。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "背後の兵舎のほうから、誰やら金槌で釘を打つ音が、幽かに、トカトントンと聞えました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたし、あなたに、誤解されてやしないかと思って、あなたに一こと言いたくって、それできょうね、思い切って」　その時、実際ちかくの小屋から、トカトントンという釘打つ音が聞えたのです。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
