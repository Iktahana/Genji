        "examples": {
          "standard": [
            {
              "text": "彼は斗酒なお辞せずの酒豪で、飲み会では常に活躍している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その人物は斗酒なお辞せず、毎晩大量の日本酒を飲み干す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祖父は斗酒なお辞せずで、家族も彼の酒量には驚いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "十年前までの満鉄社員の中には、斗酒なお辞せず口を開けば大陸政策を論ずる人が多かったそうである。",
              "citation": {
                "source": "満洲通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる斗酒なお辞せずという類の酒豪の逸話は、次第に昔話の領域に入って行こうとしている。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
