[
  {
    "uuid": "7b406800-ea3c-5ff3-953d-d52cfa3d76e3",
    "entry": "督軍",
    "reading": {
      "primary": "とくぐん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
