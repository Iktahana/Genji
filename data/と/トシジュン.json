        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一、詩篇の排列順序は必ずしも正確な創作年順を追つては居ない。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "年順でいうと田原屋の方が四、五年先輩で料理がうまいというのが評判だ。",
              "citation": {
                "source": "早稲田神楽坂",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人の画家の中でも、小竹が一番｜年長で、その次が岡、牧野の年順らしかった。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "色彩も美しい五ヵ年計画の絵解きから、十月革命の相当のむずかしい歴史に至るまで小学校の学年順に並べた棚が出来ている。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "附録二　著者年譜（但し逆編年順）大正十四年二月、「泣菫詩集」を上梓す。",
              "citation": {
                "source": "人及び芸術家としての薄田泣菫氏",
                "author": "薄田泣菫氏及び同令夫人に献ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車に乗ると文一君を筆頭に年順に坐ったのは長幼の序を守ったものと認めた。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間は大抵年順に死んで行く。",
              "citation": {
                "source": "ガラマサどん",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "本句集は彼の最初期から晩年までの俳句を収集し、調査できた範囲で制作年順に並べたものである。",
              "citation": {
                "source": "藤野古白句集",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、お年順だし、兄の武大や嫂が、始終ごやっかいになってきたお婆さんだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　年齢からいえば、関羽がいちばん年上であり、次が劉備、その次が張飛という順になるのであるが、義約のうえの義兄弟だから年順をふむ必要はないとあって、「長兄には、どうか、あなたがなって下さい。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「年順でいえば、しかも長男ではないか」「が、仔細なございまして、庶子ともせず、家にも入れておりませぬ」「どこにおいてあるのだ、その隠し子は」　高氏は冷たい肌を這う油のような汗を覚えた。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻からぞろぞろとつながって兵助の屋敷へ来ると、彼らは、里親の所へでも来たように、勝手に風呂へはいったり、台所を手伝ったり、座敷をこしらえたりして、さて、それからお客様になって、奥の広間へ年順にずらりと畏るのである。",
              "citation": {
                "source": "銀河まつり",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ご姉妹の年順に、まだ乳呑児のうちに、左の指の爪へ、漆のごとく、お鉄漿の入墨をなされました」「爪へ、入墨をしたとか。",
              "citation": {
                "source": "牢獄の花嫁",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
