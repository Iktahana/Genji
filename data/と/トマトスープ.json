        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "赤楽の茶わんもトマトスープでも入れられては困るであろう。",
              "citation": {
                "source": "青磁のモンタージュ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "負けてるのですぐ引返して、赤門の不二アイスでトマトスープとハンバーク、オムレツ等食ひ、又盲役者林長之助を宝生座で見物し、広小路へ出て買もの、テク／＼と歩いて朝日ビル、暑い／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大黒と上山でオリムピックへ寄り、トマトスープと、チャプスイを食ふ、トマトスープはいゝが、チャプスイはゼロ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからあっちへ行き、こっちへ行きフジアイスで、クリームトマトスープとチキンコロッケを食って、医者へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日明後日うまいもの食へまいからと、トマトスープ、白魚フライ、ミートボールに苺食って東京駅へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューグランドへ寄り、トマトスープと犢のカツレツ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューグランドへ行き、トマトスープ、コゝット入の鶏。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "森岩雄と会ひ、ニューグランドで食事、クリームトマトスープとハムエグスに、オックスタング。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝食、ハムエグス、トースト、トマトスープ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
