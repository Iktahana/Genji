        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「これって、ヒットしてないのかよ」　山崎のでかい躰をクッションがわりにして、ポテトチップスをつまみながら、陳がいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小さなちゃぶ台には、コーラやオレンジジュースの缶、ポテトチップスやポップコーンの袋がのっていて、あちこちから頻繁に手が伸ばされている。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　靜子は妙にトチッて、其儘口を噤んで了つた。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "第３図　1493年版アンチ・クリストの世の図竜の起原と発達　一八七六年版ゴルトチッヘルの『希伯拉鬼神誌』に、『聖書』にいわゆる竜は雲雨暴風を蛇とし、畏敬せしより起ると解いた。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや」と云ったが細川の藩士、これには少なからずトチッたものである。",
              "citation": {
                "source": "善悪両面鼠小僧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ご洗足のお水、取りましょうで」「何さ、裏に清水がある」「へい」とトチッてまたお辞儀。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "役者の舞台でトチッたのも亦称揚すべし。",
              "citation": {
                "source": "偏奇館漫録",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "飲みすぎて舞台をトチッたり、喧嘩をして相手に怪我をさせたり、遊びに行って出さなくってもいゝボロを出したり、そんなことで始終かれは由良を失敗った。",
              "citation": {
                "source": "春泥",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かたわらにはポテトチップスがひとつかみ添えてあった。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポテトチップスはどちらにも良く調和した。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "食べるものはポテトチップスをひとつかみ添えた胡瓜のサンドイッチと、かたゆで卵だけだ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
