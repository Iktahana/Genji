        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其ノ利己的欲望中ニ含有サルル斯ル幾多ノ動機ハ、其ノ事業ヲ發展セシメタル國家的認識ト、國家ニ移レル事業ヲ其人ニ經營セシムル手腕發揮ノ自己滿足トニヨリテ、實ニ爭ヒテ私人生産業限度ヲ超越セントスル奮鬪心ヲ刺※シ鞭撻スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ル民族ガ其ノ國家組織ヲ失フ所以ハ外部的壓迫ト内部的廢頽トニヨリテ自決スル力ヲ缺ケルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ノ國家觀ハ國家ハ有機的不可分ナル一大家族ナリト云フ近代ノ社會有機體説ヲ、深遠博大ナル哲學的思索ト宗教的信仰トニヨリ發現セシメタル古來一貫ノ信念ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍國主義ナルカ否カハ傭兵ト徴兵トニヨリテ決セラルル者ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上ノ如クナルヲ以テ、芋ヲ焦焼スルコトナク（僕はいささか焦げた方が好きです）、蒸焼シ得ルノミナラズ蒸焼ヲ二回ニ順次行ウヲ以テ塩ノ浸滲ハ良好ニ行ワレ（とてもタマランです）、更ニ蓋ニ保温室ヲ設クルコトニヨリ之ヲ焼冷シトナスコトナカラシメ、常ニ保温シ得ル等ノ効果ヲ有ス。",
              "citation": {
                "source": "発明小僧",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
