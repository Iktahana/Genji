[
  {
    "uuid": "2a45dad9-ccfc-54fa-8c0f-47aa546b91b5",
    "entry": "と或る",
    "reading": {
      "primary": "とある",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "連体詞"
