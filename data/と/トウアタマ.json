          "literary": [
            {
              "text": "雲間からヌッと顔を出した弦月の光に、高く盛りあがった濤頭が、夜目にも白々と映った。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "刻々と揉む歴史の濤頭は荒くて、ふるい女らしさの小舟はすでに難破していると思う。",
              "citation": {
                "source": "新しい船出",
                "author": "――女らしさの昨日、今日、明日――",
                "note": "青空文庫"
              }
