  {
    "uuid": "d50920b3-8eda-559b-b983-02d39c7b39b1",
    "entry": "トナリ",
    "reading": {
      "primary": "となり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雲ハ経紙ノ紺ニ暮レ、　　　　　樹ハカグロナル山山ニ、梢螺鈿ノサマナシテ、　　　　　コトトフコロトナリニケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祭日〔二〕宮沢賢治アナロナビクナビ睡たく桐咲きて峡に瘧のやまひつたはるナビクナビアリナリ赤き幡もちて草の峠を越ゆる母たちナリトナリアナロ御堂のうすあかり毘沙門像に味噌たてまつるアナロナビクナビ踏まるゝ天の邪鬼四方につゝどり鳴きどよむなり",
              "citation": {
                "source": "祭日〔二〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラのオヤヂのコヾト、トナリのオカミのコヾト、それはすべて子に対して妻への、夫への不平であり、要望である（彼等には夫も妻もゐないのだ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ全然正反對ナル發達ハ社會生活ノ凡テニ於ケル分科的發達トナリテ近代史ニ連ナリ、彼ニ於テ婦人參政運動トナレル者我ニ於テ良妻賢母主義トナレリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "壹千萬圓以上ノ生産業ガ國營タルベキ爲ニ起ル疑惑ハ事業家ノ奮鬪心ヲ挫折セシムベシト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義ノ原理ガ實行時代ニ入レル今日トナリテハ其レニ附帶セル空想的糟粕ハ一切棄却スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シナガラ大多數婦人ノ使命ハ國民ノ母タルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ母又ハ女子ニ負荷セシメザル所以ハ、愛情アリト雖モ扶養能力ナキガ故ニ、結局其ノ兄弟又ハ娘ノ夫ノ負擔トナリテ立法ノ精神ヲ殺ス者トナルヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "人格權ノ歴史的覺醒タル民主々義ガ哲學的根據ヲ缺如シタル民本主義トナリテ輸入サレツツアル「デモクラシー」。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語ハ直チニ思想トナリ思想ハ直チニ支配トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ不幸ナル幸ハ中學教育ニ英語ヲ課シ來レル慣習ノ爲ニ、其ノ程度ノ教育者モ被教育者モ、何等カノ言語ヲ習得スベキコトヲ必須的ニ確信セルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "中食ノ學校支辨ノ理由ハ第一ニ登校兒童ノタメニ毎朝母ヲ勞苦セシメザルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此ノ立法ガ男子ノ道念ニヨリテ行ハレザルナラバ忌ムベキ婦人勞働トナリ婦人參政權運動トナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "既ニ王朝貴族ニ朝鮮人ノ血液ガ多量ナリト云フコトハ、實ニ其ノ貴族ノ血液ガ皇室ニ入リ得ベキ特權階級タリシ點ニ於テ、日本ノ元首其者ガ朝鮮人ト沒交渉ニ非ズト云フコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ノ亡國的腐敗ハ悉ク事大的國是トナリテ現ハレ、日清戰爭ニ於テハ清國ニ從ヒ、日露戰爭ニ於テハ露西亞ヲ迎ヘ、聊カモ英國ト自耳義ノ結托ニ似タル者ナカリシハ開戰原因ヲ顧レバ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ノ世界的天職ハ當然ニ實力援助トナリテ現ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ日本ノ實力援助ニツキテ大方針トスベキハ海上ニ於テノミ彼ノ獨立ヲ援護スルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "英國ハ英獨協商ノ相手方ヲ日本ニ代ヘタルガ故ニ、今ヤ該協商ノ目的タリシ中部支那以南ノ領有ヲ現實ナラシメントシテ茲ニ青海四川甘肅ヲ包有セル西藏濁立ノ要求トナリテ現レタルナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度文明ノ西シタル小乘的思想ガ西洋ノ宗教哲學トナリ、印度其者ニ跡ヲ絶チ、經過シタル支那亦只形骸ヲ存シテ獨リ東海ノ粟島ニ大乘的寳藏ヲ密封シタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノトキ、私モオツウヤヲシテイタノデスガ、ナニゲナク君チャンタチノネテイルトナリノヘヤニ入ッテイッタトキ、私ハットシテ立チドマッテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "一身軽舟トナリ、落日西山ノ側――か、到頭私は居酒屋の親爺に信用を搏してしまつたよ、歩きながらその弁舌を披露しませう。",
              "citation": {
                "source": "ゾイラス",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（緑林黒白ニ曰ク）大盗暁星五郎、ソノ本名白須庄左衛門、西国某侯遺臣ニシテ、幕府有司ニ含ム所アリ、主トシテ大名旗本ヲ襲フ、島原ノ遊女花扇、是ト馴染ンデ党中トナリ、変幻出没ヲ同ジウス、星五郎強奪度無シト雖モ、ヨク散ジテ窮民ヲ賑ス、云々。",
              "citation": {
                "source": "首頂戴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古人ノ語ニ、一身ヲ自由ニシテ自ラ守ルハ、万人ニ具ハリタル天性ニシテ、人情ニ近ケレバ、家財富貴ヲ保ツヨリモ重キコトナリト。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "又上タル者ヨリ下ヘ許シ、コノ事ヲ為シテ差構ナシト云フコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "又好悪ノ出来ルト云フコトナリ、危キ事ヲモ犯シテ為サネバナラヌ、心ニ思ハヌ事ヲモ枉ゲテ行ハネバナラヌナドト、心苦シキコトノナキ趣意ナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、政事ノ自由ト云ヘバ、其国ノ住人ヘ、天道自然ノ通義ヲ行ハシメテ、邪魔ヲセヌコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "開版ノ自由ト云ヘバ、何等ノ書ニテモ、刊行勝手次第ニテ、書中ノ事柄ヲ咎メザルコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗旨ノ自由トハ、何宗ニテモ、人々ノ信仰スル所ノ宗旨ニ帰依セシムルコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
