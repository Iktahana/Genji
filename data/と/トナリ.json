[
  {
    "uuid": "f1f8917d-e7b6-543e-8a60-ca58721d1da1",
    "entry": "隣",
    "reading": {
      "primary": "となり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
