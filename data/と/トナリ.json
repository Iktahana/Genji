        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "引っ越してきた隣は、とても親切な高齢夫婦だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "隣から騒音苦情が来たため、注意するよう家族に呼びかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "子どもの友達は隣に住んでいるため、毎日のように遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
