        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソロモンはＳＦドラマの「スタートレック」をテレビで見ている娘に、宇宙船エンタープライズに積んであるコンピューターの名前をたずねた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらに五号には、パロアルトのリチェン・ワンによるパロアルト・タイニーベーシックが掲載され、翌月号にはこれを使ってワンの書いた、宇宙戦争ゲーム、スタートレックの小型版のタイニートレックが掲載された。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パロアルト版のタイニーベーシックと宇宙ゲームのタイニートレックの値段は、ともに二ドルだった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パロアルト版を書いたリチェン・ワンのもう一つの傑作、タイニートレックをそのまま走らせて遊びたいという切実な動機もあり、パロアルト版や東大版に文法は合わせたが、中身は一から書き起こすことになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "△木村荘八氏――『浅草元日』『幽霊せり出し』等の所謂氏の芝居絵である、幽霊せり出しはテーマは賛成だが、氏にして良くロートレックやドガのやうに、この種の社会を庶民的テーマとして引き下げる力があれば面白いが、芝居道の肯定者らしい態度が妙に美しいものより描けてゐない。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオトレックが直接浮世絵の影響を受けた、それとはまた異つた意味で、少くとも、あなたは東洋芸術のわかる人だ。",
              "citation": {
                "source": "訳者より著者へ",
                "author": "――「葡萄畑の葡萄作り」――序",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥウルウズ・ロオトレックの有名な挿絵二十二葉によつて飾られてゐる。",
              "citation": {
                "source": "「博物誌」の序に代へて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオトレックがやつたと同じやうに動物園にも度々通つたらしい。",
              "citation": {
                "source": "「博物誌」の序に代へて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドガ及ツールーヅ・ロートレックが当時自然主義の文学の感化を受けその画題を史乗の人物神仙に求めず、女工｜軽業師洗濯女等専ら下賤なる巴里市井の生活に求めんと力めつつあるの時、北斎漫画は彼らに対して更に一段の気勢を添へしめたり。",
              "citation": {
                "source": "江戸芸術論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "エミール・ベルナールとロートレックとベルト・モリソウ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックは貴族的な黒の礼服を着た小男で、それほどの年でもないのに、一見五十過ぎに見える。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックが、ステッキで、中の絵の一つを指している。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックさんと、ベルナールさんと、あの奥さんは何とか言ったっけ――タン　モリソウの奥さんだよ、ベルト・モリソウ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "微笑しつつ）なんですかな、ロートレックさん？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タン　（ロートレックの言葉も、ベルナールの言葉も深くは理解できないで）え？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（所内を見わたして、ロートレック、ベルナール、ベルト・モリソウ、タンギイなどを目に入れるが、別に目礼もしないで、売台の所のおかみを見て、初めて微笑）やあ今日は、クサンチッペ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アルルかニースあたりに行ったらって、ロートレックさんも、こないだ言ってらしたじゃありませんか？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィン　ロートレック……あれは良い男だ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にロートレックさんもベルナールさんもモリソウさんも、あなたの絵を認めています。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、ロートレックやベルナールが、そう言ってくれるのは、友達だから、同情すると言うか、憐んで褒めてくれてるのかも知れない。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる政界に登場し全生涯におけるもっとも広範で深遠で有効な一撃を示したのは1528年にナポリがロートレック傘下のフランス軍によって包囲されたときに皇帝軍の救助に決定的な役割を果たしたことであった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この精力的な指導者の死はフランス軍を指揮していて北イタリアに近づいていたロートレックの最初の成功と大きく関係していたのだろう。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックのフランス軍はロレーヌとライン地方からの傭兵を加え彼を解放者とみなしたイタリア人で常に強化されロンバルディアの諸都市を再征服し教皇が解放されてボローニャに到達して中部の町オルヴィエトに移されたことを聞いた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は強力だった軍隊の残党もナポリ近くのトロイアで兵力が約２万8000人のロートレックによって包囲された。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸なことにロートレックはすぐに攻撃をしなかったのでオランジュの皇太子は夜中に脱出しナポリの防衛を強化した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックの軍隊がナポリの近くに到達したころにカール５世が支配していた領土の全ての場所すなわち北海沿岸の低地帯、カタロニア地方および地中海沿岸地方でカール５世への戦争が行われていたことを思い出す必要がある。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロートレックは７月５日にはナポリがこれより長いあいだ抵抗できないだろうと信じていたがペストは沼地に密集したフランス軍の野営地で急速な破壊行為を行った。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴォードモン、ナヴァロ、およびロートレック自身が病気になり死亡した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと一命をとりとめてほっとした頃、かつて私のゴッホやロートレックの特製本を出してくれて、それがやみつきで限定本だけをやっている今野書房の今野健二さんが見舞にきてくれた。",
              "citation": {
                "source": "二笑亭綺譚",
                "author": "あとがき",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
