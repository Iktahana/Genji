        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "トロトロトロと云うような鳴き声も常に聞き慣れていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロトロトロトロと燃えつづけた。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロトロトロトロと脳の中で、何かがとろけるような気持ちがした。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トロトロトロトロと妾の眼が、その男の顔へ笑いかけたら、どうだろうねえと云うことさ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからおせめなさいまし」「ははあ」というと天草時行、トロトロトロトロと両眼を、硫黄火のように輝かせた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチ、カメコオバサンモ　トロトロト　マブタガ　オモクナリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
