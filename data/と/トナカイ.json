[
  {
    "uuid": "75c5820a-56e9-5a6a-8a70-0facb31b9f49",
    "entry": "馴鹿",
    "reading": {
      "primary": "となかい",
      "alternatives": [
        "トナカイ"
      ],
      "is_heteronym": false
