  {
    "uuid": "e0024eab-91b5-5956-b5c9-d5c492ce5e95",
    "entry": "涛音",
    "reading": {
      "primary": "とうおん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "幾人の人を癒やし、幾人の人を殺した此寢臺の上、親み慣れた藥の香を吸うて、濤音遠き枕に、夢むともなく夢むるのは十幾年の昔である。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾人の人を癒やし、幾人の人を殺した此寝台の上、親み慣れた薬の香を吸うて、濤音遠き枕に、夢むともなく夢むるのは十幾年の昔である。",
              "citation": {
                "source": "二筋の血",
                "author": "石川啄木",
