      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "as (for)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "親としては、子どもたちの安全と教育が最優先事項です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "日本としては、この国際問題に慎重に対応する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医者としては患者の健康回復に全力で取り組んでいます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてその気質としては、動物よりも植物を、夏よりも冬を愛し、――『鋼青』を『苹果』を、午前のみそれを愛したのです。",
              "citation": {
                "source": "宮沢賢治の詩",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、私としては、良心を澄ませる、即ち謙虚な気持を修熟させることが第一だと思ひ、従つて、当分発表するものは、旧作であるから、それがつまらないからといつて、如上の考へをも愚であるとされたくない。",
              "citation": {
                "source": "詩壇への抱負",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私としては、従来のものを一新しようといふ新短歌作者等が、どうしていつそ寛闊な様式――新体詩様式に到らないのか寧ろ不思議である。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて私としては、新体詩様式を確立することが、大切なやうに思はれる。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "純粋持続の、人に於ける心理的状態は、強ひて言へば、未来を思ふとしては神を、現在を思ふとしては自己を、過去を思ふとしては運命を信じてゐるのだ。",
              "citation": {
                "source": "詩と詩人",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "かう云つてしまふと話は簡単だが、当人としては随分無理もないことである。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、当人としては相手の個性を嫌つてゐるつもりはない、相手の話しぶりだの手ぶりだの、要するに相手の人間臭を嫌つてゐるつもりなのだが、そんならその話の特に個性的な部分だけでも聴くかといふと強ちさうでもない。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "講述する耕作法その物は、かいさ詰らぬものであるが、農学士は心理的には、甚だ発達してゐて、聴いてる方では、耕作法としては何が何やら分らぬ乍ら、なんだか好いことを教へて呉れつゝあるやうに思はれてならないといふ場合である。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒がられては、Ｂとしては冠履転倒も甚だしいものだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｂとしてはアテ外れだ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私としてはまだも少し突きたい欲望が残つてゐたわけなので、猶も勝負を続けたが彼等の勝手決めな観念がみす／＼自分に向つて放たれ、そして私以外の三人の間では立派に通用しつゝあるのをみると、イヤな気がして来たので、恰度十三回目が終ると、其処を出てしまつた。",
              "citation": {
                "source": "西部通信",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の彼は、日本をもはや『夢の国』としては見ていなかった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故に彼が、あの文壇の大家芥川龍之介君が、私の如き非才無名の一詩人に對して、特別の好意と友情とを――時としては過分の敬意さへも――寄せられたかといふことは、今にして始めて了解出來たのである。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が結婚致しましたのは、松江に来てからのことで、二十四の秋でございますから、当時としてはずいぶん遅い結婚でございました。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校のおつとめからお帰りになって、隣りのお部屋で、私たちの話を立聞きして、ふびんに思い、厳酷の父としては一世一代の狂言したのではなかろうか、と思うことも、ございますが、まさか、そんなこともないでしょうね。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "疑いだすと果しがないけれども、いったい、彼にはどのような音楽理論があるのか、ヴァイオリニストとしてどれくらいの腕前があるのか、作曲家としてはどんなものか、そんなことさえ私には一切わかって居らぬのだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "具体的なことがらについては、君と相談のうえできめるつもりであるが、僕のプランとしては、輸出むきの雑誌にしたい。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "実現不可能の理由としては、何があるか。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで近代の作品は、私には、歌はうとしてはゐないで、寧ろ歌ふには如何すべきかを言つてゐるやうに見える。",
              "citation": {
                "source": "生と歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "又一方、大衆としては、詩といふ型がハツキリしてゐない限り、詩に詩以外の物をも要求してかゝる場合があるのだし、無理からぬことでもある。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本武尊が古事記中に叫ばれた歌は、明かに一呼吸中に歌はれたものであつて、一呼吸中のものとしては実に絶品であるが、デヴヱロッピングではない。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃流行の、「文学と政治」のことに一寸言及するならば、文学の対象としては、一切物が対象となるわけだから、無論その中に政治も含まつてゐる。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論理想としては、その粧ひもあるよりはない方がよいのだが、六ヶ敷いことだ――（生れしながらの睡みに、そなたよ眠りてあれかし――ボドレル）彼の欠点　彼がヒュマニティから出発したことは明かだが、立派なヒュマニティは理論を欲するものであるのか、彼は非常に考へる習慣を持つた。",
              "citation": {
                "source": "高橋新吉論",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "証拠としては迷信の介在、恐怖あること等。",
              "citation": {
                "source": "地上組織",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなになんでも延長したり質の問題にして考へたりしてたら御飯も食ふ時間がなくなりますよ」「さうかしら……」「女としては物分りの好い方だし、昨日の昼迄ならさうだわねと位に言つて呉れたんだらうにな……」と彼はさう思つた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "片町に更紗染めるや春の風　町の片側に紺屋があって、店先の往来で現に更紗を染めているという句であるが、印象としては、既に染めた更紗を、乾燥のために往来へ張り出していると解すべきであろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分作者は、こうした動物の印象からして、その昔死別れた彼の幼ない可憐な妹（蕪村にそうした妹があったかどうか、実の伝記としては不明であるが）もしくは昔の小さな恋人を追懐して、思慕と恋愛との交錯した情緒を感じ、悲痛な咏嘆をしたのであろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕪村の詩としては閻王の口や牡丹を吐んとす　が最も有名であるけれども、単なる比喩以上に詩としての内容がなく、前掲の句の方が遥かに幽玄でまさっている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
