[
  {
    "uuid": "409694a5-92aa-52cb-a46f-1b14d1c72d26",
    "entry": "としては",
    "reading": {
      "primary": "としては",
      "alternatives": [
        "としちゃ",
        "としちゃあ"
      ],
      "is_heteronym": false
    },
    "grammar": {
