    },
    "definitions": [
      {
        "index": 1,
        "gloss": "handle",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鍋の取っ手が熱くなっているので布巾を使ってください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "引き出しの取っ手が緩んで、開けるたびにがたつく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "陶芸教室でマグカップの取っ手を成形するのに時間がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "とにかく、祖母は自分の家にとついでからの何十年の間にこの糸車の取っ手をおそらく何千万回あるいはおそらくは何億回か回したことであろう。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その先端の綿の繊維を少しばかり引き出してそれを糸車の紡錘の針の先端に巻きつけておいて、右手で車の取っ手を適当な速度で回すと、つむの針が急速度で回転して綿の繊維の束に撚りをかける。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大概車の取っ手を三回まわす間に左の手が延び切って数十センチメートルの糸が紡がれ、それを巻き取ってから、また同じ事を繰り返す。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "取っ手の一回転が「ビーン」で、それが三回繰り返された後に「ヤ」のところで糸が巻き取られるのである。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで取っ手を回すと同じリズムでキュル／＼／＼と一種特別な轢音を立てるのであった。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はわれわれ人間の頭上に恐ろしい大きな鋏を振り回している神様の残忍に痛快な心持ちを想像しながら勢いよく鋏の取っ手を動かして行った。",
              "citation": {
                "source": "芝刈り",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "取っ手を回して、ホームズは中へ入る。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "一望した景色のなかで動いているのはふたりだけで、一方は自転車にすっくと乗った優雅な女性、もう一方はその後ろで取っ手に身を屈め、その動きひとつひとつがこそこそとして妙に曰くありげな男。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の話では、取っ手に屈んでいたという。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "田舎モンだと思われるぞ」　慶一は、取っ手の下に派手なストライプが入った、じぶんのデニムのバッグを見おろした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "身の取り方はいろいろあるが、料理人の仕方は、あり合わせの庖丁や、わさびおろしの取っ手の先で起こしている。",
              "citation": {
                "source": "鮑の水貝",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "不在のときには、きわめて巧妙に、細枝でつくった紐でしっかりとドアの取っ手をしばりつけ、鎧戸には心張棒がかってあった。",
              "citation": {
                "source": "スリーピー・ホローの伝説",
                "author": "故ディードリッヒ・ニッカボッカーの遺稿より",
                "note": "青空文庫"
              }
            },
            {
              "text": "煤だらけの化け物が茶色の紙の帽子をかぶって、鞴のところでせっせと働いていたが、それもちょっと取っ手にもたれ、喘息病みの器械は長い溜め息をつく。",
              "citation": {
                "source": "駅馬車",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔１〕酪農場に牛痘が蔓延すると、しばしば牛乳手桶の取っ手を介して、乳搾りをしたことのない人たちにも感染する。",
              "citation": {
                "source": "イングランドの西部の諸州とくにグルスターシャーで見つかった病気で、牛痘の名で知られているウシ天然痘の原因および効果についての研究",
                "author": "AN INQUIRY INTO THE CAUSES AND EFFECTS OF THE VARIOLAE VACCINAE, A DISEASE DISCOVERED IN SOME OF THE WESTERN COUNTIES OF ENGLAND, PARTICULARLY GLOUCESTERSHIRE, AND KNOWN BY THE NAME OF THE COW POX.",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてハーフ・アンド・ハーフ、すなわちエールを半分とビールを半分、またはエールを半分とタペニー半分を１パイント、またはタンカード（取っ手、蓋つきのビール大ジョッキ）１杯を頼むのが習慣であった。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪い空気は幾分治まり、ウィレットは電灯の光を三途の川の取っ手に真っすぐ向けることができた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つは背の高い取っ手のないもので、ギリシャのレキュトス壺ないしは油壺(*17)に似ており、もう一つは片方に取っ手があり全体の釣り合いがファレロン壺に似ていた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルの上に小さな白い姿が転がっていて――裸にされ気を失った幼い男の子だった――その反対側には目つきの悪い悍ましい老女が、右手にグロテスクな柄のあるナイフを光らせ、左手には奇妙な彫金装飾で覆われ両側に繊細な取っ手がある不格好な青白い金属製の鉢を持っていた。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "数歩後ずさった私の目は足元のリング状の取っ手のついた落とし戸に吸い寄せられました。",
              "citation": {
                "source": "錬金術師",
                "author": "THE ALCHEMIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "中に米俵を敷いて、銅壺カンを半分に切って針金の取っ手をつけた火入れを左に置き、ボックスの戸をしめて釣っていると、氷の上とは思えないくらい暖かなものだ。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「取っ手をおしておくれ。",
              "citation": {
                "source": "赤ずきん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オオカミが取っ手をおしますと、戸がいきおいよくあきました。",
              "citation": {
                "source": "赤ずきん",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまたアラビアとアッシリアの王サナクリブがエジプトに大軍を行進させたときに戦闘の前の晩に「野生のマウスの大群が集まり矢や弓や盾の取っ手を食べ尽くし」たので翌日に大軍は逃げた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この扉の銅の取っ手をお回しになりますれば、ちょうど法廷の裁判長殿のうしろにお出になれます。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼の目は、彼を法廷から距ててる扉の銅の取っ手にぶつかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の視線は初めは穏かにその銅の取っ手に引きつけられてとどまり、次に驚いてじっとそれに据り、そしてしだいに恐怖の色を帯びてきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は痙攣的にその取っ手をつかんだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファンティーヌの室にくると、ジャヴェルは取っ手を回し、看護婦かあるいは探偵のようにそっと扉を押し開き、そしてはいってきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は閾の上に立ち、半ば開いた扉の取っ手に片手をかけ、頭を少し差し出してふらふらさし、身体は経帷子のように白いまっすぐな無襞の寝間着に包まれ、びっくりした様子であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京｜帝国大学の招聘に応じて、松江や熊本の地を去ったことも、同じくヘルンの身にとっては、愛する妻への献身的な犠牲だった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
