        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "明治43年11月『ホトヽギス』署名　　　左千夫",
              "citation": {
                "source": "水害雜録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治42年９月『ホトヽギス』署名　　　左千夫",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから「ホトヽギス」を見るやうになつて、漸く上根岸のそこがさうであるといふことを確めた。",
              "citation": {
                "source": "竹の里人〔二〕",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "夢は唯これだけで畢つたが、その病人の樣子などはホトヽギスや日本を見て自分が嘗て想像しつゝあつた先生なのである。",
              "citation": {
                "source": "竹の里人〔三〕",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜明けにたしかにホトヽギスが啼いた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホトヽギスを見ましたか。",
              "citation": {
                "source": "鈴木三重吉宛書簡―明治三十九年",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで千鳥を此次のホトヽギスへ出さうと思ふが多分御異存はないだらう。",
              "citation": {
                "source": "鈴木三重吉宛書簡―明治三十九年",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホトヽギスの写生文などが即ちその好例である。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本で言つて見ても、硯友社あたりの型にはまつた文章にあきたらないで、ホトヽギス一派は、写生に引返して、そしてあの自由な新しい文章を始めた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ホトヽギス三十二年七月号碧子の俳句評釈の文中摘記）僕は子規子に対して、年齢と経歴とに於ては郷里の長者先輩である。",
              "citation": {
                "source": "鳴雪句集",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ホトヽギス三十五年六月号獺祭書屋俳句帖抄に就きての文中摘記）下の子規居士の画と句とは居士の病革まる少し以前に乞ひ得たもので永き紀念として附載した。",
              "citation": {
                "source": "鳴雪句集",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホトヽギスの三百三十二号より四百四十五号まで。",
              "citation": {
                "source": "川端茅舎句集",
                "author": "川端茅舎句集",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十がらみの海女が、後から追ひ越しながら、「おや、今朝は、トヽカヽ船は出さないのかい？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、別々に仕事に出るより、船をなんとか都合して二人で一緒に働けるやうにしておくれ」「おれもその方がいゝとは思ふが、船は、当節、値が張るし、それに、あの、トヽカヽ船といふやつは、亭主が女房をこき使ふやうに見えて、おれの性に合はんのだ。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一斗桝とは――　トヽヽヽヽヽヽ、トン。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "トヽヽヽヽヽヽ、トヽン。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "削り終ると、すぐにトヽヽヽヽンと打ちつけた。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホトヽギス雑詠、各種の句会その他で虚子先生の選を経た、千句余りの中からそれだけ抽出した。",
              "citation": {
                "source": "松本たかし句集",
                "author": "松本たかし",
                "note": "青空文庫"
              }
            },
            {
              "text": "」朝寝坊ノ彼女ハ当然マダ寝テイルコトヽ思ッタラ、予ガ身動キヲシタ途端ニ上半身ヲ跳ネ起シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハイ、オ帰リニナッタコトヽ存ジテオリマシタラ………」「アヽソウカイ」「………オ二階デ涼ンデイラッシャイマシタンデ、………」コップガ二ツトコカコラノ壜ガ二ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頸カラ胸ヘカケテＶ型ニ真紅ノ型ガ染マリ、水着デ隠サレク腹ノ部分ノ白イコトヽ云ッタラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「肥後の本妙寺は朝から晩迄トヽカチ法蓮経トヽカチ法蓮経、皆人詣るばい。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も來月のホトヽギスに何か書くなら御掛念に及ばず」とある。",
              "citation": {
                "source": "知られざる漱石",
                "author": "小宮豐隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ホトヽギスに何か書く」とあるのは、その時分私がアンドレイエフ論を書く書くと言つてゐた、それをさすのである。",
              "citation": {
                "source": "知られざる漱石",
                "author": "小宮豐隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
