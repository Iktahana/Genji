        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "バルハートゥイ「チェホフのドラマツルギー」。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなじ叫ぶんでも〈トゥイスト＆シャウト〉とは、大ちがいだ」「それ、聴いたことない」　と、柾生が期待をこめていった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トゥイスタンシャウ！",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――という、トゥインＤＪでお送りします。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの――」　令子が口を開きかけると、部室から〈トゥイスト＆シャウト〉の３コードのイントロが流れてきた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンプだって、真空管のトゥイン・リヴァーブだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリヴァア・トゥイストは、何という子供じみた家庭小説であることか！",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら、知ってるだろ、あのフウォストゥイリョフのところで取り換えた馬さ……。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」だがチチコフは、そんな薄栗毛の牝馬にも、フウォストゥイリョフとかにも、生まれてこの方ついぞお目にかかったことがなかった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿の主人はコロトゥイルキンという商人で、これも矢張りがっしりした男であった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "偶々さうした噂話で婆さん連が井戸端会議を開いてゐるところへ、牛飼のトゥイミーシュ・コロスチャーウイといふ男が来合はせたことがあつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし鍛冶屋は、どうかしたはずみに自分の手が袋にひつかかつてひとりでに動いたのだと思つて、頑丈な拳で袋を叩きつけてから、肩の上で一つゆすぶると、プザートゥイ・パツュークの住ひをさして歩き出した。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "このプザートゥイ・パツュークといふ男は、かつてザポロージェにゐたといふことは確かだが、そこから追放されたのか、それとも勝手に出て来たのか、その辺のことは誰も知らなかつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのウイトゥレベニキ村からは、ほんの五露里も距れてをらぬホルトゥイシチェが私の持村で、姓名はグリゴーリイ・グリゴーリエッチの声はいつとはなしに段々荒くなつた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホルトゥイシチェへお出かけ下さらないと、ほんとに承知いたしませんよ。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんながいつしよぢやないか、クルトゥイシチェンコも！",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おなかがはって、ねむくなって来た――今、ドーム・オトドイハなら、ミョールトゥイ・チャスです。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "オムスクのすぐ手前、イルトゥイシュ河、大きい河、白い雪の間に河水は澱った灰汁色だ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その二側目の右から三つめのを見せて下さいな」「これでございますか」「ええ、そう」　それは、トゥイード風な茶と緑と黄の混った織物で、わるい趣味ではなかったが、田沢がカラーのところにあててこちらを向くと、蒼白い顔色や眼鏡とその織物との間にそぐわないものが生れた。",
              "citation": {
                "source": "道づれ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、心持に手綱のかかっている前半より、一九〇〇年八月、チェホフが楽々と「ヴイ」を「トゥイ」にかえてクニッペルを呼び始めてから、訳者も彼女の心持をのばしている。",
              "citation": {
                "source": "シナーニ書店のベンチ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "平日は労役へ出るので、彼女はそちらへ出向いて行き、時には作業場、時には煉瓦工場、時にはイルトゥイシュ河畔の小屋で会った。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "セミパラチンスク――イルトゥイシ河沿岸。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "又、メルトゥイユ侯爵夫人の天分はかくの如きものではないのである。",
              "citation": {
                "source": "破門",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アルジャントゥイュの素敵な酒があるんだがな。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アルジャントゥイュだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アルジャントゥイュってどこにあるんだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「六スーのアルジャントゥイュだよ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "外套も持たねば毛布もかつがず、あたり前のトゥイードの服を着た丈であったという。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "テル・ミー、ヨシオ、ジャスト・ビトゥイーン・ユーアンミ。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
