        "examples": {
          "standard": [
            {
              "text": "飲み屋街の路地裏には、泥酔した人が残した吐しゃ物が散乱していて不快だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「キャーッ、服に吐しゃ物がかかっちゃった！」と、介抱していた友人が悲鳴を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ノロウイルスなどの感染症を防ぐため、吐しゃ物の処理には塩素系漂白剤が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
