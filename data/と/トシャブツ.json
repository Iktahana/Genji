    "uuid": "b0a23ba9-e3b1-5308-9863-416997e68b9d",
    "entry": "吐瀉物",
    "reading": {
      "primary": "としゃぶつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
