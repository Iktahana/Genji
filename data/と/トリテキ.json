[
  {
    "uuid": "a8bda7b5-6a55-5501-9bd7-448bd093f9fa",
    "entry": "取り的",
    "reading": {
      "primary": "とりてき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "low-ranking unsalaried wrestler (ranked below juryo)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "まだ取り的なので、巡業中も関取の身の回りの世話や雑用をこなさなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "朝早くから稽古場に出て、泥だらけになって稽古に励む取り的たちの姿に心を打たれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "早く関取になって自分の個室を持つことを夢見て、取り的は厳しい修行を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "茂兵衛　そうだ取り的だ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "横綱でも大関でも、一度はみんな取り的だった。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔦　　（頬杖をついて見下している）取り的さん、そんな人に交際ってないで、さッさと行っておしまい、とどの詰りは、二つ三つ殴られた揚句に、いくらか銭をとられちまうよ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（引ッ繰り返り、慌てて起きかけ、へたへたとなる）茂兵衛　（力なくよろめき、辛くも踏止まったが、へたへたと坐る）弥八　　この取り的め。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（折り曲って去る）お蔦　　（弥八が倒れるのを見て喝采し、茂兵衛が意気地なく坐るのを見て惘れる）お松　　（お吉に）この人、病人らしいけど、さすが取り的でも力士は力士だねえ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "茂兵衛　（振り返ってお蔦を、ちょっと見ただけで歩く）お蔦　　取り的さん、お前さんを呼んでるんだ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（頭をさげて行きかける）お蔦　　お待ちよ取り的さん。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り的さん、お前、本当に、精出して立派な関取におなり、辛いことがあったら、その薄情な親類どもの顔を思い出して、一所懸命おやり、出世したら故郷へ錦を飾って、薄情揃いの奴等に、土下座させておやり、屹といい気味だよ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔦　　取り的さん、お前さんもお母さんが恋しいのだねえ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り的さんちょいと。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蔦　　吝ッ垂れな、今に横綱になる取り的さんじゃないか。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（口の中で記憶するために繰返していっている）お蔦　　その代り、取り的さん、屹とだよ、立派なお角力さんになっておくれね。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "あ、取り的さんの名は、まだ聞かなかったっけねえ。",
              "citation": {
                "source": "一本刀土俵入　二幕五場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の前で顔色なし　横綱だか、取り的だか知らんが、ともかく、雷はイヤですね、実に厭だ。",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去の仕事のカタログを製したりするよりは、むしろ未来の仕事の種子の整理に骨折っているらしいのが、常に進取的なこの人の面目をよく表わしていて面白いと思う。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "農業に関する知識は相当にあって、人工肥料の問題にも興味があり、この点では却って旧弊な執事等より進取的であった。",
              "citation": {
                "source": "レーリー卿（Lord Rayleigh）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大きい絣の単衣を着ていると、私は角力の取的のようである。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにも、支配階級の立場と、当時の進取的な、いわゆる立身成功を企図したブルジョアイデオロギーの反映がある。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四にねばり強くかつ進取的になります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この意義から言っても仏教は進取的です。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏教は進取的であっても、真理の根底が深いから、表面がやがやと騒ぎ立てません。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈良朝以前には少しは小乗仏教も入ったようでありますが、土地に適さない種子の萎びてしまうように、積極的、進取的な日本民族の間には、その小乗仏教はたちまちにして萎びてしまいました。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この大乗仏教のみ日本に根付いたという理由は、大乗仏教の現実理想化の思想、無私と慈悲を説く思想、個人主義を排斥して社会生活、国家生活に重きを置く思想、光明的進取的の思想等、ことごとく日本の民族精神に共鳴せられるところのものであるからであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらゆる民族の中の勇敢な進取的な連中が自然に寄り集まってできた国だとすれば、日本は世界じゅうでいちばんえらい国でなければならないはずである。",
              "citation": {
                "source": "カメラをさげて",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "開国は寧ろ大胆な、進取的な策であるべき筈なのに、それが因循と云はれたのは、外夷の脅迫を懾れて、これに屈従するのだと云ふ意味から、さう云はれたのである。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "万力は男世帯で、家には黒松という取的がいるだけです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒松なんぞは名も知れない取的ですから、別に問題にもなりませんが、万力は二段目の売出しですから、この噂が伝わると世間では驚きました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "薄雲の碁盤",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもそんな噂が生み出されたのを見ても、ふだんから世間一般に団十郎は進取的、菊五郎は保守的と認められていたのが判る。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋の文明は積極的、進取的かも知れないがつまり不満足で一生をくらす人の作った文明さ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その不便な、不衛生な、貧民窟の増加し易い、犯罪の行われ易い、そうして保守的なブル階級にだけ都合よく、進取的なプロ階級にとって不愉快極まるロンドンが、如何に新しい英国の発達を妨げたことであろう。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
