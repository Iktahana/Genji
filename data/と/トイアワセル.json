[
  {
    "uuid": "7bf16061-a23f-5294-a976-46d54824bfaf",
    "entry": "問い合わせる",
    "reading": {
      "primary": "といあわせる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
