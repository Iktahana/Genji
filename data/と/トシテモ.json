  {
    "uuid": "f337fe71-14b6-56a3-bfe0-babe31fcebec",
    "entry": "トシテモ",
    "reading": {
      "primary": "としても",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "万一出来タトシテモ其時ハ話モ出来ナクナッテルデアロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字トシテモ現今ノヒラガナヨリハ変態ガナノホウガ美シク、変態ガナヨリハ上代ガナノホウガ美シイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、ナカ／＼別レル気ナンカアルマイ、萬一彼女ニ疑ワシイ行為ガアッタトシテモ、見テ見ナイ振リヲスルカモ知レナイ、上手ニ振舞ッテサエクレヽバ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サッキノ土蹈マズノ感触ガ、マダ唇ニ残ッテイテ忘レヨウトシテモ忘レラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ同時ニ、コノ調子ナラコレカラ後モ気狂イ的行為ヲ繰リ返シテモ差支エアルマイ、颯子ノ好キナピンキー・スリラーデハナイガ、コノ程度ノ冒険ハ止メル訳ニ行カナイ、間違ッテ死ンダトシテモ構ウモンカ、ト云ウ気ニナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ喜ビヲ買ワンガタメニ負傷ヲシテモ惜シイトハ思ワナイ、ソノ負傷ガ原因デ死ヲ招イタトシテモ、ムシロ望ムトコロデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワア、ワア、ワア、―――予ハ芝居ヲシテルンジャナイ、「颯チャン」ト叫ンダ拍子ニ俄ニ自分ガ腕白盛リノ駄々ッ子ニ返ッテ止メドモナク泣キ喚キ出シ、制シヨウトシテモ制シキレナクナッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮リニ友人ガアッタトシテ、ソノ友人ガ優秀ナ技術ヲ具エテイタトシテモ、予ガ何ノ目的デ左様ナ製作ヲ依頼スルカヲ知ッタトシタラ、果シテ快クソレニ応ジテクレルデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（又予トシテモ、ソンナ厚カマシイ耻カシイコトヲ臆面モナク頼ム勇気ハナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ノ理性ハ制御ヲ命ジタトシテモ、彼女ノ飽クナキ肉体ハ理性ノ言ニ耳ヲ貸サズ、僕ヲ破滅ニ追イ込ムマデモ満足ヲ求メテ已マナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………考エマイトシテモソノ家ノ様子、室内ノ空気、二人ノ寝テイル恰好マデガ浮カンデ来テ仕方ガナカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナヲ自分ノ日記ニ書イテイルカドウカ知ラナイガ、書イテイタトシテモ僕ガソレヲ読マナイデ（アルイハ読マナイフリヲシテ）イルヲ認メサセルタメニ敏子ヲ使ッタ？",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………従来僕ガ妻ノ貞節ヲ信ジテ疑ワナカッタ一ツノ理由ハ、彼女ガドンナ場合ニモ僕トノ情交ヲ拒マナイガ明ラカデアル時ニモ、ソノ夜夫カラ挑マレテ怯ム色ヲ見セタガアッテ夜ニ及ンデマタアッタトシテモ、―――ソウイウ日ガ数日続イタトシテモ平気ナ体質ナノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "拒モウトシテモ誘惑ニ打チ克チ得ズ、カエッテソレヲ喜ビ迎エル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "名犬ハ税トシテモ貴マレ、一匹ノ価、百貫ヲ呼ブモアリ、武門｜悉ク、犬ヲ繋ギ、犬ニ仕へ、日、暮ルレバ又、宴楽アルノミ。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
