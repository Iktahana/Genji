        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は音楽家としても、教育者としても国際的に認められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "日本は電子機器の大国としても、自動車産業の強国としても知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女はアスリートとしても、タレントとしても成功を収めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
