          "literary": [
            {
              "text": "古代メキシコ人の間に行われた、トナラマトル（Tonalamatl）と名づける二六〇日の珍しい周期はほとんど太陰月の九ヶ月（すなわち、二六五・七日）に等しい。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは一四六トナラマトル、あるいは金星周期の六五倍に当るのである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            }
          ]
