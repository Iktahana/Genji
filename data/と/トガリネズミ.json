        "examples": {
          "standard": [
            {
              "text": "森の中では、小さな尖鼠が素早く走り回っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "尖鼠は夜行性で、昆虫などを食べる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の研究室では、尖鼠の行動について詳しく調査している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ギリシア人はウラクスを知っていて後期ラテン語の「ソレクス」であって齧歯類ではなくトガリネズミでありマウスに似ていて文献ではマウスと混同されていたようである。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の学友ランド教授はケラーが「古代の動物」でローマ皇帝ヘリオガバルスが「１万匹のマウス、千匹のトガリネズミ、千匹のイタチの戦いを行わせた」話を引用していることを述べてくれた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "言う必要は無いがトガリネズミはマウスに楽勝しイタチは両者を殺した。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
