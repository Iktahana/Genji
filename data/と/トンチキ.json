      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "numbskull",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「おい、トンチキ、そんなこともわからないのか！」と彼は怒鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はよく頓痴気な質問をして、周りを困らせる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "そんな頓痴気なことを言っていると、誰にも相手にされなくなるぞ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「この頓痴気野郎が」と云ひ様足許近くに置いてあつた痰壺を取上げて判官目がけて投げつけた。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "小作ソーギなんぞやってるときか、頓痴気奴！",
              "citation": {
                "source": "「モダン猿蟹合戦」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……奴あ頓痴気のうえに悪党だ……つまり頓痴気だ。",
              "citation": {
                "source": "マリ・デル",
                "author": "MARI D'ELLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからお前はつまり、頓痴気のザグヴォズキンと同じことなのさ。",
              "citation": {
                "source": "マリ・デル",
                "author": "MARI D'ELLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "氷見役人などはみな頓痴気だから、そりゃ、大変、で追いかける。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "氷献上",
                "note": "青空文庫"
              }
            },
            {
              "text": "何にもしらずに、夫婦とはこんなものだと思っているなら、とんでもない、それをくだらないと気がつかないのか頓痴気め！",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから縁側へ出てゆき、鏡の面を拭いてよくよく眺めた……自分の顔である、慥かに、紛れもなく庄司千蔵の顔である、「ははあ」こう彼は頷いた、「ははあ、――」弁証法を借りるまでもない、この二つの顔の表明するものがわからなければ、それこそ頓痴気であり蒟蒻玉である。",
              "citation": {
                "source": "評釈勘忍記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「くっだらない、このお頓痴気！",
              "citation": {
                "source": "ドラムガニョールの白い猫",
                "author": "Ｊ. Ｓ. レ・ファニュ　J.S.Le Fanu",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそうならトンチキだな」「江戸じゃあ一流の人物だ、まさかそうとは思っていまい。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "熱い茶を暑中に出すなんか、一口に羽田と馬鹿にも出来ないね」「能く江戸からお客様が入らッしゃいますで、余まりトンチキの真似も出来ませんよ」「それは好いけれど、何かこう、茶菓子になる物は無いかえ。",
              "citation": {
                "source": "悪因縁の怨",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうはいっても俺だって、トンチキでないとはいわれないよ。",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御冗談でせう、近頃の円タクで空車流しをやるやうなそんなトンチキは近頃の貸家よりも目つからねえやうなもんですぜ、などと喰はされる。",
              "citation": {
                "source": "貸家を探す話",
                "author": "高田保",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤイ警官のトンチキ野郎奴。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「トンチキ野郎などと大変な口を利いたのもお前だろう」「僕に違いありません。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンチキめ」　と、いうようなグアイで、手がつけられない。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "でえいち、てめえのようなトンチキにつかまる羚羊なんかこのへんに一匹でもいたらお目にぶらさがるってんだ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「またもだらしねえことをしやがって、このトンチキめ！",
              "citation": {
                "source": "曲馬団の「トッテンカン」",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ママ薯におとらないナチ・マニアで、この前パリへ来たとき、カーキ色のユニフォームに、ＢＤＭ（ドイツ女子青年団）の〈三叉の物干棒〉のバッジをつけてルロンへ口紅を買いに行って、あっさりお断りをくったというトンチキだが、なんのつもりか鶴のように片足で立って、花束の間からあたしたちのほうを見ていた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに平和を愛されたあの方を戦争の主謀者だったようにありもしない罪を誣い、天皇制を否定して、新しい主権者のイメージを描いて見せるふしぎな国があり、われわれの中にもそれに同意するひとがいるようだが、トンチキはどこにもいるものだと感心させられる」　ジャガイモの顔を見ながらあとをつづけた。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャラコさんは返事のしようもなくておし黙っていると、茜さんは、唇のはしに皺をよせてジロジロとキャラコさんを見おろしながら、だしぬけに、「キャラコなんて、ずいぶんトンチキな名ね。",
              "citation": {
                "source": "キャラコさん",
                "author": "蘆と木笛",
                "note": "青空文庫"
              }
            },
            {
              "text": "不死身無感覚のトンチキめ！",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
