[
  {
    "uuid": "3b8b692c-5b35-5be4-a321-1c05c5655f95",
    "entry": "頓痴気",
    "reading": {
      "primary": "トンチキ",
      "alternatives": [
        "とんちき"
      ],
      "is_heteronym": false
    },
    "grammar": {
