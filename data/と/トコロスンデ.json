          "literary": [
            {
              "text": "この一直線に画いてある処既に奇抜である。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐野が宿は源左衛門の宿なるべく、鉢の木の梅松桜を伐りたる面影を留めて夏季の藜を伐るに転用したる処既に多少の厭味があるやうに思ふ。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつの民族が唯何等かの仕方で文化の段階に到達した處では、到る處既に或る歴史敍述が見出される。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
