    "definitions": [
      {
        "index": 1,
        "gloss": "castor oil plant (Ricinus communis)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
