        "examples": {
          "standard": [
            {
              "text": "「事態を円満に取り運ぶために、まずは相手の主張をじっくり聞こう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ベテランの仲介役が、難航していた交渉を見事に取り運んだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「プロジェクトを計画通りに取り運ぶには、チームの結束が不可欠だ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "文庫の運搬は大沢と恭一とが引きうけて、あすのうちにとりはこぶことになった。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも其の覚束無い光の下に其の男は万事を取運ぶのであつた。",
              "citation": {
                "source": "落葉降る下にて",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "必死の思いをひたかくしにした表情で、オヘロは式をとり運ぶ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
