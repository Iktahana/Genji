        "examples": {
          "standard": [
            {
              "text": "愛犬の毛が伸びてきたので、予約していたトリマーさんにカットをお願いした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "トリマーの鮮やかなハサミさばきによって、ボサボサだった犬が見違えるほど綺麗になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "愛犬をトリマーに連れていってスタイリングしてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
