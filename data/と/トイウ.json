        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その会議には、専門家が30人と言う大勢集まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この小さな町には、一万人と言う人々が暮らしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は一日で本を5冊と言う驚くべき速さで読み終えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
