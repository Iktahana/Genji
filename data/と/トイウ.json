    "definitions": [
      {
        "index": 1,
        "gloss": "called",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は「山田さん」と言う名前の友人を探している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この公園は「緑豊かな憩いの場」と言うことで地元の人々に愛されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼が「天才」と言うのは、単に頭が良いだけでなく、努力家でもあるからだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そういう時、妻はわざわざ私の所へやって来て、『遅くなりますから、お先へ休ませて戴きます』と言う、丁寧に三つ指をついてお辞儀をし、それから自分の寝床へ入る。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がＡと言う作品を創る。",
              "citation": {
                "source": "自作を語る",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、プウシキンの読者だったあのレニンが、いま生きていたら、何と言うでしょう。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕に五十円出せと言うのですけれども、ばからしい。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実は、小説よりも奇なり、と言う。",
              "citation": {
                "source": "一つの約束",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中さんがあらわれて、どうぞ、と言う。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」しっかり飲め、と言うのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」傲然と言うのである。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は生来、俳句と言うものに深い興味を持たなかった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜかと言うに、蕪村の俳句だけが僕にとってよく解り、詩趣を感得することが出来たからだ。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてこの場合に「若い」と言うのは、人間の詩情に本質している、一の本然的な、浪漫的な、自由主義的な情感的青春性を指しているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その蕪村を好まぬ理由は、蕪村が技巧的の作家であり、単なる印象派の作家であって、芭蕉に見るような人生観や、主観の強いポエジイがないからだと言うことだった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏町によく見る風物で、何の奇もない市中風景の一角だが、そこを捉えて春夜の生ぬるく霞んだ空気を、市中の空一体に感触させる技巧は、さすがに妙手と言うべきである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "某氏初期の新体詩に若草｜萌ゆる春の野にさまよひ来れば陽炎や名も知らぬ虫の飛ぶを見てひとり愁ひに沈むかな　と言うのがある。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人の説によると、この句の「人間」は「にんげん」と読むのでなく、「ひとあい」と読むのだと言うのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち句の意味は、行人の絶間絶間に鶯が鳴くと言うので、人間に驚いて鶯が鳴くというのでないと主張している。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実に名句と言うべきである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日だけの休暇を楽しむ、可憐な奉公人の子供は、何の夢を見ていることやら、と言う意味である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのため非難するものは、蕪村の句が絵画的描写に走って、芭蕉のような渋い心境の幽玄さがなく、味が薄く食い足りないと言うのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この同じ自然観が、芭蕉にあっては大いに異なり、鷹ひとつ見つけて嬉しいらこ岬　　　芭蕉　と言うような、全く魂の凍死を思わすような、荒寥たる漂泊旅愁のリリックとなって歌われている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い高い梯子が立ってその上に天の戸が開けていた、王がそれを登りつめて最後の段に達した時に起こされたのだと言う。",
              "citation": {
                "source": "春寒",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボーイが御茶を上げましょと云うて来たから室へはいると、前の商人はあわてて席を譲って「ドーゾコチラヘ」と言う。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "自然派勃興以後の花袋自身は、おそらく「こんなもの」と言うかもしれないが、私のすきな花袋は、やはり情緒綿々たる紀行文家の花袋である。",
              "citation": {
                "source": "紀行文家の群れ",
                "author": "――田山花袋氏――",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に依ると、あの花の馨は、糞ッ臭いから、いやだと言うようだが、幸いに私の嗅覚は、それほど過敏でない故か、ちっとも苦にならないどころか、臭いからして、私はこの花が好きだ、梅の匂いのように上品でないかも知れないが、土臭いのが堪まらなくいい。",
              "citation": {
                "source": "菜の花",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんなところが登れようかね」と、岩壁の白い薙を指しながら、話の緒を引き出したところが、あすこは嘉門次が、つい去年、山葵取りに入りこんで、始めて登ったところで、未だ誰もその外に、入ったものはないと言うので、私はふと聞き耳を立てた。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに十九の大厄だと言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "車屋のばあさんなどは「もうスッカリ御全快だそうで」と、ひとりできめてしまって、そっとふところから勘定書きを出して「どうもたいへんに、お早く御全快で」と言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "月の十何日、風のない暖かい日、医者の許可を得たから植物園へ連れて行ってやると言うとたいへんに喜んだ。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "出かけるとなって庭へおりると、髪があんまりひどいからちょっとなでつけるまで待ってちょうだいと言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにせき立てると、なおできやしないわと言う。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
