        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "生理学を専攻する君に、こんなことを言うのは僭越だが、心臓の血圧の曲線を観察すると、かのトラウベ・ヘーリング氏の弛張がある。",
              "citation": {
                "source": "闘争",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで活動に弛張を来し、それが所謂トラウベ・ヘーリング氏の弛張と名づけられて居るが、僕は精神的活動にも同様なことがあり得ると思うのだ。",
              "citation": {
                "source": "闘争",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "医薬の作用について価値のある研究がなされただけでなく心臓病理学についての我々の知識はトラウベ、コーンハイムその他の研究によって革命的に変化した。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の病理学の傾向はメーケル、トラウベおよびとくにウィルヒョウに見られた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "臨床研究ではフレーリクスおよびトラウベがその代表であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "トラウベはシェーンラインの弟子でユダヤ人であり従ってユダヤ人にも資格を与えるようになった1848年まで学位を得ることができなかった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "（＊弟のモーリッツ・トラウベも優れた化学者、生化学者であった）。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "シェーンラインがベルリンの臨床を支配していた頃であってトラウベの講義にも出席した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はウィルヒョウの講義を聞きシャリテでフレーリクスやトラウベの臨床に出席した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "1867.　半透膜についてのトラウベの仕事。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホイットマンやトラウベルの詩に趣味性としての民主化さえ見る事が出来る。",
              "citation": {
                "source": "第四階級の文学",
                "author": "中野秀人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
