        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "冬の味覚の王様と言えば、やはり刺身でいただく虎河豚が一番だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "本場の下関で、熟練の職人が引いた透き通るような虎河豚の薄造りを堪能した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "虎河豚のヒレ酒を一口飲むと、香ばしい香りが口いっぱいに広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "侍女四　（同じく公子の背後に）鮟鱇五十袋、虎河豚一頭、大の鮹｜一番。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち名古屋河豚（小斎河豚）、目赤、虎河豚、黄金河豚、銀河豚、北枕、篭目河豚などが普通知られている。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私らが、料理屋で食うのは虎河豚、名古屋河豚、世間では金河豚といっている黄金河豚であるが目赤と北枕、篭目は猛毒の持主で、食えば大概極楽行きである。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番人に歓迎されるのが虎河豚で、漁も沢山ある。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎河豚のように皮膚に刺はなく肌に黄金色の艶が出ているのである。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日後、ニューヨークは五番街のティファニイで日本人ギャルの「ウッソー、ホントにー」をＢＧＭに、慶子ちゃんの品定めに付き合っているうちに、突如体中のリンパ腺がトラフグを怒らせたように膨れ上がり、猛烈な悪寒とともに下腹が鳴り始める。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
