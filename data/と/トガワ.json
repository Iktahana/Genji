          "literary": [
            {
              "text": "タイヘン突拍子モナイコトヲ言イ出シタヨウニ思ワレルカモシレナイガ、少シ落着イテ考エテミルナラ、別ニ奇抜ナコトデモ何デモナイコトガワカル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒコートウノコージハオモイノホカハヤクデキアガルコトガワカッタタブン三シユウカンノノチトオモワレル。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "トガワという人の『幕末小史』や『旧幕府』という月刊雑誌の出たのも、このころであったかと思うが、もしそうならば、それらもいくらかの刺戟になったかも知れぬ。",
              "citation": {
                "source": "学究生活五十年",
                "author": "津田左右吉",
                "note": "青空文庫"
              }
            }
          ]
        }
