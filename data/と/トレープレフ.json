        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "出演はニーナ嬢で、脚本はトレープレフ君の書きおろし。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あなたには、わかってもらえそうもないけど……右手から、ソーリンとトレープレフ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが昼めしのあとで、ついまた寝こんじまって、今じゃ全身へとへと、夢にうなされてるみたいな気持さ、早い話がね……トレープレフ　そりゃもちろん、伯父さんは都会に住む人ですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　（トレープレフに）じゃ、始まる前に、知らせによこしてください。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやでも、ここに釘づけだ……ヤーコフ　（トレープレフに）若旦那、〔わっしら〕ちょいと一浴びしてきます。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　いいとも。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）トレープレフ　（仮舞台を見やりながら）さあ、これが僕の劇場だ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　万一ニーナさんが遅刻しようもんなら、舞台効果は吹っ飛んじまう。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　なぜかって？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　（笑う）まさか、そう気を回さんでも……トレープレフ　おっ母さんはね、この小っぽけな舞台で喝采を浴びるのが、あのニーナさんで、自分じゃないのが、癪のたねなんですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　（小さな花の弁をむしりながら）好き――嫌い、好き――嫌い、好き――嫌い。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　だから、新しい形式が必要なんですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　あれは、頭のいい、さばさばした、それにちょいとその、メランコリックな男ですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　（耳をすます）足音が聞える。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……トレープレフ　（女の両手にキスしながら）ええ、大丈夫、大丈夫……ニーナ　一日じゅう心配だった、どきどきするくらい！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　ほんとに、もう始める時刻だ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（あたりを見回す）トレープレフ　僕たちきりですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーナ　誰かいるみたいだわ……トレープレフ　いやしない。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　にれの木。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　もう晩だから、物がみんな黒く見えるのです。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　じゃ、僕のほうから行ったらどう、ニーナ？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　僕は君が好きだ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　（足音を耳にして）誰だ？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　みんな持ち場についてくれ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　アルコールの用意はいいね？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　ええ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　（冷やかに）知らないな、読んでないから。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　生きた人間か！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（訳注　この引用句は、ラテンのことわざを二つ、つきまぜたおかしみがある）トレープレフ、仮舞台のかげから登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トレープレフ　もうすぐです。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
