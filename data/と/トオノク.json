[
  {
    "uuid": "d2cf553f-f2c6-51ea-aaaa-e1a05d5151c2",
    "entry": "遠のく",
    "reading": {
      "primary": "とおのく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-カ行",
        "動詞-自動詞"
      ],
      "ctype": "五段-カ行",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to move off (into the distance)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "船はだんだん沖へ遠のいていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "飛行機が空高く遠のいていくのが見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼が去っていく後ろ姿が、次第に遠のいていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しおれた女の足音が遠のくと、ミサコは女記者が青バスに太い拳をさしあげるのを見た。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "川の岸に並び立っている倉庫は、つぎつぎに私を見送り、やがて遠のく。",
              "citation": {
                "source": "佐渡",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが遠のくと、また心臟だ――息切れだ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕許の雑音が、だん／＼遠のくと同時に、それが快い微妙な、小鳥の囀か何かのように、意味もない音声に変ってしまって居た。",
              "citation": {
                "source": "極楽",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして数を読んで行くうちに、頭の中がしんしんと冴えるようになって行ったと思うと、世の中がひとりでに遠のくように思えた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三唖も旋毛の少々曲った変梃な男だから嫌気がさして復た暫らく足を遠のくと、今度は他の家へはマメに出掛けるくせに社のものの方へはまるきり鼬の道てのは余まり義理を知らなさ過ぎるぜと、一々不義理を数え立てられてネチネチと油を搾られた。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "三四郎は九州から山陽線に移って、だんだん京大阪へ近づいて来るうちに、女の色が次第に白くなるのでいつのまにか故郷を遠のくような哀れを感じていた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が近附くと向うが隠れ、私が遠のくと向うがバタバタとついて来たのではないか。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　部屋の中で、参木はいつ秋蘭の足音が遠のくかと耳を聳てている自身に気がつくと、ああ、また自分はここで、今まで何をしてたのだろうと、ただぐったりと力がぬけていくのを感じるだけであった。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が出て行った後をしめ、樹の間に遠のく姿を暫く見ていたさほ子は、今にも涙を出しそうに、うるんだ眼をして良人の処に来た。",
              "citation": {
                "source": "或る日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当に、活動から遠のく不安さえ感じなかったら、この自然とともに根気よく、一年でも二年でも落付いていられるだろう。",
              "citation": {
                "source": "夏遠き山",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "柿丘でなくとも、どのような男だって、雪子夫人のような女に出遭うと、立ち竦みでもしたかのように彼女から遠のくことが出来なくなるだろう。",
              "citation": {
                "source": "振動魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際少し遠のくと重々しく艶な淡紅の花の姿全体が、サクサクした黒土との配合、品よく張った葉の繁り工合とともに、却って近くで見るに増した趣がある。",
              "citation": {
                "source": "牡丹",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼い日の思い出物語であるが、親戚の御婚礼の日、雌蝶の役になったかつみという女の子が其の日雄蝶の役になった仙台平の袴の男の児に淡い魅力を感じ、はにかみと興味とをたがいちがいの稚い感情でその男の子のまわりに近より遠のく風情など、単純ではあるけれどもなかなか厚みと伸びと濃やかさのある筆致で書かれている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　義雄は千代子に引かれて、電車通りを、公園のふちに添つて歩いてゐたが、あの鶴子の爲めに遠のくやうになつた倶樂部の連中に、またこんなことがあつた爲め、又と再び會はせる顏がないかのやうな恥辱に滿ちて、一言も口を聽かなかつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし店を遠のくにしたがって、今さきにした戯れもまだ早すぎるのだと思った。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは真実から遠のくことだ。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "往来を、今度はゆっくり江戸川の方へあるき初めたが、榎の家から遠のけば遠のくほど、彼の胸に漠然とした面白さが湧いた。",
              "citation": {
                "source": "ヴァリエテ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "みよ子から遠のくにつれて、私の心は益々祖母に接近していきました。",
              "citation": {
                "source": "幻の園",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸をあけて遠のく足音につれてやがて余韻ばかりになるしずかな旋律の歌に耳をかたむけた。",
              "citation": {
                "source": "日記",
                "author": "一九一四年（大正三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ノ五　黒吉は、しょんぼりと、突立った儘、親方の遠のく、跫音を、聴いていた。",
              "citation": {
                "source": "夢鬼",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――長さんの足がひょいひょい遠のくのは、吉原の火焔玉屋のお職がこのごろ血道を上げているからだそうな。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二千年の昔から不意に呼び出された影の、恋々と遠のく後を追うて、小野さんの心は杳窕の境に誘われて、二千年のかなたに引き寄せらるる。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "海境は、行けば行くほど遠のくので、とても行きゝれない。",
              "citation": {
                "source": "古代人の思考の基礎",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "今さし当って縁付くにしても、ジョン・バートンは夫として彼女が胸に描いた理想の人物とは聊か隔りがあったけれど、でも然うすれば少くともきりなしに起る悴夫婦の喧嘩からは遠のくことが出来る。",
              "citation": {
                "source": "目撃者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでその叫び聲も、割栗石を敷いた道に響くびつこの足音も、だん／＼ハリーの耳から遠のくばかりであつた。",
              "citation": {
                "source": "帽子箱の話",
                "author": "スティーヴンスン",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした立ち場から、部分の類似をつきつめて行けば行く程、事実から遠のく。",
              "citation": {
                "source": "万葉びとの生活",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういえば、跫音らしいものが空虚な反響をあげて、トントンと遠のくように思いましたが、別に扉がギーッと閉まる音は気がつきませんでした」「ふふん、それはどうも……」課長は低く呻った。",
              "citation": {
                "source": "赤外線男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "風のように近づいて遠のく省線の響。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつたい、今日は何ごとかの」　庄谷は自分よりは高い相手から見下されるのを避けるやうに少し遠のくと、房一の改まつた服装を胸から下にかけてぢろぢろと見た。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to drift away (from a person, activity, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "忙しくなって、趣味から足が遠のいてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの事件以来、彼とは連絡が遠のいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "近年、若者の活字離れが遠のくことなく続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
