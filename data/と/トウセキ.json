    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "野営地から上、踏跡は全く急箭の流れに押しまくられて「監視路」の文字も無意識にうちに消え失せた。",
              "citation": {
                "source": "二つの松川",
                "author": "細井吉造",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの辺は人が最近通るとみえ、踏跡はハッキリしている。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
