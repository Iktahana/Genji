          "literary": [
            {
              "text": "一より十六を正方格内に置いて縦線、横線、対角線、各隅、随処四方角、皆三十四になる。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "方一丈ばかり掘るに、地中深き處四個の房閣ありけり。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "講釋師の言ふ、槍のつかひてに呪はれたやうだがと、ふと見ると、赤煉蛇であらう、たそがれに薄赤い、凡そ一間、六尺に餘る長蟲が、崖に沿つた納屋に尾をかくして、鎌首が鷄に迫る、あます處四五寸のみ。",
              "citation": {
                "source": "間引菜",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
