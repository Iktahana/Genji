        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "外国の婦人のまだうら若きと見ゆるが靴の上に草鞋をはき、一人は橋の上に立ち、一人は岩に腰うちかけて絵など写すめり。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "走れば十分とはかからぬ間なれど肥った自分には息切れがしてほとんどのめりそうである。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "物語の中に「なめり」「あめり」と書いてありますが、これはこれまでの伝統的の読み方としては「ナンメリ」「アンメリ」と読んでいる。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴虫はふり出てなく声のうつくしければ、物ねたみされて齢ひの短かきなめりと点頭かる。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひるすぎて空はさあをにすみわたり海はなみだにしめりたりしめりたる浪のうちかへすかの遠き渚に光るはなにの魚ならむ。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花鳥花鳥の日はきたり日はめぐりゆき都に木の芽ついばめり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "波宜亭少年の日は物に感ぜしやわれは波宜亭の二階によりてかなしき情歡の思ひにしづめり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の日は物に感ぜしやわれは波宜亭の二階によりて悲しき情感の思ひに沈めり　と歌つた波宜亭も、既に今は跡方もなく、公園の一部になつてしまつた。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）とはいへ、私の求愛の道はあまりに遠く、あまりに陰鬱でしめりがちである。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "凧のかげ夕方かけて読書かな夕立やかみなり走る隣ぐに沓かけや秋日にのびる馬の顔鯛の骨たたみにひらふ夜寒かな秋ふかき時計きざめり草の庵石垣に冬すみれ匂ひ別れけり　彼の俳句の風貌は、彼の人物と同じく粗剛で、田舎の手織木綿のやうに、極めて手触りがあらくゴツゴツしてゐる。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "更衣母なん藤原氏なんめり　平安朝の文化に対して、蕪村は特殊の懐古的｜憧憬と郷愁とを持っていた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この句の第三句は、多くの句集に「なりけり」となってるが、平安朝の言葉をもじった「なんめり」の方が、この場合ユーモラスで面白い。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気は梅雨で重たくしめり、地上は一面の桑畑である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和九年二月著者我が心また新しく泣かんとす冬日暮れぬ思ひ起せや岩に牡蠣漂泊者の歌日は斷崖の上に登り憂ひは陸橋の下を低く歩めり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "波宜亭少年の日は物に感ぜしやわれは波宜亭の二階によりてかなしき情感の思ひにしづめり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが感情は飢ゑて叫びわが生活は荒寥たる山野に住めり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬱然として怒に耐へず、遠く沖に向て叫び、我が意志の烈しき渇きに苦しめり。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遙か河下に星の如くまたたくは淺草の人家なめり。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "香水、麝香、油煙、マニラの臭氣相混じて一種縁日臭を作り、靄々然として、人自らそが上を蹈み、そが中を歩めり。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋日行語〔菊もうららに〕萩原朔太郎菊もうららに咲きいでたれど我身は砂丘に寄りて悲しめりさびしや海邊のおくつきに路傍の草を手向くることこのわびしきたはむれにひとり樹木にすがりつきたましひも消えよとむせびなく。",
              "citation": {
                "source": "秋日行語",
                "author": "〔菊もうららに〕",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくばかり我に信なきともがらに、なにのかかはりあるべしやは、空しく坐して祈り、遠き遍路に消え殘る雪を光らしむ、いのちはひとりのもの、ただ我が信願をかくるにより、木ぬれにかかり、有明の月もしらみてふるへ悲しめり。",
              "citation": {
                "source": "黎明と樹木",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾たびとなく足をすくわれ、のめり、手を突きながらも、温度は手が凍えるまで下らなかったので、金剛杖や糸立を強くつかんで、大宮口の五合目へ、ほうほうの態でたどりつき、たき火でぬれた上衣を、かわかすのに暇取った。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ真理なる神よ、願くは余をして永久の愛において爾と一ならしめよ、余は時々多くの事物に関して読みかつ聞くに倦めり、余の欲する処望む処はことごとく爾において存するなり、総ての博士たちをして黙せしめよ、万物は爾の前に静かならしめよ、しかして爾のみ余に語れよ。",
              "citation": {
                "source": "基督信徒のなぐさめ",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物的の汝は病めり、しかれども天使的の汝は健全なるを得るなり、汝動物的の快楽を去り天使的の快楽を取れ。",
              "citation": {
                "source": "基督信徒のなぐさめ",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "◯六節にいう「汝は神を畏こめり、これ汝の依頼む所ならずや、汝はその道を全うせり、これ汝の望ならずや」と。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それ全能者の箭わが身に入りわが魂その毒を飲めり、神の畏怖われを襲い攻む」と四節はいう。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "◯今十四章を全体として視るに、光明既に臨めりということは出来ない。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、めりめりめりめりっ。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "べきん、めりっ、と、戸を、木を折り、挫く音が聞え出した。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ふらんす・あるまん・あんぐれい、あめりっく・おらんだ・ぽるちゅげえ、と世界中の国々の女の子が、みな一度は登ってるってのに、日本の女の子だけは、みな麓をしゃなしゃな散歩して引き上げたってんだから、あたしは、納まらないのよ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
