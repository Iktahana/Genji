          "literary": [
            {
              "text": "麦の芽が針程に延びて、木綿畑では、枯葉やはぢけたももの殻がかさかさと風に鳴る静かな朝のことであつた。",
              "citation": {
                "source": "夜烏",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから清国へ渡って塩田で働いたり綿畑で働いたりしたらしいんだがね。",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "この国はどんなに多くかつての綿畑を桑畑に変えてしまったでありましょう。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
