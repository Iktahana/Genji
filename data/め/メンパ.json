          "literary": [
            {
              "text": "宗平兄弟は「メンパ」とよぶ弁当箱を出して、汁を上から掛けては箸を運ぶ。",
              "citation": {
                "source": "白峰の麓",
                "author": "大下藤次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らの手にせる「メンパ」というのは、美濃方面で出来る漆で塗った小判形の弁当箱で、二合五｜勺入りと三合入りとある。",
              "citation": {
                "source": "白峰の麓",
                "author": "大下藤次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕は「メンパ」であろう。",
              "citation": {
                "source": "白峰の麓",
                "author": "大下藤次郎",
                "note": "青空文庫"
              }
            }
          ]
