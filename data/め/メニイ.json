          "literary": [
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｇ中尉は「これは少々ツー・メニイだ」といって、入口の所へ行き、前から命令を受けていた米国兵一人のほかに比島兵一人に新たに命令を出し、都合二人の兵隊がエスコートすることになった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスルト颯子ノタメニイロ／＼ト好都合ナコトガ起リソウデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
