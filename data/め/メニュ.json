        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四　ある食堂の片隅の食卓に女学生が二人陣取ってメニューを点検していた。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがちかごろは洋食のメニューを並べている。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これならラフルス・ホテルのメニュウにだってつけ出されまさ」　事務員の一人は、晩餐の食卓でこう云った。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝸牛の季節には巴里のレストラントのメニュウには大抵それが載っている。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスのレストラントへ行ってメニュウを探して見るとポークカツレツというのがあるから、喜んで注文するとそれはわれわれの予期するカツレツではなくて日本の所謂ポークチャップであった。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、八重ちゃん……」　と、豹吉は店の女の子を呼んで「――この子供らに、メニューにあるだけのもン、何でも食わせてやってくれ」　どうやら靴磨きの少年達に御馳走することには、反対らしいお加代への面当てに、わざとそう言った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣のテーブルでは、十二三の少年が七つ位の弟と五つ位の妹を連れて、メニューにあるだけのものを全部注文していた。",
              "citation": {
                "source": "ヒント",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッチ、メニュー、――手当り次第だった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "オムレツと焼玉子の合の子のようなものが、メニューの中にあった。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しおりをはさむくらいの手軽さで登録できて、次からはメニューから名前を選ぶだけでいい。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "現住所を起動機能付きで記録する「Save location といったメニューを用意しておかなかったのは、ネットスケープの盲点だな」と祝田さんは考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "スモールトークと名付けたダイナブック用の言語では、この点を改善したいと考えて「メニュー」を用意することにした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトのポインティングディバイスに使われたマウスのボタンの操作によって、画面上にメニューを呼び出す方式は、ポップアップメニューと名付けた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした理想に近づくために、ＩＴＯＳには、ディスプレイに表示されるコンピューターからの問いかけに「はい」か「いいえ」で答え、処理の内容や手順を一覧表にしたメニューから選んでいくだけで、プログラムを作ったり処理を行ったりできる環境が盛り込まれていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンピューターの基本的な動作を一括して管理するＯＳに対応したプログラムは、ＯＳ側が用意している作業のメニューを利用して動くように設計することができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＯＳのメニューにないことを独自に工夫してやらせるようなことをしなければ、ＣＰ／Ｍ用のソフトはＣＰ／Ｍを載せたどのマシンでも使えるように書くことができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトの方向付けを評価していたラスキンは、マッキントッシュにもグラフィックスの強みを与え、メニューを採用したいと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "画面に表示した機能メニューをキーボードから選ぶ、マルチプランに採用された形式のインターフェイスを用い、ベーシックの搭載も予定されていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シモニーは、マルチプランにアルト流のメニューを持ち込もうと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "パロアルト時代、アラン・ケイの方向付けに深く親しんでいたシモニーは、マルチプランの画面の下に二行をとって「印刷」や「計算」といった項目を並べたメニューを用意した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "医療や法律関係、学校関係、果てはゴルフクラブにいたるさまざまな業種用のアプリケーションが書きためられており、ユーティリティーやプログラム開発用のシステム、言語などにもずらりと豊富なメニューがそろっていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウォズニアックにとって電源はパーツ屋から仕入れてくる単なる部品にすぎず、こうしたアナログ技術は彼のテクニックのメニューには含まれていなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "後藤にはウインドウの意味やメニュー、マウスの役割などあらためて説明する必要はなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがインターフェイスマネージャーと名付けたグラフィックスの互換性確保を目指すモジュールの開発をスタートさせた時点では、ゲイツと西はこのプロジェクトをウインドウやメニューを備えたアルト型の操作環境を実現するところまで拡張しようとは考えていなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただしメニューの組み込みに関しては、パロアルト研究所の出身者らしい自らの信念を通した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "シモニーはマルチプランの画面の下二行にメニューを並べ、命令を正しくタイプする代わりに次の動作をここから選ぶ道を付けて、操作を簡単なものとしようと考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルと呼ばれる集計表のます目を選ぶ動作や、メニューの選択は、マウスになじむ処理だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがＭＳ―ＤＯＳにマウスからの情報を取り入れるためのドライバーソフトを組み込み、ボタンを押すと画面上にメニューが現われるように仕立てたデモには、インターフェイスの新時代がまさに開けつつあることを実感させる衝撃があった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウインドウやメニューを用意する操作環境は、ＰＣ―１００には用意されていなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
