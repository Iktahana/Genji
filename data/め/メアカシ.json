[
  {
    "uuid": "a3e5dead-88a3-52bc-957d-2f88f038486f",
    "entry": "目明し",
    "reading": {
      "primary": "めあかし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
