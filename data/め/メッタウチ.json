    },
    "definitions": [
      {
        "index": 1,
        "gloss": "showering with blows",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ボクサーは相手にメッタ打ちを浴びせ、ノックアウトした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "強盗は被害者にメッタ打ちにして、現金を奪い去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "批判のメッタ打ちに遭い、彼は精神的に追い詰められた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ハムを　ゆかの　どまんなかに　おくと、　ひばしや　シャベルで　めったうち　――　ばん、　ばん、　がしゃん　ぐしゃん！",
              "citation": {
                "source": "わるねずふたりぐみのはなし",
                "author": "THE TALE OF TWO BAD MICE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライオン　ふん、こっちはお前を町中でめったうちにしたんだぜ、なあ？",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の黒いステッキを握ると、エザウの首っ玉をつかんでつるさげておいて、泣き叫ぶ小犬をめったうちにしながら、同時に憤懣のあまり我を忘れて、物すごくしゅうしゅういう声で、何度も何度もこういった。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
