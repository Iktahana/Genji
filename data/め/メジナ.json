        "examples": {
          "standard": [
            {
              "text": "磯釣りで立派な「眼仁奈」を釣り上げ、釣り仲間から歓声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「眼仁奈」の塩焼きは、身が締まっていて磯の香りが口いっぱいに広がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬の寒い時期に獲れる「眼仁奈」は「寒メジナ」と呼ばれ、特に脂が乗っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "なお、中めじ、大めじ、平めじなどというものなどについては、折を見て物語ることにしよう。",
              "citation": {
                "source": "鮪を食う話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
