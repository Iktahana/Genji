[
  {
    "uuid": "b2937b8f-cc38-5734-a0f2-58d71f638f89",
    "entry": "目くるめく",
    "reading": {
      "primary": "めくるめく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
