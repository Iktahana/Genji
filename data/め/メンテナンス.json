        "examples": {
          "standard": [
            {
              "text": "工場の製造ラインを安定して稼働させるには、日常的なメンテナンスが欠かせない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "Webサイトのメンテナンス画面が表示されている間、ユーザーはサービスを利用できない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「このソフトウェアは、開発よりもその後のメンテナンスにコストがかかる構造になっている」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「リンク」についてはメンテナンスにかかる手間から更新を中止、当初すすめていた相互リンクも現在はやっていない。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らが関心を持ったのは、価格であり、アプリケーションの品揃えであり、メインテナンスの面倒見であり、せいぜいが使い勝手と外側から見た限りでの機能だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫婦二人だけで始めた会社はこれまで、オフィスコンピューターの販売とメインテナンス、加えてマシンの納入先からの開発依頼をこなし、第二次オイルショック後の苦しい時期をどうにかこうにか乗り切ってきた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどいいかもしれないのよ」「いまの僕が三十八歳であることは確かだけれど」「メインテナンスはいいから、厳しい娘の目で見ても、四十代の後半と大差ないと思うわ、体は。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
