    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "プノンペンの街、タマリンドの街路樹、メコン河の流れ、シソワット王の城内、彼方には椰子の林があり、赫熱とした熱帯の強烈な太陽の直射と、熱風を避けた王城内でノラの母はシソワット王と廷臣の居並ぶ玉座のまえで、オーケストラと数十人の唄い手の歌声のなかで華麗な彼女はカンボジヤの踊りを舞うのだった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは台湾の※鯉、西大陸の食蟻獣、濠州のミルメコビウス（食蟻袋獣）、アフリカの地豚と等しく、長き舌に粘液あり、常に朽木の小孔に舌をさし込めば、白蟻輩大いに怒りてこれを螫さんと集まるところを引き上げ食い尽す。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "暹羅の南、交趾支那の北、これぞ王国柬埔寨の位置で、メコン河の下流、トッテサップ湖の砂洲に、首都プノンペン市は出来ていた。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑彌呼の語解は本居氏がヒメコの義とするは可なれども、神代卷に火之戸幡姫兒千々姫命、また萬幡姫兒玉依姫命などある姫兒に同じとあるは非にして、この二つの姫兒は平田篤胤のいへる如く姫の子の義なり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "卑彌呼と故さらに一字を違へたるもヒメコの意にあらざるが爲か。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "余が此篇を出せる直後、已に自説の缺陷を發見せし者あり、即ち卑彌呼の名を考證せる條中に古事記神代卷にある火之戸幡姫兒、及び萬幡姫兒の二つの姫兒の字を本居氏に從ひて、ヒメコと讀みしは誤にして、平田氏のヒメノコと讀みしが正しきことを認めたれば、今の版には之を改めたり。",
              "citation": {
                "source": "卑彌呼考",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリタケ、ウスタケ、アンズタケ、その他食用になるのがいろいろ出るが、ナメコはこの山には出ない。",
              "citation": {
                "source": "山の秋",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ウン、テキガ　セメコンダノカモ　シレナイ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメコオバサンハ　マルコオバサンノ　ウチヘ、ノソリノソリト　ハツテ　ユキマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マルコオバサンハ　セツカク　カメコオバサンガ　キタノダカラ、オキヤクサマノ　マヘデ　ネムツタラ　タイヘン　シツレイダ　トオモヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、イヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カメコオバサンガ　イヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カメコオバサンガ「イイエ――ヤツパリ――ハデ――デスワ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコオバサンガ「マア――ソンナ――コト――」　カメコオバサンガ「ダツテ――イイエ――ヤツパリ――」　ソシテ　フタリトモ、コヱガ　ダンダン　チヒサクナリ、クチガマワラナクナリ、ヤガテ　グツスリ　ネムリコンデ　シマヒマシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメノ　カメコオバサンハ、キンジヨノ　マルコオバサンノウチヘ、ノソリノソリト　ハツテユキマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノウチ、カメコオバサンモ　トロトロト　マブタガ　オモクナリマシタ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメコオバサンハ　オホキナ　アクビヲ　カミコロシナガラ、「デモネエ、ワタクシ　スコシ　ハデスギヤシナイカト　オモフノデスケレド。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イヒマスト　カメコオバサンハ「イイエ、ハデデスワ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　イフト　カメコオバサンガ「イイエ――ヤツパリ――ハデ――デスワ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カメコオバサンガ「ダツテ――イイエ――ヤツパリ、ムニヤ、ムニヤ――。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　マイニチノヤウニ　カメコオバサンハ　マルコオバサンノ　トコロヘ　サウダンニ　ユキマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "預メコレヲ為サバ如何ト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紀州牟婁郡大雲取ヲ過ギ口色川村ヨリ山路ニ到リ僅ニ両三根ヲ得タリ羊歯科ノ小草ニシテ全形エウラクゴケニ似テ葉背ニ数点ノ花実ヲ着ク今回発検ノ一ニシテ珍草ト賞スベキ者ナリ」　そしてその時これにコケシダの名が下され、なお一名としてヨウラクシダ、ムカデシダ、ヒメコシダならびにナンキンコシダの名も付けられた。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「此術ハ一金ヲ他金上ニ沈着セシムル者ニシテ金銀銅鐵石木ヲ撰バズ新古ニ拘ラズ其上ニ彫刻スル所ノ者ニ銅ヲ着カシメコレヲ剥ギテ其形ヲ取リ以テ其數ヲ増ス次圖ハ其製式ナリ」とあつて、以下は幾つも圖解して綿密に説いてある。",
              "citation": {
                "source": "光をかかぐる人々",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "御宅へ御邪魔して、神戸へ戻り、メコちゃんという、屋台の焼とり屋で、一本コップ酒、四本の、かわつきのとりを食べ、そこから、七十円で帰ったの。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メコちゃんのところで、私は、こんな会話を、知らない客といたしました。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メコちゃんのところで、私は、こんな会話を、知らない客と致しました。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            }
          ]
