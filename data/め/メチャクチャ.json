          "literary": [
            {
              "text": "実に気立てのいい編集者が、メッチャクチャに人の原稿を変えるのだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから市街へとびこんでメッチャクチャ暴れたとさ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの、牛（ギュウ）には違いないが、牛肉では絶対にないところの、牛のモツや、皮や（角は流石に用いなかった）その他を、メッチャクチャに、辛くコッテリ煮詰めた奴を、飯の上へ、ドロッとブッかけた、あの下司の味を、我は忘れず。",
              "citation": {
                "source": "下司味礼讃",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
