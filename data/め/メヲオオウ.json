        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その悲惨な事故の光景は、目を覆いたくなるほど痛ましかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ホラー映画の残酷なシーンに耐えきれず、彼女は思わず目を覆った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "事故現場の凄惨な状況は、思わず目を覆いたくなるほどだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "聞いているうちに今まで目を覆うていた鱗がぽろりと落ちて、目の前が急に明るくなって来たような気がした。",
              "citation": {
                "source": "鰊漁場",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この稀有の大出水によって、下流沿岸地方で蒙った被害は、実に目を覆うばかりの惨状を呈した。",
              "citation": {
                "source": "亡び行く国土",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、カルクマンは手をあげて制して、「目を覆うなかれ」と言った。",
              "citation": {
                "source": "秘密礼拜式",
                "author": "アルジャナン・ブラックウッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "国語の現状に目を覆うて、徒に空疎な幻影を目標として国語教育を考へる時、国語教育は非常な危険に曝される。",
              "citation": {
                "source": "国語学と国語教育",
                "author": "時枝誠記",
                "note": "青空文庫"
              }
            },
            {
              "text": "空想ばかりに秀でた人たちは、この点で、聖書にて翼で両目を覆うように表現されている、天使たちに例えられる。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
