[
  {
    "uuid": "770ce8fd-3fe4-59fe-95a6-9e2712b255de",
    "entry": "巡る",
    "reading": {
      "primary": "めぐる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ラ行",
        "動詞-自動詞"
