    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ユライ芸術トハ、コンナモノサ、譬噺デモナシ、修養ノ糧デモナシ、キザナ、メメシイ、売名ノ徒ノ仕事ニチガイナイノダ、ト言ワレテ、カエス言葉ナシ、素直ニ首肯、ソット爪サキ立チ、夕焼ノ雲ヲ見ツメル。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "目指すべき機械化された個人用のファイル・図書管理システムを、仮にメメックス（memex と名付けたブッシュは、この装置の具体的な仕様を思い描いた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "メメックスは一見すれば、傾いたディスプレイとキーボード、ボタンやレバーの付いた机である。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "メメックスの機能の中で特に重要であるとブッシュが考えたのが、参照の機能である。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "人類が争いによる自滅を免れるとすれば、メメックスのような道具が何らかの用を果たすのではないかと、原爆の投下を目前に控えた時点でブッシュ★は考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした経歴を確認したのち、メメックスの構想を見直すと、あらためてブッシュの「本気」が伝わってくる。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブッシュがメカニズムを用いてメメックスを実現しようとしている点は、現時点で振り返って一見すれば構想の非現実性を印象づけるかもしれない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが最後のパネルディスカッションの席上、横に座ったアラン・ケイと二人きりで話し込むようにメメックスのアイディアに初めて触れた当時のことに小声で言及しはじめ、「人類は障害物だらけの急流を乗り切っていかなければならない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブッシュの思い描いたメメックスのようなシステムを作りたいと考えた彼は、ＮＡＣＡをやめてカリフォルニア大学バークレー校の大学院に入り、コンピューターと対話するように作業を進めるためのソフトウエアの研究に取り組んだ。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　タウトウ　イチバン　イタダキニ　ヰタ　ツボミガ　オメメヲ　ヒライテ　花ニ　ナリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウ　シタノデセウ」「マダ　ネンネシテルノカシラ」「ワタシタチガ　モウ　オメメヲ　ヒライタ　コトヲ　シラナイノカシラ」「モウ　ハルガ　キテルノヲ　シラナイノカシラ」　ソコデ　花タチハ　マダ　ヒラカナイ　ツボミヲ　オコシニ　カカリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ　ヒラカナイ　ツボミサン　モウ　ハルデスヨ、オンモニ　デテ　イラツシヤイ」「マダ　ネンネシテル　ツボミサン　オメメヲ　サマシナサイ」　スルト　ツボミガ　コタヘマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はメメズと呼ばれると、いつでもこの長い身体が半分位にちぢまってしまうのだ。",
              "citation": {
                "source": "みみず先生の歌",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メメズ小僧は、いねえだろうな？",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "メメズ小僧とはよく云った。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ゃあのガキをウチへ泊めるぐらいなら、ホンモノのメメズと一しょにドブへねる方がマシだよ」　そこで金サンは隣の床屋へでかけた。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると、自分の倅のことだから、メメズ小僧と正坊の対局よりも心配だ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "マキはたしかに二割引で売って下さるんでしょうね」「売ってはやるが、メメズ小僧は負けやしまいな」「負けるもんですか。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムムンツの金属 Muntz metal.無線電信および電話 Wireless telegraphy and telephony.メメリボルン男（人）Lord Melbourne. ウィリヤム。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "その要旨がメメント　モリという短い死の戒告に結晶せられたのであろう。",
              "citation": {
                "source": "メメント　モリ",
                "author": "田辺元",
                "note": "青空文庫"
              }
            },
            {
              "text": "今や改めて、メメント　モリの戒告に従い、それを実行しなければならぬ時機に、追詰められて居るわけである。",
              "citation": {
                "source": "メメント　モリ",
                "author": "田辺元",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が来て、露の落ちる時、ウルリックはコンラに云った「天馬リメメエンが星の中を駆けている、泡が彼の口から落ちて来る」　コンラは落ちる露を感じた。",
