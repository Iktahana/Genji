        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おかあさんはメキネズさんの所へ奉公していたんです。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「メレリさんはメキネズさんの所へゆかれた。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メキネズさんはここにいますねえ？",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メキネズさんはコルドバへ行きましたよ。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それならそのメキネズさんのところにいた女の人はコルドバという都へゆきましたよ。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "コルドバへゆけばメキネズの家もお前のおかあさんも見つかるだろうから、それからこれをおもち。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は停車場の人にメキネズの家はどこにあるかききました。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何か用がありますか」「メキネズさんはいますか。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メキネズさんはツークーマンへゆかれた。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　マルコの母親は病気にかかってメキネズの立派なやしきにねていました。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがメキネズは思いがけずブエーノスアイレスから遠くへ出かけねばならなくなりコルドバへきたのでした、その時母親は腫物が体の内に出来たので外科のお医者さんにかかるためツークーマンに見てもらっていたのでした。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ちょっとおたずねしますがメキネズさんの家はどちらでしょうか。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　男の人はちょっと考えていましたが、「メキネズさんはここにはいないよ。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "川のそばの大きな砂糖工場がたっているところにメキネズさんの家がある。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "メキネズ夫婦もそれをすすめました。",
              "citation": {
                "source": "母を尋ねて三千里",
                "author": "アミーチス",
                "note": "青空文庫"
              }
            },
            {
              "text": "『こんな騒ぎがリスボンに起つて、ポルトガルの高い山々が揺れてゐた間に、モロツコ、スエズ、メキネズなどといふアフリカのいろんな都市が顛覆されて了つた。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
