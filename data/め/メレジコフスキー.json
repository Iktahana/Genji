        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だがそれは又直ちにトルストイとドストエフスキーとの比較ともなる（メレジコフスキーの批評の如き）。",
              "citation": {
                "source": "クリティシズムと認識論との関係",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれはメレジコフスキーが指摘するようにもっと凄く、もっと陰惨なものをもっている。",
              "citation": {
                "source": "探偵小説の芸術性",
                "author": "――文学のメカニズム――",
                "note": "青空文庫"
              }
            },
            {
              "text": "メレジコフスキーも云つたやうに、トルストイ程人を愛しようと努めた人は少い。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しメレジコフスキーも疑つたやうに、トルストイは終に人を愛する事が出來たか。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メレジコフスキーは其鋭利にして淺薄なる洞察を以つて――俺は此大膽なる斷定を敢てする――トルストイの本質を異教的な心だと斷じた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し假令トルストイの心がメレジコフスキーの説のやうに本來異教的な心だとしても、猶世界史上に於ける異教主義が基督教に轉移するには、果して異教主義そのものゝ中に此轉移を至當にする必然性がなかつたらうか。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
