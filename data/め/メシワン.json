    "definitions": [
      {
        "index": 1,
        "gloss": "bowl used for serving rice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
