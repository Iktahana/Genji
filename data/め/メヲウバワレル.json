        "examples": {
          "standard": [
            {
              "text": "美術館に展示された巨大な油絵の迫力に、すっかり目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "突然夜空に打ち上がった色鮮やかな花火に、会場の誰もが目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼はパーティ会場に現れた美しい女性に一瞬で目を奪われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "われわれの目はただ西洋のえらい大家の持ち扱い古した、かびのはえた月並みの現象にのみ目を奪われる。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "察するに一方は、路花墻柳の美に目を奪われるの甲斐無きことをあげて、修身斉家の大切なことを、それとなく諷したに違いない。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、レースをたのしむ者の身にしてみると、抜かれたり、抜きかえしたりの力、あの振幅の限度にみなぎる力の大きさ、美しさに目を奪われるのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛が苦しみだなんて――」　ほんとうに、伸子のまわりのどこに、愛の発露とはこうもあろうか、と、目を奪われる眺めがあるだろう。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
