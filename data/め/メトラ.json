        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アガメムノーンとメネラオス、アトリュウス生む兩子息、　470之に醇酒の千「メトラ」ユウネーオスは贈り來ぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴兄の真の旧友にしてアルモンシン＝メトラトンの僕たる、ジョセフス　Ｃ.シモン・オーン殿、ウィルアムズ小路、セーレム　かなり奇妙なことだが、この手紙によって初めてウォードはカーウィンの家のプロヴィデンスにおける正確な位置を知った。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルモンシン＝メトラトンの兄弟よ：――　本日貴兄よりの書簡拝受。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国犯罪学者メトラス博士」「ああメトラス博士か」春田博士が傍からいった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍介は遂にメトラス博士の招待を受けることに決心した。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいかね、メトラス博士の部屋は二階の五号、そらあの左から三番目の明るい窓がそうだ。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は並木のかげに身をよせて、じっとメトラス博士の窓を見守るのであった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "轟然二発のピストル　龍介がホテルへ着くと、礼服を着た立派な三人の外国人が出迎えて、叮嚀にメトラス博士の室へ案内した。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メトラス博士です」先の外国人が龍介にそう告げた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メトラス博士は、らんらんと輝く鋭い眸で、じっと龍介を見た。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メトラス博士が、誰か貴方におひき合せしたいと申していられますから」　龍介は頷いて立ち上がった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メトラス博士は正面の大｜卓子に向かってすわっていた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそもメトラス博士とは何者か！",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "龍介がホテルへ入って行ってから三十分もしたと思うころ、注意していたメトラス博士の部屋の窓が突然暗くなったのを見た。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜、長男の龍介がメトラス博士に招待されたまま日本ホテルから行方不明になって、まだい所も知れぬので、博士の心配は並々ではなかったが、そうかといって秘密試運転を延期するわけには行かなかった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっ墜落だ　メトラス博士の室で、闇の中に強烈な格闘を始めた龍介はどうなったか。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすればこの骸骨島も娘もあの春田博士も粉微塵よ」「で、おいらはメトラス博士にＣ・Ｃ・Ｄ潜水艦を売って日本をずらかるんだ。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてメトラス博士というのは、実はＣ・Ｃ・Ｄ潜水艦の秘密をぬすみにきた、外国の軍事探偵だったのだ」　文子には、すべての事が分った。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メトラス大狼狽「大変だ！",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「チャアリイ、是ゃどうしたのだ」　覆面をとるとそれはあのメトラス博士だった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」メトラス博士は頷いた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ではあのぶん捕ったＣ・Ｃ・Ｄ潜水艦で遁げられるだけ遁げてみよう、来い」　そう云うと、メトラスは先に立って、チャアリイを導いた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "下ではメトラス博士とチャアリイが待受けていた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とメトラスが喚いた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう駄目だメトラス、チャアリイも覚悟をしろ、今度こそは逃がさんぞ※」「貴様こそ叩っ殺してやる」　云いざま混血児チャアリイが隠し持った拳銃を、取出すよと見る、パッ！",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "畜生」と呻りながら、鼠のようにメトラス博士へ跳びかかった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」向うで壮太が声をかけた「それじゃ拳骨壮太のお株を横取りするようなもんですぜ※」　かくて混血児チャアリイ、メトラス博士の二人は、濡雑巾のように打倒されてしまった。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへＣ・Ｃ・Ｄ潜水艦を取戻し、メトラスとチャアリイを捕縛して龍介と壮太が帰って来たので、一同は歓呼の声をあげて、横須賀へ帰航の途についた。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからメトラス博士と云うのは、あのヤンセン牧師と同じ、××国から廻されて来た軍事探偵で、常に要塞地帯の写真などを撮らせていたのですが、それらは凡べて今度抑えてしまいました。",
              "citation": {
                "source": "骸骨島の大冒険",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
