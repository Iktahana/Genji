          "literary": [
            {
              "text": "タトエバ我々ノ映画事業ニシテモ、何カ会ダノ組織ダノガデキルタビニ、ズラリト重要ナ椅子ヲ占メラレルノハ、必ズ、全部ガ全部映画ニハ何ノ関係モナイ人バカリデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンデシマエバ何処ニ埋メラレタッテ構ワナイヨウナモノダケレドモ、今ノ東京ノヨウナ不愉快ナ、自分ニ何ノ因縁モナクナッテシマッタ土地ニ埋メラレルノハイヤダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
