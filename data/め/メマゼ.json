        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "上司と部下が目交ぜし、互いの意図を確認し合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "遠くから彼女と目交ぜを交わし、秘密の合図を送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は冗談を言うたびに、こっそり私と目交ぜをする癖がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その後から、三人の刑事は、何か目交ぜをして、薄笑いながら跟いて行った。",
              "citation": {
                "source": "三稜鏡",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――出ると同時のように、あちらから二人、こちらから三人、全部では二十名近くの面々が、いずれも異常な緊張を示してにょきにょきと姿を現しながら、互いに目交ぜをしつつ、再び退屈男のあとをつけ始めました。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、つまりながらもちらりと何か目交ぜを送ったかと見るまに、笑止です。",
              "citation": {
                "source": "旗本退屈男　第七話",
                "author": "仙台に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　顔から顔へ名を呼ぶように目交ぜが飛ぶと、近侍達は一斉に傍らの脇差をにぎりしめた。",
              "citation": {
                "source": "十万石の怪談",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その向う角の、川に向いた一軒の、　お江戸お名残り、めずらし屋　と、少し横にすねたような行灯のみえる小料理屋の門の前に止まると、新兵衛は、頤をしゃくるようにして目交ぜをし乍ら、さっさと中へ這入っていった。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやじによく言ってやれ」　立ちあがろうとしたのを、慌てて新兵衛は、目交ぜで止め乍ら、まだなにか言いたそうに、もじもじとしていたが、平七の顔いろを窺い窺い、女を隣りの部屋へつれて行くと、小声でひそひそとなにかささやいた。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを裏書するように、花簪の小女が、最後の料理を持って来て並べて了うと、ちらりと新兵衛に目交ぜを投げておいて、かくれるように向う端の暗い部屋の中へ這入っていった。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "互にまともな結婚もなかなかできない下級サラリーマンとウーマンとが、自分たちのゆがめられしぼられている小さい恋の花束を眺めて、野暮に憤る代りに、肩をすくめ、目交ぜし合い、やがて口笛を吹いてゆくような新らしげな受動性。",
              "citation": {
                "source": "新しい一夫一婦",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おてふさん」「見たわ、ねえ」　てふは、さも二人だけがあれを知ってるのよと合図するように得意で縫子に目交ぜをした。",
              "citation": {
                "source": "縫子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の中の灯は醉ひにかすんだ美しい女の眼のやうに、おぼろな花の間に華やかな光りと光りを目交ぜしてゐた。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　アグーシャが、アンナの目交ぜにききかえし、訝しそうに自分の膝の下で寝ころがってる信吉の顔を見下した。",
              "citation": {
                "source": "ズラかった信吉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の夜旅というやつも酒落たものだ」「へ、でも……」　と仁三と久六と、ちょっと厭な目交ぜをしたが、伝吉は涼しい顔で、折から明るみかけた月を後ろに澄まして行く。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の夜旅というやつも洒落たものだ」「へ、でも……」　と仁三と久六と、ちょっと厭な目交ぜをしたが、伝吉は涼しい顔で、折から明るみかけた月を後ろに澄まして行く。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈都子さんだって、大隈伯なんて、おじいちゃんの顔なぞ、見たくないわね」「え……でも……何でしょう」　目交ぜで、クスリと笑っていると、理平は、新聞に眼を突かれたように、ガチリと、珈琲茶碗をおいて、「おい、こら、お前たちゃ、きのう船渠会社へ何しに行ったんじゃ。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「癖になる」　目交ぜして、頷きあうと、無理に弥太郎をゆり起した。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "稲吉は目交ぜで立って、つかつかと連中の前へ行き、揉み手をしながら、「エエ親方」　と、喋舌っていた男の前に小腰をかがめました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃあ……」「うム、また逢おうぜ」　目交ぜで別れて、秦野屋は風のごとく馳け去りました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その和田峠から、とんだ目にあいましてね」「ま、そこではなんでございますから、さ、どうぞこっちへ」「新吉や」と、手代の方へ目交ぜをして――「お前も早くこッちへ体を隠したがよい。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "木曾の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おい」　悪四郎は後ろの仲間となにか目交ぜし出していた。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "また虹のいろの如く原色を染めまぜた毛糸の束は不思議な印象を与えたものである。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼に見えない誰かを空に描いて、そのものに得意なめまぜでもするような、満足げな微笑であった。",
              "citation": {
                "source": "饒舌り過ぎる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いって下さい」とおりつはめまぜをしながら云った、「すぐに御飯を持っていきます」　茂次は廊下へ出ていった。",
              "citation": {
                "source": "ちいさこべ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなふうに思うようすが、互いのめまぜのなかにあらわなくらい出ていた。",
              "citation": {
                "source": "契りきぬ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "としとって、お前が然るべき重職に就いた時、人はお前の昔のカンニングは忘れても、落第の事は忘れず、何かと目まぜ袖引き、うしろ指さして笑います。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "沢山の汚名を持つ私を、たちの悪い、いたずら心から、わざと鄭重に名士扱いにして、そうして、蔭で舌を出して互に目まぜ袖引き、くすくす笑っている者たちが、確かに襖のかげに、うようよ居るように思われ、私は頗る落ちつかなかったのである。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分よりは教師に容易く口の利ける妹に、用意万端整ったことを教師に告げよと、目まぜをする。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまは、ちょっと母屋の気配いを覗う様子を見せましたが、わたくしに目まぜすると、わたくしを抱き上げて手早く部屋の中へ入れ、自分は外へ気を配りながら、わたくしの後に控えました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに自分のはしたない身なりが気になったので、寛三にそっと目まぜして帰って行こうとした。",
              "citation": {
                "source": "勝ずば",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其處へ、門内の植込の木隱れに、小女がちよろ／＼と走つて出て、默つて目まぜをして、塀について此方へ、と云つた仕方で、前に立つから、ござんなれと肩を搖つて、足を上下に雀躍して導かれる、と小さき潛門の中へ引込んで、利口さうな目をぱつちりと、蒋生を熟と見て、「あの、後程、内證で御新姐さんが。",
              "citation": {
                "source": "麥搗",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　小芳はさッと青ざめ、兄の方へ目まぜを送ると、小声で囁きました。",
              "citation": {
                "source": "旗本退屈男　第十一話",
                "author": "千代田城へ乗り込んだ退屈男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
