[
  {
    "uuid": "c1b9589b-49db-59b1-b8dc-ba132833286b",
    "entry": "面朱",
    "reading": {
      "primary": "めんしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
