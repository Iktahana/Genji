        "examples": {
          "standard": [
            {
              "text": "あまりの惨状に、思わず目を背けてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "凄惨な事件現場の写真を突きつけられ、彼は耐えきれずに目を背けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "眩しすぎるライトの光に、彼は思わず目を背けて手で顔を覆った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
