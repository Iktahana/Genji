        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "現実から目を背けるのではなく、立ち向かう勇気が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "孤独な現実から目を背けるために、彼は夜通し賑やかな街を歩き回った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
