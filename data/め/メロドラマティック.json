          "literary": [
            {
              "text": "その生硬さ、メロドラマティックな筆致においても。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学作品で云えばメロドラマティックな誇張に陥るのではないかと、母の筆勢論には消極なうけこたえしか出来なかった。",
              "citation": {
                "source": "母",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "情景のとらえかたは極めてメロドラマティックで、このごろの大衆小説の一部にあらわれているヤミやものにやや近くなった。",
              "citation": {
                "source": "予選通過作品選評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "劇場でのメロドラマティックな出会。",
              "citation": {
                "source": "チェーホフの短篇に就いて",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
