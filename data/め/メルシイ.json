        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「メルシイ」と云って綾小路が吸い附けた。",
              "citation": {
                "source": "かのように",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は勇躍してボナミとかマドモアゼル、ウイメルシイとか片言を並べつつ近附いて行った。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕にも或婆さんが振撒いたから追掛けて行つて襟元へどつさり入れて遣ると「メルシイ」と礼を言はれた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人が物を云ひ掛けますと私はいい加減に、「セツサ」とか「メルシイ」とか「ウイ、ウイ」とか云ひながら良人の傍へ出て来ました。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にもレオ・ラルゲエやエル・メルシイやジユル・ロオマン等を褒めた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ノン・メルシイ。",
              "citation": {
                "source": "舞踏会",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポーランドは、「メルシイ、メルシイ」と云つてＹの手を握つた。",
              "citation": {
                "source": "北支物情",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寿　　オー・ノン・メルシイ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうじき十三になるのに、ローリイはあたしを子供あつかいにし、ひよこさんといったり、あたしがフランス語で、メルシイ（ありがとう）とか、ボンジュール（こんにちは）とかいうと、ぺらぺらとフランス語をしゃべってこまらせます。",
              "citation": {
                "source": "若草物語",
                "author": "LITTLE WOMEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
