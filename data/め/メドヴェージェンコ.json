        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "散歩がえりのマーシャとメドヴェージェンコ、左手から登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　あなたは、いつ見ても黒い服ですね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　なぜです？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　そりゃ、理論ではね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　そう。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　欲しくないです。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（マーシャとメドヴェージェンコを見て）皆さん、始まる時には呼びますよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（メドヴェージェンコに）さ、行きましょう！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　（トレープレフに）じゃ、始まる前に、知らせによこしてください。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナがソーリンと腕を組んで、つづいてトリゴーリン、シャムラーエフ、メドヴェージェンコ、マーシャが登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　何がなんでも、霊魂と物質を区別する根拠はないです。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（並んで歩いているメドヴェージェンコに）完全に一オクターブ低いやつでね、「ブラボー、シルヴァ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　給料はどれくらいでしょうかね、クレムリンあたりの歌うたいだと？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとからメドヴェージェンコが、空っぽの肘かけ椅子（訳注　車のついた）を押してくる。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　ソーリンさんは、タバコをやめるべきでしょうな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（メドヴェージェンコと二人で椅子を押す）ああ、ほんとに厭だこと！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコのところへ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……頭に包帯したトレープレフと、メドヴェージェンコ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ひと休みして出かける……論より証拠だ……（杖にすがりながら歩く）メドヴェージェンコ　（腕を支えてやりながら）こんな謎々がありますよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやありがとう、もう一人で行けますよ……メドヴェージェンコ　ほらまた、そんな遠慮を！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ、やがてソーリン、メドヴェージェンコ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）メドヴェージェンコ　僕は停車場まで歩いて行きます……お見送りにね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコとマーシャ登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あの人がいないじゃ、生きてられないのね……メドヴェージェンコ　孤独がこわいんだ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　庭はまっ暗だ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーシャ　また、あんなことを……（間）メドヴェージェンコ　うちへ帰ろう、マーシャ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　（哀願するように）マーシャ、帰ろうよ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）メドヴェージェンコ　可哀そうだ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　帰ろうよ、マーシャ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "メドヴェージェンコ　お前のお父さん、僕にゃ馬を出してくれないよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
