      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "looks",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "久しぶりに再会した恩師の面容には、年月が刻んだ深い皺が刻まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "写真に写る若き日の祖父の面容は、今の父と驚くほどよく似ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女の穏やかな面容を見ているだけで、こちらの心まで落ち着いてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「なんじら断食するとき、偽善者のごとく、悲しき面容をすな。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ルヤ、君、断食ノ苦シキトキニハ、カノ偽善者ノ如ク悲シキ面容ヲスナ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寂しいときに、寂しそうな面容をするのは、それは偽善者のすることなのだ。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）なんじら断食するとき、かの偽善者のごとく、悲しき面容をすな。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、しばらく、かの偽善者の面容を真似ぶ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「汝は彼を永く攻めなやまして去り往かしめ、彼の面容を変らせて逐いやり給う、その子貴くなるも彼はこれを知らず、卑賤くなるもまたこれを暁らざるなり、ただ己みずからその心に痛苦を覚え己みずからその心に哀くのみ」という。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くも彼は仕事に向ひ、その面容もほがらかに、大きな鋸を押したり引いたり、その幼い手で、多くの板を挽いたのだつた。",
              "citation": {
                "source": "ランボオ詩集≪学校時代の詩≫",
                "author": "VERS DE COLLEGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから間もなく小野梓君が帰朝したから、早速逢ってみると、義兄の肥満にして豪放なるに反し体格も小さく肉も痩せて、むしろ豪傑肌の人間とは外見は違っているが、俊傑たることは一見その面容に表れている。",
              "citation": {
                "source": "東洋学人を懐う",
                "author": "大隈重信",
                "note": "青空文庫"
              }
            },
            {
              "text": "――じつ申せばわれ始めのほどは到底、勝戦なきを思ひひそかに将軍（尊氏）を討たむものとちかひ居しがそのをり将軍の形質を看たるに面容優長にしてげに大人の風貌｜備はる天下の器としてこの人、何の不足かあらむと即座に幕下たるを決したるなり。",
              "citation": {
                "source": "私本太平記",
                "author": "筑紫帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "如斯ことはきょう始めてと云うではないが見る度に胸がふさがるべくおぼえ何と云うて慰さめんようもなく身も世もあらぬ思である。",
              "citation": {
                "source": "根岸庵訪問の記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "税金を期日までに納めんような者が、お前、息子を中学校へやるとは以ての外じゃ。",
              "citation": {
                "source": "電報",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "書き漏らした事をもう一つ、――今夜はどうしたわけか、やたらに溜息がでる、はてめんような、これは何の溜息でござるか！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "水力の利用もよし、風力応用もよし、あらゆる天然の力を利用して工業の発達を計り富源開発には国民挙げて計画しつつあるが、まだまだ深く潜める無限の精神を開発することは吾々教育家も未だ力を込めんように私は感ずる。",
              "citation": {
                "source": "教育家の教育",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼火バシを目にさしこむのごめんよう。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "――結局二人｜藻抜けの殻みたいにさして、この世の中に何の望みも興味も持たんと、ただ光子さんいう太陽の光だけで生きてるように、それ以外に何の幸福も求めんようにさしたいいうことになるのんで、薬飲むのん厭がったりしたら泣いて怒んなさるのんです。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
