        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すでにうちの車は無し、メイタクで帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "四時近く迄ゐて、銀座でメイタクを拾ひ、帰宅。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野からメイタク、浅草公園は歓楽区域とあって遠くで下ろされる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひらめのさしみと湯豆腐を食ひ、メイタク拾って帰宅、銀座より小滝橋まで五円也。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕休みのために、金語楼劇団が出てる、うちの渡辺・高杉・杉を貸してるので、楽屋へ一寸寄り、それから彼等の芝居を見て、ホテ・グリへ寄り、軽く食事し、メイタクで帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "省線で高田馬場へ出て、メイタク、橘の家へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
