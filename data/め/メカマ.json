          "literary": [
            {
              "text": "目蒲電車は事故を起して、単線の折返し運転。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "車といっても近頃は間に合わないので、省線、目蒲線と乗継いで行くのが、もどかしくて仕方がありません。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから毎日のように潤三郎の家へ行きます内に、並木の桜の花が咲き、それがまた忽ち盛りを過ぎて、目蒲線を往復する電車の屋根を白くするようになりました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
