        "examples": {
          "standard": [
            {
              "text": "強風に煽られながらも、船員たちはメーンマストに新しい帆を張り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古い帆船の模型を組み立てる際、最後にメーンマストを慎重に立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "嵐の中でメーンマストがへし折れ、船は航行の自由を失ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "海上遠くメーンマストの上で、茂太郎は、「七兵衛おやじが、走るわ、走るわ」とわめき立てたことがありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "待望の日の丸は、いつまでも、メーンマストに翻らない。",
              "citation": {
                "source": "ものは考えよう",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この無名丸のメーンマストの下には、柱を囲んで幾人かの人が嬉々として語り合っているのを見ます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず、メーンマストの下を囲んだのは、これだけの面ぶれのようです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
