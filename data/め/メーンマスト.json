        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "強風に煽られながらも、船員たちはメーンマストに新しい帆を張り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古い帆船の模型を組み立てる際、最後にメーンマストを慎重に立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "嵐の中でメーンマストがへし折れ、船は航行の自由を失ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "海上遠くメーンマストの上で、茂太郎は、「七兵衛おやじが、走るわ、走るわ」とわめき立てたことがありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "待望の日の丸は、いつまでも、メーンマストに翻らない。",
              "citation": {
                "source": "ものは考えよう",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この無名丸のメーンマストの下には、柱を囲んで幾人かの人が嬉々として語り合っているのを見ます。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず、メーンマストの下を囲んだのは、これだけの面ぶれのようです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばんの本家は、船のメインマストになりました。",
              "citation": {
                "source": "空とぶトランク",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "何がいるって」「メインマストの上のあたりをごらんなさい。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜巻かな、いや竜巻じゃない」　船長はおどろいて、メインマストが見えるところまで船橋の上を大またでとんで行って、上をあおいだ。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おそろしい大怪物が、メインマストの上でくわっと口を開き、こっちをねめつけているのを。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "メインマストの国旗。",
              "citation": {
                "source": "踊る地平線",
                "author": "虹を渡る日",
                "note": "青空文庫"
              }
            },
            {
              "text": "凪いだ日にはわたしは好んで船尾の手摺にもたれかかったり、メインマストによじのぼったりして、静寂な夏の海の胸にだかれて数時間もずっともの思いに沈んだものだ。",
              "citation": {
                "source": "船旅",
                "author": "ワシントン・アーヴィング　Washington Irving",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳も聾せんばかりの大爆発とともに、今の今まで艦長がメガホンを執っていた司令塔も前部砲塔も濛々たる白煙に包まれて、メインマストのキャップからもスカイライトからも激しく火焔が噴き出してくる。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
