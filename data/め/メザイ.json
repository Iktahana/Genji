        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コメザイ　佐渡の島の中部で、米の屑のことをいふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "語の起りは米のサイでは無く、メザイに「小」を冠したものらしい。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張の日間賀島でも、メザイとコゴメとは同じで、是と小麥糟、大豆の粃などを合せ蒸して糠味噌を作るといふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は又麥のメザイもある。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コメザイ　佐渡の島の中部で、米の屑のことをいう。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "語の起りは米のサイではなく、メザイに「小」を冠したものらしい。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "尾張の日間賀島でも、メザイとコゴメとは同じで、これと小麦｜糟、大豆の粃などを合せ蒸して糠味噌を作るという。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいはまた麦のメザイもある。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
