          "standard": [
            {
              "text": "夢や目標を失った人々は、しばしば目が死んでいるように見える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その事件の被害者は、憔悴しきって目が死んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「最近の君は目が死んでいるよ」と友人に言われ、ハッとして自分の生活を振り返った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "第一目が死んでいる。",
              "citation": {
                "source": "恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻は外出着を召し、笑顔を浮かべ、進み出たそのとき、夫の目が死んでいるのを見て、のけぞった。",
              "citation": {
