      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "Pacific barrelfish (Hyperoglyphe japonica)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今夜の夕食は、新鮮な目鯛の煮付けにしよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "釣りの名人である彼は、見事に大きな目鯛を釣り上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "目鯛は身が締まっていて、刺身にしても美味しい魚だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その他江の島沖の金目鯛、逗子沖のソーダ松魚といふやうなものになると、一日何貫と釣れることもあるから、力の強い、剛快な人はやるのもよいが、真に竿で釣りを愉しむ者にはどうかと思はれるのである。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『だめだい、そんなにのびあがつては。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だめだい、そんなこと。",
              "citation": {
                "source": "どんぐりと山猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『だめだい、そんなにのびあがっては。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら、ああ明るくなった」　「だめだい。",
              "citation": {
                "source": "おきなぐさ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら、ああ明るくなった」「だめだい。",
              "citation": {
                "source": "おきなぐさ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だめだい半分ぐらい云っておいていけないったら蜂雀　ね。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奥さんに、奥さんに、お願いなさいよ、」　　　　　　　四十三「何を、奥さんに頼めだい、黙れ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あ、何度めだい、また握手した。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なにが、お国のためだい」「なにさ、俺だちが、こうして悪い奴をとっちめるのも、やっぱりお国のためだと、今、大将と話したところだ」　半ちゃんはやっと判った。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、貴方の不具な部分をもってせずには、誰一人博士に、自殺の証跡を残して、息の根を止めることは不可能だったのですよ」「すると、敷物の波は何のためだい」熊城が横合から訊ねた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すると、前室の湯滝を作ったのは、何のためだい。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おーい、その曲はだめだい」　上から山木がどなった。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だってにぎやかでいいじゃないか」「いや、だめだい。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "うんと働くぜ」「でも、そんなこと、だめだい」「おい、二郎」　二郎が、後をふりかえった。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこへ来たをばさんが、さういふと、「だめだい、をばさんなんか。",
              "citation": {
                "source": "母子ホームの子供たち",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは我等の為めでないまた君等の為めでもない我等と君等と、その何れもの為めだいや、我等が敵である彼の資本主すらのためだ。",
              "citation": {
                "source": "プロパガンダ",
                "author": "加藤一夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "へえそれはまた何のためだい。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "「穿めもしない手袋を握ってあるいてるのは何のためだい」「なに、今ちょっと隠袋から出したんだ」と云いながら中野君は、すぐ手袋をかくしの裏に収めた。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつをぶつこはしや、銀の十字架かめだいか取れようつてもんだ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、仲吉は三の日と八の日には、日が暮れてから出掛けるようだか、ありゃ何のためだい」　三の日と八の日――それは三軒の酒屋へ火を放けた日――とは市五郎も気がつきません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "酒屋火事",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
