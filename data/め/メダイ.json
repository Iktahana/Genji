[
  {
    "uuid": "9fb32dd8-07b1-54fb-a8fd-170e4ba133b8",
    "entry": "目鯛",
    "reading": {
      "primary": "めだい",
      "alternatives": [
        "メダイ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
