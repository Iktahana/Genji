    "definitions": [
      {
        "index": 1,
        "gloss": "flaring up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "暖炉の薪がメラメラと燃え上がり、部屋中を温めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の心には、困難に立ち向かうメラメラとした闘志が燃えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怒りがメラメラと湧き上がり、彼女は思わず声を荒げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "油紙の天幕には、チロチロと漣の刻むような光りがする、岩石の間に、先刻捨てた尻拭き紙までが、真赤にメラメラと燃えている、この窪地一帯に散乱する岩石の切れ屑は、柔らかく圭角を円められて、赤い天鵝絨色が潮しはじめた。",
              "citation": {
                "source": "谷より峰へ峰より谷へ",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の腰かけている長椅子の真正面の左手の窓硝子越しに遙かに見える新張炭坑の選炭場の弧光灯がタッタ一つと、その下でメラメラと燃え燻っている紅黒いガラ焼の焔が、ロシヤ絨氈のように重なり合って見える。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その片隅に、もう消えかかったガラ焼の焔と煙が、ヌラヌラメラメラと古綿のように、または腐った花びらのように捩れ合っているのであった。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に中野学士の胸のポケットからハミ出していた白いハンカチが、フワリと火の海の上に落ちてメラメラと燃え上った。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "口を引き裂かれて馬鹿みたような表情にかわっているもの……鼻を切り開かれて笑っているようなもの……それ等がメラメラと燃え上る枯れ葉の光りの中で、同時にゆらゆらと上下に揺らめいて、今にも私の上に落ちかかって来そうな姿勢に見えます。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、こすると、マッチがメラメラもえだしました！",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "――時々竈の火で、顔の半分だけがメラメラと光って、消えた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに横合から白煙が吹きつけると見る間に、焔がメラメラと燃えだした。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あッという間もなくメラメラと燃えひろがり、クルクルクルとまわりだした。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "空中に乱舞する照空灯、その間に交って破裂する投下爆弾、メラメラと燃えあがる火の手、遠くからながめても恐ろしい焼夷弾の力！",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "みるみる火勢はものすごさを加えていって、往来へとびだしてみると、もう屋根の上へ真赤な炎が、メラメラと顔をだしていた。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三百数十人の大小の死体とメラメラ火を吐いている焦土とが、駈けつけたバクーの労働者を迎えた。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メラメラともえ上がったと思うと、しめり気があるとみえて、すぐに力なく消えそうになる。",
              "citation": {
                "source": "くまと車掌",
                "author": "木内高音",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが時折引き締ると、そこから、この老婦人の、動じない鉄のような意志が現われて、隠遁的な静かな影の中から、焔のようなものがメラメラと立ち上るような思いがするのだった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジイジイっと喘鳴のようなかすれた音を立てて燃えはじめると、拡がってゆく焔の中で、薄気味悪い蒼鉛色をしたものがメラメラと蠢きはじめるのです。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "レヴェズさん、その二つを兼ね具えたものと云えば、まず貴方以外にはないのですよ」とにわかに酷烈な調子となって、法水の全身が、メラメラ立ち上る焔のようなものに包まれてしまった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、そうなって………」と云いかけた法水の顔には、殺気とでも云いたいものが、メラメラと盛り上って来た。",
              "citation": {
                "source": "夢殿殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "投げ捨てられた松明が、メラメラと焔を上げていた。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "忽ち焔はメラメラと六歌仙を包んで燃え上がったが、火勢に炙られたためでもあろうか、六歌仙六人の左の眼へ、一字ずつ文字が現われた。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "掻きむしられるような…………が、身心をメラメラと焼き立てる。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤く弱い焔がメラメラと立のぼったが、それが消えると黒くなって残った手紙の残骸は、火鉢のなかで脹れ上った、そしてその一部は灰となって軽く天井に舞い上った。",
              "citation": {
                "source": "仙人掌の花",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一思ひに、といふ気持が日ごとにメラメラ燃え立つて激しくなるが、一方にこの放浪者の心の幅が却つて狭く見えてきた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "街の片端から、メラメラと火の手があがった。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "また一つ、崩れるような大きな爆発音がして、新宿駅の方が急に明るく火の手があがり、それが、水でも流したように、見る見るうちに四方八方へ拡がり、あたり近所が、一度に、メラメラと燃え出した。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒い煙や黄色い煙が色テープのように、横なぐりの風に吹き叩かれ、マストの上を、メラメラと赤い火焔が舌を出していた。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその火床には、大きな石炭が抛りこまれて居り、メラメラと赤い焔をあげて、今や盛んに燃えているところだった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッと丸の内方面が明るくなったと思うと、毒々しい火焔がメラメラと立ちのぼり始めた。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "金魚鉢の上の穴からも真赤な焔の舌は盛んにメラメラと立ちのぼって、まるで昔の絵に描いた火の玉のようになった。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "金魚のすぐ頭の上は水面だったが、そこには呪わしい紅蓮の焔がメラメラと燃え上っているのだった。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると紅蓮の焔はまるで生物のように八十助の存在を認めて、そのメラメラといきり立つ火頭を彼の方に向け直すと、猛然と激しい熱風を正面から吹きつけた。",
              "citation": {
                "source": "火葬国風景",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
