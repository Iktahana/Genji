  {
    "uuid": "75b05618-8faa-5ffb-a77b-e371e315adcb",
    "entry": "めらめら",
    "reading": {
      "primary": "めらめら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大裾野の草木が、めらめらと青く燃える。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "火を放けた人は赤い火のめらめら燃えてゐる籠を脊負はされ、めかけ持つた人は二つの首のある青い蛇にからだを卷かれて、せつながつてゐた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は庭園で焚火をめらめらと燃やして、飛んで來るたくさんの蟲を網や箒で片つぱしからたたき落した。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘆きがめらめら燃え出したよ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵の砲弾は、わがマストに命中し、たちまち帆がめらめら燃え上った。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、この通り、山ばかり、重り累る、あの、巓を思うにつけて、……夕焼雲が、めらめらと巌に焼込むようにも見える。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "地虫のような鼾を立てつつ、大崩壊に差懸ると、海が変って、太平洋を煽る風に、提灯の蝋が倒れて、めらめらと燃えついた。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸障子に不意に火が附いてそこいらめらめら燃えあがる事がありましても、慌てて消す処は破れ、水を掛けた処は濡れますが、それなりの処は、後で見ますと濡れた様子もないのですから。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も、この障子の多いこと続いたのに、めらめら破れのある工合が、ハイ一ツ一ツ白髑髏のようで、一人で立ってる気はしねえけんど、お前様が坊様だけに気丈夫だ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その幕の彼方から、紅蓮、大紅蓮のその声、舌も赤う、ひらめくと覚えて、めらめらと饒舌る。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……一軒、家だか、穴だか知れねえ、えた、非人の住んでいそうな、引傾いだ小屋に、筵を二枚ぶら下げて、こいつが戸になる……横の羽目に、半分ちぎれた浪花節の比羅がめらめらと動いているのがありました、それが宿はずれで、もう山になります。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お道さんが、さんばら髪に肩を振って、身悶えすると、消えかかった松明が赫と燃えて、あれあれ、女の身の丈に、めらめらと空へ立った。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご本尊にあやかって、めらめらと背中に火を背負って帰ったのが見えませんかい。",
              "citation": {
                "source": "菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに、めらめらと鎌首を立て、這いかかったためである。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、今夜は全くの無風なので、焔は思うさま伸び伸びと天に舞いあがり立ちのぼり、めらめら燃える焔のけはいが、ここまではっきり聞えるようで、ふるえるほどに壮観であった。",
              "citation": {
                "source": "新樹の言葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "火を放けた人は赤い火のめらめら燃えてゐる籠を背負はされ、めかけ持つた人は二つの首のある青い蛇にからだを巻かれて、せつながつてゐた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ、眼の前の一軒の農家がめらめら燃えている。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子に揮発油をぶっかけて、マッチで点火したら、それは大いに燃えるだろうが、せいぜいそれくらいのところしか想像に浮んで来ないのであって、あんな、ふとい大黒柱が、めらめら燃え上るなど、不思議な気がする。",
              "citation": {
                "source": "春の盗賊",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦稈は青いほのおをあげてめらめらと燃え、あとには黄色な麦粒の小山が残りました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "取り出せるは、皺になれる敷島の袋、残れる一本を、くわえて、火を点ず、残れる火を、さて敷島の袋にうつす、秋の日の下、物思いのひるさがり、芝生の上、めらめらと、袋は燃ゆらし　灰となりゆく、あわれ、我が肺もこの袋の如、日に夜に蝕まれゆくか、秋の日の下、くゆらす煙草のいとからし。",
              "citation": {
                "source": "詩二つ",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたかも甚平の魂のごとくに挫けて、真紅の雛芥子は処女の血のごとく、めらめらと颯と散る。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪を捌かせ、鉄輪を頭に、九つか、七つか、蝋燭を燃して、めらめらと、蛇の舌の如く頂かせろ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（黒髪のその呪詛の火を払い消さんとするや、かえって青き火、幣に移りて、めらめらと燃上り、心火と業火と、もの凄く立累る）やあ、消せ、消せ、悪火を消せ、悪火を消せ。",
              "citation": {
                "source": "多神教",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "トどうかは知らんが、少い女の絡んだ腕は、ひとりで貴婦人の頸を解けて、ぐたりと仰向けに寝ましたがね、鳩尾の下にも一ヶ所、めらめらと炎の痣。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに気が小さいから、取詰めて、持ってる洋燈をこの荷車に叩きつけよう、そして粉微塵に砕けたら、石油に火が移ってめらめらと燃えて無くなるであろうとまで思った。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を悟ったのか、ケケッケケッ、羽ばたきをしてる奴を引掴んで両手で袖の下へ抱え込むと、雨戸が一枚ばったり内へ煽ったんですが、赫として顔が熱かったのも道理、見る間に裏返しに倒れ込むとめらめらと燃えてましょう。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その白犬がの、狂気になったかの、沖の方へ、世界の涯までと駈出すと思う時、水戸屋の乾の隅へ、屋根へ抜けて黄色な雲が立ちますとの、赤旗がめらめらと搦んで、真黒な煙がもんもんと天井まで上りました。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸焼のあたり一面、めらめらとこう掌をあけたように炎になったから、わッというと、うしろ飛びに退っちまったそうですよ。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "一尺ぐらいずつ、おなじほどの距離をおいて、蜘蛛の巣と、どくだみの、石垣の穴と穴から、にょろりと鎌首を揃えたのが、姉さんの白い腰に、舌をめらめらと吐いているんじゃあないか。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……大釜の底にはめらめらと真赤な炎を彩って燃している。",
              "citation": {
                "source": "怨霊借用",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
