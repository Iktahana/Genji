        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "また遥か後になつて小網町に鴻の巣が出来「メエゾン、コオノス」と称して異国がつた。",
              "citation": {
                "source": "パンの会の回想",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西人のホテルで、メエゾン・ポアソンといふ家号だつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄宿舎の向い側にあるメエゾン・ド・プランタンは、朝寝をした学生に重宝がられるばかりでなく、そういう人々によって夜など殊に賑やかであった。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには幸ひルュニェ・ボオのメエゾン・ド・ルウヴル（創作の家）がある。",
              "citation": {
                "source": "巴里で観たイプセン劇",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、財産の点では、メエゾン・ペルシエの副支配人と云つただけで、相当の代物だつてことがわかるだらう。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国橋畔の第一やまと、永代橋ぎわの永代亭、大伝馬町の三州屋、鳥料理都川、小網町のメエゾン・コオノス。",
              "citation": {
                "source": "カフェー",
                "author": "勝本清一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
