[
  {
    "uuid": "2411bb53-8562-54a3-9b02-8c025cd755b9",
    "entry": "召し抱える",
    "reading": {
      "primary": "めしかかえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
