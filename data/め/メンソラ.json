          "literary": [
            {
              "text": "メンソラを鼻の中におぬりになると幾分かわいた息が楽のようですけれど。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "目じるしに今は細くさいた原稿紙のはじがメンソラでちょいと付けてあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "身体を気をつけ、よく含嗽し、メンソラを用ゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンソラをうんと塗っておく。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
