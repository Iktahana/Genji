        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場ハ川崎辺ニアルガ、本社ハ日本橋ニアッテ、彼ハソコノ営業部ニ勤メテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ誰々サンノ所ノ老人ハ、チョットシェパードガ足元ニ絡ミ着イタヾケデ転ンデ大怪我ヲシ、三カ月モ入院シテ未ダニギプスヲ篏メテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "豫メホールダーノ色ト調和スルヨウニマニキュアモ常ヨリ紅ク染メテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番｜肝腎ナハ、―――今度コソ郁子ハスベテノモノヲ木村ニ捧ゲ尽シテシマッタノデハナイカ、ソシテ敏子ノ口ヲ介シテソノ諒解ヲ僕ニ求メテイルノデハナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマエガ小竹向原ノ空家デ着々ト進メテイル計画ヲ私ハスベテ知リツクシテイル。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
