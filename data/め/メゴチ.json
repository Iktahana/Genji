        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釣り上げためごちは、天ぷらにすると非常に美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "市場には新鮮なめごちが並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "めごちは、海底の砂地に生息する魚だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "町田忠治は、政権という餌を捜しているめごちみたいだ。",
              "citation": {
                "source": "議会見物",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "くるま蝦にしてもあなごにしても、鯊、きす、めごちにしても、自分は頭とか中骨とか尻尾などを、べつに揚げさせて、それを肴に焼酎を啜る。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の鯊やきすやめごちやくるま蝦などの、頭と尻尾と骨だけのてんぷらである。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
