        "examples": {
          "standard": [
            {
              "text": "このUSBメモリは、容量が128メガバイトしかない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "スマートフォンのデータ使用量が、今月はすでに数メガバイトを超えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔のゲームソフトは、たった数メガバイトの容量しかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "標準的に使われているフロッピーディスクの容量は、一・四メガバイトです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "広く使われるようになってきたＣＤ―ＲＯＭならさらに、フロッピーディスクの五百倍近い六百五十メガバイトまで入ります。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＣＤ―ＲＯＭにおさめたエキスパンドブック版の容量は、最終的に六百十メガバイトほどになりました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちの五百八十メガバイトを、動画が占めています。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "費用を問い合わせてみると、代表的なプロヴァイダーの一つであるＩＩＪでは、十メガバイトの容量を借りるのに一か月で一万円かかると言います。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "本来はＭＳ―ＤＯＳ用のこのマシンに１メガバイトちょいのＢＴＲＯＮのＯＳ（商品名はＥＴマスター）を載せ、別売のエディターをプラスすれば日本語ワープロとお絵書きにはすぐに使える。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
