        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「オオ　マブシイ」ト　ドノ　ツボミモ　ハジメハ　サケビマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アメハ　フツテ　ヰナイノ？",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデハ　オマエ　トンデ　ゴラン」　スズメハ　トビマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてハワイで、ハワイナポレオンと称せられた、大虐殺王タメハメハの死んだ時などは、大勢の人間の強制的犠牲を供えたのみならず、なお無数の忠良な臣下が自殺しまたは自ら傷つけて不具になった。",
              "citation": {
                "source": "奴隷根性論",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその後数年間、国民は毎年その日に糸切歯を抜いて、タメハメハを祭った。",
              "citation": {
                "source": "奴隷根性論",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ、道子ヲ殺シタ後清三ガオキタラ、罪ヲスッカリ自白シテ自殺シヨウト思ッテ居タノデスガ、然シ清三ノ態度如何ニ依ッテハ之ヲ殺スツモリデシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "答　ハジメハ目ヲサマスト驚イテフルエテ居タヨウデシタガ、私ガシャベリ出ストソレニ対シテ、コノウソツキメ、大嘘ツキメト私ヲ罵リマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ始メハ「ガス、タンク」デモ爆發シタカト思ツタ位猛烈ナ勢デアツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　クロコディル〔風刺雑誌『わに』〕とスメハチ〔風刺雑誌名〕とを買った。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが矛盾すると考えられるのはメハニスムスの二義を混同することに基くものである。",
              "citation": {
                "source": "カントと現代の科学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔曾テ甲山ニ入リテ大薬ヲ求メ／元メハ水府ニ遊ビテ霊泉ニ浴ス〕と言っているのと、滝川という姓氏の二事から漸くにして南谷というのは禄四千石の旗本滝川出羽守｜利雍の雅号であることを知った。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙の人はそれはメハジキのヤクモソウ（※蔚すなわち益母草）だといっている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従来学者によりてその実物の考えがまちまちになっていて、ある学者はこれをエンレイソウ（ユリ科）ならんといい、ある学者はヤクモソウ一名メハジキ（クチビルバナ科）であろうといい、またある学者はそれはツクバネソウ（ユリ科）であるといっていて、今はこのツクバネソウをそれに充るのがまず通説の様になっている。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "宗祗ノ旅日記ニ、日坂ニテ富士ヲ望メハ、南ハ険シク北ヘ長ク足ヲ引テ伏屋ノ形ニ似タリ、足柄嶺ニテ見ルモ同之キヨシ記セリ、山ハ伏覆ノ義ナレバ、不尽不時等ノ仮名ヲ用フルモ皆伏ス意ニテ、其訓藤蔓ニ通ヒ、ふしトモつるトモ云ヘリ、云々。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯締メハ金ト銀トヲ縄ノヨウニ撚ッタモノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日ノ晩ハ「ヒメハジメ」デアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメハメハ・ハイツを、すでに後方に置き去りにした。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジョージ・ブランギアと、ナット・ノーフリートのふたりの名前を合成して、ブランフリートとなったのでしたね」「のちに、カメハメハ・スポーツウエア、という名前に変わったわ」「そうでした。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメハメハ・アヴェニューに面したほんのすこしだけの町なみも、一日の活動をおえていた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハナはハワイ島に近いという地理的な条件のため、カメハメハ・ザ・グレイトがハワイ王国を統一するまでは、敵に攻めこむための前線基地であり、敵から攻めこまれて戦う戦場でもあったのだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "というよりも、ぼくとしてはカメハメハ・ハイウエイと呼びたい。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのカメハメハ・ハイウエイを、中古で買ったフォード・グラナーダで走りながら、ぼくは次のようなことを考えた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
