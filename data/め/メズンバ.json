          "literary": [
            {
              "text": "一類之ヲ哀ンデ而シテ之ヲ諫メズンバ、亦世人ヲシテ一類ヲ哀マシメン。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ同一ノ人民ヲ目的ト為シテ強奪ヲ恣ニシ悪俗ヲ改メシメズンバ、遂ニハ自主自裁ノ特権ヲ以テ国内ヲ悩マスニ至ルベシ。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "子寿｜欣然トシテコレヲ受ケ改メズンバ措カザルナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
