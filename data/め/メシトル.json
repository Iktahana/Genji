    "definitions": [
      {
        "index": 1,
        "gloss": "to arrest",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "奉行所の役人たちが、長年逃亡していた大泥棒を潜伏先で「召し捕った」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "捕り物帳のヒーローが、悪党を一瞬で「召し捕る」場面に観客が沸いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "証拠を突きつけられた犯人は、抵抗することなくその場で「召し捕られた」。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "Ｔ「木ッ葉役人の二十三十束にして」　とづかづか近寄り乍ら、Ｔ「なりひら小僧を召し捕るたァ」　と言って、Ｔ「虫が好すぎるぜ大将」　で主膳グーの音も出ない。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手が二人ですから、一度に召し捕るのはむずかしいと思っていましたら、都合好く順々に出て来たので、案外にばたばたと片付きました。",
              "citation": {
                "source": "半七捕物帳",
                "author": "青山の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "身を変えての追手役、召し捕る相手は俺の従兄、古い物語にでもありそうだ。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……和歌の会｜催そうそのために、望東尼殿も拙者も参会したものを、月照上人召し捕るなどと申して、この狼藉は何事じゃ」　内外森然としてしまいました。",
              "citation": {
                "source": "犬神娘",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こえて、明治三年一月一日、政府の命を受けた弾正渡辺登は長崎に来て、浦上キリシタンを老人子供残らず召し捕る振遠隊の兵士に指揮される、おびただしい捕り手が、突如長崎役所から繰り出すと、なだれをうって浦上に殺到し、片っぱしからからめとる──。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "召し捕るなり、殺すなり、勝手にしろ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "よいか、召し捕るのじゃぞ。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "召し捕る……つまり生獲りじゃ。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "縛につかぬとあらば、押しくるんで召し捕る分じゃ」「ああ！",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれは「めしとる」という意味であったそうである。",
              "citation": {
                "source": "千人針",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "にせ金使いの一味をめしとるために、わざわざ放った火じゃによって、消すには及ばぬ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ただちに　めしとるのじゃぞ。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "末には維幾も勘忍し兼ねて、官符を発して召捕るよりほか無いとなつて其の手配をした。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまじいに人の物に眼をかけないだけに、その手がかりを見つけ出すのが困難で、所詮はその場で召捕るよりほかには、下手人を見いだす方法がなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "槍突き",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云って、無証拠のものを無暗に召捕るわけには行かなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "湯屋の二階",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時代の習いとして、どこの藩でも隠密が入り込んだと覚れば、彼を召捕るか、殺すか、二つに一つの手段をとるに決まっているのであるから、叔父は早々に身を隠して、その危難を逃がれるのほかはなかった。",
              "citation": {
                "source": "くろん坊",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はおくればせに駈け付けて来て、すぐにこの持て余した狼藉者を召捕る法を考え付いた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し相手が武士であるから、迂闊に召捕るわけにも行かないので、手先ふたりは三河屋のせがれ善吉を同道して、次郎の屋敷の近所に網を張つてゐると、彼は湯屋へ行くらしく、手拭をさげて表へ出た。",
              "citation": {
                "source": "赤膏薬",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちは役目で罪人を召捕るのですから、それを一々恨まれてはたまらない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "廻り燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれを逆に利用して金蔵を手元へおびき寄せ、藤吉ぐるめに召捕るという手だてが無いでもない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "廻り燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "他人と手柄を争って金蔵を召捕るにも及ばないが、それが長引いて三甚の迷惑をかもすのも可哀そうである。",
              "citation": {
                "source": "半七捕物帳",
                "author": "廻り燈籠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わしを召捕るなら召捕るがいい。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、俺を召捕るか、捕らぬか、噂を聞いて――金はあるし――旅へ出て噂を聞いた上での、分別と――）　吉右衛門は、支度をして、立上った。",
              "citation": {
                "source": "寺坂吉右衛門の逃亡",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田は、柱を掴んでいた手を放して、刀を握りながら「士を召捕る作法かっ」　と、叫んだ時、五六人もの手が、肩へ、襟へ、腰へ集まって来て、門の中へ、引き摺り込んでしまった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰の指図で、何ゆえに召捕るのか？",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "――訳を明かさずして、盗賊と同じように召捕るからには、捨ておかんぞ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとのは、てっきり人を召捕るためのお手先に相違ないが――そうだとすれば、誰を召捕るため、それは言わずと最初から胸一杯に思い塞がっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "召捕るというわけにはゆきますまいが、掛けあうくらいのことは出来ましょう。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "御代参の乗物",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その高木銀次郎を召捕るのだ、神妙にせい」「何？",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "幻の民五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利助と友次郎に手を貸して一日も早く召捕るようにするのだぞ」「ヘエ――」「解ったか、平次」　眼に物言わせた新三郎、この二人の意地の悪い先輩に楯を突いて、また面倒な事を起してはならぬという謎でしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "永楽銭の謎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
