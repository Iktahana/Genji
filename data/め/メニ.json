        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "四　ある食堂の片隅の食卓に女学生が二人陣取ってメニューを点検していた。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また医薬として土を用いた例はアルメニアやスペインにもある。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがちかごろは洋食のメニューを並べている。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々刻々ノワガ姿、笑ッタ、怒ッタ、マノワルキカッカッ燃ユル頬、トウモロコシムシャムシャ、ヒトリ伏シテメソメソ泣イテイル、スベテ記シテ、ノチノチノ弱キ、ケレドモ温キ若キ人ノタメニ、尊キ文字タルベキコト疑ワズ、ソコガソレ、スランプノモト。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本居留民ノ生命ヲ保護スルタメニ来タノデアルカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "居留民ノ財産ヲ守ルタメニ来タノデアルカ？",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸君ハ、日本国内ニ於テハ、農村ヤ工場ニ於テ、資本家ヤ地主カラ搾取セラレ、支那ニキテハ帝国主義ブルジョアジーノタメニ命ガケノ血ナマグサイ戦争ヲサセラレヨウトシテイル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本帝国主義ハ、真先ニ掠奪スルタメニ有利ナル戦略的状勢ヲ利用シテ、諸君ヲコノ地ヘ来ラシメタ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "満鉄ヤ撫順ノタメニ諸君ノ暮シガチットデモラクニナッタカ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "分割センガ為メニ弾圧スル――コレガ支那ニ於ケル帝国主義者共ノ政策デアル。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ諸君ハ、支那ノ労働者、農民、兵士達ト手ヲ握レ、諸君ガ革命的連帯ノ固キ握手ニ達スルタメニハ、如何ナル犠牲ヲモ辞スルナ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那革命擁護ノタメニ、諸君ハ支那ノ労働者、農民、兵士達ト力ヲ結合セヨ！",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これならラフルス・ホテルのメニュウにだってつけ出されまさ」　事務員の一人は、晩餐の食卓でこう云った。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝸牛の季節には巴里のレストラントのメニュウには大抵それが載っている。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリスのレストラントへ行ってメニュウを探して見るとポークカツレツというのがあるから、喜んで注文するとそれはわれわれの予期するカツレツではなくて日本の所謂ポークチャップであった。",
              "citation": {
                "source": "異国食餌抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿ニ似テ非ナル猿面冠者ハオノガ立身出世ノタメニハ、主人ヨリ猿々ト呼ビ捨テラレルモ、ヘイヘイト追従笑ヒナド泛ベタルハ、即チ羞恥ヲ知ラザル者ト言フガ如シ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、八重ちゃん……」　と、豹吉は店の女の子を呼んで「――この子供らに、メニューにあるだけのもン、何でも食わせてやってくれ」　どうやら靴磨きの少年達に御馳走することには、反対らしいお加代への面当てに、わざとそう言った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣のテーブルでは、十二三の少年が七つ位の弟と五つ位の妹を連れて、メニューにあるだけのものを全部注文していた。",
              "citation": {
                "source": "ヒント",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッチ、メニュー、――手当り次第だった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "まん中には立派な顔をしたトルコ人だかアルメニア人かがゆるやかに櫂をあやつっている。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オムレツと焼玉子の合の子のようなものが、メニューの中にあった。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベルギー人のメニエ君は一枚のはがきに一万七千百三十一語を書き込んでレコードを取った。",
              "citation": {
                "source": "記録狂時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しおりをはさむくらいの手軽さで登録できて、次からはメニューから名前を選ぶだけでいい。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "現住所を起動機能付きで記録する「Save location といったメニューを用意しておかなかったのは、ネットスケープの盲点だな」と祝田さんは考えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "スモールトークと名付けたダイナブック用の言語では、この点を改善したいと考えて「メニュー」を用意することにした。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルトのポインティングディバイスに使われたマウスのボタンの操作によって、画面上にメニューを呼び出す方式は、ポップアップメニューと名付けた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした理想に近づくために、ＩＴＯＳには、ディスプレイに表示されるコンピューターからの問いかけに「はい」か「いいえ」で答え、処理の内容や手順を一覧表にしたメニューから選んでいくだけで、プログラムを作ったり処理を行ったりできる環境が盛り込まれていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンピューターの基本的な動作を一括して管理するＯＳに対応したプログラムは、ＯＳ側が用意している作業のメニューを利用して動くように設計することができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＯＳのメニューにないことを独自に工夫してやらせるようなことをしなければ、ＣＰ／Ｍ用のソフトはＣＰ／Ｍを載せたどのマシンでも使えるように書くことができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
