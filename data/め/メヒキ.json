          "literary": [
            {
              "text": "こちらの名まえをあかさずに届けなよ」　言いおくと、右門と知って目引きそで引きしながら、いっせいにどよめきたったお客たちの視線をのがれるようにして表へ出ていきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いらっしゃい」と一人の女中が云って、僕等を見て、今一人の女中と目引き袖引き笑っている。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "生徒の方でも目引き袖引きして此の名も知らぬ若い教師を眺めた。",
              "citation": {
                "source": "道",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "真白な肉附きの好い肌が役者のように美くしかったので、近所の若い女が目引き袖引き垣根から隙見したそうだ。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "マア何と云うネエ、……」と目引き袖ひきするのもあるのを上からのぞく御月さま、「ても笑止な」と思うで有ろう。",
              "citation": {
                "source": "錦木",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、目引き袖引きする、無知な年とった女どもにかこまれている彼女の境遇に同情を持った。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「電車の中で余所の奥さん方が目引き袖引きしているじゃありませんか？",
              "citation": {
                "source": "嫁取婿取",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "目引き袖引き、覗き見していた近所のほうが、かえって、罪を犯したみたいにしいんとしていた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "初下りの上方役者の、楽屋入りを見ようとする、若女房や、娘たちが、狭い道の両側に立ち並んで、目ひき袖ひき、かまびすしくしゃべり立てている。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そう云って集っていた近所の人々は目ひき袖ひきした。",
              "citation": {
                "source": "犬三態",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな目ひき袖ひきくらいに、驚きゃしませんやな！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
