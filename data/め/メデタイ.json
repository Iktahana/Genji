[
  {
    "uuid": "394085ec-a7da-5b38-8762-af05f08cdde8",
    "entry": "目出度い",
    "reading": {
      "primary": "めでたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
      "ctype": "形容詞",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "happy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ご子息の結婚、誠にお目出度い話ですな」と、近所の老人がお祝いを述べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "新しい年を迎えることができ、これほど目出度いことはありません。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "紅白の垂れ幕が下がった会場は、お目出度い雰囲気に包まれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "少年の姿を見ると目出度いと言って急いで羽織袴で恭しく出迎えるような商家の主人もあった。",
              "citation": {
                "source": "みちのく",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだとすれば濫造の噂が高ければ高いほど目出度い喜ばしいことだと云わなければならないのではないかと思われる。",
              "citation": {
                "source": "学位について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それほど目出度いことはないのである。",
              "citation": {
                "source": "学位について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「石さん、一寸」　「何んだよ」　「目出度い話さ」　「出し抜けに、どうしたんだ」　「実はね、石さん。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "国家のために入営するのは目出度いことであり、名誉なことであり、十分軍務に精励せられることを希望する、と。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが目出度いことであり、名誉なことであるか？",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「濫費日」や「嘘つき日」や「怠け日」はあまり聞えはよくないかもしれないが、実はこれらの特定日の存在は平日の節約勤勉真面目を表白するとすれば目出度い事である。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それはお目出度い。",
              "citation": {
                "source": "恋を恋する人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが日清戦争、連戦連勝、軍隊万歳、軍人でなければ夜も日も明けぬお目出度いこととなって、そして自分の母と妹とが堕落した。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "己れっちらの境涯では、四辻に突っ立って、警部が来ると手を挙げたり、娘が通ると尻を横目で睨んだりして、一日三界お目出度い顔をしてござる様な、そんな呑気な真似は出来ません。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の姿を見ると目出度いと言って急いで羽織｜袴で恭しく出迎えるような商家の主人もあった。",
              "citation": {
                "source": "みちのく",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たかがお前この頃｜情人が出来たそうだね、お目出度いことよ位なことを謂われるばかりさ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "武村兵曹は前額を撫でゝ『やあ、だん／″＼と目出度い事が集つて來ますな。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――結婚式は目出度いと世間の常識は言いますね。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、花嫁がよほど好色的でない限り、つまり処女の場合、例外なしに殆んど気絶状態になって夫に体を許すという儀式が、何が目出度いんでしょう。",
              "citation": {
                "source": "夜の構図",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "目出度いことだ」　小布施が命に係はることさへわざと軽薄ないひ廻し方をするので、桂子はぐつと気持が胸へつかへたが、長患ひする者の自棄的な反語であるのを知ると、むしろ不憫に思へた。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「土地繁昌の基で、それはお目出度い。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんならお目出度いけれど　八重子　わたくしは、この絵葉書の写真を、老人のように眼をしょぼつかせたり、見開いたりして眺めました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "言い換えれば容易く祭り上げられるお目出度い人間に出来てるのだと嘲笑したい。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「内務省に出る事に決定りました、江藤さんのお世話で」「フンそうか、それで目出度いというのか。",
              "citation": {
                "source": "富岡先生",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『さうか、それでは今年が初めてだの昔からも一年の謀は元旦にありといふから、お前さんも、今日の日の出を忘ないで居なさい如何じや大變顏の色が惡いやうじやがそんな元氣のない顏色をして居ては世の中を渡れるものではない、一同に日の出を拜んだも目出度い縁じや、これから私の宅へ來るが可い、雜煮でも祝はう。",
              "citation": {
                "source": "日の出",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "くどく持ち出された三十円の金を、弁償いたしますと大人なしく出て、すご／＼と大阪へ戻って来ると丁度その日は婚礼料理の註文があって目出度い／＼と立ち騒いでいる家へ料理を運び、更くまで居残ってそこの台所で吸物の味加減をなおしたり酒のかんの手伝いをしたりした揚句、祝儀袋を貰って外へ出ると皎々たる月夜だった。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「相公は、何故、ここにいらっしゃいます」「今晩は、目出度い婚礼の酒宴があるということを路で聞いたから来た」　邪神は喜んだ。",
              "citation": {
                "source": "殺神記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、読んでゐる間中は、それらの書物のうちに展開されて行く花やかな幻に包まれて吾身を忘れるかのやうな目出度い影響を被る自身を想像してゐた。",
              "citation": {
                "source": "読書と生活",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのお祝ひの卓子で、私は二人の喜びを胸一杯に享け入れて目出度い盃を挙げながら――うつら／＼と、おゝ、それは二年ばかり前の春の時分であつたかな！",
              "citation": {
                "source": "満里子のこと",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "目出度いとも、何とも、形容の言葉が無かった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「村の平和――こいつを一番楯にして、この目出度い仮装行列の出発に際して奴等が持つてる俺達の借金証書を血祭の煙と燃やさせてしまはう――といふ僕の魂胆、どう処置するか、まあ／＼あと一刻僕に任せて置き給へよ。",
              "citation": {
                "source": "馬上の春",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなおめでたい席に。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間はめでたいお正月になって、暖かい天気が続く。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その感じはちょうどおめでたい新聞小説と恐ろしい罪悪を主題とした傑作とを読み比べる時のそれとよく似たものである。",
              "citation": {
                "source": "漫画と科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "naive",
