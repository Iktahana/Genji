    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "※――高い山から谷底見れば　　　　　　　瓜や茄子の花ざかり　　　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　瓜や茄子の花ざかり　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男",
                "author": "第一話　旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "地久節チキユウセツハメデタイナクワウゴウサマノオウマレ日ガツカウモ　ヤクバモイハヒマス。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一瞬にツル子の美しさ気高さが骨身にしみこんだというから、見かけによらぬオメデタイ男で、実にもうダラシなく感動してしまった。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犯人も案外オメデタイ人物なのかね。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑われたろう」「笑われもしなかったな」「オメデタイよ。",
              "citation": {
                "source": "巷談師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父と同様、あなたもだいぶオメデタイかたのようだわ。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い学者、技師連などは古い書物に書いてある間違いの影響を受けてその誤りを引き継ぎ、今日でもなお甘藍をキャベツ、すなわちタマナと思っているのはまことにオメデタイ知識の持主であって、憐れ至極な古頭の人々である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "精一杯手短かな言葉に代表さしていえば、「お目出度き人」という小説か脚本かを書いた武者小路氏のごとく、皮肉でも反語でもなく、勿論何らの漫罵でもなく、思切って「オメデタイ」ことである。",
              "citation": {
                "source": "文壇昔ばなし",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "加之、あの小説だか脚本だかを読んでいないでも、武者小路氏及び氏によって代表されているいわゆる白樺派の文芸及び思潮が、本当にオメデタイものであることを言明し得られると思っている。",
              "citation": {
                "source": "文壇昔ばなし",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メデタイという言葉も濫用せられている。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
