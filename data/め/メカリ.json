        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "遠藤と本名を出さず、「シサベノメカリ」といふ匿名だつたので、筆者の誰なるかについて大分痛くない腹をさぐられた人もあつたらしい。",
              "citation": {
                "source": "イプセンの日本語譯",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シサベは博士の故郷函館の濱のアイヌ名、メカリは布刈りで、海藻取りの意味である。",
              "citation": {
                "source": "イプセンの日本語譯",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "和布刈神社のメカリというのは、わかめの意味ですと教えられる。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
