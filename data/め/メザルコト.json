            {
              "text": "中食ノ學校支辨ノ理由ハ第一ニ登校兒童ノタメニ毎朝母ヲ勞苦セシメザルコトナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "開版ノ自由ト云ヘバ、何等ノ書ニテモ、刊行勝手次第ニテ、書中ノ事柄ヲ咎メザルコトナリ。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "後ニマタ豪商ノ有トナリ棄テテ治メザルコト殆四十年、今遂ニ我ニ帰ストイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
