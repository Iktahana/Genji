        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かれは風に帆をあげて行く舟のやうなものだかれを追ひかけるなかれにちかづいて媚をおくるなかれを走らしめろ　遠く白い浪のしぶきの上にまで。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ　かれをして遠く遠く沖の白浪の上にかへらしめろかれにはかれの幸福がある。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ婦人は空にふる雨の點點、しめやかな音樂のめろぢいのやうなものだ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれらの實體に近よることなく、かれらの床しき匂ひとめろぢいに就いてのみ、いつも蜜のやうな情熱の思慕をよさしめよ。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『なぐれ』『たため』『しめろ』雜然たる叫聲の中、殺氣は既に滿ち渡つて、氣早の若者は行成横合から飛び出して、思ひ切り芳の天窓を擲つた、續いて何處よりともなく、拳の雨は彼の頭上に降り注いだのである。",
              "citation": {
                "source": "二十三夜",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯殿でまだ沸き切らぬ湯をチヤブチヤブさせて遊んでゐる四人の小さな子供等こそは、実は一番喧しかつたのだが、長男に就いての一件の起こつてる時なので、他の四人の子供は何だか可愛い気がして、何時ものやうにとても「やめろ！",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今川家御朱印（天文二十四年）にも、村山室中で魚を商なってはならぬとか、不浄の者の出入を止めろとか禁制があって、それには、この村山なる事を明示している。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちゃ、チーフメーツから、仕事をやめろと命令されたから、今やめたまでの話さ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やるもやらぬもねえじゃないか、いいつけを守って、やめてるだけのもんじゃないか、ボースンもさっきから大分やめろといわれてるようだが、よさないとあとでまたうるさいだろうぜ」　全くボースンにとっては、どちらにしても、あとでうるさい、面倒な事になったものであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分自身が何だってことを、内部からハッキリ見詰めろ！",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「やめろ、やめろ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "越後獅子は、それまでベッドの上に黙って寝ころんでいたのだが、その時むっくり起きてベッドから降り、かっぽれのうしろから肩を叩いて、やめろやめろ、とちょっと威厳のある口調で言ったのである。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちどに改めろ言うても、それぁ無理。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母は、此の針金でわたしを殺すつもりか、河原乞食の眞似糞はやめろ、と言つて私たちをののしつた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬場は音たかく舌打ちして、「おい佐竹、からかふのはやめろ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいか、あの人の事は、あきらめろ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お願いだから、あの人の事は、もうきょう限り、あきらめろ。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「泣くのはやめろよ。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきらめろ、あきらめろ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘ったれた芝居はやめろ。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかと云ってマスクをやめろと人に強いる勇気もない。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうした瞬間を限って変る人間の気持ちと、構成され破壊される歴史の記録を掲示する銀座の青色の夜、プロレタリア駆逐したプチ・ブルジョワ達によって、かくも盛大に開演された未来派のオペラ、金属的なめろでい、青磁色の空には女優募集の広告と、ダダイズムの集会の予告板とが蛾と戯れていた。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニその、胡麻和のような汝が面を甜めろい！",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "気絶しようが、のめろうが、鼻かけ、歯かけ、大な賽の目の出次第が、本望でしゅ。",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方なしに、笑って見せて、悄々と座敷へ戻って、「あきらめろ。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
