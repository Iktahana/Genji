    "definitions": [
      {
        "index": 1,
        "gloss": "to love",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は庭に咲いた名もなき野花を、愛おしそうに愛でていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "月を愛で、酒を酌み交わしながら、古き友人と思い出を語り合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古美術品を愛でるのが趣味の彼は、週末になると各地の骨董市を巡っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "わが田夫は花を生けることを知り、わが野人も山水を愛でるに至った。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は爾を奴国の何物よりも愛でるであろう。",
              "citation": {
                "source": "日輪",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八一九年建設の古い本館は、彼の若い好古家としての感覚を常に魅惑しつづけ、学園が位置する広大な公園は風景を愛でる彼の鑑識眼に訴えた。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただこの時代の貴紳の芸術が、花鳥風月を愛でる風流となって久しいから、その実感ということは、一層念を入れ、一層細かく自然を見るという方へ向う。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "花を愛し、月を愛でるのであるが、その同じ自然を如何な角度から見るかということが大切である。",
              "citation": {
                "source": "中世の文学伝統",
                "author": "風巻景次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしマーシが来たなら、カーネーションを愛でる振りをしなさい。",
              "citation": {
                "source": "黄金薔薇",
                "author": "The Golden Rose",
                "note": "青空文庫"
              }
            },
            {
              "text": "さも愛でる振りをした風景は、陽光が降り注ぎ見事だが、時々不吉な雲がかかり、あとで雪が降りそうな気配だ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "――箇々その文事や勇気の長を愛でるに止まらず、自分自身も加えて、一団体としてよく自己をご覧ぜられよ。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "日常、姜維の才を磨いてやることは、珠を愛でる者が珠の光を慈むようであった。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれらは却って私が桜を多くめでるのあまり桜の美観が私の深処に徹し過ぎての反動かもしれません。",
              "citation": {
                "source": "病房にたわむ花",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして我ながらしほらしい氣分をめでるやうに、涙ぐましくなつたのを紛すやうに言葉を重ねて、『あなたは？",
              "citation": {
                "source": "神樂阪の半襟",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其頃母からおちごという牛若丸のような髷にいつも結ってもらって友禅の被布をきておとぎ文庫の因幡の白兎や、松山鏡を読みふけり乍ら盆の蜜柑をしきりに飽食する少女だった私は、南国というものによほど縁があると見え、嫁して二十五年余り、小倉の町にすみ馴れて年毎に柑橘の花をめでるのである。",
              "citation": {
                "source": "朱欒の花のさく頃",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "（豪州の南の風物は吟詠の情をゆり動かし、日暮れて船の欄干によりかかって遠く晴れた空をめでる。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "単なる珍奇をめでる心より以外に、何かその背後に之を重く見なければならぬ、古来の感覚が有つたのではないかといふことである。",
              "citation": {
                "source": "信濃桜の話",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "はて、フェンウィックが、まさか音楽をめでると思うか」「さあ、分からんぞ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "あだめいた女がさす櫛とさえいえば、油艶の生地をめでる黄楊と相場がきまっていますが、お粂がまだ廓の芸者でいた前身の頃、櫛に血色の塗りをかけて、それを廓に流行らせたことがあります。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これもまた好み愛づる人の多くなれば、花の品の多くなり行くこと、牡丹などの如くなるものならん。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも緑にして光ある、誰か愛づるに足らずといふべきや。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどこの花、備後おもての畳の上にのみある人の愛づべきものなるべし。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那西洋の人たちの此花を愛づる、まことに所以あり。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "花は其形の大きくて香の高きをのみ愛づべきものかは。",
              "citation": {
                "source": "花のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "花の香を匂はす宿に尋め行かば色に愛づとや人の咎めん　と、まだ受け入れがたい気持ちを書いてお返しになったのを、大納言は飽き足らず思った。",
              "citation": {
                "source": "源氏物語",
                "author": "紅梅",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人草木の花を愛づる癖あり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "其薔薇花の美しき間は、わが愛づべきこと慥なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "子が愛づる薄葉鉄の太鼓、その紅き片面剥げしに、土盛りて、せめて植ゑむと、福寿草霜に抜き来ぬ、二株三株。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌児が愛づる薄葉鉄の太鼓剥がれたり植ゑて眺めむ福寿草のはな春鵙おもしろの春や、この朝、花しろき梅のはやしに、をさな鵙来てををりける。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、委くこゝに写さんも要なけれど、余が彼を愛づる心の俄に強くなりて、遂に離れ難き中となりしは此折なりき。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく心づきてみれば、メエルハイムが言葉も振舞も、この君をうやまひ愛づと見えぬはなし。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、委しくここに写さんも要なけれど、余が彼を愛づる心のにわかに強くなりて、ついに離れがたきなかとなりしはこの折なりき。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、委くこゝに寫さんも要なけれど、余が彼を愛づる心の俄に強くなりて、遂に離れ難き中となりしは此折なりき。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
