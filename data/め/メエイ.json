          "literary": [
            {
              "text": "みのるは買つて來た小さいパンを袋から出して、土間の中まで追つて來たメエイに捩つて投げてやりながら、態といつまでも明りのついた義男の方を向かずにゐた。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其邊をうろついてゐたメエイが其所へ現はれたみのるの姿を見附けると飛んで來てみのるの前にその顏を仰向かしながら、身體ぐるみに尾を振つて立つた。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メエイとも別れるんだわね。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたに別れるよりもメエイに別れる方が悲しい。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
