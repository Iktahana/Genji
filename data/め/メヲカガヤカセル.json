        "examples": {
          "standard": [
            {
              "text": "宇宙飛行士になるという夢を語る少年は、希望に満ちた目を輝かせていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "新作ゲームの発表映像を見て、ファンたちは一斉に目を輝かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "大好きなキャラクターの着ぐるみを見つけた途端、娘は目を輝かせて走り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そんなとき、ルーシィは口をつぐんでいたが、頬を赤らめ、目を輝かせるので、その女心が男に奪われていることは明らかだった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "私を見ても娘達がもう目を輝かせることがなくなったその日から、私のここでの生活はずっと冬のように凍りついたままだ。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
