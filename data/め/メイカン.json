        "examples": {
          "standard": [
            {
              "text": "小鳥たちは鳴管を巧みに震わせることで、あのような美しい歌声を奏でている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "鳴管の構造は鳥の種類によって異なり、それが鳴き声の個性を生んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "解剖学的な調査により、その鳥の鳴管が非常に発達していることが分かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
