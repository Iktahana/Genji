          "literary": [
            {
              "text": "たかが、窓を開けるだけに呼びつけておいて、あの位置にするまでに、それは何度上げ下げしたことだったでしょう」　クメルニツキーの大迫害――。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現ニ私ハ近ゴロ原稿ヲ書クニモ手紙ヲシタタメルニモヒラガナトイウモノヲ使ツタコトガナイ、ソレハナゼカトイウニ、我々仰臥シタママデモノヲ書クモノニトツテハ些細ナ力ノ消費モ大キナ問題トナル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨッテ自分ハマルクス主義ノ正シクナイ事ヲ完全ニ理論的ニ証明セントシテ研究ヲ始メタガ、ソノ結果ハ却ッテ同主義ハアクマデ正当デアリ、且ツ無産階級解放ノ唯一ノ途デアル事ヲ認メルニ至ッタ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ヤ彼女ハ卯木家ニ於テ確乎タル地歩ヲ占メルニ至リ、浄吉ニ取ッテモ、ソウ云ウ意味デ缺クベカラザル存在トナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメテ奈良ノ寺々グライハ見テ置イタ方ガイヽシ、殊ニ今度ハ予ノ菩提所ヲ定メルニツイテモ、必ズ参考ニナルコトガアロウ、ト、ソウ云ッテヤッタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
