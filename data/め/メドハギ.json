        "examples": {
          "standard": [
            {
              "text": "小道に沿って咲くめどはぎの花が、夏の終わりを告げているようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供の頃、めどはぎの葉をちぎって遊んだ記憶がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この辺りの山には、野生のめどはぎが多く自生している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "これを蓍萩と呼んだのにも仔細があるだろうが、日本の自然史はまだこれを説く迄に進んでいないのを遺憾とする。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
