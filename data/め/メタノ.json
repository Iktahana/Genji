        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ後急ニ近隣ノ火ノ手ガ強クナリ、今戸八幡ノ方ニモ火ノ手ガ擴ガツテ來タタメ、大川縁ヲ傳ヒ北方ニ、逃ゲル仕度ヲ始メタノデ、後ノ状況ハ見ナカツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ヲ生ンデカラ後次第ニ愛情ガ冷メタノカ知ラン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「折角ソコマデ習ッタノニナゼ止メタンダネ」「ダッテ、トテモ足ガ変形シチャッテ醜クヽナルノヨ」「ソレデ止メタノカネ」「アタシ、足ガアンナニナルノハイヤダワ」「ドンナニナルノサ」「ドンナニナルッテ、ソリャヒドイノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻トシテ家庭ニ入レテ見ルト、案外ニモソウ云ウ才能ヲ発揮シ始メタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ三度目ニ求メタノガ今度ノコリーデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヲ止メタノハ医師トシテ実ニ立派ナ心ガケト云ハナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト云ウノハ、五子モ暫ク奈良ヘ行ッタコトガナイノデ、コノ機会ニ行ッタラドウカト予ガ勧メタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンナツモリデ今夜モ木村ヲ引キ留メタノダロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年ノ秋、書斎ノスタンドヲ螢光燈ニ改メタノモ、実ハイツカハコウイウ機会ガ来ルデアロウヲ理由ニ螢光燈ニ変エタノダッタガ、―――事実読書ノタメトイウヨリモ僕ハ、イツカハ螢光燈ノ明リノ下ニ妻ノ全裸体ヲ曝シテ見タイトイウ慾望ニ燃エテイタノダッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ最初ハホントウニ寝テイタラシイガ、途中カラ眼ガ覚メタノダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「悔改」とはギリシャ語でメタノイアと言い、心の向きを変えること、生活態度を百八十度転回することを意味する。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "悔い改めとは心を変えて新たにすることでありまして、原語たるギリシャ語ではメタノイアといい、私の非常に好きな語です。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私を牽転して下さい、そうすれば転られる、私は転りたいと思うのですが、自分の力では転られません」、これがメタノイア、すなわち悔い改めであります。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがイエス御自身のメタノイアでありました。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヨコサンペイ　コンレイニテ　キサブロウ　ウチニトメタノヲ　ツリニツレダス」八時十八分、大戸着。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
