        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今年はもうシーズンには間に合わないだろうと思いますが、メーエルホリドなどを是非見て来るつもりです。",
              "citation": {
                "source": "ロシヤに行く心",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メーエルホリドの切符はレビゾール二枚貰った。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "米川さん、メーエルホリドへ行きがけに、イズボーシチク〔辻馬車〕、タクシと衝突した。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜メーエルホリドに、リチ・キタイを見る。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "メーエルホリド座では「｜支那よ、吠えよ」。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
