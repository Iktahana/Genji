        "examples": {
          "standard": [
            {
              "text": "権力を手に入れた独裁者がメガロマニアに陥り、身の丈に合わない巨大な記念碑を乱立させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は自分を歴史上の英雄の再来だと信じ込んでおり、周囲からはメガロマニアだと噂されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "天才的な才能とメガロマニア的な自尊心は、しばしば紙一重のところで共存している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "青龍展のこの悪趣味をわたくしは私かにメガロマニアと呼んでゐるが、あれを尺大に縮めてくれたら、好い本の表紙になると思つて看て過ぎた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
