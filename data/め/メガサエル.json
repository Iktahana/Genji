        "examples": {
          "standard": [
            {
              "text": "コーヒーを飲んだら、すっかり目が冴えて眠れなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重要な会議の前日、緊張でなかなか寝付けず、目が冴えてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "真夜中なのに、アイデアが次々と浮かび、目が冴えて集中できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "路は一すぢ、秋の路、物の盛りの尽きる路、おお美くしや、急ぐまい、点、点、点、点、しばらくはわたしの髪も朱の斑……電灯狭い書斎の電灯よ、紐で縛られ、さかさまに吊り下げられた電灯よ、わたしと共に十二時を越してますます目が冴える不眠症なる電灯よ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒も醒めて目が冴える。",
              "citation": {
