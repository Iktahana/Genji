[
  {
    "uuid": "b555bb7b-be3f-544c-bbe7-afe295daa36b",
    "entry": "瞑想",
    "reading": {
      "primary": "めいそう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
