      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "meditation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎朝10分間の瞑想を習慣にすることで、心が穏なり集中力が増した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "喧騒を離れた寺院の静寂の中で、座禅を組みながら深い瞑想にふけった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ストレス解消のために瞑想を始めたら、夜ぐっすり眠れるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "つまり、人の顔色を見るやうな能力はみるみる発達する一方、瞑想だの理念だのは、さなきだに濃厚ではないのが、発展の余地を持たなくなり、益々衰へてゆくのである。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その寺は庭が広く、背後に老杉の茂った林があったので、彼の瞑想的な散歩に最も好ましい所であった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して瞑想とは、その反対に、吸気の気持でなされると思はれる。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮りに思想が分析によつてはじめて形態を取るとしても、思想の実質は、瞑想そのものではないが瞑想状態にある。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術は扨措いて、生活の中ででもそのやうな手合は困るのであつて、それらの人が朝目覚めた時の無念無想、即ち瞑想状態が、精神にも物質にも有益であつて、其処にこそ現実があり欣怡のあることに想到されるやう、私一介の馬鹿は希つてゐる。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "芭蕉は瞑想的で、蕪村は感覚的なのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その鮓は、時間の沈滞する底の方で、静かに、冷たく、永遠の瞑想に耽っているのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "既に年経て、古く物さびた庵の中には、今もなお故人の霊がいて、あの寂しい風流の道を楽しみ、静かな瞑想に耽っているように見えたか知れない。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る時間的なイメージを持っているところの、沈痛な魂の瞑想が感じられ、象徴味の深い俳句である。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の凍りついた家の中で、芭蕉は瞑想に耽りながら、骨のように唯一人で坐っている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対に孤独癖の人間は、黙って瞑想に耽ることを楽しみとする。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋人と東洋人とを比較すると、概してみな我々東洋人は、非社交的な瞑想人種に出来上ってる。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまた一種の瞑想家です。",
              "citation": {
                "source": "ふつくりとした人柄",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人と話をしてゐる中にも、何かの瞑想に捉はれてゐる時がよくあります。",
              "citation": {
                "source": "ふつくりとした人柄",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "北原氏の如き人は、一般に瞑想家と言はれる部類の人の中でも特に極端の方でせう。",
              "citation": {
                "source": "ふつくりとした人柄",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一緒に散歩に出ても、絶えず何かの瞑想に耽つてゐるので、こつちで癇癪を起すことがよくあります。",
              "citation": {
                "source": "ふつくりとした人柄",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジユリアンの場合は、詩人が皇帝の家系に生れ、瞑想家であるべき人が、境遇のために武人となり、誤つて戰場に出たことに悲劇をもつてる。",
              "citation": {
                "source": "足利尊氏",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上私には、道を歩きながら瞑想に耽る癖があった。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　瞑想から醒めた時に、私の心に浮んだのは、この心細い言葉であった。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国の日本人経営のクラブとかレストランでは先例によって女を雇入れることはめったにないことなのだが、私は天津の日本租界、敷島町の或るレストランに近頃日本の少女が青磁の衣服をつけてそれでなくとも感傷的になった旅人の私の心を瞑想的にするのに会ったことがある。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は終日、彼女にあたえられた部屋で過去の瞑想にふけっているようであった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その飽くまでも靈の世界の永遠を信ずるの強きに於て、また絶え間なき祈祷と瞑想によつて精神生活を充實せしめ、怠りなき勞働によつて肉體を鞭打ちつつ妄執と欲望と邪念から解脱せんとする努力に於て、私は尊ぶべきものあるを思ふことが出來る。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「人は瞑想によつてのみ信仰の道に達す。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大津は独り机に向かって瞑想に沈んでいた。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の学者などの中にはほとんど年中、あるいは生涯貧しい薄暗い家の中に引き籠ったきりで深い思索や瞑想に耽っていたような人もあったらしい。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしそれこれを憶うていよいよ感じ、瞑想（めいそう）静思の極にいたればわれ実に一呼吸の機微に万有の生命と触着するを感じたりき　もしこの事、単にわが空漠たる信念なりとするも、わが心この世の苦悩にもがき暗憺たる日夜を送る時に当たりて、われいかにしばしば汝に振り向きたるよ、ああワイの流！",
              "citation": {
                "source": "小春",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし寝坊をして出勤時間に遅れないように急いで用を足す習慣のものには、これもまた瞑想に適した環境ではない。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って満員電車の内は存外瞑想に適している。",
              "citation": {
                "source": "路傍の草",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はしばらく瞑想して見たが、とても堪へ切れなくなつて、そつと眼蓋を上げて四辺を見廻した。",
              "citation": {
                "source": "逆徒",
                "author": "平出修",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これが僕んですよ」「これが僕んですよ」　子供たちはめいめいそう言って、自分の影法師の前に立ってみせました。",
              "citation": {
                "source": "影法師",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
