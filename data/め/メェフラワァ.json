        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "メェフラワァの帰り二　米国の画家ヂャルヂ、ヘンリー、バウトンの描いた「メェフラワァの帰り」と云う画がある。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メェフラワァは、約三百年前、信仰、生活の自由を享けん為に、欧洲からはる／″＼大西洋を越えて、亜米利加の新大陸に渡った清教徒の一群ピルグリム、ファザァスが乗った小さな帆前船である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の眼はじっと遠ざかり行くメェフラワァ号の最後の影に注がれて居る。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メェフラワァは故国との最後の連鎖である。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メェフラワァの去ると共に故国の縁は切れるのである。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新生涯の新夫婦、メェフラワァを目送するピュリタンの若い男女の一対の其一人は欠けた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
