        "examples": {
          "standard": [
            {
              "text": "問題が大きくなる前に、芽を摘むことが大切だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「出る杭は打たれる」という言葉通り、彼は周囲から才能の芽を摘まれるような嫌がらせを受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "将来性のある若者の芽を摘むのではなく、大切に育てていくのが我々年長者の役割だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「ねえ、みんな、おまへさんたちいゝ子だから、この蔦の芽を摘むんぢやないよ。",
              "citation": {
                "source": "蔦の門",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その間を二人は葉煙草の脇芽を摘むことにした。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の暑いさかりに芽を摘む時なんか、木と木との間をまるで這ひ※るやうにしてやるんです。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽の光が細くさし込む金網の窓に顔をよせて、めをつむると、こんな幸せは僕以外に知らないだろうなあーと思うのです。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
