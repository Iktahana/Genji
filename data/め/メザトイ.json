        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "少しの物音でも目ざとい彼は、すぐに目を覚ます。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "赤ちゃんの目ざとい泣き声で、母親はすぐに駆けつけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅行中は、何かと目ざといのでぐっすり眠れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
