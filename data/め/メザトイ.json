[
  {
    "uuid": "37abc6c6-ef1a-5ee2-a3e1-3bf62c6576de",
    "entry": "目ざとい",
    "reading": {
      "primary": "めざとい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
