        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "漢文の口頭試験のようなものだったが、先生はメントル・テストだとおっしゃった。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "正三君はメンタルとおぼえていたけれど、漢学の方ではメントルかしらと考えた。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はメントル・テストの流儀にしたがってお学友の心得をお話しいたしましょう」「はあ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "メントル・テストです。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「内藤君、きみは安斉先生のメントル・テストを受けたね？",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろと教えていただきました」「あれはやっぱりメントルだとさ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いいえ、はあ、しかし……」「頭脳明敏の優等生にこれぐらいのメントル・テストがわからないはずはありますまい。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "正三君は部屋へひきさがって、安斉先生のいわゆるメントル・テストを考えた。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご身分をうかがって、メントル・テストにかけます。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうだしぬけにメントル・テストをやるものだから、安斉さんはいやがられる。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「はあ」「一つわしがメントル・テストをしてみよう」　と安斉先生は例によってメントルだ。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「漢文のメントル・テストがあるようなら僕はすぐ帰るよ」　と細井君がいった。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロソロ得意のメントル・テストにかかるのである。",
              "citation": {
                "source": "苦心の学友",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
