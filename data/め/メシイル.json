        "examples": {
          "standard": [
            {
              "text": "歳をとって両眼が盲いる前に、もう一度故郷の山々を拝んでおきたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "若くして不治の病で盲いた彼は、聴覚だけを頼りにピアノを弾き続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "強い光を浴びて一瞬盲いたようになり、私は思わずその場にうずくまってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "彼は恋に盲いる先に孤独に盲いている。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから恋に盲いることなど、できやしない。",
              "citation": {
                "source": "青鬼の褌を洗う女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "邪教という環境に住みなれて、世良田ほどの男も別天王を救うに人を殺す暗愚な手段を用いてしまったが、恋に盲いると、頭の冴えの非凡なるものも一朝にして曇るのが人間の常でもあるのさ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            }
