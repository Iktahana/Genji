  {
    "uuid": "b960d328-57c0-5127-87e3-0f74b77605a9",
    "entry": "目指し",
    "reading": {
      "primary": "めざし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
