        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "メティエンヌ爺さんと言って、墓掘りです。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "メティエンヌ爺さんといって、もう老耄です。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はメティエンヌ爺さんと二人きりになります。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "メティエンヌ爺さんを酔っぱらわすには造作はありません。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "人のいい肥っ面の墓掘り爺メティエンヌを、彼はこの二年ばかりの間に十ぺんくらいは酔っぱらわしたことがあった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はメティエンヌをもてあそび、掌中にまるめこみ、自分の欲するままに取り扱った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "メティエンヌの頭はいつもフォーシュルヴァンのかぶせる帽子のとおりになった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「墓掘り人はメティエンヌ爺さんだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だが、」と彼は弱々しく言った、「墓掘り人はメティエンヌ爺さんだがな。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナポレオンの後にはルイ十八世が出で、メティエンヌの後にはグリビエが出る。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "メティエンヌ爺さんが死んだって！",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "メティエンヌじいさんは死んだが、小ちゃなルノアール爺さんは生きてる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああメティエンヌ爺さんが死んだって。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それではメティエンヌ爺さんは死んだんだね。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとメティエンヌ爺さんの番だった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもはフォーシュルヴァンが言い出して、メティエンヌ爺さんが金を払った。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで俺はメティエンヌ爺さんのあとを引き受けたのさ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして彼はフォーシュルヴァンと同じくメティエンヌ爺さんを当にしていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧師が立ち去る、フォーシュルヴァンはメティエンヌを飲みに引っ張ってゆく、自分は一人になる。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「メティエンヌ爺さんが悪いんだ。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
