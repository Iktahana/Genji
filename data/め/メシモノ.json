    },
    "definitions": [
      {
        "index": 1,
        "gloss": "clothing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "パーティー会場には、豪華な「召し物」を身に纏った招待客が続々と集まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「本日の素晴らしい『召し物』は、どちらのデザイナーのものですか？」と司会者が尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お出かけの際は、季節に合わせた上品な「召し物」を選びたいものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "いま一人が影武者というのだ」「そこでお召し物はなんと踏んだ」「藤色と踏んだよ」「え、藤色とばかりじゃ、本読みが納まらねえぜ。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い男と女の方のお召し物は御座いますが、魔法使いの着物は御座いませぬ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お召し物も来たんでしょう？",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのとき山鳩色の絹の召し物に駝鳥の羽根飾りをつけてお越しでしたよ。",
              "citation": {
                "source": "シルヴァブレイズ",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "華麗な気の放たれることは昔にましたお姿であると思った源氏は前後も忘却して、そっと静かに帳台へ伝って行き、宮のお召し物の褄先を手で引いた。",
              "citation": {
                "source": "源氏物語",
                "author": "榊",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮は上着を源氏の手にとめて、御自身は外のほうへお退きになろうとしたが、宮のお髪はお召し物とともに男の手がおさえていた。",
              "citation": {
                "source": "源氏物語",
                "author": "榊",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮のお召し物の動く音などもほのかではあるが聞こえてくると、源氏は恨めしさも忘れてまず涙が落ちた。",
              "citation": {
                "source": "源氏物語",
                "author": "榊",
                "note": "青空文庫"
              }
            },
            {
              "text": "お二人ともそのぬれた召し物ではお冷えなさりましょう。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "髪は文金の高島田に結いあげ、召し物帯いっさいが女の服装でありながら、一枚下はあきらかに男性だったのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃ、辰ッ、そのまにだんなのお召し物をてつだっておあげ申せよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七化け役者",
                "note": "青空文庫"
              }
            },
            {
              "text": "さう言へば青木さんにはこれからのお召し物も御不断のが一枚しかおありにならない。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "な、ほら、たたんでおいたお召し物までが、このとおりぬれてまっしゃろ」「ほほう、いかにもな。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "召し物は豪奢だが、英国では悪趣味と見なされる類である。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きすぎて、女性の召し物に隠すのは容易ではない。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "新婚時代の新郎の衣服として宮のほうへおいでになる院のお召し物へ女房に命じて薫香をたきしめさせながら、自身は物思いにとらわれている様子が非常に美しく感ぜられた。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫宮は可憐で、たいそうなお居間の装飾などとは調和のとれぬ何でもない無邪気な少女で、お召し物の中にうずもれておしまいになったような小柄な姿を持っておいでになるのである。",
              "citation": {
                "source": "源氏物語",
                "author": "若菜（上）",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうお身体は隣の間へはいっていたのであるが、お召し物の裾がまだこちらに引かれていたのである。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理やりに荒々しく手を宮のお召し物から引き放させるようなこともできる相手ではなかった。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いてあそばされたお物思いのせいかほっそりと痩せておいでになるのが、お召し物越しに接触している大将によく感ぜられるのである。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮は母君の所へ行こうとあそばされて、額髪の涙でかたまったのをお直しになり、お召し物の綻んでいた単衣をお着かえになっても、お気が進まないでじっとすわっておいでになるのであった。",
              "citation": {
                "source": "源氏物語",
                "author": "夕霧一",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏の更衣に花散里夫人からお召し物が奉られた。",
              "citation": {
                "source": "源氏物語",
                "author": "まぼろし",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の奥のほうに向こうを向いてすわっている女王の後ろでは薄鈍でない他のお召し物に姫君をお着かえさせるようにとか女房らが言っていて、だれもが今夜で結婚が成立するもののようにして、こそこそとその用意をするらしいのを、姫君はあさましく思っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "総角",
                "note": "青空文庫"
              }
            },
            {
              "text": "お召し物などを今夜になってからそっとお届けさせるようにお供へお命じになるお取り次ぎを今私はしましたよ」　などと言った。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮の御様子は艶で、夜中の霧に湿ったお召し物から立つ香はたとえようもなく感じのいいものであった。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっと薄いお召し物を宮様にお着せ申せ。",
              "citation": {
                "source": "源氏物語",
                "author": "蜻蛉",
                "note": "青空文庫"
              }
            },
            {
              "text": "御食事は勿論、御召し物さえ、御不自由勝ちに違いありませんから。",
              "citation": {
                "source": "俊寛",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "元より薄色の袿と申しましても、世間に類の多いものではございますが、もしやあれは中御門の姫君の御召し物ではございますまいか。",
              "citation": {
                "source": "邪宗門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "お顔もお姿もお召し物も。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "田丸浩平は、茶を飲み終ると、「ご馳走さん、話はあとでゆつくりするとして、ちよつとお隣りへお悔みに行つて来ます」　結城ひろ子が、「お召し物は？",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見て取った紳士は慌てて言葉を継いだ：「お召し物のことでしたらご心配に及びません。",
              "citation": {
                "source": "夢日記",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
