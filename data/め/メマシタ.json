        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソシテ　ヒバリハ　スガタガ　ミエナク　ナルホド　タカク　ノボツタ　トキ　ウツクシイ　コヱデ　ウタヒハジメマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウダ、コノ　キノドクナ　ヒトビトヲ　タスケテ　ヤラネバ　ナラナイ」　ヲトコハ　アチラ　コチラノ　ムラニ　ノコツテ　ヰル　ヒトビトヲ　ヒトトコロニ　アツメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒトビトハ　ゲンキヲ　ダシテ　ハタケデ　ハタラキハジメマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ　チヤウサンハ　ウチニ　カヘルト、サツソク、ロバニ　ヒカセル　クルマヲ　ツクリハジメマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネンネン　ヨヲヲヲ　ネンネン　ヨウ」　シカシ、アカンボウヨリ　サキニ、コモリノ　ハウガ　ウツラ　ウツラ　ネムリハジメマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカイ　フウセンダマハ　ソラノ　ハウヘ　ノボリハジメマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『記者様――私ハ、アナタノ新聞ノ記事ヲ読ンデカラ眼ガ醒メマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トヒトリデ、ブツブツオコリナガラ、マタホンヲヨミハジメマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロノナカニ　コロガツテヰルト、ナニカ　ウチノナカデサワガシイ　オトガ　シハジメマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタニナツテ　メガサメマシタガ、ドツチガ、サキニネムツタノカ　フタリトモ　ワカリマセンデシタ。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
