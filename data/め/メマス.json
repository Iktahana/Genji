        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "モシ貴官ガ今年一パイ、コノ問題ヲ調ベズニ打チ棄テテオカレタナラバ、貴官モ爆弾売リノ仲間ト認メマス。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「六月四日に法事早メマス」とお母さん、ペンの跡｜淋漓というはりきりかたでお書きです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをアメマスと称している。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアメマスはエゾイワナと言うのが本名で、北海道では陸封された川や湖沼に生活しているが、樺太へ行くと川にも棲み、海へ遊びに行く。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
