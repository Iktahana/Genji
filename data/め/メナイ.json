        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ナグサメナイデホシイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一名はオメケイオコデと為し、一名はオメナイオコデと為し（方言、男兄弟をオメケイと言い姉妹をオメナイと言う）、其の神を祭る一切の事を掌る。",
              "citation": {
                "source": "ユタの歴史的研究",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "目ヲトジテヰルジヤガイモサンハ、石ニツマヅイテ、何度モコロンデ、コブダラケニナツテモ　マダマダ、目ガサメナイデ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木君に従えば同じ山形県でも酒井家の領分を離れた山形地方では、オクメナイ様といっているという。",
              "citation": {
                "source": "オシラ神に関する二三の臆説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "してみればオクナイ実はオクメナイの略称かもしれぬ。",
              "citation": {
                "source": "オシラ神に関する二三の臆説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ入浴ノ助手ハ、婆サンハ転ンデカラ以後勤メナイノデ、颯子カ女中ガ勤メルノデアルガ、佐々木ノヨウニ上手ニ親切ニハ助ケテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者ニモドンナニ説明シテモ呑ミ込メナイラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは日本語にてはママの原義が説明しあたわぬ上、『蝦夷語地名解』（再版四〇三頁）には、北見｜宗谷郡メメナイ、崩れ川、崩壊をメメという。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
