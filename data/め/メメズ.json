          "literary": [
            {
              "text": "僕はメメズと呼ばれると、いつでもこの長い身体が半分位にちぢまってしまうのだ。",
              "citation": {
                "source": "みみず先生の歌",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "メメズ小僧は、いねえだろうな？",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "メメズ小僧とはよく云った。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ゃあのガキをウチへ泊めるぐらいなら、ホンモノのメメズと一しょにドブへねる方がマシだよ」　そこで金サンは隣の床屋へでかけた。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると、自分の倅のことだから、メメズ小僧と正坊の対局よりも心配だ。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "マキはたしかに二割引で売って下さるんでしょうね」「売ってはやるが、メメズ小僧は負けやしまいな」「負けるもんですか。",
              "citation": {
                "source": "町内の二天才",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
