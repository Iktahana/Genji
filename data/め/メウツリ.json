    "definitions": [
      {
        "index": 1,
        "gloss": "being drawn to many things",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "百貨店のバーゲンセールでは、目移りしてしまってなかなか決められない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "たくさんの魅力的な商品がありすぎて、どれを買うか目移りしてしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は新しいものにすぐに目移りする性格なので、飽きっぽいところがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "さうなるとなか／＼目移りがして、うつかり決めるわけには行きますまい。",
              "citation": {
                "source": "能因法師",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞記者は、気移り目移りの早い人々です。",
              "citation": {
                "source": "新しい国語教育の方角",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "美も技巧もいくらでも目移りし易いものだし、男にサービスさせる要素がある限りは、いずれは崩れるものにきまっている。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その八　安吾愛妻物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "細かく終いまで読み通したい本があったら、それをそっくり持って降りることも許されるのだが、名も聞かぬような本があまり多いので、つい目移りがして次々と本箱の蓋をとる。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして見ると、行き悩んだ筆の疲れを休めて、目の下の風景を指呼してみたくなるらしく、お雪ちゃんは、見ゆる限りのところに於て、あれかこれかと目移りがします。",
              "citation": {
                "source": "大菩薩峠",
                "author": "勿来の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "できない、おっかあ」　その声はわずかに震え、不安げに目を泳がせ、黒いオーク材から、火床にあるぴかぴかのフライパンへ目移りした。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "極く極く漠然とした眼移りのするような心地でもって、町へ行って娘達に逢うのを楽みにしたり、見知り越しなお嬢さんの家の門なぞに佇立んだり、時には繁子の居る寄宿舎の方へ、あるいは彼女が教えに通う学校の窓の見える方まで行ったりして、訳もなしに彷徨い歩かずにはいられなかった。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっちこっち眼移りがしたからさ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふふん妙なことをしやあがる」　こう思いながら宗三郎、切り込んで行こうとするのであるが、眼移りがして切り込めない。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「如何いたしましょう」「一度に見ては眼移りがするだろう、一人一人これへ連れて参れ」「かしこまりました」　三文字紋弥は天下の大事を扱うような、至極真面目な顔をして退きました。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "暴君の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
