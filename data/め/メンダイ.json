          "literary": [
            {
              "text": "「後がきましたらダルマを引きますから、見はからいメンダイにツナイで下さい」「ツナギ」は引っ張る、延ばす。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い物はすべて「メンダイ」である。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「帰りにそばでも食べて行こう」というのは、「帰りにメンダイでもノセて行こう」　字は麺台と書くのかも知れない。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "メンダイの反対語が「アシ」である。",
              "citation": {
                "source": "符牒の語源",
                "author": "三代目　三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
