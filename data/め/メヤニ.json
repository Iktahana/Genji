    },
    "definitions": [
      {
        "index": 1,
        "gloss": "eye mucus",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "朝起きると、いつも目やにがたくさんついている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "猫が黄色い目やにを流していたので、動物病院に連れて行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "花粉症の季節は、目のかゆみと目やにに悩まされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "固より身をやつす色氣十分の男であるから、道中笠の中ながら目やにのついた顏は、茶店の婆にも覗かせたくない。",
              "citation": {
                "source": "二た面",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、そのさるまわしはもう五十をすぎた老人で、腰はよぼよぼと弓のごとく曲がり、目にはいっぱいの目やにがたまって、顔は赤黒く日にやけ、いかにも見すぼらしいかっこうでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は目やにで目をあけるのに苦しむこともあるほどであつた。",
              "citation": {
                "source": "盲目",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "板にはたいのような形が彫ってあるので、じいさんはそれにメリケン粉をどろりと流す、それから目やにをちょっとふいてつぎにあんを入れその上にまたメリケン粉を流す。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとといは目をしょぼつかせてこすっていたが、今朝は目やにがたくさん出て目があかなくなってしまった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "目やにに汚れた顔を見ると、しみじみ落ちぶれたのを感じる。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "目のわるい奥さんは、朝おきるといつも目やにがたまっているのです……　ここだけはほんとのことなので、思わずくすっと笑ったとき、空想は霧のように消えてしまった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "きれいに澄んだ十二の瞳、一重まぶたの細い目、くるくるした丸い目、目やにでよごれた目もある。",
              "citation": {
                "source": "赤いステッキ",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうだ、やはり佐々木小次郎」　つぶやいて、八十馬は、酔うと目やにの出る性らしい眼を、どろんと据え、「その上で、まだご仕官もなさらぬのか、惜しいものだ」「ただ剣一方に、すべてを打ち込んで来たので、世間にはとんと何の知己もないために」「や、なるほど。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めは何かい喃と、ぢつと眼をこらしてめやにのたまつたまなじりをぱちぱちさせてゐたが、白い蝶々なのだとおもふと、お婆さんは手を宙へあげてひらひらさせてみたりした。",
              "citation": {
                "source": "絵本",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "唖との交渉はとめやに限ると主人夫婦は云うた。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
      "synonyms": [
        "眼脂"
      ],
