        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "空中の音楽　西暦一八七四年九月八日詩人メーリケはス市の閑居で七十回の誕生祝をやった。",
              "citation": {
                "source": "怪談綺談",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその時、隣の寝室から詩人メーリケが、「誰だ、あの音楽はどこだ」　と叫んだ。",
              "citation": {
                "source": "怪談綺談",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "程なくメーリケは寝巻のまま二人の所へやって来て、悲しそうな顔をして、「誕生日も今日で到頭おしまいだ」　と叫んだ。",
              "citation": {
                "source": "怪談綺談",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "シュルツはゲーテとメーリケとの詩句を誦した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "この點に關しては、東ドイツに生まれたシュティフテル、シュワーベンに育ったメーリケと並び稱されている。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "年齡からいえば、シュティフテルよりは八歳、メーリケよりは七歳年長ではあるが、文藝活動に入ったのは、前述の事情によっても想像されるように、はるかに遲れている。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
