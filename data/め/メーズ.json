          "standard": [],
          "literary": [
            {
              "text": "ポト・ド・ヴェルサイユのそばの商業組織展（商業用具展なのさ）を見て、メーズリ展、真独立展を見て、平さんのところで食事した。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の浅草公園と云えば、名物が先ず蜘蛛男の見世物、娘剣舞に、玉乗り、源水の独楽廻しに、覗きからくりなどで、せいぜい変った所が、お富士さまの作り物に、メーズと云って、八陣隠れ杉の見世物位でございましたからね。",
              "citation": {
                "source": "押絵と旅する男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治の昔、流行した、パノラマ館、ジオラマ館、メーズ、さては数年前滅亡した、浅草の十二階などと同じ、追想的な懐かしさ、いかもので、ゴタゴタして、隅々に何かしら、ギョッとする秘密が隠されていそうな、あの不思議な魅力を、現代の東京に求めるならば、恐らくこの国技館の菊人形であろう。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
