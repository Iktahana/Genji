        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はジョルジュ・シメノンという人の探偵小説を読みはじめた。",
              "citation": {
                "source": "帰去来",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルサメノ露ノヤドリヲ吹ク風ニコボレテ匂フヤマブキノ花　天真爛漫とでも申しませうか。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒ハ酔フタメノモノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スズメノエンドウ、スズメウリ、スズメノヒエ、姫百合、姫萩、姫紫苑、姫菊の※たけた称に対して、スズメの名のつく一列の雑草の中に、このごんごんごまを、私はひそかに「スズメの蝋燭」と称して、内々｜贔屓でいる。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、せんだつて私のところから借りて行つたシメノンの探偵小説を風呂敷から出して、「うまいですね。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この、シメノンたらいふひと。",
              "citation": {
                "source": "當選の日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そら、大粒の赤玉、白玉のメノーを七宝の青い葉茎がくっきりうけとめている、チューリップ！",
              "citation": {
                "source": "五月の朝の花",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昔物語にアメノフイスといふ王ありき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣は懸る、高くのみ、ウメノキゴケ、気色のみ、母鳥や姿、羽ぶり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "巣は懸る、高くのみ、ウメノキゴケ、氣色のみ、母鳥や姿、羽ぶり。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "下乗之事禁中ヨリノ御使イ、並ビニ江戸公儀ヨリノ御使者以外ニ夜中ノ通行堅ク御差止メノ事　はっきりと禁裡御所からのお使い、並びに江戸お公儀からの使者以外は、夜中の通行堅くお差止めの事と書いてあるのです。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、アイノ人の本場平取村が近いだけに、髯武者のアイノや口のあたりに入れ墨したメノコを見ることが多く、その一セカチ（男兒）の如きは、義雄等の馬車について一二町も走つた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤイシヤマネーナとは「悲しやな」、クコロポンカンピとは「わが年若い帳場」、ナタアララとは「どこへ行つた」と云ふことで、若いメノコが漁場の帳場さんなる和人を愛してゐたが、その和人が内地へ歸つたのを戀ひ慕つて歌つたものである。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ナダイムスメノー」低く、然し氣取つてるやうな――「やつてる、やつてる！",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピイチク　ピイチク　ピイチク　ピイチク」　ヒバリノ　コヱハ　タカイ　ソラカラ　キンノ　アメノヤウニ　フツテ　キテ、ウマヤノ　ソバノ　ナタネノ　マワリニ　フリソソギマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルノデス」ト　ハジメノ　デンデンムシガ　ハナシマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ソレヂヤ　シカタナイト　オモツテ、ハジメノ　デンデンムシハ、ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカニモ　カナシミハ　イツパイデス」　ソコデ、ハジメノ　デンデンムシハ　マタ　ベツノ　オトモダチノ　トコロヘ　イキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウトウ　ハジメノ　デンデンムシハ　キガ　ツキマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコガ　メヲ　サマシテ　ミルト、コレハ　マタ　ドウシタ　コトデセウ、メノ　マエノ　オ花バタケガ　ムチヤクチヤニ　フミニヂラレテ　アリマス。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミドリイロノ　ペンキハ　アメノ　タメニ　ハゲテ　シマヒ、ワガネハ　アカク　サビテ　ヰマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……手前の不吉な前科も知らねえでノメノメとこの船へ押しかけて来やがったのが癪に触るんで……遠慮しやがるのが当前だのに……ねえ……親方……」「それあそうだ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねばれる蛇の卵見ゆ、かつは臭のくさければガメノシユブタケ顰めつつ毛根を水に顫はす。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "２．ガメノシユブタ。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねばれる蛇の卵見ゆ、かつは臭のくさければ＊ガメノシユブタケ顰めつつ毛根を水に顫はす。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "２．　ガメノシユブタ。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
