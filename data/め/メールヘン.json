        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小波がお伽噺に筆を染めたのは随分古い事で、二十一年十二月発行の『我楽多文庫』第十三号から「鬼車」というメールヘンの飜訳を連載したのがそもそもの初めであった。",
              "citation": {
                "source": "硯友社の勃興と道程",
                "author": "――尾崎紅葉――",
                "note": "青空文庫"
              }
            },
            {
              "text": "比較説話学の概念及び世界大拡布説話の一例　独逸語の「メールヘン」、これを翻して、遊離説話と云い、童話と云い、お伽噺と云い、或は略して、単に説話とも云う。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうしてその勤め場所は十吉にとつて、刻々に無数の発見とメールヘンとにみちた「森の中の家」に変つてきた。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "メールヘンだって、王子と姫君とが出てくるじゃありませんか」　と、忠告してくれたのが、当時の井口長二氏。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
