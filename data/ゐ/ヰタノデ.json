        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コノ　ウグヒスハ　オカアサンウグヒスデ、センダツテノ　コト、ボウヤノ　ウグヒスヲ　ナクシタノデ、タイヘン　カナシンデ　ヰタノデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ　ハナノ　下ニ　クロイ　ヒゲヲ　ツケテ　ヰタノデ、コドモタチハ　「ヒゲサン」ト　ヨンデ　ヰマシタガ、ヤガテ　タキクンノ　コトモ　「ヒゲサン」ト　ヨブヤウニ　ナリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ、イタチサンガ、オナラヲ　シタイノヲ　アマリ　ガマンシテ　ヰタノデ　コンナ　コトニ　ナツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イマ、オトナリノハタケムラカラ、ヂヤガイモサンガ、アソビニキテヰタノデスガ、キウニヰナクナツタノデス。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トツテキテ、ハヤクナゲルンダヨ――」ト、トラ三ガドナツテヰタノデ、オバアサンハビツクリシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アサ　ミタトキヨリモ、モツト　モツト　カゲハ　オホキク　ナツテヰタノデス。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
