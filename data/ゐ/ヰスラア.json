        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夜もすがら夜もすがら歌ふ鶯……月白き芝居裏、河岸の病院、なべて夜の疲れゆくゆめとあはせて、ウヰスラアーの靄の中音に鳴き鳴きてそこはかとなし。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは好んでホヰスラアの描いた藝術の氣分を想像の綾に織りまぜて置いて、これを鑑賞すると共に、飜つて廣重の古調をなつかしむ。",
              "citation": {
                "source": "仙人掌と花火の鑑賞",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "花火の畫を描いたホヰスラアは世間から山師と呼ばれてゐた。",
              "citation": {
                "source": "仙人掌と花火の鑑賞",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "參考室にはヴエラスケス、レンブラント、ヴアン・ダイクの模寫がある、フオゲラアのエチングは珍らしいものと思はれたが、わたくしはエチングに對して、ウヰスラアのテエムス・セツトのやうなリアリスチツクなものを好む偏見を有つてゐるので、唯その美しさを賞するに止まつた。",
              "citation": {
                "source": "七月七日",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "その壁のところに、原色刷の海の額がかかっている、見たことのある絵だが、こんな色はヰスラアではないか知ら……私はこの額がここにあるのを賛成した。",
              "citation": {
                "source": "西班牙犬の家",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
