        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "書生の身の上を思つたり、また、その映寫機のフヰルムから發火して大事になつたらどうしようとそのことが心配で心配で、その夜はあけがた近くになる迄まどろむ事が出來なかつたのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親ニモ同胞ニモワカレテ仕ヘテヰルノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」和田ガ喜ンデヰルサウデス　将軍家は、やつぱりお弱い御口調でおつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "六年前の建暦元年六月三日丑剋、将軍家御寝の際、高僧一人御夢の中にあらはれて、汝はもと宋朝医王山の長老たり、とお告げになつたのださうで、誰ニモ言ハズニ居リマシタガ、ソナタノ物語ト符合シテヰルトハ面白イ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタコノヘンノオテラ、ボンゾサン　シッテヰルゴザイマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとこれで間に合うと言って、パテーベビーの映写機を持って来て、最新のフヰルムをかにかくに自分で写してみせます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "過ぎ去った一年ほどの間に眼に見えて縺れ出した葛岡とわたくしと先生の間の経緯が、まるで流行り廃ったフヰルムの截片のように値打なく観られます。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひょっとしたら、わたくし同様、過去のいきさつを流行り廃ったフヰルムの截片のように胸の中で値打なく顧みているのではありますまいか。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一ツノ片割レハ今｜樺太ノ炭坑ニヰルハズダ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで先生の草がきを見ると「ヰルナラタヅネル」一字のことだ。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヰルナラサガス」此れなら、局待の二字分がきちんと入る、うまいでせう。",
              "citation": {
                "source": "春着",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホメロス、ソクラテエス、ブルツス、ヰルギリウス、これ皆永く樂土の門に入ること能はずしてこゝに留りたるものなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃我はヰルギリウスを讀みき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れヰルギリウスが詩の主人公エネエアスが乳媼の名にして、此港を以て其埋骨の地となせるなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞説らく、昔はボツカチヨオ涙をヰルギリウスの墳に灑ぎて、譽を天下に馳せたりとぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "其日の興行はセヰルラの剃手にて、その末折の終りてより、我即興詩は始まるべしとぞ掟てられし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "セヰルラの剃手の曲の爲めに登場する俳優は、乍ち去り乍ち來り、演戲のその心を擾さゞること尋常の社交舞に異ならず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "セヰルラの剃手の僅に末齣を餘したる頃なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日フランチエスカ夫人は姫を伴ひてヰルラ、デステの園の中をそゞろありきし給へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりして、我足は日として四井街に向はざることなく、偶※識る人に逢ふことあれば、散歩のゆくてはヰルラ、アルバニなりと欺きつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人は學者ではなかつたが、アメリカのヰルソンなどと云ふ人が、日本の植物を採集に來た時も案内者に選ばれたほどで、日本の植物の名をば好く知つてゐた。",
              "citation": {
                "source": "すかんぽ",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……朝も三平汁、昼もおなじ三平汁（三平汁は樹明直伝のもの、朝も三平、昼も三平、そして晩も三平だつたら、合して九平、クヘイ、クヘイ）、晩はにんぢん葉の煮付、何を食べてもうまい、此点に於て、私はほんとうに幸福だ、やつぱりメグマレテヰル！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケキヨ、ヨ　ケキヨ、ヨ」　チヨウド、ソレハ　ナキジヤクリシテ　ヰルヤウニ　カナシイ　オトデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、「オンモハ　ドンナ　トコロデセウ」ト　ドノ　ツボミモ　オモツテ　ヰルノデ　アリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタツムリガ　ツノヲ　フツテルノヲ　ミテ　ヰルト、王サマハ、子ドモノ　ジブン、何ダカ、カタツムリノ　ウタヲ　ヨク　ウタツタ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テンカン　テンカント　イサマシイ　オトガ　シテ　ヰルノデ　イツテ　ミルト　カジヤデシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フエフキハ、タカイ　トコロデ　ハタライテ　ヰル　ダイクノ　テニ　カナヅチガ　ニギラレテ　ヰルノニ、ハジメテ　キガ　ツイタヤウニ　オドロキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
