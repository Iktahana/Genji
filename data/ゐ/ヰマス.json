        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「フーネニホ、ホバシラニハータ、コヒガヰマス、ヒゴヒモヰマス……」　雨がザアーツと降り出して来た。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "和田ガ上総ノ国司ヲ望ンデヰマスガ「いけませぬ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウマヤノ　マエノ　ヒザシガ　ヒニ　ヒニ　アタタカク　ナツテ　クロイ　土カラ　白イ　ユゲガ　ノボリハヂメテ　ヰマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシハ　モウ　メヲ　サマシテ　ヰマス」「アラ　アラ、ソレデハ　スグ　デテ　イラツシヤイ」　ヤガテ　ソノ　ツボミガ　フタツニ　ワレテ　ナカカラ　ナニカ　デテ　マヰリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、サムライハ　マダ　フルツテ　ヰマス。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ前タチ、デンデンムシノ　ウタ　シラナイカ」ト、オソバノ　モノニ　キイテモ、「シリマセン」ト　イツテ　クビヲ　カシゲテ　ヰマス。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、カネガ　ナツテ　キヨウシツノ　マエニ　ナラビニ　ユクト、ミツルクンハ　マダ　ナイテ　ヰマス。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレガ　オホキク　ナル　シヨウコデス」　ミルト　ナルホド、ナガイ　ミミガ　フタツ、ニヨツキリ　ハエテ　ヰマス。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オネコサン、私ハカゼヲヒイテ、真白ナキモノヲキテネテヰマス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ私ハ持ツテヰマス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコノオバアサンハ、マイニチ、コンナフウニクラシテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト　チヒサナ　ナミガ　ヨセテハ　カヘシテヰマス。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スルト　ナミモ　ウタツテ　ヰマス。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　イツモハ　シロヤ　ブチガ　チヨツト　アガツテモ　タイヘンニ　シカラレル　ソノタタミカラ、クモノヤウナ　ホコリガ、イツパイニ　マヒアガツテヰマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イケノカメサンタチモ　ウツラ　ウツラト　ヒナタボツコヲ　シテヰマス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ハンブン　ヰネムリナガラ、ソレデモ　ハナシヲ　ツヅケテヰマス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイケノカメサンタチモ　ウツラ　ウツラト　ヒナタボツコヲ　シテヰマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フタリハ　ハンブン　ヰネムリナガラ、ソレデモ　ガマンシテ　ハナシヲ　ツヅケテヰマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――ウサギノミミ私ハウサギヲカツテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノ家ニハ犬ヤネコガヰマスカラ、ウサギハベツニシテ、ゲンカンニオイテアリマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ「オヤ、オカシイナ、ソツチノミミモ立テナサイ」トイヒマシタケレドモ、ウサギハシランカオシテヰマス。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪子は自分も字引を見ながら、「オカシナ」を「ヲカシナ」に、「タオレ」を「タフレ」に、「シランカオシテヰマス」を「シランカホシテヰマス」に直しただけで、外には何処も文章として間違ったところはないように思ったが、当惑したのはこの「足デ」の処置であった。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
