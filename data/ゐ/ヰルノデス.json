          "literary": [
            {
              "text": "親ニモ同胞ニモワカレテ仕ヘテヰルノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルノデス」ト　ハジメノ　デンデンムシガ　ハナシマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ツテヰル間中、死ンダヤウニナツテヰルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、毎日、ダレカヌツテクレソウナ人ガ通ラナイカトミテヰルノデス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
