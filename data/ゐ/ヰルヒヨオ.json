          "literary": [
            {
              "text": "独逸の宰相ビスマルクが議会で反対党のヰルヒヨオから小つ酷く攻撃された事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヰルヒヨオは独逸のお医者さんだから、その攻撃に謡曲や蓄音機を持込んだ訳でもなかつたが、ビスマルクは鉄瓶のやうに湯気を立てて怒つた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヰルヒヨオは急きこんだ大宰相の顔をじろ／＼見て、気味が悪い程落付いてゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
