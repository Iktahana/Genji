          "literary": [
            {
              "text": "親ニモ同胞ニモワカレテ仕ヘテヰルノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、「オンモハ　ドンナ　トコロデセウ」ト　ドノ　ツボミモ　オモツテ　ヰルノデ　アリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テンカン　テンカント　イサマシイ　オトガ　シテ　ヰルノデ　イツテ　ミルト　カジヤデシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルノデス」ト　ハジメノ　デンデンムシガ　ハナシマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "“U. S. R. S. Flanklyn”フランクリン号ナル、レシービングシツプデアル、大概港ノ中ニ碇ヲ降シテヰルノデ危険ノ憂ヒハナイガ、僕ニハヤハリ水雷艇ノ方ガ面白イ、君ノ冒険心ガ健ヤカニ成長スルコトヲ望ンデヰル。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハソノ神ガ乗リ移ツテヰル間中、死ンダヤウニナツテヰルノデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一国ノ平和ヲ護ル争闘意識ノ象徴ハ、マタ同時ニ、閃々タル指揮刀ヲタバサム華ヤカナ装飾人デアルコトヲ自覚シテヰルノデアラウ。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、毎日、ダレカヌツテクレソウナ人ガ通ラナイカトミテヰルノデス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
