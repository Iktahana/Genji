    "definitions": [
      {
        "index": 1,
        "gloss": "to",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "少年は振り返ることもなく、夕日が沈む地平線の彼方へと歩き去っていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "長年住み慣れた実家を離れ、彼女はついにあこがれの東京へと旅立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古い手紙の束は、燃え盛る暖炉の炎の中へと次々に放り込まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それからそれへと、私は想ひを馳せた。",
              "citation": {
                "source": "逝ける辻野君",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に面倒なことを避けようといふのではない、避けたいことはいつ何時だつて避けたいのだが、而も事に面前すれば、どうせ理想家の私のこと、どうせへとへとになるまでは打つ衝かることは知れたことだが、まあなんとしても、その時は額に重い力を感じた。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝道婦なぞといふ奴は、何処に行つても信者といふつながりでそれからそれへと知合ひを作つてしまふ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は足袋のために、もうへとへとであった。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親の俺からみてもおまへと耕二は大変な違ひだ。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――表の掛軸を好い加減に換へとけよ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然るに彼も亦神の手になれるもの、常に理想の方向へとのみ盲目なれど強き力もつ衝動と共に生く。",
              "citation": {
                "source": "地上組織",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――人はあせりにあせり、もつともつとと渉猟した揚句は、益々不消化となり益々苛立つて、その不消化解消にもと、益々渉猟するのだが、どうも不消化は解消しさうにもないといふので急に重曹を飲用するやうに、批評書へと赴くのではあるまいか。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "隙間もない茂りの緑は霜にややさびて得も云われぬ色彩が梢から梢へと柔らかに移り変っている。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "不知不識其方へと路次を這入ると道はいよいよ狭くなって井戸が道をさえぎっている。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処を右へ曲るとよう／＼広い街に出たから浅草の方へと足を運んだ。",
              "citation": {
                "source": "根岸庵を訪う記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸文へと思いしが知らぬ家も興あるべしと停車場前の丸万と云うに入る。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃になって、自分に親しかった、そうして自分の生涯に決定的な影響を及ぼしたと考えらるるような旧師や旧友がだんだんに亡くなって行く、その追憶の余勢は自然に昔へ昔へと遡って幼時の環境の中から馴染の顔を物色するようになる。",
              "citation": {
                "source": "重兵衛さんの一家",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小津神社の裏から藪ふちを通って下へ下へと行く。",
              "citation": {
                "source": "鴫つき",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は實に不便な思ひをしながらも、最も人に迷惑をかけないやうな身の置き所から、身の置き所へと、恰も飛石づたひのやうに拾ひ歩かなければならなかつたのである。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と龜に言はれた時には、しかし、もうそんな、さかさの感じは無く、當り前に龜の甲羅の上に坐つて、さうして、龜は下へ下へと泳いでゐる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは、あしたお辨當をたくさん作つて持つて行つて、一心不亂に働いて十貫目の柴を刈つて、さうして爺さんの家へとどけてあげる。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お婆さんは、なほもしつこく次から次へと詰問する。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてなぜ、どこへといふ事は知らないのです。",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）わが家へと入りてみれば　　なごやかにうちまじりつつ秋の日の夕陽の丘か炊煙か　　　　われを暈めかすもののあり　　　　　　　　　　　　古き代の富みし館の　　　　　　　　　　カドリール　ゆらゆるスカーツ　　　　　　　　　　カドリール　ゆらゆるスカーツ　　　　　　何時の日か絶えんとはする　カドリール！",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗き空へと消えゆきぬ　　わが若き日の夢は希望は。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その浪はあまりに深く　　その月はあまりに清く、あはれわが若き日を燃えし希望の　　今ははや暗き空へと消え行きぬ。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆうべもおまへと別れてのち、酒をのみ、弱い人に毒づいた。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "想像するがままに任せた山、感情を塗りかえした山、その山の暗き森と、深い谷、過去へと深く行き、遠く行くだけ、紀念は次第に成熟する、石の上を走っている水の面の経緯は、幾世の人の夢を描いては消し、消しては描いているのである。",
              "citation": {
                "source": "梓川の上流",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "禽の、朗かに囀ずる声は、峰から峰へと火がつくようである。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は、南へと流れる。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちの、これから溯ろうという、東俣の谷と、西俣の谷とは、下流三里のところで一つになり、初めて田代川――馬子唄で名の高い、海道一の大井川の上流――となって、西南の方向へと、強い傾斜を走って行くのである。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、二回の徒渉をして、広河内へと達した。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
