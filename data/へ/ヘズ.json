        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一方ノ提供者ニハ生活費ノミヲ與ヘテ其ノ提供ノタメニ生レタル利益ヲ與ヘズ他方ノ提供者ノミ生活費ノ外ニ凡テノ利益ヲ專有スベシトハ、其ノ不合理ニシテ無智ナルコト殆ド下等動物ノ社會組織ト云フノ外ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "マサカニ兵卒ト同ジキ飮食ニテハ戰爭ニ堪ヘズト云フ者アルマジ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚シキハ即チ人民ノ窮苦ニ堪ヘズ［＋シテ］群起シテ其保護ヲ請願スルヤ有司ハ警吏ヲ派シテ之ヲ圧抑シ誣テ兇徒ト称シテ獄ニ投ズルニ至ル。",
              "citation": {
                "source": "直訴状",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "豈不肖余ノ故ヲ以テニアラズヤ感歎ニ堪ヘズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "折悪シク昨年来房州ヘ遊歴留守中早速ニ拝眉ヲ得ズ、消魂ニ堪ヘズ候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔南坊北巷望ムコト隣リノ如シ／我往キ君来ル数武ノ塵／何ゾ幸ヒナルヤ門庭接近ヲ成シ／恰モ宜シ詩酒精神ヲ闘ハスニ／柳橋妓ニ命ズルハ少年ノ興／駒野禅ニ参ズルハ前世ノ因／廿歳旧游游ビテ未ダ了ヘズ／又台麓酔吟ノ人ト為ル〕　昆渓が下谷に来ると間もなく毅堂が下谷を去った。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでアメノミナカヌシの神からヒコナギサウガヤフキアヘズの命までを上卷とし、神武天皇から應神天皇までを中卷とし、仁徳天皇から推古天皇までを下卷としまして、合わせて三卷を記して、謹んで獻上いたします。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでお産まれになつた御子の名をアマツヒコヒコナギサタケウガヤフキアヘズの命と申し上げます。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマツヒコヒコナギサタケウガヤフキアヘズの命は、叔母のタマヨリ姫と結婚してお生みになつた御子の名は、イツセの命・イナヒの命・ミケヌの命・ワカミケヌの命、またの名はトヨミケヌの命、またの名はカムヤマトイハレ彦の命の四人です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍令さえ出して、「無断ノ動キアルベカラズ」　と禁じ、「奇功ハ功ニ数ヘズ、先駆ケハ厳罰ニ附ス」　と、かたく持しているふうであると、さぐりの者は城中へ告げて来ている。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
