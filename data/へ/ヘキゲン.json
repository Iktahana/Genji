        "examples": {
          "standard": [
            {
              "text": "酒に酔った彼は、周囲の人々を困惑させるような僻言を並べ立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "上司の理不尽な僻言に耐えかねて、彼はついに辞表を提出する決意を固めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "議論が白熱するにつれ、相手の口からは冷静さを欠いた僻言が飛び出し始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
