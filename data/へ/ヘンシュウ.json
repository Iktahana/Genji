[
  {
    "uuid": "52d8f332-a004-5f06-91cf-6dfd9c87e785",
    "entry": "偏執",
    "reading": {
      "primary": "へんしゅう",
      "alternatives": [
        "へんしつ"
      ],
      "is_heteronym": false
    },
    "grammar": {
