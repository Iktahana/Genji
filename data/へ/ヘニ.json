        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夫女人ノ身ハ、五障三從トテ、オトコニマサリテカカルフカキツミノアルナリ、コノユヘニ一切ノ女人ヲバ、――馬鹿らしい。",
              "citation": {
                "source": "陰火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「リツコジウビヨウビヨウメイミテイダイガクヘニウインシタアトフミ」そういう文言であった。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、それはかまはないのですが――」義雄が默讀して見ると、「イマタツアヲモリマテムカヘニコイ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　シカタガナイノデ、ユカノウヘニスワリマシタラ、洋服ガドロダラケニナリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーディン、ローキ、ヘニールは凡て、日耳曼神話に於て、最初の世界主宰神と称せらるる者なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーディン、ローキ、ヘニール三神の贖料を出して、立ち去りし後、直ちにフライドマルの一家に、父子の間に確執を生じたり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "300悲しみ叫ぶ女性らは神女に向ひ手を擧げつ、頬美はしきテアーノー衣服を取りて鬢毛の美なる神女の膝の上、獻じ捧げて雷霆のクロニオーンのおほいなる息女に祈り求めいふ、292　ポエニキエー（ヘニキア）の最古の都。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "オウチカラ　　　バシヤガ　オムカヘニキテヰマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ところがそれが知事様だと隣席のものに教えられて「我輩ガ考ヘニハ此失敬老人ガヨモヤ大久保公デハ有ルマイ。",
              "citation": {
                "source": "ハイカラ考",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "反ハンサムなヘニイジ、それからド・ヴェールは槍仕合いの勇敢な花形だったし、若いブラウンドは、「トビ色の髪で、かわいい顔をして、誰よりもきちんと落ちついて、背が高い、そして」おまけに女王の目が注がれるたびに、さっと頬を染める美しさ、そんな男が、うようよしていたのである。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "土人ノ伝ヘニ往古日本武尊東夷征伐ノ時コノ郡中ニカカリ、此ノ山ヲ見給ヒテ通行セシメタマフコト八日ニ及ベルヨシ、故ニ名ツクト云。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はその草稿を持って翌日ヘニング夫人を訪ねて飜訳を依頼し、又数日後に大阪へついでがあったので、心斎橋筋の「みのや」へ行って舞扇を買い、それをクレプ・ド・シンの生地と一緒に小包便でハンブルクへ出した。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘニング夫人の娘フリーデルが、今度父に伴われて伯林へ行くことになったと云って、或る日夫人が訪ねて来たのは、十一月の中旬であった。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、ちょうど十時頃のことで、貞之助も悦子も出かけてしまったあとなので、彼女はひとりゆっくりと足腰を休めるために二階の寝室へ上って行ったが、ふと机の上を見ると、西比利亜経由の外国郵便が二通、封を切ったまま置いてあり、その傍に夫の手で、シュトルツ夫人とヘニング嬢から珍しい便りが来た。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘニング様はローゼマリーへ指輪をお持ち下さいました由、この間お手紙を下さいまして、ハンブルクへはいつお越しになられるか今のところまだはっきりしないとのことでございましたが、私共の知合いの方が先日｜伯林でヘニング様にお会いになり、指輪は持って来て下さいました。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒔岡の奥様、あなた様と御主人様には心から御挨拶を申上げ、あなた様がおやさしく私達のことをお心におかけ下さいましたことに対して、重ねて御礼申上げますあなたのヒルダ・シュトルツヘニング嬢のは分りやすい英文でしたためてあるので、これは幸子にもどうやら原文を読むことが出来た。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何卒あなたからもお便りを願います敬具フリーデル・ヘニングそしてこの中に、ハンブルクのシュトルツ夫人から伯林マイエルオットー街のヘニング嬢に宛てた、指輪を受領したことを報じた絵端書が、丁寧にも封入されていたのであった。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも幸子は、遠い国外へ手紙を出すと云うことが何となくぴんと来ないので、又｜暫く捨てて置いて、漸く或る日自分も認め、悦子にも認めさせて、それをヘニング夫人の許へ送り届けたのであった。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "極星座付俳優ヘニング・ローマンとの浮名が立っているが、伯爵は一切関知せざる模様、夫妻の間に風波はない様子である」　毒蛇のラルフに、こんな緻密な聞き込みなぞのできるわけがない。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネると、独人リマー・ヘニッヒが迎へに来り、小石川のティルマンさんの家へ、ジョン・ヘイグを飲み、大いに語る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "独乙人のリマー・ヘニッヒ牧師と知り合ひになる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "独乙人ギンター・シュベルトとリマー・ヘニング来訪、銀田辷人、里馬辺人と名をつけてやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "独乙人ヘニングとシュベルトが来た、日独防共協定おめでたうと握手する。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "独乙人リマー・ヘニングとグィンタ・シュベルト来る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、外人シュベルトの送別会で、小石川のヘニッヒ家へ行き、アコーディオンをひいて歌ったり、さわいだり、夜も二時まで。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "独乙人リマー・ヘニッヒ来り「マリウス」を絶讃した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "来訪、リマー・ヘニッヒ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "結論の終りの章には、＝父母懐胎の時、チヤツト一滴ノツユヲウケテヨリ、ハヤ身モ心モ生ズルモノヨ、タトヘバ袖ノ上ニツユガアレバ月ノウツリ、草ノウヘニモツユガアレバ月ノウツル如クヨ　と書いたり、また、＝月白風清、コンポンニ至ツテハ、ナンニモナイトイフ処ガ面白ヨ、ナンノ道理モナキナリ　で、結んでいる。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
