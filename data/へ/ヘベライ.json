        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "当時奥山の住人というと奇人ばかりで、今立派な共同便所のある処｜辺に、伊井蓉峰のお父さんの、例のヘベライといった北庭筑波がいました。",
              "citation": {
                "source": "諸国の玩具",
                "author": "――浅草奥山の草分――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘベライというのは、ヘンホーライを通り越したというのでヘベライと自ら号し、人はヘベさん／＼といってました。",
              "citation": {
                "source": "諸国の玩具",
                "author": "――浅草奥山の草分――",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊井蓉峰の父北庭菟玖波も五人男の花形で、写真の率先者、ヘベライともいった。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
