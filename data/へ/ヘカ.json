        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「カイモノノツゴウデトウキョウヘカエルアススグユク　　　キョウコ」　と読まれた。",
              "citation": {
                "source": "第二の接吻",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "納税資格ガ選擧權ノ有無ヲ決スル各國ノ制度ハ議會ノ濫觴ガ皇家ノ徴税ニ對シテ其ノ費途ヲ監視セントシタル英國ニ發スト雖モ、日本國自身ノ原則トシテハ國民タル權利ノ上ニ立テサルヘカラス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "落花踏ミ盡シテ何處ヘカ行ク――　つい焦れつたくなると漢語調の歌をうたふのは、代紋と稱して提燈や傘などにつける紋章に梯子の印を付け、自烈亭居士と號して狂歌などを詠んだ祖父、そしてインデイアン・システムは父からの影響であるが、今日を限りとして私はそんな文章癖は棄却しなければならない。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "落花踏ミ尽シテ何処ヘカ行ク――　つい焦れつたくなると漢語調の歌をうたふのは、代紋と称して提灯や傘などにつける紋章に梯子の印を付け、自烈亭居士と号して狂歌などを詠んだ祖父、そしてインデイアン・システムは父からの影響であるが、今日を限りとして私はそんな文章癖は棄却しなければならない。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、突然一人の頭の中ヘカンナの予言が浮び上つた。",
              "citation": {
                "source": "碑文",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、同上ノ娼妓芸妓ハ人身ノ権利ヲ失フ者ニテ牛馬ニ異ナラス人ヨリ牛馬ニ物ノ返弁ヲ求ムルノ理ナシ故ニ従来同上ノ娼妓芸妓ヘ借ス所ノ金銀並ニ売掛滞金等ハ一切債ルヘカラサル事。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フネデトウキョウヘカエッテクルゾ……東京へ帰るというからには、芝浦へ着くのか、それとも横浜に着いて東京へ入るのか」　課長は大いに迷った。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "内殿は二つに仕切られ、東側の三分の二はヘカトンペドス・ナオス（百歩殿）と呼ばれ、西側の三分の一はパルテノン（処女殿）と呼ばれた。",
              "citation": {
                "source": "パルテノン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東側の入口からはいると、まずプロナオス（前殿）があり、中央の鉄の格子扉の先がヘカトンペドス・ナオスで、名称は部屋の長さが歩測して百歩あったからである。",
              "citation": {
                "source": "パルテノン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘカトンペドス・ナオスと、その前房と、パルテノンとその前房と、以上四つの部屋は、結合した一つの神殿で、その外部の軒蛇腹の下には、此処にも四面とも、プ※イディアスの浮彫の絵巻物が展げられてあった。",
              "citation": {
                "source": "パルテノン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、ヘカトンペドス・ナオスの外壁とパルテノンの外壁には大きな壁画が描かれてあった。",
              "citation": {
                "source": "パルテノン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "上にいて、永遠に古びずに、三つの称号、三つの形相を持っている、ジアナ、ルナ、ヘカテの三一の神よ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「我等ハタトヘカヽル設備ヲ有スルモ、コレヲ利用スル暇ナカラン」ト。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ヒゲナシ　ニナツテオウチ　ヘカヘツテ　来タラオ母サン　ハオドロイテ山羊サン　ヲ叱ツタ　ケド山羊サン　ハ平気ナ　顔ヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、人参サンハ決心シテ、ジヤガイモサンノオ家ヘカケコンデ、眠ツテイルジヤガイモサンヲユスブリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ、オゲンクワンカラ、ソトヘカケダシテイツテシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハイクラオコツテヰテモオ家ノ中ニヰルカライイヤウナモノノ、クライ夜道ヲ一人デトンデイツタボンコチヤンハ、モウ、ケツシテ、オ家ヘカヘツテコラレナイデセウ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシヤサマハヨクヨク、シンサツシテ、ソレカラ、「ボンコチヤン、アナタノ病気ハモンコチヤンノ所ヘカヘレバスグナホリマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アマリクルシイノデ、ボンコチヤンハオイシヤサマノイツタヤウニ、ビヨウキガナホルノナラ、モンコチヤンノオ家ヘカヘリタイトイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒハ　カン　カン　ト、マウヘカラテツテ、アツクテ　タマリマセンデシタガ、ジヨン　ト　チビスケハ　カケツコシテ　ノハラニ　ユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此パリス、実は「トロヤ」王プリアムスの子なるも、其母ヘカーベの悪夢を夢みし結果として、「イダ」の山へ棄てられし者なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "先鋒並びにヘクトール斯くて後陣に退けば、雄叫びすごきアカイアの衆は屍體を曳きずりて　505なほ奮進を續け行く――之を怒れるアポローン、ぺルガモスより見おろしてトロイア軍に叫び曰ふ、489　プリアモスとヘカベーとの子後アガメムノーンに殺さる。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "中の一枚とりあげてヘカベー之を獻つる、そは巧妙を極めたる最美最麗、燦として、星の如くに耀きて、すべての下に藏めらる。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊さはれ來らんトロイアの禍難、わが母ヘカベーの　450それすら、父王の禍難すら、はた勇猛に戰ひて敵に打たれて塵中に、俯伏しなさむ同胞のその禍難すら、汝ほどわれの心を惱さじ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "さはれ汝はこゝに坐し耀く酒盃傾けよ、　5やがて鬢毛うるはしきヘカメーデーは温浴を、汝の爲めに備ふべく、凝血洗ひ清むべし、われは急ぎて展望の場に現状眺むべし。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "城上より之を眺めてプリアモス王、ヘカベー、アンドロマケーの慟哭。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "』堅甲振ふおほいなる將ヘクトール答へ曰ふ、『デーイプォボスよ、汝をばプリアモス王、ヘカベーの双親うめる兄弟の中に最も我｜愛でき、今は一層胸の中、我は汝を尊ばむ、　235事の危急を眺め得て、敢てわが爲城壁の外にいしくも來れるよ、他は皆中に留るに。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
