          "literary": [
            {
              "text": "渓辺有路歩堪移、看到断橋行自遅、疑是那山存鬼窟、巨巌戴雪半空欹。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "有舜九納堂前辺有之。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "頼通とほぼ時を同じゅうした藤原明衡の『雲州消息』に、桂辺有領地。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
