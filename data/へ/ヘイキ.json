        "examples": {
          "standard": [
            {
              "text": "大地震とそれに伴う津波という二つの災害が併起し、甚大な被害をもたらした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "複数のシステム障害が併起したことで、復旧作業は困難を極めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "異なる感染症の併起を防ぐため、徹底した手洗いとワクチン接種が呼びかけられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
