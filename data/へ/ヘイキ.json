[
  {
    "uuid": "4dc4bbfb-fd82-50bb-b7b1-9bcd957286e6",
    "entry": "併記",
    "reading": {
      "primary": "へいき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
