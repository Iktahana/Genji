      {
        "index": 1,
        "gloss": "header (on a document, email, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "メールのヘッダー情報を確認すれば、どのサーバーを経由して届いたのかが分かる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "企画書の全ページのヘッダーに、プロジェクト名と今日のタイムスタンプを入れておいて。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ウェブサイトのヘッダー部分にあるナビゲーションメニューのデザインを刷新した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「ホワイト・ファング」は「荒野の呼び声」と相対して傑作のダブルヘッダーである。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッダの書名と章名が文字化けするといった明らかな問題点の解消に加えて、ツールキット日本語版が我が国の組み版のルールにどこまで対応してくれるかに、大いに期待したい。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳なりがするそうぞうしい音の中にヘッダの科白が浦路の声でひびいて来ると思えば鴈次郎の紙治のまつわる様なこえがひびいて来る。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "乱調子にそむいた心で自分がピアノを弾いて居るのにわけもなくヘッダの最後の舞台面を思い出した。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッダ・ガブラーや人形の家の芝居を眺め「日本にもかかる思想がなくてはならぬと思ったくらいだ」。",
              "citation": {
                "source": "歴史の落穂",
                "author": "――鴎外・漱石・荷風の婦人観にふれて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "座の人たちが思いあたることは、この春の興行に、「ヘッダガブラア」が候補になったところ、彼女はどうしても嫌だと言張った。",
              "citation": {
                "source": "松井須磨子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッダのようなあんな烈しい性格のものばかりやるのは嫌だといってきかなかった。",
              "citation": {
                "source": "松井須磨子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッダは最後にピストルで自殺する役である。",
              "citation": {
                "source": "松井須磨子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ヘッダ・ガーブレル』『幽靈』『海の夫人』『小さなイヨルフ』『棟梁ソルネス』『ロスメルスホルム』『野鴨』『ヨン・ガブリエル・ボルクマン』『我等死者の目醒むるとき』『人民の敵』など多きは四五種ぐらゐ、少くとも二種は飜譯があらう。",
              "citation": {
                "source": "イプセンの日本語譯",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れの生涯中三十七歳から六十三歳まで、人生の最盛期二十七年間は、本國に意を得ないでドイツ、イタリア等に漂泊の生活を送り、『ブランド』以下『ヘッダ・ガブレル』に至る十餘篇の劇をそのあひだに作つた。",
              "citation": {
                "source": "『人形の家』解説",
                "author": "島村抱月",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他『人形の家』を滑稽の材料にしたパロデ※ーの類では、千八百九十三年に出來た『ポンチ氏の袖珍イブセン』（Mr. Punch's Pocket Ibsen : F. Anstey）が最も有名で『人形の家』のほかに『ロスメルスホルム』『ヘッダ・ガブレル』『鴨』『建築師』等の作りかへをも加へてある。",
              "citation": {
                "source": "『人形の家』解説",
                "author": "島村抱月",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、第一回の観劇会が、先月俳優座のストリンドベリイ劇、第二回が、今月の実験劇場（イプセンのヘッダ・ガブレル）といふ風に、着々、実行されつゝある。",
              "citation": {
                "source": "雲の会",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――『ヘッダ　ガブレル』イブセン　――兄閣下　お手紙ありがとう御在います。",
              "citation": {
                "source": "監獄署の裏",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　人間のうちにはいかにヘッダ・ガブラーが多いことだろう！",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度観ているうちにこの観音、女優になってイプセンの『ヘッダ・ガブラ』のヘッダに扮したら、その役柄にぴったりはまるのではないかと私には空想された。",
              "citation": {
                "source": "冬の法隆寺詣で",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
