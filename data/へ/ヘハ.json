        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヒトノ後ヲ尾行シタリ隣室ヘハイツテ散々俺ノ悪口ヲ言ツタリ、俺ノ生活ヲ覗イタリスルコトハ、今後絶対ニヤメテクレ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "餘り達者でない・公學校式の角張つた日本語で、ウチヘハイツテ、休ンデクダサイと言ふ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "余り達者でない・公学校式の角張った日本語で、ウチヘハイッテ、休ンデクダサイと言う。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "イイエ、コノ　コノ　トコロヘハ、ヤハリ　カナシイ　コヱデ　ナク、イチハノ　ウグヒスガ　ヤブノ　ナカカラ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オマヘハ　ドウダ、ウデガ　ムヅムヅシテルンダラウ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ソコヘ　ヨコブヱヲ　モツタ　ヒトガ　チカヨツテ　キテ、「オヤ、オマヘハ　マヒゴノ　タケノコダネ」ト　イヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ父ッチャハ、工場デヤスリヲトイデイルウチニ、グルグルマワッテ居ルト石ガカケテトンデキテ、ソレガムネニアタッテ、タオレテ家ヘハコバレテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷里ノ方ヘハ、海ニ墜チテ死ンダトダケオ伝エクダサイ」　とうとうやったな――と、長谷部大尉は思った。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "此儀ハ飯田在番ヘハ耳に入置たり。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年二月十六日　三吉慎蔵あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ニ私儀此頃老主人よりよび帰しニ相成候て、国許ヘハ不帰、其まゝ長崎ニ於て、兼而召つれ候人数を御あづけ被申ことにて、私おして海援隊長と申付、則長崎ニて一局を開キ諸生のセ話致し申候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年五月中旬　寺田屋伊助あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ミミヅクサン　ハメガネ　ヲトリ　ニミヅ　ヘハイリマシタ。",
              "citation": {
                "source": "ミミヅクサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、玉ネギサンノ　ノツテヰル汽車ノ中ヘハイツテイツテ、席ニコシヲ下シテ、グウ　グウ　グウ　グウ眠リコンデシマヒマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オコタヘハ　クワンセイ　ハガキ　デ　コドモノクニ　ヘ　五月十五日マデニ　ハツペウハ　八月号ノ　コドモノクニ裏表紙",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○考古學上ノ三時代トハ石時代、青銅時代、鐵時代ノ事ナルガ、青銅時代、鐵時代ノ二ツノ稱ヘハ今ヲ距ル二千六百年前「ヘシヲツド」既ニ之ヲ使用セリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "李時珍がその著『本草綱目』芳草類なる薫草の条下で述べるところによれば「古ヘハ香草ヲ焼テ以テ神ヲ降ス、故ニ薫ト曰ヒ※ト曰フ」（漢文）とある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右ニ記如ク上野衆北条ト一味故、越後ヘ之通路自由ニテ、三郎殿ヘ加勢ノ兵北上野ヘハ志水谷ヘ下テハ長尾伊賀守城ヲ取巻ク。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいら川ハ加賀川ノ入ニテ、野口沢本谷ノ北すばり越ト云フ辺ヨリ奥ヘハ通路ナシ。",
              "citation": {
                "source": "後立山は鹿島槍ヶ岳に非ざる乎",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当村ニテハ八日見山ト唱ヘ、又竜神社ヲ祭レル故ニヤ竜神山トモ唱フ、薄村ニテハ両神山ト唱フ、皆文字異ニシテ唱ヘハ同シ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大威籠権現ヘハイニアリ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「軽井沢ヘハイツイラツシャルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯カラ上ルト、ウシロカラタオルデ拭キ、ベビーパウダーヲ振リカケ、扇風機ヲカケテクレルガ、決シテ前ヘハ廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南禅寺ヘハオ泊リニナラナイノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ埼玉県ノ生レデ関西方面ヘハ一度モ旅行シタコトガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コンナ時ニ先日ノ記憶喪失ガ襲ッテ来ハシナイカトイウ恐怖ガ、チラト脳裡ヲカスメタ）僕ハ関田町ノ家ノ所在ハ分ッテイタガ、中ヘハイルノハ始メテダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ノ所ヘハ時々手紙ヲクレルケレドモアノ晩ノコトニハ一言モ触レテナイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々アル方ヘハ、足ヲモササゲル心モチ肝要ニ候。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
