[
  {
    "uuid": "18c672d3-b0c7-54f3-a6d5-8500790f0ae0",
    "entry": "兵児",
    "reading": {
      "primary": "へこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
