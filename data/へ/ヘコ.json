  {
    "uuid": "293943d1-3e44-5887-88d9-f97fd7ef627b",
    "entry": "ヘコ",
    "reading": {
      "primary": "へこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まったく困った世の中」「おかげで、簡単にあいつをヘコませられるようになって、助かったけどね。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この渋紙包の一つには我輩の寝巻とヘコ帯が這入っているんだ。",
              "citation": {
                "source": "倫敦消息",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼神ちとヘコタレ気味で四つの問いを掛けた。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時にこれを火鉢に燻べると雷神様が落ちさっしゃれんちうてなあ……梅津の爺さんは身体ばっかり大きいヘコヒキ（褌引き……臆病者の意）じゃけに雷神様が嫌いでなあ。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今になって白状に及んだところをみると、みんな相当私のウワバミ元気にはヘコたれていたらしいのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の体は二十四日以来可成りの無理があったから、随分気をつけてマッサージもまた始め、昼間よくねるようにしておりますから御心配下さいますな、何といっても体の大きい五つの子供をだくのは骨よ、体中にしまりのない子なのだから重さは非常なもので、皆、可愛がりながらヘコたれます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "帯をしていらしったというけれど、それはどんな帯だったのか、私の入れたやすもののヘコ帯かしら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の大きな、絣の単衣を着て黒メリンスのヘコ帯をしめた姿、又制服（東・高の）の姿、目に見えるようで、その姿目に浮ぶと、云う限りなく可愛ゆし。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六時頃、ヘコヘコになっているところへかえって来た。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は最早、生活にヘコ垂れはじめたらしい。",
              "citation": {
                "source": "湖畔手記",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の仕事はやはり金型をヘコサに彫る工人の手本になるので、その意匠を考え考えして種々な用途の器具の内面または外側に、旨く意匠づけたものを彫るのであるから、なかなか仕事に骨は折れますが張り合いがある。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "貿易品の型彫りをしたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "実にただ薄笑いをうかべて、幸平の差出したものを黙ってつかんで、まず預金帳を懐中にしまいこみ、次に印鑑をつまんでヘコ帯の中へ入れてグルグルまきこみ、それを帯の一番内側へ指で三四度押しこんでから、札束を掴みあげた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十　冷笑鬼",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハッハッハア」　と虎之介は大きな両腕でヘコ帯の前を抑え、肩をゆすって呵々大笑した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十三　幻の塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "柔道着に小倉袴をつけた壮士風のもの、高貴織の単衣に錦紗のヘコ帯をだらしなく巻きつけ、金時計を光らした、デップリした若者、そのほかいろいろの風態をした五、六人連の、傍若無人に大言壮語している連中がいる。",
              "citation": {
                "source": "震災後記",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "海屋の幅『古書通信』の二月号に出ていた閑人閑語の「オキナのヘコヘコ」という条を見て、思わずほほえみました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たかがこれしきのことにヘコタレはしねえ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりはこの白髪頭ヘコ／＼さげて頼んで廻るだけの事だあ。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホッテントットとかピグミイ族といったような未開人の間に、人間にとって一番たいせつな物は、生殖器の先端だとかヘソの中に在ると信じて、これらを自分の頭よりもだいじにする習慣があったとするならば、さしあたり、われわれはこれを愚劣と呼び、ヘコタレて引きさがる以外に手は無いであろう。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから私は新劇人たちのこのような習慣を愚劣と呼び、ヘコタレて引きさがったのである。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐山　そりゃ……（左手で入口の方向をさして）そこを曲って二間ばかり行くと、ヘコんだところがあります。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして開闢以来の珍事で、村の郵便局はヘコ垂れ切っているのであろうか。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひどく幼稚な観念的な言葉で、老人を無条件でヘコマセてくれようといふ風な底意地の悪い政治的なずるさがあつて甚だ無邪気でないところへ、何よりも馬鹿な言葉なのがいやなのである。",
              "citation": {
                "source": "人さまざまの苦労の話",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "（妹より兄へ）　ウルシド、シンダ、サジ、ケイサツヘツレテユカレタ、コチラヘコラレヌカ。",
              "citation": {
                "source": "偽悪病患者",
                "author": "大下宇陀児",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の心持ちをなんでも下等にいやしく解釈して見抜いたような薄笑いを浮かべ、人がそれに腹を立てて何かヘコますようなことをいえば、「まあさ、そうどならんでも」とごまかして笑う。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の心持ちを何でも下等に浅薄に解釈して独り見抜いたやうな得意の薄笑ひを浮べ、人がそれに不快を感じて何かヘコマすやうな事を云ふと誰も呶鳴りもしないのに「まあさ、さう呶鳴らんでも」と云つて笑ふ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺で、ヘコタレては、問題にならない。",
              "citation": {
                "source": "富士屋ホテル",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギシ／″＼、ギチン／″＼、寝台は鳴り通し、圧せばヘコむスプリングのおかげで、アンマの快感はゼロ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気分はどうじゃ、大儀ではないか」「なアに大丈夫です、これしきのことにヘコたれちゃ、目明しという肩書に面目がありゃしません。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
