[
  {
    "uuid": "a07645f6-c1f5-503e-b31b-6ef26b892f73",
    "entry": "兵士",
    "reading": {
      "primary": "へいし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
