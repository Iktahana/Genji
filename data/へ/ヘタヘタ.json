    },
    "definitions": [
      {
        "index": 1,
        "gloss": "falling down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "合格発表の掲示板に自分の番号を見つけた瞬間、安心感からへたへたとその場に座り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "マラソンを完走した直後、足の力が抜けてゴールラインでへたへたと崩れ落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "悪い知らせを聞いた母は、ショックのあまり廊下でへたへたとしゃがみ込んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "夜光虫は私たちに一言の挨拶もせず、溶けて崩れるようにへたへたと部屋の隅に寝そべった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "へたへたと最敬禮なんかして、上品もくそもあつたものぢやない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちの仕事はな、地殻の底の底で、とけてとけて、まるでへたへたになった岩漿や、上から押しつけられて古綿のやうにちぢまった蒸気やらを取って来て、いざといふ瞬間には大きな黒い山の塊を、まるで粉々に引き裂いて飛び出す。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちの仕事はな、地殻の底の底で、とけてとけて、まるでへたへたになった岩漿や、上から押しつけられて古綿のようにちぢまった蒸気やらを取って来て、いざという瞬間には大きな黒い山の塊を、まるで粉々に引き裂いて飛び出す。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "せわしく深く気息をついて、体はつかれ切ったようにゆるんでへたへたになっていました。",
              "citation": {
                "source": "溺れかけた兄妹",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝吾は扉の敷居口に、へたへたと腰を抜くと、羆の筒袖の前脚めいたやつを、もさりと支いて、土下座して、「途惑をいたしまして。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなあんまり一生けん命だったので、汗がからだ中チクチクチクチク出て、からだはまるでへたへた風のようになり、世界はほとんどまっくらに見えました。",
              "citation": {
                "source": "カイロ団長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その股立が、きょろッとして、それが、慌てて頬被を取ると、へたへたと叩頭をしました。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "と反って飛退り、下駄を脱ぎて、手に持ちはしたれども、腰の骨の蝶番がっくり弛みてただの一足も歩かれず、くしゃりと土下座して、へたへたになり、衣服をすっぽりと引被りて、南無阿弥陀仏南無阿弥陀仏。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と言って、誰にするやら仁右衛門はへたへたとお辞儀をした。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「もう、その度にね、私はね、腰かけた足も、足駄の上で、何だって、こう脊が高いだろう、と土間へ、へたへたと坐りたかった。",
              "citation": {
                "source": "女客",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "饂飩屋は、行燈に向直ると、誰も居ないのに、一人で、へたへたと挨拶する。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "へたへたと最敬礼なんかして、上品もくそもあつたものぢやない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "復一は精も根も一度に尽き果て、洞窟のように黒く深まる古池の傍にへたへたと身を崩折らせ、しばらく意識を喪失していた。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、真佐子にも、神魚華鬘之図にも似てない……それよりも……それよりも……もっと美しい金魚だ、金魚だ」　失望か、否、それ以上の喜びか、感極まった復一の体は池の畔の泥濘のなかにへたへたとへたばった。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭半分も後退した髪の毛の生え際から、ふらふらと延び上った弱々しい長髪が、氏の下駄｜穿きの足踏みのリズムに従い一たん空に浮いて、またへたへたと禿げ上った額の半分ばかりを撫で廻わす。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜光蟲は私たちに一言の挨拶もせず、溶けて崩れるやうにへたへたと部屋の隅に寢そべつた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、きゅうに足から力がぬけて、へたへたとしきいの上にすわってしまったのであった。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まったくだね、股引の裾をぐい、と端折った処は豪勢だが、下腹がこけて、どんつくの圧に打たれて、猫背にへたへたと滅入込んで、臍から頤が生えたようです。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の憤慨とは反対に加奈江はへたへたと自分の椅子に腰かけて息をついた。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、僧都の宿所まで負われて来たときはもう暁近くで、男はへたへたになっていた。",
              "citation": {
                "source": "大力物語",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "神のごとくに信頼しきっている親分の右門がそうなんだから、おしゃべり屋伝六のしょげかえってしまったことはむろんのことで、ひざ小僧をそろえながらへたへたとうずくまると、泣きだしそうな顔つきで、そこにころがっていた証拠物件のあの横笛を恨めしげにひねくりまわしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "笛の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "はや腰を抜かして、へたへたと縁側に這いつくばりつつ逃げおくれた六松をひとり残して、誰先にとなく裏口へ逃げ走り去ったので、あとから追いかけようとした京弥を、退屈男は慌てて制しつつ呼び止めました。",
              "citation": {
                "source": "旗本退屈男　第三話",
                "author": "後の旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　伝六のおどろいたことはもちろんでしたが、それよりも妻女の青ざめたことはいっそうのもので、へたへたとそこにうずくまってしまったのをみると、右門はさらに勢い鋭く天井を突き刺してまわりながら、ふたたび大音声で叫びました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "卍のいれずみ",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の巻き羽織を見て早くもそれと知ったか、顔色変えながらへたへたとそこへ手をついたのを、至極｜鷹揚にいいました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "明月一夜騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとたまりもなく三人の青坊主達はちぢみ上がって、へたへたとそこに手をつきました。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は望遠鏡を窓枠の上に置くと、そのまま窓の下にへたへたと崩れ座った。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
