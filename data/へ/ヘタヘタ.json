[
  {
    "uuid": "83b5627b-d236-5e40-9d83-e6d924c52080",
    "entry": "へたへた",
    "reading": {
      "primary": "へたへた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
