        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "矢張いつものやうに、今持つて来たばかりのポシエホンスキイ・ヘロルド新聞も、卓の上に置いてある。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "題号はポシエホンスキイ・ヘロルドと云ふのである。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "大通りの家に金めつきの看板が掛かつて、それに「ヘロルド編輯局」と書いてある。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて此ヘロルド新聞も従来他の地方に行はれてゐる、有益なる新聞と比肩するに至らんことを希望すると云ふとき、ふいとプラトンが気が附くと、長官は自分の顔を見てゐたのである。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
