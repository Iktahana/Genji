        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "近い岸より、遠い山脈が襞目を碧落にくつきり刻み出してゐた。",
              "citation": {
                "source": "川",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "天は高く晴れ渡って碧落に雲無く、露けき庭の面の樹も草もしっとりとして、おもむきの有る夜の静かさに虫の声々すずしく、水にも石にも月の光りが清く流れて白く、風流に心あるものの幽懐も動く可き折柄の光景だった。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫には風碧落を吹いて浮雲盡き、月東山に上つて玉一團とあつた。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼のように明るい冬の月が晃々と高くかかって、碧落千里の果てまでも見渡されるかと思われる大空の西の方から、一つの黒い影がだんだんに近づいてきた。",
              "citation": {
                "source": "鷲",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには風碧落を吹いて浮雲尽き、月東山に上って玉一団とあった。",
              "citation": {
                "source": "門",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "別号碧落居、更然洞。",
              "citation": {
                "source": "風狂私語",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、群を離れたる鴻雁なれども、猶万里の扶揺を待つて、双翼を碧落に振はむとするの壮心を有す。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "俥の上から湖東の方を顧ると、此の春遊びにいつた三上山が平濶な野洲郡の碧落と緑樹と點綴せる上にくつきりと薄墨色に染まつて見えてゐる。",
              "citation": {
                "source": "湖光島影",
                "author": "琵琶湖めぐり",
                "note": "青空文庫"
              }
            },
            {
              "text": "お銀様は青天碧落の上を、やや昂奮の気持で眺めておりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "弁信法師のいうことは、上は碧落をきわめ、下は黄泉に至るとも、あなたの姉を殺したものがこの人のほかにあるならばお目にかかる――それは途方もない出放題。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "白日荒原の上に、地の利と人の勢いの如何を眼中に置かず、十方｜碧落なきのところに身を曝して立つの無謀。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ今日のは、白日荒原の上、十方碧落なきのところで、前後左右に敵を引受けた無謀と、それに相手が相当の代物だけに、その勝負の程度が問題になるので、現在こうして、歩いている以上は、とにかく、生命に異状はないらしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "焦くが如き炎天の下、碧落の十方、キチキチ、キチキチと、青い虫の飛び交うほか、旅人の影一つない真昼だった。",
              "citation": {
                "source": "剣の四君子",
                "author": "小野忠明",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、やがて、渺茫とした裾野と、はてなき碧落が目の前にめぐりまわってくる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "道案内の徳川家の諸臣、まわりの旗本、諸大将以下、行軍のものすべてを置去りにして、ただ一騎、十方碧落のうちへその影は、一羽の小鳥の如く溶けて行った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第六分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ、武蔵野原に土着の百姓家には、どこの草葺屋根にも、この防風林がつきもので、十｜方碧落のほか何ものも見えない平野にあっては、時折、気ちがいのようにやッて来る旋風や、秩父颪の通り道のようになっている地形上、それが自然の城壁であり、またこの郷土特有の点景でもありました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時折、笠のつばを上げて、四方の碧落を見廻す瞳は、疲れながらも、何かの希望に燃えている。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "戛々として響く鉄棍の音、碧落を縫ふ真白な球、忽ち場の一隅から突如として異様なる応援の声が起つた。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "加うるに、ここは高原なので、十方｜碧落身をかくすべき一木もないし、高低もない。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "十方の碧落よりも、四方の野辺の自然よりも、武蔵にはこの小さい工芸品が、いちばん美麗に見えた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "生々と夏を待つ地上の何物よりも、晩春の碧落を彩る虚空何物よりも、彼の顔一つが、いちばん楽しそうであり、また、溌剌としていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさに無明の底から碧落を仰いだような狂喜である。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "江戸の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "十方｜碧落、一｜朶の雲もない秋だった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
