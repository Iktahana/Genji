  {
    "uuid": "f4cb9274-0d62-546c-8a0a-7170a7bb09ff",
    "entry": "辺三",
    "reading": {
      "primary": "へんさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
