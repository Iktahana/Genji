        "examples": {
          "standard": [
            {
              "text": "怪力の持ち主である彼は、厚い鉄板を素手でグニャリとへし曲げるというパフォーマンスを見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "理不尽な校則を自分の都合のいいようにへし曲げて解釈する生徒がいて困っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "怒りに任せて、彼は鉄パイプを力任せにへし曲げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "殆ど空で、奴は、此の間に例の、目をきよろつかせる、鼻をひこつかせる、唇をへし曲げる。",
              "citation": {
                "source": "松の葉",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "探幽はそれを見て、憤怒のまだ消え切らない口もとをへし曲げるようにして、ちらと微笑しました。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「それが輿論か……」原氏は髯のない口元をへし曲げるやうにして、皮肉な笑ひを見せた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後にＳ氏も顔をへし曲げるやうにしてお附合ひに少し笑つた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
