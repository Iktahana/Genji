[
  {
    "uuid": "a6dbca53-4fa9-5d87-b28b-9b3cdcfe5c53",
    "entry": "遍行",
    "reading": {
      "primary": "へんぎょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「おれも一遍行ってみべが。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おれも一遍行つてみべが。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ひ切つて這入らうかと思つたが何となく氣臆れがして二三遍行つたり來たりした儘、とう／＼門の扉を押し明ける勇氣も出ないで悄々として歸つて仕舞つた。",
              "citation": {
                "source": "竹の里人〔二〕",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "何遍行っても女に手を出さずにいると、或晩一番美しい女で、どうしても日本人と一しょには行かないというのが、是非金井君と一しょに行くと云う。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "何もございませんがここで何卒御寛り」「ところがもう一遍行つて見やうかとも思ふの」「へえ、又いらつしやいますか」　物は言はで打笑める富山の腮は愈展れり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん、たいていの伝説で御定まりのように、こういうことは三遍行われなければならないので、次には一羽のペリカン次には一頭の牡牛でこの術を行い、完全に成功してみせたというのである。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "何處かへ行つてみてえと思ふよ、藤さん……」「さうだねえ、一遍行きてえなア、何とかしてね。",
              "citation": {
                "source": "なぐさめ",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中野は、もう一遍行って、それだけでも訊こうと思った。",
              "citation": {
                "source": "地図にない島",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "失敗しちゃったと悄気てかえって来たので、私もがっかりしたし、一番終りの日様子もわからず歳越しをおさせするのはどうも辛抱出来なかったので、もう一遍行って貰い、特別に面会を許可されるよう願いましたがやはりもう人手がなくて駄目で、様子だけはつたえて下さるとのことで書いておいて来たそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "郡山へは必要上、年内に一遍行かなければならないでしょう、整理しなくてはならないから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこからハガキが来てね、上落合へ一遍行って回送されて来ているんだけれど、お召の著物が一枚五円で入っているのが明日限りで流れるって知らして来たんだけれど。",
              "citation": {
                "source": "まちがい",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もう一遍行くんだ――そうでしょう？",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "良　三　一遍行って会って御覧、大抵の者はいい加減毒気を抜かれるよ。",
              "citation": {
                "source": "宵（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで赤ちゃんみたいにしゃぶるんだもの、可笑しいわ、私もう一遍行って見て来ようかしら」　などと云いながら、まるで何か嬉しいことに出会ったように、ハアハア、ハアハア云って笑った。",
              "citation": {
                "source": "面積の厚み",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが妙なことでこんなことになりましたのよ、やはりあの社の或方のお母様の方がね、いい人だから一遍行つて逢つて見ろつてあの人が云ふもんですから、私は検査の帰りに一寸行きますとね、人を馬鹿にした方でね、女郎が真実のことを云ふ時があるかつて、そんなことを云ふんですよ。",
              "citation": {
                "source": "女が来て",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こないだ一しょに行って愉快に思った処へ、もう一遍行って見たいのだ。",
              "citation": {
                "source": "みれん",
                "author": "シュニッツレル　Arthur Schnitzler",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もう一遍行つて見てお出。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "※　輕井澤へは數日前室生さん達を迎へに行つたとき一遍行つたきりだ。",
              "citation": {
                "source": "夏の手紙",
                "author": "立原道造に",
                "note": "青空文庫"
              }
            },
            {
              "text": "台湾には私は一遍行っただけでその後行きませんからよく存じませんが、tinctoria も anil も作って居るだろうと思います。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかもう一遍行きたい気がする。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日はもう鎖国が実に完全になったから私とてももう一遍行くことは出来ない。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「もう一｜遍行ってごらん。",
              "citation": {
                "source": "杜松の樹",
                "author": "グリム",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間があったらもう一遍行ってもっと様子を探ろうと思っていたのだけれど、それから二三日して父が退院し、自分も蘆屋へ戻って来てしまったので、とうとうその機会がなかった。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "………そこのお鮨がえらいおいしい云うことなので、一遍行って見よう思うてはりましたのんで、新開地へ映画見に行かはりました帰りにお寄りになったのやそうでございます」「啓坊はどないもないのん」「はあ、若旦那さんは鯖がお嫌いで、お上りにならなんだそうで。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かもっと有意義なことを勉強しに行かはるのんやったら、一遍行って来やはるのもええことですし、そう云うては失礼ですが、費用ぐらい出さして戴きます。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親も、「一遍行って能く聞いてお出」　と勧めた。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、君は馬面を訪問しないといけないぜ」「行ったよ、来てから一遍」「もう一遍行こう。",
              "citation": {
                "source": "凡人伝",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一遍行ってくれ給え」「何遍でも行く」「加藤さんの一存に相違ない。",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは全くお母さんの誤解です」「誤解なら私もお礼を言うよ」　と母親は満足のようだったが、「けれども姉さんはあんな手前勝手の人だから、私、何うしても一遍行って能く話して来ますわ」　と後の方が宜しくない。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう一遍行って来てくれ給え」　と新太郎君は又命じる。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
