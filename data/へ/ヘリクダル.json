  {
    "uuid": "55ceacf6-e3ff-54e6-a19a-e37793d4df17",
    "entry": "遜る",
    "reading": {
      "primary": "へりくだる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞"
      ],
      "ctype": "五段-ラ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は遜る態度を装い、強いて夫人に向って批評を求めた。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶滋という姓があったのでも無く、古い書に伝えてあるように他家の養子となって慶滋となったのでも無く、兄に遜るような意から、賀茂の賀の字に換えるに慶の字を以てし、茂の字に換えるに滋の字を以てしたのみで、異字同義、慶滋はもとより賀茂なのである。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にとつてはこれらは矢張り詩文であると遜る方がほんたうである。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとては諦も得ず、また和の悟りをも見ね、ただすこしおのれ知るからただ堪へて遜るのみ。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事にも深く頭を垂れ、いよいよ深く遜るべきであつた。",
              "citation": {
                "source": "「白秋詩集」序",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さりとては諦めも得ず、また和の悟りをも見ね、ただすこしおのれ知るからただ堪へて遜るのみ。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "技において、ミケルアンゼロに及ばず、巧みなる事ラフハエルに譲る事ありとも、芸術家たるの人格において、古今の大家と歩武を斉ゅうして、毫も遜るところを見出し得ない。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮も嘗て己に対して、かの娘に遜るまじき誠を抱かざるにしもあらざりき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち女子の品位を維持するの道にして、大丈夫も之に接して遜る所なきを得ず。",
              "citation": {
                "source": "新女大学",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとく人間といえば上は神、下は獣類のあいだに介在するものであるから、両者の性質を兼備し、自分の勝手で都合よきほうに較べ、ある時はみずから尊者の敬称を甘んじて受け、またある時はみずから野卑と称するほど謙遜る。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに支那近代の學術について論ぜば、北は遠く南に遜り、古代の學術に就いて論ぜば、南は遠く北に遜る。",
              "citation": {
                "source": "晉室の南渡と南方の開發",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意味に於て尊公の心に萠し出でた本能の芽は聖なる鉢顛闍梨の三昧に比していささかも遜るところを見出しがたいのじゃよ。",
              "citation": {
                "source": "木枯の酒倉から",
                "author": "聖なる酔っ払いは神々の魔手に誘惑された話",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意味に於て尊公の心に萌し出でた本能の芽は聖なる鉢顛闍梨の三昧に比していささかも遜るところを見出しがたいのぢやよ。",
              "citation": {
                "source": "木枯の酒倉から",
                "author": "――聖なる酔つ払ひは神々の魔手に誘惑された話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まのあたり見しにもあらぬ事どもは」しるさず、又信じないのが白石の生涯を一貫した学的精神で、シローテ審問の要領も亦もとよりこの軌道の上にあり、科学的訓練のない当時にあつて真に異例の精神であつたが、之に応じたシローテが又その知識に於てその誠実真摯な信仰に於て遜る所のない人物であつた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまことの知は、ただ遜る者のみに与えられる。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "遜る勇気、敬しむ勇気、――どうだ、子路、何とも云えない、いい響きをもった言葉ではないか。",
              "citation": {
                "source": "論語物語",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵役に服すると兵役に服せざるとは乞食と市民とを分つに由ない、大奸も遜り聖者も遜る。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遜ると否とは大奸と聖者とを分つに由ない。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遜ることを以つて價値を判ずれば、大奸と聖者とは價値を等しくする。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神聖なる無意識に跪くこゝろは、私に弱いものゝ前に遜ることを教へた。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は唯トルストイやゲーテの前に自ら遜るのみである。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜂の巣に遜るの故を以て、軽視するわけには行くまいと思う。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "人事的葛藤を描く上から見ると、蕪村の句が最も力があり、活動してもいるようであるが、句の価値は姑く第二として、自然の趣はかえってこの句に遜るかと思う。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の女を思ふの心深いだけそれだけ、多く自分をへり下るものか。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうふうにすればさらにやましい所はないのだからやたらに小さくへり下る必要はない。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
