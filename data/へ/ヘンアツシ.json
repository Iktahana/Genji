        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たとえば文士｜渡辺篤君の家庭の夜の風景を表現するとして、そうしてねずみが騒いだり赤ん坊が泣いたり子供が強硬におしっこを要求したりして肝心の仕事ができぬという事件の推移を表現するにしても、何もあれほどまでに概念的、説明的、型録的に一から十までを一々｜羅列して見せなくてもよいと思われる。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和戦前、ジヤズ化された阿呆陀羅経は「笑の王国」が採上げて、渡辺篤三益愛子の両君が歌つた。",
              "citation": {
                "source": "寄席風流",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "三国周三、沢村貞子、渡辺篤とからむ、古岡の家のセット、昼食になる、ポークチャップを食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "オープンが、撮影所の隅に出来てる、古岡の家の縁側と庭、渡辺篤とのカットが終ると、もう昼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤を誘ひ、大雅で専ら食ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "斎藤寅次郎来訪、渡辺篤を誘ひ、四十二番街でウイをのみ、大雅でウンと食ひ、今夜も早い、十二時前。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の「東京温泉」終ると、照明室から「ロッパと将軍」を見物、渡辺篤の大熱演面白し。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤を誘って、アラスカで夕食、トマトのポタアジュと、チキンクリーム煮にコーン・フリッター。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝村より申出の、エノケンの映画に渡辺篤を貸すことＯＫ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝村より電報で、渡辺篤を借りること断念す、藤原釜足はロケ延引して駄目とのこと、京都は、すっかり藤原で宣伝してゐるので、これ又クサリ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネて、京宝の小田・渡辺篤を連れてギルビイ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤、声が出ない、ひどいので休演。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンバルでコーヒーのむ、渡辺篤と逢ひ又歩く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大雅へ直行して、ブラックホワイト、渡辺篤同道。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "発信控小国英雄　滝村和男　三益愛子　川村秀治　伊藤松雄　正岡容　太田一平　山野一郎　上山雅輔　中野実　渡辺篤　サトウロクロー　大庭六郎　石村宇三郎十一月九日（土曜）　退院――新大阪ホテルへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "十二時五分、うちの渡辺篤以下が放送するので、スウィッチを入れると、今日は西園寺公薨去のため中止、皆がっかりしてるだらう。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、或る頃の冬、（金龍館の楽屋を常盤座で使ってた頃）渡辺篤と二人で一ヶ月ぶっ通しで、松喜の肉をとりにやって、石鍋で焼いて食ったことがある。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤休み、出し物してゐて休まれちゃ全く困る、「荒木又右衛門」の又右衛門は、中根竜太郎が代る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹久又欠勤、渡辺篤も一回目来らず昨日通りの代役でやる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「黄門」の中には、渡辺篤と二人のアパッシュがある、大変なことになった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月二十七日（土曜）　本日渡辺篤休み、大辻司郎に格さんを演らせる、やっぱり渡辺の味がいゝといふことを思ふ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡辺篤とサトウロクローの二人が休んじまった、「人生勉強」も代役が多くて弱ったが、「金剛五郎」と来ては全くひどいことになった、渡辺の役を横尾泥海男、サトウの役を田島がやり、しどろもどろで何うやら終った。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "よるの部済んでから、例会で、今回は渡辺篤が幹事、上野の翠松園へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鍋島」の終り近く、山本五郎一家のゴロ酒井ってのが、袖で着換へをしてる渡辺篤をひっぱたいた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月七日（月曜）　ひるの部の、「幡随院」の泥試合では、山野が「何を此のシュウマイ」に対して、僕原作の渡辺篤のセリフ「何を此の子供のオバケ」。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出ると渡辺篤が休み、してやられた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "川口、渡辺篤の休みですっかり怒ってる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「幡随」の例のドナリ合ひのとこ、渡辺篤に知恵をつけといて、楽しみに待ってると、山野先づ血迷って、「何を此の助平のゴミタメのカス」と来たのを、アッサリ渡辺が「何言ってやんでエ山野一郎」で客も裏も大受け、愉快。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月二十六日（土曜）　座へ出ると、都の小ニュースに、渡辺篤Ｐ・Ｃ・Ｌへの話が出ちまったので川口等怒ってる、又滝村が早まっちまやがった。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ帰ると、渡辺篤、此の部屋あんまり暑いから大辻が今回ゐない間だけでもと、三階へ化粧前を移した。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
