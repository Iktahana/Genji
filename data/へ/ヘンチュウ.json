      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "膳所の近辺中庄村瓦浜に在るが、古くは其地の亀屋といふ家の界内に在つた。",
              "citation": {
                "source": "愛護若",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "マニラへ連絡に行った河辺中将の消息は知れず、ひょっとするといよいよ日本が無くなってしまうかも知れないという軍隊の武力蜂起を、ラジオの声だけで喰いとめようという頼りのなさで、Ｈ宮は瘠せるような思いをなすったということだった。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "この友達思いの新聞記者は、暫らくは物をも言わずに、――シャーロック・ホームスのように――其辺中を探し廻りました。",
              "citation": {
                "source": "女記者の役割",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あれえ――とか何とか言って、ヘタヘタと泥の中に横っ座りになった図なんてものは滅法色気があって――」「止さないか、馬鹿々々しい」「兎も角お神さんのお余野を医者へやってあっしは其辺中に眼を配りましたがね。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "腰抜け彌八",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわてて其辺中捜し廻ったが、犬の子一匹居ねエ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "髷切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それにこんな大きな足の人間はあるものでしょうか」「…………」　平次はそれには答えず、その辺中を忙しく見廻しております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "幻の民五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その煙草盆を片づけて置け、また火入れを履かれるとかなわない」　銭形平次はニヤリニヤリと笑いながら、物々しくもその辺中を片づけ始めたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は諸方をほッつき歩いて、其辺中の官兵の屯所は、一つ残らず顔馴染だから、私と一緒にお出でなさい。",
              "citation": {
                "source": "芳年写生帖",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「秋、乳母の元の娘の秋でございます」　嫣然とした年増、隔てもなくニッコリすると、桃色の愛嬌が、その辺中へまきちらされそうな女でした。",
              "citation": {
                "source": "十字架観音",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ってみた事はねえが、一両四｜匁ずつとして、風袋抜きでも十二貫、生優しい人間じゃ持運びの出来る荷物じゃねえ」「なるほど」　平次とガラッ八は、その辺中を捜し廻りました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "三千両異変",
                "note": "青空文庫"
              }
            },
            {
              "text": "八、あの研屋をもう一度｜虱潰しに当ってみてくれ」「ヘエ――」「俺はこの辺中の雪駄直しを一人残らず当ってみる。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "辻斬綺談",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の浪人はしばらくその辺中を探している様子でしたが、最後に平次の隠れた部屋をパッと開けました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お局お六",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時は、大分争ったものと見えて、その辺中さんざん荒らした上、痛々しく血までこぼれていたと近所の者が多勢で言っております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "和蘭カルタ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのために平次は女房のお静を出したって話ですから、いずれ、そんな事で刃物｜三昧になったんじゃございませんか」　万七はすっかり好い心持そうに、お楽の死体を見たり、その辺中の人に当ったり、目まぐるしく活動しては、合間合間に同心に報告しております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次女難",
                "note": "青空文庫"
              }
            },
            {
              "text": "無事に一日を過して、念のためにその辺中を探してみると、本堂の賽銭箱の側に、紙に包んだお捻りが一つありました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "大盗懺悔",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかたなく、次ぎ次ぎとその邊中の燒け殘りの建物の前に立つたり、それをグルリと※つたり、階段をあがつてみたりして、一時間ばかりも搜した末に、やつと、コンクリートの側面全部が火にあぶられて薄桃色にこげたビルディングの二階に、それらしい事務所を見つけだした。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八、あの研屋をもう一度｜虱潰しに當つて見てくれ」「へエ――」「俺は此邊中の雪駄直しを一人殘らず當つて見る。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "辻斬綺談",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの親分、其後はすつかり御見限りねえ、でもまアよく」　と言つた調子、荒い浴衣の袖を飜して、ニツコリすると、其｜邊中桃色の媚が撒き散らされて、何も彼も匂ひさうです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "くるひ咲",
                "note": "青空文庫"
              }
            },
            {
              "text": "無事に一日を過して、念の爲に其邊中を探して見ると、本堂の賽錢箱の側に、紙に包んだお捻りが一つありました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "大盜懺悔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それにこんな大きな足の人間はあるものでせうか」「――」　平次はそれには答へず、其邊中を忙しく見廻して居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "幻の民五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "着物は泥だらけだ――」「さう言へば、馬鹿に當つたとか言つて、フラフラし乍ら歸つて來たやうだが――」　解つたのはそれ丈け、其邊中を搜して見ると、小判が一枚小粒が二つ三つ落散つてゐましたが、それが多分三次の命を奪つた餌の殘りでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "結納の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時は、大分爭つたものと見えて、其邊中散々荒した上、痛々しく血までこぼれて居たと近所の者が多勢言つて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "和蘭カルタ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その爲に平次は女房のお靜を出したつて話ですから、いづれ、そんな事で刄物三｜昧になつたんぢや御座いませんか」　萬七はすつかり好い心持さうに、お樂の死體を見たり、其邊中の人に當つたり、目まぐるしく活動しては、合間々々に同心に報告して居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "平次女難",
                "note": "青空文庫"
              }
            },
            {
              "text": "「默つて歸つたんぢやありませんか」　そんなことを言ひ乍らも、平次と、八五郎と小僧の今吉は、手分けをして其邊中探し廻りましたが、十八娘のお清は平次の家の前で、烟のやうに消えてしまつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "桐の極印",
                "note": "青空文庫"
              }
            },
            {
              "text": "其邊中探したが、尻尾も見付かりやしません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "水垢離",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわてて其邊中搜し廻つたが、犬の子一匹居ねエ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "髷切り",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな極りの惡いことを」　後ろからそつと袖を引くのは、十九といふにしては、柄が大きいせゐか、少し老けては居りますが、八五郎の所謂クワツと其邊中明るくなるやうな良い娘です。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お長屋碁會",
                "note": "青空文庫"
              }
            },
            {
              "text": "その邊中ピカピカするやうな良い新造」「馬鹿だなア、涎でも拭きなよ、見つともない、――お客樣なら大玄關から通すんだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "妹の扱帶",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南に二階家があるから、植木が皆んなヒヨロヒヨロですね」　八五郎がその邊中を撫で廻すのを相手にもせずに、平次は縁の下や、物置などを念入りに見て居りましたが、「庭の手入れでもするのかな、棕梠繩がうんと用意してあるが」　妙なことを言つて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "屠蘇の杯",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾度も／＼其邊中を見廻し、また主人の善兵衞は、いよ／＼最後の愛兒もさらはれてしまつた事を確かめると、其儘、「ウーム」　と氣を喪なつて了ひました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "振袖源太",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
