[
  {
    "uuid": "b35fd4fc-edbe-549c-8076-38faf00f9de9",
    "entry": "辺中",
    "reading": {
      "primary": "へんちゅう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
