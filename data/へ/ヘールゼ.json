          "literary": [
            {
              "text": "ヘールゼの絶壁のすぐそばのところで、ヘールゼの塔がすぐ目の下に見えているのです。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでわたしたちは、ヘールゼまで逃げましたが、まだ暗かったので、夜が明けるまで墓地の大きな十字架のうしろにかくれていました。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、暫くそこに坐っていますと、ふいに頭の上で馬の鼻息と足掻きの音が聞え、同時にヘールゼの教會の塔のすぐ上の空に長い火花が見えました。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            },
            {
              "text": "領主は、死んだカップと、ヘールゼの坂道でのカップの冐險談を思い出した。",
              "citation": {
                "source": "ユダヤ人のブナの木",
                "author": "山深きヴェストファーレンの風俗畫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
