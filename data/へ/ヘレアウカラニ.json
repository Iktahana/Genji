          "literary": [
            {
              "text": "道路の向こう、椰子の樹の下の芝生にすわり、マイケル・ヘレアウカラニがギターを弾きながら歌っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギターをかかえたマイケル・ヘレアウカラニが、トラックの近くに来ていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイケル・ヘレアウカラニは、仲間のサーファーたちに囲まれていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しくて、なんだかこわくて」　マイケル・ヘレアウカラニが、自作の歌『ニシモト・カントリー・ストア』をシングル盤のレコードにする。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうひとつは、おなじくサーファーの、マイケル・ヘレアウカラニ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "マイケル・ヘレアウカラニだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
