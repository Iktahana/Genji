        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "貧困ニシテ實男子又養男子ナキ六十歳以上ノ男女、及ビ父又ハ男子ナクシテ貧困且ツ勞働ニ堪ヘザル不具廢疾ハ國家之レガ扶養ノ義務ヲ負フ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "覺醒セル民族ガ内部的興奮ニヨリテ外部的壓迫ヲ排斥セントスル時、是レ無用ナル自決ノ文字ヲ加ヘザル傳來ノ民族主義ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ信仰ガ強固ニシテ犧牲ヲ甘ンズル事例ヲ擧ゲテ對抗スルナラバ宗教ノ低級ナル者ニ於テ斯ル例ノ他ニ無數ナル者ヲ擧グ可ク、更ニ斯ク頑迷移サザル者多キガ故ニ殺スベシト云フ囘教ノ信仰ニヨリテ答ヘザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ國庫ノ負擔堪ヘザルヲ云ハン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ルニ堪ヘザル有ルコト三百六旬、相伝ノ什物数代ノ蓄蔵先代ノ遺訓、幾世幾年カ其家ニ伝来シテ積累山ノ如シ。",
              "citation": {
                "source": "阿房山賦",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛙声ノ枕ニ近クシテ喧聒ニ堪ヘザルガ如キモ、隔ツレバ則チ聴クベシ。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "宣光不敏ニシテ唯負荷ノ任ニ堪ヘザルコトヲ懼ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "王事｜離ノ感ニ堪ヘザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、聯合軍ニ話シカケ、マタ話シカケニ答ヘザルコト。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
