          "literary": [
            {
              "text": "ト　チヒサナ　ナミガ　ヨセテハ　カヘシテヰマス。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とふしんに思ひながら、その状箱のやうのやうなものをあけてみますと、　サツキハ、バケソコネテ、ヲカシカツタダロ、コバンハ、カヘシテヤルヨ、コンスケ。",
              "citation": {
                "source": "狐の渡",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ソノ日、暴風枝ヲ鳴ラシ、地籟、塊ヲ運ビ、新皇ノ楯ハ、前ヲ払ツテ、自ラ倒レ、貞盛ガ楯モ、面ヲ覆ヘシテ、飛ブ。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
