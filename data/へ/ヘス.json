[
  {
    "uuid": "8cd0a294-54c2-5bcd-9788-d05cbc410fd8",
    "entry": "圧す",
    "reading": {
      "primary": "へす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to dent",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "力を込めて親指で粘土の表面を圧すと、そこには丸く滑らかな跡がついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "重い家具を運ぶ際、うっかり指で木材を強く圧してしまい、表面を少し凹ましてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "柔らかいクッションを圧すと、ゆっくりと元の形に戻っていく感覚が心地いい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それは程よく背を圧する椅子とその背とのやうな関係であつたのである。",
              "citation": {
                "source": "アンドレ・ジイド管見",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さもあらばあれ、この山の強さは、依然我胸を圧す。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "水を口から注ぎ込むとたちまち湯になって栓口から出るギザーや、煙管の先で圧すと、すぐ種火が点じて煙草に燃えつく電気｜莨盆や、それらを使いながら、彼女の心は新鮮に慄えるのだった。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "植民地の労働者をベラ棒に安い、牛か馬かを使うような調子に働かせるために、威嚇し、弾圧する。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、満洲、支那に於ける中国人労働者及び鮮人労働者たちの反抗を鎮圧するために使われているのだ。",
              "citation": {
                "source": "入営する青年たちは何をなすべきか",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四章　日露戦争に関連して　　　　　─花袋の「一兵卒」、忠温の「肉弾」、龍之介の「将軍」　日清戦争当時のブルジョアジーは、既に解放される階級ではなく、支配する階級、抑圧する階級として発展しつゝあった。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　帝国主義××は、何等進歩的意義を持っているものではなく、却って、世界の多数の民族を抑圧すると共に、その自国内に於けるプロレタリアをも抑圧して、賃銀労働の制度を確保し拡大せんがために行われるものである。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "重圧する畏怖の下に、黙々と憐れな人間の意図を衛っている。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこういう人間の本能的な傾向から起こって来る作用の効果はなかなか根強いものであって、そうそう容易に抑圧することはできないものである。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「市街の広場を圧するほど展開した岩組が、簾の滝のように水で充ちている。",
              "citation": {
                "source": "噴水物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人はヤッシと艪柄を取って、丸裸の小腰を据え、圧すほどに突伏すよう、引くほどに仰反るよう、ただそこばかり海が動いて、舳を揺り上げ、揺り下すを面白そうに。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "よい、と圧した小腕ながら艪を圧す精巧な昆倫奴の器械のよう、シッと一声飛ぶに似たり。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "力なく引手に手をかけ、裳を高く掻い取って、ドンと圧すと、我ながら、蹴出の褄も、ああ、晴がましや、ただ一面に鼠の霧、湯花の臭気面を打って、目をも眉をも打蔽う土蜘蛛の巣に異ならず。",
              "citation": {
                "source": "わか紫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "所謂越中平の平野はここに尽きて、岩を噛む神通川の激流を右に視ながら、爪先上りに嶮しい山路を辿って行くと、眉を圧する飛騨の山々は、宛がら行手を遮るように峭り立って、気の弱い旅人を脅かすように見えるであろう。",
              "citation": {
                "source": "飛騨の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "主食と闇煙草の販売を弾圧する旨の声明は、わざわざ何月何日よりと予告を発して、これまで十数回発表されたし、抜打ちの検挙も行われる。",
              "citation": {
                "source": "大阪の憂鬱",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "駄荷馬などの砂煙をあげて行く道路を隔てて谷の向うに青い山がそそり立ち、うねった道路の果てにも、どっしりした山が威圧するように重なり合って見え、童蒙な表情をしていた。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち一方が抑圧すれば、他方が直ちに反動し、他方が時代を占有すれば、次には一方が興ってくる。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "故にこの種の詩は、主観を抑圧することによって、逆に却って主観を飛躍させ、情緒を苛めつけることによって、却って最も強いセンチメントを高調させる。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで氏郷は之を援けて一揆を鎮圧する為に軍を率いて出張したが、途中の宿々の農民共は、宿も借さなければ薪炭など与うる便宜をも峻拒した。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "両者の仲裁仲直りの席に、司会者の側の顔を大勢並べて両者を威圧するようにするのは卑怯で、かかる場合万々一間違が出来れば、左方からも右方からも甘んじて刀を受けて、一身を犠牲にして、そして飽迄も双方を取纏めるのを当然の覚悟とするから、助勢なんぞは却って要せぬのである。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "本因坊あつて偃武の世に出づるに及び、蔚然一家を為し、太平三百年間、雋異の才、相継で起り、今則ち禹域を圧すといふ。",
              "citation": {
                "source": "囲碁雑考",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "臙脂屋早く身退りし、丹下は其人を仰ぎ見る、其眼を圧するが如くに見て、「丹下、けしからぬぞ、若い若い。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒸々と悪気の籠った暑さは、そこらの田舎屋を圧するようで、空気は大磐石に化したるごとく、嬰児の泣音も沈み、鶏の羽さえ羽叩くに懶げで、庇間にかけた階子に留まって、熟と中空を仰ぐのさえ物ありそうな。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "米屋の縄暖簾を擦れ擦れに消える蒼い女房、矢絣の膝ばかりで掻巻の上から圧す、顔の見えない番町のお嬢さん。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "長城万里に亘り荒蕪落日に乱るゝの所、悵たる征驂をとゞめて遊子天地に俯仰すれば、ために万巻の史書泣動し、満天の白雲｜凝つて大地を圧するの思あり。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と威圧するごとくに答えながら、双手を挙げて子供等を制した。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……その癖半襟を、頤で圧すばかり包ましく、胸の紐の結びめの深い陰から、色めく浅黄の背負上が流れたようにこぼれている。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "むさゝびか知らぬがきツ／＼といつて屋の棟へ、軈て凡そ小山ほどあらうと気取られるのが胸を圧すほどに近いて来て、牛が啼いた。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで彼は、その現識を、出来るだけ直接に表白出来さへすればよかつたのです。",
              "citation": {
                "source": "宮沢賢治の詩",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニ、当人は自分の交遊がスラスラ行きさへすれば好いのだ。",
              "citation": {
                "source": "非文学的文士",
                "author": "中原中也",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
