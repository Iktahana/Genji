        "examples": {
          "standard": [
            {
              "text": "彼は自身の正当性を主張するために、偏見に満ちた僻書を自費出版した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史的な事実を歪曲して伝えるような僻書は、次世代に受け継ぐべきではない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "その僻書を読んだ人々が誤った情報を鵜呑みにしないか、学者は懸念を示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "余り僻書ではございません。",
              "citation": {
                "source": "魚玄機",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の珍蔵する所の文書でもなく、又僻書でもない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
