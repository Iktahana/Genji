        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデ、人参サンハ決心シテ、ジヤガイモサンノオ家ヘカケコンデ、眠ツテイルジヤガイモサンヲユスブリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ、オゲンクワンカラ、ソトヘカケダシテイツテシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "頸カラ胸ヘカケテＶ型ニ真紅ノ型ガ染マリ、水着デ隠サレク腹ノ部分ノ白イコトヽ云ッタラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尺骨ト橈骨ノ茎状突起カラ五本ノ指ノ尖端ヘカケテ手ガ一本ノ棒ノ塊ノヨウニ突ッ張リ、掌ノ内側ト外側トガチリ／＼トコキザミニ小サク細カク痛ミ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
