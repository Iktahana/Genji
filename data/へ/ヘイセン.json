[
  {
    "uuid": "c2b9abe8-5f0e-5454-9d8e-40abf67b64ce",
    "entry": "兵船",
    "reading": {
      "primary": "へいせん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
