        "examples": {
          "standard": [
            {
              "text": "引っ越しの日が決まったので、水道局に連絡して水道の閉栓を依頼した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ガス栓の閉栓を確認してから外出しないと、火災の原因になりかねない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "長期不在にするため、トラブル防止を兼ねて元栓を閉栓しておくことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "大野裕と一緒に「読書 blog――すいへいせん」を始めた ten。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
