[
  {
    "uuid": "bcdbbea1-0016-5458-8987-30610d78f39b",
    "entry": "ヘトヘト",
    "reading": {
      "primary": "ヘトヘト",
      "alternatives": [
        "へとへと"
      ],
      "is_heteronym": false
    },
    "grammar": {
