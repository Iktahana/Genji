[
  {
    "uuid": "2d82dd57-94f6-55df-ae7c-6a12c4d6f8b7",
    "entry": "返金",
    "reading": {
      "primary": "へんきん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-他動詞",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
