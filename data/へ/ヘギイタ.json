        "examples": {
          "standard": [
            {
              "text": "骨折した指を固定するために、医師は手際よく折板を当てて包帯を巻いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "応急処置として近くにあった薄い折板を添え木代わりにし、患部が動かないよう固定した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い道具箱の底から、かつて外科手術で使われていたのであろう錆びた折板が出てきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "蜘蛛の巣、大根の干葉、蜜柑の皮、汚れた折板、空瓶。",
              "citation": {
                "source": "夢幻泡影",
                "author": "外村繁",
                "note": "青空文庫"
              }
            }
          ]
        }
