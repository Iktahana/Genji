            {
              "text": "ヘリオトロオプと矢車草。",
              "citation": {
                "source": "花園の思想",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は妻の影が、ヘリオトロオプの花の上で、蝋燭の光りのままに細かく揺れているのを眺めていた。",
              "citation": {
                "source": "花園の思想",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "看護婦さんは硝子の花瓶から萎れたヘリオトロオプを一本抜いて捨てに行つた。",
              "citation": {
                "source": "産褥の記",
                "author": "与謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "貢　　今はね、さうですね……シクラメン、ヘリオトロオプ、シネラリヤ……。",
              "citation": {
                "source": "温室の前",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
