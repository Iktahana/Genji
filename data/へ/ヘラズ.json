        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "併し矢つ張り風は治らん様に見えるな」と、白頭がヘラズ口を叩いて居る時、カラ／＼と戸を開けて帰つて来たのは、今迄留守で有つた仲間の一人だ。",
              "citation": {
                "source": "俺の記",
                "author": "尾崎放哉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大学を卒業したり中途退学したりして多少の学問と文筆への習慣を持ち、ほかにする事がなく、ヘラズ口を叩くのが好きな者にとって、批評家になるほど手易く「割の良い」ことは無いわけです。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "批評の言葉から血が流れ出すこともある代りに、べた一面にヘラズぐちにヨダレをまぜて垂れ流す時もある。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いや、だから、なるべく、ヘラズぐちは叩かぬ方がよい。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘラズぐちを叩いていても此の人たちのは、時によって身が入って血が流れます。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――とは言っても、なにしろカンがきついから、この人たちはヘラズぐちを叩くのをやめはしますまい。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
