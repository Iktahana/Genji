        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "高熱にさらされたプラスチックの部品が、ぐにゃりと奇妙な形に変形してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "このロボットのおもちゃは、飛行機から人型へと三段階に変形するギミックが売りだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "事故の衝撃で車のフロント部分が大きく変形し、ドアが開かなくなっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして事情の許す限りは物質を空隙のないコンチニウムと見做す事によってその運動や変形を数学的に論じる事が出来た。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔術が曲馬に変形してそれが猛獣を呼出したと思われる。",
              "citation": {
                "source": "夢判断",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "平板に円孔を穿ったものの伸長変形に関する理論と実験の結果を比べたものが学位論文となっている。",
              "citation": {
                "source": "工学博士末広恭二君",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い芋虫と真紅の肉片、家鴨と眇目の老人では心像の変形が少しひど過ぎるが、しかしこの偶然な一と朝の経験から推して考えてみるとフロイドの「夢判断」の学説も、そのことごとくが全くの故事付けではないかもしれないという気がして来るのである。",
              "citation": {
                "source": "ＫからＱまで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火山の変形　昨年四月イタリアのヴェスヴィアス山がやや烈しい噴火をやったが、その後同国陸軍地理局で測量を行った結果によると、噴火前における最高点の高さ海抜千三百三十五メートルあったのが千二百二十三メートルに減じている。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この瓦斯は酸素の変形したもので非常に酸化力が強く、黴菌類はこれに遇えば皆死んでしまう。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大西洋北岸の富の余剰はいまや米国株式に変形したと歎じさせた。",
              "citation": {
                "source": "大阪万華鏡",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしまた、そうした奇形児がいくらできてもその当時の環境に適合しなければその変形は存続することができなくて死滅したであろうと考えられる。",
              "citation": {
                "source": "俳句の型式とその進化",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして雷鳴に対する神秘的の恐ろしさがなくなりはしたが、たぶんその恐ろしさの変形したものと思われる好奇心と興味とはかえって増すばかりであった。",
              "citation": {
                "source": "家庭の人へ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお面白いのは一つ一つの煙の団塊の変形である。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はそういう変形した鋏穴の「標本」を電気局で蒐集して、何かの機会に車掌達の参考に見せるのもいいかもしれないと思う。",
              "citation": {
                "source": "雑記（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年はある目的があって、陸地測量部五万分一地形図を一枚一枚調べて河川の流路を青鉛筆で記入し、また山岳地方のいわゆる変形地を赤鉛筆で記入することをやっている。",
              "citation": {
                "source": "夏",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "耳が悪いせいか、「かん」が悪いせいか、本物の演説を聞くのでも骨の折れるくらいであるから、完全でない機械で変形された音波の混乱の中から、変形されない元の波を読取ることはなかなか困難である。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽の方はかなりまで好い加減に色々に変化させても、やはり同じものとして認め得られるが、人間の言語はそれがただほんのごくわずかでも変形すればもはや全然別のものに変って識別出来なくなってしまうのである。",
              "citation": {
                "source": "ラジオ雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "口寄せ、梓神子は古い我邦の神おろしの術が仏教の輪廻説と混じて変形したものらしい。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえこの要素の等密度線がどのように変形しようとも、少なくも、その密度の傾度最大方向のトラジェクトリーを追跡して行けば、ついにはその源に到着、あるいは少なくも近づく事ができそうである。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下の三巻に現われるこれらの根本的なものは、多く述べきたったものの変形であり敷衍であるとも見られる。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩石に関してはまだ皺襞や裂罅の週期性が重要な問題になるが、これはまた岩石に限らず広く一般に固体の変形に関する多種多様な問題と連関して来るのである。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし場合によっては、これが単に河水の浸蝕作用だけではなくて、もっと第一次的な地殻変形の週期性によって、たとえ全部決定されずとも、かなり影響された場合がありはしないかと考えられる。",
              "citation": {
                "source": "自然界の縞模様",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ少しばかり現実の可能性を延長した環境条件の中に、少しばかり人間の性情のある部分を変形し、あるいは誇張し、あるいは剪除して作った人造人間を投入して、そうして何事が起こるかを見ようとするのである。",
              "citation": {
                "source": "科学と文学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも文献の破片は一度すっかり細かにすりつぶされなければならないのであるが、すりつぶされても結局素材としてはもとのものの変形である。",
              "citation": {
                "source": "空想日録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アフリカの蛮人でくちびるを鐃※のように変形させているのや、顔じゅう傷跡だらけにしているのがあるが、あれはどうもどう見ても美しいと思えない。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果として、空中分解の第一歩がどこの折損から始まり、それからどういう順序で破壊が進行し、同時に機体が空中でどんな形に変形しつつ、どんなふうに旋転しつつ墜落して行ったかということのだいたいの推測がつくようになった。",
              "citation": {
                "source": "災難雑考",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "紫色の服を着た女はやはり同じ写真の中に現われた黒い式服の中年婦人の変形であるとしたところで、瀬戸物を踏み砕く一条だけは説明困難である。",
              "citation": {
                "source": "三斜晶系",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "緊張のために口の中のどこかがどうにか変形するためらしい。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともそう言えば結婚でも就職でも、よく考えてみればみんなイシャクの入れ歯をイブラヒムの口にはめて、そうして歯ぐきがそれにうまく合うように変形するまで我慢できるかできないかを試験するようなものかもそれはわからないのである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある意味において陶器の翫賞はエロチシズムの一変形であるのかもしれない。",
              "citation": {
                "source": "青磁のモンタージュ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々は、これを私の性慾の変形だと片付けそうである。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわばその「憎めない」は盲愛の変形でありますから、愛についての検討の部に属するものですが、しかし、普通の憎みの感情に対して変態的なもの、つまり憎み能わない憎みとでも強いていえばいえましょう。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
