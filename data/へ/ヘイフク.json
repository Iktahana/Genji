  {
    "uuid": "9f49f016-98c5-562e-a3d5-367e2f28a476",
    "entry": "平復",
    "reading": {
      "primary": "へいふく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
