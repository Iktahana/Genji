          "literary": [
            {
              "text": "川辺御楯君が鈴木君に贈与したものださうである。",
              "citation": {
                "source": "大塩平八郎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "その話によると、団十郎は小中村清矩、黒川真頼、川辺御楯などという人たちをあつめて、“求古会”というものを作ることになって、父もその会員の一人に加えられた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "御主人にもどうかこの辺御決心を願いたい』と、これが期せずして一致した意見であった。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治以後幸若の謡を知るものは川辺御楯、西田春耕の二人のみであったという。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の出の唱歌を歌ふて朝寐坊する人物が學校から出るやうになりては何の益にも立つまじく、其邊御賢慮願上候。",
              "citation": {
                "source": "日の出",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
