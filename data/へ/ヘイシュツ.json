[
  {
    "uuid": "701e6677-2d21-5196-945b-944a9d8a84f5",
    "entry": "迸出",
    "reading": {
      "primary": "へいしゅつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
