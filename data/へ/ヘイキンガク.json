          "literary": [
            {
              "text": "いや、この地方のみならず、日本全國を通じて、小作料の平均額はほぼさういふものとされてゐる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論この小作料の平均額は現在がさうだといふことである。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これと平均額の家禄とで辛うじて一家の生計は営んでいたのである。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時の年貢額は二百疋とあるが、これが平均額以上か以下かはわからぬ。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
