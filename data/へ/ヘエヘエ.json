        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "旦那様も御存じ……ヘエヘエ……そのガリガリの中へあっしが這入り損ねたお話なんでゲスからアンマリ気持のいいお話じゃ御座んせん。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はそのお連れ様の事に就いて尋ねたいのじゃが……」「ヘエヘエ……どのような事で……」「その、お連れ様という奥方風の女は、どのような人相の女であったろうか……」「……ヘエッ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "九大農学部に僕の友人が居ると云ったね」「ヘエヘエ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "好いた女と一所に殺されて、後に祟りを残すなんて仕事が、馬十の痴呆けた頭には、たまらなく楽しみだったかも知れないね」「ヘエヘエ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこれは相談じゃが、香奠と思うて今月の俸給の残りの四円を貸してくれんか」「ヘエヘエ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "助教授室……ヘエヘエ。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘエヘエそれあ、まったく返って来ないのも随分ありますよ。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その包箱の見返しの中央にＭＩＣＨＡＥＬ・ＳＨＩＲＯと読める朱墨と、黒い墨の細かい組合わせ文字の紋章みたいなものが、消え消えに残っているところを見ますと、私のカンでは多分天草一揆頃日本に渡って来て、ミカエル四郎と名乗る日本人が秘蔵してたものじゃないか知らんと……ヘエヘエ。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘエヘエむろんそうですとも。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはドウモ何ともハヤ……ヘエヘエ……何と仰言る……。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘエヘエッ……ド……ドッ……どうぞお落付きになって……お落付きになって……お静かに……お静かに……御ゆっくりお話し下さいまし……ナナ……なる程。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヘエヘエやっぱりコウして書物の中に埋まっておりましても探偵小説が一番面白いようで……まったくで御座います。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来あの蔵元屋は昔からこの万延寺でも一番上等の檀家で御座いましつろうがなあ和尚さん」「ヘエヘエ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなら、お尋ねしますが、あの斬られた娘の両親の中でも、あの父親は腹からの町人で御座いまっしょう」「ヘエヘエ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "実はあの娘の事に就いて少々相尋ねたいために今日、良助に同道致させた次第じゃが……万一、その方の申立てによってあの胴切りの下手人が相わかれば、褒美を取らするぞ」「ヘエヘエ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば何か他人に怨まれるような悪い癖はなかったかと申すのじゃ」「ヘエヘエ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の信用に拘わってはならぬとあって、役人体の者なぞは滅多に近寄らせんように取計ろうておったものじゃが……言語道断……」「ヘエヘエ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋の小野の小町というてみたような……ヘエヘエ。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "よう御座いますか、森栖さん」「ヘエヘエ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヘエヘエヘエヘ。",
              "citation": {
                "source": "赤い着物",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
