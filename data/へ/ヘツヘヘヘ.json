          "literary": [
            {
              "text": "眼をズルさうに輝かしながら）ヘツヘヘヘ、奥さん、これ、見なはれ！",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヘヘ、ヘヘヘ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヘヘ（尾崎に）やあ、……ごめんなして……（ノタノタ行きかける）五郎　待つてくれ、それぢや、あんたの方も困りやしないかね？",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヘヘ、どうせ君、こんな画だもの。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヘヘ、どうだい、助かつたと君は言つたね？",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事よりも、本当に怖えのは、親切さうに持ち込んで……ヘツヘヘヘ」　旅商人「……おい君！",
              "citation": {
                "source": "おスミの持参金",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヘヘ、そんな事で一々踊らされて、無けなしの金で罐詰めの道具買つたり、製板の株買つたり、ハムを作るのに資本をかけたりして益々借金ふやす百姓こそ、いい面の皮だ。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヘヘ、こてえられねえなあ。",
              "citation": {
                "source": "彦六大いに笑ふ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
