        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さうして四つ又が持て餘して双方とも暫く無言であつた時に「ヱヘヽヽヽヽ嫁さま貰つてやれ」　といつて脇を向きながらにや／＼と笑つた。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘヽヽおつかあ」　と太一は又にや／＼と笑つた。",
              "citation": {
                "source": "芋掘り",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "エヘヽヽヽ大丈夫ですよ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘヽヽヽだ」　二人は相尻居して足と足を組み當てた。",
              "citation": {
                "source": "足相撲",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに身体の様子も子供ぽいのに、エヘヽヽ」　人夫は卑しく笑い出した。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "登「然らば御免を……エヘヽヽ斯ういふ事に致しますか。",
              "citation": {
                "source": "華族のお医者",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "登「エヘヽヽヽくすぐつたうござりますな、左様横ツ腹へ器械をお当あそばしましては。",
              "citation": {
                "source": "華族のお医者",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "金「エヘヽヽ昨晩は大にお喧ましうございます。",
              "citation": {
                "source": "黄金餅",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅「ヘヽヽ今日明きましたんで、不断云ひ慣けて居るもんですから。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅「へえゝ是がお猪口……ウンナ……手には持慣けて居ますが、巧く出来てるもんですな、ヘヽヽ、是はお徳利、成程此ン中からお酒が出るんで、面白いもんですな。",
              "citation": {
                "source": "心眼",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人「エヘヽヽ此手では如何でございます。",
              "citation": {
                "source": "世辞屋",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人「エヘヽヽ此辺では如何さまで。",
              "citation": {
                "source": "世辞屋",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥「ハヽヽ何うか怒つてやアがる、えヘヽヽ御免なさい。",
              "citation": {
                "source": "にゆう",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚「エヘヽヽヽ、ナニおせきさんぢやない赤いソノ何とか云つたつけ、うむ、お赤飯か。",
              "citation": {
                "source": "八百屋",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヘツヘヽヽヽ、まつたくそれぢや貰ひ手もねえ。",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘツヘヽヽヽ、うめえことをしやがつたねえ。",
              "citation": {
                "source": "天國の記録",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "例のエヘヽヽつて調子ぢやなかつたぜ。",
              "citation": {
                "source": "運を主義にまかす男",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヘヽヽヽ、スベタとは、見目かたちよからぬ女房のことで……」「わかつた、わかつた……。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彦吉はマツチを拾ひながら、『こらまた常が悪いことをした、エヘヘヽヽ。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッヘヽヽ」「お芽出度う」　と僕は背中を叩いてやった。",
              "citation": {
                "source": "合縁奇縁",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッヘヽヽヽヽ」　と揶揄一番した。",
              "citation": {
                "source": "恩師",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヘヽヽ、お安くないんだな」「直ぐ追い帰そうと思いましたが、北海道くんだりまで慕って来たものを然うもなりません。",
              "citation": {
                "source": "女婿",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "仲人だもの」「尤も僕はもう一軒寄るところがあって急いだからね」「ヘッヘ」「おい」「ヘッヘヽヽヽ」「手がつけられない」「鞆へはいつ行く？",
              "citation": {
                "source": "負けない男",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッヘヽヽ」「気をつけろ！",
              "citation": {
                "source": "勝ち運負け運",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッヘヽヽヽ」　と窓の内から新太郎君を覗き上げた。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「子供の時浅草の釣り堀でやったんです」「ハッハヽヽヽ」「ヘッヘヽヽヽ」「浅草の釣り堀と太平洋を一緒にされちゃ溜まりませんな」「太平洋では何が釣れますか？",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッヘヽヽヽ」　と会計係の新井さんが応じた。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヘッヘヽヽヽ」「申分ないじゃないか？",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッヘヽヽヽ」　とヨロ／＼した。",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヘッヘヽヽヽ」「何さ？",
              "citation": {
                "source": "脱線息子",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
