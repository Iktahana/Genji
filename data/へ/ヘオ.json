          "literary": [
            {
              "text": "コンドノ土ヨウ日ニ小サイオヂサント、コチラヘオイデ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "各幹事ハ打合セノタメ至急庶務ヘオ出デ下サイ。",
              "citation": {
                "source": "海流",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンジンノ反物ヲ木ノ枝ノ穴ノ中ヘオイテキマシタカラ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネコ　ノ　オバアサン村山籌子　タイヘントシトツタオバアサンネコガ、オヒルコロニナツテメヲサマシテ、ベツドノウヘヘオキアガリマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トプリプリシテ、オダイドコロヘオリテユキマシタガ、マダ、オシタクガデキテヰマセン。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「カマクラノオバサントコヘオクル。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木氏曰ク、非常ニ忙シイノデ拙宅ヘオ越シ下サルコトヲ望ムガ、往診ノ場合ハ週ニ三回ニシテ戴キタイ、拝見シナケレバ分ラナイガ、オ話ノ様子デハ多分治癒出来ルト思ウ、二三カ月ハカヽルデショウト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガドウシタンダ」「アタシモ覚エテナインダケレド、鉾田トハ仕事ノ関係カラ近頃懇意ニオナリニナッテ、時々オ目ニカヽルコトガアルンデスッテ」「ダカラサ、ソレガドウシタト云ウノサ」「イヽエネ、ソノ油谷サンガ先週ノ日曜ニ御近所マデ参リマシタカラッテ、御夫婦デ鉾田ノトコロヘオ寄リニナッタンデスッテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤ、オ爺チャン何処ヘオ出カケ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「墓地ハ決ッタンデスカ」「大体法然院ト決ッタ、オ寺ノ方デモ承知ダソウダ」「ソレハヨカッタワネ、ジャ、イツ東京ヘオ帰リニナル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今頃ドチラヘオ出掛ケニナリマスノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家ニアルツワイス・イコンヲ使ッテ写シテミヨウカト思ウ」ト云ッタラ、「現像ハ外ヘオ出シニナルノデスカ」ト彼ガ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その塙の路を地方によっては、やはり上総のごとくヘオといっていたのである。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシ、ニホンヘオリタ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリス、アメリカ、ソビエトヘオリタノモアル。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
