[
  {
    "uuid": "7c988756-7174-598d-9572-11cbe7f13370",
    "entry": "閉式",
    "reading": {
      "primary": "へいしき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞",
        "動詞-サ変",
