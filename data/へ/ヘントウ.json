[
  {
    "uuid": "91f4b3ea-1b66-545a-a5bb-07d37666eb7f",
    "entry": "返答",
    "reading": {
      "primary": "へんとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
