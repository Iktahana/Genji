          "literary": [
            {
              "text": "次いでヘロディコス、ソフィストのゴルギアス、哲学者のデモクリトスに学んだ。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は医学教育を父親からとヘロディコス（Herodicus）から受け、哲学をソフィストであるゴルギアス（Gorgias）、およびデモクリトス（Democritus）から教えられたと言われている。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリッポスのために処刑された大勢の中に、テッサリア人の王であるヘロディコスという者があった。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
