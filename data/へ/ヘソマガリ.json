        "examples": {
          "standard": [
            {
              "text": "彼は本当にへそ曲がりで、みんなが右と言えば必ず左を選ぶんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "素直に謝ればいいのに、へそ曲がりな性格のせいでまた喧嘩になってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "あのへそ曲がりなお爺さんも、孫の顔を見るときだけは優しい顔になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ところがへそまがりが、メニューを減らして効率アップを目指そうと言い出した。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
