          "standard": [],
          "literary": [
            {
              "text": "）　われは友を顧みて、拿破里は最早こゝより見ゆるかと問ひしに、友は笑ひて、まだ見えず、されどヘスペリアは見ゆるなり、アルミダの奇しき園は見ゆるなりと答へき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘスペリアは希臘語、晩國、西國の義なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどこゝには、希臘神話にヘスペリアといふ女神ありて、西方の林檎園を守れるを謂ふならん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "人ありて我にヘスペリアの好景を歌へと曰はゞ、我は此遊の見る所を以てこれに應ふるならん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘスペリアの海をくぐる山羊座の運勢はいかに。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
