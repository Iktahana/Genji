        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日本歴史で、知り得る限りでは、大和国の山辺郡の大倭村が、やまとの本地であつたらしい。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "大和の北と真中の平原にあつた村々を支配するまでに、づぬけて勢力を持つて来たのが、山辺郡｜大倭を土台にした村だつたのである。",
              "citation": {
                "source": "万葉びとの生活",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鳥立たづぬる宇陀の御狩場」というのは宇陀の松山からかけて榛原より西峠、山辺郡に至るあたりを言うたものらしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "山辺郡につづくあたりは全く人家がない、初瀬の裏山へかかっても人家がない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "摂州有馬の鳥地獄や、同じく川辺郡昆陽池の片目魚のごときは、むかしは迷信をもって説明したけれども、今日は格別これを怪しむものがないようになった。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "先年、信州松本近在にその怪事が起こり、そののち尾州葉栗郡宮本村にも起こり、またその後、大和国山辺郡朝和村にも起こったことがある。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "富松は河辺郡と武庫郡とに分れて、東西富松の二つある。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "発見地は秋田県河辺郡荒巻村後山で、むろん石器時代の遺品である。",
              "citation": {
                "source": "奥羽北部の石器時代文化における古代シナ文化の影響について",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙北の俘囚　仙北の名は今は平鹿郡と川辺郡との間にある一郡の称となっているが、もとは広く山の北の義で、羽前境の連山以北、御物川上流の平野を中心とした一帯の地の総称であった。",
              "citation": {
                "source": "春雪の出羽路の三日",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ははア、――大和の国ですね――中山ミキの生れたのは』『へえ、大和の国山辺郡三味田村で御座ります』『その人はもう昔死んだので御座りますか？",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "○飛ぶ鳥の明日香の里を置きて去なば君が辺は見えずかもあらむ　〔巻一・七八〕　作者不詳　元明天皇、和銅三年春二月、藤原宮から寧楽宮に御遷りになった時、御輿を長屋原（山辺郡長屋）にとどめ、藤原京の方を望みたもうた。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "摂州｜川辺郡東富松の部落においては、すでに茨木童子の家筋は絶えたかわりに、更に一段と心を動かすべき物語が残っていた。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヅクベ　　　　　　　　秋田市ヅクベ（ボウズ）　　　南秋田郡ヂックビ　　　　　　　仙北郡横沢ヅックベ　　　　　　　同　大曲等ヅクンベ　　　　　　　河辺郡ヂクベ　　　　　　　　由利郡亀田町ヅクベ　　　　　　　　同　笹子村グウヅベ　　　　　　　飽海郡｜本楯村　山形県下は大体にほぼ中央部と一致している。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを河辺郡ではカッパノシュンチコというそうである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋田県｜河辺郡のネリガユは、粃米の粉であってこれを午食用に供し、三重県南海岸のネリゲはまた蕎麦粉であった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵庫県｜川辺郡稲野村昆陽）　またある説では行基は三十七歳の年に、故郷の和泉国へ帰って来ますと、村の若い者は法師を試して見ようと思って、鮒のなますを作って置いて、むりにこれを行基にすすめた。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈良県｜山辺郡二階堂村）　油掛地蔵といって、参詣の人が油を掛けて拝む地蔵もありました。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車で由利から河辺郡の海岸を走っているときでも、窓からただ海の方を眺めているのみで十分である。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その例を挙げれば、薩摩｜川辺郡加世田村大字津貫字狩集肥後｜八代郡下｜松求麻村字狩集備中｜吉備郡大和村大字｜岨谷字カリアツマリ美作久米郡｜大倭村大字南方一色字苅集リ和泉泉南郡西葛城村大字｜蕎原小字集リ坂大和宇智郡五条町大字二見字島小字集リ等である。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆の村々や大和の山辺郡などの岡の上の百姓、または東京以西のいわゆる野方場の百姓は、官道の通過というような特別事由がなければ、集合部落は作りにくく、すなわちイを形造ることが少なかった。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのため一応取次をして貰っている鳥井氏に会おうと思って、川辺郡川西村字何とかいうアドレスを頼りに、探して行った。",
              "citation": {
                "source": "鳥井さんのことなど",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その年の十二月に兵庫県川辺郡稲野村に梶井君を見舞ひ、二人は温い日当りをよつて散歩に出たのだが、梶井君はこの辺りが「稲野笹原風吹けば……の稲野だよ」などと説明した後で、色々文学や文壇の話をしあつたのだつたが、その時、突然、しかし悠々たる態度で、「東京の横光はどうや？",
              "citation": {
                "source": "横光さんと梶井君",
                "author": "淀野隆三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
