        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私が作ったへっぽこなプログラムのせいで、システム全体を巻き込む重大なエラーを出してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "あんなへっぽこ探偵に浮気調査を依頼したのが間違いで、証拠も掴めずに高額な料金だけ請求された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼は自称天才ハッカーだが、実際は他人のスクリプトをコピペして動かすだけのへっぽこだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "他のへっぽこ占ないは駄目よ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "へっぽこ部長だ、お前は。",
              "citation": {
                "source": "女類",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ルコックは哀れなへっぽこだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "あってもへっぽこ悪事、動機が見え透いているから、スコットランド・ヤードの刑事どもでも見破れてしまう始末だ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばへっぽこレストレードの発見だが、あれは単なる目くらましで、社会主義者か秘密結社をにおわせて、警察を誤った方へ向かわせたいだけだ。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "へっぽこな親父をもったより骨が折れる。",
              "citation": {
                "source": "墓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "へっぽこ詩人の女郎奴、貴様がついて来たら本当にこの僕の天外な像が分っただろうに、莫迦な女郎奴と彼は心の中で文素玉を憎々しげに罵った。",
              "citation": {
                "source": "天馬",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、俳優の立派であるか、へっぽこであるかということは、それは決して舞台の上にあがって、ある役を演じてはじめてわかるのではない。",
              "citation": {
                "source": "俳優倫理",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この女、三杉磯がひいきで、三杉磯がへっぽこの間、夜は女とねて、昼は掃除もするというようにして居たが、そろそろ売り出すとこんな婆より新橋の方がいい。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく仕事を休んで、うまいものを食ってごろごろしていれば癒ってしまう」　医務室のへっぽこ医者にわかるわけはないのだ。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして創作する者は感じても差支えないと思うような人は、へっぽこだからです。",
              "citation": {
                "source": "トニオ・クレエゲル",
                "author": "TONIO KROGER",
                "note": "青空文庫"
              }
            },
            {
              "text": "或るへっぽこ医者は冷水浴療法を僕にすすめたし、やや気の利いた他の医者はドーナウの例の温湯浴をすすめた。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「吉良領がどうしたんだ、忠臣蔵のへっぽこ芝居にたぶらかされている奴等におれたちの気持がわかってたまるもんかい、よし、ひと口でも吉良上野の悪口をたたいてみやがれ、そのままにしておくものか」　青年たちは三人五人と肩を組んで、祭礼があるごとに他領へ押しかけていった。",
              "citation": {
                "source": "本所松坂町",
                "author": "尾崎士郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "博物館でとらえたのは、あれは二十面相でもなんでもない、ただのへっぽこの野郎だったということを、世間に広告するようなもんじゃないか。",
              "citation": {
                "source": "少年探偵団",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭の上の電気時計はタッタ今午後の十時をまわったばかり……横啣えをした葉巻からは、紫色の煙がユラリユラリ……何の事はない、糞勉強のヘッポコ教授が、居残りで研究をしている恰好だ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなヘッポコ役人の御機嫌を取って、罪を赦してもらう位いなら、モウ一度、玄海灘で褌の洗濯をします。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しきりにシカメ面をして涙を拭う真似をしていながら、鼻だけはノホホンとしているために見物には何の感動をも与え得ないヘッポコ役者の表現法とは、その根底の在り処が違うのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッポコ皮肉といふものだ。",
              "citation": {
                "source": "素書",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "竜頭をいじって耳へもってゆくしぐさを繰返す――　この碁打ちたち、かたちはさも巧者でありそうだが、だが、ある折、妹の婿の若い、海軍のヘッポコ少尉がこの三人の前で、「とても駄目です、僕は軍艦でも、ものにならない方の、その中の一番しまいです。",
              "citation": {
                "source": "お墓のすげかえ",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "この長い間の歴史的存在を、僅か三つや四つのヘッポコ小説でけりにしてしまつて、それでいいのか、と私の頭は考へねばゐられないのだ。",
              "citation": {
                "source": "柊の垣のうちから",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんなヘッポコ詩人に何の用があるものか。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼ばなくてもいいヘッポコ医者なんぞ呼んで！",
              "citation": {
                "source": "葛根湯",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘッポコ小説家だから、小説の方はなかなか横綱までゆかぬが……横綱どころか！",
              "citation": {
                "source": "雷嫌いの話",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "梁山泊でぶちのめされた、だらしのねえヘッポコ将軍てなあ、てめえか」「だまれ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やい、ヘッポコ、チョンガリ、南京虫！",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "体重といい身長といい、何たるヘッポコか。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
