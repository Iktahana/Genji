[
  {
    "uuid": "21af6617-98c1-58bc-b517-bedba3f6dce3",
    "entry": "変てこ",
    "reading": {
      "primary": "へんてこ",
      "alternatives": [
        "ヘンテコ"
      ],
      "is_heteronym": false
    },
    "grammar": {
