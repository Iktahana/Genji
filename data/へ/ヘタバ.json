        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ヤレヤレ」ト　チヤウサンハ、タウトウ　クルマノ　ナカニ　ヘタバツテ　シマヒマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり日中を避けて、朝の間と夕方だけ馬を歩かせるので、あんまり速く馬を歩かせたり、モウ夏になりかけている日光に当てたり何かすると、眼をまわしてヘタバル奴が出来かねないからだそうです。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "レミヤの膝の上に赤ん坊を取り落したまま、射抜かれた飛行船のようにフラフラと回転したと思うと、バッタリと床の上にヘタバリたおれてしまいました。",
              "citation": {
                "source": "霊感！",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなると又、その恋しい係りの交感台の交感嬢がイヨイヨやり切れなくなってヘタバリ込む。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘタバッたのかい」「ナアニ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩はその時にドッカリと椅子にヘタバリ込んだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "新式タービンのパリパリが、ビスケー湾の檜舞台でヘタバッたり、アラスカ沖の難航で、陸地が鼻の先に見えながら、石炭が足りなくなったりする。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この中に這入ること好きですか……仕事しますかしませんか」　流石のあっしも……流石でなくたってヘタバッちまいますよ。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時にコレ位の僅かな分量で、一人の人間がヘタバルものならば、俺はチットばかり薬を持って来過ぎたな……と気が付いた。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも、そうしたタマラナイ、浅ましい記憶の全部を、現在眼の前で、副院長に図星を差された一｜刹那に、電光のような超スピードで、ギラギラと恢復してしまった私は、もう坐っている力も無いくらい、ヘタバリ込んでしまったのであった。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……とはいえあの「蟲」の主人公が、女優の屍体を土蔵の中からトウトウ取り出し得ずに、変テコになってヘタバッてしまう迄の極度にあられもない気分の変幻を、あんなに平気で扱い去った筆力の凄まじさには「鬼か人か」と叫びたいくらい、参いらせられてしまいました。",
              "citation": {
                "source": "江戸川乱歩氏に対する私の感想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し強情我慢の名を惜しむ二人はここでヘタバッてなるものかと歯を噛みしめて、互いに先陣を争って行くうちに、やっと人家近い処へ来たので二人とも通りかかった小川で尻を洗い、宿屋に着くには着いたが、あまりの息苦しさに、ボーオとなって腰をかけながら肩で呼吸をしているところへ宿屋の女中が、「イラッシャイマセ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな男の喧嘩大将も一生懸命我慢していましたが、とうとう我慢し切れなくなって、百も二百も続け様にクシャミをしているうちに地びたの上にヘタバッてしまいました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六蔵の体が地の上へ潰された蟇のようにヘタバった。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の労働への進出については、僕にして見れば相当に感激もしているしほめたくもあるのだが、今あんまり口を極めて賞賛してしまうと、直ぐ二三ヶ月してから（そんなこともないだろうが）すっかりヘタバッテしまうようなことになるとすると、君はその時、余計恥ずかしい思いをしなければならないから、今は余りホメないよ。",
              "citation": {
                "source": "新しき夫の愛",
                "author": "――　牢獄の夫より妻への愛の手紙　――",
                "note": "青空文庫"
              }
            },
            {
              "text": "膝を立て、両手を廻して膝をおさへ、クハヘタバコ、パクパク。",
              "citation": {
                "source": "散る日本",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう証拠をつきつけられても、彼はいささかもたじろがず、オレはあの日一日伐っただけだから、それでは、それはオタツだろう、オレはオタツが牛でもヘタバるような大きな材木をかついで行くのを何べんも見たことがあると証言した。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十二　愚妖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
