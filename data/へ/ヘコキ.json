        "examples": {
          "standard": [
            {
              "text": "彼は悪びれる様子もなく屁放きをして、部屋中に気まずい沈黙を漂わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "落語の演目の中には、屁放きを芸にする男を滑稽に描いた「屁放き爺さん」がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "授業中にこっそり屁放きをした犯人探しが始まり、教室内は騒然となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "赤松は裸が好きで枝葉をだん／＼梢の方へこき上げて行く。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "下級生でさえも、あいつ屁えこき虫と、公然指さしてわらった。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなは、石太郎のことを、屁えこき虫としてとりあつかっている。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、屁えこき虫の石が、例のくせを出したのである。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今こっちからつっつくから、むこうで、屁えこき虫といっしょにかまえとって、つかめ。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "むこう側へこしてみると、なるほど、屁えこき虫の石太郎が、このときばかりはじつにしんけんな顔つきで、そこのどろみぞの中にひざこぶしまではいって、土管の中へ、右手をうでのつけねまでさし入れている。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなの視線の集まるところに、屁えこき虫の石太郎が、てれた顔をつくえに近くさげて、左右にすこしずつゆすっているのである。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "屁えこき虫の石太郎が屁をはなったときと、寸分ちがわぬことが。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ是信さんは、おしもおされもせぬ屁こきである。",
              "citation": {
                "source": "屁",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
