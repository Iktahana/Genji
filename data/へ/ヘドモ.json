        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "えーと、よろしくお願いします」　といって頭をさげながら、慶一は、なんか、ヘンだな、と思ったが、あたりをはらうような、この親子の華やかさに圧倒され、ただヘドモドした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "白磁色の頬を火のように燃やし、黒曜石色の瞳を異妖な情熱に輝やかしつつ、彼女の方からウネウネと身体を乗出して来たので、たまらない息苦しい眩惑をクラクラと感じた支配人は、今更のようにヘドモドし初めた。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "梶子は笑止に思ったが、吹き出すことも出来ないので、かえってわざと威厳を作り、「あなた方の味方に加わって、青塚の郷へ参るのも、女隠密としての必要ゆえ……」「へ、へい」と軍右衛門はヘドモドし、こわそうに梶子を上眼づかいに見た。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ本国いぎりすノ国家ノ強ヒル宗教ヲ信ズルコトヲ肯ンゼザルナリ、制度ハ国ノ制度ヲ遵奉セザル可カラズトイヘドモ、信仰ハ自由也、国家ヨリ賦課セラルベキモノニアラズ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君ハ君タラズトイヘドモ、臣モッテ臣タラザルベカラズ、親ハ親タラズトイヘドモ、子モッテ子タラザルベカラズ」　娘の読み下すのをぢつと聴いてゐて、文則は、「待て。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はヘドモドして、えゝ、ハア、女の人、うわずって言い直して、あやまったりしたが、私は然し、口惜しさで、あなたを軽蔑しきっていた。",
              "citation": {
                "source": "三十歳",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女に高飛車にきめつけられると、松夫はヘドモドしてしまう。",
              "citation": {
                "source": "握った手",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "オレたちが足すりへらして三拝九拝、ヘドモドしながら諸方を駈け歩いているのに、妃殿下は寝たッきり身うごきもしねえや。",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（３）「其の下には」ト原文ニナキモ、木ト花草ノ關係ヨリ入レ候ヘドモ、必要ナキヤウニ思ハル。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "國文ノ規則ニ從ヒ省略セムト思ヘドモ力及バズ。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　清の名家｜袁随園が『詩話』巻四に「詩ハ淡雅ヲ貴ブトイヘドモマタ郷野ノ気有ルベカラズ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "否ザレバ鳥啼虫吟沾沾トシテ自ラ喜ビ佳処アリトイヘドモ辺幅固已ヨリ狭シ。",
              "citation": {
                "source": "小説作法",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは毎年冬の寝覚に、落葉を掃く同じようなこの響をきくと、やはり毎年同じように、「老愁ハ葉ノ如ク掃ヘドモ尽キズタル声中又秋ヲ送ル。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "今彼我ノ二書ヲ比較スルニ東武ノ詩人｜大沼枕山ノ事ニ関シテハ彼ハ我ニ比シテヤヤ簡略ナリトイヘドモ中京ノ詩人｜森春濤ノ事ニツキテハ遥ニ精緻ヲ極メタリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生射ヲ善クシ、四矢反セズトイヘドモイマダカツテ※ヲ出デズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔宅ハ三遷セズトイヘドモ孟母ノゴトク賢ナリ〕と言うを見ればこの年益斎の母はなお健在であったと思われる。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然リトイヘドモ上人ノ寛懐｜固ヨリコレヲ罪セズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔秋峰瀟洒ノ質／子肇豪宕ノ才／文郁齢猶｜弱シトイヘドモ／清詩点埃ヲ絶ツ／子寿交リ最モ旧ク／辛勤十載ヲ偕ニス／姓字海内ニ馳セ／吟壇雄魁ニ推ス〕と言っている。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐宋諸賢ノ集中往往ニシテ粗笨冗長ナルガ如キ者アリトイヘドモ、ソノ実ハ句鍛ヘ字錬リ一語モ苟クセズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒陬僻邑識ラザル者トイヘドモ、必※中ニ入レ、釐テ二巻トナシ命ジテ名家詩録トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夷カニコレヲ考フレバ則チ古器ハ雅ナリトイヘドモイマダ新器ノ時用ニ適シテシカモ便ニカツ利ナルニ若カザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ『天保嘉永絶句』及ビ『摂西摂東詩鈔』〔『摂西六家詩鈔』、『摂東七家詩鈔』の二書のことか〕頗ル諸州ヲ収ムトイヘドモ、然レドモイマダ一方ノ都会ヲ専取スル者ハアラザリシ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヽ降誕ト訃来ト五十四年ヲ隔ツトイヘドモソノ地｜相距ルコト百歩ニ過ギズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "板葉｜焚燬ストイヘドモコレヲ索ルコトマタ難カラズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "衰病ニ由ルトイヘドモマタ賦性ノ然ラシムル所。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "成島柳北があたかもこの年の秋に著した『柳橋新誌』第一編にお菊の事を記して、「彼ハ傾国ノ色絶世ノ技アルニ非ラズトイヘドモ、繊繊タル女手ノ力ヲ以テ大ニ巨閣高楼ヲ墨水ノ西ニ営ミ、扁シテ有明楼トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ君ガ緒余ナリトイヘドモ、マタ以テソノ博学ノ翁ニ淵源スルヲ見ルニ足レリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "名ハ集ナリトイヘドモ実ハ子ナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
