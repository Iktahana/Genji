          "literary": [
            {
              "text": "編集人は兄の方で適当の人があるかも知れんが、こんな意味からもやはり守田に頼むのがよかろう。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、編集人の件、なるべくなら他の講座同様岩波氏にしていただいた方、万事好都合と思いますので、極力そうしてもらうよう交渉すべきだと存じます。",
              "citation": {
                "source": "平野義太郎宛書簡",
                "author": "一九三二年四月三十日",
                "note": "青空文庫"
              }
            },
            {
              "text": "開館前から富田がシンポジウムで構想を語り、開館直後にはボイジャーの萩野が編集人に名を連ねる『季刊　本とコンピュータ』で紹介された。",
              "citation": {
                "source": "青空文庫ものがたり",
                "author": "インターネット図書館の開設から今日まで",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
