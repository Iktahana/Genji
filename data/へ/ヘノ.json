        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "哲学ハ、知ヘノ愛デハナクテ、真実ノ知トシテ成立セシムベキ様ノ体系知デアル、ヘエゲル先生ノコノ言葉、一学兄ニ教エラレタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "不審に堪えず、薬の箱をよく見ると、それはヘノモチンという下剤でした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘノモチン、という」　と言いかけて、うふふふと笑ってしまいました。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "眠ろうとして下剤を飲み、しかも、その下剤の名前は、ヘノモチン。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マヘノ　カゴカキモ、「シーツ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マヘノ　ハウガ、「モウ　シバラク　マテ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ウシロノ　ハウガ　イヒマスト、マヘノ　ハウガ、「モウ　スコシ　サキノ　ガケノ　上カラ　タニ川ヘ　ホリコンデ　ヤラウ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ヲトコハ　アル　イヘノ　マドシタニ　タツテ、「オナカガ　スイテ　シヨウガ　アリマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヘノ　ナカニハ　フタリノ　トシヨリガ　ヰテ　チヨウド　ヒトツノ　パンヲ　フタツニ　キラウト　シテ　ヰル　トコロデシタガ、ハラノ　スイタ　ヲトコヲ　キノドクニ　オモツテ　パンヲ　ミツツニ　キリ、ソノ　ヒトキレヲ　ヲトコニ　メグンデ　ヤリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フルイ　バシヤ新美南吉　ムラヤクバノ　マヘノ　ヒロツパニ　フルボケタ　バシヤガ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ノ生産的各省ヘノ貸付。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "全世界人ヘノ警告文　余スナワチ金博士は、今度ヒソカニ感ズルトコロアリテ、永年ニ亘ル秘密ノ一部ヲ告白スルト共ニ、之ニサシサワリアル向ニ対シ警告ヲ発スル次第ナリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（此項モ東京朝日新聞ノ「探シテ居ルモノ」ヘノ寄稿デアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコヘノツテヨイノヤラ　ワカラナイノデ、ヤネニノリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "柿の木が「カヒの木」、猫の子が「ネホの子」、筍が「タヘノコ」。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木昆陽（甘藷先生といわれる学者）の『昆陽漫録』に「我国ノ古ヘノ草はモチ］ハ鼠麹草ナリ」とある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の『桃洞遺筆』に引用されている『本朝食鑑』（小野必大の著、元禄十年1697出版）巻之四の文を仮名交りに書いてみれば、「上野州下野州ニ山栗アリ極メテ小ニシテ一年ニ三度、栗ヲ収ム故ニ三度栗ト号ス其味ヒ佳ナラズト為サズ此｜類ノ山栗ハ諸州ニ在レドモ亦極メテ小キナリ是レ古ヘノ※栗乎」である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どう悪く見つもっても、原稿紙にヘノヘノモヘジを書く仕事では無い。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "利根川ノ西岸ヨリ山東ヲ繞テ越後国ヘノ山道アリ、コヽニ謙信馬返シ岩ト云アリ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "媚ビノ呈シ方、陶酔ヘノ導キ方、漸々ニエクスタシーヘ引キ上ゲテ行ク技巧ノ段階、スベテハ彼女ガソノ行為ニ渾身ヲ打チ込ンデイル証拠デアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の古語にあるソキヘノキハミ、またはソキヲリトモヨのソキ・ソキヘなどは、底のソコと確かにもと一つであったが、本来は単に遠い距離を意味し、必ずしも足もとの直下とは限らなかったらしい。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠をヨモノだのヨモノヒトだのという中に挟まって、東北地方などには稀にはまた、ウヘノアネサマという異名もある。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『書紀』の神代巻でも、「新嘗」の文字を用いつつも、天照大神当新嘗時を、ニハナヘきこしめす時と訓ませ、またその新宮をニハナヘノミヤと訓ませていた。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それの用紙には、　――東福寺領肥前ノ国｜彼杵ノ荘ヘノ鎌倉幕府下知状目録　といったような文書の反故裏がたんねんにつかってある。",
              "citation": {
                "source": "私本太平記",
                "author": "八荒帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘマムショ入道はヘヘノノモヘジのことである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
