        "examples": {
          "standard": [
            {
              "text": "満員電車の中では、乗客たちが一刻も早く降りようとして出口付近で激しく圧し合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バーゲンの会場では、限定品を手に入れようとする人々がワゴンを囲んで圧し合う騒ぎになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "狭い路地に神輿が入り込むと、担ぎ手たちが威勢よく圧し合いながら練り歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "固性の観念を造るためには、少しも透入なくして、相互に圧し合う二つの物体を考えなければならない。",
              "citation": {
                "source": "人間本性論（人性論）",
                "author": "A Treatise of Human Nature",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
