          "literary": [
            {
              "text": "だからね、ゆつくり遊んでつてね、それにお母さんが、あとでいゝんだけれどね、今朝ね、猿が檻から逃げ出しちやつて、さつき一辺皆なで追つかけたんだけれど、どうしても捕まらないのよ、お午からまた皆なでやるんだけれど、あなたに手伝つて貰ひたいんだつてさ。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "寛文検地帳ニハ、此社ノ跡辺皆仮名ニテフクチト記タルハ誤ナルコト知ヌベシ。",
              "citation": {
                "source": "マル及ムレについて",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう晩かつたから、材木の森に谺する鰐口の響きもなく、露地の奧から笛の音も聞えず、社頭にたゞ一つ紅の大提灯の霧に沈んで消殘つたのが、……強ひて擬へるのではない、さながら一抹の丹頂に似て、四邊皆水。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
