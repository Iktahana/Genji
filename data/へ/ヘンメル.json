          "literary": [
            {
              "text": "その一番前のが、一九四六年ヘンメル家から、頂戴して来たものだ。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "がヘンメル家と聞いた途端、拳銃片手に思わず旅行鞄の中を覗き込んだ。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘンメル家、ウェッセル家等々、今日なお迷宮に入っている幾つかの難事件が思い出されてきたからであった。",
              "citation": {
                "source": "グリュックスブルグ王室異聞",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
