        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鏝で勢いよくきゅうとなでて、ちりちりぱっとくくりをつけて、パイプをくわえて考え込んで、モンパリー、チッペラリー、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "助手はのんきにうしろから、チッペラリーの口笛を吹いてゆっくりやって来る。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体何がチッペラリーだ。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と笑ってからチッペラリーの口笛を又吹きながら出て行った。",
              "citation": {
                "source": "フランドン農学校の豚",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "松次郎は馬車のうしろに向って、ペラリと舌を出すと、「糞爺いの金聾」と節をつけていって、ぽんぽんと鼓をたたいた。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペラリとしたのよ、一枚の。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっとあんなに細かく書いてあるのにペラリと一枚ではわるいと思ったのね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それからＭは気軽そうにティッペラリイの口笛を吹きはじめた。",
              "citation": {
                "source": "海のほとり",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスティの『グード・バイ』『ティペラリー』、それから母国アイルランドの民謡はことごとく面白い。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
