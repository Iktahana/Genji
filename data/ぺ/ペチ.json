        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私が自分の部屋にかえると隣の寝台にカーテンも引かないでペチ・コートのまま仰向けになったアダが、夢うつつにも寝床で寝るトア・ズン・ドルの女を再び見出した。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ペチャペチャおしゃべりして、げびてまいります。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "口に出したくも無いことを、気持と全然はなれたことを、嘘ついてペチャペチャやっている。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "食い物がないのを知ると、竈の傍へ行って、ペチャ／＼やりだした。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『さうですかね』『でなくても左樣見えますね』『婆樣は上方者ですよ、ツルリンとした顏の何處に「間拔の狡猾」とでも言つたやうな所があつて、ペチヤクリ／＼老爺の氣嫌を取て居ましたね。",
              "citation": {
                "source": "湯ヶ原ゆき",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペねずみが、たくさんとうもろこしのつぶをぬすみためて、大砂糖持ちのパねずみと意地ばりの競争をしていることでも、ハねずみヒねずみフねずみの三匹のむすめねずみが学問の競争をやって、比例の問題まで来たとき、とうとう三匹とも頭がペチンと裂けたことでも、なんでもすっかり出ているのでした。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お光が「まあお掛け」と二人仲良く茶店の縁台に腰掛けて、何やら楽しげに、ペチャペチャ、誰が見たって恋人同士の甘き囁き。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お光と仲蔵、尚もペチャペチャ喋言ってる。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二ページはおかあさんの留守に幼少な娘のリエナが禁を犯してペチカのふたを明け、はね出した火がそれからそれと燃え移って火事になる光景、第三ページは近所が騒ぎだし、家財を持ち出す場面、さすがにサモワールを持ち出すのを忘れていない。",
              "citation": {
                "source": "火事教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "クジマが「今後はペチカとランプと蝋燭以外に飛び出してはいけないぞ」と命令する場面で、ページの下半にはランプと蝋燭のクローズアップ。",
              "citation": {
                "source": "火事教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "旁々の手を見れば、半はむきだしで、その上に載せた草花の束ねが呼吸をするたびに縞のペチコートの上をしずかにころがッていた。",
              "citation": {
                "source": "あいびき",
                "author": "イワン・ツルゲーネフ　Ivan Turgenev",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かふつと思ひついて、素晴らしい發見でもしたつもりでゐてもさて社會へ出て見るとペチヤンコですよ。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かふっと思いついて、素晴らしい発見でもしたつもりでいてもさて社会へ出てみるとペチャンコですよ。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして手ばしこくコルセットをはめたり、漸く着なれたペチコオトを着けたりした。",
              "citation": {
                "source": "あらくれ",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペチカの前にでも跼んでいたのらしい。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "セメントのペチカは右の室へ通ずる渋がちの廉更紗のカーテンの傍に造りつけになって、そのまた隣りに、これも粗末なテエブルが一つ出しっぱなしになっていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかほかと焼けかかったパンの香いがして、ペチカの焚き口には赤い火の反射が幽かにはみ出していた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "指でちょいと、ペチカの方を、そして私が茶目ると、赤いおやじさんがぽんぽんと片手でその首根っこを叩いた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "どかりと、ペチカの方で、テエブルに何か投げ出す音がした。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから私たちもペチカの前へ引き帰すと、娘のナタアシャも蹤いて来た。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "サモアルは空つぽでペチカは燃えず、されば新劇林のごとく静かなる部屋にかかる小沢の喧騒な演技もまた情熱の現れか？",
              "citation": {
                "source": "小熊秀雄全集-13",
                "author": "詩集（12）その他の詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "手にふれるものがみんな燃えちまふわわあ　みんなすごい熱だ○あの病気はつまりペチャ　クシャうむ、それでペチャ　ペチャそれだから　ペチャクシャどうも大ぶ病気が重いのぢや○あれつ？",
              "citation": {
                "source": "小熊秀雄全集−22",
                "author": "火星探検―漫画台本",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
