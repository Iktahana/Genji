          "literary": [
            {
              "text": "良人が市街の地図を出して、何処が一番｜賑やかなのかと聞くと、プラス・ペピユブリツクだと云ふ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあペピユブリツクへ行つて見るんだね。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同室の四五人の婦人客は皆ペピユブリツクで降りた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "良人が市街の地圖を出して、何處が一番賑やかなのかと聞くと、プラス・ペピユブリツクだと云ふ。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあペピユブリツクへ行つて見るんだね」　と良人は云つて、ピガル廣場から地下電車に乘ることにした。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
