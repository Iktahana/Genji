        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お腹を空かせた子供たちは、出されたお菓子をあっという間にペロペロと食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は忙しい朝でも、トーストをペロペロと平らげて仕事に向かう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「こんなに美味しい料理、ペロペロって食べちゃったよ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
