        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "530ロクリス族の住む處、キノス、オポース、カリアロス、ペーッサ及びスカルプェー、更にいみじきアウゲーア、更にタルプェー、トロニオン、傍へる流はボーグリョス。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユウエーノスの生み出でしマルペーッサは妻の母、父はイデース、人界の中に最も強きもの、脚美はしき女子のため、神プォイボス・アポローン、威靈かしこき神明に向ひて嘗て弓張りぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "イデースとマルペーッサの間に生れしはクレオパトレー即メレアーグロスの妻。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
