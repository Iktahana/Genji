        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "＊　ファシングは一ペンニイの四分の一。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞや一ペンニイ、じいめが帽子にほうりこんでくだされ。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ペンニイがおいやなら半ペンニイでもようござる。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "半ペンニイでもないならば、ごきげんよろしゅう、だんなさま。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ペンニイで一つ、二ペンニイで二つ、あったかいパン。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
