        "examples": {
          "standard": [
            {
              "text": "出血を止めるために、執刀医は素早くペアンで血管をクランプした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "手術室の看護師は、医師が求めたサイズのペアンを正確に手渡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "滅菌処理を終えたばかりのペアンが、トレイの上に整然と並べられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "フオルス橋の技師等は、この新しい材料を使はなかつたら、海の入江を遮つて橋弧を積み重ねるのにシクロペアンの技術しか考へることが出來なかつたらう。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィチ・クロポトキン　Pyotr Alkseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォルス橋の技師等は、この新しい材料を使わなかったら、海の入江を遮って橋弧を積み重ねるのにシクロペアンの技術しか考えることができなかったろう。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィッチ・クロポトキン　Pyotr Alekseevich Kropotkin",
