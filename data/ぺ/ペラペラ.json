  {
    "uuid": "a9a871a9-8fca-5884-ad2a-f94d073c14e4",
    "entry": "ぺらぺら",
    "reading": {
      "primary": "ぺらぺら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "へんに紙屑がぺらぺらしてかなしい日光の射してるところへ餓鬼共のヒネびた聲がするではないか。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天幕が霧の中に、小さくぼんやり見える、四ツ柱に、油紙がぺらぺらとして、田舎の卵塔場のようだ、今まで、あそこに寝ていたのか知ら……この霧と雨の中を、たった紙一枚の下に……火光がパッとさす、霧の水球が、美しい紫陽花色に輝いたかとおもうと、消えた。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "早口の江戸っ子弁でぺらぺら話しかけられてはたまらない。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭がわるくてブルジヨア臭いぺらぺらしたふつうのモダンボーイだと思つてゐるんだ。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつから、こんな、　　ぺらぺら赤い火になったろう。",
              "citation": {
                "source": "タネリはたしかにいちにち噛んでいたようだった",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜんたい、いつから、　　こんなにぺらぺらしだしたのだろう。",
              "citation": {
                "source": "タネリはたしかにいちにち噛んでいたようだった",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一文の金にもならんことを、そうぺらぺら喋んな、だいたいお前は昔からわいの言うこというたら、いちいち逆らうけど、ほんまに難儀な男やぜ。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽子が茶を運んで行くと、章三は陽子には眼もくれず、ひとりぺらぺらと喋っていた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "長髪の男はぺらぺらと喋り続けながら、神経質に膝をふるわせているのだった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……野郎若輩ながら、軒下三寸を借りうけましての仁義失礼さんにござんす……」そうして、男は聴馴れぬ調子でぺらぺら喋り立てたが、再び電気蓄音機が鳴り出したので、はっきり聴きとれなかった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三は部屋の真中にある黒い卓の片隅で、ぺらぺらと原稿紙をめくって行った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　葉子はそう言って、原稿紙｜挟みから十枚余りの原稿を出して、ぺらぺらと繰っていたが、疲れきった体に、感傷的な哀憐の刺戟を感じたものらしく、まだ全く眠りからさめきらない庸三の体を揺り動かした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "またなんと恐ろしくしゃべる、ちょっぴり髭の赤いぺらぺらの舌であろう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺらぺらとまくった拍子に、そのいんちきばくち必勝秘伝書の中から、ひらひらと下に舞い落ちただれかの書面らしい紙片がありました。",
