          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "待ち合わせの時間まで、本屋で雑誌を「ペラペラ」と立ち読みして過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は写真集を「ペラペラ」とめくり、お気に入りの一枚を見つけると手を止めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "授業中、退屈した生徒が教科書の端を「ペラペラ」と弾いてアニメーションを作っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 4,
        "gloss": "thin (paper, cloth, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
