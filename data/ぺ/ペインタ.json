          "literary": [
            {
              "text": "「ゑかき」も變だし「アーテイスト」「ペインター」もいけない。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "種々な経営にいそがしいあの吉本さんにも、こうした「モダアン・ペインタアス」なぞを繙こうとした静かな時があったであろうかと想像して見た。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ペインタ君、すぐ通してくれ、あの休暇の私服は着られない。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "運が悪い」　ペインタ秘書がお辞儀して下がった。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ず欲しい情報が得られます」　ムーアがベルを鳴らすと、愚直なペインタ秘書が現れた。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ちに出発だ、ペインタ君」　ペインタがお辞儀して出発した。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャレですら、詐欺師のカモになったと気づくまい」　ムーアがベルを鳴らすと、ペインタ秘書がはいって来た。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            }
          ]
