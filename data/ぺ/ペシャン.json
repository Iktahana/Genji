        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "きょうは、九度五分にあがったの」　にわかに私は、ぺしゃんこにしょげた。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "人からあなどりを受け、ぺしゃんこに踏みにじられ、ほうり出されたときには、書物を売り、きまって三円なにがしのお金をつくり、浅草の人ごみのなかへまじり込む。",
              "citation": {
                "source": "狂言の神",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小田に挑まれて、大阪劇場地下室で将棋をさし、花田八段的攻撃と称する小田に翻弄されて、ぺしゃんこになった。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "着のみ、着のままで、しゃんと結ばると袋はぺしゃんこ。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを袖で抱いて、さ、晩のご飯を近所のちもとへ、と立たれたのには、懐中もぺしゃんこです。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし、交通遮断か何かで時刻に遅れることがあれば、爺の生活は今度こそぺしゃんこだった。",
              "citation": {
                "source": "或る嬰児殺しの動機",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんまり耳くそがたまっとるで、ちょっとそうじしてやらァ」といって、久助君はまた草の先で、兵太郎君の頭にぺしゃんとはりついた耳をくすぐる。",
              "citation": {
                "source": "久助君の話",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は窓硝子に頬も、額も、鼻もぺしゃんこに押しつけて、外ばかりを見ていた。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "折角の命がけが、ぺしゃんこだあ」「命懸け？",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "この四、五日ほとんど商いという商いがなく、従って食事をとるお金もなくなっていたので、私はもう空腹でぺしゃんこになっていた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　与助がそこまで言いかけた刹那、あの、日本橋詰の高札場から、千浪と白覆面の後を尾けて行った由公――承知の由公が、礫みたいに走り込んで来たかと思うと、そこの縁さきにぺしゃんと尻餅、馬鹿っ声を張り揚げたものだ。",
              "citation": {
                "source": "煩悩秘文書",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺしゃんこに疲れ果ててしまって、水がやけに飲みたかった。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺしゃんこに疲れ果てゝしまって、水がやけに飲みたかった。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "みじめな者は私一人じゃないか、私はぺしゃんこにくず折れた気持ちで、片づけて行くたい子さんの白い手を見ていた。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で知ったところに依ると、この地域では大概の家がぺしゃんこに倒壊したらしいのに、この家は二階も墜ちず床もしっかりしていた。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺしゃんこになった建物の蔭からふと、「おじさん」と喚く声がする。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは爪先で歩いて窓にしのび寄って下を見ますと、西村はぺしゃんこになって倒れて死んでいました。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の六（終局）",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、ぺしゃんとあなたの前に座りたい。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、まあ……赤土の猫は、むざんにも、何度かに踏みにじられて、ぺしゃんこなひとかたまりの泥となり、金貨と銀貨とが、その中で光ってるだけでした。",
              "citation": {
                "source": "金の目銀の目",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺしゃんこの下駄をつっかけて、外に出た。",
              "citation": {
                "source": "祭りの夜",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもすりへったぺしゃんこの下駄で、それも片方がよけいへってるちんばだ。",
              "citation": {
                "source": "花ふぶき",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その力で工場も家もぺしゃんこになったものさ。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "『こんな風にどんとやると、その竜の百の頭の一つくらいは、ぺしゃんこになると思いませんか？",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "その巨人にとっての空は、ぺしゃんこにされてしまいそうになって苦しんでいる人達にとっての地上の苦労とちょうど同じでした。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "……其時、手で、今してる様にさわって見たら、驚いたことに、おれのからだは、著こんだ著物の下で、※のように、ぺしゃんこになって居た――。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は古ぼけたぺしゃんこになった枕に顔を埋めて、じっと考えた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一――いっさいの原因たるあのごうまんな乳くさい青二才を、ぺしゃんこにやっつけてやらねばならぬ。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、その時こう考えるが早いか、わたしの心中には猛烈な毒念が込みあげて来て、もしリーザがふと偶然にわたしの傍にい合わせたら、あの『いまいましい』あまをぺしゃんこにやっつけて、思うさま恥をかかせ、唾を吐きかけ、ぶん撲ったあげく、追っ払ってしまったろうと思われるほどだった！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "或晩このトラが、炬燵へ這って来て如何にも元気がない、やっと炬燵の上へ這い上ったところを見るとぺしゃんこになって、一枚と云いたいほど平べったくなってしまって居る。",
              "citation": {
                "source": "百姓弥之助の話",
                "author": "第一冊　植民地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の勇気と決意はしっかりしていますが、希望や元気がぺしゃんこになる時も、ないとは言えません。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
