        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "伯爵の愛妹、ペヌロオプ夫人は、かつてサア・フィリップ・シドニイが空しく懸想したステラだった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペヌロオプ夫人は幸福ではなかった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなグルウプ――エセックス、エセックス夫人、マウントジョイ、そしてペヌロオプ・リッチ夫人――それだけの小さなグルウプは、欲望と愛情のもっとも深い感情でかためられた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛人ペヌロオプだって、彼のこの運命を邪魔することは許されぬ。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントニイ・ベエコンに死なれて後の彼は、ただ母と、妹のペヌロオプ・リッチとサア・クリストファ・ブラウントの呶声と、ヘンリイ・カッフの遠慮会釈のない助言に、耳を傾けるほかはなかった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "エセックス邸に兄と同時に監禁されていたペヌロオプ・リッチは釈放された。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
