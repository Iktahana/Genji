    "definitions": [
      {
        "index": 1,
        "gloss": "shepherd's purse (Capsella bursa-pastoris)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "道端にぺんぺん草が生えているのを見つけて、春の訪れを感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "子供の頃は、ぺんぺん草を鳴らして遊ぶのが好きだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "庭の手入れを怠っていたら、あちこちからぺんぺん草が顔を出してきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それ故に三味線草（ぺんぺん草）の可憐な花が、この場合の詩歌によく合うのである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤吉はあべこべに云いまくられて、そのくやしまぎれに、お前が禁断のむらさき鯉を売り込んで、荒っぽい銭儲けをしているということを俺が一と言しゃべったら、ここの家にぺんぺん草が生えるだろうとか何とか嚇し文句をならべて立ち去っても、宇三郎はおどろかない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "むらさき鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鷹の白羽の矢が次郎兵衛の家の屋根を素通りしてそのおむかいの習字のお師匠の詫住いしている家の屋根のぺんぺん草をかきわけてぐさとつきささったのである。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ道のほとりには、ぺんぺん草の小さな三角の実が見られ、うすぐもりの空には、季節おくれの雲雀が囀つてゐた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてまた蹈み入りがたき雑艸の最も淫れしあるものは肥満りたる、頸輪をはづす主婦の腋臭の如く蒸し暑く、悲しき茎のひと花のぺんぺん草に縋りしは、薬瓶もちて休息める雑種児の公園の眼をおもはしむ。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "その追分には馬頭観音が立っているんですがね、いつか行って見た時には、まだ早春で枯草の中にぺんぺん草の花が咲いていましたよ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "土手を横に切って、あれから埋地にかかった橋の、欄干が真中で切れて水へ折れ込んでいようという、ぺんぺん草の生えてる袂へ寄って、渡ろうとする時分にゃあ私が居る間近になったから見えました。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまけに、ぺんぺん草がはえやがって、どこか気に入らねえお寺だね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "３酒袋を干すとてぺんぺん草をちらした。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "暖かうなりやぺんぺん草が生えるこつてござんせう。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしの田圃をわしがどうしておかうと勝手ぢや、ぺんぺん草を生やしておかうと勝手ぢや、餘計な世話は燒くな、と、そのくらゐのことは云はれると思つた。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうしてまた二年か三年で田圃にぺんぺん草を生やすことになる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺんぺん草を活けて楽しむ、春蘭の蕾もふくらんでくる。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日ッからこの宮志多亭はな、屋根へぺんぺん草を生やさなけりゃならねえや、このはっつけ野郎」「すみませんごめん下さい」　もういっぺんまたオドオドと詫びた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "若松屋が倒れるか、磯五の屋根にぺんぺん草がはえるか――これは、われながら大芝居になりそうである。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お千代」「私に構わず、その綱を斬っておしまいよ、私ゃア磔柱の上から、福屋の屋根にぺんぺん草の生えるのを見てやりたい」　なんという気の強い女でしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "振袖源太",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぺんぺん草や、蚊帳つり草や、そこにはえてる草の名をおぼえるだけでも大変な仕事である。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "この屋敷にぺんぺん草を生やしてくんど！",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "見よ、見よ、ここ三代が間に汝の屋敷にぺんぺん草を生やしてくれん！",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、陽気が暖かになると、折々今日のような風に、海水帽にもんぺを穿いて、芝の間に繁殖するぺんぺん草や車前を取ったり、芝刈器で、ジョキジョキ芝を刈ったりした。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンペン草の返礼にあれを喫べさせられては、と土耳舌帽氏も恐れ入った。",
              "citation": {
                "source": "野道",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、みんなは、われもわれもと、猫柳をはじめ、桃や、松や、たんぽぽや、れんげそうや、なかにはペンペン草までとって来て鐘にささげた。",
              "citation": {
                "source": "ごんごろ鐘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "太陽の光線は存外公平なもので屋根にペンペン草の目標のある陋屋でも、金田君の客間のごとく陽気に暖かそうであるが、気の毒な事には毛布だけが春らしくない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ鈴木君がペンペン草を目的に苦沙弥先生の臥竜窟を尋ねあてたと見える。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ここいらに違いない……と気が付いて見廻わすとツイ鼻の先に、軒先一面にペンペン草を生やした陰気な空屋があって、閉て切った表の戸口に「売貸家」と書いた新聞紙がベタベタと貼ってある。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから血に染まった匕首と両手を、向家のペンペン草を生やした屋根の上の青空の方向に高く挙げて力一パイ叫んだ。",
              "citation": {
                "source": "骸骨の黒穂",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "星明りに透かしてみると墓原らしい処は一面の竹籔となって、数百年の大｜銀杏が真黒い巨人のように切れ切れの天の河を押し上げ、本堂の屋根に生えたペンペン草、紫苑のたぐいが、下から這い上った蔦や、葛蔓とからみ合って、夜目にもアリアリと森のように茂り重なっていた。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると又それに連れて図書館の外側の手入れが不充分になったらしく、スレート屋根の上にタンポポだのペンペン草だのがチラチラと生え始めた。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして一日、仕事を休まして貰って、まだ降っている嵐模様の雨越しに、向家の屋根のペンペン草だの、ずっと向うに並んで揺れているポプラの並木だの、下り列車から吹き散って行く黒い烟だのを見ていると、それがみんな妾の運命みたいに思われて来て、考えても考えても考え切れない、淋しい淋しい気持になって来るの。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モトは学校の作法教室だったそうですが、今では壁も瓦も落ちて、ペンペン草が一パイに生えて、柱も階段も白蟻に喰われて、畳が落し穴みたいにブクブクになっております。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
