          "literary": [
            {
              "text": "「ラップ」に加盟しないプロレタリア作家と「同伴者」左翼とがあつまっている「ペレワール」という団体がある。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "純粋文学制作において、作者の政治的認識は問題にする必要ないという考えが、「ペレワール」の理論的柱となっている。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラップ」のキルションが、一九三〇年の党大会における報告演説の中で、「ペレワール」のこの傾向に触れた。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
