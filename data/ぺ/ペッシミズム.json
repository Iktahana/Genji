          "literary": [
            {
              "text": "ペッシミズムというものは私にはそれ自身矛盾してるように思われ出した。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらはに不満を表はして、私が常々肉親に対して誠実な答へと信頼が欠けてゐると難じたこともあつたのだが、陰へまはると、たとへば叔父や友人に向つて、うはべの冷酷と微笑を忘れた堅い顔はもはや性格化されたペッシミズムの結び目に当る宿命の瘤で、裹まれた心の温かさは人にも稀れであるといふ。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて改めて、第一の人物ほどの人物が地上に二人とあるものかといふ、凡そ論外なペッシミズムの虜になる。",
              "citation": {
                "source": "金談にからまる詩的要素の神秘性に就て",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
