          "literary": [
            {
              "text": "乳房をぺろんと前へ垂らして顔が歪みかゝり桃色の口が開きかゝるところまで見ているのが好きです。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　木曾は、赤い舌をぺろんと出して、風間をからかった。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "何が　あっても　起きない　ごようす　――　ベッドの上で　ロープが　ぺろんぺろん　しているのに。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "左慈は、ぺろんと平げて、まだ物足らない顔していた。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
