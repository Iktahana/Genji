        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たったいま迄、あの御立派な先生の前で、ぺこぺこしていらした癖に、もうすぐ、そんな陰口をたたくなんて、あなたは、気違いです。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」思わずぺこりと頭をさげた。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご近所の叔母さんたちが、おお綺麗と言ってほめると、ここの主人が必ずぬっと部屋から出て来て、叔母さんたちに、だらし無くぺこぺこお辞儀するので、私は、とても恥ずかしかったわ。",
              "citation": {
                "source": "失敗園",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世に暮して行くからには、どうしても誰かに、ぺこぺこ頭を下げなければいけないのだし、そうして歩一歩、苦労して人を抑えてゆくより他に仕様がないのだ。",
              "citation": {
                "source": "駈込み訴え",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」私は思わず、ぺこりとお辞儀をして、「ここで失礼して、着換えさせていただきます。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ああ、弱った弱った、暑いし、腹はぺこぺこになりやがるし。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "両人は固くなって、ぺこ／＼頭を下げた。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とぺこぺこお辞儀をする。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」二人は頭をぺこぺこさげました。",
              "citation": {
                "source": "鳥箱先生とフウねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "女が坐って盆をすすめると客のような男がぺこぺこ頭を下げているのが見えた。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体｜彼奴等に頭を下げぺこぺこと頼み廻るなんちゅうことは富岡の塾の名汚しだぞ。",
              "citation": {
                "source": "富岡先生",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "永々厄介な小僧をお世話様でしたのうと兄が挨拶したあと、ぺこんと頭を下げ、「ほんの心じゃけ、受けてつかわさい」　と、白い紙包を差し出して、こそこそ出て行った。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "男はぺこぺこ頭を下げ、立ち去った。",
              "citation": {
                "source": "馬地獄",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、やがて、坐り直すと、ぺこんと頭を下げて、「じゃ、いただきます。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴雄はぺこんと頭を下げて、階段を降りて行こうとすると、「君！",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「…………」「下手くそやぞ、お前らの掏り方は……」「今夜はじめてだす」　次郎は蚊の鳴くような声を出して、「――かんにんしとくなはれ、大将」　と、ぺこんと頭を下げた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "永々厄介な小僧をお世話さまでしたと兄の挨拶の後で、ぺこんと頭をさげ、之はほんの心だけです、と白い紙包を差出して、家を出て行った。",
              "citation": {
                "source": "雨",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "良えのし」といい、まるで伝三郎の妻に謝っているかの様にぺこりと頭を下げた。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も、伝三郎の妻は何ということもなしにぺこりと頭を下げねばならなかった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "永々厄介な小僧を世話でしたのうと兄が挨拶したあと、ぺこんと頭を下げ、「ほんの心じゃけ、受けてつかわさい」と、白い紙包を差し出して、何ごともなかった顔で、こそこそ出て行った。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（良い服装の堂々たる押し出しの男から先輩だと言われたのなら、たぶんぺこぺこして盞を貰いに行っているところだろう）「言えないだろう？",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はいわかりました、悪い癖をすっかり毀すようにやります、大丈夫きっとやります」　そして、ぺこっとおじぎをした。",
              "citation": {
                "source": "みずぐるま",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はおなかがペコペコなのだが、喫煙室のソーファに沈んで煙草を吹かしてゐるより他はなかつた。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまり騒いだので、いま食べたばかりなのに、もうペコになってしまった。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は真面目に、ペコペコ頭を下げ、靴を磨くことが、阿呆らしくなった。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「さんざん、工場主や、地主に搾られて居りながら、それでもなお、ペコ／＼頭をさげて、尾を振らずにゃいられねえ奴隷だよ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社員に、おべっかを使うように、ペコペコ頭を下げた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｋ鉱山でもＪ鉱山でも、卑屈にペコ／＼頭を下げることをやめて、坑夫は、タガネと槌を鉱山主に向って振りあげた。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "課長のあとから阿見が、ペコ／＼ついて来た。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まアザッとこんな苦しいわけで……けれどつかい込みの一件は、ごく内密にお願いします」と言って立ち上がり、石井翁が何も言い得ぬうちに、河田翁は辞儀をペコペコして去ってしまった。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
