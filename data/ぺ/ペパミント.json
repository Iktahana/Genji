        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "さうして重い緑色のペパミントと濃い珈琲とを併せ飲んだ。",
              "citation": {
                "source": "市街を散歩する人の心持",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれに反して私が辿って行く岨道は、冷たいペパミント色の薄暗に蔽われて、木の下の道なぞは月夜のように暗かった。",
              "citation": {
                "source": "眼を開く",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君もまた色青きペパミントの酒に、かなしみの酒に、いひしらぬ慰藉のしらべを、今日の日のわがごとも、あはれ、友よ、思ひ知り泣きしことのありや。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ五百元でも、こっちのペパミントがいい。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "生返事をしただけで、彼はなおも飾窓の青いペパミントの値段札に全身の注意力を集めている。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜひともこの醤を哀れと思召し……その代り、お礼の方はうんときばり、博士のお好みのものなれば、ウィスキーであろうとペパミントであろうと……」「そうか。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は、几帳面に礼をかえすどころか、いきなり醤の瘠せた肩をどんと叩いて、「おい、ウィスキーにペパミントの約束、あれはまちがいないじゃろうな。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペパミントじゃ」　金博士が、醤に負けないような大きな声を出し、怒った蟷螂のような恰好で、拳固で天をつきあげた。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあのウィスキーにペパミント百四十函は、授業料としては至極やすいものじゃ」「あれだけの夥しい洋酒を捧げても、まだ先生の方が御損をなさいますか」「それはそうじゃ。",
              "citation": {
                "source": "毒瓦斯発明官",
                "author": "――金博士シリーズ・５――",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏国現代式装飾だなと、こう思いながら食堂の内部を、黄蓮とペパミントを飲み乍ら、私は仔細に眺めました。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一層悲しげに見える料理店の桃色の窓枠の間々には、もう新鮮さを失った飾花や、焼きざましのパイの大皿や青いペパミントのくくれた罐などがある。",
              "citation": {
                "source": "小景",
                "author": "――ふるき市街の回想――",
                "note": "青空文庫"
              }
            },
            {
              "text": "志村の大将、その時分は大真面目で、青木堂へ行っちゃペパミントの小さな罎を買って来て、「甘いから飲んでごらん。",
              "citation": {
                "source": "片恋",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、僕は志村のペパミントの話をして、「これは私の親友に臂を食わせた女です。",
              "citation": {
                "source": "片恋",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の直ぐ下の潮はペパミントの酒になる。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男の注いだペパミント男の手から飲まうもの。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この昼の若葉を透す日の色はほんに酒ならペパミント、黄金と緑を振り注ぎ、広く障子を開けたれば、子供のやうな微風が衣桁に掛けた友染の長い襦袢に戯れる。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし一方にペパミント、キユラソオ、ベルモツト、ブランデイ、トマトソオスなどを飾り立てたバアもあります。",
              "citation": {
                "source": "佐渡が島から",
                "author": "江南文三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニューヨークのペパミント・ラウンジというディスコテークが、その風俗的な中心だった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時の約束で、東宝へ、樋口と逢ひ、ペパミントソーダを飲む、お互に宿酔らしいので。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
