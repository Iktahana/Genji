        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「でボースンやカムネ（カーペンター――大工――の訛り）はどうするんだね」波田はボースンや大工が裏切り者になりはしないかを恐れた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「セント・ジョンズ・ウッド、サーペンタイン並木道のブライオニ荘だ。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "とまぁ、サーペンタイン厩舎の男どもは口を揃えている。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "サーペンタイン厩舎より十数回と送っているから、何もかも知っていた。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "予定の時刻より十分早く、サーペンタイン並木道に到着した。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と王はふさぎ込んで黙ってしまい、サーペンタイン並木道に着くまで口を開かなかった。",
              "citation": {
                "source": "ボヘミアの醜聞",
                "author": "A SCANDAL IN BOHEMIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田のペンタゴンか。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペンタゴンなんか相手にしていたんじゃなあ……柿江なんぞも、田舎新聞にひとりよがりな投書ぐらい載せてもらって得意になっていないで、ちっと眼を高所大所に向けてみろ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョン・カーペンターやジョン・ベルーシやエルトン・ジョンはおろか、たとえジョン・フォードでも、たんにジョンなどと呼ぶわけがない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がカーペンターの Principles of Mental physiology で無意識脳作用といふ事を初めて学び、千里眼だの、メスマリズムだの、スピリチュアリズムだの、読心術だの、卓子転だの、卓子談だのを知つたのは明治十四五年の頃であつたと思ふ。",
              "citation": {
                "source": "斎藤緑雨と内田不知菴",
                "author": "坪内逍遙",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーペンターの解釈では、卓子転は期待注意 expectant attention の作用だとなつてゐた。",
              "citation": {
                "source": "斎藤緑雨と内田不知菴",
                "author": "坪内逍遙",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、帰国が近づいた頃、うす汚い、真鍮のロケットをぼくにくれた、カアペンタアという八つ位のお嬢さんも、ぼくと仲が善く、再々、彼女の宅にも引張って行かれました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一部で、ファウストの書斎に魔除のペンタグランマが画いてある場所は、シュウェルレである。",
              "citation": {
                "source": "不苦心談",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはシヤルパンチエーといふ名で、結構な名前だが、このシヤルパンチエーは英語でいふと、カアペンタア、言霊の幸はふ日本語では、「大工」といつて、朝から晩から金鎚を叩いて暮してゐる、紺の法被に鉢巻をした男の事である。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタリア人ジォヴァンニ・バッチスタ・バシレの『イル・ペンタメロネ』の四巻一譚に、ミネカニエロ翁雄鶏を飼う。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "先月あたり『早稲田文学』に出たカアペンタアの『感想』を読んで見たが、あれなどにも、流石は聡明な思想家だと思はれるやうな生滅の感想が多く書いてあつた。",
              "citation": {
                "source": "生滅の心理",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "……紫の間と呼ばれている部屋には、「ペンタビルギオン」という、上に塔の五つ並んでいる風変りの戸棚の中に、皇帝の衣裳が蔵ってあったが、此の部屋から宦官が皇帝の祭服を運んで来た。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田英学塾を卒業してのち、社会問題の研究に進んでいた彼女は、当時まだ山川均との結婚前で、『番紅花』にカアペンタアの翻訳などをのせたりもしている。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも同時にあなたはカーペンターを説き、ホイットマンを語り、モンテーヌを紹介しました。",
              "citation": {
                "source": "悪魔の弟子",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――でも僕は歸りますよ……」　サスペンタアを肩へ引つかけて立ちあがると、くみ子は恨めしさうな表情で周次を眺めながら、「だつて、色々お話があるんですけどねえ……」　と、泣きさうな聲で云ふのだつた。",
              "citation": {
                "source": "多摩川",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーペンタア My days & dreams 文章の簡明なのに、驚く。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "五月十九日（金曜）曇　人間の理想が、いかほど、時間を超えて共通なものであるのか、と云うことを、カーペンターの、My days & dreams をよみ、ダンテをよみ思う。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、フランシス上人が、帰つて来ると共に、神聖なペンタグラマの威力によつて、とうとう、その土地から、逐払はれた。",
              "citation": {
                "source": "煙草と悪魔",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の三一を否定せる三世紀の異端者（アフリカのペンタポリスに生る）〔アルリオ〕アリウス。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一七節　今、カーペンター氏の『心理書』中に挙ぐるところの一例を引きてこれを示すに、ジップシンと称するもの、その友人一名とともにテーブルに向かい、「当代の女王は王位に昇りて以来、幾年を経過せしや」と問いたるに、テーブルその床をうちて、「十六年なり」と答えたり。",
              "citation": {
                "source": "妖怪玄談",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの敷居にあるペンタグランマの印ですな。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学は無知の法則だ、と英国の百姓仲間のカアペンタアは言つたが、今の所謂学問なぞすればするほど無知になる。",
              "citation": {
                "source": "百姓日記",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時わたしの出會つた思想家エドワード・カアペンターは、不思議にも、わたしの從來の一切の疑問に全的解決を與へてくれました。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
