        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その男は悪の道へ走り、先日までペントンヴィルで服役していました。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペントランド、バラヘッド、カークウォール、ラス岬、嗚呼！",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語でサーペントもスネイクも、蛇とは誰も知り居るが、時にサーペントおよびスネイクと書いた文に遭う。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "リッペントロップ外相とゲーリング元大ドイツ元帥のことはすこしも出て来ない。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "リッペントロップが目下スペインに行っているそうだ。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "リッペントロップのスペイン訪問はデマであるよし。",
              "citation": {
                "source": "暗黒日記",
                "author": "清澤洌",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、エヂンバラの新しい町の美しさや整然たるところや、またその浪漫的な城、世界でいちばん楽しいその近郊、アーサー王の座席、聖バーナードの泉、ペントランド丘陵などが、気分を変えるのにやくだったので、クレルヴァルもすっかり愉快になって感歎した。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はペントンビル（ロンドン北部）に行き次の日９月２日の夕方にコレラに罹り翌日の夕方に死亡した。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さア、もう大丈夫です、屋上へ行って見ましょう」　幸子は懐中電灯を照らしながら身軽に階段を踏んで、二階へ三階へ、そしてペント・ハウスから屋上庭園へ飛び出します。",
              "citation": {
                "source": "九つの鍵",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにはペント・ハウスと、そして敷き詰めた砂利のほかには何んにもありません。",
              "citation": {
                "source": "九つの鍵",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをうしろに聴いて、狩屋三郎と植野誠一は、ビルディングの地下室から恐ろしく念入りに調べて、頂上のペント・ハウスから、小砂利を敷いた屋上まで登りました。",
              "citation": {
                "source": "九つの鍵",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女が来たら部屋はこのぼくに世話させてくれ、と友人のエドワードが言い張り、このコンドミニアムのペントハウスに部屋をとってくれた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の気配のない静かな建物のなかに入り、エレヴェーターでぼくたちはペントハウスに上がった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのペントハウスの部屋は、簡単に言ってしまうなら、３ベッドルームだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "持合せのペントード式のは東京しか聽けないので、米國製のスパートンといふ小型のポータブルを備へつけた。",
              "citation": {
                "source": "ラヂオ閑話",
                "author": "成澤玲川",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に加えられたペントース尿症とともにギャロッドの tetrad（４つ組）と呼ばれる。",
              "citation": {
                "source": "アルカプトン尿の発現",
                "author": "THE INCIDENCE OF ALKAPTONURIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際のところ今日までに理論的に示すことができるこの分類のものは白皮症、アルカプトン尿症、シスチン尿症およびペントース尿症であり、これらに関してもこの分類に入れる理由にすべて同じ説得力があるのではない。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近になり見つかり最も知られていないペントース尿症が生まれつきに起きていることを示す直接の事実はまだ得られておらず、これを加えるには他の理由によって正当化しなければならない。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "何年間も変化しないで続くことは確かであるが、これまでに観察された最年少のペントース尿者は15歳の男児であった。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "26例のペントース尿者のうちで19例が男性で７例が女性であった。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペントース尿症の害が無いことを示す事実は増えてきていて、分子中に５個の炭素原子のある糖の排泄は糖尿（グルコース尿）のような悪い意味を持たない。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカプトン尿症およびペントース尿症が下等の動物で起きるかどうかは知られていない。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペントース尿症が兄弟、姉妹に起きる事実が多く得られているが、両親から子供への伝達の例は記録されていない。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペントース尿症は1892年に発見されキシリトールデヒドロゲナーゼ欠損症である。",
              "citation": {
                "source": "先天性代謝異常",
                "author": "INBORN ERRORS OF METABOLISM (1909)",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
