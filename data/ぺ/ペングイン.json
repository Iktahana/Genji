          "literary": [
            {
              "text": "「エピキユウルの園」の思想家、ドレフイイユ事件のチヤンピオン、「ペングインの島」の作家だつた彼もここでは面目を新たにしてゐる。",
              "citation": {
                "source": "続文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの男は唯のペングイン鳥になり、氷山の間を歩いてゐた。",
              "citation": {
                "source": "貝殼",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車や自動車やペングイン鳥やトンカツや玩弄屋やカツフエ等は、相渝らずごつちやになつて町ぢゆうに入亂れてゐるのである。",
              "citation": {
                "source": "星より來れる者",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
