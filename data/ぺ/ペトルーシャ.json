        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ただペトルーシャ・カルガーノフだけが、金入れから十カペイカ銀貨を一つ取り出したが、どうしたわけか妙にあわてて、ひどくどぎまぎしながら、大急ぎで一人の女乞食の手へそれを押しこんで、『皆で同じに分けるんだよ』と早口に言った。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　ねえ、ペトルーシャ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "トリゴーリン　百二十一ページと……（退場）アルカージナ　ね、ほんとにペトルーシャ、ここにじっとしていらっしゃいよ……ソーリン　お前たちが発って行くと、あとにぽつねんとしてるのは辛くてな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（仰天して）ペトルーシャ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（懸命に彼をささえながら）ペトルーシャ、しっかりして……（叫ぶ）誰か来て。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（ソーリンをふり返って）ペトルーシャ、あなた退屈？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ソーリンをおこす）ペトルーシャ、お夜食ですよ！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
