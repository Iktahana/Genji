          "literary": [
            {
              "text": "あの多感なマリ・スチューアートは、スコットランドの川でとれたいわゆるペルル・ドー・ドゥスでなければ身につけなかったけれど、それがべつに幸運を運んで来てくれもしなかったですわい。",
              "citation": {
                "source": "真珠の首飾り",
                "author": "ZHEMCHUZHNOE OZHERELJE",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおファンティーヌよ、汝はマルグリット（菊）もしくはペルル（真珠）の名にふさわしい娘で、最も光輝美しい女である。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "銃殺された石工の死体が、ペルル街に横たわっていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
