          "standard": [],
          "literary": [
            {
              "text": "きまりわるいのかしらと思って、私は自分からロゼエの名などあげて、あなたは？",
              "citation": {
                "source": "女の歴史",
                "author": "――そこにある判断と責任の姿――",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソワアズ・ロゼエが、やはりそうです。",
              "citation": {
                "source": "あるニュウ・フェイスへの手紙",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンの楽壇におけるその年配と魅力と芸達者とを総計して、私はいつでも、女優のフランソア・ロゼエを思い出してならない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロゼエのように老巧で、ロゼエのように仇っぽくて、そしてロゼエのように渋い。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンがロゼエならばタリアフェロはアンナ・ベラでもあろうか。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
