        "examples": {
          "standard": [
            {
              "text": "第一次世界大戦後の混乱期を生きた作家たちは、ロストジェネレーションと呼ばれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "ヘミングウェイやフィッツジェラルドは、ロストジェネレーションを代表する作家だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "日本では、バブル崩壊後の就職氷河期世代を指してロストジェネレーションと呼ぶことが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "戰爭から最も激甚な打撃を受けた世代、いはゆるロスト・ジェネレーションである。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦争とそのあとの資本主義は、ロスト・ジェネレーションという、絶望に立ちむかう思想を生んでいた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
