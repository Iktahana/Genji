  {
    "uuid": "d131ad35-cd61-58fa-8f51-f8e8ec3a9ead",
    "entry": "ロザ",
    "reading": {
      "primary": "ろざ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
