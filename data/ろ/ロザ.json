[
  {
    "uuid": "96d3e355-c665-57ce-9f32-0b88908e94a0",
    "entry": "露座",
    "reading": {
      "primary": "ろざ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
