        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロマンテイツクなる秀才なりしが、岡山の高等学校へはひりし後、腎臓結核に罹りて死せり。",
              "citation": {
                "source": "学校友だち",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "忍従　忍従はロマンテイツクな卑屈である。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊つちやん育ちで人の好い幾太郎は、完全に梅吉の傀儡になつて、父の激怒に觸れたり、座敷牢に入れられたり、其處を脱出して女に逢つたり、それを此上もなくロマンテイツクな遊戯と思ひ込んで居たのでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "梅吉殺し",
                "note": "青空文庫"
              }
            },
            {
              "text": "わがままでなまけもの、それも骨の髄からさう出来上つてしまつてゐるといふ一種のロマンテイツク性格者である。",
              "citation": {
                "source": "尊重すべき困つた代物",
                "author": "――太宰治に就て――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私も時代小説の上では、いままではよくロマンテイツクな傳記的なものを書き、讀者の方もそのやうなものとみて來た。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
