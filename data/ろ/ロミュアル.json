          "literary": [
            {
              "text": "「ロミュアルよ、わしの友達よ、何か恐しい事がお前の心の中に起つてゐるのではないか。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも長い吐息をついて、組んでゐた腕をほどくと、溢るゝばかりの悦びを顔に現して、わしの頸を抱きながら「あゝ貴方ね、ロミュアル。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロミュアル、左様なら。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "神がお前を御守り下さればよいがの、ロミュアル。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロミュアル、私が貴方の事を忘れてしまつたのだと思つたでせう。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "可愛いゝロミュアル、さうして方々探してあるいてゐたのだわ。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、もう遊ぶのは沢山よ、ロミュアル、これから出かけるのよ。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前の情人を見るがよい、ロミュアル卿。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラリモンドの恋人ロミュアル卿も、今は長い間不思議な交際を続けてゐた、憐れな僧侶から離れてしまつたのである。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
