        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あまりの事に、その老兄も彼を責めた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "異聞総録・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ところが余の物は大概集りましたが、老兄も知らるゝ通り私達がこの国に入つて以来、私達は未だ一度も慈雨の恵みを享けてゐないぢやありませんか！",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "老兄の回生は全くわたくしの掌中に帰しました。",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで一粒の烏金丸と共に、老兄の命は再び吾々の手に帰しました。",
              "citation": {
                "source": "毒気",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "是小弟長く浪遊して仕禄を求めず、半生労苦辞せざる所、老兄ハ小弟を愛するもの故、大略を述。",
              "citation": {
                "source": "手紙",
                "author": "慶応二年十一月　溝淵広之丞あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "御別後、老兄の事を京の方に申遣し候よふ存候うち、別に愚存も相生じ、先、其まゝニ仕候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年二月十四日　河田左久馬あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "上許を相初候時ハ、必や老兄が留守でハこまり候事故、私も薩の方へハ申不遣在之候。",
              "citation": {
                "source": "手紙",
                "author": "慶応三年二月十四日　河田左久馬あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月六日龍伊藤九三老兄直柔足下",
              "citation": {
                "source": "手紙",
                "author": "慶応三年四月六日　伊藤助太夫あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "老母老兄といへども、自分が国のため又教法のため一身を棄てゝ赴くことを彼等自身の幸ひであると喜んでくれた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "老兄、君は知っているだろうが、髪の毛はわれわれ中国人の宝であり、かつ敵である。",
              "citation": {
                "source": "頭髪の故事",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "「朶雲拝誦、先以て老兄｜足下御勝常賀し奉候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "一『名家詩録』後編出来いたし候はゞ社中老兄を始め一両輩は編入仕るべくと兼て心懸け置き候間、御近作律絶の中御得意の作四、五十首拝見仕度候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "箇様の御事老兄等風流才子の面前に開口候御事には之無く候へども、国家の御事と思はず一筆之に及び候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "老兄｜忽然ノ御出府、意外驚異｜仕候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "小官モ春来帰心矢ノ如ク、特ニ老兄ノ御出府、猶更ノ事是非帰府早々仕ル可ク候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れば老兄の月旦、上方筋宜しき旨□□□。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "老兄の技倆にて勿論の事に御座候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕も老兄とは同一家。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "老兄以て如何となす。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "）老兄御草稿｜御上木成され度き御思召一盛事に御座候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "老兄以て何如と為す。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十五日夏目金之助　　　　　高浜老兄　　　　　　○明治四十一年二月二十四日（葉書）『朝日』の講演速記は未だ参らず。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いったい、この印籠は、どうして、老兄のお手にあるのでございますか」「それをお質し召されて、お奉行には、如何なされるおつもりか。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
