      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "姫はジエラルドオ・デル・ノツチイの名ある作なるロオト（ソドムに住みしハランの子）とその女兒との圖の前に立てり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなれば我は赤心を棒げて人々に依頼せしに、人々は我をして鹽の柱と化すること彼ロオト（亞伯拉罕の甥）が妻の如くならしめしぞ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とか、時々は「ホントニ、イロオトコダネ。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオトレックが直接浮世絵の影響を受けた、それとはまた異つた意味で、少くとも、あなたは東洋芸術のわかる人だ。",
              "citation": {
                "source": "訳者より著者へ",
                "author": "――「葡萄畑の葡萄作り」――序",
                "note": "青空文庫"
              }
            },
            {
              "text": "こつちは、オスカア・ワイルドの親友でなければ、ロオトレツクの弟子か。",
              "citation": {
                "source": "巴里素描",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "トゥウルウズ・ロオトレックの有名な挿絵二十二葉によつて飾られてゐる。",
              "citation": {
                "source": "「博物誌」の序に代へて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオトレックがやつたと同じやうに動物園にも度々通つたらしい。",
              "citation": {
                "source": "「博物誌」の序に代へて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」嘗て私がこう云った時、「日本では豊国、西洋ではロオトレク。",
              "citation": {
                "source": "金色の死",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオトレクが好きだけあって、彼はチャリネが大好きでした。",
              "citation": {
                "source": "金色の死",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
