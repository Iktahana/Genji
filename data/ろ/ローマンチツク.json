          "literary": [
            {
              "text": "時に彼は年僅に二歳、彼のローマンチツクなる生涯は、既に是に兆せし也。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "米を洗ひ乍ら『僕は実にローマンチツクな人間だ。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ローマンチツク……自由意志……悲哀なのだ――然し――僕は何と幸福な目に会つたのだらう。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "こいつは一つローマンチツク風を吹かしてやれと栄一は考へたので、『何だえ。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄一は『ローマンチツクな真似をした、他人の為めに着物を脱ぐと云ふ聖人の真似をした。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
