        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "焼津　八月十七日パパカラ可愛イ子ニ、ソレカラ皆ノ人ニヨロシク。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はいつも手紙の終りに『オババサマニヨロシク』とか『オババサマニ可愛イ言葉』とか書いている。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、二度も罹災して、行くところが無くなり、ヨロシクタノムと電報を発し、のこのこ生家に乗り込んだ。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、二度も罹災して二人の幼児をかかえ、もうどこにも行くところが無くなったので、まあ、当ってくだけろという気持で、ヨロシクタノムという電報を発し、七月の末に甲府を立った。",
              "citation": {
                "source": "庭",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナニ　ヤサシイ　モノガ　花タチノ　オソロシク　オモツタ　ウマダツタノデシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨロシク一千年ノ間シンボウ強ク今日ノ日ヲ待ツテイタカタカナヲ登用スベキ時期デアロウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ケッコウシマス、テツヅキヨロシクタノム。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ケッコンシマス、テツヅキヨロシクタノム――。",
              "citation": {
                "source": "宇宙爆撃",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでにＡに、カエレヌ、ヨロシク、アトフミと電報を出して貰う。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "林町から、ヨロコビニタエズ　ヨロシクネガウ　と電報が来た由。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今年ノウチニワタシハ、コタンヘカヘリマスガ、マタ、コンド、アガリマスカラ、ドウカ、ヨロシクネガヒマス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "留守中ノ事ヨロシク頼ム。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日、嶺太郎から、ヒロシクンニアツタリエコサンノユキサキワカラヌ　といふ電報が届いた。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシハ来月参リマス、経助ヲヨロシクオ頼ミ申シマスト、颯子ハ云ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "短時間内ニ血壓ノ変動ガカヨウニ激シイノハヨロシクナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "使ヲ派シテ、コレヲ捕ヘ、ヨロシク朝ノ法廷ニ於テ、指弾、問責アルベキ也。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨロシク王位ニススメ、魏王ノ位ヲ賜ワランコトヲ。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
