        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――案の条、帰りの崖道で二人の女学生が大いに灯台のロマンテイシズムを論じてゐた。",
              "citation": {
                "source": "或るハイカーの記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "八郎は、物薄い調子で卓子を叩きながら、七郎のロマンテイシズムなるものが、如何にあやふやなものであるか、といふことに就いて、私の女房をとらへて切りに罵倒してゐる最中で、私と亭主が憂愁に富んだ顔を見合せてゐるのも気づかなかつた。",
              "citation": {
                "source": "ゾイラス",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "由来貧富のロマンテイシズムほど文人墨客を捉へたものはない。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "作家　それは子供｜瞞しのロマンテイシズムですよ。",
              "citation": {
                "source": "売文問答",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "約言すればドン・ホアンの生涯は異教の良心を以つてロマンテイシズムの夢を追ふ生涯である。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
