[
  {
    "uuid": "4d17a5cf-10dc-57cc-8703-5c2d6e7438e7",
    "entry": "録音",
    "reading": {
      "primary": "ろくおん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
