        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やがて玄関のベルで起きると、ロンデール医師が入ってきた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "会えてうれしいよ、ロンデール。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "はい、承知しました」　もう教授はロンデール医師と、カーテンの向こう側で夢中になっていた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "小柄なロンデール医師の人影が明らかに興奮して震えている。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さぁて、遂に来たのか」　とロンデール医師が口火を切った。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合、常にテムズ川……」　ロンデール医師も大声で言った。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール医師が接眼レンズをのぞいてびっくり仰天。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "『悪魔は捨て置け』の典型だ」「おそろしいことだ」　とロンデール医師がうめいた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "メイフェアはホワイトチャペル同様、出たとこ勝負だ」「万難を排して給水を断たないと」　とロンデール医師が大声。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "考えて見ろよ、ロンデール」　ロンデール医師が憂鬱そうに答えた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール先生のすぐあとに来られました。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ダネとやらで、やつら大英帝国を破滅させるぞ」　ロンデール医師がうめいた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間以内に帰るだろうから、ロンデール医師は待つことにした。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生宅でロンデール医者と話してるのを小耳にはさみました。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方のロンデール医師は時の人となった。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール医師は希望を与えることができず、ただダービシャイア教授との談話を伝えるのみで、ペスト細菌がテムズ川に充満してると言うばかり。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール医師は何百万という軍隊と攻城砲がロンドンを攻撃するのをはるか遠くに眺め、他人事としか聞いてないようだ。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール医師の診断。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペストの二例はライムハウスの密集地の一角で発生し、ロンデール医師が呼ばれて確認した。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール医師は帰宅途中で立ち止まり、事態をよく考えた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ロンデール先生、よくいらっしゃいました。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "『昨晩遅く、有名な衛生専門家であるロンデール医師はチャリングクロス病院へ呼ばれ、ダービシャイア教授に面会した。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜遅く、当学者がようやく回復し、事の詳細を詳しく尋ね、ロンデール医師にすぐ会った。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンデール医師が驚きかつ喜んだのは、すでに事態が処理されていたことだ。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "話の趣旨を、ダービシャイア教授が同僚のロンデール医師に伝える暇がなかった。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてロンデール医師は質問にこう認めざるを得なかった。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "真実を打ち明けられたロンデール医師はすぐ動いた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "偉大な男がベッドに座り、ロンデール医師の話を謙虚に聞いていた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            },
            {
              "text": "退院したらまず殺菌法方法を全部見せよう」　ロンデール医師が真面目に答えた。",
              "citation": {
                "source": "死の川",
                "author": "THE RIVER OF DEATH",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
