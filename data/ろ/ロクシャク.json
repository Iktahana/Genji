        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "祭りの日、若者たちはきりりと締めた六尺を誇らしげに見せていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "相撲の稽古では、力士は六尺を締めて土俵に上がる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は初めて締める六尺に戸惑いながらも、先輩に教えてもらって何とか身に着けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
