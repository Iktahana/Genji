        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なるほどそうであったか、姉は勿論母までがそういう心になったでは、か弱い望も絶えたも同様。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに手古奈は勿論母も少歳も、父の役目を氣遣ふので、此日は何事も手につかぬ。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論母夫人は、華族でもなければ、藝術家でも無い。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論母も同意ですの。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "お蝶の処へ行つて見たいのも確かには違ひなかつたが、勿論母になど云ふ必要はないのだ。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（勿論母のことは何も知らなかつた頃である。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな風では、子供の健康に悪いのは勿論母が家事どころか身の廻りさえきちんとする事が出来ませんでしょう。",
              "citation": {
                "source": "男女交際より家庭生活へ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつれこそ見えるが、勿論母の様子は、一昨日新たな子を迎えた人ではなかった。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十三人というからには、勿論母親は一人ではなかった。",
              "citation": {
                "source": "人間繁栄",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論母はいつもそれを唱えていたが、母の生きてる間、彼女は神棚に振向きもしなかったのである。",
              "citation": {
                "source": "神棚",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "農民は無論母との姦淫を欲していたわけである。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論母をはじめとして、わたくしには親しかった人たちの、今は一人としてこの世に生残っていようはずはない。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論母をはじめとして、わたくしには親しかつた人達の、今は一人としてこの世に生残つてゐやう筈はない。",
              "citation": {
                "source": "雪の日",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "上田が英語英文に長じたのは勿論母堂の感化であらう。",
              "citation": {
                "source": "新詩發生時代の思ひ出",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は勿論母から厳しく折檻された。",
              "citation": {
                "source": "生い立ちの記",
                "author": "小山清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
