          "literary": [
            {
              "text": "最初は濁つた黄色であつたのが、大衆の中で、ロオザァヌの附近へ來ると、不思議な青色を帶び、ジュネヴを過ぎて、佛國の方へ再び長途の旅に向ふころから、彼はまた渇色を帶びて來る。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "汽車は、湖水の岸を走つて、ロオザァヌへ私をつれて來た。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオザァヌでも、湖水に面した一夜を過ごした。",
              "citation": {
                "source": "山岳美觀",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
