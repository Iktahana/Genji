[
  {
    "uuid": "cab97694-7bfc-52b5-9c56-4c9cc29ba6e2",
    "entry": "鹵獲",
    "reading": {
      "primary": "ろかく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "capture (of enemy weapons, supplies, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "奇襲攻撃に成功した我々の部隊は、敵の食糧と弾薬を大量に鹵獲した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "鹵獲した敵の通信機器を解析することで、彼らの次の作戦を事前に察知できた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "敗走する敵軍が置き去りにした兵器の鹵獲品リストを作成するよう指示された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ヨーロッパ中世における婦人は、飾りない言葉でいえば男子の闘争の鹵獲品として存在したのであった。",
              "citation": {
                "source": "私たちの建設",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "森の掩へるプラゴスを領せし我の母夫人、　425そを擒にしアキリュウス、他の數多き鹵獲ともこゝに連れ來て其後に、無量の賠償受け納れて放ちぬ、されど＊アルテミス、父の居城に母を射ぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "82　鹵獲の武具を神に捧ぐるは古來の習。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミュルミドネスの陣營に並に船に着ける使者、　185精美盡して銀製の絃柱もてる＊竪琴の玲瓏の音に其王者心樂む姿見る、エーイチオーンを陷れ鹵獲の中に撰りしもの、彈じて彼は興じつゝ＊武勇の事蹟謠ふめり。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "241　舳部における突出部、ヘクトールは之を鹵獲品となさんとするか？",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "』224　鹵獲の少きを曰ふか。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "大砲の鹵獲は三千門に及んだ。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうだ、鹵獲品は、みなこっちの隊へ運んでこい」　後方に退がると、諸隊は争ってこんどは兵糧のあばき合いを始めた。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "また諸所の道にかかる落人どもの馬具、物具なども余すなく鹵獲せよ」と、いいつける。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "張飛、趙雲、そのほかの士卒は、みな戦場から立帰って、敵の首級や鹵獲品を展じて、軍功帳に登録され、その勲功を競っていた。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "呉の軍勢は、勝ちに乗って、途中、敵の馬を鹵獲すること三百余頭、さらに進撃をつづけて、遂に南郡城外十里まで迫って来た。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中、莫大な兵糧や兵器を鹵獲しつつ、ついに※城の下まで追いつめて行った。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "占領した陣屋には、たくさんな兵糧や軍需品があったので、それらの鹵獲品はみな先に城内へ搬入させ、漢中の張魯へは、「莫大なる戦利品を獲、かつ曹操の一陣営を占領す」と、吉報を知らせておいた。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに人的損傷はその三分の一以上に及んだであろうといわれ、航行不能になって捨てていった船や兵糧や武具など、呉の鹵獲は莫大な数字にのぼり、わけても大捷の快を叫ばせたものは、「魏の名将｜張遼も、討死をとげた一人の中に入っている」　ということであった。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬岱軍は、大山の谷を挟んで陣を取り、その日のうちに、ここを通行する蛮人輸送隊の車百輛以上、水牛四百頭を鹵獲した。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはすばらしい鹵獲品だ。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸遜は、多大な鹵獲品と、数万にのぼる降人をひきつれて、建業へ還った。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく、鹵獲した木牛流馬が、この場合には、味方の足手まといになりはしまいか？",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに積んだ糧米だけでも二万二、三千石は鹵獲いたしました。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして魏軍は多くの木牛流馬と蜀兵の捨てて逃げた馬具、金鼓、旗さし物などを沢山に鹵獲したのち、凱歌賑やかに帰ってきた。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その多くは、葫芦の口へ兵糧を運んでゆく蜀勢を襲撃したもので、糧米、輸車、そのほかの鹵獲は、魏の陣門に山積され、捕虜は毎日、珠数つなぎになって送られて来た。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "否むしろかくのごとき方則に従って力に反応する物を物質と名づけるのである。",
              "citation": {
                "source": "物質とエネルギー",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの引斥力が自乗反比例という簡単な言葉で表わされるのは驚くべき事であるというよりは、むしろかくのごとく簡単に云い表わし得る言葉があるのが驚くべき事だとピアソンは云っている。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "貫一は寧ろかく疑ふをば、事の彼の真意に出でしを疑はんより邇かるべしと信じたりき。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して現代は歴史的時代の一つとして、寧ろかくの如き全體の一つの部分であるに過ぎぬ。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "耀きぬ雲の夕映、いやはての甕の雫に、耀きぬ、――わがこころかくて驚く。",
              "citation": {
                "source": "有明集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙ね、女のひとは多くその写真に即していろいろかく傾向です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルーズリーフをつかおうというわけは、ちょいちょいいろいろかくのです、耳にとまった会話、景色、そのほかいろいろ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "狼がじっとして動かないから、平五郎は今のうちにと思い、ぱっと馬にもろかくを当てる、たたたたたっ結び矢来に沿って驀地に近づきながら、つと馬上に伸び上り、狙い定めてふっと一の矢を射て放った。",
              "citation": {
                "source": "備前名弓伝",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　絶叫したかと思うと、もろかくを入れてぱっと疾駆しはじめた。",
              "citation": {
                "source": "備前名弓伝",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
