          "literary": [
            {
              "text": "その上、ポルト・サン・ジャックの本屋の主人でロアイヨルという老人のほか、生きた者のうちには友人も知己もなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "本屋のロアイヨルは死んでいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・ジャック市門のロアイヨルの後継者の家に行き、百フラン持って帰ってきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
