          "literary": [
            {
              "text": "倫敦テムズ河上、ロウヤル・アルバアト波止場でである。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそうと、いつの間にかもう日本へ帰着したようなことを言っているが、じつは、話しのうえでは、ＳＳ・Ｈ丸はいまやっと倫敦テムズ下流のロウヤル・アルバアト埠頭を離れたばかりのところに過ぎない。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "四日午前九時、ＳＳ・Ｈ丸はロウヤル・アルバアト・ドックを離れてテムズ河口へ揺るぎ出た。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "おぺら・ぐらす　六月二十三日――ロウヤル・アルバアト会館にロウヤル・コウラル協会の「ヒアワサ」を見る。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十六日――コヴェント・ガアデンのロウヤル・オペラ。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十八日――ロウヤル・ドルウリイ・レイン座。",
              "citation": {
                "source": "踊る地平線",
                "author": "テムズに聴く",
                "note": "青空文庫"
              }
            },
            {
              "text": "ともに陶器店で、ロウヤル・ポウセリンとケエレル。",
              "citation": {
                "source": "踊る地平線",
                "author": "白夜幻想曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
