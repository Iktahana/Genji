[
  {
    "uuid": "23a53c47-5c35-5df1-aa91-fa63c2cc207b",
    "entry": "炉辺",
    "reading": {
      "primary": "ろへん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
