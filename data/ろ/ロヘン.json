          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "寒い冬の夜、家族みんなで炉辺に集まり、暖を取りながら語り合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "山小屋の炉辺で揺れる炎を眺めていると、日々の喧騒を忘れて心が安らいだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "その古い民宿には趣のある囲炉裏があり、宿泊客は炉辺で郷土料理を楽しむことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "小鳥来る音うれしさよ板庇　渡り鳥の帰って来る羽音を、炉辺に聴く情趣の侘しさは、西欧の抒情詩、特にロセッチなどに多く歌われているところであるが、日本の詩歌では珍しく、蕪村以外に全く見ないところである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い火の燃える炉辺。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩人蕪村の心が求め、孤独の人生に渇きあこがれて歌ったものは、実にこのスイートホームの家郷であり、「炉辺の団欒」のイメージだった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オールド・ロング・サインを歌い、炉辺の団欒を思い、その郷愁を白い雲にイメージする英吉利文学のリリシズムは、偶然にも蕪村の俳句において物侘しく詩情された。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "河豚汁の宿赤々と灯しけり　と、冬の街路に炉辺の燈灯を恋うる蕪村は、裏街を流れる下水を見て易水に根深流るる寒さかな　と、沁々として人生のうら寒いノスタルジアを思うのだった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことに蕪村の俳句においては、すべてが魂の家郷を恋い、火の燃える炉辺を恋い、古き昔の子守歌と、母の懐袍を忍び泣くところの哀歌であった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芭蕉は「漂泊の詩人」であったが、蕪村は「炉辺の詩人」であり、殆んど生涯を家に籠って、炬燵に転寝をして暮していた。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「侘び」とは蕪村の詩境において、寂しく霜枯れた心の底に、楽しく暖かい炉辺の家郷――母の懐袍――を恋いするこの詩情であった。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "反対に蕪村は、どんな蕭条とした自然を見ても、そこに或る魂の家郷を感じ、オルゴールの鳴る人生の懐かしさと、火の燃える炉辺の暖かさとを感じている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは「炬燵の詩人」であり、「炉辺の詩人」であったところの、俳人蕪村の風貌を表象している。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "炉辺が、こわくてならぬのである。",
              "citation": {
                "source": "父",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈の折柄、彼を炉辺に呼び入れて、種々の話をする。",
              "citation": {
                "source": "雨夜の怪談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬ならば、炉辺に坐って燃えあがる焚火の焔を眺めていた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る冬の夜、太郎は炉辺に行儀わるく寝そべりながら、かたわらの惣助の顔を薄目つかって見あげ、ゆっくりした口調でなぞなぞを掛けた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "謂わんや、ふるさとの人々の炉辺では、辻馬の家の（Ｄというのは私の筆名であって、辻馬というのが、私の家の名前である。",
              "citation": {
                "source": "善蔵を思う",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　炉辺に大あぐらをかき熱燗のお酒を、といふ私のけしからぬ俗な念願は、奇蹟的に実現せられた。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いづれにもせよ、このハタハタを食べる事は、津軽の冬の炉辺のたのしみの一つであるといふ事には間違ひない。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と言つて、懈さうに炉辺から立つて来て、風呂敷包みを受取つて戸棚の前に行く。",
              "citation": {
                "source": "刑余の叔父",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十三　辻町糸七は、ぽかんとしていた仕入もの、小机の傍の、火もない炉辺から、縁を飛んで――跣足で逃げた。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですが、先生の私たちを引留めた目的は夜毎の炉辺の話にあるらしく、わたくしはまた、それを意表の外の思いで聴くのでした。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、先生と私たち二人は炉辺で向き合いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この夜のことを先生は、「祈祷の夜」と名付けましょうと言いまして、また私たちと炉辺で向い合い、パイプの煙草に香水をミックスして、おいしそうに燻らしながら次のように語り出しました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、先生は炉辺で、とても打ち沈んだ顔をしながら、今夜のことを「昇天の夜」と名付けましょうねと言って、話を語り出すまえに、低い、しかし清らかな声で唄いました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "埋火をかき起して炉辺再びにぎはしく、少婦は我と車夫との為に新飯を炊ぎ、老婆は寝衣のまゝに我が傍にありて、一枚の渋団扇に清風をあほりつゝ、我が七年の浮沈を問へり。",
              "citation": {
                "source": "三日幻境",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞き入れて、ホームズをくすぶり立つ炉辺の椅子に残して下がった。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が階下の部屋へと引き返すと、ファーガソンとホームズはそのまま炉辺で座っていた。",
              "citation": {
                "source": "サセックスの吸血鬼",
                "author": "THE ADVENTURE OF THE SUSSEX VAMPIRE",
                "note": "青空文庫"
              }
            },
            {
              "text": "座敷は其方此方、人声して、台所には賑かなものの音、炉辺には寂びた笑も時々聞える。",
              "citation": {
                "source": "貴婦人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の炉辺には、先刻の按摩の大入道が、やがて自在の中途を頭で、神妙らしく正整と坐つて。",
              "citation": {
                "source": "貴婦人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルコンもあるし、炉辺も出来るわけだ。",
              "citation": {
                "source": "悪筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然しポカンと炉辺に坐っていれば、坐ったきりで一日中そうしていた。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
