          "literary": [
            {
              "text": "ムューズ高原・バリクール高原・ロマーニュ高原及びアルゴンヌの森。",
              "citation": {
                "source": "ヴェルダン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちは記念柱の裏の高地に登って、物凄く破壊された寺の跡を見てまわり、ついでにロマーニュの戦跡を訪ねて、アルゴンヌの森を抜けた。",
              "citation": {
                "source": "ヴェルダン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロマーニュにはシメティエ・アメリケエン（米軍共同墓地）があり、付近にはシメティエ・アルマン（独軍共同墓地）が二つほど見られた。",
              "citation": {
                "source": "ヴェルダン",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
