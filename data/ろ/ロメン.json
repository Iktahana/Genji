  {
    "uuid": "02ada80c-a953-5e80-9fc8-b22e1b73a32b",
    "entry": "ロメン",
    "reading": {
      "primary": "ろめん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二人はクロメンコ社を起こし、ダズラーを売り出した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな錯乱のさなかの一九九一年四月九日、コンパックとマイクロソフト、そしてＵＮＩＸで勝負をかけるサンタクルズオペレーションを始めとする二十一社が、新しい先進的プラットフォームと銘打った、ＡＣＥ（アドバンスト・コンピューティング・エンバイロメント）構想に取り組むと発表してオレの錯乱に拍車をかけた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでなくとも、民衆には丸で無関心な、若しくはロメン・ロオランの云ったように、民衆を少しも軽蔑しないと云う事を却って軽蔑のたねにする、即ち其の膏汗で自分等の力を養ってくれた親の田舎臭いのを恥じる、成上り者共の多い文壇の事である。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "民衆芸術は、ロメン・ロオランの云ったように、流行品ではない、ディレタント等の遊びではない。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロメン・ロオランが起草した、民衆劇場建設の檄にもあるように、此の問題は実に、民衆にとっても亦芸術にとっても、死ぬか生きるかの大問題である。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　ロメン・ロオランは、前世紀の末年から現世紀にかけて非常な勢で拡まった民衆芸術の大運動に就いて、次ぎの二つの事実を記して置きたいと云って、民衆が急に芸術の中に勢力を得て来た事と、民衆芸術と云う総名の下に集まる諸説の極めて紛々たる事とを挙げている。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロメン・ロオランの民衆即ち People が平民労働者である事は後に明かになるであろう。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の要求する芸術は、ロメン・ロオランの謂わゆる、新しき世界の為めの新しき芸術であったのである。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランスでの民衆芸術の提唱者、ロメン・ロオランはさすがに分っている。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを要するに、エレン・ケイはただ、ロメン・ロオランの民衆芸術論の要旨を紹介して、それに「其の一語も残さずに賛成し」更に其の一方面の休養的教養を力説して、現在の民衆の娯楽物を批評したにとどまる。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　然らば、エレン・ケイが「其の一語も残さずに賛成した」と云う、ロメン・ロオランの民衆芸術論の要旨はどんなものか。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　ロメン・ロオランの民衆芸術論の要旨はこれで尽きる。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「始めに行為あり」と、　斯くしてロメン・ロオランは、其の民衆芸術の当然の結論として、芸術的運動と共に、と云うよりも寧ろそれに先だって、社会的運動に従わなければならないと断言した。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶ロメン・ロオランは、其の民衆芸術論を労働運動論で結んでいると共に、其の芸術論をも生活論で終らせている。",
              "citation": {
                "source": "新しき世界の為めの新しき芸術",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
