        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アラモアナの録音スタジオでマイケルの歌をいっしょに聴いていたとき、ウエインは小きざみにふるえていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "単なるショウ・ビジネスのための集合ではなく、メンバーのひとりひとりが自己発見をして自分のことをおこないながら全体は緊密に結ばれあい、録音スタジオのなかで有機的に発酵するというグループになった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "録音スタジオは、木屋町の南のはずれにあった。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽子たちは新宿の録音スタジオでレコーディングを済ませた後、市ヶ谷の日本テレビへタクシーで直行した。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽子たちは四谷の録音スタジオを貸し切りで明日のコンサートに向けて朝から練習に励んでいた。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "録音スタジオの休憩室は赤い壁で囲まれていて窓がなく、自動販売機とテレビと長椅子以外ほとんど何もない殺風景な部屋だった。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "録音スタジオから自宅の“ＳＦしてる”部屋に戻ると陽子は全身の力を弛緩させて絨毯に寝そべりながらＣＤでジャン・ミッシェル・ジャールの『ズールック』を聴いた。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
