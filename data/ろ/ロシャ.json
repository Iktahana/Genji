    },
    "definitions": [
      {
        "index": 1,
        "gloss": "donkey cart",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "シルクロードの古い街並みを、荷物をいっぱいに積んだ驢車がゆっくりと通り過ぎていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "絵本の中で、主人公の少年はロバに引かれた小さな驢車に乗って旅に出る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "現地の農民たちは今でも、畑への農作物の運搬に素朴な驢車を愛用している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "支那では明朝の宮中元日に驢の頭肉を食うを嚼鬼と呼んだ、俗に驢を鬼と呼んだからだ（インドでも驢を鬼物とし、故人驢車に乗るを夢みるは、その人地獄へ行った徴という）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "またインドで曙光神アスヴィナウは、日神スリヤその妃サンニアと牡馬牝馬に化けて交わり生んだので三輪の驢車に乗り、日神自身は翡翠色の七頭の馬に一輪車を牽かせて乗ると類似して、ギリシアの日神ヘリオスは光と火を息する四の雪白馬が牽く車に乗る（第六図）。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "騾車、驢車、支那人の爺のウオウオウイウイが聞こえる。",
              "citation": {
                "source": "一兵卒",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝城は金壁にかこまれ、瑠璃の瓦を重ね、百官の驢車は、翡翠門に花のよどむような雑鬧を呈している。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何者とも知れず、安喜県のほうから代州（山西省・代県）のほうへ向って、驢車に家財を積み、十数名の従者をつれ、そのうち三名は、驢に乗った浪人風の人物で、北へ北へとさして行ったということでありますが」　との報告があった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は陽城を出て、四頭立ての驢車に美人を大勢のせ、酔うた彼は、馭者の真似をしながら、城外の梅林の花ざかりを逍遥していた。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "天下の百姓の見せしめに召捕えろ」と、驢車の上で、急に怒りだした。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、花見よりも、よほど面白かった」　驢車は黄昏に陽城へ向って帰還しかけた。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとある巷の角から、「逆賊ッ」と、喚いて、不意に驢車へ飛びついて来た漢がある。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "精悍な刺客の男は、驢車へ足を踏みかけて、短剣を引抜き、相国の大きな腹を目がけて勢いよく突ッかけて行ったのであったが、董相国にその剣を叩き落され、しっかと、抱きすくめられてしまったので、どうすることもできなかった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おれは朝廷の臣、越騎校尉の伍俘だっ」「斬れッ、こいつを」　驢車から蹴落すとともに、董卓の武士たちは伍俘の全身に無数の刃と槍を加えて、塩辛のようにしてしまった。",
              "citation": {
                "source": "三国志",
                "author": "桃園の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは、ふたりながら死んだように黙って呑んでいたのであるが、二時間くらいたってから、馬場はそろそろしゃべりはじめた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京訛が抜けなかったために「他国もんのべろしゃ／＼」だと云っていじめられた。",
              "citation": {
                "source": "鷹を貰い損なった話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋とサア情のその二道は、やまと、唐土、夷の国の、おろしゃ、いぎりす、あめりか国も、どこのいずくも、かわりはしない。",
