          "literary": [
            {
              "text": "土間には轆轤台と陶土、出来上った急須や茶碗も五つ六つ並んでいる。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（蓮月、土間に降り轆轤台に向う。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮月、土間の轆轤台の前に座って陶器の仕事にとりかかる。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓮月はやはり土間の轆轤台の前に坐って居て工作に余念も無い。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく轆轤台の軋る音だけが春昼の閑けさの中に耳につく。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（蓮月、轆轤台の前を立ち部屋の方に来る。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（蓮月また轆轤台の前に戻る。",
              "citation": {
                "source": "ある日の蓮月尼",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "前にもいったが陶器師の数はすくなく、製品を乾すために轆轤台から棚へはこぶ幼い子供から、あるいは盲目であっても陶土を轢いたり（図599）、足で陶土をこねたり（図600）することが出来る老人にいたる迄、家族の全員が仕事をする。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
