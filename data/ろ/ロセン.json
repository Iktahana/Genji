[
  {
    "uuid": "56232f44-ad0f-5e8f-93f0-93387559f00e",
    "entry": "路線",
    "reading": {
      "primary": "ろせん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
