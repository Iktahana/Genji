        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、大正九年の秋、たま／＼ヨーロツパから歸つて來た親戚の人からイーストマンの葉書｜判の寫眞器をみやげにもらつた。",
              "citation": {
                "source": "寫眞と思ひ出",
                "author": "――私の寫眞修行――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨオロツパでも警察力の完備した所と聞えたストツクホルム、當然喧々囂々たる非難の矢面に立つ責任者だつたから‥‥。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしヨーロツパにアレキサンドル大王といふ英雄があつた。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界的太宰治　ヨーロツパの近代人が書いた「キリスト傳」を二、三册讀んでみて、あまり感服できなかつた。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｊ・Ｍ・マリイといふ人は、ヨーロツパの一流の思想家の由であるが、その「キリスト傳」には、こと新しい發見も無い。",
              "citation": {
                "source": "世界的",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フルイ　バシヤ新美南吉　ムラヤクバノ　マヘノ　ヒロツパニ　フルボケタ　バシヤガ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナデ　バシヤヲ　ヒロツパヂユウ　ヒツパリマハス　コトモ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タレノ　カゲ新美南吉　マチノ　マンナカニ　ヒロツパガ　アリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒロツパノ　マンナカニ　マルイ　カゲガ　ヒトツ　オチテ　ヰマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　ヒロツパノ　マンナカノ　カゲハ　ウゴキマセンデシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　コンドハ、ヒロツパ　イツパイニ、ハツ　ハツ　ハツト　ワラフ　コヱガ　ヒビキマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　ユウガタニ　ナツテ、タイヤウガ　オチテ　シマフト　ヒロツパノ　マンナカノ　マルイ　カゲハ　ナクナツテ　シマヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の避くべからざるは、当時｜外夷とせられてゐたヨオロツパ諸国やアメリカは、我に優つた文化を有してゐたからである。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時｜元田永孚などと交つて、塾を開いて程朱の学を教へてゐた横井が、肉身の兄の病を治療してもらふ段になると、ヨオロツパの医術にたよつた。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵器とそれを使ふ技術ともヨオロツパが優つてゐたのを横井は知つてゐた。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "横井は又ヨオロツパやアメリカで基督教が、人心を統一する上に於いて、頗る有力であるのを見て、神儒仏三教の不振を歎いた。",
              "citation": {
                "source": "津下四郎左衛門",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の女優だと云つて、或時忽然ヨオロツパの都会に現れた。",
              "citation": {
                "source": "花子",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロダンの差し伸べた手を、もう大分ヨオロツパ慣れてゐる花子は、愛相の好い微笑を顔に見せて握つた。",
              "citation": {
                "source": "花子",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰ばかり濶くて、肩の狭い北ヨオロツパのチイプとも違ふ。",
              "citation": {
                "source": "花子",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "詰まりヨオロツパ中のどの国の人も自国ではそんな声を聞いた事がないのだ。",
              "citation": {
                "source": "病院横町の殺人犯",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後身であつた藻社も、若い人達の集合であつたにも拘らず、新しいヨウロツパの思潮に触れず、唯、単に技巧と娯楽とを基礎にしたやうな作品ばかりを公にしてゐた。",
              "citation": {
                "source": "『蒲団』を書いた頃",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに、今回のヨオロツパの未曾有の大戦が起つた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな空気に捲き込まれずに、大戦以後のヨオロツパの文学を研究することが最も必要である。",
              "citation": {
                "source": "私の考へてゐる事",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもいつもヨオロツパの文学の言葉の自由なのに、豊富なのに、何とも言へない影やら彩やらを持つたものの多いのに空しく憧憬した。",
              "citation": {
                "source": "私の考へてゐる事",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人の骨格は大体ヨーロツパ人よりも小さく、従つて体力も弱い。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "古代ギリシヤ人と二十世紀のヨーロツパ人との間には殆んど骨格の相違は認められぬであらう。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "テエヌの言葉をかりると当時のフランス劇は、「ゴチツク建築と同様に、人間精神の、くつきり整つた形態をあらはしてゐたので、そのために、それはゴチツク建築と同様に全ヨーロツパにひろまつたのである。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨーロツパの各国に前後して起つたところのロマンチスムの文学運動には、民族や国土やその他無数の条件によつて、それ／″＼異つた色彩が見られる。",
              "citation": {
                "source": "文学方法論",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に又全ヨオロツパを挙げて十字軍に加はらせたのも、――しかしそれは「文芸的な、余りに文芸的な」問題ではないかも知れない。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
