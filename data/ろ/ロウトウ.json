[
  {
    "uuid": "83eff9f0-fce1-5bc9-8cba-ef0dd43ddec3",
    "entry": "郎等",
    "reading": {
      "primary": "ろうとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
