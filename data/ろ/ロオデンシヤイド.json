        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これまで毎年ロオデンシヤイド市に来る曲馬師の組は、普通の天幕の中で興行したのだが、それはもう罷められる。",
              "citation": {
                "source": "防火栓",
                "author": "DAS GROBE VERGNUGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオデンシヤイド市の物のわかる連中に来て貰はうと思つて、何遍も骨を折つて見た。",
              "citation": {
                "source": "防火栓",
                "author": "DAS GROBE VERGNUGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオデンシヤイド市の警察は人数も余り多くない。",
              "citation": {
                "source": "防火栓",
                "author": "DAS GROBE VERGNUGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロオデンシヤイドの上流社会は城壁のやうに屹立してゐる。",
              "citation": {
                "source": "防火栓",
                "author": "DAS GROBE VERGNUGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "気の毒千万なのはロオデンシヤイド市民と元日のおなぐさみとである。",
              "citation": {
                "source": "防火栓",
                "author": "DAS GROBE VERGNUGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはロオデンシヤイドの曲馬場は今後もきつと大入だと云ふことを知つてゐたからである。",
              "citation": {
                "source": "防火栓",
                "author": "DAS GROBE VERGNUGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
