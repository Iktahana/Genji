        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あれから多賀ちゃんと池袋で会って、有楽町へ出てフレッド・アステアとジンジャ・ロージャースの「カッスル夫妻」というのを（映画よ）観ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがスタンレイ・ロージャースの近刊『太平洋』によると、一八六七年で、船は「コロラド」である。",
              "citation": {
                "source": "咸臨丸その他",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "アステア、ロージャースの傑作集と、同じ二人の「気儘時代」といふ、あんまり面白くない映画。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
