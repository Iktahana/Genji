        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（初出時の表題は「マルテ・ロオリッツ・ブリッゲの手記」。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "（初出時の表題は「二つの断片（「マルテ・ロオリッツ・ブリッゲの手記」から）」。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "（初出時の表題は「「マルテ・ロオリッツ・ブリッゲの手記」から」。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "（初出時の表題は「マルテ・ロオリッツ・ブリッゲの手記（※）」。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵のひとが出て来ないほど、船が、凄まじくロオリングするなか、ぼくは盛んに、牛飲馬食、二番の虎さんや、水泳の安さんなんかと一緒に、殆ど、最後まで残って、たしか飯を五杯以上は食いました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ長江は大きいと云っても、結局海ではないのだから、ロオリングも来なければピッチングも来ない。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はその時、ウォタア・ロオリイ卿のように叮嚀にお辞儀をしようと思います。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア・ウォルタ・ロオリが創始しデラウェア卿が建設したヴァージニア植民地においては、三つの企画が完全に失敗した。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルヌウとフレデリックの錯雑を極めた人間関係やデロオリエとの憎悪にみちた友愛や、その奥にひそむところの生命の秘密ともいふべきところの野心や懊悩、さういふものは素材として掴みだされ呈出されてゐながら、彼の描写の興味は殆んどそれに向けられてゐない。",
              "citation": {
                "source": "フロオベエル雑感",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "内貿桟橋と山内岸壁には貨物船が何隻も横づけになり、上屋と税関の構内には幌馬車のような幌をつけた山のようなトラックやトレーラーやモータア・ロオリーがおしあうようになっている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何を願うか、クレヴィナ・マック・ロオリイ」青き琴手は訊いた。",
              "citation": {
                "source": "琴",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "クレヴィンの老母は身じろぎして、だるそうに呻いたが、やがて白い頭をたれて神々の国に行った、そして彼女を愛した亡夫ロオリイ・マック・ロオリイといっしょに歩いた、その人は遠いむかし戦場で死んだ人だった。",
              "citation": {
                "source": "琴",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "見習の早見俊平は立上って、うろ覚えのアンニイ・ロオリイをうたい始めた、しかしひどく亢奮しているので歌を続けることができず、すぐにやめて腰を下す、みんながそれに好意ある拍手を送る、やがて根来勇助が椅子の上に立って、タンブラアを高く捧げながら叫ぶ。",
              "citation": {
                "source": "溜息の部屋",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
