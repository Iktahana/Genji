          "literary": [
            {
              "text": "「待たせてすまない、ロスコウ君。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "すまんがチャリングクロス駅に電話して三十分以内に臨時列車をドーバー駅まで出してくれるように手配してくれ」　ロスコウ秘書は少しも嫌がっていないようだ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとばかげた恋文で、国際問題が起こるわけはありませんよ」「ロスコウ君、まさにそこが誤りだ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は筋を立てるが好きだろ、ロスコウ君、これがそれだよ。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここ何日も食べていないような気がする」　ロスコウ秘書はこれらの命令を冷静に受け止めた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            }
          ]
        }
