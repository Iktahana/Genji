          "literary": [
            {
              "text": "サン・ロレンツオ寺の頽れた古廊も秋の季節に見るべき物である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルネツサンス芸術の保護者であつた貴族メデイチ家の霊廟をサン・ロレンツオ寺に訪うてミケランゼロの建築に良久しく陶然とした。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで己、ロレンツオ・ヰラミは諸君にことわつて置くが、己の話すのは、己の確かに知つてゐる事でほ無い。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "――――――――――――　ロレンツオや、聞いてくれ。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロレンツオや、聞いてくれ。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロレンツオや、君も外の友達も己を忘れてゐたやうだ。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ロレンツオよ、君の住んでゐる館の赤み掛かつた壁と水に漬つた三段の石級とがある。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヱネチアに帰つてから己の最初に尋ねたのは、ロレンツオよ、君だつた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
