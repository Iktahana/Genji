[
  {
    "uuid": "8b7d4e07-c471-5f1a-9be9-209dc97d0892",
    "entry": "老境",
    "reading": {
      "primary": "ろうきょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
