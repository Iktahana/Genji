        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――ソロモン僕はもうバッハにもモツアルトにも倦果てた。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモン王と賤民　私は生れたときに、一ばん出世していた。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はソロモン王の底知れぬ憂愁も、賤民の汚なさも、両方、知っている筈だ。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモンの栄華も一輪の百合の花に及ばないという古い言葉が、今の自分には以前とは少しばかりちがった意味に聞き取られるのである。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるにまた近来ニューヨークのソロモンという人が同じ考えを起して大仕掛けに資本をかけてこの法を用いる事になったそうである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうして、じっと見ていると、ほんとうにソロモンの栄華以上だと、実感として、肉体感覚として、首肯される。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "野の百合は如何にして育つかを思え、労せず、紡がざるなり、されど栄華を極めしソロモンだに、その服装この花の一つにも如かざりき。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモン王の底知れぬ憂愁をうかがひ知り得る唯ひとりの人である。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その友達というのは手相を見る男で、それも西洋流の手相を見る男で、僕の手相を見たとき、君の手にはソロモンの十字架がある。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "南洋のソロモン群島中のある島に存する竹製の縦笛にププホルと称するのがある。",
              "citation": {
                "source": "日本楽器の名称",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモンと榮華を競へりとか、白百合の花も恥づべき哉。",
              "citation": {
                "source": "婦人十一題",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このキット式のコンピューターをアルテアと名付けたのは、『ポピュラーエレクトロニクス』のテクニカルエディター、レズリー・ソロモンの娘だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモンはＳＦドラマの「スタートレック」をテレビで見ている娘に、宇宙船エンタープライズに積んであるコンピューターの名前をたずねた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "左は海に向へる青野のあなたに、チルチエオの岬（プロモントリオ、チルチエオ）の隆く起れるあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "――おくみさん、フランスではね、この人と二人で、一と夏フロモンビールといふ田舎で一緒に自炊をした事があるんだよ。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうかの捕捉し難き海の精靈も、ソロモンの壺のやうなこの小さい祠の中に藏められれば、既に彼等の實際生活の役に立たねばならぬ。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はソロモンの栄華と野の花のよそおいを対比して考察したりなんかしない。",
              "citation": {
                "source": "白い花",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモンの栄華は人間文化の一段階として、それはそれでよいではないか。",
              "citation": {
                "source": "白い花",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "法水さん、貴方はこのソロモンの意味がお判りになりまして。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで君は、『ソロモンの雅歌』の最終の章句を知っているかね。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "野に咲く百合を見て、ソロモンの栄華を果敢なしと説いた神の子は、この芥子の花に対して何と考えるであろう。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、申してみれば、ソロモン王のような、くらしをあそばしていらっしゃるとでも申しましょうか。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモンは一代のうち数へきれぬ程の女と縁を結んだといふが、あの通りの賢者の事だから、訊いてみたら色々面白い談話を聞かせてくれたに相違ない。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "男三　身体は、売ったがわが魂は、ソロモンの富を以てしても売らないとこう云っているのです。",
              "citation": {
                "source": "世評（一幕二場）",
                "author": "A morality",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソロモン諸島人はのみと信ず（一九一〇年版ブラウン著『メラネシアンスおよびポリネシアンス』二〇九頁）。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "『英国人類学会雑誌』十巻三〇九頁にいう、ソロモン島では、人の余食を神池の魚や蛇に食わせば、その人死すというと。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしソロモン王が外国から致した商品中に猴ありて、三年に一度タルシシュの船が金銀、象牙、猴、孔雀を齎らすと見ゆ。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘブリウの異伝には、アスモデウス身を隠してソロモン王の妃に通ぜしに、王その床辺に灰を撒布し、旦に鶏足ごとき跡を印せるを見て、鬼王の所為を認めたりという。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
