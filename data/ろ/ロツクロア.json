          "literary": [
            {
              "text": "エヅアアル・ロツクロアはきつとまだ覚えてゐるだらう。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして非常に早くロツクロアの読み書きをする机の上に飛び上がつて、インクの瀋んだのを吸ひ取る沙が、皿に盛つてあるのを取つて、又非常に早く窓に帰つて、その皿の中の沙を、丁度中庭を通つてゐた誰やらに蒔き掛けた。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時ロツクロアが云つた。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            }
          ]
        }
