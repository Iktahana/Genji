        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その塀に沿つた、紙や泡のヒヨロヒヨロと顫へてゐるドブは、それを見ながら歩くことが嫌ではなかつた。",
              "citation": {
                "source": "亡弟",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "色の青白い、瘠せた、胸の薄い、頭の大きいのと反比例に首筋の小さい、ヒョロヒョロした深谷であった。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "野球のチャンが二人でようやく載っけることができた、仮の墓石を、深谷のヒョロヒョロな手が軽々と持ち上げた。",
              "citation": {
                "source": "死屍を食う男",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "下手な田舎芝居の女形を思わせる色の黒い、やせたヒョロヒョロの、南瓜のしなびた花のような、女郎上がりのおばさんだった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は鰯のようなヒョロヒョロの星やめだかのような黒い隕石はみんなパクパク呑んでしまうんだ。",
              "citation": {
                "source": "双子の星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな甲蟲がまっすぐに飛んで來て私の額に突き當りヒョロヒョロ危く墮ちようとして途方もない方へ飛び戻る。",
              "citation": {
                "source": "うろこ雲",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十前後の、ヒョロヒョロと痩せて背の高い、放心したような表情の男だったが、眉には神経質らしい翳があり、こういう男はえてして皮肉なのだろうか。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はヒョロヒョロした足で、ついて行った。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "息を吹き込むとヒョロヒョロと象の鼻のように伸びるおもちゃも売っている。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こゝに住める猶太教徒は全き宗門の組合をなして、その家々軒を連ねて高く聳え、窓といふ窓よりは、「ベレスヒツト、バラ、エロヒム」といふ祈の聲聞ゆ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんたの方がコスモスより、よっぽどヒョロヒョロのくせに。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜子（西瓜のたね）　烏秋（台湾烏）　　赤嵌楼（蘭人の所謂プロヒレンチヤ城なり）蕃童蕃童は※仔を射る。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜子（西瓜のたね）烏秋（臺灣烏）赤嵌樓（蘭人の所謂プロヒレンチヤ城なり）鴛鴦飛ぶ禽としも、幽かだに思ひかけずておろかさよ、こずゑの雪に鴛鴦のたつる羽音を觀しや君。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、チョッピイヒョロヒョロ、ピイヒョロヒョロと、たそがれかけた夕空高く囀ってこのあたり野州の山路に毎年訪れる、一名霜鳥との称のある渡り鳥のツグミの群が、啼いて群れて通っていったからとて不思議はないのです。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコドコドンドン、ヒュウヒョロヒョロと、朝ごとに角兵衛獅子の囃子がその柳原お馬場の近くの旅籠町からわびしく流れだして、西に東に江戸一円へ散らばっていくのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいてめんこ、でんでん太鼓にピイヒョロヒョロの笙の笛。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ　ミチバタデ　カナヅチヲ　一ツ　ヒロヒマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンデ　オヒロヒナサイ」　ヲンナノ　コハ　コマツテ　シマヒマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガイトウノ　カゲナラ、ガイトウノ　ウシロニ　アル　ソノ　ヒヨロヒヨロシタノガ　サウダヨ」ト　ケイキキユウハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この装置は三十三個の鐘群も同様で、ベルリンのパロヒアル寺院を模本としたものであるが、パロヒアル寺院では、反対にそれが、礼拝堂の内部に向けて作られてある。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "日頃、大食いの親父は息子の重みを背中に感じ、ヒョロヒョロしながらも、その重みを歩く張りにして、それから未だ一里もあった街道をもう風景に対する感動もないまでに疲れ切って歩いて行った。",
              "citation": {
                "source": "箱根の山",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "処で自分の功績だけを気にする分隊長は、岡田が剣も銃も棄て、乞食みたいな格好でヒョロヒョロと歩いているのをみると、そんな兵隊を上官にみられたら、叱りつけられた上、点数も薄くなると、カッと上気した様子で、忽まち走り戻り、銃を逆手に持ち直し、「このド阿呆が。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "与一ちゃまが乱心……ランシイ――ンン……」「おのれッ……云うかッ……おのれッ……」　東の縁側から逃げ出した七代の乱れた髻に、飛鳥のごとく掴みかかった与一は、そのまま飛石の上をヒョロヒョロと引き擦られて行った。",
              "citation": {
                "source": "名君忠之",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕を採用するならするでイクラカ前貸しして頂きたいのですが」　と呼びかける勇気も無くしてしまったまま杖に縋ってヒョロヒョロと立ち上った。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
