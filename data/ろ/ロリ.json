        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ローマ兵は、敵の攻撃から身を守るためにロリカ（鎧）を着用していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "博物館には、古代のロリカの遺物が展示されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "重厚なロリカを身にまとった騎士が、ゆっくりと歩みを進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
