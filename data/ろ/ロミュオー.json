        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ああ、あなたはロミュオーさま……」　彼女は竪琴の音の消えるような優しい声で、ゆるやかにささやきました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            },
            {
              "text": "さようなら、ロミュオーさま、さようなら。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロミュオー君、どうかあなたの上に神様のお守りがあるように祈ります」　こう言って、セラピオン師は静かに戸口の方へ出て行きました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは小さいＣの村の司祭であるか、またはクラリモンドの肩書つきの愛人ロミュオー君であるか、この変則がどうしても分かりませんでした。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ロミュオー卿、あなたの情人をご覧なさい。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラリモンドの愛人として身分の高いロミュオー卿は、長いあいだ不思議な道連れであった僧侶の身から離れてしまったのです。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "クラリモンド",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
