          "literary": [
            {
              "text": "ケロデンの渓流、ゲッセマネの園、そっちの方へ流れて行った。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "楊の茂みを潜りぬけ、ケロデンの渓流を徒歩渡りし、やがてゲッセマネの廃園へ来た。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルコント・ド・リイル、ヴェルハアレン、ロデンバッハ、サマンなど詩人たちの戯曲は、何れも一時的の評判をとつただけである。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "これをロジンだと言いロデンが本当だと言い或は気狂いだなどとも先生がいった。",
              "citation": {
                "source": "美術学校時代",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――この様な句を読むとすると、嘗てロデンバックの短篇集を繙いたことのある人ならきつとあの廃都ブリュジュの夕暮を思ひ描くに相違ない。",
              "citation": {
                "source": "水に沈むロメオとユリヤ",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
