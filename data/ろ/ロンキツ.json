        "examples": {
          "standard": [
            {
              "text": "弁護士は証人を鋭く論詰して事件の核心に迫る証言を引き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "委員会の場で野党議員が大臣を容赦なく論詰する場面があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼は相手の主張の矛盾を丁寧についながら論詰していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "大吉と年造とは壁ひとえの相長屋で、ひとり者同士の仲よく附き合っていたので、年造がゆうべから病気に罹ると、彼は商売を休んで看病した程であるから、今夜の通夜には勿論詰めかけていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "かむろ蛇",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ見たばかりじゃあ勿論詰らないさ。",
              "citation": {
                "source": "小景",
                "author": "――ふるき市街の回想――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
