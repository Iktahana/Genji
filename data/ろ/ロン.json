  {
    "uuid": "e5f28319-6df3-5133-aa73-3810e6a48764",
    "entry": "崙",
    "reading": {
      "primary": "ろん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
