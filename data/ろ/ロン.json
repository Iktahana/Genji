        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "進化論を否定する立場から強い反発の声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "量子力学と相対性論を統合する理論の構築が物理学者の夢となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "宇宙論の最前線では多宇宙の存在が真剣に議論されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "essay",
        "register": "standard",
        "nuance": null,
