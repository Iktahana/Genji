          "literary": [
            {
              "text": "わたしのシロクマの毛皮の中に、おはいりなさい！",
              "citation": {
                "source": "雪の女王",
                "author": "――七つのお話からできている物語――",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮の胸痛のこときく、ロクマクの癒着でおこる神経痛の由。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツハハ、でもな、ロクマクエンは治つたが、治つた時にほ、髪の毛えが、みんな抜けてしまうてな、キレーに丸坊主になりましてな。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼばかりでなく、ロクマクでも子宮病でも、みんな肝臓炎だ。",
              "citation": {
                "source": "肝臓先生",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロクマ（大道易者）のアビルの、乞食のような姿は、こっちの気のせいもあってか、神秘と威厳にみちたものとして俺に見られた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
