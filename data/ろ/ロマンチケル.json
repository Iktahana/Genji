          "literary": [
            {
              "text": "ロマンチケルである。",
              "citation": {
                "source": "夜長ノート",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "山をあるく、風がさわがしい、枯枝をふんで寂しい微笑をさがすといふのが、ロマンチケルだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、なぜ自分がロマンチケルであるかということは説明のしようもない。",
              "citation": {
                "source": "錯覚した小宇宙",
                "author": "――Our faith comes in moments;",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ親戚では結婚に反對した位だから、二人の熱烈な、同時に無力なロマンチケルに對して、丸で補助と云ふものをして呉れませんでしたから、又二人の方でも、それを受けませんでしたから。",
              "citation": {
                "source": "「青白き夢」序",
                "author": "森田草平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
