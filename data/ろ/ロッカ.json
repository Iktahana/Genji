        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "チェンロッカー（錨室）の蓋の上には、安田が仰向きに臥ていた。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "水夫室のまん中にある蓋をとると、その下は錨鎖のはいる箱（チエンロッカー）になっていた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "波田は暗い顔をして、チエンロッカーへおりて行った。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はチエンロッカーについて悲惨な物語を聞いていたが、それは、いつでも彼がチエンロッカーへはいる場合に、彼の記憶の中から、ムクムクと起き上がって来ては、彼を脅すのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことにチエンロッカーと彼女らとの関係は惨鼻をきわめた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、密航婦を船長とボースンとが共謀で、チエンロッカーの中に隠したのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "チエンロッカーは、出帆したが最後、入港までは用のないところなのだ、その暗室の鎖の上へ彼女らは、蓆を敷いて寝ていたのだ。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "水火夫らは毎夜、そのチエンロッカーの蓋をあけてやった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ホンコン入港の時に、密航婦を、フォーアピークへ移しかえることを忘れなかったボースンは、何と考え違いしたものか、大切のシンガポーアで、有頂天になり過ぎていて、密航婦を、チエンロッカーから出すことを忘れてしまった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "波田は、チエンロッカーが、そんな歴史を持っていることによって、その困難な労働をなお一層不快ないやな、堪え難いものにした。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを思い出すと、彼は全くチエンロッカーにはいることが、何よりもいやであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は肉体的にはもちろんであるが、精神的にもこの上ない疲労を感じて、チエンロッカーから上がった時はまるで溺死しそこねた人のようであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "だれかが、このチエンロッカーにはいらなかったならば船は動き得ないのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一、おれはチエンロッカーにはいらないよ」波田は、自分のあの困難な仕事が、船の出帆に際して、どうしても省略することのできない重大な作業であることを、ハッキリ見ることができた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "去年の秋は神田の花屋で、チューリップと、ヒアシンスと、クロッカスとの球根を買って来て、自分で植えもし、堀り上げもしたので、この三つのものはよく知っていた。",
              "citation": {
                "source": "球根",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "きょうは市街を離れてアルバノの湖からロッカディパパのほうへ古い火山の跡を見に参りました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺院の北側をロッカ・マジョーレの方に登る阪を、一つの集団となってよろけながら、十五、六人の華車な青年が、声をかぎりに青春を讃美する歌をうたって行くのだった。",
              "citation": {
                "source": "クララの出家",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "心配なのは、同室の手塚という、なにかといえばロッカーから菓子を出して、だれにもやらずに、じぶんひとりで食べている、意地の悪そうな太った奴だけだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大森、やっちゃえよ」　秋本が面白そうにいって、じぶんのロッカーをあけ、バットをひっぱりだした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一はあわてて、いま閉めたロッカーの鍵をあけ、ＶＡＮの白いスニーカーをひっぱりだした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一はロッカーをあけて、じぶんのガットギターをひっぱりだしたが、ケースをあけるのは気がすすまない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "片桐がくるまで、ロッカーに放りこんだままだった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつも、死体処理にご協力ありがとうございます」　高志が笑いながら立ちあがり、壁に背をつけて四つならんでいるロッカーのカギをあける。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロッカーには、大きなビニール袋が入っていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいたい、こいつはＰＸの横流しだからな、理屈じゃ密輸品なんだぜ」　そういいながら、高志はつぎのロッカーをあける。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいちに、ロッカーに隠す必要があるので、たとえコーラでもなんでも、高志が空き缶をかならず洗うように強要する。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "慶一は、ラディックの刻印がついたスティックをロッカーにしまい、となりの片桐のベッドを見た。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ストレート・ロッカーはこれくらいにして、つぎはバラッドね」　ワラが、タイムを書き写しながらいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "これでまた、ストレート・ロッカーにもどれる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
