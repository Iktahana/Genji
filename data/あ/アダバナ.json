        "examples": {
          "standard": [
            {
              "text": "毎日、徒花について考えています。",
              "source": "幻辞"
            },
            {
              "text": "我が社の徒花戦略は重要です。",
              "source": "幻辞"
            },
            {
              "text": "徒花の原理は複雑である。",
              "source": "幻辞"
            },
            {
              "text": "徒花という言葉が頭から離れない。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは徒花について学んでいる。",
              "source": "幻辞"
            },
            {
              "text": "徒花の治療方法は多様である。",
              "source": "幻辞"
            },
            {
              "text": "徒花に関する法律が改正された。",
              "source": "幻辞"
            },
            {
              "text": "選手たちは徒花を目指している。",
              "source": "幻辞"
            },
            {
              "text": "自然界での徒花は見事である。",
              "source": "幻辞"
            },
            {
              "text": "歴史上、徒花は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "徒花は日本文化の一部である。",
              "source": "幻辞"
            },
            {
              "text": "旅行中に様々な徒花を見つけた。",
              "source": "幻辞"
            },
            {
              "text": "「徒花」という概念について深く考察する必要があります。",
              "source": "幻辞"
            },
            {
              "text": "「徒花」という概念について深く考察する必要があります。",
              "source": "幻辞"
            },
            {
              "text": "「徒花」という概念について深く考察する必要があります。",
              "source": "幻辞"
            },
            {
              "text": "「徒花」という概念について深く考察する必要があります。",
              "source": "幻辞"
            },
            {
              "text": "「徒花」という概念について深く考察する必要があります。",
              "source": "幻辞"
