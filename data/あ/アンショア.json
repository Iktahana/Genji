        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "料理卓の上にはアンショア（ひしこの塩漬）の三枚におろしたのが昨日からオリーブ油に浸けられている。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは料理家の間にアンショア・ア・ラ・ブレトンヌと名づけられる前菜なのだ。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "基本のアンショア・ア・ラ・ブレトンヌに加減していた味の数学は漸く割り切れた。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上にオリーヴ油のアンショアを乗せ蝦の肉で彩るのだった。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰻も捨てられた、独活も捨てられた――そして「巴里人のアンショア」の名で一つの前菜が新しく生れた。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「巴里のアンショア」の最初の一皿は、ほんの端だけ老翁に味われあとはゴミ桶へ捨てられた。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
