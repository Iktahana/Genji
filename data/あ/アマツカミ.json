    },
    "definitions": [
      {
        "index": 1,
        "gloss": "heavenly gods",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "天津神を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは天津神について学習した。",
              "source": "幻辞"
            },
            {
              "text": "天津神の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は天津神の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では天津神が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "天津神という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に天津神という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では天津神についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "天津神を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると天津神は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "天津神について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では天津神が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に天津神は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により天津神の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "天津神は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に天津神は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "天皇は天津神の子孫であつて、同時に、祝詞を唱へる時だけは、その天津神であつた。",
              "citation": {
                "source": "呪詞及び祝詞",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで神の位が段々昇進するのは、かうした、信仰から来た自然であつて、次第に、天津神に近づかされるのである。",
              "citation": {
                "source": "呪詞及び祝詞",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし違乱に及び候わば、八百万の天津神、国津神、明らかに知ろしめすべきところなり。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が「日本民族」は、実に天津神の後裔たる天孫民族と、これに同化融合した国津神の後裔とが、相倚り相結んで成立したのである。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば神武天皇の大和に土賊を平らげ給うや、天津神の教によりて天神・地祇を崇祭し給い、その位に橿原宮に即き給うや、また天神・地祇を宮中に祭り奉り、特に天津神の代表者と仰ぎ奉るべき天照大神と、大地主神なる倭大国魂神とを、ともに宮中に安置し、殿を同じゅうして崇敬怠り給うことがなかった。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "のみならず天皇は、さらに天社・国社を定め、神地・神戸を奉りて、あまねく天津神・国津神をお祭りになった。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ以て我が「日本民族」が、天津神と国津神とを祖神と仰ぐ両民族の、完全なる融合同化から出来た複合民族であることを、立証したものと謂わねばならぬ。",
              "citation": {
                "source": "「日本民族」とは何ぞや",
                "author": "日本民族の概念を論ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "案ずるに我が天孫民族の国家の発展は、「豊葦原の瑞穂国を安国と平けく治ろしめせ」との天津神の依ざしを受けたものだとの、確乎たる信念のもとに行われた。",
              "citation": {
                "source": "「ケット」と「マット」",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "国津神はすなわち先住民で、その相互の関係は、天津神は父たり、夫たり、国津神は母たり、妻たるの間柄であった。",
              "citation": {
                "source": "「ケット」と「マット」",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　結語　炭焼長者の出世物語は世にありふれた俗伝として、ハハアここにもあるのかと軽く笑ってすます程度のものではあるが、これを民族上より観察すれば、我が国において、天津神の系統と国津神の系統とが、渾然融和して区別なきに至った道筋を示すものとして、尊重せねばならぬものではあるまいか。",
              "citation": {
                "source": "炭焼長者譚",
                "author": "系図の仮托と民族の改良",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が神代の古伝説によっても、天津神系統の天孫民族は現界を掌り、国津神系統の先住民族は、幽界の事を掌ると信ぜられていた。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が日本の国には、神様に天神・地祇という区別がありまして、すなわち天津神・国津神ですが、その天津神とは高天原の神様、すなわち天孫民族の祖神と仰ぐ神様で、国津神とは天孫降臨以前からこの国土におられた神様、すなわち先住民族の祖神と仰ぐ神様です。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "近く明治・大正の御大典の際に於かせられても、大甞祭に悠紀殿・主基殿において、天皇陛下はまず新穀を天津神・国津神に捧げ給うというようなことであります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かく我が皇室の御先祖とます御方々の御系図を拝しまするに、一方では天津神の御系統から天皇、一方には国津神の御系統から皇后と申す様に、両方から相寄って、代々の天皇・皇后がお立ちになっておられます。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かかる次第でありますから、神武天皇が橿原宮に御即位になりまして後に、天津神の代表者として仰ぎ奉るべき天照大神と、国津神の代表者として仰ぎ奉るべき倭大国魂神とを宮中にお祭りになり、崇神天皇の御代までその通りで、代々の天皇殿を同じゅうしてこれを御崇敬になりました。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち元は天津神・国津神の両方を、同じく宮中にお祭りになっておられたのであります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし両者に軽重の区別があると言いますならば、天津神は父、国津神は母、天孫民族は夫、先住土着の民族は婦の関係という位のところであります。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは皇室の御先祖の御事でありますが、一般人民から言いましても、必ず同じ関係があって、天津神の系統を承けている者と、国津神の系統を承けている者と、双方が相寄り相結んで日本民族は出来ている。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって天津神も国津神も、ないし歴史上の偉人・哲士も、ことごとく我々の共同の祖先と申してよろしい。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にも天孫民族というものが一番優勢の地位を占め、所謂天孫降臨の伝説を境として、その前からいたものが国津神系統、新たに高天原から来たものが天津神系統、その後に来たものが海外の帰化人ということに区別されることになりました。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
