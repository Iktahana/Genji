        "examples": {
          "standard": [
            {
              "text": "「悪法もまた法なり」とソクラテスは言い、死刑の判決に従って毒を飲んだとされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「悪法もまた法なり」という考え方をめぐって、法学の授業では毎年激しい議論が交わされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "理不尽な社内規則でも「悪法もまた法なり」と部長は言い張り、部員たちはうんざりした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「法律はそれ自体決して正しいものではない」が、「悪法もまた法なり」というのである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
