        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ペリクレス（Perikles）の師であったアナキサゴラス（Anaxagoras）は紀元前約五〇〇年に小アジアで生れ、ペルシア戦争後アテンに移った人であるが、彼は以上の考えを宇宙全体に適用し、すなわち、宇宙の永遠不滅を唱道した。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナキサゴラスはまた太陰にも生物が住んでいるという意見であった。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "エムペドクレスとアナキサゴラスの次にデモクリトス（Demokrit）が現われた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナキサゴラスの生後約四〇年にトラキア（Thrakien）のアブデラ（Abdera）に生れ長寿を保って同地で死んだ。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "既にアナキサゴラスは恒星の灼熱はエーテルとの摩擦によるものという考えを出している。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れは、當時の目的論者、否な目的論的世界觀の始祖と言はるべきアナキサゴラスが「ヌース」の原理を立て、宇宙秩序を以て『目的』『設計』に基いて成立つて居るとしたのに徹頭徹尾反對して、原子の瞽盲的、機械的の運動によつて一切を説明したるものである。",
              "citation": {
                "source": "學究漫録",
                "author": "朝永三十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
