          "literary": [
            {
              "text": "「アアッ……お父オさア――ン……お母アさ――ン……」　と叫んだが、その声は自分の耳には這入らなかった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのまま、「……アアッ……ああッ……」　と藻掻き狂いながらブクブクブクと沈んで行く。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……グワ――アアッ……」　中野学士のお尻の処の布地が、又野の指の間で破れて、片足が足首の処まで火の海の中へ落ち込んだのであった。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "チーアアップ、チーアアップ！",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "本因坊と私とが一パイのんでいる傍で、にわかに両手で頭をかかえて、「アアッ！",
              "citation": {
                "source": "九段",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "山水楼という旅館に旅装をといたのだが、一風呂あびて部屋に帰ると、アアッと驚いた。",
              "citation": {
                "source": "エキゾチックな港街",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガアアッ、ウオオッ……！",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ガアアッ、ウオーッ……。",
              "citation": {
                "source": "魔法人形",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに応えて、敵方でもワアアッという鬨の声。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここから、親の名を呼んで、何うする気だ』『アアッ……堪忍して！",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
