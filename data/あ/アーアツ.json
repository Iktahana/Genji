        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「お母さん、お母さん、あア、ア、アーアツ」などと云つて、目をさますことは氷川の方にゐた時は一番烈しかつたと思はれたが、この頃では、またその習慣が囘復して來て、夢に見た母の姿を、枕もとに起きあがつてまでも見まはす樣子をする。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アーアツ』　爺の姿が見えなくなるとＭは不精らしく懐手をしたまゝで体をのばしながら大きな欠伸をした。",
              "citation": {
                "source": "監獄挿話　面会人控所",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
