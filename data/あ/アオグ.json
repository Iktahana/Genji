        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この国はエネルギー資源の多くを輸入に仰いでおり、国際情勢の影響を受けやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
