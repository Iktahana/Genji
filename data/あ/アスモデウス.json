        "examples": {
          "standard": [
            {
              "text": "ユダヤ伝承ではアスモデウスは強力な悪魔とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "物語ではアスモデウスが主人公と対峙する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "アスモデウスの名前は多くの文献に登場する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは専ら中世盛んに信ぜられた妖鬼アスモデウスの話に基づき、その話はジスレリーの『文界奇観』等にしばしば繰り返され、殊にルサージュの傑作『ジアブル・ボアトー』に依って名高い。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘブリウの異伝には、アスモデウス身を隠してソロモン王の妃に通ぜしに、王その床辺に灰を撒布し、旦に鶏足ごとき跡を印せるを見て、鬼王の所為を認めたりという。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
