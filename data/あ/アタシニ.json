          "literary": [
            {
              "text": "……ヤ、ヤ、山ナンカ、キョウガ、ハ、ハ、ハジメテナンダ……アタシニハ……カミサンモ……コ、コ、小供モアルンダヨー。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「キットソウニ違イナイヨ、アタシニハチャント分ッテイマス」「アハハハハ、ソンナラ颯子ニ聴イテ御覧ナサイ」「笑ウ人ガアリマスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分ノ胸ニ収メテ置ク」「オ爺チャンハアタシニソンナコトヲシロッテ仰ッシャルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「葉ガ繁ッテヽ絡ミツクワヨ、アタシニ掴マッテラッシャイ」「腕ヲ組マセテクレルトイヽガナ」「ソンナコト無理ダワヨ、オ爺チャンハ背ガ低インダカラ」予ノ左側ニ並ンデイタ彼女ハ、突然右側ニ廻ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソノステッキヲアタシニ貸シテ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナ顔、アタシニ見セタッテ何デモナイワ、ソレヨリ自分デ自分ノ顔ヲヨク見タコトガオアリニナルノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ハイ、ハイ、オ爺チャン、アタシニドウシロッテ仰ッシャルノヨ、何デモスルカラ仰ッシャッテヨ」ト、ソウ来テクレヽバ締メタモンダガ、迂闊ニソウハ云イソウモナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フヽン、アタシニ何ヲサセヨウッテ仰ッシャルノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ理由ハアタシニハヨク分ラナイガ、オ爺チャンコソ何カシラ感ヅイテイラッシャルノデハナイデショウカト、乙ニ絡ンデ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
