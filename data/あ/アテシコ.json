          "literary": [
            {
              "text": "「それが、アテシコだ。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテシコを伝わって臀部へ少々感じがあった。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテシコの利目は、ここで始めて分った。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分がアテシコを臀に敷いて、深い坑のなかで、カンテラを提げたまま、休んだ時の考えは、全く芝居じみていた。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテシコはこう云うときに非常に便利になる。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "アテシコを尻に敷いて、休息した時は、始めから休息する覚悟であった。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分はどさっとアテシコを俵の上に落した。",
              "citation": {
                "source": "坑夫",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
