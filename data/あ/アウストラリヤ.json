        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "同様の神話は、「アウストラリヤ」土人の間にも之あり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アウストラリヤ土人の如きは現在の石器時代人民の一例にして本邦諸地方に石の矢の根、石の斧等を遺したる者は過去の石器時代人民の一例なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼のアウストラリヤのクヰンスランド土人の如きは實に食人人種の好標本なり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是等の事はアウストラリヤ、クインスランド土人の現状に徴して推考するを得るなり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "亞米利加土人中ノ或者、「アウストラリヤ」土人、「ニウギニヤ」土人、「アンダマン」土人等ハ石器使用中ニ開明國人ニ接シテ鐵器ノ用ヲ知レリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
