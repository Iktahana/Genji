          "literary": [
            {
              "text": "ジャパン・アドバタイザーの女記者アメリカ人のミス・何とかいふのが来り、インタヴィウ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "原注一四　ストーン大佐編集のニューヨーク、『コマーシャル・アドヴァタイザー紙』。",
              "citation": {
                "source": "マリー・ロジェエの怪事件",
                "author": "『モルグ街の殺人事件』続編",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般大衆がミスカトニック大学調査隊を知っているのは、『アーカム・アドヴァタイザー』誌やＡＰ通信向けに頻繁に行った無線による報告を通じてであり、また後になってピーボディと私が書いた論文を通じてである。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の大型無線機は外界との交信を行い、報道機関向けのレポートをマサチューセッツ州キングスポート岬にあるアーカム・アドヴァタイザー紙の強力な無線局に送信するものとなっていた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
