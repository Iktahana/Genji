        "examples": {
          "standard": [
            {
              "text": "昔の運動会では、母親が作った合の子弁当を食べるのが何よりの楽しみだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "合の子弁当には、ご飯の横にハンバーグやエビフライなど、子供が喜ぶおかずが入っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "大正時代の小説に、子供が合の子弁当を嬉しそうに開く場面が描かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "下谷の新梶へ寄り、飲み、合の子弁当食って帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
