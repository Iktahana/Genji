          "literary": [
            {
              "text": "さうして海浜のすぐ近くに網がいくつも立てられてゐて、蟹をはじめ、イカ、カレヒ、サバ、イワシ、鱈、アンカウ、さまざまの魚が四季を通じて容易に捕獲できる様子である。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この町では、いまも昔と変らず、毎朝、さかなやがリヤカーにさかなを一ぱい積んで、イカにサバだぢやあ、アンカウにアオバだぢやあ、スズキにホツケだぢやあ、と怒つてゐるやうな大声で叫んで、売り歩いてゐるのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
