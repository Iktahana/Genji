        "examples": {
          "standard": [
            {
              "text": "大雪で足止めを食ってしまい、駅で一夜を明かすことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "荷物の紛失で足止めを食った乗客たちが駅員に詰め寄った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "予定していた出張で足止めを食うことになり、やることなく待合室で時間をつぶした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "しかしその復讐のために堂島を探して銀座に出るなどと話したら、直に足止めを食うに決まっている――加奈江も明子も口に出さなかった。",
              "citation": {
                "source": "越年",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に急ぎの用事があるわけではないが足止めを食うというのは気の滅入ることだ。",
              "citation": {
                "source": "ＵＶ",
                "author": "石塚浩之",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
