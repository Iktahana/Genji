        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "プロレスの試合で、激しい足固めが極まってギブアップを奪った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "寝技の練習で、足固めからの展開をコーチに教わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "相手の足固めから抜け出せず、そのままピンフォール負けを喫した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
