[
  {
    "uuid": "ae409fe5-80c4-54a0-a4c2-3821b332ba7d",
    "entry": "ありがた迷惑",
    "reading": {
      "primary": "ありがためいわく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "形容動詞"
      ],
