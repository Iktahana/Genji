        "examples": {
          "standard": [
            {
              "text": "庭に植えた朝熊黄楊は樹形がコンパクトで手入れしやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "朝熊黄楊の盆栽は樹齢が高く、何十年も愛でられてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "春の新しい葉が朝熊黄楊を鮮やかに彩っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "円形に苅り込んである「あさまつげ」の木を見れば、そのこんもりした緑の中にも秘密が蔵してありはせぬかと疑はれた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "己はこれを眺めながら、あさまつげの苦味のある香と、柑子の木の砂糖のやうに甘い匂とを吸つてゐた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
