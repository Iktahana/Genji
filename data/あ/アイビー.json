        "examples": {
          "standard": [
            {
              "text": "古いレンガ造りの校舎には、青々としたアイビーが壁を覆っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "部屋の窓辺にアイビーの鉢植えを置くと、涼しげな雰囲気になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "家の壁を伝って伸びるアイビーが、趣のある風景を作り出している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "アイビーできれいにまとめていて、ほんとにかわいい。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
