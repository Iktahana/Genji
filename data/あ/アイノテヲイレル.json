        "examples": {
          "standard": [
            {
              "text": "漫才師の軽快なトークに、相方が絶妙なタイミングで合いの手を入れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "友達の恋愛話を聞きながら、時折「わかるわかる」と合いの手を入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "宴会で部長が歌い始めると、若手社員が一斉に合いの手を入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「まったく今日このごろはひでえ不景気でして、ねえ、へッ、子供と遊んでてたいした月給を貰えるけっこうなお身分には不景気は素通りでしょう、が、さ」すると親爺が一声合いの手を入れるのであった。",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "土をうつ水滴が、二人の会話に奇妙な合いの手を入れる。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            }
          ]
