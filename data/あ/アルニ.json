    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "歐米婦人ノ愚味ナル多辯、支那婦人間ノ強奸ナル口論ヲ見タル者ハ日本婦人ノ正道ニ發達シツヽアルニ感謝セン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "要スルニ有罪ヲ假定スルガ故ニ未決期ノ日數ヲ刑期ニ加算スル等ノコトアルニテ明カナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "末節枝葉ニ於テ如何ナル非難アルニセヨ、朝鮮ハ露西亞ノ玄關ニ老婆ノ如ク窮死スベカリシ者ヲ、日本ノ懷ニ抱カレテ少女ノ如ク生長シツツアルハ之ヲ無視スル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "河野系圖、豫章記、越智氏累世居伊豫、支族蕃滋云々、而河野氏尤著河野系圖」トアルニ由リテ、ソノ子致命ヲ子致彦トシテ、狗古智卑狗ニ附會シタルナリ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又國造本紀ニ「久努（遠江國山名郡久努郷）國造、筑紫香椎朝代、以物部連祖伊香色男命孫、印播足尼定賜國造」トアルニ由リテ、「河野は初め久努に作る。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "又「男子爲王」ハ、下文ニ、男王卑彌弓呼トアルニ由リテ、日韓古史斷ハ、卑彌弓ヲ日子ト讀ミテ、「伊豫國造の皇別より出でゝ、當時來りて其の國を鎭めたまへるを謂ふに似たり。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "草野の頂は、ややなだらかに南へ開いて、そこに横たわる岩の蔭に、黄金色のアルニカ Arnica montana が立派に咲いている。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ初學ニハ差支アルニ非ズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ唯本邦學術ノ沿革ニ據テ之ヲ考フレバ、少シク顧ミザル可ラザル者アルニ似タリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ今摸傚ノ弊ヲ矯メムト欲セバ、何如ナル道ニ從事スベキヤト云フニ、余ガ見ル所ニテハ、唯二道アルニ過ギズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "枕山は「アヽ上人ノ先考ニオケルヤ半面ノ識アルニ非ズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "成島柳北があたかもこの年の秋に著した『柳橋新誌』第一編にお菊の事を記して、「彼ハ傾国ノ色絶世ノ技アルニ非ラズトイヘドモ、繊繊タル女手ノ力ヲ以テ大ニ巨閣高楼ヲ墨水ノ西ニ営ミ、扁シテ有明楼トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔訳者注――ベッティーナ・ブレンターノ（後にアルニムの妻）はドイツ浪漫主義時代の問題的な性格と見なされて来た。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "日曜デアルニモ拘ラズ、浄吉ガ午後羽田カラ立ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二〇五カ六カ、一〇カ、或ハ二二〇以上アルニ決ッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ先祖ハ遠イ昔ハ江州商人ノ出ラシイガ、四五代前カラ江戸ニ住ミ、予モ本所割下水ニ生レタノデ、生粋ノ江戸ッ子デアルニ違イナイ、ガ、ニモ拘ワラズ予ハ近頃ノ東京ガ面白クナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出発以来四日間、近頃ニナク活動シ、ソノ間ニ面倒ナ日記ヲツケタリシタノデ、予自身休養ノ必要ガアルニハアッタガ、今日一日ダケ佐々木ニモ暇ヲ与エル約束ガシテアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コレハ相馬氏ニハ内証デ、自分デ施シテイルノデアル）シカシ自分ガ珍シクモカヨウニ旺盛ナ状態ヲ維持シ得テイルノハ、恐ラク薬剤ノ利キメヨリモ主トシテ精神的興奮ノシカラシメルトコロデアルニ違イナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「適当ナ場所ガアルニ委シイ人ニ聞イテ上ゲタノヨ」ソウ云ッテ敏子ハ、「パパ、少シイカガ」ト、クルボアジエヲ注イデ出シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………自分ノ頭脳ガ日ニ日ニ駄目ニナリツツアルニノミ熱中シテイタラ、イツノマニカ淫慾以外ノスベテノヲ五分ト考エツヅケル根気ガナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "先帝　吉野ニ於テ崩御ノオ聞エアルニ依テ　と、七日間の政務の停止を告げ、宴遊｜鳴物は申すにおよばず、公私とも、一切を謹んで哀悼すべし、ともつけ加えた。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            }
          ]
        }
