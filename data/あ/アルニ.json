  {
    "uuid": "3ee4e3f6-d66c-5fd9-afa4-d36008cfc352",
    "entry": "アルニ",
    "reading": {
      "primary": "あるに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
