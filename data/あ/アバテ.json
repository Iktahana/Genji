        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "名をば「アバテ」ハツバス・ダアダアとなんいひける。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハツバス・ダアダアは日ごとに我を顧みて、ことしは「アバテ」の位受くべき歳ぞと、いましめ顏にいふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "是れ久しく夢みし「アバテ」の服ならずや。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男は歌女に初對面なりといふ「アバテ」一人と外國うまれの樂人一人とを伴へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは「アバテ」となりぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々は我を「アバテ」と喚べり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アバテ」も暫く我と共に留まり給へ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アバテ」はいかに思ひ給ふといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そは「アバテ」の天才より産まれし思想中の最も惡しきものなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "マリアは忽ち容を改めて、「アバテ」の君と呼び掛けたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アバテ」の君、我はおん身に語るべきことあり、此會談は我が瀕死の人と結びし約束の履行なり、日ごろ疎からぬおん身に聞かせまつることながら、これを語る苦しさをば察し給へといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
