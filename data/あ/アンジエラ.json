        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ステンダールは十八の年伊太利のミラノでアンジエラ・ピエトラグルアを見た。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の心はアンジエラに對する熱情的な戀によつて、「地上から夢の國に――最も天國的な、最も尊い戲謔圖中に高められた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」しかし當時のアンジエラには他の戀人達がゐた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ステンダールはその後十一年の間、他の女と共に居りながらもアンジエラのことが忘れられなかつた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その十一月二日彼は當時他人の妻なるアンジエラと、街の灯の下に肩を並べて歩きルトの發生に適してゐるが、和製ドン・ホアンの發生には適してゐないらしい。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」さうして彼は妖婦アンジエラの美しさの中に人間以上のものを見た。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジエラは彼にとつて「崇高な」妖婦であつた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
