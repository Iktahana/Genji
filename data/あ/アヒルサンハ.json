          "literary": [
            {
              "text": "ナゼトイヘバ、アヒルサンハ赤イモノナラ、ドンナモノデモ大キラヒダカラデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヒルサンハ、ハヅカシクテ穴ガアツタラハイリタイト思ヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　アヒルサンハ、マツカニナツテイヒマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヒルサンハ大ヨロコビデ自分ノ洋服トトリカヘマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、オネコサンハ似合ヒモシナイ洋服ヲキテ得意デスシ、アヒルサンハアカダラケノクサイ洋服ヲキテ大ヨロコビナノデ、誰デモ二人ヲミルト、ワラツタリ、ハナヲツマンダリシマシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二　アヒルサンハ、三匹ノコグマサンニ、イヒマシタ。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
