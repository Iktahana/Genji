        "examples": {
          "standard": [
            {
              "text": "疲労困憊して階段を下りていたら、足がもつれて転びかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "暗い廊下で足がもつれ、壁に手をついて何とか立ち直った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "泥酔した状態で足がもつれながら歩いている人を見かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "心臓の響きが頭にまで伝わって来る、足がもつれる。",
              "citation": {
                "source": "いのちの初夜",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "足がもつれるほど走りつづけて、ようやく岬の家並を見たときには、松江のひざはがくがくふるえ、肩と口とでいきをしていた。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしばらく歩かなかったもんだから、足がもつれる」「病院ですか。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし三十メートルほど行くと、さすがにくたびれて、足がもつれる。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
