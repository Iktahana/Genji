        "examples": {
          "standard": [
            {
              "text": "パトカーの屋根で回転する赤ランプが、夜の住宅街を不気味に照らしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "工場の機械に異常が発生し、制御盤の赤ランプが激しく点滅し始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この赤ランプがついている間は、決して扉を開けないでください」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "遠く微かに船の形らしいものが浮かんで、檣頭燈とサイドの赤ランプと、それに甲板の灯が二つ三つ、水平線上の星に紛れて、少さくぼんやりと瞬いて見える。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "後日、海事法廷で Stone と Gibson は証言して「その舷側の赤ランプが高い所に見えた様子が如何にも妙で unnatural なので、思わずはっとして凝視めた」と言っている。",
              "citation": {
                "source": "運命のＳＯＳ",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "咲き出でた交番の赤ランプはおまへの看護には過ぎたるものだ。",
              "citation": {
                "source": "橋の上の自画像",
                "author": "富永太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パイロットの赤ランプが点いているじゃありませんか、さあこれから、すこし面倒な実験をやります。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは職務という観念があるので、初めよりも更に迅い速度でそこを駈け出して、自分の赤ランプでトンネルの入り口の赤い灯のまわりを見まわしたのち、その赤い灯の鉄梯子をつたって、頂上の展望台に登りました。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "信号手",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の道路工事か水道工事なら、こんな道の真中に危険な穴をあけたまま放っておく筈がなく、少なくとも周囲に繩をまわし、赤ランプをつけて置く筈なのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
