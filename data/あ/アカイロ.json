        "examples": {
          "standard": [
            {
              "text": "戦後、赤色勢力を警戒する風潮が強かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その団体が赤色と見なされて監視されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "冷戦中、赤色的と言われることは危険だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
