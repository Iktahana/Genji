        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "秋の末にもなりたれば、籐筵に代うるに秋野の錦を浮織にせる、花毛氈をもってして、いと華々しく敷詰めたり。",
              "citation": {
                "source": "琵琶伝",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「古昔寧楽朝山上憶良詠秋野花草七種。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "余因賦秋野花草七種詩。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　健は平然として卓隣りの秋野といふ老教師と話を始める。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "検定試験上りの秋野は十三円で、古い師範出の校長は十八円であつた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時半頃、秋野教師が遅刻の弁疏を為い／＼入つて来て、何時も其室の柱に懸けて置く黒繻子の袴を穿いた時は、後から／＼と来た新入生も大方来尽して、職員室の中は空いてゐた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分とも経たぬうちに、今度は秋野がその鐘索を引いて、先づ控所へ出て行つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋野は其間を縫つて歩いて、『先の場所へ列ぶのだ、先の場所へ。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "渠は緩りした歩調で階段を降りて、秋野と共に各級をその新しい場所に導いた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、十年もこの学校にゐる土地者の秋野が喙を容れた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、秋野は鉛筆を削つてゐる。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、秋野は言つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、手づから椅子を引寄せて、遠慮もなく腰を掛け、校長や秋野と二言三言話してゐたが、何やら気の急ぐ態度であつた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　秋野も校長も孝子も、鳴を潜めて二人の話を聞いてゐた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、秋野は初めて知つたと言ふ態に言つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、秋野と東川が同時に言つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈何なさらうと、それは貴方の御権限ですが……』と言ひながら、傍から留めた秋野の言葉は聞かぬ振をして、自分の席に帰つて来た。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋野は煙管の雁首を見ながら煙草を喫んでゐる。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "それア何でごあんす……』と言つて、安藤は密と秋野の顔色を覗つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋野は黙つて煙管を咬へてゐる。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "月給から言へば、秋野は孝子の上である。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋野が預るとすると、男だから、且つは土地者だけに種々な関係があつて、屹度何かの反響が起る。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "『秋野先生、』と言ひながら、胡麻塩頭の、少し腰の曲つた小使が入つて来た。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、秋野は小使と一緒に出て行つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "檢定試驗上りの秋野は十三圓で、古い師範出の校長は十八圓であつた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時半頃、秋野教師が遲刻の辯疏を爲い／＼入つて來て、何時も其室の柱に懸けて置く黒繻子の袴を穿いた時は、後から／＼と來た新入生も大方來盡して、職員室の中は空いてゐた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "五分とも經たぬうちに、今度は秋野がその鐘索を引いて、先づ控所へ出て行つた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
