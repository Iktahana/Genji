          "literary": [
            {
              "text": "モンコチヤンノオ父サンハボンコチヤンガカハイサウニナリマシタカラ、クワイ中電燈ヲモツテ、ワンコチヤンヲツレテ、ボンコチヤンヲサガシニユキマシタケレド、アタリハマツクラ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝アタリハ空気ガ乾燥シ、老人ノ喉ガカラ／＼ニ干｜涸ビ、風邪ヒキ加減ニナッテイルセイデ、呼吸ガ喉ヲ入ッタリ出タリスル度毎ニピイピイト云ウ音ヲ発スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佛印アタリハ宝石ノ値ガ安インデスカラ、佛印デ二百萬圓ダッタラ日本ヘ持ッテ来レバ倍以上ニナルデショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
