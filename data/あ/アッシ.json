    "definitions": [
      {
        "index": 1,
        "gloss": "death by crushing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日、圧死について考えています。",
              "source": "幻辞"
            },
            {
              "text": "我が社の圧死戦略は重要です。",
              "source": "幻辞"
            },
            {
              "text": "圧死の原理は複雑である。",
              "source": "幻辞"
            },
            {
              "text": "圧死という言葉が頭から離れない。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは圧死について学んでいる。",
              "source": "幻辞"
            },
            {
              "text": "圧死の治療方法は多様である。",
              "source": "幻辞"
            },
            {
              "text": "圧死に関する法律が改正された。",
              "source": "幻辞"
            },
            {
              "text": "選手たちは圧死を目指している。",
              "source": "幻辞"
            },
            {
              "text": "自然界での圧死は見事である。",
              "source": "幻辞"
            },
            {
              "text": "歴史上、圧死は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "圧死は日本文化の一部である。",
              "source": "幻辞"
            },
            {
              "text": "旅行中に様々な圧死を見つけた。",
              "source": "幻辞"
            },
            {
              "text": "「圧死」という概念について深く考察する必要があります。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "同君は、その後帰朝して、過般の大震災で、鎌倉で圧死の不幸に遭われた、他の二人は、野坂滋明君と国府精一君とである、今は米国と日本に別れていて、共に健在である。",
              "citation": {
                "source": "火と氷のシャスタ山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし今度襲われる地方がどの地方でそれが何月何日ごろに当たるであろうということを的確に予知することは今の地震学では到底不可能であるので、そのおかげで台湾島民は烈震が来れば必ずつぶれて、つぶれれば圧死する確率のきわめて大きいような泥土の家に安住していたわけである。",
              "citation": {
                "source": "災難雑考",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、大きな岩と見えるものが墜落して来て、その下敷きになって一人の人間が隠れればその人はほんとうに圧死したものと考えられるのである。",
              "citation": {
                "source": "映画の世界像",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "夥しい書籍が――数百枚の重い粘土板が、文字共の凄まじい呪の声と共にこの讒謗者の上に落ちかかり、彼は無慙にも圧死した。",
              "citation": {
                "source": "文字禍",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "火は警視庁を焼き、帝劇を焼き、日本橋、京橋、浅草を焼き、本所深川を一舐めにして、圧死者の上へ無数の焼死者を出したという恐ろしい噂がきれぎれに耳へ入った。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "色の黒い※野な顔をした田舎武士は、安政乙卯の年十月二日の午後十時、かの有名な安政の大地震に逢って、母を救い出そうとして家の中へ入ったところで、家が潰れて圧死した。",
              "citation": {
                "source": "死体の匂い",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元慶元年四月の地震には、京中を垣墻悉く破壊し、宮中の内膳司屋顛倒して、圧死者を出した。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つぎの地震は、山城、摂津、和泉の諸国の大地震で、伏見城の天守が崩壊して圧死者が多かった。",
              "citation": {
                "source": "日本天変地異記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "圧死焼死相継ぎ、悲惨とも無慙とも言ひやうがなかつた。",
              "citation": {
                "source": "竹林生活",
                "author": "――震災手記断片――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、かの桐沢氏は、その当時あたかも鎌倉の別荘に在った為に、無残の圧死を遂げたという。",
              "citation": {
                "source": "深見夫人の死",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの一ケ年間あらゆる角度から、千差万別の批評をなげかけられてきた、もし私に真理を信奉する不屈な負け嫌ひな態度がなかつたならば、私はいまこの詩集を世に出すに先立つて、私は世間的な批評の重石で、ぺちやんこに圧死してゐたであらう。",
              "citation": {
                "source": "小熊秀雄全集-4",
                "author": "詩集（３）小熊秀雄詩集１",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて狭い竪坑の出口で圧死者などの出ないように、最も統制のとれた避難準備にとりかかった。",
              "citation": {
                "source": "坑鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、鎌倉で、親密な叔母と一人の従弟が圧死したことを知った。",
              "citation": {
                "source": "私の覚え書",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェトに忠実な二人の活動家は圧死した。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "落盤はいつ起って君らを圧死さすかもしれぬ。",
              "citation": {
                "source": "ドン・バス炭坑区の「労働宮」",
                "author": "――ソヴェト同盟の労働者はどんな文化設備をもっているか――",
                "note": "青空文庫"
              }
            },
            {
              "text": "鎌倉から小南の兄かえり、叔母上、季夫圧死し、仮埋葬にした由　七日　午後Ａ来。",
              "citation": {
                "source": "大正十二年九月一日よりの東京・横浜間大震火災についての記録",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと心づき「お話ししなければならないことがある」と云ってやって来、叔母、季夫が圧死し、咲枝、一馬に助けられ、材木座の八百屋わきのトタン屋根の仮小屋に避難した由を云う。",
              "citation": {
                "source": "大正十二年九月一日よりの東京・横浜間大震火災についての記録",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って、私が方々を流浪しつづけていた間も、彼女が嫁いださきの有名な実業家のことを常に注意していたので、其の男が、あの関東の大震災の時無残にも圧死し、彼女を除く外、彼女の里のものまで殆ど全部死んでしまったことを知っていたのです。",
              "citation": {
                "source": "悪魔の弟子",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わづかに彼が身じろぎをしただけで全世界は震動し、至るところで多くの人家が倒壊して、人々が圧死を遂げた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこれらの飛行機もここの露台から眺めたことがあるが、家を突き抜いた食物で圧死した捕虜もある。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰も彼も、下敷になった二人は圧死したものと思っていたが、甲子の外には涙を流す者もなかった。",
              "citation": {
                "source": "九月一日",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　圧死した二人は、その上に海嘯にさらわれたものと想像していたが、それだけは免かれたのを知った。",
              "citation": {
                "source": "九月一日",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "剣つきの銃をにない、三十人ばかりひとかたまりになって行進していると、その銃剣の穂に大きな雷が落ちて、全員圧死してしまったこともあるとか。",
              "citation": {
                "source": "牛乳と馬",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所へ落ちた爆弾のために防空壕の七人が圧死したことがある。",
              "citation": {
                "source": "わが戦争に対処せる工夫の数々",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "◯護国寺裏の町に爆弾が落ちて、壕内に入れておいた二歳と五歳の幼児が圧死し、母親は見張中であって助かった由。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の損害は、前の防空壕に一方より圧力がかかって壕がくずれ、上からは土砂が落ち、赤ちゃん一名圧死。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "◯水の公園では押されて人々が倒れると、その上に将棋だおしとなって多勢が圧死し、そこへ火が来て、一層凄絶なこととなった。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "倉知の叔母上、季夫、不幸な圧死をしたことを知る。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一藩の指導者は二人とも圧死を遂げた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明ける迄あっしの処でお休みなすっちゃ如何で御座います」　「……そうだな。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
