        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "妻子には、トクトウニカハツタ、イマヨコハマヨリ二〇〇ノツト、イチロヘイアン、アア、ヒロイウミ、アヲイウミ　また、ある東京の友人にはこうも打った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、それはかまはないのですが――」義雄が默讀して見ると、「イマタツアヲモリマテムカヘニコイ。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドノ　ムラニモ　アマリ　ヒトハ　ヰナイデ、ノコツテ　ヰル　ヒトビトハ　ミナ　アヲイ　ヤツレタ　カホヲ　シテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカヤ　アヲヤ　キイロヤ　ムラサキヤ、イロイロナ　フウセンダマハ　ホホヲ　スリヨセナガラ　カゼノ　フク　ハウヘ　ナビイテ　ヰマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミスヂ其他（２）アゲハ……クロ（５）キ（３）カラス（７）ジヤコウ（６）アヲスヂ（３）△鞘翅。",
              "citation": {
                "source": "真夏の朝のひとゝき",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "己（バルタザル）は情人バルビさんと一しよにスキアヲニ河の岸に立つてゐた。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "己は忽然として又リワ・スキアヲニに立つてゐる。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヲヘビといふ小さな毒蛇の攻撃を予防するためとわかつた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬の性は白を本とするといったから、当時アヲウマと云って、白馬を用いていたという説もあるが、私には精しい事は分からない。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、浴室ノドーアヲノックシテ、「チョット、コヽ締メルワヨ」ト云ウ声ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜八時半頃、ノックヲセズニ恐ル／＼ドーアヲ開ケル者ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "横杵は大きいからアヲという土地もある。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヲカテ　陸中東磐井地方で青カテと謂つて居るのは、大根の葉の鹽漬にして貯へられたものゝことである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヲモノトリ　野菜のもと野生であつたことは文字からでもわかる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヲヤ　栽培する蔬菜にも青物といふ名を延長し、之を鬻ぐ店を青物屋といふことは、東日本一般の風であつたが、東京などはいつの間にか之をヤホヤといふやうになつた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヲクサヤ　加賀の金澤などは、所謂八百屋を青くさ屋と謂つて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "グヮンザン　熊本では澁柿のアヲシ柿に對して、木ねり、木ざはしの柿をグヮンザンと呼んで居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シラニギテはコウゾ、アヲニギテはアサ。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヲズリは、青い染料をすりつけて染めること。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この神がシキヤマヌシの神の女のアヲヌマヌオシ姫と結婚して生んだ子は、ヌノオシトミトリナルミの神です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "また河内のアヲタマの女のハニヤス姫と結婚してお生みになつた御子はタケハニヤス彦の命お一方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天皇、葛城のソツ彦の子のアシダの宿禰の女の黒姫の命と結婚してお生みになつた御子は、市の邊のオシハの王・ミマの王・アヲミの郎女、又の名はイヒトヨの郎女のお三｜方です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
