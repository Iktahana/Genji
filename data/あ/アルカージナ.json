        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゆうべだって、わざと一晩じゅう、テラスに出てらしたり……ドールン　（口ずさむ）「言うなかれ、君、青春を失いしと」（訳注　ネクラーソフの詩の一節）ポリーナ　あなたは、アルカージナさんと話に身が入りすぎて……つい寒いのも忘れてらしたのね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナがソーリンと腕を組んで、つづいてトリゴーリン、シャムラーエフ、メドヴェージェンコ、マーシャが登場。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　あなたはいつも、大昔の人のことばかりお訊きになるのね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台の下落ですな、アルカージナさん！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（息子に）ねえ、うちの坊っちゃん、一体いつ幕があくの？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（『ハムレット』のセリフで）おお、ハムレット、もう何も言うてたもるな！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　どうともご随意に。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（小声で）なんだかデカダンじみてるね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "見るも怖ろしい、あの火のような二つの目……アルカージナ　硫黄の臭いがするわね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（笑って）なるほど、効果だね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　それはね、ドクトルが、永遠の物質の父なる悪魔に、脱帽なすったのさ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　お前、何を怒るのさ？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕が……いや、僕なんか……（まだ何か言いたいが、片手を振って、左手へ退場）アルカージナ　どうしたんだろう、あの子は？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　わたし、あの子に何を言ったかしら？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　あの子は、これはほんの茶番劇でと、自分で前触れしていましたよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーリン　まあさ、それにしたって……アルカージナ　ところが、いざ蓋をあけてみたら、大層な力作だったわけなのね！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　おや、そう？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　そんなら勝手に、書きたいことを、書けるように書くがいいわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドールンはこの句で、暗にアルカージナを諷したのであろうが、彼女は気づかずに――）アルカージナ　わたしはジュピターじゃない、女ですよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　ごもっともね。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）アルカージナ　（トリゴーリンに）ここへお掛けなさいな。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　ええ、お願い。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アルカージナおよびポリーナとキスを交す）ソーリン　ブラボー！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　ブラボー！",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　そんなことあるもんですか。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニーナ　まあ、うれしい……（どぎまぎして）いつもお作は……アルカージナ　（彼女を自分のそばに坐らせながら）そう固くならないでもいいのよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　（笑い声を立てて）そんなこと言わないほうがいいわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　どこへいらっしゃるの？",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルカージナ　なんてパパでしょうね、ほんとに……（キスを交す）じゃ、仕方がないわ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
