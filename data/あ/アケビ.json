  {
    "uuid": "16ec148c-4c59-53db-ab07-674974a73fda",
    "entry": "通草",
    "reading": {
      "primary": "あけび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
