          "literary": [
            {
              "text": "シカシ　ツボミタチハ　ウマガ　ドンナ　モノデ　アルカモ　シツテ　ヰマセン。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ旧作執筆ノ年代ニハ記憶ノ誤ガアルカモ知レナイ。",
              "citation": {
                "source": "正宗谷崎両氏の批評に答う",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンモ団十郎ノハ見タコトガアルカモ知レナイガ、記憶ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ爺サンハ発狂シテルノデハナイカト、思ワレルダケデモ極マリガ悪イ）予ハコヽマデ思イ詰メテ、コヽニ一ツノ可能ナ方法ガアルカモ知レナイコトニ気ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ事実デハナク、僕ノ単ナル妄想デアルカモ知レナイガ、デモソノ妄想ヲ僕ハ無理ニモ信ジタカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
