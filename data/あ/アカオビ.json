        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は空手道場に通い続け、ついに目標だった赤帯を締めることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "大会の決勝戦で、赤帯を締めた選手が鋭い上段蹴りを決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "道場の壁には、入門したばかりの白帯から師範代の赤帯までが順に飾られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
