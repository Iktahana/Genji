        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "火星の薄いアトモスフィアでは、液体の水が地表に安定して存在することは困難だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "地球のアトモスフィアは、オゾン層によって太陽からの有害な紫外線を効果的に遮断している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "温室効果ガスの増加は、地球のアトモスフィアの熱バランスに影響を与えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その隠れ家のようなカフェは、温かい照明と心地よい音楽で、リラックスできるアトモスフィアを作り出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「このパーティー、なんだかワクワクするアトモスフィアだね！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プレゼンテーションの質疑応答では、鋭い質問が相次ぎ、場は一時的に緊迫したアトモスフィアに包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その画家の作品は、憂鬱でありながらもどこか神秘的なアトモスフィアを湛えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "高原地方のアトモスフィアを、これほど鮮明に、印象強く、しかもパノラマ的展望で書いた俳句は外にない。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの句において、蕪村は或る心象的なアトモスフィアと、或る縹渺とした主観の情愁とを、白という言葉においてイメージさせている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならその古机でさへが、やはり彼の居間の中で、彼の家族たちと一緒に、彼の構成してゐる家のアトモスフィアの中でのみ、始めて藝術的に美しく調和するので、單獨に引き離してしまつては、普通の平凡なガラクタ道具に變つてしまふからである。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの家では、妻と子供と主人とが、一家協力して或る特殊な樂しいアトモスフィアを、具體的に構成してゐるやうに思はれる。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が始めて気付いたことは、こうした町全体のアトモスフィアが、非常に繊細な注意によって、人為的に構成されていることだった。",
              "citation": {
                "source": "猫町",
                "author": "散文詩風な小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんな男の話まで聞かせて全体のアトモスフィアをこわすのは、一種の政略の失敗に帰したものか。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（『文芸』はうちへかして頂きましょうね）しかし、あの插画の木村荘八亜流をみて、歴史（明治初期）という空気が、ああいうアトモスフィアで好事的にランプ的に見られているのは不十分であり、それは変りにくいということを感じます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚愕して飛びあがつたやうな町は、かかる苦悶そのもののアトモスフェアを突き破らうとでもするかのやうに必死となつてゐます。",
              "citation": {
                "source": "トレドの風景",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者のほうは容易に説明のできる小細工のおもしろみであるに対して、後者のほうには一口には説明のできない深い暗示があり不思議なアトモスフェアがあるのである。",
              "citation": {
                "source": "映画雑感（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の幼いころは今日よりも交通不便であったが、却って落ちついた文化的アトモスフェアが田舎の町や村をつつんでいたようだ。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（この三人の作るアトモスフェア、安価だ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大変実際的な落ち付いた観察を以て終始していることによって、或る一つの纏まったアトモスフェアをハッキリと醸し出している。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "寧ろアトモスフェアが出来上り過ぎてさえいないかということが気にかかる程だ。",
              "citation": {
                "source": "読書法",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、この日本的共同体社会生活が、世界中の社会の（人類の倫理の）模範であるかのような感じを、アトモスフェアーを、興奮を、つくり出すことだ。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "――唯物論的世界観は世界観としてのヒューマニズムと、可なり対立したアトモスフェアを持っていることに、もう少し注目することが必要だ。",
              "citation": {
                "source": "現代唯物論講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々が何かの事物を具体的に観察し遺漏なく捉えようとすると、必ずその事物の内部と周囲とに一種のアトモスフェアが発生するのであるが、このアトモスフェアがすでに文学的なものであって、往々ユーモアと呼ばれている処のものだ。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上のような生活は、現象として見れば一切の生活材料が出揃って羅列され、雑然とした一種のアトモスフェアを造り、やがて一種虚無的なケオスを造り出す。",
              "citation": {
                "source": "思想としての文学",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、吏道とは単なる官吏服務規律遵守からそれ以上のものとして発散する、否発散せしめようと欲する、何等かのアトモスフェアか臭いか何ぞの類のものを指すのである。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、一種のアトモスフェアがあつて、それが全體を導いて行くやうにしたい。",
              "citation": {
                "source": "手紙",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ある感情の展開に必要なアトモスフェア」を作り出すためになのだ。",
              "citation": {
                "source": "レエモン　ラジィゲ",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "叡智と趣味高き人々の永遠のふるさとなる店、二〇・五世紀のささやきとアトモスフェアの店、その甘き風味の店、「さゝの枝」こそあなたの訪れを待つ。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "新時代のうごき、新しいアトモスフェア、知性的新人ですわね、そういった理解はゼロに等しいと思ったんです。",
              "citation": {
                "source": "ニューフェイス",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "仙人掌の聯想の奧から、まづ第一に、或る老人の顏面が潮氣をふくんだ夕影のしつとりとしたアトモスフェアの中に現れてくる。",
              "citation": {
                "source": "仙人掌と花火の鑑賞",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリの国立音楽院管弦楽団（ソシエテ・デ・コンセール）は、楽員の優秀さと、フランス的なアトモスフェアを持つこと、他の民間団体の比でないことは言うまでもない。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆愚はアトモスフェアで左へゆき右へ動く。",
              "citation": {
                "source": "革命を待つ心",
                "author": "――今の實業家、昔の實業家――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
