          "literary": [
            {
              "text": "「この戦争で殺された、百万人の男よ女よ……」　アポリネェルの〈金色のアポロ〉の弔詩が頭にひらめく。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "アポリネェルから文句がくるわけでもあるまいし。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはたぶんアポリネェルの詩だったと思います。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "アポリネェルやヴァレリィの詩の飜譯もうまいと思つた。",
              "citation": {
                "source": "芥川比呂志",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
