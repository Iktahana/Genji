        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "汝等の国は近々にも訪れたいのだが予は、いつか生れて初めてマナヅルからアタミまで船に乗つた時に悶絶せんばかりに苦悶した経験を持つて以来、汝の国はガリバーの訪れた国よりも遥かになつてしまつた。",
              "citation": {
                "source": "消息抄（近頃書いた或る私の手紙から。）",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "宛名――アタミ線、吉浜局区内コメカミ漁場納屋気付、須田七郎）　豊漁の報に接して、近頃最上の愉快を覚えた。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタミホテルニ来遊ノ旨、歓迎ト答ウ。",
              "citation": {
                "source": "父の手帳",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタミへ一しょに行きましょう。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうわけでセラダと小夜子サンは再びアタミの散歩者となったのですが、ここへ来てみれば別天地でした。",
              "citation": {
                "source": "裏切り",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂だから歩きづらいということもあるが、あの沙漠をうめる熔岩ならアタミと伊東の二ツの市をまとめて下に敷き隠してしまうのはワケはない。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタミ、イカホ、ユガワラ、キヌガワ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ電報、又スッポかされたかと思ったら「五ジ三一プンアタミエキツク」。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
