        "examples": {
          "standard": [
            {
              "text": "彼の意見は理想ばかりが高くて、どこか青っぽい感じがする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんな青っぽい正義感だけでは、この仕事は務まらないぞ」と諭された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "学生時代の青っぽい青写真を見返して、少し恥ずかしくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
