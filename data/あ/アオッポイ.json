[
  {
    "uuid": "ff2f9c66-8edb-55b8-b889-3018597f14cb",
    "entry": "青っぽい",
    "reading": {
      "primary": "あおっぽい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
