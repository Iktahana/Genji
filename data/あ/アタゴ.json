          "literary": [
            {
              "text": "」「いまさっき、アタゴ山のサイレンが鳴ったよ。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一放送の方だとアタゴにたしかめたのに入らず。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタゴ山とはだいぶ違わア。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はこの寺の後の山がどうも気になるので（と申すのは、ヒダの社寺の後にある山の上には古墳らしいのが多いのですよ）そこで寺のうしろの山上にあるアタゴ社のホコラを見物に登りました。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛騨・高山の抹殺――中部の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶんアタゴ社の下を掘ると羨道の入口があるのだろうと思いますよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "飛騨・高山の抹殺――中部の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタゴという地名は京都の北部だけでなく、これから天竜を隔てた遠州の磐田郡にも有名なる阿多古がある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
