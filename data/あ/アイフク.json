[
  {
    "uuid": "b1fe8bad-6ae2-5733-a49c-794c6cb36a58",
    "entry": "合服",
    "reading": {
      "primary": "あいふく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
