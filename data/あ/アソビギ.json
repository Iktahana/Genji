          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は休日のゴルフコンペに、仕立ての良いツイードの遊び着を羽織って現れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "少し肌寒くなってきたので、クローゼットの奥から秋用のコーデュロイの遊び着を出しておいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "名門カントリークラブの厳しいドレスコードに合わせて、上品なチェック柄の遊び着を購入した。",
              "citation": {
