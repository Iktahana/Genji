          "literary": [
            {
              "text": "頬白は散髮屋の鋏のやうにせはしく、四十雀はけたたましいアイアムビツク。",
              "citation": {
                "source": "闇への書",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、当時我々はアイアムビツクに出席するとか何とか云つて、成瀬が出れば自分が休み、自分が出れば成瀬が休んでゐた。",
              "citation": {
                "source": "あの頃の自分の事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
