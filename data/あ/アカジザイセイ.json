        "examples": {
          "standard": [
            {
              "text": "この地域の赤字財政は、少子化による税収減が主な原因である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤字財政を改善するために、市は公務員の給与削減を検討している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤字財政が続けば、公共サービスの質の低下は避けられない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "この人たちがたとえばヴェトナム戦争に反対する場合は、ドル価格の低下をまねくほどの深入りに対して反対する場合にかぎられ、ドルさえたしかならば戦争は利益をあげる商売でしかなく、その商売がいまアメリカでは増税、物価の値上がり、インフレ、赤字財政、失業を生んでいる。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
