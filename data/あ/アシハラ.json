    },
    "definitions": [
      {
        "index": 1,
        "gloss": "reed bed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕暮れの葦原を、冷たい秋風が吹き抜けていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "その野鳥は、川沿いの広大な葦原の中に巣を作って繁殖する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "昔はこの辺り一面が葦原だったが、今はすっかり埋め立てられて住宅地になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "豊葦原の瑞穂の国の瑞穂の波の中にいて、それでなかなか容易には米が食われないのである。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すなわち高天原皆暗く、葦原中国ことごとに闇し」というのも、噴煙降灰による天地｜晦冥の状を思わせる。",
              "citation": {
                "source": "神話と地球物理学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "将弘が将軍太郎といひ、将門が相馬小次郎といひ、系図には見えぬが、千葉系図には将門の弟に御廚三郎将頼といふがあつて、其次が大葦原四郎といつた事を考へると、将門は次男かとも思はれる。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく川の両岸はよしきりの頻りに鳴く葦原つゞき、その間にところ／″＼船つき場と漁家が見え、川はだん／＼幅を拡めて来ますと、ついに海――。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳河の街の子供はかういう時幽かなシユブタ（方言｜鮠の一種）の腹の閃きにも話にきく生胆取の青い眼つきを思ひ出し、海辺の黒猫はほゝけ果てた白い穂の限りもなく戦いでゐる枯葦原の中に、ぢつと蹲つたまゝ、過ぎゆく冬の囁きに昼もなほ耳かたむけて死ぬるであらう。",
              "citation": {
                "source": "水郷柳河",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神｜坐しき、千五百秋瑞穂の国、皇国ぞ豊葦原。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神｜坐しき、千五百秋瑞穗の國、皇國ぞ豐葦原。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "蓋し乱世の後、人心漸く泰平の娯楽を愬へ、彼の芒々たる葦原（今日の吉原）に歌舞妓、見世物｜等、各種の遊観の供給起り、これに次いで遊女の歴史に一大進歩を成し、高厦巨屋｜甍を并べて此の葦原に築かれ、都には月花共に此里にあらねばならぬ様になれり。",
              "citation": {
                "source": "徳川氏時代の平民的理想",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですからいちばんはじめには、日本のことを、大八島国と呼び、またの名を豊葦原水穂国とも称えていました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "きじのお使い一　そのうちに大空の天照大神は、お子さまの天忍穂耳命に向かって、「下界に見える、あの豊葦原水穂国は、おまえが治めるべき国である」とおっしゃって、すぐにくだって行くように、お言いつけになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大神はおまえが治めているこの葦原の中つ国は、大神のお子さまのお治めになる国だとおっしゃっている。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、父や兄の申しあげましたとおりに、この葦原の中つ国は、大空の神のお子さまにさしあげますでございます」と、平たくなっておわびしました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "笠沙のお宮一　天照大神と高皇産霊神とは、あれほど乱れさわいでいた下界を、建御雷神たちが、ちゃんとこちらのものにして帰りましたので、さっそく天忍穂耳命をお召しになって、「葦原の中つ国はもはやすっかり平らいだ。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その夢の中で、天照大神と高皇産霊神のお二方が、建御雷神をおめしになりまして、葦原中国は、今しきりに乱れ騒いでいる。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は半ば凍り、泥濘も脛を没する深さで、行けども行けども果てしない枯葦原が続く。",
              "citation": {
                "source": "李陵",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃の那珂川の水は透明清冽で博多織糸の漂白場であったが、ずっと上流まで博多湾から汐がさして、葦原と白砂の洲が到る処に帯のように続いていた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "後水尾天皇の葦原やしげらばしげれおのがまゝ　　　とても道ある世とは思はず　の御製に依つても、幕府の横暴が察せられるのである。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "例せば古事記に天若日子、葦原中國に到て下照比賣を娶り、八年に至るまで復奏せず。",
              "citation": {
                "source": "詛言に就て",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "兩岸の枯葦原に物凄い音を立てゝ風は鳴りはためいた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "漸く東岸へ漕ぎつけて、葦原の繁り高い洲の間に這入つた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒い月の光は物凄い浪畝の上に、金を浮べ銀を浮べ名殘りの風が時々葦原を騷がす、云ひ難き爽快な夜になつた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯葦原に火を放つた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "入江の渚幾里の枯葦、枯れに枯れた葦原に火を放つたのである。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯葦原の火は遠く燃え去つた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒涼と見渡す限りに連なった地平線の低い葦原を一面におおうた霙雲のすきまから午後の日がかすかに漏れて、それが、草の中からたった二本ひょろひょろと生い伸びた白樺の白い樹皮を力弱く照らしていた。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖先の御遺訓を守るは孝の第一、神を敬するは国の誉、そなたも豊葦原瑞穂国にお生れの立派な若殿様じゃ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳河の街の子供はかういふ時幽かなシユブタ（方言、鮠の一種）の腹の閃めきにも話にきく生膽取の青い眼つきを思ひ出し、海邊の黒猫はほゝけ果てた白い穗の限りもなく戰いでいる枯葦原の中に、ぢつと蹲つたまゝ、過ぎゆく冬の囁きに晝もなほ耳かたむけて死ぬるであらう。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "池の菰に水まして、いずれが、あやめ杜若、さだかにそれと、よし原に、ほど遠からぬ水神へ……」　扇子をつかって、トントンと向うの段を、天井の巣へ、鳥のようにひらりと行く。",
              "citation": {
                "source": "開扉一妖帖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "お紺はよんどころなく商売をやめて、そこらを流れ渡っているうちに、吉原の或る女郎屋の妓夫と一緒になって、よし原の堤下の孔雀長屋に世帯を持つことになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鬼娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし原と違って、新宿や品川には旅籠屋に給仕の女をおくという名義で営業しているのであるから、かれらの宿泊を拒むわけには行かない。",
              "citation": {
                "source": "半七捕物帳",
                "author": "鷹のゆくえ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
