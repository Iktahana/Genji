        "examples": {
          "standard": [
            {
              "text": "不当な解雇を服さないとして、彼は会社を相手取って訴訟を起こした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "巨大資本を相手取って戦うのは無謀に見えたが、市民たちは団結した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "国の不作為を相手取った裁判の判決が、いよいよ明日言い渡される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "まるでもう批評家が大向ふとして相手取る大家になつたやうな気持で。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "必ずしもみち子を相手取るにも当るまい。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大久保のやうな稚気の多い狂人を相手取ることに、何の意味のあらう筈もなかつた。",
              "citation": {
                "source": "彼女の周囲",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
