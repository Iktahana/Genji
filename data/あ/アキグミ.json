        "examples": {
          "standard": [
            {
              "text": "山道で赤く熟した秋茱萸の実を見つけて、少しだけ味見してみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "祖父の庭には大きな秋茱萸の木があり、毎年たくさんの実をつける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "鳥たちが秋茱萸の実をついばみに、朝早くから枝に集まってきている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "苗代茱萸でも秋茱萸でもない所謂西洋茱萸であるが、根もとから幾本かに分れて枝の茂つてゐる大きな木である。",
              "citation": {
                "source": "たべものの木",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "苗代ぐみもあれば秋茱萸もある。",
              "citation": {
                "source": "家のめぐり",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
