          "literary": [
            {
              "text": "これにはおっ母さんも呆れたように笑って、渋りながらも帯の間から青皮の小さなガマ口を出して人形を買うてくれるのである。",
              "citation": {
                "source": "神楽坂",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "本草のいわゆる青皮楝だとある。",
              "citation": {
                "source": "アテヌキという地名",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ごんじ」は蓑によく用いる「うりき」の別名で、ある地方では「おっかわ」ともいう、青皮の意である。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
