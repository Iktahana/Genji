        "examples": {
          "standard": [
            {
              "text": "水黽を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは水黽について学習した。",
              "source": "幻辞"
            },
            {
              "text": "水黽の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は水黽の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では水黽が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "水黽という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に水黽という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では水黽についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "水黽を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると水黽は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "水黽について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では水黽が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に水黽は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により水黽の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "水黽は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に水黽は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "下ではあめんぼが番つたまゝすつと走る。",
              "citation": {
                "source": "即興",
                "author": "富永太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "池のあめんぼうの泳ぐのを雨かと驚いた時のほんのちょっぴりの時間は私にとって詩になりそうなものであった。",
              "citation": {
                "source": "日記",
                "author": "一九一四年（大正三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "水鳥がむれて泳いでいる時も、あめんぼが勢いよく走っている時もありました。",
              "citation": {
                "source": "清造と沼",
                "author": "宮島資夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の上を、あめんぼうが器用に渡って行く。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤錆の浮いた隅つこのをどみには水蟷螂があめんぼをとつたり、田亀がひよくひよくもぐつたりしてゐる。",
              "citation": {
                "source": "銀の匙",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "芥川は、お線香のやうにくるくると卷くのだといつてゐたが、セロファン包みのあめんぼうに似た形である。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、かすかに眼蓋を開くと、あしもとの小川の水は眼ばゆく照り映えて、空のやうに澄んだ水底には、水カマキリやヤゴが物憂気に逼ひまはり、目高が飛び交ひ、アメンボウが水の表面を長い脚で可笑しく歩いてゐるのだ。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもその三枚を仔細に見わけると、明暗の微かな相違が認められ、全々の白紙と、積乱雲の影らしいものと、また一尾のアメンボウの姿らしいものが発見出来るので、夫々に、水や倒さまの雲やアメンボウを写すのが目的ではなかつたといふ言葉を附けたして、採集日誌のスクラツプにはさんだ。",
              "citation": {
                "source": "ベツコウ蜂",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、アメンボウが飛んだやうに水の上に雫が落ちるのだ。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "お馬のお耳お馬のお耳は　何故長い青い草をたべたくつて　動くのよお馬にかねの靴　なぜはかすくろい爪がへるから　はかすのよお馬のお耳は　なぜ長い桶の水飲むから　ながいのよ黒ンぼと斑ンぼサキノ　ウシハクロンボアトノ　ウシハアメンボクロンボノツノトアメンボノツノトツノト　ツノトソロツタ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしアメンボの方は目だつほどのさざなみはたてずに滑っていく。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "水面がだいぶ波だっているとアメンボもミズスマシも出てこないが、おだやかな日にはかれらはその港を出て岸から冒険的な滑走をはじめ、短い推進をかさねてついに湖面をよこぎるものとみえる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメンボとミズスマシはきびしい霜がむすぶ十月の終わりになるととうとう消えうせる。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、わたしが見わたしていると、ちょっと離れたあそこここにかすかなきらめきが見えて、霜をまぬがれたアメンボが寄りあつまっているのか、それともことによると、水面があまりに澄んでいるので池の底から水が湧いているところを顕わし示しているのか、とも思われた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから高等学校入学早々、アメンボウという綽名がついてしまった。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "生来、狸を愛して自然と狸の画に妙を得たくらい、狂歌にも手を出して狂名が遊狸庵つづみ、そのほか水中の虫を集めてアメンボやコガネ虫と仲よく遊んだという変り者、二十三年に名古屋で歿した。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
