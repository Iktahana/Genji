        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――まああんたゞけでも勉強おしよ。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれやああんな男だ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」三「別に直ったというでもないけれど、まああんなものさ。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と腋の下に両手を当てそのまま、私は手放しで、ぐしゃと泣いて、たまらずああんと声が出て、みっともない二十八のおたふくが、甘えて泣いても、なんのいじらしさが在ろう、醜悪の限りとわかっていても、涙がどんどん沸いて出て、それによだれも出てしまって、私はちっともいいところが無い。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが不思議なことは、「わああああんああああ。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ははああんまり面白くもないのかな。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、名を憚った男の、低い声に、（ああん。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「…………」「ああん、阿爺い。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だか私たちああんまりな御様子に呆れッちまって、ぼんやりしたの、こりゃあまあ魅まれてでもいないかしらと思った位だわ。",
              "citation": {
                "source": "清心庵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まああんた、ぶちこわしを言うのね。",
              "citation": {
                "source": "源氏物語",
                "author": "常夏",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしていずれ『賢さ』に関わろうとする企業であるのなら、スティーブン・ジョブズと坂村健に対置して見せるのが算盤勘定だけじゃ、そりゃああんまり寂しかないかい。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それああんた、あんたは天麩羅は東京ばかりだと思うておいでなさるからいけません」桂三郎は嗤った。",
              "citation": {
                "source": "蒼白い月",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様ああんまりけちだぞそれじゃ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――さああんまり、よろこびもしまいけれど。",
              "citation": {
                "source": "勇士ウ※ルター（実話）",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「成程ゆうべは寒いともつたら、ほれ山ああんなに積つた。",
              "citation": {
                "source": "海郷風物記",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくまああんなに図迂／＼しく出来るものだ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "よくまああんなにずうずうしく出来るものだ。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「将軍はただいまから、盗賊たいじに出発のところでござーい」　クロが、ああんと赤い口をあけました。",
              "citation": {
                "source": "正坊とクロ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それぢやああんまりぢやあありませんか。",
              "citation": {
                "source": "權三と助十",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで無けりやああんまり用のねえところだ。",
              "citation": {
                "source": "番町皿屋敷",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、これぢやああんまり体裁が悪いから、もう少し何とか店附を好くしようと云つてゐるんですが、例の区画整理がまだ本当に決まらないんでね。",
              "citation": {
                "source": "赤い杭",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんにまああんな縹致と云ひ、気立と云ひ、諸芸も出来れば、読、書、針仕事、そんなことは言つてゐるところではない。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「たしかに僕には君を笑う権利はないが、――百五十万という金は笑いごとにしちゃああんまり重大だからねえ、――だが君は、君の鎖の第三の輪をこさえようとしているんじゃあるまいね。",
              "citation": {
                "source": "黄金虫",
                "author": "THE GOLD-BUG",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからそんな余計な心配をしないで一パイお飲みなさいったら……飲まなけああんたを殺したいわけを話さないからいい……寝てる間に黙って殺しちゃうから……さあ……グッと……そうよ。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれああんた方のような珍らしい御夫婦は初めて見た。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人が結婚生活に入ってからもうかれこれ八年の余にもなるのに、今だにどちらか一人が相手のところへ、そっと林檎の一切れだの、金平糖だの、胡桃だのを持って来て、水も漏らさぬ愛情を表わす、とろけるような甘ったるい声で、『さ、ああんと口をおあきなさい、美味しいものを入れてあげますから』と言う。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれたちはもうここに三週間もじっとしてたんじゃないか、ああん？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様はこういう醜態をさらけやがるじゃないか、ああん？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃあ、どうして前に言わなかったのだ、ああん？",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の巡査は、明治初年、士族の食いっぱぐれが、悉く採用されて「くや人民ッ、ああん」と云った時分から、伝統的に、威張るようにできている。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
