        "examples": {
          "standard": [
            {
              "text": "交渉は難航したが、最終的に相手側の譲歩を引き出すことに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "今回のトラブルの原因は、明らかに相手側の確認ミスにある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "試合中、相手側の執拗なマークに苦しめられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "第二二課　敵、味方一　敵が相手側にばかりあるかと思えば自分の中にもあります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、更に公判が進み、ストライヴァーが同僚弁護士であるカートンの注意によってカートンとダーネーとの容貌の酷似を利用して相手側の一証人の証言を粉砕する。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手側の言い分も聞かねば。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
