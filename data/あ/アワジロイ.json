          "literary": [
            {
              "text": "ばたばたと団扇を使いながら、いつまでも寝つかれずにいるお銀の淡白い顔や手が、暗いなかに動いて見えた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く途絶えたかと思うとまた、静かな朝の深い霧の中から、夢色のしっとりと淡白いその霧の幕をふるわせて、はげしく罵り合う声が聞えました。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "その淡墨と濃墨との接する処は極めて無造作であつて、近よつてこれを見ると何とも合点のゆかぬほどであるが、少し遠ざかつて見ると背中の淡白い処が朦朧として面白く見える。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "淡白い空に黒い輪郭を画している寺の屋根。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "東雲頃迄空は平穏で、消えのこった淡白い星に涼しい風が渡った。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
