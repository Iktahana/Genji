          "literary": [
            {
              "text": "並木道の左右に売店が並び、各々が意匠した店名を、「アガニョーク」「ゴスイズダート」青葉の下にかかげている。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予約出版物の用事で「アガニョーク」社へ出かけた。",
              "citation": {
                "source": "モスクワ日記から",
                "author": "――新しい社会の母――",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちでは、丁度昼休みで、「アガニョーク」の若い男女の連中がシャツ一枚になって新しい遊び場を早速利用しボールをやって遊んでいる。",
              "citation": {
                "source": "モスクワ日記から",
                "author": "――新しい社会の母――",
                "note": "青空文庫"
              }
            }
          ]
        }
