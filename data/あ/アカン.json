        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「こんな夜遅くに甘いもの食べたらあかんよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「宿題を終わらせるまでは、ゲームして遊んだらあかんで」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「そんな嘘をついて人を騙すような真似は、絶対にあかん」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
