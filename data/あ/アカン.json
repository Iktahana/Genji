  {
    "uuid": "fb57d4cb-d029-57fe-9fb8-5108ebfc9104",
    "entry": "アカン",
    "reading": {
      "primary": "あかん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "三次が「アカンッ」と眼で知らす。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "三次が又「アカン」と眼で合図する。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「大体身共は内気な　方で厶って喃」　若侍手真似で「アカンアカン」云うが、　進藤一向構わず、Ｔ「生得、大勢の人中へ　出ると気がボー　と致す性質」　大吉背後でジッと聞いて居る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウイルス頭のオレはパネル・ディスカッションの席上では「Ｗｉｎｄｏｗｓが成功しなければきっと失敗するだろう」などと訳のわからないことを、アカンアカンと思いながらも口走るのみだった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤ、ヲバサン、アカンボガ　ウマレルノデスカ」「モウ　ウマレテ　ヲリマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ、アカンボヲ　セヲツタ　コモリガ　ヤツテ　キテ、イツセンデ　ソノ　チヒサイ　アカイ　フウセンダマヲ　カヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネンネン　ヨヲヲヲ　ネンネン　ヨウ」　シカシ、アカンボウヨリ　サキニ、コモリノ　ハウガ　ウツラ　ウツラ　ネムリハジメマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その窓の外側には、アカンサスの拳葉で亜剌比亜模様が作られている、古風な鉄柵縁が張り出されてあった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "図書室の中には、アカンサス形をした台のある燭台が、ポツリと一つ点されているのみで、その暗鬱な雰囲気は、著作をする時の鎮子の習慣であるらしかった。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "涙が彼女の眼にたまりつつある、――プリニー６のアカンサスのように「柔らかにしてほとんど溶けそう」なその眼に。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アカンサス」についての引用ももちろんその書から取られたものであろう。",
              "citation": {
                "source": "しめしあわせ",
                "author": "THE ASSIGNATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に日本の女は芝居をし過ぎるか、いじけ過ぎるかしていて、とてもアカン。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の心はもうアカンザスの様にフワフワと浮いて来た。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、この頃は、英本土が、ドイツのためにあぶなくなったところから、「わしらの方はもうアカン、そこで亜米利加へ肩代りじゃ」　と、どうやら冷淡の素振りを見せはじめた。",
              "citation": {
                "source": "今昔茶話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユダヤ人アカン、エリコの分捕品の中より金銀若干を盜みしかば、ヨシュア（ヨスエ）人々に命じ石にてこれをうちころさしむ（ヨシュア、七・一以下）一一二―一一七第四例、サツピラとその夫アナニア。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めの時は廃墟の間にアカントゥスが大きな濃緑を拡げていた。",
              "citation": {
                "source": "パラティーノ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカントゥスはポンペイでも見たが、特にパラティーノでそれを強く印象されたのは、コリントスの彫刻家カリマコスの逸話を思い出したからだった。",
              "citation": {
                "source": "パラティーノ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る日、パラティーノの町（ローマ・クァドラタ）を歩いてると、若い娘の墓の上にアカントゥスの葉を盛った籠が供えてあるのを見て、その美しさに目を留め、熱心に写生して図案化し、それで初めて円柱の冠頭を装飾したのがコリントス式の起りだという。",
              "citation": {
                "source": "パラティーノ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは真にグロテスクな植物で、その形と色とは青銅で模倣されているアカントス、チコリー、常春籐、葡萄、そのほかいかなる植物の葉よりも古代的で典型的な建築用唐草模様の一種であって、次第によっては未来の地質学者の頭をなやます謎となるかもしれない。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "とばっかりにアカンベの花真赤に咲いた名の知れぬ花も咲いてた月見草も雨の真昼に咲いてたコタン賑かさに飢えて居た様な此の町は旅芸人の三味に浮き立つ酒故か無智な為かは知らねども見せ物として出されるアイヌ白老のアイヌはまたも見せ物に博覧会へ行った　咄！",
              "citation": {
                "source": "北斗帖",
                "author": "違星北斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "ストリップみたいなもんナンボ見たかてアカンワ、と車券をビリッとちぎって、エイッとすて、なんとなくウラミを骨髄から外すぐらいの寛仁大度に日頃の心得なき方々ではない筈なのである。",
              "citation": {
                "source": "安吾人生案内",
                "author": "その五　衆生開眼",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹きぬけの窓のそばにある池――仏蘭西でバッサンといっているものだが、その緑は、どこが終りともわからないように、つらつらに緑の漆を塗った、人工のアカンサスの草むらの中に消えている。",
              "citation": {
                "source": "泡沫の記",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "就ては会場の儀、今まで小生宅にて催うし候処、細君アカンボ製造中にて随分難儀そうに見受候に就ては、今度はちょっと御免蒙り、どこかほかへ持って行きたしと存候、会員の宅でなくとも貸席など可然か。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小説は、アカンとされたのだが、私が、はじめて、久坂葉子なる名前を附したもので、一週間位して、第二作、「入梅」を、島尾氏のところへ持って行き、それがＶＩＫＩＮＧにのったのだ。",
              "citation": {
                "source": "久坂葉子の誕生と死亡",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、花に繞まれた玄関には、アカンザス模様を彫刻した幾本かの大理石の円柱がそそり立ち、中へ踏み込めば、そこには大広間の嵌木細工の床の半ばを掩うて、月桂樹の老木が円天井を衝かんばかりに蓊鬱とした葉を繁らせて、その翠緑の色を傍の青苔の蒸した浴池が水に浸しているのであった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "大理石に似て、もっと石膚が艶やかに、もっと純白雪のように磨き上げられた円柱が並列して、円形の屋根を支え、円柱の台石に飾り付けられた裸体女神の立像や、座像や、そして屋根と柱との壁間に刻まれた白鳩とアカンザス模様の見事さ！",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
