        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "九唱　ナタアリヤさん、キスしましょう　その翌、翌日、まえの日の賤民とはちがって、これは又、帝国ホテルの食堂、本麻の蚊がすり、ろの袴、白｜足袋の、まごうかたなき、太宰治。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤネワを経て、カナアリヤに至り、ここでまたフランスヤの海舶一隻ずつに乗りかえ、とうとうロクソンに着いた。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるとき千羽鶴の模様のある女生徒の着物を見て、得意そうに「この鶴、｜千ワアリヤス」と言ったという逸話が、この子にいつまでも附纏って、級友たちは「千ワ、千ワ」といって揶揄っていました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手唾をかけて、ヤ、曳、と圧しはじめ、ヨイシヨ、アリヤ／＼／＼、ザブーンと転がす。",
              "citation": {
                "source": "怪力",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまもなほ黒いダアリヤのかげから、かくれ遊びの三味線は昼もきこえて水はむかしのやうに流れてゆく。",
              "citation": {
                "source": "水郷柳河",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたたかにうち黄ばむ写真屋の古きならびは、半盲目の病児らの日向ぼこをば見るごとく、掲げたる鈍き写真のうちにくはせ者の女役者の顔のみ白く、罎ならぶ※のそば、露台にダアリヤの花ただひとつ赤けれども、なべてみな色もなし、入口の静かなる空椅子のうへに、みよりなき黒猫ぞひとりまた背を高めたる。",
              "citation": {
                "source": "浅草哀歌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "君を撃つと言やしまいし、僕はバヴアリヤ生れだよ。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれアリヤ種の言語はそんな下等なものでなく、馬を名ざすにもその声を擬ず。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリヤ種の祖先が馬を名ざすに、そのもっとも著しい性質としてその足の疾き事を採用した。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "梵語アース（迅速）、ギリシア語のアコケー（尖頂）、ラテンのアクス（鍼）、アケル（迅速また鋭利また明察）、英語アキュート（鋭利）等から煎じ詰めて、これら諸語種の根源だったアリヤ語に鋭利また迅速を意味するアスてふ詞あったと知る。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "果してしからばミュラーがアリヤ種で一番偉いように言った独語のプファールト、蘭語のパールト、いずれも支那の馬また恐らくはアラブのヒサーン同様、嘶声を採って馬の名としたのでなかろうか。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリヤヌスの『印度記』に、ヘラクレス老いて一女あったが相当な婿なし、王統の絶ゆるを虞れ自らその娘を妻ったとある。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて捨札の読上げ終るや、矢来の片隅に控へ居りし十数人の乞食ども、手に／＼錆びたる槍を持ちて立上り来りアリヤ／＼／＼／＼と怪しき声にて叫び上げつゝ初花太夫を残したる九人の左右に立ち廻はり、罪人の眼の前にて鑓先をチヤリ丶／＼と打ち合はし脅やかす。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の私は副院長の下に働く臨時雇いの助手であり、面前に立つ私の友は若い印度人（アリヤン）で、極く小さい貿易商の事務員、ラオチャンド氏であった。",
              "citation": {
                "source": "ラ氏の笛",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "影というのは、之もアリヤンの若い女性、名は覚えて居ぬが、何でも当時、日本へ渡って来たばかりの、乞食に等しい貧困者であった。",
              "citation": {
                "source": "ラ氏の笛",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼れはその以前迄、一人だけであの旧風な煉瓦造りの××番館全体を使用してゐたが、間もなく、建築物の大部分をシャンダーラムと呼ばるるアリヤンの一家族へ又貸しをして了ひ、自分は北隅に位置をしめた十二畳程もある湯殿へと椅子や寝台を移し、そこで日夜を過ごす事に充分な満足を感じてゐたのである。",
              "citation": {
                "source": "アリア人の孤独",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまもなほ黒いダアリヤのかげから、かくれ遊びの三味線は晝もきこえて水はむかしのやうに流れてゆく。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォンジュアリヤ（哲学の基礎）、ロジカ（倫理学）。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "門へゆく迄に、手入れをしない花壇があって、ダアリヤ、矢車草、孔雀草などが緑の島のように、ぼっさりと繁っていた。",
              "citation": {
                "source": "秘められたる挿話",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴局ヨリノ質問アリヤ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美人ト不美人トノ相違ノ真髄ハ何処ニアリヤト考エルノニ、要スルニ夫レハ主トシテ眉目ノ立体幾何学的問題ニ在ル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の室から起きて来た二人の女の児が戸の間から庭を覗いてコスモスもダアリヤも折れて仕舞つたと言つて居る。",
              "citation": {
                "source": "台風",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "清少納言は野分の記事の中に萩や女郎花の吹き倒されたのを傷ましがつて居るが、ダアリヤやコスモスの吹き倒される哀れさは知らなかつた。",
              "citation": {
                "source": "台風",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "况んやアリヤン文明と云ひ、蒙古文明と云ひ、ヘブルウ文明と云ひ、漫に之を區分するも、其源流に遡れば則ち一のみ、若し、源流に遡らずして、其の下流につきてのみ云はんとする乎。",
              "citation": {
                "source": "世界の日本乎、亞細亞の日本乎",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリヤンなく、蒙古なく、ヘブルウなし。",
              "citation": {
                "source": "世界の日本乎、亞細亞の日本乎",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本あるのみ、支那あるのみ、波斯あるのみ、英國あるのみ、佛國あるのみ、露國あるのみ、源流に遡れば天下は一のみ、支流に下れば列國あるのみ、アリヤンと云ひ、蒙古と云ひ、ヘブルウと云ふ、半上落下の區分あるを許るさず。",
              "citation": {
                "source": "世界の日本乎、亞細亞の日本乎",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "必しもアリヤンと云ふ勿れ、必しも、ヘブルウと云ふ勿れ。",
              "citation": {
                "source": "世界の日本乎、亞細亞の日本乎",
                "author": "竹越三叉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アリヤあれ踊の、人寄せなるか。",
              "citation": {
                "source": "硯友社と文士劇",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
