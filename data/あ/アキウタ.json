        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "詩魂衰へて警察歌をつくる北原白秋歌壇に盤踞して、後陣を張る歌壇組みし易しと見えたり。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌は、桂園一枝、秋歌に、「薄隨風」といふ題で載つてゐる。",
              "citation": {
                "source": "愛國百人一首評釋",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "古今集巻五秋歌の下に、「仁和寺に菊の花めしける時に、歌そへて奉れと仰せられければよみて奉りける」と云う詞書の附いているのが即ちそれである。",
              "citation": {
                "source": "少将滋幹の母",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
