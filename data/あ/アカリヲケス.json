          "literary": [
            {
              "text": "どうぞお先に」「明かりを消すだけでいいようになってます」「ありがとう。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "直子は彼を送り出し、店のドアに内側から鍵をかけ、明かりを消す。",
              "citation": {
                "source": "東京青年",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひそひそと、誰かに明かりを消すようにささやいている。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かが明かりを消すようにささやき、暗闇で座っていたときでございます。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしが明かりを消すように寝室から言いました。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、君も手つだいたまえ」「ええ、こうなったら、どんなことでもやりますよ」「では、もう外のあかりをけすよ」　スウィッチの切れる音がしました。",
              "citation": {
                "source": "豆潜水艇の行方",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、あかりをけすのは、星とか花をおやすみさせるってこと。",
              "citation": {
                "source": "あのときの王子くん",
                "author": "LE PETIT PRINCE",
                "note": "青空文庫"
              }
            }
          ]
        }
