        "examples": {
          "standard": [
            {
              "text": "有り高を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは有り高について学習した。",
              "source": "幻辞"
            },
            {
              "text": "有り高の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は有り高の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では有り高が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "有り高という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に有り高という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では有り高についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "有り高を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると有り高は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "有り高について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では有り高が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に有り高は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により有り高の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "有り高は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に有り高は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "徐庶が来たと取次いでくれ」　外の客は、しきりと訪れていたが、童子はなお気づかないものの如く、栄うる者は自ら安々辱めらるる者は定めて碌々南陽に隠君有り高眠｜臥して足らず　と、歌いながら、梢の鳥の巣を仰いでいた。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで釣寄せて置いて……ほんありがた山の蜀魂、一声漏らそうとは嬉しいぞえ嬉しいぞえ」　と妙な身振りをして、「それなら、実は此方も疾からその気ありだから、それ白痴が出来合｜靴を買うのじゃないが、しッくり嵌まるというもンだ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたも年頃の孫娘がおありだから、思ひ当りもあらうと思ふが、老人の衰えをふせぐためにも、身辺に若者の世界があることは、何かと結構であるらしい」　皮肉の言へる左門ではなかつた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「森さんはお母さんばかりか、お祖母さんもおありだから、お嫁さんはお骨が折れましょう」という噂を聞いて、いっこくな祖母は腹を立てて、「何も私は急に出て来たのではない。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポリーナ　わかってるわ、そう言って逃げをお打ちになるのも、わたしのほかに、身近な女の人が、幾らもおありだからよ。",
              "citation": {
                "source": "かもめ",
                "author": "ЧАЙКА",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあたまがおありだから、あたしよりも刀がかわいいのに不思議はございませんとも――もう何も伺いたくはございません！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「貴方は女の方たちににんきがおありだから、これからもきっと招待があると思います、そんなときはなにを措いてもお受けにならなければいけません、これだけはよく覚えていらっしゃらないと」　そして警告するような笑いかたをした。",
              "citation": {
                "source": "いさましい話",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月八日（日曜）　マチネーありだから十時半に起きる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
