  {
    "uuid": "a3ae1ca6-3590-5f9c-8e42-8c993d1ef8a1",
    "entry": "有高",
    "reading": {
      "primary": "ありだか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
