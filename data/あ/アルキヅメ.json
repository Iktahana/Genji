        "examples": {
          "standard": [
            {
              "text": "歩き詰めを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは歩き詰めについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "歩き詰めの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は歩き詰めの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では歩き詰めが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "歩き詰めという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に歩き詰めという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では歩き詰めについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "歩き詰めを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると歩き詰めは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "歩き詰めについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では歩き詰めが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に歩き詰めは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により歩き詰めの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "歩き詰めは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に歩き詰めは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "わけても此処数年間は、出歩き詰めであったようであり、来訪者に忙殺されたようであった。",
              "citation": {
                "source": "名古屋の小酒井不木氏",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この旅人は旧暦九月の半ばに昼夜兼行で江戸を発つから、十月半ばに近くの木曾路の西のはずれにたどり着くまで、ほとんど歩きづめに歩き、働きづめに働いて、休息することを知らなかったような人である。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまで歩きづめに歩いてほんとうの休息ということも知らなかったようなわたしは、ようやくのことで胸一ぱいによい空気を吸うことのできる宮城野のふところへ飛びこんだようなものでした。",
              "citation": {
                "source": "力餅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "数日の歩きづめとこの一二晩の睡眠不足とのためである。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩きづめであるから足駄の歯はぐんぐん減って行くが、新しいのを買うことができなかった。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一年ばかりというものは、まるで歩きづめに歩いていた旅人のような自分の身をも胸に描いて見た。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は歩きづめに歩いてまで宿屋に辿り着くことの出来ない旅人のように自分の身を考えた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "數日の歩きづめとこの一二晩の睡眠不足とのためである。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝から歩きづめで、どうにもやりきれない。",
              "citation": {
                "source": "かんしやく玉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男は終日歩きづめだったに違いない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "一時間いじょうも、歩きづめに歩いたのです。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "急ぐにも及ばん」　朝から歩きづめである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
