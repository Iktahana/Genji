        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「現場も知らないくせに口だけは達者な、青白きインテリめ」と、彼は吐き捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は、行動の伴わない自分を青白きインテリだと自嘲した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "理想論ばかりを語る彼は、周りから青白きインテリだと陰口を叩かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "もし首相が、文学青年的な愛読書を列挙したとしたら、一部の青白きインテリは喜ぶかもしれないが「銭形平次」を読むと言い切ったほどの人気は湧かなかったであろう。",
              "citation": {
                "source": "随筆銭形平次",
                "author": "平次読む人読まぬ人――三人の政治家――",
                "note": "青空文庫"
              }
            },
            {
              "text": "青白きインテリの嘆きはここから実は一種のインテリ宣言の意味をさえ持つようになって来た。",
              "citation": {
                "source": "日本イデオロギー論",
                "author": "――現代日本に於ける日本主義・ファシズム・自由主義・思想の批判",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し残念｜乍ら我々の仲間は、骨の髄から青白きインテリで、一代に一千万円の巨富を築き上げた国府金弥老人と対抗するほどの、金も智慧も持っている筈はありません。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "音盤の詭計",
                "note": "青空文庫"
              }
            },
            {
              "text": "甚だ腹の立つことですが、私ども青白きインテリどもは、諦める外は無い運命でした。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "音盤の詭計",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉田さんとしても、文学青年的なむずかしい本の名前をあげたとしたら、青白きインテリは喜んだかも知れないが、捕物帳だよと答えたほどに、大衆の人気は沸かなかったに違いない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
