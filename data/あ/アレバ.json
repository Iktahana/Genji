          "literary": [
            {
              "text": "サレド富貴栄達ノ相アレバ、一国一城ノ｜主タラム。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド道ニ喧嘩口論ヲ挑ム者アリ、手向イ致サバ怪我スル恐レアレバ、逃グルニ如カズ。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレド富貴栄達ノ相アレバ、一国一城ノ主タラム。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレサヘ　アレバ　ジブンハ　テガラヲ　タテル　コトガ　デキル。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレヲ調和シテイルト考エル人ガアレバ、ソレハ習慣ニヨツテ感覚ガ麻痺シテイルニスギナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、客観的ニ不正デアレバソレデ足リル。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、フシギナコトガアレバ、アルモノデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論今日ノ所謂學術ハ、歐洲ヨリ輸入スル所ニ係レバ、前日ノ漢學ト云フ者ノ比ニ非レバ、唯摸傚蹈襲スルダモ日モ足ラザル所アレバ、況ヤ自ラ機軸ヲ出ス等ノ事ハ固ヨリ企テ及ブベキ所ニ非ズ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "客ノ至リテ言ノ時事ニ及ブモノアレバ則恠譚以テソノ端ヲ折ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔ヘバ則チ一世ヲ睥睨シ、モシ意ニ忤ルコトアレバ、輙チ面折シテ人ヲ辱シム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "惟ソノ有スル所、イヤシクモ尤ヲ誇リ奇ヲ闘スノ意アレバ器物ニ役セラル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「客既ニ集リ炉底火ハ活シ鼎腹沸沸トシテ声アレバ乃茗ヲ※テ主客倶ニ啜ルコト一碗両碗。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "常ニ水底ニアレバ開花ニ不及。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間がアレバアアイウ者デマトマッタモノヲ書キ度候。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "此芋ヲ折トリナドスルモノアレバ立所ニ祟アリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "言語動作ガキビ／＼トシテ、目カラ鼻ヘ抜ケルヨウデ、ソレデイテ情味モアレバ愛嬌モアッテ人ヲ外ラサナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ心理ハ君ニハ分ルマイ」「分ラナイワネ」「ツマリ、僕ガ醜悪デアレバアルダケ、君ガ途方モナク美シク見エルッテコトサ」予ノ言葉ヲ上ノ空デ聞イテ彼女ハアダリンヲ取リニ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "体ガ丈夫デサエアレバコンナ秋日和ノ日ハドンナニ爽快デアロウ、予モ四五年前マデハソノ爽快味ヲ満喫シテイタノニト思ウト、クヤシクモ忌マ／＼シイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ人ガ優レタ藝術家デアレバアルホド、断乎トシテ刎ネツケハシナイデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時世風土記」の記事など見ると、　――犬、病ムアレバ、冬ナレバ、夜着蒲団ヲ厚ウシ、犬医者ヲ呼ブ也。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "結論の終りの章には、＝父母懐胎の時、チヤツト一滴ノツユヲウケテヨリ、ハヤ身モ心モ生ズルモノヨ、タトヘバ袖ノ上ニツユガアレバ月ノウツリ、草ノウヘニモツユガアレバ月ノウツル如クヨ　と書いたり、また、＝月白風清、コンポンニ至ツテハ、ナンニモナイトイフ処ガ面白ヨ、ナンノ道理モナキナリ　で、結んでいる。",
              "citation": {
                "source": "随筆　宮本武蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
