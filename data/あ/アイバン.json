        "examples": {
          "standard": [
            {
              "text": "印刷所に、チラシ用の紙として合い判のものを百枚発注した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "授業のノートをとるのに、机の広さにちょうどいい合い判のノートを愛用している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "図書館の古い資料の中に、合い判の和紙で綴じられた手記が残されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "medium-sized photo print (approx. 10x13 cm)",
        "register": "standard",
