    "definitions": [
      {
        "index": 1,
        "gloss": "medium-sized paper (approx. 15x21 cm, used for notebooks)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
