        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "パトリツクは竜の腹から這ひ出て、湖の岸で顔を洗はうとすると、水の中に、久しい前から行衛知れずになつてゐた妹のアニマスの顔が映つてゐた。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "塔の頂上の窓から、アニマスが半身を乗り出して、救ひを呼んでゐるらしかつたが声はとゞかなかつた。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダビツトはパトリツクの友達で、アニマスの恋人である。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
