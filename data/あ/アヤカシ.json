    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「白楊の枝の上で体をゆすぶる」セイレネスの妖態や「サチロス仲間に気に入る」バックス祭尼の狂態、すなわち腰部を左右に振って現実の露骨のうちに演ずる西洋流の媚態は、「いき」とは極めて縁遠い。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝垂桜は夢のように浮かびでて現代的の照明を妖艶な全身に浴びている。",
              "citation": {
                "source": "祇園の枝垂桜",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "人は夜の夢の中で、樹人や火人であつた頃の、先祖の古い記憶を再現し、いつも我等の生命を脅かして居たところの、妖怪變化の恐ろしい姿や、得體の解らぬ怪獸やの、魑魅魍魎の大群に取り圍まれて魘されてゐる。",
              "citation": {
                "source": "夢",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕等は電光の森かげから夕闇のくる地平の方から烟の淡じろい影のやうでしだいにちかづく巨像をおぼえたなにかの妖しい相貌に見える魔物の迫れる恐れをかんじた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷主よ水先案内よいまおそろしい嵐のまへに　むくむくと盛りあがる雲を見ないか妖魔のあれ狂ふすがたを見ないかたちまち帆柱は裂きくだかれするどく笛のさけばれさうして船腹の浮きあがる青じろい死魚を見る。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よしんば醉つぱらつても青白い妖怪の酒盃は、「未知」を語らない。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが現實の世界に穹窿してゐる、現實の青空であることを、初めに人人が錯覺することから、その油繪具のワニスの匂ひと、非現實的に美しい青色とが、この世の外の海市のやうに、阿片の夢に見る空のやうに、妖しい夢魔の幻覺を呼び起すのである。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の名は、餓鬼、天人、妖精等と呼ばれ、我等の身邊に近く住んで、宇宙の至る所に瀰漫してゐる。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "科学は妖怪変化と共に、月の詩情を奪つてしまつた。",
              "citation": {
                "source": "月の詩情",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼年時代はすべての世界が恐ろしく、魑魅妖怪に満たされて居た。",
              "citation": {
                "source": "僕の孤独癖について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い長い年月のあひだ、彼等の求めてゐたその夢の中の不思議な世界、その空想で描いた妖魔の女性。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の時代の子供たちは、もはや昔の子供のやうに、フアンタスチツクで荒唐無稽のお伽話――森の妖精の話や、魔法使の話や、赤頭巾の話や、鉛の兵隊の話や、親指太郎の話や、ピノチヨの話や、惡魔が人間に化けた話や――などを悦ばないといふのである。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に西洋の子供たち、科學の先進國たる獨逸や佛蘭西の子供たちでさへ、今尚好んで讀んでるものは、グリムやアンデルセンの童話であり、森の妖精や魔法使の話なのだ。",
              "citation": {
                "source": "童話と教育について",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新古今集の和歌は、亡び行く公卿階級の悲哀と、その虚無的｜厭世感の底で歔欷しているところの、艶に妖しく媚めかしいエロチシズムとを、暮春の空に匂う霞のように、不思議なデカダンスの交響楽で匂わせている。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ◇此等の妖怪共も、時がたてば正體を現はしてくる。",
              "citation": {
                "source": "名詩集「思ひ出」の眞價",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時代とか社会とか謂はれる随分偶然的な機構は、諸君のやうな結構な適従性を持つてゐるのであつてみればなんらの怪々たるものでもないが、それのない人にとつては、時々刻々の妖怪と見えるかも知れない。",
              "citation": {
                "source": "ヂェラルド・ド・ネルヴァル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あんな奴が、段々偉くなりやがる」、ハテ面妖なとＡの方で思ふのだが、Ｂとしたら、変な話ぢやないか。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分が其処で暮し、其処で耕した所から花が咲いたのに、別の所で暮し、別の所で耕してた奴が、その花を面妖がるのが変な話でなくてなんとしようぞ。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベックリンという海の妖怪などを好んでかく画家の事は、どなたもご存じの事と思う。",
              "citation": {
                "source": "十五年間",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その小都會の有樣をも、つとめて幻妖に物語つたのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　あわれ、この花園の妖しさよ。",
              "citation": {
                "source": "もの思う葦",
                "author": "――当りまえのことを当りまえに語る。",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼い子等には、まだ見たことのない父母の郷国が、お伽噺の中の妖精国のように不思議な幻像に満たされているように思われるらしい。",
              "citation": {
                "source": "小さな出来事",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての物体は雲煙のごとくまた妖怪｜変化と類を同じうするだろう。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが小さな、可愛らしい、夏夜の妖精の握り拳とでも云った恰好をしている。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔西洋の雑誌小説で蛾のお化けの出るのを読んだことがあるが、この眼玉の光には実際多少の妖怪味と云ったようなものを帯びている。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
