        "examples": {
          "standard": [
            {
              "text": "風呂場の隅に足高蜘蛛がいるのを見つけて、思わず叫び声を上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "足高蜘蛛はゴキブリを食べてくれると知って、退治するのをやめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "夜中に天井を素早く走る足高蜘蛛の姿に、子どもたちは息をのんで見守っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "また、蔭に蜘網弛みて、『過去』や、足高蜘蛛の冷えし死骸。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            }
          ]
        }
