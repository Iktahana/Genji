          "literary": [
            {
              "text": "いったい弔詞というものは、あれは誰にアドレッスされたものだろう。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "室に入ると、さっきの英人がアドレッス・ブックを持って来て、日本人がいましたよと教えてくれた、それには片仮名でこう書いてあった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おついでにアドレッス・ブックも拝見出来ないでしょうか？",
              "citation": {
                "source": "情鬼",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　久子さんはまた立ってアドレッス・ブックを持って来た。",
              "citation": {
                "source": "情鬼",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            }
