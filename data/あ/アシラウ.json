    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to treat",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "クレームをつけてきた客に対し、ベテランの店員は決して感情的にならず、うまく遇って帰らせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女は新入社員からの的外れな提案を冷たく鼻で遇うだけで、まともに取り合おうとはしなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "忙しい時に話しかけられて、つい子供を適当に遇ってしまったことを後で深く反省した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "何故逆廻りをしたかといえば、御中道は、前にも廻っているんだが、小御岳から御庭を通じて、大宮道へ出遇うまでの、森林の石楠花を見たかったのだ。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "また白衣の道者の一群に、森の出口でゆき遇う。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこの頃、湧玉の水のほとりで、度び度び遇う男は、女の醒めたものを攪乱する野太く、血熱いものを持っている。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し忽ち倦で了う、則ち恋に倦でしまう、女子の恋に倦だ奴ほど始末にいけないものは決して他にあるまい、僕はこれを憎むべきものと言ったが実は寧ろ憐れむべきものである、ところが男子はそうでない、往々にして生命そのものに倦むことがある、かかる場合に恋に出遇う時は初めて一方の活路を得る。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕等は生れてこの天地の間に来る、無我無心の小児の時から種々な事に出遇う、毎日太陽を見る、毎夜星を仰ぐ、ここに於てかこの不可思議なる天地も一向不可思議でなくなる。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "母も僕に遇うことを好みません。",
              "citation": {
                "source": "運命論者",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "お徳はどうかすると譏謔を言い兼ないがお源さんにそんなことでもすると大変よ、反対に物言を附けられてどんな目に遇うかも知れんよ、私はあの亭主の磯が気味が悪くって成らんのよ。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の不幸や、零落につけこんで、その秘密まで聞こうとするのは、決して心あるもののすることでないとは承知しながらも、彼に二度まで遇い、その遇うた場所と趣とが少からず自分を動かしたために、それらを顧慮することができなかったのである。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "先方では私が叔母の家の者であり、学校の先生ということで遇うたびに礼をして行き過ぎるのでございます、田舎の娘に似わない色の白い、眼のはっきりとした女で、身体つきよくおさよに似てすらりとしていました。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "城下の娘にもあのくらいなのは少ないなどと村の者が自慢そうに評判していたのですが全くそうだと私も遇うたびに思っていたのでございます。",
              "citation": {
                "source": "女難",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "この母親の死に遇うことは慧鶴にとってはかなり打撃である筈だが、自分の求めるものに一心凝っている彼は今、さしあたり自分の力ではどうしようもないという諦らめがあった。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或時、群盜に遇うて首を斬らる。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "河間王が宮殿も、河陰の亂逆に遇うて寺院となりぬ。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　その日の新聞を開いたときの匂い、初めて見る若い女性に遇うたときの匂い、吸物碗の蓋をとったときの匂い、埃及煙草の口を切ったときの匂い、親友から来た手紙の封を破ったときの匂い。",
              "citation": {
                "source": "夜長ノート",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが青年は思いがけない彼女の顔に出遇うと顔を赭くした。",
              "citation": {
                "source": "赤い煙突",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "その妹は、たまさか姉に遇うても涙よりしか懐かしさを語り得ないような内気な娘であった。",
              "citation": {
                "source": "雛妓",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月、盛庸と來河に遇う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "安いよいよ逼りて、燕王に北坂に遇う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕王｜覬覦の情無き能わざりしと雖も、道衍の扇を鼓して火を煽るにあらざれば、燕王｜未だ必ずしも毒烟猛々、蕩々、糾々、昂々として、屈す可からず、撓む可からず、消す可からず、抑う可からざる者、燕王に遇うに当って、※然として破裂し、爆然として迸発せるものというべき耶、非耶。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "八年春三月、工部尚書厳震安南に使するの途にして、忽ち建文帝に雲南に遇う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十二年春、建文帝東行したまい、冬十月｜史彬と旅店に相遇う。",
              "citation": {
                "source": "運命",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "検非違使庁の推問に遇うて、そして将門の男らしいことや、勇威を振つたことは、却つて都の評判となつて同情を得たことと見える。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の村人は自分に遇うと、興がる眼をもって一行を見て笑いながら挨拶した。",
              "citation": {
                "source": "野道",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤十郎が、こんなひどい目に遇うとは、思いも設けなかった事でした。",
              "citation": {
                "source": "風の便り",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、今、図らずも故人に遇うことを得て、愧赧の念をも忘れる程に懐かしい。",
              "citation": {
                "source": "山月記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまり単調で気が狂おう（※）そして日本の桜花の層が、程よく、ほどほどにあしらう春のなま温い風手は、徒に人の面にうちつけに触り淫れよう。",
              "citation": {
                "source": "病房にたわむ花",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お光はフンと鼻であしらう。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "且つその身体を棄てもせず、老実やかに、しんせつにあしらうのが、何か我ながら、身だしなみよく、床しく、優しく、嬉しいように感じたくらい。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士はやっぱり鼻であしらうといった風で『だって木が根こぎにならんじゃないか。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "名ある女を、こうはいかに、あしらうまい、――奥様と云ったな――膝に縋った透見をしたか、恥と怨を籠めた瞳は、遊里の二十の張が籠って、熟と襖に注がれた。",
              "citation": {
                "source": "第二菎蒻本",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to arrange",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お刺身の盛り合わせには、彩りを良くするために大葉と菊花が美しく遇われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女がデザインしたドレスの胸元には、繊細なレースの刺繍が控えめに遇われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "正月の玄関を飾るしめ縄に、縁起物であるウラジロとユズリハをバランスよく遇う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
