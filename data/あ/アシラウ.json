[
  {
    "uuid": "f51ab7db-9af8-5f61-9c39-cc448014c9bd",
    "entry": "遇う",
    "reading": {
      "primary": "あしらう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-ウ行",
        "動詞-他動詞"
