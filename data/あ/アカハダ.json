          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "転んで赤肌になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤肌から血が出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤肌の傷が痛む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "）果樹園に取巻かれて、土の赤肌をポカンと開けて居るポロ競技場もかすかに見える。",
              "citation": {
                "source": "ドーヴィル物語",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「赤肌か」と口々にささやかれる。",
              "citation": {
                "source": "緋のエチュード",
                "author": "A STUDY IN SCARLET",
                "note": "青空文庫"
              }
            },
            {
              "text": "日光と霧と松脂のしずくとが細かく降注ぐ山土の傾斜、ふやけた落葉の堆積のなかから踊り出して来たこの頭の円い菌こそは、松山の赤肌に嗅がれる体臭を、遺伝的にたっぷりと持ち伝えた、ちゃきちゃきの秋の小伜である。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こういってたぬきが火ぶくれになって、赤肌にただれている背中を出しますと、うさぎはその上に唐がらしみそをところかまわずこてこてぬりつけました。",
              "citation": {
                "source": "かちかち山",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の魂は皮膚を剥がれた赤肌である。",
              "citation": {
                "source": "情意の干満",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "峨峨温泉展望青灰色の岩壁の外輪をあんなにもうねうねと帆走する白雲の塊り峽中は西風をめぐらした城のやうに今にも霧をはなち、雨を吹き入れよう下には阿羅漢の如く浴する赤肌の農人が物見臺の上にゆつたりと歩みいで衣をかかへて、遠く陰りゆく日を惜しげにその青青とした髯を風にすりつけては仰ぐ。",
              "citation": {
                "source": "季節の馬車",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "始めはところどころがぽくぽく穴のように落ち込んで見えたが、後には赤肌に脱け広がって、見るも気の毒なほどにだらりと垂れていた。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　赤裸今一人の逆語序論者金沢庄三郎先生は、裸（はだか）は赤肌（あかはだ）と言ふ旧来の説によつて、語序の逆になつたものとしてゐられた。",
              "citation": {
                "source": "日琉語族論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔ひどれ船私は不感な河を下つて行つたのだが、何時しか私の曳船人等は、私を離れてゐるのであつた、みれば罵り喚く赤肌人等が、彼等を的にと引ツ捕へ、色とりどりの棒杭に裸かのままで釘附けてゐた。",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　きょうはまるで朝から日射しものぞかせない灰色の冬空がますます低くおりてきて、ふきあげるひどい空らッ風が、腰かけている赤肌の松の巨木をユサユサと揺ぶった。",
              "citation": {
                "source": "冬枯れ",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "明月院の相手は、羽着きの薄い枯笹色の貧相な鶏で、いくどかの戦いで背中のあたりまで羽毛をむしられ、ぞっとするような赤肌をむきだしているのは悲惨だが、鶏冠を半分以上も剃り落してあるので、頭だけ見ると、鸚鵡のお化けのようで滑稽だった。",
              "citation": {
                "source": "春の山",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "死体を運搬する途中、瓦礫の上を手荒に引摺り廻されたものと見え、顔面はすっかり赤肌になり、人相が識別出来ぬほどに破壊されているのである。",
              "citation": {
                "source": "魔都",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもこの驚くべき勇士の決心は、赤肌をした松の幹の高い所に、二本の青い人間の足がブーラ、ブーラとしているのを見出した瞬間、何の役に立ったろう！",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さ、早い奴に褒美をやる」　赤肌の大地に、明るく銀貨が音を立てて飛ぶと、坑夫達は大人も子供も仕事を放り出して群がって来た。",
              "citation": {
                "source": "雲南守備兵",
                "author": "木村荘十",
                "note": "青空文庫"
              }
            },
            {
              "text": "行者ものぼらないという鷲ヶ岳の赤肌へ、武蔵は、抱きついていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "めくれた皮の下から、黒血がほとばしって、ベロベロの、見るも無悪な赤肌が現れて来ることを、想像したからだ。",
              "citation": {
                "source": "吸血鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな日の激流に削られたような切岸が、足利の町屋根から数町東の岩井村の辺で赤肌をむいていた。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "傑作のお手本、あかはだか苦しく、どうか蒲の穂敷きつめた暖き寝所つくって下さいね、と眠られぬ夜、蚊帳のそとに立って君へお願いして、寒いのであろう、二つ三つ大きいくしゃみ残して消え去った、とか、いうじゃないか。",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、すこしずつ大きくなるにつれて、だいいち私が自身いやらしくなって、私の特権はいつの間にか消失して、あかはだか、醜い醜い。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "褐色がかった火星兵の、あかはだかの死体が、あたり一面に、ごろごろころがっている。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「奴らは赤膚になるまで、うんと新聞で叩いてやらなくちゃならん。",
              "citation": {
                "source": "グーセフ",
                "author": "ГУСЕВ",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そう肚を据えると、銅提が新たに榾火から取下ろされて、赤膚焼の大｜湯呑にとろりとした液体が満たされたのを片手に扣えて、折からどうと杉戸をゆるがせた吹雪の音を虚空に聴き澄ましながら、客はおもむろに次のような物語の口を切った。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "……さう肚を据ゑると、銅提が新たに榾火から取下ろされて、赤膚焼の大｜湯呑にとろりとした液体が満たされたのを片手に扣へて、折からどうと杉戸をゆるがせた吹雪の音を虚空に聴き澄ましながら、客はおもむろに次のやうな物語の口を切つた。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で特に、赤膚媛と標記された若い女性の一体と、片氏月姫と標記された一体とが、著るしく僕の注目をひいた。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、それがあの博物館にあつた赤膚媛、牙氏月姫といふ二体のミイラに他ならぬことを認めた。",
              "citation": {
                "source": "わが心の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "明月院は眼を光らせて周平の顔を見ていたが、なにが気にいらないのか、羽毛のない赤膚を緊張させると、怒り毛を逆立て、いまにも飛びかかろうとするように、身体をゆすりながら足踏みをはじめた。",
              "citation": {
                "source": "春の山",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも眼のとどく限り、東方と北方の海上には、赤膚の巉巌が、世界の障壁のごとくに、涯しもなく列なって、断岩と断岩との間から顔を覗かせている。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "古筆はそれを二百年になる清水の仁清だというが、このような刻印は見たことが無く、柏木は古い大和の赤膚だと鑑定し、安藤は大和の萩だといい、増田は古薩摩といい、前田は摂津の浪華であるかも知れぬと思い、更に別の、名前を忘れたが、一専門家は、それは尾張の志野だといった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "郡山は金魚の養殖を以て名がありますが、品物としてはその近くに産する「赤膚焼」が世に聞えます。",
              "citation": {
                "source": "手仕事の日本",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
