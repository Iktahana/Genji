        "examples": {
          "standard": [
            {
              "text": "あの映画のアクターはハリウッドの有名な人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼はアクターとしてアカデミー賞を受賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "このドラマに出ているアクターは新人ばかりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "▲ヒー、イズ、アクター　十八日朝七時出発、快晴。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "一心に写生をやっている未醒画伯を指して「あれはなんだ」と聞かれ、将軍反り返り、得意になって曰く、「ヒー、イズ、アクター」　西洋人、目を丸くして未醒氏の顔を見る。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "将軍、アーチストとアクターとを何の気なしに滑らして、色の黒い未醒画伯とうとう俳優となってしまった。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近できた『グリーン』や『カナリア』に扮したアクターは、まあはまり役だろう。",
              "citation": {
                "source": "ヂユパンの癖とヴァンスの癖",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭抜けたアクターであり、その底にひそむ勝負師の根性ははかり知れないものがあるやうである。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その点、升田もアクターであるが、ちよッとアチャラカのアクターであり、大山は本舞台のアクターといふ感じであつた。",
              "citation": {
                "source": "勝負師",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、アクター・プロデューサーである僕が、一日たりとも此うもろく破れたりしては困る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
