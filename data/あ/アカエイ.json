        "examples": {
          "standard": [
            {
              "text": "海水浴場の浅瀬で泳いでいた赤エイが、長い尾をくねらせながら砂を舞い上げて逃げ去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "釣り上げられた赤エイの鋭い毒針に刺されないよう、漁師は細心の注意を払って扱っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "水族館のトンネル水槽で、頭上をゆっくりと通り過ぎる赤エイの平らな白い腹部を眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "俺がかかとを痛めたのなんて、赤エイに刺された時くらいだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここでつった魚は、イソマグロ、カツオ、カマス、シイラ、赤まつ鯛、白鯛、ヒラカツオ、カメアジなど、多くの種類で、ときどきは、長さ二メートル、太さ人間の足ほどもある海蛇や、尾のなかほどに毒針のある、アカエイも、つり針にかかった。",
              "citation": {
                "source": "無人島に生きる十六人",
                "author": "須川邦彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
