    "definitions": [
      {
        "index": 1,
        "gloss": "to be tripped up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "深い雪の中を歩いていると足を取られて、思うように前へ進めなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歩道の段差に足を取られてよろめき、通りすがりの人に支えてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "競走馬が柔らかいターフに足を取られ、最終コーナーで大きく遅れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "迂濶にそれを否認して、飛んだ揚げ足を取られるのも口惜しいと思ったからであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "まともなキーボードのついたパーソナルコンピューターがあのサイズにおさまり、二十万円を切ったことで、独自の『使いやすさ』をタコ壺にこもって追及する日本語ワープロに足を取られる犠牲者は、激減すると踏んだ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎に揚足を取られるやうぢや世話アねエ」　平次は苦笑ひをしました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "十萬兩の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "八五郎に揚足を取られるようじゃ世話アねエ」　平次は苦笑いをしました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "十万両の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "国内的物価騰貴が投機思惑によるものであるかのような云い方は、忽ち揚げ足を取られる点だろう。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "「地面に繩が張ってあるかもしれないぞ、足を取られるな」　斧田又平が「おう」と答えた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
