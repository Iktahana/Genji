[
  {
    "uuid": "77ae9d38-10f0-54ea-a5fc-f9564f83e8a6",
    "entry": "諦めがつく",
    "reading": {
      "primary": "あきらめがつく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
