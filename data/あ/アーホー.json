          "literary": [
            {
              "text": "アーホー、アーホーと啼くはこの地方にて野におる馬を追う声なり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを心配して夜どおし山の中を探しているうちに、これも鳥になって今でもアーホー・アーホーと啼きあるくといっている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーホーはこの地方の牧童が馬を集める喚び声であって、他では必ずしもそうは言わぬから、他処ではもうその話は通用せぬわけである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
