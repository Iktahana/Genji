        "examples": {
          "standard": [
            {
              "text": "毎日、温めるについて考えています。",
              "source": "幻辞"
            },
            {
              "text": "我が社の温める戦略は重要です。",
              "source": "幻辞"
            },
            {
              "text": "温めるの原理は複雑である。",
              "source": "幻辞"
            },
            {
              "text": "温めるという言葉が頭から離れない。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは温めるについて学んでいる。",
              "source": "幻辞"
            },
            {
              "text": "温めるの治療方法は多様である。",
              "source": "幻辞"
            },
            {
              "text": "温めるに関する法律が改正された。",
              "source": "幻辞"
            },
            {
              "text": "選手たちは温めるを目指している。",
              "source": "幻辞"
            },
            {
              "text": "自然界での温めるは見事である。",
              "source": "幻辞"
            },
            {
              "text": "歴史上、温めるは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "温めるは日本文化の一部である。",
              "source": "幻辞"
            },
            {
              "text": "旅行中に様々な温めるを見つけた。",
              "source": "幻辞"
            },
            {
              "text": "「温める」という概念について深く考察する必要があります。",
              "source": "幻辞"
            },
            {
              "text": "「温める」という概念について深く考察する必要があります。",
              "source": "幻辞"
