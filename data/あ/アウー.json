          "literary": [
            {
              "text": "サムといっしょに、ワラも「アウー」と狼の遠吠えをやる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「式を挙げるまで、これを僕と思って可愛がって下さい」　という婚約者のお手本みたいな甘ったるい文句附きであったが、その犬の特徴というのは、ピアノを弾き初めると妙に眼を白くして天井を見てアクビみたいな声を出して、アウーアウーと合唱する。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭へ立って、二階の方を見上げながら宏子は手を筒のようにして、「アウーウ」と大きく抑揚をつけ呼んで見た。",
              "citation": {
                "source": "雑沓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
