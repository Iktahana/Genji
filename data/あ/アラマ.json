        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヴォアラ、ネスパ、セッサ、ムシュー、アラマディ、プレンプアン、ラタヽパン。",
              "citation": {
                "source": "二科狂想行進曲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お眼ざましにお二人でお上んなさい」「……アラマア……どうも済みません。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで早速、私に宛てた至急親展で、事のアラマシを通知して、事実かどうかを問い合わせて来た訳ですが、その手紙を受取った時には私も、思わずシインとなりましたよ。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それでは……これで……お暇を……この御恩は死んでも……」「アラマア……」　眉香子は追いかけるように二、三歩進み出た。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしは役目柄ズッと入るけに、アンタはすこし遅れて、いつもの通りの物貰いの風で、人にわからん様、入んなさいや」「おっとアラマシ承知の助。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は四郎の兄の一郎なんです」「アラマアあたくし、どうしましょう」とジュリアは美しい眉を曇らせたが「とんだお気の毒なことになりましたわネ」　といって目を瞑じ、胸に十字を切った。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは面白い……」と帆村は手帖に書きとめて、「……アラマソーオ、マダムイナイノ、ダマシタノネ、ソトハサムイワ、マサニ、オオサム……。",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラマソオオ、マダムイナイノ、ダマシタノネ、ソトハサムイワ、マサニ、オオサム……」　と一度例の文句を片仮名で書いた。",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラマという音の逆はマラアではなくて、ローマ字を逆にした AMARA――アマラなんだ。",
              "citation": {
                "source": "獏鸚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――妹ガ家モ続ギテ見マシヲ、大和ナル大島ノ嶺ニ、家モアラマシヲ。",
              "citation": {
                "source": "春泥",
                "author": "『白鳳』第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラマ、ほんとに、どうしませう」　はからざる大声で悲鳴をあげる。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上がお魚女史の第一回目の訪問のアラマシである。",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラマ、エヘヘ、言ッチャッタワヨ、アハハ、バカネ、チェッ！",
              "citation": {
                "source": "お魚女史",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから別に鮭のアラマキを薄く切り、それを飯の上に載せて、その上から柿の葉の表を内側にして包む。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "吉野へ遊びに行った友人があまり旨いので作り方を教わって来て伝授してくれたのだが、柿の木とアラマキさえあれば何処でも拵えられる。",
              "citation": {
                "source": "陰翳礼讃",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし厚い壁に立ち向かう強いアラマン族（西ゲルマン）の頭骨に我々は気がつき世界に挑戦する鍛え抜かれた男の特徴に気がつく。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "東部日本の多くの都会にあるアラマチ（粡町）という地名は、もと玄米調製が城下市街の事務であったことを示している。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮭や鱒にも以前はこの貯藏方法が盛んであつたらしく、今もアラマキといふ語が知られて居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラマキは淺漬と同じくあらく鹽をふり撒いたからの名かとも思つたが、マクはやはり藁を以て卷くことであつたのが、この包みシヒラの類推によつてわかつた。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮭や鱒にも以前はこの貯蔵方法が盛んであったらしく、今もアラマキという語が知られている。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラマキは浅漬と同じくあらく塩をふり撒いたからの名かとも思ったが、マクはやはり藁をもって巻くことであったのが、この包みシイラの類推によってわかった。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラマア、この柄は山北の鶴子さんのだわ。",
              "citation": {
                "source": "鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラマア、ちっとも存じませんで、どなた様でございます」　老婆はなじり顔に、大声でいった。",
              "citation": {
                "source": "一寸法師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
