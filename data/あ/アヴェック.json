          "literary": [
            {
              "text": "化石なんか採ってるアヴェックを、だれが本気にしますか」　なにか一撃くらわせようと、芝は高志をにらんだが、ここにいては、じぶんのほうの関心事も進展する可能性がないことに思いあたったのか、渋い顔でシャーベットを受けとった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "男達の前には、ビールが、美和子と相川さんの前には、バーテンの創案の、アルコール分の少いアヴェック・モア・カクテールが運ばれた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "つて伺つたらね、――ノン・アヴェック・ヴウ、と来たわ」　そして、彼女は、笑ひこけた。",
              "citation": {
                "source": "ある夫婦の歴史",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "真帆子も、アヴェック・ヴウの意味ぐらゐはわかつた。",
              "citation": {
                "source": "ある夫婦の歴史",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぼくは、いま、どんな女性とだってうまく家庭をもって行くことが、できるような気がするんだ」ながい髪をふりみだして失笑して、アヴェックできた彼女は一蹴した。",
              "citation": {
                "source": "演技の果て",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヴェック・シートだった。",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
