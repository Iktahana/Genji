    },
    "definitions": [
      {
        "index": 1,
        "gloss": "flaxseed",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "亜麻仁を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは亜麻仁について学習した。",
              "source": "幻辞"
            },
            {
              "text": "亜麻仁の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は亜麻仁の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では亜麻仁が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "亜麻仁という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に亜麻仁という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では亜麻仁についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "亜麻仁を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると亜麻仁は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "亜麻仁について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では亜麻仁が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に亜麻仁は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により亜麻仁の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "亜麻仁は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に亜麻仁は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "それは粘土を亜麻仁油にとかしてその液面に印刷しようと思う絵の具を、牛の胆汁あるいはその他の特殊油に混じて流すのである。",
              "citation": {
                "source": "墨流しの物理的研究",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "贋コショウは亜麻仁かす（アマの種子から油を絞ったかす）、粘土および一部のトウガラシからなり、塊を作り、まず最初に篩を通し、次に桶の中で転がして丸める。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "［校正者による追加ここまで］　食物脂肪の代謝についての最初の一連の実験は亜麻仁油から作った重水素脂肪を使って行われた(7)。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜麻仁油の部分的な水素添加によって得られた脂肪は種々の脂肪酸からなるはっきりと定義されていないグリセリドであり、そのうちのあるものは生理的でない構成の可能性がある。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "亜麻仁油を使う最初の実験で動物は低脂肪食に保っていて、観察された脂肪蓄積の一部は動物が特定脂肪酸を要求するためとも考えることができた。",
              "citation": {
                "source": "生体構成物質の動的状態",
                "author": "THE DYNAMIC STATE OF BODY CONSTITUENTS (1942)",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほだから、まず、爺つあまに訊いてみせえ。",
              "citation": {
                "source": "山茶花",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ほんじゃ、爺つあまに、おれ、直接に、訊いで見んべかなあ？",
              "citation": {
                "source": "山茶花",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊枝の母が、若い年で死んだ時などは、村中に「あの爺つあまに追い廻されちゃ……よっぽどの稼人だって死んでしまうべさ！",
              "citation": {
                "source": "駈落",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海ぞいに立て連ねた石杭をつなぐ頑丈な鉄鎖には、西洋人の子供たちが犢ほどな洋犬やあまに付き添われて事もなげに遊び戯れていた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああまにあわん」　イバンスがこういった、その一せつなである。",
              "citation": {
                "source": "少年連盟",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "しねりに、儀来（ぎらい・じらい）との関係が見えるばかりか、あまみのあまには、儀来同様、海なる義が窺はれるのである。",
              "citation": {
                "source": "琉球の宗教",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "――お兼あまにどれだけ男がいるか、本当に知っているのは亭主のしっつぁんだけだ。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
