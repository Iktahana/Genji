  {
    "uuid": "fe98a64b-7c58-5cad-9699-d3ac0fac4b82",
    "entry": "アマニ",
    "reading": {
      "primary": "あまに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
