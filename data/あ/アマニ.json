    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今の主人の祖父いさんの代で、其人からさつき云つた、あのセンツアマニと云ふ名が剏まつたのだ。",
              "citation": {
                "source": "センツアマニ",
                "author": "FAMILIE OHNEHAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人共長生をして、センツアマニの一族は今でも栄えてゐる。",
              "citation": {
                "source": "センツアマニ",
                "author": "FAMILIE OHNEHAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで山登りをする人は、まるで武士が日本刀を大切にするように、アックスを大切にし、ステッキには常にアマニ油をぬり、鉄の部分はピカピカ光らせておきます。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
