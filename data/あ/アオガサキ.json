        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "色眼鏡をかけた男、東亜産業社長アオガサキと並んで登場。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　お話はだいたいわかりました。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　卓見です。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　ご家族は？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　ご戯談。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　まつたく、当節はうつかり汽車にも乗れませんからなあ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　呉れるといふものは、とつておおきなさいよ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　それやさうですとも……宿賃だつて馬鹿になりませんよ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　おほきに、おほきに……だが、田舎でも旅は油断がなりませんよ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　はつきり申しますが、わたしの会社の外交は、然るべき人物にやらせてをりますから、これ以上、手を延ばす必要を認めません。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は、あの曲者のアオガサキ、例によつて虚勢を張るかも知れん。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノロミ、アオガサキを案内して登場。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　それはそれは、ご丁寧にどうも……。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　どうしまして……新参者のなにかと手違ひだらけで、お恥かしい次第です。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　はゝは、時に、例の色眼鏡の一件ですが、お宅では、どう対策を講じられますか。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　すると、どんな手を打ちますか。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　わたしの方の情報を綜合しますとね、社員をこつそり聴衆のなかにまぎれ込まして、講演の内容をノートさせてみたりしたんですが、これといつて、われわれ業者の立場を悪くするやうな言辞は故ら弄してはゐない様子です。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　その傾向はあるらしいですな。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　多少はあるかも知れませんが、さういふケースはごく稀れです。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　いや、いや、そこまでのことをわたしは申してはをらん。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　まあ、そのへんの見解は、お互に多少の差があるものとして、こちらは、一歩あなたに譲りますが、その対策をいつたい、どうしますか？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　と、いふと？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　買収とは、利をもつて誘ふ？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　で、それを強制する力は？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　金をつかませる？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　つまり、口止め料、沈黙に対して払はれる報酬ですか。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　それは、組合の理事長たるあなたの権限だ。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　わたしは敢て反対はしません。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）アオガサキ　　こゝへ、奴さん、来るのですか？",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アオガサキ　　用意周到、おそれ入りました。",
              "citation": {
                "source": "椎茸と雄弁",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
