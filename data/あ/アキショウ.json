        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "凧の話は如何したの、もうあきらめたと見えるね、お前は子供の時から物に飽き性だつた。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、いつか戴くところの司権者を変えてしまう、下民の力と、その飽き性が恐い。",
              "citation": {
                "source": "大谷刑部",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木は彼の猟奇癖の為に、又｜飽き性の為に、殆ど細君の存在を無視して暮して来た。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "飽き性というのであろう。",
              "citation": {
                "source": "自作解説",
                "author": "怪人二十面相と少年探偵団",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
