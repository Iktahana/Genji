[
  {
    "uuid": "73ef89b2-de7e-5301-bd3c-d8b1770c620c",
    "entry": "嗚呼嗚呼",
    "reading": {
      "primary": "ああああ",
      "alternatives": [
        "あーあー",
        "あーーー",
        "アアアア",
        "アーアー",
        "アーーー"
      ],
      "is_heteronym": false
    },
    "grammar": {
