        "examples": {
          "standard": [
            {
              "text": "来月、アゼルバイジャン共和国の大統領が公式訪問のため来日する予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "石油資源が豊富なアゼルバイジャン共和国は、近年急速な経済発展を遂げている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "会議室のテーブルには、日本とアゼルバイジャン共和国の国旗が並べて飾られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "有名な定期市が終った朝、ニージュニ・ノヴゴロドからイリイッチ号という小ざっぱりした周遊船にのって、秋のヴォルガを五日かかってスターリングラードまで下り、そこからコーカサス、チフリスと経て、アゼルバイジャン共和国の首府バクーへ来たのであった。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
