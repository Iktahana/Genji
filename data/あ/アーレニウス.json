          "literary": [
            {
              "text": "ボルツマンやアーレニウスは、そういうプリンシプルの夢を書き残した。",
              "citation": {
                "source": "ルクレチウスと科学",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マクスウェル、ボルツマン、アーレニウスらを悩ました宇宙の未来に関するなぞを解くべきかぎとしての「第三第四の方則」がそこにもしや隠れているのではないか。",
              "citation": {
                "source": "量的と質的と統計的と",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳者付記　スワンテ・アウグスト・アーレニウス（Svante August Arrhenius）は一八五九年にウプザラの近くのある土地管理人の息子として生れた。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケルヴィン、ラサフォード、アーレニウス、オングストロームなどという科学史上の人びとから、薫陶を受けた由で、話は非常におもしろかった。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
