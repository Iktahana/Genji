        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "エジプトを舞台にした冒険小説で、主人公はアスプが岩陰に潜んでいるのに気づき、慌てて足を引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "博物館の爬虫類展示コーナーにアスプのはく製が飾られ、その扁頭の形に子どもたちが見入っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "クレオパトラの死にまつわる伝説には、アスプを使ったという説が今も語り継がれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それからアスプといってエジプトの美女皇クレオパトラが敵に降らばその凱旋行列に引き歩かさるべきを恥じこの蛇に咬まれて自殺したとある。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれは「アスプレニウム」属のカミガモシダの本名で、つまりホングウシダとカミガモシダとは本来同物なのである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "反応の早いのがいたり、フォックス・エアスプリッタの獲物が好きなのがいたり、カーナカーズに激しく反応するのがいたり。",
              "citation": {
                "source": "理想",
                "author": "THE IDEAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスプレドーン、ミニエーのオルコメノスに住める族、將はアレース生める二子、アスカラプォスとヤルメノス、その誕生のゆかり聞け、アゼーオスの子アクトール、其｜家にむかし無垢の處女アスチオケーは樓の上昇り、軍神アレースと私かに契り生むところ、515三十艘の兵船は彼らをのせて進み來ぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
