        "examples": {
          "standard": [
            {
              "text": "今年の母の日のプレゼントとして、濃いピンク色の花をたくさんつけたアザレアの立派な鉢植えを贈った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "春になって暖かくなると、近所の公園にある大きな花壇に色とりどりのアザレアが一斉に咲き乱れる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "アザレアは寒さに少し弱い植物なので、冬の間は霜に当てないよう室内の日当たりの良い窓際に置いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "時々アザレアを無造作にかきわけている。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "空気は生暖かく、音楽の調べは満開アザレアの背後に控えた楽団が演奏し、怠惰な愛を思わせた。",
              "citation": {
                "source": "道化玉座",
                "author": "A MUMMER'S THRONE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
