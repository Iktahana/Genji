        "examples": {
          "standard": [
            {
              "text": "昔、スケジュール管理のためにコンパックのアイパックを常に持ち歩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "引き出しの奥から、画面に傷のついた古いアイパックが出てきて懐かしくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "スマートフォンが普及する前、彼は最新型のアイパックで外出先からメールをチェックしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
