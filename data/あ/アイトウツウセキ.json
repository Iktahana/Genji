        "examples": {
          "standard": [
            {
              "text": "会社創設メンバーの訃報に際し、社長は朝礼で哀悼痛惜の念を禁じ得ないと沈痛な面持ちで語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "偉大な文学者の死を報じる新聞の社説は、哀悼痛惜の思いに溢れた名文であった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "友人の若すぎる死に対し、私はただ哀悼痛惜の言葉を並べることしかできなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "先生の懇切な御指導のもとに専心演劇研究に精進しつつあったわれわれは、このにわかの悲しみに遭って哀悼痛惜の念に耐えません。",
              "citation": {
                "source": "小山内薫先生劇場葬公文",
                "author": "久保栄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
