[
  {
    "uuid": "2fc265ff-d93f-5bf3-b75a-2c6123e99358",
    "entry": "穴生",
    "reading": {
      "primary": "あのう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
