        "examples": {
          "standard": [
            {
              "text": "この通りはアクロス通りと呼ばれ町を横切っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "公園を横切ってアクロス移動できるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "2つの建物がアクロス配置で対比をなしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "13だから、いいつづけるだろういつまでもここで暮らすと〈フェリー・アクロス・ザ・マージー〉ジェリー＆ザ・ペイスメイカーズ「あれ、まったくおなじ形なんだね」　ワラが、ヴェランダの手すりにもたれて、三階部分の工事に入った、新しい寮を見ながらいった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリップ・ギブスの『国境を横切りて』（アクロス・ザ・フロンティア）というのがあり、買いたいようでもあったが、おやめ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その店の営業時間は十一時から十一時まで、そして「サーヴィス・イズ・コンティニュアス」つまり休み時間なしであり、店の場所はケワロ・ベイスンのむかい側、「アクロス・フラム・ケワロ・ベイスン」だそうだ。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクロス・フラム・リフエ・ショッピング・センター。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
