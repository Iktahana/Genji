        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あまりにサン・ジュスト的なところが多くて、アナカルシス・クローツ的なところが充分でなかった（訳者注　両者共に大革命時代の人）。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナカルシスの意見によると、一国の一番幸福な状態は、他のすべての事柄が平等であって、ただ徳ある者ほど崇められ不徳な者ほど卑しめられるところに、生ずるのである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナカルシスはギリシア人が食事の終る頃に、始めよりはずっと大きな盃の数を重ねるのを見て驚いたが、それはドイツ人がそうするのと同じ理由からであるように思う。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
