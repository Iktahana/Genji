        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その中にアリック少年とラファエレとサヴェアとがやって来た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、アリックが私を呼んだ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日の午後街へ使にやったアリック少年が、昨夜遅く繃帯をし眼を輝かして帰って来た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルノール・ド・ヴィラノヴァ、アンリ・ド・モンドヴィル、ギ・ド・ショアリックである。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから最近、アリックス皇太子の住むウィーンに耳目が集まっていた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつでも血なまぐさい悲劇が起こり、アリックス皇太子自ら王位につきかねない。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時点で、アリックス皇太子がロシアの味方という噂はどうでもいい。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "退位書に署名したから、今頃間違いなく、代表団はアリックス皇太子へ王位を授けるために、ウィーンへ行く途中だろう。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも数日の余裕があれば、アリックス皇太子が帰国されます。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "大臣たちは退位を宣言するように迫り、アリックス皇太子を選ぶ」　レックミア侍従が意味ありげに答えた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリックス皇太子をかつぐまで、公表すべきじゃありません」「証明できるとお考えですね」　と女王がかすれ声でおっしゃった。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、私的な感情を脇に置き、あらゆる苦悩に耐えて、ロシアが事態を知る前に、アリックス皇太子をアストリアへ呼びよせねばなりません。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "一たびアリックス皇太子が王位継承に指名されれば、ロシアは無力です。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま最も肝心なことは、アリックス皇太子と連絡がつくまで、国王の死を隠さなければならないことです。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん、アリックス皇太子をしっかりと王位後継者にした後です。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "国民はアリックスについて行くでしょう。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまごろ、アリックス皇太子も確実に現場にご臨席されておられます。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "後継者を問われれば、アリックス皇太子を指名したい。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとたびアリックス皇太子が後継を受諾すれば、ロシアに勝てるだろう。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "エアノ王はアリックス皇太子を支持して退位した。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリックス皇太子はアストリアの首都できのう、民衆の歓喜の声と共に戴冠した。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆が見て喜んだのは、ロシアが行き詰ったこと、アリックス皇太子の戴冠が好感を与えたこと。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし実際に国王の亡骸を見たし、更に具合の悪いことに、どうやらアリックス皇太子がアストリア国の玉座に正式に座ってしまった。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロシアに勝ったし、アリックス皇太子がいれば王朝は安泰でしょう。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
