        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は地域のボランティア活動にとてもアクティブだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "休日は家でじっとしているより、アクティブに外で過ごしたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は80歳を超えているが、非常にアクティブな生活を送っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "『ＣＯＭＰＵＴＥＲ』という雑誌の一九七七年三月号に載った「パーソナル・ダイナミック・メディア」という記念碑的な論文の最後に、彼がユタ大学に博士論文として提出した「ザ・リアクティブ・エンジン」や、所属していたゼロックス社パロアルト研究所の技術レポートとしてまとめた文献に関する記述がありました。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが「リアクティブエンジン」と名付けた論文の骨組みを固めて、長大な原稿をまとめているあいだにも、ケイはいくつかの試みに影響を受け続けていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクティブにどんどん自分のよみたい本は買い、ききたい音楽はききたい。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして復習と社会的作業――自分より小さい幼稚園の子供をお客にすると云う――とを結びつけたところアクティブだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常にアクティブにやって居る。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日リテラツールナヤ・ガゼートにレーニングラードのクルジョークは非常にアクティブで、却ってモスク※の方がそうでないことが出て居たばかりだ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひた駛りに駛る鋼鉄の車室に坐って、アクティブな肉体の運動は、何も要求されない。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人に対して平静、順応的にしてアクティヴに非ざる限り、我等が民族の文学は何時迄も反復に終るであらう。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに事引抜きに関するかぎり、会社側がいかに抗弁しても、アクティヴの立場にあるものは常に会社側であり、俳優監督はどこまでもパッシヴであるという事実はあまりに明白過ぎていまさら議論の余地はない。",
              "citation": {
                "source": "映画界手近の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって引抜きがもしも不徳義であるならば、その罪の少なくとも大部分はアクティヴな立場にある会社側が負うべきであって、決して監督俳優の責任ではない。",
              "citation": {
                "source": "映画界手近の問題",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてのアクティヴな作家は、前線に、また前線に近い銃後に赴いて、彼らの文学的記録・通信を送っていた。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "爛熟し、妖しきまでに完成された女性には、一種異様な圧倒されるような、アクティヴな力のあることを感じた。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、ひどく利己的な、その癖極めてお体裁屋の私は、このアクティヴな力を圧倒してまで飛込んで行くことが出来なかった、それで人足先きにマダムへのスタートを切ったらしい青木を、ただニヤニヤと見つめるのであった。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは決してのしかかって来るようなアクティヴな美しさではなかったけれど、丁度その彼女の纏っている聊か流行おくれなワンピースの碧羅が、しっくりと吸い附くように似合うような、静かな柔かな美しさであった。",
              "citation": {
                "source": "植物人間",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのうは、かえってからマツがなかなかアクティヴなので、すっかり夜具干しして、風呂敷につつんでしまって、きょうはマツ縫いなおす分のほどきものをして居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "求めることにおけるアクティヴ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "卯女は何でもアクティヴです、康子リードされている、それできっとずっと仲よしでしょう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の評論に何かの価値の独特さがあるとすれば、それは小説をかく人間が書く生活性であるということ、そしてその生活性の質によって結果されるアクティヴィティであるということだと思いますが、そう批評する人は少いわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "向日性というものは寂しいなんて思いをしたがらない、しようとしない、寂しそうになると大いそぎでそれをふき消そうとするアクティヴィティだけでは、浅くそして単純ね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "非民主的な日本の政府は、日本におけるユネスコ運動が、人民のアクティヴィティの一つとして表現されることを極端に嫌っている。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もどういう仕方に於て実践の要素が認識の過程に介入するかは、分析を必要とすることで、単に知識の理論的な行きづまり――夫は理論的矛盾となって現われるが――を実地や経験というものの責に転嫁して、理論的な解決を打ち切ることは、ファシスト的アクティヴィズムか、僧侶的な神秘主義のデマゴギーにぞくする。",
              "citation": {
                "source": "科学論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれで英語の「え」の字もしゃべれず、パッシヴ・ヴォイスとアクティヴ・ヴォイスの区別さえも分らないとは、誰も知るまいが己だけはちゃんと知っているのだ。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の、パッシヴとアクティヴの力の合成によって、狂態が漸次倍加されて行きました。",
              "citation": {
                "source": "Ｄ坂の殺人事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "急に気がアクチブになりますよ。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
