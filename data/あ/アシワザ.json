    "definitions": [
      {
        "index": 1,
        "gloss": "foot technique (in judo, sumo wrestling, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は柔道の試合で得意の足技を決め、相手を鮮やかに投げ飛ばした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "相撲では足技が禁じ手に近いとされる一方、柔道ではれっきとした技術として磨かれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "道場では師範が足技の基本を丁寧に教え、生徒たちは繰り返し練習した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "水練の覚えのない新九郎は、たちまち眼もくらんで二、三度水を呑んだが、一角は水技にたけている上、福野流の体術の心得が充分あるので、喉輪を締められながらも、足技を試みて、右手には素迅く短剣を逆手に持つ。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「えいッ」　と同時に新九郎の気合、パチンと紫色の火花が散る――と思うと二、三合、シュッシュッと刀競りに縒り合って、あわや鍔競り――双方必死の足技を試みつつ、タタタタと押しつ押されつの息喘ぎ、昼なら玉なす脂汗がどっちにもギラギラ見えたであろう。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "tricks performed with the feet",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
