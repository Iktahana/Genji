  {
    "uuid": "a6d8b32f-6934-5057-a945-5a1e1a6b326e",
    "entry": "アウ",
    "reading": {
      "primary": "あう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "感動詞"
      ],
      "ctype": null,
