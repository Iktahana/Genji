    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ゲーテのフアウストやミルトンの失樂園やは、今日に於て既に詩の範圍に屬さない。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アウガスチンの如き、バンヤンの如きはその最たるものである。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者は、フアウストの一頁も、ペンテズイレエアの一幕も、おそらくは、讀んだことがないのではあるまいか。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に、昨一九三四年の『ナツーアウィッセンシャフテン』第三十一号に、その飼育法に関する記事が掲載されていたくらいである。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その彫刻は人間の恐怖が異常な人間の脳裡によって刻まれた、アウギュスト・ロダンの作品「｜小さい花子」の死の首であった。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その花子の顔こそアウギュスト・ロダンの刻んだ「小さい花子」の死の首なのであった。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "支配人はアウギュスト・ロダンの名刺を妾に見せると、偉大な芸術家であるから、是非私に面会するようにと云うのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀で染めた髪と、眉の間に鼻眼鏡をかけたアウギュスト・ロダン氏は、妾の小さい手を芸術家らしい熱情をもってとると、不思議に透徹した眼光が妾を凝視しているのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日ジョージ・佐野は、妾がアウギュスト・ロダン氏のアトリエへ行くことに反対しました。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "よってファーニッシング部は廃業して、南京路入口、アウトフィッチング・デパートメントの一部とともにスコッチ・ベーカリーに賃貸するに至れり。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまこそ、アウフヘエベンの朝である。",
              "citation": {
                "source": "HUMAN LOST",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲痛も、度を越すと、滑稽な姿にアウフヘーベンするものらしい。",
              "citation": {
                "source": "『玩具』あとがき",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グルルル、グルウ、ユー、リトル、ラズカルズ、ユー、プレイ、トラウント、ビ、オッフ、ナウ、スカッド、アウヰイ、テゥ、スクール。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはメフィストさんとはアウエルバッハ以来お仲がよろしくないのですな。",
              "citation": {
                "source": "電車",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グルルル、グルウ、ユー、リトル、ラズカルズ、ユー、プレイ、トラウント、ビ、オッフ、ナウ、スカッド、アウエイ、テゥ、スクール。",
              "citation": {
                "source": "十月の末",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）※（Ｆ・Ｉ）は「フェード・イン」、（Ｆ・Ｏ）は「フェード・アウト」",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その向ひには老処女のアウグステが据わつてゐる。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "アウグステはこの家で何事にも手を出して働いて、倦むことを知らない、をばさんである。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタニスラウスの目は向ひのアウグステをばさんの頭の上を通り越して、食堂の一番暗い隅に注がれてゐる。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからアウグステをばさんは、かう云ふ会食のある度に、三日前からと三日後までとを併せて、七日分の腹を拵へて置かうとしてゐるので、どうしたら、なる丈沢山｜饒舌つて、同時になる丈沢山食べられるだらうかと云ふ研究に汲々としてゐる。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "スタニスラウスは目を高い腕附きの椅子からそらして、ちよつとアウグステをばさんの陰気な額の上に休ませて、更に一転して、大いに意味ありげに女主人イレエネの顔に注いだ。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでアウグステをばさんが返事をしなくてはならない順序になつた。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間アウグステをばさんは色々な、下らない世間話をしてゐる。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "女主人は、アウグステをばさんがこんな日に世間話をするのを、不都合だと思つて、少佐夫人にそつとその心持を話した。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリイデリイケはアウグステをばさんが何を言はうと構はないで、女教師と話をしてゐる。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリイデリイケも、女教師も、アウグステをばさんも黙つた。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "糸の切れた緋威しの鎧が聖アウガスチンの龕に寄りかゝっている古道具屋。",
              "citation": {
                "source": "巴里祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "野球は其樣な災難が無いから、毎日／＼盛んなものだ、丁度海岸の家から一｜町程離れて、不思議な程平坦な芝原の「ゲラウンド」があるので、其處で「アウト」「ストライキ」の聲は夕暮の空に響いて、審判者の上衣の一人黒いのも目立つて見える。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいていの人間は一種のアウトマーテンである。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "俳諧の道は、われわれをアウトマーテンの境界から救い出す一つの、少なくも一つの道でなければならない。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
