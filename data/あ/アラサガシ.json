    },
    "definitions": [
      {
        "index": 1,
        "gloss": "finding fault (with)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "粗探しを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは粗探しについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "粗探しの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は粗探しの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では粗探しが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "粗探しという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に粗探しという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では粗探しについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "粗探しを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると粗探しは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "粗探しについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では粗探しが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に粗探しは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により粗探しの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "粗探しは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に粗探しは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "「……場所をとらぬ簡便な図書室を造る最良の方法は、例えば、十二巻の全集中、六頁だけ有用と信じたら、六頁だけ切取って、余は火中す可し」　然しながら、以上三人のフランスの粗探しが、二世紀に渉って、皮肉混じりの警告を発したって、愛書家の病がそれで癒おる筈もない。",
              "citation": {
                "source": "愛書癖",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽家ないしはそのジレッタント諸君が映画をごらんになる場合、ほかのことは何も見ないでもつぱら音楽のあらさがしだけに興味を持たれることは自由であるが、そのあとで、なぜこの監督はその半生を音楽の研究に費さなかつたか、などとむりな駄目を出されることははなはだ迷惑である。",
              "citation": {
                "source": "映画と音楽",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物はほかのことを考えたり、舞台のあらさがしをしたり、あくびをかみ殺したりしなくなる。",
              "citation": {
                "source": "劇の好きな子供たちへ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記というよりは、何となくあらさがし、不平｜録といったようなもののできるのは、第一に書くものの恥になります。",
              "citation": {
                "source": "女中訓",
                "author": "羽仁もと子",
                "note": "青空文庫"
              }
            },
            {
              "text": "３．それは實に無用の穿鑿（あげ足とり的なあらさがし）であつて、それを究明するに必要な暇が今私にない。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴルフの話、競馬の話、流行の話、映画の話、……浜の砂と話題はつきないが、なにより好きなのは他人のあらさがしで、よく飽きないものだと思われるほど、男も女もひがなまいにち人の噂ばかりして暮らしている。",
              "citation": {
                "source": "キャラコさん",
                "author": "社交室",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし人間の制度のあらさがしをするほど容易なことはなく、適当な実際的改善を示唆するほど困難なことはない。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "本気でいじめる気持がなくても、自然とあらさがしみたいになるんだ。",
              "citation": {
                "source": "赤い駱駝",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "第五十三章　カエサルの一句について　（a）もし我々が時折自分自身を考察してみるならば、そして他人のあらさがしをしたり・我々の外にある物事を詮索したり・するために用いる時間を我々自らを測量するのに用いるならば、我々は容易に、我々のこの全組織がいかに脆弱な各部から成り立っているかに、気づくであろう。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
