        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "お弁当の彩りが寂しかったので、茹でたブロッコリーを青みとして添えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "煮物の仕上げに、さっと塩茹でした絹さやを青みとして散らす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "刺身の盛り合わせには、大根のツマだけでなく青みも必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
