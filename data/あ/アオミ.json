        "examples": {
          "standard": [
            {
              "text": "鮮度の良い鯵の青身は、生姜醤油で食べると格別に美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "魚屋の店主が「今日の青身は脂が乗ってておすすめだよ」と声をかけてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "健康のために、鯖やイワシなどの青身の魚を積極的に食べるようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
