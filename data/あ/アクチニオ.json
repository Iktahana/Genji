        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここはバリ港から奥地へ十マイルほどいったセラネ山頂にあるアクチニオ宮殿の廃墟であった。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクチニオ四十五世さ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはきっとアクチニオ四十五世を探し出さにゃおかない」　と男は、杖をからんからんとならしながら、空に向って話しかける。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は、そういう危険をものともせず、土台石の山を登り、わずかの間隙をすりぬけて、アクチニオ四十五世たちの祈祷場をなおも探しまわった。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、それがアクチニオ四十五世の一団であることを認めた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一段高い壇の上に、新月を頭上に架けたように仰いで、ただひとり祈る白衣の人物こそ、アクチニオ四十五世にちがいなかった。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あ、あなたはアクチニオ四十五世！",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、アクチニオ四十五世のうしろに並んで新月を拝んでいた同形の修行者たちはただの一人も見えなかった。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士は聖者アクチニオ四十五世について城壁の上をずんずんと歩いていくうちに、いつしかトンネルの中にはいっているのに気がついた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖者アクチニオ四十五世は、自分の前において、壁にもたれているミイラのような人間を指し、「わが弟子たりしロザレの遺骸である。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく、それに控えていよ」「ははッ」　治明博士は、アクチニオ四十五世の神秘な声に威圧せられて、はッと、それにひれ伏した。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは実は博士のデタラメが交っていたが、一部分はアクチニオ四十五世の下に集っている行者団のことを述べたので、かなり実感のある話として聴衆の胸にひびいた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その声こそ、聖者アクチニオ四十五世の声にちがいなかった。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "かたじけなし」　と治明博士は心の中に感謝を爆発させて、アクチニオ四十五世の名をたたえた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖者アクチニオ四十五世の左手は、ふわふわとした絹わたのようなものを掴んでぶら下げていた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクチニオ四十五世も、ロザレや霊魂第十号の幻影も、同時にかき消すように消え失せた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして口の中で、アクチニオ四十五世の名をくりかえし、となえた。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アクチニオ四十五世にお前も感謝の祈りをささげなさい」　舞台の上で親子が抱きあって、わめいたり涙を流しているので、来会者には何のことだかわけが分らなかったが、やはり感動させられたものと見えて、またもや大拍手が起った。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
