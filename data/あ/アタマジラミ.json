        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヒトのアタマジラミは毛皮を持つ動物から原始人の髪に移ったものであるがこの点でもシラミの遣り取りは決して一方向ではなかったようである。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々はアラビア人のアタマジラミが東インドサルに植え付けられて数週のあいだ生き続け死亡率も低かった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間にまず取り付くのは主としてアタマジラミの雑種である。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「黒色ヒトシラミ」すなわちアフリカニグロに見つかるアタマジラミはヨーロッパや現代アメリカ人の頭のシラミとは少し違う。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベイコットの発見はヒトのアタマジラミがコロモジラミと雑婚して増殖力の強い子孫を得ることであった。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユーイングによると現在生きているインディアンはコーカサス型（白人）とエチオピア型（アフリカ人）のアタマジラミの２種とさらにアメリカ型との雑種を持っていることになる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "根拠ははっきりしないが有史前アメリカシラミはシナのアタマジラミやアリューシャンのエスキモーのシラミに非常によく似ていると記載されている。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "裸の人間が衣類を着るようになって種々のアタマジラミからコロモジラミが生じた。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタマジラミからコロモジラミへの発展の過程で多くの興味ある習慣の変化が生まれる。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "コロモジラミとアタマジラミは病気をヒトからヒトへ運ぶ。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらは同じ病気をヒトに起こしヒトのコロモジラミとアタマジラミによってヒトからヒトに伝播される。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分このことはエニド・ロバートソン博士が言うようにマレー半島でアタマジラミは居るがコロモジラミは居ないという事実によるのであろう。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし同じようにこの病気を伝播するアタマジラミは同じところに留まるであろう。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々は真夏に北アフリカでアラビア人にアタマジラミが沢山たかっていることを見ている。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば、日本では半世紀以上にわたって発疹チフスは発生していないし、アタマジラミ経由の感染はあったとしても極めて稀だそうである。",
              "citation": {
                "source": "ネズミ、シラミ、歴史",
                "author": "――専門家でない読者に必要な12章を含む発疹チフス一生の伝記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
