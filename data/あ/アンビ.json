        "examples": {
          "standard": [
            {
              "text": "鞍鼻を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは鞍鼻について学習した。",
              "source": "幻辞"
            },
            {
              "text": "鞍鼻の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は鞍鼻の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では鞍鼻が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "鞍鼻という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に鞍鼻という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では鞍鼻についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "鞍鼻を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると鞍鼻は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "鞍鼻について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では鞍鼻が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に鞍鼻は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により鞍鼻の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "鞍鼻は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に鞍鼻は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "「どうえのつて爺は、燒けた柱掘立てたのよ、そんだから壁も塗んねえのよ」「そんぢや、藁か萱でおツ塞えたんでもあんびや」「うむ、さうだあ、そんだから觸つとがさ／＼すんだよ」斯ういつておつぎの聲は少し明瞭として來た。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も「あんびん」（水注）の如き小品を作るが、昔はもっと色々作った。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんらあ甕（油甕）、あんびん（水甕）、ちゅうかあ（酒｜土瓶）、からから（酒注）、わんぶう（鉢）、まかい（碗）、その他、壺、皿、徳利、花活、香炉、湯呑、等色々の小品が出来る。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
