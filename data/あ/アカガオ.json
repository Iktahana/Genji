          "literary": [
            {
              "text": "大夫の赤顔が、座の右左に焚いてある炬火を照り反して、燃えるようである。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "会々宗徒の部将有江｜休意、黒髪赤顔眼光人を射る六尺の長身を躍して至った。",
              "citation": {
                "source": "島原の乱",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こちらは私の友人の岡田君です」「申し遅れまして」と五十｜恰好の赤顔にでっぷりと肥った紳士は丁寧に礼をしながら、「私は下村でございます」「私は佐瀬でございます」三十を少し越したかと思われる頭髪を綺麗に別けた、色白の背の高い紳士は云った。",
              "citation": {
                "source": "真珠塔の秘密",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "肥満つた赤顔の主人は御人好で、にこにこし乍ら僕が行く度に外套を脱がせたり着せたりする。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤顔を除き、半臂を脱捨て、侍女の薙刀を奪ひ、大口を穿きしまま小脇にかいこみたる形は、四天王但馬の妻と見えたり。",
              "citation": {
                "source": "両座の「山門」評",
                "author": "三木竹二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「然しジヨルジ王の赤顔の招牌は、まだ彼処に掛けてある。",
              "citation": {
                "source": "新浦島",
                "author": "RIP VAN WINKLE. EINE NACHGELASSENE SCHRIFT VON DIETRICH KNICKERBOCKER.",
                "note": "青空文庫"
              }
            }
          ]
        }
