[
  {
    "uuid": "442a0004-b22f-5f35-bc57-5a5127cfcb3c",
    "entry": "凡ゆる",
    "reading": {
      "primary": "あらゆる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
