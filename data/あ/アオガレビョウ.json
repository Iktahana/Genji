        "examples": {
          "standard": [
            {
              "text": "せっかく育てたトマトの苗が青枯病にかかり、一晩でしおれてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "農家の人たちは、青枯病の蔓延を防ぐために土壌消毒を徹底している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "葉が緑色のまま急激に枯れるのは、青枯病の典型的な症状だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "胡瓜は、親指に少し太いほどの實で、萎んだ花の名殘をまだその先につけながら、青枯病に罹つて立ち枯れてゐるものもあつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
