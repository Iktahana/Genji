        "examples": {
          "standard": [
            {
              "text": "クロークに残されたままの傘の預け主が、閉館時間になっても現れない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "銀行は預け主からの引き出し請求に対し、速やかに応じる義務がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "この迷子の犬の預け主を探すため、SNSで情報を拡散してもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "客の金をあずかっておきながら、それを渡すときに文句を付けるというのは、宿屋として甚だ質のよくない遣り方で、亭主も少し躊躇したが、しょせんは自分の欲心ですることではない、預け主のために思うのであるという理屈から、亭主も治六の忠義に同情して、結局その相談に乗ることになった。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "預け主を探し出してお返しする！",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
