          "literary": [
            {
              "text": "鍋前に陣取って揚げ立てを食う。",
              "citation": {
                "source": "下司味礼讃",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "その、揚げ立ての、上等の天ぷらを食って、しまいに、かき揚げか何かを貰って、飯を食う。",
              "citation": {
                "source": "下司味礼讃",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そいつが天麩羅のあげたてだ。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな声じゃいわれねえが、他人の名まえの手がらまでも横取りしたい連中はうようよいても、自分のあげたてがらにひとの名まえを貸してやるような、ご了見の広い者は、半分だってもご番所になんぞいねえじゃねえか。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "「与八さん、この鯣も食べてごらんよ、お団子ばかり食べないでさ……」「いけねえやい、今度は、おいらのあげたてんぷらを食うんだぞ、てんぷらを――」「静かにしろよ、与八さんの好きなのから先に食べさせるんだといってるじゃねえか」「与八さん、モットお団子をお食べ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "みちりやの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は牛乳をわざわざ飲みたいとは思わない、揚げたてのカツレツがたべたいのだもの。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚げたての精進あげまで、「やくと、なおうまいね」　電熱のコンロに焙ってたべた。",
              "citation": {
                "source": "風知草",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊だし、種、油、揚げたてをやかましくいうが、新しい掘りたてのだいこんのおろしを吟味する必要がある。",
              "citation": {
                "source": "料理メモ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚げたてのてんぷらを茶漬けにするのはもとより差支えないが、本来、てんぷらの茶漬けは古いてんぷらの利用にある。",
              "citation": {
                "source": "てんぷらの茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚げたてを生姜醤油で食ふのである。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
