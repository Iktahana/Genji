          "literary": [
            {
              "text": "疳高い甘え声が、真昼の暑熱が漸く鈍い渾然さをみせた夕刻の空気の中を、矢のやうに走つた。",
              "citation": {
                "source": "医者と赤ン坊",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま散歩から帰って来たところらしく、窓の下で、ツウアアなんて、あくびの様な甘え声をたてています。",
              "citation": {
                "source": "俗天使",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも若い女の、華やいだ甘え声である。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "甘え声で、「ちょっと、手を貸してよ」「なんだ」「帯の端を、ぎゅっと、締めてくれない？",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
