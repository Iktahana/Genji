[
  {
    "uuid": "d80c4309-52b2-5cfc-a261-7512b8852883",
    "entry": "亜種",
    "reading": {
      "primary": "あしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
