          "literary": [
            {
              "text": "普通あかめがしわを梓に当てているが、昔わが国で弓を作った木は、今でも秩父であずさと称している。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の辞書にはあかめがしわに梓字を当てて、版木に使われるとある。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして見ればむこうでいう梓はあかめがしわかとも思われる。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかめがしわは上野公園入口の左側の土堤の前に列植してある。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "『万葉』のひさきが今日のきささげならば、楸はその当時あかめがしわではなかったはずである。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            }
          ]
        }
