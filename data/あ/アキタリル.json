        "examples": {
          "standard": [
            {
              "text": "三年かけて技術を磨いてきた彼は、ようやく自分の腕前に飽き足りるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "どれだけ旅を重ねても飽き足りることなく、彼女は新たな目的地を探し続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その景色の美しさに飽き足りることなく、二人はしばらくの間、丘の上に立ち尽くしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "どうか又｜熊掌にさえ飽き足りる程、富裕にもして下さいますな。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか又｜熊掌にさへ飽き足りる程、富裕にもして下さいますな。",
              "citation": {
