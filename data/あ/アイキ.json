    "definitions": [
      {
        "index": 1,
        "gloss": "one's favorite machine; one's beloved instrument; one's own plane",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ベテランのパイロットは、長年苦楽を共にしてきた愛機の整備を欠かさない。",
              "source": "幻辞"
            },
            {
              "text": "ギタリストにとって、傷だらけのヴィンテージ・フェンダーは唯一無二の愛機だ。",
              "source": "幻辞"
            },
            {
              "text": "彼は週末になると、自慢の愛機である一眼レフカメラを手に野鳥撮影に出かける。",
              "source": "幻辞"
            },
            {
              "text": "激しい空戦を生き抜いた愛機の機体には、無数の弾痕が刻まれていた。",
              "source": "幻辞"
            },
            {
              "text": "最新のスペックを備えた愛機を導入し、動画編集の作業効率が劇的に向上した。",
              "source": "幻辞"
            }
          ],
          "literary": []
        }
      }
    ],
