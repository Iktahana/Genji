        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "で、その下りる方へ半町ばかりまた足探り試みたのであるが、がけの陰になって、暗さは暗し、路は悪し、灯は遠し、思切って逆戻りにその饂飩屋を音訪れたのであった。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも自分は手探り足探りに奥まで進み入った。",
              "citation": {
                "source": "水害雑録",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の女房は少し剥げた塗盆へ水を一｜杯に汲んだ飯茶碗を載せて「ちつとおめえ等退つてくんねえか」といひながら人々の間を足探りに歩いて巫女の婆さんの前へ置いた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "叔母や従同胞等は日が暮れて間もなく寝て了ふのだから、酔つた叔父は暗闇の中を手探り足探りに、己が臥床を見つけて潜り込むのだつたさうな。",
              "citation": {
                "source": "刑余の叔父",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅人は途方にくれましたが、後へ帰るにしても人家のある処へは、一里ばかりもありますので、暗い路を足探りに探って、上へ上へと登りました。",
              "citation": {
                "source": "死人の手",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "玲子はまた急に悲しくなりながら、サルーンの電燈を消して、ギシギシと鳴る階段を手探りの足探りにして三階の方へ上って行った。",
              "citation": {
                "source": "継子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから電燈を消して、足探りで台所｜草履を穿いて、裏口へ出て、アトをピッタリと閉めた。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……もとの処に返しておこう……というような気もちで足探りしいしい庭下駄を突っかけましたが、あまりあわてておりましたせいか、思わず前にノメリそうになった拍子に、真暗なお庭の沓脱石のあたりへ卵をコロリと取り落しました。",
              "citation": {
                "source": "卵",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これには平太郎も困りぬいたが、引返しては卑怯だと云われるから、足探りに路を探って進んだ。",
              "citation": {
                "source": "魔王物語",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき横尾の谷へ下った頃には薄暗くなってきたので、ランタンに火をつけようとしたが、ローソクに雪がついたためマッチの火ではジーッといっているだけで火がつかず、あきらめて真暗な中を足探りで下って行くうち、川の中へ辷り込んで半身びしょ濡れになってしまった。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵐の夜　一人は鎌、一人は笄、お吉と島君とは恋と意地とで嵐吹き捲く山道を手探り足探りで命を懸けて闘っている。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寸時の躊躇の後、私は手探り足探りで、窓の方へ近づいて行った。",
              "citation": {
                "source": "囚われ人",
                "author": "――寓話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "見えない乍らも、馴れた自分の家で、足探りの見當はつくのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "寳掘りの夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "不知案内の暗の山路を足探りに探って登ったことも下ったことも三人は未だ経験していなかった。",
              "citation": {
                "source": "奥秩父の山旅日記",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "河床は平だから深いこともあるまいと、足探りに徒渉して対岸に渡り、附近を物色すると踏み固められた道跡らしいものがある。",
              "citation": {
                "source": "初旅の大菩薩連嶺",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手探り足探りで歩く程に、やがて徐々にあたりがほの明るくなって来た。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたりまっ暗ではあれど、勝手知ってる家だから、足さぐりに行っても子細はない。",
              "citation": {
                "source": "隣の嫁",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊弉諾神はしまいには、もう待ちどおしくてたまらなくなって、とうとう、左のびんのくしをおぬきになり、その片はしの、大歯を一本｜欠き取って、それへ火をともして、わずかにやみの中をてらしながら、足さぐりに、御殿の中深くはいっておいでになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっ暗い峠を、足さぐりでこすのはあぶないので、茶店のばあさんに、ちょうちんをかりていこうと思いました。",
              "citation": {
                "source": "のら犬",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とんだ迷惑で」　庄吉は、こう南玉に云って、奥の方へ足さぐりに行った。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中を、不具にされた日本の文学とその不具な文学をさえなお愛する人間らしい精神の人々が手さぐり足さぐりで、去年の八月十五日までを辿ってきていたのであった。",
              "citation": {
                "source": "作家の経験",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学作品との直接のつながりから見ますと、今年の一月ころから三月ころまでの間最初の四半期は、さっきちょっと触れたように、民主主義が初々しく、ややまじめにあつかわれた時で、まだそこにどんなはみだしや歪みが出てくるのかわからないから用心ぶかくやってみるという足さぐりの時代だったわけです。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この足さぐりの時期には、戦争遂行に協力した作家たちは作品発表をせず、ジャーナリズム自身の存在安定のためにも、執筆依頼はひかえておくという工合でした。",
              "citation": {
                "source": "一九四六年の文壇",
                "author": "――新日本文学会における一般報告――",
                "note": "青空文庫"
              }
            },
            {
              "text": "三人はそろり、そろりと暗い洞窟の中を手さぐり、足さぐりですすんでいった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「では私がはいってみましょう、石棺の中へはいってみましょう」　民弥は手さぐり足さぐりで、石棺の中へ身を沈めた。",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "足さぐりに来て、ぶつかる体をそこに感じるようなそんな心持を思いおこさせます、静かな明暗のうちにある深い快い眠りを思いおこします。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前かいたときにはまだ足さぐりで、ゴタゴタなの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "電燈をひねるまで真直を見て足さぐりで進む。",
              "citation": {
                "source": "顔を語る",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "足さぐりで部屋の外へ出ようとして、ひろ子は思わずよろけた。",
              "citation": {
                "source": "乳房",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひろ子は、足さぐりで畳のしめっていない床の間よりの一隅を見つけた。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
