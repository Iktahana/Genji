  {
    "uuid": "ffc59318-d405-5f74-9964-c8d82fae9829",
    "entry": "アルイハ",
    "reading": {
      "primary": "あるいは",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソハヒマビマニトリテ来シ、　　木ノ芽ノ数ヲトリカハシ、アルイハ百合ノ五｜塊ヲ、　　　　ナガ大母ニ持テトイフ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハ一着３　　　　　　　３　　赤二郎　　マズ見込ナシ４　　　　　　　４　　黄三郎　　油断ナラヌ。",
              "citation": {
                "source": "安吾巷談",
                "author": "今日われ競輪す",
                "note": "青空文庫"
              }
            },
            {
              "text": "詩仏ノコノ作アルイハ南豊ノ詩ト駢伝スベキ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "答フル所アルイハソノ問フ所ニ異ル。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "辺疆ノ責ニ任ズル者能クコノ篇ヲ熟読シ以テ斟酌シテコレヲ用レバ則チソノ実用アルイハ孫呉ニ倍セン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "天使モシ別勅ヲ齎シコレヲ責メンカ、アルイハ奮起スル所アラン。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハコレニ基クカ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十七　安政五年戊午七月十一日（アルイハ十五日）、鷲津毅堂の妻佐藤氏みつが時疫の暴瀉に罹って没した。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "近世人心浮薄ニシテ、父祖ノ詩モアルイハコレヲ刻セズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハ恐ル、ソノ鼾雷ノ如ク城鼓正ニ五更ヲ報ズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ書生タルモノ平時互ニ相誇ルニアルイハ博覧考証ヲ以テシアルイハ詩若シクハ文章ヲ以テシ皆自ラ謂ラク天下｜己ニ若クモノハ莫シト。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルイハ主ノ蔵スル所、アルイハ客ノ携ル所、心ヲ潜メテ以テ品賞ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "倦メバ則アルイハ坐シ、アルイハ臥シ、劇談一｜餉、善ク戯謔シテシカモ虐ヲナサズ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ彼女ノ捜索癖ヲ満足サセルタメデアッタカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハアルイハ事実デハナク、僕ノ単ナル妄想デアルカモ知レナイガ、デモソノ妄想ヲ僕ハ無理ニモ信ジタカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ッテイルトスレバ、ソレハ以心伝心デアロウカ、アルイハ郁子カラ暗示サレタノデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデマタ、妻ガソノ写真ヲ見セラレタ場合ノヲ憤ル―――アルイハ憤ル真似ヲスル―――ヲ夫ニ許サレタモ同然デアルト考エルニ至ルカモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夕食後、二人ガ妻ヲ映画ニ誘ウト称シテ連レ出シニ来、十一時過ギテモ戻ラナイノデ、アルイハソンナデ掴マエテ来マシタ」彼女ハ独得ノ意地ノ悪イ眼デ僕ノ眼ヲ覗イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハドウイウ家ナノカ、普通ノ品ノヨイ旅館カ、アルイハ待合カ、モット柄ノ悪イ温泉マークノヨウナ家カ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカシナヲ自分ノ日記ニ書イテイルカドウカ知ラナイガ、書イテイタトシテモ僕ガソレヲ読マナイデ（アルイハ読マナイフリヲシテ）イルヲ認メサセルタメニ敏子ヲ使ッタ？",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
