        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一枚物の歌ではレーマン（ソプラノ）の「アガーテの詠唱」がある（コロムビアＪ八五八六）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウェーバーの『魔弾の射手』の「アガーテの詠唱」（Ｊ八五八六）に至っては、傑作以上だ。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気の初期に入った『魔弾の射手』の「アガーテの祈り」（六五八八）や『タンホイザー』の「歌の館よ」（一二七三）などの方が良かったと私は思っているが、これは絶盤になってしまった。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばエルザにしても、アガーテにしても彼女の独占的なものであったばかりでなく、恐らくその後に至っても、彼女ほどに歌える人は容易に出て来ないだろう。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
