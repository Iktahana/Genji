        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コオリン、アレキサンドロヰツチ。",
              "citation": {
                "source": "霧の夜に",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "安別薩哈嗹州ピレオ　北方二里アレキサンドロフスク　北方約三十里　海岸の白木の角標にはこう記してあった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アレキサンドロフスキー。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおかたアレキサンドロフスキーから持越しのものであろうか。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえばアレキサンドロウィチ、ミハイル、ゲオルグ、ウラジミルなぞいう名前はネ」　と云い云い相手の顔色を窺っておりましたが、リヤトニコフの表情には何等の変調もあらわれませんでした。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボオイが来て明日アレキサンドロ※ウでもう三円三十五銭払へと云つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうアレキサンドロ※ウに来て居るのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人で、クラースナヤ・プロスチャージ〔赤い広場〕、アレキサンドロフスキー・サードを散歩した。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロフスキーかと思ったら電車にのった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボオイが來て明日アレキサンドロ※ウでもう三圓三十五錢拂へと云つた。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうアレキサンドロ※ウに來て居るのである。",
              "citation": {
                "source": "巴里まで",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほどナポレオンやアレキサンドロスのは、雄であり、壮である。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、いつの世にでもナポレオンが出たり、アレキサンドロスの出ずることは出来ない。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "アアレキサンドロス（人）Alexandros. ギリシャの大王。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロスの時代には300から400の神殿が彼を祭っていたと推定された。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロスの父フィリッポス２世の医師でアスクレピアドのニコマコスの子供である偉大なスタゲイロス人（＊アリストテレスの俗称）が生まれたときに、惑星は稀な組み合わせであったに違いない。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の重要なビザンチンの著者はアエティウスおよびトラレス（＊現在のトルコのアイディン）のアレキサンドロスであった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は既にギリシア後期のアエティウスおよびトラレスのアレキサンドロスについて述べた。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アレキサンドロス大王のすぐ後には、アテーナイに国立浴場ができている。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロス大王がダリオス王の風呂場を見て驚いているのなども、この方面から考えるとおもしろい。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ギリシア劇はアレキサンドロスの東征のころから紀元後へかけて北インドや大夏やペルシアで盛んに行なわれた。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロス大王の時代に植えられたギリシアの芽はサンチ、バルハトに開いた。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ぬ10年前エジプトに侵入したときにアレキサンドロスは解放者として歓迎された。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "教師と生徒、すなわちアリストテレスとアレキサンドロスは最初の大きな自然史博物館を創設し、標本はその当時に知られていた世界の各地から送ってきた。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は比較解剖学研究において解剖のための材料を弟子のアレキサンドロスから供給されて非常に助けられた。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドリア学派はギリシャ文化の崩壊後に世界の学問の中心になり、アレキサンドロス帝国が分割されるとエジプトの分前はプトレマイオス１世（Ptolemy）の手に落ち、彼はアリストテレスの指導のもとにアレキサンドリア図書館を創設した。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロスの息子シリア王（紀元前150年）アンティオコス（Antiochus）の後見人ディオドトスの扇動により膀胱結石切除術師が膀胱結石と言って10才のアンティオコスを殺す忌まわしい殺人事件が起きた。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレキサンドロスのクレメンス（c.150-c.215）によると、モーセはエジプト医師のもとで医学および化学さえも学んだ、と。",
              "citation": {
                "source": "医学の歴史",
                "author": "History of Medicine",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
