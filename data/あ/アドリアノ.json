          "literary": [
            {
              "text": "その名は、彼の覚えている限りでは、何かアドリアノーポリといった風のものだった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "何カ月もペラのアドリアノープルにいたんだ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァレンチノ公はコルネットの枢機官アドリアノを毒殺しようと決心し、父である法王アレクサンドロス六世とともにヴァチカンにおける彼のもとで晩餐をすることとし、まず毒酒数本を送りとどけ、料理長にそれを大切に保管するよう命令した。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
