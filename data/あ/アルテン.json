        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "フォン・アルテンブルク若伯爵はそのためにすでに軍隊から呼びもどされ、現に男爵の城へ花嫁をむかえにゆく途上にあった。",
              "citation": {
                "source": "幽霊花婿",
                "author": "ある旅人の話",
                "note": "青空文庫"
              }
            },
            {
              "text": "フォン・アルテンブルク若伯爵は、落ちついたゆっくりした足どりで、のどかに結婚式への旅をつづけていた。",
              "citation": {
                "source": "幽霊花婿",
                "author": "ある旅人の話",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベーリングは撃退され、アルテンはなぎ払われていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちには、アルテン師団のものもあり、ドゥー・ポン家のある大侯がささげていたルネブールグ隊のもあった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラ・エー・サントにおいて既に痛手を被ってるアルテンの師団は、ほとんど全滅していた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
