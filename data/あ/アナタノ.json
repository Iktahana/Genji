        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヨク来タト申シタイアナタノ可愛イ手紙、今朝参リマシタ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔ヲ見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "今アナタノ顔見ナイノハ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラ　ドウ　シタノデシヨ、アナタノ　オベベハ　マツシロヨ」ト　オドロイタ　花ノ　ヒトツガ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『記者様――私ハ、アナタノ新聞ノ記事ヲ読ンデカラ眼ガ醒メマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウゾコノ大馬鹿者ノ最期ヲ、アナタノ筆デ、デキルダケ大キク世間ニ発表シテ下サイ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタ、ホントニアタシガカワイイナラ、コノテガミツキシダイ、ヨルノ七時マデニ、イツモノトコロヘキテチョウダイ、キット、キットヨ、デワ　サヨナラ　　　　コイシキコイシキペテロフサマ　シブヤにてアナタノトヨ子※」　それは、いかにも滅多に手紙など書く必要のない女の字であった。",
              "citation": {
                "source": "街",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホントニ、コノ前アナタノ十家ヘアガッタ時ハ、ヒドイ御病気デ、トウ／＼アナタニアフコトガ出来ナクテ、ザンネンデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "デハ、ワタシ、アナタノタメニ唄ヲウタッテ上ゲル、コノ手風琴デ、世界ノ国々ノ、港々ノ唄ヲウタッテアナタヲ慰メテ上ゲルデス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ嬢サン、提灯ヘローソク入レマス、オ待チナサイ、ソウシテ、今夜ワタシ、アナタノ淋シイノヲ慰メルタメニ、一晩中、器量一パイウタイマス、ワタシ、知ッテル世界ノ国々ノ唄トイウ唄、ミンナ歌イマス、イチバンシマイニ日本ノ、歌イマス……夜ガ明ケテモカマイマセン」　マドロスは、すっかり興奮しきっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヒルサン、アナタノ洋服ハ一度アラツタラドウデスカ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタノ洋服、青ニデモオソメニナツテハイカガデセウ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オイシヤサマハヨクヨク、シンサツシテ、ソレカラ、「ボンコチヤン、アナタノ病気ハモンコチヤンノ所ヘカヘレバスグナホリマス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シアナタノ作ヲ読ムノハヒマガ入ラナカッタ。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノカホイロモスヅメノアシノヨホデス。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラ今度ノアナタノオ手紙デハ驚キマセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ケレドアナタノ決心ガ真ニ最後ノモノデアルナラ、一日モ早イ方ガヨクハナイデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕コウ見エテモ必ズシモ木石漢ニ非ズ、芳子ノコトナド思イ出シテ感慨無量ナルモノアリ、唯何処マデモソウ云ウ感情ヲ後ニ残シテ斯波ノ家ヲ去ラナケレバナラナクナッタアナタノ不仕合ワセヲ歎クノミデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アナタノ今ノ良人ノコト、及ビ弘君ノコトハ、御依頼ガナクトモ親戚ノ一人トシテ、親子ノ性質ヲ最モ良ク理解シテイル友人トシテ、及バズナガラ出来ルダケノ事ハスル積リデスカラ、決シテ心配シナイデ下サイ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　金五郎サント、オ京サントヲ切リハナスニハ、モウ、アナタノ力ヲ借ル外、ナイノデス。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノイウ事ナラ、金五郎サンモ、キット、聞クデシヨウ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハアナタカラ記憶ヲ消シ、アナタノ意識ニ架空ノ現象ヲ投影シタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当ハアナタシカ存在シナイノニ、アナタノ五感ニ訴エル擬似現象ハ、アナタ以外ノ存在ヲアナタニ納得サセタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "歴史ハイワバアナタノ誕生ト共ニ始マリ、アナタノ死ト共ニ終ワル運命ニアッタノダ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテアナタガ“存在者”トシテ目覚メタ今、コレマデアナタノ意識ニ投影シタ架空ノ世界ハ幕ヲ閉ジタノダ」　あなたは何かしら名状し難い虚無感に苛まれる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
