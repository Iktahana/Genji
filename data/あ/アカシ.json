        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "理論的な検証が実施されている。",
              "source": "幻辞"
            },
            {
              "text": "教会の集会で、彼女は神に出会った体験を涙ながらに証した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "私は法廷に立ち、あの夜に見た出来事を証するつもりです。",
              "citation": {
