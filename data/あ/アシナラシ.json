        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しい登山靴は足慣らしをしてから本格的な登山に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "マラソン練習の基本として毎日足慣らしをしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "手術後のリハビリとして毎日足慣らしを続けている患者がいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "隼太郎は、近く南アルプスに登る計画があるので、足慣らしに連れたのであった。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しは調べたいもの、見たい所もあって、五六日は随分歩くつもりで、足慣らしもして来たのであるが、これでは愛宕、乙訓、久世、綴喜と遠っ走りは出来そうにない。",
              "citation": {
                "source": "雨の宿",
                "author": "岩本素白",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ってますよ、その旅先はちゃあんと呑込んでいますからね」「ナニ、少しばかり足慣らしをやってみるんだ」「出かけるなら出かけてごらんなさい、わたしという者をさしおいて行けるものだか行けないものだか、さあ、出るなら出てごらんなさい」　お角はそこにあった荷物と、がんりきが結びかけた脚絆を取って抛ります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "市中騒動の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説においては、済勝の足ならしに短篇数十を作り試みたが、長篇の山口にたどりついて挫折した。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "戯曲においては、同じ足ならしの一幕物若干が成ったのみで、三幕以上の作はいたずらに見放くる山たるにとどまった。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、その浪々の道すぢを自分に言訳するために、後日の零落に備へての足ならし、身鍛へだなぞと、感傷的に思ひ込んでゐることに於てをや、と云ふべきであらう。",
              "citation": {
                "source": "大凶の籤",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遠いぞオ――」と、彼は足ならしをするように交互に土間をふみしめた、「家中の男という男は、一人残らずトウベツに行っておる、間に合せの小屋がけをして、伐木に従事しておる、相田どのはそれを指図なされておる、――蹤いてまいるか？",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんは不思議と早く癒つて、もう足ならしの散歩を始めたと報告してきた。",
              "citation": {
                "source": "おばあさん",
                "author": "ささきふさ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、ついこなひだまで足ならしのよちよち歩きをしてゐた筈の道平が、本家の孫息子につき添はれてではあつたが、ちやんと一人立ちになつて、ゆつくりゆつくり足を踏み出してゐた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "聖衆は雲に乗っておいでになりまする、信心のともがらは遠きと、高きを厭わぬものでございます、ゆさんの人たちは足ならしのために恰好と申すことでございます……ところの幽閑、これ大いなる師なりと古人も仰せになりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと、思いあたった……「叔母が言っていた、あのひとなんだわ」　近くの結核療養所にいるすごい美青年が、療後の足ならしに、ときどき遊びにくると、自慢らしく言っていた。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫は冬の中に足ならしをしておくやう明日から山に猟に連れてゆくと申してをります。",
              "citation": {
                "source": "早春箋",
                "author": "辻村もと子",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は足ならしに、重い靴をはいて四里の路を歩いた。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっと足ならしに散歩するつもりのが、つい遠くまで行ってしまった。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず足馴らしに校庭を一周して、弥生町から池の端へ出た。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一同も軍議をやめ、兵糧なとつかえ」　元康は、本堂を出て、廻廊を行きつ戻りつ、足馴らししているように、巡っていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は、足馴らしに、そこらを少し歩いてみた。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋口から、風邪をこじらせて、二月ほど病床に、仆れていた』『もう快いのか』『やっと起きて、足馴らしに出て来たのだ』　そのせいか、丈八の頬には、すこし痩せが見える。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして足馴らしのために、私たち村の子供を案内人にして散歩をはじめました。",
              "citation": {
                "source": "亜剌比亜人エルアフイ",
                "author": "犬養健",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでもなかなか見えないので、土俵の砂をふむように足馴らしをしはじめた。",
              "citation": {
                "source": "銀河まつり",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
