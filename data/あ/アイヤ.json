        "examples": {
          "standard": [
            {
              "text": "彼は江戸時代から続く藍屋の十代目として、伝統の技術を守り続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "徳島の古い町並みには、今でも藍屋を営む店が軒を連ねている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "藍屋の職人は、藍甕の色や匂いで染料の状態を判断するという。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "「雍州府志」に、凡所在洛内外之紺屋、以藍汁染衣服者、号青屋、又称藍屋。",
              "citation": {
                "source": "エタ源流考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯を呼ぶ呼子笛　その時刻と前後して、城下のちまたから荒川へ流れ出る藍屋川の土橋の上に、ひとりの女性が立ちました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "川には、藍屋町の藍滓が油のように浮いて、深淵のごとき深い色をドンヨリと流しています。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "藍屋川の川べりに添って、やや暫く西へくだると、また一つの橋がある。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "やあいやあい」　といって出て行った。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
