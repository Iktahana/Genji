    "definitions": [
      {
        "index": 1,
        "gloss": "paper screen door for admitting light",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い旅館の客室では、明かり障子を通した柔らかな光が部屋を包んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母は毎年暮れになると、破れた明かり障子の紙を器用に張り替える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "明かり障子に映る庭の木の影が、風に吹かれてゆらゆらと揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "縁をたどって来る足音が軽くきこえて、明かり障子の前にとまると、女は読みさしの歌集をかいやって、表の方に眼をくばった。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "パンの屑を屋根へ蒔いといたんですの」　その音がし始めると、信子は仕事の手を止めて二階へ上り、抜き足差し足で明り障子へ嵌めた硝子に近づいて行った。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虻という虫が部屋に入って、出ようとして明り障子のところで羽搏いて、頭を打付けてブンブンと努力しているが、結局何の役にも立たないで終る。",
              "citation": {
                "source": "一貫章義（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンニ、ホンニ、…………　沈丁花からりはたはた織る機は佛蘭西機か、高機か、ふつととだえたその窓に守宮吸ひつき、日は赤し、明り障子の沈丁花。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホンニ、ホンニ、…………沈丁花からりはたはた織る機は佛蘭西機か、高機か、ふつととだえたその窓に守宮吸ひつき、日は赤し、明り障子の沈丁花。",
              "citation": {
                "source": "思ひ出",
                "author": "抒情小曲集",
                "note": "青空文庫"
              }
            },
            {
              "text": "画室は、母屋とは廊下続きの離れの形式になっており、南向きの二階建てで、東、西、南の三方は明り障子とガラス障子の二枚が嵌まっていて、北面だけが壁で仕切られています。",
              "citation": {
                "source": "画室談義",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "明り障子とガラス障子の二枚戸にしたのは陽光の明暗強弱を適度に調節するためで、それらの三方の外には一尺幅ほどの小さい外廊が廻らしてあり、それにかたちばかりの欄干も取りつけられてあります。",
              "citation": {
                "source": "画室談義",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "日のあたる明り障子たゞ白じろと　ひろがり見し夢の　かそかなる思ひに　つゞく　　　　　堀君　三みつまたの花咲く日山原を　行きしかな。",
              "citation": {
                "source": "『かげろふの日記』解説",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "清涼寺の七日の参籠を済せて、それから南都へ下り、法相宗の碩学蔵俊僧都の処に至って普通の修業者の通りに御対面を申出で、大床にいた処を蔵俊僧都が何と思ったか明り障子をあけて内へ招き入れて対面し、法談に時を移した。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを居合せた法蓮房信空に向って、「この蛇を取ってお捨てなさい」と法然が云えば法蓮房は生来非常の蛇嫌いの人であったけれども師命｜背き難く、こわごわその蛇を捕え、明り障子を開き塵取りに入れて投げ捨て障子をたててさて帰って見ると蛇が尚元の処にいた。",
              "citation": {
                "source": "法然行伝",
                "author": "中里介山",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手は上り口で、右手には勝手の明り障子が嵌めてあって、それに油で二重の波形の模様が描いてある。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そうしてやがて、彼の手で抱き起こされ顔をそむけて涙を拭いたとき窓の明り障子にほのかな晩春の曙の光りがさしていた。",
              "citation": {
                "source": "菊千代抄",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "供の弥九郎はそれまでものも云えず、足も地に着かぬようすだった、然し明り障子に灯影のさしている家などがみえはじめると、ようやく生気をとり戻したとみえ、急にわっはっはと笑いだした。",
              "citation": {
                "source": "山だち問答",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下に面したほうは明り障子であるが、他の三方は壁と襖なので、うす暗いうえに、いつも湿気が絶えなかった。",
              "citation": {
                "source": "山彦乙女",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "机にむかって筆を持ったまま、もの思いにふけっていた平三郎は、明り障子の蒼茫と暗くなっていくのに気づいて、筆をおきながら、しずかに立って窓を明けた。",
              "citation": {
                "source": "蘭",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏庭に面した腰高窓の、明り障子の左右があけてあり、庇に吊った風鈴が、ときおり、もの憂そうにリリと鳴っていた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　昏れかかる日の残照が、明り障子にものかなしげな光を投げている。",
              "citation": {
                "source": "日本婦道記",
                "author": "墨丸",
                "note": "青空文庫"
              }
            },
            {
              "text": "爽やかな朝の日光が、明り障子いっぱいにさしつけている、いかにも春らしく、心を温められるような明るさだ。",
              "citation": {
                "source": "日本婦道記",
                "author": "糸車",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから紙の利用が自由になって、明り障子や唐紙の間仕切ができ、家の中の区画が立って食物はようやく統一を失った。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "わずか三間しかない禅室も、明り障子をとり払って、縁や、土間の隅にまで、坐れるだけの人間が坐っていた。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "熊野路や小春の海を見ぬ日なく海明り障子のうちの水仙花世にすまぬ心地師走の旅うらゝ　など。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎が坐った左側、つまり海と反対側に、明り障子が立ててある。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏｜立や明り障子の朝みどり　　　　左次「明り障子」というのは、或特別な障子を指す場合もあるらしいが、普通は今いう障子のことである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラス障子というような、更に明るいものの出現した今日から見れば、紙障子を「明り障子」と号するのは、いささか僣越の沙汰であろう。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれが明り障子として通用するためには、一方に明るくない障子のあった時代を顧みなければならぬ。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
