          "literary": [
            {
              "text": "……姉さんは科よく消えたが、こっちは自雷也の妖術にアリャアリャだね。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリャアリャアリャアリャ大鳥大鳥！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早え野郎だ」「いま時分また、なんの粗相で……」「ワッショイワッショイ、火事と喧嘩ア江戸の花でえ」「アリャアリャアリャ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "役目の人は知らず、こうして非人がアリャアリャと都合三十槍突いたのを矢来の側の特別席とでもいったところに立っていて、最後まで眼をはなさずに見届けていた者に、お銀様がありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "後棒へまた二人取りついて、「アリャアリャ」　一団の黒雲になって飛ばして行く。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "捨公方",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アリャアリャ、アリャアリャ」　テッパイに叫びながら、昼なかのお茶の水わきをむさんに飛んで行く。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "三人目",
                "note": "青空文庫"
              }
            }
          ]
        }
