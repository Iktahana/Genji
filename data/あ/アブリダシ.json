  {
    "uuid": "7d6f7611-76bb-5023-93a8-6fa57d16c2fc",
    "entry": "アブリダシ",
    "reading": {
      "primary": "あぶりだし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "生前、歯に彫りつけたというわけではなく、書いたものがアブリダシで現れたようなアンバイである。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は死人の歯を治療したことがありませんから、なんとも云えませんが、これはたゞの偶然で、なんでもないことじゃありますまいか」「このホトケはクビをくゝって自殺したのですが、死ぬ前に、歯にアブリダシで字を書いておいたら、骨になってから、こうなるのと違いますか」「さア、どうでしょう。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯にアブリダシを書いた話はきいたことがありませんが、口の中は濡れているのが普通ですから、アブリダシを書いても流れて消えて失くなりはしませんか。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は骨になった歯など見たことがないのですが、シサイに見たら、こんなのは例が多いのかも知れませんな」「しかし、アブリダシということも考えられるでしょうな」「和尚さん。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供じゃアあるまいし、頭をまるめたいい年寄が、アブリダシ、アブリダシって、ナニ云ってやがんだい。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙僧は、奴め、口惜しまぎれにクビククリの寸前にアブリダシを前歯に仕掛けやがったなと睨んだが、漬物屋のオカミサンは、亡魂がこの地にとどまって、歯に文字を書いたというのだよ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
