          "literary": [
            {
              "text": "揮発油でもないアルコウルである。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコウル漬けになっているから、余り崩れないで、顔などもはっきり鑑別出来た。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコウル漬けにして置いたのは、いずれも機を見て他へ埋めるつもりだったに相違ない。",
              "citation": {
                "source": "生きている戦死者",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにはアルコウルの疑いがあった。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
