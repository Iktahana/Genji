          "literary": [
            {
              "text": "どこよりも早く夕ぐれの訪れて来るらしいそこの廊下や階段をいくまがりして、建物の外に出ると澄みわたつた空に茜雲が明るい。",
              "citation": {
                "source": "小さな庭",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供のころ見なれた山の端の茜雲や、青空にふんわりとかかった白い薄雲や、いつかの明方見たことのある遠い空の燃えるようなだんだら雲を次ぎつぎと織っていった。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            }
          ]
