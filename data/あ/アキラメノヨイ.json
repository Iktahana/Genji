    "definitions": [
      {
        "index": 1,
        "gloss": "knowing when to give up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "五平　諦めのいい事もあるまいが、まあ、まあ、そう思って無理に諦めるより外はあるまいよ。",
              "citation": {
                "source": "人狼",
                "author": "――Were-Wolf――",
                "note": "青空文庫"
              }
            },
            {
              "text": "諦めのいい幽霊と言わなければならない。",
              "citation": {
                "source": "妖異むだ言",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸太郎　どうもお前の諦めのいいのには驚かされる。",
              "citation": {
                "source": "女の一生",
                "author": "五幕七場",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り諦めのいいことはまず誰にも負けないし――といってこれは余り自慢になる性格じゃないが――しょっちゅう早合点をして頭を掻いてばかりいるのだ。",
              "citation": {
                "source": "宇宙尖兵",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私は当然拒絶を承知した諦めのいい集金人のように、その頃私は仏教を勉強する堕落生であったが、さながら魚のように機嫌よく街を泳いで埃を浴びていた。",
              "citation": {
                "source": "母",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "諦めのいい家庭の二三は既にそれぞれ他へ住居を契約して、長屋からして泣く泣く移転したくらいである。",
              "citation": {
                "source": "長屋天一坊",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "細君は気軽な人物で何事もあきらめのよいたちだから文句はない。",
              "citation": {
                "source": "二老人",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "清三の心持ちでは、荻生さんのようなあきらめのよい運命に従順な人は及びがたいとは思うが、しかしなんとなくあきたらないような気がする。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきらめのよい彼は、唯一人広い歌舞伎座の舞台に、輝く金屏風を後にして、改名披露の口上を、自分自ら述べたのである。",
              "citation": {
                "source": "市村羽左衛門論",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
