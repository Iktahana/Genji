          "literary": [
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "云ウマデモナク最近ノ不況ハドシ／＼失業者ヲ街頭ニ投ゲ出シテ居リ、ソレハ全く見ルニ忍ビナイモノサエアルノデス。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オマツリガ　アルノデス。",
              "citation": {
                "source": "オマツリ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サウダント　イフノハ　ホカデモアリマセン、モウ一シユウカンスルト　オイケデ　オマツリガ　アルノデス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
