[
  {
    "uuid": "d648b777-84a9-5e20-8041-bf4f0ec092d7",
    "entry": "洗い張り",
    "reading": {
      "primary": "あらいはり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "stretching pieces of a kimono on boards to dry after they have been washed and starched",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "洗い張りを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは洗い張りについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "洗い張りの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は洗い張りの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では洗い張りが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "洗い張りという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に洗い張りという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では洗い張りについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "洗い張りを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると洗い張りは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "洗い張りについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では洗い張りが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に洗い張りは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により洗い張りの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "洗い張りは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に洗い張りは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "「こんなに汚れたから、新しいの買って下さい」　父は本と私の顔を等分に見くらべていたが、「そんなら私が洗い張りしてあげる」　と言った。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんは近所の洗い張りでもしようかと云うし、私は女給と芸者の広告がこのごろめについて仕方がない。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お母さんは近所の洗い張りでもしようかと云うし、私は女給と芸者の広告がめにつく。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "明るい庭さきでは、洗い張り作業をしているひとたちもいました。",
              "citation": {
                "source": "新生の門",
                "author": "――栃木の女囚刑務所を訪ねて",
                "note": "青空文庫"
              }
            },
            {
              "text": "おはるは縫物をとてもよくし、私など洗い張りした着物はいちいち軽井沢へ送っておはるに縫ってもらっていた。",
              "citation": {
                "source": "入梅",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は先生の宅へ出はいりをするついでに、衣服の洗い張りや仕立て方などを奥さんに頼んだ。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮を脱いで、肉を脱いで骨だけで涼みたいものだと英吉利のシドニー・スミスとか云う人が苦しがったと云う話があるが、たとい骨だけにならなくとも好いから、せめてこの淡灰色の斑入の毛衣だけはちょっと洗い張りでもするか、もしくは当分の中質にでも入れたいような気がする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、これで家じゅうさっぱりして、お恭ちゃんが使っていた布団類の洗い張りも出来ていいわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこの家でも、女は夜なべに、子供の足袋の穴や洗い張り物を、眼をいたくして針の先でかがっていた。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん誰にも相談せんと、自分ひとりであんだけの段取り工夫しなさって、ただ電話かけるのんに女の声やったらいかん思て、お梅どんに訳話して出入りの洗い張り屋の男頼んだ。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よごれたまま押込んで置いた彼の衣類を出して、次つぎに解いて洗い張りをし、巧みに仕立て直した。",
              "citation": {
                "source": "あだこ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいえ、すこし洗い張りをせんならんので、糊を炊いておこうと思うて……」「ふウン」　夫から、喧嘩に手を出すな、といわれたマンは、暴漢どもが飛びこんで来たら、たぎり立った糊を、頭から打っかけてやろうと考えているのだった。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗い張りをした袷のようにさばさばとした顔つきだった。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "張板を立てて、襤褸を洗い張りしていたお次は、気の毒そうに、そっと寄って。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも、自分の帯とか春着の小袖とかならばとにかく、洗い張りをした二官の袷を仕立て直しているのですから、お蝶としてはしおらしい。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "洗い張り屋さんのように、本式にハリシンが張ってあった。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "百草の花のとじめと律義にも衆芳に後れて折角咲いた黄菊白菊を、何でも御座れに寄集めて小児騙欺の木偶の衣裳、洗張りに糊が過ぎてか何処へ触ッてもゴソゴソとしてギゴチ無さそうな風姿も、小言いッて観る者は千人に一人か二人、十人が十人まず花より団子と思詰めた顔色、去りとはまた苦々しい。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「え、それも釈いて洗張りしたまゝ仕舞つてありますの。",
              "citation": {
                "source": "青い風",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "裏通の或一部を覗くと洗張屋が一軒庭へ布を張つてあつて其庭先からは青菜の畑があるといふので、そこらをうろつくを追ふ百姓の叱り聲が聞かれる。",
              "citation": {
                "source": "開業醫",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "春になると其の畑からさうしてそこらあたりに隱れて居た青菜が一時に黄色な頭を擡げてすつと爪立てをしてそれから白桃の花が垣根に咲いて、洗張屋は庭の短い青草に水を滾しながら引つ張つた布を刷毛でこすつて居る、とかういふ町の或横町である。",
              "citation": {
                "source": "開業醫",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の板塀を前にした一構、それはさつきの洗張屋の庭先の青菜の畑から※を追ふ叱り聲も時々は微かに聞かれるあたりであるが、そこに近頃開業した醫者がある。",
              "citation": {
                "source": "開業醫",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "この冬着ようと思って、洗張をしたまま仕立てずにしまっといたの」　なるほど若い女の着る柄だけに、縞がただ荒いばかりでなく、色合もどっちかというとむしろ派出過ぎた。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただどんなに時代を食っても、綺麗に洗張が出来ている所に彼女の気性が見えるだけであった。",
              "citation": {
                "source": "道草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫とも、一度洗張りをしなければいけないでしょうか。",
              "citation": {
                "source": "大島が出来る話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "私こと、毎日々々そこここと手伝見舞にまいり、いそがしく、それに仕事の方も間に合せたくと存じ、それ着物の浸抜、それ洗張と、騒ぎにばかり日を暮し、未だ父上の道中着物ほどきもせずに居るような仕末に御座候。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜそんなことをよく覚えていたかと云うと、それはその白い車を曳いた被告人を見たお蔭で、その時まで忘れていた大事な着物の洗張りを思いついたからだというんです。",
              "citation": {
                "source": "あやつり裁判",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰山御酒が浸みたるさかい、洗張にやつて、縫直して貰ふたらどうでつしやろ。",
              "citation": {
                "source": "大阪の宿",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは古ぎれ屋か洗張屋の店の引越騒ぎとでも言はゞ言はれべき、何とも彼とも譬へやうのない混雑である。",
              "citation": {
                "source": "勲章",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "小学校しか出ないでしょうに、利口な女で、裁縫もしますし、洗濯洗張物などについては、商売がら私の方で教えられることが多いのです。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「洗張でもするの」と聞きましたら、「これは主人のために探して来ました」といいます。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
