    "definitions": [
      {
        "index": 1,
        "gloss": "person entrusted with someone's money, belongings, land, etc.",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "不在がちな家主に代わって、彼がアパートの家賃の預かり人になっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "村で一番信頼されている村長が、共有財産の預かり人を務めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "遺産相続の手続きが終わるまで、弁護士が貴重品の預かり人として指定された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ここに近い領地の預かり人などを呼び出して、いろいろな仕事を命じたり、良清朝臣などが家職の下役しかせぬことにも奔走するのも哀れであった。",
              "citation": {
                "source": "源氏物語",
                "author": "須磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "入道夫人の祖父の中務卿親王が昔持っておいでになった別荘が嵯峨の大井川のそばにあって、宮家の相続者にしかとした人がないままに別荘などもそのままに荒廃させてあるのを思い出して、親王の時からずっと預かり人のようになっている男を明石へ呼んで相談をした。",
              "citation": {
                "source": "源氏物語",
                "author": "松風",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお修繕を加える必要のある所を、源氏はもとの預かり人や新たに任命した家職の者に命じていた。",
              "citation": {
                "source": "源氏物語",
                "author": "松風",
                "note": "青空文庫"
              }
            },
            {
              "text": "いろいろときめることをきめ、領地の預かり人たちを呼んで、御堂の建築の件について、すべて阿闍梨の命令どおりにするようにと薫は言いつけたりしているうちに短い秋の日は暮れてしまったので、山荘で一泊していくことに薫はした。",
              "citation": {
                "source": "源氏物語",
                "author": "宿り木",
                "note": "青空文庫"
              }
            },
            {
              "text": "久しい以前からわたしの家は、その同胞の財布の総預かり人であったというアテナイ人リュクルゴスの受けた賞賛のおすそわけに預っているのだ。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、自分の姿が見えねば、六波羅の預かり人が、山落ちして行方を晦ましたるぞとばかり、一山の騒ぎとなり、ひいては谷間に集まる日頃の味方にまで、詮議が及ぼうも計りしれぬ。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れた高氏は、やがて滑川のほとりで待っていた郎党をつれ、大蔵ノ邸へ入って、その夜もまた幕府の“預かり人”である忠円僧正とおそくまで話しこんでいた。",
              "citation": {
                "source": "私本太平記",
                "author": "みなかみ帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さまは大岡様からの大事な預り人で、困って芸者に出る人じゃないから、嫌になったらいつでも廃業すこった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "此れ我家の不注意と、預り人の怠りとに由るなり。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "生不動の身内では、利助が金井一角に斬り斃された他は、百介も駒吉も薄傷を負っただけだったが、大切な預り人春日新九郎一名が、その夜以来、まったく消息が知れなかった。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見馴れぬ男だが」「十兵衛様からのお預り人だそうでございます。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "主税の名は、松平家のお預人の中に記されてあった。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御預人の十七名の駕と人数は、目黒門と呼ぶ口から邸内へ入った。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "person in charge of someone taken into custody",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "少年院を出た後、叔父が彼の預かり人として生活を支援することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "保護観察中の彼女には、保護司が預かり人として定期的に面接を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "身元引受人兼預かり人として、警察署まで彼を迎えに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
