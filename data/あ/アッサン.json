        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私がフムボルトを読めば彼はローレンツとモアッサンを読んでいる。",
              "citation": {
                "source": "鳥",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が漸くモアッサンにかかるともう彼はウォルフとハッスリンガーにかかっているという状態で、夜の目も寝ずに私が勉強したとてとても彼には及ぶことが出来ないのだ。",
              "citation": {
                "source": "鳥",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "例を申しますなれば、エドワアド・ウイムバアは最初の英吉利人、ハンス・ジムメルマンは最初の墺太利人、アブ・アッサンは最初の土耳古人でございました。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「男のように強いあのアッサンシオン長老がお前に手伝って下さるでしょう」「女の方と男とは別でございます。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "礼拝堂の中には四人の歌唱の長老とアッサンシオン長老とお前とのほかはだれもいませんでしょう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "砂糖を焼いて純粋な炭素の粉を作り、それを高温高圧にするとダイヤモンドに変るというのが、有名なモアッサンの実験である。",
              "citation": {
                "source": "硯と墨",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "召使いなしでは出かけないでしょ」「忠実なアッサンが下の玄関に控えております」「すぐ呼んできて。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくして戻り、召使いのアッサンを連れてきた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "召使いのアッサンがきらめく仮装舞踏会の中を縫って進むのが見えたからだ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ来たわ」　アッサンが進み出て、汚い平箱を差し出した。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
