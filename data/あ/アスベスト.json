        "examples": {
          "standard": [
            {
              "text": "古い校舎を解体したところ壁材にアスベストが含まれていることが判明し、専門業者による除去工事が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "アスベストを長年吸い込んだ建設作業員が中皮腫を発症し、国に損害賠償を求めて提訴した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "自治体は住民向けの説明会を開き、アスベスト含有建材の点検と安全な処理方法を案内した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "手製のアスベストスの棒に針金を捲きつけて、それを不細工な歯車か何かにとりつけた妙な装置が出来上がった。",
              "citation": {
                "source": "実験室の思い出",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "室井君の「地球磁気の根源に関する」大研究も、検流計が一つとあとはアスベストスの棒と手細工のがらがら廻る歯車とが出来上がれば、とにかく実験が始められた。",
              "citation": {
                "source": "実験室の思い出",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "手製のアスベストスの棒に針金を捲きつけて、それを不細工な歯車か何かにとりつけた妙な装置が出来上った。",
              "citation": {
                "source": "寺田先生の追憶",
                "author": "――大学卒業前後の思い出――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＨＭ君の「地球磁気の根源に関する」大研究も、検流計が一つとあとはアスベストスの棒と、手細工のがらがら廻る歯車とが出来上れば、とにかく実験が始められた。",
              "citation": {
                "source": "寺田先生の追憶",
                "author": "――大学卒業前後の思い出――",
                "note": "青空文庫"
