        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これはギリシア神話の中のアナキネという話の物語にでも推察される。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナキネは大変美しく可愛い娘で、織物を織ることが上手であった。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュピターの妻ジュノーの嫉妬がつのって、到頭哀れなアナキネはジュノーのために蜘蛛にさせられてしまった。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナキネの物語は、ギリシアの社会に、婦人の本当の自由がなかったこととともに、女に課せられている紡織仕事に対し疑いをもっていたことがうかがわれる。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジュノーとアナキネの関係が織り紡ぐ仕事における奴隷と主人との関係、義務を与えるものと、義務づけられたものとの関係を語っている。",
              "citation": {
                "source": "衣服と婦人の生活",
                "author": "――誰がために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜘蛛は、アナキネという乙女の化身ですって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナキネは大変織物が上手で、その美しい織物の技術に、或るギリシャの神が魅せられたのを、その男神の恋人が嫉妬して呪詛で蜘蛛にしてしまったのですって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
