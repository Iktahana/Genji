          "standard": [
            {
              "text": "セルフでアイラッシュを付けるのは、意外とコツがいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "目尻にポイントでアイラッシュを足して、華やかな印象にする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は自まつ毛が長いので、アイラッシュを使わなくても目元がはっきりしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "髪ヲパーマネントニシ、耳ニイヤリングヲ下ゲ、唇ヲコーラル・ピンクダノパール・ピンクダノコーヒー・ブラウンダノニ塗リ、眉ニ黛、瞼ニアイ・シャドウヲ着ケ、フォールス・アイラッシュデ附ケ睫ヲ着ケ、ソレデモ足リナイデマスカラーデ睫ヲ長ク見セヨウトスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
