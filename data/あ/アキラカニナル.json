        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "内部告発によって、長年隠蔽されてきた企業の不正会計が世間に明らかになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "週刊誌の報道で、人気俳優の極秘結婚が突然明らかになり、ファンに衝撃を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "政府の機密文書が機密解除され、当時の外交交渉の裏側がようやく国民の前に明らかになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
