        "examples": {
          "standard": [
            {
              "text": "彼が会社の経費で個人的な買い物をしていたことが発覚し、社員一同呆れ果てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "徹夜で仕上げた資料を「やっぱり使わない」と一言で片付けられ、すっかり呆れ果ててしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "こんな常識外れの要求をしてくるクレーマーには、店長もただ呆れ果てるばかりだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、それを自身が殉教者みたいに、いやに気取って書いていて、その苦しさに襟を正す読者もあるとか聞いて、その馬鹿らしさには、あきれはてるばかりである。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
