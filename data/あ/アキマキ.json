        "examples": {
          "standard": [
            {
              "text": "この花の種は秋まきなので、9月下旬から10月にかけてプランターに植えるのが最適です。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "秋まきのホウレンソウは寒さに当たって甘みが増すため、春に収穫するのが楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "園芸店で秋まき用のハーブの種を買ってきて、さっそく庭の花壇にまいてみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "秋まきのえんどうが冬をしのいできた姿をそのまま、ちぢこまって、みどりの色もまだ沈んでいるその姿だった。",
              "citation": {
                "source": "妻の座",
                "author": "壺井榮",
