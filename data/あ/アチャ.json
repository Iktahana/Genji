    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "妻は上げた時すぐに奈あちゃんやって呼んだら、どうも返事をしたようであったがねい。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は二十九のばあちゃんだから、十年前のお父上の御逝去の時は、もう十九にもなっていたのだ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやにおばあちゃんになついてしまって、いい気になってへばりついてる。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあちゃんの財布を持ってくれて落さなかったんだものねえ。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあちゃんに買っていただいたの？",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "睦子にそこんところを何と説明してやったらいいか、おばあちゃんも困ってしまった。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあちゃんが御病気になったら、もうちっともおばあちゃんの傍には寄りつかず、こんどはやたらにおじいちゃんにばかり甘えて、へばりついているのだもの。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたから見ると、私は、きっとキザに気取って、おろかしい瞑想にふけっているばあちゃん女史に見えるでしょうが、でも、私、こうしているのが一ばん、らくなんですもの。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "むかしから、ちゃんと泥沼が、明確にえぐられて在るのだと、そう思ったら、かえって心が少しすがすがしく、爽やかに安心して、こんな醜い吹出物だらけのからだになっても、やっぱり何かと色気の多いおばあちゃん、と余裕を持って自身を憫笑したい気持も起り、再び本を読みつつけました。",
              "citation": {
                "source": "皮膚と心",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、せめて、此のおばあちゃんひとりを、花火のように、はかなく華麗に育ててゆきます。",
              "citation": {
                "source": "古典風",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎は、すゞを、親のように、「かあちゃん、かあちゃん。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのね、天の川の岸にね、おっかさんお話しなすったわ、……」「それから彗星がギーギーフーギーギーフーて言って来たねえ」「いやだわ、たあちゃん、そうじゃないわよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いやだわたあちゃんそうじゃないわよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わあい、けんかするなったら、先生あちゃんと職員室に来てらぞ。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いやだわたあちゃんさうじゃないわよ。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「姉さんが今、番屋に止められたと云って、なあちゃんが泣き込んで来たんです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうか、おじいちゃんやおばあちゃんには食べられたくない。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大な声で、かあちゃん、と呼ぶものだから、二階の障子が開く。",
              "citation": {
                "source": "菊あわせ",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "越えて三歳になる時、母親は蠣殻町の贔屓客に、連児は承知の上｜落籍されて、浜町に妾宅を構えると、二年が間、蝶吉は、乳母日傘で、かあちゃん、かあちゃんと言えるようになった。",
              "citation": {
                "source": "湯島詣",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎々のことでしょう、気をつけると毎月さ、はて変だわえ、とそれからいつでも寝際にゃあちゃんと、ちゅう、ちゅう、たこ、かいなのちゅ、と遣ります。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "父と母にはねつけられたおねだりが、泣きながら祖母に訴えればかなえられることを覚え、西は何かにつけてはおばあちゃんの膝の上に転がり込むようになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れて大学生となった西は、おばあちゃんの財布を存分に活用して山のように本を買い集め、グライダーの練習に手を染めた★。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅費はおばあちゃんにねだり、三〇〇万円を用意した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "地元の小学校に上がって間もないころから、松本は「まあちゃん」と呼んでいた六つ年上の中島正敏の手ほどきを受けて、工作に取り組むようになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "電気にめっぽう詳しく、何を聞いても新しい世界の扉を開くような答えを返してくれたまあちゃんは、あたりの小学生たちの尊敬を一身に集める存在だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあちゃんの家の隣にはラジオ屋があり、この店で捨てられるジャンクはもっぱら彼の部品供給源となっていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単な鉱石ラジオの組み立てには飽き足らず、小学校二年のころからは、まあちゃんの手ほどきを受けて真空管式のラジオ作りに取り組むようになった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎がね、一昨夜夜中に、おかあちゃあと泣いているのですって。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
