        "examples": {
          "standard": [
            {
              "text": "あさだという海草は塩辛い味がする。",
              "source": "幻辞"
            },
            {
              "text": "市場であさだを買って帰った。",
              "source": "幻辞"
            },
            {
              "text": "あさだは磯の香りが特徴的である。",
              "source": "幻辞"
            },
            {
              "text": "刺身と一緒にあさだを食べるのが好きだ。",
              "source": "幻辞"
            },
            {
              "text": "あさだは栄養価が高い海産物である。",
              "source": "幻辞"
            },
            {
              "text": "漁業の授業であさだの採集を習った。",
              "source": "幻辞"
            },
            {
              "text": "旅館の夕食であさだが出された。",
              "source": "幻辞"
            },
            {
              "text": "あさだは日本の沿岸地域で採取される。",
              "source": "幻辞"
            },
            {
              "text": "磯焼きの時にあさだをつけダレにする。",
              "source": "幻辞"
            },
            {
              "text": "あさだの旬は春と秋である。",
              "source": "幻辞"
            },
            {
              "text": "地元の漁師があさだを採って生計を立てている。",
              "source": "幻辞"
            },
            {
              "text": "あさだは保存するために塩漬けにされることが多い。",
              "source": "幻辞"
            },
            {
              "text": "健康食としてあさだのサラダを食べている。",
              "source": "幻辞"
            },
            {
              "text": "あさだの栽培技術について論文を読んだ。",
              "source": "幻辞"
            },
            {
              "text": "伝統的な料理ではあさだが重要な材料である。",
              "source": "幻辞"
            },
            {
              "text": "あさだは低カロリーで健康的である。",
              "source": "幻辞"
            },
            {
              "text": "沿岸の居酒屋で新鮮なあさだが食べられる。",
              "source": "幻辞"
            },
            {
              "text": "あさだの香りは地中海を思い出させる。",
              "source": "幻辞"
            },
            {
              "text": "子どもの頃からあさだを食べていた。",
              "source": "幻辞"
            },
            {
              "text": "あさだはミネラルと食物繊維が豊富である。",
              "source": "幻辞"
            }
