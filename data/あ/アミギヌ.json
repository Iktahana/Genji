          "literary": [
            {
              "text": "いかなるものにて何にするぞと問へば、山にあるいらといふ草也、これを糸にしてあみ衣を作るといへり。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "あみ衣といふ名のめづらしければ強てたづねければ、老女はわらひてこたへず。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            },
            {
              "text": "案内がかたはらよりあみ衣とは婆々どのゝ着たるあれ也といふ、それを見れば※布のやうなるを袖なし羽織のやうにしたる物也。",
              "citation": {
                "source": "北越雪譜",
                "author": "鈴木牧之編撰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
