        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "洗い落とすを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは洗い落とすについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "洗い落とすの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は洗い落とすの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では洗い落とすが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "洗い落とすという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に洗い落とすという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では洗い落とすについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "洗い落とすを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると洗い落とすは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "洗い落とすについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では洗い落とすが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に洗い落とすは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により洗い落とすの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "洗い落とすは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に洗い落とすは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "」という警部の言葉に、「洗い落とす必要がある。",
              "citation": {
                "source": "唇のねじれた男",
                "author": "THE MAN WITH THE TWISTED LIP",
                "note": "青空文庫"
              }
            },
            {
              "text": "血液は、毒の源泉だからこれが一滴ついていても洗い落とす必要がある。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼くときに味噌から出して味噌を洗い落とす。",
              "citation": {
                "source": "生き烏賊白味噌漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "とんでもないことでございますよ」「しかし」と宗春物憂そうに、「過去の穢れを洗い落とす！",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "西洋風呂はただ体のあかを洗い落とす設備に過ぎないので、言わば便所と同様の意味のものであるが、日本の風呂は湯の肌ざわりや熱さの具合や湯のあとのさわやかな心持ちや、あるいは陶然とした気分などを味わう場所である。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水は汚れを洗い落とす性質をもっておりまして、水につかりあるいは水で洗うことが儀式的な潔めとなったのです。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはただ体に付着した汚れを洗い落とすということでなくて、道徳的な生まれ変わりという意味をもちました。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨハネ以前の洗礼においては、水で汚れを洗い落とすということに、意味があったのです。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "血の汚れを洗い落とすと手首の怪我はごく僅かで、ギルマンは二ヶ所の小さな刺し傷のありかを見て困惑した。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "この憂さはらしには、遊蕩紳士殿村啓介に変身して、いまわしい記憶を洗い落とすほかはないと思った。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "大法鼓を鳴らし、大法螺を吹き、大法幢を樹てて王城の鬼門を護りし昔しは知らず、中堂に仏眠りて天蓋に蜘蛛の糸引く古伽藍を、今さらのように桓武天皇の御宇から堀り起して、無用の詮議に、千古の泥を洗い落すは、一日に四十八時間の夜昼ある閑人の所作である。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "筆洗い　石油、及アルコールを併用します、即ち石油で先ず洗った後になおアルコールでよく洗って置くのです、アルコールは主として速乾を洗い落すのです、あるいは手先きのよごれた時や、ガラス面の掃除に使用します。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "また描き損じた絵を洗い落すにもアルコールが一番｜重宝であります。",
              "citation": {
                "source": "楢重雑筆",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコールは主として、速乾を洗い落すのです。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "また描き損じた絵を洗い落すにも、アルコールが一番重宝であります。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっ黒なつむじ風を洗い落すつもりだったのだろう。",
              "citation": {
                "source": "花ふぶき",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "足の泥を濁り水でじゃぶじゃぶ洗い落すと、ぶるっと身震いがした。",
              "citation": {
                "source": "特殊部落の犯罪",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この好機會を逸せず、諸君が原子核に存在する素粒子を利用する方法を攻究し、人間の福祉に資すべき發明に成功せらるれば、既往の謗りを洗い落すことが可能であると存じます。",
              "citation": {
                "source": "湯川博士の受賞を祝す",
                "author": "長岡半太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "血を浴びた裸体を氷のような冷水で洗い落すというのも相当の難作業である。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一滴の水にも一粒の砂を洗い落す力はあるんだから、それを信ずる人間なら、悪魔の足がどんなに汚れていようと、あとへは引かないはずだ。",
              "citation": {
                "source": "次郎物語",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらゆる曖昧さの嫌悪すべき粉飾を、魂から洗い落すがいい。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが図星に当って、紅皿と筆をお松の手筐に入れたのは、罠に掛ったようなものだ」「…………」「わざと筆の軸の銘を切って、善い筆か悪い筆か解らないようにしたが、上等の唐墨を洗い落すのが、少しぞんざいだった」「何だって新しい筆を使わなかったんでしょう」　とガラッ八。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "紅筆願文",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸いお前の文身を洗い落すついでに、一と皮｜剥いでやろうじゃないか、石原の利助を三助にするなんざア、お前にとっちゃ一代の晴れだ」　利助の左の手が女の丸い肩に掛ると、右手に持った濡れ手拭が、恐ろしい勢いで女の背から、肩から、腕を摩擦し始めました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お珊文身調べ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私は体じゅうが便所臭くなった気がして外へ出たのであったが、その臭気を洗い落すつもりだったのか、まだ足もとがふらついているので人に遇うのが嫌だったのか、そのまま風呂場へ行って着物を脱いだのであったらしい。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はしばしばこの女の全身の甘皮が、自分の肌へ肉｜襦袢のようにすっぽり被さってしまった気がして、それを残らず洗い落すのに多少の未練を感じながら、やっぱり自分が思ったよりも彼女を愛していることを意識しないではいられなかった。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはナオミが睡がったりして銭湯へ行くのを大儀がったものですから、海の潮水を洗い落すのに台所で水を浴びたり、行水を使ったりしたのが始まりでした。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とっさに、情夫の西門慶の姿が梯子段をころげるように降りて来るなり、隣家の王婆の裏口へ消えて行ったし、女の金蓮は金蓮でまた、俄にわが手で髪を揉みくずし、紅白粉を洗い落すなど、今日も二階で逢曳きの痴夢に現なかった男女には何ともやさしい仰天ではなかったらしい。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "入洲に手をつけて、飯粒などをざぶざぶと洗い落す。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからなるべく早く洗い落す必要がある。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
