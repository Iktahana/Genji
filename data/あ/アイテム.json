        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ダンジョンの奥深くで、体力を完全に回復させる貴重なアイテムを手に入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "インベントリが一杯になってしまったので、不要なアイテムを整理して捨てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ボス戦に備えて、攻撃力を一時的に上昇させる消費アイテムを買い込んでおく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
