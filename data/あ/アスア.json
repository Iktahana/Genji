        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アスアサゴジヒキコシテツダヒタノム」といふのだ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハコネ、ユモト、タマヤ、デビョウキ、アスアサキテクレ」　受取って玄関で開いた千歳は、しばらく何が何やら判らなかった。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は、名古屋駅発信で、発信時刻は当日午前七時二分、受信八時二十分で電文は『キユウヨウアリチユウオウセンニテマツモトヘユキアスアサイイダマチツクキミ』となっている。",
              "citation": {
                "source": "山吹町の殺人",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケサノリオクレタアスアサタツモヤー　がっかりし、泣き出したい位になった。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "電文には、昨夜Ｆ市の発信で「アスアサ九ジツク」とある。",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきまりの読み難い片仮名ながら、はっきりと、「アスアサ九ジツク」と書いてある。",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもルクソルとかアスアンとかの上流地方の都市に居住する者が大部分で、カイロにもいるようだが、要するに小市民で、活力の範囲は制限されている。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスアン付近に行くと殊に多くのヌビア人が見られるが、皮膚の黒さは煤で塗られたようである。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちが、アスアンでフィレの島へ小舟を雇った時、ヌビアの子供が四人で橈を漕ぎ、年とった親爺が舵を引いた。",
              "citation": {
                "source": "七重文化の都市",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "滋子はそのとき夫の克彦と白耳義にいたが、十二月もおしつまった二十九日の昼ごろ、アスアサ一〇ジ　パリニツクという安の電報を受取ってびっくりした。",
              "citation": {
                "source": "野萩",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "滋子は夫の克彦と白耳義にいたが、十二月もおしつまった二十九日の朝、アスアサ一〇ジパリニツクというやすの電報を受取ってびっくりした。",
              "citation": {
                "source": "ユモレスク",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "二四ヒスマヌ　アスアサデ　ンタノム。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロップ倉庫の前で、その平井老人が、ぼくを見るなり「おや、アスアかと思ったぜ、よく似てるなあ」と大ゲサに眼を丸くして云った。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後も「おめえ、アスアに似てるぜ」と、ぼくを見るたび云うのである。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "気になって、アスアって誰？",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それといふのもぼくがドツク會社に入つてまもない頃、ロツプ倉の倉庫番をしてゐたＨといふ老職工が、ぼくを見るなり「おや、アスアによく似てゐやがるなあ、アスアかと思つた」と叫んだ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスアといふのは、アダ名か實名か、へんな名だけに妙にそれも頭にこびりついた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞその時、陸に居て、ぼくの乘つてゐた足場ロツプの操作を過まつておツ放してしまつた人は、ぼくがドツク會社へ入つた當初「おや、アスアに似てるよ」と叫んだあのロツプ倉のＨ老だつた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "モーナルーダオはマヘボ社の親戚ジアスアベバの家に呼ばれていた。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
