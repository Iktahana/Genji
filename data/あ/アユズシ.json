        "examples": {
          "standard": [
            {
              "text": "鮎ずしを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは鮎ずしについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "鮎ずしの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は鮎ずしの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では鮎ずしが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "鮎ずしという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に鮎ずしという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では鮎ずしについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "鮎ずしを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると鮎ずしは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "鮎ずしについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では鮎ずしが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に鮎ずしは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により鮎ずしの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "鮎ずしは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に鮎ずしは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "そして久助は、出がけに彼の眼瞼を熱くした、あの不覚の涙に溺れなかった為に、今こうやって自分が、朋輩の誰よりかも、一番忠僕になれた事を考えて、鮎ずしを頬張りながら、思わずひとりで微笑んだ。",
              "citation": {
                "source": "忠僕",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道の「鮭ずし」は元来新潟のもので（北海道は新潟人の出稼ぎ人が最も多く土着した）似たような「鮎ずし」もあり、海の魚も川の魚も美味だが、土地の魚は多くはとれないので一般用はよその魚かも知れない。",
              "citation": {
                "source": "諦めている子供たち",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "時間を節約する為に、電車の中で鮎ずしを喰べて、ひる少し前に法隆寺村へ着いた。",
              "citation": {
                "source": "壁画摸写",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "車で下市へ下り、谷崎氏の“吉野葛”にも見える弥助鮨の楼上に休んで鮎ずしを食う。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
