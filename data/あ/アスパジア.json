        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日、学生が女学生と共にサン・クルーの川舟に乗るのは、昔アスパジアがペリクレスと共にサモスの流れに浮かんだのと同じである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人諸君、君たちはアスパジアがいかなる女であったかを知っているか。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスパジアは女の両極を同時に有する女性であった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスパジアは実に、プロメシュースに女が必要である場合には、その用をなすために作られたようなものであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
