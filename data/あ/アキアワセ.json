        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "涼やかな風が吹き始めたので、箪笥から秋袷を取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "観劇のお供には、落ち着いた色合いの秋袷を選んで袖を通した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母から譲り受けた秋袷は、今でも古びることなく気品を保っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それまで筒袖のつんつるてんの着物を着て居た私は、その年の秋袷から、袖のついた一人前の着物を着せられた。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（10）　時間の句やがてきづく菊の小雨や秋袷　　　みどり新涼や月光うけて雨しばし　　　あふひいつとなく木立もる灯やくれの秋　　　同　秋袷の女がいる。",
              "citation": {
                "source": "大正女流俳句の近代的特色",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "十　四五日たつと、あの夜をかぎりもう行かないつもりで、秋袷の代まで置いて来たのにも係らず、何やらもう一度行って見たい気がして来た。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋袷身を引締めて稽古事九月十四日　笹鳴会。",
              "citation": {
                "source": "五百五十句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
