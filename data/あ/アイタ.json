        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、こうしたアイタイずくめの文化人の包装は、その低級深刻にして、奔放無頼なる心理遺伝の内容を洩らすまいとして、いつも一パイに緊張している。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「啖付いても大事ないかえ」「歯が立ったなら鰻を今一パイ喰わせる……アイタタタ……待て……待てチウタラ……」　廊下を通りかかった女中が吃驚したらしく襖を開けたが、木乃伊親爺の二の腕に付いてる濡れた歯型を見ると、呆気に取られたまま突立っていた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今更となって……恥を晒すかッ……コン畜生コン畜生コン畜生ッ……」「アイタッ……アタッ……アタアタッ……サ……晒します晒しますッ。",
              "citation": {
                "source": "戦場",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴェルダンの火の中へ行きます……喜んで……アイタッ……アタアタアタアタアタッ」　月光に濡れた工兵中尉の剣光がビィヨンビィヨンと空間に撓った。",
              "citation": {
                "source": "戦場",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイタッ」　と泥棒はうしろ向きに立ち止まる拍子にお縁から足を辷らして、石の上に落っこちて頭をぶって眼をまわしてしまいました。",
              "citation": {
                "source": "虻のおれい",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アイタイ』っていう『アイ』じゃないか」「勝手にこしらえたんじゃないかい」「僕がかい」「そうじゃない。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゼヒアイタイ、スグキテクレ」　としてあった。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ヴアイタリテイのない人間ほど醜惡なものはないね。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「殺せ、アヤ、アイタ、アヤ、殺せ！",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "背より腰にかけての痛今日は強く、軽く拭はるるすら堪へがたくして絶えず「アイタ」を叫ぶ。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "』こう云わなけりゃアイタに付かねえ」　この心配も無用であった。",
              "citation": {
                "source": "銀三十枚",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりにも観世の御曹司が、地口を語るとは不似合だな」「それ不似合、やれ不面目、家名にかかわる、芸の名折れ、どっちを向いてもアイタシコ。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新「アイタ」　賤「アヽじれったいね」　と有合せた小杉紙を台処で三帖ばかり濡して来て、ピッタリと惣右衞門の顔へ当てがって暫く置いた。",
              "citation": {
                "source": "真景累ヶ淵",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふしやうぶしやうに、庭に下りて、外れし戸をやうやくに建て合はせ、竿竹にてともかくも支へ来り、上りかけにわざと強く夫の足に突当たれば、　アイタアイタ痛てえや、何をするんだ。",
              "citation": {
                "source": "磯馴松",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろあれの親も、盗人じやあないが、お金を遣ひ込んで這入つたんだといふからね』　折しも次間に人の気配、奥様誰ぞと声かけたまへば、大村でござるといふ声の、噛付くやうに聞こへしにぞ、さてはと奥様お奥へ逃入りたまふに、三もとつかは流しもとへ退らむとしての出合頭、ぬつと入来る一郎に突当られてアイタタタタ。",
              "citation": {
                "source": "誰が罪",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイタタ、まあひどいのネ此の児は。",
              "citation": {
                "source": "熊と猪",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイタタ、何といふ乱暴な子だらう、此の子は。",
              "citation": {
                "source": "熊と猪",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八ヒアサ　ヒカワマルデ　ヨコハマニツク　ニユウグランドニテアイタシ　アリエ　アリエ、アリエ……と口のなかでくりかえしているうちに、アメリカの北西部で、祖父が、有江というひとと共同で、鉱山の仕事をやっているという消息があったのを、思いだした。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その原種は水辺に野生してこれは敢えて食用に利用せられてはいないが（無論利用は出来る）、これから変わって出た上のアザブタデほかのムラサキタデ、アイタデ、ホソバタデ、イトタデなども多く人家に栽えてあって、同じくその葉が食用に供せられる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金五郎から、いつも、「お前は、朝、頭をたたかれて、夕方ごろになって、アイタ、というような男じゃ」といって、からかわれる。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "清七の奴も、朝、頭をたたかれて、夕方ごろ、アイタというような奴じゃげ、よう揃うたもんじゃ」　金五郎は、かたわらにいた「六ゾロの源」に、そんなことをいって笑った。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイタッ、なにするか」　金五郎は、びっくりして、頬に、手を当てた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "清七がカンのにぶい奴で、朝、頭をたたかれて、夕方になって、アイタというほどのろくさい男じゃが、おれの方がよっぽど、カンが鈍い。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは、二十五年ぶりに、アイタ、というようなもんじゃ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "三「ア痛、アイタタタッ……」　跛をひきながら、草むらよりころげだしたのは竹童である。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰の痛いこと、アイタゝゝゝと言ひつゝ座る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
