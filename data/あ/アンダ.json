  {
    "uuid": "02dec376-f947-51b9-81a5-4561754c5827",
    "entry": "アンダ",
    "reading": {
      "primary": "あんだ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
