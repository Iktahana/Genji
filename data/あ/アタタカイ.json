        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は誰に対しても暖かい心で接する優しい人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "近所の人たちの暖かい励ましのおかげで、辛い時期を乗り越えられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "失敗して落ち込んでいる部下に暖かい言葉をかける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
