        "examples": {
          "standard": [
            {
              "text": "秋風が吹き始めると、庭の片隅で赤酸漿の袋が色づき始める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "祖母は縁側に座り、赤酸漿の実から丁寧に種を抜いて笛を作ってくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "鬼灯市で鉢植えの赤酸漿を買い求め、夏の終わりの飾りとして玄関に置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "国王これを訪い眼を開きて相面せよといいしに、わが眼睛｜耀射て、君輩当りがたしと答え、国史に猿田彦大神、眼｜八咫鏡のごとくにして、赤酸漿ほど※く、八百万神、皆｜目勝ちて相問うを得ずとある。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あかかがち」とは赤酸漿の実の古い名、当時の美女はほおずきのように丸く、赤く、艶やかであったらしくも考えられる。",
              "citation": {
                "source": "明治美人伝",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "平安朝になっては美人の形容が「あかかがちのように麗々しく」と讃えられている。",
              "citation": {
                "source": "明治美人伝",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
