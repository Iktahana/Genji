          "literary": [
            {
              "text": "のみならず、ちょうど私が箱根のアシノコ・ホテルに外人を診察に行く約束をした日の早朝に白鷹氏……否、白鷹先生ならぬ白鷹先生から電話がかかって、「この間はすまなかった。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後になって箱根のアシノコ・ホテルに外人を診察しに行かれましたか」「ええ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハコネのアシノ湖あたりへ行きませう、Ｈさん、姉さん――信州から帰つてから。",
              "citation": {
                "source": "断唱",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノカホイロモスヅメノアシノヨホデス。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはまだ私たちだけの想像で、しかとした証跡も実はないのだが、とにかくに全国的にいたって数多いアシダニ・アシノタニ・千束・菖蒲谷という類の地名が、この県にもかなり分布していて、まだその由来が判っておらぬということは、注意しておいてよいであろう。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
