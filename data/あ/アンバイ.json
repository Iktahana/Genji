[
  {
    "uuid": "de092eb4-e304-57bb-9676-b0573b3840b0",
    "entry": "塩梅",
    "reading": {
      "primary": "あんばい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
