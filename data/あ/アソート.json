        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アソートされたマカロンの箱を開けると、ピスタチオ・ラズベリー・バニラが色鮮やかに並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "アソートされた文房具セットは、子どもへのプレゼントとして定番の商品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "複数の香りがアソートされたキャンドルセットを母の日のギフトに選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
