[
  {
    "uuid": "64fcefcb-5e7f-54cd-b5f1-85f7eaaa3a9a",
    "entry": "主",
    "reading": {
      "primary": "あるじ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
