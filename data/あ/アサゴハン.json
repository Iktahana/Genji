[
  {
    "uuid": "04467aa0-1700-5394-80a9-b26cf5b8191d",
    "entry": "朝ごはん",
    "reading": {
      "primary": "あさごはん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
