[
  {
    "uuid": "63b112bb-8c69-54b3-8f74-185b1ae4f60b",
    "entry": "分つ",
    "reading": {
      "primary": "あかつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
