          "literary": [
            {
              "text": "見なさい、アレアレちらほらとこうそこいらに、赤いものがちらつくが、どうだ。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごらんなせえ、アレアレ、あの腹が減ったような顔つきをしているやつがそうです」「もういい。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……汝の悪逆の所業から、それからそれと禍いを産み、頼母様を五郎蔵に怨ませ、アレアレあのように紙帳の外では、五郎蔵めに頼母様が！",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「狂人が妾を手籠めにし……殺そうとしてアレアレそこへ！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アレアレ聞くがいい。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そればかりでない、アレアレ向こうへ、雲助、博労、無頼漢によって、運び去られ行く木箱こそ、宥免状を入れた人形箱！",
              "citation": {
                "source": "猫の蚤とり武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の人ばかりだからアレアレなのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレアレ、キミ、何十年かぶったの。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "何一ツ証拠にする様な物もなし、まるで風の様にサッと来てアレアレと云う間に攫ってしまったのですからなあ……』　プラスビイユもよほど閉口しているらしかった。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレアレッと驚き見まもる暇もなく、砲塔をゆるやかに旋回させ、八｜糎速射砲の無気味なる砲口を桟敷の中央に向けたと思うと、来賓席の二段目を目がけて、たちまち打ち出す薔薇やアネモネの炸裂弾。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "南風吹かば　――モンテ・カルロの巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物はアレアレと騒いでている間に、鷹は心得たもので、悠々と雀を追って地上に舞い戻り爪で押えた、よく馴らされているので、雀に疵を負わせるようなへまはやらなかった。",
              "citation": {
                "source": "美人鷹匠",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもちゃの汽車竹内浩三ゴットン　ゴットン汽車が行くケムリをはいて汽車が行くアレアレアレアレ脱線だお人形さんの首が飛びキューピイさんの手が飛んだ死傷者優に三十個オモチャの国の大椿事",
              "citation": {
                "source": "おもちゃの汽車",
                "author": "竹内浩三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレアレ、また一つ、オヤッ、二つになった。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレアレ墜落する天狗岩「ああ、間に合った。",
              "citation": {
                "source": "天狗岩の殺人魔",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレアレ見たような奴が、おさきに立ってくるぞ……いけねえ！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレアレ、こんどは湖水のほうへいっさんにかけりだした――」　瞳をこらして見ていれば、さっさつたる怪影は、関の山から竹生島のあたりへかけて、ゆうゆうと翼をのばして舞うのであった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレアレ大変大変」と叫び出したので人々がみな起きて来て舟をとめて水夫を海に入れてさがさせたけれども見つからない。",
              "citation": {
                "source": "「平家物語」ぬきほ（言文一致訳）",
                "author": "宮本百合子訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな船が、アレアレ横っ倒しになって沈んでいるよ。",
              "citation": {
                "source": "新宝島",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
