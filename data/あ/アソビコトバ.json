        "examples": {
          "standard": [
            {
              "text": "彼のスピーチには「あのね」という遊び言葉が多く使われていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "遊び言葉を減らすことで、プレゼンテーションはより聞きやすくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼女は話すときに「えっと」という遊び言葉をよく使う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私が少年時代、朕という言葉は、子供たちの遊び言葉で、おかげで我々は少年時代に、余分に笑うことができた。",
              "citation": {
                "source": "天皇陛下にさゝぐる言葉",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔話のチンチン小袴、もしくは小児の遊び言葉に、こういう文句のあったことを記憶している人ならば、誰でもこの名を聴いて微笑することであろう。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野草雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
