    "definitions": [
      {
        "index": 1,
        "gloss": "hiba false arborvitae (species of cypress, Thujopsis dolabrata)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "翌檜は檜に似た木だが、「明日は檜になろう」と言われるほど自己評価が高い木として知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "山道を歩いていると、翌檜の独特な扁平な葉が光を受けてきらめいていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "植物図鑑で翌檜のページを開くと、ヒノキアスナロとアスナロの違いが細かく説明されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "まるで蕈とあすなろとの合の子みたいな変な木が崖にもじゃもじゃ生えてゐた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで蕈とあすなろとの合の子みたいな変な木が崖にもじゃもじゃ生えていた。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東の南の背の高い、よく雀が来てとまるひば、一杯の引かぶった松、あすなろう。",
              "citation": {
                "source": "一九二三年冬",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはよいとして、はじめは燈籠の下あたりにだけあったに相違ない低い笹が、根から根へひろがって、左手の円いあすなろうのところまで茂っている。",
              "citation": {
                "source": "雑沓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――空地のほぼ中央に、さしわたし二尺あまりのあすなろうの樹があり、その脇に、小舟をあげたのが伏せてあった。",
              "citation": {
                "source": "あすなろう",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紡錘形に剪定したアスナロを模様のようにところどころに植えこみ、その間に花壇と睡蓮の池がある。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスナロノヒジキ　アスナロとはアスナロウで明日ヒノキになろうといって成りかけてみたが、ついに成りおうせなかったといわれる常緑針葉樹だ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この樹の枝にはアスナロノヒジキと呼んで、一種異様な寄生菌類の一種が着いて生活していて、その学名を Caeoma deformans Tubeuf と称するが、その最初の学名は Uromyces deformans Berk. et Ber. であった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれをアスナロノヒジキと呼んだが、しかしヒジキの名はあっても海藻のヒジキのように食用になるものではなく、単にその姿をヒジキに擬ぞらえたものに過ぎないのである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちその書の巻九十にアスナロウノヤドリギとしてその図が出ている。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそのアスナロノヒジキを相州箱根で採ったのは、右の大久保三郎君よりは私が一足先きであったことである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちこのアスナロノヒジキはかくして私が初めてこれを箱根で採ったのである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアスナロノヒジキは一種の寄生菌、すなわちアスナロの害菌で、そのもとの学名 Uromyces deformans Berk. et Broom は初めてかのチャレンジャー航海報告書にその図説が発表せられたのである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この菌はまたアスナロに近縁異属のクロベ一名ネズコすなわち Thuja Standishii Carr.（＝Thuja japonica Maxim.）にも寄生するのだが、この樹のものは瘠小で緑色を呈しすこぶる貧弱な姿を呈している。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "加賀・能登辺では唐檜すなわちアスナロの木をアテともクサマキともいっている。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
