    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これらの引斥力が自乗反比例という簡単な言葉で表わされるのは驚くべき事であるというよりは、むしろかくのごとく簡単に云い表わし得る言葉があるのが驚くべき事だとピアソンは云っている。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろずいぶん遠くの事だつたで‥‥」　警視は鋭い眼で暫くダアルベルグの顏を探るやうに見詰めてゐたが、やがて次のペタアソンの方へ向きなほつた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それだからヂックを勤めたカアソンという役者が、批評家に智恵を附けられて、ジックは牧師の妻を愛しているので、それで牧師の身がわりに立ったということにした。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "チイサイ　トキカラ、ヤマ　ノ　ケモノ　ヤ、トリタチ　ト、ナカヨク　アソンデ　ソダチマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『ミナサン、ボク　ト　アソンデ　クダサイ』ト。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば日本の「アソ」、「ウス」、「オソレ」、「エサン」、「ウンセン」等に対してカムチャツカの「ウソン」、マリアナ群島の「アソンソン」、スマトラの「オサール」などがあり、またわが国の「ツルミ岳」、「タルマイ山」、「ダルマ山」に対しジャヴァの「ティエリマイ」、「デラメン」などがあるという類である。",
              "citation": {
                "source": "火山の名について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "★『DIJITAL AT WORK』（ジャミー・パーカー・ピアソン編、Digital Press 、一九九二年）所収のケン・オールセンへのインタビュー。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてエマアソンがその撤回を強要した時、敢然として耳を傾けなかった理由が如何に明白であるよ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エマアソンに言わせれば、人の智慧は其の人の有つ希望の有無多少によって計られるのだそうだから、私も希望を失わぬことにしよう。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヌスビトト　コヒツヂ新美南吉　ヤワラカイ　クサガ　ミドリノ　モウフノヤウニ　ハヱテ　ヰル　ヒロツパニ　タクサンノ　ヒツジガ　メイメイト　ナキナガラ　アソンデ　ヰマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オナカガ　スイテ　ヰル　ヌスビトノ　メニ、フト　マルマルシタ　コヒツジガ　一ピキ、ミンナト　ハナレテ　アソンデ　ヰルノガ　ウツリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツピキノ　シロイ　テフテフガ　フウセンダマノ　トコロヘ　マイニチ　トンデ　キテ、イチンチヂユウ　アソンデ　イクノデシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "インガルスとは打つて変つた肥えた男で、診察のひま／＼には、静な書斎でエマアソンの論文を読むのが何よりも好きであつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが困つた事には、このお医者がエマアソンを読まうとすると、極つたやうに其処へ飛び込むで来て、邪魔｜立する者がある。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "外でもない、ちんぴらな新聞売子で、医者とエマアソンとの知らない色々の事が載つてゐる新聞を押売しに来るのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者は友達の顔を見ると、例のやうに新聞売子がうるさくて、しみ／″＼エマアソンが読めないのが何よりも残念だと話をした。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」露伴氏と鱸９・11（夕）　米国の飛行家パタアソン氏の郵便飛行用飛行機の製作者ゴウハム氏の阿爺さんは、米国でも指折りの釣りの名人ださうで、日本へ来る早々日光の中禅寺湖へ鱒釣に出かけて往つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここですよ、レストラン・ボアソンと言つてね。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ以後Ｏ氏は友達と散歩の途すがら、どうかしてレストラン・ボアソンの前へ出ると、慌てて友達の肱をつついて言つた。",
              "citation": {
                "source": "茶話",
                "author": "初出未詳",
                "note": "青空文庫"
              }
            },
            {
              "text": "教科書には、テニソンや、ラスキン、エマアソンなどゝいふ洒落たものを毎日包みにして通つてゐるにも係はらず、単に音読だけでも、彼が一度試験して見ると、辛うじて片仮名読みにたどらなければ声が出なかつた。",
              "citation": {
                "source": "小川の流れ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『明治二十四年――卒業生』八　学校を卒業する頃の菅はエマアソンなぞの好きな、何となく哲学者らしい沈着を有った青年に成って行った。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゾラ『アソンモアル』、クロポトキン『パンの略取』、アラトウ『無政府主義の哲学』、『荘子』、『老子』、『家庭雑誌』、『日本エスペラント』。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏蘭西人のホテルで、メエゾン・ポアソンといふ家号だつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前はこの総裁六さん――じゃあねえ、何とか六麿のアソンを何と思ってやがるんだ」　そばにいた女たちが、六さんをとめたけれど、六さんはとうとう青二におどりかかって、その帽子をひったくってしまった。",
              "citation": {
                "source": "透明猫",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の持っている、マドモアゼルロアソンという文字が記されている二人の娘の肖像も、まったくオランダあたりから渡来したのかと思っていたが、よく見るとそれは支那製である事がわかった。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "外へ出た序にリユウ・ド・パラヂイ・ポアソンニエエルに立ち寄つて、このリツトル・ジヤツクと云ふ子猿に砂糖を一切れづゝくれて行つた。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に読んだエマアソンの文と比較して見ると、明に二人の性格の差が感ぜられる。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "エマアソンは、何と云うか、真昼の太陽の正しさと、熱と、暖みと平静とを持つトランスペランシーがある。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            }
          ]
        }
