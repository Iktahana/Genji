[
  {
    "uuid": "f29bf08d-875f-5a0e-ad75-46ea2b30319d",
    "entry": "朝臣",
    "reading": {
      "primary": "あそん",
      "alternatives": [
        "あっそん",
        "あそみ"
      ],
      "is_heteronym": false
