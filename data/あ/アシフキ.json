        "examples": {
          "standard": [
            {
              "text": "お風呂から上がったら、バスマットの代わりの足拭きでしっかり水気を取ってください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "雨で靴下が濡れてしまったので、玄関に置いてあった足拭きを使わせてもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ホテルのシャワールームには、ふかふかの足拭きが用意されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "風呂場の足拭きとか、火鉢の下敷くらいの用にしかならないのだろうが、丹念に、しっかりと編みあげるから、平さんの品は好評で、かなりとくいも多いようであった。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
