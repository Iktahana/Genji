  {
    "uuid": "5602fd6c-545b-5d11-aeed-ebc8f1cd2a09",
    "entry": "安分",
    "reading": {
      "primary": "あんぶん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
