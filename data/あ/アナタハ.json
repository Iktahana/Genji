        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタハ、キットウマイ。",
              "citation": {
                "source": "水仙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しはなれた食卓にただ一人すわっている日本人らしい若い紳士にハース氏が「アナタハニホンノカタデスカ」と話しかけると Ja ! といってうなずいて見せた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ　コレカラ　ドチラヘ　イクノデスカ」ト　シンセツナ　トシヨリハ　ワカイ　ヲトコニ　タヅネマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ア……ア……アナタハ……サッキ……ノ……」　彼女はカスレた声でこう言いさしてグッと唾を呑んだ。",
              "citation": {
                "source": "童貞",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚句ノ果ニハ、　「アナタハ一体今迄清三ニカクレテ私ト愛シ合ッテ居タノデハナクッテ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハ勿論権利ガアルトハ思イマセンケレ共、余リ乱暴ナ言イ方ナノデ私モ二言三言申シマスト、　「一体アナタハホントニ私ニ可愛ガラレテ居タト思ウノ？",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハ、ニッポンジンカ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハソウト、アナタハ赤イ洋服ガチツトモ似合ヒマセンネ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マア、アナタハ、何トイフ近眼デセウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨシヲサンノオ母サンハキウニトビ上ツテ、「アラ、アラ、誰カト思ツタラ、アナタハヨシヲサンヂヤナイノ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、アナタハンのような事件そのものは、戦争がなければ起り得ない性質のものではない。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の女をめぐって殺し合うのは、山奥の飯場のようなアナタハンに外見の似た土地柄でなくとも、都会の中でもザラにありうることだ。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハンには法律も刑事も存在しなかったから、各人の心理は我々とちがって開放的で、そこにおのずから差があった筈だと見るのもうがちすぎているようだ。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そこでも、アナタハンと同じような事件が奇も変もなく行われているのである。",
              "citation": {
                "source": "都会の中の孤島",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタハン」で京都で張り切っているジョセフ・フォン・スタンバーグの処女作、「救いをもとめる人」なぞも最早白髪に近視鏡をかける年老えるスタンバーグの近影を見て過ぎし日の感激が又新たになるのである。",
              "citation": {
                "source": "私の洋画経歴",
                "author": "小野佐世男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イツナサルノ」「病院ノ方ハイツデモイラッシャイト云ッテルンダ、ソウ決マッタラ早イ方ガイヽ、明日行ク」「マアオ待チナサイ、アナタハイツモ性急ナンダカラ」婆サンハ出テ行ッタト思ウト、高島易断ノ暦ヲ持ッテ戻ッテ来タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ誤解シテイルヨウダガ僕ハ決シテ怒ッテイルノデハナイノデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンサン、　アナタハ、金五郎サントオ京サントノ事、ナニモ知ラナイデシヨウ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "「シバラクシタラアナタハ一切ヲ思イ出サレルデショウ」「どういうことなんだ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「思イ出サレタヨウデスネ」「ああ、だいたい思い出したとも」「アナタハ」炎のような球体は今度は雄弁に思念を送ってくる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハアルトキ自ラノ意思デ私ヲ創造シタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ私ヲ“創造者”ト呼ビ、私ニ宇宙ヲ創造スルコトヲ命令シタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコノ宇宙ガ不満ダッタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハコレヲ破壊スルヨウニ命ジ、私ハ命ゼラレタ通リノコトヲシタ」「その通りだ」あなたの意識は思念を送った。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ“存在者”デアルコトヲ忘レ、自分ガ生マレル前カラ世界ガ存在シテイルカノヨウニ認識シタ。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ地球トイウ惑星ノ日本トイウトコロニ生マレ、擬似体験げいむノぷろぐらまあトイウ職業ニ就ク。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハ子供ノ頃学校ノ歴史ノ時間ニ、西暦一九九九年ニ第三次世界大戦ガ勃発シタト教ワル。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタハン島から歸つて來た人々には、ついこの七月上旬がもう遠い歴史の日であつた。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
