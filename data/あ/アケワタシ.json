  {
    "uuid": "02b30309-0c94-5886-bcf0-a6e2b521eb65",
    "entry": "明け渡し",
    "reading": {
      "primary": "あけわたし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
