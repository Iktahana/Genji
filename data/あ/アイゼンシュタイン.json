        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはグンテル王が、ひそかに想いを焦がすブルンヒルデ女王であって、ブルンヒルデは、アイゼンシュタイン河を隔てた洋上に砦をきずき、われに勝る勇士あれば、嫁づかんと宣言していたのである。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "王は奇策を胸に秘めて、アイゼンシュタインの城へ赴いた。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイゼンシュタインの城内で、妾をうち負かしたグンテルが、何者であったか。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラマの祭りの仮面踊りはアイゼンシュタインの「アジアの嵐」という映画にあの時代らしい手法で、比喩的にフラッシュで使用されていました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
