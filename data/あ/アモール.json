        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "小さい愛の神のアモールたちは、そのまわりでワニとたわむれていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊饒の角の中にはごく小さいアモールがひとり、腕を組んですわっていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアモールは、あの紡車のそばにいた小さい男の子にそっくりの姿をしていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソプラノの主役オイリディーツェを百合姫と訳してこの役を私、矢張りソプラノのアモールを愛の女神と訳して宮脇遷さん、この方は吉川さんと同級で今は甲賀さんといいます。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "希臘神話のアモールとプシヘ、或は愛の男神と心の女神との結婚説話は、其発達の最後の階段に於ては、純粋の神と神との結婚説話なり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "希臘神話のアモールとプシヘとの結婚説に関しては、天然神話説あるも、信ずるに足らず。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アモールとプシヘの説話、及びウルヴシとプルラヴァスの説話の如きは、禁制の違反として、説明せらる可きものなりと。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、アモール（ラヴ）に相当する日本語として、「御大切」といふ単語をあみだしたのである。",
              "citation": {
                "source": "ラムネ氏のこと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
