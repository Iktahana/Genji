          "literary": [
            {
              "text": "交差点の赤信号で車は停った。",
              "citation": {
                "source": "記憶",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "腕時計を気にしながら開店直前の紀伊国屋の前を小走りに通り過ぎ、赤信号の横断歩道を渡ってほとんど十時ちょうどにスタジオアルタ前に到着した。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "迎賓館に通じる大通りを渡り、四谷見附橋を渡り、最後に赤信号を無視してホテルニューオータニに抜ける小さな横断歩道を小走りに渡ると、北門から上智大学に入った。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自動車にとって赤信号のその交差点の横断歩道を渡っていきつつあるのは、そのふたりの女性だけだった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "交差点までそのまま徐行していき、赤信号で止まった。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウールワースのまえにある交差点の赤信号で、自動車の列は止められた。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "人も車も途絶えた交差点の赤信号でとめられていたとき、このオートバイのアイドリングを聞いていて、ぼくは泣き出したのだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "またがって赤信号を見つめているぼくも、生きている。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "交差点のむこうの赤信号が、突然、ぼうっとにじんだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤信号の赤が、どんどん、にじむ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "四つ角で赤信号が出たら、青になるまで止まっていなければなりません。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
