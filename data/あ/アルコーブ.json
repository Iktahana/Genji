        "examples": {
          "standard": [
            {
              "text": "アルコーブを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちはアルコーブについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "アルコーブの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生はアルコーブの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化ではアルコーブが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "アルコーブという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中にアルコーブという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社ではアルコーブについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "アルコーブを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によるとアルコーブは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "アルコーブについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野ではアルコーブが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的にアルコーブは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展によりアルコーブの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "アルコーブは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的にアルコーブは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "もし、その消え得べき時ありとなさば、そは、唯だ、われにして君をわがアルコーブの帳幕の陰に引入れしめ、わが手わが唇をして、親しく君が肉の上に触れしめん夕べのみ。",
              "citation": {
                "source": "舞姫",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "左手に幕を引いたアルコーヴ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチンとつながっているような、あるいはつながっていないような、微妙な造りになっているダイニング・アルコーヴのテーブルは、すでにセットしてあった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイニング・アルコーヴのテーブルは、すでに昨夜のうちにきれいにセットしてある。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、ダイニング・アルコーヴに入ってきた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥にむけて歩いていくと、両側にいくつものアルコーヴがある。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "棚のある壁面をできるだけ多く作り出すためには、数多くのアルコーヴが必要なのだ。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコーヴごとに領域を設定できるし、そのなかにいるとなかば個室のようであり、本を選ぶ人の気持ちは落ち着く。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのすこし手前に、現代の作家たちによる短編集をたんねんに集めたアルコーヴが、ふたつあった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくは、そのアルコーヴに入った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコーヴのこちら側の端からむこうの端まで、かなりの距離がある。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣りのアルコーヴにも、現代のアメリカ人作家たちによる短編集が集めてあった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリスマス・プレゼント用のきれいな本がたくさん並べてあるアルコーヴをへて、ぼくたちはキャシーアのカウンターのまえに立った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "キチンの外に食事のためのアルコーヴが大小ふたつあり、小さいほうのアルコーヴにぼくたちは入った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "入れちがいに、ジムがアルコーヴに入ってきた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "着替えをすませたシャーリーがアルコーヴに戻ってきて、ぼくは思い出を脱して現実に帰った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕食のしたくを始める時間まで、ぼくたちはアルコーヴにいた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁に囲まれてアルコーヴのようになっているふたり用の席に、中野玲子の姿があった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "引出しの下の、小さなアルコーヴのようになった直方体の空間には、奥の壁に寄せてカレンダーが立てかけてあった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
