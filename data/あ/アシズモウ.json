        "examples": {
          "standard": [
            {
              "text": "子供の頃、よく兄弟でベッドの上に寝転がって足相撲をして遊んだものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "足相撲の勝負では、単なる腕力よりも足の器用さと全身のバランス感覚が問われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "飲み会の余興でいきなり足相撲のトーナメントが始まり、思いのほか白熱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "酒屋へは、有本老人、疊屋の吉さん、表具屋の主人、などコップ酒の常連が詰掛けて、足相撲をやつてゐた。",
              "citation": {
                "source": "足相撲",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、どうした誘惑からか、足相撲などに一度の經驗もない私は、「先生、私とやりませう」と、座敷へ飛び上つた。",
              "citation": {
                "source": "足相撲",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
