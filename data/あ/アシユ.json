        "examples": {
          "standard": [
            {
              "text": "温泉街を散策したあと、無料の足湯に浸かって冷えた体をじんわりと温めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "観光案内所のすぐ隣に立派な足湯の施設ができていて、多くの観光客で賑わっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "長時間の山歩きで疲れ切った足を、旅館の庭にある専用の足湯でゆっくりとほぐした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "爺さんの衰えた身体に蛭療法が行われ、続いて湿布剤、足湯、更に二人の若者の力と献身なくしてはなし得ない医学的措置がとられた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　あしゆびの股を丹念に拭きこみながら彼は重ねて云った。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
