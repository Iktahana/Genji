        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "僕アンデルゼンのおはなしやなんかもっと読みたいなあ。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アンデルゼンの猫を知ってゐますか。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇で毛を逆立てゝパチパチ火花を出すアンデルゼンの猫を。",
              "citation": {
                "source": "猫",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "即興詩人（森鴎外訳）も面白い、クラシツクのよさが、アンデルゼンのよさが、鴎外のよさが私を興奮せしめる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学になってからも物語りであることをやめなかった（アンデルゼンやソログーブのことを憶い出して下さい）。",
              "citation": {
                "source": "童話における物語性の喪失",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンデルゼンでも読み給え。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はい、アンデルゼンを読みます。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さなかなしい　アンデルゼンの娘よ。",
              "citation": {
                "source": "死について",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は飢ゑと寒さに戦きながら農家の二階でアンデルゼンの童話を読んだ。",
              "citation": {
                "source": "死について",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "予はＡＮＤＥＲＳＥＮをアナアセンと呼ばず、アンデルゼンと呼ぶを恥ぢざるものなり。",
              "citation": {
                "source": "続野人生計事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "予は ＡＮＤＥＲＳＥＮ をアナアセンと呼ばず、アンデルゼンと呼ぶを恥ぢざるものなり。",
              "citation": {
                "source": "梅花に対する感情",
                "author": "このジャアナリズムの一篇を謹厳なる西川英次郎君に献ず",
                "note": "青空文庫"
              }
            },
            {
              "text": "一　作者この『こがね丸』を編むに当りて、彼のゲーテーの Reineke Fuchs（狐の裁判）その他グリム、アンデルゼン等の Maerchen（奇異談）また我邦には桃太郎かちかち山を初めとし、古きは『今昔物語』、『宇治拾遺』などより、天明ぶりの黄表紙類など、種々思ひ出して、立案の助けとなせしが。",
              "citation": {
                "source": "こがね丸",
                "author": "巌谷小波",
                "note": "青空文庫"
              }
            },
            {
              "text": "このアンデルゼンの小説だとか、シュウビンの「埋木」のやうな味はひの小説を何とかして書きたいものだと、病氣をする度毎に思ふのである。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンデルゼンのものはこの外に中野重治の譯しかけた「わが一生のめえるへん」を讀んだことがある。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはアンデルゼンの自敍傳だ。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その原稿は僕がいま預つてあるが、誰かアンデルゼンと中野重治とを愛するものがあつてこの譯を續けてくれるといいと思ふ。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "中野の譯は丁度アンデルゼンが「即興詩人」を書き上げたところで中絶してゐる。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "附記　アンデルゼンの自敍傳の一節を上に引用したが、あれは中野の譯そのままではない。",
              "citation": {
                "source": "（アンデルゼンの「即興詩人」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「グリムやアンデルゼンは北欧民族の「民族的記憶」の名残を惜しんで、それを消えない前に喚び返してそれに新しい生命を吹込んだ人ではないかと想像される」からなのである。",
              "citation": {
                "source": "民族的記憶の名残",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
