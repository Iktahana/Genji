    "definitions": [
      {
        "index": 1,
        "gloss": "dapple-grey (gray) (horse coat colour)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その競走馬は美しい芦毛で、馬場では目立つ存在だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "芦毛の馬は競馬でも人気が高く、ファンが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "芦毛の色合いは年とともに白くなっていく傾向がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "此処で奥千丈山塊から東北に派出された所謂芦毛山脈の突端と、木賊山の東峰から南に派出された尾根の突端とが、まるで袋の口を括ったように南北から迫り合って、危く子酉川の上流を堰き止めている。",
              "citation": {
                "source": "笛吹川の上流（東沢と西沢）",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芦毛山脈に南を限られた子酉川の上流は、殆んど人跡の絶えた地で、記録の徴す可きものがない。",
              "citation": {
                "source": "秩父の奥山",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣かずにひとりでお遊び」　ひらりと乗ると、馬はあしげの逸物、手綱さばきは八条流、みるみるうちに、右門の姿は、深い霧を縫いながらお馬場をまっすぐ向こうへ矢のように遠のきました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "不均衡な不安定な、いやあな気持に自分をおいて、自分に対して、唾をはきかけ、自分に対して、あしげにして、何といういじめ方。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "不均衡な不安定な、いやあな気持に自分をおいて、自分に対して、唾をはきかけ、自分に対して、あしげりして、何といういじめ方。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて士卒三人おそるおそるお庭の片隅にまかり出まして、そのうちの一人が少し進み出て、赤皮縅の鎧、葦毛の馬の武者一騎あざやかに先登かけて居られました、と申し述べ、たちまち義村さまは平伏なされ、忠綱さまは得々としてあたりを見廻しました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤皮縅は忠綱さまの御鎧、またその葦毛の馬は、相州さまから拝領の片淵と号する忠綱さま御自慢の名馬に相違ないのでございますから、もはや争論の余地も無く、将軍家は、興覚め顔に何事もおつしやらず、ついとお座を立つておしまひになりました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかあらぬか、此一箇月許りの間、南天垣の外に蹄の跡が絶えて居つたのが、今日は日の暮近くに突然又目馴れた葦毛の駒が垣根の外に現はれた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "白銀造りの太刀をば、紫のさげ緒の紐に掻結び、毛竝美しき葦毛の駒に練行く後姿前姿、さすがに縣主の品位も高く雄々しくもある、壯士振り、手古奈もそれを憎からず思はない訣にゆかなかつた。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "白い馬、葦毛の馬、黒い馬、跳ね立つ馬、寝てゐる馬、並んで水をのんでゐる馬、泳いでゐる馬、向うの向うを眺めてゐる馬、ふりかへる馬、ひとりぽつちの馬、出てくる馬、消えてゆく馬、何千何百とゐる馬、裾野いつぱいの馬、馬は馬同志群れてゐる。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "船止めの葦毛潭から引かえして本流に出る。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒は、桜田の御厩から借りて来た葦毛だった。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ド、ド、ドウ、　ハイヨウ、　ド、ド、ドウ、　と乱れ太鼓のとどろく間を、三騎、五騎とうしろに引き離して、胸にくっきりと真紅の胴が、浮きつ沈みつしぶきの中をかいくぐっていったかと思うまもなく、平七の葦毛は、ぶるぶると鬣の雫を切り乍ら、一番乗りの歓呼の土手へ、おどるように駈けあがった。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、正勝は葦毛の花房に、平吾は黒馬に、松吉は栗毛にそれぞれ跨った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、たちまちのうちに黒馬を抜き、葦毛の花房を抜いて走った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを見て黒馬が走り葦毛が駆けだし、三頭の馬は土埃を掻き立てながら、毬のようになって新道路を走った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "栗毛と黒馬と葦毛の三頭の馬はＶ字形の三角形になって、その一団の放牧馬を襲った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右へ逃げたその葦毛の……」　正勝はそう叫びながら、首を上げて逃げていこうとする新馬の右手へと、半円を描くようにして走った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葦毛の新馬浪岡は驚いて逃げ回った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い葦毛の花房は、それを見ると、急に一足跳びに移った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三、四日のことだもの」　そして、松吉はややもすれば駆けだそうとする栗毛の手綱を引き締め、正勝は跛を引く葦毛を曳いて、放牧場の斜面を新道路のほうへと下りていった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時越の本庄、安田、長尾隊は甲の両角、内藤隊と甲軍の右翼で接戦し、甲軍の死傷漸く多く、隊長両角豊後守虎定は今はこれまでと桶皮胴の大鎧に火焔頭の兜勇ましく逞しき葦毛に跨り、大身の槍をうちふって阿修羅の如く越兵をなぎたおしたが、槍折れ力つきて討死した。",
              "citation": {
                "source": "川中島合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "沼田城は、信幸の居城で、信幸の妻たる例の本多忠勝の娘が、留守を守っていたが、昌幸が入城せんとすると曰く、既に父子｜仇となりて引き分れ候上は、たとい父にておわし候とも城に入れんこと思いも寄らずと云って、門を閉ざし女房共に武装させて、厩にいた葦毛の馬を、玄関につながした。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "演技場の真中には今、中位の象かと思われる巨大な白｜葦毛の挽馬が、手綱も鞍も何も着けずに出て来て、小さな斑のテリア種の犬と鼻を突き合わせて何かひそひそ話をしている体である。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな風に彼は物思いに耽っていたので、マニーロフ家の召使連の接待にすっかり好い御機嫌になっていた馭者が、右側に繋がれた連銭葦毛の測馬に、なかなか穿った小言を浴びせていることにも、いっこう気がつかなかった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう褒美を与えておいて、彼はまたしても連銭葦毛に向ってしゃべった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "いうまでもなく連銭葦毛などは、何か教訓的な言葉を聴かせて貰いたくて堪らないのだが、いつもはあれほどのお喋りの馭者が、今は手綱をだらりと握ったまま、ただほんの形式的に鞭で背中を撫でてくれるだけである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "連銭葦毛は自分の肥った大きな尻に、気持の悪い鞭づかいを感じた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "栗色や『議員』だけではなく、連銭葦毛まで甚く機嫌が悪かった。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "連銭葦毛の奴は自分の両側へひょっこり姿を現わした新らしい友達を、さも物珍らしげに嗅ぎまわしている。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
