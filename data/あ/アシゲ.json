[
  {
    "uuid": "d32204cc-b229-5da5-b487-9e42dcc9063d",
    "entry": "芦毛",
    "reading": {
      "primary": "あしげ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
