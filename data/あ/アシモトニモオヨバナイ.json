          "literary": [
            {
              "text": "ほかの所は何を見ても東京の足元にも及ばないが温泉丈は立派なものだ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの所は何を見ても東京の足元にも及ばないが温泉だけは立派なものだ。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやはや、私は連中の足元にも及ばない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほかの所はなにを見ても東京の足元にも及ばないが温泉だけは立派なものだ」　この小説が道後の宣伝に使われる所以だが、全体を通じて褒められているのは温泉とマドンナの容姿だけだといってよい。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがすべての中で誰一人としてシルバデール公爵の足元にも及ばない。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            }
          ]
        }
