        "examples": {
          "standard": [
            {
              "text": "彼の卓越したピアノの演奏技術には、何年練習しても足元にも及ばない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "今期の売り上げは、過去最高だった去年の成績の足元にも及ばない結果となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "語学力にかけては、帰国子女である彼女の足元にも及ばないと感じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ほかの所は何を見ても東京の足元にも及ばないが温泉丈は立派なものだ。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの所は何を見ても東京の足元にも及ばないが温泉だけは立派なものだ。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやはや、私は連中の足元にも及ばない。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほかの所はなにを見ても東京の足元にも及ばないが温泉だけは立派なものだ」　この小説が道後の宣伝に使われる所以だが、全体を通じて褒められているのは温泉とマドンナの容姿だけだといってよい。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがすべての中で誰一人としてシルバデール公爵の足元にも及ばない。",
              "citation": {
                "source": "ギルレイ",
                "author": "The Man Called Gilray",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
