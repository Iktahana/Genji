        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　ゆるしが出たのでポチは、ぶるんと一つ大きく胴震いして、弾丸のごとく赤犬のふところに飛びこんだ。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほど、弱さ、かね」とＹ君に、笑はれても、私は抗辯することもできず、かの赤犬の出現以來、もう、めつきり氣が弱くなつて、それからの議論は、ことごとく私の敗北になりました。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一群の鶏も、数匹の白兎も、ダリヤの根方で舌を出している赤犬に至るまで。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは犬殺しが何処かで赤犬の肉を註文されて狙いをつけたのだから屹度殺してやるとそこらで放言して行ったということを知らせる為めであった。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤犬の肉は黴毒の患者に著しい効験があると一般に信ぜられて居るのである。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤犬の肉は佳味いといわれて居る。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐったりとなった憐れな赤犬は熟睡した小児が母の手に衣物を脱がされるように四つの足からそうして背部へと皮がむかれた。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは赤が死んだ日に例の犬殺しが隣の村で赤犬を殺して其飼主と村民の為に夥しくさいなまれて、再び此地に足踏みせぬという誓約のもとに放たれたということを聞いたからである。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして赤犬を撲殺した其棍棒は折れた。",
              "citation": {
                "source": "太十と其犬",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな赤犬が、入口の用水桶の下にうずくまってこちらを見ているのだった。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "潦の傍には、鋼線で拵へた樣な、骨と皮ばかりに痩せて了つた赤犬が一疋坐つてゐた。",
              "citation": {
                "source": "散文詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅人は、怎やら少し暢然した樣な心持で、目の前の、痩せ果てた骨と皮ばかりの赤犬を、憐む樣な氣になつて來た。",
              "citation": {
                "source": "散文詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "餓ゑに餓ゑてゐた赤犬が、恁うして死んで了つた。",
              "citation": {
                "source": "散文詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "了意の『東海道名所記』に「大きなる赤犬かけ出てすきまなく吠えかかる云々、楽阿弥も魂を失うて俄に虎という字を書いて見すれども田舎育ちの犬なりければ読めざりけん、逃ぐる足許へ飛び付く」とある。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、どこからか迷い込んで来たポインター雑種の赤犬を一匹、台所のタタキの上に繋いで、バタを塗ったジレットの古刃を三枚ほど喰わせて、悶死させているのであった。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどこの家の赤犬が通りかかって、この猫を見ると声をかけました。",
              "citation": {
                "source": "どろぼう猫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その背後で赤犬が一匹何かしきりにはしやいでゐるのが見えました。",
              "citation": {
                "source": "晩春の健康",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうしろで小さな赤犬が一匹何か切りにはしやいでゐるのが見えました。",
              "citation": {
                "source": "砂浜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋭い眼付きの赤犬が飛んで来た。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "番小屋の主人が出て来て私達を迎えてくれた頃は、赤犬も頭を撫でさせるほどに成った。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤犬は廻って来て、生徒が投げてやる鳥の骨をシャブった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　文きは棄鉢のやうに言つて、ぼんやり突つ立つてゐたが、何處からか赤犬が來て、綴れ股引の尻のあたりを嗅がうとした。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、乙まは感じの深い眼付きをして、骨の出ばつた赤犬の尻を見送つてゐた。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウールトオの家の犬ね、あの大かい赤犬よ。",
              "citation": {
                "source": "生さぬ児",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちがクロなら、そっちはアカイヌ（放火）……」　やりかえすと、またどこからか、「アカはアカでも、アカ（凶器）を持ったアカデ（強盗）もいる……」「アカが三枚……アカタンときたね」　これはアカイヌだった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
