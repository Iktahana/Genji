        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あおむけに寝かして心臓音を聞いてみた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときに予と相目して、脣辺に微笑を浮かべたる医学士は、両手を組みてややあおむけに椅子に凭れり。",
              "citation": {
                "source": "外科室",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "クねずみは、そこであおむけにねころんで、「ねずみ競争新聞」を手にとってひろげながら、「ヘッ。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」大学士はあおむいて空を見る。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちばん小さな子はもうあおむけになって気絶したようです。",
              "citation": {
                "source": "貝の火",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこで兵隊は、つくえの上にのっているかぎタバコ箱のうしろへ、ごろりとあおむけにひっくりかえりました。",
              "citation": {
                "source": "しっかり者のすずの兵隊",
                "author": "DEN STANDHAFTIGE TINSOLDAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりがあおむいてみると、大きいまっ白なはくちょうが一羽、空の上に舞っていました。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "しじゅう、うわぐつであるきまわっていた、けらいのけらいの小姓なんか、とてもあおむいて顔が見られないくらいでした。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "もみの木のてっぺんにつけてある金紙の星が、うまくてんじょうにしばりつけてなかったら、きっと木は、あおむけにひっくりかえされたことでしょう。",
              "citation": {
                "source": "もみの木",
                "author": "GRANTRAEET",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵隊は鉄砲をとりあげると、あおむけに寝たまま額の真上の空にねらいをつけてズドンと射ち放した。",
              "citation": {
                "source": "兵隊の死",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうするとその矢は、若日子がちょうど下界であおむきに寝ていた胸のまん中を、ぷすりと突き刺して一ぺんで殺してしまいました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお互いに長い剣をずらりと抜き放して、それを海の上にあおむけに突き立てて、そのきっさきの上にあぐらをかきながら、大国主神に談判をしました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "――みごとな一刀切りの前傷うけて、頭をこちらにしながら、道なりに長々とあおむけにのけぞっているのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ひとりはあおむけに、ひとりは伏して、道へ横に倒れながら、この二つが伝六のいった不審な死に方の死骸であるとみえて、いかさまふたりとも血のり一滴見せずに倒れているのでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "縁側からさかさになって半身をのめらしながら、あおむけざまに打ち倒れているのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなふうにあおむけにのけぞってね、のどから血あぶくを吹いて長くなっていたんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "こもの下には捜しまわったその小娘の死骸が、見るも凄惨な形相をして、あおむけになりながら横たわっていたからです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "闇男",
                "note": "青空文庫"
              }
            },
            {
              "text": "三造は水の上にあおむけに寐て浮んだ。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つタァンをすると、もとの所へかえって来て、再びあおむけになって浮んだ。",
              "citation": {
                "source": "プウルの傍で",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "重いガラス戸をあけて中へはいりますと、おじさんがひとり、たたみのしいてあるところに、あおむけにひっくり返って、新聞を読んでいました。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もたれだけが、うしろにのびて、腰かけている人があおむけにねるようになっただけでした。",
              "citation": {
                "source": "いぼ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお都合のよいことに、おじさんはくたびれていたとみえ、ふたりに自転車をまかせたきり、上がりがまちにあおむけにねころんで眼をとじてしまったのである。",
              "citation": {
                "source": "空気ポンプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ひざをびんぼうゆるぎさせながら、あおむけに空を見ている。",
              "citation": {
                "source": "久助君の話",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ころころと兵太郎君の方へころがり近づいていって、草の先を、あおむいている兵太郎君の耳の中へ入れようとした。",
              "citation": {
                "source": "久助君の話",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "半七はその頤に手をかけて、無理にあおむかせた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "妖狐伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の下まで来てあおむいて、三四郎の顔を見上げて、「おい、おるか」と言う。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時にいくらか話に飽きが来たらしく、あおむいて小さな欠伸を出しかけた。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "下唇をギリギリと噛んだまま見る見るうちに青褪めて行くうちに、白い眼をすこしばかり見開いたと思うと、ガックリとあおむいた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下にゴンクール氏は黄蝋色に変色した唇を開いたまま、あおむいている。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "又｜甘藍や何かには、青むしもたかる。",
              "citation": {
                "source": "茨海小学校",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
