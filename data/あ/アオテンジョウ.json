        "examples": {
          "standard": [
            {
              "text": "記録的な不漁の影響で、サンマの価格が青天井に跳ね上がっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "人気アーティストのチケット代がオークションで青天井になり、手が出せない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "仮想通貨の相場が青天井の勢いで上昇し、投資家たちの間に衝撃が走った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
