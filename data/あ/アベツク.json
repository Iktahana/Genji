        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "観光客ちらほら、むつまじいアベツクもゐた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど見給へ、アベツク、醉つぱらひ、高級車、あらゆる逸樂と贅美な流れをまへに、かれは少しも、さもし氣でない。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、愛人らしい男女一對の仲よきチンドン・アベツクは、もつとも、心おきなく微笑できる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "片方は炭の買出しの女の人達、それから片方は蝶々と背の高いアベツク達、その中にお茶の先生が入つてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "神とのアベツク　赤ンぼが生れる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉と神とは、アベツクなものだと聖書は言ひきつてゐる。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
