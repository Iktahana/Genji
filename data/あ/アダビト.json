    "definitions": [
      {
        "index": 1,
        "gloss": "capricious person",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎日、徒人について考えています。",
              "source": "幻辞"
            },
            {
              "text": "我が社の徒人戦略は重要です。",
              "source": "幻辞"
            },
            {
              "text": "徒人の原理は複雑である。",
              "source": "幻辞"
            },
            {
              "text": "徒人という言葉が頭から離れない。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは徒人について学んでいる。",
              "source": "幻辞"
            },
            {
              "text": "徒人の治療方法は多様である。",
              "source": "幻辞"
            },
            {
              "text": "徒人に関する法律が改正された。",
              "source": "幻辞"
            },
            {
              "text": "選手たちは徒人を目指している。",
              "source": "幻辞"
            },
            {
              "text": "自然界での徒人は見事である。",
              "source": "幻辞"
            },
            {
              "text": "歴史上、徒人は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "徒人は日本文化の一部である。",
              "source": "幻辞"
            },
            {
              "text": "旅行中に様々な徒人を見つけた。",
              "source": "幻辞"
            },
            {
              "text": "「徒人」という概念について深く考察する必要があります。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "成吉思汗　それから、僕が忘れようとしても忘れることのできないのは、父の也速該巴阿禿児が泰赤宇徒人に攻められた時、あの危急存亡の場合に僕を助けてくれたのは、君だった。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "あだは、あだ人あだ花などのあだなるべし。",
              "citation": {
                "source": "雲のいろ／＼",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "沙門『不淨』『おもひ』は經つや荊棘の路を、今し乾ける土に埋れてめしひぬれど、ただ聞く、凶の沼水缺けかたぶき、をぐらきまむしの谿間たぎちゆきてひしめき溢るるさやぎ、――將また聞く、あだ人きほへる夜の森かげより篝の火枝啄み滅し去ると舞ひ來し天の眞鳥の悲しきこゑ。",
              "citation": {
                "source": "春鳥集",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊やまこえてあだ人｜來る其眼くろし其髮くろしくろからむ其子らの眼もくろからむ其かみもまた。",
              "citation": {
                "source": "「黒瞳」より",
                "author": "ペドロ・アントニオ・デ・アラルコン　Pedro Antonio de Alarcon",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
