        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "縁側で冷たい麦茶を飲みながら、「すっかり秋涼しとなったね」と祖母が目を細めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "厳しい残暑がようやく落ち着き、朝晩の風に秋涼しを感じる季節になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "秋涼しの夜風が心地よく、少し遠回りをして虫の音を聴きながら帰路についた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "秋涼し天の香山夜あくれば耳無かけて白き霧立つ東山西大谷を過ぎて。",
              "citation": {
                "source": "禮嚴法師歌集",
                "author": "與謝野禮嚴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
