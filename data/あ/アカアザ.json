[
  {
    "uuid": "201d75fc-61b1-5420-91d8-b20b4fb59c49",
    "entry": "赤あざ",
    "reading": {
      "primary": "あかあざ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "red birthmark (esp. a hemangioma)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子どもが生まれた時、背中に赤あざがあると医者に言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "頬の赤あざは思春期になると薄くなることが多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "レーザー治療で大きな赤あざが目立たなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "中でも屈竟な、赤あざのある侍が一人、衆に先んじてかたわらから、無二無三に切ってかかったのである。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　赤あざの侍は、その後ろからまた、のび上がって、血に染んだ太刀をふりかざした。",
              "citation": {
                "source": "偸盗",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その俺は袋叩きにされたための赤あざだらけの、顔までみっともない俺だった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには不規則な円形の、大手術の跡かと見える、むごたらしい赤あざがあるのだ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
