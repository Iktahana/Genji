          "literary": [
            {
              "text": "其は秋彼岸の中日、秋分の夕方であつた。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "四天王寺の塔は極楽浄土の東門に向っていると信ぜられ、春秋彼岸の中日が一等適切に西方浄土と相向う日と考えたものである。",
              "citation": {
                "source": "雛祭りとお彼岸",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等の事から年中時令の中でわたしは冬至の節をば正月や七夕や中秋彼岸なぞよりも遥に忘れがたく思う事が多い。",
              "citation": {
                "source": "写況雑記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
