        "examples": {
          "standard": [
            {
              "text": "競馬で大穴を当てて手に入れた大金だったが、一晩の豪遊で使い果たし、まさに悪銭身に付かずだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "詐欺まがいの商法で荒稼ぎしていた男が破産したニュースを見て、悪銭身に付かずとはこのことだと思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「拾ったお金で買った宝くじなんて当たらないよ、悪銭身に付かずって言うだろう」と友人に笑われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "けれども藩士の禄券と云うものは悪銭身に付かずと云うような訳けで、終にはなくして仕舞って何もありはしない。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
