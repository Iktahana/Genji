        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スルト、ツボミタチノ　アタマノ　ウエデ　ダレカガ、「ヒバリデス、ヨ」ト　フトイ　コヱデ　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　トキ　花タチノ　アタマノ　上デ、「オヤ　マア　キレイニ　サキマシタネ」ト　イフ　コヱガ　シマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ホソイ　メヲ、アタマノ　ウエニ　ソーツト　ダシマシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボウヤノ　アタマノ　トコロニ　大キナ　モノガ　アルデセウ？",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタマノウエデ　オホキナ　フトンガ　マドノトコロデ、パタパタト　アバレテヰマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノマヒゴノヤウスノヘンテコリンナコトトイツタラ※　水ノ中ニムヤミト長クツカツテヰタトミヘテ、アタマノ毛ハ一本、一本、サカダチ、カホモカラダモマツサヲ、クチビルハムラサキ色。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アツイオ日サマノ光デ、マヒゴノカラダモアタマモ、アタマノケモヤツトフダンノ通リ、人間ノ子ドモラシクイキイキトシテキマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
