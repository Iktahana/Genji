        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "甘子を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは甘子について学習した。",
              "source": "幻辞"
            },
            {
              "text": "甘子の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は甘子の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では甘子が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "甘子という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に甘子という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では甘子についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "甘子を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると甘子は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "甘子について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では甘子が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に甘子は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により甘子の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "甘子は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に甘子は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "………油でいためた加茂川の甘子を始め、西京の特産らしい名の知れぬ川魚や野菜の料理が此処の自慢の器物に入れられて、後から／＼と数知れず運ばれる。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なにもおへんえ」「甘子はどうした？",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さ、一つ差上げましょう、………」「そうどすか、そんなら戴きます」「甘子がなかなか結構です。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "向は鯛のあらい、汁は鯉こく、椀盛は若※と蓮根、焼物は藻魚の空揚げ、八寸はあまご、箸洗い、という献立だった。",
              "citation": {
                "source": "ユモレスク",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "西田幾多郎先生をお誘いして貴船へ遠足してアマゴでも食べようということになった。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "天野君が和辻君にその由を伝えると和辻君はアナゴではなくてアマゴであることを説明した。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "西田先生もアマゴなら食ってもいいといわれて貴船行の計画がめでたく成立った。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはアマノがアマゴとアナゴを間違えた話である。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東育ちでカントの『純粋理性批判』の訳者である天野君はアナゴは知っていたがアマゴを知らなかったのである。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "この二つの場合で、クキがクッキーでグキットしたとはいいやすいが、アマノがアマゴとアナゴを間違えたといおうとするとうまく口が廻らないで多少の努力を要する。",
              "citation": {
                "source": "偶然の産んだ駄洒落",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "岐阜県から、滋賀県、京都府へかけてはアメノウオ、またはアマゴなどと呼び、中国地方ではヒラメ、九州ではエノハと名づけている。",
              "citation": {
                "source": "雪代山女魚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "会津の飯豊山麓では、啼声によってマメコロバシという名もあるが、普通にはこれをアマゴイドリと呼び、この鳥が啼けば雨が降るからというのは（『耶麻郡誌』）、実際は降りそうになると啼くことを意味するのであろう。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
