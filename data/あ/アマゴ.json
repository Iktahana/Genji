    "definitions": [
      {
        "index": 1,
        "gloss": "land-locked variety of red-spotted masu trout (Oncorhynchus masou ishikawae)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
