          "literary": [
            {
              "text": "ヤジロー（もしくはアンジローとも云われているが）は鹿児島の産である。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう情勢を眼中に置いて考えると、シャビエルに帰依して有名となったヤジロー（或はアンジロー）のような人物が出たことは、少しも奇異な現象ではないのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャビエルに日本伝道の意図を起させたのは鹿児島人ヤジロー（或はアンジロー）である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
