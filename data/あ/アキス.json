  {
    "uuid": "8ea7ed62-1e63-5cb3-a236-1589312c40a3",
    "entry": "アキス",
    "reading": {
      "primary": "あきす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
