    "entry": "足元から鳥が立つ",
    "reading": {
      "primary": "あしもとからとりがたつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現",
        "Godan verb with 'tsu' ending"
