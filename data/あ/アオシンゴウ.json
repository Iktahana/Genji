        "examples": {
          "standard": [
            {
              "text": "我々の提案がようやく社長に認められ、プロジェクトに青信号が灯った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "長年の研究開発を経て、新薬の製造販売に青信号が出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "関係各所との調整が済み、計画実行への青信号がともった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
