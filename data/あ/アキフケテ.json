        "examples": {
          "standard": [
            {
              "text": "秋更けて、虫の音も次第に弱々しくなり、冬の足音が聞こえてくるようだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "秋更けていく京都の街並みは、どこか寂しげで趣がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "山間の温泉宿で、秋更けていく静寂な夜の空気を心ゆくまで堪能した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "一坪の庭も無い家へ急に移つた時に一切の菊を失つて終つてから、今はもう自分は一株の甘菊をも有たぬが、秋更けて酒うまき時、今はたゞ料理菊でもない抛つたらかし咲かせの白き小菊の一二輪を咬んで一盞を呷ると、苦い、苦い、それでも清香歯牙に浸み腸胃に透つて、味外の味に淡い悦びを覚える。",
              "citation": {
                "source": "菊　食物としての",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿蘇の山里秋更けて　　　　眺め淋しき冬まぐれ　　　　…………　お千代ちゃんは内気らしく、受け口を少しあいて、低い声で歌った。",
              "citation": {
                "source": "毛の指環",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩秋の草野の秋更けて、露霜に打たるものの哀れさよ。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "君恩酬ふ身の一死今更我を惜まねど行末いかに漢の運、過ぎしを忍び後しのぶ無限の思無限の情、南成都の空いづこ玉壘今は秋更けて錦江の水痩せぬべく、鐵馬あらしに噺きて劔關の雲睡ぶるべく。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            }
          ]
        }
