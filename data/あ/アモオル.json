          "literary": [
            {
              "text": "醜き龍に騎りたる、美しきアモオルの神を据ゑたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その戀の神なるアモオルをこそ、むかしおん身は見つるならめ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかにアモオルの神は、低能な子供たちに、純粋な形態の具象的な像を見せてやる数学者と張り合う。",
              "citation": {
                "source": "ヴェニスに死す",
                "author": "DER TOD IN VENEDIG",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼がいま腕をあげて、かわいい、明色の、柔かく縮れた、細長いイギリス風の頭の下に、細い両掌をあてがったなり、そこに横になっているところは、なんだか小さいやせたアモオルのような観があった。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
