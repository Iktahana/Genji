        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "然るに内行を潔清に維持して俯仰慚ずる所なからんとするは、気力乏しき人にとりて随分一難事とも称すべきものなるが故に、西洋の男女独り木石にあらずまた独り強者にあらず、俗にいう穴探しの筆法を以てその社会の陰処を摘発するにおいては、千百の醜行醜聞、枚挙に遑あらず。",
              "citation": {
                "source": "日本男子論",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャバレーの主人ポントスも、本国からそのパチノの墓穴探しに来ているのだ。",
              "citation": {
                "source": "恐怖の口笛",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "皮肉や悪罵や、無益な穴探しや、相手を理解せんとする意志のない空言にみち、はなはだしきはもはや論点の所在に対する感覚を全然欠いて、いかにして巧みに相手を辱しめんかを苦心せるごとき論争をみる。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『これか――』といつて、幸徳は気の毒さうに躊躇したが、『牢屋で一つ、ヤソの穴探しをするんだ』　かういつて、笑つた。",
              "citation": {
                "source": "幸徳秋水と僕",
                "author": "――反逆児の悩みを語る――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「牢屋で耶蘇の穴探しをしたから、今度は耶蘇の宝探しをして呉れ」と書き添へて。",
              "citation": {
                "source": "幸徳秋水と僕",
                "author": "――反逆児の悩みを語る――",
                "note": "青空文庫"
              }
            }
          ]
        }
