        "examples": {
          "standard": [
            {
              "text": "祖母が戦時中に書き留めた日記は、値千金の史料として地域の文書館に寄贈された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "長年の研究の末にたどり着いたその発見は、チームにとって値千金の成果だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼が一言アドバイスをくれたおかげで問題が解決したのだから、まさに値千金の助言だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "さまでに時刻｜後れては、枕に就くと鶏うたわむ、一刻の価値千金と、ひたすら式を急ぐになん。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
