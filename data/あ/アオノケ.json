        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "第一に飛び込んだる髯将軍、オットセイと称して浴槽の中へ仰のけのまま跳り込み、頭から、足からザブンザブン飛び込むこと十数回、危うく浴構内の土左衛門さんとならんとせしところを三人して引挙げ、ようやく事なきを得た。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "あ、これで点けるわ」　蚊やり線香の火で、はすっぱに吸いはじめたが、いきなり仰のけになると、じっと天井を見つめていた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "木崎はごろりと仰のけに転って、天井をながめた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいわ、あたし風邪引いてやるから」　ごろりと仰のけに倒れて、天井を見ていると、急に襖がひらいた。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云う銃声ともろとも仰のけざまにぶッ倒れた時には、実にすさまじい勢で打ち倒れたのですが、私たちは鳥渡、本気にしませんでしたよ。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "準之助氏は、本を読んでいる新子と、仰のけに寝ながら、新子の読む声に聞き惚れて、美しい黒目を一章一章に、うごかしている祥子とを、何か楽しい観物のようにしばらく眺めていた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと自分が仰のけに臥したる影の大きくなりて襖の上に写りたるを見るに、両膝を立てたる上に毛布を著せたれば、その影はのつぺりしたる山の如く、膝の処にてどんと絶壁をなして急に落ちたり。",
              "citation": {
                "source": "明治卅三年十月十五日記事",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "可哀そうに、彼女はぐったりと仰のけに首を垂れ、その碧眼は、眼瞼をあげられたまま、きょとんと私の方を見ています。",
              "citation": {
                "source": "麻酔剤",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子の背へ仰のけに頭を凭たせ、肱掛けに手をおいたまま、何の感動もないような風で耳を傾けていたが、やがて女が静まるのを待って問いかけた。",
              "citation": {
                "source": "暗中の接吻",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "召使が駆けつけたときは、二人は仰のけに倒れて縡切れていた。",
              "citation": {
                "source": "誤診",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "だめだよ」「おい、おい、車掌忘れてっちゃ困るよ」　そして、ハハハハとカンカン帽を仰のけて笑った。",
              "citation": {
                "source": "電車の見えない電車通り",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすこは駄目だ」　志野は、二十三にしては小柄で若々しく白い喉をふり仰のけるようにしてころころと笑った。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう夜は十二時もとうに過ぎているので、ことに東山の畔のこととて人の足音もふっつりと絶えていたが、蒼白く靄の立ちこめた空には、ちょうど十六、七日ばかりの月が明るく照らして、頭を仰のけて眺めると、そのまわりに暖かそうな月暈が銀を燻したように霞んで見えている。",
              "citation": {
                "source": "黒髪",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽気は申し分なく、昼過ぎの日が、ほかほか窓にさし込んで来るのが、何んとも云えない気持ちで、今まで山の中で張りつめた気がゆるんだせいもあったろうが、初めのうちは窓に倚りかかって、こくりこくりやってたが、たまらなくなって本式に仰のけに寝てしまった。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "杖を草の上に抛りだして、仰のけになって花野の上に寝ころんだ。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからだんだんやって、師匠と忠次郎に、政左衛門が体当りをされて、後ろの戸へ突き当てられて、雨戸が外れて仰のけに倒れたが、起きるところを続けて腹を打たれた。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "六疊は文字通り血の海で、番頭の伊八は仰のけ樣に倒れて居りますが、死骸の位置から見ると、八千兩の金と睨めつこをして居るところへ、後ろから近寄つた曲者が、鋭利な匕首か何んかで、その喉笛を掻き切つたのでせう。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八千兩異変",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっかから武者修業がやって来て、これこれの大先生がござる筈だってよ、わからずにゃいねえだ、修業者はあとからあとから来るだし、米味噌は村からはこぶだしよ、そのうち黒門へ客にござるようになったで、すっかり詳しいことがわかっただに」　杢助はふんといって、きせるを放りだし、大きな欠伸をして仰のけになった。",
              "citation": {
                "source": "似而非物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "）「ここにかうやつてゐると氣がしづまるよ、」　さう言つて汚ない疊の上に仰のけにころげてゐた芥川は「ちよつとでいいから觸らせておくれよ、」「たのむから僕にその足を撫でさせておくれよ、」と體をのばして僕の切斷されたはうの足に手をかけ、「君の暮しは羨ましいなあ、」とため息をしてゐた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　芥川はまた仰のけになつてひとりごとのやうに言つてゐた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "温度はすこしぬるめだが、そのままじっと、仰のけに身を浸しているうちに、全身の毛孔の一つ一つから、しずかにしかも鮮かに、湯のしみとおって来るのが感じられて、こころよい。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もろくも仰のけに湯の中に落ちて、そのまま漂い流れてゆく……よく見れば、大きな黄緑色の複眼の燦として輝く、美しい虫だ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その他の足袋の底と着物の裾に、すこしばかり泥が附いているだけで、轢死体としては珍らしく無疵な肉体が、草の中にあおのけに寝て、左手はまだシッカリと前裾を掴んでいた。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その新しいパンの固まりを、お臍の上に乗っけたまま、ソーッとあおのけに引っくり返った。",
              "citation": {
                "source": "ココナットの実",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "両手の指をシッカリと組み合わせたまま、あおのけに倒おれると、膝頭をジリジリと引き縮めた。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "田圃側の草の上には、土だらけの足を投出して、あおのけさまに寝ている働き労れたらしい男があった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物の中には突き飛ばされて、あおのけさまに倒れた大の男もあった。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｗ君はあまり詰込み過ぎたかして、毛布を冠ったまま暫時あおのけに倒れていた。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そこいらには、草の上にあおのけさまに昼寝して大の字なりに投げ出している村の男の足がある。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "あおのけに畳の上に倒れている夫の胸は浪打つように見えた。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
