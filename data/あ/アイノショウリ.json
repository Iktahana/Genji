        "examples": {
          "standard": [
            {
              "text": "カラヴァッジョ作の『愛の勝利』は、キューピッドが全てを征服する様を劇的に描いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "美術の教科書で見た『愛の勝利』の力強い表現に、強く惹きつけられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は『愛の勝利』に描かれた様々な寓意を解き明かそうと、画集を隅々まで眺めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "やはり人性の善と愛の勝利というようなことが考えられます。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし恒川は恋愛の勝利者として得意の色を包み切れないものがあつた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛の勝利、狂気　二人は愛に勝った。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十七歳の罪のない老女の唖然たる目つきであり、愛の勝利をながめてる空しい生命だった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
