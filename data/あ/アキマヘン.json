        "examples": {
          "standard": [
            {
              "text": "「そんなええ加減な仕事してたら、絶対にあきまへんで」と先輩に厳しく叱られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「この機械、ボタンを押しても全然動きまへんわ」「そらあきまへんな、すぐに修理呼びまっさ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "「あきまへん、いくら計算しても帳簿の数字が合いませんわ」と経理担当者が頭を抱えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
