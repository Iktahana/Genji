    "definitions": [
      {
        "index": 1,
        "gloss": "multiple people holding the same item with their chopsticks",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "葬儀の作法を連想させるため、食事中の相挟みは避けるべきだとされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "大皿の唐揚げを取ろうとしたら、偶然弟の箸と相挟みになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "鍋の具材で相挟みになりそうだったので、慌てて自分の箸を引っ込めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "仰せの通り『安政絶句』中に相洩し候にて微しく野心を相挟み、陶奴推刃之気味無きにしもあらず。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛮民互いに廃殺の隠罪あれば、戦後心に疑いを相挟み、私闘を醸す怖れあること三つ。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "passing something from chopstick to chopstick",
        "register": "standard",
        "nuance": null,
