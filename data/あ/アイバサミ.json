        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "食事中に料理を箸から箸へと渡す相挟みは、縁起が悪いからやめなさいと祖母に叱られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "つまみ上げたお肉を相挟みで渡されそうになり、慌てて自分のお皿を差し出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "焼き肉屋で友達が焼けた肉を相挟みでくれようとしたが、行儀が悪いと注意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
