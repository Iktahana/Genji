        "examples": {
          "standard": [
            {
              "text": "天体望遠鏡の倍率を変えるには、アイピースを交換する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "顕微鏡を覗き込み、アイピースを通してミクロの世界を観察する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼はカメラのファインダーに目を当て、アイピース越しに被写体を捉えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "ムーヴィ・カメラのファインダー・アイピースを目のなかに埋めこむようにして、僕は絶体絶命の悲鳴をあげた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
