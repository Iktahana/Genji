    "definitions": [
      {
        "index": 1,
        "gloss": "shelf for offerings (of water, flowers, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎朝、母は閼伽棚に供える水を新しく汲み、仏様への祈りを欠かさない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "寺院の本堂の脇にある閼伽棚には、色鮮やかな季節の花が生けられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い屋敷の仏間には、重厚な造りの閼伽棚があり、お香の香りが微かに漂っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "美しい侍童などがたくさん庭へ出て来て仏の閼伽棚に水を盛ったり花を供えたりしているのもよく見えた。",
              "citation": {
                "source": "源氏物語",
                "author": "若紫",
                "note": "青空文庫"
              }
            },
            {
              "text": "閼伽棚などをそのほうへお作らせになったのが優美に見える。",
              "citation": {
                "source": "源氏物語",
                "author": "鈴虫",
                "note": "青空文庫"
              }
            },
            {
              "text": "閼伽棚に置かれた花に夕日が照って美しいのを御覧になって、「春の好きだった人の亡くなってからは、庭の花も情けなくばかり見えるのですが、こうした仏にお供えしてある花には好意が持たれますよ」　とお言いになった院は、また、「対の前の山吹はほかでは見られない山吹ですよ、花の房などがずいぶん大きいのですよ。",
              "citation": {
                "source": "源氏物語",
                "author": "まぼろし",
                "note": "青空文庫"
              }
            },
            {
              "text": "西の端には物を置くのに便利な様に閼伽棚を造ったりして色々と住居らしい設備をして行った。",
              "citation": {
                "source": "現代語訳　方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま日野山の奧にあとをかくして後、南にかりの日がくしをさし出して、竹のすのこを敷き、その西に閼伽棚を作り、うちには西の垣に添へて、阿彌陀の畫像を安置したてまつりて、落日をうけて、眉間のひかりとす。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "棚は、天湯河板挙・棚橋・閼伽棚（簀子から、かけ出したもの）の棚で、物からかけ出した作りである。",
              "citation": {
                "source": "たなばたと盆祭りと",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖母夕暮の祈祷がすむと、祖母のあける窓から、閼伽棚の器をとつて、私はいつぱいの水をまく。",
              "citation": {
                "source": "測量船拾遺",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
