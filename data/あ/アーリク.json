        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "少女等がかざしの玉の赤玉に似たるいちごを採りつゝありく奧山の道のへに咲く草花をうらめづらしみ見せまくもとなおぼつかなき歌なり。",
              "citation": {
                "source": "滝見の旅",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありくにつれて汗少しいでぬ。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "指す方もあらでありくともなく歩をうつすに、頭ふらふらと足の重たくて行悩む、前に行くも、後ろに帰るも皆｜見知越のものなれど、誰も取りあはむとはせで往きつ来りつす。",
              "citation": {
                "source": "竜潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "花盛りで一つも実のない、ない実の、そのあって可い実の数ほど、大きな蝦蟇がのそのそと這いありく。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "床几に休ひ打眺むれば、客幾組、高帽の天窓、羽織の肩、紫の袖、紅の裙、薄に見え、萩に隱れ、刈萱に搦み、葛に絡ひ、芙蓉にそよぎ、靡き亂れ、花を出づる人、花に入る人、花をめぐる人、皆此花より生れ出でて、立去りあへず、舞ひありく、人の蝶とも謂ひつべう。",
              "citation": {
                "source": "彌次行",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "振のむずかしき、舞の難き、祭礼に異様なる扮装して大路を練りありくそれとは同じからず。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の山奥から時々姿を現わして奇妙な物を売りありく老人がいた。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい炭取りくらいの大きさの竹かごを棒切れの先に引っかけたのを肩にかついで、跛を引き歩きながら「丸葉柳は、山オコゼは」と、少し舌のもつれるような低音で尻下がりのアクセントで呼びありくのであった。",
              "citation": {
                "source": "物売りの声",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "指す方もあらでありくともなく歩をうつすに、頭ふらふらと足の重たくて行悩む、前に行くも、後ろに帰るも皆｜見知越のものなれど、誰も取りあわむとはせで往きつ来りつす。",
              "citation": {
                "source": "龍潭譚",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "世中をめぐりありく惡魔は、邪宗の人の所詮おのが手に落つべきを知りたるゆゑ、強ひてこれを誘はむとすることなし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "われは走り出でゝ遊びありくに、媼は戒めて遠く行かしめず、又テヱエルの河近く寄らしめず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "事果てて後家に歸りしが、身は唯だ夢中に起ちてさまよひありく、怪しき病ある人の如くにして、その夜枕に就きての夢には始終アヌンチヤタが我歌を喜べるさまをのみ見き。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "白鷺白鷺は、その一羽、睡蓮の花を食み、水を食み、かうかうとありくなり。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼少の恩愛忘れがたく、暇ある毎にたづねありく。",
              "citation": {
                "source": "白南風",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "反歌春もやや潟の水曲を行きありく白鷺の眼の黒くするどさ童子柳河涼しさは水豊かなる柳かげ葦笛吹きて我等行けりし夏の照り葦辺行く子は魚籠もちて何か真顔の我にかも似る今ぞ見む郷国は童がどの顔も我によく似る太郎によく似る　（妻に）町内菎蒻屋桶に藷磨り、飴形屋掛けて飴練る、蚊ばしらや春より立たむ。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "松もよい、松風はむろんよろしい、さく／＼踏みありく砂もよい、自然は何でもいつでもよろしいな。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時まことの舞踏はじまりて、群客たちこめたる中央の狭きところを、いと巧にめぐりありくを見れば、おほくは少年士官の宮女たちをあひ手にしたるなり。",
              "citation": {
                "source": "文づかひ",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "このときまことの舞踏はじまりて、群客たちこめたる中央の狭きところを、いと巧みにめぐりありくを見れば、おおくは少年士官の宮女たちをあい手にしたるなり。",
              "citation": {
                "source": "文づかい",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "されば僻地盗難繁かった処々は、庚申に祈りて盗品を求め、盗もまた気味悪くなってこれを返却した例多く、庚申講を組んで順次｜青面金剛と三猿の絵像を祭りありく風盛んなり。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十九あはれ、人妻、ふたつなきフランチエスカの物語かたらふひまもみどり兒は聲を立てつつ、かたはらを匍ひもてありく、君はまた、たださりげなし。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "金いろの陽は匍ひありく弟の胸掛にてりかへし、そが兄の銀の小笛にてりかへし、護謨人形の鼻の尖りに彈ねかへる。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はてには笠うちき、足ひきつゝみ、よろしき姿したるもの、ひたすら家ごとに乞ひありく。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくわびしれたるものどもありくかと見れば則ち斃れふしぬ。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしつれづれなる時は、これを友としてあそびありく。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしありくべきことあれば、みづから歩む。",
              "citation": {
                "source": "方丈記",
                "author": "鴨長明",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京にては一月二日の夜に宝船を売りありくこそ心得ね。",
              "citation": {
                "source": "墨汁一滴",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
