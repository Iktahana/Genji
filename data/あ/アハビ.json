        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "海女は、岩の間を潜り、海草の茂みを分け、アハビ貝を探してゐる。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハビを二つ腰にさげた網に入れる。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "両端の総の根じめに、ご承知でせうが、これは、アハビ貝からとれたマダマです。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハビ玉、アコヤ玉は、このへんがいちばんだと聞いてゐるから……」「なににするんだい？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハビ玉が、そんなに珍重されるのか？",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハビ玉とも言ふのです。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほど、こゝにアハビ玉を使つてあるところまで、そつくりおなじです。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ぢやアハビ玉、今は真珠ともいふが、唐人はえらく欲しがるもんださうだ。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は、別棟の母屋の戸口に立つてゐる中年の女に、アハビを採つてきた桶の中をみせ、そのまゝ、奥へはいる。",
              "citation": {
                "source": "虹色の幻想（シナリオ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
