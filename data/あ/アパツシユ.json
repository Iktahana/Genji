          "literary": [
            {
              "text": "――ミツキイは、何時もの僕達の単なる酒興の戯れかとばかり思つて、相変らずのアパツシユ気どりの身構へで頬笑んでゐた。",
              "citation": {
                "source": "山男と男装の美女",
                "author": "ミツキイのジヨンニイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "御朱印の傅次郎といふのは、――御朱印船にも乘つたことがあるといふのを、唯一の自慢の種にしてゐる船頭上がりのやくざ者で、これが小便組の女王お扇の後ろで絲を引いてゐるアパツシユだつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "小便組貞女",
                "note": "青空文庫"
              }
            }
          ]
        }
