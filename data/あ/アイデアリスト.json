        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "或る意味に於て、すべての人間はアイデアリストである。",
              "citation": {
                "source": "夜長ノート",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "形而上学にてアイデアリスト（唯心論者）といふものは、文芸上にてアイデアリスト（理想家）といふところの者とは全く別物なり。",
              "citation": {
                "source": "内部生命論",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロマンチック・アイデアリストとしての馬琴の一端は、之を以て窺ひ知るを得んか。",
              "citation": {
                "source": "処女の純潔を論ず",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　バーナード・ショウはそのイブセン論の中で、アイディアリストとリアリストとの區別を説いてゐる。",
              "citation": {
                "source": "生みの力",
                "author": "片上伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "この意味に於いて彼はリアリストであると共に、また深刻なアイディアリストである。",
              "citation": {
                "source": "生みの力",
                "author": "片上伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來の可能を信じ且つ望むといふ意味に於いてのアイディアリストである。",
              "citation": {
                "source": "生みの力",
                "author": "片上伸",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
