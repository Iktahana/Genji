        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アナタノ小説、友人ヨリ雑誌借リテ読ミマシタガ、アレハ、ツマリ、一言モッテ覆エバ、ドンナコトニナルカ、ト詰問サレルコト再三、ソノタビゴトニ悲シク、一言デ言エルコトナラ、一言デ言イマス、アレハアレダケノモノデ、ホカニ言イ様ゴザイマセヌ、以後、ボクノ文章読マナイデ下サイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから四、五日経つて、相州さまが、へんな薄笑ひを浮べて御前に伺候し、「ただいま人から承りましたが、囚人胤長の屋敷を、」と言ひかけたら、すぐに、アレハ和田ニ　とうつむいたまま低くおつしやいました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカ　ニ、アレハ　ドコカ　ト、タズネマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレハ　ウミ　ト　イウ　ミズ　ノ　セカイダ　ト、タカ　ハ　コタエマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "お勢は黄八丈の一ツ小袖に藍鼠金入繻珍の丸帯、勿論下にはお定りの緋縮緬の等身襦袢、此奴も金糸で縫の入ッた水浅黄縮緬の半襟をかけた奴で、帯上はアレハ時色縮緬、統括めて云えばまず上品なこしらえ。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレハ大方｜馬見所の家根で、土手に隠れて形は見えないが車馬の声が轆々として聞える。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "――バカヤロウ、アレハ、カンゴクジャナイカ！",
              "citation": {
                "source": "可哀相な姉",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「フーン、ツマンナイネ、ア、シロイ　ハツパガ　トンデ　ユク」「アレハ　ハツパヂヤ　ナイコト、テフテフヨ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストノ　ウエニ　トマツテ　ヰタ　スズメガ、「アレハ　ワタシノ　カゲダワ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレハ　コノ　ワシノ　カゲサ」ト　ガイトウガ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　トクイサウニ、「アレハ　ワタシノ　カゲダ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スルト　ポチハ　ボンヤリシタ　メヲアケテ「ナアニ、アレハ　オホソウヂダヨ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレハオトコダツタンダ　コトシデ19　　（母の溜息）　三人は各々見識らぬ兄弟の幻の面貌を見た。",
              "citation": {
                "source": "肉親の章",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレハ明治三十年前後、十三四ノ頃ダッタト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ家ガ本所割下水ニアッタ時代デ、両国廣小路ノ、アレハ何ト云ッタッケナ、何トカ云ウ有名ナ絵草紙屋ノ店頭ニ助六ト意休ト揚巻ノ三枚続キノ錦絵ガ掲ゲテアッタノヲ今モ忘レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アレハ是非素脚ニ白粉ヲ塗ッテ貰イタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エヽ、何カノ時ノ用心ニアレハ取ットク積リナノ」「何云ッテルンダイ、オ前ノ亭主ハマダ四十台ジャナイカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少クトモ今日一般ニ行ワレテイル長方形ノノッペラボウノ石ノ表面ニ戒名又ハ俗名ヲ記シ、ソノ下ニ台石ヲ据エテ、ソノ前ニ線香立テノ穴ト手向ケノ水ヲ供エル穴トヲ穿ッテアルアノ形式、アレハイカニモ平凡デ、俗ッポクッテ、何事ニモ旋毛曲リノ予ニハ気ニ入ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤハリアレハ書カナイ方ガヨカッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、アレハスイセイデハナイ。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
