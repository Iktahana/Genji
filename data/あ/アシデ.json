        "examples": {
          "standard": [
            {
              "text": "彼女の葦手による手紙は、文字が水辺の草花のように流れて美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "書道教室で葦手の書き方を習い、その独特の筆運びに魅了された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歌集の序文は葦手で書かれており、詩的な内容と視覚的な美しさが重なり合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
