        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "真夏の営業回りに備えて、ワイシャツの下に吸水性の高い汗取りを着込んで出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "着物を着る時は、大切な正絹の生地を汚さないように必ず専用の汗取りを身につける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ベビー服売り場で、赤ちゃんの背中に入れるための柔らかなガーゼの汗取りを購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "着ている物は浅葱の無紋の木綿縮と思われる、それに細い麻の襟のついた汗取りを下につけ、帯は何だかよく分らないけれども、ぐるりと身体が動いた時に白い足袋を穿いていたのが目に浸みて見えた。",
              "citation": {
                "source": "幻談",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下を三国へ上る人通ひ汗取りどもを乾す屋廊かな　法師温泉は川原に涌くのを其の儘囲つたもので、主屋は放れた小高い処に建てられて居り、其の間が長い廊でつながり、廊について三国街道が走つてゐる、廊には昨日三国へ上つた婦人客の汗取りがずらつと干してある、その下を三国を経て越後へ通ふ旅人が通るのである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "天へ怒るように独り語に云い、そしてぱっと、鞍へあがって、袴を割ると、「風邪ひき馬を、ひと鞭、汗とりしてくれよう」　と、馬場を駈け始めた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第一分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
