        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "きょうは「アンヴィルコーラス」をやれとか、カルソーの「アヴェマリア」をやれとかいろいろの注文を持ち出すようになった。",
              "citation": {
                "source": "蓄音機",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は古風なマキアヴェリズムを信ずるものだ。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "政治がマキアヴェリズムであることをも承認してゐる。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえたちは、イヴェデ・アヴェデのお話が聞きたいかね？",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イヴェデ・アヴェデ！",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちは、イヴェデ・アヴェデのお話も聞きたかったのです。",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、イヴェデ・アヴェデのお話も、きっと聞けるだろう」こうして、モミの木は、一晩じゅう、じっと考えこんで立っていました。",
              "citation": {
                "source": "モミの木",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "化石なんか採ってるアヴェックを、だれが本気にしますか」　なにか一撃くらわせようと、芝は高志をにらんだが、ここにいては、じぶんのほうの関心事も進展する可能性がないことに思いあたったのか、渋い顔でシャーベットを受けとった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "男達の前には、ビールが、美和子と相川さんの前には、バーテンの創案の、アルコール分の少いアヴェック・モア・カクテールが運ばれた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一五三五年頃スアヴェニウスは、スコットランドで周り八マイルばかりまるで鶏鳴かぬ地を見た由（ハズリット、一巻一三五頁）。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この生徒のこの答えは、ロシュフコー（６）や、ラ・ブリュイエール（７）や、マキアヴェリ（８）や、カンパネラ（９）のものとされている、あの、あらゆる贋の深遠さよりも深いものだよ」「で、その推理者の知力を相手の知力と合致させることはだね」と私は言った。",
              "citation": {
                "source": "盗まれた手紙",
                "author": "THE PURLOINED LETTER",
                "note": "青空文庫"
              }
            },
            {
              "text": "（８）Niccolo Machiavelli（一四六九―一五二七）――マキアヴェリズムでよく知られているイタリーの政治家、著作家。",
              "citation": {
                "source": "アッシャー家の崩壊",
                "author": "THE FALL OF HOUSE OF USHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッハやアヴェナリウスに依ると、概念、公式、方法、原理等は、できるだけ勢力を節約して経済的に環境に適応することを可能にするものであり、その価値は思惟経済上の価値によって決定される。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "またひとはシェクスピヤおよびミルトンとイギリスの物理学との間に、あるいはライプニツの哲学とバロック芸術との間に、さらにはマッハ、アヴェナリウスと絵画上の印象主義との間にそのような類似を見出し得ると信ずる。",
              "citation": {
                "source": "科学批判の課題",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――自然科学はその誕生ならびに発展の過程において、例えば神学上ではカルヴィニスムス、政治上ではホップスやマキアヴェリに現われているところの力の思想のもとに立っている。",
              "citation": {
                "source": "科学批判の課題",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンテーニュ、パスカルなどから哲學の本筋に來てデカルトに行くもよく、或ひはスピノザの『エティカ（倫理學）』に行くもよく、或ひはまたマキアヴェリの『君主論』などに行つてみるのも面白いであらう。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "思惟經濟説はマッハやアヴェナリウスなどによつて唱へられ、主として自然科學者の間に追從者をもつてゐる。",
              "citation": {
                "source": "認識論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリストテレスやマキアヴェリの政治學が彼等のアントロポロギーを除いて理解されないやうに、唯物史觀はアントロポロギーのマルクス的形態を先づ認識することなしには到底完全に理解され得ないのである。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "マキアヴェルリが国家の本質とした「力」virtu 【＃「u」はグレーブアクセント付き】というものすら、創造性を意味していたものと考えることができるであろう。",
              "citation": {
                "source": "絶対矛盾的自己同一",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マキアヴェルリが国家の本質とした「力」〔virtu`〕 というものすら、創造性を意味していたものと考えることができるであろう。",
              "citation": {
                "source": "絶対矛盾的自己同一",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かしらぴいんと来るものを感じたガフは、直ぐその足で問題のハイランド・アヴェニウの家へタクシを乗りつける。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しく例を挙げてみれば、羅馬人達が親しみを感じたアヴェンチン山河の「｜親愛の神」も、アリアン民族が尊敬したリンガ神の神体も、印度の人々がいつき祀っていたシャクテイ教の神体たる、ヨニーと称する物の形も、大黒天も聖天もそれなのである。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マノン・レスコオ」をかいたアヴェ・プレボウ、「ポオルとヴェルジイニ」のサン・ピエール、シャトウブリアン。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "かえりに、別なアヴェニューを発見する。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月九日（月曜）　アヴェード後一人自分四時の茶まで歩いた。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっと歩いてかえって来て、家でアヴェードたべた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラルギエのセザンヌ・アヴェク・ディマンシェをよむ。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏家の所謂善巧方便とは畢竟精神上のマキアヴェリズムである。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りに、泰造は伸子をつれてフリードランド・アヴェニューにあるホテル・キャンベルへよった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、労働者地区に近いアヴェニュー・ジャン・ジョレスの小さな劇場でふたをあけた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
