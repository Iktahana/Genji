        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "建築はアンピイル式。",
              "citation": {
                "source": "痴人と死と",
                "author": "ホフマンスタアル　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "神童は、一面にアンピイル式の花環と、大きな仙花とで刺繍せられた、華麗な衝立のかげから現われて、すばしこく段々を昇って、演奏壇へあがると、風呂にでも入るように、拍手喝采の中へ入って行く。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンピイル式の小さい花環模様の白っぽい壁布が、壁と天井の傾斜した部分とを蔽っている。",
              "citation": {
                "source": "予言者の家で",
                "author": "BEIM PROPHETEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ置戸棚だけは、重たい金具のついたアンピイル式の道具で、これだけが値打もあり美しくもある。",
              "citation": {
                "source": "トビアス・ミンデルニッケル",
                "author": "TOBIAS MINDERNICKEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "この上品な古い建物のほとんど全部と同じく、きわめて純粋なアンピイル式で整えられた応接間で。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アインフリイト』は全然アンピイル式です。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで私は、このアンピイル式なしではどうしても暮せないような時があります。",
              "citation": {
                "source": "トリスタン",
                "author": "TRISTAN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
