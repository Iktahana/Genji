    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "頭の上は大空で、否、大空の中に、粗削りの石の塊が挟まれていて、その塊を土台として、蒲鉾形の蓆小舎が出来ている。",
              "citation": {
                "source": "奥常念岳の絶巓に立つ記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕等はあまり多い粗削りの藝術に倦きて居る。",
              "citation": {
                "source": "京阪聞見録",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "粗削りに平げたる樫の頸筋を、太い藤蔓に捲いて、余る一尺に丸味を持たせたのは、両の手にむんずと握る便りである。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには五六人の男が粗削りの材木に腰をかけて何か面白そうに饒舌っていた。",
              "citation": {
                "source": "黄八丈の小袖",
                "author": "岡本椅堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その素人素人した粗削りな遣り口こそ、かえってその筋の苦労人の手足を封じ込めた最大の真因だった観がある。",
              "citation": {
                "source": "女肉を料理する男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "道の傍らには、節を荒けずりした新らしい木の香のする電柱が、間隔を置いて、何本も転がさっていた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "低い天井、四囲の壁も床も荒けずりの板で張りつめてあって、かたわらに筵や夜着蒲団のたぐいといっしょに簡単な炊事道具がころがっているらしいことは手さぐりでもわかった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒けずりの荷物箱の板を釘でうちつけたようなお粗末な扉だ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでの文学で、下級海員の生活を描いたものは、階級的な立場からあつかわれたものでも、とかく海の人間の心持の荒けずりでロマンチックな面だけを色濃く出そうとするような傾向があり、誇張があった。",
              "citation": {
                "source": "「第三新生丸」後日譚について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべては粗末で無骨だが、荒けずりなその建物に漂っている木の匂いも、そこに働いている女のプラトークで頭をつつんでいる姿も、すべては他のどの国の、どの国境駅にもなかったものだ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつものメイエルホリド自身の演出から見ると、ずっとリアリスティックで、荒けずりの重さがあり、革命劇場と似た舞台の印象だった。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "荒けずりから仕上げに掛かり、悉皆出来上がって、彫工会へ納めました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "四頭の狆を製作したはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "矮鶏の温柔なちんまりした形に対して、軍鶏の勇猛な処を鑿打ち半分で、かさかさと荒けずりの仕事を見せると、形の上からも矮鶏の軟らかさに対して剛柔の対比にもなるし、また、仕事の上では粗密とか強弱などの調和も見せられる、これは話して見ようと思い、その事を話すと、「それはどうもおもしろい。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "鶏の製作を引き受けたはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は最も荒けずりの型でできていた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしわたしは、節だらけの荒けずりの樺色の板や、頭上高くにある樹皮のついたままの梁にかこまれて、この涼しく風通しのよい部屋でたのしい幾夜かをすごした。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな、荒けずりの、がっしりした原始的な広間で、天井も塗り壁もなく裸の垂木と横木とが、いわば、より低い天を頭上にささえており、それが雨や雪をふせぐ役をしているのである。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには荒けずりの長い卓があって、その上にいくつかの皿と大きな乳入れと小麦の菓子を積みのせた皿と、その側に、らい麦の黒パンとがあった、私は目を大きくして見つめた。",
              "citation": {
                "source": "最後の晩餐",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "その室のかべというのは新しい荒けずりの松板でヴァニスをかけただけですから、節がよく見えていました。",
              "citation": {
                "source": "真夏の夢",
                "author": "ストリンドベルヒ　August Strindberg",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分に対して抵抗してくる力と張りあいながらとにかく外にむけて出ていこうとする、比較的単純で荒けずりな力へのコミットメントだった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い荒けずりのベンチの、安っぽい布をかけたのが、壁と天井とで形造られた広い龕の前に、長々とおいてある。",
              "citation": {
                "source": "予言者の家で",
                "author": "BEIM PROPHETEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "札幌から汽車で函館へ向うときここを通過するが、荒涼として淋しい風景、いや風景とも言いきれないほど荒けずりで、すさまじいすがたは見ものである。",
              "citation": {
                "source": "馬鈴薯の花",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間の眼で愛されるには、あまりに荒けずりで、大まかで原始的なのだ。",
              "citation": {
                "source": "馬鈴薯の花",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "剽悍で一徹者、何ごとにも荒けずりな性格を見せる天堂が、妙に楽しまぬ色で、考えこんでいるので、周馬と孫兵衛がだんだんたずねると、やっと、口を開いた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
