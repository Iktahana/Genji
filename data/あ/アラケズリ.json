  {
    "uuid": "27fa09bd-c56c-5c46-b056-1a9f4870e40e",
    "entry": "粗削り",
    "reading": {
      "primary": "あらけずり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
