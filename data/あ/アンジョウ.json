    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「大暑の候｜愈御安祥御勤被成候由、奥様にも定而御安祥、恐悦奉賀候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「新禧｜弥御安祥御迎可被成遙賀仕候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「矢代太郎様御安祥に被遊御座候哉。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "愈御安祥御座被成候哉承度奉存候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "尊家愈御安祥御迎被成候覧奉恭賀候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "弥御揃御安祥被成御坐候覧、奉恭賀候。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "安祥以来の三河を離れることは相当につらかったであろう。",
              "citation": {
                "source": "小田原陣",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "千五百石の安祥旗本、白旗小左衛門の次男であって、その時年齢二十三、神道無意流の大先生戸ヶ崎熊太郎の秘蔵弟子で、まだ皆伝にはなっていなかったが、免許はとうに通り越していた。",
              "citation": {
                "source": "銅銭会事変",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大久保主計は安祥旗本、将軍｜家斉のお気に入りであった。",
              "citation": {
                "source": "柳営秘録かつえ蔵",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "臼井金弥は旗本の長男、父は臼井小六郎といい、二百石の安祥旗本。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とんでもないこと、旗本でござる」「ははあ、徳川ご直参か」「しかも安祥旗本で、家柄にかけては、負けを取らぬ」「それは、えらいの」とだんだん無礼。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寺侍かと聞いたところ、安祥旗本とおっしゃるので。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾多の入唐僧侶の中で、尤も迅速なる渡海を遂げたのは、安祥寺の惠運和尚であらう。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "室の主人は、今、腕組みをしている手をほどいてみたが、別段、深い冥想の底から、安祥として、現世の色界に戻って来たという足なみでもなく、そうかといって、退屈しきって、所在なさに、四肢の置き場と、顔面筋肉とを、無意味に変化させてみようというのでもない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、無心というものの境涯こそは、あらゆる無気味に超越すると見え、この母と子は、すらすらと、この危険きわまる存在物の立ちはだかりの前を通り過ぎて、極めて安祥として二三間向うへ離れますと、「どこへ行くのです？",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十四　多景島の庵に行いすましていた弁信は、全く落着かない心で、安祥の座から立ち上りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "農奴の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それに就いては、私の方にも望みが御座います」「何なりと申して見い」「安祥以來の御家柄――安倍の御家が大事でせうか、それとも素姓も解らぬ奉公人のお勝が大事でせうか」　清左衞門は開き直りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "傀儡名臣",
                "note": "青空文庫"
              }
            },
            {
              "text": "宇佐美直記といふのは三千五百石の大身で、旗本とは言ひながら安祥以來の家柄、大公儀から格別の御會釋があり、當主は無役ではあるが、小大名ほどの暮しをしてをります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "若黨の戀",
                "note": "青空文庫"
              }
            },
            {
              "text": "安祥以來の名家が、そんなことで取潰されてなるものか」　立上がつた平次を、宇佐美直記はあわてて呼び留めました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "若黨の戀",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛込見附外の大場石見といふのは安祥旗本の押しも押されもせぬ家柄ですが、房州の所領に、苛斂誅求の訴へがあつた爲に、若年寄から東照宮の御墨附――大場家の家寶ともいふべき品――を召上げられ、長い間留め置かれましたが、領地の騷ぎも納まつたので、一と先づ下げ渡されることになつたのはツイ昨日の事。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "名馬罪あり",
                "note": "青空文庫"
              }
            },
            {
              "text": "安祥旗本の立派な家柄と、祖先の手柄を細々と歎願書に書き添えたのですから、公儀もこれは、まず許す方に傾くでしょう。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "殺され半蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛込見附外の大場石見というのは安祥旗本の押しも押されもせぬ家柄ですが、房州の所領に、苛斂誅求の訴えがあったために、若年寄から東照宮の御墨付――大場家の家宝ともいうべき品――を召上げられ、長い間留め置かれましたが、領地の騒ぎも納まったので、一とまず下げ渡されることになったのはツイ昨日の事。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "名馬罪あり",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それについては、私の方にも望みがございます」「何なりと申してみい」「安祥以来の御家柄――安倍の御家が大事でしょうか、それとも素姓も解らぬ奉公人のお勝が大事でしょうか」　清左衛門は開き直りました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "傀儡名臣",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、安祥寺の実玄阿闍梨は、平家調伏を祈って問題になり、呼び出されて問いつめられると、実玄は、「朝敵を調伏せよというご命令でござりましたが、つらつら近頃の様子をみると、どうやら朝敵は平家の事らしいので、私も別に罪とも思わずにいたしましたが」　と平気な顔で申し立てた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第六巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は言葉をも発せず、言わんともせず、意を動かしもせず、動かそうともせず、安詳に身を清くしていた。",
              "citation": {
                "source": "魔法修行者",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "他行であるか、禅定であるか、観法であるか、何かは知らぬが、互に日頃から、見ては宜からぬ、見られては宜からぬ如き行儀を互に有たぬ同士であるから、遠慮無く寂心は安詳にあちこちを見廻った。",
              "citation": {
                "source": "連環記",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は無意識に伴ふ安詳にして鞏固なる意識を――明かに眞實を見る内省と、障碍と面爭してたじろがざる自信とを――持つ必要がある。",
              "citation": {
                "source": "三太郎の日記　第一",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼その難きに処して、安詳静粛、意長く神遠く、殆んど無極の精神に冥化するものあるが如し。",
              "citation": {
                "source": "吉田松陰",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
