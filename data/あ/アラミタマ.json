          "literary": [
            {
              "text": "和魂（ニギミタマ）と荒魂（アラミタマ）、つまり優しい魂と荒々しい魂の両方を持っている。",
              "citation": {
                "source": "勇子",
                "author": "一つの追憶",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから正月にもアラミタマの家には別の行事がある。",
              "citation": {
                "source": "年中行事覚書",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
