          "literary": [
            {
              "text": "――あなたはアバニシー（４）の話を覚えていますか？",
              "citation": {
                "source": "盗まれた手紙",
                "author": "THE PURLOINED LETTER",
                "note": "青空文庫"
              }
            },
            {
              "text": "アバニシーなんぞくたばってしまえだ！",
              "citation": {
                "source": "盗まれた手紙",
                "author": "THE PURLOINED LETTER",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがね、あるとき、ある金持の吝嗇家が、そのアバニシーに医療上の意見をただで聞こうという工夫をしたんです。",
              "citation": {
                "source": "盗まれた手紙",
                "author": "THE PURLOINED LETTER",
                "note": "青空文庫"
              }
            },
            {
              "text": "』とアバニシーは言ったそうですよ」「だが」と総監は少しむっとして言った。",
              "citation": {
                "source": "盗まれた手紙",
                "author": "THE PURLOINED LETTER",
                "note": "青空文庫"
              }
            }
          ]
        }
