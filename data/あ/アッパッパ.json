    "definitions": [
      {
        "index": 1,
        "gloss": "loose-fitting summer dress",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あっぱっぱについて考えてみました。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱの意味を理解しました。",
              "source": "幻辞"
            },
            {
              "text": "日常生活であっぱっぱが使われています。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱに関する知識を深めました。",
              "source": "幻辞"
            },
            {
              "text": "辞書であっぱっぱを調べました。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱの用法について学びました。",
              "source": "幻辞"
            },
            {
              "text": "様々な分野であっぱっぱが活用されている。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱの応用例を見つけました。",
              "source": "幻辞"
            },
            {
              "text": "専門家があっぱっぱについて論じている。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱについての研究が進んでいます。",
              "source": "幻辞"
            },
            {
              "text": "教育の場であっぱっぱが教えられている。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱの歴史を追うことは興味深い。",
              "source": "幻辞"
            },
            {
              "text": "文化的背景からあっぱっぱを理解する。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱの変化に気づきました。",
              "source": "幻辞"
            },
            {
              "text": "言語や文化におけるあっぱっぱの重要性。",
              "source": "幻辞"
            },
            {
              "text": "分析結果からあっぱっぱの特性がわかった。",
              "source": "幻辞"
            },
            {
              "text": "一般的なあっぱっぱの使い方を習得しました。",
              "source": "幻辞"
            },
            {
              "text": "複雑なあっぱっぱの概念を説明する。",
              "source": "幻辞"
            },
            {
              "text": "あっぱっぱに関連する他の用語がある。",
              "source": "幻辞"
            },
            {
              "text": "最新のあっぱっぱに関する情報を入手した。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "夏になるとあっぱっぱと云うのが流行りますが一風景です。",
              "citation": {
                "source": "着物雑考",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっぱっぱも随分りりしくはありますが、そのりりしさよりも、浴衣に襷がけのりりしさを愛します。",
              "citation": {
                "source": "着物雑考",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっぱっぱのはだけた胸に弁当箱をおしつけて肩をゆすりながらくる内儀さん。",
              "citation": {
                "source": "白い道",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "察しのつく通りアッパッパで、それも黒門市場などで行商人が道端にひろげて売っているつるつるのポプリンの布地だった。",
              "citation": {
                "source": "大阪発見",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "治療してもらっているのはどこかの奥さんらしくアッパッパを着て、スリッパをはいた両足をきちんと揃えて、仰向いています。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その年の夏、持子は頑としてアッパッパを着たがらぬので、不審に思ってよくよく観察してみると、妊娠していると判った。",
              "citation": {
                "source": "婚期はずれ",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "色の褪せた、野良仕事用のアッパッパに、島民並の跣足である。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "理論家窪川鶴次郎は彼女に手を出して手を噛まれた――小説といふ彼女に窪川稲子の嫉妬が小説を書かせるほど彼女は利巧者で、小説家で黒襟をはずしてアッパッパを着る時代性も承知してゐる。",
              "citation": {
                "source": "小熊秀雄全集-12",
                "author": "詩集（11）文壇諷刺詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッパッパが、大阪近代風俗の一つとなり、東京の流行が千差万別であるとの差であって、知識の差に、帰着してくる。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "片瀬では殆ど見えなかつた、縞柄の派手な海岸パラソルの點在や、模樣の美しい贅澤な海水着や、裕福らしい西洋人の家族や、すべて、アッパッパを着て丸髷に結つた五九郎の喜劇役者のやうな四十女がブランコに乘り、傍から「母ちやん、このごろ、だいぶんウマくなつたのね。",
              "citation": {
                "source": "滑川畔にて",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、おいで、アッパッパ」「やあ、笑った、笑った」赤ン坊の珍らしい素六が、横から囃し立てた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "下町へ行くと、今もなお女髪結いの上っ張りの如く、西洋のねまきの如き、あんまの療治服の如き俗にこれをアッパッパと称されているところの簡易服を着ているものを認めることが出来る。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッパッパは現代モダン生活の第一線に対するそのもっとも煽りを承っているところの女軍であるといっていいかも知れない。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッパッパといえばもうそれは七、八年も以前、その流行の初期において画友鍋井君がこれを女のものとは知らずに着用して、虎の門女学校を写生するため毎日電車で通うたということである。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッパッパから足を出している少女が大阪だけかと思うと、神戸にも京都にも東京にもある。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はとにかく新時代の後からおそるおそるぞろぞろと追従して行くアッパッパ連と急先陣を承るところのモダンガールにすこぶる興味を持つ。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに一年や二年は如何にあのアッパッパと仁丹を表現すべきかについて考えた結果、落胆と、失望と、不勉強と、生活難はどしどしと攻めよせてくる。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "碑の傍に腰をおろしていると、一緒に上ってきたアッパッパに日傘の娘さん達も、そこに来て休んだ。",
              "citation": {
                "source": "浅間山麓",
                "author": "若杉鳥子",
                "note": "青空文庫"
              }
            },
            {
              "text": "酌婦上りのような老母、アッパッパの母、ちょいと町のトビのものの母娘という感じ。",
              "citation": {
                "source": "日記",
                "author": "一九四七年（昭和二十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東山さんのおうちりっぱなものですねえ、あんなのを文化生活と言うのでしょ」妻がアッパッパに着替えながらしみじみ言う。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に女中の一人が赤い腰卷の上から、笹縁の附いた薄いアッパッパを一枚着たきりで給仕をしたりするに至つては、みんなあきれ返つてなんにも言はなくなつてしまつた。",
              "citation": {
                "source": "湖水めぐり",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寧ろ、盛んになっているのは、愛国家が敢えて宣揚することを好まぬような、アッパッパ映画や東京音頭まがいの街頭小唄位いのものではないか。",
              "citation": {
                "source": "社会時評",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも多少日本語ができ、ヤミ族としては、この島開闢以来の文化人なのださうだが、なるほどさういへばカリヤルは頭を解き分けにして豚の脂をつけ、シナロンは束髪に結つて浴衣地のアッパッパを著てゐた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッパッパのやうなものが二着とよれよれのユカタのやうなフダン着が残されてゐるだけ、あとはみんな清人が質に入れてしまつた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "まつたく富子はもう羞も外聞もない気持になつて、アッパッパで飛びだして、会社の社長や、問屋のオヤヂや、印刷所のハゲアタマのところへ途中まで歩きかけてみたが、さすがにすくんで、動くことができなくなつて、倉田のアパートへ行つた。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッパッパで、小さくなつて、私を二号にしてちやうだいよ、なんて、それぢやア、あなた、闇のチンピラよりも安く値切り倒されてしまふですよ。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "松籟と月光と女とね、日本の女は焼けだされてアッパッパだが、結構夢の恋物語は始まることだらうさ」　野村は月光の下の私の顔をいとしがつて放さなかつた。",
              "citation": {
                "source": "続戦争と一人の女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（このころはアッパッパはなかった。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "（このころはアッパッパはなかつた）僕は神経衰弱でも青年男子であるから一番遠い所へ水を運び、人の最も好まざる苦難を敢て行ふといふのは、之も青道心のせめてもの心掛けといふものであつた。",
              "citation": {
                "source": "二十一",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子がアッパッパと称する下着一枚で戸外に出歩く奇風については、友人佐藤｜慵斎君の文集に載っている其論に譲って、ここには言うまい。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
