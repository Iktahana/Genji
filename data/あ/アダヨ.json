          "literary": [
            {
              "text": "今日、元日のアダヨの仲直り手打をするから云々で、又もや部屋で十円いかれた。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大阪の吉田（高級アダヨ）来り、渡辺と二人で五円やる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "中川（山春）に五円、又いろ／＼なアダヨ来り憂鬱である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部又「鍋島」を中根にたのみ、報知講堂へ、アダヨの会、顔だけ出してくれてのへ一寸出る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜の部終って入浴、又々変なアダヨ部屋へ来り、くさる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "山一もあとから来て話してると、アダヨ来り、二円たかられる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダヨが入って来たり、大部屋が酒気を帯びていたりするので全く不愉快。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アダヨ入来、二円いかれる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女形をすませてすぐに大隈講堂へ行き、嗄声で一席やり（35）、雨をついて円タク、大崎館て小屋へアダヨ（新門の何とか）ザシで行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和九年",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイスクリームのみ、一人で歩いてゝ危いなと思ってると日比谷の角でアダヨが来り、二円たかられる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出る、オザの話もあれど柳がゐないので話がうまくきけず、益戸の克巳なんてアダヨが来て十円タカられるし、不自由である。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日又、アダヨ来り一円たかられる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "象潟署から呼び出しあり、一昨日は、浅草のアダヨに花環二個持ち込まれて四五十円とられたし、つく／″＼くさる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ出る、満員だが、補助が少々スキあり、楽屋の来訪客えらく混雑、又アダヨが来り金とられる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "座へ帰る途、アダヨにつかまりそこなふこと幾たび、此の遍は危いとこらしい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京のアダヨ、三橋といふ凶悪なのが来り、十円タカられ、警察の人来る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
