        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "編み笠を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは編み笠について学習した。",
              "source": "幻辞"
            },
            {
              "text": "編み笠の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は編み笠の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では編み笠が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "編み笠という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に編み笠という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では編み笠についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "編み笠を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると編み笠は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "編み笠について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では編み笠が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に編み笠は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により編み笠の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "編み笠は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に編み笠は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "そこで、自分の大きな編み笠を脱いで、跪くと、しばらく泉の水を飲んだ。",
              "citation": {
                "source": "夏の日の夢",
                "author": "THE DREAM OF A SUMMER DAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の母の話によれば、法界節が二、三人｜編み笠をかぶって通るのを見ても「敵討ちでしょうか？",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゝきの原形だと言はれてゐる胸叩きと言ふ乞食者は、顏だけ編み笠で隱して、裸で胸を叩きながら「春參らむ」と言うたとあるから、「節季に候」と「春參らむ」とは、一續きの唱へ言であつたことが知れる。",
              "citation": {
                "source": "國文學の發生（第三稿）",
                "author": "まれびとの意義",
                "note": "青空文庫"
              }
            },
            {
              "text": "この編み笠を冠ぶった姿のアミガサタケはなにも珍らしいほどのものではなく、五月の季節が来れば方々に生える地上菌で、その形が奇抜なものである。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで栄三郎は、かぶっていた編み笠を路傍へ捨てて、しずかに愛刀武蔵太郎安国の鞘をはらう。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴下毛糸にて編める靴下をもはかせ好めるおもちやをも入れあみがさ、わらぢのたぐひをもをさめ石をもてひつぎを打ちかくて野に出でゆかしめぬ。",
              "citation": {
                "source": "忘春詩集",
                "author": "忘春詩集",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころの囚人さんはあみがさをかむっていた。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまもあみがさをかむっているらしい。",
              "citation": {
                "source": "我が愛する詩人の伝記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は編笠を被らずに手に持って、それじゃお母さんいってまいりますと挨拶して走って出た。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅館の主人、馬を勧め、剛力を勧め、蓆を勧め、編笠を勤む、皆之を卻く、この極楽の山、只一本の金剛杖にて足れりと広舌して、朝まだき裾野を往く。",
              "citation": {
                "source": "霧の不二、月の不二",
                "author": "――明治三十六年八月七日御殿場口にて観察――",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は編笠を冠り白木綿の羽織のようなものを着ている。",
              "citation": {
                "source": "札幌まで",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦は編笠を着て三味線を持った、その門附の絵のある処が、お前たちの相性だ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "松茸、椎茸、とび茸、おぼろ編笠、名の知れぬ、菌ども。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "編笠、ひたりと折合わせて、紐を深く被ったなりで、がっくりと俯向いたは、どうやら坐眠りをしていそう。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに、先刻の編笠｜目深な新粉細工が、出岬に霞んだ捨小舟という形ちで、寂寞としてまだ一人居る。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "舞台を見返す瞬間、むこうから、先刻の編笠を被った鴉ような新粉細工が、ふと身を起して、うそうそと出て来るのを認めた。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、もうそこに、編笠を深く、舞台を覗く。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞬間、松崎は猶予ったが、棄ておかれぬのは、続いて、編笠した烏と古女房が、衝と幕を揚げて追込んだ事である。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭を編笠が抱えた、手も胸も、面影も、しろしろと、あの、舞台のお稲そのままに見えたが、ただ既に空洞へ入って、底から足を曳くものがあろう、美しい女は、半身を上に曲げて、腰のあたりは隠れたのである。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）Ｓ＝通り　深編笠の浪人者の移動稍長く、　腰に下っている印籠の大写。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "と三次の背後から通り過ぎた又別の深編笠の侍。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「待てと言ったら待たねえか」　逃げる船頭が、Ｔ「人に喋るとあの男の様になります」Ｔ「罰が当ります、罰が」　その舟が橋の下へ来た時、　橋の上の欄干に凭れた深編笠の侍が居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋の上を――逃げる深編笠の侍。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "川端を逃げる深編笠の侍。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "川岸――　逃げる深編笠を追う伝六。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "１５＝川端の寺のある処　深編笠の侍は其処の土塀を飛び越えて姿を消す。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "編笠が其処に落ちて居る。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手には編笠と羽織。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（Ｆ・Ｏ）１８＝（Ｆ・Ｉ）右門宅　編笠と羽織を調べる右門。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "15＝川端の寺のある処　深編笠の侍は其処の土塀を飛び越えて姿を消す。",
              "citation": {
                "source": "右門捕物帖　三十番手柄　帯解け仏法",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
