        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "9月に入って急に朝晩の風が涼しくなり、景色も少しずつ秋めいてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ショーウィンドウのマネキンが厚手のコートを着せられ、街並みもすっかり秋めいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "山の木々の葉がわずかに色づき始め、本格的な紅葉の季節に向けて野山が秋めいていくのを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "暑いとはいつても、朝晩は秋を感じる、一雨来たらめつきり秋めくだらう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "南晴るゝ　上野の山山の肌　なべて秋めく草の葉のさえ／″＼しきに、さびしまむとす碓氷嶺の　峠の町をいでゆきて、いち早かりし戦死者を　とふ盆すぎの山にのぼり来て、戦死者の家をおとなふ。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "暑さ短き日と　なりにけり昼深く　秋めく風や。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天候がしずまるともうすっかり秋めくことでしょうね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀河一　初袷を着、風も秋めくと、毎日のように、江戸のどこかしらで、笛太鼓の音の聞えない日はない。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "目を大きく見ひらいているのに、手さぐりでそんなことをしているところをみると、あきめくらなのだろう。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "この少女は、あきめくらであるばかりでなく、気がくるっているのだろう。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "久助君は、そこにいる白い少女が、あきめくらでも気ちがいでもないことがわかったけれど、でもなんとなくきみがわるくて、しぜんに、目や耳は少女の方にひきつけられた。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あきめくら共めがッ、この眉間の三日月形が分らぬかッ」「………?!」「よよッ」「………！",
              "citation": {
                "source": "旗本退屈男　第二話",
                "author": "続旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あきめくら共めがッ、この眉間の三日月形が分らぬかッ」「………※」「よよッ」「………！",
              "citation": {
                "source": "旗本退屈男",
                "author": "第二話　続旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえのようなあきめくらがのぞいたっても、犬が星をみるようなものなんだから、尾っぽを巻いておとなしくかしこまってな」「ちぇッ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "あきめくらとはなんですかい！",
              "citation": {
                "source": "右門捕物帖",
                "author": "因縁の女夫雛",
                "note": "青空文庫"
              }
            },
            {
              "text": "大自然のあきめくら、見くびつてくれるな、人間には備はつてゐる、刹那に永遠を見通す目、それから、上下左右へ即座に方向転移の出来る飛躍自在の魂。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人ともあきめくらで、子供も人並に育てることはできない。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "鶯ばか",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
