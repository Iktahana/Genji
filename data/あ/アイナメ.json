    "definitions": [
      {
        "index": 1,
        "gloss": "fat greenling (Hexagrammos otakii)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "釣り上げたばかりの鮎魚女をその場で捌き、塩焼きにして贅沢に味わった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今日の献立は鮎魚女の煮付けですよ」と、女将が明るい声で言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "春から夏にかけて旬を迎える鮎魚女は、上品な味わいで人気が高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "下屋の水窓へ、折から横づけの船から、穴子、ぎんばうの畚、鰈、あいなめの鮹盤臺を、掬ふ、上げる、それ抱き込む、大鯛の溌剌たるが、（大盤臺）から飛び上つた。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鱚、魴※、鯒、あいなめ、目ばる、藻魚の類合せて七百籠。",
              "citation": {
                "source": "海神別荘",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、あいなめを焼いて久しぶりに御飯をたべる。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいなめに、鯛に、さばに、いさき、かつおの紳士。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰹のたたき、あいなめの煮物、船で作った絹｜漉しの冷奴、大根の風呂吹き。",
              "citation": {
                "source": "海豚と河豚",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいなめ、と云う小魚と栗と新しい野菜の漬物で茶漬をうまく喰べた。",
              "citation": {
                "source": "青べか日記",
                "author": "――吾が生活　し・さ",
                "note": "青空文庫"
              }
            },
            {
              "text": "捕れるのは鰈が多く、あいなめとか、夏になるとわたり蟹なども捕れるが、蟹の場合はべつに心得があった。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "メバル、アイナメ、海タナゴなどもよく交るが、カイヅは十月池上のお会式まで釣れる。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「海鳥型」の釣人は、主として海を翔り、十尋から三四十尋の深所で、赤鯛、スズキ、黒鯛、サバ、太刀魚、鰺、鯒、カレヒ、ブダヒ、モヨ、カサゴ、タコ、イカ、アイナメなどを釣る。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "川では鮎、鱒、鯉、鮒、ニゴヒ、ハヤ、モロコ、ヤマベ、イハナ、ヤマメ、タナゴ、鰻、鯰、鰌、ハゼ、イナ、などが釣れ、海では、鯛、鱸、鯒、鰈、鰺、鱚、烏賊、蛸、カサゴ、アイナメ、ソイ、平目、小松魚、サバ、ボラ、メナダ、太刀魚、ベラ、イシモチ、その他所によつて、百種以上のものが釣れる。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "北海道で油子といふのが、関東のアイナメで、関西ではアブラメ、佐渡ではシジウなどといふ。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには悉く又｜鈎も違ふ、仕掛けも違ふ、底釣りのカレイ、アイナメ、コチ、ハゼ、カサゴの仕掛けでは、サバ、アヂ、スズキなどの中層にゐる魚は釣れない。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じ地震の前に、男鹿半島北浦町の釣り漁船はタイ、アイナメ、アブラコの漁獲が多かった。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイナメ」を「アブラコ」。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
