          "literary": [
            {
              "text": "ソコデ、ウグヒスタチハ　ミンナデ　イツシヨニ、キカラ　キヘ　ツタハリナガラ、ニギヤカニ　コドモタチノ　ハウヘ　アソビニ　ユキマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤア　ウグヒスガ　アソビニ　ヤツテ　キタ」ト、イヒナガラ、コドモタチハ　テヲ　ウツテ　コロコビマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イマ、オトナリノハタケムラカラ、ヂヤガイモサンガ、アソビニキテヰタノデスガ、キウニヰナクナツタノデス。",
              "citation": {
                "source": "三匹　の　こぐまさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
