          "literary": [
            {
              "text": "彼は自分の名前をアルビヌスとラテン語化していた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "何よりもハラーの将来に決定的な影響を及ぼしたアルビヌスとブールハーフェがいた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "1747年にアルビヌスは骨と筋の図を含む大きな２折版を刊行した。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "血管系についてのハラーの図版はアルビヌスの図版に相当するものであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はスミルナに行って医師ペロスおよびプラトン主義者アルビヌスの弟子になり、コリントスではヌメシアヌスのもとで、アレクサンドリアではヘラクリアヌスの講義を聞き、キリキア、フェニキア、パレスチナ、クレタ島、キプルス島、へ行った。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            }
          ]
        }
