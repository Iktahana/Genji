          "literary": [
            {
              "text": "うちにとって、極めて興味ある歴史的アントラクトの時間です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてね、今のこの寸刻のアントラクトに、わたしにこんな手紙かかせる気もちには一寸した基礎があります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一楽章が、入れ混ったつよい音の林のように伸子たちの頭の上をふきすぎ、短いアントラクトがあって、第二楽章に入ろうとする間際だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
