        "examples": {
          "standard": [
            {
              "text": "深夜の公園の茂みで青姦に及んでいたカップルが、巡回中の警官に見つかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は週刊誌のスキャンダル記事で、有名人の青姦疑惑を読んで驚愕した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「そんな場所で青姦なんて、誰かに見られたらどうするんだ」と彼女は顔を赤らめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
