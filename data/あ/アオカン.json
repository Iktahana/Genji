        "examples": {
          "standard": [
            {
              "text": "若い頃、無一文で旅をしていた彼は、公園のベンチで青姦を決め込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "山小屋が満員だったので、入り口の軒下で青姦することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今夜は星が綺麗だから、このまま青姦でもするか」と友人が冗談めかして言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
