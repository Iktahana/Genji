    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "園も笑ひながら楽器の調子を変へると、客達が一勢に手拍子をとつて「日清談判ハレツシテ、品川乗リ出スアヅマ艦――」と合唱した。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "上州の吾妻郡に對するアヅマ郡、利根上流の吾妻川に關するアヅマ川も同樣な謬りの例（正しく發音すればアガツマ郡、アガツマ川）である。",
              "citation": {
                "source": "地方主義篇",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後世に至りて関東武人をアヅマエビス（東夷）、一般武人をエビス（夷）と呼びたるも、罵詈の綽名に非ざりしが如し。",
              "citation": {
                "source": "武士を夷ということの考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「我妻をアヅマと読むことがありますから、（我）はアですね。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
