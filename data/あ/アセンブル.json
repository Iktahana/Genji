        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "買ってきた家具のパーツをリビングでアセンブルするのに、丸一日かかってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "記述したソースコードをアセンブルして、マイコンのフラッシュROMに書き込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "分散していたチームのメンバーを本社にアセンブルし、緊急の対策会議を開いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "手作業の、ハンドアセンブルを進めていく。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "機械語に変換されてＲＯＭに組み込まれているベーシック処理プログラムを、逆アセンブルと呼ばれる工程を経てアセンブラーの形式に戻して分析すれば、マイクロソフトがどういった手順で機能を実現しているかを覗いてみることができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで古山は逆アセンブルを禁止し、あくまで一からの組み立てに徹した。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで６８００で実現可能な最高速を目指すという目標をかかげたが、これを達成しようとする以上、すでにあるものを逆アセンブルして参考にしようとしてもあまり意味はなかった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
