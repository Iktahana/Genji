          ],
          "literary": [
            {
              "text": "これは風呂から出て、ちょうど上がり湯を使おうとしたところらしい。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬琴は水槽の前へ来て、心静かに上がり湯を使った。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "上がり湯は既に水になつてゐます。",
              "citation": {
                "source": "佐渡が島のこと",
                "author": "江南文三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ろくに体を洗いもしないで、それから伊兵衛と馬春堂が、上がり湯をザッと浴びて着物を引っかけ初めたころ。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかしやの花さく見れば水の上にはかなき夏の夢もやどりぬ片恋のわれをあはれと鈴麦の花さく傍を通ひ来にけり夕青き微光の中をあがりゆく足長蜂は足を垂らせり玉赤き蝋マツチする草のなかすでに蛍の臭気むせべり　こうした所縁の深い新作が増補として、「第二桐の花」としてでも加えられねばならない恋々たる気持にもなる。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "日の丸湯へ戻り、ふと女湯の障子にはめられた赤、紫、黄、青の色硝子に湯槽の湯がゆらゆらと映って、霞んでいるのを、いつもとちがうしみじみとした美しさだと見上げていると、「上り湯ぬるおまっせ」　羅宇しかえ屋のお内儀の声がし、暫らくすると、季節はずれの大正琴の音がきこえて来た。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "浴室へ行けばぬるりと辷るし、暗くて狭くて、天井が低くて、息抜きも無ければ、上り湯もない。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "上り湯のパイプがわるくなっているのを思い出しすぐ上り湯をあけました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは風呂から出て、丁度上り湯を使はうとした所らしい。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬琴は水槽の前へ来て、心静に上り湯を使つた。",
              "citation": {
                "source": "戯作三昧",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんな話……今やめましょうよ」　多計代は上り湯を汲み出して、顔を洗いながら、手拭の合間から乱れた声で云った。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯はぬるみ加減で、上り湯は底少くなっていた。",
              "citation": {
                "source": "或る素描",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は町内の洗湯で、上り湯を使いながら、セメントの流しの上へ倒れた。",
              "citation": {
                "source": "ひょっとこ",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "といつて、別に上り湯があるではなし、洗面用の水桶から汲み出して洗ふか、風呂桶の中であかを洗ひ落すかするより外はない。",
              "citation": {
                "source": "湖水めぐり",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒中でも上り湯がぬるいためか大抵の人は水を浴びてゐます。",
              "citation": {
                "source": "佐渡が島のこと",
                "author": "江南文三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、上り湯を思い切りよく浴びる。",
              "citation": {
                "source": "刺青",
                "author": "富田常雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
