        "examples": {
          "standard": [
            {
              "text": "毎日手入れをしているうちに、中古で買った車に愛着がわいてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最初は使いにくいと思っていた道具だが、慣れると不思議と愛着がわくものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "自分で一から組み立てた家具は、完成した瞬間に愛着がわく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この籐のステッキは無一物の私がたつた一つの財産に大事にしてゐたもので、それはステッキを愛用した人でないと分らないが、身体の一部の愛着がわくもので、私の嘆きは甚大だつた。",
              "citation": {
                "source": "ぐうたら戦記",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
