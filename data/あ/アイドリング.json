        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "駐車場でアイドリングをしたまま仮眠をとっていたトラックの運転手が、警備員に注意されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "寒い冬の朝、車のエンジンをかけてしばらくアイドリングをしてから出発した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "交差点で信号待ちをしていると、隣に停まったバイクのアイドリングの音がやけにうるさかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "人も車も途絶えた交差点の赤信号でとめられていたとき、このオートバイのアイドリングを聞いていて、ぼくは泣き出したのだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｗ３のアイドリング音と、ぼくの心臓の音が、じかに、つながっている。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あとでいっしょに食べよう」　エンジンはアイドリングのままだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "すんなりとスタンディング・スティルの状態になり、ニュートラルを出してアクセルを閉じると、エンジンは八〇〇回転で安定したアイドリングへ落ちていった。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
