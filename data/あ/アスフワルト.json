        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "巴里の道ももう此辺はアスフワルトでもなければ切石を敷いた道でもない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アスフワルトを敷いた坦道が丘陵の間を縫ひつつ、しばしば右方に黄海の緑を望むのは、まことに快適な散歩であつた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "都会の大道には橋梁の便あつて、自由に車を通ずるに係らず、殊更岸に立つて渡船を待つ心は、丁度表通に立派なアスフワルト敷の道路あるに係らず、好んで横町や路地の間道を抜けて見る面白さと稍似たものであらう。",
              "citation": {
                "source": "水　附渡船",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
