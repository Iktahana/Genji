[
  {
    "uuid": "113d5b3a-d3a2-5a9d-9865-36ae8c99eb6d",
    "entry": "足ずり",
    "reading": {
      "primary": "あしずり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
