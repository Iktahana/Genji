    "definitions": [
      {
        "index": 1,
        "gloss": "to blow (of autumn wind)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "盆を過ぎて秋風が立つようになり、夜の寝苦しさから解放された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の木々から虫の声が聞こえ始め、ようやく秋風が立つ気配がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旅先でふと秋風が立つのを感じ、家路を急ぐことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "秋風が立つてから、眼に見えて吾人の身の※りのものが乾燥して來るといふ氣象學的現象の實感、同時に氣温濕度の急變から起る生理的、ひいては又精神的な變化の表現が、活々とした句の裏面から映し出されてゐる。",
              "citation": {
                "source": "天文と俳句",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋風が立つにつれて、容体の悪いのが目に立った。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "降り続いた火事後の雨が霽ると、伝染病発生の噂と共に底冷のする秋風が立つて、家を失ひ、職を失つた何万の人は、言ひ難き物の哀れを一様に味つてゐた。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "降り續いた火事後の雨が霽ると、傳染病發生の噂と共に底冷のする秋風が立つて、家を失ひ、職を失つた何萬の人は、言ひ難き物の哀れを一樣に味つてゐた。",
              "citation": {
                "source": "札幌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "酷い夏痩せの千登世は秋風が立つてからもなか／＼肉付が元に復らなかつた。",
              "citation": {
                "source": "業苦",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾分あきらめたような、希望のあるような心持で、秋風が立つと、祖母がやることにきめている着物の地を染めたり、絞ったりしながら、自分のしていることが自分で分らなくなって来たのを感じていたのである。",
              "citation": {
                "source": "貧しき人々の群",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "to fall out of love",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あれほど仲睦まじかった二人の間にも、いつの間にか秋風が立っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "些細な喧嘩をきっかけに、彼との関係に秋風が立つのが分かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "共通の話題が少なくなり、二人の会話に秋風が立つ寂しさを覚えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
    ],
