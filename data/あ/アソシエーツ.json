        "examples": {
          "standard": [
            {
              "text": "独立後、彼はかつての同僚たちと「田中アンドアソシエーツ」という設計事務所を立ち上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "大手監査法人から独立した公認会計士が集まり、新しいアソシエーツを設立したというニュースを見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "クライアントの複雑な要望に応えるため、海外のアソシエーツと連携して大規模な市場調査を実施した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "（伊藤信吉編「新潮日本文学辞典」、日外アソシエーツ編「詩歌人名事典」を参照した。",
              "citation": {
                "source": "風狂私語",
                "author": "辻潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "インテルから数マイル離れたところに生まれたシュガートアソシエーツという小さな会社では、当時、フロッピーディスクのドライブの開発を始めていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
