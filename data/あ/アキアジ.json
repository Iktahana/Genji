    "definitions": [
      {
        "index": 1,
        "gloss": "salmon (esp. salmon swimming upstream in the autumn)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「俺アだぢ來た頃なんてみんな取りてえだけ秋味（鮭）ばとつたもんだ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、だまつてれば、キユ／＼／＼つて、秋味なア河面さ頭ば出して泣くの聞えたもんだ。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「今朝、俺アのお母川さ行つたら、五、六疋秋味が背中ば見せて下つて行つたツて云つたで。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "後さ行つて、川ば見てれば、秋味の野郎、背中ば出して、泳いでるのに、三ヶ月も魚ば喰はねえつてあるか。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "旭川藤井家で御馳走になった「秋味」――鮭のしゅん――をいつまでも私は忘れないのだが、はからずもここ余市の道立水産試験場でまる一日この方面でからっぽの私の頭を、みたすことができたことはしあわせであった。",
              "citation": {
                "source": "望郷",
                "author": "――北海道初行脚――",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
