        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なかば見物、なかば好意の出迎えを彼らは楽しんでいて、桟橋を歩いてくる日本の人たちに、「アローハ」　と、おだやかな笑顔で声をかけた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰もが、誰に対しても、「アローハ」　と、呼びかけた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒田半蔵と幸江にとって、ハワイで最初に聞いたその島の言葉は、このときのアローハのひと言だった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アローハ」　歩きながら半蔵は幸江をふりかえり、出迎えてくれた地元の人たちの口調を真似てみせる。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どの人も、アローハと言っていた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "初対面で、しかも誰もが口にするひと言なのですもの、こんにちはとか、いらっしゃいませとか、そんな意味でしょう」「アローハ」　と、半蔵は幸江にむかって言う。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アローハ」　幸江が、笑顔で彼にこたえる。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "善意や好意など、人に対する肯定的な気持ちのほとんどすべてを表現することのできる、きわめて便利な、そして重要なひと言がアローハなのだと、やがて彼らは知っていく。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
