        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロバァト・バアンズ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファーガスンは来るべき偉大なものを予告し、バアンズは其の偉大なものを成しとげ、私は唯其の糟粕を嘗めたに過ぎぬ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "スコットランドの三人のロバァトの中、偉大なるバアンズは別として、ファーガスンと私とは余りに良く似ていた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白人は愚か、土人さえ稀なマルケサスの裏海岸に自分で小舎を作り、唯一人（海と空と椰子樹の間に全く唯一人）一冊のバアンズと一冊のシェイクスピアを友として住んでいる（そして少しの悔もなく其の地に骨を埋めようとしている）亜米利加人もいた。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その災難に伴う屈辱を避けるために、彼は先祖の代から住み慣れたニュー・オーリアンズ（３）の町を去って、南カロライナ州のチャールストンに近いサリヴァン島に住むことになった。",
              "citation": {
                "source": "黄金虫",
                "author": "THE GOLD-BUG",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは学校の図書館の本で英吉利の詩人バアンズの評伝中に引いてある一節であった。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い麦の香を嗅ぐようなバアンズの接吻の歌も、自分の国の評判な俳優が見せてくれる濡幕にも勝って一層身に近い親しみを覚えさせた。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーツ、シエレイ、バアンズ、テニソン――種類は夥しい、求める人の好みに依る。",
              "citation": {
                "source": "日本橋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分であつめた本は、これまでの幾度かの嵐で大半あとかたもなかつたが、天井裏や長持の中からなど、誰のものかも知れないやうな、ヒストリアンズ・ヒストリイとか、ブリタニカとか、古典的な西洋料理全集といふやうなものまで、あらひざらひ掻きあつめて見ると、それでもトラツクに一台は十分の量だつた。",
              "citation": {
                "source": "裸虫抄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、三日後にロイドは泣きの涙のうちに、ジェパアンズ・ブッシュの弁護士に頼んで、遺書によってマアガレットの遺した物を掻き集め、「泣く泣く」七百ポンドの保険金を受け取っている。",
              "citation": {
                "source": "浴槽の花嫁",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中は小さい弟に干アンズをパンの間にはさんでこまっかく一口にたべられる様にきっては口に運んで居た。",
              "citation": {
                "source": "千世子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○夜食堂へ行ったら、アンズのような頬の感じの若い女の人盛に喋って居た。",
              "citation": {
                "source": "日記",
                "author": "一九二七年（昭和二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ブドー酒、オトカ、キューリ、カプースタ〔キャベツ〕、鶏、腸詰、クルミ、干アンズ、サモワール　○ニキーチナ夫人のスボートでは二十一日に話すことになった。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "クリタケ、ウスタケ、アンズタケ、その他食用になるのがいろいろ出るが、ナメコはこの山には出ない。",
              "citation": {
                "source": "山の秋",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "月明の夜に焼酎をあふつて、歌ひ舞ふ素朴な生活はわたくしをしてバアンズの詩に見るスコットランド人のそれを想はせた。",
              "citation": {
                "source": "八月の霧島",
                "author": "吉田絃二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モモ、アンズなどは植物学上でいうところの中果皮の部を食用とし、リンゴ、ナシなどは実を合成せる花托部を食しており、ミカンは果内の毛を食し、バナナは果皮を食し、イチジクは変形せる花軸部を食用に供している。",
              "citation": {
                "source": "植物知識",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って私は一般登録局に、９月２日に終わる週における、ソーホーのゴールデン・スクエアとバーウィック・ストリートと聖アンズの（＊３つの）サブディストリクトの、コレラ死亡者のリストを作る許可を求め、親切にもこのことは許された。",
              "citation": {
                "source": "コレラの伝染様式について",
                "author": "ON THE MODE OF COMMUNICATION OF CHOLERA (1854)",
                "note": "青空文庫"
              }
            },
            {
              "text": "リョウヘイは冬は何もなかったが、夏は庭が広いので、アンズとか青いウメとかビワとかを、母にかくれてもいでいって、おばさんにやっていたが、そんなことをするのがはずかしいので、茶の間の茶ダナの上におくと、おいたとも、あげますともいわないで、だまってかえっていた。",
              "citation": {
                "source": "ふたりのおばさん",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "炙った羊肩肉とアンズのプッディング――仔うし肉のカツレツ、焼いたジャガイモ、冷たい舌ハム、冷たい炙り牛肉、殻に入った卵。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "仔うしのヒレ肉と辛いソースをかけたマッシュルーム、炙った膵臓、熱いイセエビ、アンズのタート、中央にはシラバブとジェリーのピラミド。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルーエン「ニュー・ボヘミアンズ」。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面の芝生は広さ六百坪、レンガで庭を区切り、アンズとスモモが植えてある。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンズ、リンゴ、ナツメなどの実もなるしね」「夏は？",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
