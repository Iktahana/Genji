        "examples": {
          "standard": [
            {
              "text": "このGPUアクセラレータにより、画像処理速度が10倍になりました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "データセンターに新しいアクセラレータを導入して、演算性能を強化しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "アクセラレータのおかげで、機械学習モデルの訓練時間が大幅に短縮されました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "６８０３０搭載マシン購入のための貯金を崩し、Ｔ田はサードパーティのアクセラレーターと大型モニターを買った。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにより速いマイクロコンピューターを採用し、グラフィックスの処理をいっそう早めるためのアクセラレータを開発する。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
