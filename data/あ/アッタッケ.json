          "literary": [
            {
              "text": "去年ノ今頃モ修繕シタコトガアッタッケガ、ソノトキハ赤沢常造ノ奴ガイタカラ、半日デ片付イタモノダ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……舟木　アッタッケが来れば、今すぐにでも、転機を取る。",
              "citation": {
                "source": "冒した者",
                "author": "――Ｓの霊に捧げる――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、コヽニアノ爺サンノ墓ガアッタッケナ」ト、通リスガリニ立チ寄ッテ線香ノ一本モ手向ケテクレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
