        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アラツ」と、それを見た女の教師達は一齊に聲を擧げた。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "門内楽声（たとへば独逸国リヒヤルト、ストラウスがツアラツストラの曲の末段の如き）嵐の如く高まる。",
              "citation": {
                "source": "南蛮寺門前",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "読後晶子、ヅアラツストラを一日一夜に読み終り、その暁、ほつれし髪を掻上げて呟きぬ、「辞の過ぎたるかな」と。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "晶子の幻に見るは、ヅアラツストラの黒き巨像の上げたる右の手なり。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女「鞭を忘るな」とヅアラツストラは云ひけり。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "○「鞭を忘るな」とツアラツストラは云ひけり。",
              "citation": {
                "source": "そぞろごと",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ツアラツストラ」はどうしても讀めなかつた。",
              "citation": {
                "source": "二三の追憶",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヒルサン、アナタノ洋服ハ一度アラツタラドウデスカ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "君福助君の手だと思ふて嬉しさうに暫く握つて居つたが、実は横合いから手を突込んだ、僕の手だつだよと云つたら、アラツ！",
              "citation": {
                "source": "競馬興行と競馬狂の話",
                "author": "初代　桂小南",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
