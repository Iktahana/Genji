[
  {
    "uuid": "ead20ed4-2deb-56f5-a8c7-f99cbee771c4",
    "entry": "雨止み",
    "reading": {
      "primary": "あまやみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
