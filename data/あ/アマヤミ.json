    },
    "definitions": [
      {
        "index": 1,
        "gloss": "break in the rain",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨止みを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは雨止みについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "雨止みの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は雨止みの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では雨止みが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "雨止みという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に雨止みという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では雨止みについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "雨止みを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると雨止みは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "雨止みについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では雨止みが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に雨止みは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により雨止みの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "雨止みは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に雨止みは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "夕刻雨止みて一同にて手製の食事を終りブラッデイ氏邸へキネスコープの見物に赴く。",
              "citation": {
                "source": "サフランの花",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "うれしや、雨止みて、月出でたる也。",
              "citation": {
                "source": "層雲峡より大雪山へ",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻雨止みて一同にて手製の食事を賑々しく終へたる後、ブラツデイ氏宅へキネスコープの見物に赴く。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処にはまだ男の外にも、物乞ひらしい法師が一人、やはり雨止みを待ちわびてゐた。",
              "citation": {
                "source": "六の宮の姫君",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "この当事者と云う男は、平常私の所へ出入をする、日本橋辺のある出版｜書肆の若主人で、ふだんは用談さえすませてしまうと、※々帰ってしまうのですが、ちょうどその夜は日の暮からさっと一雨かかったので、始は雨止みを待つ心算ででも、いつになく腰を落着けたのでしょう。",
              "citation": {
                "source": "妖婆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨脚の強弱はともかくも、女は雨止みを待つもののごとく、静に薄暗い空を仰いでいた。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の心には刹那の間、あの古ぼけた教室の玄関に、雨止みを待っていた彼女の姿が、稲妻のように閃いた。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄帝の魃を下すや、此大風雨止み、蚩尤力を失いて殺さるるに至る。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "はいって、雨止みを待つがよい」「へいへい」　長庵と、長庵を送りに立った小姓とが、山城守の言葉に甘えてお部屋へ逃げ込もうとしていると、雨は一そう激しくなって、地面を打ち、樹々を叩いて、障子にも、ポツリ、ポツリ、大粒な水のあとが滲み出している。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "捧げるように両手で取って、「大助りです、ここに雨やみをしているもいいが、この人が、」　と見返って、莞爾して、「どうも、嬰児のように恐がって、取って食われそうに騒ぐんで、」　と今の姿を見られたろう、と極の悪さにいいわけする。",
              "citation": {
                "source": "縁結び",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "車を下りし時は霧雨やみて珍しくも西の空少しく雲ほころび蒼空の一線なお落日の余光をのこせり。",
              "citation": {
                "source": "おとずれ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「中秋は十四日より雨ふり、十五日夜九つ過には雨やみ候へども、月の顔は見えず、十六日は快晴也。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は兄妹を誘って向島の花見に出かけると、それほどの強い降りでもなかったが、その途中から俄雨に出逢ったので、よんどころなしに或る料理屋へ飛び込んで、二時間ばかり雨やみを待っているあいだに、赤座は妹の身の上についてこんなことを話した。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜に入って雨やみたれば、八時ごろ散歩。",
              "citation": {
                "source": "慈悲心鳥",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰ってはいるが、きょうは雨やみになっているので、半七はあさ飯の箸を措くとすぐに町内の生薬屋へ行った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "向島の寮",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨やみ、寝られず、寝静まった街へ出てベンチに一人腰かけ、噴水を眺めている。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者が笹の湯に遊んだのは十四年頃で　逞しき宿屋の傘を時雨やみ大根の葉へ我置きて行く　などその時も多数の作が残つてゐる。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時窓外雨やみて風になりたるとおぼし。",
              "citation": {
                "source": "病牀六尺",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の下人が、羅生門の下で雨やみを待っていた。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅生門が、朱雀大路にある以上は、この男のほかにも、雨やみをする市女笠や揉烏帽子が、もう二三人はありそうなものである。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者はさっき、「下人が雨やみを待っていた」と書いた。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから「下人が雨やみを待っていた」と云うよりも「雨にふりこめられた下人が、行き所がなくて、途方にくれていた」と云う方が、適当である。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人の下人が、羅生門の下で雨やみを待つてゐた。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅生門が、朱雀大路にある以上は、この男の外にも、雨やみをする市女笠や揉烏帽子が、もう二三｜人はありさうなものである。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "作者はさつき、「下人が雨やみを待つてゐた」と書いた。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから「下人が雨やみを待つてゐた」と云ふよりも、「雨にふりこめられた下人が、行き所がなくて、途方にくれてゐた」と云ふ方が、適當である。",
              "citation": {
                "source": "羅生門",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内に御影の狛犬が向い合っている所まで来ると、やっと泰さんが顔を挙げて、「ここが一番安全だって云うから、雨やみ旁々この中で休んで行こう。",
              "citation": {
                "source": "妖婆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨やみたるも、風冷ややかにして冬に入りたるを覚ゆ。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後雨やみたるも、風力さらに加わり、海潮を甲板上に打ち込むこと幾回なるを知らず。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "手近い空別莊のヴェランダに駈けこんで雨やみをしてゐたら、すつかり日が暮れてしまつた。",
              "citation": {
                "source": "手紙",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
