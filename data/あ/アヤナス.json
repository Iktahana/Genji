[
  {
    "uuid": "95762455-2f22-5273-ab0f-bfb38b6d6f2a",
    "entry": "彩なす",
    "reading": {
      "primary": "あやなす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
