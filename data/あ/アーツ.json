        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「フーネニホ、ホバシラニハータ、コヒガヰマス、ヒゴヒモヰマス……」　雨がザアーツと降り出して来た。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなものは仕方がありませんから捨てておしまいなすって、サアーツ新規に召し上れな。",
              "citation": {
                "source": "太郎坊",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてフランクストンとともにブリックリンはソフトウエアアーツ社を起こし、パーソナルソフトウエアを販売の窓口として、ビジカルクと名付けたソフトウエアを世に問うた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "予の卓子の周圍には二人の人――マスター・オヴ・アーツの學位を有する外電係と新しく社會部に入つた若い、肥つた法學士――とが集つてゐた。",
              "citation": {
                "source": "A LETTER FROM PRISON",
                "author": "‘V NAROD’ SERIES’",
                "note": "青空文庫"
              }
            },
            {
              "text": "不図私は、私の身近かに、「ギヤアーツ！",
              "citation": {
                "source": "驚いた話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に私も爆弾のやうに仰天して、「ギヤアーツ！",
              "citation": {
                "source": "驚いた話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアーツ、カアーツ！",
              "citation": {
                "source": "創作生活にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして私は、私のよりも凄まじい、わあアーツといふ悲鳴を感じた。",
              "citation": {
                "source": "創作生活にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アーツ』　と云ふなり一人の老人は腰をぬかしてしまひました。",
              "citation": {
                "source": "火つけ彦七",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "メルボルン市には約十日間滞在せしにつき、教授にも会見し内部の情況をも聞き及び候うが、第一に文学や哲学の専門科これなく、ただアーツの科目の下にて論理学、哲学を兼修するに過ぎず。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーツ科（古文学、歴史学、論理学および哲学、数学、近世語学）　右の諸学を、一年を限りまたは数年にまたがりて履修する課程に候。",
              "citation": {
                "source": "南半球五万哩",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アーツ、水だ、水だ！",
              "citation": {
                "source": "旱天實景",
                "author": "下村千秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかりがついてゐないから、真暗やみ、わづかに機関車がつけてゐるあかりが洩れて来るのと、後は沿線の電燈がパアーツ、パアーツと行きすぎにてらす位のものだ。",
              "citation": {
                "source": "汽車",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アーツ、天狗だあ！",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "十歳のときにケンブリッジの、トリニテイ・カレッジに遊学し、そこで一五八一年十四歳のとき、マスタア・オブ・アーツの学位を与えられた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
