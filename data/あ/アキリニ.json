        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "又真理の追窮は、かのブローテイナスをして、早くも地上生活中に、よく超現象の世界に遊ばしめ、更に真理の光明は、かのアレッサンドロ・アキリニイをして、よく烈々として、人を動かす熱語を吐かしめた。",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時のパドヴァにおける有名な教師はアキリニとポンポナッチ（ポンパナティウス）であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "２人ともピエトロと同じようにアリストテレス主義者でありアキリニはアヴィケンナと同じように「第２のアリストテレス」と呼ばれた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "アキリニはアラビア学の信奉者でありとくに哲学者アヴェロエスを高く評価していた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしアキリニはピエトロと違って解剖学者であった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
