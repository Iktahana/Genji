        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一はかざしに、二は胸に、さては御手に、『ゆくすゑ』のあらまし事の願ひにと、參らす花のあらばよい。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ま背後の板戸を締めてもらって、あらまし事の次第を承わるとしようじゃねえか。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "宇治の茶箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "折に触れては、我へそのあらまし事ほのめかしたまひ。",
              "citation": {
                "source": "葛のうら葉",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただのちのちのあらまし事といふは、父御の資産の幾分と、かの製薬会社とを、その奥様につけて譲り与へられむのみと聞くに。",
              "citation": {
                "source": "葛のうら葉",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "もちろん悪気などは少しもない女で、ごく単純にそう信じていたものらしい、おせんがあらまし事情を話すとすぐ納得した。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
