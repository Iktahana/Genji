        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これも近頃聞いた話であるが、稲の生長を助けるアゾトバクテルという黴菌がある。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「してみれば、私もまた一人のピコアゾーではあるまいか。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡の中の私の顔はまさにピコアゾーである。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フアゾムレス　アイズ！",
              "citation": {
                "source": "虚弱",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "産地　ニューゼーランドハワイアゾールス等諸島や南北｜冱寒の地は蛇を産せぬ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺アゾオッとしちゃった」「だからよ。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シワーシュの入江　クリミヤ半島の東岸にある細長い帯状の陸地に依つてアゾフ海より距てられた内海。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "その町の裏に出口のない湾みたいなアゾフ海があって、崖があって、人通りがありませんでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の生れたタガンローグの町は、アゾフ海のそばで、ロストフのそばで、其処にある家はいかにも小さな屋台店の持主らしい、つつましい四角い小家でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "写真の列は年代を追って、伸子の前にカザンの市の眺望を示し、アゾフ海岸の景色や、近東風な風俗の群集が動いているチフリス市の光景をくりひろげた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェホフの父は解放された農奴でタガンローグというアゾフ海の近くのどこかの町で屋台商人として生活していた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドン・バスの炭坑を見学したり、アゾフ海に面したタガンローグの町でチェホフがそこで生れて育ったつましい家などを見物して、二人がモスク※へ帰って来たのは十月であった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すくなくとも、タガンローグの蠅は、ワタシの鼻のあたまを知っている」　アゾフ海に向って下り坂になっている大通りのはずれに公園をもっているタガンローグの町は、チェホフの生れたところだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "少しおおげさに云えば、伸子と素子とは蠅をかきわけて食堂のテーブルにつき、アゾフ海名物の魚スープといっしょに蠅をのみこまないためには、絶えずスプーンを保護して左手を働かせていなければならない程だった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "タガンローグはアゾフ海に沿うた小さな町でアントン・チェホフの故郷なのである。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしてその時の起算点はアゾーレス群島の近傍であった。",
              "citation": {
                "source": "東西相触れて",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると犬は、ボネエ将軍路のほうを指して、一目散に駈けて行ったかと思うと、トモアゾン夫人の墓石のそばのところで、ピタリと停ってしまった。",
              "citation": {
                "source": "墓",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、それはエクアドルのチンボラアゾウとか、アルプスのモン・ブランほど高くもないし、またこの地方第一といわれる、わがグレイロック山にくらべても、まだずうっと低いものだった。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "この船は、「｜大西洋の真珠」と俗称されるアゾウレスとマデイラの南島から、材木やバナナを積んでくる。",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "パウラ・ベッカアは畫家オットオ・モオダアゾオンと結婚したが、その後間もなく産褥中に死んだ」と、英譯者Ｊ・Ｂ・レイシュマンは、「レクヰエム」の莊嚴なる一篇をもつてリルケがその死を哭した、その「或女友達」のことをノオトしてゐる。",
              "citation": {
                "source": "「鎭魂曲」",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼けてからじゃア錠の仕掛けが分らないかも知れないが、かほどの趣向を立てるからにゃアゾッとすくむところまでやりたいのが当り前というものだろうね」「ハッハッハ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十五　赤罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "同艦はその後アゾレスに回航し、そこでリバプールから来航した二隻の英船によって武器を供給された。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は母国に通信して、自分の不運を報告し、そして、スペインの艦隊が財宝運輸の護衛のためにアゾレ群島に向けて出帆したという情報をえたから、これからただちにその追跡に向かうつもりでいると書いた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "アゾレ群島にきてみると、スペイン艦隊の影もなかった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "フィリップ王が、次から次へ、奔流のごとく命令を発して彼らを激励している最中に、イギリス艦隊はアゾレ群島に向かったという情報がはいった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつもその小屋の中でぢつとしてゐる飼犬のアゾルまでも悲しさうに吼えたのださうです。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジヤツクが牛の咆えたのと、アゾルの鳴き声の事を話したらう。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般の意見によれば、シャール・ロアゾン氏は本世紀を通じての天才だということであった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにロアゾン飛ぶとても、足あることを人は知る。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い山は雲に掩われたり近い前山の蔭になったりして、あの心を唆る雪の姿は牛首山あたりに少し光っているのが眼に入ったのみで、黒部の本流も亦出入の激しい幾重の山裾に深く包まれて、唯一箇所赤茶化た崖の下に青白い水面をチラと覗い得たに過ぎなかった、アゾ原あたりであったろうか。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
