          "literary": [
            {
              "text": "アペルシン〔みかん類〕を買う。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、ГОТОБ〔国立歌劇舞踊劇場〕第一へ行って「アペルシンの三つの恋」を見た。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十日　第一ГОТОБ〔入場券、配役表貼付〕「三つのアペルシン〔オレンジ〕恋」　ソヴェートの「五年計画」「社会主義競争」「チーストカ」は第一ГОТОБに最も必要だ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈な皇子がアーアー　アアアア、アーア　アアアアと歎息して居るところを魔女にささやかれて三つのアペルシンをさがしに出かけて、その中から出て来た女を得て安心してアーアーアーをやめるというきわめて非ソヴェート的なお伽噺を、光線、音楽その他で羅列するのだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
