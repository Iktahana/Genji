[
  {
    "uuid": "442254ad-6105-544e-ba99-abad1e9c1f7c",
    "entry": "相手",
    "reading": {
      "primary": "あいて",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
