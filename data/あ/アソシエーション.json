        "examples": {
          "standard": [
            {
              "text": "地域住民が主体となって、子供たちの防犯のためのアソシエーションが結成された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "その研究者は、長年の功績が認められて国際的なアソシエーションの理事長に就任した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "データマイニングにおいて、顧客の購買履歴から商品間のアソシエーション・ルールを抽出する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それは、三造の高等学校を卒業する年で、ちょうどその少し前に、彼は、学校で蹴球（アソシエーション）をしていて、顔を蹴られ、顔中｜繃帯をして病院へ通っていたのであった。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで調査研究機関は、政府の束縛をうけないで、自由な立場で真実を探求するところにその妙味があるのであって、それがためにはヴォランタリイ・アソシエーションの形態が望ましいのである。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "（テッド・ブルーチェル、ジ・アソシエーションズ）　身のまわりでなにがおこりつつあるかに関してもっと敏感にならなくてはいけない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ラリー・ラモス、ジ・アソシエーションズ）　フィルモア・イーストがつくられたとき、椅子はとりはらわれるはずだった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
