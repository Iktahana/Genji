        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "揚げ出しの例文",
              "source": "幻辞"
            },
            {
              "text": "このそば屋の揚げ出しは絶品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "揚げ出しのような軽い料理が食べたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "上野の揚げ出しとか、日本橋室町の花村とか、昔から決っているうちである。",
              "citation": {
                "source": "河明り",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ズドーン　ズドーン　といっても、本来はコケおどしで、海岸で急に花火を揚げ出したまでのことですが、その花火も示威脅迫の音を含んでいることは勿論で、今の二三発は確かに上へ向けて放ったが、やがてその次は、また最初のようにこちらへ向けて飛び込ませないとは限らない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、少くも微風よりも強い風が吹き初めて、砂塵を揚げ出したら、その瞬間から、僕は蒼空の徒らに蒼きを憤って、雨を想い、雨を呼ぶようになる。",
              "citation": {
                "source": "雨の日",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "近くは、揚げ出しも復活したとかきいた。",
              "citation": {
                "source": "ああ東京は食い倒れ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "畳を揚げ出したのである。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれまでの声なき波濤は、ここで初めてわああッと物凄い咆哮を揚げ出した。",
              "citation": {
                "source": "私本太平記",
                "author": "黒白帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ね……ちくしょうめ、胸がどきどき変な音をあげだしやがった。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "物音に驚いた鴉共が、雑木の梢で不吉な声をあげだした。",
              "citation": {
                "source": "三狂人",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚出しの名物で、生揚げ豆腐におろしをそえ、たっぷりとしたじのかかった「あげだし」は、師匠も父も大の好物であったから、これだけは幾皿も重ねて、一本の銚子をながいことかかって酌みかわすのであった。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おお、機はいよいよ高度をあげだしたぞ」　そばに、高度計がかかっていたが、その指針は、生きもののように、ぐるぐるうごきだした。",
              "citation": {
                "source": "氷河期の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすがに庭の群衆も動揺して喧噪の声をあげだした。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "一火は、取るにたらないことばと聞きながして、さっさと引きあげようとしたが、徳川家のほうからは一｜刻ましに味方があつまって、わざとことをもつれさせるように、石見守の尾について、ごうごうと苦情の声援をあげだした。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そのあいだにも、曹操の陣中では、いよいよ兵糧総官の王垢も悲鳴をあげだしていた。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともね、すぐその前、あすこで――私はお約束の大時計より、大変な後れ方ですから、俥をおりると、早廻りに、すぐ池の端へ出て、揚出しわきの、あの、どんどんの橋を渡って、正面に傘を突翳して来たんでしょう。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野の山も、広小路にも、人と車と、一斉に湧き動揺いて、都大路を八方へ溢れる時、揚出しの鍋は百人の湯気を立て、隣近な汁粉屋、その氷月の小座敷には、閨秀二人が、雪も消えて、衣紋も、褄も、春の色にやや緩けたであろう。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "車は「揚出し」の前を過ぎて進んで往た。",
              "citation": {
                "source": "熊手と提灯",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの足はいつしか池を半周して揚出しの横にかかっていた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が世に在った頃、よく加福の師匠に案内されてこの揚出しだの、山下の鶴のいる牛肉屋だので夕飯の馳走にあずかったものであつた。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "池に面した揚出しの古びた格子窓を眺めやりながら、ふっと、その内らから老人ふたりの徐かな話し声が洩れてくるような気がして耳をすましてみたが、聞えるのは客を送り迎える小女たちの嗄れて甲高い声ばかりであった。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
