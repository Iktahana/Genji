          "literary": [
            {
              "text": "ソノアナタガ私ガ今誰ヲ又愛シヨウト、何モ云ウ権利ハナイ筈ダワ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モンコチヤン　アナタガボンコチヤンヲカブツテヰルカツカウハトテモヘンダワ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタガ僕ニ泣キ言ヲ云ウノハイイ、シカシソノ泣キ言ヲ、―――アナタ自身ハ泣キ言ノ積リデハナイカモ知レナイガ、―――何故僕ニ云ウ代リニ夫ニ向ッテ云ワナイノカ、ソレガアナタニ出来ナイト云ウノハ、世ニモ不幸ナ人ガアレバアルモノダト思ッテアナタノタメニ一掬ノ涙ナキヲ得マセン。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当分オ目ニ懸リマセンガ、イズレアナタガ新夫人トナラレタ暁ニ改メテ拝顔ノ機会ノアルコトヲ望ミマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「先生が御迷惑でなかったら……」「カマイマセン、アナタガ聞キタケレバ……よろしい！",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテアナタガ“存在者”トシテ目覚メタ今、コレマデアナタノ意識ニ投影シタ架空ノ世界ハ幕ヲ閉ジタノダ」　あなたは何かしら名状し難い虚無感に苛まれる。",
              "citation": {
                "source": "人生は擬似体験ゲーム",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
