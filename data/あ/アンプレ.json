        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アンプレッショニストのような絵も描いている。",
              "citation": {
                "source": "模倣と独立",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもアンプレショニストのそれの如く極めて柔かです。",
              "citation": {
                "source": "木下杢太郎著『唐草表紙』序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてヒトラーが画家として立ったなら、むしろ穏健な、さりとて古くない、ポストアンプレッショニストとして彩管を揮ったことだろうと思った。",
              "citation": {
                "source": "ヒトラーの健全性",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまた今｜悶えの底に沈んでいるひとりの妹の宅に寄るのにも、どんなにその家の貧しさから生ずるアンプレザントなことをきろうて、またひとりの叔父のかたくなな性質に触れることをいとうために妹を愛する心を鈍くしたかもしれません。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の右側の紙屑籠の中から見出された注射器と、空になったアンプレの四五本と、左の手首に赤くはれ上った注射の跡とによって、文夫さんは自殺と決定されました。",
              "citation": {
                "source": "蛇性の執念",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自殺と見せかけるために、注射器やアンプレを屑籠に投げ込んだのではございますまいか。",
              "citation": {
                "source": "蛇性の執念",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モヒ中毒にかかっていた叔父様は、自分用の注射器とアンプレを残して立ち去ったのだそうですの」",
              "citation": {
                "source": "蛇性の執念",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "机の抽出しにはモルヒネのアンプレも入っています。",
              "citation": {
                "source": "消えた霊媒女",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
