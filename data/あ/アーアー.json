        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "アーアーと勝坊合点して、　「この人が落したんだよ」　と商人を指で示す。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　武蔵が「ハイＴ「吉岡憲法先生の　吉岡流を少々ばかり」　団九郎、ウンウン、アーアー。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨウヤク目ヲサマスト、オ母ッチャハ、アーアーモウ長クナイヨ、ト云ウノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーアーいやになってしまう。",
              "citation": {
                "source": "煩悶",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々アーアーという歎声を漏らす人もある。",
              "citation": {
                "source": "病",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈な皇子がアーアー　アアアア、アーア　アアアアと歎息して居るところを魔女にささやかれて三つのアペルシンをさがしに出かけて、その中から出て来た女を得て安心してアーアーアーをやめるというきわめて非ソヴェート的なお伽噺を、光線、音楽その他で羅列するのだ。",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな姿をして、頭髪をおかっぱのようにして、中には胸にあぶらやのような茶色の切れをかけていた――お茶盆をもって、アーアーと節をつけて、店のはなっさきを行ったり来たりしていたからだ。",
              "citation": {
                "source": "大丸呉服店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーアーというのは、おはいりという事なのだといったが、眺めていると好い気持ちではなかった。",
              "citation": {
                "source": "大丸呉服店",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌劇「道化師」がお得意なのですがこのオペラの開幕にうたう有名な「序詞」の最後のところに、「アンドイアン、コンミンチアー」　というところの「コンミンチアー」を誰でもそのままうたうのですが、このテイタルフォは「コンミンチアーアーアー」とアーを三つものばして平気でうたう。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんな勢一杯の力を出してもアーと一度しかうたえないのに、アーアーアーと三つものばせるお化みたいな息の持主なのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて一人の女形が出てイーイーアーアーと唱った。",
              "citation": {
                "source": "村芝居",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "（アーアーアーと何かうなり出す。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木山は、歌詞が日本語では歌えないのか、メロディだけをアーアーアーとやっていたが、やがて、口笛で合せる。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "強いて延ばしてやるとすれば、アーアーと途中であくびをくって味噌をつけるくらいが関の山でさあ。",
              "citation": {
                "source": "初看板",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アーアー」　群集はただ、こう口からもらしただけであった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月三十日（月曜）　吹込が気になって朝早く眼がさめる、アーアーと言ってみる、声は大丈夫らしい。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴してアーアーと声を出してみる、悪くはなってゐない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アーアー、睡くなって来た」　話しかけた少女は長い欠伸をしたかと思うと、これも目を細くして、動かなくなってしまった。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アーアー、いやだいやだ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
