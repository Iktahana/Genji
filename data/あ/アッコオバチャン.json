        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大きいということが云えず、アッコオバチャンと云い、コの音の出しようをクの間のように喉音で出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はカゼがなおって遊びに来て、「アッコオバチャン、おぽんぽが痛くなくなったらアボチャン、トシマエンヘツレテッテヤルヨ」と大いに慰めてくれました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アッコオバチャン送りにゆくかときいたら行くと云ったということで両親ついて来た。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アボチンからも、アッコオバチャンのオジチャンに「よろしくって云ってね」の由。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな心配をして、お七夜さわぎをして、夜番をするのだからアッコオバチャンだって気もたつわ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四二年（昭和十七年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（筆者註、アッコオバチャンは口だけ達者で困りますヨ！",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "さらにいじらしいことには、小さい小さいのし紙を胸に下げて、そこに「アッコオバチャン」「ヤスコ」と書いた一寸ほどのもんぺをはいたコケシ人形が現れました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたらね、太郎はよほど感ずる処があったとみえて、次の日みんなの居るとき、真面目くさって「アッコオバチャン、今年の夏も病気するといいね、みんなが水瓜を持って来てくれるから。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ずっと私は其処に坐って、アッコオバチャンらしく、例えまざった御飯にしろ美味しいようにみんなによそってやっていたのよ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎はアッコオバチャン！",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやと思っていると「アッコオバチャン、解除ですって！",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
