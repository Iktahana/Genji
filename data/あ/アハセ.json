          "literary": [
            {
              "text": "「ワタシハ　ナント　イフ　フシアハセナ　モノデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナノ　モノハ　タメイキヲ　シテ　カホヲ　ミアハセマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ後漢書ニハ、之ヲアハセテ「自女王國、東渡海千餘里、至狗奴國、雖皆倭種、而不屬女王」ト改メタリ。",
              "citation": {
                "source": "倭女王卑彌呼考",
                "author": "白鳥庫吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "新考のアハセ説は、第四句の「相将」が、古鈔本中（嘉・類）に、「相為」になっているためであった。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "是を仕事着というのは普通だが、土地によってノラギまたはヤマギモノ（越後）、海で働く者は沖ギモノ・沖アハセとも謂う。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アハセもしくはオカズという副食物も、大体に手数のかからぬ物をきめて、いつも同じような献立をくりかえしていた。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
