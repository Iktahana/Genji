          "literary": [
            {
              "text": "僕はこれへチョコレートを煮て加えたり、あるいは胡麻を加えたり、レモンを加味したり、バニラ、アルモンド、シンナモン、ナットメックなんぞと色々な味をつけて楽みにするが家庭の慰みには極く好いよ。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○バニラとアルモンドは香料なり。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "○バニラ一オンス入三十銭、アルモンド同四十銭なり。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            }
