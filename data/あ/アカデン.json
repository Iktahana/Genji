        "examples": {
          "standard": [
            {
              "text": "返品された商品の処理をするために、経理担当者が赤伝を切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "入力ミスが発覚したため、正しい金額で再入力する前に一度赤伝で取り消した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "月末の伝票整理で、山のような赤伝を一枚ずつ確認していく作業に追われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
