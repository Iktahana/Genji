  {
    "uuid": "781d3191-7228-58a9-9b75-26ed6fcc1594",
    "entry": "預かり物",
    "reading": {
      "primary": "あずかりもの",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
