        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "移転先は病院へも秘密にし、そして「俺ハ考ヘル所ガアツテ好キ勝手ナ生活ヲスル。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラ　花タチハ　ジブンタチノ　スガタヲ　ナガメアヒ、ジブンタチカラ　ナガレデル　ニホヒヲバ　カギアツテ、ジブンタチガ　ミナ　オナジヤウニ　キイロイ　キモノヲ　キテ　ヲリ、ホカノ　木ヤ　クサニ　マケナイホド　ウツクシイノヲ　シツテ　イツソウ　ヨロコビアヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフハ　花トハ　チガヒマス、オハネガ　アツテ　アチラ　コチラ　トビマワル　コトガ　デキマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ、ホカノ　ヒトニハ　トウトイ　モノデ　アツテモ、ジブンニハ　チツトモ　トウトクナイ　コトモ　アルノダ、ト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノヨウナモノガナゼカタカナニツイテ論ジタリスルノカトイウ不審ガアルカモシレナイガ、コウイウフウニ自分ノ専門以外ノコトニ口出シヲシテ人ニ迷惑ヲカケルコトハ当今ノ流行デアツテ何モ私ノ創意ニヨルコトデハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、コウイウ国ガラデアツテミレバ、タマタマ私ガ少シクライ畠チガイノコトニ口出シヲシタトコロデメツタニ苦情ヲイワレル筋合イハナイハズデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハアクマデ意見デアツテ実際運動デハナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "『イーズレル――イーズレル――アツテーキ――アツテーキ――イーズレル――バルトーラ――マッシーモ――アツテーキ――イーズレル――……ちょっ、畜生！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "花もうつろふ仇人の浮気も恋といはしろの結び帛紗の解きほどきハリサ、コリャサ、よいよいよい、よいとなアツテチン、ツテチン　心なき門附けの女の歌。",
              "citation": {
                "source": "大菩薩峠",
                "author": "東海道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテソコデ、カヽル便宜ヲ得ル方法如何デアルガ、コレ本社ガソノ奉仕的企画ヲ今公表スル所以デアツテ、最モ簡単ニ諸君ヲ納得セシメルノハ、恐ラク左ノ画期的ナ数字デアラウト信ズル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オモテニハ　タタミガ　ズラリト　ナラベテ、タテカケテアツテ、　トン　トン、バタ　バタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡ニアツテ繁ニアラザルナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ子アツテ集ナシ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "味至テ辛ク可食偶々浅瀬ニアツテ擡起スレバ秋花アリ。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蕾ニアツテハ尖ニ淡紅暈ヲミル。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八日見という山名の起原に就ては、河原沢村の所伝に従えば八日見山ト申ハ、日本武尊東夷征伐ノ時、東国ノ海陸御巡幸有テ、夷賊追伐ノ御祈トシテ筑波山ニ登ラセタマヒ、遥ニ御覧アツテ、衆山相連ナレル中ニ殊ニ秀タル瞼山戌亥ニ当テ有リ、八日以来、見ヘタリト宣シヨリ、山ノ名ヲ八日見山ト名付ケ給フトナリ。",
              "citation": {
                "source": "二、三の山名について",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "七歩隔千万里　と、題して、豆ヲ煮ルニ豆ノ箕ヲ燃ク豆ハ釜中ニアツテ泣ク本是レ同根ヨリ生ズ相煮ル何ゾ太ダ急ナル　有名な魏の曹植の「七歩詩」である。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「梅松論」がいう――当夜、矢矧ニ御着アツテ、京都鎌倉ノ両大将御対面、久々ナル御物語リ、尽クトモ見エズ――とある一条の短夜は、こうして、あわただしいまにすぐ白む。",
              "citation": {
                "source": "私本太平記",
                "author": "風花帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
