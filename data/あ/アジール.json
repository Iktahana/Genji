        "examples": {
          "standard": [
            {
              "text": "中世のヨーロッパにおいて、その修道院は罪人すら保護されるアジールとして機能していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "激しい競争社会に疲れた彼にとって、週末に過ごす山小屋だけが唯一のアジールだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "かつてこの広場は、国家の権力が及ばない自由なアジールとして多くの芸術家を集めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そこにあるのは舊石器時代の最後の頃であるオリニヤック期のもので、その次ぎに來るのが、舊石器時代から新石器時代に移つて行く中間のアジール期のものです。",
              "citation": {
                "source": "博物館",
                "author": "濱田青陵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
