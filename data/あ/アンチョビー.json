        "examples": {
          "standard": [
            {
              "text": "アンチョビーを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちはアンチョビーについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "アンチョビーの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生はアンチョビーの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化ではアンチョビーが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "アンチョビーという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中にアンチョビーという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社ではアンチョビーについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "アンチョビーを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によるとアンチョビーは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "アンチョビーについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野ではアンチョビーが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的にアンチョビーは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展によりアンチョビーの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "アンチョビーは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的にアンチョビーは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "「アンチョビーが一三〇〇円。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スイカや白玉ていどのおまじないじゃ、きかないんじゃないか」　高志が、手早くアンチョビーを皿から引きはがした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがルールらしいので、慶一もアンチョビーをとりながら口を開いた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞之助達は、テーブルの上に数々の前菜、―――いつの間に用意してあったのか、鮭の燻製、アンチョビーの塩漬、鰮の油漬、ハム、チーズ、クラッカー、肉パイ、幾種類ものパン、等々がまるで魔術のように一時に出現して置き切れぬ程に並べられた光景を見ると、先ずほっとした形であった。",
              "citation": {
                "source": "細雪",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "特大のアンチョビー・ピザをひとつ取り、三人で食べた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それから焙玉子にアンチョビの……。",
              "citation": {
                "source": "巴里のキャフェ",
                "author": "――朝と昼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも上等にすると赤茄子ソースかアンチョビソースを掛けて出します。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十五　アンチョビトース　は味の好いもので、玉子二つとバター中匙半分と牛乳中匙一杯とアンチョビ中匙八分目と塩胡椒少しとを皆んな一つに混ぜ合せて鍋の中でよく炒ってトースパンへ載せます。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンチョビとは小魚で拵えた煉物のようなもので食品屋にあります。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アンチョビイと、ケルチ（訳注　クリミア半島の東端）のニシンとだ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "有毒なアンチョビ・ソースとその検出法　我々が調べたこの魚ソースの幾つかのサンプルは鉛で汚染していた。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンチョビトースト、此処のプリゼンテーションのうまさ、しみ／″＼酒を飲んでる気持になる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「更にピクルス、更にアンチョビまで付けるなんて。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            },
            {
              "text": "この魚ソースの作り方は、崩したアンチョヴィをすりばちですりつぶす。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アンチョヴィを２ポンドから４ポンド半。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ＢＷハイボール、アンチョヴィトースト。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
