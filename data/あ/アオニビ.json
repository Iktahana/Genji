    "definitions": [
      {
        "index": 1,
        "gloss": "grey tinged with green",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
