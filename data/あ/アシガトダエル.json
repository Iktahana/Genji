        "examples": {
          "standard": [
            {
              "text": "品質低下により客の足が途絶えて、閉店のしか道がなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "台風で道路が寸断され、この地域への観光客の足が途絶えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "駅前開発で競争が激化し、古い商店街の客足が途絶えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは、或る家では最も客が込むけれど、或る家では妙に客足が途絶えることのある、一寸合間の時間だった。",
              "citation": {
                "source": "野ざらし",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
