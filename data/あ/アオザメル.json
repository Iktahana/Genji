    "definitions": [
      {
        "index": 1,
        "gloss": "to become pale",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "事故の知らせを聞いた瞬間、彼女はさっと顔が青ざめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼はひどい船酔いで、すっかり青ざめて甲板に座り込んでしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「どうしたの、幽霊でも見たみたいに青ざめた顔をして」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "俊寛　（青ざめる）そんなはずはありません。",
              "citation": {
                "source": "俊寛",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の核心は青ざめる。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "左衛門　（青ざめる）私に見せてください。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔の色も日にまし青ざめる。",
              "citation": {
                "source": "クラリモンド",
                "author": "LA MORTE AMOUREUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "とっさに私は何のことか理解できなくてキョトンとしていましたが，やっとどうやら“ペール”という言葉の持っている“悪いしらせを受けてショックで青ざめる”という状態を“青”という色に感ずるのは日本人だけの独特の感覚で，外国人は“白くなる”と感ずるのだということが分りました。",
              "citation": {
                "source": "“青い顔”",
                "author": "間所紗織",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　次郎は顔が青ざめるほどおどろいた。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々青ざめることもあったが、十九世紀の始めや十八世紀の終わりに早くから名を知られたある種の青年らのように、若い娘のようないきいきした有り余った若さを持っていた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "明智は、不二子の顔色がサッと青ざめるのを見た。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッ」という叫び声、見る見る青ざめる顔、恐怖に戦く唇、箱の中の一物を見ると、川村は思わずタジタジとあとじさりをした。",
              "citation": {
                "source": "白髪鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "たださえ青白い顔が、酔うと一層青ざめる。",
              "citation": {
                "source": "月と手袋",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ごろは小指の血にすら色青ざめる女院にしてさえ、いつか兵の血まみれ姿にもさまでなお感じもなくなっていた。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
