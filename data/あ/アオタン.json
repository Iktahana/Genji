        "examples": {
          "standard": [
            {
              "text": "昨日階段で派手に転んでしまい、膝に大きな青タンができてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "弟は友達と喧嘩をして、目の下に青タンを作って帰ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "机の角で太ももを強く打ち、触ると痛い青タンができている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
