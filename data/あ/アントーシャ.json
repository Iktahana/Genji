          "literary": [
            {
              "text": "アントーシャに信用を失わせた点だけでも困ったことだ。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "обед をすまして直ぐソコリスキーへ出かけたが、幸アントーシャにはまだ話してなかった由。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "前期はアントーシャ・チェーホンテという筆名をもった一時代で、つまり初期のユーモア作家としての活動期である。",
              "citation": {
                "source": "チェーホフ試論",
                "author": "――チェーホフ序説の一部として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "前者はアントーシャ・チェーホンテという筆名をもって蔽われる一時代で、つまり初期のユーモア作家としての活動期を示す。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……これがアントーシャ・チェーホンテ時代のあらましである。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェーホンテは初めからチェーホフであったし、アントンは終りまでアントーシャであったわけだ。",
              "citation": {
                "source": "チェーホフ序説",
                "author": "――一つの反措定として――",
                "note": "青空文庫"
              }
            }
          ]
        }
