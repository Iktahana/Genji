        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "夢か、犬かと、思ったのが薄汚れた、赤袴です。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤袴の這身で忍んで、あらかじめ、お冬さんの衣桁にも掛けず嗜んで置いた、帯を掴み出していたのです。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼が折花攀柳の遊宴を恣にしたるが如き、彼が一豎子の私怨よりして関白基房の輦車を破れるが如き、将彼が赤袴三百の童児をして、飛語巷説を尋ねしめしが如き、平氏が天下に対して其同情を失墜したる亦宜ならずとせず。",
              "citation": {
                "source": "木曾義仲論（東京府立第三中学校学友会誌）",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで境内で鹿を放し飼いにしておくような要領で、この神社の山上高くて広々した境内のあッちこッちに、白衣赤袴の娘さんの幾群かが庭掃除をしていたり、サイセン箱をのぞいていたり、散歩していたり、放し飼いにしてあるね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下は安産にからまるモロモロ、たとえば結婚式にまでさかのぼッて取り扱い、さてこそ白衣赤袴の娘さんが続々と入用なのだそうだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
