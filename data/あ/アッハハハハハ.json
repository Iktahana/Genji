          "literary": [
            {
              "text": "「アッハハハハハ、弱い奴らだ」紋太夫は大声で笑い出した。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アッハハハハハいまのはじょうだんだよ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アッハハハハハ」と才蔵は、それを聞くと笑い出した。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、橘は突然大きな口を開けて、「アッハハハハハ」　と笑い出した。",
              "citation": {
                "source": "火繩銃",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
