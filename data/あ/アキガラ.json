        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "海岸を散歩していると、美しい模様の貝の空き殻をいくつか拾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の木の枝に、蝉の空き殻が夏の終わりの名残として残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "卵の空き殻を細かく砕いて、家庭菜園の肥料として土に混ぜた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "弁当の空き殻には、白い飯が、ろくに箸もつけず、残って来るし、料理屑は、どんどん捨てるし、これじゃ、野良犬が殖えるはずだと思った。",
              "citation": {
                "source": "脚",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "法律の箇条書で一杯詰つてゐる筈の頭は、案外空つぽだつたと見えて、缶詰の空殻を投げたやうに、かんと音がした。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "店に捨てた多くの空殻を集めて小児が積み上げ、その上に蝋燭を点し、行人に一銭を乞いてその料とす。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃の彼は、蝉の空殻のやうであつた。",
              "citation": {
                "source": "鏡地獄",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度其女房が箕を振る度に、空殻の塵が舞揚つて、人々は黄色い烟を浴びるやうに見えた。",
              "citation": {
                "source": "破戒",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝えうべき者はただ抽象的空殻である。",
              "citation": {
                "source": "善の研究",
                "author": "西田幾多郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今も私は空殻のやうになつて呆然とあの愚かな夢を追ひながら、せめてもあの間の始末書を書かうと思ひ立つたのである。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "年を重ねるに伴れて、単に若気の亢奮に駆られてゐるらしい空々しい血気が消え失せたならば、これも屡々他人から云はれた通り、阿呆な空殻になつてしまふであらうと、臆病な私は怖れてゐた。",
              "citation": {
                "source": "素書",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "未来も過去も内容なき空殻である。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は骨の抜けた、たましいのない空殻のような交渉を二人の間に残すに忍びなかったからである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "壇の浦で有名な平家蟹などは八本ある足の中の四本を用いて、蛤のごとき貝の空殻を背負い、他の四本で匍うている。",
              "citation": {
                "source": "自然界の虚偽",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "静止するとあたかも泥の上にただ貝の空殻だけが落ちているごとくに見えて、そこに生きた蟹がいるとは誰も気がつかぬ。",
              "citation": {
                "source": "自然界の虚偽",
                "author": "丘浅次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
