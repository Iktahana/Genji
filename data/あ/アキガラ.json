        "examples": {
          "standard": [
            {
              "text": "海岸を散歩していると、美しい模様の貝の空き殻をいくつか拾った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の木の枝に、蝉の空き殻が夏の終わりの名残として残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "卵の空き殻を細かく砕いて、家庭菜園の肥料として土に混ぜた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "弁当の空き殻には、白い飯が、ろくに箸もつけず、残って来るし、料理屑は、どんどん捨てるし、これじゃ、野良犬が殖えるはずだと思った。",
              "citation": {
                "source": "脚",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
