[
  {
    "uuid": "7024420c-05e6-5c47-a357-dc5baedbf2d9",
    "entry": "隘路",
    "reading": {
      "primary": "あいろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
