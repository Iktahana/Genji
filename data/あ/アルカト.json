          "literary": [
            {
              "text": "』446　一は自方のヒュプセーノール、三はオトリュオニュウス、アーシオス、アルカトース。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "495かくてトロイア軍勢はアルカトースの身のめぐり近く、長槍手に取りて進めば凄く胸の上、青銅鳴りて彼と此、兩軍互に相覘ふ、中にも著き二勇將、共にアレース軍神に比すべし、こなたアイネ，アス、あなた名將イドメネー、　500互に敵を屠るべく凄き槍もて向ひ合ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノミナラズ、モデルガ誰デアルカト云ウコトヲ彫リ手ニ知ラセズニ彫ラセルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ガコレラヲ撮ッタ目的ハ何ニアルカトイウト、第一ハ撮ルニ愉悦ヲ覚エタカラダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
