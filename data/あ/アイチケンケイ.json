          "standard": [
            {
              "text": "愛知県警のパトカーが、スピード違反の車両をサイレンを鳴らして追跡した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は愛知県警の刑事として、日々難事件の捜査に東奔西走している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "愛知県警が主催する交通安全教室に、近所の子供たちと参加した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "社会大衆党は之に対して抗議書を発表して曰く、「愛知県警察部は本年夏頃より県下の労働組合に対して日本主義に転向を強要し、特に日本製陶労働組合同盟に対し執拗に分裂を策しつつあり。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
