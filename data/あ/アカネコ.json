        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それで一｜匹は赤猫、一｜匹は白猫です。",
              "citation": {
                "source": "葛の葉狐",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ハ）焚かれし魔神の灰の赤きは赤猫、黒きは黒猫、白きは白猫となれり。",
              "citation": {
                "source": "比較神話学",
                "author": "高木敏雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭に迷ひこんで来たキジ猫を「キシロ」といひ、赤猫は「アカ」で、白猫は「マシロ」、赤猫の子どもを「コアカ」といふやうに。",
              "citation": {
                "source": "仔猫の「トラ」",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの木に私の大事な赤猫が駈け上がつて遊んだこともある。",
              "citation": {
                "source": "三本の棗",
                "author": "片山廣子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は福田氏が飼っている、純白の雄猫なのだが、それが全身に血潮をあびて、物凄い赤猫と化けてしまったのだ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何と　きれいな　赤ねこだ。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界一の　赤ねこだ。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると　白ねこの　赤ねこは、とことこと　おふろばに　はいって　来て、おぢいさんの　かほを　見ながら、にやあご……と、なきました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ぶるぶると　身ぶるひ　しますと、今まで　まっかだった　赤ねこが、もとの　まっ白な　白ねこに　なって　しまひました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たらひに　おゆを　いっぱい　入れて、その　中に　白ねこの　赤ねこを　入れ、かめのこだはしで　ごしごし　あらひましたが、白く　なりませんでした。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんは、赤ねこの　だいすきな、おさかなの　やいたのを　もって　来て　よびましたが、なかなか　おりて　来ません。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、大ぜいの　人が、赤ねこを　見て　めづらしがって　あつまって　来ました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「赤ねこなんて、はじめて　見たよ。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに　赤ねこは、やねの　上から　のこのこ　おりて　来ました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おばあさんは、いそいで　だきあげて　お家へ　はいりましたが、大ぜいの　人たちも、赤ねこを　見ようと　して、わあわあ　お家の　中まで　はいって　来ました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで　おぢいさんは、その　くわぞくさまに　でんわを　かけて、あの　赤ねこは　ほんたうの　のらねこで、白ねこを　赤インキで　そめて　あるの　だから、五十銭の　ねうちも　ないものだと　いふ　ことを　はなしました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから　まもなく、白ねこの　赤ねこが、はじめて　ついて　来た　あき地に、大きな　バラックの　家が　たちました。",
              "citation": {
                "source": "赤いねこ",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
