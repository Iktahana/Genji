  {
    "uuid": "4b918703-f59d-50af-bec3-b25dca917c13",
    "entry": "有り様",
    "reading": {
      "primary": "ありさま",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
