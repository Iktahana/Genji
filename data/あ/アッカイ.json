    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしよしや大智深智でないまでも、相応に鋭い智慧才覚が、恐ろしい負けぬ気を後盾にしてまめに働き、どこかにコッツリとした、人には決して圧潰されぬもののあることを思わせる。",
              "citation": {
                "source": "鵞鳥",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "圧潰した様に二列に列んだ茅葺の屋根、其処からは鶏の声が間を置いて聞えて来る。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、渠は怎したものか、それを胸の中で圧潰して了つて考へぬ様にした。",
              "citation": {
                "source": "病院の窓",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "滅茶々々に圧潰されたシルクハットが一段と悲惨さを添えていた。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "埃まみれの亜鉛屋根は圧潰されたやうになつてゐるので、そのなかにゐる人間も圧潰されたやうな姿で、家の外に出て来る。",
              "citation": {
                "source": "かげろふ断章",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はそのために圧潰されそうになっているのだ。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕はそのために圧潰されさうになつてゐるのだ。",
              "citation": {
                "source": "鎮魂歌",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬もあるかもしれない、慥かに、森とおいちとをひとつにした想像は、呼吸を止められ、胸を圧潰されるような苦しさだった。",
              "citation": {
                "source": "つばくろ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "壓潰した樣に二列に列んだ茅葺の屋根、其處からは※の聲が間を置いて聞えて來る。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
