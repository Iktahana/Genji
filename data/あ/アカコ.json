          "literary": [
            {
              "text": "アカコをやきもちやいて、「お母ちゃまは何故赤コばっかり可愛がるの」と云うそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "林町のアカコはね、まだ頭の湿しんが快癒しないので、見参不可能です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういうのよ、この頃の世の中一様に）その前へアカコの脚をすっかり出してねかして、まるでうれしそうに脚を動して笑うのをよくよく眺めて来ました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
