        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "在昔大名高家の子供に心身｜暗弱の者多かりしも、貴婦人が子を産むを知て子を養育する法を忘れたるが故なり。",
              "citation": {
                "source": "新女大学",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の心身の暗弱四肢耳目の不具は申すまでもなく、一本の歯一点の黶にも心を悩まして日夜片時も忘るゝを得ず。",
              "citation": {
                "source": "新女大学",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "萬一斯かる事あらんには、大納言殿（宗盛）は兄の内府にも似ず、暗弱の性質なれば、素より物の用に立つべくもあらず。",
              "citation": {
                "source": "瀧口入道",
                "author": "高山樗牛",
                "note": "青空文庫"
              }
            },
            {
              "text": "（坂井虎山の厩戸論）また、他の漢学者は、「ああこれ、一暗弱の太子のみ。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこれ、一暗弱太子のみ。",
              "citation": {
                "source": "天皇",
                "author": "誰が日本民族の主人であるか",
                "note": "青空文庫"
              }
            },
            {
              "text": "劉璋ノ暗弱ヲ以テシテモ守ルニ足レリ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、劉璋は暗弱の太守、無能の善人、いかにこの時代の大きな変革期を乗りきれましょうや。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "――前蜀の劉璋は、暗弱、紊政。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
