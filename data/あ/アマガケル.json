    "definitions": [
      {
        "index": 1,
        "gloss": "to soar (esp. of spirits and gods)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "天翔るを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは天翔るについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "天翔るの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は天翔るの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では天翔るが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "天翔るという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に天翔るという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では天翔るについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "天翔るを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると天翔るは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "天翔るについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では天翔るが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に天翔るは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により天翔るの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "天翔るは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に天翔るは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "天翔る雲のエレキを、　　とりも来て蘇しなんや、いざ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "続いて露領沿海のタラバ蟹に延焼し、加察加の鮭、鰊と宛然に燎原の火の如く、又は蘇国の空軍の如く、無辺際の青空に天翔る形勢を示したが、その途端、何気なく差した湊屋の盃を受けて唇に当てたのが運の尽き、一瞬の中に全局面を、無学文盲の親友に泄われてしまった。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "圖の下の端なる死人の起つあたり、艤せる羅刹の罪あるものを拉き去るあたりは、早や暗黒裡に沒せるに、基督とその周匝なる天翔る靈とは猶金色に照されたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々あるひは云ふ、――皇帝の白衣の后と、あるひは云ふ、――天翔る鵠のむれと。",
              "citation": {
                "source": "パステルの龍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリストを信じて私どものたましいは罪の縄目から解放せられ、天翔るような喜びと力をもちますが、体はもとのままの体なんです。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "天翔る鞍馬の使者一　きょうも棒切れを手にもって、友だち小猿を二、三十｜匹つれ、僧正谷から、百足虫腹の嶮岨をつたい、鞍馬の大深林をあそびまわっているのは、果心居士の童弟子、いが栗あたまの竹童であった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "兩羽鋭どくあまがける天馬の鞍に堪へかねて下界に落ちし塵の子（三）よ恨はあはれなれのみかまぼろし消て力なく今こそ咽べ我琴も。",
              "citation": {
                "source": "天地有情",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "殿たちの空を飛ぶ鳥は、私等が足の下を這廻る、水底の魚が天翔ける。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は世界的の大詩人とあがめられて、あたかも他の群鳥を尻目に悠々と高く天翔ける鷲のように、他の群小詩人を睥睨しながら、泰然とおさまっている。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "西南指して天翔ける「それはそれは困ったことで」老師は一層顔を顰めたが、「愚老はともかく芳江姫が酷く恐れておりますのでのう」「また打ち棄てて置きましたなら不測の災い起ころうも知れず。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふわりと熊の皮は浮き上がり、あたかも巨大の荒鷲が、羽繕いして空飛ぶように、窓を抜け空に浮かび、二、三度グルグル廻わったかと思うと大鼠山を背後にし、岩石ヶ城の天主を越え、西南を指して天翔ける。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天翔けることも地を潜ることも、魑魅魍魎を使うことも、呪縛でお前さんを縛ることも、どんな事だって出来るのだよ。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるときこの哲学者がそのアテナイ人の精神によつて、市井に行はれた賞讃すべきひとつの美談を、多分に天翔ける論理をもつて語つてゐた。",
              "citation": {
                "source": "吹雪物語",
                "author": "――夢と知性――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてしかも、この雄大なドラマに伴ふものは、思想の臆病、一切のものの上に天翔ける思想に大膽のないことであつた。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィチ・クロポトキン　Pyotr Alkseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "天馬ペガサスが天翔ける道を飛來する南歐の詩人を歡迎する其序詩は初め「中央公論」に載つた。",
              "citation": {
                "source": "新詩發生時代の思ひ出",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「天翔ける衣が欲しいとは思いませぬか」必死に叫んだ。",
              "citation": {
                "source": "紫大納言",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "近い鑓ヶ岳の山頂から西に曳いたゆるやかな斜線は、天翔ける鳥のように空を截って黒部の谷に隠れる。",
              "citation": {
                "source": "白馬岳",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々の熱心は、我々が怨恨・残忍・野心・吝嗇・悪口・謀反に向う傾向を助長するときにはめざましい働きをするが、好意・親切・節度に向っては、ある稀な気質がいわば奇跡的に我々の熱心をそこに導かない限り、天翔けることはおろか歩むことすらしないのである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "降り乱れひまなき空に亡き人の天がけるらん宿ぞ悲しき　という手紙を送ったのである。",
              "citation": {
                "source": "源氏物語",
                "author": "澪標",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてしかも、この雄大なドラマに伴うものは、思想の臆病、いっさいのものの上に天がける思想に大胆のないことであった。",
              "citation": {
                "source": "革命の研究",
                "author": "ピョートル・アレクセーヴィッチ・クロポトキン　Pyotr Alekseevich Kropotkin",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ『富士』はロケットの力で天かけるのだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "天かける神さまに、お祈りして、そのお力で出来たのだぞ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "僅か一瞬間の事であったが、子供の眼には仰ぎ見る馬上の姿が、天かけるように聳えて高く見えたのである。",
              "citation": {
                "source": "大人の眼と子供の眼",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし幾たびか、清き涙を揮ひつつ、歌のつばさもて天かけるそが姿をみかふる時しあれ、わが双の眼を封ぜむとするは｜一種朗かなる｜悲みにあらずや」と。",
              "citation": {
                "source": "松浦あがた",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりは「あまかける恋」におけるゲーブルとクロフォードとのユーモラスなものの下に語られる男の真心というようなものの方がさっぱりしていて、笑えるだけでも成功であったと思う。",
              "citation": {
                "source": "映画の恋愛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "よし十万坪といふ限られた世界に侏儒のやうな生活を営むとはいへ、せめて精神だけは大空をあまかける鵬でありたいのだ。",
              "citation": {
                "source": "柊の垣のうちから",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "理想の天へあまかける、希望のあとを思ひのまゝに翼を張つて、飛んで行く青春の靈を表はしてゐた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はいまその碧色の虚空に、高く高くあまかける神々のすがたを見るように思った。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
