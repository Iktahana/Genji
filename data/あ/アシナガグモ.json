        "examples": {
          "standard": [
            {
              "text": "庭の隅に足長蜘蛛の細い糸からなる巣があった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "足長蜘蛛は水面を歩くことで知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "生物の授業で足長蜘蛛を顕微鏡で観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ろうそくをはい上がって行く一匹の足長蜘蛛がある。",
              "citation": {
                "source": "小浅間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、まるで足長蜘蛛が小さなワラヂ虫をおともにつれて出かけるやうなかたちでした。",
              "citation": {
                "source": "青い顔かけの勇士",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜蠅、つゆ虫、ばった、足長蜘蛛、蚋、蚊とんぼ、尺蠖、金亀子、羽蟻、蟷螂、それ等の虫がそれぞれ枝と葉の宮殿のなかに休んでいる。",
              "citation": {
                "source": "螽※の記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "臙脂虫、油虫、足長蜘蛛、二つの角のある尾を曲げて人をおびやかす黒い昆虫の「鬼」。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
