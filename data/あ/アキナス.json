        "examples": {
          "standard": [
            {
              "text": "秋茄子は夏のものより身が詰まっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "市場で秋茄子を買ってきて、焼いて食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "秋茄子の独特の風味は、この季節の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "霜に染められたかと思う川越芋の紅いのに隣り合って、秋茄子の美しい紫が眼についた。",
              "citation": {
                "source": "両国の秋",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "竹藪を切り拓いた畑に、小さい秋茄子を見ながら、婆さんは例によってめの粗い縫物をしていた。",
              "citation": {
                "source": "秋の反射",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋茄子三本、秋胡瓜三本を植ゑる、この価五銭、あんまり安すぎる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう商売上の事柄は、長谷川にとっては興味もなく、秋茄子の話や大根の間引きの話の方が、よほど面白かった。",
              "citation": {
                "source": "女心の強ければ",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋茄子を嫁に食わせるなといった位ですから好い味を持ったものです。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "君の今言った秋茄子を嫁に食わせるなという俗諺も味が佳いからという訳であるまい、多分｜妊娠前や妊娠中の若い女に毒だから食べさせるなという親切な誡めだろう。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは友が庭前の叢に培った秋茄子である。",
              "citation": {
                "source": "姫柚子の讃",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "みると老母は、邸内の空地を耕して菜園とした畑で、きょうも百姓の持つ鍬を把って、秋茄子の根土を掻いているのだった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見てたも」　彼女のすがたを見ると、老母は鍬をおいて、自分の丹精をうれし気に指して、「秋茄子がこのように、たくさんに実った。",
              "citation": {
                "source": "新書太閤記",
                "author": "第三分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋茄子　この頃、良人の秀吉は、すこし寝坊癖がついたらしい。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "さぞあきあきなすったでしょうね、え？",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
