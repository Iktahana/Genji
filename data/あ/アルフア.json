        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「コーラン」ト共ニ劒ヲ示シテ殺スベシト云フ信仰ト殺ス勿レト云フ信仰トヲ兩立セシムルニ、liberty ナル「アルフアベット」七個ニ依頼セントスルガ如キ淺薄ナル信念ニテ何ノ信仰ゾ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイウエオ・カキクケコ――五つの母音を第一行として、凡てゞ四十八文字が吾等の言葉の、アルフアベツトである。",
              "citation": {
                "source": "鸚鵡のゐる部屋",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち大まかに云へば、第一期プロレツト・カルトの目標はプロレタリア××を完成せしめる爲の訓練であり教化であるが、兒童文學はそのアルフアベツトのＡ・Ｂ・Ｃ、オーケストラの大組織（これが當然×のスローガンともなつてゐるのだ）への音階ド・レ・ミ・フアを誤りなく教へる事にあるのである。",
              "citation": {
                "source": "プロレタリア童謠の活用に關する覺書",
                "author": "――兒童の指導者・保護者達に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "兒童は、アルフアベツトを書き、世間的知識を習得する前に、魂とは何か、眞理とは何か、精神のうちにはいかなる力が潜んでゐるかを學ぶべきであることは、何人も否定し得ないだらう。",
              "citation": {
                "source": "受動的抵抗の理論と實行",
                "author": "エム・ケー・ガンヂー",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きてゐる事がアルフアでオメガだ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "『端の方にアルフアベツトの文字を浮き彫りに刻んだ、短かい綺麗な金属の棒を想像してごらん、或る棒の端にはａといふ文字があり、別なのにはｂ、或はｃといふ文字がある。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのケースの中にはアルフアベツトの文字や符号が、一と区切り／＼入つてゐる。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれらの文字はアルフアベツト順に箱が並んでゐるのではない。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
