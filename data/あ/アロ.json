        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それから、ワイアロープがブラ下がって来た。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべることこの上もないところへ、それを縛るワイアロープは、腕の太さほどであるのであった。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ハ必ズコノアワレナ男ニ同情ヲ持ツデアロウコトヲ我輩ハ疑ワナイノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "我輩ハソノ期間ニ、我輩自身ヲ我輩ノ私室ニ密閉シ、君ノ文章ヲ研究シ、シカシテ、我輩ノ答ヲ、我輩ノ能力ノ最大ヲ致シテ書キシタタメルデアロウ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は江戸時代に於ける隱れたシヤアロツク・ホームズであつた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲はアロング・ザ・ナバホ・トレール。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず今夜しか機会はなさそうですね」　その時、アロング・ザ・ナバホ・トレールの曲が終った。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "小作人らに一々アローと声をかけて、一言二言話していました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐにわかったことは、役者のダイアローグを聞かせようと思うと視覚的画面が静的になってしまって死んでしまう。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラツツアロオネ」といふ賤民（立坊抔の類）の裸※なるが煖き沙に身を埋めて午睡せるあり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "シャアロック・ホルムズが眼鏡をかけて兵隊の死因をしらべに来たのだが、この十九世紀の古風な探偵のもつ観察と推理とは、兵隊の心に宿っていたところの最も近代的なる一つの要素を検出し得べくもなかったので、探偵は頭をかいて当惑したと云う。",
              "citation": {
                "source": "兵隊の死",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで君は、俄に恐しく神経を悩ましはじめたのだ――』　西村はシャアロック・ホルムズの様な口調でこう云うと、少し勿体ぶった手つきでスリーカッスルをつめたマドロスパイプを脂さがりに斜めに銜えた。",
              "citation": {
                "source": "象牙の牌",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヴァ酒を飲み、アロウ・ルウトの料理を喰う。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "クラリッサ・ハアロウとロビンソン・クルーソーとを比較せよ。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、此の言を為した所の人が、果して、クラリッサ・ハアロウを一度でも通読したことがあるか、どうか。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまたアロンの杖に似て居る。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "『パロとその臣下の前に投げうちしに、蛇となりぬ』とあつて、エジプトの博士と法術士等もおの／＼その杖を蛇と爲し得たが、アロンの杖はすべて之を呑んでしまつた。",
              "citation": {
                "source": "神秘的半獸主義",
                "author": "岩野泡鳴",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一出来タトシテモ其時ハ話モ出来ナクナッテルデアロー。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "-------------------------------------------------------「グッドバイ」「オォルボァル」「アヂュウ」「アウフビタゼエヘン」「ツァイチェン」「アロハ」等々――。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその体裁をして荒涼なるジェネアロジックの方向を取らしめたのは、あるいはかのゾラにルゴン・マカアルの血統を追尋させた自然科学の余勢でもあろうか。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故に現在の思量が伝記をしてジェネアロジックの方向を取らしめているかは、未だまったくみずから明かにせざるところで、上にいった自然科学の影響のごときは、少くも動機の全部ではなさそうである。",
              "citation": {
                "source": "なかじきり",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダンテ、マアロオ、ミルトン、カアライル、バイロン、ヲオヅヲオス、ブラウニング等は家數に大小ありといへども皆叙情詩人なり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は江戸時代に於ける隠れたシャアロック・ホームズであった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お文の魂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その信念が追々堕落する事、ギリシアローマの詩に彫刻に盛名を馳せた幽玄絶美な諸神が、今日｜藪沢に潜める妖魅に化しおわったごとくなったものか。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからちょうど古ギリシアローマの名神に、蛇妖となり下ったものあるように、野槌も草野の神から悪鬼、次に上述通りの異態な蛇を指す号と移ったものか。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
