          "literary": [
            {
              "text": "日ニヨリマストアタリノ山々ガ浮キアガッタカト思ワレルクライ空ガ美シイ時ガアリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ心アタリノ方ハ私ノトコロマデオ知ラセ下サイ。",
              "citation": {
                "source": "川へおちた玉ねぎさん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オココロアタリノ方ハアリマセンカ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妹ガ閨ノ板戸ヲ開ムトスレバ、音ノ高クテ人ノ聞付ム事ヲ恐レ、サリトテ帰リモエヤラデ其アタリノ霜ノ上ニ一夜寝タルトナリ」（代匠記）の解は簡潔でよいから記して置く。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ先ズ奈良アタリノ絵心ノアル佛工ニ命ジテ、今宮神社ノ四面佛ニ倣ッテ線彫リニシタ勢至菩薩ノ像ニ似タモノヲ描カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
