        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ところが、その田舎といふのが、不思議に子供の少い村で、昼間でも遊び声一つ聞えない、ひつそりした村であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「じゃん、けん、ぽん」「ぱあと出て」「ぱあと出て」「ぐっと出て」「ぱあと出て」「ちょっきはどうだい」　こんな二人の子供の遊び声がよく廊下のところで起って、少年時代の昔へと岸本の心を誘うのであった。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "獄の近くの子供達の遊び声や、「おかあさーん」と呼ぶ声がきこえるのもこんなしじまの時です。",
              "citation": {
                "source": "遺愛集",
                "author": "島秋人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
