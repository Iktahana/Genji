    "definitions": [
      {
        "index": 1,
        "gloss": "cicadas that sing when autumn comes",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
