[
  {
    "uuid": "ee279605-dad4-5f42-a599-a93b48a9cd76",
    "entry": "浅葱色",
    "reading": {
      "primary": "あさぎいろ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
