        "examples": {
          "standard": [
            {
              "text": "祖母は『東男に京女と言うように、江戸の男性と京都の女性が最高だ』と何度も繰り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "東男に京女という言葉は、江戸時代から民間に伝わる有名な言い伝えだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼は東男に京女という理想をそのまま現実にした人物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "『東男に京女やなア。",
              "citation": {
                "source": "東光院",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "東男に京女という諺はいつごろから出来たものか知らないが、事実はこの時代にやはりそうであったものだそうであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "間の山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
