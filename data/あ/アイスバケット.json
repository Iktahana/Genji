        "examples": {
          "standard": [
            {
              "text": "白ワインを頼んだら、すぐに氷で満たされたアイスバケットが運ばれてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "夏のバーベキューでは、飲み物を冷やしておくために大きめのアイスバケットがいくつも活躍した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "カクテルの材料を冷やすため、バーテンダーはまずアイスバケットに氷をたっぷり詰めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ホテルのロビーには、シャンパンや高級スパークリングワイン用のエレガントなアイスバケットが用意されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このポータブルアイスバケットは、アウトドアでの使用に最適で、保温性も高い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「ちょっと、あのー、アイスバケット、もう一つ持ってきてもらってもいい？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
