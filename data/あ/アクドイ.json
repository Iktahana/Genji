        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の商売のやり方は悪どい手口で客をだましている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その詐欺団は悪どい手段で金銭をだまし取っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "悪どい計画を立てて他人の財産を奪おうとしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
