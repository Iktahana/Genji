[
  {
    "uuid": "a43c7bee-df33-567c-959e-0bc5067de05d",
    "entry": "悪しい",
    "reading": {
      "primary": "あしい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
      ],
