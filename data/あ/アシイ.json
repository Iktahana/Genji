    },
    "definitions": [
      {
        "index": 1,
        "gloss": "bad",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "食べ過ぎたせいか、どうも昨晩から胃の調子が悪しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "嘘をついて人を騙すような悪しい考えは、今すぐ捨てなさい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "そんな悪しい言葉遣いをしていると、誰からも信用されなくなりますよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それが善いか悪しいかは、残念なことにまだ私には分らない。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあ、悪しいことはいわぬ。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯、その「甚し・極めて」などが、悪しい傾向のことを言ふに傾いてゐたと言ふことは出来るかも知れぬ。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシ葦那行　鴨之羽我比爾　霜零而　寒暮者　倭之所念　アシはまたヨシともいわるるがこれはアシを悪しいとて縁起を祝いヨシすなわち善しとしたもので本来の名は正しくアシである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お母さんよ、この、ひさあしいくう……といふところがとてもいいわね」　翌日、彼が大原コレクシヨンを見て、家に戻つて来ると、小さな姪が配給で貰つた五つの飴玉のその一つを差出して、「をぢさん、あげませう」と云ふ。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなことには少しも経験をお持ちにならないあなたがたにとっては、恨めしくばかりお思われになることもあるでしょうが、まあしいてもそれを静めて時をお待ちなさい。",
              "citation": {
                "source": "源氏物語",
                "author": "総角",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理のよしあしは、まず材料のよしあしいかんによる。",
              "citation": {
                "source": "味覚馬鹿",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "グリフォン　じゃかあしい！",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニールスが二あし三あしいくかいかないうちに、なんだかきれいなものが目にはいりました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸運の星の下に生れた人は、夜の夢の中でも幸福であり、惡しき星の下に生れた人は、夢の中でさへも、二重にまた不幸である。",
              "citation": {
                "source": "夢",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつて信仰は地上にあつたでうすはいすらええるの野にござつて惡しき大天狗小天狗を退治なされた。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切を憎惡し、粉碎し、叛逆し、嘲笑し、斬奸し、敵愾する、この一個の黒い影をマントにつつんで、ひとり寂しく陸橋を渡つて行く。",
              "citation": {
                "source": "宿命",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故ならばＳの生涯を誤らした、不吉な厭人的情操や病鬱的精神や、その他のもろもろの惡しき苗は、その學校生活の小社會的環境によつて、ひとへに育まれたものであるから。",
              "citation": {
                "source": "非論理的性格の悲哀",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべての易者と星占家（家相家や、人相見や、八卦師や）は、かうした彼等の所謂亡者どもを濟度するため、矛盾にも此處で前説を豹變し、逆に今度は、意志の自由が運命を支配すること、自覺と心がけとによつて、何人も意識的に人相を變へ、惡しき手相を善き手相にし、自由に運命を支配し得ることを辯解する。",
              "citation": {
                "source": "易者の哲理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」眼は意地惡しく　復讐に燃え　憎憎しげに刺し貫ぬく。",
              "citation": {
                "source": "氷島",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "惡しきものに逢ひけるよ、と思ふまもなく、つかつかと歩みよりて、なつかしげに物言はるるに、こはけれど遁れゆくべきにあらず。",
              "citation": {
                "source": "花あやめ",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれが善き詩であり、どれが惡しき詩であるかについて、彼は正しく判別批判する。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔は人間墮落の骨頂と思つて憎惡し切つてゐた江戸文化が、今ではそれほどに惡くない。",
              "citation": {
                "source": "悲しき決鬪",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに反して天性惠まれた才能をもち、充分の活動力をもつてる人が、惡しき時代や環境に生れた爲、生涯その才能を發揮し得ないで死んだとすれば、これはあきらめがたく不運である。",
              "citation": {
                "source": "所得人　室生犀星",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、さきほどその行員を訪ねてみましたが、折惡しく不在で、暫くしたらもう一度行つてみるつもりでをります。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "快き第一印象は、時とすると惡しき第二第三の印象をも包まうとする。",
              "citation": {
                "source": "猫又先生",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何とも陰氣にて薄氣味惡し。",
              "citation": {
                "source": "寸情風土記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "此の奧に住める人の使へる婢、やつちや場に青物買ひに出づるに、いつも高足駄穿きて、なほ爪先を汚すぬかるみの、特に水溜には、蛭も泳ぐらんと氣味惡きに、唯一重森を出づれば、吹通しの風砂を捲きて、雪駄ちやら／＼と人の通る、此方は裾端折の然も穿物の泥、二の字ならぬ奧山住の足痕を、白晝に印するが極惡しなど歎つ。",
              "citation": {
                "source": "森の紫陽花",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその一方の紳士は、自己の半身であるところのルンペンを憎惡し、不潔な動物のやうに嫌厭してゐる。",
              "citation": {
                "source": "酒に就いて",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平生よく事へくれ、惡しきこととて更に無し、此度鳥を勸めしも、予を思うての眞心なるを、何とてあだに思ふべき。",
              "citation": {
                "source": "十萬石",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の知りあひに、御旅館とは表看板、實は安下宿に居るのがあるが、秋のながあめ、陽氣は惡し、いやな病氣が流行ると言ふのに、膳に小鰯の燒いたのや、生のまゝの豆府をつける。",
              "citation": {
                "source": "湯どうふ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "實に人の惡しからざる思想や言語や行爲に對して、妄りに剋殺的の思想や言語や行爲をなさずして、助長を意とせざる可からずと思ふからである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "墨子の道は惡しからずと雖も、「うるほひの無い」ことは爭へない。",
              "citation": {
                "source": "墨子",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉のはしなどにあらはれる、今の青年に共通な匂ひが、その云ふことの好し惡しは別として、感覺的に老年者に反撥を感ぜしめるものがあることを思つたからである。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぢやが、その少しが、地主仲間のあるものからは、新しがつてせいでもいいことを異を立てるの、ありや縣會へ出る野心からぢやのと、わしの柄でもない本讀みのことまで一緒に持ち出されて、うるさう、惡しざまに云はれたもんだ。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
