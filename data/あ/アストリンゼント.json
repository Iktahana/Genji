        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この赤ワインはタンニンが強く、口に含むとしっかりとしたアストリンゼントを感じる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "洗顔後にアストリンゼントをたっぷり含ませたコットンでパッティングし、毛穴を引き締めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "夏のベタつく肌には、清涼感のあるアストリンゼント効果の高い化粧水がぴったりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ニキビの出ている寿子だけは、アストリンゼントをつけた。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
