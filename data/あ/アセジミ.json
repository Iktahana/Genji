        "examples": {
          "standard": [
            {
              "text": "何度洗っても白いシャツの脇の汗ジミが落ちなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "夏が終わると毎年スーツの背中に汗ジミが残り、クリーニングに出す羽目になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "久しぶりに着ようとした去年のTシャツに汗ジミがついていて、がっかりした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "あれから夕方まで、生田川の川原では、正成の部下がみな裸になって、みそぎするように汗を流したり泥土の具足を洗っていたが、正成もまた、そうして来たのか、よろい下着にも、汗ジミのない白い襟もとを涼やかにのぞかせていた。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
