        "examples": {
          "standard": [
            {
              "text": "相手への深い愛儀を込めて、一筆したためる。",
              "source": "幻辞"
            },
            {
              "text": "彼の振る舞いには、育ちの良さと他人への愛儀が感じられる。",
              "source": "幻辞"
            },
            {
              "text": "形式的な礼儀ではなく、心のこもった愛儀こそが人間関係を円滑にする。",
              "source": "幻辞"
            },
            {
              "text": "先輩からの温かい愛儀に触れ、彼は緊張を解いた。",
              "source": "幻辞"
            },
            {
              "text": "旅先で受けた土地の人々の愛儀は、一生の思い出となった。",
              "source": "幻辞"
            }
          ],
          "literary": []
        }
      }
