          "literary": [
            {
              "text": "アレヲ私ニカシテ下サイ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ダケドアレヲ提ゲテ歩イタラ、僕ガ買ッテヤッタンダト、婆サンガ感ヅキャシナイカナ」「オ婆チャンハアノ時見テイラッシャラナカッタワ、ドン／＼歩イテ先ノ方ヘ行ッテラッシャイマシタワ」ヤッパリソウダッタナト予モ思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「株ヲ持ッテル筈ジャナイカ、アレヲ売ル訳ニ行カナイノカ」「アレヲ売ッタラ、ソレコソアタシタチ一文ナシニナッチャウワ」「ソウヨホントニ、アレダケハ手ヲツケナイ方ガイヽヨ」ト、婆サンガ助ケ舟ヲ出ス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アタシアレヲ思イ出シチャッタワ」「ボクシングハタッタ一ペンシカ見タコトガナイナ」コヽヘ婆サント看護婦トガ滑リ台ノ時間ガ来タコトヲ知ラセニ来タノデ、颯子ハ一層面当ガマシク誇張的ニ話シ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南禅寺ッテ云エバ永観堂ノ紅葉ガ綺麗デショウネ、アタシガアレヲ見テカラモウ何年ニナルカ知ラ」「永観堂ハマダ早イヨ、高尾ヤ槙ノ尾ガチョウド見頃ダガ、己モコノ脚ジャ行ケソウモナイ」……………………………………………………………………………………………………十二日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "家ジュウデ妻以外ニアレヲ食ウ者ハイナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日モアレヲ着テ歩イテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
