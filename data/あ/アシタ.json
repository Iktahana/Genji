        "examples": {
          "standard": [
            {
              "text": "この画期的な新素材の技術が、我が国の明るい明日を切り開くことになるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "子どもたちに平和な明日を残すために、私たち大人が今すべきことは何だろうか。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "明日の自動車産業を担うのは、間違いなく電気自動車や完全自動運転の技術だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
