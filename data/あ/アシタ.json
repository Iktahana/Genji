  {
    "uuid": "9edd24ea-435b-5cf9-adfd-eca5ad2a27bd",
    "entry": "アシタ",
    "reading": {
      "primary": "あした",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カクテアシタハヒルトナリ、　　水音イヨヨシゲクシテ、　鳥トキドキニ群レタレド、　　　ヒトノケハヒハナカリケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ高木モ夜トナレバ、　　　サラニアシタヲ云ヒカハシ、ヒトビトオノモ松ノ野ヲ、　　　ワギ家ノカタヘイソギケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタ七ジツク　というのであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタにせよとか、アサッテにせよとか、毎日食うては悪いとかいう親たちの意見に依ってとかく私らの即時断行説が阻止される。",
              "citation": {
                "source": "私の父",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヒサマ　カンカンオオ　アツイネバウノ　ネバウノアカトンボ、アシタノ　アサマデオヒルネカ、オヒサマ　カンカンオオ　アツイ。",
              "citation": {
                "source": "未刊童謡",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "では、マタアシタ（これは太郎が夕方友達とわかれるあいさつ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アシタ、町デ、ホントノ、キカイ油ヲ、買ウ」　母親は、「ほう、そうかい」と、金を出しに立った。",
              "citation": {
                "source": "杏の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「十ハコノ次デス、アシタカラデス」「今日教えて下さい、そうしないと数が合わなくていけません」「デハ、教エテ上ゲルヨロシイ」といって、マドロスは黒板の上に、10を書いて、「テン」「テン――十はテンですか、棒と球ですね」　茂太郎の首には小さな石盤があります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタマタアソバウヨ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　アル日、人参サンノ所ヘ、人参サント　ジヤガイモサンノオ友達ノ玉ネギサンガ　タヅネテキテ、「ボクモ、コンナニ大キクナツタノデ、トウトウ、アシタノアサ、六ジニ　キシヤデ　マチノイチバヘ行クコトニ　キマツタヨ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタノアサハ　ジヤガイモサンニモサウ言ツテ二人デ一シヨニ、キツト　オミオクリニキテクレタマヘ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キモノノコトハ、マタ　アシタ　ゴサウダン　イタシマセウ。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大島は地下水のないところだから、畑もなく、島民はもっぱら化け物のような芋を食い、栄養補給にはアシタッパ（又は、アスッパ）という雑草を食い、牛乳をのんでいた。",
              "citation": {
                "source": "安吾巷談",
                "author": "湯の町エレジー",
                "note": "青空文庫"
              }
            },
            {
              "text": "アシタッパという雑草は、今日芽がでると明日は葉ッパが生じるという意味の名で、それぐらい精分が強いという。",
              "citation": {
                "source": "安吾巷談",
                "author": "湯の町エレジー",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本にはこのジャコウソウの品種が三つあって、それはジャコウソウ、タニジャコウソウ（Chelonopsis longipes Makino）、アシタカジャコウソウ（Chelonopsis Yagiharana His. et Mat.）である。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同じく昭和八年三陸津浪の十五、六日前に、岩手県｜鵜住居村の漁師が、縄釣りでアシタカガニをとった。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アシタノ、バン、ダヨ。",
              "citation": {
                "source": "青銅の魔人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
