        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「旅の誘ひ」は恐らく彼の成熟を示すものであり、その後発表された「アンベエルの秘密」「ドゥニイズ・マレット」「悩める魂」「面影」等の諸作は、まだ読んでみる機会がないが、或は、その中に彼の傑作があるかもわからない。",
              "citation": {
                "source": "クロムランクとベルナアルに就いて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "農夫　ほう（鍬の手を休めて、見る）なんとまあイソイソして、まるで、へえ、娘っこが祭りにでも行くようなアンベエしきだ。",
              "citation": {
                "source": "鈴が通る",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに町の工場に行つたりして共産党かなんかにカブレたアンベエずら。",
              "citation": {
                "source": "ぼたもち",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
