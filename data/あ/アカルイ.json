          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "選挙管理委員会は、明るい選挙を呼びかけるポスターを街頭に掲示した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "お金のかからない、明るい政治の実現が今の日本には求められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "市民一人ひとりが市政に関心を持つことが、明るい社会への第一歩だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
