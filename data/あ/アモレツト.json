        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アモレツトオ」といふ者ぞ、と教へられたる、美しき神の使の童どもは、我夢の中より生れ出でしものかと疑はる。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "神の使の童をば、何故「アモレツトオ」（愛の神童）といふにか。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「アモレツトオ」は、何故｜箭を放てる。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日飾棚の内にゐるアモレツトの小人形が皆喪のしるしに黒い紗を纏つた。",
              "citation": {
                "source": "クサンチス",
                "author": "XANTHIS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
