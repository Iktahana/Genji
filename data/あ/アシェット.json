        "examples": {
          "standard": [
            {
              "text": "毎号パーツを集めて完成させるアシェットの分冊百科を定期購読している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "書店でアシェットの新しいミニカーコレクションの創刊号を見つけて買ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼はフランスのメディア複合企業であるアシェットの歴史について論文を書いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "フランスあたりの本屋にしても、こんな本は多分アシェットから出ているだろう、恐らくアルカンから出ているだろうと見当がつくぐらいである。",
              "citation": {
                "source": "書物の倫理",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
