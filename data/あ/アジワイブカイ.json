        "examples": {
          "standard": [
            {
              "text": "美術館で見たその抽象画は、いつまでも見つめていたくなるほど味わい深い作品だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "古い木造建築の旅館には、新築のホテルにはない味わい深い魅力がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "この焙煎珈琲は苦味の奥にほのかな甘みがあり、とても味わい深い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "こういう味わい深い佳品こそプロの手で訳してほしいものです。",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔はご隠居さまのお道楽みたいにいわれていた魚釣りも今ではりっぱなスポーツであるから、当然ながら、ひじょうに味わい深い言葉だと思っている。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "総じて山の積雪に現われる種々な形態と口碑は、山民の生活、なかんずくその重心たる農耕に関するものが多く、自然への人間の和親帰依の象徴として、わが祖先の自然を見る眼のするどさ、感ずる心の温かさを伝える遺産として、まことに面白く、貴く、又味わい深いものがある。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "電源どころか命脈を絶たれ、どうやったって電波の届かない国へ向かおうとする者への言葉としては、なかなかに味わい深い文章だ。",
              "citation": {
                "source": "ぞなもし狩り",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に彼が四百年前の人であり、地主の息子であったことを考えると、次のパラグラフとともに、きわめて味わい深いものがあると思う。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
