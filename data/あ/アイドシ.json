        "examples": {
          "standard": [
            {
              "text": "久しぶりに会ったいとこは私と相年なのだが、すっかり大人びて見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "クラス会で再会した友人たちは皆相年のはずなのに、苦労のせいか老けて見える者もいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "相年の同僚とは妙にウマが合い、仕事の愚痴から趣味の話まで何でも言い合える仲だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "又墨子に引ける尚書には呂刑、大誓、仲※之誥等、今の尚書と同名の者の外に、今の尚書と異名同實の禹誓（甘誓）武觀（五子之歌）等があり、同名異實の湯誓などがあり、今の尚書に全くなき術令、相年、禽艾、湯之官刑、禹之總徳等もある。",
              "citation": {
                "source": "尚書稽疑",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいおい進むと、その人相年齢すらも確とは判然しない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
