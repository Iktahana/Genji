          "standard": [
            {
              "text": "師匠の洗練された包丁さばきには、見習いの私など足下へも寄りつけない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "プロの陸上選手の走るスピードには、一般のランナーは足下へも寄りつけない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "彼女の圧倒的な語学力と知識量の前では、僕など足下へも寄りつけないと感じた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "こんなカニのおばけみたいな、みにくい姿をしているくせに、その知恵は、地球のどんな学者だって、あしもとへもよりつけないのです。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
