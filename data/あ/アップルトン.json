          "literary": [
            {
              "text": "ルイス・アップルトン〔英国委員の書記〕フヒフセル婦人〔ロンドン〕ただしこの婦人の目的は今日において各国相競いて兵備を盛んにするはそもそも婦女輩の罪なり。",
              "citation": {
                "source": "将来の日本",
                "author": "徳富蘇峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "原理は英国のアップルトン教授が、もう二十五年くらい前から始めていた方法と同じである。",
              "citation": {
                "source": "アラスカ通信",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時この現象の発見者アップルトン教授は、階上の実験室で電離層の研究をしていた。",
              "citation": {
                "source": "科学と国境",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キングス・カレッジも訪問されて、たしかアップルトン卿（当時はまだ卿ではなく、新進の電波学者であった）だったかの案内で、実験室を見て廻られた。",
              "citation": {
                "source": "身辺雑記",
                "author": "――『日本のこころ』を囲って――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アップルトン先生は、多分日本語というものは、非音楽的な言葉だと思われたにちがいない。",
              "citation": {
                "source": "身辺雑記",
                "author": "――『日本のこころ』を囲って――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
