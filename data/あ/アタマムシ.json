          "literary": [
            {
              "text": "『善信経』には黒頭虫と訳し居る。",
              "citation": {
                "source": "十二支考",
                "author": "犬に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は懐中拡大鏡の力をかりて彼に、仰向けに置かれると飛び上る叩頭虫の、奇妙な構造を見せていた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "叩頭虫は背中で横になる時、胸部と腹部とを脊梁形に曲げ、隆起は承口を外れてその辺にのりかかる。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼠が毎晩｜座頭虫の身だけをくって足をそこらへちらけておく。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "座頭虫はくわれてもくわれても別の奴が相変らず長い脚をもてあましてよいよいみたいに歩き廻る。",
              "citation": {
                "source": "島守",
                "author": "中勘助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
