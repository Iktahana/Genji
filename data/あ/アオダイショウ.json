[
  {
    "uuid": "fe70ac00-7794-5f91-bdf9-673ef415ba04",
    "entry": "青大将",
    "reading": {
      "primary": "あおだいしょう",
      "alternatives": [
        "アオダイショウ"
      ],
      "is_heteronym": false
    },
    "grammar": {
