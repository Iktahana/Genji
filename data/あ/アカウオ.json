    "definitions": [
      {
        "index": 1,
        "gloss": "Pacific ocean perch (Sebastes alutus)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日の夕食は赤魚の塩焼きに決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤魚はたんぱく質が豊富な白身の魚だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "市場で大きな赤魚が入荷されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "私は尺に近い赤魚を、サンザン苦労して引つ張り上げ、魚籠に入れる直前に落した。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "……場所を何う取違へたか、浴衣の藻魚、帶の赤魚、中には出額の目張魚などに出逢ふのみ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この河からは鯉、鮎、鰻、赤魚、山女魚、等々が釣れる。",
              "citation": {
                "source": "信濃の山女魚の魅力",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は又、水の中に住む赤魚の恋を妬んででもゐるのであらうか。",
              "citation": {
                "source": "かちかち山",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "県、赤魚、月丸、鯖、小次郎、お小夜の六人である。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その金を隠したとは呆れたものだ」「いいや俺は呆れもしねえ」次男の赤魚がベソを掻きながら、「明日から俺らはどうするんだ。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "本バヤ即ち学名うぐいはあかはら又は赤魚の名で雌雄ともに腹が赤くなるが、主として天竜に居て、諏訪湖の上流の方はうぐいは稀でおいかはが主である。",
              "citation": {
                "source": "釣十二ヶ月",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「その場合にはねえ」と男は真面目｜相に「あなたはあの菓子をもう一度持って来なくてはいけないね」「あら、あなたは大事な話の方をよくきいて下さらなくてはいけませんわ」とローラは負けずにいった、「では始めに、私のお父さんがラドベリーに『赤魚軒』という料理屋を出していた事からお話しいたしましょう。",
              "citation": {
                "source": "見えざる人",
                "author": "THE INVISIBLE MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の握るものは、鱧、河豚、赤魚、つばす、牡蠣、生うに、比目魚の縁側、赤貝の膓、鯨の赤身、等々を始め、椎茸、松茸、筍、柿などに迄及んだが、鮪は虐待して余り用いず、小鰭、はしら、青柳、玉子焼等は全く店頭に影を見せなかった。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "『塩松勝譜』には常陸坊海尊、衣川にて老人に逢い赤魚をもらって食った。",
              "citation": {
                "source": "雪国の春",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘇我ノ蝦夷、平群ノ鮪、蘇我ノ赤魚、押返ノ毛屎、阿曇ノ蛍虫――などはまだよいが、巨勢ノ屎子という女性がある。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
