        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こつちはイライラするけれど、彼方は親切に何やかと訊ねなさるから、牧代（姉娘）はどうしたか、生れた子供は丈夫かと訊ねなさつて……」とニコニコしながら呼吸をつきながら、仰向き勝なその顔の、アザヤかな色の唇がさういふのである。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "アザヤカな淡紅色を帯びて、噎せかえるほど深刻に匂う白い花ビラの大群を、静かに少女の枕元に置き直すと、ポキンポキンと音を立てる腰骨を一生懸命に伸ばしながら、長い長いふるえた溜め息を吐いた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鞭ヲ鳴ラシテ酒肆ヲ過リ服ヲアザヤカニシテ倡門ニ遊ブ――」　他の者は世話ものを歌つたが、雷音は人々の聞き慣れぬ類ひの漢詩ばかりを次々に朗吟するのが癖だつた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがクッキリと對照をなして、目もさめるようにアザヤカに見える、痛そうな顏はしていない。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭ノ敷石ノ蔭カ縁ノ下カ何処カニ潜ンデイテ、アザヤカナ声デ鳴キ立テル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
