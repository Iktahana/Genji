          "literary": [
            {
              "text": "九月十九日　金　Ｙ、アオムスその他へ出かけた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月二十九日　月　○アオムスへ出かけた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○黄色い葉の間から更に黄色いアオムスの前面何とも云えず美しい。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "十月十一日　土　アオムスへ行ったが、一時までだというので結局駄目。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○アオムスでパスポートの後からシールをこわして居住証をはがされたときの感じ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            }
          ]
