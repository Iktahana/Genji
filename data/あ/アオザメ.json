        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ドキュメンタリー番組で、青鮫が驚異的な速さで獲物を追い詰める姿を見た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "青鮫は、その流線形の美しい体と鋭い歯で知られる海のハンターだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "漁師たちは、船の周りを泳ぐ巨大な青鮫に遭遇し、息をのんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "海は青鮫の砂ずりのいろに拡がり、空にちかい波と波のすき間から、聖らかな船唄が流れてくる。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常に大きなアオザメで、その体は海で一番速く泳げるようにできていた。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、さっきのアオザメのようには来なかった。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
