          "standard": [
            {
              "text": "陶芸ではあたり鉢が使われることがある。",
              "source": "幻辞"
            },
            {
              "text": "その陶芸家はあたり鉢で作品を作っている。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢は伝統的な陶製の道具だ。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢は農業でも使用される。",
              "source": "幻辞"
            },
            {
              "text": "昔の人たちはあたり鉢を日常的に使っていた。",
              "source": "幻辞"
            },
            {
              "text": "その博物館ではあたり鉢が展示されている。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢の使い方を陶芸の先生が教えた。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢は薬を作る時に使うこともある。",
              "source": "幻辞"
            },
            {
              "text": "その工房ではあたり鉢が大切に保管されている。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢は日本の伝統的な道具である。",
              "source": "幻辞"
            },
            {
              "text": "その家系ではあたり鉢が代々受け継がれている。",
              "source": "幻辞"
            },
            {
              "text": "考古学的にあたり鉢は重要な遺物である。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢の製造方法について研究している。",
              "source": "幻辞"
            },
            {
              "text": "古い民家にはあたり鉢が置かれていた。",
              "source": "幻辞"
            },
            {
              "text": "料理番組でシェフがあたり鉢を使っていた。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢は陶芸の初心者向けの道具だ。",
              "source": "幻辞"
            },
            {
              "text": "その技術者はあたり鉢の改良を試みている。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢を使った儀式がある地域もある。",
              "source": "幻辞"
            },
            {
              "text": "その美術館ではあたり鉢の美しさを展示している。",
              "source": "幻辞"
            },
            {
              "text": "あたり鉢は文化財として保護されている場合もある。",
              "source": "幻辞"
