[
  {
    "uuid": "52a635d3-7f6c-5bf1-9e96-ed69cb64ad3a",
    "entry": "足だまり",
    "reading": {
      "primary": "あしだまり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "base of operations",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "山岳部の隊長は次のキャンプ地を足だまりとして、そこから頂上へのルートを検討した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古城の地下室が反乱軍の足だまりとなり、そこで作戦が練られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "港町は大航海時代に商船の足だまりとして栄え、さまざまな文化が混ざり合った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "見た眼には、けわしそうでもあるが、こうして登ってみると、きちんきちんと足だまりができていて、さほど難渋でない。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いのちともしきわれをよぶ　足だまりにしていた枯枝がぽきっと折れた。",
              "citation": {
                "source": "猿ヶ島",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "学生が、絶壁のなかばに到達したとき、足だまりにしていた頭ほどの石ころがもろくも崩れた。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "官吏とか商人とかゞ、足だまりに寄つて行きさうな小さい町である。",
              "citation": {
                "source": "摩周湖紀行",
                "author": "――北海道の旅より――",
                "note": "青空文庫"
              }
            },
            {
              "text": "足だまりの城として伯父より添書ありしは、浅草三間町の深沢某なり。",
              "citation": {
                "source": "良夜",
                "author": "饗庭篁村",
                "note": "青空文庫"
              }
            },
            {
              "text": "その南の岸辺に柳の木が成育し、従って土がかたまり、人々の足だまりが出来た。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイヌの遊牧にまかせていたこの島は、外寇と植民の足だまりになるよう立てなおさなければならない。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "播州・江州に大きな足だまりを持つて居た。",
              "citation": {
                "source": "河童の話",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロ・ハは、遥拝信仰発達の一過程であるが、其多くは、神幸の儀式を行ふ前の、足だまりとなる地点であつた。",
              "citation": {
                "source": "漂著石神論計画",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その大萱はいつのころか、瀬戸を追われて行った陶人の足だまりとなった。",
              "citation": {
                "source": "瀬戸・美濃瀬戸発掘雑感",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "一行四人は中津川から馬籠峠を越え、木曾街道を江戸へと取り、ひとまず江戸両国の十一屋に落ち着き、あの旅籠屋を足だまりとして、それから横浜へ出ようとした。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊那の谷の方のだれ彼は白河家を足だまりにして、京都の公卿たちの間に遊説を思い立つものがある。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "東餅屋、西餅屋は敵の足だまりとなる恐れもあるから、代官所へ申し渡してあるように両餅屋とも焼き払う、桟も取り払う、橋々は切り落とす、そんな話があって、一隊の兵と人足らは峠の上に向かった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "その「万一」がもし事実となるとすると、下原村は焼き払われるだろう、宿内の友の町、久保、武居も危ない、事急な時は高木大和町までも焼き払い、浪士らの足だまりをなくして防ぐべき諏訪藩での御相談だなぞと、だれが言い出したともないような風評がひろがった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、また、土蔵も残らず打ち破り家屋敷もことごとく焼き崩して浪士らの足だまりのないようにされるとの風聞が伝わった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪士らの足だまりをなくする意味で、彼らはその手段に出た。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "この以外祈祷卜筮等を渡世とする浮浪性の陰陽筋・神子筋・禰宜筋などのものが、足だまりを得て土着した場合において、そのある者がしばしばその仲間として他から見られる結果、いつしか物持筋になる場合の少からぬことは言うまでもない。",
              "citation": {
                "source": "憑き物系統に関する民族的研究",
                "author": "その一例として飛騨の牛蒡種",
                "note": "青空文庫"
              }
            },
            {
              "text": "でもどうやらやっと足だまりができた。",
              "citation": {
                "source": "家なき子",
                "author": "SANS FAMILLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　太陽と水との接吻をする辺まで降ると、棕梠縄の瘤を足だまりに、じっと四壁を見廻して居りましたが、やがて、「フム」　一つ唸ると、かくしからＵ字型になった鈎を出し、縄の途中へ引っかけて、それを自分のバンドへ止め、両手に鶴嘴を振り上げて、サックと畳み上げた石垣の隙間へ叩きこみました。",
              "citation": {
                "source": "古城の真昼",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞社の名簿にある住所は唯のアパートで、調べて見ると足だまりにしか過ぎず、新聞社に提出した履歴書は、社内の秘密の一つで、新米記者の京極三太郎などは、それを見る権力も無く、また取出して調べる方法も無かったのです。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "第四次元の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "運命から、その足をおくべき足だまり・平穏な生活をおしたてるべき頼り・をこばまれている人間は、自分の持っているものを危険にさらしても、それは仕方がない。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は早苗さんを抱いたままそれを登って、上部の足だまりに立つと、鉄板でできた水槽の蓋をひらいて彼女のからだを水中へ投げこんだ。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "四国二十三番の札所薬王寺にゆく足だまりにもなるので、遍路の人のほの白い姿と、あわれにふる鈴の音もこのたそがれのわびしい点景。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
