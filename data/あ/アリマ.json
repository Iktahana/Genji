        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ママサマ、少シモアブナイ事ハアリマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "一雄ハ深イ所デ泳イデモ危イコトハアリマセン。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ナストウリ、モノサシトハサミ、カガミガアリマス、イケニフネ……」大急ぎでそれだけ読んだが、そこで息が切れた。",
              "citation": {
                "source": "良子",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホカニ功徳ハアリマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とおつしやつたのに、間髪をいれず、ソレモアリマス　あざやかなものでございました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」タツタ一年ノオ留守番モデキヌヤウデハ、重臣ノ甲斐ガアリマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ、夢デ見タコトガアリマス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アノ裏ニハキット墓地ガアリマス。",
              "citation": {
                "source": "ア、秋",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オクサンアリマスカ。",
              "citation": {
                "source": "一九三一年度極東ビヂテリアン大会見聞録",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウミ　ノ　マンナカ　ニ、オオキナ　イワ　ガ　アリマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日ニヨリマストアタリノ山々ガ浮キアガッタカト思ワレルクライ空ガ美シイ時ガアリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ、ヤブカラ　デテ、ウグヒスブエノ　ハウヘ　ヤツテ　キタノデ　アリマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツボミタチハ　マダ　コノ　セカイヲ　ミタ　コトガ　アリマセン。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、「オンモハ　ドンナ　トコロデセウ」ト　ドノ　ツボミモ　オモツテ　ヰルノデ　アリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　マタ　サツキノ　フトイ　コヱデ、「ワタシハ　ウマデス、チツトモ　オソロシイ　モノヂヤ　アリマセン」ト　イヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　ハジメテ　ミル　セカイガ　イママデト　チガツテ　ピカピカ　ヒカツテ　ヰタカラデ　アリマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ　ヒラカナイ　ツボミガ　アルヂヤ　アリマセンカ」　花タチハ　ビツクリシテ　ミマワシマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　ホントニ　イツピキノ　テフテフデ　アリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナヅチ新美南吉　ヒトリノ　フエフキガ　アリマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "タケノコ新美南吉　タケノコハ　ハジメ　ヂビタノ　シタニ　ヰテ、アツチ　コツチヘ　クグツテ　イク　モノデ　アリマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、アメガ　フツタ　アトナドニ　ポコポコト　ツチカラ　アタマヲ　ダスノデ　アリマス。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシ、イクラ　シカラレテモ、ヒトツノ　タケノコハ　ドンドン　トホクヘ　モグツテ　イクノデ　アリマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デンデンムシノ　カナシミ新美南吉　イツピキノ　デンデンムシガ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタバカリデハ　アリマセン。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アナタバカリヂヤ　アリマセン。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、オトモダチヲ　ジユンジユンニ　タヅネテ　イキマシタガ、ドノ　トモダチモ　オナジ　コトヲ　イフノデ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ワタシノ　カナシミヲ　コラヘテ　イカナキヤ　ナラナイ」　ソシテ、コノ　デンデンムシハ　モウ、ナゲクノヲ　ヤメタノデ　アリマス。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "マダ　ワカイノニ　オトウサンモ　オカアサンモ　キヨウダイモ　ナク、ホントウニ　ヒトリボツチデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナニシロ　オカネガ　アリマセンノデ、キシヤヤ　ジドウシヤニ　ノル　コトハ　デキマセン。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
