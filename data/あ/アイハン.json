        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "連帯保証人になるため、借用書に兄と合判することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "この書類が正式なものであると証明するために、関係者全員で合判する決まりになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "共同経営の契約書に、パートナーと共に合判して事業をスタートさせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      }
