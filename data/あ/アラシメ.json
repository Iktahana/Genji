          "literary": [
            {
              "text": "若キ令嬢ハソノ美貌ニ加エ真ナル価値ニ恵マレ、コノ婚姻ヲ光輝アラシメ至福ヲ永遠ナラシム也。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "天武紀九年の詔の利国家を「アメノシタニカガアラシメ」と訓み、その他『※嚢抄』、『類聚名義抄』等にも、利の字をカガという例が多い。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ臣死スルノ日ハ、内ニ余帛アリ、外ニ贏財アラシメテ、以テ、陛下ニ背カザル也。",
              "citation": {
                "source": "三国志",
                "author": "篇外余録",
                "note": "青空文庫"
              }
            }
          ]
        }
