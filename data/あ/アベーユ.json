          "literary": [
            {
              "text": "タクシー、北の新地のバー・アベーユへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのママのバア、かとうといふのへ連れ込まれ、それから又佐野の案内で、北のアベーユへ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔って、アベーユへ電話、ママさん迎へに来る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして北進、アベーユへ寄りし頃は、もうおねむの極。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
