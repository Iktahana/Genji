        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "空襲の時のアブリの避難者收容數である。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにアブリの中は暗くて臭くて、あんな所に何時間も閉ぢ込められたら氣がちがつてしまふ。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、パリでは諸般の取締が日に日にやかましくなり、アレルトの鳴つてる間、即ち、人人がアブリへ逃げ込んでる間、他人の室内に侵入した者は死刑に處するといふ布令が出たさうだ。",
              "citation": {
                "source": "大戰脱出記",
                "author": "野上豐一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "直ぐ裏に住んでいたファアブリという伊太利人が、商売物のフィルムから火を失したのである。",
              "citation": {
                "source": "芝、麻布",
                "author": "小山内薫",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋸ビキ、火アブリ、牛ざき、穴つるし、水責め、なんでもやる。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "生前、歯に彫りつけたというわけではなく、書いたものがアブリダシで現れたようなアンバイである。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は死人の歯を治療したことがありませんから、なんとも云えませんが、これはたゞの偶然で、なんでもないことじゃありますまいか」「このホトケはクビをくゝって自殺したのですが、死ぬ前に、歯にアブリダシで字を書いておいたら、骨になってから、こうなるのと違いますか」「さア、どうでしょう。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯にアブリダシを書いた話はきいたことがありませんが、口の中は濡れているのが普通ですから、アブリダシを書いても流れて消えて失くなりはしませんか。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は骨になった歯など見たことがないのですが、シサイに見たら、こんなのは例が多いのかも知れませんな」「しかし、アブリダシということも考えられるでしょうな」「和尚さん。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供じゃアあるまいし、頭をまるめたいい年寄が、アブリダシ、アブリダシって、ナニ云ってやがんだい。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙僧は、奴め、口惜しまぎれにクビククリの寸前にアブリダシを前歯に仕掛けやがったなと睨んだが、漬物屋のオカミサンは、亡魂がこの地にとどまって、歯に文字を書いたというのだよ。",
              "citation": {
                "source": "行雲流水",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "火アブリにしてやるから、そう思え」　町内の連中が、いきりたって、責めたてる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "火アブリにされてはたまらない。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前、綱につかまって、一人で、あがれるか」「あがってやるが、女房を火アブリにしないか」「あんなことを言ってやがる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前が一人であがってくれば、女房を火アブリにもしないし、おいしい物をタント食べさせてやるぞ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "その方法は斬首、ハリツケ、火アブリ、水責め、氷責め、熱湯責め、ノコギリびき、蓑踊り、穴吊し等々いろいろある。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "火アブリは死ぬまでの時間が長く、それまで説教しつづけるので最も荘厳でいけなかった。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "』『彼品はドーブレクがストーアブリッジのジョン・ハワード商会に註文した時、見本として送って来た品に過ぎないのでございます。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうして彼は騎士の冒險と華々しい生活とを夢みながら、獨逸勢撃退の軍に加はるためにアブリヤに向つた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度あとから遣つて來た友達の群が笑ひ出した――「それぢや裁縫屋が又仕事にありつくね、丁度君がアブリヤに出かけた時のやうに。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔、キリシタン退治の頃、信徒をハリツケ、火アブリにかける。",
              "citation": {
                "source": "ヤミ論語",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちフアブリシイァス・アブ・アクアベンデンテといふ猶太の人だ。",
              "citation": {
                "source": "光る生物",
                "author": "神田左京",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
