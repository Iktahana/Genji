        "examples": {
          "standard": [
            {
              "text": "毎日の生活の中で、「石蓴」をよく耳にする。",
              "source": "幻辞"
            },
            {
              "text": "朝食の味噌汁に乾燥した石蓴を入れると、一瞬で海辺の香りが食卓に広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "見受けるところ、これは普通の緑色海藻で、石蓴属の一つであるらしい。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝の白さと、星のあおさ、それに朦朧と輪郭づけられ、夜のやみから抜けて見える。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「競子は競子、これはこれさ、僕はふわふわした男だから、ふわふわしてしまわなきあおさまらないんだ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "おらあおさよさん、この年になって初めて親の恩を知りましたよ。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どなたかお客さまでござんしたか」　わざとあわただしく駈けあがって障子をガラリ、「まあおさよさん！",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "那波・樋口と銀栖鳳へ行き、ウイスキーをのみつゝ話す、那波は日劇を二回興行で開けるやう努力するからまあおさまってくれとしきりに言ふ、ルパンへ寄ると田中三郎に逢ひ、牛込へ行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
