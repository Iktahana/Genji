          "literary": [
            {
              "text": "このアチックに洩れて来る光線は皆頭の上から真直に這入る。",
              "citation": {
                "source": "カーライル博物館",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしていつかは、アドリアチック海の奥に、砲声を聴くであろう。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "余はわが艇を、アドリアチックの海底に沈め休息をとることになった。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田先生から教へられたのは英文法と英文和譯、譯の教科書はアチック・フィロソファーとイナックアーデンとであつた。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            }
          ]
        }
