          "literary": [
            {
              "text": "また厳格な顔をして、派手な着物を着た男がアムパイアの役をする。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾度か彼等は取組み合うと、アムパイアが何か正しからぬことを見つけて彼等を止める。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後にアムパイアが何かいうと、二人は争いをやめて円場の外に出る。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
