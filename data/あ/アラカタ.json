  {
    "uuid": "26e93cec-6a2e-5f2e-994e-f63a37f0db9d",
    "entry": "アラカタ",
    "reading": {
      "primary": "あらかた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "むろん十が十まで当てにはならんが、彼奴のやりそうな事だと思うて前から睨んではおったんだ」「投書の出所はわからないか」「ハッキリとはわからんが、大学部内の奴の仕事という事はアラカタ見当がついとる。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "古くからこの土地で小さな下駄屋を遣っていたが、儲けた金は病人の女房の養生費にアラカタ注ぎ込んでいたものだという。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで説明して来たところでもアラカタ想像が付くであろう通りに脳髄局のポカン式反射交感機は、構造が非常にデリケートに出来ているのだから色んな故障を起し易いばかりでなく、その故障箇所の取換えが、なかなか急に行かない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "質問の意味はアラカタ解っている……それでは精神病者と、普通人との区別が、わからなくなるではないか。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今まで説明して来たところによって既に、アラカタ理解されているであろう。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたＷの帰朝後の態度から、Ｔ子｜母子が福岡市を中心とする一日旅程以内の処に住んでいるに違いない事をアラカタ読んでしまっていた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆はこの時お作が、饂飩屋時代に得意にしていた道行踊りを踊ろうとしている事を、アラカタ察しているにはいた。",
              "citation": {
                "source": "斜坑",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それじゃ方針がアラカタきまったから出かける事にしよう」「まあお待ちなさいよ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事情もアラカタ察していた。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩の話だけでもアラカタ見当が付くだろう。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、そんな訳で舟を漕ぎ漕ぎ友太郎の話を聞いて行くうちにアラカタの事情がわかると吾輩大いに考えたよ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラカタ一本七十五銭平均ぐらいにしか当りますまい。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "爆弾の隠匿し処などもアラカタ残らず、探り出してしまったものです。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "血だらけの櫓柄を洗って、臍に引っかけると水舟のまま漕ぎ戻して、そこいらのブクブク連中をアラカタ舷の周囲に取付かせてしまったので、とりあえずホッとしたもんだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした事情がアラカタわかると、私はソッと室を辷り出た。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "序にドンナ毒物が使用されたかもアラカタ見当が付くだろうと考えていた。",
              "citation": {
                "source": "無系統虎列剌",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「妾は眼が悪う御座いますので、三尺も離れた方の風体はボーッとしか解りませんが……」「わからなくともいいからアラカタの風采でいいんだ。",
              "citation": {
                "source": "近眼芸妓と迷宮事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも「刺青」の話に関する限り東作爺が頑として口を開かないところを見ると、そこに事件の秘密を解く鍵が隠れているのじゃないか……といったような事にアラカタ意見が一致したが、しかしＲ市のような比較的狭小な都市に刺青の研究家なぞいう者は居そうにない。",
              "citation": {
                "source": "Ｓ岬西洋婦人絞殺事件",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "幅広う申上げまする面目も御座りませぬが、初めて石月様のお物語を承っておりますうちにアラカタ五つの不審が起りました」「成る程……その不審というのは……」「まず何よりも先に不審に存じましたのは、仇討に参いる程の血気の若侍が、匂い袋を持っていたというお話で御座いました。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "十個の味噌桶の底にそれぞれ擬い小判を平等に入れて、上から鋸屑を被いかぶせ、その上から味噌を詰込んでアラカタ百斤の重さになるように手加減をした。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも五六軒も大持てに持てて高価い魚がアラカタ片付く頃になりますと、もうヘトヘトになって、息が切れて、走ろうにも腰がフラ付きます。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしかしたらこの青年は、私が貴族の出身であることをアラカタ察していて……且つは親友として信頼し切っている余りに、胸に余った秘密の歎きと、苦しみとを訴えて、慰めてもらいに来たのではあるまいかとも考えてみましたが……。",
              "citation": {
                "source": "死後の恋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまいには入口からノッソリ這入ってお出でになる態度を見ただけでもアラカタ見当が附いて来ます。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "持ってお出でになった方もアラカタ見当が……。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "探りを入れるにしても大凡の見当を付けてからの事にしなければならないと考えたが、そのアラカタの見当が、なかなか付かなかった。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そげな理由でお熊さんがアラレもない賭博を打つ……壺を振るらしいと言う見当がアラカタ付きますると、私も実のところ胆を潰しました。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "野西を落すことは、たしかに落いたが……」「聞かんでもアラカタわかっとる。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "漬け物もすこしは喰べますが、大抵六七八杯は請け合いのようで……それからいよいよ喰えぬとなりますと、煙草を二三服吸うて、一息入れてから又初めますので、アラカタ二三杯位は詰めこみます。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "古道具屋の爺もいっていたよ……どうだアラカタこれでよかろう。",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風呂場ト離レ屋トヲ廊下デツナゲルノト、ピアノノ床下ニ煉瓦ヲ積ム工事ハアラカタ終ッタガ、電話ノ切リ換エガマダデアルシ、今日ハ赤口デ日ガ悪イカラ二十一日ノ大安マデ待チナサイト昨日郁子ハ云ッテイタガ、敏子ハ構ワズ行ッテシマッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
