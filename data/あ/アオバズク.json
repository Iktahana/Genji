        "examples": {
          "standard": [
            {
              "text": "夏の夜、森の奥から「ホッ、ホッ」というアオバズクの鳴き声が聞こえてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "バードウォッチングで、木の枝にじっと止まっているアオバズクを見つけることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "アオバズクは、渡り鳥として夏に日本へやってくるフクロウの仲間だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "例えば『中央公論』（三六年七月）にのった「青葉木菟」（万太郎）とか「老ぼれ」（白鳥）とか「山女魚」（滝井）とか、の類を思い起こせば事は足りるだろう。",
              "citation": {
                "source": "思想と風俗",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
