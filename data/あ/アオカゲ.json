        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミウーソフの馬車からだいぶ遅れて、二頭の青鹿毛の老馬に引かせた、ひどく古びてがたがたする、だだっ広い辻馬車に乗って、フョードル・パーヴロヴィッチが息子のイワン・フョードロヴィッチといっしょに乗りこんで来た。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "青鹿毛の進路を変えさえすれば……。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "相変わらず青鹿毛は突き進んでいる。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "青鹿毛には乗るなと常々注意されていたのに。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "青鹿毛の巨体が突進中。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ、吉左衛門さん、吾家じゃ仙十郎の披露を済ましたばかりで、まあおかげであれも組頭のお仲間入りができた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「えゝ、まあおかげで。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "まあおかげ様で瓦斯エンヂンだけは評判を取つとりますやうなわけで。",
              "citation": {
                "source": "煤煙の臭ひ",
                "author": "宮地嘉六",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああおかげでわしにもまた傑作ができたわ。",
              "citation": {
                "source": "青銅の基督",
                "author": "――一名南蛮鋳物師の死――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はまあおかげさまで、至って丈夫です。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
