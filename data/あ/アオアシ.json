        "examples": {
          "standard": [
            {
              "text": "川沿いに広がる青葦の茂みから、時折、小鳥たちが一斉に飛び出していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "湿地帯には青葦が密集しており、風が吹くたびにザワザワという涼しげな音が聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夏の暑さを避けて、私たちは青葦の陰で釣り糸を垂らしながら静かに過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "老人は、毎日毎日汗をふきながら机に向っているわたしを可哀そうに思って、ある日、河原から幾背負いもの青葦を苅って来て、それを二階の窓の下につき出た木片ぶきのひさしにのせてくれた。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第二巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "厚くしかれた河原の青葦は、むんむんと水気を蒸発させ、葦が乾いて段々枯れてゆくきつい香りを放散させ、わたしは目がくらみそうだった。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第二巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
