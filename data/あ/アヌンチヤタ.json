        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "幕下りて後も、アヌンチヤタ、アヌンチヤタと呼ぶ聲止まねば、歌女は面を幕の外にあらはして、謝することあまたゝびなりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "觀棚よりも土間よりも、アヌンチヤタ、アヌンチヤタと呼ぶ聲｜頻なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタは聲を顫せてこれを制せんとしつれど、その聲は萬人のその名を呼べるに打ち消されぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はアヌンチヤタに近づき、アヌンチヤタともの語せり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝は猶アヌンチヤタの我｜猶太少女なることを疑ふにや。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタはたしかに猶太をとめなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我心はアヌンチヤタが妙音世界に遊びて、ほと／＼歸ることを忘れたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタが何を云ひしと問ふか。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我等二人は杯を擧げてアヌンチヤタが壽をなしたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は手を被中より伸べて拍ち鳴らし、聲を放ちてアヌンチヤタと呼びぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタは必ず我詩を拾ひしならん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "さるを今アヌンチヤタが藝を見るに及びて、その我心に入ること神曲よりも深く、その我胸に迫ること神曲よりも切なるを覺えたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタ我詩を讀まば、必ず我意を解して、我を知らんことを願ふならん。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタの影を見る幸もあらんかとてなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタに引きあはせ得さすべし。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝が詩を贈りし人の許へ、汝も我も世の人も皆魂を奪れたる彼人の許へ、アヌンチヤタの許へ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我はアヌンチヤタが前に立てり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタも亦起ちて笑みつゝ我を迎へたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時王は窓にアヌンチヤタあるを見つけ、親しげに目禮し、車の動きはじむると共に聲を揚げ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきに猶太廓にて我に酒を勸めし少女の、今のアヌンチヤタなることは、最早疑ふべからず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "されどアヌンチヤタは生れながらの猶太婦人にあらず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "喝采の聲と花束の閃は場に上りたるアヌンチヤタを迎へき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタがヂドは妙藝なり、その歌女は美質なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "即興詩の作りぞめ　この夕我と同じ年頃なる人々にて、中には我を知れるものも幾人か雜りたるが、アヌンチヤタが家の窓の下に往きて絃歌を催さむといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時我は唯だアヌンチヤタが上をのみ思ひて、すべての世の中を忘れ果てたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヌンチヤタが出窓よりさし覗きて、身を屈し禮をなしたるときは、その禮を受くるもの殆ど我一人なる如くおもはれき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "事果てて後家に歸りしが、身は唯だ夢中に起ちてさまよひありく、怪しき病ある人の如くにして、その夜枕に就きての夢には始終アヌンチヤタが我歌を喜べるさまをのみ見き。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
