        "examples": {
          "standard": [
            {
              "text": "ジャムを作るために、摘みたての赤酸塊をボウルに集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤酸塊の酸っぱい味は、お菓子の味付けに最適だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "庭で育てた赤酸塊は、毎年たくさんの実をつけている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そこへ弦のある籐の籠にあかすぐりの実を入れて手に持った女中が通り掛かったので、それにこの家は誰が住まっているのだと問うた。",
              "citation": {
                "source": "冬の王",
                "author": "ハンス・ランド　Hans Land",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
