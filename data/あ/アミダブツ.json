        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "阿弥陀仏を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは阿弥陀仏について学習した。",
              "source": "幻辞"
            },
            {
              "text": "阿弥陀仏の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は阿弥陀仏の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では阿弥陀仏が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "阿弥陀仏という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に阿弥陀仏という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では阿弥陀仏についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "阿弥陀仏を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると阿弥陀仏は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "阿弥陀仏について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では阿弥陀仏が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に阿弥陀仏は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により阿弥陀仏の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "阿弥陀仏は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に阿弥陀仏は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "「南無阿弥陀仏」と、丈夫な誰かが云ったようだった。",
              "citation": {
                "source": "労働者の居ない船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無阿弥陀仏、南無阿弥陀仏」　僕は懐にあった紙の有りたけを力杖に結ぶ。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああさっきのお百姓がものの間違でも故道には蛇がこうといってくれたら、地獄へ落ちても来なかったにと照りつけられて、涙が流れた、南無阿弥陀仏、今でもぞっとする。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と折から唸るように老人が唱えると、婆娘は押冠せて、「南無阿弥陀仏。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無阿弥陀仏と言いたくなるその妖気……その虚無世界……その中にさまよう実さんの芸的ルンペンぶり。",
              "citation": {
                "source": "実さんの精神分析",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かの句に、身を捨ててまた身を掬ふ貝杓子　他力信仰（他力信仰は浄土宗、浄土真宗の信仰の仕方で、阿弥陀仏のさしのべる手〔本願〕に救われる信仰生活です）のこつをいったものであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時唱える「南無」（「南無阿弥陀仏」を現代語にいい換えれば「光明と叡知よ、今、我に来れ」）は、この時に適した行進曲ともいい換えられます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　お千世は、薄気味悪そうに、お孝の袂に掴まりながら、直ぐ目の前なを、爪立って覗くように、と見ると、比羅紙の、およそ二枚｜凧ぐらいな大きさの真中にぼつりぼつりと筆太に、南無阿弥陀仏、と書いたのが、じめじめとして、さながら、水から這上った流灌頂のごとく、朦朧として陰気に見える。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と云う、南無阿弥陀仏の両傍に、あいあい傘の楽書のように、（となえろとなえろとなえろとなえろ、）と蛞蝓のごとくのたくり廻る。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、南無阿弥陀仏、南無阿弥陀仏。",
              "citation": {
                "source": "取舵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分は阿弥陀仏の化身親鸞僧正によって啓示されたる本願寺派の信徒である。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ遥かにかの西方の覚者救済者阿弥陀仏に帰してこの矛盾の世界を離るべきである。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はいはい南無阿弥陀仏。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と反って飛退り、下駄を脱ぎて、手に持ちはしたれども、腰の骨の蝶番がっくり弛みてただの一足も歩かれず、くしゃりと土下座して、へたへたになり、衣服をすっぽりと引被りて、南無阿弥陀仏南無阿弥陀仏。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無阿弥陀仏南無阿弥陀仏。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "殺さば殺せさ、南無阿弥陀仏南無阿弥陀仏。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺も阿弥陀仏より、御開山より、娘の顔が見たいぞいの。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「南無阿弥陀仏、」「お可哀相に、初産で、その晩、のう。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「は、南無阿弥陀仏、黒門前は真暗だんべい。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無阿弥陀仏、南無阿弥陀仏。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "南無阿弥陀仏、なむあみだぶつ」「あ、もし」と、お藤は思わず彼をよび止めた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "津の国屋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの世に行つて、ちやんと、蓮華の上に坐つて、「なむあみだぶつ」と、心から云ふことが出來るのぢや。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お内儀さん、気をたしかに持つんだよ」「なむあみだぶつ――」　と、女は両眼を閉じた。",
              "citation": {
                "source": "棺桶の花嫁",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に、「アナカシコアナカシコ」と讀み納めると、人々は、なむあみだぶつを口々に唱へて禮拜し、手にした數珠をもみ鳴らすのである。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何もかもなむあみだぶつの心持ちなり。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なむあみだぶつ、なむあみだぶつ……」　署長は、谷博士、山形警部それから勇敢な五少年の死をいたんで、思わずお念仏をとなえたのだった。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（鐘）僧一　なむあみだぶつ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "僧一同　なむあみだぶつ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてただ「なむあみだぶつ」とのみ言え。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "何事もなむあみだぶつだよ。",
              "citation": {
                "source": "出家とその弟子",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
