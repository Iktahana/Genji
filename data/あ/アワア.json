        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると突然子供はワアワアと唖のような声を出して駆け出しました。",
              "citation": {
                "source": "春の鳥",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ラッシュ・アワア」も「風景」も「檢温器と花」的なものである。",
              "citation": {
                "source": "詩集『戰爭』",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワアワアと見物人がはやす。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "町はラッシュアワアだったが、秋の侘びしい光線が一層この十字街を無秩序なものにしていた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の中に自分程可哀そうな者は無い、オボカズ女神の身体がパラオの島々と化して以来、リメイ程性の悪い女は無い、と喚き、ワアワア泣きながら家を飛び出した。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "事の次第も其の烈しさも本文中に述べた通りで（私の見たのも矢張言いがかりを付けて来た方が返り討ちに会ってワアワア手離しで泣きながら帰って行ったが）昔と少しも変る所が無い。",
              "citation": {
                "source": "南島譚",
                "author": "夫婦",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は気が弱くなり、ときには苦しさのあまり、恥も外聞も構わずワアワアと大声で哭いた。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "五百年｜経って、天竺への旅の途中にたまたま通りかかった三蔵法師が五行山頂の呪符を剥がして悟空を解き放ってくれたとき、彼はまたワアワアと哭いた。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ、好い気持になって、ワアワアヘしあってくる娘さん達の、香油と、汗と白粉のムッとする体臭にむせていると、いきなり、また吃驚させられました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、ぼく達は、向うの新聞に、オォバアワアクであると、批評されたほど、傍目もふらずに練習を重ねるのでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論、警官にみつかれば、叱られるのでしょうが、このアワア・ギャング達は、おめず臆せず、堂々と取ってのけ、その場で、ぼくにくれるのでした。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "いよいよ、好い気持になって、ワアワアへしあってくる娘さん達の、香油と、汗と白粉のムッとする体臭にむせていると、いきなり、また吃驚させられました。",
              "citation": {
                "source": "オリンポスの果実",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "買わねえ薬が利いチャッタイ」　ワアワアゲラゲラ腹を抱えている中を、吾輩は悠々と立去った。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぶつかるぞッ……」　ワアワアワアワアと蜂の巣を突いたような騒ぎの中に、船は忽ちゴースタンして七千｜噸の惰力をヤット喰止めながら沖へ離れた。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "外廊から舞台の直前まで身動き出来ない鮨詰で、一階から三階までの窓を全部｜明放し、煽風機、通風機を総動員にしても満場の扇の動きは止まらないのに、切符売場の外ではまだワアワアと押問答の声が騒いでいるのであった。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに播磨屋の千六は町人のボンチ上りだけに、取止めもなく声を放ってワアワアと泣出すのであった。",
              "citation": {
                "source": "名娼満月",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様は嘘をついているのだろう」　と、みんなワアワア騒ぎ出しました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しまいには何千人とも何万人ともわからぬ位になって、ワアワアワアワアワアと町中の騒ぎになりました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワアワアワア」　と、番頭はなおなお大きな声で泣き出しました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
