        "examples": {
          "standard": [
            {
              "text": "数学のテストで赤点を取ってしまい、夏休みに補習を受けることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "答案用紙を裏返すと、真っ赤なインクで書かれた赤点の数字が目に飛び込んできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "赤点さえ回避できればいいと考えている弟の態度に、母はため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "赤点、黒点、黒はよく、黒点かぱりかぱり。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハロルドは頭がくらくらし始め、眼の前に赤点が舞い、科酸が切れ、なんとか息をしようとした。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
