          "standard": [],
          "literary": [
            {
              "text": "「私は愛す」の作者アヴデンコが革命当時「保護者のない子供たち」ベス・プリゾールヌイの一人であったということには深甚な意味がある。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてソヴェト社会建設の各分野に働く生ける何万人かのアヴデンコとして。",
              "citation": {
                "source": "政治と作家の現実",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近ソヴェトの若い労働者の作家、アヴデンコというひとが書いた小説「私は愛す」が翻訳されて、ナウカ社から発行された。",
              "citation": {
                "source": "作品のテーマと人生のテーマ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
