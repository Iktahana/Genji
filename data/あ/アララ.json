  {
    "uuid": "6c8b7ee1-0baf-54e3-a56d-a1724387cf0f",
    "entry": "アララ",
    "reading": {
      "primary": "あらら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大正２年３月『アララギ』署名　　　　左千夫",
              "citation": {
                "source": "歌の潤い",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "かうした子規の歌――それは今日でもアララギ派歌人によつて系統されてる。",
              "citation": {
                "source": "病床生活からの一発見",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現歌壇のアララギ一派は、子規によって始められた俳人の余技歌を亜流し、歌であって俳句の境地を行こうとしている。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日でもなお、アララギ派の歌人がこの美学を伝承しているのは、人の知る通りである。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のアララギ派の歌人がその悪い伝統をすっかり受けてる。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一、極めて初期の作で「ザムボア」「創作」等に発表した小曲風のもの、及び「異端」「水甕」「アララギ」「風景」等に発表した二、三の作はこの集では割愛することにした。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中途退学だが、彼女は広島県のある女学校へ通っていたことがあり、その時可愛がってくれた先生はアララギ派の歌人だった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正九年五月、アララギ）",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "始終『アララギ』を送って頂いておりながらほんの時々しか読んでいないので甚だすまない気がしております。",
              "citation": {
                "source": "書簡（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和八年一月『アララギ』）",
              "citation": {
                "source": "書簡（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（九月二日斎藤茂吉宛）（大正十五年十月『アララギ』）",
              "citation": {
                "source": "書簡（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし座右にある最近の「アララギ」や「潮音」その他を手当たり次第に見ていると、中にはほとんど前記の第一例に近いものも、第二例に近いものも、また第三例に近いものもあるが、また中には形式においてずっと変わった特徴の見られるものも少なくはない。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが最近に寄贈を受けた「アララギ」の十一月号を開いて見ると、斎藤茂吉氏の「大沢禅寺」と題した五首の歌がある。",
              "citation": {
                "source": "連句雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの歌は「潮音」「アララギ」等に主に載せて貰つた。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "（明治四十二年一月一日發行、アララギ　第一卷第二號所載）",
              "citation": {
                "source": "旅の日記",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "（大正二年十一月十五日發行、アララギ　第六卷第十一號　伊藤左千夫追悼號所載）",
              "citation": {
                "source": "記憶のまゝ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近にアララギ誌上に掲げた「歌俳句の叫び」といふものゝ論旨に就いては私なども双手を擧げて賛同の意を表する。",
              "citation": {
                "source": "知己の第一人",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一〇月、「アララギ」創刊。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九〇九（明治四十二）年　一月、「濃霧の歌」を「アララギ」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "同月、「病中雜咏（一）」を無題で「アララギ」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "同月、「病中雜咏（二）」を「病中雜咏」の題で「アララギ」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "六〜九月、「鍼の如く（一〜四）」を「アララギ」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "同月、「鍼の如く（五）」を「アララギ」に発表。",
              "citation": {
                "source": "長塚節句集",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正八年アララギ発行所がわたくしの「食後の唄」を出版してくれた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のアララギの傾向とはまるで相合はぬものであつたが、当時は文壇がまだ甚だ分化せず、かかる雑糅が何の奇もなく行はれてゐた。",
              "citation": {
                "source": "本の装釘",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤイシヤマネーナとは「悲しやな」、クコロポンカンピとは「わが年若い帳場」、ナタアララとは「どこへ行つた」と云ふことで、若いメノコが漁場の帳場さんなる和人を愛してゐたが、その和人が内地へ歸つたのを戀ひ慕つて歌つたものである。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルメニア人信ずらく、アララット山の蛇に王種あり、一牝蛇を選んで女王と立つ。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "中央に大陸が横たわり、それから四方に向かって高まり、いわゆる「世界の山」アララットになっている。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると大正十四年八月アララギの安居會（雜誌アララギにて十年以上毎夏催す歌の精進勉強會）その年は高野山において開かれ、それに出席された齋藤茂吉氏がその時高野山で聞いた佛法僧の事を、昭和三年一月四日と五日の時事新報の文藝欄に載せてゐる。",
              "citation": {
                "source": "佛法僧",
                "author": "今井邦子",
                "note": "青空文庫"
              }
            }
          ]
        }
