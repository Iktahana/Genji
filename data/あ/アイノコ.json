  {
    "uuid": "62460cfb-4f5f-50c5-8beb-ac990e0b357e",
    "entry": "アイノコ",
    "reading": {
      "primary": "あいのこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
