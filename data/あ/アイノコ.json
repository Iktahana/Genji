    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ママも年とったらアイノコの孫を抱くのだね、楽しみだね」と、極々座興的ではあったけれど或時かの女がそれを息子の前で言ってどやされたことをかの女は思い出した。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "女だけが生き残り、アイノコを生み、別の国が生れるのだと思つてゐた。",
              "citation": {
                "source": "続戦争と一人の女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私は伊沢君と葛巻君のアイノコみたいな一人の男を考へてしまつてゐるのだ。",
              "citation": {
                "source": "戯作者文学論",
                "author": "――平野謙へ・手紙に代へて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイノコでしょう」「オレの村は日本一の村だ」「もう、いいから、帰ってちょうだい」　たまりかねて、御帰館ねがったのである。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワラジと下駄のアイノコだなア。",
              "citation": {
                "source": "発掘した美女",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "みんなアイノコになる、ねえ、そうでしょう。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局、みんな、アイノコにならなきゃいけないじゃないですか。",
              "citation": {
                "source": "退歩主義者",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦女子が犯されてアイノコが何十万人生れても、無関心。",
              "citation": {
                "source": "安吾巷談",
                "author": "野坂中尉と中西伍長",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちを生みッ放しでろくにわが子らしいイタワリも見せてくれたことのない父が、ビルマのアイノコの孫に限ってひきとりたいなぞというのが滑稽なんです。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "それともビルマのアイノコならライオンか山猫なみに育てるにもお金がかからず、気の向くままに放りだすこともできるからとでも考えているのでしょうか。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "高利がついて戻る金でなければビタ一文出したことのない仙七がビルマからアイノコの孫をよぶため息子の霊をよぶためと称して二万ナニガシのムダをする。",
              "citation": {
                "source": "心霊殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "坂と絶壁のアイノコぐらいの急坂ですよ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "スノコのカンヅメも特にクジラと云われないと、牛と豚のアイノコ、ハムの大和煮（そんな変なのはないだろうけどね）みたいな、ちょッといける物じゃないかと思う程度に食える。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれはウマニであるしアイノコ的なウドンに相違ないから、どうしても人間のために作られたものに相違ないが、案ずるに長崎チャンポンの法則として一度に一日ぶんのチャンポンを買って三度の食事ごとにここへ通ってきて三度目に食いあげる、なるほど大陸に近いだけのことはあるな、と考える。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして現在小型の日本犬と称するものには、チャウチャウとのアイノコも多い。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして傾いた屋根の下に、長い一冬の雪の下に、アキラメと楽天との区別のつかないアイノコが人々の心にしみつき、育って行くのである。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "秋田犬訪問記――秋田の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "九州の炭坑に三が日もぐりこんだがおかげで石炭のメキキができるようになったが、わが家の石炭は石炭とボタのアイノコだ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "また初冬の小春日和の一日、日和で季節をカンちがいしたらしくスイッチョンがノコノコまいこんだから、これを生け捕りにしてカステラの空箱に入れて、「昔、松永弾正というロベスピエールとフーシェのアイノコのような悪党ボスが人のできないことをやってみせるといって松虫を飼って三年生かしたそうだ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして私は伊沢君と葛巻君のアイノコみたいな一人の男を考えてしまっているのだ。",
              "citation": {
                "source": "戯作者文学論",
                "author": "――平野謙へ・手紙に代えて――",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり蘇我と物部という最高の二氏族のアイノコの物部大臣である。",
              "citation": {
                "source": "安吾史譚",
                "author": "道鏡童子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、東京から転校して来たアイノコが組にいたが、私は彼女がとても好きになり――というのは、私の悪事を知らないという安心感があったのであろうか――たった一人彼女を家へ招いた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑種児といふものは人間にあつても必ず美しいものであり、特色の烈しい眉目を持つてゐるものであるが、内田百間のアイノコ文章も誰も何もいはないけれど、どこまでも小説と随筆とが生みつけた文章らしいのである。",
              "citation": {
                "source": "「鶴」と百間先生",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "併しながら我が百間先生になると人間くさいところがあり、例のアイノコの匂ひが烈しいのである。",
              "citation": {
                "source": "「鶴」と百間先生",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまで　いえば　アイノコです。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイノコの　じくさいさんは　いつでも、けものの　かわで　つくった　どうぎを　きているのです。",
              "citation": {
                "source": "一休さん",
                "author": "五十公野清一",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、ふり返ってみると、一時は、大分その関西風すき焼が、東京へも進出して、東京風との間を行く、アイノコ流が流行ったことがある。",
              "citation": {
                "source": "牛鍋からすき焼へ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
