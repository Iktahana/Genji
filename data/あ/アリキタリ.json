  {
    "uuid": "7acbd4d9-55b4-5900-baf4-5d3391289134",
    "entry": "在り来り",
    "reading": {
      "primary": "ありきたり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
