          "literary": [
            {
              "text": "若い頃はジェイムズ・アーミティッジといったのだ。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーミティッジとして私は、ロンドンの銀行に入り、アーミティッジとして我が国の法を犯したため有罪となり、流刑を言い渡されたことがあった。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "お名前はアーミティッジ――パーシィ・アーミティッジ――アーミティッジ家の次男で、レディングのそばのクレイン・ウォータにお住みです。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            }
          ]
        }
