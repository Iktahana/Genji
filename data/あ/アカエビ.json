        "examples": {
          "standard": [
            {
              "text": "市場で見つけた新鮮な赤海老を、今夜は奮発して家族のために豪華な天ぷらにすることにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "馴染みの寿司屋のカウンターで、身が透き通るような赤海老の握りを贅沢に一口で頬張る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "殻を剥いた赤海老のぷりぷりとした心地よい食感と、濃厚な甘みが口いっぱいに広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "昭和二年三月七日丹後地震の前に、京都府｜与謝郡栗田湾や島蔭湾で深海の泥砂の中にすむアカエビやミミイカがイワシ大敷網や手繰網でおびただしくとれたと言う（奥丹後震災誌）。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤えびす共の侮蔑は却って露骨になった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "近海に赤えびすが現われたそもそもの初めであった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            }
          ]
        }
