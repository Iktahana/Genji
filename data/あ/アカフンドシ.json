        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "唯人の頭も、顔も、黒く塗りて、肩より胸、背、下腹のあたりまで、墨もていやが上に濃く塗りこくり、赤褌襠着けたる臀、脛、足、踵、これをば朱を以て真赤に色染めたるおなじ扮装の壮佼たち、幾百人か。",
              "citation": {
                "source": "凱旋祭",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "『今昔物語』二十の七に、染殿后を犯した婬鬼赤褌を著けて腰に槌を差したと記す。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "本邦にも善相公と同臥した侍童の頭を疫鬼に槌で打たれ病み出し、染殿后を犯した鬼が赤褌に槌をさしいたといい、支那の区純ちゅう人は槌で鼠を打ったという（一八六九年板、トザーの『土耳其高地探究記』二巻三三〇頁。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "派手な浴衣の赤褌に、黄色い手拭の向う鉢巻がノスタレのオーム・シッコでウンウン云ってるんですから世話ありやせんや……。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "禿頭の親爺がピンピンして頑張っておりましたので……その親父が引いてくれた魚類の荷籠に天秤棒を突込んで、母親が洗濯してくれた袢纏一枚、草鞋一足、赤褌一本で、雨風を蹴破ってワアッと飛出します。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にも赤褌一貫で、腕へ桃の刺青をした村一番の逞ましいのが、真先に上り框に立って来て呶鳴った。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きい方の児は、すぐに網干場に駈け込んで、そこに突立っている赤褌の、桃の刺青をした男に縋り付いた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤褌一つのモイ族が、二三羽のインコを籠に入れて、遊歩道で売つてゐたのを、富岡は思ひ出した。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は二人とも赤褌をしめた、筋骨の逞しい男だった。",
              "citation": {
                "source": "海のほとり",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――という、ようやっと持ちこたえてきた合理精神の歯をくいしばった渋面が、笑いの国では、突然赤褌ひとつになって裸踊りをしているようなものである。",
              "citation": {
                "source": "茶番に寄せて",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "――といふ、やうやつと持ちこたへてきた合理精神の歯をくひしばつた渋面が、笑ひの国では、突然赤褌ひとつになつて裸踊りをしてゐるやうなものである。",
              "citation": {
                "source": "茶番に寄せて",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　私の家には、その片腕の熊さんや、赤褌の豊さんやら、たわし売りのお吉さんやら、灰買いの重どんなどがいた。",
              "citation": {
                "source": "戦争雑記",
                "author": "徳永直",
                "note": "青空文庫"
              }
            },
            {
              "text": "船頭は真っ裸に赤ふんどしをしめてゐる。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "船頭は真っ裸に赤ふんどしをしめている。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
