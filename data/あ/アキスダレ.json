        "examples": {
          "standard": [
            {
              "text": "取り外すタイミングを逃した秋簾が、冷たい風に吹かれてカサカサと音を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "日差しもすっかり弱まり、窓辺に掛けられたままの秋簾がどこか寂しげに見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "庭の落ち葉を掃きながら、軒先に吊るされた秋簾を今週末には片付けようと心に決めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "帯結ぶ肱にさはりて秋簾九月二十四日　銀座探勝会。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕立来て右往左往や仲の町ここはしも山口巴｜秋簾九月二十一日　浅草探勝会。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋蝉も泣き蓑虫も泣くのみぞ敵といふもの今は無し秋の月黎明を思ひ軒端の秋簾見る八月二十二日　在小諸。",
              "citation": {
                "source": "六百句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
