        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その古い刀は赤鰯のように役に立たなくなっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "さびて古くなった刀を赤鰯と呼ぶのは昔の言い方だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "博物館に展示されている赤鰯は歴史的価値がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
