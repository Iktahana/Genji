          "standard": [
            {
              "text": "これはアイリッシュの例句です。",
              "source": "幻辞"
            },
            {
              "text": "パブから、陽気なアイリッシュ・ミュージックが聞こえてくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女はアイリッシュ・ダンスのステップを軽やかに踏んで見せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "わら色、レモン色、オレンジ色、レンガ色、アイリッシュ・セッターみたいな色、レバー色、粘土色、ありとあらゆる色合いの赤毛がおりました。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "プツデング次の代りはシチウなり　西洋料理の中に、ヨークシャー・プディングと名づくるものとアイリッシュ・シチューと名づくるものあり。",
              "citation": {
                "source": "西航日録",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "スキートは小さなアイリッシュ・セッターで、早くからバックと仲良しになつたが、バックの方では、死にかけた容態の時とて、その牝犬の初めて近附いてくるのに腹を立てることもできなかつた。",
              "citation": {
                "source": "荒野の呼び声",
                "author": "THE CALL OF THE WILD",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉は無し、オルドヴルにスープ、スクラムルエッグ、アイリッシュ・シチュウ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
