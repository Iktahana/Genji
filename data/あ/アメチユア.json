        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "之に次では横浜アメチユア倶楽部、慶応、学習院と云ふ順序で、駈出しの早大が、如何に踏張つて見た所で、迚も傍へは寄附けまいとは一般の下馬評であつた。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "各選手は尽く衝天の意気を以て、帰るや否や競技を横浜アメチユア倶楽部に申込んだ。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時慶応の勢ひは実に素晴しいもので、好敵手と云へば、先づ一高に指を屈し次でアメチユアを数へる位なもの、早大などは全で眼中に無い。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "一高、アメチユア、慶応、学習院を撫で斬りにして、事実上日本の覇者たるを得たなら、必ず米国遠征の議を成功させると云つて選手を激励した。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            },
            {
              "text": "技倆に於ても勢力に於ても、最早一高、アメチユア、学習院の敵では無かつた。",
              "citation": {
                "source": "野球界奇怪事　早慶紛爭囘顧録",
                "author": "吉岡信敬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
