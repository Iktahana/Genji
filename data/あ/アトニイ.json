          "literary": [
            {
              "text": "そうしているうちに、彼は酷い胃のアトニイに罹った。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "多少は快くなつた筈の胃のアトニイは相変らずで、食べものが不自由なので、後戻りした形だつたが、気管支もひどく悪くなつてゐた。",
              "citation": {
                "source": "佗しい放浪の旅",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "――胃酸過多、胃アトニイ、乾性｜肋膜炎、神経衰弱、慢性結膜炎、脳疲労、……　しかし彼は彼自身彼の病源を承知してゐた。",
              "citation": {
                "source": "或阿呆の一生",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            }
          ]
        }
