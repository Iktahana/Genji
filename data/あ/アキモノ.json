        "examples": {
          "standard": [
            {
              "text": "残暑が厳しい中、アパレルショップの店員はすでに秋物のセーターを着て接客している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "夏のバーゲンが終わり、デパートの紳士服売り場はすっかり秋物のスーツに切り替わっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ネット通販で注文していた秋物のジャケットが届いたので、週末のデートに早速着ていくつもりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
