    "definitions": [
      {
        "index": 1,
        "gloss": "twill (fabric)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "綾織りを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは綾織りについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "綾織りの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は綾織りの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では綾織りが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "綾織りという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に綾織りという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では綾織りについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "綾織りを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると綾織りは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "綾織りについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では綾織りが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に綾織りは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により綾織りの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "綾織りは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に綾織りは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "暗鬱と瑰麗の綾織り。",
              "citation": {
                "source": "三島由紀夫",
                "author": "ナルシシスムの運命",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い綾織りのズボンは傷んですり切れ、片｜膝は白くなり、片膝には穴があいている。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "第一に小さな黒い長衣、次に黒い襟巻き、次にコゼットの足はごく小さいので今でもまだはけそうな丈夫な粗末な子供靴、次にごく厚い綾織りの下着、次にメリヤスの裳衣、次にポケットのついてる胸掛け、それから毛糸の靴足袋。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋しくばたづねて来れ下野の那須のことやの綾織りのいけ　それで夫が、跡を追うて尋ねて来て、再びこの池のほとりで面会したという話もあります。",
              "citation": {
                "source": "日本の伝説",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜿蜒として衣桁に懸る処、恰も異体にして奇紋ある一条の長蛇の如く、繻珍、西陣、糸綿、綾織繻珍、綾錦、純子、琥珀、蝦夷錦、唐繻子、和繻子、南京繻子、織姫繻子あり毛繻子あり。",
              "citation": {
                "source": "当世女装一斑",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――綾織の帯で、塩瀬紺無地の袴。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "忍男はさすがに若殿の資格を以て、服裝も一際目立つた綾織の白袍に駒は紅もて染めたらん如き駿馬である。",
              "citation": {
                "source": "古代之少女",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "車通らず人行かず見渡す野山一色に雪を飾りて音もなく空に綾織る雪の舞病を得たる身にかなし。",
              "citation": {
                "source": "文学に現れたる東北地方の地方色",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀色の髪毛を無雑作に束ねて、黒い綾織の一重服を纏い、鼻先が上唇まで垂れ下って猶太式の人相をしているこの婦人は、顔をＳの字なりに引ん歪め、実に滑稽な顔をして死んでいた。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その男は、おそろしく細くて短かい綾織木綿の白ズボンをはいて、なかなか凝った燕尾服を著ていたが、下からは、青銅のピストル型の飾りのついたトゥーラ製の留針を挿したシャツの胸当が覗いていた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "綿綾織のズボンの腿にはダラ／＼濃い血の流れかゝつた痕があり膝から下はそれが黒く乾いてこびりついてゐる。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち前者は閉伊郡綾織村字｜砂子浜という所まで尋ねてくると、そこの村人は多勢寄り集まって何事か大騒ぎをしている。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこの翁は綾織村字逃石の里までくると、どうしたのかその石が動かなくなった。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "陸申閉伊郡綾織村の某媼の話）。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "断裂の生地は仔細にこれをしらべると凡そ綾織、絹縮ふうの羅、平織、文羅などであって、このうち紫綾、絹縮ふうの羅の部分が最も多く、色めは濃淡多少の差はあるけれども紫地が大部をしめている。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから銀の長柄に銀のなし、綾織物の小そでが三十｜重ね、これはおかあさんへの贈り物でした。",
              "citation": {
                "source": "鉢かつぎ",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから龍村さんの女帯が、滔々たる当世の西陣織と比較して、――と云ふよりは呉織綾織から川島甚兵衛に至るまで、上下二千年の織工史を通じて、如何なる地歩を占むべきものか、その辺の消息に至つては、毫もわからぬと云ふ外はない。",
              "citation": {
                "source": "龍村平蔵氏の芸術",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "サイは謂わば千人針の東京へ出て来て暮すようになったのだったが、赤い糸を縫いつける黄色い布地も、きのうあたり頼まれて手にとったのは木綿でなく、妙なレーヨンの綾織のようなものになっていた。",
              "citation": {
                "source": "三月の第四日曜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて灰色っぽい綾織の服をきた、すこし年かさらしい一人の女学生が立って、努力して感情をおさえながら、自分たちが、中国を独立した文明国にしたいと願う心、民族を向上させたいと思っているこころは、諷刺の問題ではないと思う、といった。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子は、重く大きい海老茶木綿の綾織カーテンを勢よくひいた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、木綿綾織の裏がついた綿入外套でない毛皮外套を初めて着て夫婦でお客に招かれてゆけるようになった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供たちに積木してやっているわきの座布団の上に、裾まわし分だけの紺秩父の布地と、ひろ子が母の丸帯を切って来た綾織の布地が、出しっぱなしてあった。",
              "citation": {
                "source": "播州平野",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今何と言ひますか透して先の見える透織と云ふ綾織があります。",
              "citation": {
                "source": "日本の眞の姿",
                "author": "竹越與三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛乳の煮立つのに心づき男は小鍋を卸してコップにうつすと、女は丁度化粧を終り紫地に飛模様の一枚小袖に着換えて縫のある名古屋帯をしめ、梔子色の綾織金紗の羽織を襲ねて白い肩掛に真赤なハンドバックを持ち、もう一度顔を直すつもりで鏡の前に坐った。",
              "citation": {
                "source": "ひかげの花",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "附録　失はれた毒薬（未発表詩）ブロンドとまた褐の夜々、思ひ出は、ああ、なくなつた、夏の綾織はなくなつた、手なれたネクタイ、なくなつた。",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "高利貸しの類で、粗悪なラシャやセルや綾織布やトルコ帽などを製造して五十万ばかりを得たのだった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "傾国の女王クレオパトラの昔もかくやと偲ばれんばかり、透き徹るような美しさというものはおそらくこういう女を指すものだろうと思わずにはいられなかったのであったが、しかも緩やかに巻いた腰帯は金糸銀糸の綾織に、紅玉石か真珠でも一杯に刺繍てあるらしく、それが今｜陽に燦めいて煙々と瓔珞の虹を放っている光耀さ！",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "新町村にては、遠野、土淵、附馬牛、松崎、青笹、上郷、小友、綾織、鱒沢、宮守、達曾部の一町十ヶ村に分かつ。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて遠野の町と猿ヶ石川を隔つる向山という山より、綾織村の続石とて珍しき岩のある所の少し上の山に入り、両人別れ別れになり、鳥御前一人はまた少し山を登りしに、あたかも秋の空の日影、西の山の端より四五｜間ばかりなる時刻なり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "湿気の多い島国の暑中は、裸でいてすらも蒸発はむつかしいのに、目の細かい綾織などでぴたりと体を包み、水分を含ませておく風習などを、どうして我々が真似る気になったのであろうか。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
