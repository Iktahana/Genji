[
  {
    "uuid": "a845d9f3-ba50-53d2-8d96-9c7645a85af3",
    "entry": "晶",
    "reading": {
      "primary": "あきら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
