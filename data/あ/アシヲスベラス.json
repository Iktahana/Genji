        "examples": {
          "standard": [
            {
              "text": "凍った坂道で足を滑らして転び、膝を強く打ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "濡れた石畳で足を滑らして荷物を落とし、中身が散乱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "川岸で魚を釣ろうとした拍子に足を滑らして、ずぶぬれになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そして暫く揉み合ってるうちに、年寄りの方が、突き落されるか足を滑らすかして、子供みたいに崖下へ転げ落ち、泥池にはまってしまった。",
              "citation": {
                "source": "化生のもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "これこそ大局を通観することのできない近視眼者であって、またいたずらに頭上の蠅を気にしてその足を滑らす愚者にも似ているであろう。",
              "citation": {
                "source": "社会事情と科学的精神",
                "author": "石原純",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
