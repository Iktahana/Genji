    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "是れ両村ハ北に赤麻沼の水地あり西に渡良瀬川の奔下するあり、若し河流一たび氾濫して堤防を破らば洪水ハ両村を襲ふて浮沈を共せざるべからず。",
              "citation": {
                "source": "非常歎願書",
                "author": "田中正造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが住民は隣接の赤麻沼に面する堤防缺潰箇所を自費で修築しました。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物に赤麻の約と出ているが、この想像説には信を措き難い。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎杖やアカソも算を乱して倒れていた。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "助七が先登に立ってアカソ、イラクサ、蓬などの丈なす中を押分けて行く。",
              "citation": {
                "source": "黒部川を遡る",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
