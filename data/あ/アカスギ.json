        "examples": {
          "standard": [
            {
              "text": "カリフォルニアの赤杉の森は、世界で最も高い木々で知られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤杉の樹齢は千年を超えるものもあり、樹林の中では貴重な存在だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "赤杉から作られた木材は、その耐久性と美しさで珍重されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "『そうだ、十畳を神代杉にする、そうなると又、四畳半が、赤杉の並物ではうつらぬ故、吉野杉の飛切りで貼ってくれい。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
