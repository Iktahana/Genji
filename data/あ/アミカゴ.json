        "examples": {
          "standard": [
            {
              "text": "編みかごを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは編みかごについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "編みかごの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は編みかごの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では編みかごが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "編みかごという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に編みかごという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では編みかごについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "編みかごを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると編みかごは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "編みかごについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では編みかごが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に編みかごは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により編みかごの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "編みかごは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に編みかごは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "そこはもとは熱心な学生が一ぱいに詰めかけたものであるが、今ではもの淋しくひっそりしていて、テーブルの上には化学器械が積まれ、床には編みかごが転がり、荷造り用の藁が散らばっており、明りは霧のかかっている円天井からぼんやりと射しこんでいた。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、勇気をふるい起こして、その召使頭について実験室の建物の中へ入り、編みかごだの罎だののがらくたの転がっている外科の階段講堂を通りぬけて、あの階段の下まで来た。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、あの人がその薬かそれとも何かを探しにこっそり出て来ていたらしいのです、といいますのは、書斎のドアが開いていまして、あの人がその室のずっと向うの端で編みかごの間をしきりに探していたからで。",
              "citation": {
                "source": "ジーキル博士とハイド氏の怪事件",
                "author": "THE STRANGE CASE OF DR. JEKYLL AND MR. HYDE",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな半月のかたちをした編みかごを肩にかけ、片手には、地図を折りたたんで、持っていた。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりも――」　と編みかごを肩からはずした。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "かごいりチミーは　いなかの　こねずみでしたが、　あるとき　てちがいで　あみかごに　いれられ　まちまで　いってしまって。",
              "citation": {
                "source": "まちねずジョニーのはなし",
                "author": "THE TALE OF JOHNNY TOWN-MOUSE",
                "note": "青空文庫"
              }
            },
            {
              "text": "にわの　もちぬしが　しゅうに　１ど　やさいを　まちへ　はこんでもらっていまして、　それで　いつも　おおきな　あみかごに　つめるのです。",
              "citation": {
                "source": "まちねずジョニーのはなし",
                "author": "THE TALE OF JOHNNY TOWN-MOUSE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
