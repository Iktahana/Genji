        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "夕日が沈むころ、葦辺に水鳥たちが集まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "小舟を出して、静かな葦辺の景色をのんびりと眺めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "葦辺の風に揺れる穂を見ながら、彼は昔の故郷を思い出していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "反歌春もやや潟の水曲を行きありく白鷺の眼の黒くするどさ童子柳河涼しさは水豊かなる柳かげ葦笛吹きて我等行けりし夏の照り葦辺行く子は魚籠もちて何か真顔の我にかも似る今ぞ見む郷国は童がどの顔も我によく似る太郎によく似る　（妻に）町内菎蒻屋桶に藷磨り、飴形屋掛けて飴練る、蚊ばしらや春より立たむ。",
              "citation": {
                "source": "夢殿",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "水あかり黒川の浅夜の冷やき水あかり江につづくらし広き汐騒黒川の葦辺の冷やき水あかり夜汐かまじる暗くにほへり川間橋何か藻くづの青めくは夜釣のさしてにほふならしも安旅籠この晩は少し疲れて苦しかつた。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "○若の浦に潮満ち来れば潟を無み葦辺をさして鶴鳴き渡る　〔巻六・九一九〕　山部赤人　赤人の歌続き。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "巻十五に、「鶴が鳴き葦辺をさして飛び渡るあなたづたづし独さ寝れば」（三六二六）、「沖辺より潮満ち来らし韓の浦に求食りする鶴鳴きて騒ぎぬ」（三六四二）等の歌があり、共に赤人の此歌の模倣であるから、その頃から此歌は尊敬せられていたのであろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "葦辺行く鴨の羽交に霜降りて寒き夕は大和し思ほゆ（志貴皇子）倭恋ひ寝の寝らえぬにこころなくこの洲の崎に鶴鳴くべしや（文武天皇）うらさぶる心さまねし久方の天の時雨の流らふ見れば（長田王？",
              "citation": {
                "source": "万葉集の恋歌に就て",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはさる頃の葦辺踊りのときのものでいまだにうす赤く菓子のあとがついてるが、私は近頃ながらく病床にいたあいだこれをなつかしいものにして枕もとにおき、そのおりの旅のみやげの春日の鹿をならべてあかず眺めていた。",
              "citation": {
                "source": "小品四つ",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "皿のふちにずらりと鼻をならべた赤や茶や紺青やの鹿の輪は葦辺踊りの美しい子たちの姿である。",
              "citation": {
                "source": "小品四つ",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代の温気の世界は何を創造しつつあるか、まだよく判然しないけれども、先ず河合ダンスと少女歌劇と、あしべ踊りと家族温泉と赤玉女給等は、かなり確かな存在であろうと考える。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしべ踊　ここに葦の葉の模様のついた淡卵色の粗末な小皿がある。",
              "citation": {
                "source": "小品四つ",
                "author": "中勘助",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けば初代の鷺さくさんは嘗て南地の演舞場の師匠をしてい、あしべ踊の振付をしていた人なので、初代が死んだ時に二代目のおさくさんにも廓の師匠となってくれるように話があったのだそうであるが、故人は真っ平御免だと云って断った。",
              "citation": {
                "source": "細雪",
                "author": "中巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この歌は大正九年五月大阪に行かれた時蘆辺踊りか何かを見て作つた歌。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "田簑の島で禊をして恋を忘れるといふ話を寡聞にして知らないが、蘆辺踊りに興じて毎年やつて欲しいと思ふ心持を少くも田蓑の島に寄せて時所を明かにしたものであらう。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "万葉の中には「田子の浦ゆうちいでて見れば真白にぞ不尽の高嶺に雪はふりける」「わかの浦に汐満ちくれば滷をなみ蘆辺をさしてたづ鳴きわたる」などといふ歌ありて、人も名歌とし、われらも爾か思へり。",
              "citation": {
                "source": "人々に答ふ",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "土用過ぎの日の、傾き加減になつてから、波ばかりぎら／＼光る、蘆辺浦に這入つた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "出稼ぎに来て、近海で獲つた魚類は、皆壱州の三つ浦――郷野浦・勝本と此蘆辺――で捌いて、金に換へる。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "其先ぶれが、あの少年となり、蘆辺浦の風景となり、東京戻りの壱州人とのとり違へとなり、此中婆さんとなつて、私の心に来てゐるのだ、と言ふ気がして、此港の町の狭い家並みに、見る物すべてに憑しい心が湧いた。",
              "citation": {
                "source": "雪の島",
                "author": "熊本利平氏に寄す",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶴なき渡る（黒人――万葉巻三）和歌の浦に汐みち来れば、潟をなみ、蘆辺をさして、鶴鳴きわたる（赤人――万葉巻六）此二つの歌を並べて見ると、赤人が黒人を模してゐた様はよく見える。",
              "citation": {
                "source": "叙景詩の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "『汐汲む為めとは思へども、』『よしそれとても、』『女車』と両女性が互に歌ふと、地謡が『寄せては帰る潟をなみ蘆辺の田鶴こそは立ちさわげ』と歌ひ始める。",
              "citation": {
                "source": "能楽論",
                "author": "野口米次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "水鳥の蘆辺を立って、遥に筑波の方に飛んで行くを見送っては、半時も一時間も、見えなくなっても、猶空を眺めて居る。",
              "citation": {
                "source": "漁師の娘",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「まあ、久松さんは学者ね……私は淀川の蘆辺で、こんな実際教訓をうけるとは思いませんでした」「判りましたね。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――難波津の蘆辺の千鳥泣きくれて――」　ここまで言うと隅ッこにいる青年が美しい声に昂奮して、「呂昇よりうまいぞ」と叫んだ「人の心の浮沈み――」「よう女雲右衛門！",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『壱岐続風土記』巻四十四、蘆辺浦の条、海辺の小名の中に、ごうや　石多くして空地なりゆえに名とすとある。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
