        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "編み棒を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは編み棒について学習した。",
              "source": "幻辞"
            },
            {
              "text": "編み棒の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は編み棒の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では編み棒が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "編み棒という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に編み棒という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では編み棒についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "編み棒を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると編み棒は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "編み棒について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では編み棒が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に編み棒は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により編み棒の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "編み棒は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に編み棒は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "少女はもう膝の上に毛糸の玉を転がしたなり、さも一かど編めるように二本の編み棒を動かしている。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが眼は油断なしに編み棒の先を追いながら、ほとんど媚を帯びた返事をした。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女はもう大真面目に編み棒の先へ目をやっていた。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "微笑を含みてこの光景を見し浪子は、日のまぶしきに眉を攅め、目を閉じて、うっとりとしていたりしが、やおらあなたに転臥して、編みかけの韈をなで試みつつ、また縦横に編み棒を動かし始めぬ。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（なるほど、上手奥で鞍馬山の最初の部分の大薩摩が、殆んど三味線の糸が切れんばかりの烈しさで鳴り出している）……（三好、無意識に左手で顔の涙をブルンと拭いて、気が附くと、レース編みの編み棒をまだ握っている。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さうですか……」と、膝に白い毛糸の球をころばしながら何かを編んでゐた武井さんは、編棒の手を止めて窓の方に首を差し延べた。",
              "citation": {
                "source": "病院の窓",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二等甲板の船艙のつるつる光る白い壁に黒いかつぎのカトリックの尼さんが緑の円い瞳をそらに投げて竹の編棒をつかってゐる。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから編棒と毛糸の球を持出して、暫くは黙って切々と編物をしている。",
              "citation": {
                "source": "平凡",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし葉子は、子供の相手になって童謡を謳ったり、咲子にお化粧をしてやったり、器用に編棒を使ったり、気が向くと時には手軽な西洋料理を作るとか、または恋愛小説に読み耽り、長男と新らしい文学や音楽映画の話をするのが、毎日の日課で、勝手元を働くのは、年の割りに体のかっ詰まったお鈴という女中だけであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の降る中をぬれそぼちながら、傘を車の輪のように地上に回して来る頑童もあれば、傘の柄を頸のところで押さえて、編棒と毛糸とを動かして歩いて来る十二三の娘もあった。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "編棒を動かしながら二人は気が落ついて居るらしい口調で話して居る。",
              "citation": {
                "source": "旅人（一幕）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな袋に編棒を入れて居られるのが見える。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "――手馴れた竹の編棒、滑りよい絹混りの毛糸、あたりの浄らかな静けさ。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「健ちゃん」　暫く幸子のペンの音と、竹の編棒の触れ合う音ばかりが夜の室内を占めた。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――変りもん同士で、面白くやってゆけると思うんだがな……自由に……」　――朝子の編棒は、同じように動いている。",
              "citation": {
                "source": "一本の花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サエとサワ子はわきから顔を近くよせて自分もやって見たそうに眺め、進は居心地よさそうにはまりこんだ元の場所から、佐太郎はカリンの机の前から、二人の女の、速い、むらのない編棒の動きを見ている。",
              "citation": {
                "source": "鏡餅",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そうすれば私たちも安心だのに」　改めて、記憶の隅までをさぐり直す表情で、毛糸の玉をころがしつつ黙って編棒を動かしていたが、「ちょっと！",
              "citation": {
                "source": "日々の映り",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "友子の編棒からは、一段一段と可愛い桃色の毛糸の赤坊ケープがつくり出されていた。",
              "citation": {
                "source": "朝の風",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウーとうなると、グイと糸をひっぱって、編棒で突きさしたりして、丸い毛糸の玉を、むしゃくしゃに捻りあげてしまった。",
              "citation": {
                "source": "田沢稲船",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そのすぐ後で、萱野夫人が編棒の手をやめたのと、常子夫人が書物を投げ出したのと、それから、梨枝子の「あツ」といふ絶え入るやうな叫びとが殆んど同時であつた。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥さんは、涼しい顔で、編棒を動かしてゐてください。",
              "citation": {
                "source": "誰でもない……自分でもない",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "――（眼を編棒の先からはなさずに）おや、男つて、そんなにえらいもの？",
              "citation": {
                "source": "ふらんすの女",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二人はそのままの姿で並んだままジッとしていたが、登美がそれまで右手に握っていた金属の編棒を、着物の上から佐田の脚のどこかにグッと突き立てて、次第に力を加えて行く。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（編棒を三好のわき腹の方に出す。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三好、登美の顔を尚もジーッと見ていてから、その編棒に眼を移す）三好　……ああ、血が附いてる。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（編棒を取る）そいでビッコを引いていたのか。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（二人しばらく、そのままで居るが、やがて三好、頭をブルブル振りながら立ち、縁側に出て、編棒を持ったまま、ユックリ歩く……間）かには自分の甲らの形に自分の穴を堀る。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（また泣き出す）三好　……（その編棒をポイと植込みの方に投げ捨ててスタスタ縁側の方へ行く）……痛え、やっぱし。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金属製の編棒が、動くたびに冷たい色にちかちかと光った。",
              "citation": {
                "source": "田舎医師の子",
                "author": "相馬泰三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「その編棒を取って頂戴な！",
              "citation": {
                "source": "令嬢エミーラの日記",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
