        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "十八歳の夏休みに東京へ遊びに来て尾張町のＩ家に厄介になっていた頃、銀座通りを馬車で通る赤服の岩谷天狗松平氏を見掛けた記憶がある。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "天狗煙草が全盛の時代で、岩谷天狗の松平氏が赤服で馬車を駆っているのを見た記憶がある。",
              "citation": {
                "source": "銀座アルプス",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "感傷的な絵、滑稽な露骨な絵、売笑婦の姿、皇族、赤服の皇帝、青服の皇帝、ゲルマン号の舵を取って天を軽蔑してる老水夫服の皇帝、そんなものが雑然と並べてあった。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇帝親衛兵のいた所には今は赤服の近衛兵がいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
