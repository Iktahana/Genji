        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "線香を立てて死人扱いをするのがかあいそうでならないけれど、線香を立てないのも無情のように思われて、線香は立てた。",
              "citation": {
                "source": "奈々子",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、時おり、「かず枝も、かあいそうだね。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かあいそうなことを言う、しかし実際あの男は、どことなく影が薄いような人であったね、窪田君。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ばアさん、泣きの涙かなんかでかあいい男を新橋まで送ったのは、今から思うと滑稽だが、かあいそうだ、それでなくてあの気の抜けたような樋口がますますぼんやりして青くなって、鸚鵡のかごといっしょに人車に乗って、あの薄ぎたない門を出てゆく後ろ姿は、まだ僕の目にちらついている。",
              "citation": {
                "source": "あの時分",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはかあいそうだ。",
              "citation": {
                "source": "クねずみ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビジテリアンたちは、動物が可哀そうだという、一体どこ迄が動物でどこからが植物であるか、牛やアミーバーは動物だからかあいそう、バクテリヤは植物だから大丈夫というのであるか。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "で私のおたずね致したいことはパンフレットにもありました通り動物がかあいそうだからたべないとあなた方は仰っしゃるが動物というものは一種の器械です。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物がかあいそうならいつの間にか植物もかあいそうになる筈だ。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "本とうに動物が可あいそうなら植物を喰べたり殺したりするのも廃し給え。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "又バクテリヤの意識だってよくはわかりませんがとにかく私共が生れつきバクテリヤについては殺すとかかあいそうだとかあんまりひどく考えない。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物がかあいそうだから喰べないなんということは吾等には云えたことではない。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "な、あの二人さ、かあいそうだよ。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつは本当はかあいそうですね」「ええ、まあ、火が少し白くなったわ、せわしく燃えますわ」「きっと今秋ですね。",
              "citation": {
                "source": "シグナルとシグナレス",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもそれではあんまりかあいそうだから、どうだ、みんな一ぺんに今の仕事をやめてしまえ。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山男はもうすっかりかあいそうになって、いまのはうそだよと云おうとしていましたら、外の支那人があわれなしわがれた声で言いました。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そいつはかあいそうだ。",
              "citation": {
                "source": "山男の四月",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘉十の手拭はかあいそうに泥がついてところどころ穴さえあきました。",
              "citation": {
                "source": "鹿踊りのはじまり",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつはかあいそうだ。",
              "citation": {
                "source": "みじかい木ぺん",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども私はさっき、もうわるいことをしないと誓ったしこの猟師をころしたところで本当にかあいそうだ。",
              "citation": {
                "source": "手紙　一",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "チュンセがもしもポーセをほんとうにかあいそうにおもうなら大きな勇気を出してすべてのいきもののほんとうの幸福をさがさなければいけない。",
              "citation": {
                "source": "手紙　四",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴーシュは何がなかあいそうになって「おい、おまえたちはパンはたべるのか。",
              "citation": {
                "source": "セロ弾きのゴーシュ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、今しがた自分が覗いた生々として落ちついた井の底の世界を、蝙蝠もまた、あこがれているのではあるまいか――「かあいそうな、夕闇の動物」　お涌は、この小さい動物をいじらしいものに感じた。",
              "citation": {
                "source": "蝙蝠",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてあらゆるいきものはみんな気のいい、かあいそうなものである。",
              "citation": {
                "source": "カイロ団長",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペムペルという子はほんとうにいい子だったのにかあいそうなことをした。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妹のネリという子もほんとうにかあいらしいいい子だったのにかあいそうだなあ。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどほんとうにかあいそうだ。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ペムペルという子は全くいい子だったのにかあいそうなことをした。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネリという子は全くかあいらしい女の子だったのにかあいそうなことをした。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにまたあんなかあいらしい日に焼けたペムペルとネリの兄妹が何か大へんかあいそうな目になったというのですものどうして泣かないでいられましょう。",
              "citation": {
                "source": "黄いろのトマト",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
