        "examples": {
          "standard": [
            {
              "text": "漆器の美しさを引き立てる、深みのある赤紅が塗られている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕焼け空が赤紅に染まり、街全体が幻想的な雰囲気に包まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼女は赤紅の口紅を引き、鏡に向かって微笑んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "之を目がけて老女口より赤紅の焔を長く吐き上げる。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うん」「徳さんが、――今、そこに、おかみさんが来てるんですわ」「うん、何かア」　やがて、鈍ろい、呆けたやうな返事をしながら、房一の湯上りでよけい赤紅く輝く顔がのぞいた。",
              "citation": {
                "source": "医師高間房一氏",
                "author": "田畑修一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
