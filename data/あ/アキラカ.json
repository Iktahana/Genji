        "examples": {
          "standard": [
            {
              "text": "秋の夜空には、満月が明らかに輝いていて道行く人の足元を照らしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "月光が湖面を明らかに照らし出し、幻想的な風景が広がっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "闇夜の中でも、星々の光が明らかに地上を照らしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": []
