        "examples": {
          "standard": [
            {
              "text": "雨上がりの森を散策していると、鮮やかな緑色の藍茸を見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "この藍茸は美味しい出汁が出るので、スープ料理によく使われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "きのこ狩りに行ったが、目当ての松茸は見つからず、藍茸ばかりが採れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "その九「うぐいすも、都の春にあいたけと、きは淀川へ上り舟、………」お久は絃を三下りにして地唄の「あやぎぬ」をうたっていた。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
