      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "place where raindrops fall from the eaves",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨落ちを使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは雨落ちについて学習した。",
              "source": "幻辞"
            },
            {
              "text": "雨落ちの使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は雨落ちの定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では雨落ちが大切だ。",
              "source": "幻辞"
            },
            {
              "text": "雨落ちという概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に雨落ちという表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では雨落ちについての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "雨落ちを正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると雨落ちは複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "雨落ちについて詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では雨落ちが使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に雨落ちは重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により雨落ちの意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "雨落ちは様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に雨落ちは興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "しとしとと雨は降る、雨落ちの音が、ぽちゃりぽちゃりと落ちはじめた。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝吉はまず雨落ちの石へそっと菅笠を仰向けに載せた。",
              "citation": {
                "source": "伝吉の敵打ち",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "吹くともなく渡る風のせいであろう、そこここに散っている桜の花も、いつの間にかこっちへ吹きよせられて、今では、雨落ちの石の間に、点々と白い色をこぼしている。",
              "citation": {
                "source": "運",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "また実際そのお島婆さんの家と云うのが、見たばかりでも気が滅入りそうな、庇の低い平家建で、この頃の天気に色の出た雨落ちの石の青苔からも、菌ぐらいは生えるかと思うぐらい、妙にじめじめしていました。",
              "citation": {
                "source": "妖婆",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "※子は、急に引きしまった顔になりながら、何故あんなに急に飛び立ったのかと少し延び上って外をすかして見ると思い掛けず隅の雨落ちの所に洋傘を半つぼめにしたお久美さんが立って居た。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と振り切る様にして又元の雨落ちの所から下へ下りた。",
              "citation": {
                "source": "お久美さんと其の周囲",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「梯子を貸して貰ひ度いが――」　裏の物置から持つて來た九つ梯子を雨落ちに据ゑると、一番上は丁度雨戸の欄間に屆きます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "蝉丸の香爐",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここでございますよ、親分さん」　店と奥の境、ちょうど庭木戸を入った雨落ちのところに、番頭和助の死体が、菰を被せてありました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "三千両異変",
                "note": "青空文庫"
              }
            },
            {
              "text": "「梯子を貸して貰いたいが――」　裏の物置から持って来た九つ梯子を雨落ちに据えると、一番上はちょうど雨戸の欄間に届きます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "蝉丸の香炉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「だから素直にこわして雨落ちも、お隣に落ちないようにしたんだ。",
              "citation": {
                "source": "蜜のあわれ",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるじの老夫妻は裏へとびだして、雨落ちの底の下へ土下座をしていた。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、例の奥まった所にある石神の拝殿に腰かけていた一つの人影が、名月や池をめぐりて夜もすがら――そんなふうに、ふところ手をして、秋草の間をあるいていたかと思うと、いつか、千蛾の部屋の窓明りをぬすんで、その雨落ちの下に、盲蜘蛛のようにかがみ込んでいました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "当主なる老人の話に、この人四十あまりのころ、おひで老人の息子亡くなりて葬式の夜、人々念仏を終りおのおの帰り行きし跡に、自分のみは話好きなれば少しあとになりて立ち出でしに、軒の雨落ちの石を枕にして仰臥したる男あり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "石堂十馬と仁木於義丸のふたりが、やがて、がんじ縛めにした若い男を縁の雨落ちの辺にひきすえた。",
              "citation": {
                "source": "私本太平記",
                "author": "建武らくがき帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "庇から落ちる雪解の雨垂れがきらきらと美しく光っては、あまおちの小石を賑やかに叩いていた。",
              "citation": {
                "source": "いさましい話",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思いも寄らぬ蜜柑の皮、梨の核の、雨落、鉢前に飛ぶのは数々である。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ううむ、」　と頭を掉ったので、すっと立って、背後の肱掛窓を開けると、辛うじて、雨落だけの隙を残して、厳しい、忍返しのある、しかも真新い黒板塀が見える。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　これに一言句あるべき処を、姉さんは柔順いから、「お出花が冷くなって、」　と酒井の呑さしを取って、いそいそ立って、開けてある肱掛窓から、暗い雨落へ、ざぶりと覆すと、斜めに見返って、「大な湯覆しだな、お前ン許のは。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、高縁の雨落に、同じ花が二、三輪咲いているように見えた。",
              "citation": {
                "source": "七宝の柱",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　お雪さんは、歌磨の絵の海女のような姿で、鮑――いや小石を、そッと拾っては、鬼門をよけた雨落の下へ、積み積みしていたんですね。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　いま、障子外の雨落の雫がこの響きで刎ねそうであった。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "町もこうは狭からざりしが、今はただ一跨ぎ二足三足ばかりにて、向の雨落より、此方の溝まで亙るを得るなり。",
              "citation": {
                "source": "照葉狂言",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "事実、空間に大きく燃えたが、雨落に近づいたのは、巻莨で、半被股引真黒な車夫が、鼻息を荒く、おでんの盛込を一皿、銚子を二本に硝子盃を添えた、赤塗の兀盆を突上げ加減に欄干｜越。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああこの食物、ああこの労働、ああこの規則、これではたして二カ年半の長日月を堪え得るであろうか、などと秋雨落日の夕、長太息をもらしたこともあった。",
              "citation": {
                "source": "獄中消息",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルギウスは女が檐下の雨落に足を踏み込んだと云ふ事を知つた。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "風強し、心不安、また不安、雨落つ、ますます不安、夢は故郷か、旅先か、父母兄弟、また妻を子も案ぜらる人もあるに違いない。",
              "citation": {
                "source": "平泉紀行",
                "author": "──専攻科第一類歴史部──",
                "note": "青空文庫"
              }
            },
            {
              "text": "真東に向はしめたる像の秋これよりや時雨落葉と忙がしき十一月三日　武蔵調布上｜布田三〇四、新田霞霧園隣地、虚子胸像除幕式。",
              "citation": {
                "source": "五百五十句",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月の陽は縁から雨落に這つて、江戸の櫻ももうお仕舞ひ、狹い庭に草の芽が萠えて、蟻はもう春の營みに、忙しい活動を續けて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "敵持ち",
                "note": "青空文庫"
              }
            },
            {
              "text": "狸囃子を使つたのは、本所の七不思議をもじつたに相違ありませんが、實は貸本の「繪本太閤記」から思ひついたことで、日吉丸が、蜂須賀小六のところから、刀を盜み出すのに、三晩も續けて笠を雨落に置き、小六の心を疲らせて、曉方ウトウトとしたところへ入つて首尾よく取つたといふ術を用ゐたので御座います。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "たぬき囃子",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨落の笠代りに狸囃子を使つたまでで御座いますが、もう一つ、狸囃子を聞かせたわけは、あの囃子の音に合せて、鋸を引く上、目の覺めて居るものでも、一寸氣が付かないからで御座います」　と言つて居ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "たぬき囃子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
