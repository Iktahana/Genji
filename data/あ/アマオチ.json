[
  {
    "uuid": "ddb09569-9c6c-5af2-b60d-6a2e33043623",
    "entry": "雨落ち",
    "reading": {
      "primary": "あまおち",
      "alternatives": [
        "あめおち"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
