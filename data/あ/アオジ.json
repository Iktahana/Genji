[
  {
    "uuid": "2f747243-15d4-5fd1-b30e-8fd4f976c63c",
    "entry": "蒿雀",
    "reading": {
      "primary": "あおじ",
      "alternatives": [
        "アオジ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
