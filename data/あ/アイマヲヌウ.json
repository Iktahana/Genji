        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "育児と仕事で多忙な彼女は、合間を縫うようにして資格の勉強を続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "出張の移動中、合間を縫って現地の美術館に立ち寄った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "締め切り前の作家は、睡眠時間を削り、合間を縫って執筆を進めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
        "gloss": "to weave one's way (e.g. through a crowd)",
        "register": "standard",
