          "literary": [
            {
              "text": "役人に追立てられて慌て惑う状が、城楼の上からも一々見て取れる。",
              "citation": {
                "source": "盈虚",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まして村鳥のような未荘の男女が慌て惑う有様は、彼をしていっそう痛快ならしめた。",
              "citation": {
                "source": "阿Ｑ正伝",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌て惑うな、四散するな。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "衆は立つ足もなくあわて惑う、牛あれて一｜蹴りに駈け散らして飛び行く。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし母は一たい病気には神経質な性質で、滅多にひかない感冒でもたまにこれにかかって熱でも出すと、もうこれで死ぬのじゃないかとあわて惑うような大袈裟なところがあります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
