        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あゝ、あの、手遊びの青首の鴨だ、と見ると、續いて、追ひ状に袖の下を拔けたのは、緋に黄色に、艶々とした鴛鴦である。",
              "citation": {
                "source": "魔法罎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴨だ、光つて潜く青首鴨は葦かびを噛む。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝もまた、青首（鴨）が来ている。",
              "citation": {
                "source": "暴風雨に終わった一日",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "茸は不漁であつたらしいが、何処からか彼等は青首の鴨を見附けて来た。",
              "citation": {
                "source": "木枯紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "合鴨の青首はあひると同じ格好で区別がつかぬ。",
              "citation": {
                "source": "料理メモ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとしがらの蔭に枯っ風をさけて集ったほほかむり達、引ぬいて来た生大根の青首にかじりついてる。",
              "citation": {
                "source": "馬鈴薯階級の詩",
                "author": "中島葉那子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時はわざわざ猟師に頼んで、生きた青首の鴨の番いを手に入れて、それを葬式の時の放鳥のように大きい竹籠に入れて持ってきたこともある。",
              "citation": {
                "source": "御殿の生活",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
