          "literary": [
            {
              "text": "そして、アドソルビンをのんで、げんのしょうこをのんで。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アドソルビンという腸内の殺菌吸着剤が三共にあるかしらとも考えて居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アドソルビンをのむ、げんのしょうこをのむ。",
              "citation": {
                "source": "日記",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤土の特性として、その粒子の吸着水の問題をとりあげているが、アドソルビンのように吸着性の強いものでも霜柱は出来ぬからそのせいだけではないことを確め、次に赤土の中に含有されている有機物のためかも知れぬという疑問を出し、それでもないという結論を得ている。",
              "citation": {
                "source": "「霜柱の研究」について",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
