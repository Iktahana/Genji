    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "老生ちかごろ白氏の所謂、間事を営み自ら笑うの心境に有之候。",
              "citation": {
                "source": "花吹雪",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしの如き間人の間事業が偶これを追窮するに過ぎない。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "世間事物の外形は千変万化も大抵限りあれば、酷似せるものが箇々別源から出来上るも不思議ならず。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "桐葉分封二百余、蒼々陰護九松居、　　無端燬倣渾間事、同病応憐道士徐。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "総て兵器工業は民間事業を特に活用するを要するものと信ずる。",
              "citation": {
                "source": "戦争史大観",
                "author": "石原莞爾",
                "note": "青空文庫"
              }
            },
            {
              "text": "これらの建物は十二世紀の間事実上そのまま保全せられていた。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもかれが、金属人間事件の責任ある探偵でなかったら、もっと前に目を白くして、ひっくりかえっていただろう。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "『人造人間事件』は、「オール讀物」に発表したものである。",
              "citation": {
                "source": "『十八時の音楽浴』の作者の言葉",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "之で急行十三時間事件はお終いである。",
              "citation": {
                "source": "急行十三時間",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "是は學者の微視觀により明にせられたのであるが、中間事實の變化することは、巨視觀により常識を以て承認することが容易である。",
              "citation": {
                "source": "歴史の概念",
                "author": "狩野亨吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "二度目に行ったとき、伸子は三時間事務所の壁ぎわの長椅子で室のわりあてられるのを待った。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが民間事業などに関係して、こじれた固定した理論を以て、自分の識者らしさを誇示しようとした。",
              "citation": {
                "source": "民俗芸能の春",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "延徳二年七月の条には、「斎藤越後契約の間事いささかこれをつかわす」とあって、そのとき受け取った千六百疋の中から、何ほどかを与えている。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一は全く無心の間事である。",
              "citation": {
                "source": "十日の菊",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "掃墓の間事業は江戸風雅の遺習なり。",
              "citation": {
                "source": "礫川記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "追討之間事、偏大将軍之最也。",
              "citation": {
                "source": "奥州における御館藤原氏",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "『東寺文書』に、当寺散所法師原間事、奏聞候之処、被宛‐置長日掃除役之間、雖不可混一同之沙汰、法勝寺地堀事異他之上者、別為寺家之沙汰、可令召進給之間、被仰下候也。",
              "citation": {
                "source": "俗法師考",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ等のことは「人間事」と云ふ自分の記録的小説の中に記した。",
              "citation": {
                "source": "芥川龍之介を憶ふ",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
