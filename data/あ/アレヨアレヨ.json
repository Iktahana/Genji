        "examples": {
          "standard": [
            {
              "text": "あれよあれよと進学が決まった。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと季節が変わった。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと関係が進展した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと状況が変わった。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと問題が発生した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと時間が経った。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと昇進が決まった。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと成功を手にした。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと人生が変わった。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと権力が移った。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと危機が訪れた。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと機会が来た。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと決定が下された。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと事態が進んだ。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと実現した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと展開した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと変化した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと成熟した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと確定した。",
              "source": "幻辞"
            },
            {
              "text": "あれよあれよと解決した。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "午後の二時頃になって、その人々のあれよあれよと言う声が頻りに聞えた。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねてより命じけむ、夜叉羅刹は猶予わず、両個一斉に膝を立てて、深川夫人の真白き手首に、黒く鋭き爪を加えて左右より禁扼、三重襲ねたる御襟を二個して押開き、他目に触らば消えぬべき、雪なす胸の乳の下まで、あらけなく掻あくれば、綾子は顔を赧めつつ、悪汗津々腋下に湧きて、あれよあれよと悶えたまう。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよ、古狐が、坊主に化けた白蔵主。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そがなすままに委しおけば、奇異なる幻影｜眼前にちらつき、※と火花の散るごとく、良人の膚を犯すごとに、太く絶え、細く続き、長く幽けき呻吟声の、お貞の耳を貫くにぞ、あれよあれよとばかりに自ら恐れ、自ら悼み、且つ泣き、且つ怒り、且つ悔いて、ほとんどその身を忘るる時、「お貞。",
              "citation": {
                "source": "化銀杏",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "打ち見たところ、首をかしげて、何考えるか寒の蛙の寒そうな、ちょっぴり温めてくれようか」　そう言ったかと思うと、はや佐助の五体はぱっと消え失せて、一条の煙が立ちのぼった、――と、見るより、煙は忽ち炎と変じて、あれよあれよという間に、あたり一面火の海と化し甲賀流火遁の術であった。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はことの意外に呆れてしまったが、果して間もなくあるビルディングの地下室にある理髪店へ行くと、金縁眼鏡をかけたそこの主人はあなたのような髪は時局柄不都合であると言って、あれよあれよと驚いている間に、私の頭を甲型か乙型か翼賛型か知らぬがとにかく呉服屋の番頭のような頭に刈り上げてしまった。",
              "citation": {
                "source": "髪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "附近の百姓ども、あれよあれよと騒いだが、村々在々の顔役共は真田邸で酔いつぶれているので、どうすることも出来なかった。",
              "citation": {
                "source": "真田幸村",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが発表から半年ほどの一九九一年十月に、言いだしっぺのコンパックの社長ロッド・キャニオンが取締役会で突然解任されたあたりから、あれよあれよの腰砕けとなった。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんぐりの背比べの中から物の弾みでひょいと頭一つ飛び出せば、後はこの空間を支配する標準化の力学が、あれよあれよというまに絶対的な強者に押し上げてくれた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよという間に、海の向こうでは何百万本単位で売れ始めたという話を聞かされている最中も、心の底には小さなとげが引っ掛かっていた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々はそれを見てあれよあれよと目をおどろかした。",
              "citation": {
                "source": "大力物語",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬は益々驚いて、濃紅姫の死骸を載せた馬車を引いたまま大勢の兵隊の真中に駈け込んで、逃げ迷うものを蹴散らし轢き倒して、あれよあれよという中に往来を向うの方に疾風のように駈け出しました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷のような音を立てて来る「瞬」の馬車を見て、慌てて白髪小僧を片傍へ引っぱって避けさせようとしましたが、彼の時早くこの時遅く、大風のように近附いた「瞬」の馬車は白髪小僧の背中を掠めて、背負っていた月琴を梶棒に引っかけたままドンドン走って行って、あれよあれよという中に見えなくなってしまいました。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕たちがあれよあれよと見まもっているうちに、あの船はだんだん上へあがってしまって、やがて見えなくなったんです。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよと見る間に、例のカリカリカリという怪音をあげて、東京ホテルの裏に立っている大きな自動車のガレージを噛りはじめた。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ降参しないかっ」　と、おどりかかる憲兵隊に、さすがのスパイたちも、あれよあれよとさわいでいるうちに、しばりあげられてしまいました。",
              "citation": {
                "source": "電気鳩",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うと、今度はどんどん縮みはじめて、あれよあれよといううちに、元のゴム毬位の大きさになり、やがてぱっと消えてしまいました。",
              "citation": {
                "source": "新学期行進曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよという間に、社会主義の首府に向って、飛行機は飛び去り、芝居は終るというわけである。",
              "citation": {
                "source": "ソヴェトの芝居",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "下では群臣が、拳を振りあげ、声を限りにあれよあれよと叫んでいる。",
              "citation": {
                "source": "古き小画",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよと満座が騒ぐなかで、勝負は一瞬に決してしまった。",
              "citation": {
                "source": "人外魔境",
                "author": "水棲人",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、十日ばかり後に大難関に逢着し、あれよあれよという間に折竹参加という、大｜報道価値がかき消えてしまうとは……　というのは、次のような声明書、「大地軸孔」行きを断念するという意外な折竹の発表が、朝刊締切後の深更の各社をおどろかした。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "その途端に一陣の風がさっと、猿沢の池に落ちて、鏡のように見えた水の面に無数の波を描きましたが、さすがに覚悟はしていながら慌てまどった見物が、あれよあれよと申す間もなく、天を傾けてまっ白にどっと雨が降り出したではございませんか。",
              "citation": {
                "source": "竜",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよと見送って、そのすさまじさに自失していた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故火を救ひに集つた町方の人々も、唯、あれよあれよと立ち騒いで、狂気のやうな娘をとり鎮めるより外に、せん方も亦あるまじい。",
              "citation": {
                "source": "奉教人の死",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれよあれよといううちに、スピードはいよいよ増して、地球が大きな球になって見えだした。",
              "citation": {
                "source": "ふしぎ国探検",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで崖下にいるわれわれの存在に気がついて、長いくびをのばして、あれよあれよというまに崖の下にいる僕らのうちの誰かの頭にがぶりとかみつき、むしゃむしゃとたべてしまう。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を今更、五万台にのぼる敵の地底戦車兵団をわれわれの足の下に迎え、あれよあれよと騒いで間に合うものか。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "群衆がその方に気をとられて、あれよあれよといっているうちに、長良川博士にたのんでロロー殿下をつれて水上機で逃げてもらう」「ロロー殿下のにせ者はいいが、ロロー殿下をほんとうに逃がしてしまうのかね」「そうではない。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
