        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あるいは、足休めの客の愛想に、道の対う側を花畑にしていたものかも知れない。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "（いえ、勿体ない、修行の身が馬で足休めをしませうなぞとは存じませぬ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はほんの足休めに寄ったものと見えて、梅干で茶を飲んでいた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大森の鶏",
                "note": "青空文庫"
              }
            },
            {
              "text": "あすこに砂場という蕎麦屋があるから、そこを足休めにして、小左衛門の出入りを見張っていろ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "大阪屋花鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "（いえ、もったいない、修行の身が馬で足休めをしましょうなぞとは存じませぬ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより臨時の掛茶屋であるから、葭簀がこいの粗末な店ばかりで、ほんの一時の足休めに過ぎないのであるが、若い女たちが白い手拭を姐さんかぶりにして、さざえを店先で焼いている姿は、いかにもここらの開帳にふさわしいような風情を写し出していた。",
              "citation": {
                "source": "恨みの蠑螺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ足休めに立ち寄られたまでじゃ。",
              "citation": {
                "source": "小坂部姫",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは当分開成山にいて、仕事の出来る室か家を見つけ、一番近い足休めの場所として暮すこと。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そゞろあるきの足休めして。",
              "citation": {
                "source": "カフェー",
                "author": "勝本清一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
