    "definitions": [
      {
        "index": 1,
        "gloss": "twilled silk fabric",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "綾絹を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは綾絹について学習した。",
              "source": "幻辞"
            },
            {
              "text": "綾絹の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は綾絹の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では綾絹が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "綾絹という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に綾絹という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では綾絹についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "綾絹を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると綾絹は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "綾絹について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では綾絹が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に綾絹は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により綾絹の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "綾絹は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に綾絹は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "それから繻珍の夏帶とお召の單衣と綾絹の蝙蝠傘とを強請られて購はせられたが、これは彼の消極的經濟に取ツて、預算以外の大支出で、確に一｜大打撃であツた。",
              "citation": {
                "source": "平民の娘",
                "author": "三島霜川",
                "note": "青空文庫"
              }
            },
            {
              "text": "見たまえ、帯は綾絹で、裏地も見事だ。",
              "citation": {
                "source": "蒼炎石",
                "author": "THE ADVENTURE OF THE BLUE CARBUNCLE",
                "note": "青空文庫"
              }
            },
            {
              "text": "家へ帰って調べると、嚢のなかには綾絹が百余｜反もはいっていましたので、わたくしは思わぬ金儲けをいたしました。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "宣室志（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、紫や緋や黄の綾絹をもって幾重にも仏像をつつみ、拝む者があれば先ずその一重を剥いで見せる。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "白猿伝・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "香橙色の薔薇の花、物語に傳はつた威尼知亞女、姫御前よ、妃よ、香橙色の薔薇の花、おまへの葉陰の綾絹に、虎の顎が眠てゐるやうだ、僞善の花よ、無言の花よ。",
              "citation": {
                "source": "牧羊神",
                "author": "上田敏",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は縞羅紗ではなく綾絹だった。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "喬班、むっくと起き上がり、泥だらけの防寒外套を脱ぎ棄てると、その下から見事にきらびやかな綾絹の衣装が現れる。",
              "citation": {
                "source": "戦争",
                "author": "藤野古白",
                "note": "青空文庫"
              }
            },
            {
              "text": "その九「うぐいすも、都の春にあいたけと、きは淀川へ上り舟、………」お久は絃を三下りにして地唄の「あやぎぬ」をうたっていた。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "唯見る東の房には、弓綵錦綺堆し。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "錦綵寶珠、賊等やがて意のまゝに取出だしぬ。",
              "citation": {
                "source": "唐模樣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは偶松崎慊堂文政甲申の日暦を閲して、「十五日（六月）晴、熱、都下祭山王、結綵六十余車、扮戯女舞数十百輩、満城奔波如湧」の文が目に留まつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かれは酒が大好きで、酔うと力が満ちて来ると見えて、私たちに言いつけて綵糸で自分のからだを牀に縛り付けさせます。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "白猿伝・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は女四書の内訓に出でたりとて屡ば父に聴さるる「五綵服を盛にするも、以つて身の華と為すに足らず、貞順道に率へば、乃ち以つて婦徳を進むべし」の本文に合ひて、かくてこそ始めて色に矜らず、その徳に爽かずとも謂ふべきなれ。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "厩の屋根下の床をなしてゐる汚れた板は厚い蜘蛛の巣の花綵で蔽はれ天井の隙間からは絶えず秣の種子のポロ／＼落ちたのが灰色の蜘蛛のかけた粘膜に無數に懸つてゐる。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "従つて其絵は万花鏡を覗く如く、活動写真を観た後の心象の如く、大顕微鏡下に水中の有機体を検する如く、雑多な印象が剪綵せられずに其儘並べられて居るが、印象には自ら強弱と明暗があるから、画家が故意に求めずして一幀の上に核心となる印象と縁暈となる印象とが出来て居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "侏儒の祈り　わたしはこの綵衣を纏い、この筋斗の戯を献じ、この太平を楽しんでいれば不足のない侏儒でございます。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "亭中に、綵衣の人ら。",
              "citation": {
                "source": "パステルの龍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "水のなか、明かにうつれる橋は碧玉の三日の月めき、綵衣の人ら逆様に酒のめる見ゆ、陶器の亭のもなかに。",
              "citation": {
                "source": "パステルの龍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "侏儒の祈り　わたしはこの綵衣を纏ひ、この筋斗の戯を献じ、この太平を楽しんでゐれば不足のない侏儒でございます。",
              "citation": {
                "source": "侏儒の言葉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "或はまた柱を塗り又は畫いたらしくもありて、明の蔡羽が鞦韆怨に丹楯朱干傍花砌とうたひ、同じく王問は金飾丹題綵作繩と吟じて居る。",
              "citation": {
                "source": "鞦韆考",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "果してさうであるとすれば、日本には歴史上鞦韆の二つの流れが入つたので、古るくは支那から渡り、新しきものは歐羅巴から渡り即ち希臘から發して東西に傳播したものが、茲に日本の歴史で相逢ふことになり、鞦韆の綵繩が世界を一卷きすることになるかも知れぬ。",
              "citation": {
                "source": "鞦韆考",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも鎧戸を下したまゝの、二つの大きな窓には、同じ色の帷帳の花綵飾りが弛んで、半分覆うてゐた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "絨毯は敷かれ、寢臺の掛布は花綵で飾られ、かゞやくやうに眞白な寢臺の上掛は擴げられ、化粧臺も整へられ、家具も磨かれ、花瓶には花が盛られてあつた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十人は天衣綵花を盛り、四十人は音楽を調べる。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "東西に別れて舞台に列び、仏を讃歌していうには、仏身安座一国土　　　　一切世界悉現身身相端厳無量億　　　　法界広大悉充満讃歌がおわると天人らは綵花を散らし始める。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして二人とも房々とした亜麻色の髪には、紫水晶と緑玉とを鏤めて桃金花の花綵を象った黄金の冠を戴き、裳裾長くすんなりと伸した素足には、革のサンダルを穿いていた。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "燦爛眼も射らんばかり、幾十枚かの金貨で頭に花綵を戴いた、歴史の本で見るユリウス・ケーザルのごとき人物を表に鋳出し、裏に古代アッシリヤの軍船のごとき船の形を鋳出した、見る眼｜眩い金貨であった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い金髪をふさふさと掻き上げて、そこに花綵を巻いて、微風は袖を翻し、裳裾を靡かせ、しかもゆったりと腰に纏うた飾帯の金銀宝石が陽の光に煌いて、さながら、これも名彫刻から脱け出てきたような、匂わしい気品と香気とを漂わせているのであった。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふさふさと豊かに垂れた金髪に桃金花の花綵を結んで、薔薇色の頬、蒼穹のように澄み切った眸！",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして黙ってしばらくは、岸の桃金花を折って花綵を拵えていましたが、「一度、私、貴方にお話してみようと思っていたのですけれど……」　と、独語つともなく、私に話し掛けるともなく恍惚としたように言い出すのです。",
              "citation": {
                "source": "ウニデス潮流の彼方",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
