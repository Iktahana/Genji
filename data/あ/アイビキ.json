    "uuid": "f6db7501-adc7-518f-9ed3-633c0f0af2b4",
    "entry": "逢い引き",
    "reading": {
      "primary": "あいびき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
