        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ミドリイロノ　ペンキハ　アメノ　タメニ　ハゲテ　シマヒ、ワガネハ　アカク　サビテ　ヰマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストハ　ウシロヲ　ミルト、ソコニ、ホントウニ　ブカツカウナ　ジブンノ　カゲガ　アリマシタノデ　アカク　ナリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサルサンハ　タイソウハヅカシクナッテ、アカイカホヲ　モットアカクシマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これじゃアカクテルへ入れて飲ませたって、わかっちまわア。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "結句の原文、「清明己曾」は旧訓スミアカクコソであったのを、真淵がアキラケクコソと訓んだ。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "旧訓スミアカクコソで、此は随分長く行われた。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
