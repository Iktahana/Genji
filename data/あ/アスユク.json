          "literary": [
            {
              "text": "ツゴウワルシ　アスユク――としてあった。",
              "citation": {
                "source": "勝敗",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "『コチラヘキタアスユク』　シズオカ局發である。",
              "citation": {
                "source": "樹木とその葉",
                "author": "地震日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アスユク」の電報をうけとるが早いか、彼女は寄宿舎じゅうをかけまわって、伯母さんをして眉をひそめしむるにたるあらゆる書物を借りて来て、それをずらりと炉棚や机の上に立てかけておく。",
              "citation": {
                "source": "字で書いた漫画",
                "author": "谷譲次",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも五時半の汽車迄食事を待ってゐると、電報「イシイシケフユケヌアスユク、ヒラノ」やれ／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
