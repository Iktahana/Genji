      {
        "index": 1,
        "gloss": "\"blue tide\" phenomenon of an upwelling of oxygen-depleted water",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
