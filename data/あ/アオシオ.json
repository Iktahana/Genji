        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "東京湾で青潮が発生し、沿岸に異臭が漂った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "ニュースで、青潮によって多くの魚が死んでいる映像が流れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "青潮が起きると、海の色が乳白色の青緑色に変化することがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "月の影、川風、思、画堂、青潮、水の音、初夏、中津川、ほたる、杜鵑……これはと思ふ心地よき題もなきに、我まづ聊かひるみたれど、稚なきものも交れる今宵なればと、人々心したりと見ゆ。",
              "citation": {
                "source": "閑天地",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなる護岸工事の板石の傾く上に乗れる青潮　これは新潟港の所見である。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "青潮にはその中に作者の心が溶けてゐて抒情性がそこに生れるのである。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝ミネリア国の海岸が見え、舳先には青潮がゆっくり流れていた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
