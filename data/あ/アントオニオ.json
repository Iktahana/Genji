        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "）バチスタアントオニオパリスラヴィニア（大匠の一女）カッサンドラリザ　時は千五百七十六年のこと。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "石欄より登り来る階段の上にはデジデリオ、アントオニオ、バチスタ、パリスの四人｜茵絨毯の上に寝そべりている。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "デジデリオ、アントオニオ、バチスタ及びパリス、気づかわしげに、また物聞きたげに、二人の方に進み寄り話しかける。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　だが、それを差上げるわけには行くまい。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　画をおかきになることは出来るのか。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　（小声で。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　じゃ、僕たち、暫く石段の上で横になっていよう。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　君は羨ましい人間だな。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　（半ば立上って。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　誰か能く彼の天稟に参通し得る者ぞ。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　丈高く美しい人には歌謡の舞蹈、色斑らなる仮面には炬火の光、臥し眠る心にはさゆらぎの律動を鳴らす音楽、わかき女には鏡、花には明るい温い太陽の光、即ち一つの眼――美が初めて自己を認める調和の源……それ等のものをば、自然は彼の内心の光のうちに発見したのだ。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオがかく話しているうちに、三人の少女たちは静かに戸より離れ、立ち止ってそっとその話を聴く。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            },
            {
              "text": "アントオニオ　夢みるように、夕風のうちに立つ遠い樹の茂りのおもしろさ……。",
              "citation": {
                "source": "チチアンの死",
                "author": "ホーフマンスタール　Hugo von Hofmannsthal",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
