        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "特に西洋人の中でも私は、アンドレーフ、ガルシン、メーテルリンク、ダンヌンチオ、アルチバセフ、ポー、※ルレーヌ、ソログープ、アレキセイ・トルストイ（大トルストイは私とは共鳴がない）かういふ人たちが好きである。",
              "citation": {
                "source": "散文詩・詩的散文",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　代助はアンドレーフの「七刑人」の最後の模様を、此所迄｜頭の中で繰り返して見て、竦と肩を縮めた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "……　代助はアンドレーフの「七刑人」の最後の模様を、此所まで頭の中で繰り返してみて、ぞっと肩を縮めた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際ゴルキーでも、アンドレーフでも、イブセンでもショウでもない。",
              "citation": {
                "source": "思い出す事など",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便局長はイワン・アンドレーエヴィッチという名前だったが、みんなはいつも、『＊２シュプレヘン・ジイ・ドイッチェのイワン・アンドレーイッチ！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "）という文句を、語呂合せのように、イワン・アンドレーヴィッチという名前にくっつけて呼んだのである。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊３　ジュコフスキイ　ワシーリイ・アンドレーヴィッチ（1783-1852）有名なロシアの浪漫派の詩人。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "『そりゃ君はいいさ、シュプレヘン・ジイ・ドイッチェのイワン・アンドレーイッチ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いや、ちょっと待ち給え、イワン・アンドレーエヴィッチ。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊４　クルイロフ　イワン・アンドレーヴィッチ（1768-1844）有名な寓話作家。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンドレーフの『七刑人』　アンドレヱフの『七刑人』を読んで見た。",
              "citation": {
                "source": "文壇一夕話",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の思想界を賑わしたトルストイもニーチェもワイニンゲルもストリンドベルグもハウプトマンもアンドレーフもアナトール・フランスも皆跡もなく猛火の餌食となって了った。",
              "citation": {
                "source": "灰燼十万巻（丸善炎上の記）",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "またアンドレーエフの『七死刑囚』を読んだ。",
              "citation": {
                "source": "続獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すべてのものを失うことによって人は象徴を信ずるようになる」とアンドレーエフは言った。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はあのアンドレーエフの『霧』のなかの青年のことを思い出す。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンドレーフの小説に深夜の病院を書いたのがあった。",
              "citation": {
                "source": "一九二九年一月――二月",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時、帝政ロシアの文壇にはトルストイ、ツルゲネフ、アンドレーエフ、チェホフなどという世界の文学の花形が居ました。",
              "citation": {
                "source": "マクシム・ゴーリキイについて",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピエールもアンドレー公も、ナタアシャも皆愛すべき人である。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "きのう、アンドレーフの「心」、上田敏氏訳を野上さんから借りて来る。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月十七日　日　晴　アンドレーフの Anathema、昔よんだ日本語訳を出して英訳と比較して見たら、なって居ないこと夥しい。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンドレーフのあれを書くときの象徴的な気分を訳者が感得しなかったのが失敗の最大原因だ。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度は互に仕事をしようと、彼女はアンドレーエフの「飢餓王」の翻訳を、自分は書く約束。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "二月二十六日　水　今日　マルタ・アンドレーヴナ　川谷さんの細君二月二十七日　木　川谷さんによばれて、出かけて鯛をたべた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　アンドレーエフの「イスカリオテのユダ」。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "訳のわるい故か、アンドレーエフの作として、あの独特の簡明さ、クリアー・カットを感じられず。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、アンドレーエフをやる。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九一八年の党員で、フルンゼと一緒に赤色戦線で働き、クバン駐在赤軍政治部長をやった若いドミトリ・アンドレーウィッチ・フールマノフは、ボルシェビキ作家の誇、「チャパーエフ」（日本訳、赤色親衛隊）、「反乱」などをわれわれに与えた。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "祖父トルストイの妻はソフィヤ・アンドレーエウナと云って、宮廷医ベルスの娘であったのだから。",
              "citation": {
                "source": "ジャンの物語",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
