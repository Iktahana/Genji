        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「リビングのカーテンをアイボリーに変えたら、部屋全体が明るく柔らかな雰囲気になった。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「結婚式で着るドレスは、純白よりも肌馴染みの良いアイボリーを選おうと思っている。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「アンティークのピアノの鍵盤は、長い年月を経て深い味わいのあるアイボリーに変色していた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "この主婦の亡夫は南洋通いの帆船の船員であったそうで、アイボリー・ナッツと称する珍しい南洋産の木の実が天照皇大神の掛物のかかった床の間の置物に飾ってあった。",
              "citation": {
                "source": "海水浴",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九七七年四月十六日、入り口正面の最高の場所にブース★を確保したアップルは、アイボリーのプラスチックケースに収まったアップル※をデビューさせた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは女持ちの小型なアイボリー紙で上等のインキで小さく田中春と印刷してある。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京からボンボンとアイボリーと、雑誌二つ来る。",
              "citation": {
                "source": "日記",
                "author": "一九一七年（大正六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
