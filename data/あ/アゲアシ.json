  {
    "uuid": "2142c73e-ba1c-5382-883c-3c2b9959d9a8",
    "entry": "上げ足",
    "reading": {
      "primary": "あげあし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
