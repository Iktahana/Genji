        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "揚げ足の例文",
              "source": "幻辞"
            },
            {
              "text": "師匠は揚げ足で座り、弟子たちに稽古の心得を静かに語り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "揚げ足で長時間座っていたせいか、足がしびれてうまく立てなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
