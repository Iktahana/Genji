  {
    "uuid": "3a55242a-1b73-50d4-875a-027a26e0f261",
    "entry": "アリャ",
    "reading": {
      "primary": "ありゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」「違えねえ、確にアリャ、」　と、め組は路地口へ伸上る。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……姉さんは科よく消えたが、こっちは自雷也の妖術にアリャアリャだね。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アリャ」　小獅子は路へ橋に反った、のけ様の頤ふっくりと、二かわ目に紅を潮して、口許の可愛らしい、色の白い児であった。",
              "citation": {
                "source": "春昼後刻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "我の帰ッたのを知ッていながら、何奴も此奴も本田一人の相手に成ッてチヤホヤしていて、飯を喰ッて来たかと云う者も無い……アまた笑ッた、アリャお勢だ……弥々心変りがしたならしたと云うが宜、切れてやらんとは云わん。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　　　瓜や茄子の花ざかり　　　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "※――高い山から谷底見れば　　　　　瓜や茄子の花ざかり　　アリャ、メデタイナ、メデタイナ　そんな変哲もない事がなぜにまためでたいと言うのか、突如向うの二階から、ドンチャカ、ジャカジャカという鳴り物に合わして、奇声をあげながら唄い出した遊客の声がありました。",
              "citation": {
                "source": "旗本退屈男",
                "author": "第一話　旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "引くに引かれぬ鞘当てから、日本全国を潜行する無量無辺の不正ダイナマイトを正面に廻わして、アアリャジャンジャンと斬結ぶ事になった。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そいつを私が糶台に並べて、『うわアリャリャリャ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二階の男はアリャ何だい」　細君も仰天した。",
              "citation": {
                "source": "呑仙士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリャアリャアリャアリャ大鳥大鳥！",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早え野郎だ」「いま時分また、なんの粗相で……」「ワッショイワッショイ、火事と喧嘩ア江戸の花でえ」「アリャアリャアリャ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ご返辞なさらないと、ペンチで高圧電源線を切断ってしまいますよ、アリャ、リャ、リャ、リャ……」「これ、乱暴なことをするのは、何処の何奴じゃ」「博士ね、ここに紹介状を持って参りましたワ」「おお、なんと貴女は、美女であることよ！",
              "citation": {
                "source": "遊星植民説",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その証拠には、雄鶏はときどき間の抜けた様子をして、のどもさけよと叫び立てるのでした、――『結構ドコロジャアリャシナーイ※』　おや、いつの間にか私たちは、あの一ばん暑さのきびしい草場を離れて遠くへ来てしまいましたが、実はその草場には、昼寝もせずにいるお歴々が、車座になってすわっていたのでした。",
              "citation": {
                "source": "夢がたり",
                "author": "TO, CHEVO NE BYLO",
                "note": "青空文庫"
              }
            },
            {
