        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "幾程もなく到り着きて、アンジエリカが家をたづね得つ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジエリカは我を佳き兒なりと讚めき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "此時アンジエリカ籬の後より出でゝいふやう。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジエリカはゆく／＼怪しき老女が上を物語りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジエリカが家に歸り着きて、我心は纔におちゐたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "されど我がアンジエリカが家の廣き臥床に上りしときは、母上我枕の低きを厭ひて、肱さし伸べて枕せさせ、頼ある子ぞ、と胸に抱き寄せて眠り給ひき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔幼かりし時、母とマリウチアとに伴はれて、ネミの湖に往きしかへるさ、アンジエリカが我に物語りし事こそあれ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は或る冬の日、酷しい寒さに苦しめられながら、その愛弟レオとペルーヂヤからサンタ・マリヤ・デリ・アンジエリの方へ行つた。",
              "citation": {
                "source": "三太郎の日記　第二",
                "author": "阿部次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
