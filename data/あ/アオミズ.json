        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オヤと思つて、窓外を眺めると、今宵は陰暦の十三｜夜、月明かなる青水白沙の海岸には、大佐の部下の水兵等は、晝間の疲勞を此月に慰めんとてや、此處に一羣。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水沫とよたぎち、うろくづの堰かれたぎち、たまきはる命の渦の渦巻の湯津石村をとどろき揺る水上は思ふべきかな。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ほうたるよ）言問ひぬ、遠つ神代は青水沫、石根、木の立。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はろばろや大海原、涯なしや青水沫、揺りとよめ大き国民、大君に、この神に、讃へ言、寿詞申せや。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水泥ひどらが沼、蟠るぬめり蟒、憚らず曠野巨牛、畏る無し禍つ狼。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "はろばろや大海原、涯なしや青水沫、搖りとよめ大き國民、大君に、この神に、讚へ言、壽詞申せや。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水泥ひどらが沼、蟠るぬめり蟒、憚らず曠野巨牛、畏るなし禍つ狼。",
              "citation": {
                "source": "新頌",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときどき渠の姿を見て逃出す小魚どもの腹が白く光っては青水藻の影に消える。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水無月の朝野にも歎きはありや、わが如く。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "無花果葉こそこぼるれ、夏なかの青水無月のかげに見しその日の夢はまづ覺めて、今日はた汝、――ああ無花果。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水無月の小林に、漆樹は、さこそ木膚の目より美脂をしとど滴つれ。",
              "citation": {
                "source": "泣菫詩抄",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水無月の朝野にも、嘆きはありや、わが如く。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "青水無月の小林に、漆樹は、さこそ木膚の目より美脂をしぬに滴つれ。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八『花を待ちみる事榮に、さこそは齋へ、ともすれば青水無月の小野の香に、むかしの夢のうらびれて、古巣を見てはさしぐむ。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとえば「青水無月と言ふ語は、われ／＼は辞書にすら見出す事は出来ないが、薄田氏だから拠り所があるに違ひない。",
              "citation": {
                "source": "詩語としての日本語",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば「青水無月と言ふ語は、われ／＼は辞書にしか見出す事は出来ないが、薄田氏だから拠り所があるに違ひない。",
              "citation": {
                "source": "詩語としての日本語",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜半はいまその高潮にたっしたのであろう、相変らず青水晶のような透明な月が魔窟のてっぺんにのぼって、きた時くらかった路地々々やはげおちた屋根々々をひるまのようにさえざえとてらしている。",
              "citation": {
                "source": "放浪作家の冒険",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "連日の雨で不忍の池の水量がよほど増しているのだろう、腐れかかった溝板を踏むたび、ザブザブ青水泥が溢れてきて、溝板の割れ目から豆粒ほどの青蛙がピョコピョコ飛び出してきた。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人魚達は、真珠で編んだ綱を曳いて、青水晶のような水の中を静かに泳ぎ廻りました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "いざ君かなでよ箜篌、――青水沼も高草村も、げにこれ新大路や、――頑鑛もまた藝術、慈相のかげ、豪華や禮讃や、はた、戀や、歌や、――そは皆君が手にこそ、桐若樹のむらさき夏に潤ふ律調の園。",
              "citation": {
                "source": "獨絃哀歌",
                "author": "蒲原有明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
