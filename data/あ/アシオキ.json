        "examples": {
          "standard": [
            {
              "text": "長時間のフライトでも疲れないように、デスクの下に足置きを設置した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "美容室のシャンプー台にある足置きが、私の身長には少し合わなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ソファで映画を見るときは、必ずお気に入りの足置きを使ってリラックスしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "台所へ通ずる廊下の隅に、女の靴が一足置きざりになっていた。",
              "citation": {
                "source": "土から手が",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あの足置き台をわたしにお貸しなさい。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "スペードの女王",
                "note": "青空文庫"
              }
            }
          ]
        }
