[
  {
    "uuid": "fb059291-91a9-5907-bf1c-979c87ee6478",
    "entry": "編み出す",
    "reading": {
      "primary": "あみだす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
