        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "本堂のような所にはアラバスターの仏像や、大きな花崗石を彫って黄金を塗りつけた涅槃像がある。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "マサニ鬼雄トナツテ、異日兵ヲ以テ吾ガ国ニ臨ムモノアラバ、神風トナツテ之ヲ禦グベシト。",
              "citation": {
                "source": "斗南先生",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "空想のでも、天女や戀人なら、まだしも――架空のでも、おほ鴉やアラバマから來たと云ふ鳥ならまだしも――義雄は身づから部落民だと思ふものを介抱してゐるのである。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "毒藥を飮む女",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ貴族ノ土地徴集ヲ決行スルニ、大西郷ガ異議ヲ唱フル諸藩アラバ一擧討伐スベキ準備ヲナシタル先哲ノ深慮ニ學ブベシトスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ原則ト云フ者アラバ、只國家ノ保護ニヨリテノミ各人ノ土地所有權ヲ享受セシムルガ故ニ、最高ノ所有者タル國家ガ國有トモ民有トモ決定シ得ベシト云フコト是レノミ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ將來ノ大領土ニ於ケル諸多ノ鐵道ヲ再ビ南滿鐵道ニ學バシムルコトアラバ國民ニ鬪志ナキコト明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "學校トシテハ簡單ナル事務ニシテ、若シ兒童ノ家庭ノ惡感化ニヨリテ食事ヲ肯ンゼザル者アラバ教師ノ權威ヲ以テ其ノ保護者ヲ召喚訓責スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ヲシテ日本ノ愛蘭土タラシムル如キコトアラバ、將來大羅馬帝國ヲ築カントスル日本ハ全然其ノ能力ナキコトヲ第一歩ニ於テ立證スルモノナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來ノ帝國領土中、先住國民ノ大富豪大地主アリテ多大ノ土地ヲ獨占シ又ハ生産業ヲ專有スル時是ヲ是認スル如キアラバ、日本國家ハ只彼等ノ不義ナル財産ノ保護ヲ負擔セシメラレ、日本國民ハ只其ノ小作人タリ勞働者タルニ過ギザル可シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來「クエーカー」宗ノ如キ又淺薄ナル非戰主義ノ如キヲ輸入シテ徴兵忌避ヲ企ツル者アラバ、刑罰ハ斷々トシテ其ノ最モ重キ者ヲ課シテ可ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ強ヒテ此ノ日本改造法案大綱ヲ名ケテ日本民族ノ社會革命論ナリト云フ者アラバ甚ダシキ不可ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然シナガラ若シ此ノ日本改造法案大綱ニ示サレタル原理ガ國家ノ權利ヲ神聖化スルヲ見テ「マルクス」ノ階級鬪爭説ヲ奉シテ對抗シ、或ハ個人ノ財産權ヲ正義化スルヲ見テ「クロポトキン」ノ相互扶助説ヲ戴キテ非議セント試ムル者アラバ、其ハ疑問ナク「マルクス」ト「クロポトキン」ノ智見到ラザルノミト考フベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「信長記」に、信長卿ハ清水寺ニ｜在々ケルガ、於二洛中洛外一上下ミダリガハシキ輩アラバ一銭切リト御定有ツテ、則柴田修理亮、坂井右近将監、森三左衛門尉、蜂屋兵庫頭、彼等四人被仰付ケレバ、則制札ヲゾ出シケル云々。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "「信長記」に、信長卿ハ清水寺ニ在々ケルガ、於洛中洛外上下ミダリガハシキ輩アラバ一銭切リト御定有ツテ、則柴田修理亮、坂井右近将監、森三左衛門尉、蜂屋兵庫頭、彼等四人被仰付ケレバ、則制札ヲゾ出シケル云々。",
              "citation": {
                "source": "法窓夜話",
                "author": "穂積陳重",
                "note": "青空文庫"
              }
            },
            {
              "text": "意見アラバ来ル×月×日迄ニ意見書ヲ提出スベシ』　と、あっさり殺し文句があって『左記』のところには、『本願ノ要旨ハ、義手ヲ人体ニ添架スルニ在ルモノト認ム。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　眠っているうちに、アラバマは通り抜けてしまったのだろうか。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラバステル石の時計がある。",
              "citation": {
                "source": "田舎",
                "author": "マルセル・プレヴォー　Marcel Prevost",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸福を盛ったアラバスタアの盃のように輝かしく、角かくしをした美しい花嫁を側に坐らせて。",
              "citation": {
                "source": "橋",
                "author": "池谷信三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "老イタル父母アラバ、責任ハ更ニ重ク、病弱ナ妻、発育不良ノ子女ヲ有スルコトハ、男子一生ノ損失デアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理のテストに、メードさんは八分も厚さのあるビフテキを焼いて、でかっぱちもないアラバマ・サンドイッチをつくった。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "とりわけていわゆる「アラバマ号」問題は、しばしば英米国交の危機をもたらした。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラバマ号事件」というのは、こうである。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラバマ号はその一隻で、「二九〇号」とよばれていた。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八六二年六月、英国のバークンヘッドのレイヤード造船所で建造中のアラバマ号は完成にちかづいており、それが軍艦であることも明白になったので、米国公使アダムスは英外相ラッセル伯にたいして、アラバマ号の用途を公文書をもって指摘し、建艦の中止を要求した。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "英国製軍艦によって沈められた北部の船舶は、拿捕を含めて二〇〇隻をこえるが、アラバマ号は一八六四年六月十九日に沈められるまでの二二カ月間に六〇隻を犠牲にして、最大の損害を与えた。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "南北戦争の結果の一つであるアメリカ商船業の絶望的な後退は、大半アラバマ号の大あばれのせいとされた。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "内乱終了後アメリカは、アラバマ、フロリダ、シュナンドーなど諸艦を建造した英国の中立侵犯に関して、その他の抗議に合せて損害賠償を要求した。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "この交渉はその後数年にわたって米英両国政府のあいだでつづけられたあげく、一八六九年一月十四日、ジョンソン＝クラレンドン条約の調印を見るにいたったが、この条約がかんじんのアラバマ号問題をまったく無視していることが判明するや、がぜん米国の輿論は沸騰し、四月十四日上院で圧倒的多数をもって否決された。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            },
            {
              "text": "一八六九年一月―四月、太陰暦では明治元年十一月―明治二年二月はまさにこのような、「アラバマ号問題」をめぐる米英危機の第一波の時期にぞくしていた。",
              "citation": {
                "source": "黒田清隆の方針",
                "author": "服部之総",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
