        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "吹き抜けの天井に設けた明かり取りから、正午の太陽光が差し込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "暗くなりがちな階段の踊り場に、小さな明かり取りの窓を作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「この明かり取りがあるおかげで、キッチンがとても明るくて助かるわ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "明かり取りのあるところを降りて来ると、見張り番交代に昇って来るミルン氏に逢った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ腰を掛けて茶を飲んでいると、天井の明かり取りのガラス板の上をおおぜいの人が靴を踏み鳴らしながら通る。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "梯子段に近い明かり取り窓の下に、黒天鵞絨の洋服を着た盲目の少女が夕陽の中の鉄棒の影のように立っている。",
              "citation": {
                "source": "宝石の序曲",
                "author": "松本泰",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところどころに明かり取りがあって雪明りが仄かな光を落としている長い長い廊下をいく曲がりかしていちばん奥までやってきたとき、「どうぞこちらへ」　座って女中が襖を開けた。",
              "citation": {
                "source": "寄席",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸いにもあの醜い正面の明かり取りは中門の陰になって見えなかった。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "背が延び、より冒険を好む歳になると、若いウォードは時折、傾いだ家々や破れた明かり取り窓やぐらつく階段や捻れた手すりや浅黒い顔や言葉もないような悪臭がごった返したこの地区を巡りつつ、サウス・メインからサウス・ウォーターに向かって、湾を行く汽船が今なお立ち寄る船だまりを探した。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "南側で境界を接している二階建ての隣家のこちら側の壁には、階段のスペースの上方に設けた小さな明かり取りの窓があるだけだった。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてわずかな抵当品でもないものかと眼を皿にして梯子段を登つたり降つたりしたが、もとより目星しいものと云つては何一つ在りよう筈もなく、僕の部屋から捕虫網を持ち出すと、何に使ふものかと考へる風で宙に振つてゐたが（その様子は僕が時々あかりとりに飛び込んで来る蛾を追ふ態と同じやうであつた。",
              "citation": {
                "source": "沼辺より",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "北向きの、その小さな窓が一つと、ピラミツド型に歪んだ天井裏に二尺四方のあかりとりが開いたが、そんな小さな窓から空を仰ぐと、わけても憐れに満ちた放浪の煙りがもやもやとして、細々と空へ立ち昇つてゆく思ひが切なく、私は細引を曳いて窓板を閉ぢると戸立蜘蛛の有様で穴の底に瞑目するだけだつた。",
              "citation": {
                "source": "剥製",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのころはまだ電灯照明を使うことがむずかしかったので、建物の天井にあかりとりの窓をあけなければなりません。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあかりとりのガラス窓を隠すために、見物席のすぐ上に、笠のような小屋根を作ったものです。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガラス張りのあかりとりなどは、少しも必要がないのです。",
              "citation": {
                "source": "影男",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "下のほうには、小さなあかりとりのほか、窓は一つもありません。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかりとりの小窓ばかりで、外をながめるような窓はありません。",
              "citation": {
                "source": "妖星人Ｒ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋根をささえている材木が、そのまま、むきだしになっていて、いっぽうには、あかりとりの小さな窓がついています。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁はしみに汚れ、明り取りの窓｜硝子はところどころ破れ落ちかかって煤けている。",
              "citation": {
                "source": "障子の落書",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その家は奥深い塗屋造りで、広い座敷の方は始終薄暗いような間取りであったが、天井に厚硝子の嵌った明り取りのある茶の間や、台所、湯殿の方は雨の降る日も明るかった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "明り取りが無くて薄暗いので、隅の方は良く判らないが、此方から見る正面には、一人の老婆が傲然と――誠に女王の如く傲然と踞坐して煙草を吸つてゐる。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "明り取りが無くて薄暗いので、隅の方は良く判らないが、此方から見る正面には、一人の老婆が傲然と――誠に女王の如く傲然と踞坐して煙草を吸っている。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井を見ると左右は低く中央が高く馬の鬣のごとき形ちをしてその一番高い背筋を通して硝子張りの明り取りが着いている。",
              "citation": {
                "source": "カーライル博物館",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "風抜きか明り取りかと思われる。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには硝子窓の明り取りが開いていて、背の高い検事には、そこから、静止している二人の女の裸足が見える。",
              "citation": {
                "source": "聖アレキセイ寺院の惨劇",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井が、頭につかえるほど低い部屋の中は、小さい明り取りの窓があるだけで、昼でも薄暗いのですが、その薄暗い片隅には、心中前に男女が飲食したらしい丼とか、徳利などが、ごたごた片寄せられているのです。",
              "citation": {
                "source": "島原心中",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "床の間一杯に、おびただしい和書洋書が積み重ねられ、明り取りの円窓の近くに、相当古いがドッシリとした机が置かれ、その前の皮ばりの椅子に、圭子は腰かけていた。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこは階段の向うに在る明り取りの窓から外の光りが明るく指し込んでいたが、それでも自分の懐中電燈の方が強く輝いていた。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "槽に蔭干しされた種子類が格子の傍に並べてあって、水壺の明り取りから柿の生ま生ましい青色が、べっとりした絵具色で鮮明に滲み出ている。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "明り取りの障子窓は月夜よりも暗かった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分、あの板を剥がして裏天井の明り取りからずらかったに違えねえ。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "のの字の刀痕",
                "note": "青空文庫"
              }
            },
            {
              "text": "十×年八月八日　晴れ　小便に起きたついでに、明り取りの窓から暁の空を透かしてみると、憎らしいほど霽れ渡った悪天候である。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どの博物館も新式の建築術を用ひて間取や明り取りの設備には敬服させられるが、陳列品に自国の美術としては殆ど何物をも有つて居ないのは気の毒な程である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
