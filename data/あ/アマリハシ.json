        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それ占めたといふのであつたらう、忽ちに手対ふ者を討殺し、七八｜艘の船に積載した財貨三千余端を掠奪し、かよわい妻子を無漸にも斬殺してしまつたのが、同月十九日の事であつた。",
              "citation": {
                "source": "平将門",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "王成は老婆の言葉に従って、老婆から金をもらい、その金で五十余端の葛布を買って帰って来た。",
              "citation": {
                "source": "王成",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "前頭に留めた髮は、今日の南支那の婦人の前髮の如く、その儘に垂下し、兩側頭に留めた髮は、之を辮み綰げて、幾分わが古代の耳鬘の如くして、その餘端を垂下したのである。",
              "citation": {
                "source": "支那人辮髮の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
