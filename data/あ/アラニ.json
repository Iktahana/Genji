[
  {
    "uuid": "bab5bae3-d51b-5994-bedf-8517a7b77df4",
    "entry": "粗煮",
    "reading": {
      "primary": "あらに",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "dish consisting of bony fish parts boiled in soy sauce",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "粗煮を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは粗煮について学習した。",
              "source": "幻辞"
            },
            {
              "text": "粗煮の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は粗煮の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では粗煮が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "粗煮という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に粗煮という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では粗煮についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "粗煮を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると粗煮は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "粗煮について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では粗煮が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に粗煮は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により粗煮の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "粗煮は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に粗煮は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "59人情知る老人よ、早く行って、土ふるいの小童の手を戒めてやれ、パルヴィーズ＊の目やケイコバード＊の頭をなぜああ手あらにふるうのかえ！",
              "citation": {
                "source": "ルバイヤート",
                "author": "RUBA'IYAT",
                "note": "青空文庫"
              }
            },
            {
              "text": "（友吉と義一の姿をアゴで指して）あんまり手あらに扱っちゃあ。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あたしゃただの躯じゃないんだからね」とみさおは主張する、「あたしのおかずはべつにするよ」　たとえこまぎれ肉にしろ鮪のあらにしろ、みさおだけは一と皿べつにおかずをつける。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから相変わらずさしみだの蛤鍋だの鰻だの（鰻の匂ってくる午下りの女郎屋の景色も巧かった）品川らしい食べ物ばかり並べられ、結構でしたがこの前の時言ったあら煮が抜けた。",
              "citation": {
                "source": "随筆　寄席囃子",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいのあら煮が美味いというのも、実は皮も骨もいっしょに煮られているからなのである。",
              "citation": {
                "source": "いなせな縞の初鰹",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "焼いて食う場合は、俗に言うたいの頭の山椒焼きと言うのであって、山椒の粉末の入った醤油で付け焼きにすることを言うのだが、煮付けて食う場合は、俗に言うあら煮という調理になる。",
              "citation": {
                "source": "西園寺公の食道楽",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐助は鯛のあら煮の身をむしること蟹蝦等の殻を剥ぐことが上手になり鮎などは姿を崩さずに尾の所から骨を綺麗に抜き取った〕頭髪もまた非常に多量で真綿のごとく柔くふわふわしていた手は華車で掌がよく撓い絃を扱うせいか指先に力があり平手で頬を撲たれると相当に痛かった。",
              "citation": {
                "source": "春琴抄",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "魚銀でもそのとおりだったが、捨てるつもりでどけておいた魚の尾頭や臓物などの、臭くて汚ないような物の中から、あら煮として売れるような部分をよりわけて、皿に盛ってみせたそうで、主人の銀太はおどろいたということである。",
              "citation": {
                "source": "あだこ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し気の利いた割烹店へ飛び込むと、女中が煙草盆と一緒に「板」を持ってくる、赤い塗板などへその日その日の魚の名ばかり列べてある、客は一見「今日はしけだな、仕方がねえ、コチを洗いに、鯛はお定まりのうしおとあら煮だよ」などと、あつらえる、ちょっと面倒だ。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜作や鶴の家などでも、あら煮とか鯛のかぶと煮などというものはよく売れるらしいが、鰹の中落ちを箸でセセリ食うおもしろさと味にはしょせんかなうまい。",
              "citation": {
                "source": "舌のすさび",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アラ煮もこしらえた。",
              "citation": {
                "source": "葵原夫人の鯛釣",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
