          "literary": [
            {
              "text": "しかしヘンデルはその間にも名作「アルキーナ」を作り、僅々十日間で「アレキサンドルの祭」を書いた。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の管弦楽で、メンゲルベルクの指揮した「アルキーナ組曲」（ビクターＪＥ一八七―八）は名盤の一つだ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘンデルの『アルキーナ組曲』（一四三五―六）も、メンゲルベルクの傑作の一つに数えられる。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
