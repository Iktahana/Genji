[
  {
    "uuid": "47102681-edac-5313-8d2d-f06f2cdf48bf",
    "entry": "浴びる",
    "reading": {
      "primary": "あびる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
