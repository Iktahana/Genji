[
  {
    "uuid": "76df5552-ffd3-527c-a413-ef1621373c2c",
    "entry": "足止め",
    "reading": {
      "primary": "あしどめ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
