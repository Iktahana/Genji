        "examples": {
          "standard": [
            {
              "text": "朝曇りの例文",
              "source": "幻辞"
            },
            {
              "text": "朝曇りだったが昼には晴れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "朝曇りの中で散歩に出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "空は朝曇りがしていて寒かった。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の二",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日は、うちきらし朝曇りせしみゆきにはさやかに空の光やは見し何が何でございますやら私などには。",
              "citation": {
                "source": "源氏物語",
                "author": "行幸",
                "note": "青空文庫"
              }
            },
            {
              "text": "花少し散つて晴れけり朝曇り　　多代女初花や一木の中の晴れ曇り　　同花に月どこからもれて膝の上　　同さ筵に這ひ習ふ子や花のかげ　　同　多代女の之等の句は近代写生の中へ交ぜても、さして遜色ないと思う。",
              "citation": {
                "source": "桜花を詠める句",
                "author": "杉田久女",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝曇り後晴れて、海のやうに深碧に凪いだ空に、晝過ぎて、白い雲が頻りにちぎれ／＼に飛んだ。",
              "citation": {
                "source": "死者の書",
                "author": "釋迢空",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝曇り後晴れて、海のやうに深碧に凪いだ空に、昼過ぎて白い雲が頻りにちぎれ／＼に飛んだ。",
              "citation": {
                "source": "死者の書",
                "author": "――初稿版――",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝曇り後晴れて、海のやうに深碧に凪いだ空に、昼過ぎて、白い雲が頻りにちぎれ／＼に飛んだ。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝曇り後晴れて、海のように深碧に凪いだ空に、昼過ぎて、白い雲が頻りにちぎれちぎれに飛んだ。",
              "citation": {
                "source": "死者の書",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "この模樣だと放送も旨く行くぜ、案ずるよりも生むが易いといふぞ、僕は縁起のよい氣持で、朝曇りのした春寒い七條の停車場に降りた。",
              "citation": {
                "source": "京洛日記",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵営のそらひとり／＼　わが隊の兵の病状を　言はせつゝ来て、すべもなかりき寒々と　五月水田にかたよりて、あをみどろ浮き　雨到るなり朝曇り　水田のをちに群りて黄なるは、なべて　野菖蒲のはな寂かなる村の朝けか。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            },
            {
              "text": "・梅と椿とさうして水が流れてゐる・庚申塚や左は街へ下る石ころ・あさぐもりの垣根の花をぬすまうとする　太陽、生きものが生きものを殺す・寝覚しめやかな声はあたゝかい雨・ハムは春らしい香をかみしめる（樹明君に）　二月十七日サイレンが鳴る、お寺の鐘が鳴る、そしてしめやかな雨の音。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝ぐもりの草のなかからてふてふひらひら・ここまではうてきた蔦の花で　四月廿六日ふと水音に眼がさめた、もう明けるらしいので起きる。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "・ころ／＼ころげてまあるい虫・つながれて吠えるばかりの仔犬の暑さ・朝からはだかで蝉よとんぼよ・夕立つや蝉のなきしきる　夕立つや逃げまどふ蝶が草のなか　七月十八日朝ぐもり、蝉しぐれ、身心なごやかなり。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝ぐもり、日中はさぞ暑からう。",
              "citation": {
                "source": "行乞記",
                "author": "大田",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月二日朝ぐもり、今日も暑いことだらう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "岔水居　したしく逢うてビール泡立つ　　　或る旧友と会して・寝顔なつかしいをさな顔がある　朝ぐもり海へ出てゆく暑い雲　八月二日朝酒はありがたい、もつたいない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "うしろの松にしろ、朝寒や、松をよろへる、蔦うるし這はせて寒し庭の松、仕舞ひには、飛行機も東下りや朝ぐもりなんて、僕のところの唐紙のきれつぱしに書いてゐたではないか。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "工場地帶のサイレンと煤煙の朝ぐもりに「ああ、東京へ越したんだな」と、あらためて思つたりする。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
