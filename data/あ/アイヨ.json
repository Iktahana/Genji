        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "男と死ぬ約束をして奉公先からそれとなく暇乞いに来た娘が帰るさに、「身体を大切にしておくれ」　と云われて、「アイヨ」　と笑った眼つき口もと。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アイヨ……来ていることは間違いないよ……だけんど……それを引渡せばどうなるんだえ」「半殺しにして仕舞うのだ。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お前さんも知っているだろう」「アイヨ……知っているよ。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "勝手口の方から、アイヨ、ダレ？",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その八　時計館の秘密",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホックはめてよ」「アイヨ。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上、ポルト・サン・ジャックの本屋の主人でロアイヨルという老人のほか、生きた者のうちには友人も知己もなかった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "本屋のロアイヨルは死んでいた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "サン・ジャック市門のロアイヨルの後継者の家に行き、百フラン持って帰ってきた。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
