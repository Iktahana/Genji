[
  {
    "uuid": "8934b74a-3610-5452-8b02-23cbf426a5eb",
    "entry": "飽きっぽい",
    "reading": {
      "primary": "あきっぽい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
