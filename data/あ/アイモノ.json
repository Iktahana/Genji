    },
    "definitions": [
      {
        "index": 1,
        "gloss": "fresh or dried fish preserved in salt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅の土産に、港町で買った相物を実家へ送った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "ご飯のお供には、塩気の効いた相物がよく合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "昔ながらの製法で作られたその店の相物は、地元で評判の一品だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "さっと立ち上がると形相物凄く呼びとめました。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々の記憶を問ひ知れるだけは知らうとせられたのであるが、如何にせむ、曙覧と親しく相物語つた人が、殆なくなりかけた時分から、此方々の為事が初つたのであつた。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し是を偽と申し候はゞ、三右衛門を始め入満寿庵トナト白状いたさせ申すべく候」とあつて、天川の伝説は間違ひでしたと言はない限り車裂きにも致しかねない思ひつめ方、眥を決し双肌ぬいで詰め寄る形相物凄い。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、親猿は、悲しげに鳴きさけびながら、怒の形相物凄く、半四郎を、きっ、と睨みつけていた、というではございませぬか。",
              "citation": {
                "source": "京鹿子娘道成寺",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて鼓判官は寄手に向って形相物凄く大音声をあげた。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第八巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「日高くば能登の国まで越えうずると思えるに、僅かの笈一つ背負うて、後にさがればこそ人も怪むれ」　と、怒りの形相物凄く、金剛杖をおっ取って、散々に打擲する。",
              "citation": {
                "source": "ながうた勧進帳",
                "author": "酒井嘉七",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前の八疊に床を敷いて寢てゐた主人の重三郎は、頸のあたりを一と突きにやられ、床から拔け出し加減に血潮の中に縡切れ、境の唐紙を開けた次の長四疊には、薄暗い中に据ゑられた不動明王の木像が、嚇怒の面相物凄く、ヂツとそれを見下ろしてゐるのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "佛敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "アヒモノ　又アヒノモノ、古い文書には合物と書いた例が多く、或は相物とも書いて居るが、意味は採取期と採取期との中間の食物、即ち主として乾して貯へてある魚類海産物、鰹節乾海老の類をさう呼んだのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイモノ　またアイノモノ、古い文書には合物と書いた例が多く、あるいは相物とも書いているが、意味は採取期と採取期との中間の食物、すなわち主として乾して貯えてある魚類海産物、鰹節・乾海老の類をそう呼んだのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "手前の八畳に床を敷いて寝ていた主人の重三郎は、頸のあたりを一と突きにやられ、床から抜け出し加減に血潮の中に縡切れ、境の唐紙を開けた次の長四畳には、薄暗い中に据えられた不動明王の木像が、赫怒の面相物凄く、ジッとそれを見下ろしているのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "仏敵",
                "note": "青空文庫"
              }
            },
            {
              "text": "あいつが殺したんだ」　出し抜かれた明智小五郎は、憤怒の形相物凄く、エンジンの所へ飛んで行って、運転を始めた。",
              "citation": {
                "source": "黄金仮面",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンクリート壁の地下道を、逃げるものはあとずさり、追うものは正面を切って、憤怒の形相物凄く、毛むくじゃらの腕をボクサーのように構えながら、ノソノソとせまって行く。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "又してもお化人形かと見れば、そうではなくて、殆ど全裸体の若い娘が、頑丈な十字架に、手を拡げ、股を拡げて括りつけられ、両の乳房のあたりに、二つの黒い穴があいて、そこから流れ落ちた血潮が、下半身をあけに染め、苦悶の形相物凄く、歯を喰いしばって息絶えている。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベッドの病人を見ると、やっぱり瀕死の形相物凄く、今にも絶え入り相にうめいている。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は縋る娘を振り離して、スックと立上ると、憤怒の形相物凄く、いきなり次の間の品子さん目がけて飛びかかろうとした。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "上野の汽車最後の停車場に達すれば、碓氷峠の馬車に搖られ、再び汽車にて直江津に達し、海路一文字に伏木に至れば、腕車十｜錢富山に赴き、四十物町を通り拔けて、町盡の杜を潛らば、洋々たる大河と共に漠々たる原野を見む。",
              "citation": {
                "source": "蛇くひ",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　午少し過ぐる頃、富山県知事なにがしの君が、四十物町の邸の門で、活溌に若い声で呼んだ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十物町のお邸から、用があるッて、そう有仰るのでございますから。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「四十物町のお花主というと、何、知事様のお邸だッけや。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "内には目の不自由な人もござりますし、四十物町までは道も大分でござりますで。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は顔を背け合って、それから総曲輪へ出て、四十物町へ行こうとする、杉垣が挟んで、樹が押被さった径を四五間。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この馬返すからな、四十物町まで持って行ってくんねえ、頼むぜ、おい。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれから旅籠町へ抜けて、東四十物町を突切って、橋通りへ懸って神通を飛越そうてえ可恐い逸れ方だ。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや神通が切れた、郷屋敷｜田圃の堤防が崩れた、牛の淵から桜木町へ突懸る、四十物町が少し引くかと思うと、総曲輪が湖だという。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十物町はちょろちょろ流れで、兵粮を積んだ船が往来する。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし四十物と書いてアイモノと訓ませるやうになると、此品目の中には鹽物も入つて居たかも知れぬ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツケドミ　信州の山村にも知れ渡つた食物、所謂四十物（アヒモノ）の一つ、長鰯を粉糠と鹽とで漬けたもので、主として越後西頸城の海濱から、歩荷の肩で運び入れられた（郷土一卷四號）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし四十物と書いてアイモノと訓ませるようになると、この品目の中には塩物も入っていたかも知れぬ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツケドミ　信州の山村にも知れ渡った食物、いわゆる四十物（アイモノ）の一つ、長鰯を粉糠と塩とで漬けたもので、主として越後｜西頸城の海浜から、歩荷の肩で運び入れられた（郷土一巻四号）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
