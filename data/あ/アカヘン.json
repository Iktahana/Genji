        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "敵の陣地へ飛び込んで、ぼやぼやしてたら、あかへんし。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんな嫁はんあらへん――親出や、親出や」「階下へいて見せたろ」「――一寸待って、何ぞ頭へ被らなあかへんわ、ええもんがある、ええもんがある」　その上に姉様かぶりを手拭でさせられた章子をしょびいて、どやどや部屋を出た。",
              "citation": {
                "source": "高台寺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸お待ち、矢鱈こすつたりしたらあかへん。",
              "citation": {
                "source": "乳の匂ひ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こんな田舎の医者なんかあかへん。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どない叩いたかてあかへん。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お銭なんか持つて居よつては、買ひ食ひしたりしてあかへん。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「よう一晩に三軒も四軒もまはつて歩きよつたもんやが、それで平気やつたもんやが、もう此頃はさつぱりあかへんな、お母ン――お母ンは心気臭いやろな？",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これからおまはんに小遣をやるよつて、買ひ食ひなんかしよつてはあかへんぜ。",
              "citation": {
                "source": "世の中へ",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく注意しておいたのに、こう集って来たらあかへんがな。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うわッ、気が変になったらあかへんが。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかへんほん」などと、言ひ捨てて、走り去るのである。",
              "citation": {
                "source": "打出の小槌",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "理窟も屁ったくれもない、横車やよってに、なんぼ、理を詰めた話したかてあかへん。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
