        "examples": {
          "standard": [
            {
              "text": "祖父は昔からの暁起きが習慣で、私たちが起きる頃にはすでに畑仕事に出ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "冬の暁起きは寒くて辛いが、澄んだ冷たい空気を吸い込むと頭が冴える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "漁師町では多くの人が暁起きで働き始め、港は朝早くから活気に満ちている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "早暁起き出でて大気を吸へば垂死の身もよみがへる。",
              "citation": {
                "source": "枕上浮雲",
                "author": "河上肇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
