        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "劇場の入り口にある預かり所にコートを預けてから席に着いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "駅の手荷物預かり所にスーツケースを預け、身軽になって観光を楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "美術館の傘預かり所は混雑しており、少し列に並ぶことになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "携帯品預かり所の印半纏の爺さんが「細かいものは風呂敷に包むなり、ポケットへ入れるなりして下さい」と黒山の人の頭越しにどなっている。",
              "citation": {
                "source": "待呆け議会風景",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでの僕の知識によると、料理店の構造は、まず玄関を入ると、お帽子外套預かり所があり、それから中へはいると広間があって、ここで待合わせたり、茶をのんだりする。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸ビルにはいって敷煉瓦の上を辷らないように一分きざみに歩いて、漸く下足預かり所に行って上草履にかえる。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この自動車と相対して、おそらく我が日本だけに特有な下足預り所なるものがある。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にこの頃やかましい勞働者の小兒預り所は、一體どこにあるんです？",
              "citation": {
                "source": "津輕地方とチエホフ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――昨夜、亀吉は大阪駅の東出口の荷物預り所で、脊中の荷物を預けている復員軍人を見た。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした中でも、この種の商売を殆ど公然の秘密のように行っていたのは、今でもある悪姙婦預り所であった。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "残された母は妊婦預り所へ泣き入って、絶望と悲愁の中に、私を生み落したので御座いました。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "父さえ母を捨てなかったら、母だって、私を妊婦預り所へ置き去りにして、行衛不明にはならなかったで御座いましょう。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポストの立っている賑な小道も呉服屋のあるあたりを明い絶頂にして、それから先は次第にさむしく、米屋、八百屋、蒲鉾屋などが目に立って、遂に材木屋の材木が立掛けてあるあたりまで来ると、幾度となく来馴れたわたくしの歩みは、意識を待たず、すぐさま自転車預り所と金物屋との間の路地口に向けられるのである。",
              "citation": {
                "source": "※東綺譚",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "文政元年十二月、松平越後守お預り所の役人より、左の如き伺いが幕府へ出た。",
              "citation": {
                "source": "特殊部落と寺院",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "金網の間を通って、下足の預り所へ行く。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "預り所のおばさんが、化粧箱を受取りながら、お愛想をいってくれる。",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに下足預り所の設備があった。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そして、切符はフロレンスまでとなっているのに、彼は車室を出て、ささやかな構内を行きつくすと、荷物を預り所へ託してから、葉巻に火をつけて、両手を――ステッキも傘も持たぬのである――外套のポケットに突っ込んだまま、停車場を出た。",
              "citation": {
                "source": "衣裳戸棚",
                "author": "DER KLEIDERSCHRANK",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下は森閑として、携帯品預り所の長いテエブルの奥では、看守の女たちが居眠りをしていた。",
              "citation": {
                "source": "餓えた人々（習作）",
                "author": "DIE HUNGERNDEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽の響きに送られながら、廊下を通って行って、預り所でシルクハットと、薄色の外套と、ステッキとを受け取ると、彼は階段を降りて、往来へ歩み出た。",
              "citation": {
                "source": "小フリイデマン氏",
                "author": "DER KLEINE HERR FRIEDEMANN",
                "note": "青空文庫"
              }
            },
            {
              "text": "外の携帯品預り所では、黒山のような人がごった返している。",
              "citation": {
                "source": "神童",
                "author": "DAS WUNDERKIND",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の三人の紳士淑女には、外套預り所でまた会った。",
              "citation": {
                "source": "道化者",
                "author": "DER BAJAZZO",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの一時預り所に鞄をあずけてから、近くの飲み屋横町へ急いだ。",
              "citation": {
                "source": "薔薇夫人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "国際通り（国際劇場のある通り）へ出る角に、自転車の預り所があり、朝野は言った。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "その路地の、楽屋口の前にも、自転車の預り所があった。",
              "citation": {
                "source": "如何なる星の下に",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "五館とは賭館（バクチ場）、煙館（阿片吸飲所）、飯館（料理店）、舞館（キャバレー）、殯儀館（死体預り所）。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、へますると、丸さんの言ってた殯儀館行きだな」　この死体預り所という不気味なものが、華やかな舞館などとともに上海で繁昌していた。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            },
            {
              "text": "正に青天の霹靂‥‥」　　　　死の接吻　ウプサラ社交界の華ヂレツト・ホテル、裝飾電燈輝く溜間には夜の裝ひを凝らした紳士淑女の群、その玄關先に自動車を乘り捨てたソオル主任警部とエリクソン署長は外套を預所に置くと、すぐ支配人に面會を求めた。",
              "citation": {
                "source": "死の接吻",
                "author": "――スウェーデンの殺人鬼――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにおいて、番町さんの、泉、はじめて悠然として、下足を出口へ運ぶと、クローク（預所）とかで、青衿が、外套を受取って、着せてくれて、帽子、杖、またどうぞ、というのが、それ覚えてか、いつのこと……。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "携帯品預所の台の上へ短剣を脱して出した栖方は、剣の柄のところに菊の紋の彫られていることを梶に云って、「これ僕んじゃないのですが、恩賜の軍刀ですよ。",
              "citation": {
                "source": "微笑",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "携帯品預所で栖方は、受け取った短剣を腰に吊りつつ梶に、「僕は功一級を貰うかもしれませんよ。",
              "citation": {
                "source": "微笑",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾は、食事がすむとちょっと博士に挨拶して、すぐ帰るつもりで下へ降りて、携帯品｜預所へコートを受けとりに行ったのです。",
              "citation": {
                "source": "華やかな罪過",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "安東の止宿しているアパートのおばさんをはじめ、その友人たち、勤め先の上役と下僚、それから彼の加入しているロザリ倶楽部の給仕や給仕頭や預所の婦人たちを訪ねまわった。",
              "citation": {
                "source": "心臓盗難",
                "author": "烏啼天駆シリーズ・２",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
