          "literary": [
            {
              "text": "「アスアサゴジヒキコシテツダヒタノム」といふのだ。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハコネ、ユモト、タマヤ、デビョウキ、アスアサキテクレ」　受取って玄関で開いた千歳は、しばらく何が何やら判らなかった。",
              "citation": {
                "source": "呼ばれし乙女",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "電報は、名古屋駅発信で、発信時刻は当日午前七時二分、受信八時二十分で電文は『キユウヨウアリチユウオウセンニテマツモトヘユキアスアサイイダマチツクキミ』となっている。",
              "citation": {
                "source": "山吹町の殺人",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケサノリオクレタアスアサタツモヤー　がっかりし、泣き出したい位になった。",
              "citation": {
                "source": "日記",
                "author": "一九二六年（大正十五年・昭和元年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "電文には、昨夜Ｆ市の発信で「アスアサ九ジツク」とある。",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきまりの読み難い片仮名ながら、はっきりと、「アスアサ九ジツク」と書いてある。",
              "citation": {
                "source": "我に叛く",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "滋子はそのとき夫の克彦と白耳義にいたが、十二月もおしつまった二十九日の昼ごろ、アスアサ一〇ジ　パリニツクという安の電報を受取ってびっくりした。",
              "citation": {
                "source": "野萩",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "滋子は夫の克彦と白耳義にいたが、十二月もおしつまった二十九日の朝、アスアサ一〇ジパリニツクというやすの電報を受取ってびっくりした。",
              "citation": {
                "source": "ユモレスク",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "二四ヒスマヌ　アスアサデ　ンタノム。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
