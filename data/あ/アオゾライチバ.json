        "examples": {
          "standard": [
            {
              "text": "週末になると、公園の広場で地元の農家が集まる青空市場が開かれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ヨーロッパ旅行の際、古い広場で開かれていた青空市場でアンティークの小物を買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "採れたての新鮮な野菜を求めて、朝早くから青空市場に出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "東京の青空市場へ行って野菜のあきないをしようかとおもっていますが、おばあさんがゆるしてくれません。",
              "citation": {
                "source": "お父さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マーケットは青空市場のなれの果だから、板によつて青空を仕切つて人間共に位置を与へる。",
              "citation": {
                "source": "金銭無情",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
