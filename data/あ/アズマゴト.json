        "examples": {
          "standard": [
            {
              "text": "昔の農村では東琴が多くの家で見かけられたという記録がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "民俗博物館の展示品には、樹齢の古い東琴が静かに置かれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その立派な東琴は一本の大きな木を職人が手作りしたものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "面倒な気がして、源氏は東琴（和琴に同じ）を手すさびに弾いて、「常陸には田をこそ作れ、仇心かぬとや君が山を越え、野を越え雨夜来ませる」という田舎めいた歌詞を、優美な声で歌っていた。",
              "citation": {
                "source": "源氏物語",
                "author": "若紫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
