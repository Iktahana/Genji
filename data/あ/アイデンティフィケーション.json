        "examples": {
          "standard": [
            {
              "text": "機密エリアへのアクセスには、生体認証による厳密なアイデンティフィケーションが求められる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "銀行のオンライン口座を開設する際、運転免許証を用いたアイデンティフィケーションの手続きをスマホで済ませた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "ログイン時の二段階認証は、ユーザーのアイデンティフィケーションを強化するための有効な手段だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "年の干支と同様に日の干支でもこれを添えることによって日のアイデンティフィケーションがほとんど無限大の確実さを加える。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
