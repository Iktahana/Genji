  {
    "uuid": "44f38a3d-4668-52e5-8394-61a383976ef4",
    "entry": "秋霧",
    "reading": {
      "primary": "あきぎり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
