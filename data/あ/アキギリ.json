        "examples": {
          "standard": [
            {
              "text": "秋の野山で、紫色の可憐な花を咲かせる秋桐を写真に収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秋桐は湿り気のある場所を好むようで、沢沿いにひっそりと咲いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "押し花にするために、庭に咲いた秋桐を一輪だけ丁寧に摘み取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
