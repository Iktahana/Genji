        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ドアの上にある明かり窓から、廊下の様子をうかがうことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "納屋の壁の高い位置にある明かり窓が、埃っぽい室内に光を届けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "明かり窓を少し開けておくだけで、部屋の空気の通りが格段に良くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "廊下の東詰の流しの上の明かり窓から病院の動物小屋が見える。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、およその見当に温泉の浴室があり、その建物の高い軒下には天井の周囲を帯状にめぐらす明かり窓があって浴室内の電燈の光に照らされたその窓が細長い水平な光の帯となって空中にかかっている。",
              "citation": {
                "source": "人魂の一つの場合",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの可能性は、上記の浴室の軒の明かり窓の光が一時消えていたのが突然ぱっと一時に明るくなったと仮定すると、その光の帯が暗がりになれていた人の横目には一方から一方に移動する光のように感ぜられたのではないかということである。",
              "citation": {
                "source": "人魂の一つの場合",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、船長が明かり窓を降りて来るのが聞こえるぞ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、彼の力は足らず、集会室の明かり窓によろめき退って来て、そこに彼はあえぎ疲れて倚りかかってしまった。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔色は蒼白となったので、私はきっと彼が意識を失うものと思って、時を移さずに彼を伴って明かり窓を降りて、船室のソファの上にそのからだを横たえさせた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "目は刃物のようだが、それを見ず顔だけに明かり窓の光を当てたら、喜んでいるとも受け取れる、といった具合だ。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "その影は消えて、僕のからだは廊下の明かり窓の手欄に支えられているのに気がついた時、初めて僕はぞっとして髪が逆立つと同時に、冷や汗が顔に流れるのを感じた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "上床",
                "note": "青空文庫"
              }
            },
            {
              "text": "急いで原稿や帳簿の取り出しにかかって、まだその全部を出し切らないうちに、もう明かり窓の上の日覆いに火がついていた。",
              "citation": {
                "source": "地異印象記",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は最上階へ上がって、天井の明かり窓を点検する。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初ちょっと不審なそぶりを見せたが、邸宅が静かで、明かり窓がこうこうと輝いているので、疑惑が晴れたようだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            },
            {
              "text": "明り窓から黒の僧衣を著た修道士の姿が見えた。",
              "citation": {
                "source": "修道院の秋",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまんが梯子を降りて行ったあと、吉左衛門はまた土蔵の明り窓に近く行った。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "高い明り窓は土蔵造りの屋内へ光線を導くようになっている。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "金網を張った明り窓の重たい障子を開けて僅かに物を見ることが出来た。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "更にヨリ一層椿岳の個性を発揮したのは、モウ二十年も前に毀たれたが、この室に続く三方壁の明り窓のない部屋であった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "正面の石垣に遮られる太陽が一日に一回明り窓からぎら／＼と射し込んだ。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁にあるのは円形の窓で、天井にあるのはこれも円形の、玻璃で造られた明り窓で、そこに灯火が置いてあると見え、そこから鈍い琥珀色の光が、部屋を下様に照らしていた。",
              "citation": {
                "source": "十二神貝十郎手柄話",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも私が今思い出せるのは倉の明り窓からのぞいた隣の家の庭だけです。",
              "citation": {
                "source": "蛋白石",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "北向の部屋の外から勝手の方へ通う廊下の屋根には小さな明り窓があって、その窓から射す日暮時の光が廊下に接した小部屋の障子を薄明るく見せていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの明り窓の内部には、「深夜の市長」が城東で起った殺人事件の証拠物件を、彼の手紙とともに届けるようにと命じたところの不思議な科学者｜速水輪太郎が住んでいる筈だった。",
              "citation": {
                "source": "深夜の市長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "この注射器の底に、ほんのり茶っぽいものが附いているが、これは、なんて薬かい」「うん、なんか附いてはいるが――」若い男は注射器を、明り窓の方に透かして、その茶色の汚点に眺め入った。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も明り窓一つない洞内では昼と夜との区別はないわけである。",
              "citation": {
                "source": "鬼仏洞事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "五メートルと離れないところに、鉄管の一部が明り窓のように黄色く輝いているのだった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや／＼、こりゃ墓ではない、明り窓ぢゃ、なア、足下。",
              "citation": {
                "source": "ロミオとヂュリエット",
                "author": "ROMEO AND JULIET",
                "note": "青空文庫"
              }
            },
            {
              "text": "大工を入れて、台所に明り窓をつけ、区切って風呂場となる処を拵え、濡縁を修繕させ、引越しの二三日前始めて、私は内の様子を見た。",
              "citation": {
                "source": "又、家",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "北向きの三畳が多喜子の家では仕事部屋になっていて、東の高窓際にミシンがおかれ、仕事テーブル、アイロン台と、順に低い一間の明り窓に沿って並んでいる。",
              "citation": {
                "source": "二人いるとき",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓がすっかり壁の中仕切のところへ飛び込んでしまったばかりか、明り窓は煙突の上にのっかってしまっている。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "池にはそういう種類の魚群がたくさんあって、かれらは冬がその氷の戸をかれらの広い明り窓のうえに鎖す前の短い季節をたのしんでいるかのようで、時折り、湖面にかすかな風があたったのか、それともいくつかの雨のしずくが落ちたのか、と思わせるうごきを見せるのであった。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、彼は背一杯に伸び上つて、明り窓からヤンに聲を掛けようとして、頭で木の蓋板を擡げた。",
              "citation": {
                "source": "氷島の漁夫",
                "author": "PECHEURS D'ISLANDE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
