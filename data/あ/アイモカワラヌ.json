        "examples": {
          "standard": [
            {
              "text": "彼から届いた手紙には、相も変わらぬ友人への気遣いが綴られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "故郷の山々は、子供の頃と相も変わらぬ姿で私を迎えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "先生の相も変わらぬ情熱的な指導に、生徒たちは深く感銘を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "いつもいつも父母兄弟から相も変わらぬ気休めをいわれて帰ってくる。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の周囲は相も変わらぬ「異境」ばかりだ。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "塀の上の人影　金兵衛は引きしまって訊いたけれども、鴫丸のほうでは引きしまろうとはしないで、相も変わらぬノソッとしたようすで、「お老人にでございますかな？",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」偉大なるレディは相も変わらぬ無関心な声で答えた。",
              "citation": {
                "source": "犬酸漿",
                "author": "Ａ. キングスフォード　A. Kingsford",
                "note": "青空文庫"
              }
            },
            {
              "text": "両都の学生たちは、たいてい朝から晩まで、各種の新聞雑誌の編集室へ、お百度を踏みながら、相も変わらぬ仏文の翻訳だとか筆耕の口だとかを、あとからあとからと懇願する以外には、なんのいい思案も浮かばないのである。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あいもかわらぬサナトリウムの日課が始まったのである。",
              "citation": {
                "source": "※の囁き",
                "author": "――肺病の唄――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
