          "literary": [
            {
              "text": "「さあ、今日は昨日のつづきのアンモニアツクの兄弟を調べて回答しなければならん。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "二番書記、アンモニアツク兄弟の中で、南極へ行つたのは誰だ。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうかと思ふと、ぞつとするやうなマニアツクな引つゝれるやうな笑ひがとめどもなく続きます。",
              "citation": {
                "source": "白痴の母",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハ、コンゲツ一パイメッタニ雨モフラズ、カゼモナクテ、マイニチマイニチヤケルホドアツクテ、ワタシハモウスコシデ、クタバッテシマフトコロデシタ。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京ハイツデモアツイソウデスガ、今年ハトクベツニアツクテ、三十五年カラナイホドダサウデス。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイガンノ　スナハ　サワルト　アツク　ヤケテヰマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ヒハ　カン　カン　ト、マウヘカラテツテ、アツクテ　タマリマセンデシタガ、ジヨン　ト　チビスケハ　カケツコシテ　ノハラニ　ユキマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "予はこの木頭火に耶蘇教のユールロツグ（耶蘇降誕祭の木頭火）との間には思想の連絡あるを信ず、この聖火に近く奧の院あり、此に參じてその幔幕及その前の懸燈に於て、叉斧（ダブルアツクス）の印章あるを見たり。",
              "citation": {
                "source": "弘法大師と景教との關係",
                "author": "イー、エー、ゴルドン",
                "note": "青空文庫"
              }
            }
          ]
