        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "一九一四年ボンベイ板エントホヴェンの『グジャラット民俗記』五四頁にいわく、一説に帝釈瞿曇の妻に通じた時アンジャニ女帝釈を助けた故、瞿曇これを詛いて父なし子を生むべしという。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンジャニ惧れて腰まで地中に埋め苦行して、シワ神に救いを求む。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その教えに任せて王これを三妃に頒つにその一人分を鷲が掴んで同じく子を求めて苦行中のアンジャニ女の手に落し入る。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
