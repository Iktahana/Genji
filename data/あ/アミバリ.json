        "examples": {
          "standard": [
            {
              "text": "編み針を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちは編み針について学習した。",
              "source": "幻辞"
            },
            {
              "text": "編み針の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生は編み針の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化では編み針が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "編み針という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中に編み針という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社では編み針についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "編み針を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によると編み針は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "編み針について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野では編み針が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的に編み針は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展により編み針の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "編み針は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的に編み針は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "出来上がりが近づくと葉子は片時も編み針を休めてはいられなかった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キリストを恋い恋うて、夜も昼もやみがたく、十字架を編み込んだ美しい帯を作って献げようと一心に、日課も何もそっちのけにして、指の先がささくれるまで編み針を動かした可憐な少女も、その幻想の中に現われ出た。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの姿を見た夫人は、室内帽子をかぶった頭を、編み針の先で掻くと、いきなりわたしに向って、請願書を一通清書してもらえまいかと問いかけた。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "靴下の編み針が、不安に襲われた動物の触角みたいに動いている。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから突然怒りだして、編み針を彼の頭に投げつけ、帰ってゆけと怒鳴り、大嫌いだと叫んだ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "また編み針の先を折りその棒をとがらして短剣とした靴職人もあった。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "くろぐろと塗り磨かれた車体も、その両側に付いて居る長い銀の編針を束ねてひろげた様な二つの車輪も、すべてつやつやと掃除が行き届いて居て、さわやかな朝の明るさのなかに、何か尊いものの様に見えるのであった。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "十七、八の金髪の娘が一人、向うの隅っこに身をひそませていたが、何か青い毛糸の編針を動かし動かし、キッと此方を見た。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナタアシャは顔を赤くして反射的に編針を持った片手をうち振っていた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "手に編針を持つてゐる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "手に編針を持っている。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しか夫の顔のどこかに綻びでもあつたら、すぐに編針でもつてつづくりでもしさうな権幕であつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十一（一九二二）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして編針を四ツに折つた。",
              "citation": {
                "source": "「悪」の同意語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "房は、むっとしたように下を向いたまんま、途方もなく速く編針を動かしている。",
              "citation": {
                "source": "氷蔵の二階",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　女は編針を休めたまま、子供のように微笑した。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二年ぶりに編針を持って見ましたの。",
              "citation": {
                "source": "母",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "お定まりの月の光が、ちらちらと動いて、女の編針のように入り交る。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、自分の心を、編針の上に、拵へかけてゐる財布の編目の上に、集中しようとした――たゞ自分の手にある仕事の事だけを考へ、膝の上にある銀色の南京玉と絹絲ばかりを見てゐようと思つたのである。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「百姓も大勢ゐるがね、大抵はオリヴァさんの編針工場で働いてゐる、それから鑄物工場へもね。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして老婆の編針のカチ／＼いふ音までが聞き取れるやうにさへ思はれた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この方があの探……」　危うく吹き出しそうになって、老女は忙しく編針を動かします。",
              "citation": {
                "source": "古銭の謎",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
