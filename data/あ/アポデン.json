    "definitions": [
      {
        "index": 1,
        "gloss": "making appointment plans over the phone",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
