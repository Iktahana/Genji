        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "アポ電を使って文を作ってみた。",
              "source": "幻辞"
            },
            {
              "text": "学生たちはアポ電について学習した。",
              "source": "幻辞"
            },
            {
              "text": "アポ電の使い方は難しい。",
              "source": "幻辞"
            },
            {
              "text": "先生はアポ電の定義を説明した。",
              "source": "幻辞"
            },
            {
              "text": "日本の文化ではアポ電が大切だ。",
              "source": "幻辞"
            },
            {
              "text": "アポ電という概念は興味深い。",
              "source": "幻辞"
            },
            {
              "text": "この本の中にアポ電という表現がある。",
              "source": "幻辞"
            },
            {
              "text": "会社ではアポ電についての会議があった。",
              "source": "幻辞"
            },
            {
              "text": "アポ電を正しく使うことが重要だ。",
              "source": "幻辞"
            },
            {
              "text": "研究によるとアポ電は複雑だ。",
              "source": "幻辞"
            },
            {
              "text": "アポ電について詳しく知りたい。",
              "source": "幻辞"
            },
            {
              "text": "医学分野ではアポ電が使われている。",
              "source": "幻辞"
            },
            {
              "text": "歴史的にアポ電は重要な役割を果たした。",
              "source": "幻辞"
            },
            {
              "text": "技術の発展によりアポ電の意味が変わった。",
              "source": "幻辞"
            },
            {
              "text": "アポ電は様々な場面で使われる。",
              "source": "幻辞"
            },
            {
              "text": "言語学的にアポ電は興味深い例である。",
              "source": "幻辞"
            }
          ],
          "literary": []
        }
