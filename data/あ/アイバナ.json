    "definitions": [
      {
        "index": 1,
        "gloss": "scum formed near the end of the indigo fermentation process",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "藍染の染料を発酵させる甕の表面に、青みがかった藍花が浮かび上がってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "職人は藍花の状態をじっくりと観察し、染め頃のタイミングを見極めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            },
            {
              "text": "美しい藍花が咲くのは、発酵が順調に進んでいる証拠だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3.1-pro-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "藍花畑を見れば、花の美よりも先に、何貫目と数字を出すし、空地を見れば蒔く麦を考え、山を見れば植林を云う。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、藍花染の小袖に革のたすきをかけ、白い布で、額から後鬢へ汗止めをきりっと締めている侍が、草の中に顔を埋めて、俯つ伏しているのである。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "Asiatic dayflower (Commelina communis)",
        "register": "standard",
