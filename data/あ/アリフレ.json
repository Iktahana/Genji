        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "早い話が田中とか、山本とか、林、中村、又は長兵衛、芳夫、太郎、次郎、三郎といったようなアリフレた名前をヤタラに組合わせて並べて行くと、読者はキット途中で作中の人物を混線さしてしまう。",
              "citation": {
                "source": "創作人物の名前について",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、譜をよんで見、ヴェートウヴェンが、ワグナーとは違い、実にアリフレた単純な音を、しかも強く真情に充ち、独自な力で活かして居るのに感じた。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリフレックスのフィルムを止めた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴム製のいかだに腹ばいになって波のふもとに位置をとり、防水のハウジングに閉じこめたアリフレックスで自分が撮った、とダフネは言っていた。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
