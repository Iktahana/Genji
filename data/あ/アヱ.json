        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「アヱ、マリア」の鐘鳴るころ、われは近隣の子供と像の前に跪きて歌ひき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "我は此物語を聞きつゝ、「アヱ、マリア」の祈をなしつ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌日の夕まだ「アヱ、マリア」の鐘鳴らぬほどに、人々我を伴ひて寺にゆき、母上に暇乞せしめき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヱ、マリア」を唱ふることを忘るな。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "媼が我に「アヱ、マリア」唱へしむるとき、美しき色澤ある蜥蝪我が側を走り過ぎぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヱ、マリア」の鐘鳴る時より、一時ばかり早く來よ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時｜聖アゴスチノ寺の「アヱ、マリア」の鐘の聲響きしかば、われは懺悔せんとて寺の内に入りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの「アヱ、マリア」の鐘鳴るは一時なり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "姫は咋日歸りしかど、樂ははや果てし後にて、僅に「アヱ、マリア」の時此寺には來ぬとなり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヱ、マリア」の鐘響くに先だつこと一時ばかりにして、澤地のはづれに出でぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヱ、マリア」の鐘鳴り止む頃、再び博士の家に往きぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "神神の祖先（アイヌ語）老いしアイヌの歌アイヌはよ、老いしアイヌ、神アヱオイナ、アイヌ・ラクグル（アイヌの臭ひある人）の後、神ながらの頭、土の体、柳の脊骨、シネ・シツキ・プイコロクル（眼窩の人）神神の髪の毛の人、彼こそはげに、カムイ・オトプ・ウシユ・グルなれ。",
              "citation": {
                "source": "海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "神アヱオイナ、アイヌ・ラクグル（アイヌの臭ひある人）の後、神ながらの頭、土の体、柳の背骨、シネ・シツキ・プイコロクル（眼窩の人）神々の髪の毛の人。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
