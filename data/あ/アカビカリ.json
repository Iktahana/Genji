    "definitions": [
      {
        "index": 1,
        "gloss": "shininess in clothing (from grime, wear, overuse, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
