        "examples": {
          "standard": [
            {
              "text": "新緑の季節、寺の境内に広がる青紅葉が太陽の光を浴びて輝いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "秋の紅葉もいいけれど、私は生命力を感じる夏の青紅葉の方が好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "川面にせり出した青紅葉の影が、涼やかな風を運んでくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
