[
  {
    "uuid": "e4f0e1f6-426a-5ab0-b2fa-f923a60c1065",
    "entry": "肋",
    "reading": {
      "primary": "あばら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
