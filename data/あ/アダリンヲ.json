          "literary": [
            {
              "text": "「興奮サセルトイケナイカラ、アダリンヲ飲マセタゲマショウカ」颯子ガ予ニコウ云ウ種類ノコケトリーヲ云ウノハ始メテデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア寝マショウヨオ爺チャン、早クソッチヘ行ッテ頂戴」「アダリンヲ持ッテ来テ貰イタイナ」予ハ予ノ寝台ヘ戻リナガラ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ心理ハ君ニハ分ルマイ」「分ラナイワネ」「ツマリ、僕ガ醜悪デアレバアルダケ、君ガ途方モナク美シク見エルッテコトサ」予ノ言葉ヲ上ノ空デ聞イテ彼女ハアダリンヲ取リニ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
