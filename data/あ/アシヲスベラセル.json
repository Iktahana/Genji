        "examples": {
          "standard": [
            {
              "text": "雨に濡れた階段で足を滑らせて、手すりにしがみついてなんとか転倒を免れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "温泉の脱衣場で足を滑らせた父を、息子が素早く支えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "屋根の雪下ろし中に足を滑らせた作業員が、安全ロープのおかげで助かった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "古疊の上へ足を滑らせると、冷りとした氣持ちが、得も言はれぬ感じを母の胸に與へて、痩せても枯れても、石川の家には、まだ疊が敷いてあるといふ誇りが、全身に漲るのであらう。",
              "citation": {
                "source": "石川五右衞門の生立",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "武夫は悦んで暗い葉蔭をとおして、その亀のような動物に目を注いだが、そのとき彼は驚きのあまり、もう少しで枝から足を滑らせるところであった。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
