          "literary": [
            {
              "text": "ヒロポニアンでもなければ、アドルマーでもない。",
              "citation": {
                "source": "或る作家の厄日",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "梵語ではアショカ、カンカリ、カンケリ、ヴハンジュウ、ヴハンジュルドルマ、ヴィショカ、ヴィタショカと称えられる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その村のお寺にスン・チュン・ドルマ（物言う解脱母）という菩薩が居るので、その姿は三尺ばかり、非常に綺麗なもので、いかにも物を言うたような、今でも物を言いそうにあるのです。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
