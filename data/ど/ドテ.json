        "examples": {
          "standard": [
            {
              "text": "寒い夜には、熱々の土手をつまみに日本酒を飲むのが最高だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大阪の居酒屋で食べた土手は、味噌の味がしっかり染み込んでいて絶品だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "圧力鍋を使えば、家庭でも簡単に柔らかい土手を作ることができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
