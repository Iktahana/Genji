[
  {
    "uuid": "5e19bdac-c438-59c5-83b1-4091bf229b04",
    "entry": "何方もどっち",
    "reading": {
      "primary": "どっちもどっち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "表現"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "both are bad",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの二人の言い争い、どっちもどっちで、どちらが悪いとも言えないな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この提案も、あの提案も、どっちもどっちで一長一短がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "どっちもどっちだよ、君も少しは反省しなさい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "あれは対戦中の右翼小説ほどひどくは無いが、しかし小うるさい点に於いては、どっちもどっちというところです。",
              "citation": {
                "source": "返事",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の重役たちも、或いは百右衛門の意地悪を憎み、或いは武蔵の名調子を気障なりとしてどっちもどっちだと思い、或いは居眠りをして何の議論やらわけがわからず呆然として立ち上って、一人去り二人去り、あとには武蔵と金内だけが残されて、武蔵くやしく歯がみをして、「おのれ、よくも、ほざいた。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "地元の矢島も頗る面白からぬ人物だが、しかし、こんな言葉を使用する東京人の津田氏の心理もあんまり高潔とは言えない、どっちもどっちだ、と思い直してしまった。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "角突き合いならどっちもどっちだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっちもどっちだよ。",
              "citation": {
                "source": "凍雲",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……どっちもどっちだねえ）と思うと同時に、ムラムラと嫉妬の情が湧いて来た。",
              "citation": {
                "source": "甲州鎮撫隊",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっちもどっちののっぽですわ」「銀太というのは、ここへもちょくちょく忍んで来るだろうね」大江山警部は訊いた。",
              "citation": {
                "source": "ネオン横丁殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "引揚船で上海からお帰りなったことは聞いていましたが、かけちがってお目にもかかれず」なんて、おなじようなことをいってとめどもなくお辞儀のしあいをしているんですから、阿呆らしいやらバカらしいやら、どっちもどっちだと思って、見ているあたしのほうが悲しくなっちゃったわ。",
              "citation": {
                "source": "猪鹿蝶",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっちもどっちだわ。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "引ったくったほうも、ひったくられたほうも、どっちもどっちのような気がして話す心もちになれなかったのだ。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "引揚船で、上海からお帰りなったことは聞いていましたが、かけちがってお目にもかかれず」なんて、おなじようなことをいって、とめどもなくお辞儀のしあいをしているんですから、阿呆らしいやらバカらしいやら、どっちもどっちだと思って、見ているあたしのほうが悲しくなっちゃったわ。",
              "citation": {
                "source": "姦（かしまし）",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あの中でいちばん強悪無類だといわれていたわしでさえ、道三｜父子には、どっちもどっちだなと、堪らない憎悪を感じた。",
              "citation": {
                "source": "茶漬三略",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあの時は……いや、今になってみれば、どっちもどっちですがね！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "トロツキストが世界中でマイノリティだという事実、彼らに対して通常浴びせられる非難――即ち、ファシストとの共謀――が明白な虚偽であるという事実、これらのためにトロツキズムは共産主義より知性および人品の上で優れているという印象が生まれるのだが、どっちもどっちではないかと思わないではいられない。",
              "citation": {
                "source": "ナショナリズムについての覚書",
                "author": "ジョージ・オーウェル　George Orwell",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か、どっちもどっち。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の山窩、海の抜荷屋、どっちもどっちのしろものだ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
