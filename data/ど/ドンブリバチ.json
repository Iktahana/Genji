    "definitions": [
      {
        "index": 1,
        "gloss": "bowl (medium-large, suitable for donburi)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "母は、私が好きなカレーうどんを大きなどんぶり鉢に入れてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このどんぶり鉢は、ラーメンやうどんを食べるのにちょうどいい大きさだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "食洗機対応の丈夫などんぶり鉢を探している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが二三日前の朝のことだが、どんぶり鉢が炉端で転がる激しい音を立てたことがある。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄瓶、薬鑵、どんぶり鉢、何んでも手あたり次第に清江に投げつけ、「出て行け、帰れ。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
