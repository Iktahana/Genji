        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "たしかに大人の、異様な胴間声である。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "羽左衛門の義経を見てやさしい色白の義経を胸に画いてみたり、阪東妻三郎が扮するところの織田信長を見て、その胴間声に圧倒され、まさに信長とはかくの如きものかと、まさか、でも、それはあり得る事かも知れない。",
              "citation": {
                "source": "鉄面皮",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」神の胴間声、「用意！",
              "citation": {
                "source": "二十世紀旗手",
                "author": "――（生れて、すみません。）",
                "note": "青空文庫"
              }
            },
            {
              "text": "調子はずれの胴間声で、臆することなく呶鳴り散らしていたのだが、歌い終って、「なんだ、誰も歌ってやしないじゃないか。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "船の胴間でけんどん箱から食品を取り出して膳に配置したり、箱火鉢の銅壺に徳利を浸したりしていたおきみは、あとを船頭に任して表の間へ膳を運んで来ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして今、耳元でがなり立てられるのは「現代の民主主義を守るには訓練をつんだ武装集団が不可欠だ」との胴間声の大合唱である。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時オレが与太を飛ばしていた広島の片田舎にも、「アメリカはベトナムから出ていけ」だの「東大解体」だの「日帝打倒」だのの胴間声は響いていた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、またどの爺さんだか胴間声をかっ飛ばした。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く途切れた客の後から一人の男がずつとはひつて來てどつかり椅子へ腰を卸しながら「おゝ髭だ」　胴間聲を出していつた。",
              "citation": {
                "source": "おふさ",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくしたら、銘々胴間声を出して何か唄ひ始めた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれがそっちへ行くから、そこで待っているんだよう」　圭さんの胴間声は地面のなかを通って、だんだん近づいて来る。",
              "citation": {
                "source": "二百十日",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらくしたら、めいめい胴間声を出して何か唄い始めた。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と主人は胴間声を張り上げて寝室から飛び出して来る。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それも単に病気の所為なら咎むる事もないが、彼は逆上しながらも充分本心を有しているに相違ない事は、何のためにこの法外の胴間声を出したかを話せばすぐわかる。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と胴間聲を上げて、菊池君はまた人の目を引いた。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、中から胴間聲がする。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と胴間声を上げて、菊池君はまた人の目を引いた。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と先づ胴間声が突走つた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と、中から胴間声がする。",
              "citation": {
                "source": "天鵞絨",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と先づ胴間聲が突つ走つた。",
              "citation": {
                "source": "赤痢",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうすると、もうどこかへ行ったのか知らんと思っていたその男が馬鹿みたいにノロノロした、変テコな胴間声で口を利き出したの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "響きの大きい胴間声が、難破船のように切れ切れにシャガレていて、死んだ水夫の声じゃないか知らんと思われた位であった。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「フ――ン……何かその男に変った事は無いかね……近頃……」　Ｔ刑事は有名な胴間声であった。",
              "citation": {
                "source": "冗談に殺す",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうじき廻診ですよ」　という男の胴間声が、急に耳元に近づいて来た。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "競場で鍛い上げた胴間声を揺すって湊屋一流の怪長広舌を揮い始めた。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとその頭の上から、和尚の胴間声が雷のように響いて来た。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "』さういふ胴間声が彼の頭のうへで鳴り響いた。",
              "citation": {
                "source": "ディカーニカ近郷夜話　前篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "合唱中のあの胴間声は鶴井であり、あのてのうるは倉であることに私は気がついた。",
              "citation": {
                "source": "心象風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　それを自分に浴せるやうな胴間声で叫んだ者もあつた。",
              "citation": {
                "source": "まぼろし",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、それが底抑えの胴間声で呶鳴った。",
              "citation": {
                "source": "親方コブセ",
                "author": "金史良",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
