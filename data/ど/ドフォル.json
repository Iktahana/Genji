        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私にそれが嗅ぎ分けられたところでは、それはヨオドフォルムの匂、揚林檎の油の匂、恐怖の匂だ。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてヨオドフォルムや、揚林檎の油や、恐怖の匂を吸ひ込んでゐた。",
              "citation": {
                "source": "「マルテ・ロオリッツ・ブリッゲの手記」から",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、繃帯を取り終ると、申す迄もなく剔出した方の眼にはヨードフォルムガーゼが詰められてありまして、美しい容貌も惨憺たるものでした。",
              "citation": {
                "source": "痴人の復讐",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "玩具の風船は、セント・ペテルスブルグのゴスティナイ・ドフォル近くに、いつもいくらでも売っていた。",
              "citation": {
                "source": "愉快な話",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、例の忌わしい医者の薬――ヨードフォルムや石炭酸の匂が、不意にわたしの眼をさましました。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋の中には、ヨードフォルムの重苦しい匂が漂っていました。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の純朴な眼つき、よれよれのフロック、安物のネクタイ、ヨードフォルムの臭い――それらは私に不愉快な印象を与えた。",
              "citation": {
                "source": "妻",
                "author": "ЖЕНА",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
