        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "公園にはたくさんの土鳩が餌をついばんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "土鳩は都市部でよく見かける鳥だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供が土鳩に豆をあげている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「門前の土鳩を友や樒売り」――こう云う天保の俳人の作は必ずしも回向院の樒売りをうたったものとは限らないであろう。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝書鳩なら鳩舎に帰るだろうが、杉山氏の放すのは土鳩だよ。",
              "citation": {
                "source": "鳩つかひ",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この故に蛇のごとく慧く、鴿のごとく素直なれ。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "側なる小瀑の上なる岩窟には、一群の鴿ありて巣を營みたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "數千の鴿は廣こうぢを飛びかひて、甃石の上に※れり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほのかなる蝋の火にいでや子ら、日は高し、風たちて棕櫚の葉のうち戦ぎ冷ゆるまで、ほのかなる蝋の火に羽をそろへ鴿のごと歌はまし、汝が母も。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなかしこ、鴿の子ら羽をあげて御龕なる蝋の火をあらためよ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなゆかし、ロレンゾか、鐘鳴らし、まめやかに安息の日を祝ぐは、あな楽し、真白なる羽をそろへ鴿のごと歌はまし、わが子らよ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あはれなほ日は高し、風たちて棕櫚の葉のうち戦ぎ冷ゆるまで、ほのかなる蝋の火に羽をそろへ鴿のごと歌はまし、はらからよ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "もろもろの美果実籠に盛りて、汝が鴿ら畑に下り、しらしらと帰るらし夕づつのかげを見よ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "われらまた祖先らが血によりて洗礼がれし仮名文の御経にぞ主よ永久に恵みあれ、われらも、と鴿率つつ祷らまし、帆をしぼれ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが鴿よ、わが友よ、いざともに擁かまし。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "さならずばわが家のわが家の可愛ゆき鴿をその雛を汝せちに恋ふとしならば、いでや子よ、逃れよ、早も邪宗門外道の教かくてまた遠き祖より伝ヘこし秘密の聖磔とく柱より取りいでよ。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "甍より鴿か立ちけむ、はたはたとゆくりなき音に。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "七羽の鴿が窓から飛び去って、空中へ高く舞いあがった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "宣室志（唐）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはしずかに伐らなければなりません」　その言う通りに切り開いて、二｜面の琵琶の胴を作らせたが、その面には自然に白い鴿があらわれていて、羽から足の爪に至るまで、巨細ことごとく備わっているのも不思議であった。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、職人が少しの手あやまちで、厚さ幾分のむらが出来たために、一羽の鴿はその翼を欠いたので、李公はその完全なものを宮中に献じ、他の一面を自分の手もとにとどめて置いた。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "大定の末年のある夜、かれは一羽の鴿を餌として、古い墓の下に網を張り、自分はかたわらの大樹の上に攀じ登ってうかがっていると、夜の二更（午後九時―十一時）とおぼしき頃に、狐の群れがここへ集まって来た。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "続夷堅志・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鉄の野郎め、貴様は鴿一羽を餌にして、おれたちを釣り寄せるつもりか。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "続夷堅志・其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "ま白き鴿のひと群、天の羽々矢と降りきて、黄金の雲にいりぬる。",
              "citation": {
                "source": "公孫樹",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましろき鴿のひと群羽ばたき飛びぬ。",
              "citation": {
                "source": "公孫樹",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏が寺門屋下に鴿蛇猪を画いて貪瞋痴を表せよと教え（『根本説一切有部毘奈耶』三四）、その他蛇を瞋恚の標識とせる事多きは、右の擬自殺の体を見たるがその主なる一因だろう、古インド人も蛇自殺する事ありと信じたと見える。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "北欧セービュルクの物語に、一僕銀白蛇の肉一片を味わうや否や、よく庭上の鶏や鵝や鶩や鴿や雀が、その城間もなく落つべき由話すを聴き取ったとあり。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時｜鴿来ってかかる骨肉間の婚媾は宜しからずといったところで仕方がないから、一旦離別して互いに今までのと人を替えて婚姻すれば構いなしと教えたと（スキートおよびブラグデン、巻二、頁二一八）。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その前に三動物を画き、鴿は多貪染、蛇は多｜嗔恚、豕は多愚痴を表わす。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "鴿の面をもてる者に蛇の心あり、美はしき果実に怖ろしき毒を含めることあり、洞に近けば※蛇蟄し、林に入れば猛獣遊ぶ。",
              "citation": {
                "source": "哀詞序",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "女匪の働く悪事の中でも、串放白鴿の如きは最も驚くべきもので、それは女匪中の美人をどこかのお嬢さんに仕立て、田舎あたりの金持ちの息子と結婚させる。",
              "citation": {
                "source": "さまよう町のさまよう家のさまよう人々",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、彼の苛立たしさは彼にエホバの「殿に入りてその中にをる売買する者を殿より逐出し、兌銀者の案、鴿を売者の椅子」を倒させてゐる。",
              "citation": {
                "source": "西方の人",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "この支那の狐の話は、狐を捕るのを商業にしてゐた男が、一羽の鴿を餌にして、古い墓の下に網を張り、自分は大きな樹の上に居ると、夜更けて狐の群がここに集つて來て、人のやうな聲を出して樹の上の男を罵つた。",
              "citation": {
                "source": "春宵戲語",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "唐時代でも、南洋方面から來る貿易船は鴿を養ひ、之を陸上との交通にも、又は陸地の搜索にも、使用いたして居たが――最近の世界大戰以來持て囃された傳書鴿の使用は、東洋が本場で、十字軍の頃に、東洋から歐洲に傳つたものである――日支間の航海には之を使用せなかつた。",
              "citation": {
                "source": "大師の入唐",
                "author": "桑原隲蔵",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
