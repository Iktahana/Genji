    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "これで家賃が十円とは、おどろくほど家賃も高くなったものだ。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻子を振り捨てて、奮然学問のしなおしをやってみようかしら、そんならばたしかに人をおどろかすにたるな。",
              "citation": {
                "source": "老獣医",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうして貴女はここに來たのやさしい　青ざめた　草のやうにふしぎな影よ貴女は貝でもない　雉でもない　猫でもないさうしてさびしげなる亡靈よ貴女のさまよふからだの影からまづしい漁村の裏通りで　魚のくさつた臭ひがするその腸は日にとけてどろどろと生臭くかなしく　せつなく　ほんとにたへがたい哀傷のにほひである。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春夜のただよふ靄の中でわたしはあなたの思ひをかぐあなたの思ひは愛にめざめてぱつちりとひらいた黒い瞳は夢におどろきみしらぬ歡樂をあやしむやうだ。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶望の逃走おれらは絶望の逃走人だおれらは監獄やぶりだあの陰鬱な柵をやぶつていちどに街路へ突進したときそこらは叛逆の血みどろで看守は木つ葉のやうにふるへてゐた。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "商業商業は旗のやうなものである貿易の海をこえて遠く外國からくる船舶よあるいは綿や瑪瑙をのせ南洋　亞細亞の島島をめぐりあるく異國のまどろすよ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほろほろと砂のくづれ落つるひびきにありぢごくはおどろきて隱れ家をはしりいづればなにかしらねどうす紅く長きものが走りて居たりき。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより我等のかたらひはいとうすきびいどろの玉をなづるがごとしこの白き鋪石をぬらしつつみどり葉のそよげる影をみつめゐれば君やわれやさびしくもふたりの涙はながれ出でにけり。",
              "citation": {
                "source": "純情小曲集",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――まどろすの歌――風船乘りの夢夏草のしげる叢からふはりふはりと天上さして昇りゆく風船よ籠には舊暦の暦をのせはるか地球の子午線を越えて吹かれ行かうよ。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "まどろすの歌愚かな海鳥のやうな姿をして瓦や敷石のごろごろとする　港の市街區を通つて行かう。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その腸は日にとけてどろどろと生臭くかなしく　せつなく　ほんとにたへがたい哀傷のにほひである。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は椅子の上にまどろみながら遠い人氣のない廊下の向うを幽靈のやうにほごれてくる柱時計の錆びついた響を聽いた。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この戀よ、亂れて末は知らなくに、おどろにまとふ紅づたのごと。",
              "citation": {
                "source": "短歌",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "地車のとどろと響く牡丹かな　牡丹という花は、夏の日盛りの光の下で、壮麗な色彩を強く照りかえすので、雄大でグロテスクな幻想を呼び起させる。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "麦秋や何におどろく屋根の鶏　農家の屋根の上に飛びあがって、けたたましく啼いてる鶏は、何に驚いたのであろう。",
              "citation": {
                "source": "郷愁の詩人　与謝蕪村",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうとうとした、まどろみ心地の夢の中で、だれも皆人々は、母の懐中に抱かれて居た、幼なき時の記憶を思ひ、なつかしい子守唄を思ふのだつた。",
              "citation": {
                "source": "冬の情緒",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちあの蕭条たる自然の中で、たよりなき生の孤独にふるへながら、赤々と燃える焚火の前に、幼時の追懐をまどろみながら、母の懐中を恋するところの情緒である。",
              "citation": {
                "source": "冬の情緒",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには何かしら、或る物なつかしい、昔々母の懐中でまどろむやうな、或はまた焚火の温暖を恋するやうな、人間情緒の本質に遺伝されてる、冬の物侘しい子守唄の情緒がある。",
              "citation": {
                "source": "冬の情緒",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "感傷の塔萩原朔太郎塔は額にきづかる、螢をもつて窓をあかるくし、塔はするどく青らみ空に立つ、ああ我が塔をきづくの額は血みどろ、肉やぶれいたみふんすゐすれども、なやましき感傷の塔は光に向ひて伸長す、いやさらに伸長し、その愁も青空にとがりたり。",
              "citation": {
                "source": "感傷の塔",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おどろくべき獨斷だ。",
              "citation": {
                "source": "橋上",
                "author": "――詩壇の議論家に捧ぐ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝間になつて日が照り出すと、人の往來する所だけはどろ／＼に雪解がして、泥炭地の水のやうな黒褐色の水が盤に踏み固められた雪路の上を逃げ所もなく漂ひ※る。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の書いたことが何うもまどろつこくなつて起き上つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "言葉が如何に現実にとつてまどろつこしいものであるかは、諸君も先刻御承知であらうし、恐らく諸君が考へてゐられる以上にそれは事実だ。",
              "citation": {
                "source": "深夜の峠にて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "またその※のうつくしさふと物音におどろきて午睡の夢をさまされし牡牛のごとも、あどけなくかろやかにまたしとやかにもたげられ、さてうち俯しぬ。",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になって空に星はあったが、電光が白い柱を、谷の中に投げては、夜営の人々をおどろかした、夜半には、秋雨が音なく注いだ、川縁に転がっている流材を焚火にして、寒さを凌いだ、針葉樹の切崖で囲んだ、瓶のように窄い谷底からは、天も谷川ほどの細さで流れている。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "富士の噴出する前から、そこに居並んで、もっとも若い富士が、おどろくべく大きく生長して、頭抜けてくるのを見つめていた山たちである。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その天空に浮遊するかの如き、嶮にして美なる林道を「天の浮橋」と呼ぶそうであるが、何よりも喬木林の陰森さにおどろかされる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "まどろむこと一瞬間、焚火も全く消えた、一個の逞ましい木像と、一個の冷たい大理石像と、小舎の中に横わる、一は依然として動かないのに、一は蠢めいて待つものあり。",
              "citation": {
                "source": "奥常念岳の絶巓に立つ記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い血が不気味などす黒さにどろっと固まって点点と続いていた。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あ、飲んでくれはりまっか」　男は嬉しそうに、罎の口をあけて、盃にどろっとした油を注いだ。",
              "citation": {
                "source": "秋深き",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            }
          ]
        }
