  {
    "uuid": "dae70d01-1d6c-5f29-b4f6-74bf543a505d",
    "entry": "ドウシテ",
    "reading": {
      "primary": "どうして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ケレド　アンナニ　マドガ　タカクテ、ドウシテ　ナカヲ　ノゾク　コトガ　デキマセウ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウチデハ　トウサン　トツテモ　ヤサシイノニ　ガクカウデハ、ドウシテ　コンナニ　キツイノダラウ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "……二人の博士はドウシテこんなに私を中心にして騒ぎまわるのであろう……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は……」「……ドウしてですか……」「ドウシテじゃない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその一つ一つが「助けてくれ助けてくれ」と五色の悲鳴をあげているのだから、平生なら抱腹絶倒の奇観なんだが、この時はドウシテ……その一人一人が絶体絶命の真剣なんだから遣り切れない。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノトキ、私ニハドウシテモ、君チャンタチハオソロシイ、ノドマデクチノサケタオニノヨウニオモワレタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "四　人気失墜の原因　美妙斎はドウシテ人気を失墜したろう。",
              "citation": {
                "source": "美妙斎美妙",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "二葉亭が一生自ら「文人に非ず」と称したについてはその内容の意味は種々あろうが、要するに、「文学には常に必ず多少の遊戯分子を伴うゆえに文学ではドウシテも死身になれない」と或る席上で故人自ら明言したのがその有力なる理由の一つであろう。",
              "citation": {
                "source": "二葉亭四迷",
                "author": "――遺稿を整理して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "独り他人を軽侮し冷笑するのみならず、この東洋文人を一串する通弊に自ずから襯染していた自家の文学的態度をも危ぶみかつ飽足らず思うて而して「文学には必ず遊戯的分子がある、文学ではドウシテモ死身になれない」という。",
              "citation": {
                "source": "二葉亭四迷",
                "author": "――遺稿を整理して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大西郷の役廻りはドウシテモ坪内君に向けなければならぬ。",
              "citation": {
                "source": "明治の文学の開拓者",
                "author": "――坪内逍遥――",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄弟五人中津の風に合わず扨中津に帰てから私の覚えて居ることを申せば、私共の兄弟五人はドウシテも中津人と一所に混和することが出来ない、その出来ないと云うのは深い由縁も何もないが、従兄弟が沢山ある、父方の従兄弟もあれば母方の従兄弟もある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ガハバカリニ入ッタ後、私ハ床ノ中デイロイロ考エマシタガ、ドウシテモ彼女ニ会ッテ彼女ノ心ヲ飜エサネバナラヌト思イマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハアワテテ木ニノボラウトシマシタノデ、ツルツルツルツルトスベツテドウシテモノボルコトガデキマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　ドウシテヨイヤラタメイキ　ヲ　ツクバカリ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシテモ、ボンコチヤンヲミツケルコトガデキマセンデシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ電車ニノラウトシマシタケレド、イツパイノマンイン電車デ、ドウシテモノルコトガデキマセン。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヂイサンハボンコチヤンノクシヤミガドウシテモ、トマラナイノデ、町デ、有名ナ「モノシリウササン」トイフ、オイシヤサマヲヨビマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "サァ　コレカラドウシテ　オウチヘ　カヘロウカト、ミンナハ　シクシク　ナキダシマシタ。",
              "citation": {
                "source": "ユメノリヨカウ",
                "author": "岡本歸一",
                "note": "青空文庫"
              }
            },
            {
              "text": "――家ガ仲ノ町デ、引手茶屋ヲシテイマシタカラ……　――ソレガ、ドウシテ、後ニ、赤坂ダノ、葭町ダノヽ住人ニナリマシタカ？",
              "citation": {
                "source": "三の酉",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "鈴木氏ニハ数年前ニ心臓ノ期外収縮ガ長ク続イテドウシテモ止マラナイデ困ッタ時ト、眼眩デ苦シンダ時ニ治癒シテ貰ッタ経験ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「今朝ホド測リマシタ時ハ上ガ一四五、下ガ八三デ、至極順調デゴザイマシタノニ、ドウシテ急ニコンナニ上ッタンデゴザイマショウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ帝国ホテルノアーケードノ店ニアルノヲ見付ケテアルノヨ、ドウシテモコレニシヨウト思ッテ」「イクラダ」「三百萬圓」「何ダッテ」「三百萬圓」「冗談ジャナイ」「冗談ジャナイワヨ」「差当リソンナ金ハナイ」「知ッテルワヨアタシ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "アンナピイピイシタ可愛イ声ガ自分ノ体カラ出テイルトハ思エズ、ドウシテモ虫ガ鳴イテイルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウシテモコレラノ二ツガ同ジ種類ノ生物ノモノトハ信ジラレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サア、ドウシテモ一週間ハカヽルダロウナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ヤ祖父母ノ墓石ノ形式ニ反スルノハ申シ訳ナイガ、予ハドウシテモ五輪塔ニシタイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレデ結局墓石ノ形式ハドレニオ決メナサイマスカナ、実ニイロ／＼ト専門家モ及バヌホド御存知デイラッシャイマスノデ、私ナゾハ何トモ申シ上ゲヨウガゴザイマセンガ」「僕自身モドウシテイヽカ分ラナイノデ迷ッテルンデスヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ彼女ヲ酔イツブシテ寝カシテシマオウトイウ底意モアッタガ、ドウシテ彼女ハソノ手ニハ乗ラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ワレテ僕ハ直チニ一ツノ着想ヲ思イツイタガ、シカシ、僕ニソウイウ機械ノアルヲ、ドウシテ木村ハ察シタノデアロウカ、ソレガ不思議ダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後三時頃、木村ニ電話ヲカケヨウトシタラ、毎日ノヨウニカケテイル彼ノ学校ノ電話番号ガドウシテモ浮カンデ来ナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
