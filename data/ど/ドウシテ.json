[
  {
    "uuid": "8828c157-c260-578d-8ea5-702cdfae53af",
    "entry": "如何して",
    "reading": {
      "primary": "どうして",
      "alternatives": [
        "どーして"
      ],
      "is_heteronym": false
    },
    "grammar": {
