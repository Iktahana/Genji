[
  {
    "uuid": "e12b4654-e88a-560c-95fc-31f140f0561c",
    "entry": "土俵",
    "reading": {
      "primary": "どひょう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(wrestling) ring",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "力士が気合を入れて土俵に上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大勢の観客が土俵を取り囲み、取組を見守った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "相撲の土俵は神聖な場所とされている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "それは昔この道路の水準がずっと低かった頃に砂利をつめた土俵を並べて飛石代りにしてあった、それをそのまま後に土で埋めて道路面を上げたのであるが、砂利が周囲の湿気を吸収するために、その上に当るところだけ余計に乾燥して白く見えるとの事であった。",
              "citation": {
                "source": "追憶の冬夜",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "土俵の黒白青赤の四本の柱は、悲しいくらゐどぎつい原色なのでありました。",
              "citation": {
                "source": "國技館",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "土俵には、ライトを強くあててゐるらしく、力士の裸體は、赤土色に見えます。",
              "citation": {
                "source": "國技館",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猿芝居、大蛇、熊、盲目の墨塗――（この土俵は星の下に暗かったが）――西洋手品など一廓に、※草の花を咲かせた――表通りへ目に立って、蜘蛛男の見世物があった事を思出す。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　一本刀土俵入り　日本の時代ものの映画でおもしろいと思うものにはめったに出会わない。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし近ごろ見た「一本刀土俵入り」だけはたしかに退屈せず気持よく見られた。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「土俵へ塩をまかなくちゃだめだ。",
              "citation": {
                "source": "洞熊学校を卒業した三人",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "堤の壞れた所を物の五十間ほども土俵で喰ひ留めた、その土俵の藁は半ば土になつて、畑中に盛り上つた砂の間からは、所々に一かたまりになつて、大根の花が薄紫に咲き出て居た。",
              "citation": {
                "source": "幻想",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭球もある、「クリツケツト」もある、射的塲もある、相撲の土俵もある、いづれも櫻木大佐が日本を出づる前から、かゝる孤島の生活中、一同の無聊を慰めんが爲めに凖備して來た事とて「テニス、コード」も射的塲も仲々整頓したものである、然し、此島で一番流行るのは端艇競漕と野球競技とであつた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "権右衛門は伝三郎が近頃七百円もする土佐犬を飼い、おまけに闘犬に勝ったといっては犬の鎖や土俵入りの横綱に大枚の金を使ってるときいて業を煮やし、内容証明書を伝三郎に送った。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "土俵の真中で四つに組んで動かない力士は、外観上｜至極平和さうに見える。",
              "citation": {
                "source": "点頭録",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "才兵衛は土俵のまんなかに死んだ蛙のように見っともなく這いつくばって夢のような気持、実に不思議な術もあるものだと首を振り、間抜けた顔で起き上って、どっと笑い囃す観衆をちょっと睨んで黙らせ、腹が痛い、とてれ隠しのつまらぬ嘘をついて家へ帰って来たが、くやしくてたまらぬ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんとかしてその黒獅子を土俵の砂に埋めて、――」「ま、なんて情無い事を考えているのです。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "好きな女と立派なお屋敷に暮して、酒席のなぐさみには伝右衛門を、――」「その屋敷には、土俵がありますか。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などと言ってる間に和尚は、上手投げという派手な手を使って、ものの見事に荒磯の巨体を宙に一廻転させて、ずでんどうと土俵のまん中に仰向けに倒した。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "手近い例を擧げようならば、人試みに直立して胸を張り拳を固め頭を擡げ視を正しくして、横綱が土俵入りをして雄視するやうな姿勢を取り、そして兩手を動かすこと數分時、或は上下し、或は屈伸し、或は撃つが如くし、或は攫するが如くして、任意に力を用ふれば、忽にして身暖く筋張るを覺ゆるであらう。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "英吉は、ここぞ、と土俵に仕切った形で、片手に花の茎を引掴み、片手で髯を捻りながら、目をぎろぎろと……ただ冴えない光で、「だろう、君、筒井筒振分髪と云うんだろう。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、私の堤の決潰を埋めるために葛岡さんを土俵として持って来ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "香以は浜の砂地に土俵を作らせ、村の子供を集めて相撲を取らせて、勝ったものには天保銭一枚の纏頭を遣りなどした。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで俺が解放される事になって帰って来た訳だが、ナアニ頭山は正直だから、シラミを逃がさないようにシッカリと抓んで出すのだから、土俵へ上らない中に代表選手が半死半生になっている。",
              "citation": {
                "source": "父杉山茂丸を語る",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この険の突角の所を撰びて、賊は砲塁を二重にも三重にも構へ、土俵が間に合はぬとて、百姓共が囲み置く粟麦などを俵のまゝ用ひたる程なり」　大体その険要の地であることが察せられるであろうと思う。",
              "citation": {
                "source": "田原坂合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "観客のどよみも同じく空間を描き出す効果があるのみならず、その音の強弱緩急の波のうち方で土俵の上の活劇の進行の模様が相撲に不案内なわれわれにもよくわかるような気がする。",
              "citation": {
                "source": "相撲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "若くて死んだこれらの仲よしの友だちは永久に記憶の中に若く溌剌として昔ながらの校庭の土俵で今も相撲をとっている。",
              "citation": {
                "source": "相撲",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "土俵が壊れたような、相撲の総立ちに、茶屋の表も幟を黒くした群衆でしょう。",
              "citation": {
                "source": "白花の朝顔",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "文字や絵にとどまらず、映像や音を打てば響くように組み合わせていく、絶好の土俵が誕生したのです。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方、日本のチームにとって、レーザーディスクは決して飛び出せない土俵です。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、ボイジャージャパンの設立を決めてその他班の仲間に打ち明けると、彼らも土俵から飛び出す機会を待っていたと言います。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "マッキントッシュは淀み、ＭＳ―ＤＯＳは周回遅れでたらたらとマックを追いかけ、ＵＮＩＸの土俵ではＯＰＥＮ　ＬＯＯＫとＭｏｔｉｆ（共にＵＮＩＸをマックに化けさせる厚化粧の流儀）が水入りの勝負を続けている。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは沢山の壺穴を連結してちょうどひょうたんをつないだように見えました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、今までこれほどひょうばんのいい服はありませんでした。",
              "citation": {
                "source": "はだかの王さま",
                "author": "THE EMPEROR'S NEW SUIT",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
