        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "即ちミュンステルのドオムから取って下すったのである。",
              "citation": {
                "source": "訳本ファウストについて",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニコライのドオムに面した方の窓から私は家の中へ入ると云ふのでした。",
              "citation": {
                "source": "遺書",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "千恵はそれまでＮ会堂はあの大きなドオムを遠目に眺めるだけで、一度も門内へはいつたことさへありませんでしたが、さうなるともう、あの聖堂のなかに何か容易ならぬ謎がひそんでゐるやうな気がしきりにしだして、矢も楯もたまらなくなりました。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな空を背景に、もうついそこに黒々と姿をあらはしてゐるＮ堂のドオムは、まるでゆらゆら揺れてゐるやうに見えました。",
              "citation": {
                "source": "死児変相",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "『あめりか物語』は明治四十年｜紐育より仏蘭西に渡りし年の冬｜里昂市ヴァンドオム町のいぶせき下宿屋にて草稿をとりまとめ序文並に挿絵にすべき絵葉書をも取揃へ市立美術館の此方なる郵便局より書留小包にして小波先生のもとに送り出版のことを依頼したるなり。",
              "citation": {
                "source": "書かでもの記",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "さてこそ、あたしは、※ンドオムの地から、このロアアルの森へ下りて来る幼児たちを跟けて来た。",
              "citation": {
                "source": "癩病やみの話",
                "author": "RECIT DU LEPREUX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
