        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サンドヰツチを、二切たべて、よした。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とさきばしつて、大船のサンドヰツチ、國府津の鯛飯、山北の鮎の鮓と、そればつかりを當にして、皆買つて食べるつもりの、足柄に縁のありさうな山のかみは、おかゝのでんぶを詰らなさうに覗きながら、バスケツトに凭れて弱つて居る。",
              "citation": {
                "source": "雨ふり",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と礼を言つて、おくみはそれへ、ハンケチから出した、パセリをそへたサンドヰッチをよそつた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木さんはサンドヰッチを一つ二つお食りになる。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "青木さんは、サンドヰッチを食べたから、午は乳だけでいゝと言はれたさうで、おくみは婆やが生温くして壺に入れたのを、コップと共に盆に載せて二階へ持つて行つた。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その下よりルウドヰヒ町を左に折れたる処に、トリエント産の大理石にて築きおこしたるおほいへあり。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "時は耶蘇暦千八百八十六年六月十三日の夕の七時、バワリア王ルウドヰヒ第二世は、湖水に溺れて戴ける、警察吏の馬に騎り、または徒立にて馳せちがひたるなど、雑沓いはんかたなし。",
              "citation": {
                "source": "うたかたの記",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンドヰチを買はうとしたのだが、まだ出來て來ないと番人が答へたからである。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にサンドヰツチが沢山這入つてゐる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "籃を取り巻いた連中は、サンドヰツチを食ひ出した。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "食堂車の附いてゐる車であるのに、持つて乗つたビイルの栓を抜いて、革包からコツプを出して飲んで、折詰のサンドヰツチをむしや／＼食つてゐる。",
              "citation": {
                "source": "魔睡",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うを見れば、サンドヰツチの男は口を開いて鼾をかいてゐる。",
              "citation": {
                "source": "魔睡",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅麺麭のやうな二宮宗に、ちよつぴり性慾を撮み込んだ、恰でサンドヰツチのやうな女が生るに相違ない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "画の接吻４・２（夕）　サアゼントといへば、女優のエレン・テリイがマクベス夫人に扮装した、あの名高い画の作者だと知らぬものもないが、この画家がシヤ※ンヌやエドヰン・アベエなどと一緒に暮斯敦の公立図書館の装飾画を頼まれて、米国へ渡つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時同じ露西亜生れのヤアシヤ・ハイフエツツといふ名高い少年｜提琴手の独奏会が紐育のある楽堂で催されたので、友達のレオポルド・ゴドヰスキといふ洋琴弾きと一緒に聴きに往つた事があつた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして小声で側にゐる洋琴手のゴドヰスキに耳打ちをした。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "」人の悪いゴドヰスキは汗ばんだ友達の顔を見ながら言つた。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "大船でサンドヰツチを買つた時から、Ｍ君は帳面方を引受けて居て呉れた。",
              "citation": {
                "source": "伊豆の旅",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "停車場からサンドヰツチでも買つて、お午過ぎまで遊んて來ませうよ。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「サンドヰツチ、喰べようか。",
              "citation": {
                "source": "痴日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人とも袋からとり出したサンドヰツチを指先につまんだまゝ空腹も忘れたかのやうであつた。",
              "citation": {
                "source": "山峡の村にて",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「妾、サンドヰツチ持つて行くわ、先生のお部屋で喰べられて――」「掃除しておきませう。",
              "citation": {
                "source": "女に臆病な男",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "さかんに呼んでやがら、不良共が――」　百合子は片手を高くひらひらと伸して、「サンドヰツチをあげるから、あがつておいで……」　と叫んだ。",
              "citation": {
                "source": "まぼろし",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処で、バスケツトを開いて玉子のサンドヰツチを喰べた。",
              "citation": {
                "source": "Ｆ村での春",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツセ・アングレエズ」、「サラド・ルツス」其れからサンドヰツチを油で揚げた様な物で名が解らないから仮に梅原が名を附けた「サンドヰツチ・ムネ・シユリイ」に「タルト」と云ふ菓子。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "七人と云ふのはルドヰコ・バルバリゴ、ニコレ・ヲレダン、アントニオ・ピルミアニ、ジユリオ・ボツタロル、オクタヰオ・ヱルヌツチ、それからレオネルロと己とである。",
              "citation": {
                "source": "復讐",
                "author": "BALTHASAR ALDRAMIN. KURZE LEBENSGESCHICHTE AUS DEM ALTEN VENEDIG.",
                "note": "青空文庫"
              }
            },
            {
              "text": "≪彼の灰色のバルドヰン。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "何でもいい、今一度、灰色のバルドヰン、大外套の亡霊。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "リアや、熱いニィガスを少し拵へて、サンドヰッチを一｜片か二｜片切つて來て下さい。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
