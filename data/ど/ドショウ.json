          "standard": [],
          "literary": [
            {
              "text": "父親の責任を忘れるな、と云わぬばかりの語気が感じられて、平作は思わず気色ばみ、「警察のお力でドショウ骨を叩き直して貰うわけにいきませんかね。",
              "citation": {
                "source": "山の神殺人",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺という男のドショウ骨の強さは、こうだよ。",
              "citation": {
                "source": "胎内",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからバーナードショウに会ったときに、魯迅さんはこういうことをいった。",
              "citation": {
                "source": "魯迅さん",
                "author": "内山完造",
                "note": "青空文庫"
              }
            },
            {
              "text": "バーナードショウのことを、中国人でも日本人でも皮肉家だというが、あれは皮肉家ではない。",
              "citation": {
                "source": "魯迅さん",
                "author": "内山完造",
                "note": "青空文庫"
              }
            },
            {
              "text": "「世紀の楽団」のロードショウ、南部圭之助に会ひ切符貰って入る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
