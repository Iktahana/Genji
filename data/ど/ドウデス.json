          "literary": [
            {
              "text": "ドウデス、婦長さん、スバラシイ話でしょう。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからコチラの法文科で古書を集めておいでになる中江｜学長さんのお宅へ持って参りましたらドウデス。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　長イステツキドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　毛糸ノカタカケドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　十文ノオクツハドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヒルサン、アナタノ洋服ハ一度アラツタラドウデスカ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウデスカ、少シハイヽ方デスカ」「イヽドコロカ、マス／＼悪クナル一方ダ」「ダッテ、髯ナンカ剃ッテサッパリシテルジャアリマセンカ」予ハ実ノトコロ、手ガ痛ムノデ剃刀ヲ使ウノモ不自由ナンダガ、ソレヲ怺エテ今朝剃ッタバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ソウ云ウ訳デ、結果ハ案外ヨカッタト思ウノデスガ、ソノ後弘君ノ様子ニ変ッタ点ガアルカドウデスカ。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎畫伯ガ有ツテモヨカラン」關「デハ、私モ以後、別號ヲ“雲虎”トデモシマスカナ」僕「連想ガワルイ、虎關ハドウデス」關「足下ハ、ナカナカ口ガ惡イ、栖鳳サンノ若イ頃ニ似テイル、髮ノ生エ方マデ似テイル」　筆談には、まゝ栖鳳氏の名が出る。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
