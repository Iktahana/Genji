          "literary": [
            {
              "text": "ソレデ、コノ　ウグヒスハ、オカアサンヲ　ナクシタ　コドモノ　フク、カナシイ　ウグヒスブエノ　オトヲ　キクト、ナクシタ　ボウヤノ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタツムリガ　ツノヲ　フツテルノヲ　ミテ　ヰルト、王サマハ、子ドモノ　ジブン、何ダカ、カタツムリノ　ウタヲ　ヨク　ウタツタ　コトヲ　オモヒダシマシタ。",
              "citation": {
                "source": "カタツムリノ　ウタ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "テフテフガ　ミエナク　ナルト、コドモノ　デンデン蟲ハ、「アレ、ナアニ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナガレボシ新美南吉　フユノ　サムイ　サムイ　ヨフケ、ヒユーン　ヒユーント　コガラシノ　フク　オソラノ　上ノ　ハウデ　三ツ　ナランダ　コドモノ　ホシガ、ケンクワヲ　シマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンノキノ　シタデ　オカアサンノ　タヌキガ　コドモノ　タヌキニ　バケル　コトヲ　ヲシヘテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソレデハ、オテラノ　コゾウサンニ　バケテ　ミヨツト」　コドモノ　タヌキハ　コゾウサンニ　バケテ　ミマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナ　グアヒデ　コドモノ　タヌキハ　ナカナカ　ウマク　バケル　コトハ　デキマセンデシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　コドモノ　タヌキハ　ゲタニ　バケマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "わかってよ、ちゃんと見えるわよ、コドモノクニよ」　玄関に女下駄が揃えてあったので、伸子は木戸から庭へ廻った。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――つや子にコドモノクニを買って行ってやっただけ」　伸子の部屋は、北向きの三畳で、曇硝子の障子が二枚たっていた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オコタヘハ　クワンセイ　ハガキ　デ　コドモノクニ　ヘ　五月十五日マデニ　ハツペウハ　八月号ノ　コドモノクニ裏表紙",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、「コドモノクニね？",
              "citation": {
                "source": "好人物",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがさらに進んでそのまた中間にもなにか食べるのを、中国地方ではハスワ食い、四国ではアイマ食い、九州の各地ではハザ食い、南の島ではマドモノ、中部地方にくるとコバミともコマグチともいう者が多く、近畿地方ではどういうわけでか、これをホウセキともヒズカシともいっていた。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
