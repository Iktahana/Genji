        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「空には今日もアドバルンと来やがらア」　装甲自動車の列。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうら、あすこにアドバルンが上っているだろう」「うん」彼は消え入りそうな声で云った。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "アドバルウンが、月のような色をして昇っている。",
              "citation": {
                "source": "泣虫小僧",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "恋の季節を修飾する早春の枯木や、アドバルーンや、轢死人が彼等の周囲にあって移動した。",
              "citation": {
                "source": "玩具",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代り背中のところで、どてらはアドバルーンのように丸く膨らんでいた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔ソーセージ型のアドバルーンだよ！",
              "citation": {
                "source": "日記",
                "author": "観劇日記（一九二九―一九三〇年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "出版・ラジオ・キネマ・演台（舞台及び演壇）、博覧設備（展覧会・博覧会・ショーウィンドー・スカイサイン・アドバルーン等々）など＊。",
              "citation": {
                "source": "現代哲学講話",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "――それから同じ報道現象でも広告は、色々の斬新新奇な乗具を用いるが（例、アドバルーンの如き）今は言論の表現報道だけに話を限定しよう。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "政治的言論に限らず、文学乃至純文学的表現発表までも含むが併しアドバルーンやチンドン屋は入れないことにするわけである。",
              "citation": {
                "source": "世界の一環としての日本",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は繋留気球を見ていつも思うことだが、アドバルーンというものは上に昇る性能を持っている。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがアドバルーンの独自性であって、それによってアドバルーンの役割を果している。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、上に昇るだけでアドバルーンとして完全であるかというと、そうではない。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "大地に繋がれていないと、アドバルーンとしての役割を完全に果すことができない。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方には、上に昇るという独自の能力があり、同時に他方には、それが大きなものに繋がりを持っているというところに、アドバルーンの存在の意義がある。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ドバルさんが一緒にいらしってよ。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「でもドバルさんはあっちの端よ、どうして聞えるものですか。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして途切れ途切れの声で、「心配するな……俺は怪我はせぬ……だがドバルは？",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドバルは生きているか？",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "レイモンドがも一人の倒れている男を見ると、それは伯爵の信用していた家令のジャン・ドバルであった。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "伯爵は書記のドバルと二人で、たくさんの財産や地面を監督していたのであった。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "この書斎はドバルが殺されてからまだ医者の他何人も入らなかった場所である。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "家令のドバルは平素着ているビロードの服を着、長靴を履いたまま、片手を下にして上向に倒れていた。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私はドバルに起されたのです。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドバルは手燭を持って、ごらんのように昼間の仕度のままで私の寝台の傍に立っていたんです。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともドバルは時々｜夜更しをする癖があったのですがね。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドバルはたいへん気が立っている様子で、小声で「客間に誰か来ている。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めて気がついてみるとドバルがこの通り殺されて倒れていました。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ドバルは人に恨まれているようなことはありませんか。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
