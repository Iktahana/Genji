      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　と馬鹿調子のどら声を放す。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大隊を指揮する、取っておきのどら声で怒なりつけようとした。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうどら声があちらこちらに聞こえた。",
              "citation": {
                "source": "病院風景",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして時々思い出したように、どうしても我慢がならねえ……と言うように、菊枝の眠っている部屋の方へ、太いどら声で呼びかけた。",
              "citation": {
                "source": "緑の芽",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とどら声をあげた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十五六で、白衣の衿の黒いのを着て奥歯に金をつめてどら声でよくしゃべる一人をＡ氏とよんで居た。",
              "citation": {
                "source": "旅へ出て",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "流潮に乗って張りきったもやいの綱を岸でたぐるものがあるらしく、あっというまに舟が石垣にぶつかったかと思うと、頭の上に多人数の跫音が乱れ立って、丹下左膳のどら声が河面を刷いた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "と叫んで四方に散ずると同時に危険を実感したらしい首領軍之助のどら声が、指令一下、葉末の露を振るいおとしてひびき渡った。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "一体……」「しっ」　そのとき、仏天青のうしろから、どら声を張りあげたものがあった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "田代先生は髭のついている口を大きくあけて、男のどら声のような声で、しかし音程は正しく「空も港も夜は更けて」というような単純な歌を教えた。",
              "citation": {
                "source": "藤棚",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊田も気取らない気質で、大豆を奪い合う「豚」という遊びの時なんか「おい、駄目だ駄目だ、ひどいよ」と、どら声をあげて、雪枝の夫にくみついたりした。",
              "citation": {
                "source": "杉子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　少佐のどら声が夕空にひびきわたる。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とだしぬけに、どら声が闇の中から響きました。",
              "citation": {
                "source": "天狗の鼻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きな頭を五分刈りにして、猪首で赭ら顔で、それに大きな鼻、もじゃもじゃした黒い眉毛、胡麻塩の頬髯、ぶくぶく緊りのない肥りよう、軍人独特の太い嗄れ声――こう並べて見ると、このサモイレンコがこの町に来たての人の眼に、どら声の成上り士官といった不快な印象を与えるのは無理もない。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は、それに気がつくと、だしぬけに例のどら声をはりあげて怒鳴った。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　山犬の声に似たどら声がきこえて、彼の周囲が急に明るくなったと思った時には、彼は地べたに横向きにころがっていた。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は、のんきそうにそう言ってから、すぐ、どら声で校歌をうたい出した。",
              "citation": {
                "source": "次郎物語",
                "author": "第三部",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段から下の廊下にかけて、生徒たちは、いつの間にかどっどっと歩調をそろえて歩きながら、どら声をはりあげて校歌をうたい出していた。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大沢の愉快などら声が、そのとき池の向こうからきこえた。",
              "citation": {
                "source": "次郎物語",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "」相川氏が、ものやわらかに答えるのを、怪探偵は、おっかぶせるようにして、どら声をはりあげました。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　中村警部のどら声が、地下道にこだまして、ものすごくひびきました。",
              "citation": {
                "source": "サーカスの怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いまどこにいらっしゃいますの、万三郎さま、どこに、――」つなぎ船一「炭はいらねえか」　妙などら声で叫ぶ。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬車を呼んでください」第三十六章　コニー・カラム　赤帽がどら声で馬車を呼び、荷物を屋根に載せた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちの一言か二言に庭師がうなずき、少し笑って、どら声で言った。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
