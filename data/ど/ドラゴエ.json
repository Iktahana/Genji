[
  {
    "uuid": "0363f869-486d-57df-8316-fd85d539dcf9",
    "entry": "ドラ声",
    "reading": {
      "primary": "どらごえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
