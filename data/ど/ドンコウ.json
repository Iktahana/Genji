        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鈍行列車に揺られ、のんびりと旅を楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "急ぐ旅ではないので、鈍行で景色を眺めながら行こう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "終点まで鈍行で3時間かかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "時間が時間だから、こんな鈍行列車の二等に乗る客は少かった。",
              "citation": {
                "source": "暗号数字",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雪が積ってるよ」　午後八時過ぎ、その線の終点に着き、そこで乗換えて約一時間、鈍行の列車に揺られてから郷里の町の駅におりた。",
              "citation": {
                "source": "ばちあたり",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出発した列車は急行か、それとも鈍行か」　聞けば、列車は鈍行で各駅にとまる。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩原から雇って来た強力殿の足の早いこと、凡そ五、六貫位の重荷であるが、平気でドンドン行く。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後にロンドン行きの汽車があれば、ワトソン、うまく乗れそうだ。",
              "citation": {
                "source": "踊る人形",
                "author": "THE ADVENTURE OF THE DANCING MEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "私のロンドン行は、パリーを見直すために行ったようなものだ。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "お館の西側をグルリと廻わり跡部大炊の邸へ出、それを北へドンドン行くと突き当たったところに小山田邸、ここが条坊の外れである。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロンドン行の切符をアンが買った。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやドンドン行ってしまった……」　この時戸外から部屋の戸を、ドンドン叩く音がした。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "×　松岡氏と良人と自分がアン※リイドの停車場からロダン先生を訪ふ為にムウドン行の汽車に乗つたのは、初めて詩人レニエ先生を訪うた日の午後であつた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子とすればロンドン行きをのばしたこの一週間のうちに、蜂谷にならきけるだろうと思われることを、あれもこれもと持っていたのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "松岡氏と良人と自分がアン※リイドの停車場からロダン先生を訪ふ爲にムウドン行の汽車に乘つたのは、初めて詩人レニエ先生を訪うた日の午後であつた。",
              "citation": {
                "source": "巴里の旅窓より",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしあの土窖にはゾットする何物かがありますね、そして僕は寒気を感じた事を否定はしませんよ」それから彼は大股でステーションの方へドンドン行ってしまった。",
              "citation": {
                "source": "金の十字架の呪い",
                "author": "チェスタートン",
                "note": "青空文庫"
              }
            },
            {
              "text": "手形ぬきの正貨取引で、アパルトマンの裏庭にひきだされ、頭蓋骨に四五径の拳銃弾のブローカー・レージがつくんだ……クロイドン行の一便の座席を予約したが、それをやると、えらいことになる」「手紙ではだめなのか」「三池のことだから、電話にも寄りつけないような状態にしてあるのだろう。",
              "citation": {
                "source": "川波",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "クロイドン行の第一便は八時十五分、トゥルーズ行の第一便は八時二十分だ……賭ける気があるなら、賭けてみろ。",
              "citation": {
                "source": "川波",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "三木さんが第一屯所に来ていられるが、寄らないでドンドン行ってくれ。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三木さんが第一屯所にきていられるが、寄らないでドンドン行ってくれ。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな関係から、ハイドンはサロモンの勧誘を入れてロンドン行を決心し、一七九〇年の暮、ウィーンを出発して翌年正月ロンドンに初見参をした。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "二度目のロンドン行のとき、サロモンから得た二つの聖譚曲の歌詞と、ヘンデルの「救世主」を聴いたときの感激は、ハイドンをして一代の名篇「創造」を作らせる原因になった。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "老召使いにお別れを言って、午後七時五分発ロンドン行き列車に乗ります。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼十二時頃ロンドン行き列車が出るから、召使いを一人つけて軽装二輪馬車で送れ。",
              "citation": {
                "source": "謎の四つ指",
                "author": "The Mystery of the Four Fingers",
                "note": "青空文庫"
              }
            },
            {
              "text": "時計を見れば、ロンドン行き汽車の時間だし、コベントガーデン地区でフィリップスと落ち合う予定だ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "グレイのロンドン行きは全行程を有能な護衛が守っていた。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "清算して、ロンドン行きの切符を買えば、すべて良しだ。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くで列車の警笛が聞こえ、ロンドン行き最終列車が発車した事を知った。",
              "citation": {
                "source": "真劇シリーズ",
                "author": "REAL DRAMAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからにやにや笑うと、自分も茶碗を持ってベッドから飛び降り、チンドン行列に参加した。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
