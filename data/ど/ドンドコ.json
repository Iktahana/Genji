        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "おれの前へ来た一人の芸者が、あんた、なんぞ、唄ひなはれ、と三味線を抱へたから、おれは唄はない、貴様唄つて見ろと云つたら、金や太鼓でねえ、迷子の迷子の三太郎と、どんどこ、どんのちやんちきりん。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "叩いて廻つて逢はれるものならば、わたしなんぞも、金や太鼓でどんどこ、どんのちやんちきりんと叩いて廻つて逢ひたい人がある、と二た息にうたつて、おゝしんどと云つた。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの前へ来た一人の芸者が、あんた、なんぞ、唄いなはれ、と三味線を抱えたから、おれは唄わない、貴様唄ってみろと云ったら、金や太鼓でねえ、迷子の迷子の三太郎と、どんどこ、どんのちゃんちきりん。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "叩いて廻って逢われるものならば、わたしなんぞも、金や太鼓でどんどこ、どんのちゃんちきりんと叩いて廻って逢いたい人がある、と二た息にうたって、おおしんどと云った。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀の子とこどんどこぴいひやらひやあ麦の畑を風がふく。",
              "citation": {
                "source": "どんたく",
                "author": "絵入り小唄集",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのどんどこどんどこと鳴る太鼓の音。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つのたるに一つのたるに、三人はいり、どんどこ、どんどこ、すっどんどん。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "漱石氏が『坊ちゃん』に用いた「鉦や太鼓でねえ、迷子の迷子の三太郎と、どんどこどんのちゃんちきりん……」という唄なども、やはりこの迷子さがしを踏えているようだから、昔はしばしばこういう事件があったものであろう。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときに足踏みならしてたぬきの歌う歌の文句が、「こいさ（今宵の方言）お月夜で、お山踏み（たぶん山見分の役人のことらしい）も来まいぞ」というので、そのあとに、なんとかなんとかで「ドンドコショ」というはやしがつくのである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "底のドン底のドンドコドンまで。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "藁塚産業課長の膝詰談判が、今度は「内地モンロー主義」にぶつかっていた事実を、ドンドコドンまで気付かずにいたのだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも何かと言うと私の知恵袋にしておったアンタを、直接に松倉｜様に引合わせて、私とも膝をば突合わせたなら、三人寄れば何とやら、よい知恵が出まいとも限らぬ……と言う私の一生涯の知恵を絞ったドンドコドンのドン詰めの思い付きじゃが、ドウかいな。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "雀の子トコ　ドンドコ　ピイ　ヒヤラヒヤア麦の上をば風が吹く。",
              "citation": {
                "source": "桜さく島",
                "author": "春のかはたれ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーン、ドーン、ドンドコドン、ドーン、ドーン……　太鼓の音がするようだ。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーン、ドーン、ドンドコドン、ドーン、ドーン……　かすかに、八幡様の方では太鼓が鳴っていた。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンドコ、ドンドコ、ドーン、ドーン……太鼓の音がまだ聞えていた。",
              "citation": {
                "source": "田園の幻",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンドン、ドンドコドンドン」　辻へ箱を下し、人をあつめて、皿まわし、タマの使い分け、虫の鳴きマネ、などをやってみせる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "兆青流開祖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
