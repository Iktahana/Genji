        "examples": {
          "standard": [
            {
              "text": "ドルイド教は自然を崇拝する宗教で、古代ケルト文化と深く結びついている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ドルイド教の儀式は、現代のニューエイジ運動にも影響を与えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はドルイド教の歴史と哲学に強い関心を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どの家のえんとつからも、貧乏なお百姓さんの家の、ちっぽけなえんとつからさえも、ちょうど、ドルイド教徒のさいだんからのぼる煙のように、かんしゃをこめた、ささげものの煙が、うす青く立ちのぼりました。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "その国のドルイド教の僧輩反抗もっとも烈しかったので尊者やむをえずその沃野を詛うてたちまち荒れた沼となし川を詛うて魚を生ぜざらしめ缶子を詛うていくら火を多く焼いても沸かざらしめ、ついにかの僧輩を詛うて地中に陥り没せしめた。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
