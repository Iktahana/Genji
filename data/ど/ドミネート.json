        "examples": {
          "standard": [
            {
              "text": "彼は圧倒的なフィジカルを活かして、ゴール下のエリアを完全にドミネートした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "新興企業が独自の技術で市場をドミネートし、既存のメーカーを窮地に追い込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "チェスの試合で、彼女は序盤から盤面をドミネートして相手に隙を与えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてしだいに性欲がプレドミネートするに従って愛は退く。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フーシェという冷血な裏切り者、奸策という風にしか明察も明敏も作用しない男を、裏切る情熱しか知らない、謂わばプレドミネートした力に支配される人間という、観念的なみかたをして居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            }
          ]
        }
