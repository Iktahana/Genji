      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "same ward",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私の住むマンションは、彼が経営する会社と同区にある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "市長は、同区の住民を対象とした説明会を開催した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "隣のビルには、同区の図書館が入っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "」「やはり同区内で、芝の片門前にいるとかいうことでした。",
              "citation": {
                "source": "穴",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正二年には保が七月十二日に麻布西町十五番地に、八月二十八日に同区｜本村町八番地に移った。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "都下の樹木にして以上の外なお有名なるは青山練兵場内のナンジャモンジャの木、本郷西片町阿部伯爵家の椎、同区｜弓町の大樟、芝三田蜂須賀侯爵邸の椎なぞがある。",
              "citation": {
                "source": "日和下駄",
                "author": "一名　東京散策記",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが同区役所最古の戸籍簿だという事である。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "同区内否同町内においてすら、甲店と乙店とは同じ品物の価に非常な差違のあることを発見する。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "東国ではこれを名処などといい、その著名なものだけは同区の者も知っていた。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいいち、めんどうくさくなくていい。",
              "citation": {
                "source": "多頭蛇哲学",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……めんどうくせえ、モーやめた。",
              "citation": {
                "source": "号外",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス人は理屈を詰めて行くのをめんどうくさがって「かん」の翼で飛んで行くのである。",
              "citation": {
                "source": "映画雑感（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いちいち貯金なんて、めんどうくさい」　成る程と思い、私は黙ってうなずきました。",
              "citation": {
                "source": "トカトントン",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この「青んぼ」という雑誌については、いろいろと、なつかしく、また噴き出すような思い出が、あるのですけれど、きょうは、なんだか、めんどうくさく、この三番目の兄が、なくなった頃の話をして、それでおわかれ致したく思います。",
              "citation": {
                "source": "兄たち",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "市ヶ谷の女学校へはいってすぐ、芹川さんというお友達が出来ましたけれど、その当時はそれでも、芹川さんに優しく叮嚀につき合っているつもりでいたのですが、これも、いま考えてみると、やっぱり私は、ひどく思いあがって、めんどうくさいけれど親切にしてあげるというような態度も、はたから見ると在ったかも知れません。",
              "citation": {
                "source": "誰も知らぬ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもその朝は、仕事が気になって、衣服の事などめんどうくさく、何も言わずにさっさと着て朝ごはんも食べずに仕事をはじめた。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "めんどうくさいからしないだけ。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服を脱ぐのもめんどうくさいらしい。",
              "citation": {
                "source": "疲労",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ところがその養育院というやつは、めんどうくさくってなかなかはいられないという事だぜ。",
              "citation": {
                "source": "窮死",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついでに導線の接合をすっかりハンダで付けさせようと思ったが前の電気屋はとうの昔どこかへ引っ越していなくなったし、別のに頼んでみるとめんどうくさがって、そしてハンダ付けなど必要はないと言ってなかなかやってはくれない。",
              "citation": {
                "source": "断水の日",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりよく睡るので死んではいないかと思って、小さな声で「ポチや」というとポチはめんどうくさそうに目を開いた。",
              "citation": {
                "source": "火事とポチ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "王子はめんどうくさくなったので剣をぬいていきなり小藪をばらんと切ってしまいました。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネリを連れて行ったあの男は、三日ばかりの後、めんどうくさくなったのか、ある小さな牧場の近くへネリを残して、どこかへ行ってしまったのでした。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "門松や輪飾りはめんどうくさいから止めにして、裏山から歯朶を五六本折ってきて瓶に挿した。",
              "citation": {
                "source": "雑記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、めんどうくさいんです。",
              "citation": {
                "source": "新ハムレット",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まったく、肉親の者にまで、他人行儀のめんどうくさい挨拶をしなければならんとなると、男は仕事も何も出来やしない。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうも、僕には、描写が、うまくできんので、――いや、できんこともないが、きょうは、少しめんどうくさい。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の者に聞かせたくない話題なども、ひょいと出るかも知れぬし、それに、酒は勿論、酒の肴も、用意が無いので、つい、めんどうくさく、外へ出てしまうのである。",
              "citation": {
                "source": "酒ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　どうも私は駈引きという事がきらいで、いや、駈引きしたいと思っても、めんどうくさくて、とても出来ないたちですので、ちょっと気まずくても、ありのままを言う事にしているのです。",
              "citation": {
                "source": "嘘",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "めんどうくさいが、これは書き改めよう。",
              "citation": {
                "source": "猿面冠者",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙管は、めんどうくさいだろう」　と私が言うと、彼は私のほうを見て、にやりと笑い、煙草入れをしまい込み、いかにも自慢そうに、「われわれ百姓は、こんなものを持っているのだよ。",
              "citation": {
                "source": "親友交歓",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "礼儀だの何だの、めんどうくさい事はきらいなのだ。",
              "citation": {
                "source": "親友交歓",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "めんどうくさい食べものには、見向きもしない。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
