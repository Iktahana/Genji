[
  {
    "uuid": "d522a12c-d355-5a09-ba71-2d847efc2f19",
    "entry": "同区",
    "reading": {
      "primary": "どうく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
