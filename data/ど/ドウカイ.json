    "definitions": [
      {
        "index": 1,
        "gloss": "Hokkaido Legislative Assembly",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
