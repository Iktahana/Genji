        "examples": {
          "standard": [
            {
              "text": "文化祭の展示として、全校生徒で体育館いっぱいにドミノ倒しの仕掛けを作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "準備に十時間かけたドミノ倒しが、最後の一枚まで綺麗に倒れた瞬間、歓声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "うっかり袖が触れただけで、並べていたプラモデルがドミノ倒しになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そしてこの事実を発見した瞬間に、オレの心の中で六〇年代のドツボに向けて、魂のドミノ倒しが雪崩を打ちはじめた。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
