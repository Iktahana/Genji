          "standard": [
            {
              "text": "若者がドラッグに手を出さないよう、啓発活動が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "密売人からドラッグを購入しようとした男が逮捕された。",
              "citation": {
