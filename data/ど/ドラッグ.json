        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女は週末にドラッグクイーンとしてステージに立っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "友人の誕生日パーティーで、みんなでドラッグのメイクをして楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼はイベントで初めてドラッグに挑戦し、周りを驚かせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
