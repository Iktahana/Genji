  {
    "uuid": "b84ce6b4-a6af-5c8d-9bc9-c67adc3d4f06",
    "entry": "ドウシタ",
    "reading": {
      "primary": "どうした",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
