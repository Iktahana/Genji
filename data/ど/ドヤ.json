[
  {
    "uuid": "dc1379dd-3bbb-5277-8719-842332016bf4",
    "entry": "どや",
    "reading": {
      "primary": "どや",
      "alternatives": [
        "ドヤ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
