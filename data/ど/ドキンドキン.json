        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "と思ったら急に心細いやら、おそろしいやら、胸がどきんどきんして来た。",
              "citation": {
                "source": "故郷",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸が、どきんどきんと騒ぎ立ち、いても立っても居られぬのだ。",
              "citation": {
                "source": "酒ぎらい",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "傍へ来られると、坂田はどきんどきんと胸が高まって、郵便局の貯金をすっかりおろしていることなど、忘れたかった。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども心の中は駈けっこをしている時見たいにどきんどきんしていて、うまく口がきけなかった。",
              "citation": {
                "source": "碁石を呑んだ八っちゃん",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "みぞおちのとこがどきんどきんするわ。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "このような種類の推測を何べんもやり、そしてみんな間違ったあげく、この事実――私がかならず見込み違いをしたというその事実――が私にある一つながりの考えを思いつかせ、そのために手足はふたたびぶるぶる震え、心臓はもう一度どきんどきんと強く打ちました。",
              "citation": {
                "source": "メールストロムの旋渦",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は唇がからからにかわいて、心臓がどきんどきんと鼓動し、唇に唾がひからびつくのを感じた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああびっくりした」　ようやくゆるんだ帯から首をはずしてほっとしたが、腋の下や背筋には冷たい汗が出てどきんどきんと心臓が激しかった。",
              "citation": {
                "source": "いのちの初夜",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔が真蒼になり、胸がどきんどきんと鳴つた。",
              "citation": {
                "source": "道化芝居",
                "author": "北條民雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の胸は、憤りのために、どきんどきんと鳴りだしました。",
              "citation": {
                "source": "僕はこれからだ",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは仕切りの簾の向うに派手な模様がチラチラして、ハンカチで汗をおさえながらすわってはるらしい姿見ると、もうまた胸がどきんどきんいうて来ましたが、光子さんの方でも簾越しにこっち見てなさって、這入って行くのん待ち構えたように、「今日は」いうてニコニコ笑いなさるのんです。",
              "citation": {
                "source": "卍（まんじ）",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おらあはらが煮えくりかえって、はっ倒してくれようかと思ったがあのあまのこった、長屋じゅうの騒ぎになるからとびだして来た、みてくれ、まだここんとこがどきんどきんと鳴ってるから」　彼は着物の衿をひろげ、黒い毛のみっしり生えた胸をひたひたと叩いた。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相場が当った……とか何とか云っているがヒョッとすると……そう思うと吾輩の胸が又も、別の意味でドキンドキンとした。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その扉を見上げ、見下しているうちに虎蔵は又も、ドキンドキンとさせられた。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "心臓がドキンドキンと空に躍りまわっているのに、額は冷めたく濡れている。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……吾輩、思わずゾッとして胸がドキンドキンとしたもんだよ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の心臓が二度ばかりドキンドキンとした。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな事を考えまわしているうちに私は、何かしら、ドキンドキンとするような、気味のわるい予感に襲われたように思う。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "犯人が出て行った方向を拝みましたのは、そうすると遠くに居る犯人が何となくドキンドキンとして思わぬ失策を仕出かすという迷信が、外国の芝居に使ってありましたのでツイ、あんな事を致しまして……と真赤になって弁解しておった。",
              "citation": {
                "source": "二重心臓",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "辞世というものはコンナ風にして出来るものかも知れないと思うと思わず胸がドキンドキンとした。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までの不思議さと不安さの全部を、一時に胸の中でドキンドキンと蘇らせながら……。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うトタンに胸がドキンドキンとする。",
              "citation": {
                "source": "書けない探偵小説",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は固くなってドキンドキンと胸を躍らせながら……。",
              "citation": {
                "source": "けむりを吐かぬ煙突",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "取りあえずドキンドキンと心臓の鼓動を高めながら、二三歩ゆるゆると後じさりをした。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼も眩むほど胸がドキンドキンとした。",
              "citation": {
                "source": "笑う唖女",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそこにあった座布団を二つに折ると××××（以下略）　龍介はきゅうに心臓がドキンドキンと打つのを感じた。",
              "citation": {
                "source": "雪の夜",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ、そのしなやかな細かい細胞をながれてうるおして居る色のない血液のそのくっくっと云って居る鼓動と私の赤い、あったかい同じような細胞全体をうるおしてる血液の鼓動とがピッタリと一つもののようにしずかにドキンドキンと波うって居るのを感じた。",
              "citation": {
                "source": "つぼみ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟君、いくら美くしいと云っても人なみの心地と、若さにその若さをほてる様にドキンドキンと波うつあつい血しおを持って居た。",
              "citation": {
                "source": "錦木",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸をドキンドキンさせながら、恐々扉を開けてみたの。",
              "citation": {
                "source": "ニッケルの文鎮",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸の中は空っぽになってわくわくと込み上げる様になる――遂、堪らなくなって、ハアーと大きく息を吸うと胸の中の汚いものがすっかり嘔き出されたようにすがすがしい気持になって、虐げられた心臓は嬉しそうに生れ変ったような新らしい力でドキンドキンと動き出す。",
              "citation": {
                "source": "息を止める男",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
