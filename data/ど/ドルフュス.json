          "standard": [],
          "literary": [
            {
              "text": "ブルージェが「愛」だの「死」だのという観念ぽい題の故もあって今の日本で大いによまれているのは妙なことです、ドルフュスのときブルージェは大きい虚偽の側に立った恥を知らない男です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドルフュスのとき、ゾラがロンドンへ行ったりしているときセザンヌは、あいつは相変らず気ちがいだと云って田舎に引こんでいました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドルフュスの時など）が歴史との関係でマイナスばかりではなかったことをわからなかったセザンヌは、やはり同時代人としての眼かくしをかけていたのですね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
