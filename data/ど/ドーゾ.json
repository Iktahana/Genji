        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ボーイが御茶を上げましょと云うて来たから室へはいると、前の商人はあわてて席を譲って「ドーゾコチラヘ」と言う。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐわきに立っている伸子や素子の姿を認め、「到頭、来てくれましたね、サア、ドーゾ」　サア、ドーゾと日本語で云って、四人を内廊下へ案内した。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし口に発したのはただ「ドーゾやってくれたまえ」と繰返すのみであった。",
              "citation": {
                "source": "平民道",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーゾ、十円の金を墓場へ埋めてもらいたい。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
