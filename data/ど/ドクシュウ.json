    "definitions": [
      {
        "index": 1,
        "gloss": "self-study",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は塾に通うこともなく、市販の参考書だけを頼りにフランス語を独習した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "独習でプログラミングの基礎を身につけ、今ではフリーランスのエンジニアだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "独習でも迷わないように、学習スケジュールが細かく組まれたテキストを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "もっともだれに教わるのでもなく全くの独習で、ただ教則本のようなものを相手にして、ともかくも音を出すまねをしていたに過ぎなかった。",
              "citation": {
                "source": "二十四年前",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ私がヴァイオリンを独習している事を話した時に、ケーベルさんは私のもっている楽器の値段を聞いた。",
              "citation": {
                "source": "二十四年前",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから十年の後高等学校在学中に熊本の通町の古本屋で仏語読本に鉛筆ですきまなしにかなの書き入れをしたのを見つけて来て独習をはじめた。",
              "citation": {
                "source": "読書の今昔",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "お茶の席に於いて大いなるへまを演じ、先生に叱咤せられたりなどする事のないように、細心に独習｜研鑽して置かなければならぬ。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は懐石料理の作法に就いての勉強はいい加減にして、薄茶のいただき方だけを念いりに独習して置いた。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの芸と音楽は少し性質が変わっていて、多く聞き、多くの人と合わせてもらうことでずっと進歩するものですが、独習をしていて、その域に達したというのは珍しいことです」　こんな話もしたが、大臣は宮にお弾きになることをお奨めした。",
              "citation": {
                "source": "源氏物語",
                "author": "乙女",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵画の方でも一つの例として独習者画家団と云うのがあるが、主として職場の若い男女だ。",
              "citation": {
                "source": "ソヴェト「劇場労働青年」",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "独習者の新鮮、真面目な努力で、どんなに若いゴーリキイが、この科学の克服に熱中したかということは想像される。",
              "citation": {
                "source": "マクシム・ゴーリキイの発展の特質",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "独習者である自分に対しては学生達が「かなり厳格な態度」をとる。",
              "citation": {
                "source": "マクシム・ゴーリキイの伝記",
                "author": "――幼年時代・少年時代・青年時代――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の叔父は、彼が小学校に通学するころには、日々その下読みと復習を手伝い、のち彼が弁護士を志して法律学の独習を始むるや、彼の叔父は、多少なりとも指導助力に役立たばやと思う一念より、寄る年波をも顧みず、おのれもまた始めて法律学の研究に志し、同じ燈火の下にその甥とともに苦学したものである。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお最近読んだ書物の中に「菅原直之助、独習をもって刺繍に長じたる人にして狩野芳崖の『悲母観音』の繍は原画の傑出せると共に有名なり」とあるけれども、これが何処に蔵されているかは明らかにされて居ない。",
              "citation": {
                "source": "※女抄録",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年の頃から日本潜入の夢をいだいて、コームで日本の古い書物を見つけ、その時から日本語の独習を始めた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "天正年間宣教師によつて印刷術が伝へられて天草学林で刊行したが、その中には外人教師の日本語独習のために和洋両様に印刷したもの、又辞書なども有つたのである。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間ラボーチャヤ・モスク※にあった独習画家展の方ずっと面白し。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｙ、買って来たドイツ語独習書を bed の上で大きな声出してよんであそんでる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうことが十八世紀に起ったのは、ふしぎとおもわれるかもしれないが、ジュネーヴの学校できまりきった教育の課程を踏んでいるあいだにも、自分の好きな勉強に関するかぎりは、大いに独習した。",
              "citation": {
                "source": "フランケンシュタイン",
                "author": "FRANKENSTEIN, OR THE MODERN PROMETHEUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは全く先生なしに独習をやっていたのでありました。",
              "citation": {
                "source": "能書を語る",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして両親が早く亡くなり、むずかしくいって私に干渉する人が無かったので、私は自由自在の思う通りに植物学を独習し続けて、遂に今日に及んでいるのです。",
              "citation": {
                "source": "牧野富太郎自叙伝",
                "author": "第二部　混混録",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろその当時の熊本だから、勿論良い本も何もないので、仏語独習なんていう良い加減な本を古本屋から漁ってきて一人でコツコツ始めたものです。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "独習さ」「全く天才だね」「独習なら天才と限った事もなかろう」と寒月君はつんとする。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そりゃ、どうでもいいが、どう云う風に独習したのかちょっと聞かしたまえ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなところで君がヴァイオリンを独習したのは見上げたものだ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士はこの論文を読むために、独習書によってイタリー語の勉強を始めた。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は「和蘭語四週間」によってオランダ語を独習してこの記録を読んだ、そして英生に関する数十項の重要記事を写しとったのである。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の通り耳学問やわずかな独習で我慢しなければならない。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そりやハーカーさんならきつと伯母さんのためにホーンパイプを踊つてくださるわね……そして独習書を見て半時間で覚えたのだと言うでしようよ。",
              "citation": {
                "source": "緑色の人",
                "author": "THE GREEN MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまり、そのフィリップという男は、憂鬱症の気味のある、いわば独習哲学者で、みんなのことばをかりていうと、『本に読まれた』んだそうです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつも夜の四つ時すなわち午後十時には店員たちと共に眠りにつき午前三時頃に眼を覚まして三味線を抱えて物干台に出るそうして冷たい夜気に触れつつ独習を続け東が仄かに白み初める刻限に至って再び寝床に帰るのである春琴の母が聞いたのはそれであった。",
              "citation": {
                "source": "春琴抄",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし聴こうと云い出したからはいかに辞退しても許すはずのない春琴である上に母親や姉妹たちも好奇心に駆られているのでついに奥の間へ呼び出され独習の結果を披露することになったのである彼に取ってはまことに晴れの場面であった。",
              "citation": {
                "source": "春琴抄",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "著者等は親しく學生諸子に接し、教場以外獨習の助けとなるべきものゝ要求を知れり、是れ本叢書刊行の企ある所以にして、其冊子の小なるも諸子が携帶の便を計りたればなり。",
              "citation": {
                "source": "アーサー王物語",
                "author": "KING ARTHUR'S ROUND TABLE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
