[
  {
    "uuid": "14e7ccfc-8a2b-5c1a-a63e-2139f91c5c89",
    "entry": "どんな",
    "reading": {
      "primary": "どんな",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "連体詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "what kind of",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今週末は、どんな映画を見に行く？」と友人に尋ねた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この料理には、どんなスパイスが合いますか？",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "将来、どんな仕事に就きたいか、まだ決まっていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "況や、どんな観念が大切だなぞとは猶更云つてゐるのではない。",
              "citation": {
                "source": "作家と孤独",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は此の後詩が点睛を得るためには、どんなことが必要であらうかといふことを、考へてみることにしたいと思ふ。",
              "citation": {
                "source": "詩壇への願ひ",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分だけでどんなに立派にやれても、根だけはないのだ。",
              "citation": {
                "source": "詩壇への願ひ",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなわけで私は今どんな断定的な態度をもとることは出来ない。",
              "citation": {
                "source": "新短歌に就いて",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の出した本にどんな本があるかも知らないが、リヴィエールのランボオ論とモオリヤックのイエス伝――結局彼の死の前年に出した此の二つの翻訳書だけが私の頭に残つてゐる。",
              "citation": {
                "source": "逝ける辻野君",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女には実以てどんな技術もなかつた。",
              "citation": {
                "source": "デボルド―※ルモオル",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今、件の青年をＡとし、相手の青年をＢとするとして、二人の交游がどんな有様を呈するであらうか、以下そのことを誌してみたい。",
              "citation": {
                "source": "心理的と個性的",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨、象のことを知らないで、象の部分を知つたことを以て、何かおぼろに感じた象のことを言表はさうとするやどんなことになるであらうか？",
              "citation": {
                "source": "撫でられた象",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "今仮りに某が、興味を以て是々の文学書を読んだり、是々の作品を物したりして暮してゐるとして、其処へもつてきて「陽気な文学を」、なんて声がして来たらどんなものだらう。",
              "citation": {
                "source": "文学に関係のない文学者",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "電車の中で、私はそれを読み出しながら、さてどんな相談したい事等あることかと、その方のことが思ひ出されるのであつた。",
              "citation": {
                "source": "その一週間",
                "author": "――不真面目なわが心……",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハテどんな奴ぢややら……。",
              "citation": {
                "source": "引越し",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたどんなにして名前なんかを考へ出すの、あたしの一寸知つてる人はね、男だつたら自分の学校友達なんかゝら、女のだつたら恋人や恋人のお友達の名を色んなにモヂて作るんですつて。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　ぢやあなたは、顔で言つたらどんな風なのがお好き？",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　コーカサス型つて、ぢやどんなの？",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あたしがどんなに退屈御存知ないの？",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや食つたのかも知れないけど、どんな身か覚えてゐないんだ。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "大体何か充ち足りた心なり環境なりがないからだ、といふやうに癇癪まぎれに思つてみることもあるが、仮りにどんな環境が降つて湧いたつて、その変化の当座こそ充ち足りた気持を招来しもこそすれ、慣れてしまへばやつぱりそれなりに暗い時が来るなら来ようといふ風にしか思へないんだ。",
              "citation": {
                "source": "私の事",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し人生には、どんな荒んだ社会にも猶小唄があるやうに、詩人といふものは在るものなのである。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、室生の創造した新らしい詩が、どんなに深く私を感動せしめたことであらう、私は日夜に彼の詩篇を愛吟して手ばなすこともできなかつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この道をも私は通る」以下の詩、及び淫売婦に贈つた数篇の詩篇をよむものは、どんなに長い間、彼が霊的に苦しんで居たか、そして今の彼がどんなに健全で高潔な愛の信仰の上に立つて居るかを知るであらう。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな方面から見ても彼は思想の人ではない。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "上陸当初の日に一瞥して嘔吐を催し、現代日本の醜悪面を代表する都会と罵り、世界のどんな汚い俗悪の都市より、もっと殺風景で非芸術的な都市と評した東京は、彼が死んでも住みたくない所であった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "早ク見タイモノデス』という焼津の手紙でも解るように、妻と同伴することなしには、どんな旅行も楽しくないほど、夫人を熱愛していたからだった。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならそれは、どんな貞淑に行き届いた妻の奉仕も、決して慰めることのできないものであったからだ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそもこの「理智の人」であり、洗煉された「禮節の人」である――として一般に知られてゐる――人物の内臟には、どんな不思議な情熱が火を噴いてるのか。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに自分が、アナアキスチックの自由に憧憬してゐるか。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がどんな生意氣を言ひ、屁理窟をこね、憎々しく突つかかつて行く場合にも、彼は寛大に情意を理解し、決して腹を立てることがなかつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生前だれが――どんな彼の親友が――この傷ましい英雄を彼に見たか？",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真暗いので、どんなに助かるかわからない。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "no matter what (kind of)",
        "register": "standard",
