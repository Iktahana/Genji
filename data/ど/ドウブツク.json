        "examples": {
          "standard": [
            {
              "text": "生物の分布を研究する上で、「動物区」の概念は不可欠である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "アフリカの「動物区」には、ユニークな進化を遂げた多くの固有種が生息している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「この地域は、独特の動物区に属しているため、珍しい生物が見られる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "西雲南の、東経百度の線と北回帰線のまじわる辺り、そこだけ周囲とかけはなれた動物区をいとなんでいる、いわゆる察緬小地区の盆地だ。",
              "citation": {
                "source": "人外魔境",
                "author": "天母峰",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はどんなに屡々最下層にある地球脊椎動物区画で、様々な回転と押しとを交えた手の込んだその手順をやり通してきたことだろう！",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
