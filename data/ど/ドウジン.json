  {
    "uuid": "1093c31c-c379-51f6-9371-6267b60dd062",
    "entry": "同人",
    "reading": {
      "primary": "どうじん",
      "alternatives": [
        "どうにん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "same person",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会議の席で、彼と同人が全く同じ意見を述べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その事件の犯人は、先日逮捕された容疑者と同人であった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女が探している人物は、私が以前会ったことのある同人だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その夜我々は新しく始める同人雑誌の相談で、同人二十人ばかりで其処へ集つてゐた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "同人中の谷丹三が牧野さんを知つてゐたので、その夜来て貰ふやう頼んでおいたのであつた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二※月くらゐして、やつぱりその同人の集りのあとで、谷君他三人ばかりが、円タクの中からオイデオイデをするから行つてみると、これから牧野さんを誘ひ出しに行くから乗れといふのである。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度その頃、雜誌「驢馬」の同人を主とし、室生、芥川の二君を賓とするパイプの會が上野にあつた。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが不運にして芥川君は出席されず、歸途に驢馬同人の諸君に向つて、大いに私の論旨を演説した。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和四年同人雑誌「白痴群」を出す。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "昭和八年五月、偶然のことより文芸雑誌「紀元」同人となる。",
              "citation": {
                "source": "我が詩観",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時僕は詩を作り、初めて文壇的に出發したので、二三の友人と共に同人雜誌を發行して居た。",
              "citation": {
                "source": "初めてドストイェフスキイを讀んだ頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは「感情」といふ名前の雜誌で、同人には室生犀星、山村暮鳥等の詩人が居た。",
              "citation": {
                "source": "初めてドストイェフスキイを讀んだ頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五、六年まへにその人は小さい同人雜誌にいい小説を一篇發表しました。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "惠送された同人雜誌も、全部讀破しました。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、この雜誌（文學者）の同人では無い。",
              "citation": {
                "source": "義務",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、將來、同人にしてもらふつもりも無い。",
              "citation": {
                "source": "義務",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "同人の大半は、私の知らぬ人ばかりである。",
              "citation": {
                "source": "義務",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "同人諸先輩に、媚びる心も無かつた。",
              "citation": {
                "source": "義務",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この辺で高頭君は、歩度測量計を失くしてしまい、私たち一同人夫と共に、附近の偃松を捜索したが、見当らずにしまった（後にこの歩度メートルは、登山家某君に発見せられて、上高地温泉宿に委托せられ、無事に持主の手に戻った）。",
              "citation": {
                "source": "槍ヶ岳第三回登山",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に逢った場合と同じように無帽で、同じような五、六歳くらいと思われる男の子を背負っているが、どうも男の顔形にははっきりした見覚えはないので、前に自分の逢ったのと同人であるかどうか、何しろ暗いのでよくは分からない。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾が新仏教の同人諸君、願わくは大いに諸君の家庭を語れ、予先ず諸君に先じて、吾がボロ家庭を語って見よう。",
              "citation": {
                "source": "家庭小言",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾輩は茲で、アラヽギ諸同人に忠告を試みたい、我諸同人の歌は、概して形式を重じ過ぎた粉飾の過ぎた弊が多いやうであるから、石川君の歌などの、とんと形式に拘泥しない、粉飾の少しもないやうな歌風を見て、自己省察の料に供すべきである。",
              "citation": {
                "source": "『悲しき玩具』を読む",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "石井氏の「二科同人群像」には単なる似顔の集成でなく、各メンバーの排置のみならずそのポーズや服装によって各自の個性を表現しようという苦心の痕が覗われる。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく、このような同人群像を試みるとしてはおそらく最も適任な石井氏が更に研究を重ねてこの絵の完成に勉められることを希望する。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕達三高卒業生の據つてゐた同人雜誌であつた。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "チエホフの　「熊」　　　　　　一幕シングの　　「鑄掛屋の結婚」　一幕山本有三の　「海彦山彦」　　　一幕「熊」の老僕にはあとで「青空」の同人になつた小林馨がなつた。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同人はその劇研究會の中谷、外村、小林、それに私、そこへ中谷が獨文科の忽那吉之助を連れて來て五人、も一人それも中谷の友人で今鏘々とした新進歌人の稻森宗太郎が早稻田から加はつた。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時同人雜誌はまだ實に少ないものであつた。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思へばその時分が同人雜誌氾濫のはじまりであつた。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほかにも同人を擧げなければ「青空」についての全體は語られないが、まとまつて「青空」のことを書く積りでもなし、管々しいことは省く。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく「青空」は昨年の七月同人の多くが卒業論文で忙しくなり編輯をやめるまで月々撓みなく發行されてゐた。",
              "citation": {
                "source": "『青空』のことなど",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
