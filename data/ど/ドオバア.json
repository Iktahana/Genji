        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（六月二十四日）海峡の船（晶子）　よく荒れる処だと聞いて居た英仏海峡を夜の一｜時に仏蘭西のカレエ港からドオバアの港へ渡る事に成つた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "良人が甲板から降りて来てドオバアへ着いたと知らせて呉れた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブリユツセル　ドオバアからオスタンド迄の海上三時間は少し許り波の立つのを感じた。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノッチンガム卿は、急拠グレエヴセンドに、ゴバム卿はドオバアに、それぞれ赴いた。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
