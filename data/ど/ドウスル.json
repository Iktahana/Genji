        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今日の映画女優やレビュー・ガールの支持者に対しては、ファンという外来語をあたえられているが、その当時の娘義太夫支持者に対しては、ドウスル連という名称があたえられていた。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その名称の由来は、義太夫のサワリの糸に連れて、ドウスルドウスルと奇声を発して拍手喝采するからである。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "堂摺連には学生が多かったから、今日は社会的に相当の地位を占めている実業家や政治家や学者のうちにも、かつてドウスルに憂き身をやつした経歴の所有者を少なからず見いだすであろう。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "碧眼玉をギョロ付かした乗客が、吾れも吾れもと船長室へ押しかけて、土気色になった船長を取巻いて、ドウスルドウスルと小突きまわす。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "不法監禁だぞ畜生……ドウスルカ見ろ……龍代の阿魔……。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ましてや私の如きただの応援隊、文壇のドウスル連というようなものは最高文学に対する理解があるはずがなかった。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "言換えると二葉亭は周囲のもの一切が不満であるよりはこの不満をドウスル事も出来ないのが毎日の堪えざる苦痛であって、この苦痛を紛らすための方法を求めるに常に焦って悶えていた。",
              "citation": {
                "source": "二葉亭四迷",
                "author": "――遺稿を整理して――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モシオ前ノ友ダチガウッカリシテイテオ前ノ足ヲ踏ンダラオ前ハドウスルカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "問　然ラバ、清三ガオキタラドウスル積リダッタカ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高座に渇仰の的が姿を現わすと、神妙に静まりかえって、邪魔にならぬほどのよい機を見て、語り物の乗りにあわせて、下足札で拍子をとり、ドウスル、ドウスルと連発する。",
              "citation": {
                "source": "竹本綾之助",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "古い流行のひとつとして、以前女義太夫――ことに綾之助の若盛りにはドウスル連というものの盛んであったことをきいた。",
              "citation": {
                "source": "豊竹呂昇",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンノオ父サン、オ母サン、オ姉サン、オ兄サンハビツクリシマシタガ、ドウスルコトモデキマセンデシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ若サデソンナ意気地ノナイコトデドウスル」「陸子ハ嫁ニ行ッテカラ今マデ一度モコンナ話ヲ持ッテ来タコトハアリマセン。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "附ケ目ニ乗ジテドウスルト云ウ資格モ実力モナイケレドモ、安心シテ美人ノ傍ニ寄ルコトハ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ノイナイ夜ハドウスルカト云ウト、婆サンガ代リニ佐々木ノベッドニ寝ルコトニシテアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "君ハソンナモノヲ担ギ込マセテドウスルンダ」予ハ婆サンノイナイ所デハ、颯子ノコトヲ「オ前」ト呼ンダリ「君」ト呼ンダリスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダガ要スルニ今デハ愛シテイナイノネ」「君ニ愛人ガ出来タトシタラドウスル？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄席がすきで、芝居がすきで、娘義太夫のドウスル連で、むろん遊びも大好きで、そこらあたりに一ぱいいた道楽息子の一人にすぎない。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウスル、ドウスル……」　ファンは、ここぞとばかり親不孝声を振りしぼって、下足の札で伴奏を入れる。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
