[
  {
    "uuid": "ba478641-b346-58d1-a48b-e9181de7c82d",
    "entry": "どんぐり眼",
    "reading": {
      "primary": "どんぐりまなこ",
      "alternatives": [
        "ドングリまなこ"
      ],
      "is_heteronym": true
    },
    "grammar": {
