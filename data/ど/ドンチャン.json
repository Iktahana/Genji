        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "好きな娘さん達は、あのどんちゃんどんちゃんが聞えては内にじっとしてはいられませんそうで」　爺いさんの話は、つい娘自慢になりたがるのである。",
              "citation": {
                "source": "雁",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はただ声だけ聞こえる、どんちゃんどんちゃん遠くからはやしている。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために佐竹の原はたちまちにまた衰微れてしまって、これから一賑わいという出鼻を敲かれて二度と起ち上がることの出来ないような有様になり、春頃のどんちゃん賑やかだった景気も一と盛り、この大嵐が元で自滅するよりほかなくなったのでありました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "大仏の末路のあわれなはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわんやわたしの側にいた紳士はハーハー息をはずませて肥えた身体を持てあましていた、舞台の上のどんちゃん、どんちゃんの囃や、紅や緑のまぶしいキラめき。",
              "citation": {
                "source": "村芝居",
                "author": "魯迅",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって厩橋城下は殷賑を極め、武士の往来は雑｜鬧し、商家は盛んに、花街はどんちゃん騒ぎの絶え間がなかったという。",
              "citation": {
                "source": "純情狸",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど夜半過ぎ、彼らはどんちゃん騒ぎをしながら問題の小路の入口を通った。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻のどんちゃん騒ぎも、聯合組の仲間も、大広間も、いつの間にか消えて、六畳ほどの一室に、一人、寝かされている。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんちゃん騒ぎをしようや。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」「それが、一口にはいわれんけんど、……大将、ちょっと、行ってみて下さい」　広間では、もはや、どんちゃん騒ぎである。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこもかしこも客だらけで、それが泰平の世の有難さに、降り籠められた退屈しのぎのどんちゃん騒ぎで賑わっている。",
              "citation": {
                "source": "若殿女難記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "楊雄夫妻も大賛成で、日ならずして“開店大売出し”の爆竹（花火）、ちらし、慶祝の紅挑灯などが、どんちゃん、ここの街角をにぎわした。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "全部がうまくいっている場合でもなければ、最後にどんちゃん騒ぎなんてやりません。",
              "citation": {
                "source": "親友たち",
                "author": "C. スミス　C. Smith",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんちゃん騒ぎや快楽に耽溺し過ぎる。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "迎え酒を飲めばまた正気に返ると分かっていたので、朝食をがつがつ食べ、その食欲と言ったら、どんちゃん騒ぎ開けでも全く驚きだ。",
              "citation": {
                "source": "本命馬",
                "author": "HARD PRESSED",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこか遠くから、どんちゃん騒ぎが聞こえる。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ついてこい」　デンが戦士に連れられ、石畳の廊下に沿い、部屋の方へ行くと、どんちゃん騒ぎの音が聞こえた。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、どんちゃん騒ぎにも真夜中の時報が鳴った。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんちゃん騒ぎの一団が一斉に会話をやめた。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、（c）いやセネカもほとんど同じようなことをいっているが、（b）「わたしはこのどんちゃん騒ぎを利用するのだ」と言われた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "みなさんも、心してドンチャン騒ぎをくりひろげ、いまどきのガキなんか、メじゃないことを証明してください」　最前列から、テッテ的にやったろうじゃねえか、寮の屋根を吹き飛ばしてやる、どうせぶっ壊すんだろ、と声がかかり、また笑いにつつまれた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "うんと飲むといふよりは、羽目を外してドンチャン騒ぎをやつたものだ。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧民窟で、淫売窟で、そしてドンチャンドンチャンの見世物窟だ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そこには白鬚様があるのでもなし、ただ小さな島一ぱいに、パリの貧民窟のと同じドンチャンドンチャンがあるだけの話だ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、このリヨンの停車場前の広場が何かで大にぎやかだというので、ある晩行って見るとやはり同じドンチャンドンチャンと、玉転がしと文まわしと鉄砲とだ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがその代り屋敷内では、とても陽気なドンチャン騒ぎ、酒宴をやっているんですなあ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も設備の整った温泉場となると、ドンチャン騒ぎの遊山客がくるので困ります。",
              "citation": {
                "source": "身辺打明けの記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンチャン騒ぎも一日や一晩ぐらいなら、わたしだって面白いと思いますけれど、毎日毎晩ではやりきれません。",
              "citation": {
                "source": "身辺打明けの記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "日にやけて夕方かえって来たら、学校の教師のドンチャンさわぎ。",
              "citation": {
                "source": "日記",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは実業家になりたいというは、いかなるところより起こった考えかと煎じつめると、実業家は美服を着け茶屋に行ってドンチャンやるにある。",
              "citation": {
                "source": "自警録",
                "author": "新渡戸稲造",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわば縁日の本尊のないようなもので、何んというきまりもなく、ただ一時の客を呼んでドンチャンと騒いでいました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "佐竹の原繁昌のはなし",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
