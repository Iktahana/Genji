    "definitions": [
      {
        "index": 1,
        "gloss": "throwing down multiple objects in succession",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は大量の書類を机の上にどさどさと置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、おもちゃを箱にどさどさと放り込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "店員は商品棚に、新しい品物をどさどさと並べていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "たった一軒の漁師の家がある、しかし一軒が普通の漁師の五軒ぶりもある家でわれら一組が山賊風でどさどさ入っていくとかねて通知してあったことと見え、六十ばかりのこの家の主人らしい老人が挨拶に出た。",
              "citation": {
                "source": "鹿狩り",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "どさどさ打まけるように雪崩れて総立ちに電車を出る、乗合のあわただしさより、仲見世は、どっと音のするばかり、一面の薄墨へ、色を飛ばした男女の姿。",
              "citation": {
                "source": "妖術",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり卓子の上へショオルだの、信玄袋だのがどさどさと並びますと、連の若い男の方が鉄砲をどしりとお乗せなすった。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "次でどさどさ人々の走る音がした。",
              "citation": {
                "source": "外務大臣の死",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "しばらく耳を澄ましておりますと、どうも、鼠ではないようですから、むくりと起き上がって、しのび足で製作室の扉の方へ近よってゆきますと、やがて、製作室の中の音はやんで、その代わりに、地面を走ってゆくような、どさどさという足音が聞こえました。",
              "citation": {
                "source": "頭蓋骨の秘密",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分をしかって、どさどさもがいていると、磯五はあきらめて、たち上がった。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ小林の次の挨拶がどさどさと侵入して来た。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い板敷の小屋の中をどさどさ駆けまわって喜んでいるのもある。",
              "citation": {
                "source": "大根の葉",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちにあまり用心しすぎたせいだろう、畳の破れめにでも躓ずいたらしく、どさどさとよろけざま、なにかを踏みぬく激しい音が聞えた。",
              "citation": {
                "source": "泥棒と若殿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "割り下を注ぎ好きなだけ煮て、バジルの葉をどさどさ入れる。",
              "citation": {
                "source": "鉄道模型の夜",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時、ドサドサッと畳を蹴る音。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "阿曽が、むむと呻いた瞬間、ハナは得体の知れない叫び声をあげながら、ドサドサとこっちへ駆けてきた。",
              "citation": {
                "source": "白雪姫",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大りきみに力んで、テッパイに怒鳴り散らしているところへ、渡り廊下のほうに、二三人の足音がドサドサと近づいて来た。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "菊香水",
                "note": "青空文庫"
              }
            },
            {
              "text": "２　直滑降マニア　六十度の斜面――実はせいぜい六度か七度――を、雪煙り立てゝ直滑降した時の気持が忘れられず、酔っぱらっては場所錯誤で、天婦羅屋の二階から、段々をドサドサと墜ちるマニア。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "at once in great numbers",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
