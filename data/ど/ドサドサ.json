        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "閉店セールで、客が店にどさどさと押し寄せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試験の合格発表後、多くの学生がどさどさと集まってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "講演会には、予想以上の聴衆がどさどさと詰めかけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
