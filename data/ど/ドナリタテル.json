        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どっちを追おうかと少しかんがえているうちに、その騒ぎを聞きつけて、近所の珠数屋が戸をあけて、これも人殺し人殺しと怒鳴り立てる。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の可愛さを自分の心の中で殺さないで、怒鳴り立てる母親とならないで、やさしい母にもなって見たい。",
              "citation": {
                "source": "人間の結婚",
                "author": "――結婚のモラル――",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしゃ業が煮えて煮えて、チエー悔しい」と身を顫わせ四辺を憚らぬ大声にて怒鳴り立てる。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "大抵、三人連れで町家の門に立ち大きな声で怒鳴り立てる。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
