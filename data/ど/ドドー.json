    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "すると大きい奴がどどーんと落ちて来る」「ふーん。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどーン、ぐわーン。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどどーン、ががーン。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "銃をかまえると、怪物群めがけて、どどどーンと引き金をひいた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "君のいうとおりだ」　といっているとき、夜の静寂を破って、どどーんの一大音響が聞え、愛宕山が、地震のように動いた。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あの、どどーんという爆裂音と、あのずしんずしんという地響と、この二つを無くすることが出来ないものかな。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、どどどどーンと、ぶっつづけに大爆音が聞え、耳はガーンとなってしまった。",
              "citation": {
                "source": "英本土上陸戦の前夜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどーンと、大きな水音がした。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどーん、どどーんと室は四度、五度とあがったりさがったりしているうちに、一段と高い音をたてるとともに、ひゅーっと上の方にとびだしました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、どどーんという大きな音がして、ぱっぱっぱっと高角砲のたまが空中で破裂した。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどーん、ぱっぱっぱっと、ものすごい音をたて、目のくらむようなはげしい光をたてる。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあげく、どどどーん、ぐわーんという大爆発だ。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　博士は、どこかでざざあ、どどーんと、岩石がこわれておちる音をきいてたち上った。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "海水はあけた扉から、どどどーっとながれこんで、みるみるうちに艇内は水びたしになる。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上を、どどーんと、大波がとおりこしていった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどーン、どどーン。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどーン、ぐわーン、ぐわーン。",
              "citation": {
                "source": "大空魔艦",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の立っているところから、そう遠くない後方で、とつぜん、どどーンと小爆発がおこって、船の構造物が、がらがらと、はげしい音をたてて崩れた。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピートは、ばね仕掛の人形のように戦車の中に飛びのったが、そのときまたどどーん、どどーんと、相ついで小爆発が起って、船体がぐらぐらと、動揺した。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、とつぜん、どどどどーんと、四連発の大砲を、あわてて撃ちだしたときのように、おそろしい響きが伝わってきた。",
              "citation": {
                "source": "地底戦車の怪人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "だだーん、どどーん。",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どど、どど、どどーン。",
              "citation": {
                "source": "太平洋雷撃戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウン」　どどどーッ、どーン。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどど、どどーン、ぐわーン、うーン。",
              "citation": {
                "source": "空襲下の日本",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あっと思ったが、もう遅かった、ぐわーん、どどーんと大きな音とともに真白な煙が室内に立ちのぼった。",
              "citation": {
                "source": "○○獣",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
