        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドゥニャーシャが蝋燭をもち、ロパーヒンが本を手に登場。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　まもなく二時。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　お出かけになったとばかり思ってました。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）ドゥニャーシャ　犬はみんな、夜っぴて寝ませんでしたわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロパーヒン　おや、ドゥニャーシャ、どうしてそんなに……ドゥニャーシャ　手がぶるぶるしますの。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロパーヒン　どうもお前さんは柔弱でいかんな、ドゥニャーシャ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ドゥニャーシャに花束をわたす）ロパーヒン　ついでにクワスをおれに持ってきとくれ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　かしこまりました。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ登場、ロパーヒンにクワスを差出す。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（退場）ドゥニャーシャ　じつはね、ロパーヒンさん、あのエピホードフがあたしに、結婚を申しこみましたの。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　どうしたらいいのか、困ってしまいますわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ロパーヒン　（きき耳を立てて）さあ、こんどこそお着きらしいぞ……ドゥニャーシャ　お着き！",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　（わくわくして）あたし倒れそうだわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロパーヒンとドゥニャーシャは急いで出て行く。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラネーフスカヤ夫人、アーニャ、鎖につないだ小犬を連れたシャルロッタ、以上みな旅行服で、――それから外套にプラトークすがたのワーリャ、ガーエフ、ピーシチク、ロパーヒン、包みとパラソルを持ったドゥニャーシャ、いろんな荷物をかかえた召使たち――みなみな部屋に通りかかる。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャも、わかりましたよ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（ドゥニャーシャにキスする）ガーエフ　汽車は二時間もおくれた。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アーニャとドゥニャーシャのほか、一同退場。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　やっとお帰りになった、……（アーニャの外套と帽子をぬがせる）アーニャ　わたし途中四晩も眠れなかったの……今じゃもう、こごえあがっちまったわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　あなたがたがお発ちになったのは、大斎のころ（訳注　復活祭に先だつ七週間の精進期間で、年によって違うが、およそ二月初めから三月初旬までの間になる）で、まだ雪がふって、ひどい凍てつきようでしたが、今はまあどうでしょう？",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "一分間だって待てませんの……アーニャ　（だるそうに）また、なんの話……ドゥニャーシャ　執事のエピホードフが、復活祭のあとで、あたしに結婚を申込みましたのよ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……（疲れきって、よろよろしている）ドゥニャーシャ　どう考えたらいいか、困ってしまいますわ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　一昨日、トロフィーモフさんがいらっしゃいました。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　お風呂場で寝てらっしゃいますよ、あすこに陣どってしまってね。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワーリャ　ドゥニャーシャ、コーヒーを早く……。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　はい、ただ今。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャは、コーヒー沸かしをもってすでに戻ってきており、コーヒーを煮ている。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　まあ、見ちがえるようだわ、ヤーシャ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドゥニャーシャ　あんたがここを発った時は、あたしまだこんなだったわ……（床からの高さを手で示す）ドゥニャーシャよ、フョードル・コゾエードフの娘よ。",
              "citation": {
                "source": "桜の園",
                "author": "――喜劇　四幕――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
