          "standard": [
            {
              "text": "強制収容所では、過酷な奴隷労働が強いられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その海外工場では、パスポートを没収された労働者が奴隷労働を強いられているという疑いがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "安価な衣料品の裏側に、児童による不当な奴隷労働が隠れていることを忘れてはならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "処が奴隷労働力が社会の生産力として充用されるような生産様式即ち（奴隷制）になると、捕虜を奴隷にする代りに殺して了うことは、禁じられる。",
              "citation": {
                "source": "道徳の観念",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "奴隷労働者たちが教会でうたったスピリチュアルな歌は、このつらさの歌であり、世代がすすむにつれて、いつかは死によってこの求めざる土地から解放され天国にいけるのだという、宗教上の希望によって支えられたペシミスティックな生の肯定の歌にかわった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
