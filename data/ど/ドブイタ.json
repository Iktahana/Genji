        "examples": {
          "standard": [
            {
              "text": "政治活動はドブ板から始まり、地域の信頼を得た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ドブ板の活動で、候補者は市民の声を聞き歩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "ドブ板での丁寧な説得が票につながった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
