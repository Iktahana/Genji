[
  {
    "uuid": "772572b8-1a78-5ea3-aa58-14cfe468f038",
    "entry": "ドボン",
    "reading": {
      "primary": "ドボン",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "dobon",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供がプールにドボン！と勢いよく飛び込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "カエルが池にドボンと音を立てて飛び込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "うっかり手を滑らせて、スマートフォンを洗面器にドボンと落としてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "ドボンという水音がした。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭はドボンと落っこち、耳だけが残った。",
              "citation": {
                "source": "ニール・オキャリー",
                "author": "NEIL O’CARREE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「酉刻（六時）頃ぎりぎり、金龍山の鐘が陰に籠ってボーンと鳴るのと、伊勢屋新六がドボンとやらかしたのと一緒だ」「フーム」「石原の兄哥（利助）のところで油を売ってると、竪川からその知らせだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金の鯉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんじゃマキベえ、二人でここからドボンと飛び込んでしまおうか？",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だらり幽霊のような体は一瞬重たかったが、ドボンと投げ込むと、静かになった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、その時、一つの小舟から、クルクルと素裸体になった十五六歳の我鬼大将が、真黒な身体を逆さにして、ドボンと滝壺近くの深味へ飛込んだのである。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「助けてやろう、助けてやろう」　一同口々に叫んで、着物をかなぐり捨てて、競泳の様に、次々と、ドボンドボン飛込んだ。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "豊満な水着姿が、つと立ち上がったと見る間もなく、たちまち中心を失って、ドボンと水煙立てて！",
              "citation": {
                "source": "墓が呼んでいる",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "テラポンティゴヌス・ミレスは擲弾兵ヴァドボンクールと腕を組み合って歩くであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと岩にあたってくだける音がすると思ったのですが、そんなけはいはなくて、しばらくしてから、はるか向こうの方で、ドボンと水のはねる音がしました。",
              "citation": {
                "source": "新宝島",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "と同時に、当の明智でさえ自分が落ちたのではないかと疑った程の、ドボンという大きな水音。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "追って来た孫立は、井戸べりに片足かけて、中を覗き込み、「おあつらえ」　とばかり手の一｜鎗を逆にかざし、ドボンと投げ突きに井戸底の物を突き殺した。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒュッと風を切ったも目瞬きするより早かった――がそれより目に止まらなかったのは、切尖の下りた間髪に、くるりと巌の横へ抱きついた自斎の神速――同時に、ドボン！",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「身を伏せろッ」　と部下へ命じながら、自分は毅然と立ったままで、敵の弾けむりを睨んでいた明智方の足軽｜頭は、こめかみの辺を撃ちぬかれて、橋桁からもんどり打って河中に墜ち、ドボンと、大砲の弾が落ちたようなしぶきを揚げた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "源六は、その襟がみを両手にして、女を独占する勇躍の余力で、ズルズルと獄門橋、溝の際まで引きずって行き、そこでドボン！",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「つまずくなよ」「まッ暗だア、色情の闇路」「ソレ、そこに繋いである見張舟へ……」「旦那、わっしが先へ下りますから、手をはずさないでいておくんなさい……はずしてドボンと沈めたところで、この宅助は元々だが、旦那が浮かばれねえでしょう」　小舟の中へ、ドンと長櫃を下ろした時だ。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "blackjack",
        "register": "standard",
