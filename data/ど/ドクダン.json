  {
    "uuid": "025e0f68-e2d2-5a94-ab22-2e92c2580357",
    "entry": "独壇",
    "reading": {
      "primary": "どくだん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何なら此処へ呼びましょうか」そう言う不逞な言葉になると、豹一の独壇場だった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつてはゼロックスの独壇場だった普通紙複写機の領域に独自の技術で乗り込んでいった日本のメーカーも、マイクロコンピューターの大口顧客となってくれた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "高解像度でのカラー表示は、当時アップル※の独壇場だった。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この項で強調している「表現する」という領域は、少なくとも今のところマッキントッシュの独壇場だ。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "太郎にのみ許されたる独壇場だもの。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが国などではジャーナリズムと云えば以前は単に文壇的なものとしか考えられなかったものが、今日ではアカデミーの独壇場であった理論の世界を蚕食して、論壇が形成されるに至ったのを見る。",
              "citation": {
                "source": "イデオロギー概論",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "その話に対しては、私に返答の余地さへ見当らないかの宛然独壇場の有様であつた。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、これからが石川淳の独壇場であった。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "古橋は長距離王国の日本に於ても超特級品であるが、マーシャルは、日本独壇場の千五百で、はじめて日本の王座をおびやかす欧米の超特級品。",
              "citation": {
                "source": "安吾巷談",
                "author": "世界新記録病",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲の教科書にも乙の教科書にもキノコの着色図版といえば、後にも先きにも川村君の腕を振う独壇場であった。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはみっちゃんの独壇場である。",
              "citation": {
                "source": "握り寿司の名人",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って洗いづくりに事を欠き、洗いと言っては東京の独壇場の観がないではない。",
              "citation": {
                "source": "洗いづくりの美味さ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "こうなると、妻の独壇場である。",
              "citation": {
                "source": "澪標",
                "author": "外村繁",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベートーヴェンは常に音楽界の独壇場であり、レコード雑誌の問答欄の半分の投書は、ベートーヴェンの第五シンフォニーとヴァイオリン協奏曲のレコードの選択で持ち切っていると言ってよい。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後の「四重奏曲へ長調作品一三五」はビクターのブッシュが独壇場だ（ＪＤ四七六―九）。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "即興曲　奔放な即興に高い芸術性を賦与することはショパンの独壇場だ。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "中でも中国の研究は、博士の独壇場であるだけに、かしこまって謹聴していたら、突如として、中国の昔の好色本の話になったのでびっくりした。",
              "citation": {
                "source": "胡堂百話",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "拙者は鏡智流の独壇とする戒刀型の木太刀をもってお対手申さん」　と倨傲に云い放った。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "競馬場は飽くまでも、勝者の独壇場であり燦く者のためにある広場だった。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく当時の人事は、全く平家の独壇場であり、摂政関白の意向はもちろん、後白河院さえ無視されていた状態だったから、結果としては、むしろ、当然過ぎるほどの任命だった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第一巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう空気を見わたすと、小次郎はわが独壇場のように、いよいよ舌に熱を加えて、「わしも将来は、兵法をもって一家を成そうとする者なので、単なる好奇心からではなく、努めて試合、真剣勝負などの際は弥次馬に交じって出かけます。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち毛利軍の独壇場ともいうべき瀬戸内の海上権にものをいわせて中国沿岸は元より大坂から芸州にわたる間には、きょうこのごろその水軍たる大小の兵船がわが物顔に監視の眼をひからせて、一舟の航行でもうかつに見のがすことはないと沙汰されている。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
