        "examples": {
          "standard": [
            {
              "text": "彼の独断には誰もがうんざりしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はいつも独断で物事を決める傾向がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チームワークを重んじるプロジェクトでは、独断は避けなければならない。",
