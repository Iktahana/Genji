[
  {
    "uuid": "393df981-db38-50f4-80aa-142ae490dd27",
    "entry": "ど忘れ",
    "reading": {
      "primary": "どわすれ",
      "alternatives": [
        "ドわすれ"
      ],
      "is_heteronym": true
    },
    "grammar": {
