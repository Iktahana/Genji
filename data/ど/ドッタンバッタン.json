          "literary": [
            {
              "text": "何だか彼んだか訳の分らない事を二色の金切声が叫びながら、ドッタンバッタンと云うすさまじさなので、水口で何かして居た女中達は皆足音をしのばせて垣根の隙――生垣だから不要心な位隙だらけになって居る――からのぞくと、これはこれはまあ何と云う事だろう。",
              "citation": {
                "source": "二十三番地",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "火事だてえと、婆アの奴のドッタンバッタン慌てるッたらありやしねえ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの婆アのドッタンバッタン慌てるッたら有りゃしねえな。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさしくオカネはドッタンバッタン慌てふためいてタタミをあげネダをあげました。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十六　家族は六人・目一ツ半",
                "note": "青空文庫"
              }
            }
          ]
        }
