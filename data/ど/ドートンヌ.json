        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "きのうは、サロンドートンヌを見たよ、中村と一ショに。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日　土　今日、サロン・ドートンヌ〔秋の画廊〕の招待日だ。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "松本夫妻、平、永瀬（版画）とサロン・ドートンヌへゆく。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○サロン・ドートンヌを見、かえりにモンパルナスでマチスのデッサンを買った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "終ると東横へ行き、アトラクション、ロッパ・ガールスの「ブーケドートンヌ」を見る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
