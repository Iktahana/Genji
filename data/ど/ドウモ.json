  {
    "uuid": "44703373-2f34-59d0-8172-fb9aa5ea50cc",
    "entry": "ドウモ",
    "reading": {
      "primary": "どうも",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ドウモしかしながら文学などは私らにはとてもできない、ドウモ私は今まで筆を執ったことがない。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモ仕方がないから、そのことをカーライルにいった。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ノスケッチデハ私ノ感ジガドウモ出ナイデコマリマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "樹木モドウモ物体感ニトボシク思ワレマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イキテンノ」「サウ、デモ　ドウモ　シヤ　シナイカラ　ダイヂヨウブ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "女護島へ男渡らば草履を数々出して男の穿きたるを印しに妻に定むという風俗の残れるにやと、ドウモ女人国へ行きたくなって何を論じ掛けたか忘れました。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "散薬なら二三日前に頂戴したのがまだ残っていますが……」「そうして適当な判断を下してくれませんか……品夫が外国の探偵小説にカブレて、そんな事を云い出したものか、それともほかに何か理由があっての事か……どうかというような事を……」「ハハハハハ……ドウモそう性急に仰言っちゃ困りますがね。",
              "citation": {
                "source": "復讐",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……わっしゃドウモこの吸口の蝋の臭いが嫌いなんで……ヘヘ……有難う存じます。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ドウモ……身体が弱う御座いますので……外套のまま失礼を……」　それは矢張り身体に釣り合わない、女みたような声であった。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "何も知らない私を捉まえて、思いもかけぬ大学生に扮装させたり、美しい少女を許嫁だなぞと云って紹介せたり、いろいろ苦心しているところを見るとドウモ可怪しいようである。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だからその時にそのモウ一人の吾輩である吾輩は、是非とも映写幕の外に出て、説明役にまわらないとドウモ具合が悪いのだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしかに引受けた」「ドウモ……まことに……」「ウンウン。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……イヤ……これあドウモ驚いた。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲヘゲヘ弱ったなドウモ……こうなんだよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウモそういう風にどこまでも先入主になって来られちゃ敵わない……いいかい。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "残りはアンタ等に遣るから、家へ持って帰って、ユックリ飲むがええ」「それあドウモはあ。",
              "citation": {
                "source": "眼を開く",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そ……そいつはドウモ……」「出来んと云うのか」　吾輩の見幕を見た羽振医学士がブルブル震え出した。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんぼ博士になりましても、コンナ重態の奴はドウモ……」「モトモト君が結核にしたんじゃないか……この犬は……」「……そ……それはそうですけれども、治癒すとなりますとドウモ……」「ふうむ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一介の漁師としては正に位、人臣を極めるところまで舞い上って来た訳だが、サテ、そうなってみるとドウモ調子が面白くない。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはドウモ困ります。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "序にこの船の秘密を看破ってやれという気になってここまで降りて来たのは、いい度胸だったかも知れないが、そいつがドウモ感心しなかったね。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はドウモ苦手だ……ハハン……。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この際、紅茶のお盆なんか持ってブラブラしている奴はタタキ殺しちまえって……」「君から船長にそう云い給え」「ドウモ……そいつが苦手なんで」「よし。",
              "citation": {
                "source": "難船小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これあドウモ御馳走様でゲス。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤッ、これあドウモ奥様のお酌で……どうぞお構い遊ばしませんで……手酌で頂戴いたしやす。",
              "citation": {
                "source": "人間腸詰",
                "author": "夢の久作（夢野久作）",
                "note": "青空文庫"
              }
