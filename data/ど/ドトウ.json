        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼の人生はまさに怒涛の連続で、常に困難と戦ってきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "怒涛の時代を生き抜き、彼は多くの経験を積んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "試合は怒涛の攻防が続き、観客を魅了した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
