[
  {
    "uuid": "c90b83ce-3345-5666-a187-8deb4ce3d2a4",
    "entry": "怒涛",
    "reading": {
      "primary": "どとう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
