  {
    "uuid": "b515edf4-cfb8-5ded-9f6c-005b156139ee",
    "entry": "どれ",
    "reading": {
      "primary": "どれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
