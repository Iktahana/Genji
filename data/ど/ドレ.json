    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "どれおとっさんに少し抱さってみい。",
              "citation": {
                "source": "浅草詣",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれか子をうみやがったなと思うていると。",
              "citation": {
                "source": "牛舎の日記",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どれだけ涙が出たか、隣室の母から夜が明けた様だよと声を掛けられるまで、少しも止まず涙が出た。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち、その言語を用いる人々は、或る一定数の音単位を、それぞれ互いに違った音として言いわけ聞きわけるのであって、言語を口に発する時には、それらの中のどれかを発音するのであり、耳に響いて来た音を言語として聞く時には、それらのうちのどれかに相当するものとして聞くのである。",
              "citation": {
                "source": "国語音韻の変遷",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体この言語の音を研究するについて先ず第一に大切なことは、どれだけの違った音でその言語が組立てられているかということ、つまりその言語にはどれだけの違った音を用いるかということであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでその言語においてどれだけの違った音を用いるかということは、言語として非常に大切なことであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで或る言語においてどれだけの音を違った音として区別するかということが大切な問題となるのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう訳ですから、古典を研究し古典の意味を解釈するという場合においても、昔の人がどれだけの音を聴き分け、言い分けておったかということを知るのが大切であります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かような音の異同はそれを使っている人について聞いてみれば解る訳で、さようにして調べれば、その言語ではどれだけの音を違った音として聴き分けるかということがわかるはずです。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、或る語を発音する場合には、その組合っている多くの音の中のどれかを取り出して、一つずつ順次に発音するのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、人の言語を聞く場合にも、耳に聞えて来る音を、その組合せの中のどれかであるとして聴き取るのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、我々が言語を発する時にはその中のどれかを使うので、それ以外の音は用いない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それであるから外国から言葉が入って来る場合に、聞く人の言語のもっている音に合わないような音があると、その音を変えて、聞く人の言語にある諸音の中のどれかに合うようにするのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう風に日本語にない音が入って来ても、これまで我々がもっている色々違った音の組合せの中のどれかにしてしまうのであります、そういう風に、あるきまった言語において用いるあらゆる音の組合せを音韻組織といっております。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "音を発しようとすれば、その中のどれかを叩くより仕方がない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "半音ずつの違いによって一箇ずつキーが附いておりますが、それのどれかを使うより仕方がない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "現代語については、今申した通り、どれだけ違った音を区別するかということは自身が直接にその言語を聴き、また現在その言語を使っている人々に尋ねてみて判るのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが古代の言語については、昔の人がどれだけの違った音を聴き分け言い分けておったかということは、昔の人の文字に書いたものによって知るほか方法がないのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこういう風に日本語を書いたものでは、今言ったような、昔の人がどれだけの音を聴き分けたかということは判りません。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち片仮名、平仮名、あるいはもっと古い時代では万葉仮名、そういうものによって日本語を書き写したもの、それを材料にして、それによって昔の人がどれだけの音を言い分け聴き分けておったかということを知るのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは皆一々違った音をあらわしたとは思われませんが、とにかく文字は皆違っているのですから、その中のどれだけが同じ音で、どれだけが互いに違った音であるか、そういうようなことは予め決める訳には行かない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "犬の「イ」という音をどれほど考えてみても、「い」と「ゐ」とどちらを使うのだということは判らない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから「意」「於」「淤」「乙」は同じ語の同じ部分を書いてあるからこれもどれを使ってもよく、互いに通用するのであるということがわかる。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち「か」ならば「加」、「迦」、「可」など、いろいろの文字があるのを皆「か」と読んで、どれも皆「か」の音を表わす同類の仮名であると考えていた。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "霞の「か」も、赤の「か」もこの万葉仮名の中どれを使ってもよい。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "かような研究としては、「い」と「ゐ」、「え」と「ゑ」、「お」と「を」のような同じ音に読まれる仮名にあたる万葉仮名については、既に述べた通り契沖阿闍梨や奥村栄実の骨折りによって調べられて、どれだけの類別があるかが判るようになったのであります。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "これまでは、両方ともすべて「こ」の仮名と思っていて、どちらも同音の仮名で、どちらを使ってもよいと考えていたのですが、そうではなくして「古」の類の仮名ならば、互いに通用してどれを使っても構わぬが、「許」の類の仮名を使う所には決して使わない。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "玄関につるしてある銅鑼を鳴らすと、「どーれ」　出て来たのは三好清海入道よりまだ汚い、あらくれの坊主である。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やって御覧、海が上の方に見えるよ」「どーれ」　篤介は徐ろに帽子を耳の上まで引下げ、腕組みをし、重々しく転がって行った。",
              "citation": {
                "source": "明るい海浜",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どーれ」　十八九の青年が現われて来て、竜之助を見る、その物腰が武術家仕込みらしく、竜之助の風采に多少の怪しみの色はあっても侮りの気色が乏しいから、「御主人は御在宅か。",
              "citation": {
                "source": "大菩薩峠",
                "author": "三輪の神杉の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
