    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドッドド　ドドウド　ドドウド　ドドウ、　甘いざくろも吹き飛ばせ　酸っぱいざくろも吹き飛ばせ　ホラね、ざくろの実がばたばた落ちた。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "九月十日「ドッドド、ドドウド、ドドウド、ドドウ、　ああまいざくろも吹き飛ばせ、　すっぱいざくろも吹き飛ばせ、　ドッドド、ドドウド、ドドウド、ドドウ　ドッドド、ドドウド、ドドウド、ドドウ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドッドドドドウドドドウドドドウ、あまいざくろも吹きとばせ、すっぱいざくろも吹きとばせ、ドッドドドドウドドドウドドドウ、ドッドドドドウドドドードドドウ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドッドドドドウドドドウドドドウ、　楢の木の葉も引っちぎれ　とちもくるみもふきおとせ　ドッドドドドウドドドウドドドウ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、猿またの捨て場所にこまって、そっとこの便所へ突っこんで、うんとひもをひっぱってドドドウと水を流して見た。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "音楽の間にドドドウと舷を打つ重い濤音とともに、ギギギと船全体を軋ませ、ぐうっと右にロールした。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドウッとたたきのめすように吹きおろす風が、樹木の枝を折り草を薙ぎ倒し、家屋の角々に猛然とぶつかって、跳ね返されまた跳ね返されしては、ワワーッ！",
              "citation": {
                "source": "一つの芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ものすごい、沖の方から、たえず波は、ドドウ、ドドウとがけの下に打ち寄せている。",
              "citation": {
                "source": "海の踊り",
                "author": "小川未明",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
