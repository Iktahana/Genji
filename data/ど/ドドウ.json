    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "呼び物の「金色の女」はなるほどどうしても血の通っている人間とは思われなくて、金属の彫像が動いているとしか思われない。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雨はざあざあ　ざっざざざざざあ　風はどうどう　どっどどどどどう　あられぱらぱらぱらぱらったたあ　雨はざあざあ　ざっざざざざざあ」「あっだめだ、霧が落ちてきた。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっどど　どどうど　どどうど　どどう　　　青いくるみも吹きとばせ　　　すっぱいかりんも吹きとばせ　　　どっどど　どどうど　どどうど　どどう　　　どっどど　どどうど　どどうど　どどう　先ごろ、三郎から聞いたばかりのあの歌を一郎は夢の中でまたきいたのです。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどうしてもまだ歩けないんだろう、そしたらね、そのうちに東が少し白くなって鳥がなき出したろう。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、少年時代のたわいない気持のせんさくなどどうでもよろしい。",
              "citation": {
                "source": "アド・バルーン",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘のことなどどうでも良い顔で、だからひそかに自分に己惚れていたのだった。",
              "citation": {
                "source": "夫婦善哉",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "つい近頃になって「Ｂ教授の追憶」を書くときにふとそのＢ教授の手紙を想い出すと同時にこの抽出しとＳ先生の手紙を想い出したのであったが、今ではもう昔の教室の建物はすっかり取毀されてしまって、昔の机などどうなったか行衛も分らず、ましてやその抽出しの中の古手紙など尋ねるよすがもなくなってしまった訳である。",
              "citation": {
                "source": "埋もれた漱石伝記資料",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだとすれば、シムソンに有利な材料が一つだけなくなるわけだ」「それにしても、警察ではどんな見込を立てているか、今からだけれどどうも分りかねるね」「警察の見込なんかどうせ我々の考えることとは大に違うにきまってるんだよ。",
              "citation": {
                "source": "白銀の失踪",
                "author": "SILVER BLAZE",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどうしても、一度だけ子供を見たくてたまらなくなりましたの。",
              "citation": {
                "source": "黄色な顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどうしてそれが分かる？",
              "citation": {
                "source": "株式仲買店々員",
                "author": "コナンドイル　Arthur Conan Doyle",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどうしてわかる？",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "『本人などどうでもいい――やったことがすべてなのだ。",
              "citation": {
                "source": "赤毛連盟",
                "author": "THE RED-HEADED LEAGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私先生のところへ来て、家事のお助けしたいと思うんですけどどう？",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "――けどどうしてです。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だけんどどうかかうか生きるだらうつて、医者どんも云やんしたから。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、今日立つと言つたけどどうする積りでゐるのかしらと仰つて入らつしやいました。",
              "citation": {
                "source": "桑の実",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "幻術などどうでもいいのだが、幻術を能くするくらいなら真人であろうし、真人なら宇宙の大道を会得していて、渠の病を癒すべき智慧をも知っていようと思われたからだ。",
              "citation": {
                "source": "悟浄出世",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこを探しても職は無し、原稿は売れず、殆んどどうしていいか判らなかった。",
              "citation": {
                "source": "骨を削りつつ歩む",
                "author": "――文壇苦行記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどうしても駄目でした。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪の屋はにやりと笑つたが、お鳥はきまり惡さを重ねた爲めだらう、恨めしさうに義雄を瞰みながら、急に坐わり直し、「けふは、餘ツぽどどうかしてる！",
              "citation": {
                "source": "泡鳴五部作",
                "author": "憑き物",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
