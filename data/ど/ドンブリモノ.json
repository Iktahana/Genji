        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "今日のランチは、手軽に食べられる丼ものにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このお店は、カツ丼や天丼など、種類豊富な丼ものが人気だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "海外からの観光客にも、日本の丼ものは大好評だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "出張に行った時なども、よく先方で丼ものなど取って食べさせるようですが、食べて来るなと言ってあるんです。",
              "citation": {
                "source": "料理一夕話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
