    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ふじ子はひよいとしたら、丼物でもとつてもらへるかも知れないと、女中に、何か食べものを取りよせてもらへるかときいてみた。",
              "citation": {
                "source": "濡れた葦",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "手拭をしぼつて部屋へかへつてゆくと、もう丼物が來てゐて、上の子の健吉は、親子丼の蓋をあけて母を待つてゐた。",
              "citation": {
                "source": "濡れた葦",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "代書の仕事は仲々繁昌してゐて、二階は、登記を頼みに来る客の待合所になり、継母は、この客達に、茶や菓子や丼物の世話をして、幾分かのさや取りをして、馬鹿にならぬ収入をあげてゐた。",
              "citation": {
                "source": "瀑布",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒ずんだ卓子が土間に並んでいて、やはり兵営での面会帰りと見える人たちが、代用食らしい丼物を食べていました。",
              "citation": {
                "source": "沼のほとり",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "客の多くは酒かビールの一本くらいに、あとは丼物でも取ればいいほうだからだ。",
              "citation": {
                "source": "青べか物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし割箸があるとすれば、そばとか丼物とか、なにかを家へ取ったことがあるのだろう、長屋のかみさんたちはそうにらんだ。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
