[
  {
    "uuid": "04b79825-3164-5864-86ac-941ac61d7054",
    "entry": "独身",
    "reading": {
      "primary": "どくしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞-の形容詞",
