  {
    "uuid": "8a3f69c5-ba25-5aba-9130-9c8e37201014",
    "entry": "読唇",
    "reading": {
      "primary": "どくしん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
