[
  {
    "uuid": "2083954f-6926-5c5e-87ba-ad9f95570ee1",
    "entry": "同祖",
    "reading": {
      "primary": "どうそ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
