        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "旅行のお土産に、地元の土産（どさん）のお菓子を買った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はいつも、珍しい土産（どさん）をくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お世話になった方へ、心のこもった土産（どさん）を贈りたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
