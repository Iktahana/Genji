  {
    "uuid": "7c17bed1-763d-5c88-8c7c-4e8427107040",
    "entry": "ドコカ",
    "reading": {
      "primary": "どこか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タカ　ニ、アレハ　ドコカ　ト、タズネマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシネ、ドコカノ　カワイイ　アカチヤンヲ　ダツコシタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう次の瞬間には皆再び私の眼に触れないドコカへ消え失せてしまうのです。",
              "citation": {
                "source": "孤独",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなに働かされると、ワタシモ、ドコカヘ、カエッテシマイタイ。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを読むと、「茂チャン帰リマセン、ミドリサンモドコカヘ行ッテシマイマシタ」　　　　　　　　　十六　清澄の茂太郎が、ふと蘆笛の吹奏をやめて、黍畑のあなたを見やった時、せっかく、首をふりかけた表情のない動物が、愕然として恍惚から醒めて、のどを鳴らしはじめました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ千年以上の作というにかかわらず、朱の色が、昨日｜硯を発したばかりの色なんです、今時の代用安絵具とは違います、絵かきが垂涎しておりますよ、こんな朱が欲しいものだ、ドコカラ来た、舶来？",
              "citation": {
                "source": "大菩薩峠",
                "author": "椰子林の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイヌ村山籌子マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "マアイツタイドコカラコンナニタクサンヤツテキタノカシラ。",
              "citation": {
                "source": "コイヌ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコカラ　アラハレタカ、ホースノ　ミヅガ　イタベイニ　トンデキマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ、ヨシヲサンノオカアサンハ、ソノマヒゴヲドコカデ見タコトガアル子ダト思ヒマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "フウセンウリノオヂイサン　モウ　ドコカヘイツチヤツテル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここには　サンタの　おじさんのことが　くわしく　のっていて、　そのすまいは　ドコカオクソコという　ちいさな　まちの　ほどちかくと　なっておる。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "やっと　わかったのが、　すまいが　ここから　とおい　ドコカオクソコという　まちの　そばだと　いうことだけで。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "ながい　みちのりを　こえて、　ババールは　はるばる　ちいさな　まち　ドコカオクソコに　たどりつきます。",
              "citation": {
                "source": "ババールとサンタのおじさん",
                "author": "BABAR ET LE PERE NOEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ハ夜デヨカッタケレドモ、コレカラダト時間ガ時間ダカラ、必ズドコカデデモ隊ニ打ツカリマス、米国大使館ト国会議事堂ト南平台ヲ結ブ線ヲドコカデ横切ラナケレバナリマセン、ソノ積リデ早目ニオ出カケニナッテ下サイト、運転手ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤッパリ黒人デ、ブレノ・メロホド美男ジャナイケレド、ドコカ感ジガ似テルノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大概ヘッディングト云ッテ、頭ガ相手ノ顔ノドコカニ打ツカッテ出ル場合ガ多イワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "定メシソノ刹那ニハ七十年来ノ生涯ニ積ミ重ネタ悪事ノ数々ガ走馬燈ノヨウニ次々ト現レルダロウナ、アヽ貴様ハアンナコトモシタ、コンナコトモシタ、ソレデテ楽ニ死ノウナンテ虫ガヨスギル、今苦シムノハ当リ前ダ、ザマア見ヤガレ、―――ドコカデソンナ声モ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木村ガ来テ、四人デ食卓ヲ囲ンデイル最中ニ彼女ガドコカヘ立ッテ行ッテ、シバラク戻ッテ来ナイノデ、「ドウナスッタノデショウ」ト木村ガ云イ出シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が木村と会合の場所に使った大阪の宿は、「ドコカナイデショウカト木村サンガ云ウカラ」敏子が「オ友達ノ或ルアプレノ人」に聞いて教えてやったのだというけれども、ほんとうにそれだけが真実であろうか。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "金五郎サンモ、自分ノ女ヲ、友田サンニ取ラレルノハイヤトミエテ、宴会ノ途中カラ、二人トモ、ドコカニ行ツテシマイマシタ。",
              "citation": {
                "source": "花と龍",
