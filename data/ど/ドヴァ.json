        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "以下のかたがたのご協力、アドヴァイス、激励がなければ、いまここに本書が存在したかどうか疑わしい。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昔しスペインにコルドヴァと云う所があった……」「今でもありゃしないか」「あるかも知れない。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "原注一四　ストーン大佐編集のニューヨーク、『コマーシャル・アドヴァタイザー紙』。",
              "citation": {
                "source": "マリー・ロジェエの怪事件",
                "author": "『モルグ街の殺人事件』続編",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル・マムンの後約一〇〇年を経て、バクダットにおけるカリフの権勢が地に堕ちて、アラビア文化の本場はスペインのコルドヴァ（Cordova）に移った。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "紀元一二三六年にコルドヴァはスペイン人に侵略され、この有名な図書館の蔵書は次第に散逸した。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルネッサンスの時代が進んでからは、婦人の社会的な生きかたもひろがりをもちはじめ、スペインのコルドヴァ大学などで婦人の学者も数人あらわれた。",
              "citation": {
                "source": "女性の歴史",
                "author": "――文学にそって――",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしても来ない客が二人ほどあったために兄夫婦はあとにのこっていなければなりませんでしたが、賀茂子爵のアドヴァイスにより、夫妻の卓には姪の百合子と執事の勝見とが入って競技をはじめることになりました。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで失望し乍らも最後に私の訪ねたのはコルドヴァの町でございます。",
              "citation": {
                "source": "西班牙の恋",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日世間の塵労の中に大乗の信を得て生き、国民運動の社会的実践に従いつつある私は、それにもかかわらず、諸君の青春に悔いなからしめんためにこのアドヴァイスを呈するものである。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたのお優しいアドヴァイスは嬉しく心に納めました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人は、建築家仲間がその姓名のゴロを合わせて、「アドヴァンテージ」（利益）というあだ名で呼ぶような人柄であった。",
              "citation": {
                "source": "行為の価値",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、アドヴァンテージが墓をつくった。",
              "citation": {
                "source": "行為の価値",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼らは対日理事会その他のアドヴァイスによって日本民主化のための各種委員会を組織しなければならなかった。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山川と云うジャパン・アドヴァータイザーの男が一宮さんを呼ぶことを提議する。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああ、東京の町の音も全くどこかへ消えてしまう真夜中、涙に濡れた眼を挙げながら、うす暗い十燭の電燈の下に、たった一人｜逗子の海風とコルドヴァの杏竹桃とを夢みている、お君さんの姿を想像――畜生、悪意がない所か、うっかりしているとおれまでも、サンティマンタアルになり兼ねないぞ。",
              "citation": {
                "source": "葱",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "肉の生命は血にあり【アンテノリ】パードヴァ人。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "一三一四年カン・グランデが皇帝の代理としてヴェツェンツァのギベルリニを助け、パードヴァのグェルフィを破りて沼（即ちバッキリオネ河がヴェツェンツァの附近にて造る沼）の水を紅に染めしをいふとカーシーニの引用せるアンドレーア・グローリア（Andrea Gloria）の説に曰く。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソーネチカ、ソーネチカ・マルメラードヴァ、世の続く限り永遠に尽きぬソーネチカ！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはソフィヤ・セミョーノヴナ・マルメラードヴァであった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この方がソフィヤ・セミョーノヴナ・マルメラードヴァです。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "大統領にも、各省にも、それぞれサイエンティフィック・アドヴァイザーが設けられた。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大統領直属のサイエンティフィック・アドヴァイザーの報告にもとづいて、一九五〇年にナショナル・サイエンス・ファウンデーションの制度が生まれた。",
              "citation": {
                "source": "調査機関",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は、君の手紙で、君がこれから社会人となるについて私にアドヴァイスを求めて来ているが、それに対する私の答を正しく君に理解してもらうためには、私のこの気持、つまり私が世間なみのお座なりの気持で君の門出を見おくっているのではない、ということを、先ずもって理解してもらうことが必要だと思うからだ。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓に鼻をおっつけて見おろすと、ドヴァが白い波がしらをふりたててものすごく荒れくるっている。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "デミドヴァが、「所有品を持って行ったほうがいいでしょうか」とたずねると、「褥だけでいいだろう」とコルビンスキーは素気なくいって隣の食堂へ行った。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "皇太子の手をひいたアレクサンドラ皇后、三人の皇女、タチアナは愛犬を抱え、侍女のデミドヴァは皇太子の枕を持っていた。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "侍女のデミドヴァは枕で胸をふせぎながら大声をあげて階段の下まで逃げだしたが、あえなくそこで射ちすくめられ、末の皇女のアナスタジアはあまり泣き叫ぶので銃把で頭蓋を一撃され、それで永遠に沈黙した。",
              "citation": {
                "source": "淪落の皇女の覚書",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルールドの聖母やパドヴァの聖アントニオなどの像を壁にかけていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "最初に印刷された本は1475年にパドヴァで刊行された（第４章参照）。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "優れた医学校がセヴィリア、トレド、コルドヴァに創設された。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
