        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "お婆さんがばつちくなつたおべべを川へ持つて行つてお洗濯をしてゐるとね、向ふの方から大きな桃が、どんぶらこ／＼と流れてきました』『おばあちやん、そのもゝどんなにおほきかつたの？",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "……媼さんがじゃぶじゃぶ洗濯をしていますと、川上の方から大きな桃が二つ、どんぶらこ、どんぶらこと流れて来ました。",
              "citation": {
                "source": "六月",
                "author": "相馬泰三",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄さんの桃太郎に別れて一人ぽっちになって、どんぶらこ、どんぶらことどこまで流されて行って、何者のために拾われて、どんな一生を送ったでしょう。",
              "citation": {
                "source": "六月",
                "author": "相馬泰三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
