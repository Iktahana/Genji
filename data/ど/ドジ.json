    "definitions": [
      {
        "index": 1,
        "gloss": "blunder",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "また電車を乗り間違えるなんて、本当にドジだなぁ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "私の今日のドジ話を聞いてよ、朝から失敗続きなんだから。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はドジが多いけど、憎めない性格でみんなに好かれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「ウードジョーンスという人が一昨年の暮にインド洋から空瓶を数個海中に投じ、その中に手紙を封入して誰でもこれを拾うた人はその場所と時日を通知するように依頼してあった。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝に駒形のドジョウを想い、夕べになるせの足を想う、いやもう、真とに食い気一方です。",
              "citation": {
                "source": "陣中日誌（遺稿）",
                "author": "附・戦線便り",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロイドジョージとかウィルソンとかいう名前が目につく。",
              "citation": {
                "source": "丸善と三越",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ私たちが乗り込んで来たので、眼の捷いお鎌はすぐに自分の店をぬけ出して、事の成り行きをうかがっていると、元八がドジを組んで私たちに調べられることになった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "十五夜御用心",
                "note": "青空文庫"
              }
            },
            {
              "text": "南の盛り場でドジを踏んで、警官に追われたが、さすがにつかまるようなドジだけは踏まず、どこをどう逃げたか、まんまと警官をまいてしまって、大阪の北へ現れた豹吉である。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊勢父子がドジを踏んでマゴマゴすれば蒲生は之を捨てて置く訳にはゆかぬ、伊勢父子の居る地方と蒲生の会津とは其間遥に距って居るけれども必ず見継ぐだろう。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "しても、ドジ踏めへん」「あんた泥棒したの……？",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "全く運転手の過失で、こんな何でもないところで飛んだドジをやったものです。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「旦那方の前ですが、ここでわたくしは飛んだドジを組んでしまって、まことに面目次第もございません。",
              "citation": {
                "source": "真鬼偽鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "道節を除いては、小文吾が曳手・単節を送って途中で二人を乗せた馬に駈け出されて見失ってしまったり、荒野猪を踏み殺して牙に掛けられた猟師を助けたはイイが、恩を仇の泥棒猟師の女房にコロリと一杯喰ってアベコベにフン縛られる田舎相撲らしい総身に知恵の廻り兼ぬるドジを時々踏むほかは、皆余りに出来過ぎている。",
              "citation": {
                "source": "八犬伝談余",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾ら手前が、大力だからと云って、ドジ許り踏んでいちゃ、旅先で、飯にはならねえぞ」　そう云ったのは、松井田の喜蔵と云う、分別盛りの四十男だった。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら手前が、大めし食いの大力だからといって、ドジばかりを踏んでいちゃ旅先で飯にはならねえぞ。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "バカ、ドジ、マヌケといいたいのだ。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "テーブルに頭をぶつける、なんてドジを踏まないようにと注意したまでは上出来だったが、ギターを立てかけてあったのを忘れていた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "この商売は涙もろくちゃあいけねえな」「近頃こんなドジを組んだことはありません。",
              "citation": {
                "source": "半七捕物帳",
                "author": "新カチカチ山",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに気を配ばらずに、小僧っ児みたいな、気焔をあげるのが、ドジさ。",
              "citation": {
                "source": "放浪の宿",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「草花や、草花や」が、「ナスの苗、キウリの苗、ヒメユリの苗」といふ聲に變つたかと思ふと瞬く間に、「ドジヨウはよござい、ドジヨウ」に變り、軈て初夏の新緑をこめた輝かしい爽かな空氣の波が漂うて來て、金魚賣りの聲がそちこちの路地から聞えて來た。",
              "citation": {
                "source": "崖の下",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "高校時代から西さんは特異な才能を感じさせていたようで、「シルクスクリーンで玄人はだしのレコードジャケットをデザインしていた」ことが、井上さんには印象深かったらしい。",
              "citation": {
                "source": "短く語る『本の未来』",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "乞食が貴婦人を診察しているんだ」「……ダ……大丈夫ですか」　とドジを踏んだ運転手が、吾輩の顔を覗き込んだ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまらねえ思いつきで、小さい仕事に手を出して、ドジを踏まず、寝酒の支度でもしてお置きよ」　お初が、そう言うと、「へえ？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいらにも似合わねえドジをふんでね、少しばかり馬鹿を見た。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは妾は座を外し」「うん、そうさな、では少しの間、座を外して貰おうか」「はい」と云って出て行くお米、主人庄司甚右衛門はスルスルと前へ膝行ったが、「客人、いやさ勾坂甚内、大泥棒にも似合わねえドジな真似をするじゃねえか」　両手を袖へ引っ込ませると、バラバラと落ちて来た小判｜幾片。",
              "citation": {
                "source": "三甚内",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あげくに私がドジをふんでも、私だって、たまにはドジをふんでも、意地わるをしてみたいものだ。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは少いがお礼にとって置け」「どうも親分すみませんな」「あの若僧の死骸は浮き上るようなことアあるまいな」「永年の荒療治稼業、そんなドジを踏むようなわっしじゃございやせん」　青年はいまし方出て来た汽船の方へかえって行った。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "意地わるの男がアルカンなどときまっていて、ピエロはコロンビーヌにベタ惚れなのだがふられ通しで、色恋に限らず、何でもやることがドジで星のめぐり合せが悪くて、年百年中わが身の運命のつたなさを嘆いているのである。",
              "citation": {
                "source": "土の中からの話",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルユイ（小蟹）、ソガリ（鰍魚）、フナ、ヒガイ（鰉）、ドジョウなど、いずれも眼下に眺める大同江の水から漁ったものだそうだ。",
              "citation": {
                "source": "淡紫裳",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "フナとドジョウとヒガイは内地のものにくらべて、少しは劣ると思った。",
              "citation": {
                "source": "淡紫裳",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
