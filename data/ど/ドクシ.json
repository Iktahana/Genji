[
  {
    "uuid": "5b688c3e-bfc9-5335-abde-c1db7d93a740",
    "entry": "毒死",
    "reading": {
      "primary": "どくし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "実にあの義人哲学者は、すべての俗衆的愚劣のもの、俗衆的先入見を憎悪し、これによって獄に毒死されたのである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「案の定――」「毒死か！",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「寿、中山数馬」　はっきりと、あの毒死をとげたご宝蔵おん刀番の名が見えるのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "身に覚えのねえものが、中山数馬の毒死を知っているはずはねえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "可賀にさえも毒死の一件はあかさなかったんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "屍体にも外傷は愚か、中毒死らしい徴候さえ、残されていないのである。",
              "citation": {
                "source": "失楽園殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（調所殿が、敵党の奸策にかかって、毒死なされた上は、是非もない）　と、仲太郎は、決心したのであった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「毒死致した調所、あれから、密貿易の証拠品を盗み出した。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "調所は、そのために毒死したのじゃ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すっかり事切れている――どうやら中毒死のようだ。",
              "citation": {
                "source": "麻雀殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "早速、警察医の手で診察がおこなわれた結果、中毒死であることが明瞭となった。",
              "citation": {
                "source": "麻雀殺人事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「自然死か毒死かの判別は不幸にして明瞭でない。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "毒死を立証する反応は明瞭に出て来ない。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人の毒死が判り、一夜を明した男のあるのも判っているのにも係わらず、この事件は又、遂に結論を『自殺』へ持って行かねばならないのか。",
              "citation": {
                "source": "赤耀館事件の真相",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は真一の死を中毒死だと思っているのだ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小使さんの猫玉ちゃんが、トラ十へさし入れのすしを盗み食いをして毒死した、という事件が、ここの署員たちをたいへん驚かせ、そして、田所検事へ急報せられたというわけであった。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「婦人ノ推定年齢ハ二十二歳、目下姙娠四箇月ナリ、死因ハ未ダ詳カナラザレド中毒死ト認ム」　この報告は捜査本部の話題となった。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「姙娠四箇月とは気がつかなんだねえ」「中毒死とすると、誰に薬を呑まされたんだろう」「自殺じゃないかネ」「それは違う。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に松本泰氏になると、自己経営の「探偵文芸」へ、「毒死」「指紋」「蝙蝠傘」「不思議な盗難」というような、好箇の短篇を発表した以外、諸雑誌へも幾多の創作をかかげ充分奮闘を致しました。",
              "citation": {
                "source": "探偵文壇鳥瞰",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "過失によるガス中毒死という事になったのです。",
              "citation": {
                "source": "血液型殺人事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば、「悪霊」でスタヴローギン公爵の縊死に出逢い、或は更に写実的なものとされる作品、「ボヴァリー夫人」で、夫人の服毒死に出逢っても、読者は、彼もしくは彼女の現実的な死滅に当面しはしない。",
              "citation": {
                "source": "文学に於ける構想力",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女を毒死の罠にかけようという意向が聊かでも私にあったろうとは、私自身が承認しないことである。",
              "citation": {
                "source": "紫の壜",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ、な、決して、その、毒死ではない、物中の為め頓死で御座りましょうで、御手数ながらその御見立を一札どうぞ」「や、心得て御座る。",
              "citation": {
                "source": "備前天一坊",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "決してこれは毒死では御座らぬ。",
              "citation": {
                "source": "備前天一坊",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "オリヴアの「中毒死及その実例」に、六年前ニースのホテルで起った事例が記述されている。",
              "citation": {
                "source": "黒い手帳",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は新十郎をふりむき、「一見して毒死の徴候歴然です。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしても毒死でなければならないということ、小柄を刺しこんだのは毒死をごまかす手段に相違ないということは、昨夜から確信いたしておりました。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その一　舞踏会殺人事件",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
