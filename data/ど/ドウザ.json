[
  {
    "uuid": "7043393b-9c49-55f9-b1c7-e2bb0f78d2ec",
    "entry": "同座",
    "reading": {
      "primary": "どうざ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sitting together",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会食の席で、偶然にも旧友と同座することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は重要な会議で、社長と同座して議論を交わした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "結婚披露宴では、新郎新婦の親族がメインテーブルに同座した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "一同座敷の片側へ一列にならんで順々拝が始まる。",
              "citation": {
                "source": "祭",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一同座具を延べて三拝する。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "同座は在来の構造に種々の改良を加え、その当時の劇場としては、もっとも進歩したるものと称せらる。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "元地の猿若町に最後まで踏み留まりし同座も、遂に下谷｜二長町に移転したるなり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "同座は遂に再興せず。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "明治初年は新聞記者として、政論家として著名なりしが、後に転じて小説家となり、劇作家となり、歌舞伎座創立以来、同座にありて専ら団十郎のために筆を執れり。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "○八月、松竹会社が歌舞伎座を買収せんとし、同座一部の役員間に紛糾を生じたるが、結局松竹が手を引くことになりて和解す。",
              "citation": {
                "source": "明治演劇年表",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人利家に取っては自分の支持をするものが一人でも多いのが宜い訳だから、子息達も立派な大名である故同座させた方が万事に都合が好いのだが、そこは又左衛門利家そんなナマヌル魂では無い。",
              "citation": {
                "source": "蒲生氏郷",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "之を自己一人にて飮み盡せば、醉を得るに足り、他人と共に之を飮めば、自他共に醉を得るに足らずといふ場合に際して、自己一人にて之を飮み盡して、同座又は同寓の人に頒ち與へざるのは、福を專らにするのである。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　しかも、銑吉が同座で居た。",
              "citation": {
                "source": "燈明之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "取巻は河原崎座の作者岩井紫玉、同座附茶屋の主人武田屋馬平、品川の幇間富本｜登名太夫、同熨斗太夫、桜川善二坊、その他俳諧師｜牧乙芽、力士｜勢藤吾等であった。",
              "citation": {
                "source": "細木香以",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある酒席で、同座したとき、はしなくも人相の話が出たので、越前が人相に興味があることを話すと、左膳は、「では少し御伝授いたそう。",
              "citation": {
                "source": "奉行と人相学",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "一瓶の佳酒が有ると仮定する、之を自分一人で飲み尽せば酔いを得るに足り、他人と共に之を飲めば自他共に酔いを得るに足りないという場合に際して、自分一人で之を飲み尽して、同座又は同寓の人に分かち与えないのは、福を専にするのである。",
              "citation": {
                "source": "努力論（現代訳）",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛大いに鳴く時客人一同座に就く。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "外国人はおもに米国の人だったが、葉子は倉地がそういう人たちを同座させる意味を知って、そのなめらかな英語と、だれでも――ことに顔や手の表情に本能的な興味を持つ外国人を――蠱惑しないでは置かないはなやかな応接ぶりとで、彼らをとりこにする事に成功した。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その上に、惣八郎と同座していると、命を助けられたという意識が、一種の圧迫を感ぜしめて、かなり不快であった。",
              "citation": {
                "source": "恩を返す話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十年九月には中洲の真砂座で「乳房榎」を上演し、翌三十一年二月には同座で「真景累ヶ淵」を上演した。",
              "citation": {
                "source": "寄席と芝居と",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊にその当時わたしは新聞記者生活をやめて、小一年ほど浪人していたので、猶更なんにも聞くべき便宜を持たなかったのであるが、ただ一度、同座の榎本虎彦君に逢った時に、わたしがその話をすると、榎本君は冷笑して、「なにさ、芝居師は儲けさえすればいいと思っているんだよ。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "同座の「盲長屋梅加賀鳶」で、お民という子守女。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "同座の「恋闇鵜飼燎」で、お夏という商家の娘などで、勿論そのほかにいろいろの立役も勤めていたのであるが、かれが好評を博した役々はいつも娘形であったらしい。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌舞伎座からちょっと来てくれという通知をうけ取って、岡君とわたしは午後四時頃から同座の仕切場へ出てゆくと、二階では稽古最中で、仕切場には大勢の人が押合って混雑していた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "菊五郎のあと釜というような意味で新たに加入させた権十郎も、近年やはり多病で、わずかに一回かぎりで同座を退き、鎌倉の別荘に引き籠ることになってしまったので、更にそのあと釜として大阪から片岡我当をまねくことになった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、最初の同座でどちらもそんなに大笑いをしてしまったということは、お互の羞しさも警戒も吹き飛ばしてしまったのと同様なのだから、それからはもう一座は和気｜藹々となって、しばらくはなるだけ面白そうな話ばかりを誰も彼も饒舌り出した。",
              "citation": {
                "source": "馬車",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "月郊君も何うやら川上の意は察したらしかつたが、実は伊藤公とは生れて初めての同座で、今後またこんな機会があらうとも思はれない。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "同座していられた宇野千代さんが、それに賛成され、本当にそうしたら亭主のことでも悪く書けていい、という意味のことを云われ、私はその時大変困った。",
              "citation": {
                "source": "パァル・バックの作風その他",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "現今の如き戸別割の賦課なく、藩主への税納を高に割賦せし時代の無高は村にても蔑視され、高持とは同座し得ず。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、同座の中野好夫に向って、あなたもこれから批評家としてやって行くためにはこの点だけはよく心得ておきなさい、といった意味を、きわめて高びしゃに申しわたしている。",
              "citation": {
                "source": "現代文学の広場",
                "author": "――創作方法のこと・そのほか――",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十四のとき、当時米国から帰朝した同門の田村松魚と結婚する迄の俊子は久米八と同座したり川上貞奴の許に出入りしたりして女優生活を送りながら、新しい時代の文学の空気の中に生きていたのであった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう話が同座の人々の中で一致した。",
              "citation": {
                "source": "折たく柴",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この新脚本は同座の委員会では余り歓迎されなかつた。",
              "citation": {
                "source": "フランソア・コッペ訪問記",
                "author": "堀口九萬一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "the same theater (theatre)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その芝居は、前作と同じ劇場で同座公演されることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "有名俳優二人が、同じ年に異なる作品で同座することになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は長年、その小さな劇場で同座し、舞台芸術に貢献した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "involvement",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その不正事件には、複数の政治家が同座している疑いが持たれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は友人の事業に同座し、共同経営者として成功を収めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "今回のプロジェクトには、多くの国際企業が同座して取り組んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
