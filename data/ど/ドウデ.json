        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それらの事情がその後土井が読んだドウデエの「少なやくざもの」に、よく似てゐるのであつた。",
              "citation": {
                "source": "閾",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウデス、婦長さん、スバラシイ話でしょう。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "癇癪くらべ　そんな事はドウデモ宜い。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この不景気のさ中に、妹と二人切りで、利子の薄い、限られた貯金を使って、ドウデモコウデモ学校を卒業しなければならないという、兄らしい意識で、いつも一パイに緊張して来た私は、もう自分ながら同情に堪えないくらい神経過敏になり切っていた。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "仰向けに引っくり返って太平楽を並べている読者諸君にコンナ愚痴をこぼしても初まる話ではないが、創作の中の人物の名前なんかドウデもいいじゃないか。",
              "citation": {
                "source": "創作人物の名前について",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そげな事あドウデモよかバッテン、イッソ死ぬなら俺へ形見ば遣らんか』　大惣は寝たまま天井をジイッと見した。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからコチラの法文科で古書を集めておいでになる中江｜学長さんのお宅へ持って参りましたらドウデス。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　水車小屋は、恰もドウデエ作の「風車小屋」のやうにうらぶれ、わたしの顔つきはスギヤンさんのやうな憂ひに充ちて、止むなく出立を余儀なくされ、馬の手綱を執りながら何も彼も見棄てたのは、指折り数へて見ると早くもそれはもう六年前のはなしで、青葉の淡いころであつた――などゝわたしは思ひ出したのである。",
              "citation": {
                "source": "書斎を棄てゝ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中で本家本元と言つても好いフランス文学ではバルザツクあたりにその萠芽を発して、アルフオンス・ドウデエ、フランソア・コツペイ、ゾラ、それからモウパツサンの巨匠へと行つた。",
              "citation": {
                "source": "小説新論",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "古人の作や一知半解ながらも多少｜窺った外国小説（その頃ゾラやドウデも既に読んでいた）でも全幅を傾倒するほどの感に打たれるものには余り多く出会わなかったから、私の文学に対するその頃の直踏は余り高くはなかった。",
              "citation": {
                "source": "二葉亭余談",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "バルザックやドウデエなぞを読出したのは、君の方が僕より早いぜ――見給え」「あの時分は夢中だった」と原は言消して、やがて気を変えて、「君こそ勉強したろう。",
              "citation": {
                "source": "並木",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーデエは妻と大変むつまじく暮して、部屋のこちらの端のテーブルについてドウデエが一枚小説をかくと小さい息子がヨチヨチそれをむこうの端にいる母さんのところへもって行って、そうやって仕事をした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウデエは昔「サフォ」がはじめで、いくつかの作品をよんだが、『月曜物語』は短篇集として様々の感想をおこさせる作品集です。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "短篇というものについてもメリメと比較し、モウパッサンと比較し、チェホフに比べたりすると、例えばモウパッサンの「脂肪の塊」などとドウデエの短篇とでは、同じ時期の人生の断面を其々にとらえていても捉えかたがいかにもちがう。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウデエの思い出に、原稿が一枚かけると、小さい男の児がそれをチョコチョコととなりの部屋にいるお母さんのところへ運ぶ（浄書に）光景があり、そんな風にものを書くということを昔私はびっくりして覚えています。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "父ドウデエの作品がこのように一家の歴史のすすむ酵母を既に語っている、そこが又面白く思われる。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "英語のドウデンは中身はすっかり同じです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃はレオン・ドウデエの本が訳されます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから近く、ドウデエを入れますが、その作品との連関でよまれるディケンスを入れるという風にね。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三四年（昭和九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドウデエの Passion of the south を見つけて買う。",
              "citation": {
                "source": "日記",
                "author": "一九二五年（大正十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "イギリス人とフランス人、特にドウデエなどがまざまざと特徴づけている南フランスの血が、ファブルの気象の中で境遇的にもダアウィンと撥き合ったことは人間生活の画面として無限に興味がある。",
              "citation": {
                "source": "作家のみた科学者の文学的活動",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲原君もツルゲネフやドウデ黨であつた。",
              "citation": {
                "source": "永井荷風といふ男",
                "author": "生田葵山",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　長イステツキドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　毛糸ノカタカケドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシハ　ジヤガイモ、ジヤガイモニ　十文ノオクツハドウデスカ。",
              "citation": {
                "source": "ワタシハ　ジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヒルサン、アナタノ洋服ハ一度アラツタラドウデスカ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ハドウデモイヽッテ云ウカモ知レナイケレド、浄吉ハコノトコロ旅行バカリシテタジャナイカ」「ソレガ何ナノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウデスカ、少シハイヽ方デスカ」「イヽドコロカ、マス／＼悪クナル一方ダ」「ダッテ、髯ナンカ剃ッテサッパリシテルジャアリマセンカ」予ハ実ノトコロ、手ガ痛ムノデ剃刀ヲ使ウノモ不自由ナンダガ、ソレヲ怺エテ今朝剃ッタバカリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タトエバ伏見区竹田内畑町ニアル安楽寿院五輪塔、水輪ガ下ノ方デ細マッテ壺形ニナッテオリ、火輪ノ軒ノ反リガ厚ク、ヤダルミノ工合ガ風輪空輪ノ形ト共ニ鎌倉中期カラ後期ニ移ル頃ノ代表的ナ遺品デアルト、川勝政太郎氏ガ述ベテイルアノ作品、アレナドハドウデアロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
