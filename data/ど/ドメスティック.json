        "examples": {
          "standard": [
            {
              "text": "彼の考え方は非常にドメスティックで、世界情勢には疎い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の議論はドメスティックな視点に偏りがちで、国際的な視野に欠けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その村では、ドメスティックな問題にばかり意識が向けられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
