        "examples": {
          "standard": [
            {
              "text": "子供の頃、裏山でドドメを摘んで食べた思い出がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ドドメの実は甘酸っぱくて、ジャムにすると美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "庭に植えた桑の木に、たくさんのドドメが実っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "全国を通じて最も多いドドメキまたはドドウというのがこの県にもまたかなり分布している。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
