        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ドッドドドドウドドドウドドドウ、あまいざくろも吹きとばせ、すっぱいざくろも吹きとばせ、ドッドドドドウドドドウドドドウ、ドッドドドドウドドドードドドウ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドッドドドドウドドドウドドドウ、　楢の木の葉も引っちぎれ　とちもくるみもふきおとせ　ドッドドドドウドドドウドドドウ。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シバラク　スルト　タニ川ノ　オトガ　ドドドドト　キコエテ　キマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、それから間もなく、何事が起こったのであろうか、ドドドドンと、けたたましい太鼓の音。",
              "citation": {
                "source": "紅毛傾城",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、追々に遠去かって行ったその爆音は、どうしたことか十分もすると、再びドドドドドド……と鈍く澱んだ空気を顫わして、戻り高まって来た。",
              "citation": {
                "source": "動かぬ鯨群",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドドドドと重く地をふるわすとどろきにまじって、わーッ、わーッと人々の喚声がつたわって来た。",
              "citation": {
                "source": "新しい婦人の職場と任務",
                "author": "――明日の婦人へ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドドとその橋はとりとめもない呟きを残してゐた。",
              "citation": {
                "source": "潮干狩",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、ドドドドドと軽い響が伝はつて、Ｋ橋が見えて来た。",
              "citation": {
                "source": "潮干狩",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "水の上に映るＫ橋はドドドドと軽く揺れてゐるのだつた。",
              "citation": {
                "source": "潮干狩",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "来ると、一突きだぞ……」　が、その時、長庵とお六に教えられた三羽烏他一同が、ドドドドッ！",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに続いて、ドドドドッという激しい銃声が遠くに聞えた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドドドドドーン。",
              "citation": {
                "source": "崩れる鬼影",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかし……次の瞬間……ドドドドッという足音が響いた。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドッという二人の足音！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドッという足音！",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドドドドと崩れる足踏みの音。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
