  {
    "uuid": "82a4fab3-b55d-5833-a23b-675e91eae4d0",
    "entry": "ドドドド",
    "reading": {
      "primary": "どどどど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
