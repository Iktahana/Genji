        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "堰堤の内の半ば乾あがった赤濁った潮の中には、数百の人夫が散らばって、沙を掘り礁を砕いていたが、其のじゃりじゃりと云う沙を掘る音と、どっかんどかんと云う石を砕く音は、波の音とともに神経を掻きまぜた。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっかん、どっかん、どっかん。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "人夫はまた右側の礁の方へ往って、どっかんどっかんとやりだしたが、釜礁にかかる者はなかった。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "釜礁の方には、もうどっかんどっかんの音が盛に起っていた。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっかんどっかんの音はまた聞えだした。",
              "citation": {
                "source": "海神に祈る",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブルジョア、地主、坊主が、社会主義社会建設のために働くプロレタリアの鉄の鎚で、それぞれ頭をドッカン、ドッカンやつけられながら進んで来る。",
              "citation": {
                "source": "勝利したプロレタリアのメーデー",
                "author": "――モスクワの五月一日――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
