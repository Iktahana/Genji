        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "◯これに反して十八世紀の大文豪にて、信仰の人たりしドクトル・ジョンソンは、死の床に大なる苦悶を味いしという。",
              "citation": {
                "source": "ヨブ記講演",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "津田ドクトルのお見立てでは、Pest の疑いがあり、絶望を宣告されたのですが、非常な誤診でした。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人の興味は直き次に移って犬のドクトルが部屋に呼び付けられた。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドクトルはやはり寒い側部屋で酒に餓えさせ乍ら獣の黄色い牙を磨かせて置く方が興味価値があったのだのに。",
              "citation": {
                "source": "バットクラス",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人公の日本人の名がドクトル・タケラモ・ニトベというのだそうで、このタケラモだけでも行って見る気がしなくなります。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひやかしていると、「ドクトルの旦那さん、降誕祭贈物はいかがです」と呼びかけるのもありました。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "先生は結婚後まもなく夫のドクトルに死なれ、退役軍人の父親と、夫の忘れがたみで、当時十四ぐらいであった娘のヒルデガルトと二人でさびしく暮らしていた。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドクトル、ベエアマンはここで花崗岩の破れ目の出来方について講釈をして聞かせた。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "アフリカに行っていたドクトルＭはズアヘリ土人の歌というものを歌って聞かせたが、それがどれだけ本当のものに似ているかそれは誰にも分らなかった。",
              "citation": {
                "source": "異郷",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こういう、たとえば花を包んだ千代紙のような論文がドイツあたりのドクトル論文にはおりおり見受けられる。",
              "citation": {
                "source": "備忘録",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少なくともドクトル・ルーシンは、じきにわたしの腹を見抜いた。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「ねえドクトル、この子を叱ってやって下さいな。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「証文の出しおくれよ、ドクトル先生。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで、あなたは、ドクトル……」彼女は言いよどんだ。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "之は露国ワルソウの人だから詰り波蘭人だ、其波蘭人のドクトル、ザメンコフといふ人の発明で、かのウォラビュックなどから視ると、遙かに自然的で無理が少ないから、忽の中に非常な勢で諸国に弘まつた。",
              "citation": {
                "source": "エスペラントの話",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おい、ドクトル」と、彼は言い出した。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "（捕鯨者仲間では鯨を体の長さで計らず、その鬚の長さで計るのである）　さて、ドクトル。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねえ、ドクトル、給仕を内部へ入れないでくれたまえ。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おそらくそうであるかもしれず、そうでないかもしれないよ、ドクトル」と、彼は言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さて、ドクトル」と、彼は言った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでドクトルＰ氏に出逢った。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "栗栖はドイツ物のタイトルを読むのが敏く、詳しい説明をして聞かせるのだったが、映画に限らず、この若いドクトルの知識と趣味は驚くほど広く、油絵も描けば小説も作るのであった。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "後になって葉子もたびたび逃げ出したし、庸三も逐い出したりして、別れた後ではきっと、床を延べて寝ることにしていたが、近所のドクトルに来てもらうこともあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "庸三はドクトルの指図で、葉子の脇腹を膝でしかと押えつける一方、両手に力をこめて、腿を締めつけるようにしていたが、メスが腫物を刳りはじめると、葉子は鋭い悲鳴をあげて飛びあがろうとした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "メスをもった婦人科のドクトルは驚いて、ちょっと手をひいた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "何といっても内科と婦人科のドクトルのメスには、手ぬるいところがあった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそう思ってみると、ぴんと口髯の上へ跳ねたこのドクトルの、型で押し出したような顔のどこかに、梢家の血統らしい面影も見脱せないのであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ドクトルは傍へ寄って来て勧めた。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのドクトルが今夜も来ているのであった。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
