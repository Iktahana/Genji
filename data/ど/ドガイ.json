[
  {
    "uuid": "7f4a64c2-574f-5fa0-959b-ce0128ea9cec",
    "entry": "度外",
    "reading": {
      "primary": "どがい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
