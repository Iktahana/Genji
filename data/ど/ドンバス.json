        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "炭坑の黒さ、重さ、やかましさ、実に浮き出していて、ドンバスで、長靴はいて坑内を歩いたときをまざまざ思い出します。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はドンバスの炭坑から、ヴォルガ沿岸地方から、またごく辺鄙な農村から出て来たコムソモール達だ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キエフ市はソヴェト第一の大炭坑区ドンバス地方に近い。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "五ヵ年計画まではソヴェト唯一の炭坑区だったドンバスで、一九二八年大陰謀が発覚した。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一九三五年になるとドンバスからは一塊の石炭さえ産出しないように技術的な破壊が企てられていた。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンバスに外国資本が投資されていた帝政時代から働いていたドンバスのドイツ人技師が中心であった。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンバス炭坑区を近くに持ち、大国営農場、機械工場をもち五ヵ年計画とともにソヴェト同盟の南方地域では屈指の重工業、農業の生産中心地となった。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
