          "literary": [
            {
              "text": "弟子は大きな銅鉢に、何かの薬をいつぱい盛つて、布巾を添へて持つて来た。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟子がも一人、もひとつ別の銅鉢へ、別の薬をもつてきた。",
              "citation": {
                "source": "北守将軍と三人兄弟の医者",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "翁は暫く身を屈して、少女のさまを覗ひ居たるが、やをら岸に登りて、きと眼を我姿に注ぎ、空中に十字を書し、彼｜大銅鉢を抱いて舟中に移し、己も續いて乘りうつれり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
