        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎年正月には、家族で同社へ初詣に行くのが習慣だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古文書によると、この地域にはかつて同社と双璧をなす大きな神社があったらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "地域住民によって、同社の清掃活動が定期的に行われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
