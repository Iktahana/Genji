        "examples": {
          "standard": [
            {
              "text": "ハロウィンの仮装パーティーに向けて、マントを新調してドラキュラになりきった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はホラー映画が大好きで、歴代のドラキュラ俳優をすべて把握している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い洋館を舞台にしたドラキュラの小説を読み耽っていたら、夜が明けてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "」11ゾンビたちも楽しんでいたパーティーは、まだはじまったばかりゲストは狼男とドラキュラ、それにドラキュラの息子〈モンスター・マッシュ〉ボビー・“ボリス”・ピケット　寮の玄関がこれだけ騒々しいのは、めったにあることではない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガイコツとか、ドラキュラとか、いろんなものが出てきたが、そういうものには、だれもおどろかなかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
