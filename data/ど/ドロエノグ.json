        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供の頃、泥絵の具を使って大胆な絵を描くのが好きだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "泥絵の具は、水彩絵の具よりも色が濃く、重厚な表現ができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い家屋の壁を泥絵の具で塗り直し、温かみのある空間にした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その手――檜を彫って、泥絵の具を塗った筈の手は、柔かに長次の背後に廻されて、木と綿とで出来て居る筈の胸には、明かに鼓動を感じたのです。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第六夜　人形の獄門",
                "note": "青空文庫"
              }
            },
            {
              "text": "前口上はお退屈のもと、いよいよ錦太夫をお目通りまで控えさせまアす」　チョン、と木が入ると、浅黄幕を切って落す、――舞台正面は泥絵の具で描いた弁天様の遠見、程よいところに控えて居るのは、水の垂れそうな島田娘、わざと黒地の大振袖に、蜀紅錦の肩衣、物馴れた調子で、土間一パイの観客に微笑を送ります。",
              "citation": {
                "source": "新奇談クラブ",
                "author": "第八夜　蛇使いの娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋は筵張りの全く間に合わせの代物、泥絵の具で存分に刺戟的に描いた、水中に悪龍と闘う美女の絵を看板に掲げ、その下の二つの木戸口には、塩辛声の大年増と、二十五六の巌丈な男が、左右に分れて客を呼んでおります。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "人魚の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "はげて、くすんだ、泥絵具で一刷毛なすりつけた、波の線が太いから、海を被いだには違いない。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰衣のような幅広の前掛したのが、泥絵具だらけ、青や、紅や、そのまま転がったら、楽書の獅子になりそうで、牡丹をこってりと刷毛で彩る。",
              "citation": {
                "source": "縷紅新草",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "或時は無地物に泥絵具でやたら縞を描いたのを着ていた。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "周囲を杉の皮で張って泥絵具で枝を描き、畳の隅に三日月形の穴を開け、下から微かに光線を取って昼なお暗き大森林を偲ばしめる趣向で、これを天狗部屋と称していた。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥絵具は絹や鳥の子にはかえって調和しないで、悪紙粗材の方がかえって泥絵具の妙味を発揮した。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿岳は常から弱輩のくせに通人顔する楢屋が気に入らなかった乎、あるいは羽織の胴裏というのが癪に触った乎して、例の泥絵具で一気呵成に地獄変相の図を描いた。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "浅草絵は浅草紙に泥絵具で描いたものにしろ、十二枚一と袋一朱ではナンボその頃でも絵具代の足しにもならなかったは明かである。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど私はうかうかと青の泥絵具を、紅を塗るべき天狗の面になぞっているのに気がついた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど私はうかうかと青の泥絵具を、紅を塗るべき天狗の面になぞつてゐるのに気がついた。",
              "citation": {
                "source": "鬼涙村",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "型を置いては、泥絵具をベタベタ塗りさえすればいいのである。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山の奥深いところにこの樹があるのだと云うけれど、その葉っぱはどんなかたちをしているのかしら……粛々としたその姿を胸に描きながら、私は毎日こうして、泥絵具をベタベタ塗りたくっているのだ。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "軒一つの境いで、風景や静物や裸体を描いている画学生と、型の中へ泥絵具を流してはそれで食べている女と、――新聞を見ると、アルスの北原という人の家で女中が欲しいと出ている、勉強をさせてくれるかしらとも思う。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥絵具で、少々、イヴァン・モジュウヒンはにやけている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは私が勝手に呼んだ名であって、原名を何んというのか知らないが、とにかく一人の男が泥絵具と金紙で作った張ぼての蛸を頭から被るのだ、その相棒の男は、大刀を振翳しつつ、これも張ぼての金紙づくりの鎧を着用に及んで張ぼての馬を腰へぶら下げてヤアヤアといいながら蛸を追い廻すのである。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那や朝鮮では、目下製造されつつあるようだが、それは主として支那絵や日本画の方法と同じく墨をもって線描きが施され、泥絵具が膠で溶解されて塗られているものである。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "絵具としては泥絵具、金銀泥が用いられている。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "あるいは、粉末の泥絵具をニスの類を交えてペンキのごとくして用いられていると考えられるものもある。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはやはり泥絵具と墨であり絵具は膠で固められているようだ。",
              "citation": {
                "source": "油絵新技法",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "女の子たちの着物の色が染色の関係からどれも泥絵具式に混濁していて、所謂キレイな色ほどひどく濁り、それに布地の節約からおそろいの服をつけている姉妹が大変目につきました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "後をふり返ると、土手の松にまじつて、半開の桜が、べつたり泥絵具をなすつてゐた。",
              "citation": {
                "source": "世之助の話",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがては霜になろうとする霧が、泥絵具の茶と緑を混ぜて刷いたような山並みに淡く漂って、篩いかけたような細かい日差しが向うにポツネンと立っている※角子の大木に絡みつき、茶色に大きい実は、莢のうちで乾いた種子をカラカラ、カラカラと風が渡る毎に侘しげに鳴りわたる。",
              "citation": {
                "source": "禰宜様宮田",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、私の感覚は、空は淋しく濁った一面の白に感じ、その前に聳えている青桐の梢は泥絵具のような重い黒で感じているのであった。",
              "citation": {
                "source": "芸術が必要とする科学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥絵具で描いた看板の強い色彩。",
              "citation": {
                "source": "大菩薩峠",
                "author": "女子と小人の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここではまた、例の亜欧堂風の大看板を、泥絵具で塗り立てている幾人かの看板師。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白骨の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "油絵師の誰かが泥絵具で天使とカリスを書いたかなり美しいもので、このような四郎の附属品から見ても、彼の日用品は決してバラック的ではなかったに相違ない。",
              "citation": {
                "source": "安吾史譚",
                "author": "天草四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、そのころの御布令で、興行物は大概暮れ酉刻（六時）でお仕舞いになり、小屋は木戸を閉ざして、夜店の灯りだけが、寂しく泥絵具の看板を照らしております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "素焼きのお狐に泥絵具を塗って、一つが十二｜文、あれは懐中へ忍ばせておくと、願い事が叶うとか言って、手弄みをする手合がよく持っていますが――」「それだよ、そのお狐を若い女が袖に忍ばせているのも可怪しいが、何かの機みで落っことすと、乾き切った往来の上で尻尾が欠けた。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鈴を慕う女",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
