    },
    "definitions": [
      {
        "index": 1,
        "gloss": "thud",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "本が机からドサと落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重い荷物をドサと床に置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "突然、隣の部屋からドサという音が聞こえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "当主は、寝ている処を、いきなり丸太ん棒、それも樫の木の、潜り門用の閂でドサッとやられたので、遺言を書こうにも書くまいにも、眼の覚める暇がなかったのであった。",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、最後に、猪川幹太郎は、このドサクサ騒ざに、家も、仕事も、子供も、すっかり失ってしまった。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "撮影の前のドサクサにまぎれて、いつのまにやら、ちゃんと最前列の先生の隣席に坐ってニヤリと笑っている。",
              "citation": {
                "source": "小さいアルバム",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内ドサリと音がして「ヤッ」という声がした。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロデ、ソノ　ムラハ　アサニ　ナツテモ　ダレモ　オモテニ　デテ　クル　モノハ　ナク、マドサヘ　アケナイノデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "映画ファンならば、この辺でプロマイドサインを願う可きと存候え共、そして小生も何か太宰治さま、よりの『サイン』に似たもの、欲しとは存じ候え共、いけませんでしょうか。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の夕方、京吉の財布を掏った北山を大阪の中之島公園までつけて行って、首をしめられそうになったが、拘置所の脱走さわぎのドサクサで危く助かった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると落城のドサクサまぎれに、流産したかも知れないし、淀君など云うものは、生れて来なかったかも知れん。",
              "citation": {
                "source": "姉川合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、欠伸しながら、ドサリと坐った。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」十吉「……掛けようと思ったんだが、雨が降ったドサクサまぎれに、見えなくなったんだよ、その前に、君は尾形君の妹さんと話していたろう？",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "有司が前陣に立って勧めた薬が利き廻って今日ドサクサするに及び、ヤレ汽車賃を割引するから参宮に出掛けよとか、ソラ国費を以て某々の社を廓大しようとか大騒ぎに及ぶは既に手後れの至りで、汝の罪汝に報う「世の中の、うさには神もなき物を、心のどけく何祈るらん」と諸神が平家を笑うだろう。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "椅子の足は滑りし、余の足は強くテーブルの底を蹴る、かくして余は横の壁をめがけて仰向けにドサン！",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、――あゝ偶然なり、――テーブルにしがみついたれどそれは余の大力に引よせられて、それも一緒に……ドサン！",
              "citation": {
                "source": "〔編輯余話〕",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「無論書きますよ、然し僕は現在では書く気がしません、私は暫く自分の生活を瞶めた後で、ほんとうに書いたといふ気持が自分の胸にドサンと響く様なものを……」「飽までも体験に待つ。",
              "citation": {
                "source": "眠い一日",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も御維新のドサクサが直ぐ起ったのですからね」と祖母は昔を想い出したような、懐旧的な情懐に沈んで行ったようでありました。",
              "citation": {
                "source": "ある恋の話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東洋の」秘密教団と、デコボコ二人組のマッドサイエンティストに狙われ、バッキンガム宮殿や、アルプスや、バハマを逃げまわるビートルズの物語のなかに――。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等が今度の震災のドサクサを機会に、どれだけ沢山の「玉」を探し出したかは想像に余りある。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの名状すべからざるドサクサが、どれだけ上流の家庭に平民式を煽り込んだか。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に、堕落気分を持ちながら実行出来なかったものが、あのドサクサに紛れて思い切って堕落したとも見られる。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この記事中に出て来る事実は、今迄のは無論の事、これからの記事の中で最も甚だしい一つでも、平生の新聞の社会面に現われる記事のヒドサよりもヒドクないつもりである。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "正にバラックの「安ッポサ」と「アクドサ」を極度に発揮したものである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "急いで外へ出て見ると、俺のすぐ前へ、ドサンと肉体が落ちて、弾みもしないで、タタキへのさばりやがった。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "外套のない百姓は、着物を絲で刺したドサを頭からかぶつてやつてきた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そう云って、ズックの鞄をドサリと投げ出した。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫は卓子の上へドサリと鞄を置いた。",
              "citation": {
                "source": "俘囚",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "小使は室のうちにドサリと夜具を置いて、さも重かったというように呼吸をついたが、昼間掃除しておいた三｜分心の洋燈に火をとぼした。",
              "citation": {
                "source": "田舎教師",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをきゃつめがドサクサまぎれに。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「巻軸取りの連中は、天草以外にも沢山あるが、傀儡仕込みの火術をもって、天草一味を混乱させ、ドサクサまぎれに奪い取ったことを、知っているものはない筈だ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドサクサまぎれに引っさらい、逃げて行きたいんでございますよ。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
