        "examples": {
          "standard": [
            {
              "text": "ゴルフコンペの最終ホールで行われたドラコンで、彼は見事なショットを放ち優勝した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は筋力トレーニングを欠かさず、ドラコンの大会に出場して飛距離を競っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ドラコン狙いで力みすぎたせいか、ボールは大きく曲がってOBになってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "フィリップ氏曰く、竜の英仏名ドラゴンは、ギリシアにドラコン、ラテンのドラコより出で、ギリシアのドラコマイ（視る）に因んで、竜眼の鋭きに取るごとしと。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　銅像は微笑んでいるが、ドラコン像のように毅然としている。",
              "citation": {
                "source": "理想",
                "author": "THE IDEAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼にはテサロスとドラコンの２人の息子および多数の弟子がいた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
