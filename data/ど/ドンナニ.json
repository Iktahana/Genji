    "definitions": [
      {
        "index": 1,
        "gloss": "how",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「今日のテスト、どんなに難しかった？」と友人がため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼はどんなに速く走れるのか、誰も知らない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女が新しい家をどんなに気に入っているか、その笑顔を見ればわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "自分だけでどんなに立派にやれても、根だけはないのだ。",
              "citation": {
                "source": "詩壇への願ひ",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたどんなにして名前なんかを考へ出すの、あたしの一寸知つてる人はね、男だつたら自分の学校友達なんかゝら、女のだつたら恋人や恋人のお友達の名を色んなにモヂて作るんですつて。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あたしがどんなに退屈御存知ないの？",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃、室生の創造した新らしい詩が、どんなに深く私を感動せしめたことであらう、私は日夜に彼の詩篇を愛吟して手ばなすこともできなかつた。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この道をも私は通る」以下の詩、及び淫売婦に贈つた数篇の詩篇をよむものは、どんなに長い間、彼が霊的に苦しんで居たか、そして今の彼がどんなに健全で高潔な愛の信仰の上に立つて居るかを知るであらう。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに自分が、アナアキスチックの自由に憧憬してゐるか。",
              "citation": {
                "source": "芥川龍之介の死",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真暗いので、どんなに助かるかわからない。",
              "citation": {
                "source": "弱者の糧",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と質問してみて下さい、と答えて逃げ去ったとかいう話しがあるけれども、何千万年まえの世界には、どんな動物がいたか、一億年のちにはこの世界はどんなになるか、そんな話は、いったい実になるものかどうか。",
              "citation": {
                "source": "答案落第",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに小さいことでもよい。",
              "citation": {
                "source": "葉桜と魔笛",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなにぼろぼろでも自分専用の楯があったら」「あります」私は思わず口をはさんだ。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「兄さんがいらっしゃったら、きょうは、どんなにお喜びだったでしょうね。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お帰りの日までは、どんなに親しい人にだって手をふれさせずに、なんでも、そっくりそのままにして置かなければ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、今仮に詩的性情を持つ一青年があつたとして、かの成巧せる実業家、成巧せる政治家が、子供や孫、一族郎党でもゐなかつたとしたら、どんなに退屈するものであるかは、一寸理解され難いのである。",
              "citation": {
                "source": "詩と其の伝統",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれが外国人だから嫌な表情にみえないんだが、日本人だつたらどんなに嫌に見えるだらう。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども竹山俳優監督係夫人といふことは、盲同然の人間の寄り集つてゐる所ではその人間の価値如何のどんなに大切な標準器になるかは言ふまでもない。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがどんなに悲しむべきことであるかは、知る人ぞ知る、とても悲し過ぎて、今茲で簡単にその証明をするわけには行かぬ。",
              "citation": {
                "source": "よもやまの話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "當時僕がどんなに深く感動したかは、その時讀んだ本の各頁に、鉛筆で無數の書き入れや朱線がしてあるので、今もその古い本を見る毎に、新しい追憶の感銘が興るほどだ。",
              "citation": {
                "source": "初めてドストイェフスキイを讀んだ頃",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春先の植物界はどんなに恐ろしく物狂わしいものであろう。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで都会に入り込んでいる「田舎の人」がいなければどんなに静かな事であろう。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この忙しいのにどんなに世話を焼かすか知れぬと頭ごなし。",
              "citation": {
                "source": "高知がえり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "素直に讀者の聲を聞き、自身のまづしい仕事を、そんなにも懇切に讀み、考へて呉れたことに就いては、どんなに感謝するかわからない。",
              "citation": {
                "source": "「人間キリスト記」その他",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母も、どんなに喜ぶか知れない。",
              "citation": {
                "source": "このごろ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに安樂な暮しをしてゐても、自分の家が、自分の里が、自分の頭の片隅にこびりついて離れぬ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "手なんか握られたら、どんなにひどい仕返しをするかわからない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれは、もう、」と言ひかけて、這ひ寄つて來た大きい蜘蛛を素早くぺろりと食べ、「おれは、もう、どんなに嬉しいか、いつそ、男泣きに泣いてみたいくらゐだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、おれは、食慾が、ああ、そのために、おれはどんなにきまりの惡い思ひをして來たか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぜんたい私が、あなたのやうな人と一緒になつたばかりに、朝夕どんなに淋しい思ひをしてゐるか、あなたはご存じ無いのです。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなに貧乏をしてゐても、夕食の時などには樂しさうに世間話をして笑ひ合つてゐるぢやありませんか。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんなにお照さんに逢ひたいのか、毎日毎日この竹藪を搜して歩いて、さうしてたうとうこんな有樣になつてしまつて、氣の毒ぢやないの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
