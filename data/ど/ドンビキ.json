    "definitions": [
      {
        "index": 1,
        "gloss": "being put off (by someone's words, behaviour, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼のあまりにも寒いジョークに、会場はドン引きしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女の非常識な発言に、周りの人たちは皆ドン引きした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "デート中に元カノの話ばかりされて、正直ドン引きした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "┌どんぐり　┌どんぐり先生（一洵）“三鈍”│どんこつ　│どんこ和尚（澄太）　　　　└どんびき　└どんびき老豆腐の佃煮とは！",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんびきが寒いのでひつこんでゐたが、また出て来た、今夜もあぶなく踏みつけるところだつた。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちよつとポストまで、途上、どんぐり先生に逢ふ、明朝出立、どんこ和尚を訪ねるといふ、どんびき翁からよろしくとたのんでおいた。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "zooming out or pulling the camera back to get a wider image",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
