          "standard": [],
          "literary": [
            {
              "text": "ドラマチカルでないと云うのですよ。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドラマチカルな、巧妙な對話を組み立てることも出來る。",
              "citation": {
                "source": "長谷川辰之助",
                "author": "森林太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然れども凡てのドラマチカルの事蹟を抹殺し去りても、文覚が其妄愛に陥りし対手を害せし事は事実なるべし。",
              "citation": {
                "source": "心機妙変を論ず",
                "author": "北村透谷",
                "note": "青空文庫"
              }
            },
            {
              "text": "それには「劇的」即ち「ドラマチカル」といふことが、「演劇」乃至「戯曲」の本質であるかどうかといふ疑問をここで起してみる必要がある。",
              "citation": {
                "source": "近代劇論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "話を前に戻せば、戯曲乃至演劇の「本質」を説く場合に、所謂「劇的」（ドラマチカル）なる言葉の、普通の意味に於ける解釈では、これを適用することができないといふのが、今までの論旨であつたが、それならば、「劇的」といふ言葉にどんな意味をもたせたらよいか？",
              "citation": {
                "source": "近代劇論",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
