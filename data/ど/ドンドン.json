    "definitions": [
      {
        "index": 1,
        "gloss": "drumming (noise)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "太鼓がどんどん鳴り響き、祭りの始まりを告げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供が壁をどんどん叩いて遊んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ドアをどんどん叩く音がして、誰か来たのかと思った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "The Yellow Book の故智にならい、ビアズレイに匹敵する天才画家を見つけ、これにどんどん挿画をかかせる。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "膿が、どんどん出るのです。",
              "citation": {
                "source": "知らない人",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのたいへんな火事場に、私ひとりを置いてどんどん逃げて行つてしまふんだもの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが娘さんは、私に箱を与えると、いつもの懐しげな様子に似ずどんどん早足に帰ろうとします。",
              "citation": {
                "source": "伯林の降誕祭",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "内では天井に大煙突の抜けているストーヴでどんどん薪をくべていました。",
              "citation": {
                "source": "雪の日",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "外はまだどんどん雪の降っているのが窓から見えます。",
              "citation": {
                "source": "雪の日",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてひとしく雪のどんどん降りしきる窓の外に眼をやりながら玄関の扉の方へ出て行った。",
              "citation": {
                "source": "雪の日",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人はそして、ひたすら恐縮するヴァイオリン弾きを室内へ招じ、暖い喰べものを与え、ストーヴの火をどんどん焚き足して長時間吹雪のなかにさすらってこごえて来た乞食の老爺の体をあたためて遣りました。",
              "citation": {
                "source": "慈悲",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニが、どんどん電燈の方へ下りて行きますと、いままでばけもののやうに、長くぼんやり、うしろへ引いてゐたジョバンニの影ばうしは、だんだん濃く黒くはっきりなって、足をあげたり手を振ったり、ジョバンニの横の方へまはって来るのでした。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニは、もう露の降りかかった小さな林のこみちを、どんどんのぼって行きました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどもだんだん気をつけて見ると、そのきれいな水は、ガラスよりも水素よりもすきとほって、ときどき眼の加減か、ちらちら紫いろのこまかな波をたてたり、虹のやうにぎらっと光ったりしながら、声もなくどんどん流れて行き、野原にはあっちにもこっちにも、燐光の三角標が、うつくしく立ってゐたのです。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たいてい自分の望む種子さへ播けばひとりでにどんどんできます。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその鶴をもってこっちを見てゐる影ももうどんどん小さく遠くなり電しんばしらの碍子がきらっきらっと続いて二つばかり光ってまたたうもろこしの林になってしまひました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどんどんどん汽車は降りて行きました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどんどんどん汽車は走って行きました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどん黒い松の林の中を通ってそれからほの白い牧場の〔柵〕をまはってさっきの入口から暗い牛舎の前へまた来ました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョバンニはどんどんそっちへ走りました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "小屋の天井にのぼった人たちは、器械の上の方からどんどん乾いた玉蜀黍をほうり込みました。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日は、もう私たちはすっかり川の心持ちになれたつもりで、どんどん上流の瀬の荒い処から飛び込み、すっかり疲れるまで下流の方へ泳ぎました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　せいの高い草を分けて、どんどん牛が走りました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "達二はすっかり太い白いたすきを掛けてしまって、地面をどんどん踏みました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめのうちは金が、──地方の慾ばり屋がどんどん送ってよこすので──豊富で給料も十八円ずつくれたが、そのうち十七円にさげられた。",
              "citation": {
                "source": "自伝",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてもうどんどんその影は小さくなり電しんばしらの碍子がきらっきらっと続いて二つばかり光りこっち側の窓を見ますと汽車はほんたうに高い高い崖の上を走ってゐてその谷の底には川がやっぱり幅ひろく明るく流れてゐたのです。",
              "citation": {
                "source": "〔「銀河鉄道の夜」初期形一〕",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、二人の話はなかなかすまないばかりでなく、まるで親子喧嘩でもしてゐるやうな声高になつて、その揚句には、私に構はず、二人でドンドン上流へ行くのだつた。",
              "citation": {
                "source": "万福追想",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その怪物からは続けざまにドンドンドンと轟然たる砲声が放たれた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "見知越　　　　　　　五　続いてドンドン粗略に下りたのは、名を主税という、当家、早瀬の主人で、直ぐに玄関に声が聞える。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "追掛けるのか、逃廻るのか、どたばた跳飛ぶ内、ドンドンドンドンと天井を下から上へ打抜くと、がらがらと棟木が外れる、戸障子が鳴響く、地震だ、と突伏したが、それなり寂として、静になって、風の音もしなくなりました。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚も表戸がドンドン叩かれる。",
              "citation": {
                "source": "恋と十手と巾着切",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｔ「芸は大根でも　家柄のある奴は、親の威光で　ドンドン出世する　皆んな家柄のお蔭だ。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "塩原から雇って来た強力殿の足の早いこと、凡そ五、六貫位の重荷であるが、平気でドンドン行く。",
              "citation": {
                "source": "本州横断　痛快徒歩旅行",
                "author": "井沢衣水",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
