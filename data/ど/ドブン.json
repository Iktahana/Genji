    },
    "definitions": [
      {
        "index": 1,
        "gloss": "plop",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大きな石が池に落ちて、ドブンと音を立てた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供が勢いよくプールに飛び込み、ドブンと水しぶきが上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あ、やばい！」足を踏み外した瞬間、ドブンと水たまりに落ちた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ドブンとも云わねえや。",
              "citation": {
                "source": "浚渫船",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、見世ものの踊を済まして、寝しなに町の湯へ入る時は、風呂の縁へ両手を掛けて、横に両脚でドブンと浸る。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、何処ともなく、柳に暗い、湯屋の硝子戸の奥深く、ドブンドブンと、ふと湯の煽ったような響が聞える。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そりゃ刃物｜措け、棒切一本持たいでも、北海道｜釧路の荒土を捏ねた腕だで、この拳一つでな、頭ア胴へ滅込まそうと、……ひょいと抱上げて、ドブンと川に溺める事の造作ないも知ったれども、そりゃ、あれを見ぬ前だ。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、水がドブンと鳴った。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と訓導は姿勢を正して、杖を一つ、くるりと廻わすと、ドブン。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時に無茶先生は両手でヤットコを握って、初めに豚吉を、その次にヒョロ子を引きずり出して、前を流れている川の中へドブンドブンと投げ込みました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時、水がドブンと鳴つた。",
              "citation": {
                "source": "伯爵の釵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「そのゲジゲジが留めなけりゃあ、おめえはドブンを極めたところだったじゃねえか。",
              "citation": {
                "source": "廿九日の牡丹餅",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそ一と思いにドブンを極めようとしたところを、飛んだ奴に邪魔されて……。",
              "citation": {
                "source": "廿九日の牡丹餅",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "それもドブンと不意に川に陥つたやうに其話に移るので、聴手は一寸｜呆気に取られてゐる中に、話は一蹶して向岸に躍り上つてしまふ事がある。",
              "citation": {
                "source": "露都雑記",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "チラチラと眩ゆい点描きの風景、魚族のように真黒々な肌一杯に夏を吸いながら、ドブンと飛び込む黒坊――躍る水煙、巨大な黒坊、笑う黒坊、蛙のような黒坊。",
              "citation": {
                "source": "一粒の粟",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳶の者が櫂で叩落されたと同じ様に、御前も川へドブンですぜ。",
              "citation": {
                "source": "悪因縁の怨",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に満載していた人間がドブンドブンと海へ落ちてしまったのだ。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私は軽く頷いたが、途端、今までの喜び全部が、暗い淵の底に石でも抛ったようにドブンと音を立てて沈んでいった心地がした。",
              "citation": {
                "source": "現代小説展望",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜もだん／＼更けて、月が高く昇り、松に吹く風の音がさえにさえて来ますと、果して空から大きな釣瓶が下りて来て、汐の中に、ドブン、ザワ／＼と音を立てました。",
              "citation": {
                "source": "子良の昇天",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんにドブンという水の音。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワン」「ツー」「スリー」の号令とともに、一思いにドブンと、海中に投げ込まれようとした一刹那、「待て、待ちたまえ」と、皺枯れ声が、人々の背後にあった。",
              "citation": {
                "source": "怪奇人造島",
                "author": "寺島柾史",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あッという間もなく海中にドブンとほうりだされた。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドブンと音して蛙が飛び込む。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼の前の、激流と淵の瀬脇で、ドブンと日本｜鱒が躍り上がった。",
              "citation": {
                "source": "父の俤",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは実に見事なもので、狂犬はクルクルと中空高く舞い上り、堤上の松の枝をかすめて、濠の真中へドブンと落ち込み、しばしは浮みも上りません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "井戸端へ追いつめられたカメは、井戸を見るなり手をかけると、中へドブンととびこんでしまった。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメは洗濯のオカカ連をかきわけて、いきなり井戸へドブンととびこんだ。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "神伝魚心流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "枝が弓のやうに輪を画いて円く曲つたと思ふと、其枝はポツキと折れて大きな親猿は小枝を握つたまゝ二十間もあらうと思はれる高い所から、ドブン！",
              "citation": {
                "source": "山さち川さち",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドブンと音がしたかと思ふと、自分は海の底へつうと降りて行く。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウネリが高いから、マゴマゴしてゝ、ひつくり返りの、ドブンなんて、ありがたく無いからな。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
