        "examples": {
          "standard": [
            {
              "text": "読書尚友とはよく言ったもので、孔子や孟子の書を開くたびに古の賢者と対話しているような気持ちになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖父は「読書尚友というが、書物を通じて二千年前の哲人と語り合える。これほど贅沢なことはない」とよく話していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "読書尚友の精神で、彼は毎晩ソクラテスやアリストテレスの著作を紐解いては思索を深めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "修道者である中野君は政治上の岐路に立つごとに、読書尚友、東西古今の英雄豪傑と語って自らの反省の資にしようとした。",
              "citation": {
                "source": "叛骨・中野正剛",
                "author": "――主観的な覚え書き",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
