          "literary": [
            {
              "text": "浮浪少年のラスネールは、恐るべきドータンが勇ましく死に就くのを見て、行く末を思わせる次の言葉を発した、「うらやましいな。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドータン、一八一五年。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドータンは、兄弟を四つ切りにして、夜パリの中に出て行き、頭を貯水池に、胴体を下水道に投げ込んだ男だ。",
              "citation": {
                "source": "死刑囚最後の日",
                "author": "LE DERNIER JOUR D'UN CONDAMNE",
                "note": "青空文庫"
              }
            }
