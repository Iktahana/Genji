[
  {
    "uuid": "17a02592-9b70-572e-8775-f2ab90c4a45d",
    "entry": "同種",
    "reading": {
      "primary": "どうしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
