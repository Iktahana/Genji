        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "パリーの日本人で、一番パリーのために尽した伴野商店の主人は、レジオン・ドヌウルをフランス政府から貰っているほどの人であるが、東京に帰ったとき、フランスの放送をして、ふと話がフランス人の悪い部分に触れたことがある。",
              "citation": {
                "source": "欧洲紀行",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、政府の補助金を増してくれといふかはりに、「レジヨン・ドヌウル」をある男にやつてくれといふのである。",
              "citation": {
                "source": "文功章",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "（杯を挙げる）神谷　　（これに応じて）レジオン・ドヌウルの健康を祝す。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "レジオン・ドヌウル！",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寿　　いちいちレジオン・ドヌウルを云ふなよ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "小説家フロオベエルは、往々レジヨン・ドヌウル勲章の略綬をフロックの襟につけて悦んでいたそうである。",
              "citation": {
                "source": "芸術統制是非",
                "author": "辰野隆",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
