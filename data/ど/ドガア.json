        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしながら、例えばコンスタンタン・ギイやドガアやファン・ドンゲンの絵が果して「いき」の有するニュアンスを具有しているであろうか。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランス画壇の名匠エドガア・ドガは、かつてパリーの或る舞踊劇場の廊下で、偶然、大政治家クレマンソオと同じ長椅子に腰をおろした。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "清長の珍らしい浴泉圖は二枚あつて、その一枚がドガアの手に入つてゐると云ふ事は上田柳村先生の「渦卷」で承知してめづらしい事と思つた。",
              "citation": {
                "source": "京阪聞見録",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し夫れ皮肉なるドガアの畫題を搜し出すと云ふ事は既に予の領分外である。",
              "citation": {
                "source": "京阪聞見録",
                "author": "木下杢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、「江戸川乱歩は要するにエドガア、アラン、ポーに対するエドガワ、ランポに過ないのかナ」　なぞと思い思いした事でした。",
              "citation": {
                "source": "江戸川乱歩氏に対する私の感想",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "エドガア・アラン・ポーの小説は、芸術小説の部類に含まるべきものながら、その題材は主として怪奇物語を取扱っている。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えばエドガア・アラン・ポーの幾つかの奇怪なる物語は、まさしく大衆的に興味を惹くものではあるが、その文章はあくまで個性を発揮した、立派な芸術小説的なものである如き然りである。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "チェホフの作品でなしに、たとえば、ボオドレエル若しくはエドガア・アラン・ポオの作品を例にとろう。",
              "citation": {
                "source": "政治的價値と藝術的價値　マルクス主義文學理論の再吟味",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "チエホフの作品でなしに、たとへば、ボオドレエル若しくはエドガア・アラン・ポオの作品を例にとらう。",
              "citation": {
                "source": "政治的価値と芸術的価値",
                "author": "マルクス主義文学理論の再吟味",
                "note": "青空文庫"
              }
            },
            {
              "text": "なまじ、魯迅を知り、魯迅の文学論を読む機会があっただけ、そしてエドガア・スノウの「支那の上の赤い星」の描写が刻みつけられているだけ、この自分でも読めそうで読めない現代中国文学は、不断の魅力となっているのである。",
              "citation": {
                "source": "春桃",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「皆旅に来て苦労するのかなあ」　思わずそれを言って見て、パスツウルの通りからモン・パルナッスの停車場へと取り、高架線の鉄橋の下をエドガア・キネの並木街へと出、肉類や野菜の市の立つ町を墓地の方へ行かずにモン・パルナッスの通りへと突切った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近ではエドガア・ポオもどきに、密輸入品を人目につかぬ所に隠す代りに、反って人目に極くつきやすいところへ放り出して置くのが流行っていると、こんな話を面白｜可笑しく、この海原力三という船員が話して聞かせた。",
              "citation": {
                "source": "ゴールデン・バット事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、エドガア・アラン・ポオの作品を読んで、それを低級だといい得る人はあるまいから、探偵小説に対するそうした先入見はよろしく取り払って貰いたいと思う。",
              "citation": {
                "source": "「心理試験」序",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしもし、現代の日本人で、そういう偏見を懐いている人があったら、すべからく、エドガア・アラン・ポオの発音をそのまま取ってペンネームとした江戸川乱歩の作品を読むべきである。",
              "citation": {
                "source": "「心理試験」序",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "まことに、エドガア・アラン・ポオが探偵小説の鼻祖であるとおり、わが江戸川乱歩は、日本近代探偵小説の鼻祖であって、従ってこの創作集は日本探偵小説界の一時期を画する尊いモニュメントということが出来るであろう。",
              "citation": {
                "source": "「心理試験」序",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたは、無論、エドガア・アラン・ポオの『盗まれた手紙』という探偵小説を御読みになったことがありましょう。",
              "citation": {
                "source": "外務大臣の死",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾百と云ふ蔵幅は大抵モネ、ピサロオ、セザンヌ、シスレエ、ドガア、ルノワアル等近代名家の作家の作品で満ちて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣にある昔の市長の住んだドガアルの宮殿はモネが此春｜描いた絵で見知つて居たが、僕の着いた当日は何かの節会で縦覧させない。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "三日目には美術館でチチアノの「基督昇天」、「ピエタ」を始めチエボオロの画を観、又貴族政治時代の栄華をドガアルの宮殿に眺めたが、フイイレンチエ行の汽車の時間が迫つたから委しく書く余裕が無い。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "エドガア・アラン・ポオの小説にリユウ・マルグの二人殺しと云ふのがあつて、その主人公は猩々である。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "エドガア・スノウの本（自注３）が半年かかって到着しました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "（自注３）エドガア・スノウの本――エドガー・スノウ『中国の赤い星』。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへばエドガア・ポオは酒飲みだつた為に（或は酒飲みだつたかどうかと云ふ為に）永年死後の名声を落してゐた。",
              "citation": {
                "source": "文芸的な、余りに文芸的な",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年前に、エドガア・ポオの未完成のドラマが、出版された。",
              "citation": {
                "source": "演劇より文学を排除すべきか",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "エドガア・アラン・ポオにあの名高いメエルスツルムの渦潮の恐ろしい記述がある。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "エドガア　アラン　ポオ　その家が、今、彼の目の前へ現れて来た。",
              "citation": {
                "source": "田園の憂欝",
                "author": "或は病める薔薇",
                "note": "青空文庫"
              }
            },
            {
              "text": "それ故、カベーの「イカリヤ物語」よりはモリスの「無可有郷だより」が、モリスよりは更にエドガア・ポオの「アルンハイムの地所」の方が、一層彼を惹きつけるのでした。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
