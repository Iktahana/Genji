        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「私が勝ったね！」 「どっこいしょ、まだ勝負は終わってないよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「これで完璧だ！」 「どっこいしょ、もう少し見直しが必要だよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「この計画は成功する！」 「どっこいしょ、まだ課題がたくさんあるだろう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
