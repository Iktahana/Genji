      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "heigh-ho",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「どっこいしょ！」と声を出しながら、重い箱を棚に乗せた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は腰を下ろすときに、「どっこいしょ」とため息をついた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "お年寄りが立ち上がる際、「どっこいしょ」とよく言う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「どっこいしょ、どっこいしょ」　お早うを言いにあがって来た信子は「まあ、温かね」と言いながら、蒲団を手｜摺りにかけた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ううむ、どっこいしょ。",
              "citation": {
                "source": "老ハイデルベルヒ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっこいしょなら親仁相応なのに、（やあ、）と学生さんのような若い掛声で、むくりと起きた処が、脊の低い、はち切れそうな緊った身体さ。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "……いや、どっこいしょ。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺どのは、どっこいしょ、と横木に肩を入れ直いて、てんぼうの片手押しは、胸が力でござります。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっこいしょの、うんとこしょって意味なんだ。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（何、構わないようなもんじゃあるがね――どっこいしょ。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は「どっこいしょ」と大人のように言って仰向けに寝ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　どっこいしょと腰を叩く奴、ううむと唸る、ああと一人が両手を高く差し上げて欠伸をする、眼をこしこしとこするのもある。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親　よお、どっこいしょ、と……ああ道夫はどうした。",
              "citation": {
                "source": "新学期行進曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そういうと男は「どっこいしょ。",
              "citation": {
                "source": "火",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっこいしょ」　と繁が力を入れて言った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハア　どっこいしょ！",
              "citation": {
                "source": "ソヴェト同盟の三月八日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ええ、行きますべえ、ああ、どっこいしょ、山で日を送ってりゃ安気なもんだ、あさっでは久し振りで嬶の顔でも見ますべえかなあ……」「老爺さんは今まで何処にいたんだえ。",
              "citation": {
                "source": "木曾御嶽の両面",
                "author": "吉江喬松",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こう独り言を言いながら、道ばたの石の上に「どっこいしょ。",
              "citation": {
                "source": "舌切りすずめ",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、どっこいしょ！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "龜さんは荷物をおろして、どっこいしょと石ころの上にはい上がってやすみました。",
              "citation": {
                "source": "龜さん",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "岩は、どっこいしょと起きあがって、せいいっぱいにのびをしました。",
              "citation": {
                "source": "ふしぎな岩",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "たけをは、「どっこいしょ」と立って四月の昼間でも暗い納戸へゆき、勤めに着てでる新銘仙の着物を丁寧にたたみつけた。",
              "citation": {
                "source": "だるまや百貨店",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｏ君はそこを通る時に「どっこいしょ」と云うように腰をかがめ、砂の上の何かを拾い上げた。",
              "citation": {
                "source": "蜃気楼",
                "author": "――或は「続海のほとり」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は体を拭いてしまうと、濡れ手拭を肩にかけながら、「どっこいしょ」と太い腰を起した。",
              "citation": {
                "source": "少年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "右源太は一杯目の飯を食ってすぐ「代り」　と、茶碗を突出した時「どっこいしょ」　と、右源太の後方で、懸声して「お武家様、少々」　と、丁寧にいった。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は棟梁三谷三次の前に――そこだけ空かしてあるところに、どっこいしょと腰をおちつけ、目の前に据えられた徳利に手をかけた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "戸田老人は右から左――と、四肢の一つ一つにそれぞれ順々に力を入れて腕をつき立て、後脚をひき、どっこいしょと立ちあがった。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっこいしょ」と云いながら、二人は荷物を重そうに橇の上へズシリと置いたが続いて自分達も飛び乗った。",
              "citation": {
                "source": "八ヶ嶽の魔神",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっこいしょ」　と掛け声と一緒に彼はヒョロヒョロと立ち上がった。",
              "citation": {
                "source": "日置流系図",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、丸木が、「どっこいしょ」　と、かけごえをしたと思うと、千二の体は袋にはいったまま宙に浮いた。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっこいしょとタマを背負って出ようとすると「モシモシ」と呼びとめられた。",
              "citation": {
                "source": "明日は天気になれ",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どっこいしょ」と言って米友は、竹皮笠を土間から取り上げて被りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "お銀様の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "la-la",
