        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "王子は霧の中で、はあはあ笑って立ちどまり、ちょっとそっちを向きましたが、またすぐ向き直って音をたてないように剣のさやをにぎりながら、どんどんどんどん大臣の家の方へかけました。",
              "citation": {
                "source": "虹の絵具皿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかしがつくる青い光の棒を超絶顕微鏡の下の微粒子のやうにどんどんどんどん流れてゐる。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどんどんどん汽車は降りて行きました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどんどんどん汽車は走って行きました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　どんどんどんどんやって行き、恭一は見ているのさえ少しつかれてぼんやりなりました。",
              "citation": {
                "source": "月夜のでんしんばしら",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳶ははじめは自分も油が乗ってましたから、頼まれたのはもう片っぱしから、どんどんどんどん染めました。",
              "citation": {
                "source": "林の底",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガドルフは、俄かにどんどんどんという音をききました。",
              "citation": {
                "source": "ガドルフの百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして風がどんどんどんどん吹いているのです。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "空では雲がけわしい灰色に光り、どんどんどんどん北のほうへ吹きとばされていました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんどんどんどん汽車は走つて行きました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "雫ですっかりぬればらや何かに引っかかれながらなんにも云わずに私どもはどんどんどんどん遁げました。",
              "citation": {
                "source": "谷",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、その怪物からは続けざまにドンドンドンと轟然たる砲声が放たれた。",
              "citation": {
                "source": "海に生くる人々",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "追掛けるのか、逃廻るのか、どたばた跳飛ぶ内、ドンドンドンドンと天井を下から上へ打抜くと、がらがらと棟木が外れる、戸障子が鳴響く、地震だ、と突伏したが、それなり寂として、静になって、風の音もしなくなりました。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "野原でも林でも田圃でも何でも構わずにドンドンドンドン駆け出しますと、蛙たちはあとから押し合いへし合い追っかけます。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "例へば、コケコッコーでも、カック・ア・ダッダルドウでも※の声だらうし、太鼓の音を、ドンドンドンと吾々の幼時から云ひ現はし慣れてはゐるが、ラッバダブ・ラツバダブでも別段に反対の称へようもない――まつたく私は藤村の寝言の叫びを“Hurrah!”と聞いたのである。",
              "citation": {
                "source": "環魚洞風景",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」└「ドンドンドン！",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンドンドン……ドンドンドン……これがこれまでの音であった。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところで死絵は紅毛人どもが今大変な高い金でドンドンドンドン買い入れている。",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんだい与の公、せっかくあたしが助けてやろうと思っているのに――」　いまの与吉の大声で、路地の跫音がいっせいに、この家の表に集まって、ドンドンドン！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰やらおもての戸を、ドンドンドンとたたく音。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御主人が中に入って、自分で鍵をかけていてだんネ」「中から鍵を――すると警官も中へは入れないのかネ」「警官まで、蠅男の一味やないか思うとるようですなア」「ちょっと会ってみたいが――」「そんなら、扉を叩いてみまっさ」　警官が、なんだか合図らしい叩き様で、扉をドンドンドン、ドンドンと叩いた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "突然、二階へ通ずる奥の階段をドンドンドンと荒々しく踏みならして駈け下りてくる者があった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、ちょっと中へ合図をしてみい」　警官は心得て、ドンドンドン、ドンドンと合図どおりに扉をうった。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとドンドン叩いてみてくれ」　ドンドンドンと、扉はやけにうち叩かれた。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドンドンドンと破壊の音！",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸から追って来た甲斐もない」　ドンドンドンドン走って行く。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "益々早く太鼓をうち、何とかして、　　信ずるものは誰れェも　　みィな救ゥくわるゥ　急に止って歌をやめ、「みなさァん」　声のわれた、卑俗な調子で短い演説のようなことをやったかと思うと、すぐドーンドーンドンドンドンと太鼓が鳴り出し、宵のざわめきを越えて、　　信ずるものは誰れェもと再び同じ歌が進行して来る。",
              "citation": {
                "source": "刻々",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち舞踊劇の試演があって、坪内先生のいらっしゃる楽屋にお邪魔していると、ドンドンドンという音がして近くで大きな声がした。",
              "citation": {
                "source": "松井須磨子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "よそさんのお内でドンドンドンドン赤さんが生れはると、わてらの命も、ドンドンドンドン伸びるのどす。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "がその途端にドンドンドンと今度は烈しく戸を叩いて、まさかと思った親父がほんとうに帰って来た時には私もまったく竦然としました。",
              "citation": {
                "source": "蒲団",
                "author": "橘外男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
