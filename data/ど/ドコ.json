        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この山頂まで、あとどこまで行けば着くのだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「今日の会議はどこまで話が進んだの？」「まだ冒頭だよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの子はどこまでいたずら好きなんだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
