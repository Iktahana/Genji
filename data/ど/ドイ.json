[
  {
    "uuid": "af38e5d3-000f-5526-ac97-05437a4667e2",
    "entry": "土居",
    "reading": {
      "primary": "どい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
