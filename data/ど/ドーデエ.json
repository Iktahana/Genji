        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドーデエの小さいものが面白かったそうで私はそのお下りをきょうからよみはじめます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーデエがパリの二十五年間の思い出を書いたのは忘れられず面白い本でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドーデエは妻と大変むつまじく暮して、部屋のこちらの端のテーブルについてドウデエが一枚小説をかくと小さい息子がヨチヨチそれをむこうの端にいる母さんのところへもって行って、そうやって仕事をした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三五年（昭和十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日「夜明け前」の後篇とロンドンの「ホワイト・フアング」の訳とドーデエの「ジャック」を入れます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "寿江子は私のわきでスケッチをして居り、鼻歌まじりで一心に集注した可愛い顔つきで雨にぬれて色あざやかな外の風景を描いて居り、私はドーデエの『月曜物語』を、特別な興味と関心とで読んで居り、午後じゅう、ほんの一寸しか互に喋らず、しかも静かに充実した精神の活動が室に満ちて居り、本当に本当にいい心持でした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
