[
  {
    "uuid": "feba375d-e978-5c01-9643-f6920c29afca",
    "entry": "何れ何れ",
    "reading": {
      "primary": "どれどれ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
