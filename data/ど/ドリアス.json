        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その内もっとも崇められたはシノセファルス・ハマドリアスてふ狗頭猴で、古エジプト神誌中すこぶる顕著なる地位を占めた。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊３　ミアウリス　アンドリアス・ウォコス（1770-1835）ギリシアの有名な水師提督。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "※の木の少女ドリアスお国ではお前さん気の利いた方でしょうが、余所へおいでなすっては駄目ですね。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドリアスあれは闇の女フォルキアデスです。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドリアスの子のリコオルゴス勇すぐれしも天上の　130神を恐れず敵として遂に壽命は永からず。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
