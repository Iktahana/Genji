        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "寝ながらドビュッシィの歌曲を勉強したい。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "私には日本一上手に、そして完全にドビュッシィの歌をうたう自信があります。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "不幸にしてこの世の中でドビュッシィの独唱会が出来なかったら、私は天国でドビュッシィの独唱会を開きます。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう考えてドビュッシィの楽譜を探したんですが、私の持っているドビュッシィの楽譜は、去年の五月二十五日、麹町の私のお家と一緒に空襲で焼いてしまったのです。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで今、「バルコン」を始めドビュッシィの歌を勉強しています。",
              "citation": {
                "source": "お蝶夫人",
                "author": "三浦環",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく聴くとドビュッシィの「バルコン」だった。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            },
            {
              "text": "病床で研究を始めたドビュッシィを危篤の病床で唄ったのである。",
              "citation": {
                "source": "三浦環のプロフィール",
                "author": "吉本明光",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
