        "examples": {
          "standard": [
            {
              "text": "深夜、家族が寝静まった後も、彼は読書灯の明かりだけを頼りに推理小説を読み続けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旅行鞄に必ず読書灯を忍ばせておくのが彼女の流儀で、宿でも枕元で本が読めるように備えていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "ベッドサイドに置いた読書灯が柔らかな光を放ち、彼はページをめくるたびに物語の世界へ引き込まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ソファの後ろの小さな机には、小さな読書灯が乗っている。",
              "citation": {
                "source": "ＲＵＲ――ロッサム世界ロボット製作所",
                "author": "R.U.R. (ROSSUM'S UNIVERSAL ROBOTS)",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝の間中読書灯をつけざるをえなかった。",
              "citation": {
                "source": "盗聴者",
                "author": "Ａ. ブラックウッド　A. Blackwood",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
