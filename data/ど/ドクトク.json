        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は自分だけの独特の論理で、周りを納得させようとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その芸術家の作品は、彼にしか理解できない独特のメッセージを含んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は独特の解釈でその本を読み解いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
