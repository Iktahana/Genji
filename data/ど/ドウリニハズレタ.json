        "examples": {
          "standard": [
            {
              "text": "親の愛情を無下にするなんて、道理に外れた行為だ。感謝の気持ちを忘れてはいけない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "その理論は科学的根拠に乏しく、道理に外れたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の主張は論理的矛盾があり、道理に外れたものだと指摘された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "個人間では、斯くの如き知れ切つた道理が、妙に國民間に於ては、道理に外れた解釋を下さうとする。",
              "citation": {
                "source": "日本文化とは何ぞや（其一）",
                "author": "内藤湖南",
                "note": "青空文庫"
              }
            },
            {
              "text": "慰みがてら、親の留守をねらって取っつかまえて来た子鷲なんだろう、だから、考えてみると、こいつをこっちへ置くのが道理に外れたことで、返してやるのが人情だあな」と米友が答えました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "新月の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
