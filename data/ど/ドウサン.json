  {
    "uuid": "43c28d93-85df-5f0f-9c05-1312df0def1a",
    "entry": "同参",
    "reading": {
      "primary": "どうさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鯉七　身内の面々、一同参り合せました。",
              "citation": {
                "source": "夜叉ヶ池",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "同参の大衆ではなく、役僧であることがすぐ分かった。",
              "citation": {
                "source": "仇討三態",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が秀吉は、「それこそ、こちらから願い度き物であるが、某一人に限らず、丹羽、池田、森、佐々等にも廻状を遣り、来春一同参列の上、取替したがよいであろう。",
              "citation": {
                "source": "賤ヶ岳合戦",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十分の後、中佐は紙巻を啣えながら、やはり同参謀の中村少佐と、村はずれの空地を歩いていた。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "三機までの共同参加を許し、相互間の無線電話による連絡も妨げない」「参加機の離陸にあたって、本社係員より厳封せる封筒が飛行士に手渡される。",
              "citation": {
                "source": "空飛ぶ悪魔",
                "author": "――機上から投下された手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏性かならず成仏と同参するなり。",
              "citation": {
                "source": "日本精神史研究",
                "author": "和辻哲郎",
                "note": "青空文庫"
