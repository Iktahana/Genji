[
  {
    "uuid": "33dbb1f1-8f60-5432-b398-3212f6139b52",
    "entry": "動産",
    "reading": {
      "primary": "どうさん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
