  {
    "uuid": "7b83ee1b-7003-567d-ab10-2c8687967df4",
    "entry": "ドエライ",
    "reading": {
      "primary": "どえらい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「全く、私も、こゝにゃ、ドエライものがあると思って掘らしとったんです。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの坑道にいた坑夫達がドエライ震動と、轟音にびっくりして馳せつけたのだ。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ですからタッタ一つのお茶といったような問題に就いても、ドエライ研究が行き届いているに違い無い事が、すぐに想像されるでしょう。",
              "citation": {
                "source": "狂人は笑う",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなドエライ人間が、各新聞社に一人ずつ割当てるほど日本に居るか知らん……と肝を潰すかも知れないが、論より証拠だ。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "スゴイ、ドエライ地獄の話じゃ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "滅多に貰えぬドエライ奴だよ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今にドエライ証拠を出すぞよ……。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに一つドエライ研究材料が、吾輩の処へ転がり込んで来たものだ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち今の若林君が、吾輩に引渡して、吾輩が空ストーブの中に抛り込んでおいた一件の調査書を、吾輩が後から読んで要点だけを抜書きにして、自分一個の意見を書き加えた所謂抜萃の各｜頁を、一枚｜毎に順序を逐うて、映画として御覧に入れるのだ……というと又、ドエライ手数がかかるようだが、実は何でもない。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……そんなドエライ商売がどこに在るかって……ここに在るんだ。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその身分違いをハッキリさせるために、平民が寄付けないようなドエライ扮装を凝らしやがる。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "鮮海漁業の充実期して待つべし……更に金鞭を挙げて沿海州に向うべし……というので大白を挙げて万歳を三唱しているところへ、思いもかけないドエライ騒動が持ち上って来た。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "幅が利くにも何にもドエライ出世だ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドエライ罰金を喰わせられた上に、懲役にブチ込まれる事になるんだから、ソレ位のねうちはあるだろう。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "コイツはドエライ金になるぞ。",
              "citation": {
                "source": "焦点を合せる",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼が眩んで息が詰まる位ドエライ、モノスゴイものであった。",
              "citation": {
                "source": "幽霊と推進機",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドエライ勢で新疆方面に拡がっているが、しかし支那人の考えている共産主義は、ホントウのソビエット主義とはすこし違うんだよ」「ヘエ。",
              "citation": {
                "source": "人間レコード",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ誰が聞いて来たか、ドエライ話が転がり込んで来たもんだ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "曲るにしても太い鋼鉄の棒を何の苦もなく折り曲げるようなドエライ力を、その軽い動きと姿の中に感ずる事が出来た。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとそこいらに類のないドエライ疵が……」「ふうむ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、やがて五六ヶ月経って秋の収穫期になると、後家さんの下ッ腹が約束の通りにムクムクとセリ出して来たのでドエライ評判になった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそれとして、日本の上流社会の一番ドエライところを代表したのがこれ位のところで、紀文や奈良茂の昔語りよりも大分落ちるようである。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕の従弟が内地の連隊にいたとき、自分の村で小作争議が起り、それがドエライことになってしまった事があるんです。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれ御返事します」「そんなことを言わないで、確かに是処で引受けて帰ってくれ」と言って、森彦は調子を変えて、「今日は、貴様は、ドエライやつを俺の許へ打込みに来たナ――いや、しかし面白かった」　兄は高い声で笑った。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓ぢかくにおいて突然ドエライ音響がした。",
              "citation": {
                "source": "空気男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ニヒリズムなんて、ドエライものじや無かつたのだ。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒縮緬の羽織に派手な色の羽織の紐と、俎板のやうな桐の柾のドエライ下駄をよくおぼえてゐる。",
              "citation": {
                "source": "両国今昔",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで遊べるといゝんだが、まだあとに「弥次喜多」といふドエライ奴が控へてゐる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっともっとドエライものが、その辺の隅々に、ゴロゴロしているのだよ」　で、結局、私は井上次郎に説伏されて、その秘密結社へ入ってしまったのです。",
              "citation": {
