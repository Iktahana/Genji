[
  {
    "uuid": "3127bc90-1acb-5928-bad9-21d02455904b",
    "entry": "どてっ腹",
    "reading": {
      "primary": "どてっぱら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
