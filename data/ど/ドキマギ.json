          "literary": [
            {
              "text": "シュワルツコッフです」　と、岩蔵はドキマギしている。",
              "citation": {
                "source": "地球盗難",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "大にドキマギした容子であったが、調子を更えて「宮前のお広さん処へは如何参るのです？",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、お八重ちゃん」　柄にもなく顔中を真っ赤にして圓太郎は、ドキマギした。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……ヘ、ヘイ」　フイを食って圓太郎はドキマギした。",
              "citation": {
                "source": "圓太郎馬車",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうした時の、兄のドキマギした様子といったら、ないのです。",
              "citation": {
                "source": "仁王門",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたし、よく覚えているでしょう」　浩一は思わずドキマギした。",
              "citation": {
                "source": "薔薇夫人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
