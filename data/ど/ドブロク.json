[
  {
    "uuid": "0d8f43b8-d4f1-50b9-8931-42b8da8b92cf",
    "entry": "濁酒",
    "reading": {
      "primary": "どぶろく",
      "alternatives": [
        "だくしゅ",
        "じょくしゅ"
      ],
      "is_heteronym": true
    },
    "grammar": {
      "pos": [
