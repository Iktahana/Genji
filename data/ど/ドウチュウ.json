        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "道中、突然の雨に降られてずぶ濡れになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人と道中ずっとおしゃべりをしていたので、退屈しなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "道中で食べた駅弁が、旅の最高の思い出の一つになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
