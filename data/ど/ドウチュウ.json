    },
    "definitions": [
      {
        "index": 1,
        "gloss": "journey",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "長い道中、私たちは様々な景色を楽しみながら旅をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "道中では予期せぬ出会いがあり、旅は一層思い出深いものとなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは遠足の道中、歌を歌いながら楽しそうに歩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "道中の昼食は一人前五、六銭であったらしい。",
              "citation": {
                "source": "初旅",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "欄下の溜池に海蟹の鋏動かす様がおかしくて見ておれば人を呼ぶ汽笛の声に何となく心｜急き立ちて端艇出させ、道中はことさら気を付けてと父上一句、さらば御無事でと子供等の声々、後に聞いて梯子駆け上れば艫に水白く泡立ってあたりの景色廻り舞台のようにくる／＼と廻ってハンケチ帽子をふる見送りの人々。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "このあたりの景色｜北斎が道中画譜をそのままなり。",
              "citation": {
                "source": "東上記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "甲府へ戻って、大宮吉田を振りだしに、富士山を「上り」とした道中双六の「さい」は、おのずと収められる。",
              "citation": {
                "source": "不尽の高根",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、また、汽車で品川へ戻り、そこから道中｜双六のように一足一足、上りに向って足を踏み出すのである。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "関のさびれた町に入って主人は作楽井が昨年話して呉れた古老を尋ね、話を聞きながらそこに持ち合っている伊勢詣りの浅黄の脚絆や道中差しなど私に写生させた。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「密謀の集会」「大広間の評定」「道中の行列」これには大抵同じ土手や昭和国道がつかわれる。",
              "citation": {
                "source": "雑記帳より（１）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お馬ヒンヒン」という語はいつ頃からあるかまだ確かめないが、一九の『東海道中膝栗毛』初編には「ヒイン／＼」または「ヒヽヒン／＼」など見えている。",
              "citation": {
                "source": "駒のいななき",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその後二、三回の電車の道中に知らず知らず全巻を卒業してしまったのである。",
              "citation": {
                "source": "変った話",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　武蔵が、Ｔ「先生の門人として　道中御供　致し度う御座る」　ウンウンと団九郎。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが道中では至る所さるすべりと蓮の花だつた。",
              "citation": {
                "source": "編輯後記（大正十五年九月號）",
                "author": "『青空』記事",
                "note": "青空文庫"
              }
            },
            {
              "text": "勿論この屋敷でも奥方を領地へ送ることになったが、乱心同様の奥方が道中に狂い出したらばどうするか、国許へ帰っても今のありさまであったらばどうするか。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "驛路の馬の鈴の音、しやんと來る道筋ながら、時世といひ、大晦日、道中寂りとして、兩側に廂を並ぶる商賈の家、薪を揃へて根占にしたる、門松を早や建て連ねて、歳の神を送るといふ、お祭の太鼓どん／＼／＼。",
              "citation": {
                "source": "城の石垣",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今別れ際に声を懸けられたので、先方は道中の商売人と見ただけに、まさかと思っても気迷がするので、今朝も立ちぎわによく見て来た、前にも申す、その図面をな、ここでも開けて見ようとしていたところ。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "道中――旅行の憂慮は、むかしから水がはりだと言ふ。",
              "citation": {
                "source": "銀鼎",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "道中にも旅店にも、我儘ばかり申して、今更お恥しう存じます、しかし俥、駕籠……また夏座敷だと申すのに、火鉢に火をかんかん……で、鉄瓶の湯を噴立たせるなど、私としましては、心ならずも止むことを得ませんので、決して我意を募らせた不届な次第ではありません。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "せめては狩衣か、相成るべくは、緋縅の鎧……と気がつくと、暑中伺ひに到来の染浴衣に、羽織も着ず、貝の口も横つちよに駕籠すれして、もの欲しさうに白足袋を穿いた奴が、道中つかひ古しの蟹目のゆるんだ扇子では峠下の木戸へ踞んで、秋田口の観光客を――入らはい、と口上を言ひさうで、照覧あれは事をかしい。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――道中損ずる事承合ですぜ。",
              "citation": {
                "source": "十和田湖",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早打ちの使者の道中を見せる一連の編集でも連句的手法を借りて来ればどんなにでも暗示的なおもしろみを出すことができたであろうと想像される。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の幼時に愛した木版の東海道五十三次道中｜双六では、ここが振りだしになっていて、幾人ものやっこのそれぞれ長い槍を持ってこの橋のうえを歩いている画が、のどかにかかれてあった。",
              "citation": {
                "source": "葉",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い道中のために両脚が萎えてかたわになっていたのである。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "義理のやうに一寸募つた暑さも直ぐ涼しくなつて、是れでは北海道中｜種籾一粒取れまいと云ふのに、薄気味悪く米の値段が下つたりした。",
              "citation": {
                "source": "お末の死",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなものは、ただ本筋の悟りの道中のところどころの景色の一つで、若しそれに酔って嬉しがっているときは却って本筋の進行の妨げになると慧鶴は師匠の正受老人からきつく叱られさえしている。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "中にあの三｜間間口一杯の布袋が小山のような腹を据えて、仕掛けだろう、福相な柔和な目も、人形が大きいからこの皿ぐらいあるのを、ぱくりと遣っちゃ、手に持った団扇をばさりばさり、往来を煽いで招くが、道幅の狭い処へ、道中双六で見覚えの旅の人の姿が小さいから、吹飛ばされそうです。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ夫人は一夜の内に、太く面やつれがしたけれども、翌日、伊勢を去る時、揉合う旅籠屋の客にも、陸続たる道中にも、汽車にも、かばかりの美女はなかったのである。",
              "citation": {
                "source": "伊勢之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "無銭で米の買える法、火なくして暖まる法、飲まずに酔う法、歩行かずに道中する法、天に昇る法、色を白くする法、婦の惚れる法。",
              "citation": {
                "source": "露肆",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "頸摺れに、突着け、突掛け、「やあ、おいらんの道中々々！",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "人通りのない、故道松並木の五位鷺は、人の居處から五｜本目の枝に留ります、道中定り。",
              "citation": {
                "source": "三人の盲の話",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよりしまへおあがりなされて一と夜｜参籠あそばされ、あくる日｜佐和やまへおわたりになりまして、いちにちふつか御きゅうそくなされましてから御ほっそくあそばし、どうちゅうつゝがなく清洲のおしろへ御あんちゃくになりました。",
              "citation": {
                "source": "盲目物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
