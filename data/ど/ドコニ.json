        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "子孫ハ、ドコニモ居リマセヌ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドレ　ドコニ」「ソラ、ソラ、ソコニ」　ナルホド、ミルト　ナタネノ　ミキニ　マダ　ヒラカナイ　ツボミガ　ヒトツ　ノコツテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アツ、ヰルヨ」「エ、ドコニ」「ホラ、アソコニ」　ズーツト　下ノ　ハウノ　アル　マチノ　ホソイ　ミチノ　上ニ　キラキラト　ヒカル　モノガ　アリマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一年ニナルノニ、彼奴ハ故郷ニジットシテイテ、ドコニモ働キニ行コウトシナイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョウジョウネコ　ホホールト　ホール　トッピャッピ　オカザキ　デコデンデン（前掲）　ダンコクサイ（又はダンゴグサイ）　ゾンゾロシガ　シルコラタレ・タータ　チトラル（前掲）　ドコニイタイタ　ドコニウ　以上で全部である。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドコニイタイタ」は獅子がササラッ子の中に隠れた段に発せられ、「どこに行った行った？",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ではないかと云われているが、するとそれにつづく、「ドコニウ、ヒヤヒヤ」　は、どこにも居ない居ない、というような意味であろうか。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "牝獅子隠しの段で、獅子がササラッ子のマン中へ隠れ、牡獅子が探しまわるときに、音譜は「ヒ、ヒヤ、ドコニイタイタ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒヒヤ、ドコニウ、ヒヤヒヤ」　と綴られており、「ドコニイタイタ」は「どこに行ったか行ったか」であろう。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、「ドコニウ、ヒヤヒヤ」は「どこにも居ない居ない」らしく、すると冒頭の「ヒ、ヒヤ」は「アア、居ない」というような日本語に訳すべきかね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "高麗神社の祭の笛――武蔵野の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ノ奴、返答ニ困ッテ嘘ヲツイタナ、ダガドコニイルンダロウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハルガキタハルガキタドコニキタヤマニキタサトニキタノニモキタ　子供が歌っている。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
