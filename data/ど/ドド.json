        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "例えば「雪」のキには「伎」「企」「枳」などのどれを使ってもよく、「月」のキには「紀」「奇」などどれを使ってもよい。",
              "citation": {
                "source": "古代国語の音韻に就いて",
                "author": "橋本進吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "次郎兵衛は三島のまちのほとんどどこの曲りかどにでもある水車へ眼をつけた。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼び物の「金色の女」はなるほどどうしても血の通っている人間とは思われなくて、金属の彫像が動いているとしか思われない。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "やいの、）　と心持仰向くと、不意に何と……がらがら、どど、がッと鼠か鼬だろう、蛇も交るか、凄じく次の室を駆けて荒廻ると、ばらばらばらばらと合せ目を透いて埃が落ちる。",
              "citation": {
                "source": "吉原新話",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "見えつつ、面白そうな花見がえりが、ぞろぞろ橋を渡る跫音が、約束通り、とととと、どど、ごろごろと、且つ乱れてそこへ響く。",
              "citation": {
                "source": "絵本の春",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "うってがえしに、あの、ご覧じ、石段下を一杯に倒れた血みどろの大魚を、雲の中から、ずどどどど！",
              "citation": {
                "source": "貝の穴に河童の居る事",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "衝と、引潜って、ドンと飛び摺りに、どどどと駈け下りると、ね。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「抱いた記憶はないが、なるほどどこかで見たようだ」「見たようだもないもんだ。",
              "citation": {
                "source": "義血侠血",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちゃんちきちき面白そうに囃すかと思うと、急に修羅太鼓を摺鉦交り、どどんじゃじゃんと鳴らす。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "突如として、どどん、じゃん、じゃん。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおども安、手前どもりゃ人を斬るって話だが、此処で一ぺん、どど、と吃って斬って見ろ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると大きい奴がどどーんと落ちて来る」「ふーん。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほどどこにもかしこにも、もう人が寝ているのだな。",
              "citation": {
                "source": "白",
                "author": "リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほどどの葉にも、いままで見たことのない赤い点々がついていました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれどどうしてもまだ歩けないんだろう、そしたらね、そのうちに東が少し白くなって鳥がなき出したろう。",
              "citation": {
                "source": "風野又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「雨はざあざあ　ざっざざざざざあ　風はどうどう　どっどどどどどう　あられぱらぱらぱらぱらったたあ　雨はざあざあ　ざっざざざざざあ」「あっだめだ、霧が落ちてきた。",
              "citation": {
                "source": "かしわばやしの夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "時しもあれや松の雪、　　をちこちどどと落ちたれば、室ぬちとみに明るくて、　　品は四請を了へにけり。",
              "citation": {
                "source": "文語詩稿　五十篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「家ど山どどっちぁ好い。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっどど　どどうど　どどうど　どどう　　　青いくるみも吹きとばせ　　　すっぱいかりんも吹きとばせ　　　どっどど　どどうど　どどうど　どどう　　　どっどど　どどうど　どどうど　どどう　先ごろ、三郎から聞いたばかりのあの歌を一郎は夢の中でまたきいたのです。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "船は横たおしになって、うしおがどどっと、所かまわず船にながれ込みました。",
              "citation": {
                "source": "人魚のひいさま",
                "author": "DEN LILLE HAVFRUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬は習慣的にどどっとふた足、三足を駆け出した。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪岡はどどっとふた足ばかり躍った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　開墾地の人たちは叫びながら、戸口を蹴飛ばすようにして戸外へどどっと雪崩れ出していった。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九　どどっと物の倒れる、めりめりと戸の破れる、すさまじい響きが遠くの方でして、人の叫びがきこえてきた。",
              "citation": {
                "source": "吉良上野の立場",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「なア、兄ちゃ、犬ど狼どどっち強えんだ。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "どどっ、板の間に、壁に、天井に響いて、男はうつ伏せに、倒れてしまった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "討手は、背後から突かれたように、手を延したまま、どどっと、前へ倒れてしまった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論、ウイスキーに何か二三種のよき鑵詰などどっさり用意してだ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "「六平もまだや、さき方｜嚊さ迎に行ったれどどっちも帰らんわいの。",
              "citation": {
                "source": "恭三の父",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "絶対に大丈夫だ」「しかし、このとき空中魚雷を抱きたる日本の攻撃機数十台が押し寄せ、どどどっと、空中魚雷を命中させ……」「穴は明きません」「続いて、果敢なる日本潜水艦隊が肉薄して、数十本の魚雷を本艦の横腹目がけて猛然と発射するときは……」「大丈夫だといったら、大丈夫だ。",
              "citation": {
                "source": "不沈軍艦の見本",
                "author": "――金博士シリーズ・10――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
