        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "健康診断で、医者から胴回りのサイズを指摘された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "服を買うときは、まず自分の胴回りを測るようにしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の胴回りは昔よりずいぶん太くなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "胴回りでいえば、砂摺りと背に至る中間、身長でいえば、頭の付け根より腹部の終わりぐらいまでのところを中トロとしてよろこぶのである。",
              "citation": {
                "source": "鮪を食う話",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "会稽山の下にのような※冠があって、長さ一尺あまり、胴まわり五、六寸。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "録異記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのかなたの小部屋で、下宿の主婦の胴まわりにテープをまわして働いた。",
              "citation": {
                "source": "赤い貨車",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、なにしろ、この胴まわりじゃ……！",
              "citation": {
                "source": "博物誌",
                "author": "HISTOIRES NATURELLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "でも、叔父の話では、胴まわり一尺もある大蛇だという話だが、どうしてこんな小さな穴から……」「そこが、それ、魔性の変幻自在なところ。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "日高川",
                "note": "青空文庫"
              }
            },
            {
              "text": "死灰から更生した壺の胴まわりには怪獣と夢想の花のアラベスクが浮きだされている。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "背丈は一尺近くあって胴まわりも充分にある青磁は、それ一個をつつんで鞄に入れてしまえば、あとには、何も入れることが出来ない、彼は間違いがあるといけないと思って、車掌に車掌室に置いてもらうことにした。",
              "citation": {
                "source": "陶古の女人",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっき胴締を取ってしまったので、胴まわりが細いために、ズボンがずり出したものらしい。",
              "citation": {
                "source": "なぐり合い",
                "author": "WIE JAPPE UND DO ESCOBAR SICH PRUGELTEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "さしわたし尺二寸以上の桐の胴まわりに、漆と金銀で桐の葉と花の蒔絵をした火鉢で、その蒔絵の桐の葉が五枚ときまっているため、五桐火鉢と呼ばれるのであり、作りかたに独特のくふうがもちいられていて、ほかにまね手のないものと珍重されていた。",
              "citation": {
                "source": "ちゃん",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　旦那の家の裏門のすぐ傍らには、胴まわりがふた抱えもあるような、太い、高い、椋の樹が聳えている。",
              "citation": {
                "source": "南方郵信",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の身躰が一つ、胴廻りを為ると、肩から倒に婦が落ちた。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから彼は、袋の中の金貨をすっかり数えて見たり、延棒を抛り上げて、落ちて来るところを受けて見たり、指の間から金粉をさらさらと落して見たり、それから、コップのつるつるした胴廻りにうつる自分の顔のおかしな映像を眺めたりしては、『おう、マイダス、お金持の王様マイダスよ、御身は何という仕合せ者だろう！",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく胴廻りの太さが違うね。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "王鮭は、ほかの三君が二｜呎半からせいぜい三呎どまりなのに、長さは四呎半、胴廻りすら一呎半もあって、王というより化物というほうがいいような雄大なやつだ。",
              "citation": {
                "source": "南部の鼻曲り",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、三人に囲まれながら、うしろを見返ると、細い紐の様な小蛇が、いつのまにか、胴廻り一抱えもある様な、庭一杯の大蛇に変っていた。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
