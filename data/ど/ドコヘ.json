          "literary": [
            {
              "text": "」と要らざる出しやばり口をきいたやうな次第でございましたけれども、将軍家はちよつとお考へになつて、それから一言、ドコヘ行ツテモ、同ジコトカモ知レマセン。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "シロイ　テフテフハ　シンパイサウニ、「コレカラ　ドコヘ　イクノ」ト　フウセンニ　キキマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボク　ドコヘ　イクンダカ　ワカラナイカラ、テフテフサン　モウ　オカヘリヨ」ト　フウセンダマハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクハ　ドコヘ　イクノカ　ワカンナイヨ」ト　フウセンダマハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコヘノツテヨイノヤラ　ワカラナイノデ、ヤネニノリマシタ。",
              "citation": {
                "source": "三匹ノ　コグマサント　キシヤ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オマンヂウハ　ドコヘイツタノデセウ？",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ユフガタ　メガサメテミルト、オホソウヂハ　モウドコヘイツタカ　カゲモカタチモアリマセンデシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モウ五時ダネ、オ婆チャン、コレカラ銀座ヘ出テ晩飯ヲ喰ッテ帰ロウジャナイカ」「銀座ノドコヘ」「浜作ヘ行コウヨ、コノ間カラ鱧ガ喰イタクッテ仕様ガナインダ」颯子ヲ呼ンデ浜作ニ電話サセ、カウンターノ席ヲ三四人分取ッテオイテ貰ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコヘ行クノカ分ラナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドコヘ行クノカシラ」ト首ヲヒネッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「パパ、ママハドコヘ行カハルノカ分ッテハルノ」ト、膳ニ向ウト敏子ガ始メタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
