    },
    "definitions": [
      {
        "index": 1,
        "gloss": "please",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「どうぞ、こちらにお座りください。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「お先にどうぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「どうぞご自由にお取りください。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "然し僕はどれを出すかに迷ふし、一つの詩の一部を抜出すといふやり方は高森の詩には適当でないし、結局沢山出さなければならないやうに思はれるから茲には割愛しなければならぬが、どうぞ此の落付いた稀特な詩集が、一冊でも沢山に売れるやう希望するものである。",
              "citation": {
                "source": "詩集　浚渫船",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中さんがあらわれて、どうぞ、と言う。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おいしいものは、何もございませんが、どうぞ、お箸をおつけになって下さい。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さ、どうぞ、しっかり。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小坂氏は苦笑して、「どうぞ、ビイルを、しっかり。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――どうぞ愚人の囈言も偶にはよいとして、私の語る所を聴いて貰ひたい。",
              "citation": {
                "source": "詩に関する話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうです、みなさんも、」と兎たちに呼びかけ、「この座敷には偉いお婆さんも聖人もゐませんから、どうか、遠慮なく、どうぞ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とお鈴さんも笑ひ出して、「それぢやあ、またどうぞいらして下さいね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞおひまを見てお訪ね下さい。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ私をあなたの所へ連れてって下さい。",
              "citation": {
                "source": "よだかの星",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ堪忍してくれ、政夫……私は民子の跡追ってゆきたい……」　母はもうおいおいおいおい声を立てて泣いている。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞこの上お母さんも諦めて下さい。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子のためには真に千僧の供養にまさるあなたの香花、どうぞ政夫さん、よオくお参りをして下さい……今日は民子も定めて草葉の蔭で嬉しかろう……なあ此人にせめて一度でも、目をねむらない民子に……まアせめて一度でも逢わせてやりたかった……」　三人は眼をこすっている様子。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "民子可哀相と思召したら、どうぞ民子が今はの話も聞いて行って下さいな。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたがお出でになったら、お話し申すつもりで、今日はお出でか明日はお出でかと、実は家中がお待ち申したのですからどうぞ……」　そう言われては僕も帰る訣にゆかず、母もそう言ったのに気がついて座敷へ上った。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたに色々御無念な処もありましょうけれど、どうぞ政夫さん、過ぎ去った事と諦めて、御勘弁を願います。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "愚かなことでしょうがこの場合お前さんに民子の話を聞いて貰うのが何よりの慰藉に思われますから、年がいもないこと申す様だが、どうぞ聞いて下さい」　お祖母さんがまた話を続ける。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "政夫さん、どうぞ聞き分けて下さい。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ不憫と思うてやって下さい……」　一語一句皆涙で、僕も一時泣きふしてしまった。",
              "citation": {
                "source": "野菊の墓",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、「このつれならまだいくらでもありますから、どうぞいいのを御持ち下さい」という。",
              "citation": {
                "source": "ある日の経験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうぞ」　「や、こりゃどうも」　「あら随分破けてんですねえ」　「え」　「縫いましょうか」　「いや、どうも済みません」　お静、糸と針を取りに立つ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "吃驚して「どうぞ命ばかりは」　殿様が乞食に、Ｔ「隠すな、隠すな」　と言われて、乞食、何の事だか訳が分らん。",
              "citation": {
                "source": "武蔵旅日記",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ互に仲善くして助け合つてくれと云つた。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "）どうぞお掛けなすって。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢様、どうぞこちらへお通りあそばしませとでも仰ゃりそうでしたのね。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "）どうぞ堪忍して下さい。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞこんな事になりましたのを、おくやみなさらないで下さいまし。",
              "citation": {
                "source": "家常茶飯",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
