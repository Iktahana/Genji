        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "雨上がりのグラウンドは、どべで足元が滑りやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちがどべだらけになって、泥遊びを楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この粘土質の土は、水を含むとどべになる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
