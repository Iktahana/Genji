        "examples": {
          "standard": [
            {
              "text": "歌舞伎の舞台で、どんでん返しが見事に決まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この劇場には、どんでん返しのできる舞台装置がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "どんでん返しで舞台が変わるたびに、客席から歓声が上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
