        "examples": {
          "standard": [
            {
              "text": "一晩でドカ雪が降り、翌朝は一面の銀世界となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の日本海側では、ドカ雪が降ることが珍しくない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ドカ雪の影響で交通機関が麻痺し、出勤に時間がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「何んだ／＼」「何を騷ぐんだ」　ドカドカ雪崩込んだ子分達、親分溝口屋鐘五郎が、紅に染んで縡切れた姿を見ると、さすがに亂醉の酒もさめてしまひます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "鐘五郎の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何だ何だ」「何を騒ぐんだ」　ドカドカ雪崩込んだ子分たち、親分溝口屋鐘五郎が、紅に染んで縡切れた姿を見ると、さすがに乱酔の酒もさめてしまいます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鐘五郎の死",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
