[
  {
    "uuid": "b9722738-5672-57ae-991c-cb35417200c2",
    "entry": "どぶり",
    "reading": {
      "primary": "どぶり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　男衆も共に、ただ一息と思う処で、亀の、どぶりと沈むごとに、思わず声を掛けて、手のものを落す心地で。",
              "citation": {
                "source": "南地心中",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と喝する下に、どぶり、どぶり、どぶり、と浪よ、浪よ、浪よ渦くよ。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どぶりと一つ、……一時であろう。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　で、髯旦の、どぶりと徳利を拔いて出るのを待兼ねた、右の職人、大跨にひよい、と入ると、「わつ、」と叫んで跳ねて出た。",
              "citation": {
                "source": "錢湯",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　手際なもので、煽ぐ内に、じり／＼と團子の色づくのを、十四五本掬ひ取りに、一掴み、小口から串を取つて、傍に醤油の丼へ、どぶりと浸けて、颯と捌いて、すらりと七輪へ又投げる。",
              "citation": {
                "source": "松の葉",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ちよろ／＼だけぢやあ意をなしませんし、どぶりでもなし、滔たりでもなし、しやあ。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "最後に瘠せた一塊の肉団をどぶりと湯の中に抛り込むように浸けて、敬太郎とほぼ同時に身体を拭きながら上って来た。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "空地の前には鉛色をした潮が脹らんでいて、風でも吹けばどぶりと陸の方へ崩れて来そうに見えていた。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どぶうり、どぶり――浪の音がしている。",
              "citation": {
                "source": "早耳三次捕物聞書",
                "author": "海へ帰る女",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に又浪の音　どぶりどぶり。",
              "citation": {
                "source": "往生絵巻",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び浪の音　どぶりどぶん。",
              "citation": {
                "source": "往生絵巻",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　揺る度びにどぶりどぶりと重い液体の音がして、ぷーんといい香がつっ走った。",
              "citation": {
                "source": "特殊部落の犯罪",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「済まないなあ、ねえさん」などゝ、好い気になつて背中に跨らうものなら、川の中へどぶり。",
              "citation": {
                "source": "ブルタアニュの伝説より",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしなら海にどぶりんこして、死んじまふがなあ、こいつには、さういふ智惠もない、……　父親勘三は來るところまで來てゐて、それをどう處分することも出來ない果の果まで來たといふやうな顏附をして言つた。",
              "citation": {
                "source": "神のない子",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "どぶりと野風呂に身を沈めて、夕暮の空を仰ぐと、初めて、気のつかない雲の美しさを見出します。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どぶり、どぶり、と耳の下で夕波が撚れる。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "都合もあるから」　どぶり、どぶりと、砂浜に打つ波音のほかは、からんと静かな真昼である。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "どぶり……どぶり……　舷をたたく川口の静かな夜波に胸を衝かれて、あふれ出る涙をどうしようもなかった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザクッと、足が埋まりこんだが、案の定そこは砂地――しめたッ――と躍る姿は海風にばたばた鳴って、つづく限りの波明りに添い、時々、どぶりッと飛沫に足をすくわれながら、無二無三、逃げていった。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "鳴門の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
