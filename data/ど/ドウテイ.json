[
  {
    "uuid": "7a9d6063-c397-5959-894b-853632f3d3f5",
    "entry": "同定",
    "reading": {
      "primary": "どうてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
