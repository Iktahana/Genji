    "definitions": [
      {
        "index": 1,
        "gloss": "heigh-ho",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「どっこい、もう少しだ！頑張ろう！」と彼は叫んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "重い荷物を持ち上げる時、「どっこいしょ」と声を出す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "チームメイトが「どっこい！」と声をかけ合い、士気を高めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「どっこいしょ、どっこいしょ」　お早うを言いにあがって来た信子は「まあ、温かね」と言いながら、蒲団を手｜摺りにかけた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ううむ、どっこいしょ。",
              "citation": {
                "source": "老ハイデルベルヒ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてどっこいといふ風に荷馬車にのっけてあたりをじっと見まはした。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっこいしょなら親仁相応なのに、（やあ、）と学生さんのような若い掛声で、むくりと起きた処が、脊の低い、はち切れそうな緊った身体さ。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "踏み込んで連れて行く、と突立上れば、大手を拡げ、「どっこい遣らぬわ、誰でも来い、家の亭主ここに控えた。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……いや、どっこいしょ。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おっと、どっこい。",
              "citation": {
                "source": "みさごの鮨",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺どのは、どっこいしょ、と横木に肩を入れ直いて、てんぼうの片手押しは、胸が力でござります。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……が、ところで、どっこい、その紙入の中はまた古新聞の束ばかりだったと云うのだろう！",
              "citation": {
                "source": "嘘",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっこい忙がしい、」　と荷を上げそうにするのを見て、「待て、待て、」「沢山よ。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "で銜えたまんま、待てよ、どっこい、と言うたびに、煙管が打附りそうになるので、抱かれた児は、親仁より、余計に額に皺を寄せて、雁首を狙って取ろうとする。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どっこいしょの、うんとこしょって意味なんだ。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（何、構わないようなもんじゃあるがね――どっこいしょ。",
              "citation": {
                "source": "唄立山心中一曲",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "先祖代々、これにばかりは叱言を言うめえ、どっこい。",
              "citation": {
                "source": "白金之絵図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらぬか、それか、何にしても妙ではない、かようなものを間の内へ入れてはならずと、小宮山は思案をしながら、片隅を五寸か一尺、開けるが早いか飛込んで、くるりと廻って、ぴしゃりと閉め、合せ目を押え附けて、どっこいと踏張ったのでありまする。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は「どっこいしょ」と大人のように言って仰向けに寝ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いっそ風をくらって、逃げてやろうと思っていたが、どっこい、くらった風が無類の暴れ者、この五体中を駈けずり廻り、横紙破って出たのは、咳やら熱やら、ひどい目に会うてしまったよ。",
              "citation": {
                "source": "猿飛佐助",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「浪の音、ソリャ、どっこい、浪の音ウか。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　どっこいしょと腰を叩く奴、ううむと唸る、ああと一人が両手を高く差し上げて欠伸をする、眼をこしこしとこするのもある。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "すっ込もうとしたが、どっこい、Ｎ老人そうはさせない。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ところがどっこい。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "我が愛でんと欲するもの、皆我が胸中に飛び込んでくるではないかと鼻の下を伸ばしたところがおっとどっこい。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "おやじも飲んだくれだが、嬶も飲んだくれで、どっこいどっこい、という土方の夫婦がいた。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「どっこい放さぬ。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "四郎五郎　（急に芝居の身振りをなし）これさ、どっこいやらぬ。",
              "citation": {
                "source": "藤十郎の恋",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浅川ッたら蟹工の浅か、浅の蟹工かッてな」「天皇陛下は雲の上にいるから、俺達にャどうでもいいんだけど、浅ってなれば、どっこいそうは行かないからな」　別な方から、「ケチケチすんねえ、何んだ、飯の一杯、二杯！",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、その時の俺の考えの底には、お前たちがいくら俺たちを留置場へ入れて苦しめようたって、どっこい、そんなに苦しんでなんかいないんだ、という考えがあったのだ。",
              "citation": {
                "source": "独房",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうでも怪しいと目星を付け、十手を突きつけて訊問して見るとどっこい大宛違いなのであった。",
              "citation": {
                "source": "半七雑感",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
