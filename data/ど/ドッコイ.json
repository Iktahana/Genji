        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「どっこい、危ないぞ！ちゃんと前を見て！」と彼が注意した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "転びそうになった子供に、「どっこい！」と手を差し伸べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「どっこい、諦めるな！まだチャンスはある！」と仲間が励ました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "la-la",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
