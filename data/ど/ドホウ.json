        "examples": {
          "standard": [
            {
              "text": "古代ローマ軍は、強力な弩砲を装備して戦場に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "敵の城壁を破壊するため、巨大な弩砲が運び込まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "弩砲から放たれる矢は、遠距離の標的を正確に射抜いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "――小學校の往き戻りに徒らする男の子があつたから、つかまへて一間ほどほうり投げてやつたら、あたまから雪の中へ突きささつて、をかしかつた。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "發展",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
