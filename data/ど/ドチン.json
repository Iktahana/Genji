        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして新吉は、清子の「小谷先生、ヨードチンキあって？",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨードチンキは渡されたらしい。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "山母は外から帰ってきて、ああ寒々といって炉傍にどかりとすわり両脚を踏ん張って火に当たると、トチの実はドチンとはねて山母のふところに飛びこんだ。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "秋月君はそこに出してある三河内焼きの茶わんに勝手に冷えた茶をつぐと、ヨードチンキで真っ黒になった片手でぐいとあふった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "リスさんはお医者さんでしたから、兎さんの指にヨードチンキを塗つてあげました。",
              "citation": {
                "source": "兎さんの本屋とリスの先生",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "男Ｂ　……（相手の言葉はわかったのだが、それに返事はせず、いきなり、ノドチンコが見えるくらいの大あくびをする）おーう。",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者はオリヴィエを聴診して、肺尖に少し炎症を発見し、患者の背中にヨードチンキの塗布をクリストフへ頼んだ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "明礬吸入の効果が大規模に実験されたのもその時のことであって、今日ではそれに代えて、有効なヨードチンキが外用されるようになったのである。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "咽喉具合わるくノドチンコが、ひっかゝるやうでうまく喋れず、「のどか」スラ／＼行かず。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
