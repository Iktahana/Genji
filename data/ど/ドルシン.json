          "literary": [
            {
              "text": "昨日と今日とは睡眠剤のドルシンを〇・二グラムずつのみたり。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ガ買ッテ来タドルシンヲ三錠ズツ日ニ三回服用、オ蔭デ痛ミハ軽クナル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "慌テヽドルシンヲ三錠呑ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドルシンモイヽガ、コウ汗ヲ掻イチャ遣リ切レナイ、何カ外ノ薬ハナイカナ」午後五時杉田氏来診。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドルシンハ汗ガ出テイヤダッテ仰ッシャルンデス」佐々木ガ杉田氏ニ訴エテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "薬ハイロ／＼ゴザイマスカラ、ドルシンモオイヤ、ノブロンモオイヤデシタラ、取リ敢エズパロチンノ注射デモシテ見マショウ、一時ノ苦痛ハ凌ゲルト存ジマス」注射ノ結果ヤヽ軽快ニ赴ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
