        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "友達とのゲームで、彼が一番強いキャラクターを独占してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はいつもソファの真ん中を独占して、テレビを見るのが好きだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちは、新しいおもちゃを自分一人で独占しようとケンカになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
