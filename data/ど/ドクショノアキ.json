        "examples": {
          "standard": [
            {
              "text": "読書の秋というが、今年の連休は溜まっていた小説を五冊一気に読み終えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "図書館は読書の秋を迎えて利用者が急増し、開館前から行列ができるほどだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「読書の秋だね」と妻が言いながら、コーヒーを淹れてリビングのソファに腰を落ち着けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それから読書の秋が来て、札幌の早い冬が、間近にせまって来た。",
              "citation": {
                "source": "百科事典美談",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
