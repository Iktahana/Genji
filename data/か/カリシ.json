  {
    "uuid": "beba8e19-8cb7-5047-ab29-00a93ec2792a",
    "entry": "カリシ",
    "reading": {
      "primary": "かりし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ワタシハ　イママデ　ウツカリシテ　ヰタケレド、ワタシノ　セナカノ　カラノ　ナカニハ　カナシミガ　イツパイ　ツマツテ　ヰルデハ　ナイカ」　コノ　カナシミハ　ドウ　シタラ　ヨイデセウ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、二ツノ　ホシハ　ガツカリシマシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ　オサムラヒニ　バケル　トキダヨ」　オカアサンノ　タヌキハ　ガツカリシテ　イヒマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "之レ教育スベキ國家ノ窮乏セルト、教育セラルベキ國民ニ餘裕ナカリシヲ以テナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ノ亡國的腐敗ハ悉ク事大的國是トナリテ現ハレ、日清戰爭ニ於テハ清國ニ從ヒ、日露戰爭ニ於テハ露西亞ヲ迎ヘ、聊カモ英國ト自耳義ノ結托ニ似タル者ナカリシハ開戰原因ヲ顧レバ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ラバ「ウヰルソン」ハ「ヴェルサイユ」ニ行カズシテ瑞西ノ社會黨大會ニ列席スベカリシナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "實ニ朝鮮ハ合併以前自決ノ力ナカリシコトハ八十歳ノ老婆ノ如ク、合併以後未ダ自決ノ力ナキコト十歳ノ少女ノ如シ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "末節枝葉ニ於テ如何ナル非難アルニセヨ、朝鮮ハ露西亞ノ玄關ニ老婆ノ如ク窮死スベカリシ者ヲ、日本ノ懷ニ抱カレテ少女ノ如ク生長シツツアルハ之ヲ無視スル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ講和委員ハ何ガ故ニ英米ト日本トガ國民精神ノ根本、國家組織ノ信念ヨリ異ニスル所以ヲ指摘シテ、日本國民本有ノ國家有機體的信仰ヲ彼等ニ訓ユルコトナカリシカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ講和委員ハ何ガ故ニ、「カイゼリスム」ト日本ノ國家有機體的信仰ヨリ結果セル國民皆兵主義トヲ混同シテ臨ミシ無智ノ昏迷者ニ學バシムル所ナカリシカ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ニ反シテ皇帝ニ墮落セザル以前ノ奈翁軍ノ連勝セシ精神的原因ハ、彼ノ無慾ト其ノ物質的生括ガ兵卒ト大差ナカリシ平等ノ理解ニ立チシガ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「モシオ前ノ友ダチガウッカリシテイテオ前ノ足ヲ踏ンダラオ前ハドウスルカ？",
              "citation": {
                "source": "白い壁",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "道子ハタダ夫ニ自分ヲ弁解シヨウトバカリシテ居タノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死んだ親父もこいつのためにはどのくらい苦労をしたか、死んで、悴の方ではガッカリシタの一句で片づけているが、相当に無常を感じたことは、何モイヤニナッタの自暴半分の言葉つきでもわかる。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤカマシイコトバカリシテ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "（５）豁然開朗ハ下ノ土地平曠ト連ラナリ、狹カリシ穴ヨリ廣々トシタル所ニ出タト解スル事誤リナケレドモ、客觀的ノ景色ヲ描クト共ニ、主觀的ナル漁夫ノ心理状態ノ一變シタル事ヲ含ム。",
              "citation": {
                "source": "桃花源記序",
                "author": "狩野直喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩ニ際シ諸僚佐来ツテ道路｜恙ナカリシヲ賀ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "此人民ハ敬神ノ心乏カリシヲ以テ、「ゼウス」神ノ爲ニ絶ヤサレタリト云フ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――クリスチァン・カリシャーの論文『ベートーヴェンの眼と眼病』Beethovens Augen und Augenleiden（Die Musik 誌、一九〇二年三月十五日および四月一日号）参照。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "カリシャー氏がベルリンで発見した一通の書簡は、ベートーヴェンが、どれほど熱心に彼の甥を「国家のために有為な廉直な一市民」にしようとしたかを示している。",
              "citation": {
                "source": "ベートーヴェンの生涯",
                "author": "VIE DE BEETHOVEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "五子モ陸子モ予トハ反リガ合ワナイデ喧嘩バカリシテイタガ、ヤハリ声ヲ挙ゲテ泣ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「君ハドウデモイヽッテ云ウカモ知レナイケレド、浄吉ハコノトコロ旅行バカリシテタジャナイカ」「ソレガ何ナノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、シッカリシトクレヨ、我慢シテレバ直キニナオルヨ」予ハ涙ト泣キ声トヲ胡麻化スタメニ頭カラ掛布団ヲスッポリト被ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「起キテコチラヘ来テ立ッテ戴キマショウ、ソノ方ガ注射シ易ウゴザイマス」「承知シマシタ」予ハ寝台ヲ下リ、特ニ勇マシク、シッカリシタ足ドリデ博士ノ立ッテイル明ルイ窓際ノ方ヘ歩ヲ運ビ、博士ト向イアッテ立ツ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、途端ニ博士ハ、「ア、コレハイケナイ」ト、俄ニガッカリシタヨウニ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "脈モ割合ニシッカリシテイタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
