        "examples": {
          "standard": [
            {
              "text": "ストリートミュージシャンがカホンを叩きながら歌っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このバンドはドラムの代わりにカホンを使っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カホンの素朴な音色が、アコースティックな雰囲気にぴったりだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は新しいカホンを自作することにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "河岸には（伊田の街はづれの）サアカスが興業してゐた、若い踊子や象や馬がサーカス気分を十分に発散させてゐた、バカホンド、ルンペン、君たちも私も同じ道を辿るのだね。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
