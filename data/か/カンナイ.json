  {
    "uuid": "0313d2c9-331f-5ef2-b2c8-3dafe312aa99",
    "entry": "関内",
    "reading": {
      "primary": "かんない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこから関内駅までのわずかな時間、慶一は令子と肩をならべ、ぎこちない、とぎれとぎれの会話を交わした。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「早く帰って、クソして、寝ようぜ」12大人になったとき、ぼくはいま夢中になっているものをまだ楽しんでいるだろうか〈ホエン・アイ・グロウ・アップ〉ビーチボーイズ　七月三十日の朝、慶一は関内駅の階段を走りおりた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーツケースとバッグをトランクに入れたふたりは、玄関内に目をやった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから野毛橋を渡り、土手通りを過ぎて、仮の吉田橋から関内にはいった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時の横浜関内は一羽の蝶のかたちにたとえられる。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の家は、横浜の、太田｜初音町の高台にあって、彼女の書斎の二階からも、下の広間の椽側からも、関内のいらかを越して、海が遠くまで見えるのを思ったりしながら、わたしは、蟹を下駄のさきでおどろかしていた。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "高みから見る横浜｜関内の、街々の灯は華のようにちらめいて、海の方にも碇泊船の燈影が星のようにあった。",
              "citation": {
                "source": "朱絃舎浜子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代都市の交通機関内では、朝夕どれだけ多量にこの擬似性慾が消費されていることでしょう。",
              "citation": {
                "source": "踊る地平線",
                "author": "Mrs. 7 and Mr. 23",
                "note": "青空文庫"
              }
            },
            {
              "text": "これ畢竟、信門を開きて絶対関内の光景に接触する故である。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四節　神秘論の批評　つぎに、神秘派の理外に偏する不合理の次第を述べんに、神秘論者は全く人知を排して、宗教は不可思議関内のものなれば、人知をもって是非すべからずというも、およそこの世界のこと、一つも人知を中心とし起点として、これより万事万類を測定するのほか、他に知るべき方法あるものにあらず。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆる絶対関内の風光なれば、宗教上、天啓顕示をまたざるべからざるも、今ここに論ずるところは、道理によりて説明するにあれば、いささか宗教学の理論に考えて、この疑団を氷釈せんと欲するなり。",
              "citation": {
                "source": "迷信と宗教",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "表に降って居る春雨も、一度この玄関内の光景に接すると忽ちその艶を失ってしまうように思われた。",
              "citation": {
                "source": "漱石氏と私",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……通れ」　呉用はほっとしながらも、わざと悠々、関内へ入って行く。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その日とは、姿を変えた石秀が、北京府の関内へ、首尾よく潜入しえた当日なのだ。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤塗の轍はれきろくと関内の文化街を真っすぐに疾走した。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お大尽が通る」「関内｜芸妓が通る」　と百姓たちは、幾度も、腰を立てた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして黒眼鏡の四肢を、ぎりぎりと隅へしばりつけるとボートは、オールの唄のどかに、鉄の橋の下を辷るように潜って行く――　びっくりして、色を失った豆菊や若い妓はその橋の上を、今にもわっと泣き出しそうな顔をして、関内の街へ、走っていた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女の泣けるだけを泣かせて夜露に濡れた俥の幌は、やがて関内の色街へ帰った。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "横浜の桟橋に、巨大なジャマンの商船や蘭領インドあたりの無数の外船が新しくはいりこんでいるような時は必ず、この風車の家の下には、桃われや、つぶしや、銀杏がえしの、数多のニホン娘が、関内の花街から送りこまれて、夜をくだつ器楽や強烈な酒精の騒音と共に、毎夜毎夜、更けるのを知らない。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、二日でも三日でも、捕虜たちの解放されるまで、彼女もまた娘子軍の幾十人かと共に、関内の店とかけもちに、ここで眼を紅くしておとりまきをしているのだった。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし競馬場からそこへ薔薇色の馬車がはいった時には、もう、狂躁な饗宴の熾んさが、玄関にまであふれ、ホールには、その前から運ばれている関内の芸妓、雛妓たちにとりまかれて、多くの、外人賓客たちが、酔態をきわめていた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだまだ、本牧の風車の下で、関内の安ッぽいお吉や、似て非なる亀遊の髪あぶらの香を嗅いで、うつつを抜かしているてあいなどは、至って、馭しよい異人たちであるのだ。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "首尾よく関内に突撃したら、火をつけろ。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「城中の分裂、今はまぎれもなし」　と、夏侯｜惇も、つづいて関内へ駸入し、その余の大将も、続々入城する。",
              "citation": {
                "source": "三国志",
                "author": "臣道の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "以下、旧重臣の五人を列侯に封じ、また王粲や傅巽を関内侯に封じた。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "曹操は感動して、「いまの言葉は、真に国へ報じる忠臣の声である」　といって、即座に彼の官職をひきあげて、江夏の太守｜関内侯とした。",
              "citation": {
                "source": "三国志",
                "author": "赤壁の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、車が許都へつくと、曹操はその忠義をたたえ、「以後、関内侯に封ぜん」と、いった。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "栄爵はひとりご辺を耀かすものではなく、万人の忠義善行の心を振い磨く励みとなすものであることをよく察せよ」　と、いうことばに、楊阜もついに否みがたく、恩を拝して、一躍、関内侯の大身になった。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、すでにその先手も中軍も、関内へ到着して、この日、城頭には、新たな旌旗が目ざましく加わっていた。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、魏の陣中からあがった火の手は、裏切りがあってのことではなく、蜀の馬超が、斜谷の嶮をよじ登って、ふいに搦手から関内へ攻めこみ、後方｜攪乱の策に出た結果だった。",
              "citation": {
                "source": "三国志",
                "author": "図南の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
