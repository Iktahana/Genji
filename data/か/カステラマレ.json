          "literary": [
            {
              "text": "遠い異郷から帰って来たイタリア人らは、いそいそと甲板を歩き回って行く手のかなたこなたを指ざしながら、あれがソレント、あすこがカステラマレと口々に叫んでいる。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カステラマレは遠くもあらず。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "カステラマレを發せしは天氣めでたき日の朝なりき。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
