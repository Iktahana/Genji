          "standard": [
            {
              "text": "彼の研究は、進化生物学における環境理論に新たな視点をもたらした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "ゼミでは、最新の環境理論が紹介され、活発な議論が交わされた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この分野の専門家たちは、それぞれの環境理論に基づいて異なる解決策を提案している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "然るに思想の歴史に於ては寧ろ反對に、環境理論は人間が自然によつて働きかけられるといふこと、從つて環境は働きかけるものであるといふことを主張することによつて發展したのである。",
              "citation": {
                "source": "歴史哲學",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
