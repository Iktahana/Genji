        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大手町で電車を降り、停留場前のバラック仮建築の内務省の門衛に訊き、砂利を踏んで這入つて、玄関で竹草履に履きかへてゐると、「やあ」と誰やら、肩幅の広い、体格のがつしりした若者が、私の前に立ち塞がつて言つた。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "研究所の屋上に仮建物を作り、組立ても完成し、試験もだいたいすんだので、あとはクリスマスをすませて、次の年を迎えてからのこととしようというわけで、外国人の技師たちがすこし気をゆるめたとき、たいへんな事件が起ったのだった。",
              "citation": {
                "source": "ある宇宙塵の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "壕舎期、仮舎期、仮建築期、本建築期である。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "一人一人の仮建築をやっていった。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮建築に入ると結婚が行なわれ、新家庭が一週間に十組以上もできた。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "この仮建築期は、だから復興期ともいえる。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "人々は今不自由な仮建築の中で充実した生活を送っている。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは各家庭の仮建築を自分らの手でそれぞれ建てまわるのである。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮建築の天主堂はでき上がった。",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "せっかく君の努力で仮建築ながらりっぱに再建できたのだし、爆撃以前からいて様子をよく知っているのは君だけです」「だからやめるのです」「？",
              "citation": {
                "source": "ロザリオの鎖",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "家々の建築具合を見ても、假建築が永久的な住ひになつた樣なのが多く、發展の最中に不景氣の爲めにあたまを押へられてしまつたといふあり樣が見える。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            },
            {
              "text": "假建築のままに燻ぶつてゐる店などがすくなくはない。",
              "citation": {
                "source": "泡鳴五部作",
                "author": "斷橋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
