        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "白釉、黒釉、柿釉、飴釉、青釉、緑釉、海鼠釉、辰砂釉、青磁釉等これが流し釉であったり三彩であったりする。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は多く柿釉、内は海鼠釉で色がなかなか美しい。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "甕の如きも海鼠釉は主に縁に掛けてあるだけで、内も外も大概は柿釉である。",
              "citation": {
                "source": "現在の日本民窯",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "白絵、刷毛目、櫛描、指描、流釉、天目、柿釉、飴釉、黄釉、緑釉等々々。",
              "citation": {
                "source": "日田の皿山",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
