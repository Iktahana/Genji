          "literary": [
            {
              "text": "花よりはむしろ鳥類の飾り毛にでもふさわしい色だと思う。",
              "citation": {
                "source": "病室の花",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "老人の白髯を集めて作った兜の飾り毛を風に靡かせ、獣歯の頸掛をつけた・身長六｜呎五｜吋の筋骨隆々たる赤銅色の戦士達の正装姿は、全く圧倒的である。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親の兜の飾り毛にする為に自分の髪を刈ったらしく、男の様な刈上げだったので、首を取られたのだともいう。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "番兵、銀の甲冑、赤い飾毛、城門は二枚の唐草の扉。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "髭をつけ、鳥の飾毛のついた礼帽をかぶった大礼服の男が、板の間に膝をついておはちをかきまわしている。",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "逃してはならぬ奴だ」「まだ遠くへは行くまい」「見付かったら、朋輩の敵、一と太刀ずつ斬るのだぞ」　背負太刀、ダン袋、赤い飾毛をなびかせた官軍が五六人、木立を捜り、藪を分けて鶯谷の方へ降りて行きます。",
              "citation": {
                "source": "芳年写生帖",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
