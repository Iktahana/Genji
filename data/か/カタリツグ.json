      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to pass down (a story) from generation to generation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この祭りの起源は古く、村人たちはその由来を代々語り継いできた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "彼女は、先祖から伝わる家宝の物語を、子供たちに丁寧に語り継いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「あの英雄の伝説は、いつまでも人々の心に語り継がれるだろう。」と歴史家は語った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "わしは進んで深く語り継ぐであろう。",
              "citation": {
                "source": "阿難と呪術師の娘",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "教員は深い嘆息と共に、私の方を顧み、そして世にも哀れな面持で、語り継ぐのであった。",
              "citation": {
                "source": "職工と微笑",
                "author": "松永延造",
                "note": "青空文庫"
              }
            },
            {
              "text": "○丈夫は名をし立つべし後の代に聞き継ぐ人も語り継ぐがね　〔巻十九・四一六五〕　大伴家持　大伴家持作、慕振勇士之名歌一首で、山上憶良の歌に追和したと左注のある長歌の反歌である。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "憶良の歌というのは、巻六（九七八）の、「士やも空しかるべき万代に語り継ぐべき名は立てずして」というのであった。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお笠金村が塩津山で作った歌、「丈夫の弓上ふり起し射つる矢を後見む人は語り継ぐがね」（巻三・三六四）があって、家持はそれをも取入れて居る。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども国に歴史あり家に父母祖父母の思い出があるように、どんなに微々たる一商店にもそれ相当の、後々へ語り継ぐべき苦心の物語があるものです。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "……なよたけの話を語り継ぐ人は貴方なのじゃ。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "語り継ぐものとてないこの里の云い伝えはこのまま永久に消え去って行くのじゃ。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、言い継ぎ語り継ぐとは歴史の根本心情である。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何を言い継ぎ語り継ぐのか。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "語り継ぐとは、祖先の悲願にわが一身を捧げることであり、殉じて悔いざるの情である。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "語り継ぐ人間が、再び彼の死によって一切の意味を語るであろう。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「以和為貴」とは憲法の条文となる前にまず端的な祈りであり、仏の前、民の前に言い継ぎ語り継ぐべき誓願であったろう。",
              "citation": {
                "source": "大和古寺風物誌",
                "author": "亀井勝一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「かね」には一つは、「語りつぐがね」と言ふ大きな一類の語群を持つて居たらしく、「言ひつぐがね」と言ふ同義語としての対句もある。",
              "citation": {
                "source": "副詞表情の発生",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "千頭家では息子の成人に当って、先祖伝来門外不出の言い伝えを語りつぐことになっている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が息子に語りつぐのはその金箱の隠し場所だ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その七　石の下",
                "note": "青空文庫"
              }
            },
            {
              "text": "○士やも空しかるべき万代に語りつぐべき名は立てずして　〔巻六・九七八〕　山上憶良　山上憶良の痾に沈める時の歌一首で、巻五の、沈痾自哀文と思子等歌は、天平五年六月の作であるから、此短歌一首もその時作ったものであろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "長歌の方に、「あしひきの八峯踏み越え、さしまくる情障らず、後代の語りつぐべく、名を立つべしも」（四一六四）とあり、短歌の方に、「丈夫は名をし立つべし後の代に聞き継ぐ人も語りつぐがね」（四一六五）とある。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "長歌には、「ますらをや空しくあるべき」という句が入ったり、「足引の八峰踏み越え、さしまくる心さやらず、後の代の語りつぐべく、名を立つべしも」という句が入ったり、兎に角憶良の歌を模倣しているのは、憶良の歌を読んで感奮したからであろう。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、そこへ以前の悪事仲間の日本左衛門に頼られて来て、つい、何かの相談に乗るようになったところへ、また折悪く出火に会って店を烏有に帰したので、その晩から元の裸一貫となると同時に、彼の仕事に組して老後の一かせぎという野心を起した――などと語りつぐ彼のことばもいかにも真実らしい嘆息に聞かれる。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
