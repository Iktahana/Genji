[
  {
    "uuid": "ffe8c7b9-fb43-5578-97d5-fa78166e6f5b",
    "entry": "カッと",
    "reading": {
      "primary": "カッと",
      "alternatives": [
        "かっと"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞",
        "動詞-サ変"
      ],
