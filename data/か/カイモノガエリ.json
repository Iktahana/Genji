        "examples": {
          "standard": [
            {
              "text": "買い物帰りに雨が降り出し、荷物が重くて傘を差すのに苦労した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "母は買い物帰りにいつも商店街の和菓子屋に寄っていく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "買い物帰りの彼女と駅前でばったり出会い、一緒に夕食をとることになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "小さく群れる学生の姿や、スーツケースを転がしたり、自転車を押す観光客の姿が現れ、夕食用の買い物帰りの人々と、朝、会社へ向かう人々の流れがすれ違う。",
              "citation": {
                "source": "鉄道模型の夜",
                "author": "円城塔",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月の十五日、月見のしたくに団子を拵えたあと、柳原堤へいって供え物の芒や、青柿などを買って帰る途中、同じ買い物帰りのおたかと偶然いっしょになった。",
              "citation": {
                "source": "柳橋物語",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
