        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして最後のもう一人は、六十幾つかの白髪豊かな品のいい老人で、詐欺取財で僕よりも後にはいって来て、僕等の仲間にはいったのだった。",
              "citation": {
                "source": "獄中記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "見れば美しい手弱女で、髪豊に頸足白く、嬋娟たる姿、※たける容貌、分けても大きく清らかの眼は、無限の愁いを含んでいて見る人の心を悩殺する。",
              "citation": {
                "source": "高島異誌",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "巴は色白く、黒髪豊かに長く、容貌もまことにすぐれた美女であった。",
              "citation": {
                "source": "現代語訳　平家物語",
                "author": "第九巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭髮豐かで、廣い額の、上の方が女にもめつたに無いクッキリとした富士びたいになつている。",
              "citation": {
                "source": "肌の匂い",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
