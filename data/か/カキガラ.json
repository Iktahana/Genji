[
  {
    "uuid": "2a6512b9-ebf3-563d-b370-4383eacc71ac",
    "entry": "牡蠣殻",
    "reading": {
      "primary": "かきがら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
