    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今度こそは乗遅れぬやうにと再び停車場に駆け付ける。",
              "citation": {
                "source": "雪中行",
                "author": "小樽より釧路まで",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が駆け付ける頃は、もう彼等は幾分眼を据えて腰掛の樽を叩いて、口論などが始まらうとしてゐることが多い。",
              "citation": {
                "source": "喜劇考",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏がいよいよ悪いとの報知があったので駆け付けると、もう息が絶えていた。",
              "citation": {
                "source": "鳴雪自叙伝",
                "author": "内藤鳴雪",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜更け、水道橋方面の新色のところへ駆け付ける、さながら「つるつる」を地でいったような志ん太君と大塚駅で別れる。",
              "citation": {
                "source": "随筆　寄席風俗",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "あまりに咄嗟の出来事で、遠ざけられた近習達が、駆け付ける暇もなかったのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金色の処女",
                "note": "青空文庫"
              }
            },
            {
              "text": "「笹野の旦那、こいつを頼みます」「お、心得た」　その内に遠慮して遠退いていた近習達も、騒ぎを聞いて駆け付ける様子。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "金色の処女",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　昨夜、孫六が殺された時刻――それよりほんの少し遅く、平次は関係者一同を、昨夜と同じ順序で土蔵の前へ駆け付けるように命じました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "月の隈",
                "note": "青空文庫"
              }
            },
            {
              "text": "――そのまま裏口から、八丁堀へ駆け付けるのだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "弥惣の死",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三十｜間遅れて行ったあっしが、駆け付けると右の通りだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "朱塗の筐",
                "note": "青空文庫"
              }
            },
            {
              "text": "崇拝者ポトカ伯夫人がニースから駆け付けると、瀕死のショパンは、この同国人に何か歌ってくれと言った。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あッ」　と言ったが、駆け付けるには少し遠く、大きな声を出せば、すぐ飛込まれるに決っております。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "振袖源太",
                "note": "青空文庫"
              }
            },
            {
              "text": "河へ飛込んだ親分の身を案じて、西両国の橋番所に駆け付けると、船を出して貰って現場――橋の下――へ漕がせたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "平次女難",
                "note": "青空文庫"
              }
            },
            {
              "text": "構うものかと薩摩下駄を引掛けて全速力で四谷坂町まで馳けつける。",
              "citation": {
                "source": "琴のそら音",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「御叔母さん京都の話でも、しましょうかね」　降る雨の地に落ちぬ間を追い越せと、乗る怒は車夫の背を鞭って馳けつける。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯を病んだ事のないものに、歯の痛みを持って行くよりも、早く歯医者に馳けつけるのが近道だ。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "雄太郎君は夢中でその右曲りの角へ馳けつけると、体を躍らすようにして向うの長い道路をのぞき込んだ。",
              "citation": {
                "source": "石塀幽霊",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがすむと、何喰ぬ顔をして車掌室にかえり、室内の騒ぎを始めて知ったような風を装って馳けつける。",
              "citation": {
                "source": "省線電車の射撃手",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "俥で波止場へ馳けつけるとその人はいま出帆したところであった。",
              "citation": {
                "source": "愛と認識との出発",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "近いくせに、いざというとき自動車がひろえないからここからのようにいそいで十分で馳けつけるという芸当が出来ず。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "万一、私が後から馳けつけるのに手間がとれ、悪い奴がお船の方を囲むようなことにでもなりましたら、私におかまいなくお船を海へ出しておしまい下さい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "弁信の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "なんしろ火事というものは、無縁のヤジウマが汽車にのって殺到するほど魅力にとんだものだから、血気の消防員が遠路をいとわず馳けつけるのもうなずけるが、温泉地の火事は後のフルマイ酒モテナシがよろしいから、近隣の消防は二ツ返事で救援に赴くということである。",
              "citation": {
                "source": "安吾巷談",
                "author": "熱海復興",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつと其の繭をつくる事が済むと人間は直ぐにヒーザアの小枝に馳けつける。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は病院へ馳けつける前に、已に多量のカルモチンを嚥んでいた。",
              "citation": {
                "source": "青い風呂敷包み",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの地に着きますと宮城野夫人のお住居へ馳けつける前に、まず市内のあるホテルへ室をとりました。",
              "citation": {
                "source": "機密の魅惑",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            },
            {
              "text": "緊急の処置を当直医に依頼し、午後七時頃馳けつける。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからすぐ馳けつける」という返事である。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "山田が立って「諸君、田中先生はやむを得ぬ用件で遅刻されますが、もうすぐ馳けつけるはずです。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハルコビヨウキ、キテクレ」　森川さんは車で馳けつけるだろう。",
              "citation": {
                "source": "いたずら小僧日記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は、米国の辻馬車屋がするように、彼等もまた揃って私の方に馳けつけるかなと思っていたが、事実はそれに反し、一人がしゃがんで長さの異った麦藁を四本ひろい、そして籤を抽くのであった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "その都度、火災を起しては、苦い経験を重ねているので、大きな雷鳴の伴う風雨には、たとえ非番の者でも、即刻、お城へ馳けつけるという掟になっている。",
              "citation": {
                "source": "夏虫行燈",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
