          "literary": [
            {
              "text": "八　鏡の中の俳優Ｉ氏　某百貨店の理髪部へはいって、立ち並ぶ鏡の前の回転椅子に収まった。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホテルの理髪部で理髪、又、有楽座のエンタツ・アチャコをきゝに行く。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十一年",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれ白髮の太子の御名代として、白髮部を定め、また長谷部の舍人を定め、また河瀬の舍人を定めたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれ御名代として、白髮部を定めたまひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでシラガの太子の御名の記念として白髮部をお定めになり、また長谷部の舍人、河瀬の舍人をお定めになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで御名の記念として白髮部をお定めになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
