        "examples": {
          "standard": [
            {
              "text": "家具職人は、仕上げの工程として木の表面を滑らかにするため、丁寧に鉋掛けを行っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "父は日曜大工で木材を加工する際、必ず鉋掛けで美しく仕上げるこだわりがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この作業は、木材の歪みを修正し、均一な厚みにするための鉋掛けが重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "そればかりか、塀の外では、「御用ッ、御用ッ」とさかんなかけ声。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "上方の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
