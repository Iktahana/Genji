        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "奇しく思いその名を聞くにカモシシと答う。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "問うカモシシは角あるにあらずや。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰く、それはカモシカ、これはカモシシにて違い候と。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通に深山に住むニクといいて山羊に似た獣をカモシカともカモシシとも呼ぶ（『重訂本草啓蒙』四七）が、丹峯和尚の『新撰類聚往来』上に字音豹と『康煕字典』にあるのみ、説明がない。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "氈和名カモ、褥呉音ニク、氈にも褥にもなったので、羚羊をニクともカモシシまたカモシカというといえば、マミの毛皮も氈の用に立てたのでカモシシといったものか。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく松浦侯が程ヶ谷で見たカモシシは野猪でなくて、外形ややそれに似たマミすなわちアナクマだ。",
              "citation": {
                "source": "十二支考",
                "author": "猪に関する民俗と伝説",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
