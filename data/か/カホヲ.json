          "literary": [
            {
              "text": "」ト　フエフキガ　ヒトリゴトヲ　イフト　ヂイサンハ　カホヲ　アゲテ、「サウサ、カナヅチハ　ナンデモ　ツクルンダ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オトウサンハ、タキクンノ　カホヲ　ノゾキコミナガラ、「オトナシク　シナキヤ　イケナイヨ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、コヒツジハ　コロサレルトハ　チツトモ　シラズニ　ヌスビトノ　カホヲ　ミアゲテ　ヰルノデ、ヌスビトハ　キウニ　カワイサウニ　ナリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドノ　ムラニモ　アマリ　ヒトハ　ヰナイデ、ノコツテ　ヰル　ヒトビトハ　ミナ　アヲイ　ヤツレタ　カホヲ　シテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、アカチヤンハ、コトリヲ　ミナイデ、ミチコサンノ　カホヲ　ミテ　ヰテ　ニツコリ　ワラヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、フシギサウナ　カホヲ　シマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタシノ　カホヲ　ミテ　ワラツタワ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケフハ　ガチヨウサンノ　タンジヨウビデスカラ　オデカケ　クダサイ」「ア、サウデスカ」「トコロデ、イタチサン、ヒトツ　オネガヒガ　アルノデスガ」「ナンデスカ」「アノ、スミマセンガ、ケフダケハ　オナラヲ　シナイデ　クダサイ」　イタチハ　ハヅカシクテ、カホヲ　マツカニ　シマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ミナサン」ト　モルモツトハ、シンパイサウニ　シテ　ヰル　ミンナノ　カホヲ　ミマハシテ　イヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミンナノ　モノハ　タメイキヲ　シテ　カホヲ　ミアハセマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ、アヒルサンノオカホヲゴランナサイ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オサルサンハ　タイソウハヅカシクナッテ、アカイカホヲ　モットアカクシマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
