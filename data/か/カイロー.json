          "literary": [
            {
              "text": "或ときアフリカのカイローといふ町に、さういふ蛇使で顔の売れた、アブト・エル・ケリムといふ男がゐました。",
              "citation": {
                "source": "蛇つかひ",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "831　カイローンはアキリュウスを教ふ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　埃及カイロー博物館にある、王アメノフイス四世が児を抱いて接吻しようとしてゐる、細部が見えなくなつた石の彫刻も僕の注意を牽いた。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "おなじくカイローの博物館に、ゼンヲスレト一世がプタ神を抱いて接吻するところがある。",
              "citation": {
                "source": "接吻",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから　聞こえてきたのが、　はさみの　ちょきちょき、　糸の　ちくちく　いう音、　さらには　ネズミさんたちの　たのしい　大きな　歌声が　――「２４人の　ふくやさん　マイマイを　つかまえにいく　いちばんの　つわものでも　そのしっぽを　つかめない　つのを　だした　その子は　カイローの　牛のよう。",
              "citation": {
                "source": "グロスターのふくやさん",
                "author": "THE TAILOR OF GLOUCESTER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
