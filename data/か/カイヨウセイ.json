        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "沿岸平野の気象は、海洋性の影響を大きく受けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この地域の降水量は、海洋性気団の動向に左右される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "島国は海洋性の特性により、大陸との気候差が大きい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
