        "examples": {
          "standard": [
            {
              "text": "SNSのコメント欄に、大好きなアーティストへの応援メッセージを書き込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「よし、解決策がわかった！」と、攻略サイトの掲示板に新しい情報を書き込む。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "匿名掲示板に心ない誹謗中傷を書き込む行為は、決して許されない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
