    "definitions": [
      {
        "index": 1,
        "gloss": "to take a turn for the better (of an illness, patient, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "入院して三日目から熱が下がり始め、病状は着実に快方に向かっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「先生のおかげで息子の容体が快方に向かっています」と、母親は主治医に深々と頭を下げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "精神科での治療を始めてから半年が経ち、彼の症状は少しずつ快方に向かっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "蒼ざめ痩せ細っていても、まだ快方に向かう希望のある中は、一歩も其処から解放されることはできないだろう。",
              "citation": {
                "source": "ある遊郭での出来事",
                "author": "公娼存廃論者への参考資料としての実例",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、こうして病気が快方に向かうにつれて、栄三郎に対する弥生の思いは募りにつのって、それも当初の生一本の娘ごころの恋情とは違って、あいだにお艶というものがあるだけに、いっそう悪強い、人の世の裏をいく執拗な妬婦の胸中に変わろうとしていた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
