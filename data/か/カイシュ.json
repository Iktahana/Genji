[
  {
    "uuid": "0c44bb83-7bf4-5ab2-ad63-f9414ae61bab",
    "entry": "会主",
    "reading": {
      "primary": "かいしゅ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sponsor of a meeting",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "茶会の会主は毎月異なる人が務めることになっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "会主としての責任を果たすために、彼は真剣に準備に取り組んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "会主がゲストをもてなす様子は上品であった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "彼の心の中にどっしりと腰を下して、彼に明確な針路を示したものは、社会主義の理論と、信念とであった。",
              "citation": {
                "source": "生爪を剥ぐ",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "銭湯の湯船の中で見る顔には帝国主義もなければ社会主義もない。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "満員電車にぶら下がっている人々の傍を自動車で通る人があるから世の中に社会主義などというものが出来るという人がある。",
              "citation": {
                "source": "電車と風呂",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在の科学の基礎方則を疑うのは危険であっても、社会主義が国家主義に危険であったり青年の思潮が老人に危険であるのとは趣を異にする。",
              "citation": {
                "source": "方則について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと云って彼は有りふれの社会主義者でもなければ共産党でもない。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は日本が過去の栄華から、幻燈に似た流行を耽溺するプチ・ブルジョワの一群と、実生活から畸型的に形成されたブルジョワ末期の社会に発生したプロレタリア精神の出現を、繁雑な社会主義理論闘争から逃れて、私を信仰する一人の女性の涙とともに東京駅を離れて品川の砲台、横目で計算していた。",
              "citation": {
                "source": "恋の一杯売",
                "author": "Love on Drought",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、僕が、社会主義の話をしてきかせると、非常に嬉しがってきいている。",
              "citation": {
                "source": "小豆島",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒い冬の晩で、藁仕事をしながら一家の者が薄暗い電燈の下に集っている時、農村の話をし社会主義の話をしたものである。",
              "citation": {
                "source": "小豆島",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会主義と云えば、彼等は、毛虫のように思っている。",
              "citation": {
                "source": "選挙漫談",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、彼等は、その毛虫の嫌う、社会主義によらなければ、永久の貧乏から免れないのだ。",
              "citation": {
                "source": "選挙漫談",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "対岸には、搾取のない生産と、新しい社会主義社会の建設と、労働者が、自分たちのための労働を、行いうる地球上たった一つのプロレタリアートの国があった。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会主義的建設が行われだした。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会主義的社会の建設に恐怖しているブルジョア国家の手がそこに動いていた。",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "アメリカの社会主義作家、アプトン・シンクレエアは、「義人ジミー」に於て、帝国主義戦争に対する、プロレタリア階級のいろ／＼な意識の内訌を書いている。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "欧洲諸国間の帝国主義戦争の危機が次第にはげしくなって行くと、それらの国々に於ける社会主義者や戦闘的労働者は、この戦禍に対する反対運動を開始した。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、やがてアメリカの社会主義者をも立たせ、ジミーの属するリースヴィル社会党支部も演説会を開き、反対した。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "インタナショナリストであり、社会主義者であるジミーが、そういう武器を作ることが、立派な行為であろうか？",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、ついに、ジミーのような正直な社会主義者をすら有頂天にした。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "米国の社会主義者は、世界で唯一のプロレタリア国ロシアをふみにじっている独逸を倒すという範囲内で大戦に参加する者が出来てきた。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、プロレタリアートと戦争　　　　　　一　プロレタリアートは、社会主義の勝利による階級社会の廃棄がなければ、戦争は到底なくならないということを理解する。",
              "citation": {
                "source": "反戦文学論",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "社会主事　佐伯正氏群れてかゞやく辛夷花樹、　　雪しろたゝくねこやなぎ、風は明るしこの郷の、　　　　士はそゞろに吝けき。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩きながら大槻は社会主義の運動やそれに携わっている若い人達のことを行一に話した。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "行一は電車のなかで、先刻大槻に聞いた社会主義の話を思い出していた。",
              "citation": {
                "source": "雪後",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうも女の社会主義者は、虚栄心が強くて困る。",
              "citation": {
                "source": "渡り鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど貴様は社会主義労働運動の急を大声疾呼したさ。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この節の議会の問答のやうに、仏教家の平和主義ならばいゝが、社会主義者の平和主義は不可いといふやうなものぢやありませんか。",
              "citation": {
                "source": "私有農場から共産農団へ",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンジカリズムの理論体系や、ロオドベルトスの社会主義論や、マルクスとコンミュンの話や、時にビスマルクやブハリンにまで彼女の論説は及んで行きます。",
              "citation": {
                "source": "智慧に埋れて",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……本名｜五十嵐伝吾、北海道産物商会主とある名札を持つから、成程膃肭臍も売るのであろうが、他に何を商って、どこに住むか、目下の処いまだ定かならずである。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "）（あれは有名な社会主義者だよ。",
              "citation": {
                "source": "『春と修羅』補遺",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "（七）社會主義と自然主義▲更に思潮界に於ては、悪性を帯びたる社会主義の蔓延。",
              "citation": {
                "source": "警戒すべき日本",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
