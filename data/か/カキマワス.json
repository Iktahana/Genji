[
  {
    "uuid": "8ef8a190-13f8-591e-a94a-68c26208572d",
    "entry": "かき回す",
    "reading": {
      "primary": "かきまわす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
