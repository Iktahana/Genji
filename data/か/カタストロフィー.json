        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "物語の終盤、積み上げてきた平和が一夜にして崩れ去るカタストロフィーが観客に衝撃を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「このまま温暖化が進めば、人類は取り返しのつかないカタストロフィーを迎えるだろう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "巨大隕石の衝突というカタストロフィーを回避するため、科学者たちは必死のシミュレーションを繰り返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "バブル崩壊がもたらした経済的なカタストロフィーは、多くの企業の運命を狂わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "このような泪ぐましい情景は、末永く二人の上に止っているように誰しもが祈りたいところであるが、筆者は文章を売るため心を鬼にして、ここに突如として降って湧いたようなカタストロフィーについて述べなければならない。",
              "citation": {
                "source": "仲々死なぬ彼奴",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、その十億キロの意味がそのときハッキリ私に判っていたとしたら、あんなカタストロフィーは起らなかったかもしれない。",
              "citation": {
                "source": "ある宇宙塵の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は額ににじむ汗を拭おうともせず、いまにどんな恐しいカタストロフィーが来るかと思って、胸の鼓動は益々激しくなった。",
              "citation": {
                "source": "初往診",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はとうとう予期したカタストロフィーが来たと思った。",
              "citation": {
                "source": "初往診",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それは恰かも、私の目の前で、一つの運命が、長い運命が、その傷ましいカタストロフが（その鉛筆が止まつて、その悲しげな、空虚な手の上にかすかに顫へながら凸出する瞬間まで、高まつてゆくところの）、演ぜられてでもゐるかのやうでした。",
              "citation": {
                "source": "巴里の手紙",
                "author": "ライネル・マリア・リルケ　Rainer Maria Rilke",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會政策主義者や社會改良論者が連續的なる「進歩」を實現しようと努力するのとは反對に、サンヂカリストは「資本主義から社會主義への經過を、それの過程は敍述し得ぬところのひとつのカタストロフとして理解する＊。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "このデカダンスから人類を救ひ出すものは唯プロレタリアの暴力の行使による究極的なるカタストロフしかない。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとつの絶對的なるカタストロフが押し迫つてゐる、この感情に於て彼等は明かにペシミストである。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが長々と育まれて来た呪いは、遂に最後のカタストロフを導き出すことになったのです。",
              "citation": {
                "source": "三角形の恐怖",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのことで、とにかく事実に於て、カタストロフェがすんでから、人格的にあれ丈の破壊をあえてするのには、それまでの良人に対する態度が、何だか、あまり、心から無邪気すぎ――無反省すぎはしないか。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しも誰かが大平楽な気分になつて、もう一年たつた今日、あのやうなカタストロフは無いと云ふなら、それこそ迷信家を以て呼ばう。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐ前は低い線路で、その青白い色に光っているレールが、凡てのものを或るカタストロフへ引き寄せようとしているらしかった。",
              "citation": {
                "source": "微笑",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして愈々最後のカタストロフって幕さ……と云っても、それは勿論喜劇だがね。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは一見して、ごくつまらない、誰の眼にも立たないようなことでしたが、これこそあのカタストロフを引き起す原因となったのです。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもカタストロフのちょっと前なんです。",
              "citation": {
                "source": "クロイツェル・ソナタ",
                "author": "KREITSEROVA SONATA",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　かう云ひ出したので、此対話の終には、将来革命といふ詞の代りに、カタストロフエといふ詞を使はせようと相談した。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "とう／＼本物のカタストロフエが来たのである。",
              "citation": {
                "source": "板ばさみ",
                "author": "オイゲン・チリコフ　Evgenii Nikolaevich Chirikov",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたはバカだから、なんとかすれば生きのびられるかもしれないなんて幼稚なことをかんがえているのでしょうが、よしんばクウ・デタからは助かったって、日本自体が無くなってしまうかもしれない、想像もつかないようなひどいカタストロフのなかで、あなたのようなとんまなひとがどうして生きていけるもんですか。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "その寄席芸人とのカタストロフは、拙作小説「下町育ち」中に言及したから贅さない。",
              "citation": {
                "source": "異版　浅草燈籠",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれはアリストテレスをかざして、古典的悲劇を、そのカタストロフィを、身ぶりあやしげに、説いてきかせる。",
              "citation": {
                "source": "希臘十字",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "古風な物語の癖として、クライマックスの次には、カタストロフィという曲者が、ちゃんと待ち構えていた筈です。",
              "citation": {
                "source": "パノラマ島綺譚",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、芝居は型の如くクライマックスに達し、カタストロフィに落ちて、惜しい大団円を結んだ。",
              "citation": {
                "source": "百面相役者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
