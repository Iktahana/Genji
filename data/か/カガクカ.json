  {
    "uuid": "e96a6411-1b09-5f8b-92fa-979b64ccef93",
    "entry": "科学科",
    "reading": {
      "primary": "かがくか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
