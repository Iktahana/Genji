    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その論文の存在は、『ｂｉｔ』誌に東京大学理学部情報科学科の助手だった坂村健が書いていた記事で知った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "君は科学科学と云っているだろう。",
              "citation": {
                "source": "独身",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は君より、もっと科学主義者だと思えばこそ、君のように安っぽく科学科学といいたくないだけだ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たゞ、私がこゝで一言この問題に触れたいと思ふのは、近頃科学科学と方々でやかましく云ひだした、その動機が如何にも浅薄で外聞がわるい。",
              "citation": {
                "source": "一国民としての希望",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、これほど、科学科学とさわがれる世の中でありながら、それでは「科学とはなにか」ときかれると、きわめてあいまいな返事をされる人のほうが多い。",
              "citation": {
                "source": "犬がなくとガラスがこわれるか",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
