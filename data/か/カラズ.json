        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "異人ハタヨルベカラズ、就イテ少シク学ブダケデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホップのつるが、両方からのびて、門のようになっている白樺の木には、「カッコウドリ、トオルベカラズ」と書いたりもしました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "見料モ亦忘ルベカラズ」「わははははは。",
              "citation": {
                "source": "旗本退屈男　第四話",
                "author": "京へ上った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤヂのワカラズヤであるに驚く、彼はガムシヤラで世の中を渡る男に過ぎない。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "水　満洲の水は悪いというので、軍隊が基地点へゆき着くと、軍医部では直ぐにそこらの井戸の水を検査して「飲ムベシ」とか「飲ムベカラズ」とか云う札を立てることになっていた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると、その札に曰く「人馬飲ムベカラズ」　人間は勿論、馬にも飲ませるなと云うのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも満洲の水も「人馬飲ムベカラズ」ばかりではない。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "（世紀ノ更新ヲ十進數ニ依リテ思考スベカラズ）。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二十世紀ノ人類ハ聰明ト情意ヲ増進シテ「然リ然リ」「否ナ否ナ」ニテ足ル者ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "全日本國民ハ心ヲ冷カニシテ天ノ賞罰斯クノ如ク異ナル所以ノ根本ヨリ考察シテ、如何ニ大日本帝國ヲ改造スベキカノ大本ヲ確立シ、擧國一人ノ非議ナキ國論ヲ定メ、全日本國民ノ大同團結ヲ以テ終ニ天皇大權ノ發動ヲ奏請シ、天皇ヲ奉ジテ速カニ國家改造ノ根基ヲ完ウセザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ノ短所ナリト考ヘテ新ナル長ヲ學ブ者ト速斷スベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "個人ノ自由ナル活動又ハ享樂ハ之レヲ其ノ私有財産ニ求メザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ土地問題ハ單ニ國内ノ地主對小作人ノミヲ解決シテ得ベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私有財産限度ト私人生産限度トヲ同一視スベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一切ノ地主ナカラシメント叫ブ前世紀ノ舊革命論ヲ、私有限度内ノ小地主對小作人ノ間ニ巣ハシム可カラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國語問題ハ文字又ハ單語ノミノ問題ニ非ズシテ言語ノ組織根底ヨリノ革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "下掲國家ノ權利ニ説ク如ク、日本ハ最モ近キ將來ニ於テ極東西比利亞濠洲等ヲ其ノ主權下ニ置クトキ、現在ノ歐米各國語ヲ有スル者ノ外ニ新タニ印度人支那人朝鮮人ノ移住ヲ迎フルガ故ニ、殆ド世界凡テノ言語ヲ我ガ新領土内ニ雜用セシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "主權國民ガ西比利亞ニ於テ露語ヲ語リ濠洲ニ於テ英語ヲ語ル顛倒事ヲナス能ハザルナラバ、日本領土内ニ一律ナル公語ヲ決定シ彼等ガ日本人ト語ルトキノ彼等ノ公語タラシメザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "精神的價値等ヲ擧ゲテ遊戲ノ本旨ヲ傷クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ガ全亞細亞ノ盟主タル大使命アルナラバ、人倫ノ大本ヲ嚴守勵行スル立法ハ實ニ一日ヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "自由ハ自由ノ侵害者ヲ拘束セザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "終局ハ國民精神ノ神的革命ナラザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "凡テノ光榮ハ其レヲ維持スベキ物質的條件ヲ缺クベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ誤解シテ限度超過額ノ上納ヲ促ス者トシ又ハ國民ノ獨自放膽ナル消費ヲ拘束スル者ト考フベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "本然ノ人情其者ガ凡テノ法律道徳ノ根源ナルヲ忘ルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ過般ノ暴動ト米國市中ノ黒白人爭鬪トヲ比較スルトキ其ノ恥辱ノ程度ニ於テ日本ハ幾百倍ヲ感ゼザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "印度又ハ亞佛利加ノ住民ガ全然英人ト人種ヲ異ニセルニ對シテ、日鮮人ハ古來ノ混血融合ノミナラズ同一人種中ノ最モ近キ異民族ナル點ニ於テ屬邦タルベカラズ又植民地タルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
