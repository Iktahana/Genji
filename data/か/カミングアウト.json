        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ずっと隠してきたけれど、成人式を機に両親へゲイであることをカミングアウトした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "パートナーシップ制度の導入をきっかけに、職場でカミングアウトする人が増えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「カミングアウトしたことで、ようやく本当の自分として生きられる気がする」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「これをカミングアウトしたくはなかったのだが、先生、仕方がない。",
              "citation": {
                "source": "最愛の君",
                "author": "Ｈ・ビーム・パイパー　H. Beam Piper",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
