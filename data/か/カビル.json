        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「こうも湿気がひどいと、押し入れの革靴がすぐに黴びてしまう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あ、このミカン、底の方が少し黴びてるから他のは大丈夫かな」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「お餅を出しっぱなしにしておくと、あっという間に黴びるから気をつけて」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その証拠に、同じ場所においても黒レーベルが最もよく黴びるのでもわかる（これに次いでは青レーベルがよくかびるものである）。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
