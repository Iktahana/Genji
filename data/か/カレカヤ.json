        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "隣べは日のあたるよと、萩も枯れ萱も枯れぬと、よろしよと、見つつぬくもる、吾が和ぎごころ。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣りべは日のあたるよと、萩も枯れ萱も枯れぬと、よろしよと、見つつぬくもる、吾が和ぎごころ。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "男女を埋めている枯れ萱の穂は、大きな波をゆり立てるばかりだった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと小舎ほどもある枯萱を「背負枠」で背負って山から帰って来ることもある。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯萱を刈って山を焼く。",
              "citation": {
                "source": "温泉",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼間は金毛の兎が遊んでいるように見える谿向こうの枯萱山が、夜になると黒ぐろとした畏怖に変わった。",
              "citation": {
                "source": "闇の絵巻",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯萱の裏むらさきの、ほのぬくみ、かがやく根には、あなあはれ、白きなづなの花も群れたる。",
              "citation": {
                "source": "風隠集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "枯萱の裏むらさきの、ほのぬくみ、かがやく根にはあなあはれ、白きなづなの花も群れたる。",
              "citation": {
                "source": "篁",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉山のはずれが薄黄いろい枯萱の山窪となり、その山窪の原の中に一本ぽっつりと寂しく咲いているのもある。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ枯葉をつけている櫟林や、小松山や色美しい枯萱の原などを、かなり烈しい動揺を続けながらこの古びた乗合自動車は二時間あまりも走って、やがて下田街道へ出た。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "うす紅に葉はいちはやく萌え出でて咲かむとすなり山ざくら花花も葉も光りしめらひわれのうへに笑み傾ける山ざくら花かき坐る道ばたの芝は枯れたれやすわりてあふぐ山ざくら花うらうらと照れるひかりにけぶりあひて咲きしづもれる山ざくら花刈りならす枯萱山の山はらに咲きかがよへる山ざくら花",
              "citation": {
                "source": "樹木とその葉",
                "author": "梅の花櫻の花",
                "note": "青空文庫"
              }
            },
            {
              "text": "小さな杉や、丈よりも長い枯萱が繁つて居るので、誰が何處に居るのやら分らぬ。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "末吉の貝塚",
                "note": "青空文庫"
              }
            },
            {
              "text": "然うして枯萱を刈つて居る。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "末吉の貝塚",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほど近い枯萱山の傾斜を滑つて、彼等の影もまた靜かに旋囘してゐた。",
              "citation": {
                "source": "霾",
                "author": "三好達治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
