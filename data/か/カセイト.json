        "examples": {
          "standard": [
            {
              "text": "この着物は、手でかせ糸を紡いで作られています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔は、かせ糸を杼（ひ）にかけて織物をしました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "裁縫箱には、色とりどりのかせ糸が整理されて入っています。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "木の皮を煮てかせ糸を染めることまで自分でやるのを道楽にしていたようである。",
              "citation": {
                "source": "糸車",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……きょうよりは、小次郎を、青侍にとりたてて、遠侍の間において、働かせいと」　これは、思いもうけない、恩命であった。",
              "citation": {
                "source": "平の将門",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
