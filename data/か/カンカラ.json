        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ごく柔らかな、穏やかな、さやさやと薬缶から湯気が噴き出すような、かすかな音。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻が茶棚のブリキ缶から塩煎餅を取出し、饅頭の菓子器を出して、皆なの前においた。",
              "citation": {
                "source": "余震の一夜",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "喜田氏が慌てて蓋を閉めちがへた空缶からは、煙が白く這ひ出してゐたのだ。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に長火鉢あり、薬缶から湯気が立っている。",
              "citation": {
                "source": "父帰る",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとね、甘いおつゆがね、やはり缶から湯気のようにあがってきて、そこら中をふらふら漂うんだよ。",
              "citation": {
                "source": "火星探険",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "コップの食塩水が少しでも減ると、すぐに缶からなみなみと注いだ。",
              "citation": {
                "source": "反抗",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ブリキの缶から、塩せんべいを出し、二つほど、おしまさんの膝の上にのせる）おしまさん　　かまはないで頂戴。",
              "citation": {
                "source": "留守（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "目の前の缶から手さぐりに煙草を一本抜いたが、指にはさんだまま、その手で頬杖をついた。",
              "citation": {
                "source": "灰色の眼の女",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "兵士はもう機械の掃除を終えて、お粥を缶から出して小鉢の中にそそいだ。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "なめこ雑炊　なめこは缶詰でよいから、缶から出したらザッと水洗いする。",
              "citation": {
                "source": "夜寒に火を囲んで懐しい雑炊",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「はあ、僕が持って行きます」　俊次は框に腰をおろして、そこに置いてあった薬缶から、ゴクゴクと、咽喉を鳴らして、水を飲んだ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドロマイト弾を各容器の底に置き、導火線は外缶から内缶へ上空で次々に点火する。",
              "citation": {
                "source": "幽霊島",
                "author": "The Island of Shadows",
                "note": "青空文庫"
              }
            },
            {
              "text": "漁師たちの道具小屋にある、大きなドラム缶から、毎日一杯ずつ飲む。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
