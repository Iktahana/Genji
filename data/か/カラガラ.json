  {
    "uuid": "0b1ded00-37e5-501e-9884-c9626c6bf679",
    "entry": "カラガラ",
    "reading": {
      "primary": "からがら",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その夜露と泥とで辷り易くなった鉢の底を、生命カラガラ肩の上に押し上げて、よろめく足を踏み締めながら、外廊下のマットの上を一歩一歩と階段に近づいて行った時に彼は、幾度も幾度も今度こそ……今度こそ気が遠くなって、引っくり返るのじゃないかと危ぶんだ。",
              "citation": {
                "source": "白菊",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうかと思うと、私が命カラガラ爆撃を逃げて麦畑へ飛びこんで俯伏すと、この野郎、国民のイノチのもとの麦畑を踏み荒すとは何事か、と私につかみかかってトッチメる奴がある。",
              "citation": {
                "source": "帝銀事件を論ず",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ライトと屋根が吹ッとばされたが、船体へ一発も見舞われなかったのが幸運で、命カラガラ逃げて帰った。",
              "citation": {
                "source": "復員殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つだけ聴くとやや変だが、宮城県などは一円に今でもカラカラジ、その北に続く旧南部領はガラガイシ・ガラガラズまたはガラガイデ、秋田県にもカラガラスという鴉のような名があり、『青森県総覧』には五種六種の地方名が列記してあって、しかも土地によってはその幾つかを共に知っている。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
