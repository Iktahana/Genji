      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "cawing (of a crow)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それかあらぬか彼はただ徒らに気を弱くされてゐた。",
              "citation": {
                "source": "思ひ出す牧野信一",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかあらぬか、猫の瞳孔が紋むやうに、海は急劇に曇つて来て、今にも時化でもやつて来さうだ。",
              "citation": {
                "source": "海の詩",
                "author": "――人と海――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかあらぬか文士と呼ばれる人種の中にも、文学でも何でもない、といつて文学に全然関係がなくもないから、つまり文学の爪だの垢くらゐには関係のあることを何かと云々して、それで以て自身は文学のつもりでゐる人が少しはゐる。",
              "citation": {
                "source": "非文学的文士",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "別れる時その話のことで「明日かあさつては是非訪ねるから」と三田村自身云つたのだが未だに来ない。",
              "citation": {
                "source": "夏の夜の話",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "女　さうね、………だけど先づダンスする方が好かあないかしら。",
              "citation": {
                "source": "夢",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一時頃、やっとお目ざめになり、新聞ないかあと言い、寝床に腹這いになりながら、ひとしきり朝刊の検閲をして、それから縁側に出て支那の煙草をくゆらす。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「またそんな渋いことかあ。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫が仰向いて長火鉢の上の柱時計をみながら飛び出した喉豆に掛けた声で「七時かあ」と云つた。",
              "citation": {
                "source": "蜻蛉",
                "author": "――飜弄さる",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ふゝ……」　彼は何にも言ひたかあなかつた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際脳の灰白質を養う血管の中の圧力がどれだけ減るのかあるいは増すのかわからないが、ともかくもそんな気がする。",
              "citation": {
                "source": "春六題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "一望千里の滿洲の赤土の原、あかあかと夕燒にてらされ、ひとり馬で歩いて居る猫背の乃木將軍のすがたが、この眼に見えるのだ。",
              "citation": {
                "source": "人物に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と龜に言はれて、浦島は、眉をひそめてその方向を凝視し、「ああ、さう云はれて見ると、何かあるやうだね。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさかあの聖諦の乙姫が、そんな長屋の夫婦喧譁みたいな事をたくらむとは考へられない。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一緒に行くがね、おれは蛇だつて何だつてこの世の中にこはいものなんかありやしないが、どうもあの爺さんだけは苦手だ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「色氣なんかありませんよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「よかありませんよ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それよかなしきわが心いはれもなくて拳する誰をか責むることかある？",
              "citation": {
                "source": "山羊の歌",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "片っ端から母を異にする兄弟姉妹の間に、何かありはしないか？",
              "citation": {
                "source": "乳色の靄",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "自殺を思つたことも幾度かあつた。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "鏡が幾枚かあるがそれらに映る万象はみんなゆがみ捻れた形を見せる。",
              "citation": {
                "source": "厄年と etc.",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水力発電所が何箇所かある。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌人に病人が多いのかあるいは病人に歌をよむ人が多いのかどうか、事実は分らないが、私のこれまで読んだ色々の歌人の歌によって想像される作者の健康は平均すると中以下になりそうな気がする。",
              "citation": {
                "source": "宇都野さんの歌",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで私はすべての歌人に望むように宇都野さんの場合にも、どうかあまりに頭のいい自己批評から作歌の上に拘束を加えて、鮮明な自然の顔の輪郭が多少でも崩されるような事のないように祈りたいと思う。",
              "citation": {
                "source": "宇都野さんの歌",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤もこの最後のものは古くなったためもいくらかあるのである。",
              "citation": {
                "source": "颱風雑俎",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "水力発電所が何カ所かある。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかあらぬか、翁は天宙から頭上へ目庇のように覆い冠って来る塩尻の形の巨きな影を認めたかに感じた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "筑波山の夕紫はあかあかとした落日に謫落の紅を増して来た。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "稚気と未練に含まれて、そこに何かあるに違いない。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「誰かあたしのパパとママンになる人は無いかい。",
              "citation": {
                "source": "売春婦リゼット",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だらしがないな、羽織の襟が曲ってるよ、おかあさん、」「生意気いうよ、こどもの癖に、」二人は微笑して眺め合う。",
              "citation": {
                "source": "巴里のむす子へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
