        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "もし芥種のごとき信仰あらば、この山に移りてここよりかしこに移れと命うとも、かならず移らん、また汝らに能わざることなかるべしとイエスはいいたまいました（マタイ伝一七章二〇節）。",
              "citation": {
                "source": "デンマルク国の話",
                "author": "信仰と樹木とをもって国を救いし話",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一粒の芥種のごとし。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一粒の芥種、樹になるか、樹になるか。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神の国は芥種のようなものだ。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の芥種の譬はこうです、――神の国は播かれる時は微小でも、育てば樹ともいうべき大きさになる。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は小さい芥種でも、後には鳥｜棲むほどの大木となるという。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
