    "definitions": [
      {
        "index": 1,
        "gloss": "bill collection",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎月、商店街の店主たちは集まって掛け取りの方法について話し合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この会社では、月末に掛け取りの担当者が各家庭を回る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「うちの店は現金取引が主だけど、一部は掛け取りもしているんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "掛け取りに来た車屋のばあさんに頼んで、なんでもよいからと桂庵から連れて来てもらったのが美代という女であった。",
              "citation": {
                "source": "どんぐり",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "年寄りを初め、自動車屋の集金人、料理屋の掛け取り、女郎屋の「馬」、レストランの亭主、酒屋の番頭、待合の「お帳場」――それ等の人々が、各々双肌脱ぎになつてＡの指揮にもとづきながら懸声そろへてポンプのハンドルをあをつてゐた。",
              "citation": {
                "source": "雪景色",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その同じ夜に谷中の辻で、掛け取り帰りの商家の手代が、これも一刀にしとめられ、金を五十両取られたのであった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時己のほかにも掛け取りが十人くらいたまっていた。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かにあいに来たものか、茶屋小屋の掛け取りか、ことに依ればつけ馬かな。",
              "citation": {
                "source": "斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "誰かに会いに来たものか、茶屋小屋の掛け取りか、ことによれば付け馬かな。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そうらしいなあ」吉田は、大笑して、「酒屋が掛け取りに行くと――金がいるのか。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十八日　きょうはお母さんはお店のテーブルのところで、月末のかけとりの下拵え。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の肥料は田舎の経済事情の推移と、うちがかけとりの面倒さから貸をしないのとで本年などは、あの家はじまって以来の閑散さだそうです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "親の心ではなるたけ子どもらには苦労もさせたくないから、できる限り知らさないようにしてはいるものの、不意にくる掛取りのいいわけを隠してすることもできないから、実は隠そうとしても隠しきれない。",
              "citation": {
                "source": "去年",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "しづかに読書してゐると、若い女の足音がちかづいてきた、女人禁制ではないが、珍らしいなと思つてゐると、彼女はＦ屋のふうちやんだつた、近所まで掛取りにきたので、ちよつと寄つて見たのだといふ、到来の紅茶を御馳走した、紅茶はよかつたらう！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "二番目は堀川の猿まわしで、芝翫の与次郎、粂三郎のおしゅん、羽左衛門の伝兵衛、おつきあいに関三と団蔵と権十郎の三人が掛取りを勤めるというのですから、これだけでも立派な呼び物になります。",
              "citation": {
                "source": "三浦老人昔話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "小林はハツとして、突嗟に、俺は印刷屋の掛取りだ。",
              "citation": {
                "source": "一九二八年三月十五日",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は前夜主人の命令で、得意先に掛取りに行って、五百円余りの紙幣を風呂敷包にして懐中に入れ家へ持って帰る途中で落して終った。",
              "citation": {
                "source": "罠に掛った人",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は夢中で歩き廻っていたが、矢張り落した金の事を考えていたと見えて、掛取り先から主家へ帰る途順を歩いていたのだった。",
              "citation": {
                "source": "罠に掛った人",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんとうに、暮の気持がただよって居ると云う位のもので、あの一番せわしない、掛取りや、来年の準備に必要なものを景気をつけて売って居る商人やの姿が見えないから、いかにもしずかに自然に年の暮が立って行く。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "掛取りには昼頃行ったのだが、いま奥さんはお客さんとお話中だからしばらく待ってくれという事であったので、やむを得ず待つことにした。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "掛取りの居催促は、いまにはじまったことではなく、江戸の上邸では、毎年、四季の終りに、いつもこういうさわぎが起きる。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "三十二世｜利幹公の代、大晦日の午すぎから、れいのごとくに掛取りが二十と何人押しかけてきた。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれの大曽祖父、同名、久太夫と深志の大曽祖父の恒右衛門が、それならば、腹でも切って埓をあけようかといって、割場の詰合いへ掛取りを呼びこみ、辞宜にも及ばず、下座に並んで腹を切って見せた。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで掛取りは退散した。",
              "citation": {
                "source": "ボニン島物語",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、電車の中は案外すいていて、黄い軍服をつけた大尉らしい軍人が一人、片隅に小さくなって兵卒が二人、折革包を膝にして請負師風の男が一人、掛取りらしい商人が三人、女学生が二人、それに新宿か四ツ谷の婆芸者らしい女が一人乗っているばかりであった。",
              "citation": {
                "source": "深川の唄",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "……えゝ、ですから、かうして掛取りなんかも私、やらして貰つて――。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……又四郎はちょっと躊躇いを感じたが、思いきって案内を乞うと、妖婆のような女が顔を出して、「なんの用だい、掛取りなら銭なんかないよ、出なおしといで、ちぇっ、不景気な」　いきなりこう喚いた。",
              "citation": {
                "source": "百足ちがい",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう人通りもあるまいと思ったのは、家の中の考えで、通りへ出ると、掛取りの提灯が、雪の中をめげずに忙しそうに歩いています。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "天保銭掛取りは天秤棒でかつぎ回った　天保銭といえば今でも少々頭の足りない人間を連想する。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五枚ひとさしが二貫、即ち二十銭、晦日の掛取りに二、三本受け取ると、風呂敷に包んで天秤棒の先につけて担ぐ。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
