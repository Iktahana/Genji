        "examples": {
          "standard": [
            {
              "text": "会社のカフェテリアはメニューが豊富で、毎日違うものが食べられるから飽きない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "学食のカフェテリアで、友達と今日の授業の復習をしながらランチを食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "病院のカフェテリアは広くて明るく、患者さんだけでなくお見舞いの人も利用しやすい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あの美術館のカフェテリア、窓から見える景色が最高なんだよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ここはカフェテリア式の店で、前もって作ってある肉やサラダを、客が陳列してあるところまで行って、好みに合ったものを自由に取れるようになっています。",
              "citation": {
                "source": "アメリカの牛豚",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャーチ街のカフェテリアに留まるのも一苦労で、食後、自分を牽引する未知の力が一層強まっている感じがした。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこに、木造の、粗末だけれども清潔なキャフェテリア（自分で給仕する方式）の大食堂や、簡単な日用品の売店があって、本建築の仕上った本館は、すこしはなれたところに灰色と白で、清楚な四角い姿を浮き上らせていた。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "星製薬のキャフェテリアなども、代表的な、アメリカン・ランチ屋だったが。",
              "citation": {
                "source": "ああ東京は食い倒れ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
