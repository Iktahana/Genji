  {
    "uuid": "d32dd7d6-5bdc-5726-9769-7fbe51d2fe97",
    "entry": "潰敗",
    "reading": {
      "primary": "かいはい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
