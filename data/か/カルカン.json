    "definitions": [
      {
        "index": 1,
        "gloss": "steamed sweet bun made from grated yam and rice flour",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「わあ、真っ白でふわふわ！」鹿児島土産の軽羹を一口食べると、山芋の優しい香りが鼻を抜けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母は茶菓子として、よく地元の名店から取り寄せた軽羹を用意してくれていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "弾力があるのに口の中で解ける、この軽羹独特の食感は他の和菓子では味わえない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「これ、中にあんこが入っていないタイプの軽羹だね」と、素材そのものの甘みを楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「この軽羹というのが此処の名物で、長崎のカステラに匹敵するお国自慢です。",
              "citation": {
                "source": "ぐうたら道中記",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
