          "literary": [
            {
              "text": "霧島山が、桜島が、城山が、熱いお茶にカルカンの甘味しい頃ですね。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鹿児島が恋しいとお思いになりませんか、霧島山が桜島が、城山が、熱いお茶にカルカンの甘味い頃ですね。",
              "citation": {
                "source": "放浪記（初出）",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "留守番のカルカン君にあとをよく頼んできます。",
              "citation": {
                "source": "怪星ガン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
