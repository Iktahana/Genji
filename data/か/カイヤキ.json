        "examples": {
          "standard": [
            {
              "text": "浜辺で拾ったホタテを焼き網に乗せ、醤油をたらして貝焼きにして食べた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "居酒屋で注文した貝焼きは、殻の上でグツグツと煮立っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "アサリの貝焼きにバターと白ワインを加えると、香りが格段に増す。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "貝焼の訛りであらうと思はれる。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
