        "examples": {
          "standard": [
            {
              "text": "庭の片隅に植えた寒菅が、冬の寒さにも負けずに青々としている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "雨上がり、庭の寒菅の葉についた水滴がキラキラ光っていた。綺麗だな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "初夏には、寒菅の葉が茂ってきて、庭に緑の絨毯が広がります。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "「ひろれ」は蓑草で、本名は「みやまかんすげ」だというが、越後、羽後あたりでは「ひろろ」とか「ひろら」とかいう言葉を使う。",
              "citation": {
                "source": "蓑のこと",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
