        "examples": {
          "standard": [
            {
              "text": "春の貝寄せが吹く夜、浜には大量の貝殻が打ち上げられた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "貝寄せで有名な海岸には、採集者たちが訪れて貝類を集めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "陰暦2月20日の夜に吹く貝寄せは、昔から豊漁の前兆とされていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "風も、貝寄せに、おくれ毛をはらはらと水が戦ぐと、沈んだ栄螺の影も浮いて、青く澄むまで月が晴れた。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
