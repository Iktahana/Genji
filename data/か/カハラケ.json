          "literary": [
            {
              "text": "かくて不毛をアバラケ、それよりカハラケと転して呼ぶに及んだでなかろうか。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "色は黒色栗色鳶色カハラケ色等種々有りて表面の精粗も一定せず、製法は圖版中左の下に畫きたるが如し。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハマチャ　島根縣一帶に知られて居る茶の代用品で、クサネムといふものだといひ（出雲方言）、或はカハラケツメイのことゝもいふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
