        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は一度話が始まると、相手に絡みついて離さないタイプだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の苦い記憶が、時々心の奥底に絡みついてくることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "酔っ払いが、道行く人に絡みついて何か言っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "その噂は、いつの間にか彼の評価に絡みつき、簡単には消えなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
