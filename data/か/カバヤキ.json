    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鰻の蒲焼き、茶碗蒸し等に至りては世界第一美味の飛び切りとて評判を得ることなるべし。",
              "citation": {
                "source": "学問のすすめ",
                "author": "福沢諭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "卵の花｜寿司、鰯の天麩羅、海老の蒲焼き、豆滓の寿司――などというような飲食店で、四文出せば口にはいろうという、うまくて安い食物ばかりを、選んで出している飲食店なのである。",
              "citation": {
                "source": "娘煙術師",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "永井肥前守の家来辻貞叔は大福餅三百二十を平らげ、江戸堀江町の家主清水徳兵衛は鰻七貫目分の蒲焼きと飯五人前をぺろりとやってのけた。",
              "citation": {
                "source": "食指談",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "脂肪をあまり好まぬ人には鰻の蒲焼きよりもこの方が舌に合うかも知れぬ。",
              "citation": {
                "source": "鯰",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "虎の掛け物に、置き物は竜を置いたり、うなぎの蒲焼きと一緒にはもの照り焼きを出してみたり……すべて調和か統一かが大切だ。",
              "citation": {
                "source": "梅にうぐいす",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳川どじょうの大もの、五寸ぐらいなのは、蒲焼きに適し、うなぎとはぜんぜん異なった風格を有し、心うれしい気の起こるものである。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "どじょうにかぎって、小さいのを無理に蒲焼きにしても一向あり難くない。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京では埼玉の越ヶ谷辺の地黒というどじょうが上物で大きく、以前、うなぎの大和田あたりで盛んに蒲焼きにして、「どかば」と称して、一時人気を呼んだものである。",
              "citation": {
                "source": "一癖あるどじょう",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "鰻蒲焼き＊うなぎ好きは食通の至ったものではない。",
              "citation": {
                "source": "料理メモ",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのふぐの味を、うなぎの蒲焼きの美味さ、まながつおの味噌漬けの美味さ、まぐろの握りずしの美味さなどに比較しては、全く味なきに等しいものであった。",
              "citation": {
                "source": "海にふぐ山にわらび",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "蒲焼きには、まるごと薄醤油で煮つけたのをいったんさまし、その煮汁をつけてつけ焼きにしてから中骨をとる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "江戸のごひいき筋は、かば焼きをおあがりあそばすにも油をぬくぞ」「…………」「なんでえ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "油をぬいた江戸っ子好みのかば焼きかなんぞを用いてね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "幽霊水",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は大勢集めて一席やって、そのお礼に酒とウイスキーをもらい、ウナギは置き針でとれた百匁という大串を魚屋にさかせて、ミリンと醤油半々の手製のかば焼き。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、誰れが貼ったのやら、ふと、長屋の厠の壁押えに、京伝作の「江戸生艶気樺焼」の二三枚が貼り附けてあったところから、急に思い付いたのが、京伝へ弟子入の一件であった。",
              "citation": {
                "source": "曲亭馬琴",
                "author": "邦枝完二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
