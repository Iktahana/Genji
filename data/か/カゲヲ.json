          "literary": [
            {
              "text": "オカアサンタヌキハ　シンパイシテ、キノ　カゲヲ　カクレテ　サムラヒノ　アトヲ　ツイテ　イクノデス。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレニ　シテモ、ケイキキユウハ　ナント　イフ　リツパナ　マルイ　カゲヲ　モツテ　ヰル　コトデセウ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "スズメト　ポストト　ガイトウハ、ケイキキユウト　マルイ　カゲヲ　ミクラベテ　ウラヤマシガリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノハラノ　マンナカデ　カゲヲ　ミタラ、二ツトモ　チイサナ　チイサナ　カゲデシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「サア　カゲヲ　ミテゴラン。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミミヲ　クワエテ　ヒツパツタノデ、チビスケハ　シカタナク　クビヲアゲテ、ジブンノカゲヲ　ミマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ボクハ　オホキナ　カゲヲモツタ　コイヌダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマニ　モツト　オホキナ　カゲヲモツタ　オホイヌニ　ナルンダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
