        "examples": {
          "standard": [
            {
              "text": "祖母の手作りからし漬けは今までで一番美味しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "普段、ご飯にはからし漬けやたくあんのような漬物を少し添える。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このレストランでは、辛いからし漬けを含む様々な漬物を提供している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "仕事というのは背中に桜の印のある古はっぴを着て、天びん棒をかつぎ、たくあん、福神づけ、からしづけなどを売り歩くのである。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            }
          ]
