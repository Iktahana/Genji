        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ソウレ　ゴラン、オマエサンノ　カゲデ　ナイ　シヨウコニ、オマエサンガ　トンデモ、アノ　カゲハ　ウゴカナイデハ　ナイカ」ト　ポストハ　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚カナイデ、ヨクコノ手紙ヲ読ンデクレ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "告別式ハ青山斎場ナドヘ持ッテ行カナイデ、コノ家ノ庭ニ面シタ十畳ノ間ニ棺ヲ安置スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ妙ニ落チ着カナイデ、寝台ニ腰掛ケテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ恐々拭カナイデ、モット手ニカヲ入レテシッカリト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「食堂ヘ行カナイデモイヽジャナイカ、コヽニ鮨ガコンナニ残ッテル、コヽデコレヲ食ベナサイ」「ソウ、デハソウスルワ」「君ト鱧ヲ食ベルノハ浜作以来ダナ」「ソウダッタワネ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ソンナコトハ聞カナイデモイヽ、マア鱧ヲ食イナサイ」ソンナツモリモナク若イ時分ニ何気ナク見テ置イタコトガ、ドンナ時ニ役ニ立ツカ分ラナイモノダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "テープノ寸法モ測ッテアッタニ違イナイト思ウガ、ウッカリ丸メテシマッタノデ調ベルハ書カナイデオイテクレ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレハ僕モ考エルガ、ソレヨリ先ニ彼ラガ考エ出サズニハ措カナイデアロウ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナハ聞カナイデモイイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が木村と会合の場所に使った大阪の宿は、「ドコカナイデショウカト木村サンガ云ウカラ」敏子が「オ友達ノ或ルアプレノ人」に聞いて教えてやったのだというけれども、ほんとうにそれだけが真実であろうか。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
