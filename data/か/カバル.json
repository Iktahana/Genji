        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "東宝劇団は、十月の九日から有楽座で、高田保の作、ノエル・カワードの「カバルケード」の翻案を、一本立でやる由。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十二年",
                "note": "青空文庫"
              }
            },
            {
              "text": "スカルタッツィニ曰く、こは一二九五年ギベルリニ黨がブレッティノロより逐はれしをいふと一一五―一二〇【バーニアカヴァル】バーニアカヴァルロ、ラヴェンナの西にある町。",
              "citation": {
                "source": "神曲",
                "author": "LA DIVINA COMMEDIA",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァラエティ「ミュージック・カヴァルケード」。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "レオンカヴァルロ（Ruggero Leoncavallo 1857―1919）　歌劇「道化師」一つで有名になっている。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
