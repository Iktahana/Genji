        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "この商品の卸売掛率を30%に設定しました。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最近、アパレル業界では掛率の引き下げ交渉が活発だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このバッグの掛率は、他のブランドよりも高いらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "新規取引開始にあたり、まずは掛率について確認させてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "遠山のけぶるを見れば　思ふさびしさ朝雲雀　あまた啼きたつおほ野らに、休戦のらつぱ　ひゞきわたれりかけりつゝ、伏しつゝ思ふむなしさは、われくるしゑと　告げがたきかも雨あとの朝け　さやかなり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
