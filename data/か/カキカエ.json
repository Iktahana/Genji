        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あ、運転免許証の書き換え期間が今月末までだった！危うく忘れるところだったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "住所が変わったので、銀行の通帳や各種カードの書き換え手続きを一気に済ませてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "役所で健康保険証の書き換えを済ませた後、新しいカードを受け取って帰宅した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "transfer (of ownership)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
