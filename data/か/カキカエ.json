[
  {
    "uuid": "b7bd7d0d-dcb3-5fd1-86e9-aed8b4a85120",
    "entry": "書き換え",
    "reading": {
      "primary": "かきかえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
