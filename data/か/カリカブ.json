        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "稲刈りが終わった後の田んぼには、等間隔に並んだ乾いた刈り株が、冬の訪れを待つように残されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おーい、刈り株に足を取られないように気をつけて走れよ！ 転ぶと結構痛いぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夕暮れ時、畑の隅で積み上げられた刈り株を焼く煙が、里山の静かな風景の中にゆっくりと溶け込んでいった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "冬枯れの野原で、霜が降りた刈り株が朝日に照らされてキラキラと輝いている様子は、息を呑むほど美しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "刈り株ばかりの冬田の中を紅もめんやうこんもめんで頬かぶりをした若い衆が酒の勢いで縦横に駆け回るのはなかなか威勢がいい、近辺のスパルタ人種の子供らはめいめいに小さな凧を揚げてそれを大凧の尾にからみつかせ、その断片を掠奪しようと争うのである。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "儀式は刈り株の残った冬田の上で行なわれた。",
              "citation": {
                "source": "田園雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とそう私が云うと、刈り株の切り口で分るものだという。",
              "citation": {
                "source": "夜の靴",
                "author": "――木人夜穿靴去、石女暁冠帽帰（指月禅師）",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾人かは鍬をふるって、笹の刈り株を削り取ることに専念していた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "刈り株だけ残った田圃の幾つかには、秋の水がみなぎっていた。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄色っぽい灰色の四角は、去年の夏みのったカラス麦の畑で、いまは刈り株がのこっているのです。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつか夫妻の云い諍っていた田はもう稲が刈り取られたあとで、刈り株がきれいに並びしきりに雀が落ち穂を啄んでいた。",
              "citation": {
                "source": "菊千代抄",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しっとりと柔らかく乾いた田の土、きれいに揃った刈り株、……そこに竹次やおいくや正太の姿が見えるようである。",
              "citation": {
                "source": "菊千代抄",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはそのときばけものの胃ぶくろのなかでこの網をだしてね、すっかりかぶっちまうんだ。",
              "citation": {
                "source": "いちょうの実",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とめはいそいで自分のたべた飯茶碗を流しの小桶の中へつけると、野良着へ手拭をしっかりかぶって、土間から自転車をひき出した。",
              "citation": {
                "source": "共同耕作",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大勢の家来達に言いつけて、丈夫な縄の大きな網をこしらえさせ、これを庭の大木のまわりに張らせ、網につけた綱を一本引けば、網が大木の根下にすっかりかぶさってしまうようにしました。",
              "citation": {
                "source": "雷神の珠",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭には、上から落ちてくる岩をふせぐための弾力のある帽子をしっかりかぶり、手にはするどい鉤のついた小さい手斧と、強い燭光の手提灯をもち、腰には長い綱をさげていた。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "化物なんか居るものかと云ってた癖に、化物贔屓の俊子さんがいらっしたものだから、すっかりかぶれちゃって、つまらない話をしてるのね。",
              "citation": {
                "source": "月明",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "亡くなった私の弟なども、すっかりかぶれてしまって、四、五人で同人雑誌を作るというところまで進展して行った。",
              "citation": {
                "source": "若き日の思い出",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "藤原威夫の禅坊主のような骨の高い頭のてっぺんは、まじめな軍人として、軍帽ばかりかぶりつづけて来た男らしく、年に似合わず薄くなっている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで兄は、さきの妻のトシエと、笹の刈株で足に踏抜きをこしらえ、臑をすりむきなどして、ざれついたり、甘い喧嘩をしたり、蕨をつむ競争をしたりしていた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "黄いろくからびた刈株をわたッて烈しく吹きつける野分に催されて、そりかえッた細かな落ち葉があわただしく起き上がり、林に沿うた往来を横ぎって、自分の側を駈け通ッた、のらに向かッて壁のようにたつ林の一面はすべてざわざわざわつき、細末の玉の屑を散らしたように煌きはしないがちらついていた。",
              "citation": {
                "source": "武蔵野",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "痩せたクリストフが刈株のやうな腮鬚で領をこすりながら、ゆつくり何やらを咬んでゐる音と、ペピイががつがと痰を吐きながら、折々余り近くに寄つて来た子供や犬を叱る声とを聞いてゐる。",
              "citation": {
                "source": "老人",
                "author": "GREISE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは薄曇りの風の弱い冬日であったが、高知市の北から東へかけての一面の稲田は短い刈株を残したままに干上がって、しかもまだ御形も芽を出さず、落寞として霜枯れた冬田の上にはうすら寒い微風が少しの弛張もなく流れていた。",
              "citation": {
                "source": "鴫突き",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今でも刈株が殘つとります。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "勘次は自分の後の田へ出て刈株を引つ返しては耕した。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "白つぽく乾いた刈株の間には注意して見れば處々に極めて小さな穴がある。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は陸稻の刈株を叮嚀に草鞋の先で蹂んで見た。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "田圃の鴫が何に驚いたかきゝと鳴いて、刈株を掠めるやうにして慌てゝ飛で行た。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "過ぎ去りし日の事榮は、刈株の芽生を伸して、花こそ咲け。",
              "citation": {
                "source": "白羊宮",
                "author": "薄田淳介",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう夕方で黄ろな夕陽が路傍に見える水田の稲の刈株に顫えついていた。",
              "citation": {
                "source": "雁",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも隣の嫗よりもらひしといふ萩の刈株寸ばかりの緑をふいてたくましき勢は秋の色も思はる。",
              "citation": {
                "source": "小園の記",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "洒堂の句の物二、三取り集むるというは鳩吹くや渋柿原の蕎麦畑刈株や水田の上の秋の雲の類なるべく、洒堂また常に好んでこの句法を用いたりとおぼし。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかれども洒堂のこれらの句は元禄の俳句中に一種の異彩を放つのみならず、その品格よりいうも鳩吹、刈株の句のごときは決して芭蕉の下にあらず。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            },
            {
              "text": "洒堂の句の物二、三取集るといふは鳩吹くや渋※原の蕎麦畑刈株や水田の上の秋の雲の類なるべく、洒堂また常に好んでこの句法を用ゐたりとおぼし。",
              "citation": {
                "source": "俳人蕪村",
                "author": "正岡子規",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
