    },
    "definitions": [
      {
        "index": 1,
        "gloss": "first half of the (fiscal) year",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「上期の売上目標、なんとかギリギリで達成できたよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "上期の決算発表に向けて、経理部は連日深夜まで作業に追われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「上期で浮いた予算を、下期のプロモーションに回しましょう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "昨年度の上期はコロナ禍で苦戦したが、今年はV字回復を見せている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "また時代も万葉上期だから、その頃の純粋な響・語気を伝えている。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "溯上期の鮎も『岡なめ』を残す。",
              "citation": {
                "source": "水垢を凝視す",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "溯上期の鮎も「岡なめ」を残す。",
              "citation": {
                "source": "水垢を凝視す",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこの近郊都市群は、今世紀の初めからめざましい発展をして、一九二〇年には、もうネバダ山脈からの水だけでは、ロスアンゼルス及びその近郊都市、即ちアメリカの大切な工業地域である南カリホルニアの発展は、これ以上期待出来ないことになってしまった。",
              "citation": {
                "source": "アメリカの沙漠",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、やっと答えたときには、それは、集まっている一同をはじめ、お高自身も半ば以上期待していたとおりの文句であった。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこれらの国の力が増大し合体するにつれ、遂に、かかる侵入による成功をこれ以上期待することは一切出来なくなった３）。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここ数回は、清盛の出家と、一門繁昌の頂上期で、ひとまず筆を転じ、牛若丸をめぐる“陰の人びと”とその母常磐の以後の境遇を摸索して書いてきた。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かみきりや姿を見せよ神国のおそれを知らばやくたたらざれ",
              "citation": {
                "source": "簪につけた短冊",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは一座のなかでも、いちばんきりょうよしの人形でしたのに、にくにくしいブルドッグのために、あたまをかみきられてしまったのですからね。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして堰を切ったように涙が流れ出ようとするのを糸切り歯でかみきるばかりにしいてくいとめた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "試行錯誤の末、ついにマイクロコンピューターのイメージをつかみきれぬまま卒業することになった加藤だが、石油ショック後の就職難の中で、第一志望の日本電気に職を得ることができた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ学生時代の加藤明は、資料不足に泣かされて一年近くもマイクロコンピューターに取り組みながら、ついにそのイメージをつかみきれないまま卒業するという悲惨な目にあっているのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "幾度来てもキット猫か犬に殺されるものときまった様な自分の女房は十日ほど前にまっくろな目ばかり光る魔の様な黒猫にのどをかみきられて一声も立てずに死んでしまった。",
              "citation": {
                "source": "芽生",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ようようのことで猟犬から逃れはしましたが、悪魔に一番大切な尻尾の先を、半分ばかりかみきられて、宙を飛んだり物に化けたりする術を失ってしまい、その上仲間の者とはぐれてしまって、仕方なしにその崖下のくさむらに隠れているのでした。",
              "citation": {
                "source": "天下一の馬",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日、大きな、かみきりむしが飛んできてぷつりと切ってしまいました。",
              "citation": {
                "source": "谷間のしじゅうから",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君、ぼくの指を本当にかみきるツモリじゃなかったの？",
              "citation": {
                "source": "街はふるさと",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで別天王の懲しめによって悪者は狼にノド笛をかみきられるという正しい行事の形式を踏まなければ気持がおさまらなかったのが一ツ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "メスメリズムにかけておいて、なんなくノド笛をかみきって殺したのだ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "一ヶ所はノド笛をかみきった傷、一ヶ所は腹をさいた傷。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすればノド笛をかみきられたのが先にできた致命傷、あるいは致命傷にちかい抵抗不能の状態を与えるに足る深傷であったと分るのですが、ノド笛にかみついた以上は被害者の真ッ正面から抵抗をうけなければなりません。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "はで　かみきるはめに　なりました。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘はそうしてセエラが見えなくなるまで、かじりかけのパンをかみきりもせず、じっとセエラを見守っていました。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "其の長い触角で有名な、あのかみきりむしもやはりもとは白虫だ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "長いかみきりの触角を幼虫は何でつくるのだらう？",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、まるで此の不潔な必要を償ふように、それ等の幼虫の一つは、あとでは磨いた青銅と其の光輝を競ふ綺麗な蠅になるし、他のものは、見事な宝石や金の光彩と其の立派な上衣とを競はせて麝香の匂をさせてゐるかみきりになるのだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "ないと答えると、まだ疑わしそうな顔をしていたが、「食事を終えたら、ではそろそろ、でてくれたまえ」　といい、ポケットからふとい葉巻をつまみだしてぷいと口をかみきると、隅のがたがたベッドにずしんと腰をおろして、紫のけむりをはきながら、にやにやわらっている。",
              "citation": {
                "source": "放浪作家の冒険",
                "author": "西尾正",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがさすがは狼王、ふっと身をかわして繩をくわえとり、その結び目をかみきってずたずたにした。",
              "citation": {
                "source": "動物物語　狼の王ロボ",
                "author": "アーネスト・トムソン・シートン",
                "note": "青空文庫"
              }
            },
            {
              "text": "をとどし枯れたポプラを薪にしたところが、中には澤山のかみきり虫の幼虫が入つてゐて、木もこれでは生きられないと思ふ程だが、中に立派なかみきりの成虫が入つてゐた事だ。",
              "citation": {
                "source": "春",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "蜂、虻は朽木のうろなどに冬を隱れてゐるものだが、かみきりも越年するかどうか。",
              "citation": {
                "source": "春",
                "author": "横瀬夜雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ガンを地べたにおいて、逃げられないように、前足でおさえつけ、いまにもその首をかみきろうとしました。",
              "citation": {
                "source": "ニールスのふしぎな旅",
                "author": "NILS HOLGERSSONS UNDERBARA RESA GENOM SVERIGE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
