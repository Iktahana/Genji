        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "このタナゴの競技会も、数釣りと目方釣りとたいがい二回くらいやる。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、数釣りのときは、魚の小さいのをよって釣る。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "千葉県の養老川でも同じだが、そんなところでやる数釣り競争のときは、餌釣りよりも、蚊針の瀬釣りのほうに、分がある。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ数釣りのアナゴのこと、手を使わず海にあかりがもれずに電灯がつくことを考えた。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三日月」とは魚の上アゴのことで、五百、六百と数釣りのタナゴなので、いちいち上アゴにかかった釣り針をはずすということはできない。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "マハゼの要領で、ただ、地底が平場よりゴロタ石の間とかソダまわりでの数釣りだけに、針の返りのアゴを取ってやってみたが、思ったほどバレも少なかった。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
