          "literary": [
            {
              "text": "浅草独得（ではないが、そんな気がする）の牛めし、またの名をカメチャブという。",
              "citation": {
                "source": "浅草を食べる",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛ドンの、カメチャブ屋のことは、今回は語らないことにしよう。",
              "citation": {
                "source": "牛鍋からすき焼へ",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "カメチャブと称し、一杯五銭なりしもの。",
              "citation": {
                "source": "下司味礼讃",
                "author": "古川緑波",
                "note": "青空文庫"
              }
