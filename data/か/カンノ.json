        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "子供が飴を買うと、お愛嬌に何か訳のわからない唄を歌って、カンカンノウといったような節廻しで、変な手付きで踊って見せる。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て見ると、いつの間に来たか知らず、塩煎餅屋の前に子供をあつめて、唐人飴の男が往来でカンカンノウを踊っていた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "他人から見れば随分気の毒なわけですが、当人頗るのん気で、往来でカンカンノウを踊っているのが面白いという始末。",
              "citation": {
                "source": "半七捕物帳",
                "author": "唐人飴",
                "note": "青空文庫"
              }
            },
            {
              "text": "――ね、あんたアミダ様、わたしカンノン様。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "動物の世界の物語であるが、この短篇集の中に若い雄の白｜海豹ルカンノンの物語がある。",
              "citation": {
                "source": "山の彼方は",
                "author": "――常識とはどういうものだろう――",
                "note": "青空文庫"
              }
            },
            {
              "text": "北極光の照らす深い北海の年々の集合所から真白い一匹の雄海豹のルカンノンが自分の躯にうずく希みにつき動かされて、海豹の群がまだ一度も潜ったことのない碧い水の洞をぬけて遠く遠く新しい浜辺を求めて行く冒険が情趣深く描かれている。",
              "citation": {
                "source": "山の彼方は",
                "author": "――常識とはどういうものだろう――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちの心にこのルカンノンの憧れの心がないといえるだろうか。",
              "citation": {
                "source": "山の彼方は",
                "author": "――常識とはどういうものだろう――",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンノン様を拝んで仲店へ出る。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、登山者の一人であるカンノ博士はおどろいた。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンノ博士たちは、ハンカチーフをふった。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンノ博士は、その学部の教授だった。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンノ博士とあと五人の人だけがついたての中に入った。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれは君を歓迎します」　と、カンノ博士がいった。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "君はまず、はじめにどこを見物したいですか」　と、カンノ博士はきいた。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カニザワ氏とサクラ女史とカンノ博士の三人は、ひたいをあつめて何か相談していたが、やがてカニザワ区長が正吉にいった。",
              "citation": {
                "source": "三十年後の東京",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると二人は、そういうことはカンノ博士にたのむのが一番いいであろうと教えてくれた。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ、カンノ博士。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士とは、しばらくいっしょにならないが、カンノ博士こそは、正吉少年を冷凍球から無事にこの世へ出してくれた恩人の一人で、有名な生理学の権威である。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとに行きたいのかね、正吉君」　カンノ博士は、人のよさそうな笑顔で、正吉を見まもった。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちっともおもしろくはないよ」　カンノ博士のことばは、じつに本当のことであったけれど、正吉には、博士が正吉の宇宙旅行を思いとどまらせようと思って、つらいことばかり並べているのだと思った。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンノ博士は、いよいよニヤニヤ笑顔になって正吉を見ていたが、やがて口を開いた。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たぶん知らないと思っていったのだが……」　カンノ博士は小首をかしげる。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "連れていってあげる」「ウワァ、うれしい」　正吉はよろこんで、カンノ博士にとびついた。",
              "citation": {
                "source": "三十年後の世界",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
