    "definitions": [
      {
        "index": 1,
        "gloss": "to buy up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "限定品と聞いて思わず棚のものを全部買い占めてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "投機目的で土地を買い占める行為が地域住民の強い反発を招いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "パニック買いで近所のドラッグストアのトイレットペーパーが買い占められてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "増刷の本が出ると、またお前が買い占める。",
              "citation": {
                "source": "勧善懲悪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがどうだろう凄いような美人が、俺等の邪魔でもするように、先廻りをして買い占めるじゃァねえかそうだよ染吉の朱盆をな、こいつ怪しいと思ったので俺等ドンドン後をつけてみた。",
              "citation": {
                "source": "染吉の朱盆",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが口でこそ二千俵ですが、いざ買い占めるとなるとなかなか大したもんですからな。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前は脳ミソやシッポは牛肉屋がタダでくれたそうだが、高級フランス料理店が買い占めるようになって手にはいらなくなったと林達夫先生がこぼしていたものだ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "道頓堀罷り通る",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちそれをふりまいて、人間の徳義心を買い占める、すなわちその人の魂を堕落させる道具とするのです。",
              "citation": {
                "source": "私の個人主義",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "御一しょに機嫌を取って、虚偽の富を手に入れさせた時は、10245あの人は世界中を買い占めることが出来ましたっけ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "永遠の魂の所有者たる諸子は、不可解、不合理なる教義の盲目的信仰と、ただ一片の懺悔の言葉とによりて、単調無味なる天国とやらの権利を買い占めるのであろうか？",
              "citation": {
                "source": "霊訓",
                "author": "SPIRIT TEACHINGS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヨハンたら、たった一クローネで、市中の物を買い占めるんだって！",
              "citation": {
                "source": "猿",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは不足によるもので、時には海賊行為と海の危険によるが、しばしば商人が供給を「買い占める」ことによる。",
              "citation": {
                "source": "ギリシャおよびローマ医学の概観",
                "author": "OUTLINES OF GREEK AND ROMAN MEDICINE",
                "note": "青空文庫"
              }
            },
            {
              "text": "はたしてサイラス・ブレットは世界の食料を買い占めることができるのか。",
              "citation": {
                "source": "四日白魔",
                "author": "THE FOUR WHITE DAYS",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本人で根気のよい支那人に沙中から掘らせて買占める人達が、此地や鄭家屯を足場にして奥地へ進んで行くと聞いた。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "「与八、聞いてくれ、あの梅の木を伐らせないように、残らずこっちで買占めるのだ」「へえ、あの吉野村の梅の木を、残らず買占めるんですか、何千本、何万本てあるやつを、そっくり買占めるんですか、買占めて、どこへ持っておいでなさる」と与八が、仰天してしまいました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "年魚市の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで高頭君を煩わして之を買占めることに相談を決めたのであるが、さて其後の保存方法や村有である土地のことなどを考えると、土地をも併せて買い取らなくては、安全でないということになって、話はそれきりになってしまった。",
              "citation": {
                "source": "思い出す儘に",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「若しかすると親類じゅうの洗濯ものを買いしめる魂胆かもしれなくてよ」四　伸子は、自分が変って帰って来たのを感じた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "数ドル出せば、一軒の店の内容全部を買いしめることも出来よう。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
