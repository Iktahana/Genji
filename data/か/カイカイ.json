      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "opening of a meeting",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "定刻になったので、司会者がマイクを持って開会を宣言した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "委員全員が揃ったことを確認し、議長が会議の開会を告げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "予定の時刻より十分遅れて開会したため、議題の審議が押し気味になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "実際二科院展の開会日に蒸暑くなかったという記憶のないのは不思議である。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十二年の開会日は朝ひどい驟雨があって、それが晴れると蒸暑くなって、竹の台の二科会場で十一時五十八分の地震に出遇ったのであった。",
              "citation": {
                "source": "烏瓜の花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "帝展の開会が間近くなっても病気は一向に捗々しくない。",
              "citation": {
                "source": "帝展を見ざるの記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "全体七部門に分れて、結核に関する病理、療法、予防その他一切の会議をするはずで、また開会中は該病に関する展覧会を開いて公衆に観せるそうである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、ちょうど発起人を代表して、当夜の人気だった一俳優が開会の辞を陳べ終った処であった。",
              "citation": {
                "source": "露萩",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の開会の辞も下手、れいの有名人の演説も何が何やら、わけがわからぬ、とその所謂父の「同志たち」が怒声に似た口調で言っているのです。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "桂子からして疑へば、このＱ――芸館を借りることに就いて、既に約定されてゐたものを反対側の連中の策謀と思はれる力で、貸すとか貸さぬとか、開会ももう十日程の目睫に迫つて、故障が持ち上つた。",
              "citation": {
                "source": "花は勁し",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際二科院展の開会日に蒸し暑くなかったという記憶のないのは不思議である。",
              "citation": {
                "source": "からすうりの花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大正十二年の開会日は朝ひどい驟雨があって、それが晴れると蒸し暑くなって、竹の台の二科会場で十一時五十八分の地震に出会ったのであった。",
              "citation": {
                "source": "からすうりの花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "（このことは、明治三十年夏、ブリストル開会の英国科学奨励会人類学部発表の日、部長の演説に次いで、熊楠、「日本斎忌考」と題し、読みたり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "』　と一同の者に、開会の言葉を申しました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "開会の初めには毎日事務所へ来ていたが、このごろはめったに顔を出さない。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "原口さんは開会の前日検分のためちょっと来た。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「森の女」の前には開会の当日から人がいっぱいたかった。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "開会後第一の土曜の昼過ぎにはおおぜいいっしょに来た。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "これで東亜生理学会の昭和×年度春期公開会議はおわったのであった。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日の大会は博士の報告演説だけで独占されることになっていたので、司会者の開会の辞がおわると、村木博士が割れるような拍手を浴びて登壇した。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして古人の作は参考品としたら、さらに興味が深いであろうという議が起りまして、それが決まると、早速｜築地本願寺で開会することになった。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "竜池会の起ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "協会の方では開会の準備のためにそれぞれ技術家たちへ出品の勧誘などをしていた時であった。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "矮鶏の作が計らず展覧会に出品されたいきさつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "その内開会の日は来てしまって、常例の通り何時何日には、聖上の行幸があるという日取りまで決まりました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "矮鶏の作が計らず展覧会に出品されたいきさつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして、自作は、宮内省御買い上げという下げ札が附いて開会期中そのまま陳列することにして公衆の展覧に供した。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "聖上行幸当日のはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "「開会の辞」で武田が出た。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "編者の微意は本文中の「開会の辞」に悉されているから、ここに重ねて言わない。",
              "citation": {
                "source": "中国怪奇小説集",
                "author": "凡例",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではこれより改めて開会とします……」　長官｜木槌を叩く。",
              "citation": {
                "source": "諜報中継局",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめは毎月あるいは隔月ぐらいに団十郎の自宅で開会していたが、二年ばかりでやめてしまって、会員は単に団十郎の出勤する劇場を見物し、幕のあいだにその部屋を訪問するだけになった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "その本読みをした劇談会は毎月開会のはずで、三月の下旬に第二回を築地のひさご家に開いたが、松居君もわたしも差支えがあって欠席した。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかの会員もあまり気乗りがしなかったとみえて、その後は開会の通知もなく、結局自然消滅になった。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "さて、博覧会は立派に上野で開会されました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "初めて博覧会の開かれた当時のことなど",
                "note": "青空文庫"
              }
            },
            {
              "text": "大庭　　そこは暖つたかいかい？",
              "citation": {
                "source": "五月晴れ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとは、お暗い行燈ばかりで、そとは、すぐ田圃つづきのかいかいいう蛙の声が、いちどきに大方今夜も晴れているらしい星空に向って、遠くなったり近くなったりして起っていた。",
              "citation": {
                "source": "蛾",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
