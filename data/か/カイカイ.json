[
  {
    "uuid": "6a9eee69-998e-5acb-86d5-562b37847e3a",
    "entry": "開会",
    "reading": {
      "primary": "かいかい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
