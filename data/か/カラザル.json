        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "（兩者ノ救フベカラザル迷妄ヲ戒シム。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "且ツ動カスベカラザル原理ハ、都市ノ住宅地ト異ナリテ農業者ノ土地ハ資本ト等シク其經濟生活ノ基本タルヲ以テ、資本ガ限度以内ニ於テ各人ノ所有權ヲ認メラルル如ク、土地亦其限度内ニ於テ確實ナル所有權ヲ設定サルルコトハ國民的人權ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "我ガ日本ニ於テハ國民生活ノ基礎タル土地ノ國際的分配ニ於テ將來大領土ヲ取得セザルベカラザル運命ニ在リ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "眞理ハ一社會主義ノ專有ニ非ズシテ自由主義經濟學ノ理想ニ亦犯スベカラザル者アリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ又生産方針ニ干與スルノ權ハ國家全局ノ生産成績ヲ達觀シ得ベキ衆議院ニ於テセザルベカラザル所以トナル。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ賠償ヲ別途ニ命ジテ同居ヲ父ニ強ヒザル所以ハ、遺棄シタル事情ガ背徳ニセヨ又ハ積極的活動ノ爲ニセヨ干渉スベカラザル別事ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "限度以下ノ私有財産ハ國家又ハ他ノ國民ノ犯スベカラザル國民ノ權利ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大領土ヲ有スル名實具足ノ大日本帝國ヲ考フル者此ノ三大原則を確立スル日本自ラノ改造ガ實ニ將來ノ建設ニ避ク可カラザル準備ナルヲ悟得スベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃木將軍ガ軍事眼ヨリ見テ許ス可カラザル大錯誤ヲナシテ彼ノ大儀牲ヲ來タセシニ係ラズ、彼ガ旅順包圍軍ヨリ寛過サレシ理由ノ一ハ己レ自ラ兵卒ト同ジキ辨當ヲ食ヒシ平等ノ義務ヲ履行セシガ故ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "外力ノ援助ナクシテ植民米人ガ戰フベキ武力ヲ有セザリシ如ク、一切ノ武器ヲ奪ハレシ印度獨立軍ニ對シテ恣ニ鎭壓軍ヲ輸送セシムルナラバ其ノ獨立ハ永久ニ期待スベカラザル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "山東苦力トシテ輸出セザルベカラザルホドニ人口漲溢セル支那ノ貧弱ナル一角ニ沒頭スルヨリモ、支那其ノ者ヨリ廣大ニシテ豐饒ナル英國ノ濠洲ヲ併合セヨ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ノ對外行動ハ取ルベカラザル者ヨリ寸土ヲ得ザルト共ニ、天日照覽ノ下苟モ奪フベクンバ全地球ヲモ大ナリトセザルベキ大丈夫ノ健脚ニ立ツベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルヲ擧國一致此ノ天籠ヲ逆用シテ却テ兩立スベカラザル敵國ノ犬馬ニ就キ、救國ノ恩主倒マニ其ノ脚下ニ俯伏シテ糞土ニ値セザル小群島ト一青島トヲ哀訴ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一見兩立スベカラザルカノ如キ此等ガ、其實如何ニ日米兩國ヲ同盟的提携ニ導クベキ天ノ計ラヒナルカノ如キ妙諦ハ今是レヲ云フノ「時」ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "天ノ人ヲ生ズルハ億兆｜皆同一轍ニテ、之ニ附与スルニ動カス可カラザルノ通義ヲ以テス。",
              "citation": {
                "source": "アメリカ独立宣言",
                "author": "福沢諭吉訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ澳斯太利人ノ言語ニハ、正義、罪業、罪罰ニ對スル言語ナク、人種下等ノ國ニテハ、仁惠、恩徳等ノ事ハ理會スベカラザルノ事トセリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "過去ノ經驗ニ依ラズ、現在ニ誤リテ惡源因ニ從事スレバ、未來ニ惡果ヲ招クコト避クベカラザルノ勢ニテ、之ヲ不知ト謂フナリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑陰納涼ノ夏ニ於ケル紅樓望雪ノ冬ニ於ケル四時ノ景宜シカラザルハ無シ。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ文字ノ遊亦酒ニ非レバ則樂シカラザル也。",
              "citation": {
                "source": "十年振",
                "author": "一名京都紀行",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケダシ時勢ノ変ニシテ兵法ノ一定シテ論ズベカラザルモノ也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠カラザル中拝眉仕ル可ク候。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "同一地方ニ於テモ時代ヲ異ニスレバ固ヨリノ事、假令同一時代ナリトモ、種族ヲ異ニスル石器時代人民ノ棲息スル事有リ得ベカラザル事ニハアラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "石器時代人民棲息ノ年代甚シク古カラザル場合、及ビ天然或ハ人爲ニ諸遺跡ノ攪亂サレタル場合ニ此事有リ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ニ關スル研究ハ啻ニ日本ノ古事ヲ明カニスルニ於テ有力ナルノミナラズ、人類學上益スル所又决シテ少カラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此答數正シカラザルトキハ、更ニ又、他ノ生徒ノ答數ヲ書シテ、之ニ照準セシムベシ……」　何かあまりに形式的ではあるけれども、それは兎も角、まことに至れり尽せりの、模範的な説明振りではないか。",
              "citation": {
                "source": "黒板は何処から来たのか",
                "author": "小倉金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ヤ彼女ハ卯木家ニ於テ確乎タル地歩ヲ占メルニ至リ、浄吉ニ取ッテモ、ソウ云ウ意味デ缺クベカラザル存在トナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「自分ノ店ノ最モ粗悪ナ商品ヲ買ヒ、自分ヲシテ成金タラシメルコトハ、社会ノ正義ヲ重ンズル市民ノ忘ルベカラザル義務デアル。",
              "citation": {
                "source": "のんしやらん記録",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "猶又、無用ノ者、入ルベカラザル事。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大部分はカロリーの計算が主であるが、中に「近年陸軍ニ於テモ胚芽米ヲ使用シアル部隊尠カラザルモ患者統計ニ現レタル脚気発生率ハ之ガ使用ニヨリ特ニ影響ヲ蒙レリトハ認メ難シ」という節があって、添えてある表を見てもその通りである。",
              "citation": {
                "source": "兎の耳",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スベテ一日モ、弛ガセアルベカラザルニ、千早金剛ノ膠着久シキコト、ソレ無策カ、過怠カ。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
