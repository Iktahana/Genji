    "definitions": [
      {
        "index": 1,
        "gloss": "pennant on a boat showing wind direction",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "マストの先端で激しくたなびく風切りを見て、船長は風向きの変化を察知した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「よし、風切りが真横を向いた。今こそ帆を全開にする絶好のタイミングだ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い漁船の風切りが、長年の潮風にさらされてボロボロになりながらも揺れている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "色鮮やかな風切りが、真っ青な海と空のコントラストに美しく映えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "胸の羽毛は斂めた翼の風切りの上へまでぱらぱらとかぶさる。",
              "citation": {
                "source": "木彫ウソを作った時",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "背中の蓑毛と胸の羽毛の下からこの風切りが、もう一度あざやかな黒色で、黒頭巾との呼応をしている。",
              "citation": {
                "source": "木彫ウソを作った時",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "閉じた翼の風切りのさきは左右あまり強く交叉せず、直ぐ下に背の長さ位の尾羽根がやはり黒一色ですっとさがり、その親骨がはっきり見える。",
              "citation": {
                "source": "木彫ウソを作った時",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "風切りの黒と、尾羽根の黒との間にちらちらと、下尾筒の雪白の毛が隠見する。",
              "citation": {
                "source": "木彫ウソを作った時",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一挺の駕籠を取り巻いて、博徒らしい五人の荒くれ男と、博労らしい四人の男とが、傍若無人に肩で風切り、往来の左右に佇んで、一種怖そうに一種好奇的に、この一団を眺めながら、噂している宿の人々の前を、東の方へ通って行くのが見られた。",
              "citation": {
                "source": "剣侠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、風圧と風切り音、エンジンの音、そして車体から全身に伝わる振動は、すさまじい。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "燕が風切羽と尾羽とを打ち交わす度に白い腹が翻ります。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "やや時経れば、ほのぼのとして薄明る山際のいろ、黎明の薄樺いろに焼け明るその静けさに、日出づる前か、明鴉かをかをと二羽連れだちて羽風切る、その羽裏いよよ染みたり。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "やや時経れば、ほのぼのとして薄明る山際の色、黎明の薄樺いろに焼け明るその静けさに、日出づる前か、明鴉かをかをと二羽連れだちて羽風切る、その羽裏いよよ染みたり。",
              "citation": {
                "source": "観想の時",
                "author": "――長歌体詩篇二十一――",
                "note": "青空文庫"
              }
            },
            {
              "text": "太平の世の春愁は、肩で風切る武士の腰の物に、態と觸つて見る市井の無頼兒である。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "太平の世の春愁は、肩で風切る武士の腰の物に、態と触つて見る市井の無頼児である。",
              "citation": {
                "source": "菊池君",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩で風切る精神病医は。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞬間「や、やあっ」　右手から、繰出した槍――八郎太は、自分を牽制するための槍とは知ってはいたが、反射的に避けたはずみ――たたっと、よろめくと「ええいっ」　八相の烈剣、きえーっと、風切る音を立てて打込んだ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "相馬街道相馬街道の馬追さんは肩で風切つて南へ通る未通娘はおぼろに紅い咲いた桜もおぼろに紅い田甫烏か馬追さんは未通だまして二度来てくれぬ相馬街道の馬追さんよ未通娘に何に変ろ。",
              "citation": {
                "source": "別後",
                "author": "野口雨情",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、あの機を織る時、私の体の毛はみんな抜いて織ったので今ではこのようになったというて、赤裸になった体をみせ、わずかに残っている風切羽で山のほうへばさばさと飛んで行った。",
              "citation": {
                "source": "鴻ノ巣女房",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かき消えて行く飛行機の夏の日中の羽の音……モンマルトルの宿にてあれ、あれ、通る、飛行機が、今日も巴里をすぢかひに、風切る音をふるはせて、身軽なこなし、高高と羽をひろげたよい形。",
              "citation": {
                "source": "晶子詩篇全集",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "地方から上京してきつつあるたくさんの見馴れぬ顔を、河岸のあたりを肩で風切る紳士らの常ならぬ雑沓を、そして空気に漲る騒擾と不穏の気配を、いっさいを、彼は見て取った。",
              "citation": {
                "source": "エリザベスとエセックス",
                "author": "ELIZABETH AND ESSEX",
                "note": "青空文庫"
              }
            },
            {
              "text": "羅傘　さんさん　銅鑼　どんどん肩で風切る病関索（楊雄のアダ名）も惚れた女房は　斬りよもないよ惚れた弱味じゃぜひもない和尚ヌクヌク　頭陀ポカポカ如法闇夜の　玉門じゃものいちど潜れば　忘られないよ泳ぐ血の池　ぜひもない　町の酒場の妓も唄う。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれその天の日矛の持ち渡り來つる物は、玉つ寶といひて、珠二｜貫七、また浪振る比禮、浪切る比禮、風振る比禮、風切る比禮八、また奧つ鏡、邊つ鏡九、并はせて八種なり。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この天の日矛の持つて渡つて來た寶物は、玉つ寶という玉の緒に貫いたもの二本、また浪振る領巾・浪切る領巾・風振る領巾・風切る領巾・奧つ鏡・邊つ鏡、合わせて八種です。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
