    "definitions": [
      {
        "index": 1,
        "gloss": "fish or vegetables pickled in sake lees",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "銀だらの粕漬けは、焼くと酒粕の芳醇な香りがふわりと立ち、脂の乗った身の旨みが引き立つ一品だ。",
              "source": "幻辞"
            },
            {
              "text": "自家製の野菜を粕漬けにする際は、水分をよく拭き取ってから漬け込むのが、保存性を高め味をぼやけさせないコツである。",
              "source": "幻辞"
            },
            {
              "text": "「まあ、この粕漬けは味がよく染みていて美味しいわね」と、母は自慢の瓜の漬物を食卓に並べた。",
              "source": "幻辞"
            },
            {
              "text": "奈良漬は、塩漬けした野菜を何度も新しい酒粕に漬け替えることで、独特の深い琥珀色と風味が生まれる伝統的な粕漬けだ。",
              "source": "幻辞"
            },
            {
              "text": "お世話になった方への贈り物として、老舗の料亭が吟味した季節の魚の粕漬け詰め合わせを手配した。",
              "source": "幻辞"
            },
            {
              "text": "魚を粕漬けから取り出したら、焦げ付かないよう表面の粕を軽く洗い落としてから、弱火でじっくりと焼き上げる。",
              "source": "幻辞"
            },
            {
              "text": "粕漬けは、日本酒の醸造過程で出る酒粕を活用して食材の保存性を高めつつ、旨みを引き出す先人の知恵が詰まった保存食だ。",
              "source": "幻辞"
            }
          ],
          "literary": [
            {
              "text": "もしあの時空腹のまま、畢波羅樹下に坐っていられたら、第六天の魔王｜波旬は、三人の魔女なぞを遣すよりも、六牙象王の味噌漬けだの、天竜八部の粕漬けだの、天竺の珍味を降らせたかも知らぬ。",
              "citation": {
                "source": "俊寛",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから味噌漬けや粕漬けは、ほんとうに数の子の美味さを知る者は決してよろこばない。",
              "citation": {
                "source": "数の子は音を食うもの",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "藩では姿のよいものを選んで、焼干しにしたり粕漬けにしたりして、将軍家へ献上し、また幕府閣老に贈って好評を得ている、などということであった。",
              "citation": {
                "source": "若き日の摂津守",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、あなたのお弁当のおかずは卵焼きと金平牛蒡で、私の持って来たお弁当のおかずは、筋子の粕漬と、玉葱の煮たのでした。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたは、私の粕漬の筋子を食べたいと言って、私に卵焼きと金平牛蒡をよこして、そうして私の筋子と玉葱の煮たのを、あなたが食べてしまいました。",
              "citation": {
                "source": "冬の花火",
                "author": "―――三幕",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の三流の下宿屋の薄暗い帳場に、あんなヘチマの粕漬みたいな振わない顔をしたおかみさんがいますよ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "瓜の粕漬でも食べさせたいが、どうしたわけだか、このごろ酒粕もとんと無いてば。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その側に下女のおすめは、一かかえもあるほどな大きな七輪へ、赫々と炭をおこして、長い鉄串へ幾切もの粕漬の塩鮭を並べて居る、焼けて溶け落ちる塩鮭の油が炭火に焦げて、ぷんぷんと香ばしい匂をたてるのであった。",
              "citation": {
                "source": "かやの生立",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありゃうまいや、粕漬だろう。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物松浦漬（鯨骨の粕漬）そして佐用姫漬（福神漬）、島へ小鳥を持つて帰る人、島の遊女を買ふ人。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "辛子菜の香味、茄子の色彩、胡瓜の快活、糸菜の優美、――しかし私はどちらかといえば、粕漬の濃厚よりも浅漬の淡白を好いている。",
              "citation": {
                "source": "漬物の味〔扉の言葉〕",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "たよりいろ／＼、アメリカの大月君からはうれしい手紙を貰つた、名古屋の森君からは長良川の鮎の粕漬を頂戴した。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "独活の粕漬うまいな、御幣餅（飯団子の田楽）はめずらしい。",
              "citation": {
                "source": "旅日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おとなりから粕漬、お寺から五目飯を頂戴した、何とでつかい胃袋！",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か送つて来ましたか」「えゝ赤い魚の粕漬なんですがね」「ぢやひめいちでせう」　三四郎は詰らんものを送つたものだと思つた。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "例之ば午、吸物摘入、小蕪菁、椎茸、平昆布、大口魚、鱠、千六本貝の柱、猪口はり／＼、焼物生鮭粕漬、夕、吸物牡蠣海苔、口取蒲鉾卵｜橘飩青海苔を塗したる牛蒡鯛の小串、刺身｜比目魚黒鰻、大平鯛麪、旨煮烏賊牛蒡｜土当帰、概此類であつた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か送ってきましたか」「ええ赤い魚の粕漬なんですがね」「じゃひめいちでしょう」　三四郎はつまらんものを送ったものだと思った。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "到来物の粕漬を送つたり、掘立の山の芋を寄こしたりして、その度に一寸絵の事をも書き添へておくが、画家などいふものは忘れつぽいものと見えて、粕漬や山の芋を食べる時には、つい思ひ出しもするが、箸を下に置いてしまふと、今の好物も誰が送つて来たものか、すつかり忘れてゐる。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "女房の口添は粕漬や山の芋と違つて、画家の忘れ物を直ぐ思ひ出させる効果がある。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうち鮎の粕漬でも送らうなどといつて別れを惜む人がある。",
              "citation": {
                "source": "山陰土産",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この頃は毎日晩酌の膳に、生鮭、塩鮭、粕漬の鮭なぞが、代る代る載つてゐるかも知れない。",
              "citation": {
                "source": "本の事",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "粕漬のやうになつた大坊主のそれは言ひやうもない醜い姿ですが、隣の部屋で平次の女房お靜は、たまり兼ねてシクシクと貰ひ泣きして居りました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "凉み船",
                "note": "青空文庫"
              }
            },
            {
              "text": "サントリータンサン、登起波（米沢）の牛肉粕漬、ローストポーク。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "弟が夕方、多分学校へ出る途中であろう、「姉さんがこれを……」と云って、国の母の手づくりのかき餅、糟づけの瓜など届けて呉れることがあった。",
              "citation": {
                "source": "沈丁花",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
