          "literary": [
            {
              "text": "クロスビーと、グレース・スリックと、あとひとりはだれだっけ、ポール・カントナーだったかな」　tri- は三を示す接頭辞で、triad というのは、たとえば「三和音」のように、なんであれ、三つでひと組のものをいう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、かつて彼女が属していたホールディング・カンパニーのリード・ギタリスト、ポール・カントナーは、次のように言う。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そもそもの母胎である、日曜の午後の公園での無料コンサートにもどるのだ」　これからさきのことを考えると、カントナーのほうがはるかに正しい。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "（ポール・カントナー、ジェファスン・エアプレーン）　私たちの音楽は銀行員のための音楽ではない。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
