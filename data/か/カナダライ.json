    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "枕頭に侍り、カナダライに氷をいれ、タオルをしぼり、五分間おきに余のホッペタにのせかえてくれたり。",
              "citation": {
                "source": "不良少年とキリスト",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏になると、靴下もぬぎ、机の上へカナダライに水をいれて、その中へ足を突ッこんで、両手を後クビにくんで、天井をにらんでいる。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、盛夏の今日も、尚、かの社長の先生が机の上のカナダライの水に足をつッこんで天井を睨み、きわめて稀れに、苦痛少き借金のカクトクに街を歩いているのである。",
              "citation": {
                "source": "カストリ社事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋へ案内してくれたホテルの娘さんが、陶器の大きな水差しに水をいれて持ってきて、鏡の載っかってる台の上においてあった陶器の大きなカナダライのようなものの中へ、水差しの水をジャーボコボコと半分ぐらいつぎこんで立ち去った。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "人を殺した男かなんかが、血だらけのナイフをこの台の上へおいて、水差しの水をジャーボコボコとこの陶器のカナダライ的なものへ半分ぐらいついで、血だらけの手をさしこむ。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "陶器製のカナダライに相違ない平鉢の中へ、高句麗の古墳の模型をつくって少女が運んでくる。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "チャンポンのカナダライが一とまわり小さくなる時は、まさに長崎滅亡の時であろう。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "長崎チャンポン――九州の巻――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
