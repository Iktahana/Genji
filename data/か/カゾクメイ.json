          "literary": [
            {
              "text": "バウル・ゴーガンなどの類で、前名は即ち個人のキリスト教名後名は即ち家族名である。",
              "citation": {
                "source": "誤まれる姓名の逆列",
                "author": "伊東忠太",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等はまた「氏」と呼ぶ家族名と、「通称」と称する、我々の洗礼名に当る名とを持っている。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "姓――閥族名――源氏――家族名――頼通称――洗礼名にあたるもの――久太郎号――学問上の名――山陽字――追加的学問上の名――子成諱――契約書その他の為の法律的の名――襄戒名――死後の名――私の教示者はこれを知らない＊。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
