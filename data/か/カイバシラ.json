        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "牡蠣の貝柱は、殻を閉じるための強力な筋肉である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "貝柱の収縮メカニズムは、海洋生物学で詳しく研究されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "二枚貝の貝柱の大きさは、種によって大きく異なる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
