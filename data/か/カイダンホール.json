        "examples": {
          "standard": [
            {
              "text": "このビルの階段ホールは天井が高く、緊急時の避難経路として十分な広さがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古い公会堂の階段ホールには、創設者の肖像画が飾られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "階段ホールの窓から差し込む夕日が、磨き込まれた大理石の床に反射していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「おまえ、怒ってるんだろう」「怒るもなにも……」　中央階段ホールの、煙突のなかに無数のリードを仕込んだような、複雑な構造のせいだろう、ふたりの声には不思議なエコーがかかって、おたがいが、どこにもいないように感じられる。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも、パンツ一枚で非常階段ホールに入ってきた奴がひとり、仰天して防火扉のむこうに隠れた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "短いつなぎで、校舎から見た寮全景、下からあおった東棟、階段ホール、部屋の扉、そのアップ（一〇二というプレートが読める）、全員がベッドで寝ている光景。",
              "citation": {
                "source": "45回転の夏",
                "author": "第３章　フルサークル、１９９１年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
