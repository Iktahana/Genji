[
  {
    "uuid": "2b47e4a2-65b1-5deb-9ed0-41ed3de51b55",
    "entry": "冠婚",
    "reading": {
      "primary": "かんこん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
