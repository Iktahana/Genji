        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "着物、ハダカヲ包メバ、ソレデイイ、柄モ、布地モ、色合イモ、ミンナ意味ナイ、二十五歳ノ男児、一夜、真紅ノ花模様、シカモチリメンノ袷着テ、スベテ着物ニカワリナシ、何ガオカシイ。",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "福の座は、かの羊の群の間に白雲立てる、カヲの山より高きものぞといふ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "寝てばかりもゐられないので三時間ばかり町を行乞する、行乞相は満点に近かつた、それはしぼり腹のおかげだ、不健康の賜物だ、春秋の筆法でいへば、シヨウチユウ、サントウカヲタヾシウスだ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――樹明君近来の口癖はブチコワスゾである、何カヲブチコワサズニハヰラレナイホド、君は悩み苦しみ焦立つてゐる、そこで、私が先づ茶碗をぶちこはす、樹明君喜んで皿を投げつける、ガチヤンガラガラ、どうやら胸がすいたらしい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド　アンナニ　マドガ　タカクテ、ドウシテ　ナカヲ　ノゾク　コトガ　デキマセウ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "フリアゲテ　ヰタ　イシコロヲ、ポーント　ムカウノ　キニ　ナゲツケテ、マタ　コヒツジヲ　フトコロニ　イレ、スイタ　オナカヲ　オサヘナガラ　一ツノ　ムラヘ　ヤツテ　キマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コマツタ　ヤツダナ、オレニハ　オチチガ　デナイカラ　ヤツパリ　モトノ　マキバヘ　ツレテツテ　ヤラウ」ト　イツテ、ヌスビトハ　ペコペコノ　オナカヲ　オサヘナガラ　マタ　モト　キタ　ミチヲ　カヘツテ　ユキマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ　ウチニ　オバサンハ　スツカリ　ウバグルマノ　ナカヲ　カタヅケテ、「スミマセンデシタ、ホントウニ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンザシ新美南吉　ヲンナノ　コガ　イケノ　フチカラ　ミズノ　ナカヲ　ノゾイテ　ヲリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サツソク、モルモツトノ　オヰシヤガ、イタチノ　ポンポコニ　フクレタ　オナカヲ　シンサツシマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "則チ二者ノ孰レカヲ決シ得ル國家ハ其ノ國情ノ如何ヲ考ヘテ最善ノ處分ヲナセバ可ナリトス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ニ早ク已ニ此ノ大本ガ腐爛シ盡シタルカヲ見ン。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "早ク已ニ揚子江流域ハ英國ノ勢力範圍ナリト云ハルル今日、日本ヲ相手方トシテ英獨協商ヲ日英協商トシテ支那ニ臨ム時、明治大帝ハ何ノ爲メニ日露大戰ヲ戰ヒシカヲ解スベカラザラントス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "センセイノオシヘヲヨクマモリ、オトモダチト、ワルフザケヤケンカヲセズニ、ゲンキヨクアソベ。",
              "citation": {
                "source": "初夏通信",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈人生ハ百万台ノ　トラツクガ　疾走スルナカヲ　駈ケヌケル　ヤウナモノサ〉　旅に出て愛人と悲壮を得た友のハガキであつた。",
              "citation": {
                "source": "火の踵",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "スナワチ、高山山巓ニ於テ、米国ノ放送ヲ如何ナル程度ニ受信シ得ラルルカヲ試ミンガタメナリキ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをやろふと思へバ先つねのシンゴンしうのよむかんをんきよふイツカヲしうのよむあみだきよふ、これハちとふしがありてむかしけれど、どこの国ももんとがはやり申候あいだ、ぜひよまねバいかんぞよ。",
              "citation": {
                "source": "手紙",
                "author": "文久三年六月二十九日　坂本乙女あて",
                "note": "青空文庫"
              }
            },
            {
              "text": "何レモ少年時代ノ幾年カヲワガ塾生トシテ過シタル諸君デアルガ、業成リ世ニ出デテナホ旧師ノ門ヲ叩ク可憐ナル礼節ハ近来頓ニ振ハザル傾向ト思フガ、ソノ若干ノ例外中、六、七割マデハ軍服ヲ著タ連中デアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日、高イ木ノ枝ニ腰カケテ、四方ヲミマワシテ、何カヲサガシテヰル様子デス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ姉サントオ兄サンハ思ハズ、オナカヲカカヘテ笑ヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二ヒキノ　コイヌハ　ダイドコロノ　トノスキマカラ　ナカヲノゾキマシタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "總テ蜘蛛ノ類ニハ此類ノ作用殊ニ著シク、或ハ陷穽ヲ作リ他蟲ノ陷ルカヲ窺ヒ、或ハ壁虎ノ如ク、待伏ノ室ヲ作リ、其近邊ニ徘徊スル他蟲ヲ捕ルガ如キ、種々ノ巧ヲナセリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "また益軒の『大和本草』にも紫羅傘［傘は棟の誤り］すなわちイチハツの条下に「民家茅屋の棟ニイチハツヲウヘテ大風ノ防ギトス風イラカヲ不破」と書いてある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（中略）奥地タライカヲリカ辺にては屍骸を三年の間乾し曝し置くなり。",
              "citation": {
                "source": "本朝変態葬礼史",
                "author": "中山太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "タカヲチヤンノウチハ　クルリト　カラタチノカキヲマハツタ　アソコダ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラタチノ　カキノナカカラ　タカヲチヤンガ　ヨンデル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクウレシクテ　ウレシクテ　タカヲチヤンノウチノ　ゴモンノハウヘ　カケテツタ　カケテツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的ノナカツタ丈　冷静デアツタ太陽ガ汗ニ濡レタ背ナカヲ照ラシタ時影ハ背ナカノ前方ニアツタ人ハ云ツタ「あの便秘症患者の人はあの金持の家に食塩を貰ひに這入らうと希つてゐるのである」ト‥‥‥‥‥‥‥‥‥‥‥１９３１・６・５",
              "citation": {
                "source": "異常ナ可逆反応",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソンナニ恐々拭カナイデ、モット手ニカヲ入レテシッカリト。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ガ髯ヲ剃ッタノニ心ヅイテ、早クモ何カヲ察シタノカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
