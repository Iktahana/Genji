        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "七三　凡事有眞是非、有假是非。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "假是非、謂通俗之所可否。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "年少未學、而先了假是非、※後欲得眞是非、亦不易入。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔譯〕凡そ事に眞是非有り、假是非有り。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "假是非とは、通俗の可否する所を謂ふ。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            },
            {
              "text": "年｜少く未だ學ばずして、先づ假是非を了し、後に※んで眞是非を得んと欲するも、亦入り易からず。",
              "citation": {
                "source": "南洲手抄言志録",
                "author": "南洲手抄言志録",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
