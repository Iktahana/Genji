        "examples": {
          "standard": [
            {
              "text": "サケの回帰性は生殖本能に基づいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "渡り鳥の回帰性は磁場を感知する能力によるものと考えられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "カメの回帰性により、彼らは産卵地に戻ってくる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ここは姫鱒の人工養殖所で、孵化した稚魚を湖水に放流すれば、育った親鱒は三年後に、その回帰性によって、放流された場所へ産卵に戻ってくる。",
              "citation": {
                "source": "山上湖",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その場合、知らず知らず自分の正義の肯定と絡み、その絡みかたにおいて一方の低さから主観的になり、その主観に回帰性が加って、じりじりと心にくい込むものとは反対の形をとって現れて来る。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
