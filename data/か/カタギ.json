    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "よべの嵐に吹き寄せられた板片木片を拾い集めているのである。",
              "citation": {
                "source": "嵐",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "滝割の片木で、杉の佳い香が佳い色に含まれていた。",
              "citation": {
                "source": "野道",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "今度からは汝達にしてもらう、おぼえておけ、と云いながら、自分は味噌の方を火に向けて片木を火鉢の上に翳した。",
              "citation": {
                "source": "野道",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "片木にすしを盛つて人々に配る。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "広一寸弱長四五寸の片木なり。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "名に三本木の駅路と聴いては連理の樹の今は片木なるを怨みもした。",
              "citation": {
                "source": "怪異黒姫おろし",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "鯛は、網の片木縄に追われて逃げるとき尾端を岩根にすり当てるから、こう割れてしまうのである。",
              "citation": {
                "source": "鯛と赤蛸",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどミュージック・カセットのテープの箱とおなじようなサイズの、片木で出来た四角な平たい箱なのです。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "片木作りの角盆」とあるから、あまり上等なものではなさそうである。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
