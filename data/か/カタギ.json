  {
    "uuid": "0a4c039d-897c-50ea-a826-d04e336d5016",
    "entry": "片木",
    "reading": {
      "primary": "かたぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
