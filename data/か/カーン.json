  {
    "uuid": "80da04d0-7183-5d1d-a2ec-cfa89fa8e0af",
    "entry": "かーん",
    "reading": {
      "primary": "かーん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はその時頭がかーんとしたやうに思つた。",
              "citation": {
                "source": "小さき影",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その騒ぎの間に、一種｜生臭いような暖かい蒸気が甲板の人を取り巻いて、フォクスルのほうで、今までやかましく荷物をまき上げていた扛重機の音が突然やむと、かーんとするほど人々の耳はかえって遠くなった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "葉子の心の周囲にそれまで響いていた音楽は、その瞬間ぱったり静まってしまって、耳の底がかーんとするほど空恐ろしい寂莫の中に、船の舳のほうで氷をたたき破るような寒い時鐘の音が聞こえた。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嵐が急にやんだように二人の心にはかーんとした沈黙が襲って来た。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが入つてきて、お芳が何かぽかーんとしてゐたのを嫂が見た。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常に堅い物体で力一ぱいかーんと喰らわされたような感じだった。",
              "citation": {
                "source": "犠牲者",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は嗄がれた声を張りあげて「ゆうかーん、ゆうかーん」と叫んだ。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "思い出したように私は「ゆうかーん」と、だるそうな声で往来の人々に呼びかけた。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "無論私は「ゆうかーん」を叫ぶ勇気はなかった。",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "かーん、かーんと鋲をうつような音もする。",
              "citation": {
                "source": "超人間Ｘ号",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、とたんに、どかーんだから、わしはいやだよ。",
              "citation": {
                "source": "爆薬の花籠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、ちょうどこの真下に、爆薬を仕かけてきて、導火線を長く引張り、そしてどかーんと爆発させたのだ。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音盤をかけながら、音叉をぴーんと弾くと、音楽以外に顕著な信号音が、或る間隔をもって、かーんと飛び出してくるのであった。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "音叉を停めれば、それは消え、音叉をかければ、その音盤が廻っているかぎり、かーんかーんという音は響く。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その油断に乗じて、どかーんと一たび爆発すれば、相当な損害を与えることが出来る。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "弾丸はかーんと船腹にあたってまたちかっと火花がでた。",
              "citation": {
                "source": "幽霊船の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "背中に小猿をくくり付けでもしたように、赤い着物の女の子が、小さく、かーんと強張って背負われて居るのだ。",
              "citation": {
                "source": "或日",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "針金のきれめから入って原をつっきってゆくサヨの薄青いパラソルは、かーんと照りあがった夏草の上で上下にゆれながらだんだん小さくなって行った。",
              "citation": {
                "source": "朝の風",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればと云って、よく世間で云っております、あの、雷にどかーんと撃たれたような気持、――ああしたものでもありませんでした。",
              "citation": {
                "source": "墓",
                "author": "モオパッサン",
                "note": "青空文庫"
              }
            },
            {
              "text": "めたん子逃げろよバカだなといはれても、めたん子はにやにやしながら、かーんと板切れに蜂を叩く音を立てた、蜂は怒つてゐるから栗の實のやうに硬いからだを鯱張らせてゐて、かーんと勇ましい音を立て叩き落された。",
              "citation": {
                "source": "めたん子傳",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の少年達が螫されてもめたん子は滅多に螫されないで、威勢宜く、かーん、かちりと叩き落す、かれは巣甕から下りてくる時にもうすでに狙ひを決めてゐて、自分の顏のすぐ前で叩き落すのだ、町でいぢめられてゐる意氣地なしのめたん子とは、別人の落着きと沈勇があつた。",
              "citation": {
                "source": "めたん子傳",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈うた：アリスのソロ〉　びっくりだ　わあにさん　しっぽがね　ぴかーん　ナイルがわ　ざあぶざぶ　うろこにね　びしゃーん！",
              "citation": {
                "source": "不思議の国のアリス　ミュージカル版",
                "author": "ALICE IN WONDERLAND: DREAM-PLAY",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりだ　わあにさんしっぽがね　ぴかーん！",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "びっくりだ　わあにさんしっぽがね　ぴかーんナイルがわ　ざあぶざぶうろこにね　びしゃーん！",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "又バクテリヤの意識だってよくはわかりませんがとにかく私共が生れつきバクテリヤについては殺すとかかあいそうだとかあんまりひどく考えない。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかあんまりみんなうまい工合でした。",
              "citation": {
                "source": "ビジテリアン大祭",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は授業中もそのやなぎのことを早く慶次郎に尋ねたかったのですけれどもどう云うわけかあんまり聞きたかったために云い出し兼ねていました。",
              "citation": {
                "source": "鳥をとるやなぎ",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
