        "examples": {
          "standard": [
            {
              "text": "有名な建築家ルイス・カーンの作品は、今も多くの人々に影響を与えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画『スタートレック』シリーズに登場する悪役カーンは、非常に印象的だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カーン氏は、長年の研究が認められ、今年のノーベル賞を受賞した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
