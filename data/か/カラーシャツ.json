        "examples": {
          "standard": [
            {
              "text": "いつも白シャツばかりだから、気分を変えて明るいブルーのカラーシャツを買ってみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "クールビズ期間中は、ネクタイなしでカラーシャツを着ている人が増えるね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は派手な柄のカラーシャツを着て、パーティーで注目を集めていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
