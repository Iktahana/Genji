[
  {
    "uuid": "204f5e44-0dcd-5450-93f7-7be7093650dd",
    "entry": "飼い殺し",
    "reading": {
      "primary": "かいごろし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "keeping a domestic animal beyond its useful life",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "その家の飼い犬は年老いて役に立たなくなったが、飼い殺しのままである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "役に立たなくなった家畜を飼い殺しにするのは、経済的負担になることもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "農業の効率化により、飼い殺しの実践は減少している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "五十人の研究の中でただの一つでも有利な結果が飛び出せば、それから得られる利益で、学者の五十人くらい一生飼い殺しにしても、なお多大の収益があるからとのことであった。",
              "citation": {
                "source": "学問の自由",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく日本などでは、まだなかなかそういう遠大な考えで学者の飼い殺しをする会社はそう多数にはあるまいと思われる。",
              "citation": {
                "source": "学問の自由",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "生ぬるい自由なんて、飼い殺しと同じだ。",
              "citation": {
                "source": "乞食学生",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は母と相談して、生涯飼い殺しにしたいと言っていたが、そうもできないものと見えてその後払下げになってしまった。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その残忍非道な人間のために、こんな狂人地獄に陥れられて、一生涯、飼い殺しにされているなんて……僕にはトテモ我慢が出来ないのですから……」「ウン……まあやって見るさ」　正木博士は如何にも気のなさそうにこう云った。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中だって給金を貰うのに、わたしは着物一枚作って貰えず、一生飼い殺しにされるのかと、喰ってかかる。",
              "citation": {
                "source": "庶民生活",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近まで、報知新聞に伊沢の婆さんという、矢野龍渓、小栗貞夫、三木善八の三代にわたってその俥をひいた爺さんの女房が飼い殺しになっていて、山県公の遊び振りや三谷の贅沢振り、今戸の寮に住む人々の風流振りを話したものである。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "登志とてもすでに不要の存在であるが、かなり働き者であるし、神棚の下の張り番もあるので、飼い殺しの気持に傾いていた。",
              "citation": {
                "source": "保久呂天皇",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "したがって特別に屠者という専門の職業もなかったでありましょうが、天武天皇以来牛馬を殺す事を禁ぜられ、年取って役に立たぬ様になった牛馬でも、飼主はこれを飼い殺しにしなければならぬ。",
              "citation": {
                "source": "特殊部落の成立沿革を略叙してその解放に及ぶ",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "他の地方でもそうであったらしい）老牛馬は通例飼養者の飼い殺しとなっていたが、斃死の後は必ず捨場に委棄するか、しからずばエタに通告してその処理に委せねばならなかった。",
              "citation": {
                "source": "牛捨場馬捨場",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "目的は、「変った学者」を一生飼い殺しにして、勝手な研究を、勝手な場所でやらせようというのである。",
              "citation": {
                "source": "黒い月の世界",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蔵屋敷も六十一万九千石、御三家随一の尾張様の息が掛ってまことに宏大ですが、ここにはさすがに上屋敷と違って、見識張った人間ばかりいるわけでなく、庭掃きの老爺与吉といったようなのが、一生飼い殺しに庭の隅の小屋を住家にしているのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪盗系図",
                "note": "青空文庫"
              }
            },
            {
              "text": "年はもう六十恰好、お酒を頂くと、疳性で、素裸でなければ眠られないという厄介な親爺、これも遠縁の飼い殺しで、こんな時役に立つような人間ではありません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪伝白い鼠",
                "note": "青空文庫"
              }
            },
            {
              "text": "爺やの六兵衛は、近江屋の遠縁の者で、年を取ってから転げ込みましたが、先代や友二郎が同情して一生飼い殺しの寮番にして置くくらいですから、別に害意のある様子も見えません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪伝白い鼠",
                "note": "青空文庫"
              }
            },
            {
              "text": "お祖父さん、お祖母さんは歌川家の飼い殺しの下男と女中頭で、喜作爺さん、お伝婆さん、どちらも人の好い、いつもニコニコ、大へん感じのよい召使いだ。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "戦後順吉はある五十女の担ぎ屋の手伝いをしていたが、その慾の皮の突張った女から飼い殺しにされているような感じで、毎日寿命の縮む思いをした。",
              "citation": {
                "source": "夕張の宿",
                "author": "小山清",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういう者を「ころびばてれん」と呼んで、幕府ではいい重宝に使って、生涯切支丹屋敷の飼い殺しとするのが例です。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかに鉄面皮でも、幾多の肉親の頼みや故国の使命を裏切り、あまつさえ、神の御名をこの国の幕府へ売って、囚徒の後家を妻にもらい、生涯飼い殺しにされて喜んでいるころびばてれん――。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、客の方で約束は違えないんですが、一生飼殺し、といった様子でしょう。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "御本家に飼殺しの親爺仁右衛門、渾名も苦虫、むずかしい顔をして、御隠居殿へ出向いて、まじりまじり、煙草を捻って言うことには、（ハイ、これ、昔から言うことだ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "来るものも一生奉公の気なら、島屋でも飼殺しのつもり、それが年寄でも不具でもございません。",
              "citation": {
                "source": "政談十二社",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "むむ、何しろ一番｜糺明て見ようと、掌を高く打鳴らせば、ややありて得三の面前に平伏したるは、当家に飼殺しの飯炊にて、お録といえる老婆なり。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あたら名馬も飼殺しぢや。",
              "citation": {
                "source": "佐々木高綱",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを御縁に貴方の乾児にして、小使でも何でもいい一生を飼殺しにして下さい。",
              "citation": {
                "source": "爆弾太平記",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてＡの一生涯を、病院で飼殺しにしてもらうように、折返して返事を出すと、すぐにタッタ一人で極秘密の裡に、旭岳の麓へ久美子を迎えに行ったのですか。",
              "citation": {
                "source": "キチガイ地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者は頼まれて真逆に人一人を殺して了う訳にも行かず、仕方なく尤も秘密の場所を求めて隠し飼殺しにするのです。",
              "citation": {
                "source": "幽霊塔",
                "author": "黒岩涙香",
                "note": "青空文庫"
              }
            },
            {
              "text": "独立する資力がないばっかりに、地主の思うがままにみじめな生活をさせられて子供の教育も出来ず、二度とない一生を地主に操られて、働きへらして飼殺し同様にさせられて仕舞う。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "小作をしないで暮すと云う事は農民皆が皆の希望だろうけれ共、地主に飼殺しにされた親達は又それと同様の運命を子供に遺して、その苦しい境遇から脱し得るだけの能力は与えなかった。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "店員はこの恩給を棒にふるのもなんだからと、恩給を逃さぬようにとばかり考えて、独立の機会を逸する事となりがちでありまた店主の方にすれば、あたら一個の男子を飼殺しにする結果になる。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "何しろ、お芳という女は、ご覧のとおりののろまで、女学校にもとうとうあがれなかったし、かたづいた先からは、子供が亡くなったのを幸いに追い出されるし、実は、もう、わしの方で、一生｜飼殺しの腹をきめて居りましたのじゃ。",
              "citation": {
                "source": "次郎物語",
                "author": "第二部",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "keeping a person on the payroll without utilizing their skills",
        "register": "standard",
        "nuance": null,
