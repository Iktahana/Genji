        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "会社では彼のスキルを活かさず、ただ飼い殺しにしている状態だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "能力のある職員を飼い殺しにしていては、人材管理として問題がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "昇進の機会がなく、飼い殺しのような職場環境に不満を感じている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": []
        }
      }
