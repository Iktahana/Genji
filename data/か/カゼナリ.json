        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "風鳴りて松のさざめき、　　またしばし飛びかふ鳥や。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜のなかにどうどうといふ冷たいものゝ気配が静かな風鳴りとこんがらがつて遠くに聞こえた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "○男子二、（耳をそばたてゝ）ゴーといふ風鳴りだ、○男子三、（平然と落ついて）風の前には、かなはない。",
              "citation": {
                "source": "きのふは嵐けふは晴天",
                "author": "小熊秀雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと雨降つて晴れたと思ふまに、凄まじい大きな、ちやうど獣の咆えるやうな、風鳴りがしました。",
              "citation": {
                "source": "小熊秀雄全集-14",
                "author": "童話集",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピューッという風鳴りの音！",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピューッという風鳴りの音、続いて賊どもの倒れる音、そうして軟らかい気合いと共に、武士の姿は帆柱のもとに、端然冷然と立っていた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "犀川の上流で、やや遅れぎみの若葉が淵の上を半分以上覆いかぶさって、しんと、若葉の風鳴りがすると、それにつれて、淵の蒼い水面に鱗がたのさざなみが立って、きゅうに涼しさと寒さとが一どきに体温にかんじられた。",
              "citation": {
                "source": "蛾",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "と――またこそ、かれの幻術か、ふいに、さッと落ちてきた一陣の風鳴り。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
