[
  {
    "uuid": "81c5e33b-c947-5a36-bc2e-d0f2515ffe7b",
    "entry": "仇同士",
    "reading": {
      "primary": "かたきどうし",
      "alternatives": [
        "てきどうし"
      ],
      "is_heteronym": false
    },
    "grammar": {
