        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "フライパンを火にかけたまま、うっかり空焚きしてしまった！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "鍋の空焚きは、火災の原因になるから絶対にやめましょう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「空焚き注意」と書いてあったのに、お湯を沸かそうとして空焚きしちゃったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "思い出は色褪せ、予感はかすみ、君の色香は空焚きの香の薫りにも如かない。",
              "citation": {
                "source": "情意の干満",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "一瞬間、――その一瞬間が過ぎてしまへば、彼等は必ず愛欲の嵐に、雨の音も、空焚きの匂も、本院の大臣も、女の童も忘却してしまつたに相違ない。",
              "citation": {
                "source": "好色",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、あたりにはさつきの通り、空焚きの匂が漂つた、床しい闇があるばかりである。",
              "citation": {
                "source": "好色",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "旅なかまは、ヨハンネスをそっといすからだき上げて寝床に入れました。",
              "citation": {
                "source": "旅なかま",
                "author": "REJSEKAMMERATEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうした」　と、竜造寺兵曹長は、倒れている帆村のそばへかけよって、後からだき起そうとした。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "家中のものがみんな、げんかんへかけ出し、戸が、ばた／＼とあくかと思ふと、ぢいやのドウナーシヤが階だんをころがるやうにかけおりて、そりからだき下してくれます。",
              "citation": {
                "source": "そり（童話）",
                "author": "オイゲン・チリコフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　道化師はそういって、スミ子ちゃんを車からだきおろすと、そのまま、どこかのたてものの中へはいっていくように思われました。",
              "citation": {
                "source": "塔上の奇術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "火入れがたくさん出されてあって、薫香をけむいほど女房たちが煽ぎ散らしているそばへ院はお寄りになって、「空だきというものは、どこで焚いているかわからないほうが感じのいいものだよ。",
              "citation": {
                "source": "源氏物語",
                "author": "鈴虫",
                "note": "青空文庫"
              }
            },
            {
              "text": "『朝日新聞』にて『空だき』をお書きなすってから、作風も筆つきも殊更に調ってきて、『空だき』の続稿の出るのがまたれました。",
              "citation": {
                "source": "大塚楠緒子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それは女史の胸に描かれただけで、『空だき』が私の読んだものではお別れになってしまいました。",
              "citation": {
                "source": "大塚楠緒子",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
