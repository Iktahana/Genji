        "examples": {
          "standard": [
            {
              "text": "二人の意見対立は蝸牛角上の争いのようなものだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大事な問題を後回しにして、蝸牛角上の争いをしている場合ではない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼らの議論は蝸牛角上の争いに過ぎず、実質的な解決策がない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "文学界の人は殊に何事も感情任せで蝸牛角上の争いをしているから文筆を以て天下に貢献するような仕事は出来ず、実業界は道義全く地を払って更に信用の重んずべき事を知らん。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝸牛角上の争いということは昔から聞いていたが、小川の底から見ると、それが現実に見えるのである。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
