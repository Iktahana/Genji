    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "かたかたかたと、上原さんは走って階段を上って行って、私は不思議な透明な気分で、ゆっくり上って、外へ出たら、川風が頬にとても気持よかった。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "橋をかたかた渡りながら、いろんな事を思ひ出し、また夢想した。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「へい、」　と言ったばかり、こっちは忙がしい顔色で、女中は聞棄てにして、井戸端へかたかた行く。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「南無」とあとは口の裏で念じながら、左右へかたかたと静に開けた。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "鬼神に横道なし、と云う、情に抵抗う刃はない筈、」　枢をかたかた、ぐっと、さるを上げて、ずずん、かたりと開ける、袖を絞って蔽い果さず、燈は颯と夜風に消えた。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "この途端に颯と瞼を赤うしたが、竈の前を横ッちょに、かたかたと下駄の音で、亭主の膝を斜交いに、帳場の銭箱へがっちりと手を入れる。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "横笛だけは、お嬢さんを三人で包んで立った時、焦茶の中折帽を真俯向けに、爪皮の掛った朴歯の日和下駄を、かたかたと鳴らしざまに、その紋緞子の袴の長い裾を白足袋で緩く刎ねて、真中の位置をずれて、ツイと軒下を横に離れたが。",
              "citation": {
                "source": "薄紅梅",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "かたかたの五六人、声をしそろえて歌ったずおん。",
              "citation": {
                "source": "雀こ",
                "author": "井伏鱒二へ。津軽の言葉で。",
                "note": "青空文庫"
              }
            },
            {
              "text": "強いぞ」ほめてやって私は歩きだし、橋をかたかた渡って、ここはもう練兵場である。",
              "citation": {
                "source": "畜犬談",
                "author": "―伊馬鵜平君に与える―",
                "note": "青空文庫"
              }
            },
            {
              "text": "細い、小さい子供の身体、皮と骨だけになって、脚かたかたになっていた……社員、職長笑う。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と若い女の声がすると、かたかたと駆出す音、呉服橋を、やや離れた辻のあたり。",
              "citation": {
                "source": "日本橋",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "見る見る野の末に黒雲がかかると、黒髪の影の池の中で、一つ、かたかたと鳴くに連れて、あたりの蛙の一斉に、声を合わせるのが、松の根本に苺が見える…………　あの当時の唄にそのままです。",
              "citation": {
                "source": "河伯令嬢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……お久という人の、めんてんの足袋で帰るのを、立合わせた台所から、お悦が送り出すと、尖った銀杏返を、そそげさして、肩掛もなしに、冷い頸をうつむけて、雨上りの夜道を――凍るか……かたかたかたかたと帰って行く。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "舷へ、かたかたと何やら嵌込む……　その嵌めるものは、漆塗の艶やかな欄干のようである、……はてな、ひそめく声は女である。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "時にかたかたと響いて、二三人で捧げ持った気勢がして、婦の袖の香｜立蔽い、船に柱の用意があって、空を包んで、トンと据えたは、屋根船の屋根めいて、それも漆の塗の艶、星の如き唐草の蒔絵が散った。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "出て来た門番の侍が寒そうな姿で、背中がぞっとするというふうをして、門の扉をかたかたといわせているが、これ以外の侍はいないらしい。",
              "citation": {
                "source": "源氏物語",
                "author": "朝顔",
                "note": "青空文庫"
              }
            },
            {
              "text": "源四郎の家では、屋敷の掃除もあらかたかたづいたらしい。",
              "citation": {
                "source": "告げ人",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "根のゆるんだ齒がかたかたと音をたてて鳴つた。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひさは立つてしばらく箪笥の環をかたかたさせてゐたが、やがてこつちへ來ておちかに向ひ合つて坐り、「姉さん、なんなの」といつておちかの顏を見た。",
              "citation": {
                "source": "第一義の道",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "』聴け、夜に叫ぶ髑髏、急瀬の小石、熟視むるは死よりも暗き鴆毒の発作に頻吹く水の面、聴け、わなわなとかたかたと千万歎く。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "』聴け、夜に叫ぶ髑髏、急瀬の小石、熟視むるは死よりも暗き鴆毒の発作に頻吹く水の面、なほ、きしきしとかたかたと嘆けど、哀れ、億劫の窮あらぬ闇に堕ち闇に饑ゑゆく人の群。",
              "citation": {
                "source": "第二邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "三千代は次の部屋で簟笥の環をかたかた鳴らしてゐた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "三千代は次の部屋で箪笥の環をかたかた鳴らしていた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何時の間にか風が出て、裏の方で何かかたかたと鳴りました。",
              "citation": {
                "source": "死人の手",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なるほど、叩くな、何人だろう」　伯父さんはやっとこさ起きあがって、暗い中をさぐりさぐり庖厨の方へ往って土間へおり、足でさなずって下駄と草履をかたかたに履いて、其処の戸を放して裏口へ出た。",
              "citation": {
                "source": "餅を喫う",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（くそっ、本渓湖の戦の思いをすりゃ、なんでもねえや）　広巳の耳には砲弾の唸りがよみがえり、かたかたと鳴る機関銃の音がよみがえった。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
