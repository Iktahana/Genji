  {
    "uuid": "bd29c40f-ec73-5205-86a6-7efd1a648554",
    "entry": "かたかた",
    "reading": {
      "primary": "かたかた",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
