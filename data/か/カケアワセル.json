        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "青と黄色を絶妙な比率で掛け合わせることで、深みのあるエメラルドグリーンが生まれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "パレットの上で何色もの絵の具を掛け合わせ、夕焼けの微妙なグラデーションを再現していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "単色では出せない質感を出すために、あえて反対色を薄く掛け合わせて影を表現してみた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
