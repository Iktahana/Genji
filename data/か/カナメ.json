        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「彼こそがこのプロジェクトの要だ。彼が抜ければ、作戦はすべて白紙になる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "議論の要を見失わないように、ホワイトボードにもう一度論点を書き出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "防衛線の要となるこの砦を死守するため、兵士たちは交代で夜通し見張った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ここが勝負の要だぞ、気合を入れ直せ！」監督の怒声がベンチに響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      },
