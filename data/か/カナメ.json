        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "生け垣の要が、春の日差しを浴びて燃えるような真っ赤な新芽を吹いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "庭の隅に植えた要の木が、いつの間にか私の背丈を追い越すほどに成長した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "要の葉を一枚ちぎって光にかざしてみると、細かな網目状の葉脈が見えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ほら、白くて小さい花が咲いているのが要の木だよ。」と母が教えてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
