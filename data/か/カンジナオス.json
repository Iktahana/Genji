          "literary": [
            {
              "text": "一般に日本人が青いといへば何となく松の緑のやうなくすんだ色を思出すのであるが、こゝに言ふ青い色とはそんなものではない、さういふ海の色を見て、成程天地の間にはかういふ美しい青い色があつたかと、青といふ色彩を改めて感じ直すのだ。",
              "citation": {
                "source": "南太平洋科學風土記",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る晴ればれした早朝、ふと目がさめて傍にすやすやとしているものを見たとき、それが自然である故にしみじみと新しくそのことを感じ直す、それに似たよろこばしき確認というものも、人生にはあります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
