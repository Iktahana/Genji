[
  {
    "uuid": "f1141e62-dd11-5b1e-a9bc-feb94bd84363",
    "entry": "数え上げる",
    "reading": {
      "primary": "かぞえあげる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
