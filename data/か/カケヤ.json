  {
    "uuid": "527e7376-c789-5f12-908e-6ac3dc3a327e",
    "entry": "掛け屋",
    "reading": {
      "primary": "かけや",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
