        "examples": {
          "standard": [
            {
              "text": "ゲームの海外版には日本版にはない追加コンテンツが収録されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は日本語学習のために、マンガの海外版と日本語版を見比べながら読んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "映画の海外版では、文化的な違いを考慮していくつかのシーンが差し替えられていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "それとはまた別に、外務省と連絡をつけて、海外版の写真雑誌を出すことにもなっているので、その方を先きにしてから結婚しようかと、昨夜から迷ってるんだよ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京でもすでに海外版の写真で活動を始めていた塩野は、明日からの京都の旧蹟を撮ることに、今から愉しみぶかい興奮を示して絶えず活溌に話したが、矢代だけは明日の別れもあり、また皆のものを京都へひき出したこの度びの責任の回避も覚えて、とかく沈みがちに気重くなるのだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう海外版は車中だ。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
