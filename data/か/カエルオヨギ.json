        "examples": {
          "standard": [
            {
              "text": "子どもは水泳教室で蛙泳ぎの基本をマスターしようと頑張っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "蛙泳ぎは他の泳法より体力を消費しないため、長距離向きである。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "オリンピック選手たちの蛙泳ぎの速度は驚くほど速い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "……お湯へおはいりなさいよ」　そういうとお蘭は、背中を湯面へ浮かせ、蛙泳ぎをして湯槽の向こう側へ泳いで行き、振り返るとぼんのくぼを湯槽の縁へかけ、フーッと、唇をとんがらかして湯気を吹き、男と向かい合った。",
              "citation": {
                "source": "猿ヶ京片耳伝説",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒いふんどしの子供たちは、犬かきや、蛙泳ぎや、平泳ぎを、唇が青くなつてガタ／＼ふるへるまで、練習します。",
              "citation": {
                "source": "プールと犬",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "黒いふんどしの子供たちは、もう犬かきや、蛙泳ぎばかりしてはゐません。",
              "citation": {
                "source": "プールと犬",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻　　蛙泳ぎでせう。",
              "citation": {
                "source": "明日は天気（二場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "敵の通せんぼうをかい潜りかい潜り、立泳ぎ、蛙泳ぎ、抜き手、片抜手、美しき筋肉運動の限りを尽して、美少年のお尻へと追い縋る。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
