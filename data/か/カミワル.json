          "literary": [
            {
              "text": "あの実をロシヤ人が噛み割る方法を御存じですか。",
              "citation": {
                "source": "艸木虫魚",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            },
            {
              "text": "女みずからにぎりめしにして喰べさしたが、かたくて初はどうしても噛み割ることが出来なかった。",
              "citation": {
                "source": "大力物語",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅干のタネを、おく歯でカリッと噛み割ると、私たちの子供のころ“天神サマ”とよく言った白いタネの中の種肉が出る。",
              "citation": {
                "source": "押入れ随筆",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
