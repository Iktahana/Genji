          "literary": [
            {
              "text": "真赤なズボンに軍服をまとい、鼻に眼鏡を掛けている＊２マヴロコルダートだの、＊３ミアウリスだの、＊４カナリスだので。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "チチコフは再び眼をあげて、またしても太い腿と恐ろしく長い口髭を持ったカナリスや、ボベリーナや、籠の中の鶫を眺めた。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊４　カナリス　コンスタンチン（1790-1877）ギリシアの政治家。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はカナリスを作り出し、キロガを作り出し、ピザカーヌを作り出す。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
