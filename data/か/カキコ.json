      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ところが、茶漬をかきこんだり、味噌汁を吸ったりすることになると、とかく故障が起りがちである。",
              "citation": {
                "source": "鑢屑",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちかきころ水無月中旬、二十日余り照り続きたる、けふ日ざかりの、鼓子花さへ草いきれに色褪せて、砂も、石も、きら／＼と光を帯びて、松の老木の梢より、糸を乱せる如き薄き煙の立ちのぼるは、木精とか言ふものならむ。",
              "citation": {
                "source": "紫陽花",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "実は、少しからだの工合いおかしいのでして、などと、せっぱつまって、伏目がちに、あわれっぽく告白したりなどするのだが、一日にバット五十本以上も吸い尽くして、酒、のむとなると一升くらい平気でやって、そのあとお茶漬を、三杯もかきこんで、そんな病人あるものか。",
              "citation": {
                "source": "懶惰の歌留多",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……」　飯盒にわけられた、つめたい飯をかきこんだ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その手前には、モンペイをはき、髪をくる／＼巻きにした女達が掘りおこされた鉱石を合品で、片口へかきこみ、両脚を踏ンばって、鉱車へ投げこんでいた。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は、土をかきこんで、それを遮断しようがために、無茶苦茶にシャベルを動かした。",
              "citation": {
                "source": "穴",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供達は、喜び、うめき声を出したりしながら、互いに手をかきむしり合って、携えて来た琺瑯引きの洗面器へ残飯をかきこんだ。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まっ黒な家の中には黄いろなラムプがぼんやり点いて顔のまっかな若い女がひとりでせわしく飯をかきこんでゐる。",
              "citation": {
                "source": "女",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその顔色の悪い子供も黙って、馴れない手つきで茶碗をかきこんでいたのである。",
              "citation": {
                "source": "ある崖上の感情",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにかきこえると聴耳をたてはじめてから、それが一つの可愛いリズムだと思い当てたまでの私の気持は、緊張と云い喜びというにはあまりささやかなものでした。",
              "citation": {
                "source": "橡の花",
                "author": "――或る私信――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この世なるえにしふかくして母よ子と和みくらさんみじかきこの世を。",
              "citation": {
                "source": "家庭愛増進術",
                "author": "――型でなしに",
                "note": "青空文庫"
              }
            },
            {
              "text": "乙女の星はこれを見て早くも露の涙うかべ、年わかき君の心のけだかきことよと言い、さて何事か詩人の耳に口寄せて私語き、私語きおわれば恋人たち相顧みて打ちえみつ、詩人の優しき頬にかわるがわる接吻して、安けく眠りたまえと言い言い出で去りたり。",
              "citation": {
                "source": "星",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝉の声もいつかきこえず、部屋のなかに迷い込んで来た虫を、夏の虫かと思って、団扇ではたくと、ちりちりとあわれな鳴声のまま、息絶える。",
              "citation": {
                "source": "秋の暈",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "あわてて飯をかきこんで、支度をすると、鶴雄は先斗町の路地を出て行った。",
              "citation": {
                "source": "それでも私は行く",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、それはまるで座附作者が役者に科白をつけているとしかきこえなかった。",
              "citation": {
                "source": "青春の逆説",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてお母さまの伝票にかきこみます。",
              "citation": {
                "source": "乞食の子",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふたりの荒い息づかいと音楽、それに、笹の群落を吹きわたる、風の音ぐらいしかきこえない。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ラジオを消しても、ヤマバトがノドを鳴らす声ぐらいしかきこえないだろう。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "たくじやうぎんぎよのめよりをんなのへそをめがけてふきいづるふんすゐひとこそしらねてんにしてひかるはなさきぎんぎよのめあかきこつぷををどらしめ。",
              "citation": {
                "source": "聖三稜玻璃",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "人格にない事を、ただ句を綴り章を繋いで、上滑りのするようにかきこなしたって、閑人に過ぎません。",
              "citation": {
                "source": "文芸の哲学的基礎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "宵闇の長い堤をぶらぶら戻ってくると、僕をじらすように大きい魚の跳ねあがる音が暗い水の上で幾たびかきこえた。",
              "citation": {
                "source": "水鬼",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "寢入りたる女の身をば今一度　思へば夏の夜は白みけりといふのがあるやはらかきこの心持明け方を　女にそむき一しきり寢るといふのがある、若し夫れ空黄色にぽうつと燃ゆる翌朝の　たゆき瞼をとぢてたゝずむに至つては何うだ。",
              "citation": {
                "source": "女郎買の歌",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "御本陣に見参してなんと仰せられるかきこう」と、思いつくと、忠直卿は岡山口へ本陣を進めていた家康の膝下に急いだのである。",
              "citation": {
                "source": "忠直卿行状記",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "雷と、雨と、霰と、風と、水の音――そんなものしかきこえないのです。",
              "citation": {
                "source": "オシャベリ姫",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "――廬を結ぶ古城の下、時に登る古城の上、古城｜疇昔に非ず、今人自ら来往す――一九三二年、秋ちかきころ、私はそんな古詩を愛誦しながら、愛国の詩をつくりたきものよ！",
              "citation": {
                "source": "私の万年筆",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "豆腐屋の喇叭の音がどこからかきこえて来た。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
