  {
    "uuid": "8801ff09-2605-5be4-8d82-0aec3ce6b323",
    "entry": "かきこ",
    "reading": {
      "primary": "かきこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
