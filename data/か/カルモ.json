        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私はカルモチンをたくさん嚥下したが、死ななかった。",
              "citation": {
                "source": "苦悩の年鑑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「すまないけどね、電車通りの薬屋に行って、カルモチンを買って来てくれない？",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは、お前、カルモチンじゃない。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルモチンなんか枕元においちやいけないよ。",
              "citation": {
                "source": "老苦",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "……一刻も早くアルコールとカルモチンとを揚棄しなければならない、アルコールでカモフラージした私はしみ／″＼嫌になつた、アルコールの仮面を離れては存在しえないやうな私ならばさつそくカルモチンを二百瓦飲め（先日はゲルトがなくて百瓦しか飲めなくて死にそこなつた、とんだ生恥を晒したことだ！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "一昨夜も昨夜も寝つかれなかつた、今夜は寝つかれるいゝが、これでは駄目だ、せつかくアルコールに勝てゝも、カルモチンに敗けては五十歩百歩だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔ふた気分は、といふよりも酔うて醒めるときの気分はたまらなく嫌だけれど、酔ふたゝめに睡れるのはうれしい、アルコールをカルモチンやアダリンの代用とするのはバツカスに対して申訳ないが。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "九時から一時まで辛うじて行乞、昨夜殆んど寝つかれなかつたので焼酎をひつかける、それで辛うじて寝ついた――アルコールかカルモチンか、どちらにしても弱者の武器、いや保護剤だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私にはもうアルコールもいらない、カルモチンもいらない、ゲルトもいらない、フラウもいらない、……やつぱりウソはウソだけれど、気分は気分だ。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜はわざと飲み過した、焼酎一杯が特にこたへた、そしてぐつすり寝ることが出来た、私のやうな旅人に睡眠不足は命取りだ、アルコールはカルモチンよりも利く。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……二月十五日　少し歩いて雨、布津、宝徳屋（三〇・中）気が滅入つてしまうので、ぐん／＼飲んだ、酔つぱらつて前後不覚、カルモチンよりアルコール、天国よりも地獄の方が気楽だ！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――アルコールよりカルモチン　　　ちよつと一服｜盛りましよか　六月四日　同前。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルモチンよりアルコール、それが、アルコールよりカルモチンとなりつゝある、喜ぶべきか、悲しむべきか、それはたゞ事実だ、現前どうすることもできない私の転換だ。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコールよりカルモチン――まつたくさういふ気分になりつゝある、飲まないのではない、飲めなくなつたのだ（肉体的に）、意志が弱いと胃腸が強い、さりとはあんまり皮肉だつたが、その皮肉も真実になつたらしい、少くとも事実にはなつた、健全な胃腸は不健全な飲食物を拒絶する！",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もどうやらかうやらアルコールから解放されさうだ、といつて、カルモチンやアダリンはまつぴら／＼。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "酒を飲まなくなつたことは事実だ、正確にいへば、飲めなくなつたのだ、経済的でなく、肉体的乃至精神的なもののために、――よし、よし、これからは酒を飲む代りに本を読まう、アルコールよりカルモチンといふほどの意味で。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルコールよりカルモチンへ、どうやらかういふやうに転向しつゝあるやうである、気分の上でなしに、肉体に於て。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "生きてゐることが苦しくなつてくる、といつて、死ぬることは何となく恐しい、生死去来は生死去来なりといふ覚悟は持つてゐるつもりだけれど、いまの、こゝの、わたしはカルモチンによつてゞもゴマカすより外はない！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "……樹明来、サケとトウフとカルモチンとザツシとを持つて。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねむれた、ありがたかつた、カルモチンよりアルコールだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月三十一日我昔所造諸悪業――皆由無始貪瞋痴――従身口意之所生――一切我今皆懺悔――カルモチンのおかげで、やつとねむつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルモチンを飲んでも眠れないとはみじめだ、やつぱり。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルモチンよりアルコールちよいと一杯やりましよか一杯やりたいな、やりたいなだ！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は毎日寝てゐた、……カルモチンかダイナマイトか。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく生も死もなくなつた、多量過ぎたカルモチンに酔つぱらつて、私は無意識裡にあばれつつ、それを吐きだしたのである。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "バラバンのバン一万三千尺、富士の山せまい日本が、一眼に見える、お花畑で、カルモチン。",
              "citation": {
                "source": "小熊秀雄全集-2",
                "author": "詩集（１）初期詩篇",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめはカルモチンなら十錠、アドルムなら二錠で眠られたのが、しまいには、カルモチン五十錠から百錠の間、アドルム十錠ほど、一気にのまなければ眠られなくなった。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
