        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "祝髪後等覚と云つた人である。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに母尼公は落髪後久しからずして、文明四年十月中旬に歿した。",
              "citation": {
                "source": "東山時代における一縉紳の生活",
                "author": "原勝郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙貞は剃髪後の名であろうが、まだ存生であるのか、没後の話か、この句だけではよくわからない。",
              "citation": {
                "source": "古句を観る",
                "author": "柴田宵曲",
                "note": "青空文庫"
              }
            },
            {
              "text": "勤行と書いたのは剃髮後だからである。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
