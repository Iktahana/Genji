[
  {
    "uuid": "e3c6d26a-21ef-561d-ac9c-527868e52e39",
    "entry": "勘査",
    "reading": {
      "primary": "かんさ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "investigation",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの疑惑について、もう一度、じっくり勘査する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "過去の失敗から学びたいと、彼は自分の作品を冷静に勘査し始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "歴史家たちは、古文書を手に、当時の社会状況を詳細に勘査していった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この問題の根本原因を突き止めるため、専門家チームによる徹底的な勘査が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "此の問題は一つ勘査して見たい問題で有る。",
              "citation": {
                "source": "努力論",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東京は別だよ、場所（都会）の人間はあかんさ」「だが、俺たちも一昨年、去年は駄目だったじゃねえか。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "本当に今日は不好な御顔色でゐらつしやるから、それがかう消えて了ふやうに、奮発して召上りましよ」　彼は覚えず薄笑して、「薬だつてさうは利かんさ」「どうあそばしたので御座います。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺が毛唐の犬を知つてるほどに中々行かんさうだ。",
              "citation": {
                "source": "犬物語",
                "author": "内田魯庵",
                "note": "青空文庫"
              }
            },
            {
              "text": "「五十円もウネツテたまつたら、病院に入つてこまそと思ふんやけど」「どこが病気や」「どこが、悪いのかなア」と他人事のやうに少年は云ふと、「ほんまに、はよ、治しときや、手おくれになつてしもたら、あかんさかいな」と、気がよささうな煮込屋の主人は、横から忠告するのである。",
              "citation": {
                "source": "釜ヶ崎",
                "author": "武田麟太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハア、あんで洋服にさ気イつかなかったべい」「そりゃ、君誰だって、こんな所に人の死んでるのを見たら、そこまでは気がつかんさ。",
              "citation": {
                "source": "青服の男",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸術家は、絶えず、歩いてゐなくちやいかんさ。",
              "citation": {
                "source": "傍観者の言",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寿　　（珈琲の道具を用意しながら）材料が材料だから、思ふやうには行かんさ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "八月十四日（土曜）　○体重58キロから48キロに一ヵ月で下った由、　かんさんして見ると48キロというのは十三貫百三十匁云々なり。",
              "citation": {
                "source": "日記",
                "author": "一九三七年（昭和十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "な、私で話が分るんなら行んでも来ようが、こう云う事は、女子ではらちが明かんさかいな。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「私もな、今つくづく思うて見たんやが、金出してもらうにしろ、どいだけずつ入るんやかはっきり知れんでは、うちあかんさかいお前見つもって見てんか。",
              "citation": {
                "source": "栄蔵の死",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どないに口で言わはってもあかんさかいなア」　「ばかをいうな。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "どないに口で言わはってもあかんさかいなア」「ばかをいうな。",
              "citation": {
                "source": "小説　不如帰",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あくる朝、ふたりが目をさましたときには、お日さまはもう高くのぼっていて、木のうろのなかまで、かんかんさしこんでいました。",
              "citation": {
                "source": "にいさんと妹",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "はゝゝゝ、さうはいかんさ。",
              "citation": {
                "source": "音の世界",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "繃帯　　さうはいかんさ。",
              "citation": {
                "source": "命を弄ぶ男ふたり（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "「困ったなおい、俺はこれから西の窪の大黒亭まで行かなけりゃならねえ、もうこれ以上つなげねえんだ」　ある晩さんざつないで下りてきた鯉かんさんがいった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちはもう仁義だけは尽したつもりだ」　鯉かんさんはいった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「な、何だ」　立ちのまま鯉かんさんは振り返った。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいすみません、あとにまだ誰も参りませんし、鯉かんさんがお前上がれとおっしゃったもんで」　やっと自分の叱られているわけが分って、にわかにオドオド小圓太はいった。",
              "citation": {
                "source": "小説　圓朝",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おら、行かんさ。",
              "citation": {
                "source": "父の帰宅",
                "author": "小寺菊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あなたのおっしゃる事なら素直に聞くだろうと思うんですが」「そうも行かんさ」　Ｈさんは苦笑していた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで足りなければまた秋の日をかんかんさせるさ。",
              "citation": {
                "source": "吾輩は猫である",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いくら腕がようてもお客が尻ごみしてよう寄りつかんさかい」と、ある親切な先輩が真面目に反対した。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この屋敷で地方長官の父を十七年も看護した忠實な家政婦のかんさんが、一さいの家政の切り盛をやり、ななえもかんさんの言ひなりになる仕向けをうけてゐた。",
              "citation": {
                "source": "渚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "かんさんは屋敷が賣り物になり千萬圓もすると聞いてから、ななえが二階で寢た時分、納戸や押入に顏を突つ込み、更けるまで明日の食事のための搜し物をしてゐた。",
              "citation": {
                "source": "渚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな時に小用で下りて來たななえは階段では音を立てなかつたが、中の襖を開けた時にかんさんは氣づいて押入の中に隱れることがあつた。",
              "citation": {
                "source": "渚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく肥つたかんさんは押入から出ると、主家のために盡したことでも、つい、ぺろりと舌を出してみせた。",
              "citation": {
                "source": "渚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "ななえの暢氣さうな惡考へをもたない性分を知つてゐるかんさんは、夜更けにこの屋敷内の物と品に見當をつけて置けば何時でも處分することが出來た。",
              "citation": {
                "source": "渚",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
