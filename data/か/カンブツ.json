  {
    "uuid": "f15ec630-3eac-52f5-a2c9-ae996954a29a",
    "entry": "灌仏",
    "reading": {
      "primary": "かんぶつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
