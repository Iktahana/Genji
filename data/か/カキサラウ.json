          "literary": [
            {
              "text": "慾にかけ、あらいざらいを掻き攫う風にも見えない。",
              "citation": {
                "source": "日記",
                "author": "一九二三年（大正十二年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「火のついた踵」の次には何……降誕祭にしようか　夜になって風がひどく吹き、風呂場の屋根はまるで、大きな金の熊手でかきさらうような音を立る、どこかの枝がさわるのだろう。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはびんの一ばん底に残った滓までかきさらうような努力だった！",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "私なら遺言なんて冗らない物は書かずに、ムスコとムスメが、お互に掻っさらうために詰めよるのを、いまから愉しげに見て置きたかった。",
              "citation": {
                "source": "〈我が愛する詩人の伝記〉（補遺）",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
