[
  {
    "uuid": "bc2ecc2a-e829-5646-8ca3-652f9f73a6a5",
    "entry": "貸し手",
    "reading": {
      "primary": "かして",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
