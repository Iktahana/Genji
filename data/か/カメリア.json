        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭に植えたカメリアの花が、今年も美しく咲いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の寒い時期に、鮮やかな色のカメリアは心を和ませてくれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女はカメリアの柄が入った着物を着ていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "今朝、職工長から貰ったカメリヤの袋の中から三本を抜き出して、掌の上に載せながら……。",
              "citation": {
                "source": "老巡査",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「俸給は十時から渡すんだっけな」と戸塚もカメリヤの袋を出しかけた。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "してみれば、カメリヤの女皇に身をささげ、その祭壇から流れ出る暖かい同情の流れを、心ゆくばかり楽しんでもよいではないか。",
              "citation": {
                "source": "茶の本",
                "author": "茶の本",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しくなつて帯揚をまた結んで応接室へ入つてカメリヤに火を附けて吸つた。",
              "citation": {
                "source": "日記のうち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは又ふらふらと応接室へ入つて行つてカメリヤを飲んで居た。",
              "citation": {
                "source": "日記のうち",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "はじめて、カメリヤが咲いてゐるところを見る。",
              "citation": {
                "source": "アンリエツトの転地療養日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
