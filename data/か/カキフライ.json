        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "本郷バアでカキフライと、ホワイトライスを一人前取っておっかさんと私の昼飯とする。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツレツ、カキフライ、焼飯、それに十何本かの酒。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺がそう言ってからかうと、京子は怒って、留七のトンカツとカキフライをぺろりと食べてしまった。",
              "citation": {
                "source": "蛸の如きもの",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
