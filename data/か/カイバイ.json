        "examples": {
          "standard": [
            {
              "text": "古代では、貝灰をセメントの材料として使用していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "建築遺跡から採取された貝灰の成分を分析した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この地域では、貝灰を生成するための大規模な施設が発見されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "これは貝灰を燒く原料として、横濱の石灰製造所で買つたのだといふ。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "末吉の貝塚",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時に（地底探檢記一五七｜頁參照）貝灰の原料とすべく土方が大發掘をして居たのを初めて知り、それから六｜月十四｜日に又一｜度行つて見たが、兩度とも實に大失望であつた。",
              "citation": {
                "source": "探檢實記　地中の秘密",
                "author": "疑問の加瀬貝塚",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
