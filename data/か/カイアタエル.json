        "examples": {
          "standard": [
            {
              "text": "父は誕生日に息子にスポーツ自転車を買い与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "祖母が孫に高価なゲーム機を買い与えたせいで、子どもが宿題をしなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は友人の子どもに絵本を一冊買い与えて帰った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "村社の修復、屋根がえ、学校長への大礼服の寄贈（しかもこれは貧富に拘らず、校長氏が準訓以来教えた全部の卒業生各自への二十銭の割当寄付によったもので、一家四五名の卒業生も珍らしくなく、現在通学中の児童へ一本の鉛筆を買い与えることすら容易でないものも既定額を出さねばならなかったのだ。",
              "citation": {
                "source": "瘤",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでわたしは自分自身をあわれみはじめ、彼に古着店そっくりを買いあたえるよりは自分にフランネルのシャツ一枚をあたえる方がより大きな慈善だろうと気がついた。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分とおなじ髪に作ってもらい、ブティークへいって彼に似合う女性の服を買いあたえる。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
