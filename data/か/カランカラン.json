    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "秋のころと記憶するが、私がひとりでお寺へ行つてその金輪のどれを廻して見ても皆言ひ合せたやうにからんからんと逆廻りした日があつたのである。",
              "citation": {
                "source": "津軽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、こちらの農夫も、鳴子という因を田の上に釣り下げ、縄をひくという縁によって、からんからんと鳴らせて雀を追払わんとするのが果であります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが地面に響きを立てて落ちると、落ちた上に落ちて来るほかの瓶がまたからんからんと音を立てて、破れたり、はじけたり、転がったりした。",
              "citation": {
                "source": "卑怯者",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "からんからんと駒下駄を引き擦る音がする。",
              "citation": {
                "source": "坊っちゃん",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は緒を捲きとる枠が、凄い勢で、からんからんと畠の上を跳びながら、走つていくのをぽかんと見てゐた。",
              "citation": {
                "source": "良寛物語　手毬と鉢の子",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "棒が、からんからんと、板敷へ音立てて転がった。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "辻ヶ谷君は、その器械の横についている小さい汽船の舵輪のようなものにとりついて両手を器用にうごかし、からんからんと輪をまわした。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしはきっとアクチニオ四十五世を探し出さにゃおかない」　と男は、杖をからんからんとならしながら、空に向って話しかける。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあいだ、ハープは、たえず、からんからん、なりつづけました。",
              "citation": {
                "source": "ジャックと豆の木",
                "author": "楠山正雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹴ったら、からんからんと虚ろな音をたてた。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜のからんからんに乾いた空気の、その底でうつかり　咳をとりおとすと発止！",
              "citation": {
                "source": "雪",
                "author": "高祖保",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに前後左右で、からんからんとけたたましく非常に高い金属性の音が鳴り響いた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
