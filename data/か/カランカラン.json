    },
    "definitions": [
      {
        "index": 1,
        "gloss": "clank-clank",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "かき氷屋さんの店先で、店主がカランカランと鐘を鳴らして、子供たちに開店を知らせている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "空になったミルク瓶をカゴに入れて運ぶと、カランカランと乾いた音が早朝の住宅街に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "登山口の売店に吊るされたカウベルが、風に揺られてカランカランと牧歌的な音を立てている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ストーブの上で沸騰した薬缶の蓋が、蒸気の勢いでカランカランと音を立てて躍り始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その時、向うの農夫室のうしろの雪の高みの上に立てられた高い柱の上の小さな鐘が、前后にゆれ出し音はカランカランカランカランとうつくしく雪を渡って来ました。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸も腰もつくろわない少女じみたカシミヤの制服を着て、有合せの男下駄をカランカラン引きずって、客へ茶を運ぶ。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、向ふの農夫室のうしろの雪の高みの上に立てられた高い柱の上の小さな鐘が、前後にゆれ出し音はカランカランカランカランとうつくしく雪を渡って来ました。",
              "citation": {
                "source": "耕耘部の時計",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カランカランという踏切の音を背中に聴きながら、寝しずまった住宅地を通り抜けると、もはや門燈のにぶい光もなく道はいきなりずり落ちたような暗さでそこに池がある。",
              "citation": {
                "source": "道",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "棍棒が倒れるとカランカランという音がして、それが小屋の中から静かな園内へ響き渡る。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ゴロゴロ、カランカランという音が思い出したように響いていた。",
              "citation": {
                "source": "旅日記から（明治四十二年）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここで岩角を掴んでトラバースしているとき、腰のバンドに取付けていた懐中電灯が岩にふれて取手の付いた蓋の方を残してカランカランと音を立てながら谷底へ落ちてしまった。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときカランカランと音がして、長い竹竿が二人の足許に転がった。",
              "citation": {
                "source": "雷",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "六、カランカランと鳴る鐘は旅館や下宿の昼餐の合図。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "謝肉祭の支那服　――地中海避寒地の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、大連市中の日本橋のたもとに立って、りんを振っていると、汽車が走りながら鳴らすカランカランという半鐘の音がきこえてくる。",
              "citation": {
                "source": "私の履歴書",
                "author": "――放浪の末、段ボールを思いつく",
                "note": "青空文庫"
              }
            },
            {
              "text": "おきあがりますと、からだのまわりがかちかちして、おまけに、ひと足歩くたびに、たくさんの鈴がカランカランとなります。",
              "citation": {
                "source": "りこうもののエルゼ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、だれもかれも、カランカランという鈴の音をききますと、どうしても戸をあけてくれようとはしませんでした。",
              "citation": {
                "source": "りこうもののエルゼ",
                "author": "グリム　Grimm",
                "note": "青空文庫"
              }
            },
            {
              "text": "自暴もまた侮るべからず、こうして継いでおけば問題はござるまい」「なるほど、うーん」　金公が唸り出してやがて降参してしまうと大入道大得意、カランカランと打笑う。",
              "citation": {
                "source": "大菩薩峠",
                "author": "女子と小人の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "この金属の一端は半インチ足らず前後に動いて、カランカランと弱々しい音を立てた。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "大観覧車の車輪が、カランカランとほがらかな音を立てながら、組立ておもちゃの様に、解体して行った。",
              "citation": {
                "source": "地獄風景",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
