        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "平安時代の貴族は貝合わせを雅な室内遊びとして楽しんでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "博物館で展示された貝合わせの道具には、金箔で内側を飾った蛤の貝殻が並んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "貝合わせは対になった蛤の片割れを探す遊びで、現代のトランプの神経衰弱に似ている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "両側のがけが、ちょうど、びょうぶを二まいむかいあわせて立てたようになっている。",
              "citation": {
                "source": "嘘",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのむかいあわせの屋根うらべやの窓も、また、あけひろげられて、カイとゲルダとは、アパートのてっぺんの屋根上の雨どいの、ちいさな花ぞので、ことしもあそびました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "向かいあわせ」　事務室の窓口に手をかけた高志に、慶一が声をかけた。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は、赤い絨毯をしきつめた大広間の真中に、籐椅子を向かいあわせて腰を下した。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれを向かいあわせにもってきて、ぴょこぴょこさげ、両方の指がしきりにお辞儀をしているような型をやって見せた。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "春は――平打の銀簪を畳の上に落したまま、貝合せの貝の裏が朱と金と藍に光る傍に、ころりんと掻き鳴らし、またころりんと掻き乱す。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "女は今更のようにどよめきたって、居ないと思った女達まで出て来て笑いどよめきながら貝合せをはじめる。",
              "citation": {
                "source": "錦木",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其が更に、後の貝合せ・艶書合せと称する「恋歌合せ」に移つて行つた痕まで、一筋に通つてゐる。",
              "citation": {
                "source": "女房文学から隠者文学へ",
                "author": "後期王朝文学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝合せ　その日、――原田家の朝粥の会には、いつになく珍らしい客があった。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第一部",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ交※飲むだけでは、興もない」「睨めッこ」「やくたいもない」「では貝合せ」「あれは、汚い爺を相手にする遊戯びではない」「憎いことを。",
              "citation": {
                "source": "宮本武蔵",
                "author": "風の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
