        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "親ニモ同胞ニモワカレテ仕ヘテヰルノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "林房雄トイウ名ノ一陣涼風ニソソノカサレ、浮カレテナセル業ニスギズ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トウトウ　コノ　タケノコハ　ホカノ　タケノコタチト　ワカレテ、カキネノ　ソトニ　アタマヲ　ダシテ　シマヒマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲトコハ　トシヨリト　ワカレテ　ナホモ　アルイテ　イキマスト、ナルホド　アノ　トシヨリガ　イツタトホリ、ハタケハ　タイハウノ　ワヤ　ウマノ　アシデ　スツカリ　アラサレテ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイドウニ　ソツタ　イエイエノ　ヒトタチハ、ムカシ　ジブンタチノ　ノツタ　バシヤガ　コドモタチニ　ヒカレテ　イクノヲ　ミルト、シゴトヲ　ヤメテ　オモテニ　デテ、バシヤヲ　ミオクルノデ　アリマシタ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテ、アル　ヒノ　コト　ガチヨウノ　タンジヨウビト　イフノデ、ミンナハ　ガチヨウノ　トコロヘ　ゴチソウニ　マネカレテ　イキマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "末節枝葉ニ於テ如何ナル非難アルニセヨ、朝鮮ハ露西亞ノ玄關ニ老婆ノ如ク窮死スベカリシ者ヲ、日本ノ懷ニ抱カレテ少女ノ如ク生長シツツアルハ之ヲ無視スル能ハズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "棒寄せの呪文は、人によりて同一ならざるがごとしといえども、ある者の伝うるところによるに、「ショウトクオウガキミニセカレテ」と申す語を用うるなり。",
              "citation": {
                "source": "妖怪学",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、皆サンゴゾンジナイカモ分リマセンガ、ジヤガイモサンハ大ヘンナオ寝坊サンデシタカラ、人参サンニゴツンゴツンタタカレテモ、「何ダ？",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハ家ヲトビダシテ、アツチコツチヲアルキマシタケレドモ、ツカレテ、ダンダンネムクナリマシタノデ、自転車ニノツテ、ホテルヘユキマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カゼニ　フカレテ、ゴミハ　ウエキノ　トコロマデ　トンデキマス。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ一大種族ノ一部、先ヅ分カレテ「エスキモー」ノ本ヲ作リ、他部我ガ日本ノ地ニ入リテ「コロボックル」ノ本ヲ作リタルヤモ知ルベカラズ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二句、「母之手放」は、ハハノテソキテ、ハハガテカレテ等の訓もあるが、今｜契沖訓に従った。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハコノ女ハ枕サガシダト分ッテモ、却テソノタメニ興味ヲ惹カレテ、枕サガシヲ承知ノ上デ関係ヲ結ブ、ソノ誘惑ニ抗シカネルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "割下水ノ家ニ住ンデイタ時分、六ツカ七ツノ頃ダッタヾロウ、乳母ニ抱カレテ寝床ニ横ニナッテイルト、蟋蟀ガヨク縁側ノ外デ鳴イテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "半バ夢ノ中デ自分ガ今モ割下水ノ家ニイルヨウニ感ジ、寝床ノ中デ乳母ニ抱カレテイルヨウニ感ジル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ニ手ヲ曳カレテ庭ヲ散歩シテイルト、囲イノ中ノ犬舎ニ入レテアル筈ノコリーガドウシタ間違イカ飛ビ出シテ来テ突然予ニ跳リカヽッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二三年前マデハオ爺チャンモマダ足腰ガイクラカ達者グッタカラ、大キナ犬ニ飛ビ着カレテモ心配ナコトハナカッタガ、今日デハ事情ガ違ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "郁子ト敏子ト、彼自身ハドッチニ惹カレテイルノデアロウカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテソノ麻痺状態ニ置カレテイタ期間ハモノノ二三十分ニ過ギズ、間モナク遮断サレテイタ神経ノ通路ガ復舊シ、失ワレタ記憶ガ戻ッテ来テスベテガ平生ノ通リニナッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレハ大変ナ曲デス……コノ作者ハモノニ憑カレテイマス。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "……コノ人憑カレテイマス……人間ノ作ッタ曲デナイ……コノ人モウ長クハ生キナイデショウ……」　そして私の方へ柔和な老眼をじいっと向けられました。",
              "citation": {
                "source": "棚田裁判長の怪死",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "通リスガリニモ、ワント云ヘバ、身ノ毛モヨダチ、食ヒ付カレテモ、叱ルコトナラズ、逃グルホカハナカリケリ。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
