  {
    "uuid": "67478f52-ed99-5afd-b7c0-b75016a51e69",
    "entry": "かもか",
    "reading": {
      "primary": "かもか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかもかれの猫はそのいづれにもぞくしない。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかかるクラシズムが、何故に詩の表現と結婚するのか。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかうした驚異は、同時に人間としての室生犀星を知るものが、だれしも等しく感知する所の人格的驚異に外ならないのである。",
              "citation": {
                "source": "愛の詩集",
                "author": "愛の詩集の終りに",
                "note": "青空文庫"
              }
            },
            {
              "text": "この剥啄と、カム、インは、余りに呼吸が合過ぎて、あたかもかねて言合せてあったもののようである。",
              "citation": {
                "source": "婦系図",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく水はサラサラ鳴り、天井の波はいよいよ青い焔をあげ、やまなしは横になって木の枝にひっかかってとまり、その上には月光の虹がもかもか集まりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく水はサラサラ鳴り、天井の波はいよいよ青い焔をあげ、やまなしは横になつて木の枝にひつかかつてとまり、その上には月光の虹がもかもか集まりました。",
              "citation": {
                "source": "やまなし",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "なりひらが、Ｔ「そうよ半分だ」　おいッ大将、Ｔ「しかもかんじんかなめのお前さんの名前の処が無えんだよ」　アッ、と驚く左衛門。",
              "citation": {
                "source": "なりひら小僧",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "とつおいつ思いあぐねるうち、いよいよ無力の孩児としての感じを自分に深めて来た老翁は、いまは何もかもかなぐり捨て、ひたすら娘に縋り付き度くなった。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかれには言うに言われぬ無念がまだ折り折り古い打傷のようにかれの髄を悩ますかと思うとたまらなくなってくる。",
              "citation": {
                "source": "まぼろし",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほんの小さな小犬であったのが今では堂々としてしかもかわいい良い犬である。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "少なくも爆弾よりも安価でしかもかえって有効かもしれない。",
              "citation": {
                "source": "からすうりの花と蛾",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "大事なしかもかなり六かしい事柄の核心を平明にはっきり呑込ませる術を心得ているようであった。",
              "citation": {
                "source": "ベルリン大学（1909-1910）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのモンタージュは純然たる夢の編成法であり、しかもかなりによく夢の特性をつかんでいる。",
              "citation": {
                "source": "映画芸術",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかくのごときはただこれ困窮の余に出でたことで、他に何等の煩悶があってでもない。",
              "citation": {
                "source": "おばけずきのいわれ少々と処女作",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊主を軽蔑する本心にも手段にも、いささかもかわりはない。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもかの二分の人々の、殺氣を孕んだ猛々しさといふものは、すでに尋常一樣のものではなかつた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども奥さまに重大な嫌疑がかかっていて、しかもかわいそうに病気で口がきけない今、わたしがあの人を本当に救えるのでしたら、でしたら約束どころの話ではございません。",
              "citation": {
                "source": "曲れる者",
                "author": "THE CROOKED MAN",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐしましょう」と少しも気取らない、しかもかなり上品な書体で黒く書いてあった。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "神ありや、はた虚しや、かもかくに思ふ我のみ。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻が無くてしかもかの象の鼻のアンダンテ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡れしずくの硝子の内側には紅や赤の草花の鉢を一鉢、小さな脚高の花卓の上に置いたのが、そのまわりが鮮新な、しかもかえってうら寂しい気分に明ってもいた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おくびょう者と見せかけて、その実は一刀流の達人、しかもかわいそうに、生まれつきの唖さ」「えっ、唖※　唖がまたなんだってかたわのくせに、あんな上等の香なんぞからだにたきこめていたんですかい」「それがあのとおりの美少年だけあって、うれしいといえばうれしい話だが、つまり武士のたしなみなんだよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "血染めの手形",
                "note": "青空文庫"
              }
            },
            {
              "text": "然かもかういふ孤島の僻邑に能の催しがあらうなどゝは夢にも思ひ設けなかつた所である。",
              "citation": {
                "source": "佐渡が島",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "……身辺整理、何もかもかたづけて――まだ屋根と野菜畑とはかたづかないが――ほつとする、おちついてゆつたりした気持である。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "けさもずゐぶん早かつた、早すぎた、何もかもかたづいてもまだ夜が明けなかつた。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝は早い私であるが、けさはかくべつ早かつた、四時ごろだつたらう、何もかもかたづいたのに、まだなか／＼明けの大鼓が鳴りださなかつた。",
              "citation": {
                "source": "松山日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "（間）姉　　いつかもかうして、このラムプつけたつけね。",
              "citation": {
                "source": "ラムプの夜",
                "author": "――学芸会のための一幕劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかもかう云つて、ふいと出て、一人で湯河原の宿に往つて泊り込んでゐたのを、どこへ徃つたか分らぬといふので、博士の内でも、里でも、ひどく心配したあげくに、宿屋の主人の出した葉書が屆いたので、里から人を遣つて連れて歸つたことがある。",
              "citation": {
                "source": "半日",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "また出直して来ようと思って表へ出ると、あたかもかの雷雨が襲って来たので、近所の知人の家へかけ込んで雨やどりをして、小降りになるのを待って再びたずねていくと、下の婆さんはいなかった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
