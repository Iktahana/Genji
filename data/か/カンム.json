[
  {
    "uuid": "cb975f4d-a4e1-558d-a098-20c810530f1a",
    "entry": "甘夢",
    "reading": {
      "primary": "かんむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "sweet (pleasant) dreams",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "久しぶりに故郷の夢を見た。ああ、甘夢だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "恋人と過ごす時間は、まるで甘夢のようにあっという間に過ぎた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "旅の疲れもあって、昨夜はひどく甘夢を見たような気がする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "旅人を甘夢に誘った薬品は、ハシシ（hashish）という麻薬であったと言われますが、大寿院の使ったのもこれとよく似た薬品で、祈祷と言ったのは、一種の催眠術の暗示に過ぎなかったのですが、当時の人はそんなからくりを分る由もありません。",
              "citation": {
                "source": "奇談クラブ〔戦後版〕",
                "author": "夢幻の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに引きかえ、一朝雪崩のドラの音に、われらの甘夢が破られるや否や、春、夏、秋……と四季の女神たちが、それこそ袖をつらね、踵を接いで、峯入りをされるのだから、目の廻るほどのいそがしさを味わうのだ。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "意外な侵入者に、彼らが楽園の甘夢を破られて、驚いて逃れ去ったものだろう。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、オキチでもブタでも、とにかく、彼等の満喫するに足る柔肌のかいなに抱かれて、彼らが姫氏の国の甘夢にうつつなき一夜こそ、港の埠頭は戦争だった。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "後から半次「おかんむりや」と続いて去る。",
              "citation": {
                "source": "中村仲蔵",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、たうとう、黄金のかんむりをかぶりましたよ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あなたも、もうかんむりをかぶってるではありませんか。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たうとう、あなたも、かんむりをかぶりましたよ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその赤頭巾は、苔のかんむりでせう。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は、とうとう、黄金のかんむりをかぶりましたよ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "とうとう、あなたも、かんむりをかぶりましたよ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしその赤頭巾は、苔のかんむりでしょう。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中の一つだけをとって、女王さまのかんむりにつけても、きっと、りっぱなかざりになるでしょう。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある晩などは、もう何年も海の上に出てきたことのない、お年よりのおばあさまと、頭にかんむりをかぶった、人魚の王さまの姿までも、ずっと遠くのほうに見えました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "お城のいちばん高いところには、なつかしいおばあさまが頭に銀のかんむりをかぶって、立っていました。",
              "citation": {
                "source": "人魚の姫",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "死神は、頭に皇帝の金のかんむりをかぶって、片手に皇帝の金のつるぎを持ち、もういっぽうの手に皇帝の美しい旗を持っていました。",
              "citation": {
                "source": "ナイチンゲール",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、その皇帝のかんむりをください」　死神はナイチンゲールが歌をうたうたびに、宝物を一つずつ、わたしました。",
              "citation": {
                "source": "ナイチンゲール",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしは、陛下のかんむりよりも、お心のほうが好きなのでございます。",
              "citation": {
                "source": "ナイチンゲール",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "と申しましても、陛下のかんむりのまわりには、なにか、神々しいもののかおりが、ただよってはおりますが。",
              "citation": {
                "source": "ナイチンゲール",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い、きれいな髪の毛に、金のかんむりをかぶった、美しい少女が、ヨハンネスに手をさしのべました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀のかんむりをかぶった、きれいな大きいクモが、生垣から生垣へとわたり歩いて、長いつり橋をかけたり、御殿をつくったりしていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "おふたりは、頭に金のかんむりをかぶり、長いすそをうしろにひいて、それは美しい玉座に腰をおろしていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "お妃さまは、すぐにひざをついて、りっぱな金のかんむりを高くささげながら、「これをさしあげますから、どうか、わたしの夫と家来たちに、くすりをぬってやってくださいませ」と、たのみました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭にいただいている金のかんむりは、まるで、夜空にきらめく星のようでした。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "このお姫さまこそ、おとうさんが死んだ晩に見た、夢の中の、あの、金のかんむりをかぶった、美しい少女にそっくりです。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭には金のかんむりをいただいて、片手に、しゃくを持ち、もう一方の手には、金のたからの玉を持っていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "その玉座には、ひとりの年とった魔法使いが、みにくい頭にかんむりをかぶり、手には、しゃくを持って、すわっていました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "金のかんむりと、しゃくとは、ピカピカにみがいてあって、たいそうりっぱに見えました。",
              "citation": {
                "source": "旅の仲間",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭に、小さな金のかんむりをかぶっていました。",
              "citation": {
                "source": "イーダちゃんのお花",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "」というと、美和子は、子供のように、かんむりを振って、「大在りなの。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
