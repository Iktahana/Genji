        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大抵腹を立てるような事はあるまいと、純一の推測していた瀬戸が、一昨日谷中の借家へにこにこして来て、今夜｜亀清楼である同県人の忘年会に出ろと勧めたのである。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "両国の橋手前で電車を下りて、左へ曲って、柳橋を渡って、高山先生の跡に附いて亀清に這入った。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "土地は柳橋、家は亀清である。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "十八　純一は亀清の帰りに、両国橋の袂に立って、浜町の河岸を廻って来る電車を待ち受けて乗った。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "船宿は今は取り払われた河岸で、丁度｜亀清の向側になっていた。",
              "citation": {
                "source": "百物語",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々は紫色で亀甲型を一面に摺った亀清の団扇などが茶の間に放り出されるようになった。",
              "citation": {
                "source": "硝子戸の中",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳光亭も深川亭も亀清も皆な焼けた。",
              "citation": {
                "source": "地震の時",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ここは、水茶屋で、酒が無いゆえ、桜湯を」「け、けちなことを申されずに、ここを、こう参ると、亀清と申す割烹店が御座る。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほ、両国へきて、亀清を知らん仁でもあるまい。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "お歌、案内せい、案内、亀清へ」　士は、酔っていた。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "（連れ立って出たなら、亀清へ、無理矢理にも、この勢いなら、連れて行くであろうが、金が――あるか？",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とにかく、ここを出て――」　と、立上ると、一人が、袖を押えて「さあ、亀清へ――さあ、亀清へ、犬も歩けば、棒に当ると申して、当時、江戸第一の出世男――」　と、いって、往来へ、大声で「これが、相馬大作を召捕った、女狩右源太じゃ。",
              "citation": {
                "source": "三人の相馬大作",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕のまわりにいた客の中には亀清の桟敷が落ちたとか、中村楼の桟敷が落ちたとか、いろいろの噂が伝わりだした。",
              "citation": {
                "source": "追憶",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "お麻さんはいつもそれらの後始末ばかりしていたが、彼女は一中節の都の家元から一稲の名をもらっていたので、その名びろめを旦那が思いたった時は――彼女に対する日頃の謝意というより自分の道楽の方が勝ったであろうが、二日に渡った盛大な催しを柳橋の亀清楼で催した。",
              "citation": {
                "source": "お墓のすげかえ",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "芦に都鳥を描いた提灯は、さしもに広い亀清楼の楼上楼下にかけつらねられて、その灯入りの美しさ――岸につないだ家根船にまでおなじ飾りが水にゆれて流れた。",
              "citation": {
                "source": "お墓のすげかえ",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "百本｜杭の角で、駒止橋の前にあって、後には二洲楼とよばれ、さびれてしまったが、その当時は格式も高く、柳橋の亀清よりきこえていたのだ。",
              "citation": {
                "source": "明治座今昔",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "武者絵の元祖といってもいい人で、よく両国の万八――亀清楼のあるところ――に画会があると、連れていってくれたものだ。",
              "citation": {
                "source": "大門通り界隈一束",
                "author": "続旧聞日本橋・その一",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳橋の亀清が屋根一ぱいに電灯装飾をしてゐるのも不自然でなく、月もまた是等の水の街に適して新しい情調を漂はせてゐる。",
              "citation": {
                "source": "月二夜",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとオレがここと狙った三軒が全部、八百膳も、亀清も、八百松も、たいがいの日にタケノコを使ってらア。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで同じ向島の八百松も両国の亀清も調査には行かなかった。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二十　トンビ男",
                "note": "青空文庫"
              }
            },
            {
              "text": "万八、河長、梅川、亀清、柳屋、柏屋、青柏、大中村と、庇を連ねた酒楼でも、大川筋へ張り出した桟敷へ、柳橋芸者に綺麗を飾らせ、空の一発千両と豪華のほどを競い、争っている。",
              "citation": {
                "source": "圓朝花火",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "神田川の口元を出て、亀清楼の石垣の蔭から、大川の真ん中へ漕ぎ出した一艘の花見船がありました。",
              "citation": {
                "source": "幇間",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の「スバル」に載つた北原白秋君の詩、「夏の日の亀清に、歌沢の云々………」と云ふ文句にケチをつけたのも、たしかわれ／＼三人であつた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "われ／＼は、芝浜館から船を出して、木村が櫓を漕いで、お台場の方へ出かけて行つたその船の中で、「あの『亀清』と云ふのは変だ」と云ひ出した。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「亀清と云へば宴会屋だ、あんなところで歌沢の爪弾きを聴くなんて、練兵場の真ん中で植木鉢を眺めるやうなもんだ」と、とう／＼後藤が六号記事にその悪口を書いたので、「スバル」の方でそれが問題になつたりした。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、大川と神田川が合流する柳橋の龜清の石垣の下の静かな波の上に、白いものが浮いているのを見た。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまのみやこ鳥は荒川、隅田川、大川尻かけて柳橋の龜清の石垣にいるだけであるそうだ。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "浜町河岸の方へ、時々一、二羽ずつ遊びに行く姿を見たが、それも直ぐ龜清の石垣の下へ戻ってくるのである。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれど、みやこ鳥は龜清の石垣の下の波の上にばかりいるのではないそうだ。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三日前の夕、みやこ鳥がくる龜清の石垣の上の風雅な室で友人と二人で酒を酌んだ。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
