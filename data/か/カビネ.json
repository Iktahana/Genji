        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "Ｂ達は東京からの言伝を述べたり、託されて来た手紙と金とを其処に出したりして、アンナを喜ばせたが、その室の壁に接して十字架に並べてその Watanabe のカビネの写真像の置かれてあるのを眼にしたときには、彼等は思はず感激の声を立てた。",
              "citation": {
                "source": "アンナ、パブロオナ",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "第四十二　パンのカビネットプデン　は頗る上等の生菓子です。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カビネの一人撮しの軍服なるは乃舅片岡中将なり。",
              "citation": {
                "source": "不如帰　小説",
                "author": "徳冨蘆花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おや、これは、見たことのある顔だが」　その中から取出したカビネ型の一枚の写真に、花房一郎は目を見張りました。",
              "citation": {
                "source": "笑う悪魔",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
