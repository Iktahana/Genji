[
  {
    "uuid": "6c1a14e0-a113-5433-8806-cfe3cdc9a2cb",
    "entry": "勝ち味",
    "reading": {
      "primary": "かちみ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
