        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「では、カァター、敏捷にやつてくれ給へ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "カァター、危險はないつてことを保證してやつてくれ給へ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と今繃帶を解いたカァターは云つた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "御覽――カァターの方は、もう濟んぢまつた、もうぢき濟みさうなのだ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあ、カァター、チヨッキを着る手傳をしてやつてくれ給へ。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "この興奮劑は、私が羅馬で、ある伊太利の藪醫者――あなたなんぞは一｜蹴するでせうが――から貰つたものですよ、カァター。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カァター、そつちの肩を支へてやつて下さい。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は馬車の中に彼を助け乘せ、カァターがそれにつゞいた。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「彼の側の窓を開けておいて下さい、カァター。",
              "citation": {
                "source": "ジエィン・エア",
                "author": "ブロンテイ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
