        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カアキ色のズボンをはいて、開襟シャツ、三鷹の町を産業戦士のむれにまじって、少しも目立つ事もなく歩いている。",
              "citation": {
                "source": "作家の手帖",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアキ色の団服を着ていそがしげに群集を掻きわけて歩き廻っている老人を、つかまえて尋ねると、Ｔ君の部隊は、山門の前にちょっと立ち寄り、五分間休憩して、すぐにまた出発、という答えであった。",
              "citation": {
                "source": "東京八景",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのすぐ下の青い草の崖の上に、まさしく一人のカアキイ色の将校と大きな茶いろの馬の頭とが出て来ました。",
              "citation": {
                "source": "イギリス海岸",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアキイ色の一人の兵隊がいきなり向ふにあらはれて青い茂みの中にこゞむ。",
              "citation": {
                "source": "秋田街道",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花ざかりなるその広い原っぱの真中にカアキ色の新しい軍服を着た一人の兵隊が、朱い毛布を敷いて大の字のように寝ていた。",
              "citation": {
                "source": "兵隊の死",
                "author": "渡辺温",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアキイ色の軍服は初めて私の眼に映つた。",
              "citation": {
                "source": "突貫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "銀行家も大工も大学教授も肉屋も新聞記者も、パウルもチャアデンもカチンスキイも、みんなカアキ色と鉄製のヘルメットだ。",
              "citation": {
                "source": "戦雲を駆る女怪",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "青い合羽を着た女の子が一人、カアキ色の合羽を着た男の子が二人、ぽつんと電車の通るのを待つてゐた。",
              "citation": {
                "source": "子供たち",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "広い、道場のような工場の中には、赤い着物を着たひとだの、青い着物のひとだの、濃い縞の着物を着ているひとだのが、カアキ色のエプロンをして色々な作業についていました。",
              "citation": {
                "source": "新生の門",
                "author": "――栃木の女囚刑務所を訪ねて",
                "note": "青空文庫"
              }
            },
            {
              "text": "カアキイ色の服を着けた新兵はゾロゾロ窓の側を通った。",
              "citation": {
                "source": "芽生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "其処にはナポレオン帽を被つてカアキイ色の服を着けた英国の陸兵が五六人望遠鏡を手にして立番をして居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもその穴の一つには、坊主頭の若い男が、カアキイ色の袋から首だけ出して、棒を立てたように入れてあった。",
              "citation": {
                "source": "路上",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "それへまたどの家も同じようにカアキイ色の日除けを張り出していた。",
              "citation": {
                "source": "死後",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにはもうカアキイ服に、古めかしい襷をあやどった、各師団の兵が集まっている、――彼に声をかけたのも、そう云う連中の一人だった。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "この薄汚いカアキイ服に、銃剣を下げた兵卒の群は、ほとんど看客と呼ぶのさえも、皮肉な感じを起させるほど、みじめな看客に違いなかった。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――穂積中佐は憐むように、ほとんど大きな話声も立てない、カアキイ服の群を見渡した。",
              "citation": {
                "source": "将軍",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓の外には往来の向うに亜鉛屋根の古着屋が一軒、職工用の青服だのカアキ色のマントだのをぶら下げていた。",
              "citation": {
                "source": "保吉の手帳から",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "――カアキイ色に塗つた煙突。",
              "citation": {
                "source": "都会で",
                "author": "――或は千九百十六年の東京――",
                "note": "青空文庫"
              }
            },
            {
              "text": "佃は上着だけ背広を着、下にカアキ色の粗織襯衣と膝まである長靴を穿いていた。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　床屋の親方は風呂敷包を解いて、中から青年団式の雨外套と、カアキイ色の白線の入った兵隊式の帽子を取出し、いきなり仕立屋の頭へかぶせた。",
              "citation": {
                "source": "遺産",
                "author": "水上滝太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "エレヴエタアで艦の底から天上して中甲板の自分のケビンへ歸つて、カアキイ色の作業服を脱いだら、漸くもとの人間になつたやうな心もちがした。",
              "citation": {
                "source": "軍艦金剛航海記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "陽に褪せて白っぽくなったカアキイいろだった。",
              "citation": {
                "source": "踊る地平線",
                "author": "海のモザイク",
                "note": "青空文庫"
              }
            },
            {
              "text": "「奉天まで」　ゆるいカアキイ色の起伏。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "円陣を作つた若者が、怪しげな手ぶり足つきで単調なリズムを繰り返し、浴衣がけの頬かぶりが、カアキーズボンとナイトキヤツプの間で、自慢の声を張り上げてゐる。",
              "citation": {
                "source": "ある村の素人劇団",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の眼鏡には、カアキ色の軍服を着た兵隊さんが、足なみそろへて進軍してゐるところが見えました。",
              "citation": {
                "source": "のぞき眼鏡",
                "author": "土田耕平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
