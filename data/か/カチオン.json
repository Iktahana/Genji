        "examples": {
          "standard": [
            {
              "text": "この化学反応では塩化物のカチオンが放出される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "溶液中のカチオン濃度を測定するため電気分析を行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "カチオンとアニオンのイオンペアの相互作用が重要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは「電気の実験研究」の第七篇になっているが、まずファラデーは電池の電極を、単に電流の入り口と出口に過ぎないからとて、アノード（昇り道）およびカソード（降り道）という名称をつけ、また液体内で分解している物に、アニオン（昇り行く物）およびカチオン（降り行く物）という名前をつけた。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            },
            {
              "text": "後の三つはカチオンである。",
              "citation": {
                "source": "ファラデーの伝",
                "author": "電気学の泰斗",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
