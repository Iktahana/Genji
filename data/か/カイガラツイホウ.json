        "examples": {
          "standard": [
            {
              "text": "古代アテネの貝殻追放制度では、市民の投票によって政治的脅威とみなされた人物が十年間追放された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "テミストクレスもかつて貝殻追放によってアテネから追われた一人だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "歴史の授業で貝殻追放の仕組みを学び、民主主義の逆説的な側面に興味を持った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "」「貝殻追放」の作者はあたまで諾かなかつた。",
              "citation": {
                "source": "角力",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正に「貝殻追放」である。",
              "citation": {
                "source": "青べか日記",
                "author": "――吾が生活　し・さ",
                "note": "青空文庫"
              }
            },
            {
              "text": "貝殻追放＊や木葉追放はその証拠である。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
