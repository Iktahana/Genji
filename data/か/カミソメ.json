        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "真夏の事でね……五十｜面をてらてら磨いて、薄い毛を白髪染さ、油と香水で真中からきちんと分けて、――汗ばむから帽子を被りません――化粧でもしたらしい、白赤く脂ぎった大面の頤を突出して、仰向けに薄目を開けた、広い額がてらてらして、べっとりと、眉毛に墨を入れたのが、よく見える。",
              "citation": {
                "source": "卵塔場の天女",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "涙垂らすな、お勘婆、やれ、汝も尻拭け、お時婆、慾ばれ、気ばれ、白髪染塗れ、お熊婆。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、あのお齢になってさえも、相変らず白髪染めだけは止めようとはなさいません。",
              "citation": {
                "source": "白蟻",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番目は中村宗十郎が大阪から上って来て、彼が得意の「有職鎌倉山」を出し、中幕は団十郎の「白髪染の実盛」と「船弁慶」であったが、一番目ではやはり左団次の三浦荒次郎がわたしの眼についた。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかにも瑞鳥でわが徳を感じて天が祥瑞を下したと悦び、餌を与うるも食わず、吐息ついて死んだから吟味すると、何か法螺を吹き損わせて笑いやらんと巧んで、白髪染剤で常の雀を染めその毒に中っておとなしく沈みいたと判った。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "白髪染の薬瓶と竹の歯ブラシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "フフン――　槇子は、白髪染で染たらしい黒すぎる部長の髪を、睫毛の先きで軽蔑した。",
              "citation": {
                "source": "罠を跳び越える女",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "近代的｜懐疑とか、近代的盗賊とか、近代的｜白髪染めとか――そう云うものは確かに存在するでしょう。",
              "citation": {
                "source": "或恋愛小説",
                "author": "――或は「恋愛は至上なり」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "由美子のは、腋臭めいた臭気がするし、八重子のは白髪染めの臭気がする。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "白髪染めの八重子の髪の臭いが、気のせいか鼻についてきた。",
              "citation": {
                "source": "怒りの虫",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "白髪染めをやめたせいか、頭髪に白いのが目立ち、腰が曲ってきたせいか、背丈が縮んだようでした。",
              "citation": {
                "source": "落雷のあと",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワタクシは元来理髪師でございまして、なかんずく、得意といたしますところは白髪染めでございます。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "扨あくる日は岡野の宿を経、当麻の寺の鐘のこえを聞いて、転寝の夢の浮世を出でゝ行く　　　身の入相の鐘とこそ聞けかくて高野山に到着、青巌寺を仮の住まいと定め、剃髪染衣の身となって道意禅門と号したが、お供の人々も皆これに倣うて髻を切った。",
              "citation": {
                "source": "聞書抄",
                "author": "第二盲目物語",
                "note": "青空文庫"
              }
            },
            {
              "text": "余裕綽々でしたな」「ははあ、あなたもあの際に白髪染を怠らなかったとは、承わって敬服します。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏の発明した白髪染めも同じことです。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "烏羽玉の黒烏が何を苦んで白髪染を発明しましょうか？",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本画壇の斎藤別当尾形月耕翁白髪染めの証人　風俗画で一流を成した尾形月耕画伯、諸事｜恬淡の江戸ッ子気性ながら、その作品に対しては老いてますます熱を加えた。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "御陵山は白髮染の媼さんのやうに、赤ちやけた山の素肌に、黒ずんだ松の樹がばらばらに散らばつて見える。",
              "citation": {
                "source": "旋風",
                "author": "薄田泣菫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
