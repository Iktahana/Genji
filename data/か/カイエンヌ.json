        "examples": {
          "standard": [
            {
              "text": "フランス領ギアナの州都カイエンヌは、熱帯雨林に囲まれた港町だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "旅行誌でカイエンヌの旧市街の写真を見て、色鮮やかなクレオール建築に目を奪われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "カイエンヌからジャングルツアーに参加し、アマゾンの生態系を間近で観察した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "妻は不満の程度を探ろうと、夫がカイエンヌ香辛料を回してくれと言ったついでに、聞いてみたが、失敗だった。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
