        "examples": {
          "standard": [
            {
              "text": "日本周辺の海区は複数の国による資源争奪の対象となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この海区での漁業権について国際協議が開かれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "太平洋の海区分けは国連海洋法条約に基づいている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
