    "definitions": [
      {
        "index": 1,
        "gloss": "turning point",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あの出来事を境に、彼の人生は大きく変わり目となった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この技術革新は、産業界にとってまさに変わり目だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "長年の悩みが解決し、ようやく人生の変わり目を迎えることができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "従って風の変わり目の無風が著しく現われるのである。",
              "citation": {
                "source": "海陸風と夕なぎ",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十世紀への変わり目を前後して、放射能を手がかりに、物理学者は物の成り立ちの基本に迫りはじめた。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜が明け離れると海風と陸風との変わり目が来て、さすがに荒れがちな北国の冬の海の上もしばらくは穏やかになる。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夏から秋、秋から冬の変わり目はとかく病人の身体にようないものじゃ。",
              "citation": {
                "source": "玉藻の前",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄弟たちは季の変わり目で皆御所へまいるのであったが、少将一人はめいりこんで物思いを続けているのを、母の夫人は涙ぐんで見ていた。",
              "citation": {
                "source": "源氏物語",
                "author": "竹河",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後もサイバネット工業は月産三〇万台体制を維持して快進撃を続けていったが、パーソナルコンピューター元年となる翌一九七七年への年の変わり目を前後する時期から、需要は急成長を裏返したように急激にしぼみはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "今は時代の変わり目でしょう。",
              "citation": {
                "source": "蕎麦の味と食い方問題",
                "author": "村井政善",
                "note": "青空文庫"
              }
            },
            {
              "text": "世の中の変わり目には、人の心も動揺しましょうからね。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ19世紀から20世紀の変わり目における大臨床家の考え方を示したものと思っている。",
              "citation": {
                "source": "簡約医学史",
                "author": "A Concise History of Medicine",
                "note": "青空文庫"
              }
            },
            {
              "text": "計算すると、六時間が変わり目にあたります。",
              "citation": {
                "source": "処刑の話",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう潮の変わり目だから、じきに、岩棚の上に築かれた新しい橋脚の土台が水面に現われる。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "世紀の変わり目における弟子のうちでもっとも勤勉であったのは若いイギリス人のハーヴィであった。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファン・スウィーテンの努力によって作られた古いウィーン学派は世紀の変わり目に衰えた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "これからは時代の大きな変わり目だから、なにかと大変なのだと、いつも言ってるわ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど、お孝が銚子のかわりめに立った時だったのです。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "季節のかわりめには、もの皆があたらしく見えて、こいしく思われ、つい、好きだ好きだ、なんて騒ぎ出す始末になるのだ。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソヴェトでは、十月が経済年度のかわりめだ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かわりめ毎に覗き覗きした芝居も、成田屋や五代目がなくなってからは、行く張合がなくなったのであろう。",
              "citation": {
                "source": "老年",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁度、伸子がモスク※へ帰って来る前、ソヴェト経済年度のかわりめである十月一日から新しいシステムが採用されることになった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時にはお前も、芝居の変り目ごとに駕籠で出掛けるさ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「それはたぶん、女神が季節の変り目で、夏の化粧をされてるからだろう。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "上町に住んでいた私は、常盤座の番組の変り目の日が来ると、そわそわと源聖寺坂を降りて、西横堀川に架った末広橋を渡り、黒門市場を抜けて千日前へかけつけると、まず「千日堂」で二銭の紫蘇入りの飴を買うてから常盤座へはいるのだった。",
              "citation": {
                "source": "神経",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "夭死と云う事が、何だか一種の美しい事のような心持がしたし、またその時考えていた死と云うものは、有が無になるような大事件ではなく、ただ花が散ってその代りに若葉の出るようなほんのちょっとした変り目で、人が死んでも心はそこらの野の花になって咲いているような事を考えていた。",
              "citation": {
                "source": "枯菊の影",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "いつかの時の怪我でねえ、まだ時々、時候の変り目に悩みますから、梅雨時分、あのお医師様にお世話になったの、……私のね、今隠れている百姓屋へ来て貰って……　立さんが、先刻葬式にいらしった、この沼の白骨も、その時私の許で聞いて、あの方がここへ来て拾って行ったんです。",
              "citation": {
                "source": "沼夫人",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "歯痛は時候の変り目などに、時々彼を悩ませた。",
              "citation": {
                "source": "歯痛",
                "author": "徳田秋聲",
                "note": "青空文庫"
              }
            },
            {
              "text": "別に健康が悪いというのでもなさそうだが、気候の変り目はあの病気にやはりよくないのだろうね」　そういって園は静かに人見を見上げたが、その眼は人見を見ているというよりも、遠い千歳の方を見すかしているように見えた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてその好きな所が、時候の変り目や、天気都合でいろいろに変化する。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ御ゆっくりお休み下さい」　女房の云う通り、秋と冬との変り目の十月にはいって、朝夕は急に寒くなった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "青山の仇討",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからも、私は狂言の変り目毎に、三四度は欠かさずに、見物していました。",
              "citation": {
                "source": "ある恋の話",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでこの相違は、ざらざらになった破片だけが完全に呑みこまれたものであり、その他のものは潮時を大分遅れて渦巻に入ったか、あるいはなにかの理由で入ってからゆっくりと降りたために、底にまで達しないうちに満潮あるいは干潮の変り目が来てしまったのだ、と思うよりほかに説明ができませんでした。",
              "citation": {
                "source": "メールストロムの旋渦",
                "author": "A DESCENT INTO THE MAELSTROM",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
