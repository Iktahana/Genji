        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「主はだれ、むらさきの覆面二十三騎くつわをならべて……タララララタ、タララララタ、プカプカプカララララララ」「うまいぞうまいぞ」と一同が喝采した。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "三芳　だってそんなわけにゃ行かんじゃないか、叔母さんの手前――（ウィスキィをカプカプ飲む）大野　そうそう色気で思い出したが、こいつ（とトンコの頭を撫で）も、おしいことをしましたねえ。",
              "citation": {
                "source": "猿の図",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私あ、もう――源次　だってお前、さっきまでさされた酒はいくらでもカプカプ飲んでたじゃねえか。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
