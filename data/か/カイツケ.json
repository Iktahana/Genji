          "standard": [
            {
              "text": "彼はいつもの買い付けに出かけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その八百屋は彼の定番の買い付け先だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "長年通っている買い付けの店で値引きしてくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
