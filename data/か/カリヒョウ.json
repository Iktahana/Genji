        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "軸は、仮表装の北斗七星の四文字である。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の本は大抵仮表紙で、クロースの本などは一冊もない。",
              "citation": {
                "source": "装釘に就て",
                "author": "『春』と『家』及び其他",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは般若心経かなにかを書いた残欠本の仮表装でありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "不破の関の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "福羽氏のは仮表具で、私が伺った時に書いて下すったままでした。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "質素極まる仮表装で、一点の飾もない白と黒とが、まるで何かの喪に籠っているように思われる。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "北村透谷の『蓬莱曲』がその頃出た新刊書の一つである仮表装の素朴な本であることはすでに述べた。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――といふやうなことが、あの黄色い假表紙の本の初めの方にあつたと思ふ。",
              "citation": {
                "source": "父の婚禮",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
