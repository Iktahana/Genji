[
  {
    "uuid": "07f962d7-6eb7-51e2-91db-60c5730af61a",
    "entry": "限りない",
    "reading": {
      "primary": "かぎりない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容詞"
