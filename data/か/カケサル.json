    "definitions": [
      {
        "index": 1,
        "gloss": "to dart away",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "子供は母親の呼びかけも聞かず、公園の奥へと駆け去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "急に何かに驚いたのか、ウサギは一瞬で茂みの中へ駆け去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "パトカーのサイレンを聞いて、怪しい車が猛スピードで駆け去った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「待って！」と叫んだが、彼はもう人混みの中へ駆け去ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "急ごうぜ」　早口にささやきながら、駆け去るように出ていったのを、ぴかりと目を光らして見送ると、さえた声が間をおかずに伝六のところへ飛びました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "（藤作、駆け去る）おきん　（狼狽しながら）どうしよう。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "（甚作飛ぶように駆け去る）茂兵衛　甚兵衛どの、こっちへござっしゃれ。",
              "citation": {
                "source": "義民甚兵衛",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供が角笛を吹いて、北へ北へと、おおかみの群れとともに駆け去る頭の上の空には、黒雲がわいて、雷がとどろいていたのであります。",
              "citation": {
                "source": "角笛吹く子",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "（駆け去る）安兵衛　さあ行こう。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "（駆け去る）時次郎　（物蔭に一時隠れる。",
              "citation": {
                "source": "沓掛時次郎　三幕十場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叫ぶ声と、人々が待避に駆け去る足音）男４　……ふう、……き、き、来ましたねえ！",
              "citation": {
                "source": "その人を知らず",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "毬のように身を縮め、七八間さきの横丁へいっさんに駆け去るのが見えたきりだった。",
              "citation": {
                "source": "新潮記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五機を数える時から例のガラガラとガードの上を貨物列車が駆け去る時のような焼夷弾の落下音が鳴り始めたが、伊沢の頭上を通り越して、後方の工場地帯へ集中されているらしい。",
              "citation": {
                "source": "白痴",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "伴六はなお、自分はこれから土田と唐沢へまわるが、刻限が迫っているからすぐ起こしてくれるようにと云い、門の外へ出ていったと思うと、（そこに繋いでおいたのだろう）馬に乗って駆け去るのが聞えた。",
              "citation": {
                "source": "四日のあやめ",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（吉蔵かけさる）喜蔵　飯ができるまで、ゆっくり休めるというもんだ。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "今こちらから見ると、空のそのほの明るさが、下に隠れた父の胸から揺れのぼって来るようで、月の出るのが待ちどおしかったが、仲人の東野の周囲で起っている崩れ傾くひびきを思うと、婚姻の夜を迎えようとしている矢代には、それも、ひと鞭あてて駈け去る日ごろの東野の厳しさに似て見えて、しんと胸にあたる痛さだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "泣いて取りすがる合爾合姫を振り解いて、札木合は決然と露台から奥へ駈け去る。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "看視兵ら、声に応じて将校とともに、露台上手へ駈け去る。",
              "citation": {
                "source": "若き日の成吉思汗",
                "author": "――市川猿之助氏のために――",
                "note": "青空文庫"
              }
            },
            {
              "text": "屋蓋つきの荷馬車が、鞭で打たれるドンキーに挽かれて、後から後から凄じい勢で駈け去る車道の明るさと相反して、強い暗がりが、拱廊の奥を領している。",
              "citation": {
                "source": "南路",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、露台をあわただしく動く人の姿も、ここでもかしこでもどこでも長靴を穿いてどかどか歩き※ることも、急いで馬の鞍に跨って駈け去ることも、確かに、いつもあることではなかった。",
              "citation": {
                "source": "二都物語",
                "author": "上巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせこの連中の蟇口の中のお金にはみんなそれぞれ脚が生えて我先にとびだし駈け去るシクミだから、まことに天下はまゝならぬ。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び大音響を耳にしたとき、和尚の法衣は天に向つて駈け去るが如く、裾は高々と空間に張りひろがり、人々の足は自然に踏む土を失つて、再び宙に浮いてゐた。",
              "citation": {
                "source": "閑山",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "気どり屋の通人さんに、礼儀知らずの剣術使いでしょう」「ほかに古田さんという巡査がおります」「じゃア、四頭ね」　と云ったと思うと、馬にのって駈け去る。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その二　密室大犯罪",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのくせこの連中の蟇口の中のお金にはみんなそれぞれ脚が生えて我先にとびだし駈け去るシクミだから、まことに天下はままならぬ。",
              "citation": {
                "source": "オモチャ箱",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "再び大音響を耳にしたとき、和尚の法衣は天に向って駈け去るが如く、裾は高々と空間に張りひろがり、人々の足は自然に踏む土を失って、再び宙に浮いていた。",
              "citation": {
                "source": "閑山",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "次に、三番貝は、城外に総揃いの合図ぞと、表方へ触れておけ」「はいッ」　市松が駈け去ると、また直ちに、「彦右衛門を呼んで来い」　と、べつの小姓を走らせ、その蜂須賀彦右衛門の姿もまだ見えないうちに、さらに、ほかの小姓たちを派して、姫路城の金奉行、蔵奉行などを、みなここへと、呼びにやった。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "程なくお着き」　と、飾磨方面の並木道から、辻の木戸へ、路傍の警固へむかって、合図して駈け去ると、大手の夜空は一きわ明々と篝を熾にし出し、町の沿道は、急に、凍てついたようにひそまり返っていた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第九分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "騒いでいた男の子の一ト組が駈け去ると、こんどは女童の組だけで鞠をつき、鞠つき唄をうたっていた。",
              "citation": {
                "source": "私本太平記",
                "author": "筑紫帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "――義助をはじめ、堀口、大館、江口、世良田、居あわす者はみな寄れと申せ」「はっ」　瓜生保が駈け去る。",
              "citation": {
                "source": "私本太平記",
                "author": "湊川帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "（女の子裏口からかけ去る）三男　　（弱く）かあちゃん……よし坊とね、鳥もいっしょにとんでくの。",
              "citation": {
                "source": "病む子の祭",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
