        "examples": {
          "standard": [
            {
              "text": "東南アジアでは川蛇を食材として利用する地域が今でも多い。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "川蛇はウナギに似た外見をしているが、分類上はまったく異なる生物だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "水田の排水路で川蛇が発見され、作業中の農家が驚いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "色白く腹薄青く、人の肛門より入りて臓腑を啖い、歯を砕きて口より出づ、北国殊に多し、越後にて川蛇、出羽にてトンヘビなどいえるものこれなり（熊楠故老に聞く、トンとは非道交会の義）と云々。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "その濁流を時たま、川蛇が白い歯型をきざんで渡つては消えた。",
              "citation": {
                "source": "少年",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
