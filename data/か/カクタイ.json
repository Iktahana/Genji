[
  {
    "uuid": "e852f6e2-8fca-5d62-ab98-f8cba9482927",
    "entry": "各隊",
    "reading": {
      "primary": "かくたい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
