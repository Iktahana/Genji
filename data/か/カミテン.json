  {
    "uuid": "b9ae5703-7d24-5726-8b51-7d86cf522958",
    "entry": "髪天",
    "reading": {
      "primary": "かみてん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
