        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "庭師がハサミ一本で、伸び放題だった生垣をきれいな直角に刈りそろえた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「うーん、右側だけ少し長いかな。もうちょっとだけ全体を刈りそろえてくれる？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "羊の毛をバリカンで一定の長さに刈りそろえるのは、意外と重労働で腰に来る。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "伸びきった芝生を週末に電動バリカンで刈りそろえると、庭が見違えるほど明るくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
