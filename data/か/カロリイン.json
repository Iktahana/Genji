          "literary": [
            {
              "text": "恐らく白痴であろうと下宿の食堂に集る人達は噂し合って、誰が命けるともなく「カロリイン夫人」という名を命けていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カロリイン夫人」は紅い薔薇の花のついた帽子を冠り、白の手套をはめ、朝から晩までその界隈を往ったり来たりしていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さんで『カロリイン夫人』だなんて綽名をつけた婦人が有りましたろう。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            }
          ]
        }
