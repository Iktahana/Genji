  {
    "uuid": "3653c5bb-9eaa-5cf4-a775-35a3b1c53587",
    "entry": "歌数",
    "reading": {
      "primary": "かすう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
