  {
    "uuid": "7954c9d7-685d-567f-839e-8bc44a586aeb",
    "entry": "価数",
    "reading": {
      "primary": "かすう",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "valence",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「実験で使う酸の価数を間違えると、中和滴定の結果がめちゃくちゃになっちゃう。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "塩素は価数が1で、ナトリウムと1対1の割合で結合する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "この元素の価数を確認してから化合物の化学式を組み立てなさいと先生に言われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "原稿かいて、雑誌社へ持って行っても、みんな、芥川賞もらってからのほうが、市価数倍せむことを胸算して、二ヶ月、三ヶ月、日和見、そのうちに芥川賞｜素通して、拙稿返送という憂目、再三ならずございました。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し支配人は兎に角宝石に間違のなかったのを喜んで、騒ぎ立てる社員を一先ず制して、自分の部屋に帰り、念の為再び金庫を開いて調べてみると、支配人が大急ぎで金庫に投げ入れた宝石の一つ、時価数万円のダイヤモンドが一｜顆不足していた。",
              "citation": {
                "source": "琥珀のパイプ",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかに第二のホ長調の協奏曲にはＨ・Ｍ・Ｖの旧盤にティボーの名演奏があり、市価数百金と称せられ、複協奏曲にはビクターの旧盤にクライスラーとジンバリストの組合せによる名盤がある。",
              "citation": {
                "source": "楽聖物語",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかすう／＼風が來るい。",
              "citation": {
                "source": "胡瓜の種",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
