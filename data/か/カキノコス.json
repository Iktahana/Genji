[
  {
    "uuid": "5e52fa77-621f-54db-abdb-5a1c37570a4c",
    "entry": "書き残す",
    "reading": {
      "primary": "かきのこす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
