      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to leave (a note, will, etc.) behind",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「ここに置いておくからね」と、夕食のメニューを書いたメモをテーブルに書き残して外出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "歴史家たちは、当時の混乱した社会状況を日記や書簡に克明に書き残している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旅立つ前に、これまで育ててくれた両親への感謝の気持ちを手紙に書き残した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "まあ、あまり大きい慾を起さず、せめて一面の真実だけでも書き残す事が出来たら満足という気持で書く事にしよう。",
              "citation": {
                "source": "惜別",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも私は一つの心理学的研究として、このニコラス・クレーグ船長の記録を書き残すつもりである。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "北極星号の船長　医学生ジョン・マリスターレーの奇異なる日記よりの抜萃",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この機会を逃せば、あの時に起こったことを書き残すチャンスは二度と訪れないだろう」　あたたかくてねばり強い支えの手に抱かれながら、勝手にも私はただ、そんなふうに感じていたのだと思います。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの場合、書置きというたぐいのものは、この世に未練のある者が亡き後をかんがえて愚痴を書き残すか、あるいはこの世に罪のある者が詫び状がわりに書いて行くのであるが、二人はこの世に未練はなかった。",
              "citation": {
                "source": "箕輪心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "もし妻と死別れたら、一年間だけ生き残ろう、悲しい美しい一冊の詩集を書き残すために……と突飛な烈しい念想がその時胸のなかに浮上ってたぎったのだった。",
              "citation": {
                "source": "遥かな旅",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "何故といつて、この世の中には、帝王の事だつたら、どんな些細な事でも、きつと記録に書き残す歴史家といふ筆まめな輩が住んでゐるから。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "その心理で、今回もまた自分はこれを書き残すのだ。",
              "citation": {
                "source": "鼻に基く殺人",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私が若し昨日今日のうちに自殺するとしたならば、そして遺書を書き残すとしたならば、こんな文句があるだらう。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "――書こうと思うことは、自分の事ばかりでなく、他人の事にも関係するので、心の中で思っているのはまだしも、物にまで書き残すのはどんなものかと、私はいくたびもためらったが、やはり書いて見ようという気になって、ここに筆を続ける。",
              "citation": {
                "source": "御萩と七種粥",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ君のその話を、私は今迄誰にも語らなかったが、ふと文字に書き残す気になったのである。",
              "citation": {
                "source": "鯉",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜつて、小説は理解されて然るべきものであるよりも、作者としては愛読がまづ望ましいことなのですし、僕の場合にしてからが、僕の小説を理解してもらうために、僕の伝記や性質調査書のやうなものを別に書き残す必要があるとは考へることができにくいからです。",
              "citation": {
                "source": "かげろふ談義",
                "author": "――菱山修三へ――",
                "note": "青空文庫"
              }
            },
            {
              "text": "不遇の生を終へた愛護は、怨み言を書き残すだけの執念もありながら、現に転生した。",
              "citation": {
                "source": "愛護若",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしその男が私の生活の行路を横切らなかったならば、おそらくこういう長いものをあなたに書き残す必要も起らなかったでしょう。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が死のうと決心してから、もう十日以上になりますが、その大部分はあなたにこの長い自叙伝の一節を書き残すために使用されたものと思って下さい。",
              "citation": {
                "source": "こころ",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔の人は科学知識はもっていなかったがかえってこれが幸いして、自分の観察した現象を、生かじりの知識で否定し去るようなことはなく、ありのままに書き残すことが出来たのである。",
              "citation": {
                "source": "地震なまず",
                "author": "武者金吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで、「蒐集の弁」を一応は書き残すこととしたい。",
              "citation": {
                "source": "民藝四十年",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうでなければ妹のソフィアが余暇のことをそんなに日記に書き残すはずがない。",
              "citation": {
                "source": "長い部屋",
                "author": "O. H. ダンバー　O. H. Dunbar",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして全てを書き残すよう駆り立てられた。",
              "citation": {
                "source": "時間からの影",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "或はこの世に罪あるものが、詫状代りに書きのこすか、二つにひとつ。",
              "citation": {
                "source": "箕輪の心中",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "今や世界のトルストイが晩年に至って書きのこす日記の一冊、一枚のメモ、それは出版経営者としてのソフィヤ夫人が洩すところなく「私の出版」に収録しようと欲するところであり、而も、トルストイの親友と称する連中も亦「未発表」の何ものかを獲ようととびめぐっている。",
              "citation": {
                "source": "ジャンの物語",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "またべつに、ざっとした遺書一本書きのこすやいな、さっとそとへ飛び出しかけた。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてを書き遺すにしてはあまりにこの思が多過ぎる……　さらば愛も、憎も、惱も、苦もよ、今暫くが間であらうほどに、私の胸が張り裂けるまでは、お前達の棲所として、私はこの心臓を提供する。",
              "citation": {
                "source": "響",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "書き遺すほどのものならば、書いて書いて書きぬきたい、けれどもそれにしては、彼女の息はそれに伴ひ續かなかつた。",
              "citation": {
                "source": "響",
                "author": "水野仙子",
                "note": "青空文庫"
              }
            },
            {
              "text": "改めて書き遺すこと丈草性くるしみ学ぶ事を好まず、感ありて吟じ、人ありて談じ、常はこの事打わすれたる如し。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分で自慢して書き遺す程の生活も思想も持たなかつたし、子孫を導く程のそれも持つてるとは自信出来ないし、自分の生涯に於ての人世に対する感想のやうなものも大概誰かゞいつて呉れてるものの中に入るだらうし――　まあ身の廻りの捌きに就て家族に少し説明して置けば一人前の責任は済むと思ふ。",
              "citation": {
                "source": "非凡人と凡人の遺書",
                "author": "岡本一平",
                "note": "青空文庫"
              }
            },
            {
              "text": "自殺をする奴等は、きっとこんな風に坐って、最後の願望を書き遺すにちがいない。",
              "citation": {
                "source": "ピストルの蠱惑",
                "author": "モーリス・ルヴェル　Maurice Level",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さあ、お前、書き遺すことはないか」「はい、実家へ宛て、一筆」「落着いて、見苦しからぬようにな」「はい」　矢立をパチンとあけて、紙をスラスラと展げる、その音まで鮮やかに響いて来るのです。",
              "citation": {
                "source": "大菩薩峠",
                "author": "壬生と島原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから何十年をいわば美食生活を寸断されることなく続けて今日に至っているが、困ったことには、自分の食歴を書き遺すなどいう考えあって食道楽を続けたわけではないから、もとより記録のあろうはずもなく、記憶もあやしいのである。",
              "citation": {
                "source": "私の料理ばなし",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "書こうとする意気をもつ、これを書き遺すことによって、自分は犬死をまぬがれる、隠密生涯の墓石が立つ、武士の本分をつくし得る。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "剣山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、愛する同胞が過去幾千年の間に残しつたへた、文芸を書残すことです。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
