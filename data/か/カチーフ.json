        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "』と言つて、紅のハンカチーフに笑顏を蔽ふた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫻木大佐等は一齊にハンカチーフを振つた。",
              "citation": {
                "source": "海島冐檢奇譚　海底軍艦",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「何をする」と呶鳴り付けると、「日が射して困る」と、ハンカチーフなんかで鼻の頭を撫でている。",
              "citation": {
                "source": "本州横断　癇癪徒歩旅行",
                "author": "押川春浪",
                "note": "青空文庫"
              }
            },
            {
              "text": "日射しをよけるための真赤なネッカチーフで、頭を包んだ二人の女が、その女の前でジープを停めて、話し掛けていた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤いネッカチーフを巻いた頭がふり向いて、秋の日射しの中に振られている血色のよい手が見えなくなるまで、陽子も手を振っていたが、おずおずとした振り方しか陽子は出来なかった。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "牛乳を持って来て」　小間使は、古ぼけた黄色い服に、色のさめたネッカチーフを首に巻いて、牛乳の小皿を手に入ってくると、その皿を子猫の前に置いた。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫らく有ッて文三は、はふり落ちる涙の雨をハンカチーフで拭止めた……がさて拭ッても取れないのは沸返える胸のムシャクシャ、熟々と思廻らせば廻らすほど、悔しくも又｜口惜しくなる。",
              "citation": {
                "source": "浮雲",
                "author": "二葉亭四迷",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中の一人は、我々の依頼者の若い美しい女性で、口にはハンカチーフを巻きつけられ、全く気絶したように、正体もなく崩れ跼まっていた。",
              "citation": {
                "source": "自転車嬢の危難",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「姉が夢中に叫んだうわ言かとも思い、またそれは敷地にいるロマのことではないかとも思い……多くの者が頭に水玉の模様があるハンカチーフを巻いておりますが、それが姉の使った言葉に関係があるのかは、ちょっと。",
              "citation": {
                "source": "まだらのひも",
                "author": "THE ADVENTURE OF THE SPECKLED BAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし俺はしつかり切り取つた肉片を、ハンカチーフに包んだ。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "家へ這入るとすつかり戸締りをしてさてハンカチーフから肉を取り出した。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "がどんな方法で食物を引つ張つて来ようか、まづ麻酔薬とハンカチーフをポケツトに用意した。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "己れはそつとポケツトから麻酔薬の瓶を出してハンカチーフに当てた。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンカチーフは浸された。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "いきなり抱き付いてその鼻にハンカチーフを押し当てた。",
              "citation": {
                "source": "悪魔の舌",
                "author": "村山槐多",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからこまごまとととのえたものには洋杖蝙蝠傘、藤いろ革の紙幣入、銀鎖製の蟇口、毛糸の腹巻、魔法罎、白の運動帽、二、三のネクタイ、艾いろの柔かなズボン吊、鼠いろのバンド、独逸製のケースにはいった五、六種の薬剤、爽かな麦稈帽、ソフトカラアにハンカチーフに絹の靴下。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハタハタと白い扇子やハンカチーフが群蝶のように舞い出した。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "おおい、おおいと、汽車の窓に乗り出して、一人が麦藁帽を振ると、　おおい、おおいと、また一人が麦藁帽を振ると、　おおい、おおいと、また一人が白扇を振ると、　おおい、おおいと、またまた一人がハンカチーフを振ると、　おおい、おおいと、あ、向うで何か振った、振った、振った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は麻のハンカチーフを買った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彩雲閣の二階からは盛んに白いハンカチーフがゆれて光る。",
              "citation": {
                "source": "木曾川",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は左手にハンカチーフを持って、人力車の蒲団にもたれながら失神したようになっていた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてまたお友達になりましょう」　人力車の幌がうしろへ落ちると、わたしが夜になると怖がるくせに毎日考えていた死そのもののように、その内にはケイス・ウェッシントン夫人がハンカチーフを片手に持って、金髪の頭を胸のところまで垂れて坐っていた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はわたしが生前に見た着物を着て、右の手にいつもの小さいハンカチーフを持ち、左の手にやはりいつもの名刺入れを持っていた。",
              "citation": {
                "source": "世界怪談名作集",
                "author": "幻の人力車",
                "note": "青空文庫"
              }
            },
            {
              "text": "その通りにしてハンカチーフで拭き取ると、なるほど綺麗に消えてしまいました。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女は嬉しそうに微笑みながら、これも頻りにハンカチーフを振る。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　こう言い終って、星崎さんはハンカチーフで口のまわりを拭きながら、床の間の大きいがまを見かえった。",
              "citation": {
                "source": "青蛙堂鬼談",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　入口の土間に落ちていたといって、お島さんは新しいハンカチーフをひろって来て見せた。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ハンカチーフを僕の手に押し付けて、お島さんは内へ引っ込んでしまった。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　僕はそのハンカチーフをたもとへ押し込んで、町から海岸の方へ出ると、水沢のうしろ姿は一町ほど先きに見えた。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は一種の好奇心に誘われたのと、もう一つにはお島さんから頼まれたハンカチーフの使いを果たさなければならないと思ったので、足音のしないように砂浜を伝って、その松の立っている方へそろそろと歩いて行った。",
              "citation": {
                "source": "探偵夜話",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
