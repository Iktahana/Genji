        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何だかカラハンあたりから直伝のような響もあるように思われる。",
              "citation": {
                "source": "街頭から見た新東京の裏面",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋ニハ電気ガツイテ居マスカラハッキリワカリマス。",
              "citation": {
                "source": "夢の殺人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチャルスキー、カーメネワ夫人、カラハン、前田多門、大使など。",
              "citation": {
                "source": "日記",
                "author": "一九二八年（昭和三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ね、カラハンが来たときね、日本側の代表でいろいろやったの、藤堂駿平だった？",
              "citation": {
                "source": "二つの庭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「停車場に於けるアマヌル・ハンとタワーリシチ、カリーニン、ヴォロシロフ、カラハン」「自動車上のカリーニンとアフガニスタンのパジシャフ。",
              "citation": {
                "source": "モスクワ印象記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "千八百四十九年には、カラハリの大沙漠を探りました。",
              "citation": {
                "source": "アフリカのスタンレー",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラハンみたいな大男が鼻眼鏡をかけ直して写真と私を見くらべて首実験をする。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに日本では昔からこれをカワハジカミだのカラハジカミだのといっているが、これはその実物がまだ我邦に来ない前に、その当時の医薬関係の学者が支那の書物を参考してこれらの名を附けたものであろうと私は考える（この点白井光太郎博士とは聊か意見の相違がある）。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハイカラはいきに同じや煖炉燃ゆ　ハイカラハイカラと軽蔑して呼ばれる場合が多い、しかしハイカラというものもまた都会人の洗煉されたいきというものとおんなじような場合がある。",
              "citation": {
                "source": "俳句への道",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "山崎長之輔ノ一座ニ属シ中洲ノ真砂座ニ出テイタガ、ヤヽ老イテカラハ六代目ノ面差ニ似テイタ先代嵐芳三郎ノ相手役トシテ宮戸座ニ出テイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンハソレ以前カラモ時々自分ダケ茶ノ間デ寝テイタガ、ベッドニシテカラハ完全ニ別レ／＼ニ寝ルヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一般カラハソウ見エルニ違イナイノデ、忰モ内々ソレヲ自慢ニシテイル風ガアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼カラハダラシナク涙ガ流レ出シ、鼻カラハ水ッ洟ガ、口カラハ涎ガダラ／＼ト流レ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アヽ、直キナオルヨ、………早ク二階ヘ行ッテオ寝、………」予ハソウ云ッタ積リダッタガ、「早ク二階ヘ」アタリカラハ妙ナ濁声ニナッテ何ヲ云ッテルノカ自分デモ分ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "城山家ハモト吉田山ニ住ンデオリ、当時ハシバ／＼来往シタ覚エガアルガ、主人桑造ノ死後遺族ガコヽニ移ッテカラハメッタニ訪ネナイヨウニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソウ云ウ意味カラハ法然院ガ一番適当ジャナイデショウカ」ト、曼殊院ノ階段ヲ下リナガラ五子ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………僕ハ今年カラ、今日マデ日記ニ記スコトヲ躊躇シテイタヨウナ事柄ヲモアエテ書キ留メル、自分ト妻トノ関係ニツイテハ、アマリ詳細ナヲ恐レテイタカラデアッタガ、今年カラハソレヲ恐レヌハシソウモナイケレドモ、シカシ必ズシモソウトハ限ラナイ理由モアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "サテコレカラハドウナルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "関東・東北でカラハシと謂っていた稲扱具は、鉄製のものではなかった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "一方カラハシという名称の行われていた区域も弘いようである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カラハシは勿論カラコキバシの省略で、あたかもツルウメモドキをツルモドキ、白木蓮を白蓮と謂うのと同様の変化である。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは農事改良の主として苦痛を軽減し、またむしろ共同の作業を便利にした例であって、同じくカラの字の附く新意匠であっても、いわゆるカラハシの方とは著しい相異であった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "五　カラハシの効果は是と反対に、非常なる労力の節約であった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "曰くカラハシは竹を割って作ったもので、一人一日の能率は稲三十六｜把、籾約七｜斗二十一貫目を扱けばよいことになっていた。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "現在に至ってはこの二機ともに廃れ、改良｜稲扱機の能率は一日に四十｜俵、すなわち竹のカラハシの約二十七八倍になったと言っているが、勿論その後さらに有効なるものもできているはずで、つまりは百年前には一人の力で、一月以上も費すべかりし仕事を、今では丸一日もかからずに片づけるようになってしまったのである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の竹製のカラハシにかわった鉄製の千把コキなるものも、早くから有るには有ったが、それが普及したのは至って新しいことであった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いわゆるカナゴキの優越なる能力は、確かに当時の農村人を驚歎せしめるに足るものがあったが、しかもセンバコキなる名称は、それよりもずっと早くから、実は世の中に知られていて、是は多くの地方では福島・栃木などでいうカラハシ、すなわち竹製の稲扱器のことを意味していたのであった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮城県北部の登米郡その他、岩手県の気仙郡などもともに、センバコキと謂えば一般に櫛の歯式稲扱器、すなわち南隣の阿武隈流域などで、前からカラハシと呼んでいたものを指したらしい。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
