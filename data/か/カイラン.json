        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "中華料理店でブロッコリーに似た芥藍の炒め物を頼んだら、ほろ苦くてとても美味しかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "市場で芥藍を見つけたので、オイスターソースで炒めて夕食のおかずにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "香港では芥藍を茹でてオイスターソースをかけた料理がどの食堂にもある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ナマカイランソ（鰯の事）、ウワ――アアイイ……』　と横筋違に往来ば突抜けて行きます。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二十七日、土人イカイラン熊の子二頭を馬の脊に載せて持来れり。",
              "citation": {
                "source": "関牧塲創業記事",
                "author": "関寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
