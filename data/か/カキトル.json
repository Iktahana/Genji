      "ctype": "五段-ラ行",
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日暮れから煙草畑へ行つて、明日朝乾燥に釣る葉を掻き取る。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "其使用の目的は鳥獸の皮を剥ぎたる後に脂肪を掻き取るが如き事に在るなり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "はまぐり貝は又物を掻き取るに適したり。",
              "citation": {
                "source": "コロボックル風俗考",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしまたカキは万物を掻き取るの義として祝の一にしたものといわれる。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "にもかかわらず、我々の科学者魂と冒険心は完全に死に絶えたわけではなく、石組を構成する全ての岩石種毎に標本の細片をかき取る手続きを機械的に繰り返していた。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
