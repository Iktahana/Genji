        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼女の描く絵はいつもカラフルで、見ているだけで元気になる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "商店街にはカラフルな提灯が飾られ、祭りの雰囲気を盛り上げていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "子供たちはカラフルなブロックを使って、思い思いの家を作った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "食卓にはカラフルな野菜が並び、食欲をそそる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "あのデザイナーの作品は、いつもカラフルで斬新だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ブース全体もカラフルに飾り付けられている。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "バンドの背後には巨大なパネルスクリーンが備え付けられ、白黒の昔の恐怖映画にカラフルなオリジナルのアニメーションがちぐはぐに編集されているという実験映画じみたアバンギャルドなフィルムが上映されている。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」遠くの空の微光の方からふるへる物象のかげの方から犬はかれらの敵を眺めた遺傳の　本能の　ふるいふるい記憶のはてにあはれな先祖のすがたをかんじた。",
              "citation": {
                "source": "青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冷え冷えとし、だからふるえているのかと思うと、着て来た一重外套で丁度よかった、これはどういうことだろう。",
              "citation": {
                "source": "如是我聞",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」奥の方からふるえる声がした。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "大塊の奥の見えない坑道からふるえる声がきこえて来た。",
              "citation": {
                "source": "土鼠と落盤",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　老人は興奮からふるへてゐるやうにさへ見えた。",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常の死の波に最後のちからふるへる人の名はマカロフなりき。",
              "citation": {
                "source": "詩",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジミィは、大学からふるさとに帰ってきたばかりの、運動好きの若い大学四年生、といった恰好をして、板敷きの歩道をホテルに向かって歩いていった。",
              "citation": {
                "source": "罪と覚悟",
                "author": "A RETRIEVED REFORMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "８ひろい空からふる雨は森のうへにも牧場にもびつくり草にも小鳥にもみんなのうへにふるけれど子供のうへにはふりませぬ。",
              "citation": {
                "source": "どんたく",
                "author": "絵入り小唄集",
                "note": "青空文庫"
              }
            },
            {
              "text": "つとめさきでのそういう心理は、決してそのビルディングを出たときその人たちの心からふるい落されるものではないと思う。",
              "citation": {
                "source": "働く婦人の新しい年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから、ヤトラカン・サミ博士は、こころからふるえおののき、剃刀を遠ざけ、月光石を崇め、板っぺらの沓をはき、白髪の髷を水で湿し、手相見の紙着板を首にぶら下げ、大型移動椅子を万年住宅としてつつしんで、これに近づかなければならない。",
              "citation": {
                "source": "ヤトラカン・サミ博士の椅子",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "もとより心の迷い、いたずらなから耳――と思った栄三郎だったが、これがかれを渾身からふるいたたせて、つぎの刹那、うなりを生じた武蔵太郎安国、左膳の前額を望んで奔駆していた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "かぶさってくるその傷負いを蹴ほどいて、一歩敷居に足をかけ、栄三郎、血のしたたる剛刀をやみに青眼……無言の気合いを腹底からふるいおこして。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ豁然とあらゆる未練をたった彼、おのが心身の全部を挙げて乾坤二刀の争奪につくそうと、あらたなる闘魂剣意にしんそこからふるい起ったままであった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "道十郎めっかちというのは、キシャゴの遊びで、つぶの大きなキシャゴを二つもって、上からふると、片っぽひっくりかえって、貝殻の背でない方を出す、それが道十郎めっかちで、なんのためにそういう名がついているのか知らない。",
              "citation": {
                "source": "古屋島七兵衛",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "その吼え声が、またしても可憐なる女詩人を渾身からふるえ上らせずにはおかない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "白雲の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘆笛のように、ぴいぴい音を立てていた」　してみると、オノリイヌが、野菜の切り屑でいっぱいになった前掛けを窓からふるうために、向こうをむいている間に、誰かがそれをはずして行ったに違いない。",
              "citation": {
                "source": "にんじん",
                "author": "POIL DE CAROTTE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、そのためには、教育者は出来るだけ多くの機会をとらえて、子供と共に考え、子供と共に行い、子供をして常に創造発見の喜びを味わせ、建設の勇気を自分自らの中からふるい起させるようにすることが大切であります。",
              "citation": {
                "source": "青年の思索のために",
                "author": "下村湖人",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の裸身を隠すために、落ちていく衣類をつかもうとしたのだが、兵士が彼の身体をぐいと引き起こし、最後のぼろきれまで身体からふるい落してしまった。",
              "citation": {
                "source": "流刑地で",
                "author": "IN DER STRAFKOLONIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ユシュルーお上さん、こないだジブロットが敷き布を窓からふるったというので、警察から調べられて違警罪に問われたというじゃないですか。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "波にとりつこうとするサーファーが、かたっぱしからふるい落とされ、叩きのめされる。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、そうしてしばらく穴ぐらを見まわしているうちに、こんどは、いきなり背中につめたい水をかけられでもしたように、心の底からふるえあがるほどの、おそろしいことがおこりました。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あいつが騙し討ちをしかけた」と彼は白刃をみつめながら云った、「それで斬った」　おりうはまた大きく息をひき、それからふるえ声で、「あの人をですか」ときいた。",
              "citation": {
                "source": "滝口",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒さは足をはいのぼって腹にしみとおり、躯の芯からふるえが起こった。",
              "citation": {
                "source": "橋の下",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おんなわらべとひと口にいうけれども、これらがいちど心の底からふるい立ち、力をあわせてたたかえばこれだけのみごとな戦ができる、石田軍三万の兵力は、つまりそのちからのまえに手も足も出なかったのだ。",
              "citation": {
                "source": "日本婦道記",
                "author": "笄堀",
                "note": "青空文庫"
              }
            },
            {
              "text": "八　七重八重　春とはいえ、寒さはまだ朝の空気の中に、鎌いたちのようなするどさでひそんでいて、日かげにいると足もとからふるえあがってくる。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜならば、いずれにせよ、旧勢力からふるい落される無数の人々から恨みをかう。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしおっ母さんの耳にはいったら、その心配だけでも、きっとおっ母さんは……」　と、袂を顔に当てると、掴み細工の花櫛が、前髪からふるえて落ちた。",
              "citation": {
                "source": "かんかん虫は唄う",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、建武の忠臣が、いかに憤って草莽からふるい起ったか、あだには把らぬ弓矢を敢て把ったか、そしてついに国に殉じたか――を征途の夜々の眠りにも考えずにはいられなかった。",
              "citation": {
                "source": "上杉謙信",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
