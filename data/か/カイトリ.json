    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "今月｜一ぱいで店を畳んで、はあ、ツール在の土となるまでの巣を見つけて買い取りましたよ。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "最近、ある化学的薬品を使えば、酢、醤油、ソース、いや酒までつくれるという簡単な醸造法の特許権を、安く買い取りました。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "「昔……昔、浦島は、小児の捉えし亀を見て、あわれと思い買い取りて、……」と、誦むともなく口にしたのは、別荘のあたりの夕間暮れに、村の小児等の唱うのを聞き覚えが、折から心に移ったのである。",
              "citation": {
                "source": "悪獣篇",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "もともとのオリジナルを開発した企業から他の半導体メーカーが設計のノウハウを買い取り、まったく同じ仕様のものを生産するのである。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "のちにＰＥＴを出すことになるコモドール社から、現金と同社の株と地位を条件にアップルの新しいマシンを買い取りたいという条件が示された際は、ジョブズもウォズニアックも一時この話に傾いた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "矢野はいきなり家具屋へはいってテーブル机、椅子、本箱、相当にりっぱなものを買い取り、さっそく自分の下宿へ届けるように命じた。",
              "citation": {
                "source": "廃める",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私と同じで、買い取りの医院だ。",
              "citation": {
                "source": "株式仲買人",
                "author": "THE STOCK-BROKER'S CLERK",
                "note": "青空文庫"
              }
            },
            {
              "text": "この地上にもし、まだ誰も知らず一人も踏まぬ国ありとすれば、その所在を、ご貴殿にはお買い取りになりたき意志なきや。",
              "citation": {
                "source": "人外魔境",
                "author": "遊魂境",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて某は即時に伽羅の本木を買い取り、仲津へ持ち帰り候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊達家の役人は是非なく末木を買い取り、仙台へ持ち帰り候。",
              "citation": {
                "source": "興津弥五右衛門の遺書",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "この法被は貰ったんだけれど番号を改えるのが面倒だから売る』と云いたるを以て三十銭に買い取りし旨を答えたり。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの夫婦は昨日この見世物小舎に見物に参りましたのですが、御覧の通り珍らしい姿ですから、私が百万円出して夫婦を買い取りまして皆様にお眼にかけることにしました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「実は、こういう用件なんです、私は当地のいろんな地主から農奴を買い取りまして、移住させようと思いますんで、売渡証書もありますから、登記の手続だけして頂けばいいんですがね。",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第二分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "はいはい、あなた様が、このたび磯屋をそっくりお買い取りなすったお方で、ああ、さようでございますか。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "いえ、全くのはなし、あの商売をのれんでと、雇い人ごと買い取りましたときに兼吉という一番番頭が申しますには、これこれこれこれのお顧客さまへ貸しになっている。",
              "citation": {
                "source": "巷説享保図絵",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "千円は儲けさせて頂きたいもので、はい」　とどのつまり、岩田天門堂はこの怪画を四千円で伯爵から買い取り、折柄ちょうど店の者が自動車を持って岩田を迎えに来たので、それに乗って帰った。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はこの連中の中では珍らしく審美派であって、儲けた金の一部をもって、元宮様の別邸をそっくり買い取り、それから日本画や洋画等の美術品の蒐集に凝りだした。",
              "citation": {
                "source": "すり替え怪画",
                "author": "烏啼天駆シリーズ・５",
                "note": "青空文庫"
              }
            },
            {
              "text": "わしの発明兵器を、わしごと買い取りに来たのじゃろう」　と、ずばり図星をさした。",
              "citation": {
                "source": "共軛回転弾",
                "author": "――金博士シリーズ・11――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし私どもは、あの特許の実物が、いま申しましたような働きをするに充分だと認めれば、特許の買い取り価格をそうですねえ、まず二百万円までは出します」「二百万円、あの『多腕人間方式』の特許権が二百万円になるのですか」　余は、もう愕きを、隠していることができなかった。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……南蛮寺の謎を解き明かせた、研究材料さえ目つかれば、安土に居られる信長卿が、高価にお買い取り下さると、右近丸様は仰有ったけれど、何時になったら研究材料が目付かるものやら見当がつかない。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大事な人形ではございますが、小判一枚に青差一本、それでお買い取り下さるなら、お売りすることに致しましょう」　すると猪右衛門は頷いたが、やがてこんなことを云い出した。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父の意志を受け継いで、家敷の地所をも買い取りたいとさえ思っている。",
              "citation": {
                "source": "公孫樹",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この会社の株券が、百株ほどまとまって売物に出た時、芝田さんは借金をしてそれを買い取りました。",
              "citation": {
                "source": "白い朝",
                "author": "――「正夫の童話」――",
                "note": "青空文庫"
              }
            },
            {
              "text": "無理に買い取りなすったようなものだ。",
              "citation": {
                "source": "碑文",
                "author": "――近代伝説――",
                "note": "青空文庫"
              }
            },
            {
              "text": "全くその通りで私は三円でその樹を買い取りました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "栃の木で老猿を彫ったはなし",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして安田善次郎氏が百何十円かで買い取りました。",
              "citation": {
                "source": "幕末維新懐古談",
                "author": "谷中時代の弟子のこと",
                "note": "青空文庫"
              }
            },
            {
              "text": "その結果組合長が電話で製造会社に問い合わせて、会社がその百貨店に売り渡した数量は二十五斤入り三千箱一万五千円であることを確かめ、一同はただちにつれ立ってその百貨店に行き、売場に積み上げてある七百箱を買い取り、さらに一千箱の予約註文を出した。",
              "citation": {
                "source": "一商人として",
                "author": "――所信と体験――",
                "note": "青空文庫"
              }
            },
            {
              "text": "またわが北海において蟹缶詰を作りますが、蟹の甲羅は初め海中に捨て去られて居たのを、オランダ人が発見して買い取り、本国に運んで鶏の餌に致しておりました。",
              "citation": {
                "source": "私の小売商道",
                "author": "相馬愛蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうどそこへ通りかかってこれを見つけた幸作は、大いに喜んで、これはまったく神さまのお授けにちがいないといって、眠っている子供を揺り起こして、みんな箱の中の小判を買い取りました。",
              "citation": {
                "source": "金銀小判",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの巴里人のならわし通りこの男も老後を七、八十｜里巴里から離れた田舎へ恰好な家を見付けて買取り、コックに一人の女中ぐらい置いて夫婦の後年を閑居しようという人達だ。",
              "citation": {
                "source": "巴里の秋",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
