          "standard": [
            {
              "text": "退職金を一括で買取してもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "買取で現金化する手続きは簡単だ。",
              "citation": {
