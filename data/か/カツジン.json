[
  {
    "uuid": "1d12cabd-1ade-5426-a828-b6c811d1512c",
    "entry": "活人",
    "reading": {
      "primary": "かつじん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
