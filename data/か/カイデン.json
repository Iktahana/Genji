      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "initiation into an art or discipline",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "武道の師範から皆伝をもらった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "伝統芸能での皆伝は名誉ある称号である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "皆伝を受けるまでに20年の修行が必要だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "拳銃皆伝の一軸、極意の巻ものを一気に頂こうという、むかしもの語りの術譲りの処だから。",
              "citation": {
                "source": "ピストルの使い方",
                "author": "――（前題――楊弓）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と衝と寄りて、門番の両手を扼るは、昔関口流皆伝の柔術家、今零落して屠犬児、弥陀平というは世を忍ぶ仮の名にて、本名あるべき親仁なり。",
              "citation": {
                "source": "貧民倶楽部",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "果して一丁程馬車が動くと赫子が口を歪め、私には顔の側方を向け、而も一番私に云う強い語気で「ふん、あれでも神伝流の免許皆伝か。",
              "citation": {
                "source": "鶴は病みき",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……もっともここの修行が出来上れば当流の皆伝を取らするがのう……」「……エッ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの……皆伝を……」「ハハハ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "今の門下で皆伝を許いた者はまだ一人もない。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間としては免許皆伝じゃ」　平馬は眼をパチパチさせて恩師の上機嫌な顔を見守った。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……これが免許皆伝か……」　とつぶやきながら平馬は、黒い森に包まれた舞鶴城を仰いだ。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その肝玉を踏み潰し、吠面かゝし呉れむと意気込みて、いよ／＼腕を磨きければ二十一歳の冬に入りて指南役甲賀昧心斎より柳生流の皆伝を受くるに到りぬ。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時の在京中藩公の御前は勿論、喜多流の能楽堪能（皆伝）と聞こえた藤堂伯邸へも度々召出されて御能、お囃子等を仰付られた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "当時東京では喜多流皆伝の藤堂伯その他の斡旋により、現十四世喜多流家元六平太氏、当時幼名千代造氏が能静氏の血縁に当る故を以て弱冠ながら家元の地位に据わり、異常の天分を抽んで、藤堂伯その他の故老に就てお稽古に励んでいた。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてこの程度まで鼻の表現を研究し得れば、最早所謂、機略縦横、神出鬼没の行き止まりとして世間から一種の敬意を払われるので、しかもこれを世渡りの秘訣、処生法の免許皆伝と心得ている人が又｜頗る多いように見受けられるのであります。",
              "citation": {
                "source": "鼻の表現",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "親方も言いましたっけ、撲りあいに目を塞がないようになりゃ、喧嘩流の折紙だって、もうちっと年紀を取って功を積んで来ると、極意皆伝｜奥許と相成ります。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何、」「極意皆伝奥許というのは喧嘩をしない事ですとさ、何のこッた詰らない。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほんとうに詰らない、」「いえ、ところが私にゃあ不可ません、お嬢さんなんざ何でも分っていなさるんだから、はじめから幾らも皆伝になられます、荒っぽい気をお出しなすっちゃあ不可ませんぜ。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "十九の年に、免許皆伝を許されると、彼はただちに報復の旅に上ったのである。",
              "citation": {
                "source": "恩讐の彼方に",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああしてぺこぺこ詫びてはいるが、あの眼の配り、腰の構えは、先ず免許皆伝も奥義以上の腕前かな。",
              "citation": {
                "source": "旗本退屈男　第一話",
                "author": "旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ああしてぺこぺこ詑びてはいるが、あの眼の配り、腰の構えは、先ず免許皆伝も奥義以上の腕前かな。",
              "citation": {
                "source": "旗本退屈男",
                "author": "第一話　旗本退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひと吹きで大の男をのめらした手並みから察するに、おそらく下手人は今いった三人のうちのどやつかから一子相伝の奥義皆伝でもうけた娘か妹か、いずれにしても身寄りの者にちげえねえんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "「わははは、剣道修業の者ならば、先ず免許皆伝以上の心眼じゃ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "足腰のしゃんと立ったのは言うまでもないこと、声までがしいんと骨身にしみ透るように冴え渡って、手の内がまた免許皆伝以上、しかも流儀は短槍にその秘手ありと人に知られた青江信濃守のその青江流なのです。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "なるほど、犬の顔にも裏表があるかもしれねえがね、よしんばお駒が免許皆伝の剣術使いであったにしても、包丁はドス、そのドスが血によごれて、死骸のそばにころがっておったと、万兵衛のだんなが詳しくご披露なすったんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おそいかかろうとしたのを、ひらりとお駒のむちが横に動いたかと思うと、免許皆伝どころか、実にみごとな手の内でした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "やまがら美人影絵",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供の時から腕力人にすぐれて、悪戯がはげしく、十二の時に藩の指南番伊達何とかいう人に見出されて、その弟子となって、十八で免許皆伝を貰った。",
              "citation": {
                "source": "自叙伝",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかく柳生十兵衛取立の門人一万二千人――但し講釈師の調査――の中から、只一人の極意皆伝という又右衛門が小者輩に腰だの頭だのを撲られては恩師十兵衛に対して甚だ申訳の無いことであるし、第一三十人も御負けをつけて贔屓にしてくれた講釈師に対しても全く済まぬ訳であるが、どうも事実だから曲げる事もできない。",
              "citation": {
                "source": "鍵屋の辻",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはそうとして雪之丞さん」　と、闇太郎は、これまでにない真面目な眼つきになって、相手を見詰めて、「これはあとから、ある人の口から、はっきり聞いた話なのだが、やっぱし、あっしの眼に狂いはなく、脇田先生の道場で、免許皆伝だというじゃあねえか。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
