[
  {
    "uuid": "a7b2514d-ed07-5464-b4df-4da4a056e7ea",
    "entry": "閣内",
    "reading": {
      "primary": "かくない",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(inside the) Cabinet",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「閣内からも異論が噴出し、法案の修正を余儀なくされた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「総理は閣内の結束を固めるため、異例のスピードで閣僚会議を招集した。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「新法案をめぐり、閣内での調整が難航している。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「来月行われる内閣改造で、現在の閣内メンバーがどう入れ替わるのか注目されている。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "写真師を招ぎて来青閣内外の景を撮影せしむ。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之一大正六年丁巳九月起筆",
                "note": "青空文庫"
              }
            },
            {
              "text": "……水野の復職の理由が不明だによって、閣内はいうまでもない、市中でもさまざま取沙汰するそうな。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "捨公方",
                "note": "青空文庫"
              }
            },
            {
              "text": "閣内で干渉の非をとなえていた農商務大臣の陸奥も辞表をだして、河野敏鎌が代った。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきに内務大臣副島種臣は志を閣内の暗流にはばまれて憤然と致仕したが、松方は自らこれを兼務して議会を乗り切り、七月十四日河野敏鎌を移して内務にすえた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "要するに尾崎を閣内から追って、均勢論の宿望を達しようという策動であった。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "これよりさき、政友会内閣は予算問題をめぐって閣内に内訌を生じ、五月五日にまず総理大臣伊藤が骸骨を乞うて、すでに総退陣していた。",
              "citation": {
                "source": "渡良瀬川",
                "author": "大鹿卓",
                "note": "青空文庫"
              }
            },
            {
              "text": "曹操は救われたように、「むむ、それも一理ある」　と不問に付して馬をおり、階を鳴らして閣内へ通った。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "おかしいことには、その噂と同時に、魏の譜代の面々が、日々、閣内に集まって、「いま、上天｜吉祥を垂る。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　外の雑鬧にひきかえ、庁の閣内は、しいんとしていた。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "勇んで茶店に這入りはすれど、ところで話は、とかくないもの。",
              "citation": {
                "source": "在りし日の歌",
                "author": "亡き児文也の霊に捧ぐ",
                "note": "青空文庫"
              }
            },
            {
              "text": "」差し出されたセルの羽織をその学生服の上にさっと羽織って、「短かくないか。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」差し出されたセルの羽織をその学生服の上にさつと羽織つて、「短かくないか。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "『新ロマン派』で追記風にある同人雑誌（名だかくない）のある人をほめていたことばを見て、ねたましく思ったこともあります。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんだ、ちっともあったかくないね」「はっは、そうかい」「ぼくたちの先生のポケットは、もっとぬくいよ。",
              "citation": {
                "source": "うた時計",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "（昭和十年九月、渋柿）曙町より（二十七）　子供のときから夜具といえば手織り木綿の蒲団にあまり柔らかくない綿のはいったのに馴らされて来たせいか今でもあまり上等の絹夜具はどうもからだに適しない、それでなるべくごつごつした紬か何かに少し堅く綿をつめたのを掛け蒲団にしている。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "何という柔らかくない硬化した南画形式の自然主義的な作品が、世上に多いことであらう。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしまだまだ日本の生きた言葉はこの複雑な封建性から解放されるためにみじかくない時間を要するであろう。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "普通の蝶のように軟らかくない。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の丈ほどふかくない。",
              "citation": {
                "source": "僕の国",
                "author": "スチーブンスン",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは信心ぶかくないという証拠にはならなかった。",
              "citation": {
                "source": "ドナウ源流行",
                "author": "齋藤茂吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴子　　あら、いやだ、ストーブがあつたかくないわ。",
              "citation": {
                "source": "雪だるまの幻想（ラジオ・ドラマ）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "あと　おめめが　あかくない？",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをつかまえつかまえ、一方では時間を超越したその努力を続けて行けるほど、彼の脳髄は細かくない。",
              "citation": {
                "source": "三郎爺",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうこまかいところから細かくない何かで会得されて来て、ユリが本来はひとなんかおかないで、と云っていらしたことが、どういうことかわかりかかって来ます、これはなかなか興味ふかいでしょう？",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "炉のほとりにいて暖かくないという者を、想像し得らるるであろうか。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、夏隣りのみじかくない日も、もう暮れかけていた。",
              "citation": {
                "source": "宮本武蔵",
                "author": "地の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "傷口は長いが、刀痕はふかくない、ただ血しおは一時おそろしく全身をよごした。",
              "citation": {
                "source": "梅里先生行状記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
