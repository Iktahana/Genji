        "examples": {
          "standard": [
            {
              "text": "市場での値下げ交渉で、仕入れ業者たちは商品を買い叩いていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "卸売業者が農家から野菜を買い叩くのは、毎年の恒例だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "不況の時期は、買い手が買い叩こうとするため交渉が厳しくなる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "一週間以内に地中海石油株を、二株につき半ペニ硬貨三枚で買い叩くことになろう。",
              "citation": {
                "source": "諜報部",
                "author": "A Secret Service",
                "note": "青空文庫"
              }
            },
            {
              "text": "「金をわざとくれて、貴重なものを二束三文で買いたたく輩は、人の財産を自分の懐に入れると同時に、これ幸いとチャールズ卿を排除したんだ。",
              "citation": {
                "source": "くちなしの花",
                "author": "The Slave of Silence",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
