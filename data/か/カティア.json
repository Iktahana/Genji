          "literary": [
            {
              "text": "彼女の名は、カティアというのだった。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほかにどんなセダンがあるのですか」　ぼくの質問に対して、カティアは、まるでウエイトレスがビールの銘柄をならべたてるように、自動車の名をいくつも、ひと息にぼくに告げた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスクに戻ったカティアは、書類を作りはじめた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "外のビューイックを再び指で示し、「あなたのものよ」　と、カティアは言った。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
