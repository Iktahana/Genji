        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "――「夏目漱石君はズーデルマンの『カッツェンステッヒ』を評して、そのますます序を逐うて迫り来るがごとき点をひどく感服しておられる。",
              "citation": {
                "source": "田山花袋君に答う",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "花袋君は六年前にカッツェンステッヒを翻訳せられて、翻訳の当時は非常に感服せられたが、今日から見ると、作為の痕迹ばかりで、全篇作者の拵えものに過ぎないと貶せられた。",
              "citation": {
                "source": "田山花袋君に答う",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "花袋君がカッツェンステッヒに心酔せられた時分、同書を独歩君に見せたら、拵らえものじゃないかと云って通読しなかったと云って、痛く独歩君の眼識に敬服しておられる。",
              "citation": {
                "source": "田山花袋君に答う",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "（小生の読んだものについて云う）ただしズーデルマンのカッツェンステッヒより下手な拵えものである。",
              "citation": {
                "source": "田山花袋君に答う",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
