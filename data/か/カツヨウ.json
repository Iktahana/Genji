        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "日本語の動詞は、丁寧形や過去形など、様々な形で活用する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "この単語は、形容詞としても副詞としても活用できる面白い性質を持っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "助動詞「れる」の活用形を覚えるのが、ちょっと苦手なんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "英語の動詞の活用と比べると、日本語は複雑だと感じる人もいるかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
