        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "崎陽舌官劉梅泉者客歳以事出都。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　詩話に所謂「客歳」とは何れの年であらうか。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "次の年の蘭軒の詩引に、「客歳春夏之際、吾公嬰疾辞職」云云と云つてあるからである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "客歳携令弟立敬来嵯峨。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "文は文化九年七月に草したもので、「客歳」は八年を謂ふ。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "註云、客歳春夏之際、吾公嬰疾辞職、而至冬大痊、幕府下特恩之命、賜邸於小川街、而邸未竣重修之功、公来居丸山荘、荘園鉅大深邃、渓山之趣、為不乏矣、公日行渉為娯、故結末及之。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「客歳十二月十六日。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」頷聯に「此日雪景頗奇、銀鈴玉杖並実際所見、非倣銀海玉楼之顰」の註、頸聯に「二物客歳所得、此日始試」の註がある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "「丁亥元日、客歳冬暖、園中梅柳、頗有春色、故詩中及之。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "後者「戊子元日作」の自註には「客歳十二月元彫千金翼方影鈔卒業」と云ひ、次に「十一月児厚挙女子」と云つてある。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "十一月の上には前註の「客歳」を連ねて読むべきである。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "客歳は此年丁亥で、其十一月に榛軒信厚は長女をまうけた。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "第五註、客歳十二月元彫千金翼方影鈔卒業、第六註、十一月児厚挙女子、第七八註、臘前梅花半開、信頗異於常年。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "大窪天民は、「客歳」と云つてあるから文政十年に、加賀から大阪へ旅稼に出たと見える。",
              "citation": {
                "source": "壽阿彌の手紙",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "陳者客歳六月該場開業之｜砌、各位御招待申上候御報謝として、華麗之引幕一張御恵賜被成下、御芳志之段｜難有奉拝受候。",
              "citation": {
                "source": "明治劇談　ランプの下にて",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "乃チ巾箱ヲ開キ客歳ノ詩ヲ閲シテ煩ヲ芟リ冗ヲ除キテ一百首ヲ得タリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "客歳常房ノ間ヲ周遊シ、頃ロ江戸ニ還リソノ詩ヲ刻セント欲シテ余ノ題言ヲ索ム。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "梅痴は湖山から『詩屏風』に採録すべき近作を請われたについて、既に客歳『玉池吟社詩』に掲載したものは除いて、過日枕山の手許に送った近什の中から佳作を択みなお十分添削の労を取るようにと言っている。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
