    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マダ　ワカイノニ　オトウサンモ　オカアサンモ　キヨウダイモ　ナク、ホントウニ　ヒトリボツチデ　アリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミズハ　フカイノデ　トテモ　ジブンデ　ヒロフ　コトハ　デキマセン。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "少ナクトモカナヅカイノ問題ヨリハハルカニ単純デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダイ一カイノヒゲキハ、スデニオコナワレタリ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナンジダイ二カイノヒゲキニソナエヨ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると彼はダイ一カイノヒゲキハオコナワレタリ、云々という手紙を三通タイプライターで打つて持参し、同時に一方僕に『五月一日を警戒せよ』というあの手紙を郵送しておいて秋川邸にかけつけた。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニカイノ　アルトコロコノヨコチョウデス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「清サンハ、ホントニ、キカイノコトガ、オ上手デス」",
              "citation": {
                "source": "杏の若葉",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカイノ　アオイノ　ミンナイトノサキデ　ユラユラユレテル。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登ではカイノゴは三番以下の籾まじりの粗米で、団子の材料にするものだと謂っているが、その米の粉をもまたカイノゴというから、やはりかい餅にする粉という意味であった。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを汁に入れて再び煮たものを、伊勢ではやはりカイノコ汁というのは、是も奥州のカッケのごとく、のちに調理法がやや改良したのである。",
              "citation": {
                "source": "木綿以前の事",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登の方へ行くとカイノゴといふ者が多く、カイは匙即ち臼の中のものをかき出す器の名らしいから、本來は團子の粉のことゝいふ方が正しく、つまりはカイノゴ用の米といふことを省略した名かと思はれる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし現在は能登でもその米の粉だけで無く之に供せられる三番以下の籾まじりの米を、やはりカイノゴと呼んで居る。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "此地方に行はれる粉挽唄に、夏のカイノゴ三升が限り五升を出たやら鷄やうたふといふのがある（鹿島郡誌）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちカイノゴ挽きは樂な仕事ではなかつたのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "能登の方へ行くとカイノゴという者が多く、カイは匙すなわち臼の中のものをかき出す器の名らしいから、本来は団子の粉のことという方が正しく、つまりはカイノゴ用の米ということを省略した名かと思われる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし現在は能登でもその米の粉だけでなくこれに供せられる三番以下の籾まじりの米を、やはりカイノゴと呼んでいる。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "この地方に行われる粉挽唄に、夏のカイノゴ三升が限り五升を出たやら鶏ゃうたうというのがある（鹿島郡誌）。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわちカイノゴ挽きは楽な仕事ではなかったのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "『釈日本紀』巻二十秘訓、白雉元年の条に、堺標　　　サカイノシメ　すなわち標は我々の注連縄のシメ、また「紫野ゆきシメ野行き」の古歌に歌った紫野のシメと同じく堺を限って土地を占める方式を意味していた。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
