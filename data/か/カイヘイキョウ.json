        "examples": {
          "standard": [
            {
              "text": "その開閉橋は船が通るたびに自動的に上昇する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "開閉橋の作動音は船舶の乗組員に周知される。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この開閉橋は歴史的建造物として保護されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "夕刻、大浦を出て二時間ばかりで、下島への開閉橋を渡つた。",
              "citation": {
                "source": "天草の春",
                "author": "長谷健",
                "note": "青空文庫"
              }
            },
            {
              "text": "船首は、開閉橋の片方のように、コンクリートのスロープにワイア・ロープでおろしていくことができる。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
