        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こんな事を書き進むのは、殆ど私の堪え得ないところだ。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "従って「八犬伝」の続稿も、書き進むことが出来なかった。",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "八犬伝書き進む　その時武士の囁く声が馬琴の耳へ聞こえてきた。",
              "citation": {
                "source": "戯作者",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、その愈製作にあぶらのゝつて来る時代に這入らうとすると、出て来さうで影を顕さない資料を想像する心が隔てに立つて、どうしても、私の書き進む心を妨げた。",
              "citation": {
                "source": "橘曙覧評伝",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "出雲は定めて書き進む程桜丸に愛を覚えることが深かつたであらう。",
              "citation": {
                "source": "手習鑑雑談",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが自分の感じとぴったり合しつゝ書き進むるようならば、もう文章のある域まで達したのであるが、これと反対に思うところ感ずるところが、一字一行にも骨が折れてどうにも書き進められない場合がある。",
              "citation": {
                "source": "文章を作る人々の根本用意",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのものうさを人生の姿としてそれなりに訴えずにいられなくて、書きはじめられた小説が、考えすすみ書きすすむままに、やがて次第にすべてそれらのものうさの原因を、主人公の内部にあるものと、外の社会とのありかたとの関係のうちに批判をともなって、発見されてゆきはじめる。",
              "citation": {
                "source": "文学と生活",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍記物語としてはそうあってさしつかえないが、「新・平家」は、軍記が主ではないから、やがて一ノ谷、屋島、壇ノ浦と書きすすむにしても、ただちに次回から一ノ谷を書くようなことはない。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
