[
  {
    "uuid": "715e35f2-48cf-567d-9ebf-b685ce33de91",
    "entry": "皮籠",
    "reading": {
      "primary": "かわご",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
