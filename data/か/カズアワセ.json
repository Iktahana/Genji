        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "来月の予算案、このままでは数合わせになってしまいそうだね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "請求書の金額と実際の領収書で数合わせをしたら、やっぱり少しズレがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "プロジェクトの工数見積もりで、各タスクの時間を数合わせで調整するのではなく、現実的な計画を立てよう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "会計係は、毎日必ず売上と現金の数合わせを済ませなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "木曾寄せの人足七百三十人、伊那の助郷千七百七十人、この人数合わせて二千五百人を動かすほどの大通行が、三月四日に馬籠の宿を経て江戸表へ下ることになった。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "「年の近いとか少ないとか、そんな数合わせみたいな問題ではありませんよ。",
              "citation": {
                "source": "三国志",
                "author": "望蜀の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "道太の食物が運ばれた時分には、おひろは店の間へ出て、独り隅の方で、トランプの数合せに没頭していた。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
