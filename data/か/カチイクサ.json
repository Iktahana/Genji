        "examples": {
          "standard": [
            {
              "text": "古代の戦場では、騎馬隊だけでなく徒歩軍も重要な役割を担っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "敵の進軍路を断つため、主力となる徒歩軍を配置した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「敵の数が多い！徒歩軍を前面に押し出せ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 2,
