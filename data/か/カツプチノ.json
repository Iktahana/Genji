        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "我詩には、店の卓の上なる猫兒、店の女房と價を爭ひたる、若き「カツプチノ」僧さへ、殘ることなく入りぬ。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カツプチノ」僧は蝋燭に火をうつして挽歌をうたひ始めたり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌の聲に醒むれば、石垣の頂には日の光かゞやき、「カツプチノ」僧二三人蝋燭を把りて卓より卓に歩みゆきつゝ、「キユリエ、エレイソン」（主よ、憫め）と歌へり。",
              "citation": {
                "source": "即興詩人",
                "author": "IMPROVISATOREN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
