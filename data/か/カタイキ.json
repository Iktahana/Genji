    "definitions": [
      {
        "index": 1,
        "gloss": "difficult breathing",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "重い荷物を持って階段を駆け上がったら、もう片息状態だよ！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "高山病の症状で、空気が薄くて片息になることがある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "喘息の発作が起きて、急に片息になった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "女を見出すと、片息の鹿を女の足元に抛り出した。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "すでに傷き片息になっている毛もののこととて、※くまもなく四股をくいくいと伸して息絶えた。",
              "citation": {
                "source": "富士",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の中を這出して、片息になってお前、本尊の前へにじり出て、台に乗っけて小さな堂を据えてよ、錦の帳を棒の尖で上げたり下げたりして、その度にわッと唸らせちゃあ、うんと御賽銭をせしめてやがる。",
              "citation": {
                "source": "黒百合",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとにはお母さんが片息になって倒れているのを、皆で介抱しているようであったが、離れた処から見ていた上に、言葉が普通と違っているので、どんな経緯なのかサッパリわからなかった……という子守女たちの報告であった。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いざとなれば死にさえすればいいのだ」鼈四郎は幼い時分から辛い場合、不如意な場合には逃れずさまよい込み、片息をついたこの無可有の世界の観念を、青年の頭脳で確と積極的に思想に纏め上げたつもりでいる。",
              "citation": {
                "source": "食魔",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たち自身、こうあることが半ば死滅させられながら、まだ片息で、人に呑みかゝろうと蟠っている地方の因習や伝説の生活の中にいつからか住み馴染んでいる人間のように思われて来ました。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助には、平岡の凡てが、恰も肺の強くない人の、重苦しい葛湯の中を片息で泳いでゐる様に取れた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時お前が一生この恩は忘れないって、片息になって、しっかり俺の頸へしがみついたあの時から、俺は、俺はお前を……。",
              "citation": {
                "source": "片男波",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "来て見りやおれの股ぐらから、あの野郎がもう片息になつて、面妖な面を出してゐやがる始末よ。",
              "citation": {
                "source": "鼠小僧次郎吉",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おとう……とう……と、と、と……」　声は次第に弱った、涙は泉のごとくわいた、そうして片息になって寝台に手をかけた、もう這いあがる力もない。",
              "citation": {
                "source": "ああ玉杯に花うけて",
                "author": "佐藤紅緑",
                "note": "青空文庫"
              }
            },
            {
              "text": "代助には、平岡の凡てが、あたかも肺の強くない人の、重苦しい葛湯の中を片息で泳いでいる様に取れた。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この間も片息でなお地面を、お吉は這い廻り悶えていたが、「九十郎殿……死なれたか……死なれたそうな。",
              "citation": {
                "source": "血煙天明陣",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "苦痛が全身を渡るとみえ、二人ながら片息だ。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうしたことだとたずねると、音七と半兵衛は片息をつきながら、「この魚は、神様がくだされたのか、重吉ぬしがくだされたのか知らないが、ここで跳ねまわっているのを見るなり、夢中で双方からとりつき、一と口食い二た口食いしているうちに、このように骨だけにしてしまった。",
              "citation": {
                "source": "重吉漂流紀聞",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかでもない、あれからめっきり蒲鉾の味がよくなって、これが通な人々の間に喧伝され、そろそろ売上げも多くなり、今日日はどうやら片息吐いているから、この分でいけば日ならずして店の調子も立ち直ろうとの取り沙汰。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　片息ながら平兵衛の話した一伍一什。",
              "citation": {
                "source": "釘抜藤吉捕物覚書",
                "author": "巷説蒲鉾供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩息で貴方ね、口癖のように申すんですよ、どうぞまあそれだけでも協えてやりたいと、皆が心配をしますんですが、加持祈祷と申しましても、どうして貴方ここいらは皆狸の法印、章魚の入道ばっかりで、当になるものはありゃしませぬ。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "にらみ合うだけでだんだん呼吸がせわしくなって肩息になるのだという。",
              "citation": {
                "source": "映画雑感（３）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "おんつぁんは肩息になつて酔ひながらもだえるのだ。",
              "citation": {
                "source": "骨",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　肩息で駆けかえりながら、汗もふかずに、まず伝六がずぼしの的中を証拠だてたので、右門もようやく手から毛抜きを放しました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "生首の進物",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か、大怪我ださうではないか」　猶も答のあらざるを腹立くは思へど、満枝の居るを幸に、「睡てをりますですかな」「はい、如何でございますか」　彼はこの長者の窘めるを傍に見かねて、貫一が枕に近く差寄りて窺へば、涙の顔を褥に擦付けて、急上げ急上げ肩息してゐたり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と答えるともなく、押し戻される拍子にベタリとその場へ膝をついた件の男……つづみの与吉はだらしなく肩息のありさまだった。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩息で頭髪を振り乱し、遠くを駈けて来たものらしく、はいると同時にべたりとなったのを見ると、あの、一足違いで、三味線堀の里好の家から逃げられてしまった人魚のお蔦だ。",
              "citation": {
                "source": "つづれ烏羽玉",
                "author": "林不忘",
                "note": "青空文庫"
              }
            },
            {
              "text": "……拙者いつでも討たれて進ぜる」　それから、足もとに、今は肩息になっているお浦を見下ろしたが、「不幸な女」と呟いた。",
              "citation": {
                "source": "血曼陀羅紙帳武士",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから、その末に見える空も、一面に、熱くるしく、炎靄をたゞよはせて、雲の峰さへもこの旱に、肩息をついてゐるのかと、疑はれる。",
              "citation": {
                "source": "酒虫",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれだって、頭の使いかたとチャンスによっては、アッというような大仕事だって出来ないわけはないなどと、蒼ずんだ顔で肩息をつきながら気焔をあげていた。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "「う、う、う……」　大池は肩息をつきながら、家宅捜索でめちゃめちゃにひっくりかえされた広間の中を見まわし、マントルピースの端に縋って食器棚のほうへよろけて行ったが、曳出しに手をかけたまま、ぐったりと食器棚に凭れかかった。",
              "citation": {
                "source": "肌色の月",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "男が電車に乗ったころ、女は蒼白い蛙のようになって、床から半身を乗り出し、極度の疲労と凝視との世界から赦放されたばかりの荒い肩息を吐いていた。",
              "citation": {
                "source": "香爐を盗む",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "重く引き入れては、重く引き出す肩息に、蜘蛛の肢は生けるが如く蠕動した。",
              "citation": {
                "source": "刺青",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯のつきはじめた黄昏の街の中で、肩息をつきながら立停り、くしゃくしゃに顔を歪めた。",
              "citation": {
                "source": "雪と泥",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
