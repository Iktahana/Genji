        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それらの小さな子供達は、すっかり疲れもなおって、チェッカベリ摘みをはじめていたのだが、みんながおりて来たので、迎いに登って来た。",
              "citation": {
                "source": "ワンダ・ブック――少年・少女のために――",
                "author": "A WONDER BOOK FOR BOYS AND GIRLS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、カベリョーフ将軍という人は、僕もそばで見ていたが、どうしても捜し出せなかったんだからな。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "中国地方ではこの魚売りの女をカネリ、またはカベリといっていた。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "忠海などでは之をカベリと喚んで居る。",
              "citation": {
                "source": "瀬戸内海の海人",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カベリは忠海にも居り、又尾道にも澤山居る。",
              "citation": {
                "source": "瀬戸内海の海人",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このペルシムというのは他人がつけたあだ名であって、自分たちではカベリム（〔chabe^rim〕）すなわち「仲間」（英語の fellows）と呼んでいた。",
              "citation": {
                "source": "イエス伝",
                "author": "マルコ伝による",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
