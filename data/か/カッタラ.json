          "literary": [
            {
              "text": "ソンナニ外ガ見タカッタラ、教場ノ外ヘ出テイナサイ」　窓の外へ立たされて、殊勝らしくじっとうつむいていた顔をひょいとあげると、先生は背中を向けて黒板に字を書いていた。",
              "citation": {
                "source": "わが町",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウイエバ昨年ノ暮空襲デクライ外ヘ出タトキ、左ノ眼ガイヤニ暗イ感ジガシタシ、マタ室ニイテモ変デ、左ノマツ毛に目ヤニデモツイテイルノデハナイカト気ニシタ事ガアッタガ、ソノコロカラ悪カッタラシイ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "サモナカッタラ疾ックニ死ンデイタカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、モシ予トオ静トガ打ツカラナカッタラ、予ニ知レタコトヲ彼等ハ気ヅカズニイタデアロウ、トスルト、オ静ガ予ト行キ遇ッタコトハ、マダシモ仕合セダッタト云エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソンナトコロデ押シ倒サレテ若シ打チドコロガ悪カッタラドンナコトニナルカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸イニシテレスリーニハ何ノ被害モ受ケナカッタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナドト胡麻化スノデハナイガ、余計ナオセッカイヲシテ悪カッタラ詑マリマス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
