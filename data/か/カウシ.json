              "text": "カウシテ、イチニチ　クラシマシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カウシテ、オトモダチヲ　ジユンジユンニ　タヅネテ　イキマシタガ、ドノ　トモダチモ　オナジ　コトヲ　イフノデ　アリマシタ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コホロギサンハ、カウシテ反物ヲトツテキテ、早速立派ニヌツテアゲマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレドモ　マイニチマイニチ　フタリハ　カウシテ　コウラヲ　ホシナガラ　ネムツテシマヒマス。",
              "citation": {
                "source": "カメサン　ノ　サウダン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
