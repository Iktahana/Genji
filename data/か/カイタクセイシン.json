        "examples": {
          "standard": [
            {
              "text": "開拓精神に満ちた先人たちが、この地を豊かな農地へと変えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "家族一同で開拓精神を胸に、新しい移住地での生活を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "彼の開拓精神は世代を超えて受け継がれ、今日の繁栄がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "嘘をつかないという教育の外に、弱い者をいたわるとか、開拓精神を失わないとか、というような精神的の躾も、よくなされている。",
              "citation": {
                "source": "六三制を活かす道",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "第三は、開拓精神を失わないこと。",
              "citation": {
                "source": "ピーター・パン",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のいわゆる西部劇には、野蛮な面も、殺伐な面も大いにあるが、開拓精神を失うまいとする意図が働いている点を見逃してはならない。",
              "citation": {
                "source": "ピーター・パン",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
