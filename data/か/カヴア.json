        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "斯学の玉条たるエングレル及びブラントルの自然分科編に、ダリヤの九種みなメキシコの原産とあり、一七八九年にイスパニアの僧カヴアニュスが、瑞典の植物学者ダールの姓に由てダーリアと命名した事、その著西班牙植物図説一と二の説に明かなれば、支那の原産でないは論を俟たず。",
              "citation": {
                "source": "きのふけふの草花",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "廊下の處へおしめカヴアーをさげて坐つてゐた子守が、「清太郎さんておつしやいます」　と教へてくれた。",
              "citation": {
                "source": "夜福",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゆき子は枕の白いカヴアの清潔さにみとれて涙ぐんでしまつた。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、人生社会を一つや二つや三つのイデオロギイでカヴアできるような小さいものとは見ません。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらのイデオロギイ自身がそれぞれ人生社会全部をカヴアできるのだといくら豪語しても、それがウソだと言うことを「感じ」ます。",
              "citation": {
                "source": "恐怖の季節",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤ら顏の丈夫さうな女で、調子の高い、明けつ放しな感じが、頭の醜くさをカヴアーして、妙に人を親しませます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お登世の戀人",
                "note": "青空文庫"
              }
            },
            {
              "text": "女體の佛像の額のゑぐられたのも、淺ましく目立ちますが、それよりも、男體の夜光石の威力は、それをカヴアして、四方を威壓する凄まじさを持つて居るのでした。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "江戸の夜光石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
