[
  {
    "uuid": "dc34a750-7371-59e5-9542-6cbd22a9fd33",
    "entry": "闊歩",
    "reading": {
      "primary": "かっぽ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
