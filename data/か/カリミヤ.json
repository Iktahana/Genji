    "definitions": [
      {
        "index": 1,
        "gloss": "temporary shrine",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "社殿が落雷で焼失したため、急遽プレハブ小屋を仮宮として遷座祭が行われた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「遷宮が終わるまでは、こちらの仮宮にお参りいただくことになります」と巫女が案内する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "奈良の山奥には、かつての皇族が隠れ住んだという伝説の仮宮跡がひっそりと残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祭りの期間中だけ砂浜に建てられる仮宮に、潮風に乗って波の音が響く。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "その鷺宮の仮宮へ、高倉テル君が罹災者の姿で訪れてきた。",
              "citation": {
                "source": "三木清を憶う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "故、出雲に到りまして、大神を拝み訖へて、還りのぼります時に、肥河の中に黒樔橋を作り、仮宮を仕へ奉りて、坐さしめき。",
              "citation": {
                "source": "大嘗祭の本義",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "その翌日は、お札の降ったところの原の真中に、白木造りの仮宮が出来ました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その晩には仮宮の前へ、誰がするともなく、おびただしい鏡餅の供え物です。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中心地、小金ヶ原へ一夜のうちに出来た仮宮の宮柱も、みるみる太くなりました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "仮宮は何の神様であるか知らないが、その御本体を大切にするよりは、茂太郎と弁信の御機嫌を取ることが大事であるらしい。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして自分は、母の帝が板蓋宮炎上のあとで、暫く仮宮に使つてをられた川原の古宮に黙々として起居しながら、妃の莵野ノ王女の眼をぬすんでは通つてくるのだつた。",
              "citation": {
                "source": "鸚鵡",
                "author": "『白鳳』第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "本殿から仮宮までの十町の道には、一間幅にずっと白砂が敷いてあるので、道筋だけはようやくわかるくらいなもの。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "猫眼の男",
                "note": "青空文庫"
              }
            },
            {
              "text": "――氏経様は、その中を、時の権力や貧苦とたたかい、諸人を説きあるいて、やっと明応の六年ころ、仮宮の御遷宮をすることができたというのです。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "後で聞けば、輿の上※は、吉野の仮宮に仕える内侍所の女性で、何かのお使いで東条の城へ見えた途中であったという。",
              "citation": {
                "source": "日本名婦伝",
                "author": "大楠公夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "兄の正行が出陣の折、吉野の仮宮まで、行を共にして、そこから別れて城寨へ帰って来た三男の正儀は、戻るとすぐ、母の居間に姿を見せて、「母うえ。",
              "citation": {
                "source": "日本名婦伝",
                "author": "大楠公夫人",
                "note": "青空文庫"
              }
            },
            {
              "text": "「仮宮も出来あがったから、とりあえず、太牢を供えて、宗廟の祭を営もう」　袁紹は、諸侯の陣へ、使いを派して、参列を求めた。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ぜひもありません」　董承は、頭をたれて、「――この上は、再び、仮宮をお捨てあって、曹操が方へ、お落ちになられるが、上策かと思われますが」　すると、楊奉、韓暹の二人がいった。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、曹操は、さして驕らず、すぐ帝にまみえて、しかも、帝のおゆるしのないうちは、階下に低く屈して、貧弱な仮宮とはいえ、いたずらに殿上を踏まなかった。",
              "citation": {
                "source": "三国志",
                "author": "草莽の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "山頂だけに、小雨をもった烈風が蔀や廂を吹きなぐり、仮宮にしろ、これが天皇の御寝ある皇居かと怪しまれるほどだった。",
              "citation": {
                "source": "私本太平記",
                "author": "帝獄帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "宮内庁三階の仮宮殿南ノ間が私たちの控えで、そしてそこの廊下を右折した西ノ間がすぐ授与式にあてられていた。",
              "citation": {
                "source": "随筆　私本太平記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "出された鮨には手をつけず、それをすっかりみやげに持ってゆくと主張しました。",
              "citation": {
                "source": "落雷のあと",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私らは吾妻橋から上手の隅田川にばかりみやこ鳥がいて、大川にはいないものと思ってきた。",
              "citation": {
                "source": "みやこ鳥",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれ出雲に到りまして、大神を拜み訖へて、還り上ります時に、肥の河一八の中に黒樔の橋一九を作り、假宮を仕へ奉りて、坐さしめき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔氣比の大神〕　かれ建内の宿禰の命、その太子を率まつりて、御禊一せむとして、淡海また若狹の國を經歴りたまふ時に、高志の前の角鹿二に、假宮を造りてませまつりき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここをもちて曾婆訶里に詔りたまはく、「今日は此處に留まりて、まづ大臣の位を賜ひて、明日上りまさむ」とのりたまひて、その山口に留まりて、すなはち假宮を造りて、俄に豐の樂して、その隼人に大臣の位を賜ひて、百官をして拜ましめたまふに、隼人歡びて、志遂げぬと思ひき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時市の邊の忍齒の王三を相率ひて、淡海にいでまして、その野に到りまししかば、おのもおのも異に假宮を作りて、宿りましき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここに明くる旦、いまだ日も出でぬ時に、忍齒の王、平の御心もちて、御馬に乘りながら、大長谷の王の假宮の傍に到りまして、その大長谷の王子の御伴人に詔りたまはく、「いまだも寤めまさぬか。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにすなはち小楯の連聞き驚きて、床より墮ち轉びて、その室の人どもを追ひ出して、その二柱の御子を、左右の膝の上に坐せまつりて、泣き悲みて、人民どもを集へて、假宮を作りて、その假宮に坐せまつり置きて、驛使上りき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "――　かくてタケシウチの宿禰がその太子をおつれ申し上げて禊をしようとして近江また若狹の國を經た時に、越前の敦賀に假宮を造つてお住ませ申し上げました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてソバカリに仰せられますには、「今日は此處に留まつて、まずお前に大臣の位を賜わつて、明日大和に上ることにしよう」と仰せられて、その山口に留まつて假宮を造つて急に酒宴をして、その隼人に大臣の位を賜わつて百官をしてこれを拜ましめたので、隼人が喜んで志成つたと思つていました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "この時にイチノベノオシハの王を伴なつて近江においでになり、その野においでになつたので、それぞれ別に假宮を作つて、お宿りになりました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "翌朝まだ日も出ない時に、オシハの王が何心なくお馬にお乘りになつて、オホハツセの王の假宮の傍にお立ちになつて、オホハツセの王のお伴の人に仰せられますには、「まだお目｜寤めになりませんか。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "と述べましたから、小楯が聞いて驚いて座席から落ちころんで、その家にいる人たちを追い出して、そのお二人の御子を左右の膝の上にお据え申し上げ、泣き悲しんで民どもを集めて假宮を作つて、その假宮にお住ませ申し上げて急使を奉りました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
