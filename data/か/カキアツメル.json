[
  {
    "uuid": "d550dbf6-0bf3-5b91-a86b-88dbee6ae7c0",
    "entry": "かき集める",
    "reading": {
      "primary": "かきあつめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
      "ctype": "一段",
      "inflections": null,
      "ctype_source": "pos-derived",
