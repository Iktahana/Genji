    "definitions": [
      {
        "index": 1,
        "gloss": "to buy back",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "売ったコンピュータを中古で買い戻した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この会社は自社株を買い戻す予定だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "友人から借りた本を再度買い戻すことにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "稼人のない間を金に換えて置いて、稼人が帰って来たら再び自分の手許に買い戻す。",
              "citation": {
                "source": "熊の出る開墾地",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "買い戻すといっても、彼の脳は、いまはちゃんと他人の脳室に入っているのである。",
              "citation": {
                "source": "脳の中の麗人",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐに参って目付け出し、奈良朝時代の貴女人形買い戻すことにいたしましょう」「それでは」と民弥も意気込んだ。",
              "citation": {
                "source": "南蛮秘話森右近丸",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち各交換者におけるこの比の増加は、（Ｂ）利用が変化せず、（Ｂ）を再び売って、（Ａ）、（Ｃ）、（Ｄ）……を買い戻す人にあっては、（Ｂ）の稀少性の増加と（Ａ）の稀少性の減少によって生ずる。",
              "citation": {
                "source": "純粋経済学要論",
                "author": "ELEMENTS D'ECONOMIE POLITIQUE PURE OU THEORIE DE LA RICHESSE SOCIALE",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本の場合は、自分で原爆をつくる意志はないし、こっそりソ連へ密輸出しなければならない義理もないから、出来たプルトニウムを、アメリカが買い戻す点に、反対する理由はない。",
              "citation": {
                "source": "科学ブームへの苦言",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少くとも今日の彼女は、夫の愛を買うために、もしくはそれを買い戻すために、できるだけの実を津田に見せたという意味で、幾分かの自信をその方面に得たつもりなのである。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "父が死ぬと、遺産はサルタンに戻り、そして子供は多額の金を出さなければ相続権を買い戻すことが出来ない。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "あがないと言いますのは、奴隷の身代金を払って奴隷を買い戻すことであります。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそく五兵衛に相談すると、偽物を作ってともかくも一時は凌ぎ、そのうちにゆるゆる真物の行方を捜し、金に飽かして買い戻すより外に途はあるまいということになり、五兵衛はさっそく偽物を拵え上げ、鞘から鍔まで、寸分違わぬ物を持って来て、石川良右衛門の手で、それを御腰物方に納めたのは去年の秋です。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "買った遺書",
                "note": "青空文庫"
              }
            },
            {
              "text": "「この頃、大きい新聞に『名画買い戻す』という広告が出ています。",
              "citation": {
                "source": "奇巌城",
                "author": "アルセーヌ・ルパン",
                "note": "青空文庫"
              }
            },
            {
              "text": "底値になればマナーはそのころ意気消沈しているから、介入して安値で買い戻す。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「だが、知らせてからが問題だ」それなら家宝として買い戻す、と云われたらどうするか。",
              "citation": {
                "source": "末っ子",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉板の箱にはいった菓子でも、その代価に相当する切手でも、およそ二割引きくらいで菓子屋は買い戻すから、一日に五回も葬式があれば、日雇いなどより割高な稼ぎになった。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……アノ、ここにいる人が、お父さまにあたしを買い戻す様にお頼みしろと云いますの」「分った、早く云ってごらん。",
              "citation": {
                "source": "恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ですから、あなた、私が手離した二十万斤を今の値で買いもどすこともできやしません」「しかし、約束だから……」「それはムリですよ。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その十九　乞食男爵",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなに買いたければ、その内に轟さんから買いもどすんですなあ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "買いもどすとも、そのままにするとも、それは兄さんしだいです。",
              "citation": {
                "source": "珊瑚",
                "author": "蒲松齢",
                "note": "青空文庫"
              }
            },
            {
              "text": "「作品を皆買いもどすよ。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく狂気｜沙汰ではあったが、彼は初めもらった金高より五倍もの価で、自分の作品全部の版権を買いもどすことにした。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "三｜年の後、彼はとうとうバイオリンを、買いもどすだけの金を持つことができました。",
              "citation": {
                "source": "海のかなた",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "健康というものは、最も苦しい焼灼や切開によっても買いもどすに足りると、わたしは考えている。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "先方の買直がぎりぎりの処なら買戻すとする。",
              "citation": {
                "source": "国貞えがく",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "泥棒市場は、その名の示すとおり、善良な市民が金を払ってじぶんの盗まれた品物を買戻す市場だ。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノルウェイにおける農場の改良に対するもう一つの大きな障害は、オーデル権と称せられる法律であり、この法律によって直系の子孫は誰でも、この家族から売り渡された地所を、その際の買値を支払って買戻すことが出来るのである。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "交換者（３）は（Ｂ）を再び売って、（Ａ）、（Ｄ）を買戻す。",
              "citation": {
                "source": "純粋経済学要論",
                "author": "ELEMENTS D'ECONOMIE POLITIQUE PURE OU THEORIE DE LA RICHESSE SOCIALE",
                "note": "青空文庫"
              }
            },
            {
              "text": "留吉　いや、それよりも田地を買戻す方が先きだ。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "より　田地を買戻すなんか後廻しにして、その妹さんの方を先きにおしよ。",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "雪　んでも、兄さん田地買戻すんぢや無えの？",
              "citation": {
                "source": "地熱",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "或者は、身代金によって品子さんを買戻すことを提案した。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いッたい、どこへ行ったら買い戻せるだろうか」「市でございます」「市？",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
