        "examples": {
          "standard": [
            {
              "text": "鼻の周りに角栓ができやすいので、週に一度はスペシャルケアをしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "洗顔料をしっかり泡立てて、優しくマッサージするように洗うと、角栓が取れやすくなるらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "毛穴が開いて、黒ずんだ角栓が目立ってしまうのが悩みだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "角栓を無理に押し出すと、肌を傷つけることがあるので注意が必要だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
