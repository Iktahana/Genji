        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかしこいつが肥大化すれば、やがて演奏はコンピューターのジェネレートするカラオケになる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いや、いや、唄なんか聞きたくありません、唄どころじゃないわ」「船カラオ茶少シ持出シテ来マシタ、オアガリナサイ」「何も欲しくありません。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "七オ母サン　ハ仕方　ナクミンナ　カラオヒゲ　ヲネ三本ヅツモラツタノ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして「日本紀」には、「良男」をオオミタカラオノコ、「良女」をオオミタカラメノコ、「良人」をオオミタカラ、「奴」をオノコヤッコ、「婢」をメノコヤッコと傍訓してある。",
              "citation": {
                "source": "賤民概説",
                "author": "喜田貞吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "今時分カラ芝生ノ上ニ坐ッタリシテ、冷エルトイケナイカラオ止シナサイト、婆サンハ頻ニ止メタガ、「オ爺チャン、チョットイラッシャイヨ」ト、颯子ガスヽメタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "前立腺肥大ノ手術ハ七十五六歳マデハ可能デアルカラ、思イ切ッテシテオ貰イナサイ、手術シタ後ノ快感ハ何トモ云エナイ、若イ時ノヨウニ尿ガシャー／＼ト音ヲ立テヽ走ッテ出マス、モウ一度青春時代ニ戻ッタ気ガシマスト、ソウ云ッテクレタ人モアッタガ、困難デ不愉快ナ手術ダカラオ止シナサイト云ウ人モアッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "御療治ノ最中ニ失礼ダト存ジマシタケレド、先日颯チャンカラオ願イシマシタラ御承知下サイマシタソウデ誠ニ有難ウゴザイマス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イヤリングヤネックレスヲシテナイトコロガ気ガ利イテルネ」「オ爺チャンナカ／＼分ルノネ」颯子ノ後カラオ静ガ草履ノ箱ヲ持ッテ這入ッテ来、草履ヲ取リ出シテ彼女ノ前ニ揃エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「又ソンナモノニ寝ルノカイ」「何デモイヽカラオ爺チャンハ黙ッテオ休ミナサイ」「籐椅子ナンゾジャ風邪ヲ引クヨ」「風邪ヲ引カナイヨウニ毛布ヲ沢山持ッテ来サセルノ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ静ガ萬事心得テルカラオ静ニ任シテ置ケバイヽノ」「風邪ヲ引カシチャ浄吉ニ済マナイカラナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………「少シヨクナルト直グソレダカラオ爺チャンハ困リマスヨ、モウ暫ク様子ヲ見テカラニナスッタラドウ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきほども申し上げましたとおり、ひとりひとりが独立した資料調査事務所のような存在ですから、いつもお菓子を食べてお茶を飲んで、世間話をしていっしょに社を出てカラオケへ繰り出す、というようなことはないのです」　三人の女性たちは、村田の言うことに表情で賛同していた。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ゴケンチヨーシヨージキドーカラオモチヤノサツヲウケトレウケトリニンノナハダイコクヤシヨーテン。",
              "citation": {
                "source": "二銭銅貨",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴケンチョーショージキドーカラオモチャノサツヲウケトレウケトリニンノナハダイコクヤショーテン「ゴジャウダン。",
              "citation": {
                "source": "二銭銅貨",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「〈ケーブルカー〉で予約しときました」「それって〈村さ来〉の隣のカフェバーだったわよねえ」「そうですよ」「あそこはカラオケがあるんだ」春彦が言った。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
