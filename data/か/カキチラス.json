    "entry": "書き散らす",
    "reading": {
      "primary": "かきちらす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
      "ctype": "五段-サ行",
      "inflections": null,
      "ctype_source": "pos-derived",
