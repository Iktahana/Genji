        "examples": {
          "standard": [
            {
              "text": "新生児の蟹屎は緑黒色で粘り気が強い特徴的な色をしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "蟹屎の排出が遅れると、新生児黄疸が発生するリスクが高まる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "医学教科書では蟹屎の重要性と観察方法について詳しく説明されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは物凄く汚いどろどろのかたまりのようなもので、三好が看護婦から聞いたのでは、胎児の毒素が口の方へ出るのだと云うことであったが、幸子が見ると、赤ん坊が分娩後に始めて排泄するあの蟹屎と云うものに似ていた。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
