        "examples": {
          "standard": [
            {
              "text": "大英帝国の王冠に輝くカリナンは、その大きさと輝きで人々を魅了し続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カリナンと同等の大きさのダイヤモンドが採掘されることは、極めて稀な出来事だろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "映画の中で盗まれた宝石は、カリナンのレプリカだと判明した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "オークションハウスのカタログには、カリナンの歴史が詳しく記載されていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
