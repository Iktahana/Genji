        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「オウマノ　アカチヤンハ　モウ　オメメヲ　アイタカ　ミテ　キテ　チヨウダイ」　テフテフハ　スグ　ウマヤノ　マドカラ　ナカニ　ハイツテ　イキマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンガ　ノツテ　ヰテ、カキマハシタノデシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンハ、ブウブウ　イヒナガラ、カアチヤンノ　ジヤマシテ　ヰマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、オバサンノ　ソバニ　ヨツテ、「アカチヤン　ダイテテ　アゲマセウカ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オバサンハ　アカチヤンヲ　ミチコサンニ　ダツコサセテ　クレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ケレド、アカチヤンハ、コトリヲ　ミナイデ、ミチコサンノ　カホヲ　ミテ　ヰテ　ニツコリ　ワラヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカチヤンハ　マタ　ウバグルマニ　ノツケラレテ、イツテ　シマヒマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、マダ　アカチヤンヲ　ダツコシテルヤウナ　テツキヲ　シテ　オウチヘ　カヘツテ　キマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシネ、ドコカノ　カワイイ　アカチヤンヲ　ダツコシタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "好いあんばいに今夜は姿が見えないなと思ふと、チヤブ台の脚を開く音、皿小鉢のカチヤンと云ふ音を聞いたら直ぐ何処かゝら帰つて来る。",
              "citation": {
                "source": "猫と庄造と二人のをんな",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また幾日かして、小なしのはうは黍団子のやうに大事に、隆チヤンとタカチヤンに半分づゝやつてしまつた。",
              "citation": {
                "source": "一顆の栗一顆の小なし",
                "author": "小穴隆一",
                "note": "青空文庫"
              }
            },
            {
              "text": "たねなしの小なしが、いま尋常三年生の隆チヤン一年生のタカチヤンの身の内に何れの時に生えるであらうか。",
              "citation": {
                "source": "一顆の栗一顆の小なし",
                "author": "小穴隆一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
