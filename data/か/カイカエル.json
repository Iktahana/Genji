        "examples": {
          "standard": [
            {
              "text": "毎年新しいモデルに買い換える必要がある",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "壊れたテレビを最新機器に買い換えました",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "古い家電から最新型に買い換えることにした",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "切符も上の分（ユンクフラウ鉄道）は此処で買い換えるようになっている。",
              "citation": {
                "source": "吹雪のユンクフラウ",
                "author": "野上豊一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二日の日には、原っぱを横切って通りに出て、一寸林町へよって、上野の松坂やへ出かけて下着などを買いかえると、いねちゃんが待っていて、久しぶりに夕飯を一緒にたべ、いろいろ喋り十二時頃かえりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "あとになって買いかえるというのもことだろう。",
              "citation": {
                "source": "その年",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、定期的に買いかえるし」「ナナハンの免許、いつ受けさせてくれるの？",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "買うのをこれまで延期したのだから、もうすこし良いのと買いかえてくれと頼んでいる。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十八日に買いかえた。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "この分野では、経済的に白人よりは低い位置にいた黒人を相手にしていたため、プレーヤーの買いかえを必要とした45回転レコードはなかなかいきわたらず、一九五〇年代の終わりちかくまで、大勢は78回転の、重くて大きいレコードだった。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女はコスモに買いかえて、大人の女になるんだって言ってた」「だったら、ひと走りだ。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
