        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "カンザシハ　サカナノ　ソバニ　シヅンデ　キマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカモカタカナノ問題ハ現在ノ私ノ生活ニスコブル密接ナ関係ヲ持ツ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "シタガツテ楷書ノ活字トカタカナノ活字モマタキワメテ調和ガヨイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来、ヒラガナノ構成単位ハ曲線デアリ、楷書トカタカナノ構成単位ハ直線デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "漢字ノ活字ガ楷書一ツデタクサンデアルヨウニ、カナノ活字モカタカナ一種類デタクサンデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆ヤハ通イナノデ夕方水ダケ張ッテオイテ帰リ、瓦斯ニ火ヲ付ケルノハワレワレノウチノ誰カナノダガ、今夜ハ時分ヲ見計ラッテ郁子ガ付ケタ）ヘ行ッテ倒レタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガマはその後北方カナノル港で十分の商品を積込み、ゴアの南方の島で船を修繕し、一四九八年の末に近い頃、北東モンスーンに乗ってインド洋を越え、翌一四九九年一月八日にマリンディに着いた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこから南下しカナノルへ行く途中では、商品と巡礼者とを満載してインドへ帰る大船を捕え、掠奪・放火・撃沈・殺戮など残虐を恣にしたと云われる。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "カナノルでは款待を受けたが、しかしガマはこの町に対しても紅海からの貿易やカリカットとの通商を禁じてしまった。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後ガマがコチンで積荷を終えカナノルへ行く途中を要して襲撃したが、これも大砲で撃退された。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "新来の艦隊はカリカットに二日間砲撃を加え、カナノル附近でアラビア人の艦隊を打ち破り、十分の荷を積んで一五〇五年七月にはリスボンに帰着した。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "他に二百五十名の兵がコチン、カナノル、コラム等を守った。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくしてアルメイダは十月末カナノルに到って副王の位についたのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくてロレンソはこの年三月、カナノル港外に於てカリカット王の二百隻の艦隊を見事にやっつけたのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その一つはカナノルの謀叛である。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポルトガルに友交的であった王が歿して後嗣が立った後に、ポルトガルのカピタンがカナノルの舟を沈めた事件が起り、遂に王は怒ってカリカットと結びポルトガル人の城を包囲するに至ったのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルブケルケはカナノルに引き上げて休養したのであるが、その頃に二つの船団が本国から着いた。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "コチン、カナノルその他のどの城も、意義価値に於てはゴアと比較にならないのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
