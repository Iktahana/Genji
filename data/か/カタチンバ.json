          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "事故で足を痛めてから、彼は少しだけ片跛を引きながら歩くようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "古い木製の椅子は脚の長さが揃っておらず、座るたびに片跛に揺れて落ち着かない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "遠くの方で、片跛な足取りの野良犬が夕日に向かってトボトボと歩いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「アゲマキ」という貝は瀟洒な薄黄色の殼のなかに、やはり薄黄色の帽子をつけた片跛の人間そのままの姿をして滑稽にもセピア色の褌をしめた小さな而して美味な生物である。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "お尻の上の帯をゆすぶりゆすぶり玄関の扉を開いて、新派悲劇みたいな姿態を作って案内したから吾輩も堂々と玄関のマットの上に片跛の護謨靴を脱いで、古山高帽を帽子掛にかけた。",
              "citation": {
                "source": "超人鬚野博士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "……放神したようにダラリと開いた唇、真赤に血走ったまま剥き出された両眼、放散した瞳孔、片跛に釣り上った眉。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな小娘が片跛の下駄を履いて、六本木から神田まで驅けて來るといふのは、容易のことではありません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "罠",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分、何處へ」　後ろからガラツ八、これは下駄と草履を片跛に穿いて追いかけます。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "南蠻祕法箋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五六、大店の手代風ですが、餘程面くらつたものと見えて、履物も片跛、着物の前もろくに合つて居りません。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "どんど燒",
                "note": "青空文庫"
              }
            },
            {
              "text": "「親分、どこへ」　後ろからガラッ八、これは下駄と草履を片跛に履いて追っかけます。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "南蛮秘法箋",
                "note": "青空文庫"
              }
            },
            {
              "text": "二十五六、大店の手代風ですが、余程面くらったものと見えて、履物も片跛、着物の前もろくに合っておりません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "どんど焼き",
                "note": "青空文庫"
              }
            },
            {
              "text": "お孃さんが危いところへ行つたと知つて、下駄を片跛に穿いて本郷丸山から飛んで來たのさ」「なアーンだ」「それを身投げにしたところが俺の作だ」　平次は面白さうでさへありました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "お秀の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "お嬢さんが危ないところへ行ったと知って、下駄を片跛に履いて本郷丸山から飛んで来たのさ」「なアーンだ」「それを身投げにしたところが俺の作だ」　平次は面白そうでさえありました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "お秀の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "若し反省といふものがなく、徒らに尖端を狙つた輕佻浮薄ばかりを全部としてゐたら、日本の文學は片跛で、極めて不健全なお先走りのものになり終つてゐることと思ふ。",
              "citation": {
                "source": "折々の記",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "またある時、かたちんばの下駄をはいてわずかに三町ばかり歩いた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "まゆ毛はかたちんばになり、猶更わらわれた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            },
            {
              "text": "うす暗い、かたすみのところに、みすぼらしい年とったおばあさんが、かたちんばの古げたをよりわけて、あれか、これかと、くみあわせてみているのでした。",
              "citation": {
                "source": "緑色の時計",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "道の上に、手ぬぐいをかぶった、ひげつらの男と、大きな洗面器をかかえたものと、かたちんばのげたをはいた子どもなど、ひとりとして、まんぞくのふうをしない、人たちが集まっていました。",
              "citation": {
                "source": "かたい大きな手",
                "author": "小川未明",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして家へ帰るなり、片ちんばの頬鬚をそり落としてしまつた。",
              "citation": {
                "source": "茶話",
                "author": "大正十四（一九二五）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "電燈の明るい廊下に向ってかたく閉められているドアの前には、ドアごとに男の靴と女の靴とが一組ずつ出してあるのだが、それが、何者のしわざか、てんでんばらばら、ごちゃまぜにして、片ちんばにされているばかりでなかった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つのドアの前で片ちんばに組み合わされた男の靴、女の靴が、いかにも踊っている形で向いあわされているかと思うと、そのさきのドアでは、靴のぬげたのをかまわず逃げる女を、男が追っかけてつかまえたとでもいうような形に男靴女靴がいりみだれている。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "警部補の前で調べられた時と同じやうに、幾らか片ちんばの眼が血走つてぎら／＼と光り、下唇を醜く突出して、身體をぶる／＼震はしてゐた。",
              "citation": {
                "source": "不良兒",
                "author": "葛西善藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "何世紀か前には地色の青だった、油で黒い火夫の仕事着に、靴は勿論片ちんばでなければならない。",
              "citation": {
                "source": "踊る地平線",
                "author": "しっぷ・あほうい！",
                "note": "青空文庫"
              }
            },
            {
              "text": "長「随分茶の有る男だな……草履下駄を片ちんばに履いて往く奴があるか、狗がくはへて往つた、外に無いか、それではそれで往け、醋吸の三｜聖、孔子に老子に釈迦だよ、天地が唐物緞子、中が白茶地古錦襴、風袋一文字が紫印金だよ、瑾の事がにゆうだよ、忘れちやアいけないよ。",
              "citation": {
                "source": "にゆう",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等の多くは塵箱から拾つて来た古下駄――それも大抵は片ちんばの下駄を穿いて来て、どれがどれやら、自分のものを知らないものだから、そこに百二三十の古下駄が並ぶ度毎に、下駄番に一人の先生が附き切りで有つても、授業が済んで帰ると云ふ段になると、目茶苦茶である。",
              "citation": {
                "source": "死線を越えて",
                "author": "死線を越えて",
                "note": "青空文庫"
              }
            },
            {
              "text": "三輪の親分は、自慢の煙草入を忘れて、草履を片ちんばに履いて行きましたよ」　こんな事を言ふのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "死の祕薬",
                "note": "青空文庫"
              }
            },
            {
              "text": "片ちんばになっちゃ溜りませんわ。",
              "citation": {
                "source": "親鳥子鳥",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんなにまで、江戸の男と女の数が、片ちんばだとはおもわなかった。",
              "citation": {
                "source": "大岡越前",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
