[
  {
    "uuid": "b2986c6c-e1ed-5ed8-ab71-2abba6e367f7",
    "entry": "紙くず",
    "reading": {
      "primary": "かみくず",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
