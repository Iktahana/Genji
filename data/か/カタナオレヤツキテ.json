          "standard": [
            {
              "text": "チームは最後まで戦ったが、主力選手の相次ぐ負傷により、刀折れ矢尽きて敗北した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "あらゆる治療法を試したが効果はなく、刀折れ矢尽きて、彼は運命を受け入れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "刀折れ矢尽きてなお戦う武士の姿勢は後世に語り継がれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "そうしてその刀折れ矢尽きて現社会から敗退して行った翁の末路を見てホッとした連中が「それ見ろ。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから市民は安心して、常のとおり家業に励めと、高札に令しておられるではないか」「…………」「刀折れ矢尽きて、医家の垣の内に療治をうけている兵は、もう主を失った浪人じゃ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第七分冊",
                "note": "青空文庫"
              }
            }
          ]
        }
