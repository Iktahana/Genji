[
  {
    "uuid": "4c6c7e11-4ddd-58a5-b3b3-1f26d99091f9",
    "entry": "買い主",
    "reading": {
      "primary": "かいぬし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
