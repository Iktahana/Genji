        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "旧道に出て、洋服屋や、野菜店や、家具店などの小さな街を歩きながら子爵は、「南條さんは、僕の名前ご存じないでしょう。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "家具店よりの帰途私は電車に乗る。",
              "citation": {
                "source": "マルクス主義と唯物論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "家具店よりの歸途私は電車に乘る。",
              "citation": {
                "source": "唯物史観と現代の意識",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "その通りは家具店が多く、椅子や卓子が店頭高く積っていた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "退屈をしたときパリでよく、家具店をこうして千鶴子と一緒に見て廻った矢代は、そのときのことをふと思い泛べた。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "家について見ると、英・国の二人がねて居て、食堂では木下家具店でエキステンドィング・テーブルのデザインをして居る。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二人は骨董店だの、家具店だのをひやかして歩いた。",
              "citation": {
                "source": "（ポオル・モオランの「タンドル・ストック」）",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩みて芝愛宕下西洋家具店に至る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "半蔵門外西洋家具店竹工堂を訪ひ、麻布普請塲に至る。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断膓亭日記巻之四大正九年歳次庚申",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日、なんのあてもなしに入った家具店で見つけた。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "粋な家具店を覗き込むようで、家具が完璧に備わっている。",
              "citation": {
                "source": "見えざる力",
                "author": "THE INVISIBLE FORCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "書生の喜多村が、玄関へ出てみますと、職人みたいな男のひとりが、何か書きつけを見ながら、「大門洋家具店のものですが、ご注文の長イスを、おとどけにまいりました。",
              "citation": {
                "source": "大金塊",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ああ、Ｎ家具店ですか。",
              "citation": {
                "source": "黒蜥蜴",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
