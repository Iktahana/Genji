[
  {
    "uuid": "d1d771ff-bb59-545d-8e11-66cce4dce66a",
    "entry": "体つき",
    "reading": {
      "primary": "からだつき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
