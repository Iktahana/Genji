        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "掻き鳴すやこをろ／＼に。",
              "citation": {
                "source": "長塚節歌集　上",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "上手奥の離れた所から、お袖の掻き鳴す三味線の音がして来る。",
              "citation": {
                "source": "好日",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オーケストラは間断なく仕事した――日本のバンジョウを怠けたような、ぼんやりしたような調子で掻き鳴すのに持ってって、時々笛が疳高く鳴る。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
