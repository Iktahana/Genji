        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "タマクシゲ箱根ノ水海ケケレアレヤ二クニカケテ中ニタユタフ　と将軍家のおよみなされたのもこの時でございまして、間然するところなき名描写のやうに私たちには思はれました。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――海ノ底デネ、青イ袴ハイタ女学生ガ昆布ノ森ノ中、岩ニ腰カケテ考エテイタソウデス、エエ、ホントニ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ忙シイあなたニコンナ無遠リョヲカケテタイヘンスマナク思ッテイマス。",
              "citation": {
                "source": "生まれいずる悩み",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　ヨビナガラ　オツカケテ　キマス。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト、ミツルクンヲ　オツカケテ　イツテ　三ツ四ツ　ナグリツケテ　ヤリマシタ。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コモリハ　コウエンヘ　クルト、ベンチニ　コシカケテ　コモリウタヲ　ウタヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ、アノ新聞記事ヲ見マシテカラ、ヤット昨晩、家ニ帰ッテ見マシタラ、祖母ハ蚊帳ノ釣手ニ、妻ノ赤イ細帯ヲカケテ、首ヲククッテ死ンデオリマシタ。",
              "citation": {
                "source": "空を飛ぶパラソル",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "君チャンノオ父ッチャハ、工場デヤスリヲトイデイルウチニ、グルグルマワッテ居ルト石ガカケテトンデキテ、ソレガムネニアタッテ、タオレテ家ヘハコバレテキタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "「白骨ノ温泉ニ到着ス病気コノ地、秋ヨリ冬ニカケテハ、旅宿ハ戸ヲ釘ヅケニシテ里ニ去ル例ナレドモ、今年ハ珍シク冬籠リノ客多数居残リヲレリ……」といった程度の文章で、歌もなければ、発句もない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "鈴慕の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オレハ次第ニ貧乏ニナルシ、仕方ガ無イカラ妙見宮ヘムリノ願ヲカケテ、今一度困窮ノ直ルヨウニト、百日ノ行ヲハジメタガ……」　それ見たことか、敵わぬ時の神頼みだ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサンガ迷子ニナルカモシレナイトオモツテ、アトカラ、オツカケテキタトコロデス。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎日、高イ木ノ枝ニ腰カケテ、四方ヲミマワシテ、何カヲサガシテヰル様子デス。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オバアサンハ、セイヨウネコデシタカラ、ナイト・キヤツプトイフヅキンヲカブツテ、ナイト・ガウントイフネマキヲキテ、メガネヲカケテヰマス。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "郵便配達ノダテウサンハ、キシヤヨリモハヤクカケテ、ソレヲ、モンコチヤンノオ家ヘトドケマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒニ　テラサレテ　オマンヂウガ　ウマク　ヤケルマデ　ジロウハ　ウマニナツテ　スナノウヘヲ　トホクマデ　カケテユキマシタ。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　オモテニハ　タタミガ　ズラリト　ナラベテ、タテカケテアツテ、　トン　トン、バタ　バタ。",
              "citation": {
                "source": "オホサウヂ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゴムフウセン櫻間中庸　ボク　カケテツタ　カケテツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "セエタアノポケツトカラ　キヤラメルガ　トビダシサウデ　トビダシサウデ　ボク　カケテツタ　カケテツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボクウレシクテ　ウレシクテ　タカヲチヤンノウチノ　ゴモンノハウヘ　カケテツタ　カケテツタ。",
              "citation": {
                "source": "ゴムフウセン",
                "author": "櫻間中庸",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君………」ト云イカケテオ前ト云イ直シ、「オ前ニモ面白味ガ分ルカネ」ト浄吉ガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ幾分予ガケシカケテ、左様ニシムケタ気味合イモアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜｜盂蘭盆ノ送リ火ヲ済マスト間モナク颯子ハ出カケテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "後楽園ジムニ全日本フライ級タイトルマッチガアルンダ」「年寄ノ冷水ネ、ソンナ所ヘ出カケテ行ッテ怪我デモナサラナケレバイヽガ」二十三日。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕刻カラ出カケテ一泊シテ、翌日午前中ニ戻ッテ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "湯カラ上ルト、ウシロカラタオルデ拭キ、ベビーパウダーヲ振リカケ、扇風機ヲカケテクレルガ、決シテ前ヘハ廻ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ薬ガ利イタト見セカケテ寝タフリヲスル積リダッタガ、ツイ本当ニ寝テシマッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ寝室ノベッドニ腰カケテ一ト休ミシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
