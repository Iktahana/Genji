          "literary": [
            {
              "text": "私はカジカンだ手で竿を畳み、子供たちの方へ堤の上を歩いて行つた。",
              "citation": {
                "source": "氷雨",
                "author": "葉山嘉樹",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾々が寒さを感じてカジカンデいる時でも植物には一向それが平気なものである。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼が鈍い、頭が悪い、心臓が狭い、腕がカジカンでいる、どの性質にも才能にも優れたものはない、――しかも私は何事をか人類のためになし得る事を深く固く信じています。",
              "citation": {
                "source": "ある思想家の手紙",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
