        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サテ　チヤウサンハ　ウチニ　カヘルト、サツソク、ロバニ　ヒカセル　クルマヲ　ツクリハジメマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのたわけ物語の書出しに、「オレホドノ馬鹿ナ者ハ世ノ中ニモアンマリ有ルマイト思ウ故ニ、孫ヤ彦ノタメニ話シテ聞カセルガ、ヨク不法モノ、馬鹿モノノイマシメニ話シテ聞カセルガイイゼ」と言っている通り、馬鹿も度外れの馬鹿になっている。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モ、予ト二人キリノ時ニ限ッテワザト昔ノ俤ヲチラツカセルコトハアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アタシ一人デ寝カシテ戴クワ、オ爺チャンハ佐々木サントオ休ミナサイヨ」「ナゼサ、一緒ニ寝テクレタッテイヽジャナイカ、東京デモ時々ソウシテクレテルジャナイカ」五子ニ聞カセルタメニ予ハワザト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ先ズ奈良アタリノ絵心ノアル佛工ニ命ジテ、今宮神社ノ四面佛ニ倣ッテ線彫リニシタ勢至菩薩ノ像ニ似タモノヲ描カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ颯子ノサマ／″＼ナポーズノ容貌ト姿体ノ写真ヲ示シ、菩薩ノ顔ト胴ト四肢トヲソレトナク彼女ノソレラニ似ルヨウニ畫カセル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ五子ヲ佐々木ノ案内役ニ附ケテ行カセルコトニシテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "事ニヨッタラ範囲ヲ蹈ミ越エタノデハアルマイカ、ト、多少疑イヲ抱カセルクライデアッテモヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "キワドケレバキワドイホドヨイ」、―――「多少疑イヲ抱カセルクライデアッテモヨイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタシノホシヘ、ツレテイク、ソシテ、ホシノヒトニ、ウツクシイ、チキューノ、オンガク、キカセル。",
              "citation": {
                "source": "宇宙怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
