    "definitions": [
      {
        "index": 1,
        "gloss": "under-shoulder swing-down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "立ち合いの瞬間に横へ飛び退き、鮮やかな肩透かしで巨漢力士を土俵に這わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「おっと、今の決まり手は肩透かし！ 相手の勢いを上手く利用したね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "突き押しを得意とする力士にとって、不意の肩透かしは最も警戒すべき技の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "放庵そのものも確かにさうした人物の一人に加へても差支へはなからうし、またさうした人物と共通した「人生の味」を体験してゐるといへよう、芋銭の作品もこれはまた人生を呼吸ぬき、肩ぬき、肩透かし、うつちやりの連続で生き抜いたといふ感を抱かせる。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず降り立ったロサンゼルスで四日間を過ごしたが、新聞が大きく報じるほどのめずらしい連日の雨続きで、「カリフォルニアの青い空」がさっぱり拝めないのには肩透かしを食った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのいきおいが、あまりはげしくて、つきたおされそうなので、小林君は思わず、一方へ身をかわして、かたすかしをくわせました。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、いまにも、こちらへつかみかかってくるかと、身がまえていますと、恐怖王はかたすかしをくったまま、小林君のそばを通りぬけて、玄関のほうへ矢のように、かけだしていってしまったではありませんか。",
              "citation": {
                "source": "仮面の恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな調子にまたうかうか乗せられたなら、前のように肩すかしを食わされるのである。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "普段なら興味津々で飛びついてくるはずの話題を、苦虫を噛みつぶしたような表情で聞き流している渡辺の姿に、勢い込んで報告した後藤富雄は肩すかしをくったようなもの足りなさを感じていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビル・ゲイツを一目見たとき、渡辺は肩すかしをくったような軽い失望を覚えていた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分と同じやうなものをもう何人か厭きるほど扱ひ慣れ、これにたくみに肩すかしを喰はせる人間の一つの手なのではないか？",
              "citation": {
                "source": "生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "わが友人はこの肩すかしにも気落ちする様子はなく、ただなかば愉快に受け入れるがごとく肩をそびやかす。",
              "citation": {
                "source": "三枚の学生",
                "author": "THE ADVENTURE OF THE THREE STUDENTS",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとずっと若い、十二、三の子どもものじゃよ」「ちぇッ」　みごとにまた右門得意の肩すかしに出会って、伝六はちぇッと舌を鳴らしながらそっぽを向きましたが、反対に右門はおおまじめでありました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "身代わり花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "気負いこんでいた慶一は、肩すかしを喰らって、頭に血をのぼらせながら、四〇七にむかった。",
              "citation": {
                "source": "45回転の夏",
                "author": "第２章　メリーゴーラウンド、１９６７年",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度、肩すかしで投げられた事がある」「この頃、社長の星浦さんの我儘娘を貰うことになっているんだ……中野さんが……」「知っとる。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが私は見事に肩すかしを食わされたではないか。",
              "citation": {
                "source": "光の中に",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い男は肩すかしを喰わされたような気がした。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "七　ダーッと、踏み込んで行った捕方たち、――それを、肩すかしで、かわしたように、家内から飛び出して来た、黒い人影――　――あ？",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「極秘のマッチの成分なら、君がたの方がよく知っているじゃないか」　と、帆村は肝腎のところで相手の激しい詰問に対し、軽く肩すかしを喰わせた。",
              "citation": {
                "source": "流線間諜",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "地図に無い沼を偶然に発見して、ハイカーらしく胸を躍らせていた川島は、見事に肩すかしを喰ったような気持だった。",
              "citation": {
                "source": "植物人間",
                "author": "蘭郁二郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "百々子は完全に肩すかしを食い、「御座った頭にはかなわない」　などと、つぶやいていたが、それはこちらの認識不足で、千々子さまは、そうして見事に釣りだしに成功した。",
              "citation": {
                "source": "我が家の楽園",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "角力のいわゆる肩すかしだ。",
              "citation": {
                "source": "越後の闘牛",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "私に身をかわされたので、熊は肩すかしでも喰ったように、僅かに前脚の掌が私の腕の筒袖に触れただけで、前の方へ突っ走りました。",
              "citation": {
                "source": "熊狩名人",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "それなのに、その黒いアーチをくぐって中に入った時の第一印象は肩すかしとしか云いようがなかった。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、その宿題を果す日が来たと思ったのに、奇妙な肩すかしを食わされた。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "おもてむきは地域社会の発展をとなえつつ、電力会社は裏ではこんなことをやるのだと攻撃を鋭くしていくと、電力会社は肩すかしのような妥協案を出した。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "教室の中で、国定教科書を通してしか結びつくことをゆるされないそらぞらしい教師と生徒の関係、たとえ生徒のほうでかってに関をのりこえてこようとも、上手に肩すかしをくわさねば、思いがけない落とし穴があることを知らねばならなかった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "今思うとその衝動も、各人によって少しずつ異っていただろうが、おれはと言えば、強い風に逆らって歩いていて、いきなりぱたっと風が止み、肩すかしを食ってよろめくような、そしておそろしく不安定な気持がした。",
              "citation": {
                "source": "赤い駱駝",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
