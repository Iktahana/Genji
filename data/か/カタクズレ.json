    "definitions": [
      {
        "index": 1,
        "gloss": "losing shape (of clothing, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
