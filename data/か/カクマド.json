          "literary": [
            {
              "text": "角窓のそのひとつの内部に光のない青いメタンの焔が燃えてるらしい。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しその薄黒く潮風に吹き曝された角窓の裏に一人物を画き足したなら死竜は忽ち活きて天に騰るのである。",
              "citation": {
                "source": "幻影の盾",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中庭を囲繞して三つの城砦が立っていたが、三つとも巨大な角窓を中庭の方へ向けている。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
