        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "職人たちは、厳冬期に寒晒しで蕎麦粉の灰汁を抜く、伝統的な製法を守り続けている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "寒晒しにした大根は甘みが増し、昔ながらのたくあん漬けには最適だと言われる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "冬の滝行で寒晒しを行う修行僧たちの姿は、見る者の心に深く刻まれるものがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "むかしは武士のカラ脛、奴の尻の寒晒し。",
              "citation": {
                "source": "洋服論",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれからずつとおれらは逃走してやつて來たのだあの遠い極光地方で　寒ざらしの空の下をみんなは栗鼠のやうに這ひ※つたいつもおれたちの行くところでは暗愁の、曇天の、吠えつきたい天氣があつた。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "冬の寒ざらしの貧しい田舍で愚鈍な　海牛のやうな農夫よ。",
              "citation": {
                "source": "蝶を夢む",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "また「死ぬほど惚れても貧乏人はいやだ、出来りゃ吾が児が寒ざらし」などいう俚謡もある。",
              "citation": {
                "source": "貧富幸不幸",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "若くはこの寒ざらしの風のなかで、　せめて眞裸にでもなつて見ろ！",
              "citation": {
                "source": "展望",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒ざらしの風が地をドツと吹いて行く。",
              "citation": {
                "source": "展望",
                "author": "福士幸次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カタクリの根は例のカタクリ粉の本物の原料になるのだが、なかなか掘るのにめんどうらしい上、製造に手数がかかるので、今ではこの寒ざらし粉はむしろ貴重品だ。",
              "citation": {
                "source": "山の春",
                "author": "高村光太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒ざらし、裸にして雪の庭へ坐らせるなどとそうとうの拷問もあったようだ。",
              "citation": {
                "source": "二合五勺に関する愛国的考察",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、夜夜の寒ざらしの月がばつさりと、砥がれて光を投げる。",
              "citation": {
                "source": "星より來れる者",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕なんか数学の時間は始終｜寒ざらしでした」「そんなだったかね。",
              "citation": {
                "source": "母校復興",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒晒の粉のつぶつぶした、皮鯨に似た菓子である。",
              "citation": {
                "source": "挿話",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅白の美しい寒晒粉を茹上げた玉幾つ、これに氷を交えて三盆白をふりかけた奴を匙で口にした気持ち、それが食道を通って胃腑におちいた時には骨の髄までも冷さが沁入るようで、夏の暑さもサラリと忘れたよう、何が旨い彼が好いと言ってからが、この味いはまた格別。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
