[
  {
    "uuid": "2512616f-9ca2-54a9-956f-e903e6ebd257",
    "entry": "買い集める",
    "reading": {
      "primary": "かいあつめる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
