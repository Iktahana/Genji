    "definitions": [
      {
        "index": 1,
        "gloss": "to buy up",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はコーヒーの産地ごとの豆を世界中から買い集めて比較試飲を楽しんでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "古地図を買い集めるのが彼の長年の趣味だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "業者が廃業した書店の在庫を丸ごと買い集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "」「それじゃ、お前は、僕の名前の出ている本を、全部片っ端から買い集めることが出来るかい。",
              "citation": {
                "source": "眉山",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを其の時、方々から買い集めるのでは費用もかかり手数もかかると、男は考えたのである。",
              "citation": {
                "source": "愚かな男の話",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "こまこました土産物などを買い集めるに腐心しているお銀の頭にも、笹村の郷里へ対する不安が始終附き纏っていた。",
              "citation": {
                "source": "黴",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "中学校三年のときには、祖母にねだってリレーなどの部品を買い集める資金を得て、計算機の手作りも試みた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "お内儀さんは先に亡くなった大主人が、骨董を買い集めるのを、たいそう嫌がったそうだな」「それはもう、私にとっては、あんな嫌なものはございません。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "茶碗割り",
                "note": "青空文庫"
              }
            },
            {
              "text": "二週間後の決済日が来る頃には仕手戦が終わり、言い値で買い集めるぞ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "太田ミサコは売あびせのために底値を入れた××新株の反撥を予想して買いあつめると、雑株安をねらって、引たたぬ××百貨店株を後場引値で、これを指名人に買わすとさっさと場内を引あげた。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「なんぼ土産にするといって、こんなに南京玉を買いあつめる奴もあるめえ。",
              "citation": {
                "source": "半七捕物帳",
                "author": "雪達磨",
                "note": "青空文庫"
              }
            },
            {
              "text": "この物資不足の折柄、むだにすてられようとする物や、使われもせず家の中にしまいこまれた物を、買いあつめる商売だ。",
              "citation": {
                "source": "未来の地下戦車長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しきりに沿線各駅で子供の絵本を買いあつめる。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "それにしても、よほど本がすきでなくては、これほど買いあつめることはできません。",
              "citation": {
                "source": "夜光人間",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "書物を単なるアクセサリか骨董品のように買いあつめる集書家のあることを諷している。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでこの孤児院の組織のことは長いことでございますから、今ここにお話し申しませぬけれども、前に述べた二百万ドルをもって買い集めましたところの山です。",
              "citation": {
                "source": "後世への最大遺物",
                "author": "内村鑑三",
                "note": "青空文庫"
              }
            },
            {
              "text": "先ず、その品々を買い集め、それから都の大路をぶらぶら歩いた。",
              "citation": {
                "source": "走れメロス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　大隅君が北京から、やって来るというので、家の者が、四、五日前から、野菜やさかなを少しずつ買い集め貯蔵して置いたのだ。",
              "citation": {
                "source": "佳日",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そんな考えから、親爺は、借金や、頼母子講を落した金で、ちびり／＼と田と畠を買い集めた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親爺は、やはりちびり／＼土地を買い集めていた。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕入先は難波の元屋で、ここで屑値で買い集めた古本をはがして、連絡もなく、乱雑に重ねて厚みをつけ、もっともらしい表紙をつけ、縁を切り揃えて、月遅れの新本が出来上る。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "その奥さんというのが病気だから、その日その日に追われて、昼間は温泉場の飲食店をまわって空壜を買い集め、夜は八卦見に出ているのだと言った。",
              "citation": {
                "source": "雪の夜",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕入先きは難波の元屋で、そこで屑値で買い集めた古本をはがして、連絡もなく乱雑に重ねて厚みをつけ、もっともらしい表紙をつけ、縁を切り揃えて、月遅れの新本が出来上る。",
              "citation": {
                "source": "放浪",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は秋葉原でマイクロコンピューターやメモリーのＬＳＩを買い集め、自ら設計してコンピューターのシステムを自作していた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "この市場に早急に、可能なら一年以内に乗り込んでいくためには、パーソナルコンピューターの会社を買収するか、製品は自社の技術で作るというＩＢＭの大原則からはずれて、マシンの構成要素を外部から買い集めて開発するしかない。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "晴れて大学生となった西は、おばあちゃんの財布を存分に活用して山のように本を買い集め、グライダーの練習に手を染めた★。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "早水は計画部の平賀正豊と二人で年末商戦で賑わう秋葉原を歩き、ＰＣ―８００１やシャープのＭＺ―80、日立のベーシックマスターなど八ビットの人気機種用のアプリケーションを片っ端から買い集めはじめた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "職人気質の父にさっぱり商売っ気がないことを承知していた古山は、ウサギを飼って小遣いを稼ぎ、部品を買い集めてはラジオや電車の模型を組み立てることを覚えた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "部屋には、東京で世帯を持った時、父親が小マメに買い集めた道具などがきちんと片着いて、父親が蒲団の端から大きい足を踏み出しながら、安火に寝ていた。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "吾平爺は一台の古い荷車を買い、近所の農家から野菜を買い集めて、毎朝それを神田の青物市場へ曳いていくことにした。",
              "citation": {
                "source": "或る嬰児殺しの動機",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その三十七　阿部家への帰参が※って、枳園が家族を纏めて江戸へ来ることになったので、抽斎はお玉が池の住宅の近所に貸家のあったのを借りて、敷金を出し家賃を払い、応急の器什を買い集めてこれを迎えた。",
              "citation": {
                "source": "渋江抽斎",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "一度は、家主の植長がどこからか買い集めて来てくれた家具の一つの唐机に向って、その書いて見るということに著手しようとして見たが、頭次第だと云う頭が、どうも空虚で、何を書いて好いか分らない。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "石田は翌日米櫃やら、漬物桶やら、七釐やら、いろいろなものを島村に買い集めさせた。",
              "citation": {
                "source": "鶏",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
