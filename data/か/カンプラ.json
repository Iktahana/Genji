        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だけれども、親愛なるジャガイモ、私の祖母たちはカンプラと東北の呼名で呼んだ馬鈴薯の種を、どこへまいたら、育って花を咲かせて、米の足しになるようなみのりかたをするだろうか。",
              "citation": {
                "source": "昔を今に",
                "author": "――なすよしもなき馬鈴薯と綿――",
                "note": "青空文庫"
              }
            },
            {
              "text": "納れなかったのね狭いカンプラ畑では。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "で、その山の頂上まで十｜丁程ある所を下僕二人に負ぶさって昇りましたけれども、何分にも痛くて動けませんので二日ばかり山中に逗留いたし、幸いにカンプラチンキを持って居りましたから自分でよく腰を揉んでそれを塗ったり何かしたので、格別の事もなく治ってしまいました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の手の痛い所へはカンプラチンキを塗り少し休息して居りましたが、日は既に暮れて星の光と雪の光が闇を照して居るだけであります。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "さっそくカンプラチンキを拵えてやりました。",
              "citation": {
                "source": "チベット旅行記",
                "author": "河口慧海",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に馬鈴薯にも、早又カンプラ薯の名が出來て居るのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に馬鈴薯にも、はやまたカンプラ薯の名ができているのである。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
