        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "毎年夏になると、テレビでは怪談ものの特番が組まれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は怪談ものが苦手で、心霊系の映画は絶対に観ないと決めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "その作家は怪談ものを得意とし、背筋が凍るような短編を数多く残している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "」　もしもそこに品物の持ち主の死骸が沈んでいるとするなら、怪談ものです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや近項江戸にも珍しい怪談ものじゃ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "水死人に絞め殺した紐痕が見ゆるとは、愈々怪談ものじゃ。",
              "citation": {
                "source": "旗本退屈男　第十話",
                "author": "幽霊を買った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "側には川波勝弥を怨んで死んだ娘の、懐ろ鏡が落ちて割れているなんざ、そっくり怪談ものじゃありませんか」「なるほど、そいつは面白そうだ。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "懐ろ鏡",
                "note": "青空文庫"
              }
            },
            {
              "text": "側には川波勝彌を怨んで死んだ娘の、懷ろ鏡が落ちて割れてゐるなんざ、そつくり怪談ものぢやありませんか」「成程、そいつは面白さうだ。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "懷ろ鏡",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
