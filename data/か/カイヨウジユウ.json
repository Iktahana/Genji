        "examples": {
          "standard": [
            {
              "text": "国際法では、公海における海洋自由の原則が認められている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海洋自由の考え方は、近代国家の成立とともに発展した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "漁業権と海洋自由のバランスをとることが、現代の課題となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "海洋自由問題の鍵１・11（夕）　海洋自由の問題が、英国と米国との間にどうやら難かしいこだはりを拵へさうになつて来た。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "海洋自由の問題も、どうかしてこんな事で解決はつかないものか知ら。",
              "citation": {
                "source": "茶話",
                "author": "大正八（一九一九）年",
                "note": "青空文庫"
              }
            }
          ]
