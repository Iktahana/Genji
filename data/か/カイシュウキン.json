          "standard": [
            {
              "text": "回収金の額はまだ確定していない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "回収金をどのように配分するかについて協議する必要がある。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "予想以上に回収金が多かったことに驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "社長はけさ、君の欠勤の理由はあれだろうとほのめかして聞かせてくれはしたが――つまり最近君にまかせた回収金のことだ――、私はこの説明が当っているはずはない、とほんとうにほとんど誓いを立てんばかりにして取りなしておいた。",
              "citation": {
                "source": "変身",
                "author": "DIE VERWANDLUNG",
                "note": "青空文庫"
              }
            }
          ]
        }
