        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "あ、この単語、スペルを書き間違えちゃった！",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "子供が漢字ドリルで、よく似た字を書き間違えるんです。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "請求書の金額を書き間違えて、再発行してもらう羽目になったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "或は私が書き間違えたのかしら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四〇年（昭和十五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "作文道楽もいいが、こうした書き間違えは影響する処大きい。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後一度新家庭へ敬意を表そうと思っても、昼間伝票を書き間違えまいと努力するから夜分｜草臥れてしまって出掛ける気にならない。",
              "citation": {
                "source": "負けない男",
                "author": "佐々木邦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
