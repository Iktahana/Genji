          "literary": [
            {
              "text": "岩の平たい割面には、字句が刻んであった。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "簡単な濃灰色の石片の割面に、文字を刻んだものは、我国でも、墓地で見受ける或種の記念碑の代りとして、使用するとよい。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
