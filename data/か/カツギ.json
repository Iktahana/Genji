[
  {
    "uuid": "dd69b8e4-e8a2-5976-b0f0-af51e68cca65",
    "entry": "担ぎ",
    "reading": {
      "primary": "かつぎ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
