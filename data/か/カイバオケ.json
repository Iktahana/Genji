        "examples": {
          "standard": [
            {
              "text": "農場の馬小屋には、古い木製の飼い葉桶が何個も並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "毎朝、係員は飼い葉桶に新鮮な草を詰める。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "石造りの飼い葉桶は、何百年も前のものだと推定されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "飼い葉桶に寄ってくる豚のようだ。",
              "citation": {
                "source": "老人と海",
                "author": "THE OLD MAN AND THE SEA",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中でいつもの吐き気を催させる食堂をのぞくと、そこには飼い葉桶の前に並んだ動物のように十八人の会食者がたらふく食べている姿が見えた。",
              "citation": {
                "source": "ゴリオ爺さん",
                "author": "Le Pere Goriot",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
