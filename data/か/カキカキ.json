        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "つんのめり、這いあがり、ずり落ち、木の根にすがり、土を掻き掻き、少しずつ少しずつかず枝のからだを林の奥へ引きずりあげた。",
              "citation": {
                "source": "姥捨",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "おら堪んなくなって、ベソを掻き掻き、おいおい恐怖くって泣き出したあだよ。",
              "citation": {
                "source": "海異記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小菅は頭を掻き掻き言つた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八蔵は頭を掻き掻きありし事ども物語れば、銀平は、驚きつまた便を得つ、「ふむ、それでは下枝は滑川の八橋楼に居るんだな。",
              "citation": {
                "source": "活人形",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭を掻き掻き八戒が現われる。",
              "citation": {
                "source": "悟浄歎異",
                "author": "―沙門悟浄の手記―",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある日もド・モルガンが音楽の事で、何か冗談をいふと、弟子は頭を掻き掻き言ひわけをした。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "役人、商人、芸妓、学生……さういふ連中は大事な瀬戸物を毀しでもしたやうに、てんでに頭を掻き掻き、博士の前へ出て来る。",
              "citation": {
                "source": "茶話",
                "author": "大正七（一九一八）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "まるで幽霊にでも出会ったような気持ちで、何はともあれ無事を祝し合った訳でしたが、それにしても、どうしてコンナに突然に帰って来られたのかとお尋ねしますと、正木先生は昔にかわらぬ磊落な態度で、頭を掻き掻きこんなお話をされました。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に、どうしていいかわからないままタッタ一人で頭を掻き掻きそこいらを見まわした。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "三好が帽子を脱いで頭を掻き掻き云った。",
              "citation": {
                "source": "オンチ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "捨吉は頭を掻き掻きお婆さんのくれた水ですっかり火を消した。",
              "citation": {
                "source": "桜の実の熟する時",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿岳さんの画には最う懲り懲りしたと、楢屋はその後椿岳の噂が出る度に頭を掻き掻き苦笑した。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "千鶴子は雨に濡れた矢代の胸のボタンを爪で掻き掻き、ちょっと首を傾けた嬌奢な笑顔で何か云いたそうに唇を動かしたが、その間に箱は上まで昇ってしまった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "何か云われたらしく塩野はすぐ頭を掻き掻き矢代の方へ歩いて来た。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、乙まも※しめたやうな手拭の頬冠りを取つて、薄のやうな白髮頭を掻き掻き笑つた。",
              "citation": {
                "source": "太政官",
                "author": "上司小劍",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでとうとう我を折って、今夜松浦様へ小鬢を掻き掻き、つぶさに事情をお話しすると、では主税めを捕らえてしまえとな。",
              "citation": {
                "source": "仇討姉妹笠",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」小びんを掻き掻き現われた。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し、三四年前、長い間、今病室になっている書斎で相談した祐之助が、「――どうも義兄さんには敵わないや」と、延した小指の爪で、髪のわけめを掻き掻き照れかくしの剽軽た風で茶の間に出て来て以来、上京しても、ほんの申わけに顔を出すぎりになった。",
              "citation": {
                "source": "墓",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "大原も頭を掻き掻き食卓の前に進み「僕はあまり遅くなると困るからね」中川「マアいいさ、一つ二つ食べて行き給え。",
              "citation": {
                "source": "食道楽",
                "author": "秋の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "隠居仕事に、食料を商る連中の何時も集る緑のベンチ、今日も彼等はステッキで砂を掻き掻き大真面目何か契約上のこと、論議し合つてゐるのです、何れお金のことでせう、扨『結局……』と云つてます。",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「いやどうも、―――」と、橋寺は頭を掻き掻き、「―――今日はいじめられるこッてすな」「何を仰っしゃるのよ、いじめるどころか為めを思って上げてますのよ。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は彼女に潰されまいと一生懸命に力み返って、汗を掻き掻き部屋を廻ります。",
              "citation": {
                "source": "痴人の愛",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "猪之は頭を掻き掻き、つまり暫くほとぼりをさまそうと思うんだ、と云った。",
              "citation": {
                "source": "赤ひげ診療譚",
                "author": "三度目の正直",
                "note": "青空文庫"
              }
            },
            {
              "text": "「遅いなあ壮太君、僕はもう一仕事やってきちゃったぜ」　壮太は頭を掻き掻き立上った。",
              "citation": {
                "source": "黒襟飾組の魔手",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "くそばばめ」　ベソを掻き掻き、※哥はそこら中にころがり出した梨や杏を籠へ拾いあつめ、あとも見ずに、その日はついに逃げ出してしまった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "近所の顔と顔の一トかたまりは、みなベソを掻き掻き、いやおうなしに、ただ杯を上わの空に、上げたり措いたりしているに過ぎなかった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "今のみつともない手ちがひが、彼の頭の中をあつさり一と掻き掻き廻したのである。",
              "citation": {
                "source": "四人",
                "author": "芥川多加志",
                "note": "青空文庫"
              }
            },
            {
              "text": "……またベソを掻いてんのか」「何だか、思い出しちまった」「よせやい、てめえがベソを掻き掻き誦むもんだから、おれっちまで、変てこに、涙が出て来やがるじゃねえか」六　無法者にも、親があった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻緒の切れた足駄の片ッ方を番傘の柄と一しょに持って、ベソを掻き掻き、登り降りした坂道だった。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "新しい角帯前垂れを着せられて、ベソを掻き掻き近藤小母さんに連れられて行った初奉公のぼくは、勿論、店の表つきを見て這入ったわけではない。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
