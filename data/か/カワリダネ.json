    "definitions": [
      {
        "index": 1,
        "gloss": "something out of the ordinary",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「このピザ、納豆とハチミツが乗ってるの？」「変わり種だけど、意外とクセになる味だよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "最近の自動販売機は変わり種が多くて、だし汁や昆虫食まで売っていて驚かされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "文房具屋の隅で見つけた、芯が七色に変化する変わり種の鉛筆を思わず衝動買いした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今日のお弁当、母さんが変わり種の春巻きを作ってくれたんだ。中身はチョコバナナ！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし世界の広い学界の中にはまれに変わり種の人間もいて、流行の問題などには目もくれず、自分の思うままに裸の自然に対面して真なるものの探究に没頭する人もあるから、いつの日にかこれらの物理学圏外の物理現象が一躍して中央壇上に幅をきかすことがないとも限らないであろう。",
              "citation": {
                "source": "物理学圏外の物理的現象",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほほうのう、ちっとこりゃ変わり種かもしれねえな」　つぶやきながら、じろじろと見ながめていた様子でしたが、やがてずばりと名人の断定するがごときことばが放たれました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "曲芸三人娘",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「おめえみたいな変わり種もたくさんねえといってるんだ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "七七の橙",
                "note": "青空文庫"
              }
            },
            {
              "text": "その中を長いキセルでぽかりぽかりと悠長な煙を吐きながら、変わり種の清正が美人の妓生とぬれ場をひとしきり演ずるというのですから、ずいぶんと人を食った清正というべきですが、それよりももっと見物をあっといわした珍趣向は、そのぬれごとのせりふが全部朝鮮語であるということでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "南蛮幽霊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちとこれは変わり種だな」　あごをなでなでじろじろと目を光らして、その人体を子細に見調べました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "のろいのわら人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "変わり種の名人はだがそうさせるのか、千人彫りの秘願といったその念願がそうさせるのか、まるで伊三郎は魂を奪われているかのようでした。",
              "citation": {
                "source": "右門捕物帖",
                "author": "朱彫りの花嫁",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、私のことにすると、単に寄席の高座へばかり上がりたかったのではなく、一個、変わり種の落語家として、じつはあっぱれ宝塚の大舞台へ一枚看板で押し上がり、彼女を見返してやりたかったのだ。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "圓馬夫人は文士というのは学者のような堅苦しいものであると確信し、その文士の中でも私のごときは進んで芸人社会へ飛び込んでいったりしている変わり種の存在であるという点を、当初に計算してかかられなかったため、いたずらにお互いが悲劇を将来してしまったのではある。",
              "citation": {
                "source": "わが寄席青春録",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "さきごろから、変わり種が一つふえた……というのは。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは落語の種明かしであるが、そもそもこの落語をこしらえた人は、二代目林屋正蔵という坊さんの出で、俗にタクゼン正蔵といい、仏教普及のためにはなし家になったという変わり種。",
              "citation": {
                "source": "江戸前の釣り",
                "author": "三遊亭金馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "故関根｜正二氏の「信仰の悲み」でも、今の変り種の絵とはどうもちがった腹の底から来る熱が籠っていると思われる。",
              "citation": {
                "source": "二科展院展急行瞥見記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達｜孟買在住の日本人にとっては珍らしい変り種にちがいないのです。",
              "citation": {
                "source": "孟買挿話",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "変り種は地方廻りのオペラコミックの女役者と乞食が一人あった。",
              "citation": {
                "source": "生々流転",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もそッと致せとおっしゃったって、旦那のような変り種の殿様に出られりゃ気が抜けちまわあ。",
              "citation": {
                "source": "旗本退屈男　第六話",
                "author": "身延に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "旦那のような変り種は臍の緒切って初めてでございますよ。",
              "citation": {
                "source": "旗本退屈男　第五話",
                "author": "三河に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "御老体もちと変り種でござりまするな」　変り者たる点に於ては決して人後に落ちる退屈男でないが、これはいかにも大変りでした。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "解秋和尚から眼薬をさしてもらつた（此寺へは随分変り種がやつてくるさうな、私もその一人だらうか、私としては、また寺としても、ふさはしいだらう）。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこまで君には手数が掛るんだろう」と法水は眼で大袈裟な表情をしたが、「ところで支倉君、最近現われた探偵小説家に、小城魚太郎という変り種がいるんだが、その人の近著に『近世迷宮事件考察』と云うのがあって、その中で有名なキューダビイ壊崩録を論じている。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしの庭にも紅白は勿論、むらさきや樺色の変り種も乱れて咲き出した。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間はその恩恵にそむいて、無用の労力を費し、無用の時間を費し、無用の金銭を費して、他の変り種のような草花の栽培にうき身をやつしているのである。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "例の変り種は」と自分が聞いて見ると、父は苦笑いをして「実は朝貌もあまり思わしくないから、来年からはもう止めだ」と答えた。",
              "citation": {
                "source": "行人",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "数ふる道楽のうちで、殿様は一番変り種の小鳥や獣が好きで、自分の力で手に入れる事が出来る限り、いろんな物を飼つて娯しんでゐた。",
              "citation": {
                "source": "茶話",
                "author": "大正五（一九一六）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "氏に就いての印象は、遠慮のないところ、世にも不可思議な存在で、氏は自身に、「私は白人の中でも変り種です。",
              "citation": {
                "source": "戦場",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "もっとも隠元豆にも色々あるそうで、何十通りとか変り種がある。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女は学士が植えて楽む種々な朝顔の変り種の名前などまでもよく暗記んじていた。",
              "citation": {
                "source": "岩石の間",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "村木博士の邸内には、桜はもうとっくに葉になって、あちこちの庭石のかげに、紅白さまざまの変り種の躑躅が咲いていた。",
              "citation": {
                "source": "人造人間",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "椿岳の画を愛好する少数｜好事家ですらが丁度朝顔や万年青の変り種を珍らしがると同じ心持で芸術のハイブリッドとしての椿岳の奇の半面を鑑賞したに過ぎなかったのだ。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "市民としても文学者としてもいわば変り種であるローレンスは、そのようなイギリスの中流、上流社会に対して感じるすべての妥協しにくさを、肉体的な感覚の世界へとけこむことで、宇宙的な生命感の中へ意識をとけこませることで、ヒューマニティーの解放を見出そうとした。",
              "citation": {
                "source": "傷だらけの足",
                "author": "――ふたたび純潔について――",
                "note": "青空文庫"
              }
            },
            {
              "text": "本所の化物屋敷と呼ばれるこの家に今宵とぐろをまいている連中は、元小十人、身性が悪いので誘い小普請入りをいいつかっている土生仙之助を筆頭に、いずれも化物に近い変り種ばかりで、仙之助は、着流しのうしろへ脇差だけを申しわけにちょいと横ちょに突き差して肩さきに弥蔵を立てていようという人物。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中でへんなやつに掠われたがそれもまた、もうひとり変り種があらわれて取り返してくれた――あの一くせある、風格の乞食はいったい何者であろう？",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
