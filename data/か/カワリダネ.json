[
  {
    "uuid": "65c71a8b-28bc-561b-9828-c74fb6e6528d",
    "entry": "変わり種",
    "reading": {
      "primary": "かわりだね",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
