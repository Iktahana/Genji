  {
    "uuid": "e58fadbe-7c40-5742-99e8-dcfa3f9bd0c2",
    "entry": "絡繰",
    "reading": {
      "primary": "からくり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
