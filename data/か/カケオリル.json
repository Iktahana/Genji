    "definitions": [
      {
        "index": 1,
        "gloss": "to run down (stairs, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ベルが鳴ると、子どもたちは一斉に階段を駆け下りた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "遅刻しそうになり、彼は駅のホームへ続く坂道を駆け下りた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "高い丘の上から、あっという間に麓まで駆け下りてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "僕は頭に血が上って、駆け下りるや外を突っ切って走っていきました。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "嘲笑　刑事は蒼くなって二階から駆け下りると表へ飛出した。",
              "citation": {
                "source": "支倉事件",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほどけた帯を踏んで危うく倒れようとして帯に手をやった時、覚えずその手に触れたのが、土蔵の二階から駆け下りる時に手に触れた脇差であります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "禹門三級の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨の日にはカラコロ／＼と石段を駆け上り駆け下りるわが高下駄党の多いことは格別である。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それをかばって小走りに駆け下りる、今度は膝頭が痛い。",
              "citation": {
                "source": "黒部川奥の山旅",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はＴ先生の其処にゐることなどは忘れてしまつて見むきもしないで下にかけおりるなり真暗な教室に荷物をとりにはいりました。",
              "citation": {
                "source": "嘘言と云ふことに就いての追想",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから　５分も　すると　ふたりして　いきを　切らしながらも　おうし土手を　かけおりる　ウサギたち、　ふくろを　なかば　引きずるように　かかえていて　時には　草に　どしんどしんと　当たることも。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ねずみがすたこらかけおりる。",
              "citation": {
                "source": "まざあ・ぐうす",
                "author": "北原白秋訳",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘は最後の階段をかけおりると、彼より一つ上の段に立ち止まって、ぴったり彼に顔を突き合せた。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "バタバタと二階からかけおりる音がして、コックの恐怖にひきつった顔があらわれました。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は殆ど五分間の間経験のない焦燥に攻められながら、もじもじしていましたが、やがてたまらなくなって、いきなり立上ると、どうするという当もなく、兎も角も部屋を出て、すぐそばの広い階段をかけおりるのでした。",
              "citation": {
                "source": "湖畔亭事件",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、やっぱり、ニヤリニヤリと笑いながら、いそいで、階段をかけおりるのでした。",
              "citation": {
                "source": "怪奇四十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "今はじゅうたんの上を走るだけでなくて、安楽いすや、そこにあるテーブルの上にかけあがり、かけおりるのです。",
              "citation": {
                "source": "鉄塔の怪人",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、だ、だ、だ、だと、階段をかけおりる靴音！",
              "citation": {
                "source": "黄金豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "危険な瀬踏も承知の前である、真っ先に私がブリッジを駈け降りると、続いて庄亮、その他のロッペン団員がおなじく斜めの飛沫で濡鼠になりながら、パッパッパッと伝馬へ躍り込む。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りは下り坂を面白半分に駈け降りると、あぶなく滑って転びそうになること両三度、降りてしまったら汗が流れた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "お千代も落ちたる懷劍を拾ひて、これも庭へ駈け降りるを、伴左衞門は呼びとめる。",
              "citation": {
                "source": "正雪の二代目",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰りは下り阪を面白半分に駈け降りると、あぶなく滑って転びそうになること両三度。",
              "citation": {
                "source": "秋の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "寄んどころなくわたしは跣足になつてものゝ一丁あまりもあらうといふ急坂を芋畑の上から下まで糸を引いたまゝ一散に駈け降りるのであつた。",
              "citation": {
                "source": "山峡の凧",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "狭い階段を中途まで登っていた紀久子が「大丈夫かい」といって駈け降りると、膝をすりむいたらしい福は向うむきになって唾をつけていたが、紀久子の声に急に顔へ袂をあてて泣きはじめた。",
              "citation": {
                "source": "父",
                "author": "矢田津世子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼は、階段を駈け降りる跫音を聞きつける度毎に、自分の部屋の戸口から声をかけた。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "この急角度をミコシを担いで降りるということが大体に於て素人には信じられないことなのだが、ここを一気に駈け降りる。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間が斜面を駈け降りると私のようなデブでも毎秒十米は越すだろうから、イヤ、デブは加速度によって早いかね、追ッかけられても怖くはないらしいや。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "消え失せた沙漠――大島の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして案内女や桟敷番が驚いているのに目も呉れず一散に階段を駈け降りると、婦人が今しもアンチンヌ並木町に面した出口の処へ走って行く姿を認めた。",
              "citation": {
                "source": "水晶の栓",
                "author": "モウリス・ルブラン",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉を押したが鍵がかかっているから、「オイ、二人はこの場を動くな」　八丁鼻は階下へ駈け降りる。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来たっ」「襲せおったぞっ」　どうっと、その後から、源氏方が駈け降りる、平家方も駈け降りる。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "河原のほうへ駈け降りる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第四分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ウヌ、逃がすものか」　蘭堂は石垣を駈け降りると、一散に乞食のあとを追った。",
              "citation": {
                "source": "恐怖王",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段を駈け降りる音が聞こえてくる。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが、怪物が廊下の突き当たりの狭い裏階段を駈け降りるころには、二、三間に縮められていた。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
