        "examples": {
          "standard": [
            {
              "text": "クマムシは乾眠状態になることで、極限環境でも生き延びる能力を持つ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "長期的な宇宙旅行では、搭乗員を乾眠させる技術が将来的に役立つかもしれない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "砂漠に生息する一部の生物は、乾燥期を乾眠して過ごす。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
