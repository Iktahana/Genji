        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鍛冶屋の親方は、熱い鉄を金箸で巧みに操っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "赤々と燃える炭の中から、金箸で真っ赤になった鉄棒を取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "この古い金箸は、何代も受け継がれてきたものだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "〔安閑天皇〕　御子｜廣國押建金日の王一、勾の金箸の宮二にましまして、天の下治らしめしき。",
              "citation": {
                "source": "古事記",
                "author": "校註　古事記",
                "note": "青空文庫"
              }
            },
            {
              "text": "安閑天皇　御子のヒロクニオシタケカナヒの王（安閑天皇）、大和の勾の金箸の宮においでになつて、天下をお治めなさいました。",
              "citation": {
                "source": "古事記",
                "author": "現代語譯　古事記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
