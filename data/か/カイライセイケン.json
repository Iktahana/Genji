        "examples": {
          "standard": [
            {
              "text": "傀儡政権が続く限り、国民の真の民主的自決は実現できないだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "歴史の教科書では、第二次世界大戦時の傀儡政権の成立過程が詳しく解説されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "国際社会は、その国の傀儡政権を承認することを拒否した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "北方教育と呼ばれるこうした教育実践が、東北の教師たちに広がっていくその一方で、一九三一（昭和六）年、日本は満州事変を引き起こし、翌年、傀儡政権を立てて満州国の建国を宣言します。",
              "citation": {
                "source": "本の未来",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヘロデ党はローマ帝国の立てた傀儡政権たるヘロデ家を支持する党派であった。",
              "citation": {
                "source": "キリスト教入門",
                "author": "矢内原忠雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
