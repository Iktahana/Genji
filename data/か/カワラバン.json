        "examples": {
          "standard": [
            {
              "text": "「江戸時代には、こんな風に最新の出来事が『かわら版』で人々に伝えられていたんだね！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "博物館で当時の『かわら版』のレプリカを見たけど、絵もあって面白かったよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "先生が昔話で、『かわら版』には面白い噂話も載っていたって言ってたっけ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "現代のニュースとは全然違うけど、『かわら版』の独特の雰囲気が好きだな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
