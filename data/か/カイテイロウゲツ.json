        "examples": {
          "standard": [
            {
              "text": "彼の計画は海底撈月のような無駄な努力だと周囲は判断していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その議論は海底撈月に終わり、何の結果ももたらさなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海底撈月の努力をしても、結果は変わらないと悟った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それにさすがは文學の國支那の遊びで、役の名に清一色とか、國士無雙とか、海底撈月とか、嶺上開花とか、四喜臨門とかいふやうな如何にも詩味のある字句を使つてあるのも面白い。",
              "citation": {
                "source": "麻雀を語る",
                "author": "南部修太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
