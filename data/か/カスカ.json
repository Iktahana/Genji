[
  {
    "uuid": "11ca86c0-73eb-5492-85d2-6f6ebafafc53",
    "entry": "微か",
    "reading": {
      "primary": "かすか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "faint",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「深夜の住宅街で、どこからか微かにピアノを練習する音が漏れてきた。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「彼女の頬に微かな赤みが差したのを見て、思わずこちらまで照れてしまった。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「遠くの山並みが、夕闇の中に微かなシルエットとなって浮かび上がっている。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「風に乗って、微かに潮の香りが漂ってくる。海が近い証拠だね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "そして横に顔を向けたと思ふと、まことに微かに「クフン」と自嘲に似たものをする。",
              "citation": {
                "source": "校長",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "早春の淡紫に湿つた土の上で、独楽はチリチリヽヽといふ微かな音を立ててシンミリ廻つた。",
              "citation": {
                "source": "耕二のこと",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」――さうした微かな声が私の耳に這入つた。",
              "citation": {
                "source": "その頃の生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしそれでゐて何か或る頑丈な逞しい姿勢の影に、微かな虫声に似た優しいセンチメントを感じさせる。",
              "citation": {
                "source": "小説家の俳句",
                "author": "俳人としての芥川龍之介と室生犀星",
                "note": "青空文庫"
              }
            },
            {
              "text": "適度の文明的人工物は、自然をして軽快ならしめ、森や林や山巒に、微かな香水の匂ひをあたへる。",
              "citation": {
                "source": "石段上りの街",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎はさつそく泥をこねて、所謂岩乘な、いい舟の製作にとりかかり、狸は、すまねえ、すまねえ、と言ひながらあちこち飛び廻つて專ら自分のお辨當の内容調合に腐心し、夕風が微かに吹き起つて湖面一ぱいに小さい波が立つて來た頃、粘土の小さい舟が、つやつやと鋼鐵色に輝いて進水した。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "二勺より路は黒鉄を鍛へたる如く、天の一方より急斜して、爛沙、焦石、截々、風の噪ぐ音して人と伴ひ落下す、偶ま雲を破りて額上｜微かに見るところの宝永山の赭土より、冷乳の缸を傾けたる如く、大霧を揺るよと見る間に、急瀬上下に乱流する如くなりて、中霄に溢れ、片々｜団々、がり、故郷を望んで帰り去なむを私語く。",
              "citation": {
                "source": "霧の不二、月の不二",
                "author": "――明治三十六年八月七日御殿場口にて観察――",
                "note": "青空文庫"
              }
            },
            {
              "text": "白剥山の入口などは、解らなくて、森の中を一行が、離れ離れに迷うばかり、滝上りまでもやった、一時は絶望に近かった、しかし山腹に辿りついてからは、去年の路が、微かに見分けが出来た、頂は存外変りがなかった。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "金剛杖が石にカチリと当る、金属性の微かな短い音がしてコロコロと絶壁の下に転げ落ちる、どこを見ても絶壁！",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人は黙ってそれを受け取って微かにうなづきました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）　窓の蘭の葉の形の結晶のすきまから、東のそらの琥珀が微かに透いて見えて來ました。",
              "citation": {
                "source": "氷と後光",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一面の爪草の花、青白いともしびを點じ微かな悦びをくゆらしそれから月光を吸ふつめくさの原。",
              "citation": {
                "source": "うろこ雲",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　雷と風の音との中から、微かに兄さんの声が聞えました。",
              "citation": {
                "source": "種山ヶ原",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その冴えた響きはだんだん微かになって、一しきり強く吹きつけて来た風の音がした後は、四囲は以前のような、夜の更けてゆく音に帰ってしまった。",
              "citation": {
                "source": "不幸",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」スタニスラウスは微かな声で答へた。",
              "citation": {
                "source": "祭日",
                "author": "DAS FAMILIENFEST",
                "note": "青空文庫"
              }
            },
            {
              "text": "妾はロダンさんの芸術を微かながら、妾の心の奥底に感じることが出来ると同時に、この老いた彫刻家に妾は自分の心を与えることが出来たのです。",
              "citation": {
                "source": "バルザックの寝巻姿",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとそこに微かに弾丸の傷痕が見られた。",
              "citation": {
                "source": "スポールティフな娼婦",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "店の障子が風に吹かれてがたがたすると思うとパラパラと雨を吹きつける音が微かにした。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "無人島でない事はその山よりも高い空で雲雀が啼いているのが微かに聞こえるのでわかる。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "人の住んで居ない町かと思われる程で、少女が（産婆）の軒燈の前まで来た時、其二階で赤児の泣声が微かにした。",
              "citation": {
                "source": "二少女",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいえ」と、お初は微かに答えた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "猫騒動",
                "note": "青空文庫"
              }
            },
            {
              "text": "歌女寿の家では夜がふけると、暗い稽古舞台の上で誰ともなしにとんとん足拍子を踏む音が微かに聞えるという薄気味の悪い噂が立った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お化け師匠",
                "note": "青空文庫"
              }
            },
            {
              "text": "かれは固より記憶していなかったが、唯さえ静かな家中がしんとして、夜ももう余ほど更けているらしいと思う頃に、次の間の畳を滑るような足音が微かに響いた。",
              "citation": {
                "source": "半七捕物帳",
                "author": "奥女中",
                "note": "青空文庫"
              }
            },
            {
              "text": "盛岡の電燈は微かにゆらいでねむさうにならび只公園のアーク燈だけ高い処でそらぞらしい気焔の波を上げてゐる。",
              "citation": {
                "source": "秋田街道",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども家の前を通るときは犬は裏手の方へ逃げて微かにうなってゐるのだ。",
              "citation": {
                "source": "柳沢",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次の電光は、実に微かにあるかないかに閃めきました。",
              "citation": {
                "source": "ガドルフの百合",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その人は黙ってそれを受け取って微かにうなずきました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "微かな青びかりもありました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」微かに微かにわらひながらその人はみんなに云ひました。",
              "citation": {
                "source": "ひかりの素足",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "靈智萩原朔太郎ふるへる、微光のよるに、いつぱつ、ぴすとるを撃つ、遠方に、金の山脈、かすかな、黒曜石の發光。",
              "citation": {
                "source": "靈智",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "poor",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
