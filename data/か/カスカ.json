  {
    "uuid": "e0a5b119-e80e-53b3-9779-f00307b21e71",
    "entry": "カスカ",
    "reading": {
      "primary": "かすか",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ここまで来れば、安売り電気店やディスカウント・ショップでバカスカ売れる。",
              "citation": {
                "source": "青空のリスタート",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ダンダン　センサウノ　アル　トコロニ　チカヅイテ　キタラシク、トキドキ　トホクノ　ハウカラ　カスカニ　タイハウノ　トドロキガ　キコエテ　キマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ机の曳出から分厚い強度の近眼鏡と、カルモチンと同じ位のカスカラ錠の瓶を探し出しただけであった。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カスカラ錠は下剤じゃないですか」「そうです。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "近眼だもんですからカスカラとカルモチンを間違えて服んだんですね。",
              "citation": {
                "source": "山羊髯編輯長",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぐずりと鼻をならして、手紙から顔を上げると、カスカスした低い声で、「浅川のためだ。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、カスカスな声を絞り上げた。",
              "citation": {
                "source": "不在地主",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ガ主人ヲ抱キ起シタ時、主人ハサキ申シタ通リ殆ド死ンダヨウニナッテ居リマシタガ、私ガ旦那様旦那様トクリ返シマスト、カスカニ目ヲアキマシタガ、不意ニ思イガケナイ位大キナ声デ、「大寺……大寺ダ」ト申サレマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ声ハカスカデシタガハッキリトキキ取レマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "つかみどころなき焦心、私の今朝の胃のふが、菜っぱ漬けだけのように、私の頭もスカスカとさみしい風が吹いている。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これがブーンと廻転を始めると、土は勿論、硬い岩石でも、鉄壁でも、コンクリートでも、まるで障子に穴をあけるのと同じように、スカスカ抉られてしまうのだった。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "久しぶりでこのひとの書いたものをよみ、ちびた細筆で不足の絵具でカスカスにかかれているスケッチを見た感じでした。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六十二になる眼の見えない祖母が、たったひとりでひっそりと暮しているの」「たいへんね」「土地馴れない山の手なんかへ越して、ご近所の世話になって、カスカスに生きるのかと思うと、しみじみとしちゃう。",
              "citation": {
                "source": "虹の橋",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "パパの書斎にあるやつは古びたりといえども〈トゥ・フランス〉型の六球だからカスカスぐらいには入るだろう。",
              "citation": {
                "source": "だいこん",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ノアの方舟　スラバヤを出帆してから四日、海洋性の滝のような豪雨がやみまもなく降りつづくのに、赤道特有の絡みつくようなひどい暑気で船艙はさながらの蒸風呂になり、蚕棚へ長く寝てカスカス呼吸をしているという辛い船旅になった。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "三月になっても私がお前に手をおろさないのは、猫の鼻の先にいつでも食える鼠を遊ばしておくようにすこしは楽しみたかったせいもあるがそれよりも、お前を殺そうと思った自分の気持がホンの一時のものかどうかを、ためしたかった殺してしまってから、どんな意味ででも、どんなカスカにでも自分が後悔しないか？",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "五郎　……（咽喉がカスカスになつた様な声で）在る。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どのくらいの固さがよいかはむずかしい問題で、固いのになるとカスカスしている。",
              "citation": {
                "source": "高野豆腐",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "カスカスがよいというひとも、やわらかいのがよいというひともある。",
              "citation": {
                "source": "高野豆腐",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "五目寿司には少しカスカスした高野豆腐でないと使い甲斐がないから、割合に固めのものを用いるように。",
              "citation": {
                "source": "高野豆腐",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、重曹をたくさん入れると、まったく元の豆腐になってしまうから、中間だけが少しカスカスした程度の固さが適当だろう。",
              "citation": {
                "source": "高野豆腐",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            },
            {
              "text": "生じつかカスカス生活の立つやうな家に生れたからいけないんだわ。",
              "citation": {
                "source": "新婚旅行",
                "author": "正宗白鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピイピイ、ピイピイ、ト、カスカナ声デハアルガ、シキリニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊藤氏が、ＯＳＳのパンを、「色も白く軽い風味で、ビフテキなぞの対手にはもって来いである」と評しているが、あの、アメリカ式の、なるほど色は白いが、スカスカと、味もソッケもないパンは、僕は嫌だ。",
              "citation": {
                "source": "駄パンその他",
                "author": "古川緑波",
                "note": "青空文庫"
              }
            },
            {
              "text": "或患者の如きは自らカオール、カスカラ錠、含嗽劑、カルモチンなど用ふるので、總て是等を取り上げて與へなかつた事もある。",
              "citation": {
                "source": "神經質に對する余の特殊療法",
                "author": "森田正馬",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
