        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、中風やみのようにぶるぶる手足をふるわせながら、しょぼんと立っていたが、ふと小沢の足許に二、三粒の飯粒が落ちているのを見るとあっという間にしゃがんで、その飯粒を口に入れた。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "風やみさうにも無し。",
              "citation": {
                "source": "宗吾靈堂",
                "author": "大町桂月",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜になってから風やみうれし。",
              "citation": {
                "source": "日記",
                "author": "一九二四年（大正十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "老女は中風やみ特有な表情でしばらくは茶碗のなかを見ていたが、やがてゆるしを乞うようにぼろぼろと涙を落としながら幾度もあたまを下げた。",
              "citation": {
                "source": "抱茗荷の説",
                "author": "山本禾太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……しかも痛風やみで、リョーマチで、頭痛もちで、その上やっかみと焼もちとで、肝臓肥大症ときている。",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの教授閣下を――あのやくざな痛風やみを、おれは心底から崇拝して、まるで牛みたいにやつのために働いてきたのだ！",
              "citation": {
                "source": "ワーニャ伯父さん",
                "author": "ДЯДЯ　ВАНЯ",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
