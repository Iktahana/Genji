        "examples": {
          "standard": [
            {
              "text": "喫煙所には、紙巻たばこ特有の強い香りが漂っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "コンビニの棚には、何十種類もの紙巻たばこが番号順に並んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "健康志向の高まりから、紙巻たばこの増税が何度も議論されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ホラ、たばこを受け取ってくれ」　ふたりは手さぐりで、紙巻たばこを一本ずつ取り出した。",
              "citation": {
                "source": "海底大陸",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
