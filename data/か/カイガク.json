    "definitions": [
      {
        "index": 1,
        "gloss": "establishment of a university",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新設大学は来春の開学に向けて、現在キャンパスの整備を急いでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "開学から五十年を迎えた大学では、記念式典と講演会が盛大に開催された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "地方の過疎化に悩む自治体が、地域活性化を目的とした大学の開学を誘致した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "疎開学童は働く楽しみのために農家を手伝ったのではなくて、そうすれば食物を貰えるから、その目的のために働きました。",
              "citation": {
                "source": "美しく豊な生活へ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "疎開学童から来たといって、嬉しそうにハガキを見せることもあった。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "疎開学童から来たといつて、嬉しさうにハガキを見せることもあつた。",
              "citation": {
                "source": "壊滅の序曲",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "榛名南麓の箕輪町でも、疎開学童を受け入れることになったので、校舎の修築、炊事場の新設、井戸を新しく掘るなど、いろいろ準備に忙しい。",
              "citation": {
                "source": "老狸伝",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この隣組からはまだはじめての疎開学童で、学校の違ふほかの連中よりも一足早く出掛けることになつた。",
              "citation": {
                "source": "荒天吉日",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
