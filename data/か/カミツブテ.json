        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "授業が退屈すぎて、後ろの席の親友が丸めたプリントの紙礫を投げてくるのが唯一の楽しみだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「やめろよ！先生に見つかったらどうすんだよ！」と小声で言いながら、紙礫を投げ返した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "お祭りの最後、山車の上から色鮮やかな紙礫が雨のように降り注いだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "子供たちが新聞紙を丸めて作った紙礫で、即席の雪合戦ごっこを始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "それに、死人が埋もれている地底の世界からも、絶えず紙礫のようなものが、ヒューヒューと打衝って来るんだ。",
              "citation": {
                "source": "黒死館殺人事件",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "濡らして打ちつけたらしい紙礫が、額の面一面に附いていました。",
              "citation": {
                "source": "鴎外の思い出",
                "author": "小金井喜美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、お笑いなさいまし、御一緒じゃありませんが、金吾様も、今日は後から此処へ来るそうです」　次郎が揶揄うその顔へ紙礫をぶつけて、おりんは月江と共に玄関へ駈け出しました。",
              "citation": {
                "source": "江戸三国志",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "逸作の手の端ではじけている息子の手紙のドームという仏蘭西文字の刷ってあるレターペーパーをかの女はちらと眼にすると、それがモンパルナッスの大きなキャフェで、其処に息子と仲好しの女達も沢山居て、かの女もその女達が可愛くて暇さえあれば出掛けて行って紙つぶてを投げ合って遊んだことを懐しく想い出した。",
              "citation": {
                "source": "かの女の朝",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはさつき早川の供述中にあつた佐田やす子の紙つぶてであろう。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙つぶてに書かれた「あ」の一字「どう遊ばして、銀之丞様」　お品が不足そうに声をかけた。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "結婚第一日目から父は祖父と客間で食事をし、母は姑その他と茶の間で食事をし、時にはあんまり二人で話が出来ない日が続くので、手紙を書いて紙つぶてにして話し合ったという思い出話さえ聞いています。",
              "citation": {
                "source": "わが母をおもう",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時分、私の書いた「一連の非プロレタリア的作品」という作品批評と感想とをとりまぜた論文めいたものが、その「やっつけ主義」批評ののろうべき見本であるかのように、紙つぶてをなげつけられた。",
              "citation": {
                "source": "近頃の感想",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヨが紙つぶてを作り、投げてやると、猫はそれにじゃれつき、喰い破って、駆け廻る。",
              "citation": {
                "source": "蔵の二階",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙つぶて　こんな時間の電話、きっとゆき子のことに違いない。",
              "citation": {
                "source": "劇団「笑う妖魔」",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙つぶて一　諸方に網の目を張っている物見の諜報は実に早い。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてそれを手に丸め、紙つぶてとして、妻の姿へ抛りつけた。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙つぶてはいるところまで、届かなかった。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い躊躇の後、私はやっと勇気を出して、用意して来た紙つぶてを、狙いを定めて投げると、白い玉が、うまく窓の中へ飛込んだ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "若しかしたら、彼は私がこの島を立去らなかったのを怒っているのではないかと心配し始めた頃、もう殆んど暮れ切って、土蔵の窓を見分けるのもむずかしくなった時分に、やっと、その窓の所へボンヤリと白い物が現われ、紙つぶてを私の方へ投げてよこした。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙つぶてを拡げて見ると、薄闇の中でも読める様に、大きな字の鉛筆書きで、簡単にこんなことが記してあった。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "私と顔を合わせることさえ避けて、秀ちゃんに紙つぶてを投げさせたのを見ても、彼の気持が分るのだ。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云って、又紙つぶてで、尋ね返していては、時間をとるばかりだし、いつ丈五郎が土蔵の中へ這入って来ぬとも限らぬので、諸戸の思慮を信頼して、私はすぐ様その場を立去った。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "片輪者の群　同じ日の夕方、私は土蔵の下へ行って、例の紙つぶてによって、私の発見した事柄を諸戸に通信した。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "紙つぶてで事の仔細を告げると、諸戸から、勇ましい返事が来た。",
              "citation": {
                "source": "孤島の鬼",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
