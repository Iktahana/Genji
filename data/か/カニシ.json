        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "全日本國民ハ心ヲ冷カニシテ天ノ賞罰斯クノ如ク異ナル所以ノ根本ヨリ考察シテ、如何ニ大日本帝國ヲ改造スベキカノ大本ヲ確立シ、擧國一人ノ非議ナキ國論ヲ定メ、全日本國民ノ大同團結ヲ以テ終ニ天皇大權ノ發動ヲ奏請シ、天皇ヲ奉ジテ速カニ國家改造ノ根基ヲ完ウセザルベカラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ明示シタル所以ハ此限度ヨリ免カルヽ目的ヲ以テスル外國ノ財産ヲ禁スルヲ明カニシタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「鞭ヲ鳴ラシテ酒肆ヲ過リ服ヲアザヤカニシテ倡門ニ遊ブ――」　他の者は世話ものを歌つたが、雷音は人々の聞き慣れぬ類ひの漢詩ばかりを次々に朗吟するのが癖だつた。",
              "citation": {
                "source": "淡雪",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――海上ハ波オダヤカニシテ、晴天ナレド雲アリ。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "仕方ガナク、人参サンハ顔ヲマツカニシテ、半分ネムツテヰルジヤガイモサンノ手ヲウン、ウンヒツパツテ、一里モ先ニアル村ノ停車場ヘカケ出シマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "實驗ヲ主トスルハ言ハズトモ知レタル事ナレドモ、只管ニ歐洲ノ事ノミヲ主トシテ、本邦ノ利害得失ヲ審カニシ、本邦並ニ亞細亞東方ノ歴史、人情、風俗ニ通ジ、殊ニハ又自己ノ經歴、體驗ヲ主トスル事ナリ。",
              "citation": {
                "source": "學問ハ淵源ヲ深クスルニ在ルノ論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "才ニ饒カニシテ識ニ乏キ者アリ。",
              "citation": {
                "source": "人智論",
                "author": "西周",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔独臥空床展転スルコト頻リナリ／帳影烟ノ如ク闃カニシテ人無シ／紅袖娯夜ハ我ガ分ニ非ズ／青灯長ク伴フ苦吟ノ身ニ〕と言い、「秋夜書懐」〔秋夜｜懐ヒヲ書ス〕の作には「薪水偏愁良僕少。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "」〔松本佐藤ノ二子鷲津知事ニ従ヒテ登米県ニ之クヲ送ル　馬前落葉離愁乱レ／朝雨江頭猶未ダ収マラズ／部伍令明ラカニシテ尤モ整粛／使君政簡ニシテ太ダ風流／過ギル時ハ感ズルヲ休メヨ白河ノ暮／到ル日ハ須ク観ルベシ松島ノ秋／語ヲ寄セヨ厳冬大雪多カラン／一領ノ白狐ノ裘無カル可ケンヤ〕となすものを見た。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "次のスキタイ人が仏教に化せられたこともまたカニシカ王の事績を見れば明らかである。",
              "citation": {
                "source": "孔子",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "仏教興隆で有名なカニシカ王の前に初めて北インドを征服した月氏の王はインドに入ると共に狂熱的なシヴァ崇拝者となった。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カニシカ及びその後嗣の代を過ぎて、次の王は再びシヴァ崇拝に帰った。",
              "citation": {
                "source": "古寺巡礼",
                "author": "和辻哲郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは美しい貝殻に入ったままの大きな腹足類（Rapana bezoar　アカニシ？",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "復仇ノ事、必ズ、時ノ奉行ニ至リテ、理非、黒白ヲ明カニシ、ソノ命ヲ受ク。",
              "citation": {
                "source": "新編忠臣蔵",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それと当年の蛮都を写している原書三国志の記述を見ても――　コノ地銀坑山ト曰ウハ、瀘水、甘南水、西城水ノ三江｜繞リ、地｜平ラカニシテ北千里ガ間ハ万物ヲ多ク産シ、東三百里ニシテ塩井アリ、南三百里ニシテ梁都洞アリ、南方ハ高山ニシテ夥シク白銀ヲ産ス。",
              "citation": {
                "source": "三国志",
                "author": "出師の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
