  {
    "uuid": "4650c4e0-9aab-50fe-b274-aca868dc3b89",
    "entry": "カイド",
    "reading": {
      "primary": "かいど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
