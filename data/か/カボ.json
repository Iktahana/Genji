[
  {
    "uuid": "fc2d2687-8c46-518e-8faa-2d5c5c61b6fc",
    "entry": "家母",
    "reading": {
      "primary": "かぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "翌年余十五歳、家君の喪にあひ、十六歳の春余家母に従つて京に入り、再び津島氏に従学し、門人と為ることを得たり。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "故に家母甚だこれを愁ふ。",
              "citation": {
                "source": "僻見",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "而して密かに其状を探聞すれは、皆是家母の不承諾に因ると、葢し其主因の、舊時の謬想たる海洋是地獄なる觀念の發現にあるや知るへし。",
              "citation": {
                "source": "海島冐險奇譚　海底軍艦",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "堂々たる大學々士の家母にして、今日尚此嘆あり。",
              "citation": {
                "source": "海島冐險奇譚　海底軍艦",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "葢し教育の根底は學校にあり、學校の根底は家庭にあり、而して家庭の根底は家母にあり。",
              "citation": {
                "source": "海島冐險奇譚　海底軍艦",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "嗚呼、將來の國民をして開國進取の民たらしめむか、將た退嬰鎖守の民たらしめむか、國家盛衰の大問題は、一に家母の方寸に决せむとす。",
              "citation": {
                "source": "海島冐險奇譚　海底軍艦",
                "author": "序",
                "note": "青空文庫"
              }
            },
            {
              "text": "この山岸の繁みふかきにある家母はやく狂乱して、祖母の手に育てる子らあり。",
              "citation": {
                "source": "鵠が音",
                "author": "折口春洋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
    "relations": {
      "homophones": [],
