          "literary": [
            {
              "text": "「お父さんの会計事務所の支所が神戸にあるのは知ってるわね。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "早くに亡くなった夫が、親友とともに設立した会計事務所で、恵子は会計の専門家として仕事をしてきた。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでずっと仕事をしてきた会計事務所の神戸の支所へ、そこの責任者として、恵子は移ることになった。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「早くに死別した夫の親友が会計事務所を主宰していて、幼子をかかえた私に、うちで働きませんか、と誘ってくれたのよ。",
              "citation": {
                "source": "物のかたちのバラッド",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
