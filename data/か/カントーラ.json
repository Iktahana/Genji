          "literary": [
            {
              "text": "カントーラ〔事務所〕に行くと、まだその男がうろついて居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "○カントーラで行列は明日の朝何時頃から始るか聞いたら、曰く、――明日は社会主義者や共産党や、そんな碌でもない奴だけ行列するんです。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "パッサージへ行ったが、カントーラ〔事務所〕の人別な男で、二十日までに室あるかどうか分らぬ。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中70番が今空くというので、カントーラへかけつけてやっと日の当る室へ引越した。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "六月二日　月　室代をはらいにカントーラに居たら、女の人、食堂のコムソモールカと話してる。",
              "citation": {
                "source": "日記",
                "author": "一九三〇年（昭和五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "カントーラ（帳場）の人が顔をおぼえていてくれましてね。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――カントーラ（帳場）に話しなさるこったよ」　ノーソフと話しているうちに、伸子の眼の中と唇の上に奇妙に輝きながらゆがんだ微笑がうかんだ。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
