          "literary": [
            {
              "text": "而シテ日本ガ小農法ノ國情ナルニ考ヘテ之ヲ自作農ノ所有權ニ移シ以テ土地民有制ヲ取ルコトモ、日本トシテノ物質生活ヨリ築カルベキ幾多ノ理論ヲ有ス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ改造後ノ勞働者ハ眞個其ノ自由ヲ保持シテ些ノ損傷ナカルベキハ論ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ、随ッテソノ間ニ行ワルル犯罪ノ種類モ亦、唯物科学ノ原理ヲ応用セルモノ多カルベキハ自然ノ理ナリ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "銭五万｜貫五日ノ内ニ上納ノ事右、領主｜庄家、一致シテ違反ナカルベキ旨、御上意｜也　と、いう令であった。",
              "citation": {
                "source": "私本太平記",
                "author": "新田帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
