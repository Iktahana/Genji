        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ロウは一三名のスタッフを選んで、研究所のあるフロリダ州のボカラトンに集めた。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルト　ポストノ　ウシロニ　タツテ　ヰタ　ガイトウガ　カラ　カラト　ワラツテ、「ポストノ　カゲナラ、ポストノ　ウシロニ　コロガツテ　ヰル　ソノ　ブカツカウナノガ　サウヨ」ト　イヒマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "以上デ私ノ言イ分ハホボ尽キタワケデアルガ、シカシコノヨウナコトヲ書イタカラトイツテ私ガカタカナ運動デモ開始シタヨウニ思ワレテハ迷惑デアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテカラ二人ノ様子ガオカシイト感ジテ居リマシタカラ、其ノ時何トナク気ニナリマシタノデ暫ク経テカラ私モ便所ニ行ッテクルカラト申シテ室外ニ出マシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "青玉の事　カラト嶋の方、北高麗より渡り申す由なり。",
              "citation": {
                "source": "津軽の虫の巣",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレカラトイフモノ、モンコチヤンハボンコチヤンヲケツシテカブラナクナリマシタカラ、オ父サント、オ母サント、オ姉サントオ兄サンハモンコチヤンニカウイヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "５．Es wird heute den ganzen Tag gearbeitet,［den ganzen Tag ガアルカラトテ Heute wird der ganze Tag gearbeitet. トスベカラズ］――今日は一日働く。",
              "citation": {
                "source": "新獨逸語文法教程解説",
                "author": "關口存男",
                "note": "青空文庫"
              }
            },
            {
              "text": "九十ニナッテモ子ヲ産ンデミセルト云ウ久原房之助ノヨウナ精力ハナク、既ニ全ク無能力者デハアルガ、ダカラト云ッテイロ／＼ノ変形的間接的方法デ性ノ魅力ヲ感ジルコトガ出来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモコヽハ開ケラレルノヨ」予ノ入浴ハ午後九時過ギニ決マッテイルカラ、ト云ウ意味ナノカ、予ヲ信用シテイルカラト云ウノカ、見タケレバ見セタゲルカラ這入ッテラッシャイト云ウノカ、老イボレ爺サンノ存在ナンカ全然問題ニシテナイト云ウノカ、何ノタメニワザ／＼ソンナコトヲ断ルノカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アレカラ間モナク」「アレカラトハ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラコリーハ止メルヨウニオ爺チャンカラ仰ッシャッテヨ、アタシモソレトナク云ウンダケレド、アタシガ云ッタンジャ颯子ハ聴イテクレナインデスカラト、婆サンハ訴エルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ彼ガ、イクラ親父ノ髯ダカラト云ッテ、大事ナ女房ニ本気デ剃ラセル気ガアルンダロウカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "窓際ニ予、ソノ隣ニ颯子、通路ヲ隔テヽ佐々木、ト云ウ目算デアッタガ、動キ出シテ見ルト窓際ハ風ガスウ／＼スルカラト云ワレテ颯子ト入レ代リ、通路ニ寄ッタ方ノ席ニ掛ケサセラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "喉ガ渇クカラトボーイニ茶ヲ持ッテ来サセ、コンナ時ノ用意ニポケットニ忍バセテ来タセデスヲ二錠、颯子ニモ佐々木ニモ見ラレヌヨウニ、ソット口ヘ放リ込ム。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子一人五子達ヲ南禅寺ヘ送リ届ケテホテルヘ帰リ、予ト佐々木トハ夜ガ晩イカラト云ウノデ、吉兆ニ泊ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、ダカラト云ッテ、二人ノ間ニ不倫ナ関係ガ成リ立ッテイルト云ウ證拠ハナイシ、ソンナコトヲ信ジル者ハ一人モイナイヨト、ソウ云ウト、本当ニ一人モイナイデショウカ、ト、五子ハ妙ナ笑イ方ヲシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨壺はカラトに収められ、住職は墓前で四誓偈を誦んだ。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
