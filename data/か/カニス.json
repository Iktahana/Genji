          "literary": [
            {
              "text": "天皇ハ國民ノ總代表タリ、國家ノ根柱タルノ原理主義ヲ明カニス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ都市ノ積極的發達ハ此財源ニヨリテ自由ナルト共ニ、其ノ發達ヨリ結果スル借地料ノ騰貴ハ亦循環的ニ市ノ財源ヲ豐カニス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "男子ノ姦通罪ヲ罰スルコトハ第一ニ一夫一婦タル國民道徳ノ大本ヲ明カニスルガタメナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日韓合併ノ本旨ニ照シテ日本帝國ノ一部タリ一行政區タル大本ヲ明ラカニス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "朝鮮ガ日本ノ西海道タリ朝鮮人ガ日本人ト大差ナキ民族タル理由ニヨリテ、日本國民タル國民權ヲ最初ニ且ツ完全ニ賦與セラルルヲ明カニスル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "如何ナル基礎知識ニ照シテ、犯行ノ径路、手段ノ内容ヲ明カニスベキヤ――云々――　……どうです諸君。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはまさしく人生への敗北である」　三、メカニスム的に語る生理学者。",
              "citation": {
                "source": "二十歳のエチュード",
                "author": "原口統三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ファンテジイは必ずしも喜劇的ではない、然しながら、多くの場合、作中人物の性格的不具乃至心理的メカニスムと結びついて、作品に一味の滑稽感を与へる。",
              "citation": {
                "source": "ファンテジイ",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "○石器時代人民相互ノ關係ハ、古今ノ比較ニ於テモ東西ノ比較ニ於テモ、通例ノ人種調査ニ要スル順序ヲ經テ始メテ明カニスルヲ得ベキハ勿論ナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "○日本石器時代人民ニ關スル研究ハ啻ニ日本ノ古事ヲ明カニスルニ於テ有力ナルノミナラズ、人類學上益スル所又决シテ少カラザルナリ。",
              "citation": {
                "source": "石器時代總論要領",
                "author": "坪井正五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、この説に反対したのは通名カニス・レオすなわち猫であった。",
              "citation": {
                "source": "空中征服",
                "author": "賀川豊彦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
