        "examples": {
          "standard": [
            {
              "text": "海洋物理学の研究により、黒潮の流速変化と台風の関連性が明らかになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海洋物理学は気象学と密接に関わり、気候変動予測に重要な役割を果たしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "大学の研究室では海洋物理学を学ぶため、衛星データを用いた海流解析を行っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "それは、先生の海洋物理学の講義の原稿らしいフルスカップの裏に書かれてあったのである。",
              "citation": {
                "source": "救われた稀本",
                "author": "――寺田寅彦著『物理学序説』",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは海洋物理学の講義の草稿らしいフルスカップの裏に書かれたもので、百何十枚かあった由である。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "海洋物理学者なんか、どうかしら。",
              "citation": {
                "source": "時差のないふたつの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
