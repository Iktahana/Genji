          "literary": [
            {
              "text": "山へ行って薪を切ったり、その薪を割って乾かしたり、火打ち石でかっちんかっちん火を出したりする奴隷はいらぬ。",
              "citation": {
                "source": "この子を残して",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分勝手に、婿なんどに身上引っかき廻されて、それでこの俺が、黙っていられっかっちんだ。",
              "citation": {
                "source": "米",
                "author": "犬田卯",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして母親のする通りに錠穴から挿し込んで、逆にねじあげると、錠はかっちんと鳴って、賽銭箱から離れた。",
              "citation": {
                "source": "性に眼覚める頃",
                "author": "室生犀星",
                "note": "青空文庫"
              }
            }
          ]
        }
