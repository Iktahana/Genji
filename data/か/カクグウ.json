          "literary": [
            {
              "text": "蜀に客寓したといふが、本籍は恐らく沛であらうか、不確實である。",
              "citation": {
                "source": "道教に就いて",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に掲げた手紙もすなわちこのロンドン客寓中にしたためたものである。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "その後バアトンは、西部｜亜弗利加や南｜亜米利加に客寓中、独り稿を継いで行つた。",
              "citation": {
                "source": "リチヤアド・バアトン訳「一千一夜物語」に就いて",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "如亭も江戸の人で生涯家なく山水の間に放吟し、文政の初に平安の客寓に死したのである。",
              "citation": {
                "source": "向嶋",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "年十九、事ニ遇ヒ流移シテ遠州ニ客寓スルコト殆十年。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
