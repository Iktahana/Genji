        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　實に、氣の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「マタ　ハツパノ　トコヘ　カヘツテ　クルノ」「モウ、キマセン。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "キエテ　イツタ　ホシハ、イツマデ　タツテモ　カヘツテ　キマセンデシタ。",
              "citation": {
                "source": "ナガレボシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コマツタ　ヤツダナ、オレニハ　オチチガ　デナイカラ　ヤツパリ　モトノ　マキバヘ　ツレテツテ　ヤラウ」ト　イツテ、ヌスビトハ　ペコペコノ　オナカヲ　オサヘナガラ　マタ　モト　キタ　ミチヲ　カヘツテ　ユキマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジブンガ　リツパナ　タイシヨウニ　ナツテ、ムネニ　ヅラリト　クンシヨウヲ　ナラベ、ピカピカ　ヒカル　ケンヲ　モツテ、ウマノ　上ニ　ソリカヘツテ　ヰル　ユメヲ　ミテ　ヰルト、ヤガテ　ヨガ　アケテ　アサニ　ナリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、マダ　アカチヤンヲ　ダツコシテルヤウナ　テツキヲ　シテ　オウチヘ　カヘツテ　キマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アンマリ、カワイカツタノデ、マダ　ダツコシテル　ツモリデ　カヘツテ　キタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチガ　トツゼン　ヒツクリカヘツテ、キゼツシテ　シマツタノデス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コドモダヌキハ　オアシヲ　モラツタノデ　サツキノ　クルシサモ　ワスレテ、ヨロコビ　イサンデ　カヘツテ　イキマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "四ヒゲナシ　ニナツテオウチ　ヘカヘツテ　来タラオ母サン　ハオドロイテ山羊サン　ヲ叱ツタ　ケド山羊サン　ハ平気ナ　顔ヨ。",
              "citation": {
                "source": "カハイイ　山羊サン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "玉ネギサンハ　アンシンシテカヘツテユキマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "モンコチヤンハイクラオコツテヰテモオ家ノ中ニヰルカライイヤウナモノノ、クライ夜道ヲ一人デトンデイツタボンコチヤンハ、モウ、ケツシテ、オ家ヘカヘツテコラレナイデセウ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボンコチヤンハモンコチヤンノトコロヘ　カヘツテ来ルト、スグニ、クシヤミガトマツテ、モトノヤウニ元気ナボンコチヤンニナリマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　シバラクシテ　モウ　ウマク　ヤケタラウト　オモツテ　オマンヂウヲ　オイタトコロヘ　カヘツテキテミルト　オマンヂウハ　一ツモ　アリマセン。",
              "citation": {
                "source": "スナマンヂウ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
