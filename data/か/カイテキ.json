  {
    "uuid": "e5954f18-53d0-5047-b6f8-2cde7cafc7fa",
    "entry": "会敵",
    "reading": {
      "primary": "かいてき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "encountering the enemy",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "敵軍と会敵した時点で、戦闘は避けられなくなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "戦場で予期せず敵軍と会敵した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "山越えの道で敵の兵士と会敵してしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ふりかへつてみると、自分もたくさんの詩をかいてきた。",
              "citation": {
                "source": "雲",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし永田という人はとにかく『私妻』とかいてきたのだから俺は形式の結婚はとにかくやったものと認めない訳にはゆかない。",
              "citation": {
                "source": "出奔",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "多くの概念ばかりを、私はかいてきたが――実は、私は、もう少し、大望を起したのである。",
              "citation": {
                "source": "大阪を歩く",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを聞いている酋長の方でも、だんだん汗をかいてきた。",
              "citation": {
                "source": "人造人間戦車の機密",
                "author": "――金博士シリーズ・２――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、こういう人たちの書く小説が、平常の心でかかれはじめているという事実、嘗て島木健作が、緊張し青筋を立て義人ぶった日本人を小説にかいてきた時代から四年の月日は、これだけの変化を日本の人の心にもたらしているということを興味ふかく感じました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "また宮本武蔵の読後感をあの筆不性な筆で長々とかいてきたのを、某百貨店で、武蔵展をやったときに展観に貸して、それが一夜で紛失した事件などもあった。",
              "citation": {
                "source": "落日の荘厳に似る",
                "author": "――大観画伯の終焉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鼻が悪いとみえて、仲間の宅助、おそろしいいびきをかいてきた。",
              "citation": {
                "source": "鳴門秘帖",
                "author": "船路の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
