        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "厩戸ノ皇子ハ、寵臣ニソムカレタ事ハナカツタ。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "御度量のひろい将軍家に於いては、もちろん、御計画の頓挫をいつまでも無念がつていらつしやるやうな事は無く、あの、大かたり者の陳和卿に対してもいささかもお怒りなさらず、医王山ホド、ウマクイカナカツタヤウデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　実に、気の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」オニハ　コナヒダ　アヅカツタコブヲ　ツケマス　ミギノ　ホホオヤオヤ　トウトウ　コブ　フタツブランブラント　オモタイナハヅカシサウニ　オヂイサンムラヘ　カヘツテ　ユキマシタ　實に、氣の毒な結果になつたものだ。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「イイヤ、生レタトキハ良カツタ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデハ　コノ　コノ　トコロニハ　ウグヒスハ　アソビニ　コナカツタデセウカ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　五ニンノ　サムライハ　サルヲ　キラナクテ　ヨカツタ　コトヲ、メニ　ナミダヲ　タメテ　ヨロコビマシタ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イエイエ、ワタシハ、アナタノ　フイテ　イラツシヤツタ、ソノ　フエノ　コヱガ　アンマリ　ヨカツタノデ、コツチヘ　サソハレテ　キマシタ」ト　タケノコハ　コタヘマシタ。",
              "citation": {
                "source": "タケノコ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コドモタチヤ、コノ　バシヤハネ、オマエタチガ　マダ　ウマレナカツタ　ジブン、マダ　ジドウシヤト　イフ　モノガ　ナカツタ　トキ、ムラカラ　マチノ　テイシヤバマデ　マイニチ　カヨツタ　モノダヨ。",
              "citation": {
                "source": "フルイ　バシヤ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「アンマリ、カワイカツタノデ、マダ　ダツコシテル　ツモリデ　カヘツテ　キタノヨ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "イタチガ　オナラヲ　シナカツタカラデ　アリマス。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　ヤツパリ　イタチハ　ヨブンヂヤ　ナカツタト　オモヒマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラガナトカタカナハ相前後シテ生レタラシイガ、前者ハ毛筆ト和紙ニ対シ適合性ヲ持ツテイタタメ今日マデ愛用サレタニ反シ後者ハ適合性ヲ持タナカツタタメ、一千年ノ間カエリミラレルコトガナカツタ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシモコレヲ不調和ト感ジル人ガアツタラオソラクソノ人ガカタカナヲ見ナレナイセイカ、ソウデナカツタラ数学ノ本デ十分ニ痛メツケラレタ記憶ヲ持ツ人ニチガイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "我々ハ今マデニオイテモ行書ノ活字ダノ草書ノ活字ダノトイウモノヲ持タナカツタガ、ソノタメニイササカノ不便モ感ジテハイナイ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "火ノ子ガ林ノ上カラ夥シク降ツテ來タガ、布カ木片ノ燃屑デ中々大キカツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ後急ニ近隣ノ火ノ手ガ強クナリ、今戸八幡ノ方ニモ火ノ手ガ擴ガツテ來タタメ、大川縁ヲ傳ヒ北方ニ、逃ゲル仕度ヲ始メタノデ、後ノ状況ハ見ナカツタ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "酢屋は横浜の貿易商で孟買とカルカツタとに十年｜前から店を持つて居る。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツモダト私ハ知ラズ知ラズ、気ガ遠クナツテシマフノデスガ、今夜ハサウナラナイ内ニ、ワザト魔法ニカカツタ真似ヲシマス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ私は現在直接にブツカツタ問題として『恋愛』は女子の唯一の道徳であり、所謂『結婚』は恋愛とはまつたくその性質を異にしたものだと云ふことをこれ等の論文に於て一層ハツキリ覚り得たのである。",
              "citation": {
                "source": "「婦人解放の悲劇」自序",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "二〇ヒアサタツタ」ヒロシサンノユクサキワカツタラソチラシラベタノム　弘の行先は無論わからなかつたが、これでみると、梨枝子は三日も前に発つてゐるし、弘も房州海岸へ出掛けて行つて、一足先に発つたのだといふことが想像された。",
              "citation": {
                "source": "落葉日記",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト第一番ニカラカツタノハオネコサンデシタ。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "オネコサンハ、アヒルサンノ赤イ洋服ガウラヤマシクテナラナカツタノデス。",
              "citation": {
                "source": "アヒルサン　ト　オネコサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」アヒルノオマワリサンガカウイツテクレタノデ、玉ネギサント、ジヤガイモサンハ、ドンナニウレシカツタデセウ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、「マア、ソレハヨカツタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハドンナニウレシカツタデセウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アア、チツトモ、オチツイテネムレナカツタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
