        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "オールズモビールのカトラスだという。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴァニラ・アイスクリームとは、そのカトラスの車体の色だろう。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "シスコ・アカミネの「オケイ」のひと言は、オールズモビール・カトラスの快調さとつながっていた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "道路に面したマンゴーの樹の下に、僕はカトラスを停めた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "車の列から出て徐行していく舞子のジャガーのうしろに、僕はカトラスを従わせた。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カプリース・クラシック・クーペ　ハリー・オカモトのガレージへいき、借りていたままだったオールズモビール・カトラスを僕は返却し、賃貸料金を支払った。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "それに、オールズモビールのカトラス。",
              "citation": {
                "source": "ラハイナまで来た理由",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその隣りに、ぼくの車、オールズモビールのカトラス４ドアが停まっていた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのすぐうしろに、ぼくはカトラスを停めた。",
              "citation": {
                "source": "頬よせてホノルル",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
