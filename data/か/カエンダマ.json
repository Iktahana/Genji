          "literary": [
            {
              "text": "――長さんの足がひょいひょい遠のくのは、吉原の火焔玉屋のお職がこのごろ血道を上げているからだそうな。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は火焔玉屋から、遠のいてしまった。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "油ボロを芯に枯れ葉などを仕込んだ竹編みの火焔玉やら、投げ松明の類だった。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "また日ごろ蓄えておいた火焔玉も、ほかの崖全面の敵兵へぶり撒いた。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "火焔玉はなかなか燃えつきない。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
