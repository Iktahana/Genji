        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "何だかしかし余り長く飲み続けると、おかみさんみたいに、そういやおやじさんもだが、また瘠せるんじゃないんですか。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おかしかしかし樫の葉は白い。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしかしらは、それに答えないで、「わしはこの仔牛をあずけられたのだ。",
              "citation": {
                "source": "花のき村と盗人たち",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハハハハハ」「何だかしかし、こう、一人坊っちのような気がして淋しくっていけません」「一人坊っちで、いいでさあ」と道也先生またいいでさあを担ぎ出した。",
              "citation": {
                "source": "野分",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "何かしかし矢代には見ているうちに、考えきれないものばかりを見事な統一をもって緊めているのを感じ、優れた塩野の腕前も次第によく分って来るのだった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "町につづいて居る小高くなって居る往還は、霜が降っても土は柔くなろうとはしず、只かしかしにかたまって、荷馬はよく蹄を破るし、人は下駄を早くいためる。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしこの村が自己の文化のためにいかにわずかしかしていないかを考えてみたまえ。",
              "citation": {
                "source": "森の生活――ウォールデン――",
                "author": "WALDEN, OR LIFE IN THE WOODS",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから「僕なんぞも厳密に言えば戦争協力の責任をまぬがれない」と言っているじゃないかしかし、それを、どうしてこんな人たちの前でわざわざ言っているのだろう？",
              "citation": {
                "source": "殺意（ストリップショウ）",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "拷問と監禁の鉄鎖の中で獄中の通信は実に苦難だった狭い窓を見た秋晴れの空はこんなにも青いだが鉄柵と、きびしい警備の隊列とは連絡された自由と青春とをこんなにも奪っているではないかしかしそれはあくまでもなされねばならぬ彼は蒼ざめた衰弱が紙よりも白くなるまで苦慮しそしてそれをなしとげた！",
              "citation": {
                "source": "同志古味峯次郎",
                "author": "――現在高知牢獄紙折工なる同氏に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――何かしかしそのことでみなさんにおいでを願うような……」「と、あたしだけじゃァないのかい？",
              "citation": {
                "source": "春泥",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「何だかしかし気味がわりいなァ。",
              "citation": {
                "source": "春泥",
                "author": "久保田万太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何だかしかし、急には信じられぬ気がした。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "話そうと思った事をあらまし話して仕舞うと、次に話す事を考えでもする様に、体に合わせて何だか小さい様に見える頭を下げて、前歯で「きせる」を不味そうにカシカシかみながら、黙り込んで居る。",
              "citation": {
                "source": "農村",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
