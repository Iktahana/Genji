          "literary": [
            {
              "text": "Ｆなる魔法使い　悲しみ嘆く葬の歌！",
              "citation": {
                "source": "レモンの花の咲く丘へ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウペシュがそれを知って悲しみ嘆く。",
              "citation": {
                "source": "スモーリヌイに翻る赤旗",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "びょうびょうと、長く尾をひいて、地の下から訴えるように、悲しみ嘆くように、――びょうびょうと、途絶えては聞え、途絶えてはまた聞えた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
