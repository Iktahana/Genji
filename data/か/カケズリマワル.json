    "definitions": [
      {
        "index": 1,
        "gloss": "to run around (wildly)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
