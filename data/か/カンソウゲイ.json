          "standard": [],
          "literary": [
            {
              "text": "この間内から大倉男爵や横山大観さんなどの歓送迎会などの席上で、京都でも一粒選りの美人を随分見る機会がありましたが、目が美しいとか生え際がいいとか、口許が可愛いとか、兎に角部分的に綺麗な人はかなり沢山ありました。",
              "citation": {
                "source": "好きな髷のことなど",
                "author": "上村松園",
                "note": "青空文庫"
              }
            },
            {
              "text": "船着き場の桟橋に建てられたアーチは、歓送迎門の額をかかげたまま、緑の杉の葉は焦茶色に変わってしまった。",
              "citation": {
                "source": "二十四の瞳",
                "author": "壺井栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "七月十三日（水曜）　十一時半迎へ来り、第一ホテルへ、有楽座の新（畑）旧（岡崎）支配人の歓送迎会である、第一ホテルは初めてだが、安直でいゝ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
