    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼はボールドウィン、キャバンディッシュ、バカテルと云う骨牌倶楽部の会員であったが、彼は惨殺される当日は、昼食後バカテル倶楽部で、ホイストの勝負をやっていたと云うことがわかっている。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして引き続き午後一ぱいは、このバカテル倶楽部で過したのであった。",
              "citation": {
                "source": "空家の冒険",
                "author": "コナン・ドイル",
                "note": "青空文庫"
              }
            },
            {
              "text": "カテルといふ語の用ゐ方が、土地によつてちがつて居るので、之を補食用の意味にカテ飯などゝいふのは、比較的新らしいことかと思ふ。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カテルという語の用い方が、土地によってちがっているので、これを補食用の意味にカテ飯などというのは、比較的新らしいことかと思う。",
              "citation": {
                "source": "食料名彙",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
