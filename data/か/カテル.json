  {
    "uuid": "5063402d-a407-5fb6-a051-f8ae4bab2aaa",
    "entry": "カテル",
    "reading": {
      "primary": "かてる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
