        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ヘアネットの髪、田舎の辮髪者の髪、三銭か四銭で切らして、仲買人、公司へ持って来て売る。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "この前髪者が一手他流試合を所望じゃとよう。",
              "citation": {
                "source": "旗本退屈男　第九話",
                "author": "江戸に帰った退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところがこれから一年も経って、二十一年の四月頃になると、師範生中には最早一人の結髪者も見えないようになった。",
              "citation": {
                "source": "私の子供時分",
                "author": "伊波普猷",
                "note": "青空文庫"
              }
            },
            {
              "text": "広東が独立して以来｜俄に断髪者が殖えたので剪髪店が大繁昌である。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日でも北京在住民の約五分の四は、依然辮髮者と傳へられて居る。",
              "citation": {
                "source": "支那人辮髮の歴史",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            },
            {
              "text": "或る者は料理人に、或る者は理髮者に、或る者は苑丁となる。",
              "citation": {
                "source": "支那の宦官",
                "author": "桑原隲藏",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
