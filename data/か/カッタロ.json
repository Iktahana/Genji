        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ポーラ鎮守府をはじめに、トリエスト、セベニコ、カッタロ、テオド、ザラ等の各軍港が、ほとんど抵抗もうけず、完全に封鎖されてしまった。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがために、敵艦隊の集中するカッタロ湾に主力を向け、まさにアルバニアのヴァロナを出港せんばかりの気配にあった。",
              "citation": {
                "source": "潜航艇「鷹の城」",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「とにかくカッタロの町へはいったら、海岸通のヘクタ貿易商会はどこだと聞けば、すぐに道を教えてくれるからね」「あいよ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのときはカッタロの町とかへ、ついているはずだ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カッタロ港とは全然おもむきのちがった港だった。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "見テイタラサゾ面白カッタロウト、予ハアトデ残念ニ思ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分顔色モ変ッテイナカッタロウシ、体モ顫エテイナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
