        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "支廳の人の案内でマーシャルきつての大酋長カブアを訪ねた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "カブア家はヤルートとアイリンラプラプとの兩地方に跨がる古い豪家で、マーシャル古譚詩の中には屡※出て來る名前ださうである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口に、八島嘉坊と漢字で書いた表札が掛かつてゐて、ヤシマカブアと振り假名が附けてある。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉の方がカブアの細君なのだといふ。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "程なく主人のカブアが呼ばれて歸つて來た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "歸途、案内の支廳の人に聞く所によれば、カブア青年は最近（私が先刻見た）妻の妹に赤ん坊を生ませて大騷ぎを引起したばかりだとのことである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "支庁の人の案内でマーシャルきっての大酋長カブアを訪ねた。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "カブア家はヤルートとアイリンラプラプとの両地方に跨がる古い豪家で、マーシャル古譚詩の中にはしばしば出て来る名前だそうである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "入口に、八島嘉坊と漢字で書いた表札が掛かっていて、ヤシマカブアと振り仮名が附けてある。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "姉の方がカブアの細君なのだという。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "程なく主人のカブアが呼ばれて帰って来た。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "帰途、案内の支庁の人に聞く所によれば、カブア青年は最近（私が先刻見た）妻の妹に赤ん坊を生ませて大騒ぎを引起したばかりだとのことである。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁重に讃えた夕食は、相客カブア公爵が旅行中にもてなしてくれたものだ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "相客のカブア公爵が完璧な英語で言った。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "相客のカブア公爵は初老のだて男、目が細く、滑稽なほどピンと口ひげを伸ばしている。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダービー優勝馬を二頭も繁殖、出走させたことを自慢できる男はそういませんよ」「かつてのゴドルフィン血統馬ですな」　とカブア公爵が探りを入れた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "同年鑑の記録によれば、カブア公爵は競馬狂。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "カブア公爵が尋ねた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "だがカブア公爵としてじゃない。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "＊　一方のカブア公爵、別名スミスはホテルの居間に籠った。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ええと、俺の立場だが、今はカブア公爵だ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "変装して、あの有名人の姿を拝借して、カブア公爵に化けて、格の違いを見せつけた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "まさか誰も知るまい、銀溜杯の出走馬コンフェティ号がカブア公爵の若駒じゃないなんて。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に述べたカブア公爵だ。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "カブア公爵なんて英国競馬界では知られてないから、誰も興味を持たない。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンフェティ号の今シーズンの出走登録はほかにされてないが、それでもやはり、カブア公爵の損失には同情を禁じ得ない』　グライドは笑いながら、椅子でくつろぎ、煙草を心ゆくまで吸い、独りごちた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
