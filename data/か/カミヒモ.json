          "literary": [
            {
              "text": "時々長い紙ひもを投げる者もある。",
              "citation": {
                "source": "先生への通信",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二三日たって気がついて見ると、一つは紙ひもがほどけかかってつぼみの軸は下方の鉛直な茎に対して四五十度ぐらいの角度に開いて斜めに下向いたままで咲いていた。",
              "citation": {
                "source": "藤棚の陰から",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の枕許には折紙でこしらえたくす玉が一ぱい天井からぶらさがっており、時折、その長い垂れさがった紙ひもが頬をなでた。",
              "citation": {
                "source": "灰色の記憶",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
