        "examples": {
          "standard": [
            {
              "text": "「髷」の字を書くときは、まず髪冠をバランスよく配置するのがコツだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "書道の先生に、髪冠の三本の払いを力強く書くよう指導された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "髪冠という名称は、その形が頭に載せる冠に似ていることからきている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "「大雨にうたれたたかれ重荷ひくうしの轍のあとかたもなし」「天地大野蠻」「壯士髮冠をつく日の出酒」「若いもの見てはうれしき今朝の春」「餘り醉ふことはなりません屠蘇の春」　といふやうな文句は今でも記憶してゐます。",
              "citation": {
                "source": "浪",
                "author": "石川三四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "主家悲報大變到來・太守父子一病一死・怒髮冠を衝く・不動祠祈願・奸女を倒す・身命塵埃・死の妙所・生の苦尚々御賢父樣御元氣の筈、宜しく御傳へ可被下候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            },
            {
              "text": "思へば／＼髮冠を突き候。",
              "citation": {
                "source": "遺牘",
                "author": "西郷隆盛",
                "note": "青空文庫"
              }
            }
          ]
        }
