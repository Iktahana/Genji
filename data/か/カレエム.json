        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "異郷で初めて逢う正月、羅馬旧教国らしいカアナバルの祭、その肉食の火曜も、ミ・カレエムの日も、彼の旅の心を深くした。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "最早羅馬旧教のカレエムが始まっていた。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "併し巴里で第一に盛な祭は三月のミカレエムだと云ふ。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けばミカレエム祭や謝肉祭のやうに人が皆仮装をして歩いたり、コンフエツチと云ふ色紙の細かく切つた物を投げ合つたりする事はこの日の祭にはないのである。",
              "citation": {
                "source": "巴里より",
                "author": "與謝野寛、與謝野晶子",
                "note": "青空文庫"
              }
            },
            {
              "text": "聞けばミカレエム祭や謝肉祭のやうに人が皆假裝をして歩いたり、コンフエツチと云ふ色紙の細かく切つた物を投げ合つたりする事はこの日の祭にはないのである。",
              "citation": {
                "source": "巴里の獨立祭",
                "author": "與謝野晶子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
