    "definitions": [
      {
        "index": 1,
        "gloss": "to mesh (of gears, cogs, etc.)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "古い時計の内部を開けてみると、錆びついた歯車がうまく噛み合わずに止まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "エンジンの回転を上げるにつれ、金属同士がカチリと噛み合う音が聞こえる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この複雑なパズルは、全てのピースが完璧に噛み合わないと完成しない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "強いて見詰めたものは、目を損いながら、火の柱の中に鬼神が珠を掴み上げる腕の形を見たとか、竜が噛み合う姿を見たとか言った。",
              "citation": {
                "source": "宝永噴火",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "内地の生活の密度が濃いとでもいうのか、または、その密度の濃い生活とぴったり噛み合う歯車が僕たちの頭脳の中にあって、それで気持の弛緩が無く一時間の旅でもあんなに大仕事のように思われて来るのかね。",
              "citation": {
                "source": "雀",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "惚れた女の腹の中で、じたばたでんぐり返しを打って騒ぐ、噛み合う、掴み合う、引掻き合う。",
              "citation": {
                "source": "星女郎",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛み合うように固く胸高に腕ぐみをして、上体をのめるほど前にかしげながら、泣かんばかりの気分になって、彼はあのみじめな子供からどんどん行く手も定めず遠ざかって行った。",
              "citation": {
                "source": "卑怯者",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐らくその無数の腐りかかった肺臓は、低い街々の陽のあたらぬ屋根裏や塵埃溜や、それともまたは、歯車の噛み合う機械や飲食店の積み重なった器物の中へ、胞子を無数に撒きながら、この丘の花園の中へ寄り集って来たものに相違ない。",
              "citation": {
                "source": "花園の思想",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛み合う歯車の面前を、隊伍を組んだ糸の大群が疾走した。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "箇性の持って居る力と、人間の与えられた宿命的な（少くとも現今に於ては）本能が、ともに噛み合う事を又更に思わずには居られなかった。",
              "citation": {
                "source": "樹蔭雑記",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "自己の劃したる檻内に咆哮して、互に噛み合う術は心得ている。",
              "citation": {
                "source": "文芸委員は何をするか",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーイッ、カンカンカン、硬い金属が、軋み合い、噛み合うような、鋭い悲鳴だった」「大方、工場に、鼠が暴れてるんだろう」わしは、不機嫌に云い放った。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある時、裏の方で烈しい犬の噛み合う声がするので、出て見ると、黒と白とが彼｜天狗犬を散々咬んで居た。",
              "citation": {
                "source": "みみずのたはこと",
                "author": "徳冨健次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蝶の噛み合う歯の音まで歴々と聞えるのであります。",
              "citation": {
                "source": "大菩薩峠",
                "author": "お銀様の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "安岡っ引に御用呼ばわりなどをされる覚えはねえ、側へ寄ると河童をけしかけるぞ」「神妙にせい」「糞でも喰らえッ」　二匹の犬のように、猛然と噛み合う二人、後ろからは女房がガラッ八の髷節へ、必死とブラ下がってしまいました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "路地の小判",
                "note": "青空文庫"
              }
            },
            {
              "text": "互に歯紋をなして噛み合うのである。",
              "citation": {
                "source": "樺細工の道",
                "author": "柳宗悦",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛み合う赤い口、おお、彼らは噛み合ったのだ。",
              "citation": {
                "source": "人間豹",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして栄えを祈る文化を打ち建てながら、その文化の下で、もう浅ましい生活や慾望が血みどろで地上に噛み合う。",
              "citation": {
                "source": "宮本武蔵",
                "author": "空の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが二階のビュティ・パーラーの髪の焼ける臭気と、鏝のかみあう響と、シャンプする水の流れる音に交錯した。",
              "citation": {
                "source": "女百貨店",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い衆をまず芝居がかりで脅かし、また、旦那とかみあう時に同様の手口であるのはどういうものでしょう。",
              "citation": {
                "source": "随筆　寄席囃子",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、モーターらしい音にまじって、歯車と歯車とがかみあうような、そうぞうしいひびきがおこり、気のせいか、鉄ばりの部屋が、小きざみに震動しはじめたように思われます。",
              "citation": {
                "source": "妖怪博士",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛みあう氷罅、激突する氷塔の砕片。",
              "citation": {
                "source": "人外魔境",
                "author": "地軸二万哩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「こ、これは、まあ、なんと云うことだ、狼の噛みあうように」　広巳は双子に帯際に掻きつかれながら、俯伏に倒れた紺の腹掛の上に馬乗になっていた。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのおぞましい犯罪は、彼の想像のなかでしだいに細部がこまかく完成され、つぎからつぎと順をおって行われるその手順が、合理的に噛みあうようになった。",
              "citation": {
                "source": "オスカー・ブロズキー事件",
                "author": "THE CASE OF OSCAR BRODSKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "「彼と争うは利でない」　曹操は、獅子の児と噛みあう気はなかった。",
              "citation": {
                "source": "三国志",
                "author": "孔明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬つなぎではバリバリとまぐさを噛みあう音がすさまじい。",
              "citation": {
                "source": "私本太平記",
                "author": "千早帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "結局は何もかも滅びて行くのに、永遠な灰色の沈黙の中にくずれ込んでしまうのに、目前の貪婪に心火の限りを燃やして、餓鬼同様に命をかみ合うとはなんというあさましい心だろう。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時初めて、刃のかみ合う音が起って、燃えた鉄のにおいがやみに散った。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで世間無知の輩は、早くもいっさい万事これ金なりと心得、義理も人情も打ち捨てて互いに金をつかみ合うさま、飢えたる獣の腐肉を争うがごときに至る。",
              "citation": {
                "source": "貧乏物語",
                "author": "河上肇",
                "note": "青空文庫"
              }
            },
            {
              "text": "下賤なもののけんかはけんかする同志がつかみ合う、蹴る、なぐる、やがてどちらか一方が鼻血でも出せば事がすみますがのう。",
              "citation": {
                "source": "胚胎（二幕四場）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ちここで新旧文明が苦もなくかみ合う状態を目撃するのである。",
              "citation": {
                "source": "丸の内",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            },
            {
              "text": "それらがたがいに飛びついてつかみ合う。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "里にいる女の話まで出て、まるで獣物みたいにつかみ合う者さえある。",
              "citation": {
                "source": "山を思う",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
