        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "昔の農作業では、稲を脱穀するために殻竿を使っていたんだ。大変な重労働だったんだろうな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "博物館で、木製の殻竿の実物を見たよ。ずっしりとしていて、当時の人々の暮らしが偲ばれるね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "昔の農家は殻竿を使って穀物を脱穀していた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "人間などになると、細くて長くて、まるで殻竿のようである。",
              "citation": {
                "source": "三四郎",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "人間抔になると、細くて長くて、丸で殻竿の様である。",
              "citation": {
                "source": "三四郎",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "東隣の庭からは大勢が揃つて連枷で麥を打つて居る響が、森を透して夫からどろり／＼と地を搖つて聞えた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "隣の庭では先刻よりも更に勢がついた樣に連枷の響が囃の聲を伴ひつゝ森を洩れて聞えた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "三｜人は連枷を執つて端からだん／＼と幹を打つた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "おつぎと南の女房とは相竝んで勘次に對して交互に打ち卸す連枷がどさり／＼と庭の土を打つと硬ばつた大豆の幹はしやりゝ／＼と乾燥した輕い響を交へてくすんだ穢い莢が白く割れて薄青いつやゝかな豆の粒が威勢よく跳ね出してみんな幹の下に潜り込んで畢ふ。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中では、丁度ひろい庭で麦を打つてゐる百姓達が連枷を留めてじろ／＼かれの方を見た。",
              "citation": {
                "source": "ある僧の奇蹟",
                "author": "田山花袋",
                "note": "青空文庫"
              }
            },
            {
              "text": "○連枷で打った跡のような洒落だ。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんた方は連枷で麦を打ち、箕で簸るのが仕事だったのに、今のものは機械で打ち、唐箕を使っている。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "納屋の中の連枷の不規則な律動が聞こえていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」のキャプション付きの図（fig55990_051.png、横352×縦200）入る］図‐51　この国の連枷は我々のとは全く違う。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人かがそろって連枷を使っているのを見るが、いい事に、この連枷は一つの平面のみにしか動かない。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "我国の連枷はどっちへでもくるくる廻る結果、下手な人がやると自分の頭を撲ったりするが、日本のだとそんなことは無い。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
