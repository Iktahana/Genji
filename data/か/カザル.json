    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」（パブロ・カザルスの言葉。",
              "citation": {
                "source": "人の言葉――自分の言葉",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうやら司令部の有名な怒り上戸のアカザル通信兵が出ているようです。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのアカザル通信兵という男は」　モグラ下士は、また、きいきいと呼び出し信号を出した。",
              "citation": {
                "source": "二、〇〇〇年戦争",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "殆どすべての学者、芸術家がマドリッド政府の側に在り、有名なセロの名手、私たちに馴染ふかいパブロ・カザルスが全財産を寄附したり、画家ピカソがスペイン美術をファシストの砲火から守るためにマドリッドのプラド美術館館長に任命されたりしているということを、僅かに『セルパン』のニュースで知り得る。",
              "citation": {
                "source": "文芸時評",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "汝霊有テ吾ガ言ヲ聴クト聴カザルトハ吾ガ敢テ問フ所ロニ非ズ。",
              "citation": {
                "source": "祭活字子文",
                "author": "成島柳北",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ガ虚言ヲ吐キ、詐偽ヲ働クガ如キハ嘗テ聞カザル所ニシテ、人ニ向ツテハ極メテ親切ナリ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「犬ハヨク夜ヲ守ル、人ニシテ犬ニ如カザルベケンヤ」　背の高いのが、大きな声で叫び出す。",
              "citation": {
                "source": "大菩薩峠",
                "author": "他生の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "キルギス族が、その隣人たるカザルパック族、ブカリア族、ペルシア人、トルチェメン族、カルマック族、及びロシア人に対して行う、人間や家畜や商品の掠奪と分捕は、彼らの法律により禁止されているけれども、しかも何人もこれを行ったのを自白するのを恐れる者はない。",
              "citation": {
                "source": "人口論",
                "author": "AN ESSAY ON THE PRINCIPLE OF POPULATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "サレバ客ノ此楼ニ登ツテ酔ヲ買ハント欲スルモノ、若シ特ニ某隊中ノ阿嬌第何番ノ艶語ヲ聞カンコトヲ冀フヤ、先阿嬌所属ノ一隊ノ部署ヲ窺ヒ而シテ後其ノ席ニ就カザル可カラズ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "子寿｜欣然トシテコレヲ受ケ改メズンバ措カザルナリ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "夷カニコレヲ考フレバ則チ古器ハ雅ナリトイヘドモイマダ新器ノ時用ニ適シテシカモ便ニカツ利ナルニ若カザル也。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ人ト為リ気ヲ尚ビ、厳峻ヲ以テ自ラカザルヤ輙チ咄咄トシテ慢罵ス。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "思エバ予ハ随分長イ月日ヲ生キタモノヨ、数限リモナイ移リ変リヲ経験シタモノヨト、自ラ驚カザルヲ得ナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうしてるのよ、コオ、最近は」「どうもしてない」「ライブラリーでパブロ・カザルスを聴いてたの。",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "わけて、山崎の一戦には、（大将と大将との太刀打ちにて勝敗を決せん）　と、光秀へ云い送り、また、その場に臨んでは、――味方ノ鑓ノ石突モ働カザル程、御馬印ノ瓢ヲ御詰カケナサレ　とあるを見ても、いかにこのときの彼の形相が、見敵必殺の意気に燃えていたかがわかる。",
              "citation": {
                "source": "新書太閤記",
                "author": "第八分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "初めに挙げたカザルスやヒンデミートの警告も、世界の作曲界の現状が音楽の本質を逸した過度の専門化、人為的複雑化によって、多くの人達に親しみ難いものとなりつつあることへの反省の声である。",
              "citation": {
                "source": "望ましい音楽",
                "author": "信時潔",
                "note": "青空文庫"
              }
            },
            {
              "text": "何ノ怨恨カアッテ、独リワレノミニ法ヲ説カザル。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレ臣ガマダ解カザルノ（戦袍ノ意）一｜也。",
              "citation": {
                "source": "三国志",
                "author": "五丈原の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシ臣死スルノ日ハ、内ニ余帛アリ、外ニ贏財アラシメテ、以テ、陛下ニ背カザル也。",
              "citation": {
                "source": "三国志",
                "author": "篇外余録",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
