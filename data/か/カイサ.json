        "examples": {
          "standard": [
            {
              "text": "彼は海上自衛隊の海佐として、艦隊の指揮を担当している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海佐の位置づけは陸上自衛隊の佐官に相当する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海佐に昇進するには、長年の経験が必要である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "まず第一が海釣りの神様、「火照命海佐知毘古」。",
