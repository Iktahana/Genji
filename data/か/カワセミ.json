[
  {
    "uuid": "d9cf9125-a161-5687-9c06-f21232083d5e",
    "entry": "翡翠",
    "reading": {
      "primary": "カワセミ",
      "alternatives": [
        "かわせみ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
