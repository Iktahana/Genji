          "literary": [
            {
              "text": "休之助は絶叫してさっと空打ちを入れ、二人が横っ跳びに逃げるのと逆に、抜身を持ったまま走り出した。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "万三郎は大きくうしろへ跳び、「やっ、――」　と叫んで、伸びた槍をはねあげると、そのまま刀を持った相手へ空打ちを入れた。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "相手はそれを空打ちと看破した。",
              "citation": {
                "source": "風流太平記",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
