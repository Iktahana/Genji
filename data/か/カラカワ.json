        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "翌日、ヤス子は大浦博士を評して、あまり図太い、まるでカラカワレテいるようで不愉快に思った、と言っていた。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は小僧にカラカワレているように不快であった。",
              "citation": {
                "source": "ジロリの女",
                "author": "――ゴロー三船とマゴコロの手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "皆さんにカラカワれるのよ。",
              "citation": {
                "source": "不連続殺人事件",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
