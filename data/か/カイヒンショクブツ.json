        "examples": {
          "standard": [
            {
              "text": "ハマヒルガオやコウボウムギなど、砂浜に自生する海浜植物が春の光の中で風に揺れていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "環境保護団体が海浜植物の分布調査を行い、外来種による在来種への影響を報告書にまとめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "砂浜の侵食を防ぐため、根を張る力の強い海浜植物を海岸線に植える取り組みが始まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "防風林を抜けると砂丘となり、海浜植物が茂っている。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
