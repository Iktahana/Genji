        "examples": {
          "standard": [
            {
              "text": "第一次世界大戦で初めて大規模な化学戦が行われたという事実は、人類の歴史における消えない傷跡となっている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ガスマスクを装着せよ！」という緊迫した号令が、化学戦を想定した過酷な訓練場で飛び交った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "国際条約で禁じられているにもかかわらず、戦地で化学戦の兆候が見られるというニュースに世界中が戦慄した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
