        "examples": {
          "standard": [
            {
              "text": "この素材は温度による可変性が高く、わずかな温度差で伸縮する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "気候モデルの可変性を評価するため、複数の観測データを比較した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "人の性格の可変性については、研究者の間でいまも議論が続いている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "赤とか紫とか其他の原色、中間色は他の色彩との関係でどのやうにも、自分をゆづる、一つの可変性をもつてゐる。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダリはセザンヌを『プラトニックな石工にすぎない』とみてゐるとか、私はダリをまた『プラトニックなシンコ細工屋』と評することができる、形態の変化は芸術家の自由ではあるが、その変化が絶対的観念に於て求められるといふことなどはない、現実の変形の可変性といふことを考へることが、芸術家の良心的態度の一種である。",
              "citation": {
                "source": "小熊秀雄全集−19−",
                "author": "美術論・画論",
                "note": "青空文庫"
              }
            }
          ]
