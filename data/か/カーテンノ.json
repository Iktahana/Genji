          "literary": [
            {
              "text": "バス・カーテンノ裂ケ目カラ、彼女ハトキ／″＼肩ダノ膝ダノ足ノ先ダノヲチラツカセタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハ予ニ背中ヲ向ケテ上半身ノ一部ヲカーテンノ外ヘ露出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――舌デ触ラナイデ唇ダケ着ケルノヨ」膝カラ上ハ顔マデスッカリ隠レテイテ、バス・カーテンノ裂ケ目カラ脛ト足ノ先ダケ出タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "バス・カーテンノ中マデ覗イテミタガ誰モイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "早クモ彼女ハバス・カーテンノ中ニ隠レテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カーテンノ蔭カラ脛ト足ガ出タ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
