        "examples": {
          "standard": [
            {
              "text": "季節限定商品は買い切りのため、注文前に数量をよく確認してください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "取次を通さず出版社と直接交渉し、返品なしの買い切りで仕入れることで利幅を確保した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "輸入食品は買い切りなので、売れ残りのリスクを考えて少量から試験的に発注した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
