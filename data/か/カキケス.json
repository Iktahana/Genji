[
  {
    "uuid": "da082638-68dc-5b7b-bb93-6d61029b8ab0",
    "entry": "かき消す",
    "reading": {
      "primary": "かきけす",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-五段-サ行",
        "動詞-他動詞"
      ],
