          "standard": [],
          "literary": [
            {
              "text": "鬪志はげしきアバンテス、彼等の領はユウボイア、カルキス及びエレトリア、ヒースチアイア葡萄の地、ケーリントスの港市、更にヂオスの高き都市、更に其領カリストス、更に其郷スチュラの地、エレプェーノール（その父はカルコードーン）アレースを　540祖先となして猛勇のアバンテス族導きぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "「時間的および名声でヒポクラテスに次ぐ」（プリニウス）ところのカリストス（エウボイア島）のディオクレス（紀元前４世紀）は鋭い解剖学者であり百科全書的な著作者であった。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "３　カリストスのディオクレス（紀元前５世紀〜４世紀）　ヒポクラテス学派の伝統は続いた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            },
            {
              "text": "ディオクレスと呼ばれた人でエウボイア島のカリストスに生まれた。",
              "citation": {
                "source": "偉大な医師たち",
                "author": "伝記による医学史",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
