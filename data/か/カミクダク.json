    "definitions": [
      {
        "index": 1,
        "gloss": "to crunch",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "硬い煎餅をバリバリと噛み砕く音が、静かな部屋に響いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "リスは、木の実を器用に口に含み、小さな歯で噛み砕いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「うわ、この飴、硬い！」と言いながら、彼は苦戦して噛み砕こうとした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "橙紅色の丸薬のような実の落ち散ったのを拾って噛み砕くと堅い核の中に白い仁があってそれが特殊な甘味をもっているのであった。",
              "citation": {
                "source": "郷土的味覚",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "サア、御心配なく口を開いて……もっと上を向いて……そうそう……」　食道鏡が突き込まれると、松浦先生は天井を仰いだまま、開口器を噛み砕くかと思うほど苦悶し初めた。",
              "citation": {
                "source": "いなか、の、じけん",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "かけらがくちびるからひっこんだと見ると急に四股を踏むようなおおぎょうな身振りをしながらばりばりとそのガラスを噛み砕く音を立て始めた。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛み砕く音がだんだんに弱く細かくなって行った。",
              "citation": {
                "source": "柿の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "昼飯にも夕飯にも塩雑魚をあぶつて食べる、なか／＼よい味である、それにつけても、噛み砕く歯が欲しい。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨を噛み砕く音がした。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々、カルパシヤの山々で、ちやうど数千の水車場が一時に水音を立てるやうな物凄い音が聞える――それはまだ誰ひとり怖れて覗いて見たこともない、底無しの深淵で、亡者どもが一人の死人を噛み砕く音である。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその間にもう此のガツ／＼した虫は、直ぐに噛み砕くであらう次の木虱をねらつてゐるのだ。",
              "citation": {
                "source": "科学の不思議",
                "author": "STORY-BOOK OF SCIENCE",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのまま昂らせて置いたら、歯は一枚もなくなるまで噛み砕くだろう、何という、何という女だ、あの赤ん坊をまもるためには奴は何をするか判らない、袴野は生れてはじめて怖れというものを、間近の、寝床ではだらしのないすてから感じた。",
              "citation": {
                "source": "舌を噛み切った女",
                "author": "またはすて姫",
                "note": "青空文庫"
              }
            },
            {
              "text": "窖の底で何かを噛み砕く音がし、電灯の運命を物語っていたのだが、それに気を留めもしなかった。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼の眼は、ごく細かな物の断片を嘴でくわえてそれを一瞬間に噛み砕くような、それらのパリー人やユダヤ人などの眼と違っていた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "すべてを噛み砕く死もかえって己が歯をこわすであろう。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "長い準備期間があったという福山の説は、こんなふうに噛み砕くと、理屈としてきわめてすっきりと成立します。",
              "citation": {
                "source": "道順は彼女に訊く",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「田川の奥さんという人はほんとうにひどい人ね」　葉子は歯をかみくだくように鳴らしながらいった。",
              "citation": {
                "source": "或る女",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちの物理学の世界に対する知識は現象にとりまかれつつ相当乱雑なままに放られていて、たとえば岩波新書の「物理学はいかに創られたか」（石原純訳、アインシュタイン著）を、表現が砕けていると同じかみくだく理解の力で読みこなせるものが、私たちの周囲に何人あるだろう。",
              "citation": {
                "source": "科学の常識のため",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "骨をかみくだくひびきとはげしい水音が騒然といりまじってうしろの密林に反響した。",
              "citation": {
                "source": "三界万霊塔",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "渡瀬はできるだけ解りやすくと、噛みくだくようにものをいっていたが符号や数字が眼の前に数限りなくならんでいるのを辿っていくと、新井田氏の存在などはだんだん薄ぼやけてきた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今に至るもカルパシヤの、峯に駒をば打ち立てて、不思議の騎士は底もなき、奈落の淵に亡霊が、あまた一つの屍を、噛みくだく有様と、今ひとつなる屍が、地中にありて次ぎ次ぎと、成長しつつ堪へ難き、苦痛に我れと我が骨を、噛みつつ大地をどよめかす、その有様を見まもるなり。",
              "citation": {
                "source": "ディカーニカ近郷夜話　後篇",
                "author": "VECHERA NA HUTORE BLIZ DIKANIKI",
                "note": "青空文庫"
              }
            },
            {
              "text": "シベリアから雪と氷とを追放するぐらいのことが出来ないで、へん、何が金博士さまだ」「やろうと思えば、そんなことぐらい訳なしだ」　金博士が、西瓜を噛みくだく間に、ぽつんぽつんと言葉を挟んでいった。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "………他の獣の窩へ這い込む、蟻塚をやたらに荒らす、蝸牛を殻ごと噛みくだく。",
              "citation": {
                "source": "決闘",
                "author": "ДУЭЛЬ",
                "note": "青空文庫"
              }
            },
            {
              "text": "暫く吹いてゐて不意にピタリと吹き止め、目を据えたかと思ふと、そのハーモニカをバリバリ噛みくだく。",
              "citation": {
                "source": "妻恋行",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "菓子がやわらかな噛みくだく必要のないものになったのは新らしいことである。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "前のは不意に雷のように宝に打たれて、後からそれをかみ砕くところに味があり、後のは探り求める道程に苦しみも楽しみもあって、最後に獲た宝にそれが昇華する。",
              "citation": {
                "source": "ある偃松の独白",
                "author": "中村清太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "噛砕くと不味う御座いますから、微温湯か何かで其儘お嚥みになる様に。",
              "citation": {
                "source": "鳥影",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "だいぶん風が出て来て、さしものふかいガスも少しずつ吹き散らされてきたようだが、そのかわり波が高くなって、わたし達の立っているデッキから三十メートル真下の岩鼻に、眩暈のしそうな波頭がパッパッと白く噛み砕ける。",
              "citation": {
                "source": "灯台鬼",
                "author": "大阪圭吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "糞の中には一寸ばかりに噛み砕ける篠竹あり。",
              "citation": {
                "source": "山の人生",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
