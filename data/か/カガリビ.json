[
  {
    "uuid": "4732c42e-91dc-5e13-a7b1-ab192a596a71",
    "entry": "かがり火",
    "reading": {
      "primary": "かがりび",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
