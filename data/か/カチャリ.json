    "definitions": [
      {
        "index": 1,
        "gloss": "with a clang or a clink",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "鉄骨がぶつかり合って、かちゃりと大きな音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風で窓枠が揺れ、かちゃりと小さく鳴った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "古い時計の振り子が、かちゃり、かちゃりと規則的に音を立てる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "その時、列の中の一人の兵士が、かちゃりと剣を鳴らして二人にわざとらしい挙手の礼をした。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "大将は太い剣をかちゃりと鞘に収めた。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かちゃりと源内があけたあとから、物静かにはいっていくと、調べ方にむだがない。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "白いものがちらりと見えたり、かちゃりと鎖の音がしでもすると、私は矢を禦ぐ楯のようにいそいで傘を右に低く傾ける。",
              "citation": {
                "source": "吠える",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "円鈕を前に押しながら、開く戸に身を任せて、音なき両足を寄木の床に落した時、釘舌のかちゃりと跳ね返る音がする。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて差し込んである鍵をかちゃりと回すと、錠は苦もなく卸りた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛び上りものだ」　かちゃりと入口の円鈕を捩ったものがある。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋏はかちゃりと床の上に落ちた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "畏まった御坊は自分の手で封印を切って、かちゃりと響く音をさせながら錠を抜いた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かちゃりと、小刀があたるたびに、赤い味が笊のなかに隠れる。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのあとすぐ、何かカチャリという音を耳にしたのですが、どうも正面玄関の蝶番のようで。",
              "citation": {
                "source": "土色の顔",
                "author": "THE YELLOW FACE",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチャリと鍵をかけ、次の瞬間には、よろよろと寝台に引き返し、ない力を無理に振り絞ったため、あえぎながらぐったりとする。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」そして手錠のはまるカチャリという音。",
              "citation": {
                "source": "瀕死の探偵",
                "author": "THE ADVENTURE OF THE DYING DETECTIVE",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、また新来の若い中脊の背広の紳士が、その台の方へ行ってしきりに二つのレシーバーを耳に嵌めては、針を動かして見たり、跼んだり、透かしたりして見ていたが、それも諦めたように、耳のをはずして、カチャリと置くとこちらを向いた。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ううん――」　照準手は、把手を、カチャリと、下に引いた。",
              "citation": {
                "source": "空襲葬送曲",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "錠前は、カチャリと、もの高い音をたてて、外れたのだった。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチャリ、カチャリ。",
              "citation": {
                "source": "間諜座事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうなると、門の脇に取りつけてある郵便新聞受の金属函がカチャリと鳴り響くはずだった。",
              "citation": {
                "source": "軍用鼠",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは当市の判事セミヨン・イワーノヴィッチ・カチャリニコフが、ある集会の席で彼を批評したことばである、彼はフロックコートのボタンをきちんとかけて、黒の手袋をはめ、絹帽子を手に持って、申し分のない瀟洒な服装ではいって来た。",
              "citation": {
                "source": "カラマゾフの兄弟",
                "author": "上",
                "note": "青空文庫"
              }
            },
            {
              "text": "お豊　（カチャリと音させて茶わんを出してやりながら）ホントに、そんな阿呆なことやめにして、気持よく飲んだらええ。",
              "citation": {
                "source": "樹氷",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "厳重に掛けられたはずの掛金が、誰も手を加えないのに、独りで上へ吊り上げられて、カチャリと外れると、仏壇の扉は、中から押されるように、サッと八文字に開いたのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "怪伝白い鼠",
                "note": "青空文庫"
              }
            },
            {
              "text": "なかで、なにかカチャリといったので、さぐってみると肌身はなさない秘蔵の水独楽だ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――宋江もくだらなくなって、ともに席を蹴って出て行こうとしたが、一ト足先に出た閻婆が、カチャリと外から錠をおろしてしまった。",
              "citation": {
                "source": "新・水滸伝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗闇の中で自動ロックのカチャリという金属音。",
              "citation": {
                "source": "脳細胞日記",
                "author": "太田健一",
                "note": "青空文庫"
              }
            },
            {
              "text": "用心棒のあとについて、家の奥側へ行き、短い階段を上ると、背中を押され突然、真っ暗な部屋に入り、背後で扉が閉まり、カチャリ鍵をかけられた。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "じゃあ」　声が途切れ、カチャリと音がして、電話が切れた。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍵がカチャリとかかる音を聞いて苦虫をかんだ。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉を静かに閉め、鍵をカチャリとかけた。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "極度に緊張して張りつめた神経には、カチャリ音ですら銃声に聞こえた。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "ごめんなさい、しばらく一人にさせますね」　向かいの扉がカチャリと閉まった。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
