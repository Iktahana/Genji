[
  {
    "uuid": "fd17707b-80d9-5617-aae9-1ef85d8acc4c",
    "entry": "官邸",
    "reading": {
      "primary": "かんてい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
