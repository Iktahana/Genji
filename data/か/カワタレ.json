        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "あわれこの罪なき声、かわたれ時の淋びしき浜に響きわたりぬ。",
              "citation": {
                "source": "たき火",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "かわたれどきのその夕闇を縫い乍ら、落人たちは、シャン、シャンと鈴の音を忍ばせてすべり出るように京の町へ出ていった。",
              "citation": {
                "source": "流行暗殺節",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう日暮れに迫り、まだ電気はつかなかったが、かわたれ闇のもの悲しいひと時であった。",
              "citation": {
                "source": "草藪",
                "author": "鷹野つぎ",
                "note": "青空文庫"
              }
            },
            {
              "text": "うす靄のような暮気があたりを包んで、押上、柳島の空に夕映の余光がたゆたっていたのも束のま、まず平河山法恩寺をはじめとして近くに真成、大法、霊山、本法、永隆、本仏など寺が多い、それらの鐘楼で撞木をふる音が、かわたれの一刻を長く尾をひいて天と地のあいだに消えてゆく。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほの冷たい風に、蜘蛛の糸が銀にそよぐのを見るような、こころわびしいかわたれのひと刻である。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二月×日）積る淡雪積ると見れば消えてあとなき儚なさよ柳なよかに揺れぬれど春は心のかわたれに……。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "愛らしい首を曲げて、春は心のかわたれに……私に唄ってくれたあの少女が、四十二の男よ呪われてあれだ！",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
