        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "有り合わせの餌を一片二片とだんだん近くへ投げてやると、おしまいには、もう手に持っているカステイラなどをくちばしで引ったくって頬張る事を覚えてしまった。",
              "citation": {
                "source": "沓掛より",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "健が持つてきてくれた饅頭もうまかつたがカステイラもおいしいなあ（ぬけさうな歯が少々邪魔になる）。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "キャラメルが悪けりゃあカステイラは西班牙の言葉だぞ。",
              "citation": {
                "source": "キャラメルと飴玉",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "天才はカステイラを食べているンでしょう？",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "癪にさはつて、出されたカステイラを毟つて食べ、お茶をがぶ／＼飮んでゐた、岡本敬二坊ちやんを、眼にうかべて、わたしはそこのところを幾度も讀んだので忘れないでゐる。",
              "citation": {
                "source": "八歳の時の憤激",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤオヤ風月堂のカステイラに。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "斎「ダカラ私しがカステイラを御馳走をして上げようから。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここにカステイラがあるワ。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　そう云いながら秀子はお茶をいれて、戸棚からカステイラの箱を取り出したりなんかした。",
              "citation": {
                "source": "掠奪せられたる男",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中がカステイラを二切皿に入れて持って来た。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "兼子は試みにまたカステイラを持って来さして、手に掴らしてやった。",
              "citation": {
                "source": "子を奪う",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロクソンだのカステイラなど白石でも聞き覚えのある地名だが甲必丹にも分らないとはをかしな話で、曖昧な報告であつた。",
              "citation": {
                "source": "イノチガケ",
                "author": "――ヨワン・シローテの殉教――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこでは休憩室で、珈琲とカステイラを頂戴する。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            },
            {
              "text": "父はそんなものには目もくれず、カステイラなどはいつでも黴が生える。",
              "citation": {
                "source": "夢は呼び交す",
                "author": "――黙子覚書――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
