  },
  {
    "uuid": "f33f00d8-9d0d-54e6-b5ef-1f905598e4d0",
    "entry": "顔形",
    "reading": {
      "primary": "かおかたち",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
