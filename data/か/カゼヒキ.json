[
  {
    "uuid": "bdff6d36-d955-5fd7-9176-dbfce97b2c76",
    "entry": "風邪ひき",
    "reading": {
      "primary": "かぜひき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
