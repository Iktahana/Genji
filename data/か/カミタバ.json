          "literary": [
            {
              "text": "」　先達は蹴り、打ち叩き、髪束を掴まえて地べたに婦を引き廻した。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、聟が嫁を捉えたとなると、髪束をひっつかんだり、随分手荒なことをして連れ戻る。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜、聟が嫁を捉へたとなると、髪束をひつゝかんだり、随分手荒な事をして連れ戻る。",
              "citation": {
                "source": "最古日本の女性生活の根柢",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はジツと眺めてる髪束が風情をあたへる彼女等の、白い頸。",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
