[
  {
    "uuid": "8a890902-b030-5c54-84ac-5a129eff27c0",
    "entry": "革張り",
    "reading": {
      "primary": "かわばり",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
