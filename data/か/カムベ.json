        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "それはパトリツク・カムベル夫人といふ女優で、鶏のやうな癇高い調子を持つた女だつた。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "フロオマンは鼻を顰めてカムベル夫人を見た。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カムベルさん、何といふんです、貴女の芸は、てんでお話しにならないぢやありませんか。",
              "citation": {
                "source": "茶話",
                "author": "大正六（一九一七）年",
                "note": "青空文庫"
              }
            },
            {
              "text": "末寺にはインカムベントと称するものあり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "インカムベントのほかにキュレートと称するものあり。",
              "citation": {
                "source": "欧米各国　政教日記",
                "author": "井上円了",
                "note": "青空文庫"
              }
            },
            {
              "text": "むしろ、大同年間から生田の氏子、つまり神戸（カムベ）の民は、ここで酒を醸造しており、来舶の新羅の外客が入朝の日には、その酒を飲ませる風習があったという方が、ぼくらには耳よりな話であった。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "また、義経、範頼たちの源軍が、生田川や鵯越えから、なだれ入った当時も、なおカムベの民は住んでいたろうし、社の酒庫にもいくらかの酒瓶は残されていたのではあるまいか。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "生田ノ森の梅花を箙にさして奮戦したという梶原源太｜景季のような武者たちが、戦いも終わった夕べ、カムベの民の献酒をどんな風に飲んだであろうか。",
              "citation": {
                "source": "随筆　新平家",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
