          "literary": [
            {
              "text": "これをカクラサマという。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "七三　カクラサマの木像は遠野郷のうちに数多あり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクラサマは人のこれを信仰する者なし。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "七四　栃内のカクラサマは右の大小二つなり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "いずれのカクラサマも木の半身像にてなたの荒削りの無恰好なるものなり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カクラサマとは以前は神々の旅をして休息したもうべき場所の名なりしが、その地に常います神をかく唱うることとなれり。",
              "citation": {
                "source": "遠野物語",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
