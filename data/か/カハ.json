        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「カハ」（川、河、カワ）は「河」と実際に縁がありそうである。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "和名鈔には「顱　和名加之良乃加波長　脳蓋也」とあるそうで「カハラ」は頭の事である。",
              "citation": {
                "source": "言葉の不思議",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソハヒマビマニトリテ来シ、　　木ノ芽ノ数ヲトリカハシ、アルイハ百合ノ五｜塊ヲ、　　　　ナガ大母ニ持テトイフ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤガテ高木モ夜トナレバ、　　　サラニアシタヲ云ヒカハシ、ヒトビトオノモ松ノ野ヲ、　　　ワギ家ノカタヘイソギケリ。",
              "citation": {
                "source": "文語詩稿　一百篇",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "妻子には、トクトウニカハツタ、イマヨコハマヨリ二〇〇ノツト、イチロヘイアン、アア、ヒロイウミ、アヲイウミ　また、ある東京の友人にはこうも打った。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ、花タチノ　オドロイタ　コトニハ　ソレハ　花タチノヤウニ　キイロイ　キモノノ　カハリニ　マツシロイ　キモノヲ　キテ　ヲリマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンノ　ウデニ、オチチクサイ、シロイ　パヂヤマノ　カハイラシイ　アカチヤンガ、ダカレマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オカラヤ、ニンジンノ　シツポヤ、ウリノ　カハヤ、オゾウスヰヤ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カハノ　キシニハ　ハンノキガ　シゲツテ　ヰマシタ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "カハレテ　イク　トキ　アカイ　フウセンダマハ　イヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "大男の為ひと一倍、他人の視線を感じキョトキョトするのが、ぼくたちの非合法運動――といっても週に一度、読書会をやり、その席上アカハタを配り金を集め、出席している党のひとにその金を渡す程度――を大袈裟に自覚していたので、余計ひどくなっていたのだ。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポケットに築地の切符の切端しが残っていたので、豚箱に入れられ、ワセダの下宿先を捜査されると、始末してなかったアカハタが一部出てきた。",
              "citation": {
                "source": "さようなら",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "何人ガ大經世家タルカ大發明家大哲學者大藝術家タルカハ、彼等ノ立案スル如ク社會ガ認メテ勞働ヲ免除スト云フ事前ニ察知スベカラズシテ悉ク事後ニ認識セラルル者ナレバナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "而シテ現在吾人ノ血液ガ如何ニ多量ニ朝鮮人ノ其レヲ混ジタルカハ人類學上日本民族ハ朝鮮支那南洋及ビ土着人ノ化學的結晶ナリトセラルルニテモ明白ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "軍國主義ナルカ否カハ傭兵ト徴兵トニヨリテ決セラルル者ニアラズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて不毛をアバラケ、それよりカハラケと転して呼ぶに及んだでなかろうか。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の本棚には一冊の書物もなくなつて、鵯、山鳥、カケス、鶫、雉、鵙、雀、カハセミ等の標本が翼を並べた。",
              "citation": {
                "source": "剥製",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "文学サークルの雑誌・文学新聞・アカハタ、いろいろの民主的出版物は、いつも読者との直結をのぞんでいながら通信員を育てあげることについて消極的でした。",
              "citation": {
                "source": "平和運動と文学者",
                "author": "――一九四八年十二月二十五日、新日本文学会主催「文芸講演会」における講演――",
                "note": "青空文庫"
              }
            },
            {
              "text": "アカハタの読者から集めた批判の欄に、主観的な誇張のない記事をのせてくれという一項目がありました。",
              "citation": {
                "source": "平和運動と文学者",
                "author": "――一九四八年十二月二十五日、新日本文学会主催「文芸講演会」における講演――",
                "note": "青空文庫"
              }
            },
            {
              "text": "去る三月九日のアカハタにもしるしたとおりであり、これらについては反覆する必要はないでしょう。",
              "citation": {
                "source": "文学について",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い評論家の藤川徹至はこの「文学者御前会議」を『アカハタ』の上で粗末に批難した。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『アカハタ』にはぬやま・ひろしの「大うけだった恋愛談義」という見出で記事がのりました。",
              "citation": {
                "source": "生きるための恋愛",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "新聞購讀者の表を見たが、南日本が三百六部、朝日が八十七部、毎日が六十八部、讀賣が十三部、アカハタが二部となつてゐた。",
              "citation": {
                "source": "屋久島紀行",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "事務官の堺といふ、もう白髪をいたゞいた老人が、「昔は、こゝも、ほとんど朝鮮人労働者ばかりでしたが、今は全部日本人で、満洲、朝鮮からの引揚げ者に変り、アカハタ新聞が、五部ばかり、此の島へ送つて来るやうになつてをります。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヒコートウノコージハオモイノホカハヤクデキアガルコトガワカッタタブン三シユウカンノノチトオモワレル。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本共産党は機関紙として『アカハタ』を発刊した。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
