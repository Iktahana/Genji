        "examples": {
          "standard": [
            {
              "text": "このテント、張るのが簡単だね！まさにかまぼこ型で、設営が楽ちんだわ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "保育園の先生が、粘土でかまぼこ型のおもちゃを作ってくれた。子供たちが喜んで遊んでるよ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "最近のカーポートは、かまぼこ型をしたデザインのものが多いんだね。雨風を防いでくれそう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このトンネルは、掘削断面がかまぼこ型になっているらしい。水が溜まりにくくて良いんだろうな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
      }
