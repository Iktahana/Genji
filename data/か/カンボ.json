[
  {
    "uuid": "f85f9e77-8214-5a51-af0e-a394f5688b60",
    "entry": "完母",
    "reading": {
      "primary": "かんぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
