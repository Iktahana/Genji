      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "exclusive breastfeeding",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "初めての出産で、完母で育てられるか不安だったけれど、なんとかなった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "完母だと、授乳のタイミングが読みにくくて、外出が少し大変だと感じる人もいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「完母で母乳育児を頑張る！」と意気込んでいた友人が、色々あってミルクに切り替えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "母乳育児は『完母』『混合』『ミルク』と選択肢があるけれど、どれも素晴らしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "母親が早く亡くなっちゃったから、あかんぼのうちから襁褓を自分で洗濯して、自分で当てがった」　老妓は「まさか」と笑ったが、悲しい顔付きになって、こう云った。",
              "citation": {
                "source": "老妓抄",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……時間を思っても、まだ小学校前らしいのが、手に、すかんぼも茅花も持たないけれど、摘み草の夢の中を歩行くように、うっとりとした顔をしたのと、径の角で行逢った。",
              "citation": {
                "source": "若菜のうち",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もう直きあかんぼを生みます。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしなぜだかわたしの生むあかんぼよりあなたの研究から生れる新種の金魚を見るのが楽しみなくらいよ。",
              "citation": {
                "source": "金魚撩乱",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハンスの生きていたころ、まだ、ほんのあかんぼうだった人たちが、今はもう、かみの毛が雪のように白くなって、まごたちのおもりをしていました。",
              "citation": {
                "source": "丘の銅像",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、きょ年の夏、兵太郎君と川あそびにいって、川からあがったばかりの、ぴかぴか光るおたがいのはだかんぼうを、おいしげった夏草の上でぶつけあい、くるいあって、たがいに際限もなくわらいころげたことだった。",
              "citation": {
                "source": "川",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "鶏や、雀と違って、ただ聞いても、鴛鴦だの、白鷺のあかんぼには、博物にほとんど無関心な銑吉も、聞きつつ、早くまず耳を傾けた。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……今夜の豆撒が済むと、片原で年を取って、あかんぼも二つになると、隠居たちも笑っていました。",
              "citation": {
                "source": "神鷺之巻",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処で投げつけるやうなあかんぼの声がする。",
              "citation": {
                "source": "東京景物詩及其他",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "鍬打つ、鍬打つ、振りかへつて鍬打つ、とべらの木の下ではあかんぼがすやすや、鶏がコケツコツコ。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぎあとあかんぼが啼き出した。",
              "citation": {
                "source": "畑の祭",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "だんすあらしあらししだれやなぎに光あれあかんぼのへその芽水銀｜歇私的利亞はるきたりあしうらぞあらしをまろめ愛のさもわるに烏龍茶をかなしましむるかあらしは天に蹴上げられ。",
              "citation": {
                "source": "聖三稜玻璃",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが、これは天祐といふもので、いくら自分が君達をいれてあげやうとしたところで駄目なんだ」　そこには可愛らしい肉附の、むつちり肥つたあかんぼが母親に抱かれて、すやすやと眠つてゐました。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頬つぺたに蚊が吸ひつくと、あかんぼは目をさまして泣きだしました。",
              "citation": {
                "source": "ちるちる・みちる",
                "author": "山村暮鳥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ゲルダがそのあとで、絵本をもってあそびにきたとき、カイは、そんなもの、かあさんにだっこされている、あかんぼのみるものだ、といいました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            },
            {
              "text": "夫人の姿像のうちには、胸ややあらわに、あかんぼのお釈迦様を抱かるるのがあるから、――憚りつつも謹んで説おう。",
              "citation": {
                "source": "夫人利生記",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが不圖したことからある近親の人の眼を患つて肥前｜小濱の湯治場に滯留してゐた頃、母と乳母とあかんぼと遙ばる船から海を渡つて見舞に行つた當時の出來事だということがわかつた。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そつと墮胎したあかんぼの蒼い頭か、金茶の眼、ある日、あるとき、ある人が生埋にした私生兒のその兒さがすや、金茶の眼、百合の根かたをよく見れば燐は濕めりてつき纒ひ、球のあたまは曝らされて爪に掻かれて日に光る。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あかんぼ昨日うまれたあかんぼを、その眼を、指を、ちんぼこを、眞夏眞晝の醜さに憎さも憎く睨む時。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "『そのあかんぼを食べたし。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつはさみしき唇にカステラの粉をあつるとき、ひとりとくとく乳ねぶるあかんぼの頭にくらしや。",
              "citation": {
                "source": "思ひ出　抒情小曲集",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
