  {
    "uuid": "20952dc5-f68c-5ea5-9d55-d1eadce707d4",
    "entry": "カンボ",
    "reading": {
      "primary": "かんぼ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "スカンボの花などもさっぱり見所のないもののように思っていたが、顕微鏡で見るとこれも実に堂々たる傑作品である。",
              "citation": {
                "source": "高原",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は、カンボジヤ華僑、現在、為替経紀。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "母は、カンボジヤ女、シソワットの居城、王宮付舞妓であった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "上海プノンペン間を商用にて往来する父にカンボジヤ国より檳榔子の実を土産に買ってきてもらう。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてカンボジヤエロチシズムを発散す。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "郷愁は、ノラが五歳になったとき父はカンボジヤ女である母と娘を連れて上海にやってきた。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は江蘇省、海州に生れたカンボジヤ華僑であった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はサイゴンとプノンペンを往来する商権の保持と、為替ブローカーをやり、かたわらカンボジヤとシャムの国境に巨大なゴム園を経営していた。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "母はノラにカンボジヤの熱帯の景観について話して聞かしてくれた。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "プノンペンの街、タマリンドの街路樹、メコン河の流れ、シソワット王の城内、彼方には椰子の林があり、赫熱とした熱帯の強烈な太陽の直射と、熱風を避けた王城内でノラの母はシソワット王と廷臣の居並ぶ玉座のまえで、オーケストラと数十人の唄い手の歌声のなかで華麗な彼女はカンボジヤの踊りを舞うのだった。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "また彼はプノンペンから自動車に搭乗して国境のゴム園に車をカンボジヤの原野、白鷺の飛ぶ直線道路を、水田に遊ぶ水牛のなかを疾走させた。",
              "citation": {
                "source": "新種族ノラ",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベタ・カンボジャという魚らしい。",
              "citation": {
                "source": "試験管",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "高麗、唐土、暹羅国、カンボジャ、スマトラ、安南、天竺、世界ははて無く広がって居りまする。",
              "citation": {
                "source": "雪たたき",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オヤ、ヲバサン、アカンボガ　ウマレルノデスカ」「モウ　ウマレテ　ヲリマス。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デモ　マダ　オメメヲ　トヂテ　ネネシテ　ヰルノデスヨ」　花タチハ　ウマノ　アカンボヲ　ミタイト　オモヒマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オウマノ　ヲバサン　コンニチハ」「オヤ　テフテフサン　コンニチハ」「アカチヤンノ　オメメハ　アキマシタカ」「ケサ　ヤツト　アキマシタ」　ミルト　オウマノ　アカンボハ　ネワラノ　ナカデ　パツチリ　オメメヲ　アケテ　オトナシク　シテ　ヰマシタ。",
              "citation": {
                "source": "ウマヤノ　ソバノ　ナタネ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "アル　ヒ、アカンボヲ　セヲツタ　コモリガ　ヤツテ　キテ、イツセンデ　ソノ　チヒサイ　アカイ　フウセンダマヲ　カヒマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネンネン　ヨヲヲヲ　ネンネン　ヨウ」　シカシ、アカンボウヨリ　サキニ、コモリノ　ハウガ　ウツラ　ウツラ　ネムリハジメマシタ。",
              "citation": {
                "source": "ツイテ　イツタ　テフテフ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に述べたカンボジア初王の前身大蜥蜴だった故、国民今に重舌を遣うとあるはこの物だろう。",
              "citation": {
                "source": "十二支考",
                "author": "田原藤太竜宮入りの話",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンボジヤの俗信に竹の梢に或る特種の蘭が寄生すると、その竹幹中に一の小仏像が潜みある、尿で潤した布片でその幹を巻き竹を割るとこれを獲る。",
              "citation": {
                "source": "十二支考",
                "author": "馬に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくて日本、カンボジア、蒙古人等が鼠牛虎兎というと異なり、子丑寅卯と形而上の物の名で数える事となってより十二支と十二禽を離して念ずる事が出来た。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンボジアでも伝来の金剣を盗まば王となり、これなくば太子も王たるを得ず（『真臘風土記』）。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンボジア人言うは虎｜栖より出る時、何気なく尾が廻る、その尖を見て向う所を占う（アイモニエー『柬埔寨人風俗迷信記』）。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "アイモニエー曰く、猫｜往昔虎に黠智と躍越法を教えたが特り糞を埋むる秘訣のみは伝えず、これを怨んで虎今に猫を嫉むとカンボジアの俗信ずと。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "――あゝ、私、キュウカンボが食べたくなつたから、庭へ降りて剪つて来てお呉れな。",
              "citation": {
                "source": "或る五月の朝の話",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤格子九郎右衛門教之は、衛兵数人を切り仆し、カンボ・コマ皇子事駒太郎を連れて、柬埔寨国の王宮の中へ、門を排して突入った。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "……今より大略五年以前に、皇太子におわすカンボ・コマ殿下、悪人共の毒手に渡り、お行方不明になられませなんだかな？",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "驚き審かる両陛下の前で、それから私は細々とカンボ・コマ皇子をお救助け致した、五年以前の出来事を、申し上げたのでござります――。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "――「……フウム、左様か、五年以前に、柬埔寨国の皇太子、カンボ・コマ皇子を其方が、お救助け致したと申すのじゃな？",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
