        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "目の前のスペアリブがあまりに硬くて、奥歯で全力で噛み千切るしかなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ダメだってば！それはお父さんの大事なネクタイだよ！」と叫んだが、愛犬はすでにそれを噛み千切っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "梱包用のビニールテープが手元にハサミがなくて、思わず口で噛み千切ってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼は震える手で、忌まわしい過去が書かれた書類をズタズタに噛み千切った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "アゴが足にくっついているから、口を開けるのもむりに近いのに、なんとかやりとげて、ついにキノコのかさをちょびっとかみちぎる。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
