    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "阿部近日東京出立に付、分家、清川、森、関藤（菓子料二百疋添）等へ書状出す。",
              "citation": {
                "source": "伊沢蘭軒",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "只の一度でも義男は父親の許へ菓子料一とつ送つた事はなかつた。",
              "citation": {
                "source": "木乃伊の口紅",
                "author": "田村俊子",
                "note": "青空文庫"
              }
            },
            {
              "text": "悪い友には誘はれ易く、茶屋が二階の朝酒に、舌鼓打つその頃は、菓子料や薬礼も、大方おれが袂のもの。",
              "citation": {
                "source": "移民学園",
                "author": "清水紫琴",
                "note": "青空文庫"
              }
            },
            {
              "text": "重ね／＼喜びの記念に、此金を全部お菓子料として、白衣の勇士を慰問しては如何』といふ。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで香泉さんと私とは其お菓子料に添える爲めに、又一息筆を走らせて三十五枚の色紙が出來た。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "最上の粉は主としてビスケット業者および菓子料理人が使い、低級のものはパンを作るのに使われる。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "菓子料理人が作ったニーガス酒やレモネード、およびロンドンの居酒屋で売っているポンチと呼ばれる酒、はふつう酒石酸で作られている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "菓子料理人は銅の流し型の中でタートを焼いている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
