        "examples": {
          "standard": [
            {
              "text": "来月からは事務所の貸し料が上がるらしい、経営を圧迫するな。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このアパートは駅に近い割に貸し料が手頃なので、すぐに借り手が見つかるだろう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "大家さんから来月の貸し料の振込先を確認する連絡が来た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "貸し料を滞納すると、契約解除になる可能性もあるから気を付けて。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
