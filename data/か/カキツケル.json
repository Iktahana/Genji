[
  {
    "uuid": "5d043b0d-9dab-5454-a547-d0bfd455d51f",
    "entry": "書き付ける",
    "reading": {
      "primary": "かきつける",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "動詞-一段",
        "動詞-他動詞"
      ],
