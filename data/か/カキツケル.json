      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "to write down",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "大事なことだから、手帳に書き付けておこう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "彼は彼女の住所を慌てて紙切れに書き付けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "思いついたアイデアを忘れないうちに書き付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "黒板に今日の予定を書き付ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "この時「自然詩人」は感興の対象なる事象物象をセンチメンタルに、あまりにも生理作用で書き付ける。",
              "citation": {
                "source": "河上に呈する詩論",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "」友人は手帳を一枚破って数語書き付ける。",
              "citation": {
                "source": "自転車乗りの影",
                "author": "THE ADVENTURE OF THE SOLITARY CYCLIST",
                "note": "青空文庫"
              }
            },
            {
              "text": "女はかく色彩のある衣を熱愛するがゆえに従ってそれを染める（書き付ける、すなわち摺り付ける）料になる実を女に贈り与えるのはそこに大いに意義がある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は筆と紙を取り出でて、死なんとする人の言の葉を一々に書き付ける。",
              "citation": {
                "source": "薤露行",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "贄といふ船着で、隣の室に若い男と女が戯れて終夜騒いで居ても、袂の手帳に歌をかきつける余裕を失はないやうなのが其時の私であつた。",
              "citation": {
                "source": "春雨にぬれた旅",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "伸子はそういう買物をめずらしがって、フロマージュ（チーズ）六ヶ四フラン四〇サンティーム、クッキー一二五グラム三フラン五五サンティーム、玉子二ヶ（上）一フラン七〇サンティーム、桜んぼキロ四フラン、など、手帖にかきつけるのだった。",
              "citation": {
                "source": "道標",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あんまりキューとひきつめていていやなので、殆ど元のとおりですが、左の方をすこしわけるようにしてかきつけることにしたのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりあなたがおかきになるようにかきつけるわけです、はじめ横に、それからずっと上の方へ。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三九年（昭和十四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記をつける時間さえ惜しいような気がして来て、自重とでも言うのであろうか、くだらぬ事をいちいち日記に書きつけるのは、子供のままごと遊びのようで悲しい事だと思うようになった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日誌、日誌、ぼくはこの書きつける日誌がなかったら今夜どうしているだろう。",
              "citation": {
                "source": "或る農学生の日誌",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "庄造「坐った序でに、胸のポケットを見たらどうだね、庄平」庄平（言われた通りにする）「ああ、ありました」（万年筆を抜き取る）庄平、手帳に何か書きつける。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "われわれには、だれひとりとして、じまんすべきものは、なにもないのだ」　詩人は、こう書きつけると、比喩として、「名人と楽器」という題をつけました。",
              "citation": {
                "source": "ペンとインキつぼ",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "心のうちに花嫁の姿を浮べて、当時の様を想像して見てしたり顔に、花の頃を越えてかしこし馬に嫁と書きつける。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この心からの要求はかなりはげしかったので、そのためにわたしは三年近くも黙して暮すようになり、いつ始めるともなくこんなスケッチを始め、これを手帳に書きつけることを自分の日課のようにした。",
              "citation": {
                "source": "千曲川のスケッチ",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "石垣に近い縁側の突き当たりは、壁によせて末子の小さい風琴も置いてあるところで、その上には時々の用事なぞを書きつける黒板も掛けてある。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "餞の言葉（新潮社發行大衆雜誌『日の出』の創刊に際して）『日の出』の編輯氏から、その創刊號のはじに何か書きつけることを求められた。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "過ぐる日、西村君はわたしのもとに手紙を寄せられ、旅の※話をわたしに分ち、この鳩について何かわたしにも書きつけることを求められた。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "トルストイ（原久一郎君よりその譯書『トルストイの聖書』のために、何か書きつけることを求められて。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしのやうにして君の出發を迎へたものが、今また君を惜しむ諸君の仲間入りをして、こんな記念をこゝに書きつけるといふことは、これも何かの縁かと思ふ。",
              "citation": {
                "source": "桃の雫",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ベランダの下には、芋をもむような人の頭、夫人は黒眼鏡をズリ上げながら、メモに何か書きつける。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうかすると彼自身筆を執ってその話を書きつけるよりも多くの時間を要した。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "いそがしいのにこんなことを書いて僅に自ら慰めるとか、滝のように汗を流して働いた後で復た書きつけるとか、そんな言葉を添えたものもある。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "（この日記終り）空襲都日記（二）　この騒然たる空の下、事実を拾うはなかなか困難であり、それを書きつけるは一層難事であるが、私としては出来るだけ書き残して行きたいと思う。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや、いまさらおれはこんなことをくどくどと書きつける必要はない。",
              "citation": {
                "source": "蜘蛛",
                "author": "甲賀三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〔欄外に〕　　起床その他ちゃんと書きつけること、お約束を新たにいたします。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「――ろく」「いくつだ」「二十三」　いしは、駐在がこんな不意のときでも、ちゃんと手帳を出し、一々書きつけるのを、憎らしいと思った。",
              "citation": {
                "source": "小村淡彩",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "悲しい最後の言葉を書きつけるのだ。",
              "citation": {
                "source": "昭和遊撃隊",
                "author": "平田晋策",
                "note": "青空文庫"
              }
            },
            {
              "text": "ときれいにかざりたるプログレムを出して名を書きつける。",
              "citation": {
                "source": "藪の鶯",
                "author": "三宅花圃",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると私は、その文章を書きつけるのでした。",
              "citation": {
                "source": "ガリバー旅行記",
                "author": "GULLIVER'S TRAVELS",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうした例の一つとして、日本人の考へた山越しの阿彌陀像の由來と、之が書きたくなつた、私一個の事情をここに書きつける。",
              "citation": {
                "source": "山越しの彌陀",
                "author": "釈迢空",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
