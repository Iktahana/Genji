        "examples": {
          "standard": [
            {
              "text": "大学二年次に解析学の講義を受け、ε-δ論法に初めて触れた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "解析学の教科書を何度読み返しても、一様収束の概念がなかなか飲み込めなかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "数学科では微積分の厳密な基礎として解析学が必修科目に指定されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "「このごろでは、解析学の始めに集合論を述べる習慣があります。",
              "citation": {
                "source": "愛と美について",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ことに、その最高の部門であって、ただ逆行的なやり方をするというだけで、不当にも、とくに解析学と呼ばれているものによってだ。",
              "citation": {
                "source": "モルグ街の殺人事件",
                "author": "THE MURDERS IN THE RUE MORGUE",
                "note": "青空文庫"
              }
            },
            {
              "text": "実のところ彼は学期末(*5)にあって解析学Ｄと上級一般心理学を落としており、まだ今なら失地を回復できるという一縷の想いで背水の陣を布いていたのだ。",
              "citation": {
                "source": "魔女の家で見た夢",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
