        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まっ黒な着物を着たばけものが右左から十人ばかり大きなシャベルを持ったりきらきらするフォークをかついだりして出て来て「おキレの角はカンカンカン　ばけもの麦はベランべランベラン　ひばり、チッチクチッチクチー　フォークのひかりはサンサンサン。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お空のひかり、おてんとさまは、カンカンカン、月のあかりは、ツンツンツン、ほしのひかりの、ピッカリコ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……電車通りへ突つ立つて、こんなお話をしたんぢあ、あはれも、不氣味も通り越して、お不動樣の縁日にカンカンカンカンカン――と小屋掛で鉦をたゝくのも同然ですがね。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "遠くからカンカンカンと鐘の音が雪の上を明るく聞えて来た。",
              "citation": {
                "source": "最後の胡弓弾き",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁のまん中でもやはりカンカンカンと音がします。",
              "citation": {
                "source": "雪子さんの泥棒よけ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "キーイッ、カンカンカン、硬い金属が、軋み合い、噛み合うような、鋭い悲鳴だった」「大方、工場に、鼠が暴れてるんだろう」わしは、不機嫌に云い放った。",
              "citation": {
                "source": "夜泣き鉄骨",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンカンカン、カンカンカンと、鐘の音が聞こえて来る。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜は昨夜まで八時頃から十時頃まで、山本の近さんがカンカンカンカン木魚を叩いて二十人位集ってナムアミダをやって、沢山お酒をのんで、御馳走にあずかりました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三八年（昭和十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "カンカンカンカン、音は次第に急調になり、せき込んで、遠くの暑い田の面、せみのなく樫の梢に淋しく反響する。",
              "citation": {
                "source": "一九二三年夏",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "下を、飴屋カンカラカンカンカンカン、カンカラカンカンカンと、鉦を叩いて行くのを聞いて、風と、日光と、散れて大きく響く電車の音とで、妙に凄じく感じた。",
              "citation": {
                "source": "日記",
                "author": "一九二一年（大正十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "こおった夜に聞える近い半鐘、余韻のないカンカンカンカンと云う淋しい音。",
              "citation": {
                "source": "日記",
                "author": "一九二二年（大正十一年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "四月十四日（日）　目がさめるとフロ場でカンカンカン、ガスをなおして居る。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　金属の何かを、小さい槌ででも叩いているらしい、澄み渡ったカン、カンカンカンという連続的な音で、だんだん伸子は眼を醒した。",
              "citation": {
                "source": "伸子",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "揚幕の奥はるかに「おーい、船が出えるうーだあーよううーい」と船頭の声がしてカンカンカンと木板を叩く音。",
              "citation": {
                "source": "天狗外伝　斬られの仙太",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとまたもや前面にむらがっていた敵影の中から、カンカンカンカンと※子の音が高く鳴ったと思うと、曹操の身一つを的に、八方から疾風のように箭が飛んで来た。",
              "citation": {
                "source": "三国志",
                "author": "群星の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
