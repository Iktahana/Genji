        "examples": {
          "standard": [
            {
              "text": "子供の工作で、色紙を様々な形にカットアウトして貼り合わせた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "このアニメーションでは、キャラクターの動きを滑らかにするために、手描きのカットアウトアニメーション技法が使われている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "電気回路の安全装置として、過負荷時に自動でカットアウトされる仕組みが組み込まれている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "タイムズ・スクェアをみおろすビルの壁にはギターをかかえたエルヴィスの巨大なカットアウトが飾られ、それにかぶせられていたカヴァーは、盛大なおまつりさわぎとともに、封切りの日にとりはらわれた。",
              "citation": {
                "source": "エルヴィスから始まった",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
