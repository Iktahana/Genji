        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "歴史上の権力者による姦譎な支配は、多くの人々に苦しみをもたらした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "裁判官は、被告人の姦譎な証言に惑わされることなく、真実を追求しなければならない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "人の心の姦譎さを見抜くのは、時にとても難しいものだね。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": []
        }
