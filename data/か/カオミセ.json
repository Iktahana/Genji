        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "久しぶりに同窓会で旧友に顔見せしてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "忙しいけど、挨拶だけでもと取引先に顔見せに行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は会議には顔見せしただけで、すぐに退席した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "introductory kabuki performance (to introduce the actors)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
