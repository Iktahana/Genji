        "examples": {
          "standard": [
            {
              "text": "海中展望台の丸い窓から覗くと、色鮮やかな熱帯魚が群れをなして泳いでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "桟橋から海中展望台へ続く階段を下りると、水圧で耳がきゅっと詰まる感覚がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "悪天候で視界が悪い日でも、海中展望台の中からなら安全に海底の様子を観察できる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "海中展望台　タクマ少年のいうとおりになって、僕はいくども動く道路をのりかえ、どんどんはこばれていった。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "よく見れば、それは天井についている大きな半球形の笠の中に入った電灯であり、その笠には「海中展望台」という五文字が、気のきいた字体で記されてあった。",
              "citation": {
                "source": "海底都市",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
