        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「じゃ新聞記者などをしているよりも、……」「勿論オペラ役者にでもなっていれば、カルウソオぐらいには行っていたんだ。",
              "citation": {
                "source": "彼　第二",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「パスカル夫人は、カルウと発音したようです。",
              "citation": {
                "source": "小公女",
                "author": "A LITTLE PRINCESS",
                "note": "青空文庫"
              }
            },
            {
              "text": "繩で背なかに物をくくりつけることをカルウという言葉は多くの人がまだ知っている。",
              "citation": {
                "source": "母の手毬歌",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "しからば軽井沢の元の意味いかんと言うと、自分はカルウと言う動詞の連体言カルイであろうと思う。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルウは普通の辞典には見えぬが背負うという意味の中古の俗言である。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "察するところカルウはカラム・カラグなどと語原を同じくし、縄の類で背に結い附けることであろう。",
              "citation": {
                "source": "地名の研究",
                "author": "柳田國男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カイウス・カルウスは彼に対して誹謗的な諷刺詩をたくさん書いていたが、友達を介して仲直りをしようとすると、カエサルは自分の方から先に手紙を書いた。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
