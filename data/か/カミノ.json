        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "因ってスペイン人は今も銀河をエル・カミノ・デ・サンチアゴ（サンチアゴ道）と呼ぶ。",
              "citation": {
                "source": "十二支考",
                "author": "鶏に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ母ッチャモヤセテ、目ガヒッコンデ、カミノケガヌケタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ンダオ父ッチャヨリモヤセテ、カミノケガヌケテ、ネテシマッタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一つにカミノキ、ヤマカゴ、ヒヨ、シバナワノキ（柴縄ノ木）と呼ばれる。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "マンネンタケには別にサイハイタケ、カドイデダケ、カドデダケ、キッショウダケ、レイシなどの芽出度い名もあれば、またマゴジャクシ、ネコジャクシ、ヤマノカミノシャクシなどの形から来た名もある。",
              "citation": {
                "source": "植物一日一題",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近時土屋文明氏は、「神之埼」をカミノサキと訓む説を肯定し、また紀伊新宮附近とするは万葉時代交通路の推定から不自然のようにおもわれることを指摘し、和泉日根郡の神前を以て擬するに至った。",
              "citation": {
                "source": "万葉秀歌",
                "author": "斎藤茂吉",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
