        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "川向かいに見える大きな屋敷は、昔からの地主の家だそうだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "橋を渡って川向かいの商店街へ、買い物に出かける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「見て、川向かいに虹が出てる！」と彼女が指差した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "川向かいの山の斜面が、紅葉で赤く染まっていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "十日市という川向かいの町はずれに借家住居していられたが、七つ、八つ位な可愛らしいお嬢さんを連れて路ばたで遊ばしていられるのを時々見た。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして帰る日の朝には、宿の川向かいの貧しい家に夏蚕を飼っているのを勤労の心地で眺めたり、宿の寡婦の淋しい身上話をしみじみと聞いてやれるほどおちつきを得ました。",
              "citation": {
                "source": "青春の息の痕",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "検査で幼友達に会って、女の味でも覚えたんじゃないかい」「また、川向いでは火葬だね。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺たち正月からこっち、幾つ火葬を見ただろうね」「随分の数だね」　小林飯場の川向いに、この附近の村落や、工事場で死んだ者を火葬にするための場所があった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その煙がまた、風のないために未練気に、いつまでも谿谷に立ち罩めて、川向いの飯場までも、いやな臭いを嗅がねばならなかった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "川向いの飯場でも、それに気がついて、「どうしたのであろう」と、みんな気になって時々見やった。",
              "citation": {
                "source": "山谿に生くる人々",
                "author": "――生きる為に――",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜のうちにお帰りになることは、逢いえぬ悲しさに別れの苦しさを加えるだけのものになるであろうからと思召した宮は、この家にとどまっておいでになる窮屈さもまたおつらくて、時方に計らわせて、川向いのある家へ恋人を伴って行く用意をさせるために先へそのほうへおやりになった内記が夜ふけになってから山荘へ来た。",
              "citation": {
                "source": "源氏物語",
                "author": "浮舟",
                "note": "青空文庫"
              }
            },
            {
              "text": "ある晩は料亭で、つぶ貝などを食べながら、多勢の美人の踊る音頭を見せられ、ある時はまた川向いにある彼女の叔母の縁づき先であった町長の新築の屋敷に招かれて、広大な酒蔵へ案内されたり、勾欄の下を繞って流れる水に浮いている鯉を眺めながら、彼の舌にも適うような酒を呑んだりした。",
              "citation": {
                "source": "仮装人物",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの上からは松川農場を一面に見渡して、ルベシベ、ニセコアンの連山も川向いの昆布岳も手に取るようだった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目は、石浦を経て由良の港に注ぐ大雲川の上流をたどって、一里ばかり隔った川向いに、こんもりと茂った木立ちの中から、塔の尖の見える中山に止まった。",
              "citation": {
                "source": "山椒大夫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人は群集のなかを急いで帰る拍子に、ある横町を曲ろうとする角で、川向いの方限りの某というものに突き当った。",
              "citation": {
                "source": "それから",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "川向いには山がせまって、何か支那風の気韻のある美しい景色であった。",
              "citation": {
                "source": "光り合ういのち",
                "author": "倉田百三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてその堂のなかに黒仏という真っ黒な仏像があったが、あるときこの堂の火事のとき、その黒仏が飛んで、同じ野中の川向いである立石という家の屋根の上をオーイ、オーイと呼びながら室川というほうへ飛んでいったという。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからは毎夕切り屑を焼き捨ててついに伐り倒したが、その木が倒れて対こうの川向いの山までも枝梢は打ち靡いた。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "畑の向うの崖下を流れる川面から立つ靄が、川向いの山裾をうっすらと廻っていた。",
              "citation": {
                "source": "恨なき殺人",
                "author": "宮嶋資夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は村上さんと離れたところに住み、パプアたちと飛行場をつくる手伝いをしていますうちに、パプア語がわかるようになりましたので、川向いのケクワの部落へ遊びに行き、ンブナムというスルタン（酋長）と知合いになりました。",
              "citation": {
                "source": "手紙",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "巨大なドーム、川向いには緩やかに家々の屋根をいただいた緑なす古き丘。",
              "citation": {
                "source": "チャールズ・デクスター・ウォードの事件",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            },
            {
              "text": "父は成長した後にその離別せられた祖父が恋しくて、ひそかに川向いを通って生野へ会いに行き、祖母から激しく叱られて追い出されようとしたこともあったという。",
              "citation": {
                "source": "故郷七十年",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
