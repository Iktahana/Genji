        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "剣がカチャンカチャンと云うたびに、青い火花が、まるで箒のように剣から出て、二人の顔を物凄く照らし、見物のものはみんなはらはらしていました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉛の強いお化粧をコテコテと塗って、青い事務服を着て、店一パイの硝子窓の前に並んでカチャンカチャンとタイプライターを打っていた。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "通りかかりの人が大勢、冷たい硝子窓に額や頬を押つけて、そのカチャンカチャンを飽かずに見ていた。",
              "citation": {
                "source": "東京人の堕落時代",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "お恭ちゃんが、そろそろ稽古に出かけるので、盛にカチャンカチャンバタバタをやって居ります。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "その家にては深夜になるに従い、カチャンカチャンという一種の奇怪なる声が絶えず聞こえてくる。",
              "citation": {
                "source": "おばけの正体",
                "author": "井上円了",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
