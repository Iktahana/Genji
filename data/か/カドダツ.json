[
  {
    "uuid": "8c163eb8-e4dd-5911-ba1d-03a9bbe4148b",
    "entry": "角立つ",
    "reading": {
      "primary": "かどだつ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
