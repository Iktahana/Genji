[
  {
    "uuid": "50bd78ca-0619-5caa-a342-5e99d286ee87",
    "entry": "風当たり",
    "reading": {
      "primary": "かぜあたり",
      "alternatives": [
        "かざあたり"
      ],
      "is_heteronym": false
    },
    "grammar": {
