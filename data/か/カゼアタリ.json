        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "不祥事の隠蔽が発覚し、会見場での社長に対する風当たりは凄まじいものがあった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「あんな強引なやり方を続けていたら、周囲からの風当たりが強くなるのは当然だよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "若くしてリーダーに抜擢された彼女に対し、古参社員からの風当たりは冷ややかだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
