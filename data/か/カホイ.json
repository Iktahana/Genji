        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "勤めがなくて、ぽっぽにたんまりおこづけえがあって、べっぴん片手に船遊山、チャカホイ、チャカホイ、チャカチャカチャ――と、いけませんかね。",
              "citation": {
                "source": "右門捕物帖",
                "author": "開運女人地蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの上に日章旗を押したててね、（高い山から谷底見れば――）の一つも歌ってさ、皇国の光を八紘に輝やかさではおくべきや、エンサカホイ、ってわけなんだよ。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "アナタノカホイロモスヅメノアシノヨホデス。",
              "citation": {
                "source": "AU MAGASIN DE NOUVEAUTES",
                "author": "李箱",
                "note": "青空文庫"
              }
            },
            {
              "text": "椰子の木立があり、カモテやカモテン・カホイの畑があり、そこにニッパの小屋が立っている、そんな家が二、三軒あった。",
              "citation": {
                "source": "比島投降記",
                "author": "ある新聞記者の見た敗戦",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
