        "examples": {
          "standard": [
            {
              "text": "その病気には家族性の遺伝的要因が関わっているらしい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「最近、家族性の高血圧について調べる機会があったんだ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "家族性の傾向があるか、医師に相談してみるといい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "その撰者は、橘諸兄と云ひ、大伴家持と云はれ、明確ではないが、長歌短歌およそ四千五百首、上は天皇より下は庶人に至るまで、あらゆる階級の人を含み、宮廷歌集であると共に、民謡集である点に於て、わが国民の一大家族性を示した和歌集たるの観がある。",
              "citation": {
                "source": "二千六百年史抄",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
