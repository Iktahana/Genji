  {
    "uuid": "c822fa6b-6396-5647-83a2-eadee73e9b63",
    "entry": "貸元",
    "reading": {
      "primary": "かしもと",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "土台が極ると、山の貸元になって、坐っていて商売が出来るようになりました、高利は貸します。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "借りた方は精々と樹を伐り出して、貸元の店へ材木を並べるばかり。",
              "citation": {
                "source": "春昼",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　「冗談言っちゃいけねえ清水の御貸元、それァ何かの間違いだ、俺ァ人殺しなンぞした事がねえ」　「何を言やがるんだ、言い逃れは聞かねえ、立派に証人があるんだ、小五郎ッ覚悟を決めて仕度しろッ」　小五郎、突然斬って来る。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「斬られたなァ武井のお貸元の身内だと言うじゃねえか」　「そうだって。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝離れ　七五郎、傍の若い者に、　「おッ、兄哥さん、お前さんに訊ねるが、あれァ確か武井の御貸元で御座ンすね」　「そうだ」　石松が、　「そうか、あれが武井のども安親分か」　七五郎が若い者に、　「聞きゃ今日の昼間、町外れの街道で武井の御身内が一人斬られなすったと云う話だが。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "七五郎が、　「へえ、武井の御貸元で御座いますか、実は折入って……」　吉兵衛、それと見て、　「何だ、手前七五郎じゃねえか。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "安五郎は、　「さてと……俺の番だったな」　「へッ、御貸元の番で。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "この方が清水港の長五郎と云う方で……へえ長五郎さん、向って右が武井の御貸元、左が都田村の吉兵衛親分で御座います」　次郎長が安五郎に、　「初めてお目にかかります。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｓ＝庭　「清水の御貸元、裏口がこっちにあります」　「そうか、有難てえ」　石松、次郎長を庭の彼方の裏口へ案内する。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ども安の奴等もまさか此処まで追ッ掛けちゃ来めえ」　「併しお貸元、夜道は危のう御座います。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "石松、外へ向って次郎長に、　「御貸元、汚ねえ処で御座いますが、さッどうかお入んなすって……」　「あら兄さん、お客様なの」　次郎長、入って来る。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "お貸元、どうか気を悪くしねえでお呉んなせえまし、何しろ年寄りで御座いますから……」　「いや、お年寄りの怒るのも無理ァねえ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "石松、　「父っつあん、清水の御貸元が夜の明ける迄何処かで休みてえと仰言るから俺が家へお連れ申したんだ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "御貸元、さ、どうかお上んなすっておくんなせえ」　「じゃ御免なすってお呉んなせえ」　ふと次郎長の傷に気が付いた石松、　「そうだ、傷の手当をしなくっちゃならねェ……父っつあん傷薬は何処に有ったっけ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "えッ、お静、お前知らねェか」　「さあ、お隣りで借りて来ましょうか」　「いや、俺行ってくらァ、お貸元、すぐ帰ってまいります」　石松、表へ出る。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "おや、お貸元は何処へ行きなすったんだ」　源兵衛、　「あの人帰ったよ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お貸元、お貸元ッ」　闇の中に出て、呼んだが答えがない。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「変だ変だと思ったが……さては、父っつあん、お前お貸元に何か云ったな？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "父っつあんがお貸元を追い返したんだろう？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「父っつあん、なぜ、お貸元をお帰ししたんだ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "父っつあんは何故ッ、何故お貸元をッ」　「五月蝿えッ」　親子の睨み合い――　「石松、今夜はもう遅いから寝ろ」　「父っつあん、一と言云っとくが……お前が何んと云ったって、俺ァ清水のお貸元の身内になるんだ。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "行って清水のお貸元の身内になるんだ」　「石松、お前ん処の父っつあんあれで中々昔はやくざ仲間で鳴らした男だってね」　「何んだって、父っつあんがやくざ？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "先刻、清水からお客様が見えたのよ」　「清水って、お貸元の処からか？",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あるとも、代貸元をつとめる人が二十八人、是を唱えて清水の二十八人衆。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "あい度えなァ、さぞ立派なお貸元になってる事だろう」（Ｏ・Ｌ）Ｓ＝七五郎の住居の表　それは曾つての日、石松が故郷を出る時、七五郎と語ったあの場所です。",
              "citation": {
                "source": "森の石松",
                "author": "山中貞雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "自分の目算通に、信州｜追分の今井小藤太の家に、ころがり込むにしたところが、国定村の忠次とも云われた貸元が、乾児の一人も連れずに、顔を出すことは、沽券にかかわることだった。",
              "citation": {
                "source": "入れ札",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は貨殖の一端として密に高利の貸元を営みけるなり。",
              "citation": {
                "source": "金色夜叉",
                "author": "尾崎紅葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "縞の着物に手甲｜脚袢、道中合羽に一本ざし、お約束の笠を手近の縁台へ投げ出したところ、いかにも何国の誰という歴として名のあるお貸元が、ひょんな出入りから国を売ってわらじをはいているように見えるものの、さて顔を眺めると……まぎれもないあさくさ駒形の兄哥つづみの与吉。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
