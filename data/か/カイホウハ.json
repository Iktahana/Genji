        "examples": {
          "standard": [
            {
              "text": "江戸時代の富裕な商家の床の間には、海北派の画家が描いた墨絵の山水画が飾られていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "美術館の企画展では海北友松を中心とした海北派の作品が一堂に集められ、多くの来場者を集めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "海北派は桃山時代から江戸時代にかけて活躍し、力強い線描と独自の構図で知られる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そして、このわかいほうは、ふくれた乳ぶさからふたりのこどもたちに、あたたかいおちちを出してのませてくれて、そのくちの上にせっぷんしました。",
              "citation": {
                "source": "雪の女王",
                "author": "SNEDRONNINGEN",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
