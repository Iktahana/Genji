        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "コーカサスの山越えをしようとして、丁度山脈のこちら側の終点をなすウラジカウカアズという町に夜つきました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーカサスの雄大極まりない山嶽を南へ縫ってウラジ・カウカアズから、スターリンの故郷チフリースまで、立派な自動車道が通っている。",
              "citation": {
                "source": "五ヵ年計画とソヴェト同盟の文化的飛躍",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "眼玉の大きい韃靼の血の混った娘リディア・セイフリナはそのころは二十前後で、タシュケントやウラジ・カウカアズ、オレンブルグなどで舞台にたっていた。",
              "citation": {
                "source": "プロレタリア婦人作家と文化活動の問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "北コーカサスの温泉地を一晩ぐらいずつ見物して、或る晩ウラジ・カウカアズという町に着いた。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウラジ・カウカアズが、その起点となっているのであった。",
              "citation": {
                "source": "石油の都バクーへ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "処女作「マカール・チュードラ」がチフリス新聞『カウカアズ』に掲載されたのはまさにこの時なのであった。",
              "citation": {
                "source": "マクシム・ゴーリキイの人及び芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "処女作「マカール・チュードラ」がチフリス新聞『カウカアズ』に掲載されたのは、まさにこの時なのであった。",
              "citation": {
                "source": "逝けるマクシム・ゴーリキイ",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
