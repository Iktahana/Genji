        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その朝顔、入谷なるを本場とし、丸新、入又、植惣なんど、黎明より客足しげく、昔ながらの朝顔人形、どこまでも江戸ッ児は芝居気があっておかしい。",
              "citation": {
                "source": "残されたる江戸",
                "author": "柴田流星",
                "note": "青空文庫"
              }
            },
            {
              "text": "紅紫とりどりの花の色は全く目の覚める美しさ、ほかに一斗入りの大瓢箪や朝顔人形の見世物もできて大繁昌。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            },
            {
              "text": "或は又、往昔衆道の盛んでございました時分、好き者達が、馴染の色若衆の似顔人形を刻ませて、日夜愛撫したという、あの奇態な事実を御存知でいらっしゃいましょうか。",
              "citation": {
                "source": "人でなしの恋",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「僕の似顔人形を作って、おどかそうなんて」　如何にも、トランクの中の人物は、赤松警視総監の似顔人形であった。",
              "citation": {
                "source": "猟奇の果",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "人氣女優、藝者、力士の似顏人形もどうにか説明した。",
              "citation": {
                "source": "隨筆　藪柑子",
                "author": "土井八枝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
