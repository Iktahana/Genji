  {
    "uuid": "ddb5f8f6-e9de-5f00-8a87-a901d001dd2e",
    "entry": "屈み込む",
    "reading": {
      "primary": "かがみこむ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
