          "literary": [
            {
              "text": "上京して、早速、銀座のベエカリイに雇われた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "上京して、早速、銀座のベエカリイに雇はれた。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｍ・ベエカリイに寄つて茶を飮みながら一時間程話す。",
              "citation": {
                "source": "かめれおん日記",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "美しいアルカリイ泉である。",
              "citation": {
                "source": "満蒙遊記",
                "author": "附　満蒙の歌",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジョオンズ君は悠々と、南京米のカリイを平げながら、いろいろ別後の話をした。",
              "citation": {
                "source": "上海游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを聞いたルウズ氏は、カリイの皿に向いながら、忽異議を唱え出した。",
              "citation": {
                "source": "長江游記",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "カリイスカヤのゴブノビンスクだの、へんな名の村々町々を通過する。",
              "citation": {
                "source": "踊る地平線",
                "author": "踊る地平線",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月ばかり前に、僕はジャアマン・ベエカリイで或る男とはじめて會つた。",
              "citation": {
                "source": "「スタヴロギンの告白」の譯者に",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ジヤーマン・ベーカリイ……。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ベーカリイなんて云うたかて、二十年前には、誰も知らなんだよ、ほんまに……」「東京で？",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "のちのジヤーマン・ベーカリイのところにもユーロウプと呼ぶ茶館があつて、そこの二階は気の利いてゐるくせにおよそ狭くて天井が低く、宛らそのころ評判だつたアメリカ探偵映画に見る悪漢の巣窟とでもいひ度げの風景が、大きに私たちの猟奇心を満足させた。",
              "citation": {
                "source": "旧東京と蝙蝠",
                "author": "正岡容",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――近頃ハ伯父サン、オ見受ケシタトコロ大層オ元気デ」「ナーニダン／＼老イ惚レガ激シクナッテネ、毎日颯子ニ叱ラレテバカリイルヨ」「イヤ、イツマデモオ若イッテ、颯チャンガ感心シテマスガ」「飛ンデモナイ、今日モコウヤッテ鍼ナンカシテ貰ッテ、辛ウジテ露命ヲツナイデルノサ」「ソンナコトガアルモンデスカ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
