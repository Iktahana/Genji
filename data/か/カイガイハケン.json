        "examples": {
          "standard": [
            {
              "text": "国連平和維持活動への海外派遣が決まり、隊員たちは緊張した面持ちで出発式に臨んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "自衛隊の海外派遣には国会の承認が必要とされる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "海外派遣から帰還した隊員は、現地でのインフラ整備の経験を国内訓練に活かした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "人材の海外派遣、養成機関の設立準備。",
              "citation": {
                "source": "映画アカデミイについて",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "政宗の支倉六右衛門の海外派遣も見透しの大失敗であった。",
              "citation": {
                "source": "安吾の新日本地理",
                "author": "伊達政宗の城へ乗込む――仙台の巻――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それはほかでもない、当時、青年という青年の血を湧き立てずには置かなかった、海外留学、それも、農商務省からの留学生として、海外派遣を命ぜられるかも知れないという福音なのである。",
              "citation": {
                "source": "渋谷家の始祖",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
