        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "人気限定品が発売されるや否や、転売目的の業者が全量を買い上げてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "彼女は市場に出ていたそのブランドのヴィンテージ品をすべて買い上げた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "投資家が地域の空き地を次々と買い上げ、再開発を進めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
