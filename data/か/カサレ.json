        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "林房雄トイウ名ノ一陣涼風ニソソノカサレ、浮カレテナセル業ニスギズ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "酔ったお客にヒヤカサレたり、コワイ巡査に手を握られたり、キザな運転手に突っつかれたりするたんびに、心の底の底まで淋しくて、悲しくて、つまらなくなる商売よ。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "歩カズニイルト、今ニ本当ニ歩ケナクナリマスト嚇カサレテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "杉田氏ノ意見デ、整形外科ノ方ヘ行ッテ見テ貰ッタラト云ウノデ、先日虎ノ門病院デレントゲンヲ撮ッタノデアルガ、頸椎ノ辺ニ曇リガアルシ、手ノ痛ミガソンナニ激シイノナラ、事ニ依ルト癌カモ知レナイト嚇カサレテ、頸椎ノ断層写真迄モ撮ラセタリシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婆サンダッテ、他人ノ寝台ノ上ニ寝カサレルコトヲ喜ンデハイナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ聞カサレルト、予モ何トカシテ居残ル算段ヲシナケレバナラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "佐々木ハ直グ脈ヲ取ッテ見テ、「プルスガ九十以上ゴザイマスネ、ドウカナサイマシタンデスカ」「イヽヤ別ニ」「血壓ヲ測ラシテ戴キマショウ」否応ナシニ書斎ノソファニ寝カサレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「エライ目ニオ会イニナリマシタソウデ」「ナアニ何デモアリマセンヨ」「兎ニ角見セテ戴キマショウ」臥カサレテ手ヤ足腰ヲ委シク検査サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "子供ハモット子供ラシクスルモンダ」イヽ歳ヲシテコンナ子供ニタワイモナク泣カサレタコトニ、予ハ腹ガ立ッテ溜ラナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ドウナサイマスカ、博士モ決シテ無理ニスヽメテハオラレマセン、オ気ガ向カナケレバオ止メニナッタ方ガヨロシイト云ッテオラレマスカラ、マアヨクオ考エニナリマシテ、―――」コノ間ノ晩、子供ニ不意討チヲ喰ッテ泣カサレタコトガ未ダニ胸ニ残ッテイ、コンナ場合ニ何トナクアレガ不吉ノ前兆ノヨウニ思イ出サレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "無鉄砲ノヨウデ、実ハ甚ダ臆病デ用心深イ筈ノ予ガ、佐々木ノ言葉ニソヽノカサレテ頻リニ左様ナ危険ナ注射ヲシテ貰イタク感ジルノハ、ドウモタヾゴトデナイヨウニ思エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅イツル／＼シタ板ノ上ニ臥カサレテイロ／＼ノ形ニ体ヲ彎曲サセルベク命ゼラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレナラ誰ニモ心中ノ秘密ヲ見スカサレル心配ナシニ、望ンダ石佛ヲ作リ得ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ東京駅ノ地下道ノ宏大ナノト岐路ノ多イノニ驚カサレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トイッテ、僕ハ全然ソウイウヲ考エナイヨウニシテイタノニ、イキナリハッキリト聞カサレタノデギクリトシタ、トイウノガ偽ラザル気持カモ知レナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カサレを奪取したとかシエナを守ったとかで、年金の一万リーヴルも受けているというような人＊に仕えられることが、人の善い仕事になれた下男にかしずかれるよりも便利であり愉快であろうとは、わたしにはどうしても思われない＊＊。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
