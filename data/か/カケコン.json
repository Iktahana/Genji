        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレデ、人参サンハ決心シテ、ジヤガイモサンノオ家ヘカケコンデ、眠ツテイルジヤガイモサンヲユスブリマシタ。",
              "citation": {
                "source": "オ寝坊ナ　ジヤガイモサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ、モンコチヤンハジブンノヘヤニカケコンデシマヒマシタ。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソジンがカケコンで信徒になるには荘厳な儀式を行う。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "即ち、カケコミの儀式の末席に立会いを許された見物人のソジンの中から行事につれて会得する者が起り、自然にカケコンでしまうことを云うのであるが、カケコミの当人よりもツレコミの入信者がよい信者になれると云われている。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "さればといってカケコミを成就しないと信者の列に加えてもらえないから、カケコミの行事をつぶさに観察し、カケコンだ人の身ぶり顔ツキを充分に練習しておいて、入信の儀式にパスすることができた。",
              "citation": {
                "source": "明治開化　安吾捕物",
                "author": "その三　魔教の怪",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
