  {
    "uuid": "dcfa869b-66bc-5686-a94d-b6f3eee840f9",
    "entry": "回国",
    "reading": {
      "primary": "かいこく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "動詞-サ変",
        "動詞-自動詞"
      ],
      "ctype": "サ行変格",
      "inflections": null,
      "ctype_source": "pos-derived",
      "ctype_confidence": "high"
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "traveling throughout the country (travelling)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "僧侶は回国して各地で説法をした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この浪人は回国の旅に出た。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "回国する巡礼者たちが脇本陣に泊まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "第×回国際パンクラブ総会が開かれた、フランスからやつてきたクラブ員は、紙風船を手にして壇上に立つた。",
              "citation": {
                "source": "小熊秀雄全集−15−",
                "author": "小説",
                "note": "青空文庫"
              }
            },
            {
              "text": "第十四回国際ペンクラブの大会は、会合地の関係もあって、英米ともに文学の現役を送らず、文学的には貧弱であったが、それにしても猶、日本から遙々出席した「夜明け前」の作者藤村は、深き様々の印象を与えられたらしい。",
              "citation": {
                "source": "今日の文学の展望",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "かつての新聞班パンフレットによる農山漁村の対策に期待した日本の無産者の一部分は、その後の国防絶対至上主義化によって見ごとに背負い投げを食わされたが、政治家風の空頼みが今回国民に多少の期待を吹き込んだということも、話は小さくて稀薄だが、別に之と異った現象ではないかも知れぬ。",
              "citation": {
                "source": "近衛内閣の常識性",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二回国際革命作家大会がソヴェト革命第十三年記念祭を機会にハリコフで持たれようと云うのだ。",
              "citation": {
                "source": "ソヴェト文壇の現状",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "世界革命文学の第二回国際会議への召集状は発せられた。",
              "citation": {
                "source": "五ヵ年計画とソヴェトの芸術",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "第二次ヨーロッパ大戦後における第一回国際ペンクラブの大会が、一九四六年の夏、ストックホルムで開かれた。",
              "citation": {
                "source": "今日の日本の文化問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ブェノスアイレスの第十四回国際ペンクラブ大会へ出席した島崎藤村が、この大会の世界ファシズムに反対する決議や世界平和と文化を守る決議に当惑して、日本の文学者として何一つ責任ある発言をさけてかえってきたことは、当時の日本の状態をあからさまに語っている。",
              "citation": {
                "source": "あとがき（『宮本百合子選集』第十一巻）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「庄司甚内というは同じ盗賊ながら日本を回国し、孝子孝女を探し、堂宮の廃れたるを起こし、剣鎗に一流を極わめ、忍術に妙を得、力量三十人に倍し、日に四十里を歩し、昼夜ねぶらざるに倦む事なし。",
              "citation": {
                "source": "三甚内",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "勾坂甚内の生長は、甲州武田の長臣高坂弾正が子にして、幼名を甚太郎と号しけるに、程なく勝頼亡び真忠の士多く討ち死にし、または徳川の御手に属しけるみぎり甚太郎幼稚にして孤児となるを憐れみ、祖父高坂｜対島甚太郎を具して摂州芥川に遁がれ閑居せし節、日本回国して宮本武蔵この家に止宿る。",
              "citation": {
                "source": "三甚内",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この意味で今回国分君に寄せられた全国的な友情に感謝する。",
              "citation": {
                "source": "『教室の記録』の編集を終えて",
                "author": "村山俊太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "生き別れをした吾子を尋ね当てるため、六十余州を回国して、寝ても寤めても、忘れる間がなかったある日、十字街頭にふと邂逅して、稲妻の遮ぎるひまもなきうちに、あっ、ここにいた、と思うようにかかなければならない。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "この無遮会は五年に一回国王に依って行われる例であった。",
              "citation": {
                "source": "東洋文化史における仏教の地位",
                "author": "高楠順次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "この国際民主婦人連盟には、四十九ヵ国八千万人以上の婦人たちが参加していて、すでに二回国際大会をもっている。",
              "citation": {
                "source": "婦人デーとひな祭",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "というのは、上流貴婦人たちの血を沸き立たせていたものに、毎春一回国都マドリイドにおいて開かれる全｜西班牙名家の愛犬品評会というのがあった。",
              "citation": {
                "source": "陰獣トリステサ",
                "author": "橘外男",
                "note": "青空文庫"
              }
            },
            {
              "text": "このことを一九六三年の第一回国際モンテーニュ学会で、オランダのライデン大学の学長たるセム・ドレスデン教授は「モンテーニュの逆説的正確（〔pre'cision paradoxale de Montaigne〕）」と題する講演の中で述べている。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻国の六部のような男が……」　　　　　三　半七の商売を知っている六助は、訊かれるに従って総てのことをしゃべった。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここらでもう料簡を入れ替えて、兄や自分の罪ほろぼしに六十六部となって廻国修行の旅に出ようと思い立った。",
              "citation": {
                "source": "半七捕物帳",
                "author": "お照の父",
                "note": "青空文庫"
              }
            },
            {
              "text": "……消えるまで、失せるまでと、雨露に命を打たせておりますうちに――四国遍路で逢いました廻国の御出家――弘法様かと存ぜられます――御坊様から、不思議に譲られたでござります。",
              "citation": {
                "source": "山吹",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "芸妓の罪障は、女郎の堅気も、女はおなじものと見えまして、一念発起、で、廻国の巡礼に出る。",
              "citation": {
                "source": "甲乙",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "われら世過ぎにせわしき身は、一夜の旅も、糧ゆえに思うに任せず、廻国のついでに、おのずから、その武州何郡、何村に赴きたまわば、」事のよしをも訪いとむらいたまえと、舌を掉って語ったというのである。",
              "citation": {
                "source": "雪柳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "大己貴と同じく天下を運りたもう時、かの大国主袋のようなる物を身に随えてその中へ旅産を入れて廻国せらるるに、その入れ物の中の糧を用い尽しぬればまた自然に満てり。",
              "citation": {
                "source": "十二支考",
                "author": "鼠に関する民俗と信念",
                "note": "青空文庫"
              }
            },
            {
              "text": "御辺は廻国の六十六部とは跡型も無き偽り。",
              "citation": {
                "source": "白くれない",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから俺は日本廻国をはじめて越後まで行くうちに、とうとうその本を読み終ったので、叮嚀に礼を云うて送り返しておいたが、ちょっと面白い本じゃったよ」　これ程の豪傑、頭山満氏がタッタ一つ屁古垂れた話が残っているから面白い。",
              "citation": {
                "source": "近世快人伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その米の叔父に一人の僧侶があったが、それが廻国に出かけることになって、僧侶には路銀は不要だと云うので、三百円の金を米に預けて往った。",
              "citation": {
                "source": "寄席の没落",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "性来｜頗る器用人で、影画の紙人形を切るのを売物として、鋏一挺で日本中を廻国した変り者だった。",
              "citation": {
                "source": "淡島椿岳",
                "author": "――過渡期の文化が産出した画界のハイブリッド――",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻国巡礼を羨む又真実怖い事もある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのとき途中で廻国巡礼に出逢い、その笠を見れば何の国何都何村の何某と明白に書てある。",
              "citation": {
                "source": "福翁自伝",
                "author": "福翁自伝",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻国風の美しい娘を、五人の若い侍が、今や手籠めにしようとしている。",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "廻国風のその娘に、用あればこそ手をかけたのだ！",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "木洩陽を浴びて坐っている、廻国風の娘の顔の、何と美しく気高いことよ！",
              "citation": {
                "source": "血ぬられた懐刀",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
