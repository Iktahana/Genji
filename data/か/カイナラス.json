        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼は野生のワニを飼いならすことに成功した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その動物訓練士は、様々な獣を飼いならしてきた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祖父は若い頃、秋田犬を飼いならした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "飼いならすのにいろいろな方法があるが、鶴がひとを見ても恐れぬようになると、鷹匠が飼場を検分したのち、そのむねを若年寄に上申する。",
              "citation": {
                "source": "顎十郎捕物帳",
                "author": "丹頂の鶴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
