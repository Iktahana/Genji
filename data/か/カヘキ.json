        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "しかし三尺もの下壁と言わず、こまかく厚手なぶッつけ格子と言わず、がっしりとした構造は念の入ったものである。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "上からの流れ水でも落ち込まぬように、下壁の廻りを築き上げても見た。",
              "citation": {
                "source": "土城廊",
                "author": "金史良",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
