        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "」　羊の肉の薄焼に雛の肩肉と、フロマージュ付きのスパゲッティ、それにサラダを註文して三人は葡萄酒を飲んだ。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "肩肉の厚い、白い肌が、赤土色の湯から浮きあがつてゐる。",
              "citation": {
                "source": "浮雲",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シチュウには上等の羊の肩肉が一番結構です」と相も変らず料理談。",
              "citation": {
                "source": "食道楽",
                "author": "春の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "炙った羊肩肉とアンズのプッディング――仔うし肉のカツレツ、焼いたジャガイモ、冷たい舌ハム、冷たい炙り牛肉、殻に入った卵。",
              "citation": {
                "source": "文明と病気",
                "author": "Civilization And Disease (1943)",
                "note": "青空文庫"
              }
            },
            {
              "text": "左の前肢を出すときには、左の肩肉がくりくりと動くし、次には右の肩肉がくりくりと動く。",
              "citation": {
                "source": "季節のない街",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、彼のいる書院の外に、肩肉の固そうな、色の浅ぐろい、三十がらみのさむらいが手をつかえた。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "ここの仕事は荒っぽいので日傭でも肩肉の盛り上がってるのが揃っている。",
              "citation": {
                "source": "醤油仏",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソボロと言って、罐詰用としては下級品の肩肉を出すのも、工場に初めて来た女工のやる仕事だった。",
              "citation": {
                "source": "いやな感じ",
                "author": "高見順",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
