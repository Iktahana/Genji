        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "泳ぎながらも客らしい人を見つけると、あかちゃけた短い髪を元気よくかきあげてから、やすんで行きせえ、と叫んだ。",
              "citation": {
                "source": "魚服記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてお母さまは、冬の雪空に、この淡い牡丹色が、どんなに美しく調和するかちゃんと識っていらしてわざわざ選んで下さったのに、私は馬鹿でいやがって、けれども、それを子供の私に強制しようともなさらず、私のすきなようにさせて置かれたお母さま。",
              "citation": {
                "source": "斜陽",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が、紅茶の皿を持ち上げた時、意地悪くからだが震えて、スプーンが皿の上でかちゃかちゃ鳴って、ひどく困りました。",
              "citation": {
                "source": "きりぎりす",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かちゃんと落っこってバラバラに毀れた。",
              "citation": {
                "source": "御返事（石原純君へ）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あかちゃんや、あかちゃんや、うまうまをあげましょう、其処を出ておいで。",
              "citation": {
                "source": "二、三羽――十二、三羽",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "家へ帰って、摩耶夫人の影像――これだと速に説教が出来る、先刻の、花御堂の、あかちゃんの御母ぎみ――頂餅と華をささげたのに、香をたいて、それから記しはじめた。",
              "citation": {
                "source": "古狢",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時、列の中の一人の兵士が、かちゃりと剣を鳴らして二人にわざとらしい挙手の礼をした。",
              "citation": {
                "source": "春",
                "author": "――二つの連作――",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれの方では誰の家の納屋の中に何斗あるか誰の家の床下に何升あるかちゃんと表になってあるのだ。",
              "citation": {
                "source": "税務署長の冒険",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "どこで嗅ぎつけて来るのか、今日はどこそこで何んな博奕があるかちゃんと知っているらしく、毎日出掛ける。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしよく見るとそういうのでも、どこかちゃんと一つの全体を形作って一人の作者のある時期の心の世界の断面を見るような気がすることもしばしばあります。",
              "citation": {
                "source": "書簡（※）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "投銭にはちゃちゃらかちゃんなんて古風な流行唄をやってますが、可い声で、ぞッとするような明烏をやりますんでね。",
              "citation": {
                "source": "三枚続",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "余計なこと喋べらないことよ、そしてちゃかちゃかしないで落ち着いているのよ。",
              "citation": {
                "source": "縮図",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "かちゃりと源内があけたあとから、物静かにはいっていくと、調べ方にむだがない。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "蹲んで、体を鰕のように曲げて、何かぐずぐず云って祈っている爺さん婆あさん達の背後を、堂の東側へ折れて、おりおりかちゃかちゃという賽銭の音を聞き棄てて堂を降りる。",
              "citation": {
                "source": "ヰタ・セクスアリス",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　紀久子は正勝を、彼の幼少時のまっかちゃんという呼び名で呼んで、ようやくそれだけを言った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "円鈕を前に押しながら、開く戸に身を任せて、音なき両足を寄木の床に落した時、釘舌のかちゃりと跳ね返る音がする。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かねて差し込んである鍵をかちゃりと回すと、錠は苦もなく卸りた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "飛び上りものだ」　かちゃりと入口の円鈕を捩ったものがある。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "鋏はかちゃりと床の上に落ちた。",
              "citation": {
                "source": "虞美人草",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "畏まった御坊は自分の手で封印を切って、かちゃりと響く音をさせながら錠を抜いた。",
              "citation": {
                "source": "彼岸過迄",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "かちゃりと、小刀があたるたびに、赤い味が笊のなかに隠れる。",
              "citation": {
                "source": "草枕",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これでもいざとなると、なかなか真面目なところもありますからね」「そりゃ男だもの、どこかちゃんとしたところがなくっちゃ、毎日会社へ出たって、勤まりっこありゃしないからね。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "大将は太い剣をかちゃりと鞘に収めた。",
              "citation": {
                "source": "夢十夜",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "なあに、あん畜生に一度ドゥブレットをやらせて見るがいいや、そうすれあ、彼奴がどんな打手かちゃんと見抜いてやらあな！",
              "citation": {
                "source": "死せる魂",
                "author": "または　チチコフの遍歴　第一部　第一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいわ、あたし、あなたが何ぜ笑ったのかちゃんと知ってるんですもの」「いや、俺はお前がよくなって、洋装をきたがって、ぴんぴんはしゃがれるよりは、静に寝ていられる方がどんなに有難いかしれないんだ。",
              "citation": {
                "source": "春は馬車に乗って",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチャンと澄んだ音がして、ガラスがこまかくこわれた。",
              "citation": {
                "source": "薄明",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヒラメの家では食事はいつもその小僧がつくり、二階のやっかい者の食事だけは別にお膳に載せて小僧が三度々々二階に持ち運んで来てくれて、ヒラメと小僧は、階段の下のじめじめした四畳半で何やら、カチャカチャ皿小鉢の触れ合う音をさせながら、いそがしげに食事しているのでした。",
              "citation": {
                "source": "人間失格",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "剣がカチャンカチャンと云うたびに、青い火花が、まるで箒のように剣から出て、二人の顔を物凄く照らし、見物のものはみんなはらはらしていました。",
              "citation": {
                "source": "ペンネンネンネンネン・ネネムの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まず病室の長い廊下のはるかに遠いかなたで時々カチャンと物を取り落としたような音がする、それから軽くパタ／＼／＼とたとえば草履で廊下を歩くような音も聞こえる。",
              "citation": {
                "source": "病院の夜明けの物音",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "カチャンという音一ツで、千万金にもと思っていたものは粉砕してしまった。",
              "citation": {
                "source": "骨董",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
