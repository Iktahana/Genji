        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこで炊事女のオトタツという娘も坑のなかに入れられて手伝っていますと、ふいに坑口の外でオトタツ、オトタツという呼び声がするので、これは母親の声かと驚いて、坑外へ駆け出る刹那、坑が落ちて、なかの千人の鉱夫が死んだという話であります。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "二、三の者は戸外に駆け出る。",
              "citation": {
                "source": "なよたけ",
                "author": "加藤道夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "お妙は透しみて縁に駈け出る。",
              "citation": {
                "source": "俳諧師",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "露路に向かって駈け込む者、露路から往来へ駈け出る者……それで、往来はごった返している。",
              "citation": {
                "source": "前記天満焼",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と叫びながら続いて、青年Ｆを先頭に戸外へ駈け出る。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "柳麗玉は下手の裏口を開けて戸外へ駈け出る。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "半次郎　（障子を開き駈け出る）哥児――哥児。",
              "citation": {
                "source": "瞼の母　二幕六場",
                "author": "長谷川伸",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを、無理に引っ立てて、玄関へ駈け出ると、媒人は、平謝りに、謝っていた。",
              "citation": {
                "source": "松のや露八",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
