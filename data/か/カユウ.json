          "literary": [
            {
              "text": "この行は初めより歌友｜吉植庄亮君と伴であった。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして同じ詩歌友達で、飲仲間であったのだ。",
              "citation": {
                "source": "みなかみ紀行",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや矢張り、このまま真すぐ東大寺へはいって、連歌友達の玄｜浴主のところで一夜の宿を頼もうと、この門の形を雪のなかに見わけた途端に貞阿は心をきめた。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや矢張り、このまま真すぐ東大寺へはいつて、連歌友達の玄｜浴主のところで一夜の宿を頼まうと、この門の形を雪のなかに見わけた途端に貞阿は心をきめた。",
              "citation": {
                "source": "雪の宿り",
                "author": "神西清",
                "note": "青空文庫"
              }
            }
          ]
        }
