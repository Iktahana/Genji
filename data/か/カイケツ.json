    },
    "definitions": [
      {
        "index": 1,
        "gloss": "person of extraordinary talent",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "後者は怪傑星亨の機關新聞で、猛烈に薩長政府を攻撃した。",
              "citation": {
                "source": "新詩發生時代の思ひ出",
                "author": "土井晩翠",
                "note": "青空文庫"
              }
            },
            {
              "text": "美濃、飛騨、信濃を縄張りとして、運上によって営む生活は十万石の大名にも勝り、部下に信頼されることも、武士時代より一層厚く、いわば賤民の王として、不思議の勢力を揮っている巨然たる草莽の怪傑なのであったが、この怪傑の群にはいった数馬の運命はどうなるであろう。",
              "citation": {
                "source": "蔦葛木曽棧",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九｜輪をめぐる怪傑怪人一　法師野の空には平和の星がかがやいている。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "怪傑と怪傑、勇士と勇士、五三の桐の幕のなかには渾然とうちとけ合って、意気りんりんたるものがある。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
