        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「どこまで追っかけろって云うんだ。",
              "citation": {
                "source": "橇",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "貴様ら、呉と郭と二人で、それじゃ夜明に出かけろ、今度はうまくやらないと荷物を没収されちゃ、怺えせんぞ！",
              "citation": {
                "source": "国境",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "八尺なす桶のここだく、新しぼりしたたる袋、庭広に干しも列ぬと、咽喉太の老いしかけろも、かうかうとうちふる鶏冠、尾長鳥垂り尾のおごり、七妻の雌をし引き連れ、七十羽の雛を引き具し、春浅く閑かなる陽に、うち羽ぶき、しじに呼ばひぬ。",
              "citation": {
                "source": "海阪",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "野郎め、そッちへ逃げたぞッ」「追ッかけろッ。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "跡を追いかけろッ」「跡を追いかけろといったって、とうに野郎はもうつっ走ったんですよ。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "見とがめられぬよう追いかけろッ」　ぴたりと舟底に身をつけて、見えがくれにあとを追跡しました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "首つり五人男",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いいから、早くかけろ」　と、山崎が不機嫌な声を出した。",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "おれが声をかけたら、歯ブラシを口に入れたまま、カメラにむかって笑いかけろ」「歯ブラシが口に入ってて、いったい、どうやって笑えっていうの？",
              "citation": {
                "source": "45回転の夏",
                "author": "第１章　ローラーコースター、１９６６年",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはお心づけ忝のう存ずる、それでは早速」と云って伴助を見て、「これ、てめえ、白湯をしかけろ」　其の時屏風の中で嬰児の泣く声がした。",
              "citation": {
                "source": "南北の東海道四谷怪談",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夕方五時か六時までに変った事がなかったら電話をかけろ。",
              "citation": {
                "source": "暗黒公使",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ソレ、又逃げ出した」「あっちへ行った」「追っかけろ追っかけろ」　と追いまわし初めましたが、何しろ人数が多いのでヒョロ子夫婦はどっちへも逃げようがありません。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時にはるか向うから、「ワーッ、ワーッ」「あすこの家に珍らしい夫婦が逃げ込んだ」「無茶先生の家だ無茶先生の家だ」「それ、押しかけろ押しかけろ」　と云う声がすると一所に、あとからあとから大勢の人間が押しかけて、無茶先生の家のまわりを一パイに取り巻いてしまいました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ大将も起きて来て、「サア、魔法使いのあとを追っかけろ」　といいましたので、兵隊たちは勢い付いて八方に駈け出して無茶先生を探しましたが、まだあたりがまっ暗で、どこへ行ったかわかりませんでした。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうして玉葱と、葱と、大根と芋と、豚と鶏と、七面鳥と、牛とありたけ買い集めて、車に積んで出かけろ。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "追っかけろ」　と四五人の兵士が怒鳴りましたが、何しろこの国第一の名馬「瞬」が夢中になって駈け始めたのですから、迚も人間の足の力では追い附く気遣いはありませぬ。",
              "citation": {
                "source": "白髪小僧",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「出掛けベエ／＼、皆なでおしかけろ。",
              "citation": {
                "source": "熱海へ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「追かけろ、追かけろ」　丘の下に立っていたクラネクが叫んだ。",
              "citation": {
                "source": "警察署長",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "失業労働者大会・市役所へ押しかけろ！",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "ええじゃないか、ええじゃないかこよい摺る臼はもう知れたもの婆々さ夜食の鍋かけろええじゃないか、ええじゃないか　だれもがこんな謡の囃子を小ばかにし、またよろこび迎えた。",
              "citation": {
                "source": "夜明け前",
                "author": "第一部下",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「皆しっかり手をかけろ。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部上",
                "note": "青空文庫"
              }
            },
            {
              "text": "腰をかけろという椅子もないのだ。",
              "citation": {
                "source": "日本脱出記",
                "author": "大杉栄",
                "note": "青空文庫"
              }
            },
            {
              "text": "「追つかけろウ――」「糸が切れたア――」　私達は、はつきりとさういふ叫声を聞きわけた。",
              "citation": {
                "source": "鱗雲",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふん、するとふみちゃんはあれだね、用事がなきゃ手紙を出さないんだね、離れてりゃ僕のことなんかけろりと忘れてるんだね」「さあどうだか？",
              "citation": {
                "source": "何が私をこうさせたか",
                "author": "――獄中手記――",
                "note": "青空文庫"
              }
            },
            {
              "text": "現に今日はコロクと鳴く鴉も少なく、カケロとうたう鶏などは探してもいないのである。",
              "citation": {
                "source": "野草雑記・野鳥雑記",
                "author": "野鳥雑記",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
