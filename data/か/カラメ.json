          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「あの教授、レポートの採点がめちゃくちゃ辛めだから、しっかり準備しないと単位を落としかねないぞ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「新作映画のレビューサイトを見て回ったけど、評論家たちの評価は全体的にかなり辛めだね。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「自分に対して辛めな目標を立てるのもいいけど、たまには今の頑張りを認めてあげてもいいんじゃない？」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": []
        }
      }
