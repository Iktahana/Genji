[
  {
    "uuid": "4a0351ca-5dcc-5e44-8018-c2dfe4bfddce",
    "entry": "母ちゃん",
    "reading": {
      "primary": "かあちゃん",
      "alternatives": [
        "かーちゃん"
      ],
      "is_heteronym": false
    },
    "grammar": {
