        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "サテ　チヤウサンハ　ウチニ　カヘルト、サツソク、ロバニ　ヒカセル　クルマヲ　ツクリハジメマシタ。",
              "citation": {
                "source": "ウサギ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "発車まで三十分ほど間があつたので、停車場前の郵便局へ行つて「アスカヘル」と父に宛てて電報を打つた。",
              "citation": {
                "source": "厄年",
                "author": "加能作次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "〈アサツテカヘル〉　僕には殺気立つた甥の顔が目に見えてくるやうだつた。",
              "citation": {
                "source": "災厄の日",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "イツコラレルカヘンマツユリコ一〇ヒカヘル。",
              "citation": {
                "source": "日記",
                "author": "一九四八年（昭和二十三年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "記事の前の部分を缺いてゐるから判然しがたい所もあるが、續く所によれば「五色人ハイレス（中略）越根能登ノ西浦水門ヨリ唐イカヘル」とあり、推察するに越中國神明村に在つたとしたのでないかと想はれる。",
              "citation": {
                "source": "天津教古文書の批判",
                "author": "狩野亨吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "拡リ擾レテソレハ沸キカヘル人口ト季節ノ　喚声ニ乗ツテ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日、使ニ来リシ犬ハ、最モ愛スベキ忠犬ナレバ、ヨクイタハリ、カヘルトモ、留マルトモ、犬ノ意志ニ任セテサシツカヘナシ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヘルサン、毎日オアツイデスネ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カヘルサンハ生レツキ色ガ青カツタノデスガ、コノ時バカリハ赤クナリマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハアワテテ木ニノボラウトシマシタノデ、ツルツルツルツルトスベツテドウシテモノボルコトガデキマセン。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カヘルサン、私ノ足ニ綱ヲツケテ上ヘヒツパリアゲテ下サイ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ソコデ、カヘルサンハコホロギサンノ足ニ綱ヲツケテ、木ニノボツテモラヒマシタ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヘルサンハドンナニウレシカツタデセウ。",
              "citation": {
                "source": "カヘルサント、コホロギサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミハ　テガツカヘルクセニ　アシデ、ナンキンマメノ　カハヲムイテ、タベルヂヤナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "――一月五日、骨アゲヒル田端ニ寄リ　ヨル鵠沼ニカヘル――六日、夜藤澤ノ花屋ニ義チヤントユキバラ十五本三圓　芥川はずるずるに東京になつてしまつてゐた。",
              "citation": {
                "source": "二つの繪",
                "author": "芥川龍之介の囘想",
                "note": "青空文庫"
              }
            },
            {
              "text": "堀井から電報、「カイケツシタアスカヘル」と、稍々安心、林寛からも手紙、大分今回は厳しいとのこと、その不安で皆元気がない。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
