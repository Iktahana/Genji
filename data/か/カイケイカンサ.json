        "examples": {
          "standard": [
            {
              "text": "会計監査人の報告書が取締役会に提出された。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "会計監査は企業の透明性を確保する重要な機能だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "毎年、会計監査に合格することは上場企業の義務である。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "ところが、実に恐ろしい不幸に見舞われ、使ったお金はひとつも回収できず、抜き打ちの会計監査で、私の使い込みがばれてしまった。",
              "citation": {
                "source": "グローリア・スコット号",
                "author": "THE \"GLORIA SCOTT\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "――勘定吟味役は（いうまでもないだろうが）現今の会計監査官に当り、それよりもさらに広範囲の権限をもっていた。",
              "citation": {
                "source": "いしが奢る",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
