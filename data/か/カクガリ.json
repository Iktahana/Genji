        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新入社員の彼は、清潔感のある角刈りで、爽やかな印象を与えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "昔の映画を見ると、多くの男性俳優が流行りの角刈りにしているのがわかる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "息子はスポーツ刈りか角刈りにするか迷っていたが、結局角刈りを選んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "ブドリはいやになって、ぷいっと表へ出ましたら、向こうから髪を角刈りにしたせいの高い男が来て、いきなり、「おい、お前、ことしの夏、電気でこやし降らせたブドリだな。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "鉄ちゃんは須田町の近くの魚屋の伜で十九歳、浅黒い顔に角刈りが似合い、痩せぎすの体つきもどこかいなせであった。",
              "citation": {
                "source": "妖婦",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "角刈りにした頭の地も綺麗で、顔立ちも優しい方であったが、手足の筋肉がこちこちと硬かった。",
              "citation": {
                "source": "足迹",
                "author": "徳田秋声",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜山尾来る、頭を三角刈りにして居るので人相が悪く、よく下等なものの様な感じを与えた。",
              "citation": {
                "source": "日記",
                "author": "一九一六年（大正五年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "後に知ったことであるが、頭髪は角刈りにしていた（私は髪を伸していた）。",
              "citation": {
                "source": "微笑",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その頃流行つた「角刈り」と云ふのに近い刈り方で、うしろの方をより短く、前方を長目に刈つた頭の鉢は、後頭部がやゝ一直線に切つ立つてゐたが、小さく固く引き締まつて、その面長の顔とよき釣り合ひを保つてゐた。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ロタール・マンハイム――少し背の曲がった頑丈な大きな老人、赤い顔色、角刈りにした灰色の髪、ごく黒い口｜髭と眉毛、重々しいがしかし元気で嘲弄的で、強烈な生活力を思わせる顔つき――彼もまた、狡猾なお人よしのふうをして、クリストフを研究していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "五十年配の強健な快男子で、背が低くむっくりしていて、丸い大きな頭、角刈りにした灰色の頭髪、赤い顔、横柄な言葉つき、重々しい誇張的な音調、そしてときどきごつごつした快弁を弄した。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "年増の女工員が三人、次郎さんと呼ばれる角刈りの美い男ぶッた若い熟練工と四十がらみの主任と、男もぼくを入れて三人。",
              "citation": {
                "source": "忘れ残りの記",
                "author": "――四半自叙伝――",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は頭を角刈りにした痩せた男で、あまり表情を動かさない。",
              "citation": {
                "source": "狂い凧",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞ」　実直そうな角刈りの父親が、既定の事実のように後部のドアを中から押す。",
              "citation": {
                "source": "幻化",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十歳くらいで、色の青白い、角刈りにした男、着物のうえから、「友田」と襟に入った半纏を引っかけている。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも一束また一束と、折角刈り集めた柴をみなしたという点は同じである。",
              "citation": {
                "source": "海上の道",
                "author": "柳田国男",
                "note": "青空文庫"
              }
            },
            {
              "text": "短い角刈にした小さい頭と、うすい眉と、一重瞼の三白眼と、蒼黒い皮膚であつた。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "短い角刈にした小さい頭と、うすい眉と、一重瞼の三白眼と、蒼黒い皮膚であった。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "母親は白い頭髪を短く角刈にして、気品があった。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕の以前の店子であったビイル会社の技師の白い頭髪を短く角刈にした老婆の顔にそっくりであったのである。",
              "citation": {
                "source": "彼は昔の彼ならず",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "呼んだのは、四十五六の角刈の男だった。",
              "citation": {
                "source": "夜光虫",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、俯向けていた地薄な角刈の頭を擡げて、はぐらかす気か、汗ばんだか、手の甲で目を擦って、ぎろりと巽の顔を見た。",
              "citation": {
                "source": "浮舟",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "遊び人か、と思はれる角刈で、その癖パナマ帽を差置いた。",
              "citation": {
                "source": "深川淺景",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中から頭を角刈にして、布子の下に湯帷子を重ねて着た男が出て来て、純一を迎え入れた。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "角刈の男は、行燈の中に石油ランプを嵌め込んだのを提げて案内して来て、それを古畳の上に置いて、純一の前に膝を衝いた。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "飯は済んだのだ」「煮肴がございます」「それで好い」　角刈の男は、形ばかりの床の間の傍の押入れを開けた。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "角刈の男が火鉢を持って上がって来た。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "角刈の男が革包を持って附いて来そうにするのをもことわった。",
              "citation": {
                "source": "青年",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "大仁理髪組合の掲示をみると、理髪料十二銭、またそのわきに附記して、「但し角刈とハイカラは二銭増しの事」とある。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "大仁理髪組合の掲示をみると、理髪料十二銭、またその傍に附記して「ただし角刈とハイカラは二銭増しの事」とある。",
              "citation": {
                "source": "秋の修善寺",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "見ると相手の男は、頭を角刈にした、二十歳前後の、顔の四角な職人らしい男でしたが、喉の傷をくるくる巻いた繃帯が、顎を埋めてしまうほど、ふくらんでいました。",
              "citation": {
                "source": "島原心中",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "上流社会のように高慢ちきな人間は一人もいやしない」三十五　インヴァネスを着た小作りな男が、半纏の角刈と入れ違に這入って来て、二人から少し隔った所に席を取った。",
              "citation": {
                "source": "明暗",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "角刈はその時口を挟んだ。",
              "citation": {
                "source": "春心",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
