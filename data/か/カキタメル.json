    "definitions": [
      {
        "index": 1,
        "gloss": "to accumulate (writings, compositions, etc. that one has not yet published)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "彼はいつか本を出すために、毎日少しずつ原稿を書き溜めている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "エッセイを書き溜めているが、まだ誰にも見せていない。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "学生時代からノートに書き溜めてきたアイデアが、今になって役立っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "戦争にかかわる年齢は幸にすぎていて、経済の安定も保ちとおし、自分の文学をいくらか書きためることの出来ていた荷風が、無傷な、そして営業的に広汎な読者をもつ作家として着目されたのであった。",
              "citation": {
                "source": "婦人と文学",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其で、この何時お手元に届くか今のところ未だ見当のつかない手紙をこのようにポツポツと書きためることを思いついたのです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九三六年（昭和十一年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
