  {
    "uuid": "e92c5a61-3eb8-50ef-91b6-52ce5ece70dc",
    "entry": "閣令",
    "reading": {
      "primary": "かくれい",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "日勤の日にも、月に二回は閣令休暇があり、十日に一回は特別休暇がありました。",
              "citation": {
                "source": "土地に還る",
                "author": "――近代説話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "この閣令にて鉱山の借区もしくは払い下げの条規を規定せるものなれば、かの払い下げ願書のごときも、さらに再びこれに拠って呈出せざるを得ざるに至れり。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "その閣令が官報紙上にまさに現われんとする前日なりき。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            },
            {
              "text": "さあその辺の次第もあろうと、かねて手配りをいたしておいて、その閣令の草案も今日ようやく手に入れました。",
              "citation": {
                "source": "書記官",
                "author": "川上眉山",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
