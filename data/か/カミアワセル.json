    "definitions": [
      {
        "index": 1,
        "gloss": "to clench (teeth)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
