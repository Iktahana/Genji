        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "いつかこの若先生のところで顕微鏡を見せてもらって色々のプレパラートをのぞいているうちに一つの不思議な重大なアポカリプスを見せられた。",
              "citation": {
                "source": "追憶の医師達",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "向うのユウカリプスの蔭には、眞白い夏服をきた黒ん坊が三人、何か高い聲で議論をしてゐる。",
              "citation": {
                "source": "CARTE POSTALE",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "（b）故にディオンは、カリプスが自分を亡き者にしようとねらっていると聞いたけれども、それ以上に詮索する気にはまったくならなかった。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
