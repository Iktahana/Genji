[
  {
    "uuid": "0d9ed6ee-6407-5bcb-bbaf-59ef089848af",
    "entry": "書き換える",
    "reading": {
      "primary": "かきかえる",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
