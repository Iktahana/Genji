    "definitions": [
      {
        "index": 1,
        "gloss": "kamado",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "「わあ、竈で炊いたご飯って、おこげが香ばしくて最高やね」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "朝早くから土間に火を入れ、竈の火加減をうちわで調整する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖母の古い家には、黒光りした立派な三口の竈が今も残っている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "薪をくべると、竈から漏れる赤い光が台所の壁をぼんやりと照らした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ほとんど腐朽に瀕した肉体を抱えてあれだけの戦闘と事業を遂行した巨人のヴァイタルフォースの竈から迸る火花の一片二片として、こういう些細な事柄もいくらかの意味があるのではないかと思われるのである。",
              "citation": {
                "source": "子規の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "恰度その時女中は台所で、竈の下を焚き付けてゐます。",
              "citation": {
                "source": "家族",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "さういふわけで、朝な朝な、此のお家では箒の音がする時に、台所では竈の中で、とろとろと火が燃えてるのでありました。",
              "citation": {
                "source": "家族",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "なお登ると、二合二勺の室には水まで汲み込んだ樽が置いてあり、竈の側には、薪が三把ほど転がっている、防寒具を整えて来なかったが、これで焚火に事欠かないと解って、仮令天候が悪くっても、泊る宿があるという気強さが、頓に胸に溢れて来る。",
              "citation": {
                "source": "雪中富士登山記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "硝子戸の中は茶釜をかけた竈の火で暖かく、窓の色硝子の光線をうけて鉢の金魚は鱗を七彩に閃めかしながら泳いでいる。",
              "citation": {
                "source": "東海道五十三次",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "およそ「胸の煙は瓦焼く竈にまさる」のは「粋な小梅の名にも似ぬ」のである。",
              "citation": {
                "source": "「いき」の構造",
                "author": "九鬼周造",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして電磁気や光に関する理論の多くの病竈はひとりでに綺麗に消滅した。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "毎晩のように竈の前に藁把を敷いて自分を暖まらしてくれた、お松が居ないので、自分は始めてお松はどうしたのだろうかと思った。",
              "citation": {
                "source": "守の家",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "虫の声　垣根の朝顔やう／＼小さく咲きて、昨日今日｜葉がくれに一花みゆるも、そのはじめの事おもはれて哀れなるに、松虫すゞ虫いつしか鳴よわりて、朝日まちとりて竈馬の果敢なげに声する、小溝の端、壁の中など有るか無きかの命のほど、老たる人、病める身などにて聞たらば、さこそ比らべられて物がなしからん。",
              "citation": {
                "source": "あきあはせ",
                "author": "樋口一葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すなわち料理番が肉なり野菜なりを竈に仕かけて煮えるのを待っていると丁度よい時分には電気仕掛けのピアノが鳴り出す、その煮物に相応したような曲を奏するというのである。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "食い物がないのを知ると、竈の傍へ行って、ペチャ／＼やりだした。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "為吉は竈の前につくばって焚き火の明りでそれを見たが、老いた眼には分らなかった。",
              "citation": {
                "source": "老夫婦",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、枕木は炭焼竈の生木のように、雪の中で点火されぷす／＼燻りながら炭になってしまうのだった。",
              "citation": {
                "source": "氷河",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "村の夕暮れのにぎわいは格別で、壮年｜男女は一日の仕事のしまいに忙しく子供は薄暗い垣根の陰や竈の火の見える軒先に集まって笑ったり歌ったり泣いたりしている、これはどこの田舎も同じことであるが、僕は荒涼たる阿蘇の草原から駆け下りて突然、この人寰に投じた時ほど、これらの光景に搏たれたことはない。",
              "citation": {
                "source": "忘れえぬ人々",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「紀州紀州」竈馬のふつづかに喞くあるのみ。",
              "citation": {
                "source": "源おじ",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "料理場の跡らしい煉瓦の竈の崩れたのもそのままになっていた。",
              "citation": {
                "source": "雑記（２）",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛮地では人煙が稀薄であり、聚落の上に煙の立つのは民の竈の賑わえる表徴である。",
              "citation": {
                "source": "喫煙四十年",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし大きくなって、雛を捕ったり、魚を盗んだりしだすと、床板の下をくぐって人目を避けたり、寒い時には焚いたあとの火の消えたばかりの竈の中へにじりこんで寝たりするので、毛は黒く汚れていた。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "猫は、後脚に礫をあてられて、血を流しながら竈の傍につくなんでいた。",
              "citation": {
                "source": "「紋」",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "棺に納められ、石油をぶっかけられた彼等の肉体は、火葬竈の中で、くさい煙となって消えて行った。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "床にも座敷にも飾りといっては無いが、柱立の見事な、畳の堅い、炉の大いなる、自在鍵の鯉は鱗が黄金造であるかと思わるる艶を持った、素ばらしい竈を二ツ並べて一斗飯は焚けそうな目覚しい釜の懸った古家で。",
              "citation": {
                "source": "高野聖",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "三本の木の株で組み立てられた竈の飯釜の下からは楽しげな炊煙がなびいている。",
              "citation": {
                "source": "小浅間",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "かま猫はあたりまへの猫にならうと何べん窓の外にねて見ましたが、どうしても夜中に寒くてくしやみが出てたまらないので、やつぱり仕方なく竈のなかに入るのでした。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "敷居に立って豆洋燈を高くかかげて真闇の隅々を熟と見ていたが、竈の横にかくれて黒い風呂敷包が半分出ているのに目が着いた。",
              "citation": {
                "source": "酒中日記",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "一隅に長方形の大きな炉が切つて、これを火鉢に竈に、煙草盆に、冬ならば煖炉に使用するのである。",
              "citation": {
                "source": "空知川の岸辺",
                "author": "國木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "土竈だって堅炭だって悉な去年の倍と言っても可い位だからね」とお徳は嘆息まじりに「真実にやりきれや仕ない」「それに御宅は御人数も多いんだから入用ことも入用サね。",
              "citation": {
                "source": "竹の木戸",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "」おかあさんは馬にやる（不詳）を煮るかまどに木を入れながらききました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "生れ付きは何猫でもいいのですが、夜かまどの中にはひつてねむる癖があるために、いつでもからだが煤できたなく、殊に鼻と耳にはまつくろにすみがついて、何だか狸のやうな猫のことを云ふのです。",
              "citation": {
                "source": "猫の事務所",
                "author": "……ある小さな官衙に関する幻想……",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして実をすっかりたべてからこんどはかまどをぱくりとたべました。",
              "citation": {
                "source": "紫紺染について",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "たみのかまどはにぎわいにけり。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
