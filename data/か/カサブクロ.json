        "examples": {
          "standard": [
            {
              "text": "デパートに入るとき、入り口で傘袋を一枚取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "濡れた傘をそのまま持ち歩くと迷惑なので、傘袋に入れてください。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "繰り返し使える傘袋は、環境に優しい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "傘袋がなくなってしまい、鞄の中が雨で濡れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "昔から傳つてゐる調度は無論だが、地方の農家で婚禮の時に使ふ簟笥掛だの傘袋だの風呂敷の紺木綿の模樣が、悉く天平物です。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
