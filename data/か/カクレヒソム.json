        "examples": {
          "standard": [
            {
              "text": "彼は木の陰に隠れ潜み、獲物を待った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "敵の目を欺くため、物陰に隠れ潜んでチャンスを伺った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "森には珍しい鳥たちがひっそりと隠れ潜んでいる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼女は、自分の過去を誰にも知られないよう、ひっそりと町に隠れ潜んでいた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "どんな男にも隠れ潜む凶暴性が、この瞬間デンに起きた。",
              "citation": {
                "source": "ドレントン・デン特派員の冒険",
                "author": "BEING AN ADVENTURE OF DRENTON DENN, SPECIAL COMMISSIONER",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼はまた、わずかに栂の実なぞの紅い珠のように枝に残った郷里の家の庭を想像し、木小屋の裏につづく竹藪を想像し、その想像を毎年の雪に隠れひそむ恵那山連峰の谿谷にまで持って行って見た。",
              "citation": {
                "source": "夜明け前",
                "author": "第二部下",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
