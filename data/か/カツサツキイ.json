        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "併し当人たる侯爵ステパン・カツサツキイが為めには是非さうしなくてはならぬ事柄で、どうもそれより外にはしやうがないやうに思はれたのである。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「あれはステパン・カツサツキイと云つた士官の出家したのでしたね。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「皆さん、御一しよにカツサツキイさんの所まで此橇で往きませうね。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "日が暮れゝばカツサツキイさんの所で泊りますわ。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたくしはステパン・カツサツキイさんの所で泊ります。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ステパン・カツサツキイです。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "折々はどうして自分が、あの昔のステパン・カツサツキイがこんな聖者、こんな奇蹟をする人になつたかと、不審に思ふ事もある。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            },
            {
              "text": "わたしは大いなる罪人ステパン・カツサツキイです。",
              "citation": {
                "source": "パアテル・セルギウス",
                "author": "VATER SERGIUS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
