    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hoarse voice",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "風邪をひいて、かすれ声になってしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "ライブで叫びすぎて、翌日はかすれ声だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "「え、聞こえにくい？ごめん、かすれ声で。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "聞き覚えのある疳高いかすれ声に、おやっと、暗がりにすかして見ると、果して、弟の伝三郎であった。",
              "citation": {
                "source": "俗臭",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私は平伏したまゝ、かすれ声で訊ねた。",
              "citation": {
                "source": "天狗洞食客記",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "と云つて、細君とメイ子は慣れぬ周囲のために苦笑を浮べたが、細君は更に私の耳に、そつと、だが颯爽たる力の籠つたかすれ声で、「それが作次さんなんですつてさ！",
              "citation": {
                "source": "Ｒ漁場と都の酒場で",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの調子の破れたような金属性のかすれ声はエキゾチックな泣き声である。",
              "citation": {
                "source": "めでたき風景",
                "author": "小出楢重",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の満足は頂上に達して踊る様に歩き出そうとすると、今までの様子を傍に立って珍らしそうに見て居た私よりズーット大きい男の子はいきなり賤しいかすれ声を立てて、「ヤーイ、ヤーイ、チャンコロヤイ　男の癖に髪を長くして居やがらあ。",
              "citation": {
                "source": "追憶",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叫びざま、リキーが艇長におどりかかろうとした時、「リキー、その子供をお放しよ」　それまで隅っこに風呂敷のような布をかぶって、だまっていたケント老夫人が、かすれ声でたしなめた。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あれは海の風」コルマックは、低いかすれ声で言った。",
              "citation": {
                "source": "琴",
                "author": "フィオナ・マクラウド　Fiona Macleod",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜私が、墨を磨りながら耳をそばだてた、あの疾風怒濤中のかすれ声は、或は波の上に抛りだされて漂流しつつ、不運な漁夫が必死に叫びつづけた、その呼びごゑではなかつただらうか、或はさうではなくて、相手の機帆船から、闇の中に罹災者をさがしたづねて、声のかぎり呼びつづけたその呼びごゑであつただらうか。",
              "citation": {
                "source": "海辺の窓",
                "author": "三好達治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ねてませんよ、」と弱々かすれ声、「みんなの言うことは一言一句聞こえてましたよ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "緑がかった紺碧のエメラルド色だ」「いったい、何の話ですか」　俺はかすれ声で訊いた。",
              "citation": {
                "source": "理想",
                "author": "THE IDEAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お妃は相当強気でいらっしゃる」　とゾロフがかすれ声で言った。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんな世界で生き抜く弁護士なら、いいように女を喋らせますよ」「カトリーナは喋らないよ」　とミーファがかすれ声。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミーファがかすれ声で、「新聞、新聞だ」　ムーアが売店から号外をひったくり、休憩室へミーファを引っ張った。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「三人全員です」　とレバスティアが緊張して、かすれ声で白状した。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "「一万フラン賭ける」　と男がかすれ声で告げた。",
              "citation": {
                "source": "諜報部秘話",
                "author": "THE ROMANCE OF THE SECRET SERVICE FUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "気が動転した給仕がかすれ声で、「私には妻と、二人の子供が……」　グライドが男をねめつけた。",
              "citation": {
                "source": "悪の帝王",
                "author": "THE MASTER CRIMINAL",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ほかでもない、同じ島民だからな」　とジャクソンがかすれ声で言った。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを見てトリガーセンが後ずさりして、かすれ声で言った。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　フィンレイがかすれ声で、「ダイナマイトと工具は海に投げ込め。",
              "citation": {
                "source": "トリガーセンの妻",
                "author": "TREGARTHEN'S WIFE",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは過去何十年かをつうじて、彼よりも先に生贄にされた者たちの、消え入るようなかすれ声だった。",
              "citation": {
                "source": "秘密礼拜式",
                "author": "アルジャナン・ブラックウッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ええいいわ、いしが奢るわ」　低いかすれ声であったが、言葉ははっきり聞きとれた。",
              "citation": {
                "source": "いしが奢る",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "内証話のようなかすれ声で、嘲けるがごとく、憐れむがごとく、ともすれば泣いているのではないかと思われるような不思議な声で、笑いつづけた。",
              "citation": {
                "source": "暗黒星",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "間違いだよ」　父親の声はかすれ声だ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            },
            {
              "text": "「国王はからかって楽しんでおられる」　とマザロフ王子がかすれ声で言った。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "アリックス皇太子をかつぐまで、公表すべきじゃありません」「証明できるとお考えですね」　と女王がかすれ声でおっしゃった。",
              "citation": {
                "source": "王冠の重み",
                "author": "The Weight of the Crown",
                "note": "青空文庫"
              }
            },
            {
              "text": "扉を指して、かすれ声で言った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　スピード夫人がかすれ声で言った。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "かすれ声で時刻表を探した。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビンセント卿がそれ以上歩けず、ハアハア息をして、かすれ声でささやいた。",
              "citation": {
                "source": "煉獄",
                "author": "The Nether Millstone",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
