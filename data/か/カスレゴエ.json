[
  {
    "uuid": "f8e31263-600f-5c42-bd74-37dfef58ce48",
    "entry": "かすれ声",
    "reading": {
      "primary": "かすれごえ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
