        "examples": {
          "standard": [
            {
              "text": "近所の池で、大きなカムルチーが釣れたと聞いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カムルチーは、その獰猛な性質から「ライギョ」とも呼ばれる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "淡水魚のカムルチーは、特定外来生物に指定されている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "「君は知るまい、これはカムルチという魚なんだ、怖るべき奴だ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "恐山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "カムルチは蛇の樣な形をしてゐるとの事であるが、宿屋の主人の見せてくれた溌溂たる奴を見ると、成程多少はそれに似た不氣味な形をしてゐるのみならず、頗る獰猛な鬪魚の種類であつて、近年は京都附近の川にも少し繁殖してゐると言ふ。",
              "citation": {
                "source": "異國さかな雜談",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一寸オコゼにも似た形をしてゐるが、カムルチ的のムツチリした仲々捨て難い味を持ち、川魚と言ふよりも寧ろ海魚の味である。",
              "citation": {
                "source": "異國さかな雜談",
                "author": "濱田耕作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
