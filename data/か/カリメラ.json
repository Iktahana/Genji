        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "５　水仙月の四日赤い毛布を被ぎ、「カリメラ」の銅鍋や青い焔を考えながら雪の高原を歩いていたこどもと、「雪婆ンゴ」や雪狼、雪童子とのものがたり。",
              "citation": {
                "source": "『注文の多い料理店』新刊案内",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりの子供が、赤い毛布にくるまって、しきりにカリメラのことを考えながら、大きな象の頭のかたちをした、雪丘の裾を、せかせかうちの方へ急いで居りました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぼくはカリメラ鍋に赤砂糖を一つまみ入れて、それからザラメを一つまみ入れる。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ほんとうにもう一生けん命、こどもはカリメラのことを考えながらうちの方へ急いでいました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あしたの朝までカリメラの夢を見ておいで。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ひとりの子供が、赤い毛布にくるまつて、しきりにカリメラのことを考へながら、大きな象の頭のかたちをした、雪丘の裾を、せかせかうちの方へ急いで居りました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ほんたうにもう一生けん命、こどもはカリメラのことを考へながらうちの方へ急いでゐました。",
              "citation": {
                "source": "水仙月の四日",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
