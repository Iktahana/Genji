        "examples": {
          "standard": [
            {
              "text": "「見て見て！紙粘土で本物そっくりのショートケーキを作ったよ。イチゴの粒も再現したの！」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "夏休みの自由研究で、紙粘土をこねて自分だけのオリジナル貯金箱を一日がかりで完成させた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "乾くと真っ白になる紙粘土に、アクリル絵の具を何度も塗り重ねて深みのある色を出していく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "現実を模し、紙粘土や塗料、それに鉄道模型用品を巧みに使って、作りあげたものだ。",
              "citation": {
                "source": "波乗りの島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
