  {
    "uuid": "9022c0e1-b7c0-5391-b2ae-13884634b393",
    "entry": "梶木",
    "reading": {
      "primary": "かじき",
      "alternatives": [
        "カジキ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
