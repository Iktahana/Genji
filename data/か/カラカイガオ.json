          "literary": [
            {
              "text": "無論これは、例の怪物の、悠々迫らぬ、からかい顔の逃走トリックであった。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "……君のシーツの上にとぐろでも巻いていたのかね」　一郎はからかい顔だ。",
              "citation": {
                "source": "魔術師",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「で、お爺さんは中へ入って見ないんですか」　小池助手がからかい顔に訊ねると、老人は顔の前で手を振って見せた。",
              "citation": {
                "source": "悪魔の紋章",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "いやだわあたし」「何ぜさ」北川はからかい顔に聞返す。",
              "citation": {
                "source": "五階の窓",
                "author": "合作の一（発端）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも、その人形殺しの犯人は、換玉の人形を用意していて、ここへ据えつけて置いたとでも云うのかね」　紳士が、からかい顔に訊ねた。",
              "citation": {
                "source": "妖虫",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
