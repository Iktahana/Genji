        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "半四郎君の出てゆく水の音が闇に響いてカパンカパンと妙に寂しい音がする。",
              "citation": {
                "source": "水籠",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "ではゆるりゆるりとまいりましょうか」　三日の間、そこに来ては寝ころんでいた秣の中から、むくむくと起きあがると、平七は、曳き出した鹿毛にひらりと乗った有朋のさきへ立って、なんのこともない顔を馬と並べ乍ら、パカパカと三めぐりの土手へあがっていった。",
              "citation": {
                "source": "山県有朋の靴",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "密々に旨を含めて、五、六人同道せい」　パカパカとひづめの音を鳴らして、事変突発注進の一騎が、霧のかなたに消え去りました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "毒を抱く女",
                "note": "青空文庫"
              }
            },
            {
              "text": "くろがたてがみをさかだてたかと見るまに、パカパカとすさまじい勢いで走りだしました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "パカパカと矢のように駆け近づいてくる馬の鼻さきめがけて、手にしていた青竹をひゅうひゅうと打ちふりました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "）早い話が、俺にデイヴィッド・カパァフィールドが書けるか、どうか、考えて見た。",
              "citation": {
                "source": "光と風と夢",
                "author": "中島敦",
                "note": "青空文庫"
              }
            },
            {
              "text": "私もその前にはサツカレイの『虚栄市』『エスモンド』やヂツケンスの『ダビツトカパフイルド』などを愛読したものである。",
              "citation": {
                "source": "私と外国文学",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "カパカパと馬が歩き出した。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「大してそうでもございません」　馬の足掻きがパカパカと聞こえ、そうして鈴の音がシャンシャンと鳴る。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "たしか橋の上を今荷馬車が通つてゐるらしく、ゴロゴロといふ響と一緒にパカパカと馬の蹄の音が聞えた。",
              "citation": {
                "source": "潮干狩",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "このスカパフロー湾は、相手国たる独国の海軍｜根拠地ウィルヘルムスハーフェンを去ること実に五百六十｜哩の遠隔の地にあり、独国軍艦にお目にかかるのには、外野席以上の遠方の地点で、これほど縁どおいところはない。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（×月×日、スカパフロー発）　余は今、純毛純綿のベッドに横わりながら、昨日に引続き、スカパフロー発の第二報の原稿を書いているところである。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかも一時間十五分というものを、夜の北海の、あの冷い潮に浸っていたのであるから、まことに御念の入ったことであった――という訳は、わがロイヤル・オーク号は、昨夜、スカパフロー港の底に沈んで了ったのである。",
              "citation": {
                "source": "沈没男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "パカパカパカと景気よく、ご苦労ながら歩いてくれ。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パカパカパカと蹄の音が街道を東へ通って行った。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カパカパという蹄の音、フーフーという馬の鼻息、二人は無言で進んで行った。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「おれ一人では手が廻らない」　カパ、カパ、カパと蹄の音！",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "山上からカパカパカパとひづめの音、この坂道を乗りおろして来る。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二階にいると、となりの石だたみの道に馬力の馬のパカパカパカと方向をかえる乱れたひづめの音がした。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
