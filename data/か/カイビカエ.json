        "examples": {
          "standard": [
            {
              "text": "消費税増税の発表を受け、家電売り場では「様子を見る」という買い控えムードが広がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "景気先行きへの不安から消費者の買い控えが続き、百貨店の売り上げが前年比で大幅に落ち込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "新モデルの発売が近いと噂されたため、スマートフォン売り場では買い控えが目立った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "ガソリンの供給に対する危機感の薄れに加え、ＣＢ用トランシーバーが急速に増大したことによる電波の混雑解消のために進められた、従来の二三チャンネル用から四〇チャンネル用への切り替えが買い控えを招き、一気に値崩れを起こして業界はパニックに陥った。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            }
          ]
        }
