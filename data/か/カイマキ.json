    "definitions": [
      {
        "index": 1,
        "gloss": "sleeved quilt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "かい巻きは冬の寒い夜に重宝される寝具だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "祖母は毎日かい巻きに包まれてうたた寝をしていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "かい巻きの袖を通す動作は、独特の着用方法を必要とする。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "僕はおかあさんを起そうかとちょっと思いましたが、おかあさんが「お前さんお寝ぼけね、ここにちゃあんとあるじゃありませんか」といいながら、わけなく見付けだしでもなさると、少し耻しいと思って、起すのをやめて、かいまきの袖をまくり上げたり、枕の近所を探して見たりしたけれども、やっぱりありません。",
              "citation": {
                "source": "僕の帽子のお話",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「まあほんとうにあつい、　こんな『かいまき』をかけてちゃあゆだっちゃう。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "『女中』にそう云って赤いうすい『かいまき』を出させて下さいな。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと気がつけば、私は離れの十畳に寝ており、姉がかいまきをかけてくれている。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてかいまきの袖から手を出して何かよんでいらっしゃるかしら。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四一年（昭和十六年）",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
