        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "宿の番傘を借りて明神池見物に出掛けた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "明神池は自分には別に珍らしい印象を与へなかつた。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "明神池は自分には別に珍しい印象を与えなかった。",
              "citation": {
                "source": "雨の上高地",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "『英国人類学会雑誌』十巻三〇九頁にいう、ソロモン島では、人の余食を神池の魚や蛇に食わせば、その人死すというと。",
              "citation": {
                "source": "十二支考",
                "author": "蛇に関する民俗と伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "伊豆の三島の神は鰻を使者とし神池の辺で手を拍てば無数の鰻浮き出たという。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかるに今は神池空しく涸れて鰻跡を絶った由。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "社のある山の径三町ばかり全山樹をもって蔽われ、まことに神威灼然たりしに、例の基本財産作るとて大部分の冬青林を伐り尽させ、神池にその木を浸して鳥黐を作らしむ。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "これに加うるに、その地に珍しき諸植物は毎度毎度神に献ずるとて植え加えられたれば、珍草木を存すること多く、偉大の老樹や土地に特有の珍生物は必ず多く神林神池に存するなり。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "かくのごとく微細生物も、手水鉢や神池の石質土質に従っていろいろと珍品奇種多きも、合祀のために一たび失われてまた見る能わざる例多し。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人明治二十七年ころ日本に来たり、わが国の神池神林が非常に天産物の保存に益あるを称揚しおりたれば、名は大層ながら野外博物館とは実は本邦の神林神池の二の舞ならん。",
              "citation": {
                "source": "神社合祀に関する意見",
                "author": "南方熊楠",
                "note": "青空文庫"
              }
            },
            {
              "text": "明神池へ渡って川沿いに進み、横尾谷の出合から一ノ俣まであまり高廻りしないで川岸の岩場をへつったりする。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "暗かったため、六百山の裾でちょっと迷ったし、明神池に行く橋を渡って、池の奥の方へ入ってしまい、一本橋を渡ったりした。",
              "citation": {
                "source": "単独行",
                "author": "加藤文太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「神池の背景で、一枚、お撮りになりません？",
              "citation": {
                "source": "あなたも私も",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "途中明神池を御見物なさる御予定であったが、梓川の増水で橋が流れ、河童橋を迂廻しなければ対岸へ渡れないので、これはお止めになった。",
              "citation": {
                "source": "秩父宮殿下に侍して槍ヶ岳へ",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "白樺の幹に抱きついて大声をあげて泣くか、明神池の藻の花の間に顔をつっこんで絶息する迄じっとしているか……三十を越して、二人の子供まである私は、子供が母に甘えるように秋の山に甘えたのである。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これは、荒木家の厩仲間から、ふと耳にしたのだが、ご主君官兵衛様の囚われている場所は、城内の北の隅で、俗に、天神池と呼ばれている藤棚のそばの武器｜庫だと聞いた。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――で、彼のはからいに依って、六月の末の闇夜、同志のひとり三原｜隼人が、忍び上手なので、城壁をこえてまぎれ入り、城中｜北曲輪の天神池のそばにある主君の獄舎まで、内外の連絡をとるために行くことになった。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "……それはどこでございましょうか」「お庭づたいに、ずっと北の方へ降りて、お櫓下のうしろを通り、天神池のほうへ行ってごらん」「えっ。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "――天神池ですか」「怖いの」　室殿はおかしそうに笑った。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かりそめにも、主筋のものにたいして」　と、たちまち火のつくような迅さでこうきめつけておいてから――「今夜、菊が天神池へ行ったのは、わたくしのいいつけでございまする。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "室殿にいいつけられて、蛍を捕りに行ったことのある天神池への細道であった。",
              "citation": {
                "source": "黒田如水",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
