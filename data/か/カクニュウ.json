        "examples": {
          "standard": [
            {
              "text": "「昔ながらの製法で、木製の樽を使ってバターを作るための撹乳作業を行った。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「生クリームを根気強く撹乳し続けると、次第に脂肪分が分離してくる。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「牧場では、新鮮なミルクを撹乳して手作りバターを販売している。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "幻影全てが晴れ、撹乳器にかけたかのような乳白色の輝きになった時、我々は再度地上に目を向け、旅の終わりがほど遠からぬ事を知った。",
              "citation": {
                "source": "狂気の山脈にて",
                "author": "H. P. ラヴクラフト　H.P.Lovecraft",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
