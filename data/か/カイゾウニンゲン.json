        "examples": {
          "standard": [
            {
              "text": "そのSF小説の主人公は事故で瀕死の重傷を負い、最新技術で生体部品を移植された改造人間となって目覚めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "改造人間をテーマにした映画は、テクノロジーと人間のアイデンティティの境界線を問い直す内容だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "「俺はもう普通の人間じゃない、改造人間だ」と主人公は義手を見つめながら呟いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "そうだとすれば、たったひとりの改造人間をつくれば、核戦争をおこし、地球上の人類を滅亡させることだってできないことではありません。",
              "citation": {
                "source": "超人ニコラ",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
