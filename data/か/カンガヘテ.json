          "literary": [
            {
              "text": "コノ　ヲトコノ　ヒトハ、ナニカ　ヒトノ　ビツクリスルヤウナ　コトヲ　シテ　エラク　ナリタイト　カンガヘテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ムスコハ　イロイロ　カンガヘテカラ、マタ　マエノ　ラツパト　オナジ　ラツパヲ　オクツテ、「コノ　ラツパヲ　ミミニ　ツケルト　ワタシノ　コヱガ　キコエマス。",
              "citation": {
                "source": "ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　チビスケハ　チヨツト　カンガヘテ　ヰマシタガ、ヤガテトビアガツテ　イヒマシタ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
