        "examples": {
          "standard": [
            {
              "text": "地球は完全な球ではなく、極がやや扁平な回転楕円体であることが精密な測量で確かめられている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "衛星軌道の計算には、地球を回転楕円体として近似したモデルを用いるのが標準だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            },
            {
              "text": "理論物理の課題で回転楕円体の慣性モーメントを積分で求める計算に長時間手こずった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-sonnet-4-6"
              }
            }
          ],
          "literary": [
            {
              "text": "電子ストロボ鏡で、天空をのぞいていると、ちょうど天空から、そろそろと降下してくる回転楕円体の「魔の空間」を発見した。",
              "citation": {
                "source": "宇宙戦隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
