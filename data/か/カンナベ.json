        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "彼は何時の間にか燗鍋といふ綽名を附けられた。",
              "citation": {
                "source": "土",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "「若旦那様、奥様からこれを」　婢は右の手に燗鍋と盃を持ち、左の手に肴を盛った皿を持っていた。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婢は燗鍋を執って酌をした。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "婢はまた燗鍋をかまえた。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでも婢は進んで来て今度は燗鍋を口へ押しつけようとした。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでは燗鍋や盃などがあるかと思って行燈の下を見た。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "燗鍋も盃も皿もなにもなかった。",
              "citation": {
                "source": "水面に浮んだ女",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「面倒をかけますな」　女は何か云って会釈しながら艫の方へ往ったが、すぐ一つの膳へ魚の煮たのを盛った皿や、飯のつけてある茶碗などを乗せて燗鍋といっしょに持って来た。",
              "citation": {
                "source": "参宮がえり",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「これはありがたい、この舟は他の舟と違うて、姐さんのような人がおるから、何もかもが往きとどいておる」　父親は女にあいそを云い云い燗鍋の酒を、杯へ注いで飲んだ。",
              "citation": {
                "source": "参宮がえり",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "燗鍋を囲炉裡にかけて玉子を二ツ三ツポン／＼と中に入れましたが早速玉子酒が出来ました。",
              "citation": {
                "source": "鰍沢雪の夜噺（小室山の御封、玉子酒、熊の膏薬）",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "伝「燗鍋に玉子酒があつたからそれを飲んだ。",
              "citation": {
                "source": "鰍沢雪の夜噺（小室山の御封、玉子酒、熊の膏薬）",
                "author": "三遊亭円朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "濁酒を燗鍋で温めて飲むのも風雅なものだ。",
              "citation": {
                "source": "濁酒を恋う",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ祖父が、燗鍋に濁酒を入れてきて、『みんな、こっちへきな。",
              "citation": {
                "source": "濁酒を恋う",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――うちのにお燗番をさせちゃだめですよ、燗のつくまえに飲んじまいますからね」　すると脇にいた女が、それではおまえさんの燗鍋はいつも温まるひまがないだろう、など云い、きゃあと笑い罵りあった。",
              "citation": {
                "source": "雨あがる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "その八帖にはもう膳が出てい、火のよく熾った火鉢には燗鍋が湯気を立てていたし、派手な色の座蒲団が二枚出してあった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あちらはいまお化粧を直していらっしゃいますから」と女中が云った、「どうぞ先にめしあがっていて下さいと仰しゃってました」　そして膳の脇から燗徳利を取って、燗鍋の中へ入れた。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "燗鍋の中の徳利に触ってみ、こっちはまだつかないわ、と云って、膳の上に出しておいたほうを取った。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "灯のはいった行燈と、燗鍋のかかった火鉢の側に酒肴の膳、そして角樽が置いてあった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "火鉢には燗鍋をかけ、膳は二つ、角樽は一升入りであった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "障子で囲った屋形船の中に、派手な色の蒲団を掛けた置き炬燵があり、燗鍋をのせた小さな火鉢と、酒肴の支度ができていた。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "火鉢に燗鍋、徳利に角樽、それから盃だけのせた膳。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "女中が去ると、彼は手まめに角樽の酒を片口へ移したり、それを徳利に入れて、燗鍋の中へ立てたりしながら、おしのの気を変えようとしてやっきになった。",
              "citation": {
                "source": "五瓣の椿",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「そんなことはない」と土田が低い声で云った、「安川はいいよ」　十太夫がやり返そうとすると、おわかが小女たちと共に、角樽や片口や、燗鍋をかけた火鉢などを運んで来、賑やかに燗の支度を始めた。",
              "citation": {
                "source": "饒舌り過ぎる",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "丸行燈が一つ、赤あかと炭火のおこっている手焙りが二つ、さくらの脇に燗鍋をのせた火鉢があり、それには燗徳利が二本はいっていた。",
              "citation": {
                "source": "醜聞",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみやは膳拵えをし、燗鍋に酒を注いで火桶にかけながら、「それからどうして」とあとを訊いた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "おみやは燗鍋の酒を銚子に移して、新八に盃を持たせようとした。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "娘たちは互いにわけもなくはしゃぎながら、甲斐の前に古びた毛氈をひろげ、重詰を並べたり、手籠から燗鍋や盃や箸などを取出して、手まめに酒の支度をした。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "きよきとなをこはくっくっと喉で笑い、温まった燗鍋と盃を、甲斐の前に置いた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第二部",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがておくみが、燗鍋と銚子を持って来た。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            },
            {
              "text": "銚子を膳の脇に置き、こちらの火鉢に燗鍋を掛けてから、甲斐のほうを見て、そんなところにいて寒くはないか、と訊いた。",
              "citation": {
                "source": "樅ノ木は残った",
                "author": "第四部",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
