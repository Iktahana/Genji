        "examples": {
          "standard": [
            {
              "text": "ハワイのレストランで、新鮮なカジキマグロのステーキを堪能した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「釣り番組でカジキマグロと格闘する漁師さんを見て、迫力に圧倒されたよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "カジキマグロは瞬発力があり、海中を高速で泳ぐことができる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "しかし、さしみといえばどこの料理屋へ行っても、魚屋が持ってくるものはめじまぐろ、しびまぐろ、かじきまぐろ、かつお、たい、ひらめ、ふぐなどばかりで、これらには、舌があいてしまっておいしく感じない。",
              "citation": {
                "source": "さしみ",
                "author": "佐藤垢石",
                "note": "青空文庫"
              }
            },
            {
              "text": "しびまぐろのほかに、かじきまぐろだとか、きはだまぐろとかがある。",
              "citation": {
                "source": "鮪の茶漬け",
                "author": "北大路魯山人",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
