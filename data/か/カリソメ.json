        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "私の些細なミスを、彼は仮初めのこととして許してくれた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "友人の悩みを聞いて、それが仮初めの出来事ではないとすぐに悟った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "人生における試練を仮初めと考えてはいけない、と師は言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
