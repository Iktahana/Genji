        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ありがたいことには炬燵があつた、粕汁があつた。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、とにかく、炬燵があつて粕汁があつて、そして――。",
              "citation": {
                "source": "行乞記",
                "author": "三八九日記",
                "note": "青空文庫"
              }
            },
            {
              "text": "粕汁はうまかつた、山頭火も料理人たるを失はない！",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜食が出て、粕汁が附いてる、これ、京都の冬の味。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和三十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "私達は、屋台のめし屋へはいって、かす汁をのみました。",
              "citation": {
                "source": "幾度目かの最期",
                "author": "久坂葉子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
