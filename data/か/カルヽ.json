          "literary": [
            {
              "text": "最早十一時をや過ぎけん、モハビツト、カルヽ街通ひの鉄道馬車の軌道も雪に埋もれ、ブランデンブルゲル門の畔の瓦斯燈は寂しき光を放ちたり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨逸の人カルヽ・ロオベルト・エヅワルト・フオン・ハルトマンなり。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "最早十一時をや過ぎけん、モハビツト、カルヽ街通ひの鐵道馬車の軌道も雪に埋もれ、ブランデンブルゲル門の畔の瓦斯燈は寂しき光を放ちたり。",
              "citation": {
                "source": "舞姫",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "之ヲ明示シタル所以ハ此限度ヨリ免カルヽ目的ヲ以テスル外國ノ財産ヲ禁スルヲ明カニシタル者。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "澤田卓爾氏來り獨逸人レオナルド、フランツ作小説「カルヽとアンナ」英譯本貸與。",
              "citation": {
                "source": "荷風戰後日歴　第一",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            }
          ]
