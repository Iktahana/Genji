        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "地元の海洋気象台では、毎日の波の高さと風速を記録している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海洋気象台からの情報により、漁船の船長たちは安全な航路を選ぶことができた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "この海洋気象台は、沿岸地域の気象災害予防に重要な役割を果たしている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "こういう見地から見て現在一番信頼の出来る施設は中央気象台とその配下にある海洋気象台のそれである。",
              "citation": {
                "source": "新春偶語",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋画の方に「測候所」があると、日本画の方にも「測候所」及び「海洋気象台」がある。",
              "citation": {
                "source": "異質触媒作用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "尚、天文台、中央気象台、海洋気象台、木村博士のＺ項発見で有名な緯度観測所などがあり、財団法人では科学と生産と技術との関連のもとに活発な業績を挙げつつ発展している理化学研究所が最もすぐれている。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            },
            {
              "text": "故志田順、堀口由己、小倉伸吉、妹沢克惟、和達清夫、松山基範、坪井誠太郎、石本己四雄（地震研究所所長）、日高孝次（海洋気象台長）の諸博士の業績がそれだ。",
              "citation": {
                "source": "現代日本の思想対立",
                "author": "戸坂潤",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
