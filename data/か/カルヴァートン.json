          "literary": [
            {
              "text": "シンクレア・ルゥイス、アプトン・シンクレア、ドライザー、カルヴァートンなどの人々が芸術的立場をもって必死に反抗したにもかかわらず、黙々たる勝利が獲られつつあるのはこの商業主義の上に延びつつある無性格の性格にほかならない。",
              "citation": {
                "source": "近代美の研究",
                "author": "中井正一",
                "note": "青空文庫"
              }
            },
            {
              "text": "その意味では、アメリカで、シンクレア・ルウィス、アプトン・シンクレア、ドライザー、カルヴァートンなどが抗議を申し込んでいるものでもある。",
              "citation": {
                "source": "美学入門",
                "author": "中井正一",
                "note": "青空文庫"
              }
            }
          ]
        }
