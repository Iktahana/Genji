        "examples": {
          "standard": [
            {
              "text": "警察は市街地で大規模な狩り込みを行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "今夜、何かしらの狩り込みがあるって噂を聞いたんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            },
            {
              "text": "当局は容疑者逮捕のため、狩り込みを計画している。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash-lite"
              }
            }
          ],
          "literary": [
            {
              "text": "後でわかった事ですが、折り悪しく闇の女の狩り込みに引っかかって、病院へ送られてしまったのでした。",
              "citation": {
                "source": "和製椿姫",
                "author": "大倉※子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
