        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "二十米ぐらいまでくると、シャガレ声で、「カリコミイ――」　と呻く声。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしカリコミを察知されたのが早かったので、便所の入口へ駈けつけた巡査が、懐中電燈で中を照しだした時には、七人の男がクモの子を散すように、逃げでる時であった。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "カリコミではないから、女に逃げる余裕を与えているのだ。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨日、一斉カリコミをやったのである。",
              "citation": {
                "source": "安吾巷談",
                "author": "東京ジャングル探検",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
