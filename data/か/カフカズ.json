        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "道々も一｜分の絶間もなく喋り續けて、カフカズ、ポーランドを旅行したことなどを話す。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "『來年邊はカフカズへ出掛けやうぢや有りませんか、乘馬で以てからに彼方此方を驅廻りませう。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "而してカフカズから歸つたら、此度は結婚の祝宴でも擧げるやうになりませう。",
              "citation": {
                "source": "六號室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "道々も一｜分の絶間もなく喋り続けて、カフカズ、ポーランドを旅行したことなどを話す。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "『来年辺はカフカズへ出掛けようじゃありませんか、乗馬で以てからにあちこちを駆廻りましょう。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてカフカズから帰ったら、こんどは結婚の祝宴でも挙げるようになりましょう。",
              "citation": {
                "source": "六号室",
                "author": "アントン・チエホフ　Anton Chekhov",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
