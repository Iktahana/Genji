        "examples": {
          "standard": [
            {
              "text": "農家は海鳥糞を肥料として購入した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "海鳥糞はかつて貴重な輸入品だった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "その海鳥糞から多くの窒素が得られた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "で、格別の注意を払わなかったが、同室のボウイの口から甲板部の下級員が十七人、機関部が二十一人で、船はこれから一直線に南下して木曜島で海鳥糞を積み、布哇を廻って北米西海岸グレイス・ハアバアで角材を仕入れ、解氷を待ってアラスカのユウコン河をクロンダイクまで上る筈だということなどを聞出すのを忘れなかった。",
              "citation": {
                "source": "上海された男",
                "author": "牧逸馬",
                "note": "青空文庫"
              }
            },
            {
              "text": "いかなる海鳥糞も、その肥沃さにおいては都市の残滓に比すべくもない。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
