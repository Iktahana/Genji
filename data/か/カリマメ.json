          "literary": [
            {
              "text": "今夜は斬り込むのだと、ゴロ浪人まで入れて、刈豆店の居酒屋で飲んで居ますとさ。",
              "citation": {
                "source": "山浦清麿",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "出し物は、「助六」漱石の「坊ちゃん」それから「色彩間苅豆」。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "極新しい処に例をとつて見れば、清元の「身替りお俊」（延若・左団次・松蔦等）や「かさね―色彩間苅豆」などが其である。",
              "citation": {
                "source": "夏芝居",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            }
          ]
        }
