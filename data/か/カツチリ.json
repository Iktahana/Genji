        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "上と下で二人の視線がカツチリと出會つた時、妙に表情の硬ばるのを意識しながら、太田は強ひて笑顏を作つた。",
              "citation": {
                "source": "癩",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "その眼と視線がカツチリ出あふと、太田はわれ知らずあわてた。",
              "citation": {
                "source": "黎明",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "カツチリと四つの手で母の腹に取縋つて、その小い五本の指を堅く／＼握つてゐるのです。",
              "citation": {
                "source": "山さち川さち",
                "author": "沖野岩三郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "パースペクチヴは古風にいふ「遠見」といふほどの意味の、その眼鏡をのぞいて向うを見る場合は、文意の基づくところを多少考証めかして、在りし東京の一断面を水平線上の焦点距離へ成るべくカツチリちゞめて見たい意味。",
              "citation": {
                "source": "東京の風俗",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
