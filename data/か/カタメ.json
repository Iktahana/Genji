          "literary": [
            {
              "text": "しかし、どんな孤高の人が、輸送船の中へカタメテつみこまれなかったろうか。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ジャングルの中にカタメテすてられた部隊から、一人はなれた人の飢餓と苦悩の運命の終焉が、カタマって餓死した人々の運命とその本質においてどうちがったろう？",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "最悪の運命の瞬間に、八千五百万の利用できる人々としてカタメられることを拒絶するために、カタマル人民、メダカの精神とその発言のうちに現代史のヒューマニズムがある。",
              "citation": {
                "source": "五〇年代の文学とそこにある問題",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
