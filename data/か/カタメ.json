[
  {
    "uuid": "eb01fb82-f3e0-50a9-99ed-d6118cdc4c01",
    "entry": "固め",
    "reading": {
      "primary": "かため",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞",
        "名詞-の形容詞",
        "形容動詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "hardening",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "基礎工事の段階でしっかり地固めをしておかないと、後で床が歪んでしまう。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ゼリーが型崩れしないように、ゼラチンの量を調整して少し固めを意識した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「ほら、雨上がりの地面が柔らかいから、足でしっかり踏み固めをして」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "八十八夜を記念しようという、なんの意味もない決心を笑いながら固めて、二人、浅草へ呑みに出かけることになったのであるが、その夜、私はいっそく飛びに馬場へ離れがたない親狎の念を抱くにいたった。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕は今擲ぐらうか今擲ぐらうかと思つて拳固まで固めてゐたんだけれど、罰するのは神様の務めで人間のすることぢやないと思つたからギユーギユーいつて我慢したんだつたが……」　停留場に来るまでにＳ子の従兄に当る男が彼にこんなことを言つた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "埃つぽい制服に身を固めた「學生」といふ全然特殊の人間である。",
              "citation": {
                "source": "諸君の位置",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "これを巡ると、大宮口から吉田口に到るまでの間に殊に多く灰青色の堅緻なる熔岩流があり、漆喰で固めたように山を縦に走っている。",
              "citation": {
                "source": "高山の雪",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "とある横町をちょっと山の方へ曲り込んでみると、道に向って倒れかかりそうになったある家に支柱をして、その支柱の脚元を固めるためにまた別のつっかい棒がしてある。",
              "citation": {
                "source": "静岡地震被害見学記",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "全體その天井や壁が灰色の陰影だけで出來てゐるのか、つめたい漆喰で固めあげられてゐるのかわからなかった。",
              "citation": {
                "source": "圖書館幻想",
                "author": "宮澤賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "質量という考えを明らかにするにはどうしても力という考えを固めなければ工合が悪い。",
              "citation": {
                "source": "物質とエネルギー",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "習字と漢籍の素読と武芸とだけで固めた吾等の父祖の教育の膳立ては、ともかくも一つのイデオロギーに統一された、筋の通り切ったものであった。",
              "citation": {
                "source": "マーカス・ショーとレビュー式教育",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "こんなものを使わなくても、何か鋸屑でも固めたようなもので建築材料を作ってそれで建てたらいいだろうと思う。",
              "citation": {
                "source": "ある日の経験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "木乃伊を作るには始め塩水に死体を漬け種々の樹脂の類を塗って固めたものらしい。",
              "citation": {
                "source": "話の種",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "レモンヱロウの繪具をチユーブから搾り出して固めたやうなあの單純な色も、それからあの丈の詰つた紡錘形の恰好も。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは、「幾世紀も幾千年にも亘る祖国の存在によって固められた最も深い感情の一つである。",
              "citation": {
                "source": "明治の戦争文学",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "炊事場へザンパンを貰いに来る者たちが踏み固めた道は、新しい雪に蔽われて、あと方も分らなくなった。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "レモンエロウの絵具をチューブから搾り出して固めたようなあの単純な色も、それからあの丈の詰まった紡錘形の恰好も。",
              "citation": {
                "source": "檸檬",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙と火とを固めて空に抛げつける。",
              "citation": {
                "source": "楢ノ木大学士の野宿",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あそこは店の中でも一番暗い処で、私が珍本と思った本だけをソーッと固めて置いとく処ですからね。",
              "citation": {
                "source": "悪魔祈祷書",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてお固めが済みましたならば、お福さんに何もかも打ち明けて、一緒にお熊さんのお墓参りをなさいませ。",
              "citation": {
                "source": "狂歌師赤猪口兵衛",
                "author": "――博多名物非人探偵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから二階で又盛んに飲んで、歌って、死生の契りを固めているうちに、とうとう飲み潰れて二人ともグウグウ寝てしまった。",
              "citation": {
                "source": "呑仙士",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ一つのおもしろかったのは、麻糸か何かの束を黄蝋で固めた松明を買わされて持って行ったが、噴気口のそばへ来ると、案内者はそれに点火して穴の上で振り回した。",
              "citation": {
                "source": "案内者",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてうそで固めたばかばかしい饒舌の中におのずからまた何物かほんとうのものに触れているところがないでもない。",
              "citation": {
                "source": "一つの思考実験",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "と思うと純次はいきなり立ち上って、清逸の方に近づくが早いか、拳を固めて清逸の頭から顔にかけてところきらわず続けさまになぐりつけた。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それとも何かついていますか」　渡瀬さんはいきなりそのこね固めたような奇怪な顔を少し突きだすようにした。",
              "citation": {
                "source": "星座",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "処が世の中は芝居で固めてあるんだ。",
              "citation": {
                "source": "かんかん虫",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "晝間になつて日が照り出すと、人の往來する所だけはどろ／＼に雪解がして、泥炭地の水のやうな黒褐色の水が盤に踏み固められた雪路の上を逃げ所もなく漂ひ※る。",
              "citation": {
                "source": "春",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何と抗うてみても体験で固めたこの厚い扉のように堅く寂しい男の笑顔に対しては、爪も立たないように思われました。",
              "citation": {
                "source": "扉の彼方へ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "もう身を固めてもよかろう」。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが「もう身を固めねばならない」という嘆声になります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "また身内や友達も自己の体験に響いてそうさせるべきだという自然力を知らず知らずのうちに感じて「もう身を固めなさい」という助言を与えるのであります。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "この場合には、水を排かせるなり、両岸を高く築き固めるなりして害を除きます。",
              "citation": {
                "source": "仏教人生読本",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "つまりしっかりした芸術作品を持ったり他の事業でも真摯な地歩をかためて居る女性以外には装飾的な表皮の感情は多くひらめかして居ても本質的な真面目な熱情や感情が浅薄です。",
              "citation": {
                "source": "新時代女性問答",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "pledge",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
