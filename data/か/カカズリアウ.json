        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "二つの藤の蔓が拘り合ってしまい、解くのに時間がかかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "意見の異なる二人が拘り合って、議論が白熱した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            },
            {
              "text": "若い時代、彼は色々な活動に拘り合っていた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Claude",
                "note": "claude-haiku-4-5-20251001"
              }
            }
          ],
          "literary": [
            {
              "text": "……自分はお納戸向きのお使番馬廻りの家柄……要らざる事に拘り合うまい……。",
              "citation": {
                "source": "斬られたさに",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
