    "definitions": [
      {
        "index": 1,
        "gloss": "to be mixed up with",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
