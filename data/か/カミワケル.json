        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "じっくりと時間をかけて煮込まれたソースの複雑な味わいを、一口ずつ噛み分ける。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "祖父が最後に遺した言葉の重みを、親となった今、ようやく噛み分けられるようになった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "旅先で出会った人々の情愛を噛み分けながら、一人静かに帰路についた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "この古典文学は、一字一句を噛み分けるようにして、ゆっくりと読み進めたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "夜が明けたら里へ下りてお延にきっぱり自分を諦めるように話そう――新九郎には、まだ淫婦の中年の恋が、どんなに執拗で強いものか、それを充分噛み分ける経験はなかった。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして又五郎の言葉をいろいろかみわけるように、膝の上へ手を揃えてじっと聞きいった。",
              "citation": {
                "source": "おれの女房",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "やつらの羊同然な馬鹿頭でも、今度こそは、この事件の悲劇性を噛みわけるだろう！",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "然し叔父を哀れな一人旅におつぽりだしておくのが気の毒だといふ理由で、君が万座へ叔父を迎へに出向く必要があるかも知れない」と、私は一語づつ噛みわけるやうな要心をもつて言ひだした。",
              "citation": {
                "source": "狼園",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "「戸張さん……」噛みわけるやうに、幽かな声で私の名前を呟き乍ら――本来は神経質な、聡明な顔付をした人だのに、全く空虚な、意識の欠けた顔をして私の部屋へ現れてくると、目、鼻、口がバラバラに見えて不思議にあどけない土人形のやうであつた。",
              "citation": {
                "source": "蝉",
                "author": "――あるミザントロープの話――",
                "note": "青空文庫"
              }
            },
            {
              "text": "だが蕎麦の味から、幸村の人間を、噛みわけることはできなかった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "円明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京に限るといわれた自慢の蒲焼も、その江戸前の香味は失せて、どろ臭いのに慣れてみれば、本格の老舗も、そこらの新店も、かみ分けるほどの好者は寥々、随って場違いの代物でも苦情なしに召上がるので繁昌はなにより。",
              "citation": {
                "source": "明治世相百話",
                "author": "山本笑月",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
