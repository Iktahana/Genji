          "literary": [
            {
              "text": "習性及び形態の保存に固着してカリバンのように固有の生活にしがみ附こうとする生物を或る神秘な力が鞭ちつつ、分化から分化へと飛躍させて来た。",
              "citation": {
                "source": "惜みなく愛は奪う",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホメロスはそれをもってポリフェモスを縛し、シェークスピアはそれをもってカリバンを縛したことであろう。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            }
          ]
        }
