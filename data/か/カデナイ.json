          "literary": [
            {
              "text": "廻轉ハ地上カラ向ツテ右ネヂノ方向デアツタト思フガ確カデナイ。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "外ニ誰カ出来タノカモ知レナイガ、ソノ点ハ確カデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ書ハ昔或ル美術商カラ手ニ入レタモノダガ、荷風ノ書ハ非常ニ偽筆ヲ上手ニ書ク男ガイタソウデアルカラ、コノ幅モ真偽ハサダカデナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "何処ト云ウコトハ明カデナイガ、多分割下水時代ノ彼女ニ違イナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
