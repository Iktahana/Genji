[
  {
    "uuid": "8e92a1d7-9738-595a-b6b2-400bb158a0b2",
    "entry": "開放的",
    "reading": {
      "primary": "かいほうてき",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "形容動詞"
