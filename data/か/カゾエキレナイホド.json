[
  {
    "uuid": "f4addb50-9af3-51f2-bfcf-eb630a877fbf",
    "entry": "数えきれない程",
    "reading": {
      "primary": "かぞえきれないほど",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
