          "literary": [
            {
              "text": "彼は、藤夜叉の語り出ることに、およそは、疑いをもたなかった。",
              "citation": {
                "source": "私本太平記",
                "author": "あしかが帖",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを語り出でるためには時間と意志とが必要である。",
              "citation": {
                "source": "青年青木三造",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "おまえの良心がおまえを叫ばさせずにはおかないまでおまえの唇に迫るまで、おまえはへりくだり虚くして待つがいい、そのときこそおまえは権威ある人として語り出でることができるであろう。",
              "citation": {
                "source": "語られざる哲学",
                "author": "三木清",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
