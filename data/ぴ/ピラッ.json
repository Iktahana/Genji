          "literary": [
            {
              "text": "ピラッと、鮠は彼の手の中へ躍ってきた。",
              "citation": {
                "source": "源頼朝",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さすればただいまの老婆もその片われじゃな」「オオ、そこにいる修道士、引っくくってごせんぎなされませ」　といわせもはてず、小谷の方のうるわしい頬へピラピラッと四、五本の針がふき刺さった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と見る間にピラピラッと闇を縫って飛んだ投げ槍――ああ悪魔の毒槍。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
