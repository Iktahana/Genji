          "literary": [
            {
              "text": "喜平は後ろを振り返って、またぴゅっぴゅっと鞭を振り鳴らした。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "幹太郎は竹刀をぴゅっぴゅっと振りながら、平八を見て顔を歪めた。",
              "citation": {
                "source": "花も刀も",
                "author": "山本周五郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツ語の「おまえ百まで、わしゃ九十九まで」という意味とやらの小唄を教えて下さったり、星のお話をしたり、即興の詩を作ってみせたり、ステッキついて、唾をピュッピュッ出し出し、あのパチクリをやりながら一緒に歩いて下さった、よいお父さん。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピュッピュッという矢のうなりが、かれの耳をかすって飛んだ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
