            {
              "text": "上向いちやピカピカピカ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "下向いちやピカピカピカ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "クルクル廻しちやピカピカピカ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピカピカピカピカ、ピッカピカ、クルクル、ピカピカ、ピッカピカ。",
              "citation": {
                "source": "とんぼの眼玉",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "あッもう駄目だッ」　ピカピカピカッと白い閃光が、雷のように目を射た。",
              "citation": {
                "source": "地中魔",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "天空高く、一千メートルとおぼしき高度のところに、ピカピカピカピカと、砲弾が炸裂して、まるで花火のようだ。",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピカピカピカと、空中に奇妙な閃光が起ると見る間に、ぶるンぶるンと異様な空気の震動――とたんにパッと咲いた真赤な炎！",
              "citation": {
                "source": "空襲警報",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "庭も広ければ屋敷も広い、どっちを見ても結構ずくめ、ピカピカピカ光っている。",
              "citation": {
                "source": "任侠二刀流",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
