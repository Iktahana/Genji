        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "とすれば、彼の青猫は怖しい現代の吸血猫、かの山海のあひだに變幻出沒するところのバンピール――怖るべき電氣猫。",
              "citation": {
                "source": "定本青猫",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
