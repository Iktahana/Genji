        "examples": {
          "standard": [
            {
              "text": "「あんな危険な場所に、ぴょこぴょこ顔を出すもんじゃないよ」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "彼はアポもなしに、取引先のオフィスへぴょこぴょこ出向いていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "会議の最中にぴょこぴょこ席を立つのは、失礼にあたる。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
