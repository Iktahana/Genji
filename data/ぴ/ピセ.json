          "literary": [
            {
              "text": "「蛆虫めら」というのは最高度の軽侮を意味するエピセットである。",
              "citation": {
                "source": "蛆の効用",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うじ虫めら」というのは最高度の軽侮を意味するエピセットである。",
              "citation": {
                "source": "自由画稿",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "坊ちゃんは毒むしにさされて、チン／＼の先がピセみたいになって医者へ行ったりして、二日休学。",
              "citation": {
                "source": "手紙",
                "author": "知里幸恵",
                "note": "青空文庫"
              }
            },
            {
              "text": "前に述べたような惨劇を思い起こさせる上に、丸屋根の見えるサルペートリエール救済院とすぐ柵が近くにあるピセートル救済院との間にはさまってることが感ぜられた、すなわち女の狂人と男の狂人との間にあることが。",
              "citation": {
                "source": "レ・ミゼラブル",
                "author": "LES MISERABLES",
                "note": "青空文庫"
              }
            },
            {
              "text": "後者（高価な方）はエピセット・ヴェーラム（真の名前）の通りであって、砂糖と生姜だけからなっている。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
