[
  {
    "uuid": "a946d1da-e7cb-563d-8b3e-7f4dafa92bad",
    "entry": "ピクン",
    "reading": {
      "primary": "ピクン",
      "alternatives": [
        "ぴくん"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
