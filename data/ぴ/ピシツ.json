          "literary": [
            {
              "text": "それは病室と玄関との間に一枚だけはづさないで立つてゐる襖に当つて、ピシツ！",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤井　……（出合ひがしらに、両足をピシツと揃へて習慣になつてしまつてゐる挙手の礼が出る）来たよ。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうせ此世では返せまい、あばよ」　諜し合せた二人の者、主人の清右衞門を土藏の中に殘して、元入つた入口から、外へ飛出すと共に、表の大扉を、ガラガラピシツと締めてしまつたのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "寳掘りの夜",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへ小鹿を連れた鹿の一群が近づいて来て苔を喰べたり、後肢で立つて小枝をピシツと折つてみたりする。",
              "citation": {
                "source": "椎の実",
                "author": "橋本多佳子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
