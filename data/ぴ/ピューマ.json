        "examples": {
          "standard": [
            {
              "text": "山道で野生のピューマに遭遇し、肝を冷やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ピューマは驚異的な跳躍力を持ち、高い岩場も難なく移動する。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ズーラシアで展示されているピューマのしなやかな筋肉に見惚れてしまった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "今日といえどもアフリカで虎と呼ぶは豹でアメリカで虎と呼ぶは旧世界に全くなきジャギュアル、また獅と呼ぶのは同じく東半球に住まぬピューマなるなど猫属の諸獣の性質｜酷だ相似たる点から名称の混雑は尠なくない。",
              "citation": {
                "source": "十二支考",
                "author": "虎に関する史話と伝説民俗",
                "note": "青空文庫"
              }
            },
            {
              "text": "地面に寝ててピューマが被さってきたら、とても危険だ。",
              "citation": {
                "source": "玉手箱",
                "author": "A Golden Argosy",
                "note": "青空文庫"
              }
            }
          ]
        }
