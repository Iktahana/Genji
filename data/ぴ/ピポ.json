        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ピポスコラ族と全く同じようになる。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして一万年か二万年たてば、われわれ人類にはネオピポスコラ族という名前がつくだろうな」「ははあ。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのピポスコラ族というのは、何ですか。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "今までに民族学や人類学はずいぶん勉強しましたが、ピポスコラ族なんてものは聞いたことがありません。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "或いは、私をそのピポスコラ族の前へ連れていってくだすってもかまいません」「あはははは。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしてお前が、第八回目の手紙を書くようになったときには、お前は否応なしに、ピポスコラ族に出会った話を書かなければならないだろう。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それまでわしは、ピポスコラ族のことも、又それと同じ生活様態になるわれわれ人類のことについても、喋らないことにする」「まるでお伽噺に出てくる人間の姿をした神様の台辞みたいですね。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピポスコラ族とは、どんな民族なのであろうか。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかしピポスコラ族が何ものであるかは、遂に手懸りがなかった。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピポスコラ族には、遂に昨日面接しました。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等は自ら、これがピポスコラ族であることを申立てました。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで私は洪君とはかり、これから何とかしてこの土地でピポスコラ族にならい穴居生活をつづけることになりました。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "もしもどこかで、洪君のためによき配偶が見つかるならば、われわれ人類は、やがてネオピポスコラ族という新しい種族をつくり、この地中に、繁栄することでありましょう。",
              "citation": {
                "source": "今昔ばなし抱合兵団",
                "author": "――金博士シリーズ・４――",
                "note": "青空文庫"
              }
            },
            {
              "text": "（うるさくつてね）やす　　ピポオつて好かんやつ、そぎやん時ばつかり、役人｜顔して……。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピポロコスの子＊グラウコス、リキエー軍に主たる者、亂軍中に槍投げて、デキシアデース、イーピノス、速き戰車に飛びのれる彼の肩射て貫ぬけば、　15眞逆に戰車より地上に落ちて息絶えぬ。",
              "citation": {
                "source": "イーリアス",
                "author": "ILIAS",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふん、こいつァいいや」　そう言って、みなが食事をしているほうへ向って、「おい、ピポ！",
              "citation": {
                "source": "犂氏の友情",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "そしてわが国の戦争のときには、アンピポリスでもポティダイアでもデリオンでも、その他わたしがいた如何なる土地でも、いかにわたしが自分の恥によって身の安全を全うしようなどと思わないかを、事実によって示したのである。",
              "citation": {
                "source": "モンテーニュ随想録",
                "author": "ESSAIS DE MONTAIGNE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
