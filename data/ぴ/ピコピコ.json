    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "鼻だの、口だの、ぴこぴこ動いてばかり。",
              "citation": {
                "source": "陽炎座",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただ小鼻がひとりぴこぴこ動いてゐた。",
              "citation": {
                "source": "マルクスの審判",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」というように、厚い鼻翼をぴこぴこ慄わせて嘲弄した。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、耳から唇へかけてぴこぴこ痙攣しながら、間もなく赧く変って来た。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　二ひきのけものを交々抱いて頬ずりすると、モルモットはぴこぴこ鼻を動かして喜んだ。",
              "citation": {
                "source": "モルモット",
                "author": "細井和喜蔵",
                "note": "青空文庫"
              }
            },
            {
              "text": "それから棚に上ろうとして足をぴこぴこさせても上れなかった時に多くの生徒は再びどっと笑った。",
              "citation": {
                "source": "子規居士と余",
                "author": "高浜虚子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
