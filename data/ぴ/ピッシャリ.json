[
  {
    "uuid": "329fe335-fada-54ce-a41c-4c4b8c8cbb4a",
    "entry": "ぴっしゃり",
    "reading": {
      "primary": "ぴっしゃり",
      "alternatives": [
        "びっしゃり"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "slapping together (incl. sound)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ドアが風でぴっしゃりと閉まり、大きな音がした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼の頬を、母親の手がぴっしゃりと叩いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "打ち合わせの終わりには、部長が書類をぴっしゃりと机に置いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "気の強いのは、おのれ、凸助……いや、鼻ぴっしゃり、芋の葉を被っているけに、衣ものの縞柄も気のせいか、逢魔が時に茫として、庄屋様の白壁に映して見ても、どれが孫やら、忰やら、小女童やら分りませぬ。",
              "citation": {
                "source": "草迷宮",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "興哥は、これはきっと慶娘の落したものだろうと思って、追っついて渡そうと思って往きかけると、もう肩輿は中門を入って、それと同時に門の扉がぴっしゃりと締った。",
              "citation": {
                "source": "金鳳釵記",
                "author": "田中貢太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴっしゃりと閉ると、路地で泣声。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "「人を馬鹿にしていらっしゃら、」「先刻一度来たんだって、」「ええ、つい、その、」　額をぴっしゃりで頸を抱える。",
              "citation": {
                "source": "式部小路",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "五助は半身水口から突出して立っていたが、頻に後見らるるような気がして堪らず、柄杓をぴっしゃり。",
              "citation": {
                "source": "註文帳",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの女中のお熊というのが近所へ使いに出ると、やがて真っ蒼になって内へかけ込んで来て、自分の三畳の部屋をぴっしゃり閉め切ってしまって、小さくなって竦んでいたそうです。",
              "citation": {
                "source": "半七捕物帳",
                "author": "あま酒売",
                "note": "青空文庫"
              }
            },
            {
              "text": "なま暖かいひと間の空気に倦んで、次郎左衛門は障子を少しあけていたが、やがて又ぴっしゃりと閉め切って古びた手あぶりの前に坐って、小さい鉄瓶の口から軽く噴く湯煙りのゆくえを見つめていた。",
              "citation": {
                "source": "籠釣瓶",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　窓はぴっしゃり閉められた。",
              "citation": {
                "source": "綺堂むかし語り",
                "author": "岡本綺堂",
                "note": "青空文庫"
              }
            },
            {
              "text": "）そんな殺人者があったとしたところで、まさかその人間の名を彼が私に云い得る筈はない、と思ったので、ぴっしゃりと、叩きつけるように云ってやったのである。",
              "citation": {
                "source": "途上の犯人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "中庭の泉水に緋鯉の跳ねる音がぴっしゃり聞えた。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "」平一郎は狂ったように屋上を駈け下り、廊下を小走りに自分の部屋へはいって襖をぴっしゃり閉めきった。",
              "citation": {
                "source": "地上",
                "author": "地に潜むもの",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして硝子戸を今度はぴっしゃり閉めてしまった。",
              "citation": {
                "source": "霜凍る宵",
                "author": "近松秋江",
                "note": "青空文庫"
              }
            },
            {
              "text": "「……この下に、やはり軽合金と特殊ゴムとで出来た長靴をはき、宇宙服にぴっしゃり取付ける。",
              "citation": {
                "source": "大宇宙遠征隊",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで、ばあさんは、やせがれた手でヘンゼルをつかむと、そのまま小さな犬ごやへはこんで行って、ぴっしゃり格子戸をしめきってしまいました。",
              "citation": {
                "source": "ヘンゼルとグレーテル",
                "author": "HANSEL UND GRETEL",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　慶三は平手でぴっしゃりお千代の横面を喰わしたが、お千代は大声で泣き出すばかり、なかなか押えた袂を放さない。",
              "citation": {
                "source": "夏すがた",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、その戸をぴっしゃり閉めてしまった。",
              "citation": {
                "source": "クリスマス・カロル",
                "author": "A CHRISTMAS CAROL",
                "note": "青空文庫"
              }
            },
            {
              "text": "気がついた時にはぴっしゃり胸を何か材木で挟まれて床にのびていた。",
              "citation": {
                "source": "長崎の鐘",
                "author": "永井隆",
                "note": "青空文庫"
              }
            },
            {
              "text": "ところが、羊飼いは自分だけ中にはいると、二つに仕切ってある戸の下のほうを、彼の鼻先きでぴっしゃりと締め切った。",
              "citation": {
                "source": "ぶどう畑のぶどう作り",
                "author": "LE VIGNERON DANS SA VIGNE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこにうごめいている影――作爺さんは、チョビ安の出現と同時に、何かひどく狼狽して、今まで削っていた小さな木片を手早く押入れへほうりこみ、ぴっしゃり唐紙をしめきって、「な、な、なんだ。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "きっと相手の顔をぴっしゃり打ちかねず怒ったに違いない。",
              "citation": {
                "source": "加護",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "一番ケチな人間しかしないことだ、と云ったら、ごまかしてきくまいとして、猶泣き乍ら、だって何とか彼とかわめくので、私は思わず太郎の脚をぴっしゃりと打ちました。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四三年（昭和十八年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "奥の部屋からは、あけさしの戸口をくぐって、煙草の煙が波のように流れてくるので、しきりに咳が出るにもかかわらず、彼女は戸をぴっしゃり閉てようともしなかった。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、戸をぴっしゃり締め切ったのだ。",
              "citation": {
                "source": "地下生活者の手記",
                "author": "ЗАПИСКИ　ИЗ　ПОДПОЛЬЯ",
                "note": "青空文庫"
              }
            },
            {
              "text": "北と南の二方｜丈けに開かれた、たった二つの、小さな鉄棒をはめた窓が、凡ての光源であったが、それを更らに陰気にする為に、彼は南の窓の鉄の扉を、ぴっしゃりと締切ってしまった。",
              "citation": {
                "source": "蟲",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "fitting tightly (incl. sound)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "新しい靴は足にぴっしゃりとフィットして、まるでオーダーメイドのようだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "キャップを瓶にぴっしゃりとはめ込み、中身がこぼれないようにした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "このパズルのピースは、他のピースとぴっしゃりと合う。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
