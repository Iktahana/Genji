          "standard": [
            {
              "text": "南太平洋に浮かぶピトケアン島は、世界で最も孤立した島の一つだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "バウンティ号の反乱者たちがたどり着いたのは、このピトケアンだった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "いつか船をチャーターして、絶海の孤島であるピトケアン諸島を訪ねてみたい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ウィジントンは17世紀の末にライデンで医学教授だったスコットランド人のピトケアンの記載を典型的な例として引用している。",
              "citation": {
                "source": "近代医学の興隆",
                "author": "イェール大学で1913年に行った一連の講義",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピトケアンはこの力がどんな石臼よりも弱くないと言うだろう」(36)。",
