[
  {
    "uuid": "b64019e4-944e-57f9-92fc-5a4c77540167",
    "entry": "ピシャン",
    "reading": {
      "primary": "ピシャン",
      "alternatives": [
        "ぴしゃん"
      ],
      "is_heteronym": false
    },
    "grammar": {
