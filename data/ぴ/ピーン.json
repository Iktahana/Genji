  {
    "uuid": "1e53c50b-4dbc-5d5c-a87e-ca0a0961b000",
    "entry": "ぴーん",
    "reading": {
      "primary": "ぴーん",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "待ちな、待ちな」　ぴたり押えながら名人が静かに歩みよると、穏やかに、しかし、ぴーんと胸にしみ入るようなことばが、ふるえている粂五郎の頭上に下りました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "献上博多人形",
                "note": "青空文庫"
              }
            },
            {
              "text": "――」　と、ちらっと、考えた時、ぴーんと、木の裂ける音が、七瀬の心臓を、どきんとさせた。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴーんと、痛いだろう」「常磐津よりは、その方が上手じゃ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あ痛ッ」鎖はぴーんと張った。",
              "citation": {
                "source": "少年探偵長",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その筋の人だということは、老人たちにもすぐぴーんときたらしく、かれらはぺこぺこと頭をさげて、「へい、だんな。",
              "citation": {
                "source": "金属人間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ぴーんと音がして、番号札が、発止と三千子の顔に当るのと、がたんと穴の内側から戸が下りるのと同時であった。",
              "citation": {
                "source": "鬼仏洞事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「あのう、侯爵さまは、その夜、音楽の話をなさったり、それから御愛用の音叉を、ぴーんと鳴らしてみたりなさらなかったでしょうかしら」「ああ、あの有名なる音叉ですか。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "非常に高い音の出るあの音叉は、侯が私たちと話をなさるときには、いつも手にして玩具のように弄びながら、ぴーんと高い音をたてられるのが例だった。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "が――、待てよ」　そのとき私は、メントール侯が、いつも音叉をもちあるいて、相手に歌をうたわせながら、音叉をぴーんと弾いて耳を傾けていたことを思い出した。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "――私は、その傍へ音叉を持っていって、ぴーんと弾いてみた。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その音盤をかけながら、音叉をぴーんと弾くと、音楽以外に顕著な信号音が、或る間隔をもって、かーんと飛び出してくるのであった。",
              "citation": {
                "source": "暗号音盤事件",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "臆病風に吹かれているわけじゃない」　と、久慈は、ぴーんと胸をはっていった。",
              "citation": {
                "source": "地球要塞",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこには、出来たばかりの人造人間が、ぴーんと硬直したまま、ビールの空壜を積んだように並べられてあった。",
              "citation": {
                "source": "人造人間戦車の機密",
                "author": "――金博士シリーズ・２――",
                "note": "青空文庫"
              }
            },
            {
              "text": "それで特使は、あの髭を反対の方向へカイゼル髭にぴーんとひねり上げたものである。",
              "citation": {
                "source": "地軸作戦",
                "author": "――金博士シリーズ・９――",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのうちに、とうとう錨索は、ぴーんと張ってしまった。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「さては、――」　と、帆村ははやくもぴーんと感じて、勇気をふるって寝台に近づくと、その下にある人の顔をのぞきこもうとして、そっと毛布をもちあげました。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "（一体、ここはどこだろう）　頭の中には、鳥がさえずっているように、ぴーんと高い音がしています。",
              "citation": {
                "source": "怪塔王",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "気球は、ぴーんと膨れきっている。",
              "citation": {
                "source": "空中漂流一週間",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに、大辻の頭の中に、一つの考えがぴーんとひらめいた。",
              "citation": {
                "source": "人造人間エフ氏",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "方向舵がぴーんと曲ってしまって、今にも風にさらわれてゆきそうですよ」　太刀川時夫は、平気な口調でいった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "しっかりゆわえておけよ」　無言の太刀川を、五人ばかりでおさえつけると、両脚に、鉄でつくったゲートルのようなものをはかせ、その合わせ目に、ぴーんと錠をおろし、更に鉄のゲートルの穴に、二本の重い鉄の鎖を通した。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ひゃー」　と、酋長ロロは、こんどは腰がはいったのか、ぴーんととびあがった。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、くさりはぴーんとはり、豆潜水艇はしずかに、だるま船の上につりあげられていきました。",
              "citation": {
                "source": "豆潜水艇の行方",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "博士はピストルを、書類の下にそっとさし入れると、鞄の蓋を閉じて、ぴーんと金具をかけた。",
              "citation": {
                "source": "地球を狙う者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "日記記録計の針がぴーんと飛んで、行方がわからなくなった。",
              "citation": {
                "source": "地球発狂事件",
                "author": "海野十三（丘丘十郎）",
                "note": "青空文庫"
              }
            },
            {
              "text": "いや転ばなくても、次第によっては転ばせて、捕縄に物を言わせる凄味の相手であることは、つい今頃、送られる身になって、ぴーんと来ていない限りはないのだが、草津の駅でがんりきを咎めたように、頭ごなしに咎められない。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "その瞬間に、万事を忘れて、「あいつが来ているからには、何か事がある」　自分の胸へ、何とはつかず、ぴーんと来るものがありました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "山科の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "バケツには　水が　なみなみ、　ロープも　ベッドの上から　ぴーんと　はられ、　まど下を　ぬけて　外の　木まで　のびています。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "重みで　ぴーんと　なっていたために　むすび目が　きつく　しまりすぎて　ほどくのが　むりで。",
              "citation": {
                "source": "きつねめさんのはなし",
                "author": "THE TALE OF MR. TOD",
                "note": "青空文庫"
              }
            },
            {
              "text": "つるだって、ぴいんとしてるよ。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
