        "examples": {
          "standard": [
            {
              "text": "「この変数名はとりあえず piyo にしておこう」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "コードの例示で hoge, fuga の次に使われるのは大抵 piyo だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "プログラムのバグを探している最中、piyo という名前のダミーデータが残っているのを見つけた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "兎はぴよんと飛びしりぞいて唾を避け、ふん、といつたやうな顏つきで話を聞き、「何も私が、よろこぶわけは無いぢやないの。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "而も突如として電流体の感情が頭から足の爪先まで震はす時、君はぴよんぴよん跳ねる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴようぴようと吠える、何かがぴようぴようと吠える。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴよ、ぴよ、ぴよ、ぴよ、ぴよ、ぴよ、ぴよ、ぴよと空では雲雀の親が鳴いてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴよ、ぴよ、ぴよ、ぴよ、ぴよ、ぴよ、ぴよ、ぴよと、空では雲雀の親たちが鳴いてゐる。",
              "citation": {
                "source": "月に吠える",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
