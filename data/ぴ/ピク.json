[
  {
    "uuid": "044291af-c149-5328-ace5-d2dcb5e55dda",
    "entry": "ぴく",
    "reading": {
      "primary": "ぴく",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
