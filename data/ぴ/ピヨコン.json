          "literary": [
            {
              "text": "帰り途、ひつそりと黄昏れてゐる口繩坂の石段を降りて来ると、下から登つて来た少年がピヨコンと頭を下げて、そのままピヨンピヨンと行つてしまつた。",
              "citation": {
                "source": "木の都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "少年は千種の方へピヨコンと頭をさげて引き退つた。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "さうかと思ふと、枕木を一つ飛ばしにピヨコン／＼と飛んで行く者もあります。",
              "citation": {
                "source": "文化村を襲つた子供",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と云ひながら、ピヨコンと一つお辞儀をした。",
              "citation": {
                "source": "青春物語",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
