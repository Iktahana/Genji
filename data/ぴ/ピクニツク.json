        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "私は友人たちと必ずピクニツクにでかけた。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "立ち上る時、駿介は、「今度何時か一度みんなでどこかへピクニツクにでも行かうぢやないか。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピクニツクつて遠足か。",
              "citation": {
                "source": "續生活の探求",
                "author": "島木健作",
                "note": "青空文庫"
              }
            },
            {
              "text": "花ちらし――村総出のピクニツク――味取の総墓供養。",
              "citation": {
                "source": "行乞記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "公園へ花見連中が繰り込むのを見ても何とも感じないが、山あがり（田舎人のピクニツク）へ行く一家族を見ると、何となく心を動かされる、そして、私の生活のムリ、といふよりもウソを解消しなければならない、と思ふ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "陰暦の三月十八日、裏山の観音堂は賑やかである、地下の人々が男も女も年寄も子供もみんないつしよに、御馳走をこしらへて食べるのである、いはゞ里のピクニツク、村の園遊会である。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本晴、ピクニツク日和、まさに人生行楽の秋。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "午後は散歩、仁保津方面を歩きまはつた、ちようど氏神様の御年祭で、河原にテントを張り余興などいろ／＼あるましい、男も女もおぢいさんもおばあさんも子も孫も、どつさり御馳走を携へて集つてくる、村のピクニツク、うらやましかつた。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "で私もそれらの家族伴れなどの人達に交つて、ピクニツクに加はつたり、凧をあげて見せたりするうちに、彼等と一緒になつて彼等の習慣の中であると、自然に父親とも親しめるやうになり、父と子は相對する場合でない限り、英語で口を利いた。",
              "citation": {
                "source": "文學的自叙傳",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "で私もそれらの家族伴れなどの人達に交つて、ピクニツクに加はつたり、凧をあげて見せたりするうちに、彼等と一緒になつて彼等の習慣の中であると、自然に父親とも親しめるやうになり、父と子は相対する場合でない限り、英語で口を利いた。",
              "citation": {
                "source": "文学的自叙伝",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピクニツク・ランチとか“For the camping ready”などゝいふ項はピクニツクやキヤムピングに赴かぬ場合でも、折にふれてはわれわれの貧しい食卓の役に立つた。",
              "citation": {
                "source": "ライス・ワッフルの友",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "櫻が咲いたと言へば、折詰をこしらへて青い古渡りの毛氈をぼんさんに持たせて、嵯峨の方へ出かけて、どこの田の畦でもピクニツクをはじめる。",
              "citation": {
                "source": "砂がき",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "間もなく横浜からナタリーの一家などが遊びに来るようになつたりして、弥々私はお喋舌りになり、自転車をそろへてピクニツクに赴いたり、老若入れ交つてテニスに耽つたりして、間もなく中学を終へようとする頃になると、枳殻の生垣にとり巻かれた屋敷の隅々に測量の杭などが打たれ出した。",
              "citation": {
                "source": "熱海線私語",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピクニツクと｜同じ意味なんだけれど、もう少しお祭り気分が濃厚の、あたし達の町の行事なのよ。",
              "citation": {
                "source": "南風譜",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "殊に田端のポプラア倶楽部の芝生に難を避けてゐた人人などは、背景にポプラアの戦いでゐるせゐか、ピクニツクに集まつたのかと思ふ位、如何にも楽しさうに打ち解けてゐた。",
              "citation": {
                "source": "大正十二年九月一日の大震に際して",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "どんな池でも川でも、そして鮒でもタナゴでも、或はハゼでもイナでも、女子供のピクニツクの好伴侶になる。",
              "citation": {
                "source": "夏と魚",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "乗込み鮒は野外散歩で足で釣ると云はれピクニツクの好伴侶だ。",
              "citation": {
                "source": "日本の釣技",
                "author": "佐藤惣之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピクニツクにも教師引率の下に連れて行く。",
              "citation": {
                "source": "都市文化の危機",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "それがまるでピクニツクでもしてゐるかのやうに二人には樂しく思へた。",
              "citation": {
                "source": "顏",
                "author": "堀辰雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁には、子供会の写真や図画、それから「壁新聞」や「子供会ニユース」、ピクニツクのとき持つて行くリユツクサツクなど、いろいろのものが貼つたり、懸けてありました。",
              "citation": {
                "source": "仔猫の裁判",
                "author": "槇本楠郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "悦子　　ほら、奥多摩へピクニツクよ。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "お宅で一日御厄介になつた挙句、翌日は、みんなで奥多摩へピクニツクをしました。",
              "citation": {
                "source": "沢氏の二人娘",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日のピクニツクは、お前の送別会だつて云ふが、男は誰々が行くんだ。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "実際未明の薄明や、有明の月光の下に釣場に到着して、竿を継いでリユツクを背に、魚籠を腰に、釣場をもとめて、釣りあるくたのしさは、単なるピクニツクなどゝは比較にならない。",
              "citation": {
                "source": "健康を釣る",
                "author": "正木不如丘",
                "note": "青空文庫"
              }
            },
            {
              "text": "――▲――　私は私達のその日の愉快なピクニツクで、始めて馬も喰はぬといふ鈴蘭に赤い綺麗な実があるのもみた。",
              "citation": {
                "source": "又三郎の学校",
                "author": "小穴隆一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
