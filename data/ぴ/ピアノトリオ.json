        "examples": {
          "standard": [
            {
              "text": "今夜のコンサートでは、若手奏者たちによるフレッシュなピアノトリオの演奏を楽しんだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "ピアノトリオは、ピアノ、バイオリン、チェロの三つの音色が重なり合う重厚な響きが魅力だ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "カフェのBGMとして、穏やかなジャズのピアノトリオが流れていて心地よい。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "ストーヴに暖められ、ピアノトリオに浮き立って、グラスが鳴り、流眄が光り、笑顔が湧き立っているレストランの天井には、物憂い冬の蠅が幾匹も舞っていた。",
              "citation": {
                "source": "冬の日",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノトリオ位で非常に優れた室内音楽でも附属しているのは決して悪いものではないとしても、併し「演出効果」なぞと云う大掛かりな仕掛けは実際邪魔になり過ぎる場合がある。",
              "citation": {
                "source": "牛込館",
                "author": "映画館めぐり（十）",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが終わってひとくさり語りがあり、『ヒット・ザ・ランプ』という曲がピアノ・トリオで演奏された。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "だから正確には、ピアノ・トリオなのよ。",
              "citation": {
                "source": "七月の水玉",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピアノは非常に老巧な人で、エリー・ナイ三重奏団を組織してピアノ・トリオをポリドールに入れている。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            },
            {
              "text": "全世界待望のピアノ・トリオが、こんなに休んでいるというのは、どんな事情があるにしても（経済的の事情のように聴いているが）、まことに惜しいことである。",
              "citation": {
                "source": "名曲決定盤",
                "author": "野村長一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
