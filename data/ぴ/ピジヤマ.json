          "literary": [
            {
              "text": "庭にはピジヤマを着たノリ子さんがお姉さんに手をひかれて、そろりそろり歩いてゐました。",
              "citation": {
                "source": "チユーリツプ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "服を脱いでピジヤマと着替へる。",
              "citation": {
                "source": "音の世界",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "かなり強い風が、カーテン、蚊帳などを吹き上げ、真壁の著てゐるピジヤマの前が、ぴつたり胸にくつつく。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがて、ピジヤマを著た真壁の姿が、階段の途中に現はれる。",
              "citation": {
                "source": "牛山ホテル（五場）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
