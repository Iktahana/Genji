        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そこに小さな五六人の人かげが、何か掘り出すか埋めるかしてゐるらしく、立つたり屈んだり、時々なにかの道具が、ピカツと光つたりしました。",
              "citation": {
                "source": "銀河鐵道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は這々の態でとるものもとりあへず道場を飛び出すと、バツタのやうに苦しみながら半里もある道程を夢中で引き返すと、間もなくどつといふ発熱でピカツリと眼玉をむいたまま、あらぬウワ言を呟く重病人と成り変つてしまつたのだ。",
              "citation": {
                "source": "「学生警鐘」と風",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者の家の硝子窓が午後の日にピカツと光つた。",
              "citation": {
                "source": "島からの帰途",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピカツと光つたものがあり、マグネシユームを燃すやうなシユーツといふ軽い音とともに一瞬さつと足もとが回転し、……それはまるで魔術のやうであつた、と妹は戦きながら語るのであつた。",
              "citation": {
                "source": "夏の花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、何か動く群のなかにピカツと一直線に閃くものがあつた。",
              "citation": {
                "source": "火の唇",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨戸がないからガラス戸をとほしてピカツ、ピカツ／＼ツと青白い電光がお部屋中を気味悪くてらす。",
              "citation": {
                "source": "お泊り",
                "author": "平山千代子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
