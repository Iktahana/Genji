[
  {
    "uuid": "458a6e83-6166-590a-9eb1-97222da31a6c",
    "entry": "ぴし",
    "reading": {
      "primary": "ぴし",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "火が、ぴしぴし、音を立てて、盛に燃え出すと、樺の立木の葉が、鮮やかに、油紙の屋根に印して、劃然とした印画が炙り出される。",
              "citation": {
                "source": "白峰山脈縦断記",
                "author": "小島烏水",
                "note": "青空文庫"
              }
            },
            {
              "text": "以前の僕だったら、たしかに竹さんを一発ぴしゃんと殴ったであろう。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "という太いわめき声を背後に聞いて、がんと肩を打たれてよろめいて、ふっと振りむいたら、ぴしゃんと頬を殴られました。",
              "citation": {
                "source": "燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の泣いてゐるのを見つけた母は、どうした譯か、その洋服をはぎ取つて了つて私の尻をぴしやぴしやとぶつたのである。",
              "citation": {
                "source": "思ひ出",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　私も馬場の興奮に釣られてうろうろしはじめ、蒲團を蹴つて起きあがり、馬場とふたりで腐りかけた雨戸をがたぴしこじあけた。",
              "citation": {
                "source": "ダス・ゲマイネ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔を、ぴしゃんと殴ってやった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴしゃと小さい音が聞えるほど強く菊代はその野中の掌を撃つ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとあきかけても、またぴしゃりとしまる。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく去来を相手にせず、ぴしゃりと心の扉を閉ざしてしまった。",
              "citation": {
                "source": "天狗",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「富めるものの天国に入るは、――」そう冗談に言いかけて、ぴしと鞭打たれた。",
              "citation": {
                "source": "秋風記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　と、山伏の、いうと斉しく、手のしないで、数珠を振って、ぴしりと打って、不意に魂消て、傘なりに、毒茸は膝をついた。",
              "citation": {
                "source": "木の子説法",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "……軒が、がたぴしと鳴って、軒行燈がばッばッ揺れる。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "若い衆は舳に待ってて、声が切れると、栄螺の殻をぴしぴしと打着けますの。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "それでな、鳥羽の鬼へも面当に、芸をよく覚えて、立派な芸子になれやッて、姉さんが、そうやって、目に涙を一杯ためて、ぴしぴし撥で打ちながら、三味線を教えてくれるんですが、どうした因果か、ちっとも覚えられません。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "なぜッて、宗山がその夜の中に、私に辱められたのを口惜しがって、傲慢な奴だけに、ぴしりと、もろい折方、憤死してしまったんだ。",
              "citation": {
                "source": "歌行燈",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　笏で、ぴしゃりと胸を打って、「退りおろうぞ。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とムキになるのは大きに野暮、號外を見てぴしや／＼と額を叩き、「不思議だ不思議だ」といつたとて勝つたが不思議であてにはならぬといふにはあらず、こゝの道理を噛分けてさ、この七不思議を讀み給へや。",
              "citation": {
                "source": "神樂坂七不思議",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "案山子の簑は、三つともぴしよ／＼と音するばかり、――中にも憎かつたは後から行く奴、笠を着たを得意の容躰、もの／＼しや左右を※しながら前途へ蹌踉く。",
              "citation": {
                "source": "神鑿",
                "author": "泉鏡太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらぬか、それか、何にしても妙ではない、かようなものを間の内へ入れてはならずと、小宮山は思案をしながら、片隅を五寸か一尺、開けるが早いか飛込んで、くるりと廻って、ぴしゃりと閉め、合せ目を押え附けて、どっこいと踏張ったのでありまする。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とすさんだ口調で言い、がたぴし破戸をあけて三人を招き入れ、「座蒲団なんて洒落たものはねえぞ。",
              "citation": {
                "source": "新釈諸国噺",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と叫んで、ぴしゃんと頬を一つぶん殴ってやりたい気がした。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　雪は手をぴしゃと拍って、そう言ってから、私の着物の袖をつかまえ、ひきずるようにしてぱたぱた歩きだした。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　小菅は、それまでソフアに寢そべつてゐたのをむつくり起きあがつて、手をぴしやつと拍つた。",
              "citation": {
                "source": "道化の華",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は意を決して、友人の頬をなるべく痛くないように、そうしてなるべく大きい音がするように、ぴしゃん、ぴしゃんと二つ殴って、「君、しっかりし給え。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐにまた、ぴしゃりと押入れをしめて、キヌ子は、田島から少し離れて居汚く坐り、「おしゃれなんか、一週間にいちどくらいでたくさん。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」と、おやゆび姫は声を張りあげ、お日さまへ腕をぴしっとまっすぐのばしました。",
              "citation": {
                "source": "おやゆび姫",
                "author": "LITTLE TINY OR THUMBELINA",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬だけがときどきぴしっぴしっと尾を振って、横腹に飛びつこうとする蠅を叩き落としていた。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "高が小娘｜一疋ぐらい、いざとなれば、指の先で、ぴしっ――」「また、下卑た――」　お由羅が、軽く睨んだ。",
              "citation": {
                "source": "南国太平記",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ほかでもない、ある幌馬車の御者が、三度も四度もどなりつけたにかかわらず、彼が危く馬の首の下へはいってきそうになったので、鞭でぴしっと背中をどやしつけたのである。",
              "citation": {
                "source": "罪と罰",
                "author": "フョードル・ミハイロヴィッチ・ドストエフスキー",
                "note": "青空文庫"
              }
            },
            {
              "text": "サンタクロースはむちをぴしっとしならせて、トナカイを走らせていました。",
              "citation": {
                "source": "サンタクロースがさらわれちゃった！",
                "author": "A KIDNAPPED SANTA CLAUS",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
