        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "だがこの都市にも、衙門や天后宮のような旧支那式建築が残っており、ピンカンウーリ（平康五里）の特殊な高楼がある。",
              "citation": {
                "source": "ピンカンウーリの阿媽",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "このピンカンウーリは、現在はどうなってるか分らないが、妓楼であった。",
              "citation": {
                "source": "ピンカンウーリの阿媽",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "先般、旅行中に、したたか酒に酔い、女たちとも戯れていた際、席にいた一人の女性に、私はピンカンウーリの阿媽さんを見た。",
              "citation": {
                "source": "ピンカンウーリの阿媽",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "その美しい星座を見ていると、ふと、ピンカンウーリの阿媽さんを思い出した。",
              "citation": {
                "source": "ピンカンウーリの阿媽",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "そういうわけで、今、ピンカンウーリの阿媽さんへ、私は感謝の気持ちもこめて、手紙を書こうと思うのだが、書くことはただ、鳥の声とか日の光りとか身辺の器具とか、意味のないつまらないものに就いてだけだ。",
              "citation": {
                "source": "ピンカンウーリの阿媽",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
