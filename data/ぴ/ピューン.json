        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "見上げると、大きなつばさがぴゅーんぴゅーんと風をきっています。",
              "citation": {
                "source": "アラビヤンナイト",
                "author": "四、船乗シンドバッド",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴゅーんと、音がすると、一寸首をすくめた。",
              "citation": {
                "source": "近藤勇と科学",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "これが受けられるなら受けてみろ」　というなり、竹見の掌からぴゅーんといきおいよく、一挺のナイフが丸本の方へとんでいった。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいてパン、パン――　ぴゅーんと、艇長の頬をかすめて、弾は窓をつらぬき、外へとびだした。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまごろ何事が起ったというのか」　川上機関大尉は、つぎつぎに起る不審な出来事に、小首をかしげたが、そのとき後にあたって、わーっという喊声が聞え、それと同時に、ぴゅーんと一発の弾丸が頭の上をかすめてすぎた。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
