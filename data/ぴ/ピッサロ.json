        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "なにしろ、去年、アントワープからパリに出て来て、出しぬけにマネエやピッサロやゴーガンを見さされて、たまげてしまって、自分も明るい色を手に入れなきゃならないと言うんで、一週間ぐらいの内にパレットの絵具をすっかり取り変えてしまったくらいですからね。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーラだとかセザンヌだとかマネエだとかピッサロは幸福な気ちがい、なかんずく、われらが税関吏アンリ・ルッソウは幸福なる気ちがいの最たるものだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "塗り方にはスーラやピッサロなんぞの点描が入って来ているんで少し気に食わんが、まじりっけなしだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを僕はパリへ来て、ピッサロやセザンヌや君や――君たちから学んだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "現にピッサロさんやマネエさんなどもう五十過ぎです。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
