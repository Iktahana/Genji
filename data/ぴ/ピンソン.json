          "standard": [],
          "literary": [
            {
              "text": "更に同じ一四九九年の十一月に出発したビセンテ・ヤンネス・ピンソンは、コロンブスの第一回航海の際の船長であるが、南ブラジルの岸から北へハイチまで探検した。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "一五〇八年には、ビセンテ・ヤンネス・ピンソンとフアン・ディアス・デ・ソリスとがその実行にかかったが、南緯四十度で挫折した。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            },
            {
              "text": "南西航路の打開にはピンソンやソリス以上の巨腕が必要だったのである。",
              "citation": {
                "source": "鎖国",
                "author": "日本の悲劇",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
