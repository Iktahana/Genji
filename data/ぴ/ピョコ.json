[
  {
    "uuid": "f5884e24-2076-5eff-8c78-35cce2223ddd",
    "entry": "ピョコ",
    "reading": {
      "primary": "ぴょこ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "名詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そして、木崎に向って、ピョコンと頭を下げた。",
              "citation": {
                "source": "土曜夫人",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "新吉「あ、先生……」あとの「……お帰り…」は、口の中でもぐ／＼言って、頭をピョコンと下げる。",
              "citation": {
                "source": "四つの都",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ポーンと伏せてあけると、コロコロところがって、ピョコンと賽が起き上がるのです。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "』と言つて、其兒はピョコリと頭を下げた。",
              "citation": {
                "source": "足跡",
                "author": "石川啄木",
                "note": "青空文庫"
              }
            },
            {
              "text": "……途中でお腹が空かないようにね……そうして主人にはドッサリチップを呉れて、面喰ってピョコピョコしている禿頭を扉の外へ閉め出すとピッタリと鍵をかけながら、「明日の朝十時に起してくれエッ」　……て大きな声で怒鳴ったの。",
              "citation": {
                "source": "支那米の袋",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "御遠方ですから……」　青木は乞食みたいにピョコピョコと頭ばかり下げたが、よっぽど嬉しかったと見える。",
              "citation": {
                "source": "一足お先に",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "万平は何がなしにピョコピョコとお辞儀をした。",
              "citation": {
                "source": "芝居狂冒険",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダブダブの印度服に、無恰好なゴム長靴を穿いて一瞬間私を胡乱臭そうな眼付で見たが、やがて頭をピョコリと下げて見せた。",
              "citation": {
                "source": "冥土行進曲",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「二箱でいいんですね」　青年は返事の代りにピョコンと勢いよく立ち上った。",
              "citation": {
                "source": "女坑主",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "宿屋の主人はこの時まで、自分のおかみさんや子供達が真黒になって泣いているのを見て、ボンヤリ突立っておりましたが、忽ちピストルを取り落すと、無茶先生の前に跪いて、真黒な顔を畳にすり付けながら、「どうぞどうぞお泊り下さいお泊り下さい」　とピョコピョコお辞儀をして、手を合わせて拝みました。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは有り難う御座います」　とピョコピョコお辞儀をしながらよくよく見ましたが、不思議なことに何べん眼をこすってもそのお薬が見えません。",
              "citation": {
                "source": "豚吉とヒョロ子",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピョコピョコと頭を下げつつ不注意を詫びた。",
              "citation": {
                "source": "怪夢",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "支那人は喜んでピョコピョコ頭を下げて、散らばった南京玉を拾い集めて巾着に入れかけました。",
              "citation": {
                "source": "クチマネ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "雑夫のいるハッチを上から覗きこむと、薄暗い船底の棚に、巣から顔だけピョコピョコ出す鳥のように、騒ぎ廻っているのが見えた。",
              "citation": {
                "source": "蟹工船",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "金さんの話で見りゃなかなか大したものだ、いわば世界中の海を跨にかけた男らしい為事で、端月給を取って上役にピョコピョコ頭を下げてるような勤人よりか、どのくらい亭主に持って肩身が広いか知れやしねえ」「本当にね、私もそう思うのさ。",
              "citation": {
                "source": "深川女房",
                "author": "小栗風葉",
                "note": "青空文庫"
              }
            },
            {
              "text": "このおれが、こう手を突いて頼むから――」　と、膝に手を、ピョコリ頭を下げて見せる。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "笑うために大きく開く口から「かんしゃく」やわだかまった気分が皆、飛び出してしまう様に気が軽くなって頭がピョコピョコはずみ出しそうに思われた。",
              "citation": {
                "source": "千世子（三）",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "どうぞよろしく」　なめくじ男は、ここで今更改まってピョコンと一つおじぎをした。",
              "citation": {
                "source": "途上の犯人",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "出てみると、　そこらにいないと思った女房が、いまにも泣き出しそうな顔をさげて、誰かにピョコピョコおじぎをしている。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
