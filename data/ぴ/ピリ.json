[
  {
    "uuid": "c11bc59a-5c46-5592-bac7-7102788c5f27",
    "entry": "ピリ",
    "reading": {
      "primary": "ピリ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
