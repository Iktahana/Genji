          "literary": [
            {
              "text": "それデウス如来はスピリツアル・スブスタンシヤとて無色無形の実体、またサピエンチイシモ（三世了達の智）たり。",
              "citation": {
                "source": "ハビアン説法",
                "author": "神西清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピリツとくる奴、苦味酒は　　山の上から流れ出す！",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピリピリツと反射して行くんだな。",
              "citation": {
                "source": "浮標",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近頃はスピリツト・ガムがありますから、滅多にそんな失態を演じることはありませんが、その頃は不完全なヒゲラツクといふのをアルコールで溶いて、附髭の裏面に塗つて貼つたのです。",
              "citation": {
                "source": "大森彦七と名和長年",
                "author": "松本幸四郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
