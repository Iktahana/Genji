          "literary": [
            {
              "text": "蠅男は、まるで怒った牡牛のように暴れだし、あたりに砂をピシャンピシャンとはねとばした。",
              "citation": {
                "source": "蠅男",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "丁々と相｜撃つ音は恐しい程であり、竹の羽板はピシャンピシャンと響き渡ったが、もっとも撲った所で怪我は無い。",
              "citation": {
                "source": "日本その日その日",
                "author": "日本その日その日",
                "note": "青空文庫"
              }
            },
            {
              "text": "蘭子は訳の分らぬ奇声を発しながら、その血の池を、もみじの様な両手で、丁度水いたずらをする時と同じに、ピシャンピシャン叩いていた。",
              "citation": {
                "source": "江川蘭子",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
