          "literary": [
            {
              "text": "「もう一度僕はピナンへ行きたいね。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピナン、コロンボ、アデンと進むその船の中では、千鶴子と久慈がいつも手を取り合わんばかりにして、甲板の影から影を愉しげに廻っていたものだったが、過ぎ去った日の悩ましさも消したくなって、矢代は、蒲団の中で寝返りうった。",
              "citation": {
                "source": "旅愁",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は土耳古の将軍でピナンという者の二番目の娘のエルビーという女です。",
              "citation": {
                "source": "沙漠の古都",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
