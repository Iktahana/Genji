[
  {
    "uuid": "8810a8b8-cf01-531d-be6d-67c071afa0f3",
    "entry": "ぴしゃ",
    "reading": {
      "primary": "ぴしゃ",
      "alternatives": [],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "以前の僕だったら、たしかに竹さんを一発ぴしゃんと殴ったであろう。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "という太いわめき声を背後に聞いて、がんと肩を打たれてよろめいて、ふっと振りむいたら、ぴしゃんと頬を殴られました。",
              "citation": {
                "source": "燈籠",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "その顔を、ぴしゃんと殴ってやった。",
              "citation": {
                "source": "正義と微笑",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴしゃと小さい音が聞えるほど強く菊代はその野中の掌を撃つ。",
              "citation": {
                "source": "春の枯葉",
                "author": "―――一幕三場",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょっとあきかけても、またぴしゃりとしまる。",
              "citation": {
                "source": "不審庵",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "まったく去来を相手にせず、ぴしゃりと心の扉を閉ざしてしまった。",
              "citation": {
                "source": "天狗",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　笏で、ぴしゃりと胸を打って、「退りおろうぞ。",
              "citation": {
                "source": "茸の舞姫",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "あらぬか、それか、何にしても妙ではない、かようなものを間の内へ入れてはならずと、小宮山は思案をしながら、片隅を五寸か一尺、開けるが早いか飛込んで、くるりと廻って、ぴしゃりと閉め、合せ目を押え附けて、どっこいと踏張ったのでありまする。",
              "citation": {
                "source": "湯女の魂",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "と叫んで、ぴしゃんと頬を一つぶん殴ってやりたい気がした。",
              "citation": {
                "source": "チャンス",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　雪は手をぴしゃと拍って、そう言ってから、私の着物の袖をつかまえ、ひきずるようにしてぱたぱた歩きだした。",
              "citation": {
                "source": "断崖の錯覚",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私は意を決して、友人の頬をなるべく痛くないように、そうしてなるべく大きい音がするように、ぴしゃん、ぴしゃんと二つ殴って、「君、しっかりし給え。",
              "citation": {
                "source": "服装に就いて",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すぐにまた、ぴしゃりと押入れをしめて、キヌ子は、田島から少し離れて居汚く坐り、「おしゃれなんか、一週間にいちどくらいでたくさん。",
              "citation": {
                "source": "グッド・バイ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "右の耳朶から頬にかけてぴしゃっと平手が命中した。",
              "citation": {
                "source": "逆行",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ぴしゃあんと雪の原、木霊して、右の頬を殴られたのは、助七であった。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "間髪を入れず、ぴしゃあんと、ふたたび、こんどは左。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "さちよは、ひらと樹陰から躍り出て、小走りに走って三木の背後にせまり、傘を投げ捨て、ぴしゃと三木の頬をぶった。",
              "citation": {
                "source": "火の鳥",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "私の親爺やおふくろは、時折、私を怒らせて、ぴしゃっと頬をなぐられます。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "惣助は寝たままぴしゃっと膝頭を打とうとしたが、重い掛蒲団に邪魔され、臍のあたりを打って痛い思いをした。",
              "citation": {
                "source": "ロマネスク",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの大男の張宗昌のぶくぶく肥っている頬ッぺたをぴしゃりとやったれよ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それからぴしゃりと閉して帰ってきた。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親爺もおふくろも、兄も、それから僕も、田植えと、田植えのこしらえに額や頬に泥水がぴしゃぴしゃとびかゝる水田に這入って牛を使い、鍬で畦を塗り、ならしでならした。",
              "citation": {
                "source": "浮動する地価",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コーリヤは、窓の方へ来かけて、途中、ふとあとかえりをして、扉をぴしゃっと閉めた。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」兵士は、百姓の頬をぴしゃりとやった。",
              "citation": {
                "source": "渦巻ける烏の群",
                "author": "黒島伝治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとぴたっと鳥の群れは通らなくなり、それと同時にぴしゃあんというつぶれたような音が川下の方で起こって、それからしばらくしいんとしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとぴたっと鳥の群は通らなくなりそれと同時にぴしゃぁんという潰れたような音が川下の方で起ってそれからしばらくしいんとしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "一郎がそこで両手をぴしゃんと打ち合わせて、だあ、と言いました。",
              "citation": {
                "source": "風の又三郎",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "するとぴたっと鳥の群は通らなくなりそれと同時にぴしゃぁんといふ潰れたやうな音が川下の方で起ってそれからしばらくしいんとしました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴしゃっと地面へうつっぶせになった時の勝子の顔はどんなだったろう、という考えがまた蘇えって来た。",
              "citation": {
                "source": "城のある町にて",
                "author": "梶井基次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "馬はたびたびぴしゃっと泥水をはねあげて、みんなの顔へ打ちつけました。",
              "citation": {
                "source": "グスコーブドリの伝記",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴしゃっと頬にあたったときは悲鳴をあげたが、すぐまた反対の側から同様のを続けて喰うと出かかった悲鳴も声にはならず、もう不貞不貞しい覚悟でさらに飛び散る弾の中を踊り潜ってゆくのだった。",
              "citation": {
                "source": "罌粟の中",
                "author": "横光利一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
