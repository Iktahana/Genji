          "literary": [
            {
              "text": "他に色の好いシャンピニヨンを、十二個薄切にしてバタで半焼にする。",
              "citation": {
                "source": "食魔に贈る",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "月射しぬロアルの河の水上の夫人ピニヨンが石の山荘　巴里滞在中の夫妻は和田垣謙三博士に連れられ同博士入魂のピニヨン夫人といふ人のツウルの山荘に泊したことがある。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツウルの荘はピニヨン夫人のロアル川上の水荘である。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "ショムピニヨンとフロマージュの味は今に忘れられない。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
