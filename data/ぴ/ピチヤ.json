        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "まづ第一ばんに、水をくれてみますと、ピチヤ／＼となめて飲みました。",
              "citation": {
                "source": "小犬",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピチヤ／＼と水を撥ね返す音である。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭上の葉のそよぎと、ピチヤリ／＼と舐めるやうな渚の水音の外は、時たま堡礁の外の濤の音が微かに響くばかり。",
              "citation": {
                "source": "環礁",
                "author": "――ミクロネシヤ巡島記抄――",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぬかる道を歩く足音だけがピチヤ／＼／＼と續いた。",
              "citation": {
                "source": "防雪林",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "トンネルの中には、滝のやうに水の落ちてゐるところがあつたりして、草履もピチヤピチヤにぬれて了ひました。",
              "citation": {
                "source": "玉野川の渓谷",
                "author": "田山録弥",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして汀の水は申訳ばかりにピチヤ／＼とあるかないか分らない程の音をたてゝゐます。",
              "citation": {
                "source": "白痴の母",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピチヤリ　ピチヤリ　ピチヤリ」と　あめくんは　ガラスまどを　たたきました。",
              "citation": {
                "source": "あめくん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピチヤリ　ピチヤリ　ピチヤリ」「こんにちは。",
              "citation": {
                "source": "あめくん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピチヤリ　ピチヤリ」と　あめくんが　こたへました。",
              "citation": {
                "source": "あめくん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "あめくんは　きげんが　なほつたので「おやすみ」と　いつて、やねのうへで、あさまで「シト　シト　ピチヤ　ピチヤ」と　しづかに　うたを　うたつて、あさになると　とほくのひがしのはうに　いつてしまひました。",
              "citation": {
                "source": "あめくん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
