        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "やがて、ピユーと汽笛が鳴つて、車がつく。",
              "citation": {
                "source": "坊っちやん",
                "author": "夏目金之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "地上はそれ程でもないのに空では凄じい春風が笞のやうにピユーピユー鳴つてゐる。",
              "citation": {
                "source": "途上",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこへまた、何か雷のやうに怒鳴る聲がしたかと思ふと、小牛ほどもある硬い氷の塊がピユーツと墜ちてきて、真向からラランのからだを撥ね飛ばした。",
              "citation": {
                "source": "火を喰つた鴉",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とピユーが呶鳴った。",
              "citation": {
                "source": "宝島",
                "author": "宝島",
                "note": "青空文庫"
              }
            },
            {
              "text": "外は、二三間先きも見えない程ひどい雨が降つて、おまけに風がピユー／＼うなつて来るのです。",
              "citation": {
                "source": "嘘言と云ふことに就いての追想",
                "author": "伊藤野枝",
                "note": "青空文庫"
              }
            },
            {
              "text": "消防自動車は火事かと思つて、ピユーピユー四方から走つてきました。",
              "citation": {
                "source": "お鼻をかじられたお猫さん",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "シゲ　　水からあがる時の、あの、ピユーつていふ笛みたいな声が、わしは、どうかすると、夢の中で聞えるんだ。",
              "citation": {
                "source": "道遠からん　四幕",
                "author": "――または　海女の女王はかうして選ばれた――",
                "note": "青空文庫"
              }
            },
            {
              "text": "『サンキユー』が、時とすると『チヤンピユー』と聞えたり、『シヤンチユー』と聞えたりするんです。",
              "citation": {
                "source": "命を弄ぶ男ふたり（一幕）",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ウワーツ、北風ピユーピユー、骸骨社会の大舞踏会の真ツ只中に！",
              "citation": {
                "source": "ランボオ詩集",
                "author": "OEVRES D'ARTHUR RIMBAUD",
                "note": "青空文庫"
              }
            },
            {
              "text": "一枚々々に口で甞めて、ピユーツ、ピユーツと得意の投げ錢が夜風を剪ります。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "兵粮丸祕聞",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
