      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "with a patting motion",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "赤ちゃんは、お母さんの腕をピタピタ叩いて甘えている。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "医者は患者の背中をピタピタ叩いて、呼吸を促した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "水面をピタピタと叩く雨の音が心地よかった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "おりから驟雨のあとで場内の片すみには川水がピタピタあふれ込んでいた。",
              "citation": {
                "source": "映画時代",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "」雑巾を捨てて、立ち上り、素早く廊下の障子と、ヴェランダに通ずるドアと、それから部屋の襖も、みんな、ピタピタしめてしまった。",
              "citation": {
                "source": "八十八夜",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "かの女は、洋服のひだをピタピタたたくと、姉に背を向けて、縁の方に歩いて行き、欄干にもたれて、ぼんやりと晴れている空に、眼を向けてしまった。",
              "citation": {
                "source": "貞操問答",
                "author": "菊池寛",
                "note": "青空文庫"
              }
            },
            {
              "text": "」などゝ、自分ながら何の意味も感ぜられない虚勢を示すと、それは何のわけか解らなかつたが、私は懐ろ手をして、懐ろのなかでピタピタと胸板を叩いたりした。",
              "citation": {
                "source": "妄想患者",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "程よく焼いて用いるとき、――ピタピタと言う軽い足音が社務所の玄関口に近づいて来たかと思われるや一緒で、訪のうた声はまさしく銀鈴のような涼しい女の声です。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "けれども、お母様はそれから間もなく、その年の暮近くに私をお生みになる事がおわかりになりましたために、八月から後に来た注文はピタピタと断っておしまいになったそうです。",
              "citation": {
                "source": "押絵の奇蹟",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「いつもよいところへ現われて、ピタピタ予言をしてくれた、あの不思議な老傀儡師が、ここの主人とは夢のような話だ」――で広太郎手をつかえ、挨拶の言葉をのべようとした。",
              "citation": {
                "source": "剣侠受難",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "其癖素足に藁草履を穿いて、ピタピタと路を踏むので有った。",
              "citation": {
                "source": "死剣と生縄",
                "author": "江見水蔭",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つの卓を前にして、その向こう側へ醍醐弦四郎を置いて、眼光の鋭い巨大な鷲鼻の、老将軍のような碩寿翁が、胡麻塩の頤髯を悠々と撫し、威厳のある声音で急所々々を、ピタピタ抑えてまくし立てた様子は、爽快と云ってよいほどであった。",
              "citation": {
                "source": "生死卍巴",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "それが何かの合図と見え、武士を取り巻いていた海賊は、一度に颯と引き退いたが、ピタピタと甲板へ腹這いになった。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "狐か狸のいたずらであろうと、そのまま歩いて参りますと、ピタピタピタピタと足音が、近付いて来るではございませんか。",
              "citation": {
                "source": "名人地獄",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにごころなく振りかえってみると、まるでくびすを踏みそうに、さっきのみすぼらしい乞食浪人が、尻きれ草履を鳴らしてピタピタあとを追ってくる。",
              "citation": {
                "source": "丹下左膳",
                "author": "日光の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜歩きはちと控えたがよかろう」　すると泰軒、貧乏徳利を平手でピタピタたたきながら、「噂だけは聞いた。",
              "citation": {
                "source": "丹下左膳",
                "author": "乾雲坤竜の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピタピタピタと草履を鳴らして、丹波を追って行ったが、途中から向きを変えて神田の帯屋小路へ。",
              "citation": {
                "source": "魔像",
                "author": "新版大岡政談",
                "note": "青空文庫"
              }
            },
            {
              "text": "變な音がして眼が覺めると有明の行燈の前に、眞つ黒な男が立つて居るぢやありませんか」「確かに男だね」「それはもう親分さん、――飛起きて聲を立てようとすると襟頸を押へて枕に仰向に押付けられ、喉笛を脇差でピタピタと叩くぢやありませんか」　その時の事を思ひ出したか、女隱居はゾツと身を顫はせました。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "八五郎の戀",
                "note": "青空文庫"
              }
            },
            {
              "text": "見て下さいよ、親分」　八五郎はピタピタと自分の首を叩きながら続けるのでした。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "駕籠の行方",
                "note": "青空文庫"
              }
            },
            {
              "text": "「有難いツ、伽羅大盡の果報にあやかつてそれでは頂戴仕るとしませうか、――おつと散ります、散ります」　野幇間を家業のやうにして居る巴屋七平は、血のやうな赤酒を注がせて、少し光澤のよくなつた額を、ピタピタと叩くのです。",
              "citation": {
                "source": "錢形平次捕物控",
                "author": "笑ひ茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "それを御叶え下されば、迷子札は相違なく差上げますが」　平次は畳に両手を突いて、ピタピタと話を進めました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "迷子札",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだ、八」「これは良い、――地酒なもんですか、剣菱ですよ、こんなのは滅多にこちとらの口へ入らない」　ガラッ八はもっと欲しそうに、ピタピタと舌を鳴らします。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "瓢箪供養",
                "note": "青空文庫"
              }
            },
            {
              "text": "変な音がして眼が覚めると有明の行灯の前に、真っ黒な男が立っているじゃありませんか」「確かに男だね」「それはもう親分さん、――飛起きて声を立てようとすると襟頸を押えて枕に仰向けに押付けられ、喉笛を脇差でピタピタと叩くじゃありませんか」　その時の事を思い出したか、女隠居はゾッと身を顫わせました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "八五郎の恋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「有難いッ、伽羅大尽の果報にあやかってそれでは頂戴仕るとしましょうか、――おっと散ります、散ります」　野幇間を稼業のようにしている巴屋七平は、血のような赤酒を注がせて、少し光沢のよくなった額を、ピタピタと叩くのです。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "笑い茸",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピタピタと大木の肌を叩く。",
              "citation": {
                "source": "破れわらじ",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "徴収員は赤鼻をピタピタうごめかせ、にんまりと笑いながら、五千円をポケットにしまい、そしてとことこと戻って行きました。",
              "citation": {
                "source": "ボロ家の春秋",
                "author": "梅崎春生",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして三十分ぐらいの間、繰り返し繰り返し実に根気よく平手でピタピタ叩く音が聞えたが、赤ん坊は遂に泣き声を立てないのであった。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "妙子が再び自分の病室に運び込まれたので、幸子たち三人も妙子の寝台の周囲に戻って息を詰めていたけれども、いつ迄たってもピタピタと云う音ばかりが聞えて来、院長の空しい努力を続けつつある光景が想像された。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　彼はそういって、自分のほおをピタピタとたたいてみせました。",
              "citation": {
                "source": "怪人二十面相",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
