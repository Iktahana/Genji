        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "作家なんかがいち早く疎開したら、一生のうちにとりかえしつかないピンぼけの一区切りが出来ます。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "やはり其処がピンぼけで、くっついてろくなことはなかったわけです。",
              "citation": {
                "source": "獄中への手紙",
                "author": "一九四五年（昭和二十年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピンぼけなり　大使館環境は決して薬にならない。",
              "citation": {
                "source": "日記",
                "author": "一九四四年（昭和十九年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オートバイごと、そっくりみんな撮れてる」「ピンぼけだといい」「なぜ？",
              "citation": {
                "source": "彼のオートバイ、彼女の島",
                "author": "片岡義男",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
