          "literary": [
            {
              "text": "トマトをパンに挟む時は、パンの内側にピーナツバタを塗って召し上れ。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのほか私の発明でうまいと思ったものに、パセリの揚げたのをパンに挟むのや、大根の芽立てを摘んだつみな、夏の朝々百姓が売りに来るあれを、青々と茹でピーナツバタに和えてパンに挟む。",
              "citation": {
                "source": "朝御飯",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その代りに、トミー・モルトといふ明治屋製のウイを買ひ、ハインズのピーナツバターを発見、買って宿へ帰る。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
