        "examples": {
          "standard": [
            {
              "text": "部屋の壁に大きなピクチャーを飾り、寂しかったインテリアに彩りを加えた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "「今の瞬間をピクチャーに収めたい」と言って、彼はバッグから古いフィルムカメラを取り出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            },
            {
              "text": "スライドショーで思い出のピクチャーを次々と映し出し、家族で楽しい時間を過ごした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-3-flash-preview"
              }
            }
          ],
          "literary": [
            {
              "text": "余談にわたるが、邦楽座の漫画のサウンド・ピクチャーは実によかった。",
              "citation": {
                "source": "昭和四年の文壇の概観",
                "author": "平林初之輔",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ネイションス・ピクチュア」から抜いた絵である。",
              "citation": {
                "source": "千鳥",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺は本来絵描きだよ」「アア、ピクチュアか。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋画風の道としては、イーゼル・ピクチュアよりも壁画風なコースがこの人の任となつたことは、自然の推移であつた。",
              "citation": {
                "source": "小杉放庵",
                "author": "木村荘八",
                "note": "青空文庫"
              }
            },
            {
              "text": "エンタイアと呼ばれるビールの起源はピクチュア・オヴ・ロンドンの編集者にある。",
              "citation": {
                "source": "食品の混ぜ物処理および調理の毒物（1820）",
                "author": "A TREATISE ON ADULTERATIONS OF FOOD, AND CULINARY POISONS",
                "note": "青空文庫"
              }
            },
            {
              "text": "早い話が、ある貴族的な集会所でオブシーン・ピクチュアの活動写真をやったなんてことは、世間｜周知の事実だが、あれを考えて見給え。",
              "citation": {
                "source": "覆面の舞踏者",
                "author": "江戸川乱歩",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
