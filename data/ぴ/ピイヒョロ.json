          "literary": [
            {
              "text": "だから、チョッピイヒョロヒョロ、ピイヒョロヒョロと、たそがれかけた夕空高く囀ってこのあたり野州の山路に毎年訪れる、一名霜鳥との称のある渡り鳥のツグミの群が、啼いて群れて通っていったからとて不思議はないのです。",
              "citation": {
                "source": "旗本退屈男　第八話",
                "author": "日光に現れた退屈男",
                "note": "青空文庫"
              }
            },
            {
              "text": "つづいてめんこ、でんでん太鼓にピイヒョロヒョロの笙の笛。",
              "citation": {
                "source": "右門捕物帖",
                "author": "妻恋坂の怪",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ピー、ピー、ピイヒョロ、ヒョロ」　ラウダが口笛をふいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
