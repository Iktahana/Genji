        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ビルが　えんとつを　おりてくる　ものおとが　したとき、　かるく　ちょこんと　けりあげちゃったから、　ビルは　はじきとばされて、　おそらへ　ぴょーんと　でっちゃったんだ。",
              "citation": {
                "source": "えほんのアリス",
                "author": "THE NURSERY \"ALICE\"",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　おしまいには、弱々しげなきぃきぃ声、（「こいつがビルね」とはアリスの考え）言葉はこう、「んあ、よくわかんねえ――頭がこんがらがって――何かがこっちに来た、びっくり箱みてえに、んで、もう次にはぴょーんとロケット花火みてえで。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」とさけぶグリフォン、ぴょーんとおどり上がる。",
              "citation": {
                "source": "アリスの地底めぐり",
                "author": "ALICE'S ADVENTURES UNDER GROUND",
                "note": "青空文庫"
              }
            },
            {
              "text": "もうようなった――でも頭がこんがらがって何つったら――わかんのは、何かがこっちに来た、びっくり箱みてえに、んで、ぴょーんとロケット花火みてえに空へ。",
              "citation": {
                "source": "アリスはふしぎの国で",
                "author": "ALICE IN WONDERLAND",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　ナトキンの　うるささと　いったら　もう　あらしのようで、　あげくの　はてに　しまぬしさまの　ずじょうに　ぴょーんと　とびかかったのです！",
              "citation": {
                "source": "きたりすナトキンのはなし",
                "author": "THE TALE OF SQUIRREL NUTKIN",
                "note": "青空文庫"
              }
            },
            {
              "text": "さおと　かごを　とって、　ぴょーん　ぴょーんと　おおきく　はねながら　こぶねを　とめてあるところへ　むかいます。",
              "citation": {
                "source": "つりびとジェレミーさんのはなし",
                "author": "THE TALE OF MR. JEREMY FISHER",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこを　ぴょーんと　でていく　こわがりの　かごいりチミー。",
              "citation": {
                "source": "まちねずジョニーのはなし",
                "author": "THE TALE OF JOHNNY TOWN-MOUSE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
