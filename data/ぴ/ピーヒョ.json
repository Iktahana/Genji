          "literary": [
            {
              "text": "ピーヒョロリ、ピーヒョロリ。",
              "citation": {
                "source": "獄中生活",
                "author": "堺利彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピーヒョロヒョロ、ピーヒョロヒョロ……。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピーヒョロヒョロと、さもうれしそうにゆったりと舞っているのです。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ただいかにもうれしそうに、ピーヒョロヒョロと、ゆったり舞っていました。",
              "citation": {
                "source": "山の別荘の少年",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピーヒョ、ピーヒョ、と鳴く。",
              "citation": {
                "source": "自由人",
                "author": "豊島与志雄",
                "note": "青空文庫"
              }
            },
            {
              "text": "はるか頭上にトビが二羽ピーヒョロヒョロとまっている。",
              "citation": {
                "source": "曾我の暴れん坊",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "雨と風がいっしょになって、降り、吹き、すさぶなかを、道化た神楽歌の笛の旋律が、ピーヒョロ、ピーヒョロ、いとものどかにひびきわたります。",
              "citation": {
                "source": "幻術天魔太郎",
                "author": "野村胡堂",
                "note": "青空文庫"
              }
            }
          ]
        }
