          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "怒った彼は、ドアをぴちゃんと閉めて部屋を出て行った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "風で窓が急にぴちゃんと閉まり、皆が驚いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "彼は机の上に本をぴちゃんと置き、勉強を始めた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
