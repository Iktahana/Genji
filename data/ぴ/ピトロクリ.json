          "literary": [
            {
              "text": "昔　ピトロクリの谷は秋の真下にある。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピトロクリの谷は、この時百年の昔し、二百年の昔にかえって、やすやすと寂びてしまう。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "足元は丘がピトロクリの谷へ落ち込んで、眼の届く遥の下が、平たく色で埋まっている。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "主人は横をふり向いて、ピトロクリの明るい谷を指さした。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "高地人と低地人の血を飲んだ河の流れは色を変えて三日の間ピトロクリの谷を通った。",
              "citation": {
                "source": "永日小品",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
