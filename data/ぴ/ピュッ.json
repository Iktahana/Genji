[
  {
    "uuid": "8223e189-18ee-56c2-a367-20340efba8a0",
    "entry": "ピュッ",
    "reading": {
      "primary": "ピュッ",
      "alternatives": [
        "ぴゅっ",
        "ピュっ"
      ],
      "is_heteronym": false
    },
    "grammar": {
      "pos": [
        "副詞-と"
      ],
      "ctype": null,
      "inflections": null
    },
    "definitions": [
      {
        "index": 1,
        "gloss": "(with a) squirt",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "蛇口をひねると、水がピュッと勢いよく飛び出した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "注射器から薬液がピュッと噴き出し、彼女は思わず目をつむった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「あっ、インクがピュッって出ちゃった！」と彼は慌てて拭き取った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "自分もなんだか嬉しくなって口笛をピュッ／＼と鳴らしながら飛ぶようにして帰った。",
              "citation": {
                "source": "森の絵",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ドイツ語の「おまえ百まで、わしゃ九十九まで」という意味とやらの小唄を教えて下さったり、星のお話をしたり、即興の詩を作ってみせたり、ステッキついて、唾をピュッピュッ出し出し、あのパチクリをやりながら一緒に歩いて下さった、よいお父さん。",
              "citation": {
                "source": "女生徒",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "少し癇が立っているのだから――」　と、それに、そそられたように、一条の白光が、群れの中ほどでひらめいて、黒衣の一人が、ピュッと、大刀を振り込んで来るのだった。",
              "citation": {
                "source": "雪之丞変化",
                "author": "三上於菟吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、　勝「御用だ」　ピュッーと来るやつを、身を退き身体を逆に反して、肋の所へ斬込んだから、勝藏は捕者は上手だが物干から致してガラ／＼／＼どうと転がり落ちる。",
              "citation": {
                "source": "真景累ヶ淵",
                "author": "三遊亭圓朝",
                "note": "青空文庫"
              }
            },
            {
              "text": "馭者が、ピュッと鞭を鳴らすと、馬車はしずかに動いて行きました。",
              "citation": {
                "source": "シンデレラ",
                "author": "水谷まさる",
                "note": "青空文庫"
              }
            },
            {
              "text": "○スエ子、黒と灰色で、室の中央からピュッと分けて装飾した室が欲しいと云った。",
              "citation": {
                "source": "日記",
                "author": "一九二九年（昭和四年）",
                "note": "青空文庫"
              }
            },
            {
              "text": "まだ細い小雨が幾らか残つてゐて、物凄い風に殴られ乍らピュッと横ざまに吹きかかり、地べたと並んで何処までも真つ直｜平に走り去るやうに思はれてしまふ。",
              "citation": {
                "source": "竹藪の家",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピュッと何かを切った音がした。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "やがてピュッと何物か切る音とともに神の使者が着したらしい。",
              "citation": {
                "source": "現代忍術伝",
                "author": "坂口安吾",
                "note": "青空文庫"
              }
            },
            {
              "text": "顔の急所と覚しきところへ釘はピュッと突きささっている。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "こッちはベロをだしてやるから、そう思え」　ピュッと釘を投げる。",
              "citation": {
                "source": "落語・教祖列伝",
                "author": "飛燕流開祖",
                "note": "青空文庫"
              }
            },
            {
              "text": "躍るような形で、縁に上体をひらいた丹波、男の背中に小柄が刺さって、血がピュッと虹のように飛ぶところを、瞬間、心にえがいたのでしたが……どうしてどうして、そうは問屋でおろさない。",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピュッと鞭がうなり、「ム、虫けらどもっ！",
              "citation": {
                "source": "丹下左膳",
                "author": "こけ猿の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "浪人者はさすがに身だしなみで、引付けてある一刀を引抜き、「何をッ」　真っ向から向って来るのを迎えて、ピュッ、ピュッと、平次得意の投げ銭、一箇は刀を抜く拳を打ち一箇は眉間をしたたかに打ちました。",
              "citation": {
                "source": "銭形平次捕物控",
                "author": "鈴を慕う女",
                "note": "青空文庫"
              }
            },
            {
              "text": "こっちで仕掛けた逆茂木を滅茶滅茶にしてしまいおった」「忌々しい馬子め」「血祭を与えろ」　ピュッ――と誰かの手から弦唸りを切って毒矢が飛んだ。",
              "citation": {
                "source": "親鸞",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピュッピュッという矢のうなりが、かれの耳をかすって飛んだ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「きゃつ、ただ者ではない」ととっさにおもった蔦之助は、いっさんに追いかけながら、ピュッと手のうちからなげた流星の手裏剣！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　竹童はいきなり帯の棒切れをひッこ抜き、クロをねらってピュッと打ってかかる。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　叫ぶまもなく、ピュッ、ピュッと、風をきってくる霰のような征矢。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "が――一せつな、蛾次郎がさいごの力をこめた飛礫がピュッと、燕作のこめかみにあたったので、かれは、急所の一｜撃に、くらくらと目をまわして、竹童のからだを横にかかえたまま、粘土の急坂を踏みすべって、竹林のなかへころがり落ちていった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "と感じたので、晴季は前差の小太刀をぬいて、ピュッと一｜揮に、「曲者！",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "蛾次郎だとッ」　さけぶや否、鞍馬の竹童、般若丸の名刀をピュッと抜きはなって、声のするほうを、さッと斬りはらった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、まっ赤な火独楽は、文字どおり、一｜条の火箭をえがいて、しかも、ピュッとおそろしい唸りを立て、鼻かけ卜斎の顔へ食いつくように飛んでいった。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ピュッと水火両性がはじきあってとんだように、はねわかれた暗中二つのかげ。",
              "citation": {
                "source": "神州天馬侠",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「やあこの青侍め、剣術を知らねえな」　と郷士の一人は構えを見て充分に見くびりながら、「なぶり斬りには打ってつけな奴だ」　と真ッ向から斬り下げて来た鋭さ、新九郎はここぞと持った刀でピュッと横に打ッ払った一心の力、グワンと音がしたかと思うと、対手の刀は七、八間も横へすッ飛んで行った。",
              "citation": {
                "source": "剣難女難",
                "author": "吉川英治",
                "note": "青空文庫"
              }
            }
          ]
        }
      },
      {
        "index": 2,
        "gloss": "(with a) whoosh",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "ボールが風を切ってピュッと飛んでいき、彼のグローブに収まった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "一陣の風がピュッと吹き、彼女の髪がふわっと舞い上がった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「今の、すごいスピードでピュッて行ったね！」と彼は興奮気味に言った。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      },
      {
        "index": 3,
        "gloss": "(with a) sudden whistle (e.g. gust of wind)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "突然、横を車がピュッと通り過ぎ、彼は思わず身を引いた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "隙間風がピュッと音を立てて窓から侵入し、部屋の空気を冷やした。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「え、今のピュッて何の音？」と彼女は不安そうに周りを見回した。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": []
        }
      }
    ],
