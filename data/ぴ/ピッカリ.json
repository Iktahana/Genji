        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "赤い封蝋細工のほほの木の芽が、風に吹かれてピッカリピッカリと光り、林の中の雪には藍色の木の影がいちめん網になって落ちて日光のあたる所には銀の百合が咲いたやうに見えました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "お空のひかり、おてんとさまは、カンカンカン、月のあかりは、ツンツンツン、ほしのひかりの、ピッカリコ。",
              "citation": {
                "source": "気のいい火山弾",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "赤い封蝋細工のほおの木の芽が、風に吹かれてピッカリピッカリと光り、林の中の雪には藍色の木の影がいちめん網になって落ちて日光のあたる所には銀の百合が咲いたように見えました。",
              "citation": {
                "source": "雪渡り",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼は、恨めしさうにピッカリと眼を開けた儘天井を睨んだ。",
              "citation": {
                "source": "或る日の運動",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
