[
  {
    "uuid": "f5308eff-871d-5cae-9b95-ede3c446ac9e",
    "entry": "ぴゅう",
    "reading": {
      "primary": "ぴゅう",
      "alternatives": [
        "ぴゅん",
        "ピュウッ",
        "ピュー"
      ],
      "is_heteronym": false
    },
    "grammar": {
