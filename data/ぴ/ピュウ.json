    },
    "definitions": [
      {
        "index": 1,
        "gloss": "whiz (e.g. projectile through air)",
        "register": "standard",
        "nuance": null,
        "scenarios": [],
        "sensory_tags": {
          "colors": [],
          "temperature": null,
          "sounds": [],
          "emotions": []
        },
        "collocations": [],
        "examples": {
          "standard": [
            {
              "text": "窓の外を、強い風がぴゅうと音を立てて吹き抜けていった。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "矢が的に向かって、ぴゅうと鋭い音を立てて飛んでいく。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            },
            {
              "text": "「うわ、ぴゅうって音がして、びっくりした！」と子供が肩をすくめた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-flash"
              }
            }
          ],
          "literary": [
            {
              "text": "』　そこへ熊使いがやってきました」第三十二夜　寒い風がぴゅうぴゅう吹いていました。",
              "citation": {
                "source": "絵のない絵本",
                "author": "BILLEDBOG UDEN BILLEDER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴゅうと指笛でも吹きそうだ。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「ぴゅう………うる………る。",
              "citation": {
                "source": "フレップ・トリップ",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "天皇はすぐにかぶら矢をおつがえになって、ねらいをたがえず、ぴゅうとお射あてになりました。",
              "citation": {
                "source": "古事記物語",
                "author": "鈴木三重吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "その動作につれ、森谷牧場主森谷喜平の遺品の高価な鞭は陽にきらめきながら、ぴゅうぴゅうと鳴った。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "正勝の奴さえいなければ、彼女の気持ちがこんなに急に変わるわけはないのだ）　敬二郎は電報を洋服のポケットに突っ込んで、厩舎の中からぴゅうっと飛び出した。",
              "citation": {
                "source": "恐怖城",
                "author": "佐左木俊郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "少女の肩でカールしている長い金色のかみの毛に、雪のかけらがぴゅうぴゅうと降りかかっていました。",
              "citation": {
                "source": "マッチ売りの少女",
                "author": "THE LITTLE MATCH-SELLER",
                "note": "青空文庫"
              }
            },
            {
              "text": "風は鉄格子の窓からぴゅうぴゅう吹き込みました。",
              "citation": {
                "source": "野のはくちょう",
                "author": "DE VILDE SVANER",
                "note": "青空文庫"
              }
            },
            {
              "text": "ちょうど晩方で、ぴゅうぴゅう風が吹いてたんだ。",
              "citation": {
                "source": "清心庵",
                "author": "泉鏡花",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴゅうぴゅうと、うなりをたてて飛んでいく姿が見えました。",
              "citation": {
                "source": "右門捕物帖",
                "author": "左刺しの匕首",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴゅうぴゅうとうなりをたてんばかりに走りつづけて、その細長いお馬場の行き止まりまであともう一、二町と思われるあたりまで駆けすすんだとき、とつぜん、ちょこちょこと横から飛び出した影がある。",
              "citation": {
                "source": "右門捕物帖",
                "author": "死人ぶろ",
                "note": "青空文庫"
              }
            },
            {
              "text": "すると、思いがけなく、博士の弾丸傷のところから、草色のどろどろした粘液がぴゅうととびだしてきた。",
              "citation": {
                "source": "地球を狙う者",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "北の山の方から吹いてくる風が、子供部屋の小さい窓ガラスを、かたかたいわせたり、畑の唐もろこしの枯葉を、ざわざわゆすったり、実だけが真黒くなって竹垣によりかかって立っている日輪草をびっくりさせて、垣根の竹の頭で、ぴゅうぴゅうと、笛をならしたりしました。",
              "citation": {
                "source": "玩具の汽缶車",
                "author": "竹久夢二",
                "note": "青空文庫"
              }
            },
            {
              "text": "寒い風が電線をぴゅうぴゅうと云わせて居る。",
              "citation": {
                "source": "大きい足袋",
                "author": "宮本百合子",
                "note": "青空文庫"
              }
            },
            {
              "text": "幼年学校生は、それをねだり取って、ウドの太い茎を折ると、それで笛を削りあげ、ぴゅうぴゅう吹き出した。",
              "citation": {
                "source": "はつ恋",
                "author": "ツルゲーネフ",
                "note": "青空文庫"
              }
            },
            {
              "text": "なにしろ外はあの大吹雪なので、すこしの隙間からでもぴゅうぴゅうと粉雪が家の内に吹きこんで、見るまに子どもらの悪戯のような細長い白い山脈ができた。",
              "citation": {
                "source": "東奥異聞",
                "author": "佐々木喜善",
                "note": "青空文庫"
              }
            },
            {
              "text": "名物の空っ風が、ぴゅうっ、ぴゅうっ、ねえ、朝起きてみると、白いものが地面に下りて、霜だ。",
              "citation": {
                "source": "安重根",
                "author": "――十四の場面――",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　第二の鞭はぴゅうと唸りながら次の苦力に向かった。",
              "citation": {
                "source": "シベリヤに近く",
                "author": "里村欣三",
                "note": "青空文庫"
              }
            },
            {
              "text": "というような心持がしてねエ、上野の停車場で汽車へ乗って、ピューッと汽笛が鳴って汽車が動きだすと僕は窓から頭を出して東京の方へ向いて唾を吐きかけたもんだ。",
              "citation": {
                "source": "牛肉と馬鈴薯",
                "author": "国木田独歩",
                "note": "青空文庫"
              }
            },
            {
              "text": "また真剣を上段から打ちおろす時にピューッと音がするようでなければならない。",
              "citation": {
                "source": "「手首」の問題",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "だって布袋竹の釣竿のよく撓う奴でもってピューッと一ツやられたのだもの。",
              "citation": {
                "source": "雁坂越",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして、やさしいおじいさんの詩人の心臓をねらって、ピューッと、射ました。",
              "citation": {
                "source": "いたずらっ子",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんにピューッと何物か頭の上を飛び越したが、遥か前方の立ち木へ当たりパッと火花を迸しらせた。",
              "citation": {
                "source": "神州纐纈城",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "同時に飛び退いた小一郎は、引き抜いた下緒をピューッと振り、一つ扱くと早襷！",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」という凄い呻きが、吉次の口から迸しったが、瞬間ピューッと空を裂き、刎ね上がったは松葉杖で、ピカッと光ったは杖の先に、取り付けてある鋼鉄の環、それとて尋常なものではない、無数の鋭い金属性の棘で、鎧われたところの環である。",
              "citation": {
                "source": "神秘昆虫館",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "とたんに「ヒェーッ」と帛を裂くような凄じい掛け声が掛かったかと思うとピューッと空を抜く矢走りの音に続いて聞こえる弦返りの響き！",
              "citation": {
                "source": "日置流系図",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "軈て老人は立ち上がると側に在った縄を取り上げてピューッと高く空に投げ上げ落ちて来る所を右手で受け其儘クルクルと輪に曲げましたが、「それ、よいか、驚くなよ」　斯う云い乍ら岩の上へ置くと、何んと不思議ではありませんか、その縄が一匹の蛇と成ってヌッと鎌首を持ち上げたものです。",
              "citation": {
                "source": "天草四郎の妖術",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "九　ホーキン氏の率いる遠征隊が、チブロン島へ上陸するや否や、土人の斥候が早くも見附け、ピューッと鋭い笛を吹いた。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "紋太夫はあえて掛け声もかけず、振り冠っていた白刃を、ピューッと一つ振り下ろした。",
              "citation": {
                "source": "加利福尼亜の宝島",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "と、射していた蒼い光が忽然パッと消えたかと思うと天地が全く闇にとざされ木立にあたる深夜の嵐がにわかに勢いを強めたと見えピューッピューッと凄い音を立てた。",
              "citation": {
                "source": "大鵬のゆくえ",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
