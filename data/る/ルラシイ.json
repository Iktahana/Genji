        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "答　私ハ二人ガ眠テ居ルラシイ事ヲ室ノ外カラウカガッタ後、障子ヲソット開ケテ中ヘ入リマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ何カ不能ニナッタ老人ノ性生活―――不能ニナッテモ或ル種ノ性生活ハアルノダ―――ト関係ガアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日辻堂カラ陸子ガ子供達ヲ連レテ来ルノデ、ソレヲ心待チニシテイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウ云ウ予ノ心境ヲ、颯子ダケハオボロゲニ察知シテイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ハ少シズツ間接的方法デ試シテ見、ソノ反応ヲ見テイルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｎ・Ｄ・Ｔノ踊リ子ダト云ッテタケレド、日劇ニイタノハホンノ半年グライデ、ソノ後何ヲシテイタノカ、浅草辺ニイタコトモアルラシイシ、ドコカノナイトクラブニモイタラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "天候ヤ湿気ノ加減デイロ／＼ニナルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "若夫婦ノ居間ハ可ナリ豪華ニ飾ッテアルラシイガ、階段ノ中途ガ螺旋ニナッテイルノデ、足モトノ悪イ予ハタマニシカ上ッタコトガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「浄吉ハ今日ハイルノヨ、今夜庭デバーベキューヲスルト云ッテ騒イデルノ」「誰カ来ルノカ」「春久サント甘利サント、辻堂カラモ誰カ来ルラシイワ」陸子ハアレ以来当分来ル筈ガナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "―――冗談ミタイニ云ッテタケド、案外本気ラシカッタワ」「誰デモ女房ニソウ云ワレルト、ソンナ負惜ミヲ云ウモノサ」「彼ニモ誰カ好キナ人ガアルラシイノヨ、アタシト同ジヨウナ過去ヲ持ッタ、何処カノキャバレノ人ラシイワ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "近イウチニ部長ニナレルラシイガサラリーヤボーナスハ今ドノクライ貰ッテイルノカ、予ニハ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今日一日ダケコヽニ入院シタ形式ニシテアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（敏子モ日ニ一度ハ顔ヲ見セルラシイガ長クハイナイ）ポーラロイドハスデニ二晩使用シタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "思ウニ彼女ハ、世間ノ多クノ父親ト違イ、僕ガ彼女ヨリモ彼女ノ母ヲ熱狂的ニ愛シテイルラシイノニ憤懣ヲ感ジテイルノデハナイカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツマリ、ソレゾレ違ッタ思ワクガアルラシイガ、妻ガデキルダケ堕落スルヨウニ意図シ、ソレニ向ッテ一生懸命ニナッテイル点デハ四人トモ一致シテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「君ガ、昔、小頭ノ組合ヲ作ッタガ、セガレガ、又、仲仕ノ組合ヲ作ッテ、港ヲマゼクルラシイナア」トイウ。",
              "citation": {
                "source": "花と龍",
                "author": "火野葦平",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
