          "literary": [
            {
              "text": "五時頃バアンボオム中尉は更めてルウフア搜査のために出動した。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "いまだ彼の住居に到着せぬうち警察署へ行く途中で中尉はポオラス、ノエップ兩官の手によりロオガン街とフィンレイ街の角で逮捕されたルウフアに會つた。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルウフアの妻の搜査に數名の役員が派遣されたがダンラツプ街の彼女の實家には見當らなかつたところルウファアは女房は實妹のピイタア・エッケルト夫人の許にゐると陳述した。",
              "citation": {
                "source": "無法な火葬",
                "author": "VIOLENT CREMATION",
                "note": "青空文庫"
              }
            }
          ]
