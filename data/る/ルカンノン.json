          "literary": [
            {
              "text": "動物の世界の物語であるが、この短篇集の中に若い雄の白｜海豹ルカンノンの物語がある。",
              "citation": {
                "source": "山の彼方は",
                "author": "――常識とはどういうものだろう――",
                "note": "青空文庫"
              }
            },
            {
              "text": "北極光の照らす深い北海の年々の集合所から真白い一匹の雄海豹のルカンノンが自分の躯にうずく希みにつき動かされて、海豹の群がまだ一度も潜ったことのない碧い水の洞をぬけて遠く遠く新しい浜辺を求めて行く冒険が情趣深く描かれている。",
              "citation": {
                "source": "山の彼方は",
                "author": "――常識とはどういうものだろう――",
                "note": "青空文庫"
              }
            },
            {
              "text": "私たちの心にこのルカンノンの憧れの心がないといえるだろうか。",
              "citation": {
                "source": "山の彼方は",
                "author": "――常識とはどういうものだろう――",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
