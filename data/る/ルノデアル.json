        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ問題ハ活字ト関係ガナサソウデアルガ、原稿ヲ書ク場合ニ関係ガ生ジテクルノデアル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "寧ロ世界的ノ流行、否、風習トナリツヽアルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "換言スレバ、諸君ハ知ラズ識ラズコヽニ永代不滅ノ資産ヲ確立スルコトヽナルノデアル。",
              "citation": {
                "source": "泉",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレ以上ノ具体的ノ事ハ釈放時ノ事情ニヨッテ決スルノデアルカラ今カラ何トモ言ヘナイ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤モアノ若サデアノ大役ヲスルノデアルカラ無理モナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ颯子ガ不自然ナ方法デ生マナイヨウニシテルノデハナイカ、ドウモソウラシイト云ウ疑イヲ、婆サンハ抱イテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ御苦労ナコトダガ、春久ガ御祭ヲ撮影スルノダト云ッテ昨日カラ行ッテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "但シ入浴ノ助手ハ、婆サンハ転ンデカラ以後勤メナイノデ、颯子カ女中ガ勤メルノデアルガ、佐々木ノヨウニ上手ニ親切ニハ助ケテクレナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "春久ダカラワザ／＼断ル必要ヲ感ジテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人ハ二階デ「涼ンデ」イルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "服ガ籠ニ捨テヽアル以上、彼ハシャワーヲ浴ビテカラ浴衣ニ着カエテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（二日以来、予ハ彼女トタッタ二人差向イデ食事スルコトガ出来ルノデアル）六時、佐々木ガ庭ノ散歩ヲ促シニ来ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ、婆サント連レ立ッテ這入ッテ来タノハ何カ仔細ガアルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ダカラコリーハ止メルヨウニオ爺チャンカラ仰ッシャッテヨ、アタシモソレトナク云ウンダケレド、アタシガ云ッタンジャ颯子ハ聴イテクレナインデスカラト、婆サンハ訴エルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "明日午前中ニハ戻ルノデアルガ、生憎明日ハ日曜デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "当人ダケガ耐エ難クツメタク感ジルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ拓本ニモトヅイテ彼女ノ足ノ佛足石ヲ作ルノデアルコト、予ガ死ンデカラ骨ヲソノ石ノ下ニ埋メテ貰ウノデアルコト、ヲ知ッタ時ニモ、彼女ハ格別ノ意見ヲ述ベハシナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "元来僕ハ嫉妬ヲ感ジルトアノ方ノ衝動ガ起ルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "目下ノトコロ好事ノ士ガ稀ニ用イルノミデ一般ニ普及シテイナイガ、普通ノ手札型ノロールフィルムニ印画紙ガ重ネテアルモノデ、容易ニ日本デハ手ニ入ラズ、一々アメリカカラ取リ寄セルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "トスルト、何ノ目的デサヨウナヲ分ラセテイルノデアルトシテモ、ソレハ、「私ハセメテ相手ヲアナタト思イタクナイノデス、木村サンダト思イタイノデス、ソウシナケレバ感興ガ湧イテ来ナイノダカラ、結局ハソレガアナタノタメデモアリマス」トイウ意味ナノカ、「コレモヤハリアナタヲ嫉妬サセテ刺戟ヲ与エル手段ナノデス。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "モシソウナラバソレハ誤リデ、僕ハ彼女ラヲ同等ニ愛シテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "（コレハ相馬氏ニハ内証デ、自分デ施シテイルノデアル）シカシ自分ガ珍シクモカヨウニ旺盛ナ状態ヲ維持シ得テイルノハ、恐ラク薬剤ノ利キメヨリモ主トシテ精神的興奮ノシカラシメルトコロデアルニ違イナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "嫉妬ガ醸ス激シイ情熱、妻ノ全裸体ヲ思ウ存分見ルノナカッタ法悦境ニ浸リツツアルノヲ思ッテ、自分ノ幸福ヲ感謝シナイデハイラレナイガ、同時ニマタ、コンナ幸福ガイツマデツヅクハズハナイ、イツカハ報復ガ来ルノデアル、自分ハ刻々ニ命ヲ削リツツアルノデアル、トイウ豫感モシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "眩暈ナラ大概二三分間デ平常ニ復スルノダガ、イツマデタッテモ物ガ二重ニ見エルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "洋服ヲ着タヲシテイルノデアルカ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "覗イテミルト妻ガ洋服ヲ着セテ貰ッテイルノデアル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
