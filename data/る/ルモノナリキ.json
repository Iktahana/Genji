          "literary": [
            {
              "text": "貴族政治ヲ覆滅シタル維新革命ハ徹底的ニ遂行セラレテ貴族ノ領地ヲモ解決シタルコト、當時ノ一佛國ヲ例外トシタル歐洲ノ各國ガ依然中世的領土ヲ處分スル能ハザリシヨリモ百歩ヲ進メタルモノナリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レドモ、コレ等ノ小農夫及小商人ハ、皆天ヲ敬シ、人ヲ愛スルコトヲ知ルモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ハ教育アリ、訓練アリ、特ニ自治ノ能力ニ於テハ優レタル天分素質ヲ有セルモノナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
