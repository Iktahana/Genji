        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "そんな荒寥とした曠野の中に、五階七階のビルヂングがそびえ立つて、悲しい田舍の花火のやうに、赤や青やのネオンサインが點つて居る。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "新宿の數多いビルヂングは、何かの張子細工のやうに見えるし、アスハルトの街路の上を無限に續く肥料車が行列して居る。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "あのビルヂングの林立する新宿の町々に、かうした多くの人物が生棲してゐることを考へ、都會の隅々に吹きめぐる秋風の蕭條といふ響を聞いた。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかもガードを一つ距てて、淀橋の向ふに二幸や三越のビルヂングが壘立し、空には青い廣告風船があがつて居る。",
              "citation": {
                "source": "悲しい新宿",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "父親は、どこか下町のビルヂングに支店を出すことに熱意を持ちながら、小鳥を飼うのを道楽にしていた。",
              "citation": {
                "source": "鮨",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "市民は高層なビルヂングの近景を、いつもの通り右往左往してゐた、豆のやうに、紅や青や紫や、パラソルの花、花、花、自動車は疾駆した、旋廻した、昆虫の騒乱。",
              "citation": {
                "source": "第二海豹と雲",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "我曲亭、種彦などに此流義ありて、外國にては、中古の物語類はいふも更なり、スモオレツト、フイヽルヂングなど此派に屬し、スコツト、ヂツケンスといへども間々これに近し。",
              "citation": {
                "source": "柵草紙の山房論文",
                "author": "森鴎外",
                "note": "青空文庫"
              }
            },
            {
              "text": "あの市長は一個の煉瓦に至るまで恭々しく自らの手で焼き、一つ一つ自分で積みあげて、塔を建て、ビルヂングを建てゝゐる目醒しい努力家だ。",
              "citation": {
                "source": "花束一つ",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "「うむ、あれはパーマーシップビルヂングの社員が二人と、マーカンテイル・マリン・コンパニーが一人だ。",
              "citation": {
                "source": "上海",
                "author": "横光利一",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「よろしい――」　行先きのビルヂングに着く。",
              "citation": {
                "source": "出発",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "………………　私はビルヂングの窓から月を仰いだ。",
              "citation": {
                "source": "ビルヂングと月",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "階段の突き当りに四角な窓があつて、其処からはビルヂングの尖頭が見えてゐる。",
              "citation": {
                "source": "階段",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "強弱々、強弱々――と、いとも原始的な淋漓たる韻を踏んで鳴り出すバルヂンの音響に打たれると（歌詞は私より他に知る者とてもなかつたが――。",
              "citation": {
                "source": "酒盗人",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ビルヂング街にある博士の診療所へ、此方の仕事の合間を見計らつては通つてゐる。",
              "citation": {
                "source": "風媒結婚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "失敬――」「このビルヂングの下にだつて、床屋がありますから一寸行つていらつしやいよ、案内してあげますわ。",
              "citation": {
                "source": "変装綺譚",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "大きなビルヂングの地下室にある酒場で、辛うじて窓から首を出して空を仰ぐと、黒い建物と建物に挟まれた細い空が、青い巨大な帯のやうに望まれた。",
              "citation": {
                "source": "Ｒ漁場と都の酒場で",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "三　街の両側には、（鳥が空中に建てた都）のやうな空高いビルヂングが無限に延び拡がつてゐた。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "鳥が建てたかのやうに空中遥かまで延びてゐるビルヂングも夢で、それは切りに吹き寄せて来る噴水の水煙りを仰いだ水夫の思ひ違ひだつた。",
              "citation": {
                "source": "山彦の街",
                "author": "牧野信一",
                "note": "青空文庫"
              }
            },
            {
              "text": "下駄の音がガーンと響く空洞の胎内は、鐵筋コンクリートのビルヂング式になつて、階段を上ると、大佛さんの頤の内側のところに、きらびやかな黄金色の佛像が安置してあつた。",
              "citation": {
                "source": "滑川畔にて",
                "author": "嘉村礒多",
                "note": "青空文庫"
              }
            },
            {
              "text": "天井は急に高くなって、ビルヂングの床を三階分もぶちぬいたような高さであった。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ビルヂングであろうが、岡であろうが、山であろうが、ぶっかいて行きますよ。",
              "citation": {
                "source": "火星兵団",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "武ちやんはいま東京驛前の大きなビルヂングに事務所をおいて、立派な建築技師になつてゐます。",
              "citation": {
                "source": "金比羅參り",
                "author": "若山牧水",
                "note": "青空文庫"
              }
            },
            {
              "text": "尤も、都市の大建物で、拝金宗の権化ならざるものは尠なく、ニユーヨークのウールウオース・ビルヂングの案内書に、商業寺院 Church of Commerce として紹介されてあるのは、さすがにヤンキーだけあつて、言ふことが徹底的である。",
              "citation": {
                "source": "名古屋スケツチ",
                "author": "小酒井不木",
                "note": "青空文庫"
              }
            },
            {
              "text": "私が、骨組み許りのビルヂングの作業場の前を通りかゝると、其處には今しがた何か異變でもあつたと見えて、夥しい人間が集まつて急しく動作してゐた。",
              "citation": {
                "source": "梁上の足",
                "author": "若杉鳥子",
                "note": "青空文庫"
              }
            },
            {
              "text": "群衆は、殘照に彩られたビルヂングを見上げながら、屍體の引き下ろされるのを待つてゐた。",
              "citation": {
                "source": "梁上の足",
                "author": "若杉鳥子",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵骨ばかりのビルヂングの下で二人の男が上を見上げながら話してゐた。",
              "citation": {
                "source": "梁上の足",
                "author": "若杉鳥子",
                "note": "青空文庫"
              }
            },
            {
              "text": "今に今にあの足は、ビルヂングの鐵骨の上から立ち上つて、何千何萬何億もの足と一緒に、全世界の軍隊よりも歩調を合せて、一つの行進曲を奏するだろう。",
              "citation": {
                "source": "梁上の足",
                "author": "若杉鳥子",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時窓のムウルヂングの上に蹲つてゐた猿は、何か旨い物を貰はれさうなものだと思つて待つてゐるらしかつた。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "そして窓のムウルヂングの上に蹲つて、己達の方を見て満足らしい表情をした。",
              "citation": {
                "source": "猿",
                "author": "AFFENPSYCHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "近ごろでは仕掛け花火を主にするやうだが、河畔に集る人にはそれでよいが、全市を飾る、兩國の川開きなら、何處のビルヂングの窓からでも眺められる、遠景をおもんばかつた、とても雄大な火傘が、つるべ打ちにうちあげられて、空を飾るのが近代都市美の上からいつても本當だと思ふ。",
              "citation": {
                "source": "花火と大川端",
                "author": "長谷川時雨",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
