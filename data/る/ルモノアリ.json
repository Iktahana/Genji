        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "忽然茂ヨリ走リ出デ九郎右衛門ニ向カッテ跳躍スルモノアリ。",
              "citation": {
                "source": "赤格子九郎右衛門",
                "author": "国枝史郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "真ニ二千年来ノ一人――」　二千年来ノ一人……というところにばかに調子を振込んで道庵が力み返り、「中古ニ隠士｜徳本ナルモノアリ、甲斐ノ人也――」　そこで案を一つ打って、すまし返りました。",
              "citation": {
                "source": "大菩薩峠",
                "author": "めいろの巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ弟妹ニ学資ヲ与フルモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "或ハ淫肆放縦ニシテ獲ル所ノモノハ直ニ濫費シテ惜シマザルモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ニ於テヤ酒楼ノ情況宛然妓院ニ似タルモノアリ。",
              "citation": {
                "source": "申訳",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツバキを賞讃して八千代椿と称える訳は支那に『荘子』という書物があってその書中に「大椿ナルモノアリ八千歳ヲ春トナシ八千歳ヲ秋トナス」（原と漢文）の語がある。",
              "citation": {
                "source": "植物記",
                "author": "牧野富太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ三条ノ内何レノ一条カ文殊岩ノ乳ヨリ滴ルモノアリ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "古来往々突尋スルモノ得テ見ルモノアリ、得テ見ザルモノアリ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "三渓ノ内源ヲ文殊岩ニ発スルモノアリトイフ。",
              "citation": {
                "source": "利根川水源地の山々",
                "author": "木暮理太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕コウ見エテモ必ズシモ木石漢ニ非ズ、芳子ノコトナド思イ出シテ感慨無量ナルモノアリ、唯何処マデモソウ云ウ感情ヲ後ニ残シテ斯波ノ家ヲ去ラナケレバナラナクナッタアナタノ不仕合ワセヲ歎クノミデス。",
              "citation": {
                "source": "蓼喰う虫",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
