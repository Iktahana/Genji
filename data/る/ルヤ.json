        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "大岡、アベ六郎、スルヤの連中、河上、村井、小林。",
              "citation": {
                "source": "我が生活",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "牧士ナドニ反抗サレルヤウデハ奉行ノ威徳ガナイノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "知ルヤ、君、断食ノ苦シキトキニハ、カノ偽善者ノ如ク悲シキ面容ヲスナ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "キミノ仕事ノコルヤ、ワレノ仕事ノコルヤ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハレルヤ、ハレルヤ」前からもうしろからも声が起こりました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ハレルヤ、ハレルヤ」明るくたのしくみんなの声はひびき、みんなはそのそらの遠くから、つめたいそらの遠くから、すきとおったなんとも言えずさわやかなラッパの声をききました。",
              "citation": {
                "source": "銀河鉄道の夜",
                "author": "宮沢賢治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤマデハ　ヤマキチ　ノ　ナカヨシ　ノ　イロイロ　ノ、トリ　ヤ　ケモノ　ガ、ヤマキチ　ノ　カエリ　ヲ、タイソウ　ヨロコビマシテ、ウタ　ヲ　ウタウヤラ、オドリ　ヲ　オドルヤラシテ　カンゲイ　シマシタ。",
              "citation": {
                "source": "山のコドモ",
                "author": "岡本かの子",
                "note": "青空文庫"
              }
            },
            {
              "text": "神ハ実在スルヤ否ヤ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハレルヤ、ハレルヤ。",
              "citation": {
                "source": "年とったカシワの木のさいごの夢",
                "author": "ハンス・クリスチャン・アンデルセン　Hans Christian Andersen",
                "note": "青空文庫"
              }
            },
            {
              "text": "四十一年八月　　入日の壁黄に潤る港の入日、切支丹邪宗の寺の入口の暗めるほとり、色古りし煉瓦の壁に射かへせば、静かに起る日の祈祷、『ハレルヤ』と、奥にはにほふ讃頌の幽けき夢路。",
              "citation": {
                "source": "邪宗門",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "ありがたや、ハレルヤとぞ涙ながして讃め祷りませば、雀もともに、ハレルヤ、ハレルヤと眼を上げ涙ながして御空を仰ぐ。",
              "citation": {
                "source": "雀の卵",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランチエスコは御空を仰ぎて、主よ、主の奴僕はかくありぬ、かく貧しきが故にこそ世のあらゆるもろもろの御宝をも却つて主のごとく、この身ひとつに保ちまつる、ありがたやハレルヤとぞ、涙ながして讃め祷りませば、雀もともに、ハレルヤ、ハレルヤと、眼を上げ涙ながして御空を仰ぐ。",
              "citation": {
                "source": "観相の秋",
                "author": "北原白秋",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ケキヨ、ヨ　ケキヨ、ヨ」　チヨウド、ソレハ　ナキジヤクリシテ　ヰルヤウニ　カナシイ　オトデシタ。",
              "citation": {
                "source": "ウグヒスブエヲ　フケバ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "小サナ　小サナ　スキトホルヤウナ　デンデン蟲デシタ。",
              "citation": {
                "source": "デンデンムシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ　ヲトコノ　ヒトハ、ナニカ　ヒトノ　ビツクリスルヤウナ　コトヲ　シテ　エラク　ナリタイト　カンガヘテ　ヲリマシタ。",
              "citation": {
                "source": "ヒロツタ　ラツパ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ミチコサンハ、マダ　アカチヤンヲ　ダツコシテルヤウナ　テツキヲ　シテ　オウチヘ　カヘツテ　キマシタ。",
              "citation": {
                "source": "ミチコサン",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガチヨウノ　タンジヨウビ新美南吉　アル　オヒヤクシヨウヤノ　ウラニハニ　アヒルヤ、ガチヨウヤ、モルモツトヤ、ウサギヤ、イタチナドガ　スンデ　ヲリマシタ。",
              "citation": {
                "source": "ガチヨウノ　タンジヨウビ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "が、顔は、印度アールヤン族の正系ともいう、どう見ても、サンブルプールあたりからのダイヤモンド鉱夫ではない。",
              "citation": {
                "source": "一週一夜物語",
                "author": "小栗虫太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "大修行底ノヒト、因果ニ落チルヤ、マタナキヤ。",
              "citation": {
                "source": "野狐",
                "author": "田中英光",
                "note": "青空文庫"
              }
            },
            {
              "text": "而モ革命佛蘭西ガ「コルシカ」ヲ佛蘭西ノ本國ト平等ナラシメ「コルシカ」島民ヲ佛蘭西人ノ自由ニ開放スルヤ、獨立黨ノ青年士官ハ佛蘭西ニ對スル愛國心ヲ「エルバ」島ニ葬ルマデ變ゼザリキ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "獨逸ノ敗因實ニ其ノ始メニ於テ背後ニ迫レル露軍ノ爲メニ巴里占領ノ好機ヲ逸シ、更ニ英國艦隊全部ヲ本國ニ集中セシメタルガ爲メニ一擧根本ヲ屠ル能ハザルノミナラズ、却テ其ノ艦隊ヲ「キール」軍港ニ封鎖セラレテ國内物質ノ空乏ヲ來シ僅カニ潛航艇戰ノ窮策ニ訴フルヤ、又却テ米國ヲ脅威シテ之ヲ敵ニ驅リシニ基ク。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ人ニ接スルヤ温乎玉ノ如ク、子弟ヲ薫陶スルヤ極メテ厳正ニ、老ニ到ツテ懈ラズ。",
              "citation": {
                "source": "梅津只圓翁伝",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
