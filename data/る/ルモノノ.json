        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "他ハ日本人ナルカト思イタレドモ、後ニ至リテ彼等ハ日本人ニハ非ザルモノノ如キコト判明セリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "其ノ一団ハ何ヲナセルヤ」相手「予ノ今日マデノ観察ニヨレバ、明カニ軍事的施設ヲ作リツツアルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "前後ノ事情ヨリ推察スルニ怪施設ハ大部分完備ニ向イタルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "駒井ノ家ノ系統ヲタヅヌルニ、清和源氏ニ出ヅルモノノ如シ――然レドモ――彼ノ女ニ対スル余ノ愛ガ彼ノ女ヲ殺シ、彼ノ女ノ愛ガマタ余ノ生涯ヲ一変セシメタリトヤイハム。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "金椎ノ談ニヨレバ、救世主ハ大工ノ子ニシテ――耶蘇ノ教フルトコロニヨレバ、娼婦、税吏、異邦人、姦淫セル女等ガ却ツテ、驕慢ナル権者、偽者ナル智者、学者ヨリ光栄アル壇上ニ置カルルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "脱島セントシテ種種手段ヲ講ジ居ルモノノ如シ」等々。",
              "citation": {
                "source": "フランス伯Ｎ・Ｂ",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
