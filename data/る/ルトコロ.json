        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "……曰く……　――余ノ調査研究セルトコロニ依レバ、既ニ往昔ヨリコノ種ノ犯罪ガ行ワレツツアリシ事実ヲ認ムルヲ得ベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガカタカナノ場合ハソノ成立ノ歴史カライツテモ楷書ノ漢字ノ一部分ヲチヨツト失敬シタマデデアルカラ、コレガ楷書ノ字ト一緒ニ並ンデイルトコロハアタカモ親ト子ガ並ンデイルクライヨク調和スル。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "諸藩支配ノ地コトゴトク之ヲ朝廷ニ収メ、奥羽寒冷ノ地ノ民ヲ移シテ、空隙ノ地ニミタスベシ、今、朝廷数十万が財ヲステ、開拓ノ資ニ供スルモ、得ルトコロ失フトコロヲ償ハズ。",
              "citation": {
                "source": "石狩川",
                "author": "本庄陸男",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカルトコロニ、イツマデモイルベカラズ。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "カカルトコロニイルベカラズ云々というあの拙い文章の脅迫状ね。",
              "citation": {
                "source": "殺人鬼",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ニカイノ　アルトコロコノヨコチョウデス。",
              "citation": {
                "source": "新版　放浪記",
                "author": "林芙美子",
                "note": "青空文庫"
              }
            },
            {
              "text": "其時ハ何処ノ国籍ニ属スルヤ全ク不明ナリシガ只今マデ数日間観察セルトコロニヨレバ○国人ナルモノノ如シ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ其ノ小窓ヨリ窓外ヲ見タルトコロ傾斜セル山腹ガ截リトラレアルヲ見タリ。",
              "citation": {
                "source": "壊れたバリコン",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "全世界人ヘノ警告文　余スナワチ金博士は、今度ヒソカニ感ズルトコロアリテ、永年ニ亘ル秘密ノ一部ヲ告白スルト共ニ、之ニサシサワリアル向ニ対シ警告ヲ発スル次第ナリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "その次に曰く、三、丈が二尺グライノ花瓶、口ニ拇指ヲ置キテ指ヲ中ニサシ入レテ花瓶ノ内側ヲサグリ、中指ガアタルトコロニ、小サク５０９８ト墨書シアリ。",
              "citation": {
                "source": "時限爆弾奇譚",
                "author": "――金博士シリーズ・８――",
                "note": "青空文庫"
              }
            },
            {
              "text": "然ルニ、本願ト同様ナル着想ハ、本願出願以前ニ、帝国領土内ニ於テ存在シ、且｜遍ク知ラレタルトコロニシテ、例エバ奈良唐招提寺金堂ニ保管セラレアル千手観音立像ハ、四十臂ヲ有ス。",
              "citation": {
                "source": "特許多腕人間方式",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "……あだねつき染め木が汁に染め　衣を……（シムルトコロノ衣シメタル衣）上つ毛野いかほの沼に栽ゑ　小水葱……（ウヽルトコロノ小水葱ウヱタル小水葱）右の例における接続点は、前代の文法及び、其形式を襲ふものでは問題にならないが、やはり次第に、整頓せられて来る。",
              "citation": {
                "source": "形容詞の論",
                "author": "――語尾「し」の発生――",
                "note": "青空文庫"
              }
            },
            {
              "text": "金椎ノ談ニヨレバ、救世主ハ大工ノ子ニシテ――耶蘇ノ教フルトコロニヨレバ、娼婦、税吏、異邦人、姦淫セル女等ガ却ツテ、驕慢ナル権者、偽者ナル智者、学者ヨリ光栄アル壇上ニ置カルルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "無明の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コレ等ノ信神渡航者ハ一人モ往復ノ旅券ヲ求ムルモノナシ、彼等ハ他ノ旅客ノ如ク往ケバ必ズ帰リ来ルモノト予定スルコトヲセザルナリ、到リ着クトコロヲ以テ、ソノ骨ヲ埋ムルトコロト為ス。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼等ノ欲スルトコロハ領土ニアラズ、物資ニアラズ、己レノ良心ト信仰トノ活路ヲ見出サンガタメニ新天地ニ出デタルモノ也。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "閤竜ノ求ムルトコロハ領土ナリキ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "京の夢おう坂の夢の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ノ観ルトコロデハ、実際、彼等ハ愉快サウデアル。",
              "citation": {
                "source": "双面神",
                "author": "岸田國士",
                "note": "青空文庫"
              }
            },
            {
              "text": "ザウサン　サルサン村山籌子　アルトコロニ　タイヘン　オギヤウギノヨイ　ザウサンガアリマシタ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人山崎久卿モマタ斯ニ見ルトコロアリ博ク江戸ノ詩ヲ採リ、命ジテ『江都名家詩選』トイフ。",
              "citation": {
                "source": "下谷叢話",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "水ガ口ヨリ鼻腔ニ及ビ、完全ニ窒息スルトコロニテ止ム。",
              "citation": {
                "source": "ノア",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ図ラズモ予ノ希望ハ叶エラレタガ、首尾ヨク同衾シ、事ヲ行ウニ至ッテモ、普通ノ藝妓ト普通ノ方法デ行ッテイルノト異ルトコロハナカッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ代リ、全クソンナ資格ノナイ老人デアルコトヲ自分ミズカラモ認メテイルニ違イナイト、ソウ思ッテ世間ガ安心シテイルトコロガ附ケ目デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一年前ノ出来事ガマルデ新シイ事実ノヨウニ感ゼラレ、興味津々盡キルトコロヲ知ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ爺チャン、マダオ休ミニナラナインデスカ」「今寝ルトコロダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今浴ビテルトコロナノ、チョウドオ晝寝ノ時分ダト思ッテ覗イテ見タノ」「今日ハ日曜ダッタッケナ、浄吉ハイナイノカ」ソレニハ答エナイデ別ナコトヲ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様ナ場合、浴衣ヲ借リルクライハイヽガ、階下ノ客間ナリ応接間ナリ茶ノ間ナリ、今ハ婆サンモ留守デアルカラ至ルトコロガ空イテイルノニ、二階ヘ上ルニハ及ブマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今朝カラ又牽引ヲ始メルトコロデアッタガ、結局利キ目ガナイノデ中止ト決定。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「来テハイケナイッテ仰ッシャッタケレド、浄吉ガ行ケッテ云ウカラ来タワ」「浄吉ハドウシタンダ」「今又何処カヘ出テッタワ、チョット飲ンデ来ルッテ」「浄吉ガコヽヘ君ヲ連レテ来テ、僕ノ眼ノ前デ君ニ命令スルトコロヲ見タイト思ッタンダガナ」「命令ナンカ出来ヤシナイワ、工合ガ悪イカラ逃ゲチャッタノヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「イヤ、ソコガアノ方ノ偉イトコロデスヨ、麻酔ドクターマデ呼ンデ十分ノ用意ヲシテカヽッタンダカラ、誰デモヤッテシマイタクナルトコロダガ、僅カ一滴ノ血ヲ見タヾケデモ大事ヲ取ッテ中止スルト云ウコトハ、ナカ／＼出来憎イコトデス。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
