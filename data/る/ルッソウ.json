          "literary": [
            {
              "text": "構図はゴーガンさんだし、日本の浮世絵なんぞグルッと描きこんだりしたのは、言わば、まあ、アンリ・ルッソウじゃなくって？",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "スーラだとかセザンヌだとかマネエだとかピッサロは幸福な気ちがい、なかんずく、われらが税関吏アンリ・ルッソウは幸福なる気ちがいの最たるものだ。",
              "citation": {
                "source": "炎の人――ゴッホ小伝――",
                "author": "三好十郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "一つルッソウの真似をして、自然に帰れとでも皆の前でいってみるかな」と感慨深そうにいっておられた。",
              "citation": {
                "source": "先生を囲る話",
                "author": "中谷宇吉郎",
                "note": "青空文庫"
              }
            }
          ]
        }
