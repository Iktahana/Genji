          "literary": [
            {
              "text": "島々へ入るすこし手前で、ルックサックからスカートを出して、ブルーマースの上からはいていたりしたが、如何にも山を下りて里へ出る有様をあらわして、私は思わず微笑した。",
              "citation": {
                "source": "可愛い山",
                "author": "石川欣一",
                "note": "青空文庫"
              }
            },
            {
              "text": "幸子ちゃんのでなくても、雪子ちゃんのでもこいさんのでも、下着類なら何に依らず、ブルーマーなんかでも戴きます。",
              "citation": {
                "source": "細雪",
                "author": "下巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "更に信ずるばかりでなく、この町には魔法使が沢山いるというルーマーがとびました。",
              "citation": {
                "source": "涙をもつて正義をささえる",
                "author": "金森徳次郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "魔法使だというルーマーは根本的に間違つているというのであります。",
              "citation": {
                "source": "涙をもつて正義をささえる",
                "author": "金森徳次郎",
                "note": "青空文庫"
              }
            }
          ]
        }
