        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ソノ心シテ諸準備御急ギ召サルベク安藤対馬シカト命ジ置キ候」　筆をおくと凛として言った。",
              "citation": {
                "source": "老中の眼鏡",
                "author": "佐々木味津三",
                "note": "青空文庫"
              }
            },
            {
              "text": "三坪ノ邸宅ニ甘スル者アルベク數拾萬圓ノ高樓ヲ建ツルモノアルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "一貫シタル十年間ノ教育ハ、其ノ終了ト同時ニ完全具足シタル男女タルベク、更ニ其ノ基本ヲ以テ各其ノ使命的啓發ニ向ツテ進ムヲ得ベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "女子ニ禮式作用ガ必須課目ナラバ男子ニモ男子ノ其レガ然ルベク、茶ノ湯生花ガ然ルナラバ男子ニ謠曲ヲ課セザレバ不可。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "約十年ト云ヒ約二十年ト云フ年限ヲ豫定シタルハ、過去ノ專制政府等ガ民權運動ニ讓歩スルトキ成ルベク長ク專制ヲ維持セント欲スル期間ノ留保ニ非ズ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "特ニ其ノ兵質ガ、前註説明ノ如ク今ノ少尉級ニ匹敵スベキヲ以テ自ラ現役年限ノ短縮トナルベク、一年又ハ一年半ノ軍隊的軍艦的訓練ハ如何ナル專門的使命アル者モ身心ノ根源ヲ培養シテ其ノ使命ノ大成ヲ準備セシムル者ナリ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "然レバ将来、精神科学ノ諸般ノ学理ガ、一般ノ常識トシテ普及スルニ到ラムカ、同様ニコレヲ応用セル犯罪ガ、旺盛ナル流行ヲ示スベキハ論ヲ俟タザルベク、而シテソノ犯行ノ恐怖、戦慄ニ値スベキ事、現代ノ所謂、唯物科学応用ノ犯罪ノ比ニ非ザルベキモ亦自明ノ理ナルベシ。",
              "citation": {
                "source": "ドグラ・マグラ",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「――ワガ恐竜第六十戦隊ハ、コレヨリ敵艦隊ノユダンニツケイリ、ナルベク早ク所期ノ目的ヲハタシタ上デ、全艦海底要塞ヘヒキアゲント欲ス。",
              "citation": {
                "source": "太平洋魔城",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "談話者又報告者ノ言葉モナルベク保存シ、話ノ順序、ノ混雜シタノヤ不得要領ナノモ故意ニ其儘ニシテ置イタ、サウシタ方ガ史料トシテノ價値ヲ損ジナイト思フカラデアル。",
              "citation": {
                "source": "寺田先生と僕",
                "author": "海野十三（佐野昌一）",
                "note": "青空文庫"
              }
            },
            {
              "text": "美川君も、時々ロンドンへ行く事もあるとかだから、ナルベク、日本人クラブ宛に出して置く方が安全だ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルベクスキナモノを買って帰るよ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "セッカク、フランス迄ハルバル来たんだから、スキな景色はナルベク描いて置き度いと思って勉強しているよ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "キレ類も面白いものはナルベク買って帰るつもりだ。",
              "citation": {
                "source": "大切な雰囲気",
                "author": "大切な雰囲気",
                "note": "青空文庫"
              }
            },
            {
              "text": "クルベクなどは、我々には遠くなつて居るが、器物や地理の名にあるから、なる程と思はれる。",
              "citation": {
                "source": "言語の用語例の推移",
                "author": "折口信夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "平民自身モマタ奴隷タルベクコノ世ニ生レ出デタルモノニシテ、人格ト権利ヲ没却セラレテモ、之ヲ甘ンジテ屈従スルモノノ如シ。",
              "citation": {
                "source": "大菩薩峠",
                "author": "流転の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナゼトイツテ、モンコチヤンハマダ九ツデ、イタツテ小サイ子ダツタシ、ボンコチヤンハナルベク、セイノタカイ人ノアタマニノツカリタカツタカラデス。",
              "citation": {
                "source": "バウシ　ノ　ユクヘ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルベク今ノ程度ニハ太ッテイテ貰イタイナ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "多分ソノタメニ和服ヲ着、ソレヲ見セルベク予ノ面前ニ現ワレタノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナルベク安静ニト云ウノデ、寝室ニ横臥シタキリデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "堅イツル／＼シタ板ノ上ニ臥カサレテイロ／＼ノ形ニ体ヲ彎曲サセルベク命ゼラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウシテ線条ガ鮮明ニナリ過ギヌヨウニ、ナルベク朦朧ト表現サレルヨウニスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼女ハナルベク木村ト二人キリニナル機会ヲ作ラヌヨウニシ、イツモホトンド郁子ト三人デ茶ノ間デ話シ、映画ヲ見ルニモ必ズ母ヲ誘ッテ出カケル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "散歩ニ出テモアマリ多クヲ歩カヌヨウニシ、ナルベク人通リノ少イ所、百万遍、黒谷、永観堂辺ニ杖ヲ曳イテ、主ニベンチデ休憩シテ時間ヲツブス※ニシテイル。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソノ分ニ候ヘバ、侍ノ冥加アリテ、長久タルベク候。",
              "citation": {
                "source": "新書太閤記",
                "author": "第五分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "是ヲ我ガ四国衆ノ、鎧毛モ切レ腐リテ、麻糸ヲ以テツヅリシヲ着シ、腰小旗ヲ横ニ、柄長柄短カノ不揃ヒナル駆ケ草鞋ノ軍勢ト見較ベンニハ、可笑キバカリ、事違ヒテ、上方勢トハ似ルベクモナシ。",
              "citation": {
                "source": "新書太閤記",
                "author": "第十一分冊",
                "note": "青空文庫"
              }
            },
            {
              "text": "憚リナガラ正月中七日マデノ間、五条｜橋畔マデ、御返答高札下サルベク候　　　　　月　　　日新免宮本武蔵政名「すぐ帰る」　清十郎は文殻をたもとへ突っ込むとそういって立ち上がった。",
              "citation": {
                "source": "宮本武蔵",
                "author": "火の巻",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
