        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "その世間の定評では、プラトンや、ブルノーや、ニイチェや、ショーペンハウエルや、老子や、荘子や、ベルグソンやが、一般に詩人哲学者と呼ばれている。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "例えば耶蘇やマホメットのような宗教家、コロンブスやマルコ・ポーロのような旅行家、ソクラテスやブルノーのような情熱哲学者、孔子や老子のような人間思想家、吉田｜松陰や雲井｜龍雄のような志士革命家を指すのである。",
              "citation": {
                "source": "詩の原理",
                "author": "萩原朔太郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "蚤ガ群ッテ集マルノデ眠ルノハ少シムツカシイ。",
              "citation": {
                "source": "小泉八雲の家庭生活",
                "author": "室生犀星と佐藤春夫の二詩友を偲びつつ",
                "note": "青空文庫"
              }
            },
            {
              "text": "「アラ、来週はメーベルノーマンドの写真なのね、あたし今度は一人で来るわ」　予告のビラが横手の壁にあつたのをみて、Ｓ子はさういつた。",
              "citation": {
                "source": "分らないもの",
                "author": "中原中也",
                "note": "青空文庫"
              }
            },
            {
              "text": "千代紙｜貼リマゼ、キレイナ小箱、コレ、何スルノ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "花火一パツ、千円以上、ワザワザ川デ打チアゲテ何スルノ？",
              "citation": {
                "source": "走ラヌ名馬",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレラノ行為ハ、我輩ノ能力ノハルカ、カナタニ横タワッテイルノデアル。",
              "citation": {
                "source": "パンドラの匣",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "親ニモ同胞ニモワカレテ仕ヘテヰルノデス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤツレルノハ、女性ノ苦悩デス。",
              "citation": {
                "source": "右大臣実朝",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "それかと言ってルノアルふうの風景小品にもルノアルの甘みは出ていない。",
              "citation": {
                "source": "昭和二年の二科会と美術院",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "その時までに見た中村氏の絵を頭においていた自分は、話のついでに「ルノアルがお好きですか」と聞いてみた。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうしたら、「ルノアルも好きだが、レンブラントが一番面白いようです」と言われたようであった。",
              "citation": {
                "source": "中村彝氏の追憶",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "この人の絵は、どこかしらルノアルとモネエと両方を想い出させるようなところのある絵だと思う。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアルなどは、ちょっと見ると気楽に描いているようだが、また恐ろしく神経を使っているようにも思われるのだが、横井氏のはそれともちがう。",
              "citation": {
                "source": "二科会展覧会雑感",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "壁にはルノアールの偽もの蜿蜒の画がかかっていた。",
              "citation": {
                "source": "飛行機から墜ちるまで",
                "author": "吉行エイスケ",
                "note": "青空文庫"
              }
            },
            {
              "text": "貧苦オススメシテイルノデハナイ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "」　カツテ私ハ、愛ノ哲人、ヘエゲルノ子デアッタ。",
              "citation": {
                "source": "創生記",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年研究して自信のついたころ、やはりおなじ師命をうけてペッケンにおもむくトオマス・テトルノンという人と、めいめいカレイ一隻ずつに乗りつれ、東へ進んだ。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "トオマス・テトルノンは、すぐシロオテと別れてペッケンへむかったが、シロオテはひとりいのこって、くさぐさの準備をととのえた。",
              "citation": {
                "source": "地球図",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の医者の子であったが、若い頃フランスに渡り、ルノアルという巨匠に師事して洋画を学び、帰朝して日本の画壇に於いて、かなりの地位を得る事が出来た。",
              "citation": {
                "source": "花火",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマハ山中、イマハ浜、イマハ鉄橋、ワタルゾト思ウ間モナクトンネルノ、闇ヲトオッテ広野ハラ、どんどん過ぎて、ああ、過ぎて行く。",
              "citation": {
                "source": "鴎",
                "author": "――ひそひそ聞える。なんだか聞える。",
                "note": "青空文庫"
              }
            },
            {
              "text": "いいドレスが手にはいったものですから、ひとつ、ルノアルのリイズのようなポオズをさせてみたいと思っているのです。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "あれはね、ルノアルの二十七八歳頃の傑作なのですよ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルノアル自身のエポックを劃したとも言われているんです。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕だって、もう二十八歳ですからね、ひとつ、ルノアルと戦ってみようと思っているんですよ。",
              "citation": {
                "source": "リイズ",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ酔ひの勇気がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヲドリノ　スキナ　オヂイサンスグニ　トビダシ　ヲドツタラコブガ　フラフラ　ユレルノデトテモ　ヲカシイ　オモシロイ　お爺さんには、ほろ醉ひの勇氣がある。",
              "citation": {
                "source": "お伽草紙",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "莫大ナル出兵費ハ誰カラ出ルカ、諸君ガ一本ノ煙草ヲ喫ンデモ、半斤ノ砂糖ヲ使ッテモ、一足ノサル又ヲ買ッテモ、必ズ間接ニ徴収セラレル税金カラ出テイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
