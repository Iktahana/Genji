        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「カナヅチハ　クツモ　ツクルンダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」ト　フエフキガ　ヒトリゴトヲ　イフト　ヂイサンハ　カホヲ　アゲテ、「サウサ、カナヅチハ　ナンデモ　ツクルンダ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「オマヘハ　ドウダ、ウデガ　ムヅムヅシテルンダラウ。",
              "citation": {
                "source": "サルト　サムライ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "私ハカネテノ考エ通リニモハヤ仕方ガナイト思ッテ、　「僕ハアナタニハ大変スマナイ事ヲシテ居タンダ、許シテクレ、君ニ謝ラナケレバナラナインダ」　ト云イマスト清三ハ床ノ上ニ起キ上リナガラ、　「何ダ、君ハ大寺君ジャナイカ、今頃人ノ寝室ニハイリコンデ何ヲシヨウトスルンダ」　ト申シマシタ。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヲ道子ガ裏切ッタノダ、ダカラ今ココデ罰シテヤルンダ」　ト云ッタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "俺ハ復讐ヲスルンダ。",
              "citation": {
                "source": "火薬船",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "たとへば、『エッダ』の中の最も古い傳説をうたつた『ヴェールンダル・クヴィザ』〔Vo:lundar kvidha〕 即ち、ヴェールンドの歌といふのがあります。",
              "citation": {
                "source": "スカンヂナヴィア文學概觀",
                "author": "宮原晃一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "四時頃に、又グルンダー君を訪問して、いよいよ正式に入会の件を依頼する。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "兎に角一先ずヘッスラーは帰してしまって、前年、加賀に推薦したグルンダー君の説を聞くことにした。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルンダー君の店先で、いろいろ打ち合わせをしている中に、約束のフォイツがやって来た。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこで約束は山岳会の規定通り、一日三十フランずつ、もう一人のガイドは、グルンダー君の説によって、老練なヘッスラーをつれることにして、それもやはり同じ賃金である。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "晩餐には、グルンダー君を招いて、三人で会食する、食後は例によってキルシュワッサーを乾して、いよいよ御別れと云うことになる、若し何か危険にでも遇って、再び帰れないような場合には、荷物全部はグルンダー君をわずらわして、日本へ送ることに主人に依頼した。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "煙草屋の店先きには、弟のグルンダー君がいて、非常に驚ろいておる、私は車の上から手短かに話したまま、車を急がせる。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "医者が帰ると、診察の間席をはずしたグルンダー君が入って来て、いろいろの相談や、山の話に花を咲かせた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガイドの賃金やグリンデルワルトの医者の会計も、まだそのままなので、万事グルンダー君をわずらわすことにする。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルンダー君は非常に憤慨したが、ヘッスラーは兎に角、フォイツ不信任には、いささか驚いていたらしい。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "とにかくグルンダー君と相談して、グリンデルワルトのガイドをやって、遭難の場所をもう一度さがさせることにした。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "グルンダー君は、毎日かかさず見舞いに来てくれる、そして店を出る前に、きっと電話をかけて、買い物や用達しを聞き合わせて呉れた。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "ナースをせびって、時々ビーヤを持って来て貰う、町に散歩に出る時頼んで置いた、ヴェネディクティンとコンニャックを枕もとに置いて、食後には必ず祝杯をあげる、グルンダー君が毎日来てくれるんで、煙草にはことかかず、これで時々散歩にさえ行ければ、申し分はないとさえ思った。",
              "citation": {
                "source": "スウィス日記",
                "author": "辻村伊助",
                "note": "青空文庫"
              }
            },
            {
              "text": "胸襟を開いてルンダ・ルンダでも歌わんか。",
              "citation": {
                "source": "ファウスト",
                "author": "FAUST. EINE TRAGODIE",
                "note": "青空文庫"
              }
            },
            {
              "text": "トツテキテ、ハヤクナゲルンダヨ――」ト、トラ三ガドナツテヰタノデ、オバアサンハビツクリシマシタ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤキユウヲシテルンダナ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "イマニ　モツト　オホキナ　カゲヲモツタ　オホイヌニ　ナルンダ。",
              "citation": {
                "source": "こいぬ　の　ちびすけ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "……ヤ、ヤ、山ナンカ、キョウガ、ハ、ハ、ハジメテナンダ……アタシニハ……カミサンモ……コ、コ、小供モアルンダヨー。",
              "citation": {
                "source": "ノンシャラン道中記",
                "author": "アルプスの潜水夫　――モンブラン登山の巻",
                "note": "青空文庫"
              }
            },
            {
              "text": "ネオンサインダツテアンナニジーツトシテイル様ニ見ヘテモ実ハ不断ニネオンガスガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "――肺病ミガサツクスフオーンヲ吹イタラ危イ血ガ検温計ノ様ニ　――実ハ不断ニ寿命ガ流レテイルンダヨ。",
              "citation": {
                "source": "街衢ノ寒サ",
                "author": "――一九三三　二月十七日ノ室内ノコト――",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ハアノ揚巻ノ顔ヲ見テルダケデモイクラカ痛ミヲ忘レルンダ」予ハ婆サンニ窘メラレテ一層｜依怙地ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マダ何カ喰ッテモイヽナ」「冗談ジャナイ、ソレデ足リナインデスカ」「足リナイコトハナインダガ、コヽヘ来ルト関西ノモノガ恋シクナルンダ」「グジノ一ト塩ガアリマスゼ」ト浄吉ガ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
