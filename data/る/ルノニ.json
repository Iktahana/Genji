        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "「ナンダ　カナヅチカ、オンナジヤウナ　カタチヲ　シテ　ヰルガ、フエハ　ヨイ　オトヲ　タテヽ　ナルノニ、カナヅチハ　ナンニモ　ナラナイ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "」フエフキハ、タカイ　トコロデ　ハタライテ　ヰル　ダイクノ　テニ　カナヅチガ　ニギラレテ　ヰルノニ、ハジメテ　キガ　ツイタヤウニ　オドロキマシタ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコヘ上ルノニ、トチュウデ何ンベンモヤスンデ、イキヲ入レナケレバナラナイノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "モウ一年ニナルノニ、彼奴ハ故郷ニジットシテイテ、ドコニモ働キニ行コウトシナイ。",
              "citation": {
                "source": "三人の双生児",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「美人ト不美人トノ相違ノ真髄ハ何処ニアリヤト考エルノニ、要スルニ夫レハ主トシテ眉目ノ立体幾何学的問題ニ在ル。",
              "citation": {
                "source": "ヒルミ夫人の冷蔵鞄",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデ、田舎ノ景色バカリカイテヰルノニアキテ、街ノシヤセイヲシヤウト思ツテ、街ニキマシタガ、田舎者ノ玉ネギサンハ道ニマヨツテシマヒマシタ。",
              "citation": {
                "source": "迷子ノジヤガイモ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヤキユウヲスルノニ、ダマツテデキナイナンテ、ナンテ、バカナ小僧タチダ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ヤキユウヲスルノニ、コエヲダサナイデスルトイフワケニハユカンモンデスカネ。",
              "citation": {
                "source": "ネコ　ノ　オバアサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "トコロガ　イヂノワルイ　オサルサンガ、「ザウサンハ　タイヘン　オギヤウギガヨイトイッテ　ミンナガホメルケレドモ、バウシヲトルノニ　テデトラナイデ、ハナデトルデハナイカ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "いま自分らのいる、シベリヤのツルノニア圏と呼ばれる陸成層の一部は、その際、爬虫獣と爬虫鳥と古代鱗木をのせたまま、地底深く陥没し、その上を厚い片麻岩の地殻で蔽われてしまった。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツルノニア圏の湿原で、恐竜に襲われた時から今日でもう二カ月になる。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ツルノニア圏の湿原を出てから、金剛砂とクワルツ土の広漠たる原野を彷徨したのち、ふたたび輝石安山岩の単調な暗道へ入り、七十六日目の朝、突然、この島の胴中へ出た。",
              "citation": {
                "source": "地底獣国",
                "author": "久生十蘭",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソウスレバ会葬者ハ表門カラ中門ヲ通ッテ飛石伝イニ焼香ニ来ルノニ便利デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "颯子ニハヒルマンヲ買ッテオヤリニナルノニ」ソウ云ワレタノガグット来テ、予ハハッキリト断ル決心ガツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昔ハ随分熱烈ナ仲ダッタ時代モアルノニ、飽キッポイノハ親譲リカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "経助ハ既ニ七歳ニナリ小学一年生ニナルノニ、ソノ後アトガ生レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "時々前ノ日記ヲ取リ出シテ見ルト、ヒドク忘レッポクナッテイルノニ驚ク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ洋式便所ヲ可トスルノニ、婆サンハ日本式デナケレバ困ルト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハソレヨリモ、春久ト颯子トガドンナ工合ニ接触スルカ、ソノ様子ガ見タカッタノデアルガ、団欒ノ中ニ加ワッテカラ三四十分モシタ時分、次第ニ脚カラ腰ノ周リガ冷エテ来ルノニ心ヅイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "盲人ガ物ヲ食ベルノニハ時間ガカヽル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯様ナ場合、浴衣ヲ借リルクライハイヽガ、階下ノ客間ナリ応接間ナリ茶ノ間ナリ、今ハ婆サンモ留守デアルカラ至ルトコロガ空イテイルノニ、二階ヘ上ルニハ及ブマイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワガ家ニ来テカラ既ニ十年近クナルノニ、歳月ヲ経ルホドマス／＼美シクナリツヽアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシアスピリン系統ノ薬ナノデ、甚シク発汗スルノニハ閉口スル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "今ノ母屋デモ家族全部ヲ収容スルノニ狭過ギルト云ウコトハナイガ、予ガイロ／＼ト企ンデイル悪事ヲ実行スルノニハ少シ不便デアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、今朝ハ、ダン／＼意識ガハッキリシテ来ルニ従イ、ソノピイピイト云ウ声ガ、現ニ佐々木看護婦トベッドヲ並ベテイルコノ部屋ノ中デ聞エテイルノニ違イナイコトニ心ヅク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コンクリートヲ乾カスマデニ時間ガカヽルンデ、今カラ工事ヲ始メテモ完成スルノニ四カ月グライカヽルソウダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレデナクテモ「若奥様」ノ権力ガ日ニ日ニ「御隠居様」ヲ凌ギツヽアルノニ、犬一匹ノ処置ノ問題ガ因ニナッテドンナ大喧嘩ニナルカモ知レナイ、ソレヲ思ウトウッカリ戦端ヲ開ク訳ニ行カナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ガ、明ケ方眼ガ覚メテ見ルト又痛ミ出シテイルノニ心ヅク。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オ小サクッテイラッシャルノニ、ヤッパリオ爺チャンノコトヲ心配ナスッテイラッシャルンデゴザイマスネ」「子供ノ癖ニ変ニマセテイヤガッテ小生意気デイヤナ奴ダ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
    ],
