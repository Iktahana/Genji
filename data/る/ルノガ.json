        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "世間ト絶縁スルノガ俺ノ生キル道ダ。",
              "citation": {
                "source": "六白金星",
                "author": "織田作之助",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ僕ハ生キテイルノガ苦シイノダ。",
              "citation": {
                "source": "『我輩は猫である』中篇自序",
                "author": "夏目漱石",
                "note": "青空文庫"
              }
            },
            {
              "text": "タキクンハ　「ヒゲサン」ト　ヨバレルノガ　イヤデ　タマリマセン。",
              "citation": {
                "source": "センセイノ　コ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オナカガ　スイテ　ヰル　ヌスビトノ　メニ、フト　マルマルシタ　コヒツジガ　一ピキ、ミンナト　ハナレテ　アソンデ　ヰルノガ　ウツリマシタ。",
              "citation": {
                "source": "ヌスビトト　コヒツヂ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ便所ノ方ニ進ンデ暗イ廊下ヲワザトソット曲ッテ行クト、角デ道子ト友田トガ何カヒソヒソト話シテ居ルノガ聞エマシタ、道子ガアサッテ六時ニイツモノ所デネト云ウ声ガハッキリキコエマシタ、友田ノ声ハヨクキキ取レナカッタノデスガ、私ハソノ時二人ガ手ヲ握リ合ッタノヲ感ジタノデス。",
              "citation": {
                "source": "彼が殺したか",
                "author": "浜尾四郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」トカイタ大キナハタヲモツテ、小サナ男ノ子ノ手ヲ引イタカイスイヨクジヨウノバン人ガムカフカラ歩イテ来ルノガミエマシタ。",
              "citation": {
                "source": "ウミベノマヒゴ",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　犯罪に因りて得た金品は何に使ったか毫モ利欲ヲ目的トシテナシタ行為デハナク、従ッテ金品ハ何等得テ居ナイ七　自分の悪癖は何と思ふか事ヲナスニ於テ散漫ニ陥ルノガ自分ノ最大ノ悪癖デアルト思フ八　是れまで何か信じて居ったか宗教ノ意味ナレバ何モナシ。",
              "citation": {
                "source": "入所時感想録",
                "author": "槇村浩",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワタクシハオ魚ヲ食ベルノガ下手デスカラ、オ婆チャンノヨウニ綺麗デハゴザイマセンケレド」颯子ノ鮎ノ残骸ハ成ル程マコトニキタナラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………ト、清琴ノ声デ唄ッテイルノガ聞エテ来ルヨウナ、モウ死ンデイル筈ダガ、死ンデモ聞エテ来ルヨウナ気ガスル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナニモ平気デイラレルノガ意外ダッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ年寄ニハ残酷ダワ」ミンナガ周リデガヤ／＼云ッテルノガ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "オ前サンガ颯子ニ甘スギルノガイケナインダヨ、スッカリ舐メラレテルンダカラ」トウ／＼浄吉ニ呼ビツケラレテ颯子ガ婆サンニ弁明スル段ニナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "入浴ノ助手ヲスル時、彼女ハブリュウデエッフェル塔ノ模様ノ附イタポロシャツヲ着テ、膝ノトコロマデノトレアドルパンツヲ穿イテイルノガ、素晴ラシクスッキリト意気ニ見エタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "シカシマス／＼冷エテ来ルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "瞳孔ノ周囲ヲ注意シテ見ルト、角膜ノ下ニ赤イ細イ血管ガ異様ニ幾筋モ走ッテイルノガ認メラレル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ糊ノ硬イゴワ／＼シタ単衣ヲ着セラレルノガ嫌イデアッタガ、寝間着ニハイツモ甘ッタルイ腐リカヽッタヨウナ糊ノ匂イガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "己ニソレヲ見セルノガ目的デプールヲ作ルヨウナモノナンダ」「ソレデモソレハイヽコトデゴザイマスワネ、自分ノ家ニプールガ出来タラ経チャンダッテ喜ブデショウシ、………」陸子ガ云ウト婆サンガ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ワア、ワア、ワア」気ガ狂ッタラ狂ッタデイヽ、モウドウナッタッテ構ウモンカ、予ハソウ思ッタガ、困ッタコトニ、ソウ思ッタ瞬間ニ急ニハット自省心ガ湧キ、気狂イニナルノガ恐クナッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "空ットボケルノガ名人デアルカラ、彼女ハ例ノ如ク得々トシテ有楽座ヘ出カケテ行ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「デハコレカライタシマス、別ニ痛クモ何トモゴザイマセンカラ御心配ナク」「心配ハシテオリマセン、ドウゾ御遠慮ナク」「ヨロシュウゴザイマスナ」針ガ頸部ニ射シ込マレルノガ感ジラレタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "平然トシテイルノガ自分ニモ分ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハキシロカインノ場合ニ限ラズ、何ノ注射デモ、タトエバヴィタミンノ注射ノ場合デモ、薬液ヲ血管ノ中ヘ注入シナイヨウニ、一応注射ニ先立ッテ注射針ヲ外ヘ引イテ見、血液ガ混入シタカドウカヲ念ノタメニ慥メテ見ルノガ常識ニナッテイル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "昨夜ノキャバレノ帰リガ遅カッタノデ寝足リナイノカ、話シカケラレルノガウルサイノデ寝タ振リヲシテイルノカ、ドッチダカ分ラナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "」「コレニ墨ヤ朱ヲ滲マセテ、石ノ表面ヲパタ／＼叩イテ拓本ヲ作ルノサ、僕ハ朱色デ拓本ヲ作ルノガトテモ好キナンダ」「石ナンカナイジャナイノ」「今日ハ石ハ使ワナイ、石ノ代リニ或ル物ヲ使ウ」「何ヲ使ウノ？",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ妻ガ一生懸命酔イヲ隠シテ冷タイ青ザメタ顔ヲシテイルノヲ見ルノガ好キダ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "僕ハ必ズシモ睡ラセルノガ目的デ飲マシタノデハナイ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「現像ノ面倒ガナイトイウ長所ハアルケレドモ、フラッシュヲ用イルノガ手数デアルシ、ヤハリ普通ノ機械ノ方ガ撮リヨイネ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コンナ時、僕ハ本気デ注射ヲスルノガ馬鹿気テイルノデ、カンフルヲ射ス真似ヲシテ、ヴィタミンヲ射シテヤル※ニシテイルノダガ、木村ガ気ガ付イテ、「先生、コレデイインデスカ」ト小声デ聞イタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "右ノ足ガ二ツ、左ノ足ガ二ツ、水中ニアルヨウニ浮遊シテイルノガ、ソノ肌ノ白カッタノアル、アノ通リノ形状ヲシテ真正面ニコチラヲ向イテイル臀ガアッタ。",
              "citation": {
                "source": "鍵",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
