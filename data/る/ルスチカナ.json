        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "自分は漸くカワレリヤ、ルスチカナの幕開きに淋しい立琴を合方にして歌ふシチリヤナの一節を思付いた。",
              "citation": {
                "source": "黄昏の地中海",
                "author": "永井荷風",
                "note": "青空文庫"
              }
            },
            {
              "text": "パリアツチ及カワレリヤルスチカナの二曲なり。",
              "citation": {
                "source": "断腸亭日乗",
                "author": "断腸亭日記巻之三大正八年歳次己未",
                "note": "青空文庫"
              }
            },
            {
              "text": "――実際ではカヴァレリア・ルスチカナがオペラ・コミック座に君臨してい、パリアッチがオペラ座に君臨していた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            },
            {
              "text": "カヴァレリア・ルスチカナを小声で歌ってる自分自身にふと気づいて驚いた。",
              "citation": {
                "source": "ジャン・クリストフ",
                "author": "JEAN-CHRISTOPHE",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
