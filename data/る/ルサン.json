        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "こういう種類のではたとえばたっつけ袴のカルサンというのがインドへんから来ているかと思うと、イタリアにも類似の名が出て来たりするのである。",
              "citation": {
                "source": "比較言語学における統計的研究法の可能性について",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "男は愉快気に重ねて、「ああ、いい酒だ、サルチルサンで甘え瓶づめとは訳が違う。",
              "citation": {
                "source": "貧乏",
                "author": "幸田露伴",
                "note": "青空文庫"
              }
            },
            {
              "text": "舟子は、縞もめんのカルサンをはいて、大黒ずきんをかぶったかわいい老爺である。",
              "citation": {
                "source": "河口湖",
                "author": "伊藤左千夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "カルサンを穿いて籠を背負つて宿の者は山から歸つて來た。",
              "citation": {
                "source": "痍のあと",
                "author": "長塚節",
                "note": "青空文庫"
              }
            },
            {
              "text": "東京の井師五十歳祝賀句会へ打電――アキゾラハルカニウレシガルサントウカ野菊、りんだう、石蕗、みぞそばの花、とり／″＼に好きだ。",
              "citation": {
                "source": "其中日記",
                "author": "種田山頭火",
                "note": "青空文庫"
              }
            },
            {
              "text": "石油会社の支配人を……ラルサンという老人です」「その時にあの女を連れて行かれましたか」「行くもんですか。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "そのホテルでラルサンという毛唐と一緒に食事はしましたがね。",
              "citation": {
                "source": "少女地獄",
                "author": "夢野久作",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カルサン」という労働の袴を着けた百姓が、裏の井戸から冷い水を汲んで、流許へ担いで来た。",
              "citation": {
                "source": "家（上巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この男は、「カルサン」を穿いて、三吉の荷物まで自分の肩に掛けていた。",
              "citation": {
                "source": "家（下巻）",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "水力電気の工事でせき留められた木曾川の水が大きな渓の間に見えるようなところで、私はカルサン姿の太郎と一緒になることができた。",
              "citation": {
                "source": "嵐",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "学校の生徒らしい夏帽子に土地風なカルサン穿きで、時々｜後方を振返り振返り県道に添うて歩いて行く小さな甥の後姿は、おげんの眼に残った。",
              "citation": {
                "source": "ある女の生涯",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "家の裏口に出てカルサン穿きで挨拶する養子、帽子を振る三吉、番頭、小僧の店のものから女衆まで、殆んど一目におげんの立つ窓から見えた。",
              "citation": {
                "source": "ある女の生涯",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "次第に私は遠く行くやうに成つて、男の友達と一緒に深い澤の方まで虎杖の莖などを折りに行き、『カルサン』といふ勞働の袴を着けた太助の後に隨いて、松薪の切倒してある寂しい山林の中を歩き※り、路傍に『酸い葉』でも見つけると、それを生でムシヤ／＼食ひました。",
              "citation": {
                "source": "幼き日",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "荷を積める車とどまり軽衿の子の歩み行く夕月夜かな　カルサンは即ち「もんぺ」で今では日本国中穿たざる女もないが、この間までは山国の女だけしかしなかつた。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "これも八ヶ岳山麓の月のある夕の小景で、カルサンといふ洵に響きのよい舶来語を使つて昔のもんぺ姿を抒してゐるのが面白い。",
              "citation": {
                "source": "晶子鑑賞",
                "author": "平野萬里",
                "note": "青空文庫"
              }
            },
            {
              "text": "「どうだ、俺はこの節こういうものを穿いて毎日仕事をしてる」　と言いながら、岸本は山国の農夫の着ける紺木綿のカルサンを着けたまま、自分で茶を入れに火鉢の側へ立って行った。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "「東京でこんなカルサンなぞを穿いてる人はめったに無いね。",
              "citation": {
                "source": "新生",
                "author": "島崎藤村",
                "note": "青空文庫"
              }
            },
            {
              "text": "この外に、水夫のフランソアとラルサンの二人。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "「お前ら、海へはいってボートを、リーフから下ろしてくれ」「とんでもないことでございますよ」　と、水夫のラルサンが、かぶりをふった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "えへへ、なんでしたら閣下が鱶へ食糧をおあたえなすっては……」　ラルサンは皮肉をとばす。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "恐竜といったが、それはラルサンたちの胸へ、ぎくりと大きくひびいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "これはゆだんがならないぞ」　このざわめき話に、水夫のフランソアとラルサンの二人は、絞首台の前に立った死刑囚のように青くなった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "フランソアとラルサンの二人はしめしあわせて、こそこそ後じさりをはじめた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "その横には、水夫のラルサンがよいつぶれて、テーブルがわりの空箱に顔をおしつけたまま、なにやら文句の分らない歌を、豚のような声でうたっている。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "分ったか、フランソアにラルサン」　と、二人の肩を、いくどもたたいた。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ぴかぴか光っていらあ」「ほんとに、あれは金貨らしい光だ」　フランソアとラルサンが、小さい暗礁の上に光るものを見つけて、感心している。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "二人の水夫フランソアとラルサンも、モレロをこのように昂奮させた岩の上の黄金色まばゆき何物かを見つけてしまった。",
              "citation": {
                "source": "恐竜島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
