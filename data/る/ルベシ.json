        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "金五百円ハヤガテ君ガモノタルベシトゾ。",
              "citation": {
                "source": "虚構の春",
                "author": "太宰治",
                "note": "青空文庫"
              }
            },
            {
              "text": "そこの上からは松川農場を一面に見渡して、ルベシベ、ニセコアンの連山も川向いの昆布岳も手に取るようだった。",
              "citation": {
                "source": "カインの末裔",
                "author": "有島武郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "奈翁戰爭ガ十八世紀ト十九世紀トヲ劃セル如ク、十九世紀ノ終焉二十世紀ノ初頭ハ眞ニ世界大戰ノ一大段落ヲ以テ限ラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本國民ハ須ラク國家存立ノ大義ト國民平等ノ人權トニ深甚ナル理解ヲ把握シ、内外思想ノ清濁ヲ判別採捨スルニ一點ノ過誤ナカルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "従テ假令國外出征中ノ現役將卒ト雖モ何等ノ制限無ク投票シ且ツ投票セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "善キ傾向ニ發達シタル者ハ惡シキ發達ノ者ヲシテ學バシムル所アルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ハ此ノ合理的勤勞ニ對シテ其ノ納付金ヲ國家ニ對スル獻金トシテ受ケ明カニ其ノ功勞ヲ表彰スルノ道ヲ取ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私産限度超過者ガ法律ヲ遵守セズシテ不可行ニ終ルベシト狐疑スル勿レ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "故ニ中世貴族ノ所有地ヲ現今ニ至ルモ解決スル能ハズシテ終ニ獨立問題ニマデ破裂セシメタル愛蘭ノ土地問題ト、此ノ私有地限度制トハ其思想ニ於テモ進歩ノ程度ニ於テモ雲泥ノ差アルヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "社會主義的議論ノ多クガ大地主ノ土地兼併ヲ移シテ國家其者ヲ一大地主トナシ以テ國民ハ國家所有ノ土地ヲ借耕スル平等ノ小作人タルベシト云フハ原理トシテハ非難ナシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "三坪ノ邸宅ニ甘スル者アルベク數拾萬圓ノ高樓ヲ建ツルモノアルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "大森林又ハ大資本ヲ要スベキ未開墾地又ハ大農法ヲ利トスル土地ハ之ヲ國有トシ國家自ラ其經營ニ當ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ガ國家自ラノ義務ト權能トヲ無視スルコトヲ畏ルベシトナス。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "現時ノ分立セル銀行ト此ノ銀行省トノ對外能力ヲ考フル時、其ノ差等ハ殆ド支那ノ私兵ト日本ノ統一軍隊程ノ懸隔ヲ見ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "將來臺灣ノ幾十倍ナル大領土ヲ南北滿州及ビ極東西比利亞ニ取得スベキ運命ニ於テ、同一ナル罪惡ヲ國家國民ノ責任ニ嫁セラルヽコトハ日本ノ國際的威嚴信用ヲ汚辱シ、土地ノ國際的分配ノ公正ノ爲メニ特ニ日本ノ享有セル領土擴張ノ生活權利ヲ損傷シ、如何ナル大帝國建設モ百年ノ壽ヲ全ウスル能ハザルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "從テ國家ノ物價調節ハ一絲紊レズ整然トシテ行ハルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "鐵道ノ國有タルベキ者ト民有タルベキ者ト、亦實ニ私人生産業限度ノ原則及ビ大資本ノ國家統一ノ原則ノ下ニ律セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "私人生産ニ雇傭セラルル勞働者ハ其ノ純益ノ二分ノ一ヲ配當セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "事業ニ對スル分擔者トシテノ當然ナル權利ニ基キテ制定サルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "此ノ改造ニヨリテ男子ノ勞働者ノ利得ガ優ニ妻子ノ生活ヲ保證スルニ至ラバ、良妻賢母主義ノ國民思想ニヨリテ婦人勞働者ハ漸次的ニ勞働界ヲ去ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "婦人ガ妻タリ母タル勞働ノミトナラバ、夫タル勞働者ノ品性ヲ向上セシメ、次代ノ國民タル子女ヲ益々優秀ナラシメ、各家庭ノ集合タル國家ハ百花爛漫春光駘蕩タルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "父母ノ遺産ヲ相續セル兒童、又ハ母ノ資産或ハ特種能力ニ於テ教養セラレ得ル兒童ハ、國家ト協議ノ上此ノ權利ヲ放棄セシメラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "最モ不便ナル國語ニ苦シム日本ハ其ノ苦痛ヲ迯ルルタメニ先ヅ第二國語トシテ並用スル時、自然淘汰ノ理法ニヨリテ五十年ノ後ニハ國民全部ガ自ラ國際語ヲ第一國語トシテ使用スルニ至ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "若シ此ノ立法ガ男子ノ道念ニヨリテ行ハレザルナラバ忌ムベキ婦人勞働トナリ婦人參政權運動トナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "貞操ノ賣買ハ此ノ改造組織ノ後ニ於テハ漸次消滅スベキコトヲ信ズト共ニ、暫クノ近キ將來ニ存在スベキ其等ニ對シテ、國家ハ兩者共ニ法律ヲ以テ臨マザル方針ヲ取ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "斯クシテ輕キ國家ノ制裁ヲ受クルコトニヨリテ、男子ハ家族ニ對スル權威ヲ失シ交友ニ於ケル信用ヲ損スル重大ナル苦痛ヲ受クルヲ以テ自ラ身ヲ愼ミ亦以テ婦人々權ノ擁護トナリ、全家族生括ノ保障ヲ加フルコトトナルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "國家ニ對シ又ハ世界ニ對シテ勳功アル者ハ、戰爭政治學術發明生産藝術ヲ差別セズ、一律ニ勳位ヲ受ケ、審議院議員ノ互選資格ヲ得、著シク増額セラレタル年金ヲ給付セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "彼ノ者ト考フルガ上院制ヲ否ム革命的思想家ハ、人類ノ進化程度ヲ過上ニ評價セル神學者的要求ニ發足スル者ナリト見ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "母ノ遺産ハ夫タル父ニ於テ凡テ相續セラルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            },
            {
              "text": "遺産相續ノ正義ヲ規定スルニ見ルモ、合理的改造案ガ必ズ近代的個人主義ノ要求ヲ一基調トスルコトヲ知ルベシ。",
              "citation": {
                "source": "日本改造法案大綱",
                "author": "北一輝",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
