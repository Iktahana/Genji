        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "莫大ナル出兵費ハ誰カラ出ルカ、諸君ガ一本ノ煙草ヲ喫ンデモ、半斤ノ砂糖ヲ使ッテモ、一足ノサル又ヲ買ッテモ、必ズ間接ニ徴収セラレル税金カラ出テイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "日本ハ山東ヲ満洲ノ如ク、奴隷的植民地トシヨウトシテイルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "植民地再分割ノタメ帝国主義戦争ガ勃発スル可能性ガ十分ニアルノダ。",
              "citation": {
                "source": "武装せる市街",
                "author": "黒島傳治",
                "note": "青空文庫"
              }
            },
            {
              "text": "コレハ　テツキリ、ジブンヲ　コロシテ　カネヲ　トルノダナト　オモヒマシタ。",
              "citation": {
                "source": "カゴカキ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ナルホド、イママデ　キヅカズニ　ヰタガ、カナヅチハ　クワヲ　ツクル　コトガ　デキルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "オヤ、ナルホド、コノ　ウチモ　ヤツパリ　カナヅチガ　ツクルノダナ。",
              "citation": {
                "source": "カナヅチ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「カナシミハ　ダレデモ　モツテ　ヰルノダ。",
              "citation": {
                "source": "デンデンムシノ　カナシミ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテ　マタ、ホカノ　ヒトニハ　トウトイ　モノデ　アツテモ、ジブンニハ　チツトモ　トウトクナイ　コトモ　アルノダ、ト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "カンザシ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "「オテラノ　コゾウサンニ　バケル　トキハ　コロモヲ　ツケテ　デルノダヨ。",
              "citation": {
                "source": "ゲタニ　バケル",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソコデ　ミンナハ、カゲト　イフ　モノハ　タイヤウガ　ツクルノダト　イフ　コトガ　ワカリマシタ。",
              "citation": {
                "source": "タレノ　カゲ",
                "author": "新美南吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "クワシイコトハ物理学者ニ聞カナイトワカラナイガ、多分直線ノホウガヨリ少ナイエネルギーデヨリ多クノ距離ヲ行ケルノダロウト思ウ。",
              "citation": {
                "source": "カタカナニツイテ",
                "author": "伊丹万作",
                "note": "青空文庫"
              }
            },
            {
              "text": "一月八日◯去ル五日ニ気ガ附イタコトデアルガ、イツノ間ニカ左眼ガワルクナッテイルノダ。",
              "citation": {
                "source": "海野十三敗戦日記",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ワレワレ通信技術者ガワレワレノ組立テタ器械ニヨッテ放出シテイル通信用電波ノ外ニ此ノ空間ニハ現ニ多種多様ナ未知ノ電波ガ飛ビ交ッテイルノダ。",
              "citation": {
                "source": "霊魂第十号の秘密",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソシテオ前ハ俺ノ行動ニツイテ、昼間飛行島デ別レテカラ後ノコトハ、スベテミナ忘レルノダ。",
              "citation": {
                "source": "浮かぶ飛行島",
                "author": "海野十三",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダサウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "灼ケ熾カル自ラノ終焉ニ牙ヲタテ　爛燦タル夢ノ苛察ヲ思ヒ知ルノダ。",
              "citation": {
                "source": "逸見猶吉詩集",
                "author": "逸見猶吉",
                "note": "青空文庫"
              }
            },
            {
              "text": "デスカラドンナ事ガ起ルカ知リマセンガ、何デモオ婆サンノ話デハ、『アグニ』ノ神ガ私ノ口ヲ借リテ、イロイロ予言ヲスルノダソウデス。",
              "citation": {
                "source": "アグニの神",
                "author": "芥川龍之介",
                "note": "青空文庫"
              }
            },
            {
              "text": "スルトミンナガ、「ザウサンハ　アシモ　テモツカヘナイカラ、ハナデトルノダヨ。",
              "citation": {
                "source": "ザウサン　サルサン",
                "author": "村山籌子",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレヨリ何カ不能ニナッタ老人ノ性生活―――不能ニナッテモ或ル種ノ性生活ハアルノダ―――ト関係ガアルラシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "往年ノ軽微ナ脳溢血ノ痕跡ガマダ残ッテイ、脳中枢ニ僅カナ変化ガアルノデ、ソレガ脚ニ影響シテイルノダトモ云イ、又レントゲンデ検ベテミルト頸椎ト腰椎トガ曲ッテイルカラデアルトモ云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "長男ノ力ガ、マダ大学ノ二年生デ早過ギルノダケレドモ、恋人ガ出来テ結婚サセテクレト云ウノデ、許スコトニシタ、ガ、若イ二人ヲアパートナドニ別居サセテオクノハ不安デアルカラ、力ガ卒業シテ就職スルマデハ手許ニオイテ夫婦生活ヲサセヨウト思ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予モ恐ラクソウデハナイカト、心中デハ思ッテイルノダガ、ソンナコトハナイダロウト、婆サンノ前デハ否定シテイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "夜ノ遅イ急行デ京都ヘ行キ、祇園会ヲ見物スルノダト云ウ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "コノ暑イノニ御苦労ナコトダガ、春久ガ御祭ヲ撮影スルノダト云ッテ昨日カラ行ッテイルノデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "イズレ老人ニハ知ラセテ置イタ方ガ都合ノイヽコトガアルノダカラ、ソレナラ少シデモ早ク知ラセテ因果ヲ含メテヤッタ方ガ功徳ニナルト、考エタカモ知レナイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ソレガ自分ノ喉ガ鳴ッテイルノダトハ思エナイデ、自分ノ体以外ノトコロカラ鳴ッテ来ルヨウニ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "………雨ノ日ハ手足ノ工合ノ悪サガ一層ヒドク、雨ガ降リ出ス前ノ日アタリカラ豫感ガアルノダガ、今日ハ朝起キルトキカラ手ノ痺レ加減モ脚ノ浮腫ミ加減モ縺レ加減モ甚ダシイ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "予ハ颯子ト同様ニ偽悪趣味ガアリ、男ノ癖ニ泣クナンテ見ットモナイト思ッテイルノダガ、ソノ実案外涙脆クッテ、屁デモナイコトニ訳モナク涙ガ出ル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "死ハ一向恐クナイ、ダガ、予ハ今コノ瞬間ニ死ニ直面シテイルノダト思ウト、―――死ガコノ刹那ニ予ノ眼前ニ迫ッテイルノダト思ウト、―――ソウ思ウソノコトガ恐イ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
