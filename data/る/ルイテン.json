        "examples": {
          "standard": [
            {
              "text": "悲しい映画を観て涙が溢れそうになったが、ぐっとこらえて涙点から鼻の奥に流し込んだ。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "ドライアイの治療で、涙の排出を抑えるために涙点を塞ぐ「涙点プラグ」という処置を受けた。",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            },
            {
              "text": "「あくびをすると涙が出るのは、まぶたが閉じることで涙腺が圧迫され、行き場を失った涙が涙点から溢れるからだよ。」",
              "citation": {
                "source": "Illusions AI",
                "author": "Gemini",
                "note": "gemini-2.5-pro"
              }
            }
          ],
          "literary": [
            {
              "text": "なんでお前あんなに持ってあるいてんだい？",
              "citation": {
                "source": "その一年",
                "author": "山川方夫",
                "note": "青空文庫"
              }
            }
          ]
        }
