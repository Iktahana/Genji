        "collocations": [],
        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "ドストエフスキー、セルバンテス、ホーマー、ストリンドベルヒ、ゴットフリード・ケラー＊、こんな名前が好きな方の側に、ゾラやイブセンなどが好かない方の側に挙げられている。",
              "citation": {
                "source": "アインシュタイン",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "今考へるとアブソルバンのことであつたらしい。",
              "citation": {
                "source": "蓑田先生",
                "author": "寺田寅彦",
                "note": "青空文庫"
              }
            },
            {
              "text": "フルバンドをバックに従え、伴奏があってはじめて歌が成り立つのではありません。",
              "citation": {
                "source": "パソコン創世記",
                "author": "富田倫生",
                "note": "青空文庫"
              }
            },
            {
              "text": "南インドプルバンデルの諸王はハヌマン猴神の裔で尾ありという（ユールの『マルコ・ポロの書』一八七五年板、巻二、頁二八五）。",
              "citation": {
                "source": "十二支考",
                "author": "猴に関する伝説",
                "note": "青空文庫"
              }
            },
            {
              "text": "ボールバンに白墨で円を描いていた仲間が森本をちらッと見ると、眼が笑った。",
              "citation": {
                "source": "工場細胞",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "アルバン、君チャンガ何カニビックリサレタヨウニ、フト目ヲサマシタノ。",
              "citation": {
                "source": "テガミ",
                "author": "小林多喜二",
                "note": "青空文庫"
              }
            },
            {
              "text": "こう云うとモリエールの彼の有名な戯曲とか、セルバンテスのドン・キホーテなどは、「ユーモア文学」でないという説が出て来るのであるが、私は勿論、そういうものが「ユーモア文学」であるとは考えたくない。",
              "citation": {
                "source": "大衆文芸作法",
                "author": "直木三十五",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントが『ヘーゲル主義の復興』と云ふ論文を書いたとき、彼はその頃新進気鋭のノールやエビングハウスを頭においてゐたと云はれてゐます。",
              "citation": {
                "source": "消息一通",
                "author": "一九二四年一月一日　マールブルク",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントは自然科学と歴史学との区別を論じて、自然科学が法則定立的であるに反し、歴史学は個性記述的であると述べている。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントに依ると、真理はもと、言語的には文章において表現され、論理的には判断と称せられる表象の結合にのみ関わっている。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "更にヴィンデルバントのいう如く、本来の認識である判断には知的契機と共に意志的契機が含まれるとすれば、意志の一定の状態ないし態度が認識のために要求される筈である。",
              "citation": {
                "source": "哲学入門",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントの『プレルーディエン（序曲）』の中の『哲学とは何か』を速水滉先生に願って読んでいただいたのである。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "哲学の方面でもその頃からヴィンデルバントを初め新カント派の哲学が次第に一般の流行になりつつあった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "私がかように新カント派の影響を受けたのは、高等学校の時の読書会でヴィンデルバントを読んだことが素地をなしていたのであろうが、その時代のわが国の哲学の一般的傾向にも関係があったであろう。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "左右田博士の影響によって、その頃からわが国の若い社会科学者、特に経済学者の間で哲学が流行し、誰もヴィンデルバント、リッケルトの名を口にするようになった。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "これは主としてヴィンデルバント、リッケルトらの新カント派の影響によるものである。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントの『プレルーディエン』、リッケルトの『自然科学的概念構成の限界』や『文化科学と自然科学』などから始めて、ジンメルの『歴史哲学の諸問題』等、またトレルチのやがて『歴史主義とその諸問題』に収められた論文を雑誌で探して、勉強した。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "リッケルト教授はハイデルベルクの哲学を代表し、その講義はかつてヘーゲルが、クーノー・フィッシェルが、ヴィンデルバントが講義したことがあるという由緒のある薄暗い教室で行なわれた。",
              "citation": {
                "source": "読書遍歴",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは日本の哲學書出版に時代を劃した岩波の『哲學叢書』が刊行され始めた時期であつて、その中のヴィンデルバントのものを紹介した『哲學概論』を讀んでみたが、正直にいふと、よく理解できなかつたのである。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "三年生の時、小さな會を作つて、ヴィンデルバントの『プレルーディエン（序曲）』の中の『哲學とは何か』を謄寫版刷りにして速水滉先生から讀んで戴いた。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントの『哲學概論』は概論中の白眉として定評のあるものであり、ぜひ目を通さねばならぬものではあるが、初めに讀むものとしては少しむづかしいであらう。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントの哲學概論と共にわが國で知られてゐるディルタイの『哲學の本質』も、重要なものではあるが、やさしいとはいへない。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "六　ここに私が一緒に體驗してきた比較的新しい日本の學界における出來事を囘顧すると、一時わが國の文化科學研究者の間に哲學が流行し、ヴィンデルバント、リッケルトの名を誰もが口にした時代があつた。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "ヴィンデルバントの『哲學史教科書』は問題史的な哲學史として特色があり、目を通さねばならぬ名著であるが、入り易いものとはいへないであらう。",
              "citation": {
                "source": "哲學はどう學んでゆくか",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "またウィンデルバントは判斷（Urteil）と價値判斷（Beurteilung）とを區別する。",
              "citation": {
                "source": "認識論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "それは表象の結合ではあるが、その眞理價値は肯定または否定によつて決定される、とウィンデルバントはいつてゐる。",
              "citation": {
                "source": "認識論",
                "author": "三木清",
                "note": "青空文庫"
              }
            },
            {
              "text": "この誤った考えの著しい代表者はウドワード（Woodward 一六六五―一七二二年）とウルバン・ヒエルネ（〔Urban Hja:rne〕 一七一二年）であった。",
              "citation": {
                "source": "宇宙の始まり",
                "author": "スワンテ・アウグスト・アーレニウス　Svante August Arrhenius",
                "note": "青空文庫"
              }
            },
            {
              "text": "私はいつかはセルバンテスを読ませたかった。",
              "citation": {
                "source": "忘れがたみ",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "ふと、彼はその頃読んだセルバンテスの短篇から思ひついて、「新びいどろ学士」といふ小説を書かうと考へだした。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            },
            {
              "text": "セルバンテスの「びいどろ学士」は自分の全身が硝子でできてゐると思ひ込んでゐるので、他からその体に触られることを何よりも恐れてゐる。",
              "citation": {
                "source": "氷花",
                "author": "原民喜",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
