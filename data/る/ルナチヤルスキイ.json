        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "が、これは教育委員ルナチヤルスキイや、ゴルキイや、其の他の、正統派共産主義者からはセンテイメンタリストと看做されてゐる進歩的分子の人にとつては、あんまりひどい事だつた。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチヤルスキイは此の野蛮な提議と戦つて、幸に彼の方が勝つた。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチヤルスキイもゴルキイもそれを知らないのだと云ふ事は確かだ。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "友人達はルナチヤルスキイと一緒に、それを問題にした。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            },
            {
              "text": "ルナチヤルスキイはこんな事を知つてゐるだらうか。",
              "citation": {
                "source": "死んだ魂",
                "author": "エマ・ゴオルドマン",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
