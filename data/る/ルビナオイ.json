          "literary": [
            {
              "text": "大正十四年、彼は近くに在る万大社のルビナオイという娘のところへ養子に行った。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "しかし、たまに例外があるのは断わるまでもないところで、このルビナオイは生来多情な女であった。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            },
            {
              "text": "養子に貰ったヒポサツポにもルビナオイは間もなく倦きがきた。",
              "citation": {
                "source": "霧の蕃社",
                "author": "中村地平",
                "note": "青空文庫"
              }
            }
          ]
        }
