        "examples": {
          "standard": [],
          "literary": [
            {
              "text": "マルセル・ルキエン家の食事、麻布のシェバリエ家の食事も、何となく日本ばなれのした味といふので思ひ出せる。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十五年",
                "note": "青空文庫"
              }
            },
            {
              "text": "Ｍ・Ｍ支店長バルベ、ルキエン、それに船長とわれ／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "神戸の阪急で速水氏と待合せ、先日知り合ひになった、マルセル・ルキエンの家へ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "速水育三と理学博士清水氏と待合せ、神戸港突堤へ、プレシドン・ドウメル、五月にも一度来たことのある船、バルベ氏が日本話のうまいルキエン氏と共に来り、バアで先づカクテル。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "見物のバルベ・ルキエン・レヴィーの三外人とサンボアへ行き、チェリオ／＼。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十三年",
                "note": "青空文庫"
              }
            },
            {
              "text": "楽屋へ、藤山一郎・マルセル・ルキエン等来訪。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            },
            {
              "text": "ハネが十時十分、神戸のマルセル・ルキエン迎へに来り、渋谷のシュヴァリエ邸へ、フランス料理、うまい羊肉、赤白のワインにシャムパン、夜あけ迄のむ。",
              "citation": {
                "source": "古川ロッパ昭和日記",
                "author": "昭和十四年",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
