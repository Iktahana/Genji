          "literary": [
            {
              "text": "アタシ、オ爺チャンヲ是非一ペンボクシングニ引ッ張ッテ行クワ」「ボクサーニハ美男ハ少イダロウナ」「鼻ガ潰レテル人ガ多イワ」「レスリングトドッチガイヽカナ」「レスリングハ多分ニショウ的デ、ムヤミニ血ダラケニナッタリスルケレド、真剣味ガ乏シイワ」「ボクシングダッテ血ガ出ルンダロウ」「エヽ、ソリャ出ルワヨ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「マサカソレニハ及バンサ」「イヽワヨ、飲マセタゲルワヨ」彼女ガ薬ヲ取リニ出テ行ッタ間ニ、予ハ又一ツノ楽シミヲ考エツイタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "頭カラポタ／＼落チルワヨ」ビニールノ帽子ヲ脱グ時ニ二三滴予ニモ雫ガカヽッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「殴ルワヨ、ホントニ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ホラ、佐々木サンガ縁側カラ見テルワヨ」路ハ二人ガヨウ／＼並ンデ歩ケルホドノ廣サデアル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "ト、浴室ノドーアヲノックシテ、「チョット、コヽ締メルワヨ」ト云ウ声ガシタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽ締メルワヨ」ト、今日モノックスル音ガ聞エル。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「コヽ締メルワヨ」ト云ウ代リニ、「コヽ開イテルワヨ」ト云ウ声ガシテ、珍シク彼女ガ朗カナ顔ヲ出シタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "実ハ帝国ホテルノアーケードノ店ニアルノヲ見付ケテアルノヨ、ドウシテモコレニシヨウト思ッテ」「イクラダ」「三百萬圓」「何ダッテ」「三百萬圓」「冗談ジャナイ」「冗談ジャナイワヨ」「差当リソンナ金ハナイ」「知ッテルワヨアタシ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "「気狂イノ真似ナンカシテルト今ニホントノ気狂イニナルワヨ」予ノ耳元ヘ口ヲ寄セテ、ヘンニ落チツイタ、冷笑ヲ含ンダ低イ声デ云ッタ。",
              "citation": {
                "source": "瘋癲老人日記",
                "author": "谷崎潤一郎",
                "note": "青空文庫"
              }
            },
            {
              "text": "●オタケサン――●ボウヤ――●ア、ココニモアッタワヨ――●ア、アソコニモオチテイルワヨ――●オバサン――●ソオネ――●ワタシオコルワヨ――●ワタシオトナシクマッテ（ナッテ？",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "）ルワヨ――　これらの言葉はみんな五つから八つぐらいまでの女の子を思わせる口調であります。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "きげんのいいロオラが、大きな籠の中をグロテスクな足と嘴とで這いまわり、籠の天井にぶらさがったまま、「ワタシ、オトナシクマッテルワヨ」　そうやさしい女の子の声で言い出した時には、不釣合な様子と言葉とがわたしを笑わせました。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "「ア、マダアルワヨ」「ソコニモオチテイルワヨ」　この言葉をロオラが覚えたのは、きっと、こういう風に小さな飼主たちから食べ物を貰った時のことでありましょう。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            },
            {
              "text": "そうだ――「ワタシ、オトナシクマッテルワヨ」――　子供たちはお父さんにそういうのです。",
              "citation": {
                "source": "オカアサン",
                "author": "佐藤春夫",
                "note": "青空文庫"
              }
            }
          ]
        }
      }
